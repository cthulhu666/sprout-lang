module loam.planet

# Procedural planet/moon surface shader for the galaxy demo, authored HERE in Sprout and handed to the
# generic gfx shader API — the engine has no built-in notion of a "planet". The surface is synthesised
# analytically from the sphere's object-space direction (seamless, no UV, no texture asset): a 3D
# value-noise fBm drives continents/oceans + polar ice caps (rocky), latitude bands (gas giant), or a
# grey cratered mottle (moon), selected by uType and varied per body by uSeed. Lit physically for this
# scene — the star sits at the WORLD ORIGIN, so the day side faces it (light dir = normalize(-uCenter))
# — with half-Lambert wrap (night side dim, not black; no view-dependent hotspot) and a blue fresnel
# atmosphere limb on rocky/gas bodies. rlgl bakes DrawSphereEx's transform into the vertex, so
# vertexPosition is WORLD space; the FS recovers the surface normal as normalize(vWorld - uCenter).

import stdlib.gfx as gfx

let planet_vs =
  `#version 330
in vec3 vertexPosition;
in vec4 vertexColor;
uniform mat4 mvp;
out vec3 vWorld;
out vec4 vCol;
void main() {
  vWorld = vertexPosition;
  vCol = vertexColor;
  gl_Position = mvp*vec4(vertexPosition, 1.0);
}
`

let planet_fs =
  `#version 330
in vec3 vWorld;
in vec4 vCol;
uniform float uSeed;
uniform int uType;
uniform vec3 uCenter;
uniform float uRadius;
uniform vec3 uEye;
out vec4 finalColor;
float hash(vec3 p3) {
  p3 = fract(p3 * vec3(0.1031, 0.1030, 0.0973));
  p3 += dot(p3, p3.yxz + 33.33);
  return fract((p3.x + p3.y) * p3.z);
}
float vnoise(vec3 x) {
  vec3 i = floor(x); vec3 f = fract(x); f = f*f*(3.0 - 2.0*f);
  return mix(mix(mix(hash(i+vec3(0,0,0)), hash(i+vec3(1,0,0)), f.x),
                 mix(hash(i+vec3(0,1,0)), hash(i+vec3(1,1,0)), f.x), f.y),
             mix(mix(hash(i+vec3(0,0,1)), hash(i+vec3(1,0,1)), f.x),
                 mix(hash(i+vec3(0,1,1)), hash(i+vec3(1,1,1)), f.x), f.y), f.z);
}
float fbm(vec3 p) {
  float a = 0.5, s = 0.0;
  for (int i = 0; i < 4; i++) { s += a*vnoise(p); p *= 2.0; a *= 0.5; }
  return s;
}
vec3 surface(vec3 d, vec3 base) {
  vec3 so = vec3(uSeed, uSeed*1.37 + 11.0, uSeed*2.71 + 23.0);
  if (uType == 1) {
    float band = sin(d.y*10.0 + fbm(d*3.0 + so)*2.5);
    vec3 dark = base*0.6; vec3 lite = mix(base, vec3(1.0), 0.15);
    return mix(dark, lite, 0.5 + 0.5*band);
  } else if (uType == 2) {
    float n = fbm(d*6.0 + so);
    return base*(0.6 + 0.5*n);
  }
  float h = fbm(d*3.5 + so);
  vec3 ocean = base*0.35 + vec3(0.0, 0.02, 0.08);
  vec3 land = mix(base, vec3(0.30, 0.45, 0.20), 0.5);
  vec3 col = (h > 0.52) ? land : ocean;
  float ice = smoothstep(0.78, 0.90, abs(d.y));
  return mix(col, vec3(0.90, 0.95, 1.0), ice);
}
void main() {
  vec3 n = (uRadius > 1e-4) ? normalize(vWorld - uCenter) : vec3(0.0, 1.0, 0.0);
  vec3 surf = surface(n, vCol.rgb);
  vec3 V = normalize(uEye - vWorld);
  vec3 L = (length(uCenter) > 1e-3) ? normalize(-uCenter) : vec3(0.0, 1.0, 0.0);
  float ndl = dot(n, L);
  float hl = 0.5 + 0.5*ndl;
  vec3 lit = surf*(0.28 + 0.72*hl*hl);
  if (uType == 0 || uType == 1) {
    float rim = pow(1.0 - max(dot(n, V), 0.0), 3.0);
    lit += rim*max(ndl, 0.0)*vec3(0.35, 0.55, 1.0)*0.8;
  }
  finalColor = vec4(lit, 1.0);
}
`

# Compile the planet shader. Call after open_window; pass the handle to draw_planet.
export fn load_shader() -> Int !{IO} = gfx.load_shader(planet_vs, planet_fs)

# Draw a procedural planet/moon under shader `sh`: sets the per-body uniforms (seed, kind, center,
# radius, and the camera eye — read from gfx for the fresnel limb) then draws. `kind`: 0 rocky,
# 1 gas giant, 2 moon. (r,g,b) is the base tint the surface derives from.
export fn draw_planet(sh: Int, x: Double, y: Double, z: Double, radius: Double,
                      seed: Double, kind: Int, r: Int, g: Int, b: Int) -> Unit !{IO} =
  do
    ex <- gfx.camera_x()
    ey <- gfx.camera_y()
    ez <- gfx.camera_z()
    gfx.shader_set_float(sh, "uSeed", seed)
    gfx.shader_set_int(sh, "uType", kind)
    gfx.shader_set_vec3(sh, "uCenter", x, y, z)
    gfx.shader_set_float(sh, "uRadius", radius)
    gfx.shader_set_vec3(sh, "uEye", ex, ey, ez)
    gfx.draw_sphere_shaded(sh, x, y, z, radius, r, g, b)
