module loam.vista

import stdlib.math (sqrt)

# Loam's PLANETARIUM PROJECTION math for the galaxy-map ship scene (scene 3): a physically-scaled
# space vista seen from a starship, WITHOUT the astronomical world coordinates that would break
# float32 (a ~50 m ship and a 1 AU sun span ~10 orders of magnitude — no single linear scale, and no
# ordinary depth buffer, can hold both). Instead the ship sits at the world origin and every distant
# body (the sun, the planets) is placed on a render SPHERE of radius `sphere_r` around it, in the
# body's TRUE direction from the ship and at its TRUE angular size. The look is to-scale (sun a small
# disc, planets pinpoint specks in the right places); the geometry stays in a bounded, float-friendly
# range. Because all bodies sit at the same distance `sphere_r`, the camera orbiting the nearby ship
# gets negligible parallax on them — they behave like a distant backdrop, which is correct.
#
# Graphics-free and pure (imports only stdlib.math), so it lives in the headless engine core and is
# unit-tested in tests/loam/test_vista.spr. loam.view / the demo consume the returned world position
# and render radius through gfx draws. All positions are in AU; `body_rad_au` is the body's physical
# radius in AU; outputs are world units (the same units the ship model and camera use).

# Project a body at AU position (bx,by,bz), seen from the ship at AU position (sx,sy,sz), onto the
# render sphere of radius `sphere_r` centred on the origin (where the ship is drawn). Returns
# (wx, wy, wz, render_radius): the body's world position (its true DIRECTION from the ship, out at
# `sphere_r`) and the sphere-surface radius that subtends its true angular size — small-angle
# tan(theta) ~= theta = body_rad_au / distance, so render_radius = sphere_r * body_rad_au / distance.
# The radius is floored at `min_size` so a body whose true angular size is sub-pixel still draws as a
# visible speck (the same trick as the galaxy's minimum-pixel star billboards). A body sitting exactly
# on the ship (zero distance) has no direction to point; it is parked straight ahead (+z) at min_size.
export fn project_body(sx: Double, sy: Double, sz: Double,
                       bx: Double, by: Double, bz: Double,
                       body_rad_au: Double, sphere_r: Double, min_size: Double)
    -> (Double, Double, Double, Double) =
  let dx = bx - sx
      dy = by - sy
      dz = bz - sz
      dist = sqrt((dx * dx) + (dy * dy) + (dz * dz))
  in if dist <= 0.0 then (0.0, 0.0, sphere_r, min_size)
     else
       let inv = 1.0 / dist
           raw = sphere_r * body_rad_au / dist
           rr = if raw < min_size then min_size else raw
       in (dx * inv * sphere_r, dy * inv * sphere_r, dz * inv * sphere_r, rr)
