module loam.view

import stdlib.gfx
import stdlib.linalg (anim_advance)
import stdlib.math (sin, cos, pi)
import stdlib.mutable (mutvec_at, mutvec_set)
import loam.scene (Scene, scene_count, scene_model, scene_pos_x, scene_pos_z, scene_heading, scene_frame, scene_resting)

# Loam's VIEW layer: reusable rendering systems that READ the scene's component
# arrays and draw them. This is deliberately separate from loam.scene / loam.agent
# (which are graphics-free and headless-tested): the pure model never depends on
# this module, but every gfx app can. A "system" here is the same shape as in
# loam.agent — a function iterating the arrays — except these call gfx, so they
# cannot be tested without a window and live outside the headless engine core.
#
# Apps supply layout, spawning, and the frame loop; they compose these systems and
# the orbit-camera helpers to render. Two demos share this file verbatim
# (examples/gfx/ecs_agents, ecs_flocking); before it existed they each cloned it.

# --- Animation clips --------------------------------------------------------
# The idle and run cycles live in separate GLBs whose skeleton matches the model.
# Clips bundles both (set, clip index, keyframe count) so a caller threads one value
# instead of six.
export type Clips (..) =
  | Clips Int Int Double Int Int Double  # idle_set idle_clip idle_kf run_set run_clip run_kf

let anim_rate = 1.0  # playhead advance per tick
let rad_to_deg = 57.29578  # 180/pi — heading (radians) to raylib's Y-rotation degrees
# raylib's Y-rotation A faces (-sin A, cos A), but travel at heading θ is
# (cos θ, sin θ) — a 90° offset. Face = heading°-90 so walkers face where they go.
let facing_offset = 90.0

# Pose one entity on a given clip: advance its playhead by anim_rate (wrapping at the
# clip's own keyframe count) and push the pose to the model. Shared by both animation
# systems below so clip selection is the only thing that differs.
fn pose_entity(s: Scene, i: Int, aset: Int, aclip: Int, akf: Double) -> Unit !{IO} =
  do
    h <- mutvec_at(scene_model(s), i)
    cur <- mutvec_at(scene_frame(s), i)
    let nf = anim_advance(cur, anim_rate, akf)
    mutvec_set(scene_frame(s), i, nf)
    gfx.update_animation(h, aset, aclip, nf)

# System: pose each entity on its ACTIVE clip — idle while resting, else run.
fn anim_go(s: Scene, c: Clips, i: Int, n: Int) -> Unit !{IO} =
  if i >= n then ()
  else
    match c with
    | Clips is ic ikf rs rc rkf ->
        do
          resting <- mutvec_at(scene_resting(s), i)
          if resting == 1 then pose_entity(s, i, is, ic, ikf)
          else pose_entity(s, i, rs, rc, rkf)
          anim_go(s, c, i + 1, n)

export fn animation_system(s: Scene, c: Clips) -> Unit !{IO} =
  do
    n <- scene_count(s)
    anim_go(s, c, 0, n)

# System: like animation_system, but with a third state for JUMPING. The `resting`
# phase field is 0 walking / 1 resting / >= 2 jumping (loam.agent), so an entity with
# phase >= 2 poses on the jump clip. Demos that never jump use animation_system and
# need not supply a jump clip.
fn anim_go_jump(s: Scene, c: Clips, js: Int, jc: Int, jkf: Double, i: Int, n: Int) -> Unit !{IO} =
  if i >= n then ()
  else
    match c with
    | Clips is ic ikf rs rc rkf ->
        do
          ph <- mutvec_at(scene_resting(s), i)
          if ph == 1 then pose_entity(s, i, is, ic, ikf)
          else if ph >= 2 then pose_entity(s, i, js, jc, jkf)
          else pose_entity(s, i, rs, rc, rkf)
          anim_go_jump(s, c, js, jc, jkf, i + 1, n)

export fn animation_system_jump(s: Scene, c: Clips, jump_set: Int, jump_clip: Int, jump_kf: Double) -> Unit !{IO} =
  do
    n <- scene_count(s)
    anim_go_jump(s, c, jump_set, jump_clip, jump_kf, 0, n)

# System: draw each entity at its ground position, rotated to face its heading.
fn render_go(s: Scene, i: Int, n: Int) -> Unit !{IO} =
  if i >= n then ()
  else
    do
      h <- mutvec_at(scene_model(s), i)
      x <- mutvec_at(scene_pos_x(s), i)
      z <- mutvec_at(scene_pos_z(s), i)
      heading <- mutvec_at(scene_heading(s), i)
      gfx.draw_model(h, x, 0.0, z, (heading * rad_to_deg) - facing_offset, 1.0)
      render_go(s, i + 1, n)

export fn render_system(s: Scene) -> Unit !{IO} =
  do
    n <- scene_count(s)
    render_go(s, 0, n)

# --- Orbit camera controller ------------------------------------------------
# An app holds the orbit angle and radius as loop state and feeds its own tunables
# (step, height, bounds) in — so the controller stays stateless and both demos reuse
# it while sizing their camera differently.
let two_pi = 2.0 * pi

fn clampd(v: Double, lo: Double, hi: Double) -> Double =
  if v < lo then lo else if v > hi then hi else v

# Advance the orbit angle by `step`, wrapping into [0, 2pi).
export fn orbit_next_angle(a: Double, step: Double) -> Double =
  if stepped >= two_pi then stepped - two_pi else stepped
  where stepped = a + step

# Apply a zoom button press: `plus` pulls in (smaller radius), `minus` pushes out,
# clamped to [lo, hi]. Neither pressed holds the radius.
export fn orbit_zoomed(radius: Double, plus: Bool, minus: Bool,
                       step: Double, lo: Double, hi: Double) -> Double =
  if plus then clampd(radius - step, lo, hi)
  else if minus then clampd(radius + step, lo, hi)
  else radius

# Place the camera on its orbit: at `angle` around the Y axis, `radius` out and
# `height` up, looking at (0, target_y, 0) with a 45° field of view.
export fn orbit_camera(radius: Double, angle: Double,
                       height: Double, target_y: Double) -> Unit !{IO} =
  gfx.set_camera(radius * sin(angle), height, radius * cos(angle),
                 0.0, target_y, 0.0, 45.0)
