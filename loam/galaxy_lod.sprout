module loam.galaxy_lod

# Pure level-of-detail math for the galaxy-map demo's quadtree tile pyramid (examples/gfx/galaxy_map).
# Graphics-free — no gfx, no IO — so it is unit-tested headlessly in tests/loam/test_galaxy_lod.spr,
# exactly like loam.camera / loam.config. These MUST mirror the universegen catalog exporter's tiling
# (app/CatalogExporter.hs): a level-L quadtree has 2^L x 2^L tiles over the galactic (x,y) plane.
#
# The demo layers ONE impure step on top of these — tile_index, which needs a Double->Int floor
# (gfx.double_to_int) that the core stdlib still lacks — so tile_index stays in the demo; everything
# here is pure and testable.

# 2^n for n >= 0.
export fn pow2(n: Int) -> Int = if n <= 0 then 1 else 2 * pow2(n - 1)

# Base group id for a level = sum of 4^l for l < level  (0, 1, 5, 21, 85, 341, ...). Levels occupy
# CONTIGUOUS ascending group ranges, so drawing the groups [0, level_offset(L+1)) covers exactly
# levels 0..L — which is how the demo turns the zoom-derived level into both what it streams and
# what it draws, in one draw_instances call.
export fn level_offset(level: Int) -> Int =
  if level <= 0 then 0
  else level_offset(level - 1) + (pow2(level - 1) * pow2(level - 1))

# Permanent instance-group id of a tile: level base + row-major offset within the level's grid.
export fn group_of(level: Int, ix: Int, iy: Int) -> Int =
  level_offset(level) + (iy * pow2(level)) + ix

# Clamp an Int into [lo, hi].
export fn clampi(v: Int, lo: Int, hi: Int) -> Int =
  if v < lo then lo else if v > hi then hi else v

# Tile index of an INTEGER coordinate (light-years) at `level`, clamped into [0, 2^level). Pure
# integer arithmetic, no Double->Int floor: for a non-negative numerator, integer division already
# floors, so ((coord + radius) * n) / (2 * radius) EXACTLY equals the exporter's
# floor((coord + radius) / (2 * radius) * n). Used by the offline rebalance tool
# (tools/galaxy_rebalance), which bins raw integer ly coordinates and cannot use gfx.double_to_int.
# (The demo's own tile_index takes a Double camera coord, so it still needs the gfx floor.)
export fn tile_index_i(coord: Int, level: Int, radius: Int) -> Int =
  let n = pow2(level)
  in clampi(((coord + radius) * n) / (2 * radius), 0, n - 1)

# Nominal eye-distance boundary between adjacent detail levels `l` and `l+1` (the ladder crossed as
# you zoom). The SINGLE source of the LoD thresholds — both desired_level and next_level read it, so
# the ladder is defined once. stdlib.math is int-only (no log2 on a Double), hence a threshold ladder
# rather than a computed log: far away shows only the coarse levels, close in reaches the deepest.
export fn level_boundary(l: Int) -> Double =
  if l <= 0 then 60000.0
  else if l <= 1 then 28000.0
  else if l <= 2 then 12000.0
  else 5000.0

# Camera eye-distance -> desired max detail level, straight off the nominal ladder (no hysteresis).
# Used to SEED the committed level at startup; the per-frame update uses next_level.
export fn desired_level(dist: Double) -> Int =
  if dist > level_boundary(0) then 0
  else if dist > level_boundary(1) then 1
  else if dist > level_boundary(2) then 2
  else if dist > level_boundary(3) then 3
  else 4

# Hysteretic per-frame level update: given the currently-committed level `cur` and the eye distance,
# return the next committed level. A star level is a DISCRETE choice, so selecting straight off the
# ladder makes it flip-flop whenever the eye hovers on a boundary — one frame level 1, the next level
# 2, streaming and un-streaming a whole level's worth of stars. next_level adds a deadband of `hys`
# (a fraction, e.g. 0.15): it steps FINER (cur+1) only once the distance has dropped a hys-fraction
# BELOW the cur->cur+1 boundary, and COARSER (cur-1) only once it has risen a hys-fraction ABOVE the
# (cur-1)->cur boundary; inside the band it holds. It moves at most one level per call, so a fast
# zoom refines progressively (one level per frame) instead of dumping every level in at once. `maxlvl`
# caps the deepest populated level.
export fn next_level(cur: Int, dist: Double, maxlvl: Int, hys: Double) -> Int =
  if (cur < maxlvl) && (dist < level_boundary(cur) * (1.0 - hys)) then cur + 1
  else if (cur > 0) && (dist > level_boundary(cur - 1) * (1.0 + hys)) then cur - 1
  else cur
