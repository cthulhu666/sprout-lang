module loam.attitude

# PURE rotational dynamics for the galaxy-map demo — the ship's yaw treated as a physical body with
# momentum. Where loam.supercruise integrates POSITION from a proximity-scaled speed, this integrates
# HEADING from a thruster-driven angular acceleration. Used to swing the ship to point at the
# supercruise target BEFORE the drive engages (the align phase): idle -> align -> spool -> cruise.
#
# Controller: two regimes on the same body.
#   FAR from the target (|error| > tol): BANG-BANG WITH BRAKING (time-optimal slew) — full torque
#   toward the error, flipping to full counter-thrust once inside the braking distance (omega^2 / 2a)
#   so the ship arrests exactly at the target instead of ringing past it. You see the RCS couple fire
#   one way to spin up, then flip to brake. `thrust` = +-1 here (full).
#   WITHIN tol: a PROPORTIONAL-DERIVATIVE micro-hold — small CONTINUOUS thrust (cmd = kp*e - kd*omega,
#   clamped) that arrests the residual rate and then holds station. Feed it a slightly DITHERED target
#   (station-keeping noise, added by the demo) and it never goes dead-still: it emits constant tiny
#   corrections, which is what makes a holding/cruising ship look alive. Overdamped gains settle the
#   handoff from the gross slew without ringing. Deterministic, so it is unit-tested.
#
# Graphics-free and IO-free (only stdlib.math). The demo threads (heading, omega) through its render
# loop, calls attitude_step each frame while aligning/cruising, feeds heading (as degrees) to
# draw_model, and reads `thrust` for the plume VFX.

import stdlib.math (pi, floor, fabs, fclamp, atan2)

# The ship's rotational state plus the RCS command this frame. `thrust` is the signed couple firing
# FRACTION in [-1,1]: sign = which way the plumes flare, MAGNITUDE = how hard (the demo scales plume
# size by it). +-1 during the gross slew; a small fraction during the PD micro-hold; ~0 when quiescent.
export type Attitude = (heading: Double, omega: Double, thrust: Double)

# Fold an angle into (-pi, pi] so the shortest-path error is used (turn left vs right, never the long
# way around). Same magic as stdlib.math's sin range-reduction, one period wide and centered on 0.
export fn wrap_pi(a: Double) -> Double =
  a - two_pi * floor((a + pi) / two_pi)
  where two_pi = 2.0 * pi

# Target bearing from a direction vector in the orbital (x, z) plane. Convention: heading 0 points +z
# (into the screen / system forward) and +x is +pi/2 (starboard). atan2(dx, dz) realizes exactly that.
export fn bearing(dx: Double, dz: Double) -> Double =
  atan2(dx, dz)

# Aligned when the heading is within `tol` of the target AND the ship is nearly still (|omega| <=
# omega_tol) — a fast fly-through of the target bearing is NOT aligned; the drive waits for a settle.
export fn attitude_aligned(heading: Double, omega: Double, target: Double,
                           tol: Double, omega_tol: Double) -> Bool =
  (fabs(wrap_pi(target - heading)) <= tol) && (fabs(omega) <= omega_tol)

fn fsign(x: Double) -> Double =
  if x > 0.0 then 1.0
  else if x < 0.0 then 0.0 - 1.0
  else 0.0

# One frame of the slew. `ang_accel` is the thruster angular acceleration (rad/s^2) — LOWER = heavier
# (more rotational inertia, so the accel/decel ramps are longer and more visible); `omega_max` the
# angular-rate cap; `tol` the gross-vs-hold boundary; `hold_kp`/`hold_kd` the PD micro-hold gains
# (choose overdamped, ~sqrt(ang_accel*kp) natural freq, so the handoff settles without ringing).
#   - |error| > tol -> BANG-BANG: full thrust toward the error, flipping to brake inside omega^2/(2a).
#   - |error| <= tol -> PD micro-hold: cmd = kp*e - kd*omega, clamped to [-1,1] (small continuous
#     correction; with a dithered target it fires constant tiny pulses instead of stopping dead).
export fn attitude_step(heading: Double, omega: Double, target: Double, dt: Double,
                        ang_accel: Double, omega_max: Double, tol: Double,
                        hold_kp: Double, hold_kd: Double) -> Attitude =
  let e = wrap_pi(target - heading)
  in if fabs(e) <= tol
     then
       let cmd = fclamp((hold_kp * e) - (hold_kd * omega), 0.0 - 1.0, 1.0)
           omega2 = fclamp(omega + cmd * ang_accel * dt, 0.0 - omega_max, omega_max)
           heading2 = heading + omega2 * dt
       in Attitude(heading = heading2, omega = omega2, thrust = cmd)
     else
       let d_brake = (omega * omega) / (2.0 * ang_accel)
           closing = (omega * e) > 0.0
           td = if closing && (fabs(e) <= d_brake) then 0.0 - fsign(omega)
                else fsign(e)
           omega2 = fclamp(omega + td * ang_accel * dt, 0.0 - omega_max, omega_max)
           heading2 = heading + omega2 * dt
       in Attitude(heading = heading2, omega = omega2, thrust = td)
