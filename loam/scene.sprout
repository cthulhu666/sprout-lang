module loam.scene

import stdlib.mutable (MutVec, mutvec_new, mutvec_at, mutvec_set)

# Loam — the seed of a game engine. `scene` is its entity/component store.
#
# A Scene is fixed-capacity, structure-of-arrays (SoA) storage: an *entity* is an
# integer slot, and each *component* is one `MutVec` indexed by that slot. A
# *system* is a plain function iterating the arrays (see loam.agent). The engine
# owns the storage; the app assigns meaning to the model handle and drives
# rendering — so the same store backs both the game model and the view.
#
# Components (field order):
#   count    live-entity counter (one cell)     | model    view handle (Int)
#   pos_x    ground-plane x (Double)            | pos_z    ground-plane z (Double)
#   heading  facing / walk direction, radians   | frame    animation playhead
#   rng      per-entity PRNG state (Int)        | energy   stamina stat (Double)
#   resting  behaviour phase, 0 walking / 1 resting (Int)
#
# Arity note: single-constructor products (ADT or record) cap at 9 fields — both
# lower through `sprout_makeN`, which stops at `sprout_make9`. Nine here is exactly
# the ceiling, so a tenth component must group existing ones into a sub-struct
# (e.g. a Transform holding pos+heading) rather than widen this record. Animation
# *rate* is deliberately NOT a component: it is a single global cadence in the
# view, which spends no slot and reads as a uniform walk pace.
#
# Substrate note: Scene is a **record** (records-v0, docs/records-v0.md) over the
# component arrays. A record is an immutable value, but the arrays it holds are
# mutable, so a Scene value shares mutable SoA storage — exactly what the ECS
# wants. Named fields make component access self-documenting (`s.pos_x`) and, being
# resolved by name rather than tuple position, remove the class of miscounted-
# accessor bug that positional pattern-matching invited; test_scene still sentinels
# every component so a wiring mistake in `scene_new`/`spawn` is caught, not silent.

# An entity's identity: a zero-cost newtype over its integer slot. `wrap` keeps it
# distinct from the many other Ints in the engine (model handles, group ids, counts)
# so the type checker rejects crossing them, yet it compiles to the raw Int with no
# allocation. Storage is still Int-indexed; a per-entity function unwraps once via
# `eid_index`. `spawn` mints these; physics/agent/view consume them.
export wrap EntityId = Int

export fn eid_index(e: EntityId) -> Int = match e with | EntityId i -> i

export type Scene = (count: MutVec Int, model: MutVec Int,
                     pos_x: MutVec Double, pos_z: MutVec Double,
                     heading: MutVec Double, frame: MutVec Double,
                     rng: MutVec Int, energy: MutVec Double, resting: MutVec Int)

# Components are reached by name through the record's dot access (`s.pos_x`,
# `s.count`, …); systems in loam.agent/physics/view read them directly. The `count`
# field is a one-cell `MutVec Int` because a `MutVec` is our only mutable cell, so a
# bump-able `spawn` needs one.

# Allocate SoA storage for up to `cap` entities; the scene starts empty.
export fn scene_new(cap: Int) -> Scene !{IO} =
  do
    count <- mutvec_new(1, 0)
    model <- mutvec_new(cap, 0)
    pos_x <- mutvec_new(cap, 0.0)
    pos_z <- mutvec_new(cap, 0.0)
    heading <- mutvec_new(cap, 0.0)
    frame <- mutvec_new(cap, 0.0)
    rng <- mutvec_new(cap, 0)
    energy <- mutvec_new(cap, 0.0)
    resting <- mutvec_new(cap, 0)
    Scene(count = count, model = model, pos_x = pos_x, pos_z = pos_z,
          heading = heading, frame = frame, rng = rng, energy = energy,
          resting = resting)

# O(1). The number of live (spawned) entities.
export fn scene_count(s: Scene) -> Int !{IO} = mutvec_at(s.count, 0)

# Write one entity's components at the next free slot, bump the count, and return
# its id. `frame` starts at 0.0 and `resting` at 0 (walking); the caller supplies
# the model handle, transform, heading, PRNG seed, and starting energy. Caller
# must not exceed the capacity passed to scene_new (fixed storage).
export fn spawn(s: Scene, model: Int, x: Double, z: Double,
                heading: Double, seed: Int, energy: Double) -> EntityId !{IO} =
  do
    id <- scene_count(s)
    mutvec_set(s.model, id, model)
    mutvec_set(s.pos_x, id, x)
    mutvec_set(s.pos_z, id, z)
    mutvec_set(s.heading, id, heading)
    mutvec_set(s.frame, id, 0.0)
    mutvec_set(s.rng, id, seed)
    mutvec_set(s.energy, id, energy)
    mutvec_set(s.resting, id, 0)
    mutvec_set(s.count, 0, id + 1)
    EntityId(id)
