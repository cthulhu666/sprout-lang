module loam.system_view

import stdlib.math (sqrt)

# Scene-2 (solar-system view) FRAMING math for examples/gfx/galaxy_map — display layout, NOT orbital
# physics (that is loam.orbit). Graphics-free and pure, so it is unit-tested headlessly in
# tests/loam/test_system_view.spr.
#
# THE PROBLEM. A system's orbits span a huge dynamic range (e.g. SYS-864731: 0.27..19.3 AU, ~73x). A
# LINEAR AU->world scale that fits the outer orbit to the frame compresses the inner orbits to a few
# world units — smaller than the star's render radius, which then SWALLOWS the inner planets, and a
# 10-Earth giant drawn at radiusEarths*coeff dwarfs everything. Both are fixed by a sqrt compression.

# Per-orbit uniform world scale for an orbit of semi-major `a`, given the system's outer extent `a_ext`
# (the largest apoapsis) and the world radius `fit` that outer orbit maps to. Scaling each orbit
# UNIFORMLY by this — about the origin, where the star's focus sits (loam.orbit puts the focus at the
# origin) — keeps every orbit a true ellipse of unchanged eccentricity and shared focus; only the
# spacing BETWEEN orbits is compressed. World semi-major = a * scale = fit*sqrt(a/a_ext): monotonically
# increasing in a, equal to the plain linear fit/a_ext at a = a_ext, and sqrt-spread going inward (so
# the innermost orbit clears the star instead of vanishing into it). Zero for degenerate a/a_ext.
export fn orbit_world_scale(a: Double, a_ext: Double, fit: Double) -> Double =
  if (a <= 0.0) || (a_ext <= 0.0) then 0.0
  else fit / sqrt(a * a_ext)

# Compressed body render radius: sqrt(radiusEarths) * coeff, floored at `floor` so sub-Earth bodies stay
# visible. sqrt keeps the SIZE ORDERING (a bigger planet still draws bigger) while stopping a 10-Earth
# giant from dwarfing the inner system — linear radiusEarths*coeff drew it ~10x an Earth-radius body and
# ~3x under sqrt. Negative inputs are clamped to 0 before the floor.
export fn body_world_size(radius_earths: Double, coeff: Double, floor: Double) -> Double =
  let s = sqrt(if radius_earths < 0.0 then 0.0 else radius_earths) * coeff
  in if s < floor then floor else s
