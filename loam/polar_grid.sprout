module loam.polar_grid

import stdlib.math (clamp, sqrt, sin, cos, pi, fabs)

# Pure, renderer-independent polar spatial partition of a plane about a centre: `rings` equal-AREA
# annuli x `w` equal-angle wedges. Graphics-free — no gfx, no IO — so it is unit-tested headlessly in
# tests/loam/test_polar_grid.spr, exactly like loam.galaxy_lod / loam.camera. General engine code: a
# radar/minimap ring grid, an area-of-effect bucketing, or the galaxy-map's sector overlay are all
# consumers; nothing here is galaxy-specific. Positions are INTEGER plane coordinates (world units or
# fixed-point) measured from the grid centre, so the equal-area binning stays exact with no
# Double->Int floor — mirroring loam.galaxy_lod.tile_index_i.
#
# Conventions: wedge 0 starts at the +x axis and runs counter-clockwise; wedge j spans the half-open
# angular interval [j*d, (j+1)*d) with d = 2*pi/w. Ring 0 is the innermost disc. The grid is UNIFORM
# (every ring subdivided into w wedges); a consumer that wants an undivided "core" collapses ring 0 in
# its own naming, this module does not bake that in.

# --- Rings: equal-area annuli -------------------------------------------------------------------

# Is (x, y) within radius `r` of the centre? The open disc r^2 > x^2+y^2 (a point exactly on the
# boundary is OUTSIDE, so an adjacent ring owns it). For carving an undivided central region (e.g. a
# galaxy's core) out of the ring partition.
export fn in_disc(x: Int, y: Int, r: Int) -> Bool = (x * x + y * y) < (r * r)

# Ring index of an (x, y) offset from the centre, for `rings` equal-AREA rings tiling the annulus
# [inner, outer] (inner = 0 for a full disc). Equal-area edges are r_k = sqrt(inner^2 + (k/rings)*
# (outer^2 - inner^2)), so squaring removes the sqrt: a point is in ring j iff
# inner^2 + (j/rings)*(outer^2-inner^2) <= x^2+y^2 < inner^2 + ((j+1)/rings)*(outer^2-inner^2), i.e.
# j = floor(rings * (x^2+y^2 - inner^2) / (outer^2 - inner^2)) — exact integer arithmetic, no Double
# and no sqrt (as in loam.galaxy_lod.tile_index_i). Clamped to [0, rings-1]: a point inside `inner`
# (a carved-out core the caller handles separately) clamps to ring 0, one on/past the rim to rings-1.
# Safe while rings*(outer^2-inner^2) stays within i64 (galaxy: outer<=50000 -> < 1.3e10, under 9.2e18).
export fn ring_of(x: Int, y: Int, inner: Int, outer: Int, rings: Int) -> Int =
  clamp((rings * ((x * x + y * y) - (inner * inner))) / ((outer * outer) - (inner * inner)), 0, rings - 1)

# --- Wedges: azimuthal sectors ------------------------------------------------------------------

# Signed side of the point (x, y) relative to wedge-boundary ray k (direction (cos, sin) of angle
# k*2*pi/w): cross(ray_k, p) = cos_k*y - sin_k*x. >= 0 means p lies counter-clockwise of (or on)
# ray k. This is the range-reduction a real atan2 does first — enough to BIN the angle without ever
# recovering it, so no atan2 is required (the stdlib has none; see loam.camera notes).
fn ray_side(k: Int, w: Int, x: Int, y: Int) -> Double =
  let a = to_double(k) * (2.0 * pi / to_double(w))
  in (cos(a) * to_double(y)) - (sin(a) * to_double(x))

# Scan wedges 0..w-1: p is in wedge j iff it is CCW-of-or-on ray j and strictly CW of ray j+1. Each
# wedge cone spans 2*pi/w <= pi, so the two half-plane tests identify it exactly. Ray w wraps to ray 0
# (angle 2*pi ≡ 0), so the last wedge closes correctly. A point at the centre (all sides 0) matches no
# wedge and falls through to 0 — its angle is undefined, and a consumer treating ring 0 as an
# undivided core ignores the wedge there anyway.
#
# `eps` makes every boundary LOWER-CLOSED despite Taylor-series sin/cos error (~2e-8*r). A point on
# ray k has cross-product ~= 0 but of either sign; without a tolerance it can slip into wedge k-1.
# BOTH tests use the same -eps threshold: a point within eps of ray k is treated as ON it, so it
# satisfies wedge k's lower test and FAILS wedge k-1's upper test (it is not strictly-CW of ray k) —
# matching wedge k alone. eps is scale-relative (see wedge_of): far above the noise floor, far below a
# wedge's angular half-width.
fn wedge_scan(j: Int, w: Int, x: Int, y: Int, eps: Double) -> Int =
  if j >= w then 0
  else if (ray_side(j, w, x, y) >= (0.0 - eps)) && (ray_side(j + 1, w, x, y) < (0.0 - eps)) then j
  else wedge_scan(j + 1, w, x, y, eps)

# Wedge index (0..w-1) of an (x, y) offset for `w` equal-angle wedges; 0 at +x, counter-clockwise.
# eps = 1e-6 * |p| (L1 magnitude, within sqrt(2) of Euclidean) — comfortably above the sin/cos noise
# floor (~2e-8*|p|) yet far below a wedge half-width, so boundaries are exact and interior points are
# unaffected. At the centre eps = 0 and all rays coincide, so wedge_of(0,0,w) = 0.
export fn wedge_of(x: Int, y: Int, w: Int) -> Int =
  let eps = 0.000001 * (fabs(to_double(x)) + fabs(to_double(y)))
  in wedge_scan(0, w, x, y, eps)

# --- Sector identity ----------------------------------------------------------------------------

# Flat id of the (ring, wedge) cell in a uniform rings x w grid: ring-major, row = ring, col = wedge.
export fn sector_id(ring: Int, wedge: Int, w: Int) -> Int = (ring * w) + wedge

# Total number of cells in a uniform rings x w grid.
export fn sector_count(rings: Int, w: Int) -> Int = rings * w

# --- Render helpers (Double; for drawing the grid overlay) --------------------------------------

# Radius of ring-boundary k (0..rings) under the equal-area spacing over the annulus [inner, outer]:
# r_k = sqrt(inner^2 + (k/rings)*(outer^2 - inner^2)). Boundary 0 is the inner edge (`inner`, the core
# circle), boundary `rings` is the rim (`outer`); inner = 0 gives radius*sqrt(k/rings). For the
# overlay's concentric circles. (Pure geometry; a renderer maps it onto its own plane/axes.)
export fn ring_radius(k: Int, inner: Double, outer: Double, rings: Int) -> Double =
  sqrt((inner * inner) + ((to_double(k) / to_double(rings)) * ((outer * outer) - (inner * inner))))

# Point at distance `dist` along the ray at angle k*2*pi/w — polar->cartesian on the grid plane.
# Doubles as (a) wedge-boundary spoke endpoints, k in 0..w-1, and (b) circle sampling: with a fine w,
# k in 0..w traces a circle of radius `dist`. Returns (x, y) in the grid's own plane coordinates.
export fn boundary_point(k: Int, w: Int, dist: Double) -> (Double, Double) =
  let a = to_double(k) * (2.0 * pi / to_double(w))
  in (dist * cos(a), dist * sin(a))
