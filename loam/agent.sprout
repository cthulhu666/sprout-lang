module loam.agent

import stdlib.mutable (MutVec, mutvec_at, mutvec_set, mutvec_new)
import stdlib.math (sin, cos, sqrt, pi)
import stdlib.rng (rng_next, rng_below)
import loam.scene (Scene, EntityId, eid_index, scene_count, scene_pos_x, scene_pos_z, scene_heading, scene_frame, scene_rng, scene_energy, scene_resting)
import loam.physics (Body, physics_step, launch, airborne, impulse_for_height)

# Loam's behaviour layer: the game-model tick. `world_step` advances every entity
# one fixed step — decide, move, spend/regain energy — touching ONLY component
# arrays, never graphics. So the whole game loop runs and is asserted headless
# (tests/loam/test_agent.spr); the renderer just reads the same components after.
#
# A fixed timestep (not wall-clock dt) is deliberate: reproducibility depends on
# it. Same seeds => same trajectory, which is what makes the loop testable.

# Tuning (fixed-timestep units). walk_step is units/tick; energy is a 0..full
# stamina budget spent while walking and regained while resting.
let walk_step = 0.2
let energy_full = 100.0
let energy_spend = 0.5
let energy_regain = 1.5
let turn_denom = 40  # ~1-in-40 chance per walking tick to pick a new heading
let heading_hundredths = 628  # 2*pi*100: a heading in [0, 2pi) via rng_below/100
let two_pi = 2.0 * pi

# Flocking (group cohesion). Each walking agent nudges its heading toward its
# GROUP's centre of mass, so same-group agents converge into a flock. The nudge is
# PROPORTIONAL to how far off-course the centroid is (see `cohere`): near the flock
# core the correction fades to zero, which is what stops agents jittering in place.
let cohesion_gain = 0.4  # radians of turn per unit of sin(heading-error)
let cohesion_max_turn = 0.18  # clamp on the per-tick cohesion turn (radians)
let cohesion_min_dist = 0.05  # within this of the centroid: treat as arrived, don't steer

# Jump: an occasional leap. It spends HALF the stamina budget, so it is only
# possible above half energy, and it is far rarer than a turn. A jump is not a stored
# flag — it imparts an upward velocity to the entity's physics Body (loam.physics),
# and gravity produces the arc and the landing. So "jumping" is the emergent fact
# `airborne = y > 0`, costing the 9-field Scene no slot.
let energy_half = energy_full / 2.0  # a jump needs strictly more than this to afford it
let jump_cost = energy_full / 2.0  # ...and spends exactly this
# Loam's default world gravity is a stylized ~7x-Earth "arcade" field — still SI (m/s^2,
# 1 unit = 1 m), just a deliberate platformer world that makes a big, snappy hop rather
# than a realistic one. The leap is expressed by target HEIGHT and tuned against THIS
# gravity so its ~2.7 m apex lands within the ~33-tick jump clip. impulse and gravity are
# a coupled pair (apex = impulse^2/2g, airtime = 2*impulse/g), so a caller MUST run the
# sim under `arcade_gravity` for the arc to match; a realistic hop instead means passing
# earth_gravity (loam.physics) AND retuning this pair. Exported so the demo and tests use
# the exact field the impulse was tuned for.
export let arcade_gravity = 72.0  # m/s^2
let jump_height = 2.7  # metres — apex of the arcade hop
let jump_impulse = impulse_for_height(arcade_gravity, jump_height)  # ~19.7 m/s takeoff
let wander_jump_denom = 300  # ~1-in-300 per walking tick: far rarer than a turn (1-in-40)

fn clampd(v: Double, lo: Double, hi: Double) -> Double =
  if v < lo then lo else if v > hi then hi else v

# Non-negative remainder (Sprout has no `%`); used to bin an entity id into a group.
fn imod(a: Int, b: Int) -> Int = a - ((a / b) * b)

# The group an entity belongs to, derived PURELY from its id — no stored component,
# so it costs no Scene slot (the constructor is already at its 9-field ceiling). The
# view must colour/place groups by this SAME function to stay in sync. Round-robin
# (id mod N) spreads ids evenly across groups regardless of spawn count.
export fn group_of(i: Int, num_groups: Int) -> Int =
  if num_groups <= 1 then 0 else imod(i, num_groups)

# Turn a wander heading `nh` toward the group centroid (gx, gz) from position
# (px, pz). PURE and inverse-trig-free: the 2D cross product of the facing unit
# vector (cos nh, sin nh) with the vector-to-centroid, divided by the distance, is
# exactly sin(heading-error) — signed, so it says WHICH way and HOW MUCH to turn.
# The result is scaled, clamped, and added to the heading. A singleton group (or an
# agent sitting on its centroid) yields distance ~0 => no steering, so a lone agent
# behaves identically to the pre-flocking engine — the regression safety net.
fn cohere(nh: Double, px: Double, pz: Double, gx: Double, gz: Double) -> Double =
  let dx = gx - px
      dz = gz - pz
      dist = sqrt((dx * dx) + (dz * dz))
  in if dist < cohesion_min_dist then nh
     else norm_angle(nh + clampd(cohesion_gain * (((cos(nh) * dz) - (sin(nh) * dx)) / dist),
                                 (-cohesion_max_turn), cohesion_max_turn))

# Wrap an angle into [0, 2pi) so a reflected heading stays a sane value.
fn norm_angle(h: Double) -> Double =
  if h < 0.0 then norm_angle(h + two_pi)
  else if h >= two_pi then norm_angle(h - two_pi)
  else h

# Reflect heading `h` off whichever wall a step crossed: an x-wall flips the x
# velocity (heading -> pi - h), a z-wall flips z (heading -> -h), a corner both
# (heading -> h + pi). The reflected heading points back inward, so the agent
# turns away from the rim and keeps moving instead of pinning against it.
fn reflect(h: Double, hit_x: Bool, hit_z: Bool) -> Double =
  if hit_x && hit_z then norm_angle(h + pi)
  else if hit_x then norm_angle(pi - h)
  else if hit_z then norm_angle(0.0 - h)
  else h

# A random heading in [0, 2pi), derived from a PRNG state (radians).
fn heading_from(seed: Int) -> Double = to_double(rng_below(seed, heading_hundredths)) / 100.0

# The AI, isolated and PURE: given a per-entity PRNG state and current heading,
# occasionally turn to a fresh random heading; otherwise hold course. Returns the
# (heading', seed') to store back. No IO, no Scene — unit-testable on its own, and
# the single place to swap in smarter behaviour later.
export fn agent_decide(seed: Int, heading: Double) -> (Double, Int) =
  let s1 = rng_next(seed)
      s2 = rng_next(s1)
  in if rng_below(s1, turn_denom) == 0 then (heading_from(s2), s2) else (heading, s1)

# PURE. True iff a walking agent should launch a jump THIS tick. Three gates:
# jumping must be enabled (`jump_denom > 0` — callers pass 0 to forbid it, e.g. for
# flocks), the agent must have MORE than half stamina (the jump spends half, so it
# cannot afford one at or below the threshold), and a rare 1-in-`jump_denom` roll
# must fire. Peeks two PRNG steps ahead so the roll is independent of the walk
# decision's own draw; unit-testable on its own like agent_decide.
export fn should_jump(seed: Int, energy: Double, jump_denom: Int) -> Bool =
  jump_denom > 0 && energy > energy_half && rng_below(rng_next(rng_next(seed)), jump_denom) == 0

fn in_bounds(v: Double, bound: Double) -> Bool = v <= bound && v >= (-bound)

# Resting entity: regain energy in place; return to walking once fully recovered.
# Hysteresis (rest until FULL, walk until empty) keeps it from flickering at the
# threshold. Position is untouched — a rester does not move.
fn rest_entity(s: Scene, ent: EntityId) -> Unit !{IO} =
  do
    let idx = eid_index(ent)
    e <- mutvec_at(scene_energy(s), idx)
    let e2 = e + energy_regain
    if e2 >= energy_full
    then
      do
        mutvec_set(scene_energy(s), idx, energy_full)
        mutvec_set(scene_resting(s), idx, 0)
    else mutvec_set(scene_energy(s), idx, e2)

# Launch a jump: spend half the stamina budget, restart the animation playhead so
# the jump clip plays from its first frame, and impart upward velocity to the body.
# Gravity (loam.physics) then carries the arc and lands the agent — no countdown,
# no stored flag. The launch is terminal (no walk move this tick): the agent is
# grounded here (y still 0) and becomes airborne next tick, once physics raises y.
fn launch_jump(s: Scene, body: Body, ent: EntityId, seed: Int, e: Double) -> Unit !{IO} =
  do
    let idx = eid_index(ent)
    mutvec_set(scene_rng(s), idx, rng_next(rng_next(rng_next(seed))))
    mutvec_set(scene_energy(s), idx, e - jump_cost)
    mutvec_set(scene_frame(s), idx, 0.0)
    launch(body, ent, jump_impulse)

# The walk MOVE: decide a wander heading, bend it toward the group centroid
# (flocking), step along the result (reflecting off the arena walls so it turns back
# inward without pinning), and spend energy — flipping to resting when spent. The
# centroid arrays are the tick's pre-move snapshot (sum_x/sum_z/cnt indexed by
# group), so every agent steers by the SAME positions — simultaneous, reproducible.
# `seed`/`e` were already read by the caller (walk_entity) for the jump decision.
fn walk_move(s: Scene, bound: Double,
             sum_x: MutVec Double, sum_z: MutVec Double, cnt: MutVec Int,
             g: Int, ent: EntityId, seed: Int, e: Double) -> Unit !{IO} =
  do
    let idx = eid_index(ent)
    heading <- mutvec_at(scene_heading(s), idx)
    px <- mutvec_at(scene_pos_x(s), idx)
    pz <- mutvec_at(scene_pos_z(s), idx)
    let gr = group_of(idx, g)
    sx <- mutvec_at(sum_x, gr)
    sz <- mutvec_at(sum_z, gr)
    c <- mutvec_at(cnt, gr)
    match agent_decide(seed, heading) with
    | (nh0, nseed) ->
        do
          mutvec_set(scene_rng(s), idx, nseed)
          # Bend the wander heading toward the group's centre of mass. `c` counts
          # this agent's own group and always includes itself, so it is >= 1.
          let nh = cohere(nh0, px, pz, sx / to_double(c), sz / to_double(c))
          let cx = px + (cos(nh) * walk_step)
          let cz = pz + (sin(nh) * walk_step)
          # Reflect off any wall the step crossed, then move along the reflected
          # heading (clamped for the corner case). The agent always advances and
          # always faces where it goes — no pinning, no run-in-place.
          let rh = reflect(nh,! in_bounds (cx, bound),! in_bounds (cz, bound))
          mutvec_set(scene_pos_x(s), idx, clampd(px + (cos(rh) * walk_step), (-bound), bound))
          mutvec_set(scene_pos_z(s), idx, clampd(pz + (sin(rh) * walk_step), (-bound), bound))
          mutvec_set(scene_heading(s), idx, rh)
          let e2 = e - energy_spend
          if e2 <= 0.0
          then
            do
              mutvec_set(scene_energy(s), idx, 0.0)
              mutvec_set(scene_resting(s), idx, 1)
          else mutvec_set(scene_energy(s), idx, e2)

# --- Flock tick: rest or walk, never jump (a leap would fling a member out of its
# flock). Body-less — flocking agents never leave the ground.
fn flock_walk(s: Scene, bound: Double,
              sum_x: MutVec Double, sum_z: MutVec Double, cnt: MutVec Int,
              g: Int, ent: EntityId) -> Unit !{IO} =
  do
    let idx = eid_index(ent)
    seed <- mutvec_at(scene_rng(s), idx)
    e <- mutvec_at(scene_energy(s), idx)
    walk_move(s, bound, sum_x, sum_z, cnt, g, ent, seed, e)

fn flock_step_entity(s: Scene, bound: Double,
                     sum_x: MutVec Double, sum_z: MutVec Double, cnt: MutVec Int,
                     g: Int, ent: EntityId) -> Unit !{IO} =
  do
    ph <- mutvec_at(scene_resting(s), eid_index(ent))
    if ph == 1 then rest_entity(s, ent) else flock_walk(s, bound, sum_x, sum_z, cnt, g, ent)

fn flock_go(s: Scene, bound: Double,
            sum_x: MutVec Double, sum_z: MutVec Double, cnt: MutVec Int,
            g: Int, i: Int, n: Int) -> Unit !{IO} =
  if i >= n then ()
  else
    do
      flock_step_entity(s, bound, sum_x, sum_z, cnt, g, EntityId(i))
      flock_go(s, bound, sum_x, sum_z, cnt, g, i + 1, n)

# --- Wander tick (physics-aware): a grounded agent rests, walks, or MAYBE launches a
# rare jump; an airborne agent holds its ground position while physics carries the
# hop (loam.physics already advanced its y for this tick).
fn wander_walk(s: Scene, body: Body, bound: Double,
               sum_x: MutVec Double, sum_z: MutVec Double, cnt: MutVec Int,
               g: Int, ent: EntityId) -> Unit !{IO} =
  do
    let idx = eid_index(ent)
    seed <- mutvec_at(scene_rng(s), idx)
    e <- mutvec_at(scene_energy(s), idx)
    if should_jump(seed, e, wander_jump_denom)
    then launch_jump(s, body, ent, seed, e)
    else walk_move(s, bound, sum_x, sum_z, cnt, g, ent, seed, e)

fn wander_ground(s: Scene, body: Body, bound: Double,
                 sum_x: MutVec Double, sum_z: MutVec Double, cnt: MutVec Int,
                 g: Int, ent: EntityId) -> Unit !{IO} =
  do
    ph <- mutvec_at(scene_resting(s), eid_index(ent))
    if ph == 1 then rest_entity(s, ent) else wander_walk(s, body, bound, sum_x, sum_z, cnt, g, ent)

fn wander_step_entity(s: Scene, body: Body, bound: Double,
                      sum_x: MutVec Double, sum_z: MutVec Double, cnt: MutVec Int,
                      g: Int, ent: EntityId) -> Unit !{IO} =
  do
    air <- airborne(body, ent)
    if air then () else wander_ground(s, body, bound, sum_x, sum_z, cnt, g, ent)

fn wander_go(s: Scene, body: Body, bound: Double,
             sum_x: MutVec Double, sum_z: MutVec Double, cnt: MutVec Int,
             g: Int, i: Int, n: Int) -> Unit !{IO} =
  if i >= n then ()
  else
    do
      wander_step_entity(s, body, bound, sum_x, sum_z, cnt, g, EntityId(i))
      wander_go(s, body, bound, sum_x, sum_z, cnt, g, i + 1, n)

# Phase A: accumulate each group's position sums and member count into the scratch
# arrays. Resting agents count too — they are still part of the flock and anchor its
# centre. O(n).
fn accum_go(s: Scene, sum_x: MutVec Double, sum_z: MutVec Double, cnt: MutVec Int,
            g: Int, i: Int, n: Int) -> Unit !{IO} =
  if i >= n then ()
  else
    do
      x <- mutvec_at(scene_pos_x(s), i)
      z <- mutvec_at(scene_pos_z(s), i)
      let gr = group_of(i, g)
      sx <- mutvec_at(sum_x, gr)
      sz <- mutvec_at(sum_z, gr)
      c <- mutvec_at(cnt, gr)
      mutvec_set(sum_x, gr, sx + x)
      mutvec_set(sum_z, gr, sz + z)
      mutvec_set(cnt, gr, c + 1)
      accum_go(s, sum_x, sum_z, cnt, g, i + 1, n)

# Both ticks are two-phase so the update is simultaneous: (A) snapshot every group's
# centroid from CURRENT positions into scratch arrays, then (B) move each agent,
# steering it toward its group's snapshot centroid. Computing centroids inline during
# the move would be O(n^2) AND make the result depend on iteration order (agent 0's
# move would shift the centroid agent 1 sees), breaking reproducibility. O(n)/tick.

# Advance one tick with flocking into `num_groups`. No physics — flocking agents stay
# grounded and never jump (a leap would fling a member out of its flock; jumping is a
# plain-wander behaviour). `bound` is the arena half-extent; `num_groups < 1` = one.
export fn world_step_flock(s: Scene, bound: Double, num_groups: Int) -> Unit !{IO} =
  do
    n <- scene_count(s)
    let g = if num_groups < 1 then 1 else num_groups
    sum_x <- mutvec_new(g, 0.0)
    sum_z <- mutvec_new(g, 0.0)
    cnt <- mutvec_new(g, 0)
    accum_go(s, sum_x, sum_z, cnt, g, 0, n)
    flock_go(s, bound, sum_x, sum_z, cnt, g, 0, n)

# Advance one tick of PLAIN wandering — no flocking, but agents carry a physics Body
# and may occasionally JUMP. Vertical dynamics are integrated FIRST (physics_step) under
# the caller's `gravity` FIELD, then each agent is dispatched (airborne hold / rest /
# walk-or-launch). One singleton group per agent (num_groups = live count) makes each
# agent its own centroid, so `cohere` no-ops and the walk is cohesion-free.
export fn world_step(s: Scene, body: Body, bound: Double,
                     gravity: EntityId -> Double -> Double) -> Unit !{IO} =
  do
    n <- scene_count(s)
    physics_step(body, n, gravity)
    let g = if n < 1 then 1 else n
    sum_x <- mutvec_new(g, 0.0)
    sum_z <- mutvec_new(g, 0.0)
    cnt <- mutvec_new(g, 0)
    accum_go(s, sum_x, sum_z, cnt, g, 0, n)
    wander_go(s, body, bound, sum_x, sum_z, cnt, g, 0, n)
