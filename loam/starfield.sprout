module loam.starfield

# Emissive (self-luminous) star shader for the galaxy demo's scene-2 sun, authored HERE in Sprout and
# handed to the generic gfx shader API — the engine has no built-in notion of a "star". A star is not
# lit from outside (it IS the light), so this drops all diffuse shading and emits the body colour
# full-bright; bloom (gfx.post_bloom) then bleeds the glow. This is the IMMEDIATE variant (scene-2 sun,
# gfx.draw_sphere_shaded): colour arrives as the per-vertex attribute. (Scene 1's instanced point cloud
# uses loam.billboard's screen-space glow sprites instead of an emissive sphere mesh.)

import stdlib.gfx as gfx

let emissive_vs =
  `#version 330
in vec3 vertexPosition;
in vec4 vertexColor;
uniform mat4 mvp;
out vec4 fragColor;
void main() { fragColor = vertexColor; gl_Position = mvp*vec4(vertexPosition, 1.0); }
`

let emissive_fs =
  `#version 330
in vec4 fragColor;
out vec4 finalColor;
void main() { finalColor = fragColor; }
`

# Compile the IMMEDIATE emissive shader (for the scene-2 sun): pass its handle to draw_star.
export fn load_immediate_shader() -> Int !{IO} =
  gfx.load_shader(emissive_vs, emissive_fs)

# Draw an emissive sphere (a star) at (x,y,z) in flat RGB, under the immediate emissive shader `sh`.
export fn draw_star(sh: Int, x: Double, y: Double, z: Double, radius: Double, r: Int, g: Int, b: Int) -> Unit !{IO} =
  gfx.draw_sphere_shaded(sh, x, y, z, radius, r, g, b)
