module loam.config

import stdlib.string (words, string_lines, starts_with, trim, is_empty)

# A tiny `key value` config reader, so a demo can read its Int tunables (map size, terrain-gen and
# hydrology knobs) from a file at startup and be re-run with different settings WITHOUT recompiling.
# Pure — no IO, no gfx — so it is asserted headlessly in tests/loam/test_config.spr, unlike the demo
# view that consumes it. Values are Int only: the stdlib cannot yet parse a Double from text (see
# loam/terrain.sprout), and every rescale-relevant knob (region_chunks, lattice0, octaves,
# elevation_levels, tier1/2/3_min, seed) IS an Int; appearance Doubles stay compile-time constants.
#
# Format: one `key value` pair per line. Blank lines and lines whose first non-space character is
# `#` are ignored; a line whose value is not an integer is skipped (treated as absent, so a typo
# falls back to the caller's default rather than crashing a settings sweep). Later duplicates win.
# Keys `Dict` on String, so the map is a `Dict Int` (the value type is the only parameter).

# Fold one raw line into the accumulating dict: skip blanks/comments/malformed, else set key->int.
fn parse_line(line: String, acc: Dict Int) -> Dict Int =
  let t = trim(line)
  in if is_empty(t) then acc
     else if starts_with(t, "#") then acc
     else
       match words(t) with
       | [key, val | _] ->
           match parse_int(val) with
           | Just v -> dict_set(key, v, acc)
           | Nothing -> acc
       | _ -> acc

# Walk the lines by index (Vec, so index-recursion rather than list destructuring).
fn parse_go(lines: Vec String, i: Int, n: Int, acc: Dict Int) -> Dict Int =
  if i >= n then acc
  else
    match vec_get(i, lines) with
    | Nothing -> acc
    | Just line -> parse_go(lines, i + 1, n, parse_line(line, acc))

export fn parse_config(text: String) -> Dict Int =
  let ls = string_lines(text)
  in parse_go(ls, 0, vec_length(ls), dict_empty())

# Look a key up, falling back to `dflt` when absent — so a config lists only the knobs it overrides.
export fn cfg_int(d: Dict Int, key: String, dflt: Int) -> Int =
  match dict_get(key, d) with
  | Just v -> v
  | Nothing -> dflt
