module loam.skydome

# Procedural night-sky shader for the galaxy-map ship scene (scene 3): thousands of background stars,
# the Milky Way band, and the central bulge glow, all synthesised on the GPU from the view direction —
# no per-star geometry, no catalog read. Authored HERE in Sprout and handed to the generic gfx shader
# API, like loam.planet / loam.nebula. It is the FAKED mass of the sky; a couple hundred real catalog
# stars are drawn as billboards on top by the demo.
#
# Correct directions come from the galaxy's own geometry: the disk lies on the world x/z plane, so the
# Milky Way band is simply directions with a small vertical (world-Y) component (uBandNormal), and the
# bulge is a glow toward the galactic-centre direction from the ship's system (uCoreDir). Both are
# passed as uniforms, so the band and bulge sit where they truly are as seen from that system.
#
# Rendered on a CAMERA-CENTRED sphere seen from the inside (gfx.set_backface_cull(false)); rlgl bakes
# the draw transform into the vertex, so vertexPosition is world space and the fragment recovers its
# view direction as normalize(vWorld - uEye) with uEye = the sphere centre = the camera.

import stdlib.gfx as gfx

let sky_vs =
  "#version 330\n" ++
  "in vec3 vertexPosition;\n" ++
  "uniform mat4 mvp;\n" ++
  "out vec3 vWorld;\n" ++
  "void main() {\n" ++
  "  vWorld = vertexPosition;\n" ++
  "  gl_Position = mvp*vec4(vertexPosition, 1.0);\n" ++
  "}\n"

let sky_fs =
  "#version 330\n" ++
  "in vec3 vWorld;\n" ++
  "uniform vec3 uEye;\n" ++
  "uniform vec3 uCoreDir;\n" ++
  "uniform vec3 uBandNormal;\n" ++
  "out vec4 finalColor;\n" ++
  "float hash31(vec3 p) {\n" ++
  "  p = fract(p * vec3(0.1031, 0.1030, 0.0973));\n" ++
  "  p += dot(p, p.yxz + 33.33);\n" ++
  "  return fract((p.x + p.y) * p.z);\n" ++
  "}\n" ++
  "float vnoise(vec3 x) {\n" ++
  "  vec3 i = floor(x); vec3 f = fract(x); f = f*f*(3.0 - 2.0*f);\n" ++
  "  return mix(mix(mix(hash31(i+vec3(0,0,0)), hash31(i+vec3(1,0,0)), f.x),\n" ++
  "                 mix(hash31(i+vec3(0,1,0)), hash31(i+vec3(1,1,0)), f.x), f.y),\n" ++
  "             mix(mix(hash31(i+vec3(0,0,1)), hash31(i+vec3(1,0,1)), f.x),\n" ++
  "                 mix(hash31(i+vec3(0,1,1)), hash31(i+vec3(1,1,1)), f.x), f.y), f.z);\n" ++
  "}\n" ++
  "float fbm(vec3 p) {\n" ++
  "  float a = 0.5, s = 0.0;\n" ++
  "  for (int i = 0; i < 4; i++) { s += a*vnoise(p); p *= 2.0; a *= 0.5; }\n" ++
  "  return s;\n" ++
  "}\n" ++
  "vec3 star_layer(vec3 dir, float scale, float thresh, float size, float bright) {\n" ++
  "  vec3 p = dir*scale;\n" ++
  "  vec3 cell = floor(p);\n" ++
  "  float h = hash31(cell);\n" ++
  "  if (h < thresh) return vec3(0.0);\n" ++
  "  vec3 jit = vec3(hash31(cell+1.7), hash31(cell+4.2), hash31(cell+8.9)) - 0.5;\n" ++
  "  float d = length((fract(p) - 0.5) - jit*0.7);\n" ++
  "  float hb = hash31(cell.zyx + 5.0);\n" ++
  "  vec3 tint = mix(vec3(0.72, 0.80, 1.0), vec3(1.0, 0.92, 0.80), hash31(cell + 3.1));\n" ++
  "  return smoothstep(size, 0.0, d) * (0.35 + 0.9*hb) * bright * tint;\n" ++
  "}\n" ++
  "void main() {\n" ++
  "  vec3 dir = normalize(vWorld - uEye);\n" ++
  "  float lat = abs(dot(dir, normalize(uBandNormal)));\n" ++
  "  float band = smoothstep(0.42, 0.0, lat);\n" ++
  "  float clouds = fbm(dir*6.0);\n" ++
  "  float cd = max(dot(dir, normalize(uCoreDir)), 0.0);\n" ++
  "  float bandLift = 1.0 + band*3.0;\n" ++
  "  vec3 stars = star_layer(dir, 300.0, 0.86, 0.16, 0.9*bandLift)\n" ++
  "             + star_layer(dir, 150.0, 0.80, 0.20, 0.7*bandLift)\n" ++
  "             + star_layer(dir,  70.0, 0.90, 0.24, 1.1)\n" ++
  "             + star_layer(dir, 620.0, 0.93, 0.12, 0.7*bandLift);\n" ++
  "  float bandGlow = band * (0.06 + 0.16*clouds) * (0.6 + 0.8*cd);\n" ++
  "  vec3 band_col = bandGlow * vec3(0.60, 0.66, 0.82);\n" ++
  "  vec3 core = (pow(cd, 4.0)*0.10 + pow(cd, 16.0)*0.35) * vec3(1.0, 0.88, 0.64);\n" ++
  "  finalColor = vec4(stars*1.4 + band_col + core, 1.0);\n" ++
  "}\n"

# Compile the sky shader. Call after open_window; pass the handle to draw_sky.
export fn load_shader() -> Int !{IO} = gfx.load_shader(sky_vs, sky_fs)

# Draw the sky as a camera-centred sphere of `radius` (keep it < the far clip plane and > everything
# else in the scene). `(core_x, core_y, core_z)` is the galactic-centre direction from the ship's
# system (need not be normalised; the shader normalises it). Depth writes and back-face culling are
# disabled for the draw so the dome is seen from inside and never occludes the scene drawn over it;
# both are restored after. Draw it FIRST in the frame.
export fn draw_sky(sh: Int, radius: Double, core_x: Double, core_y: Double, core_z: Double) -> Unit !{IO} =
  do
    ex <- gfx.camera_x()
    ey <- gfx.camera_y()
    ez <- gfx.camera_z()
    gfx.shader_set_vec3(sh, "uEye", ex, ey, ez)
    gfx.shader_set_vec3(sh, "uCoreDir", core_x, core_y, core_z)
    gfx.shader_set_vec3(sh, "uBandNormal", 0.0, 1.0, 0.0)
    gfx.set_depth_mask(false)
    gfx.set_backface_cull(false)
    gfx.draw_sphere_shaded(sh, ex, ey, ez, radius, 255, 255, 255)
    gfx.set_backface_cull(true)
    gfx.set_depth_mask(true)
