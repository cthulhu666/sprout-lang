module loam.ease

# General interpolation / easing atoms for the loam engine — the small, domain-agnostic curve
# helpers every animated surface reaches for: the FTL jump fade (loam.ftl / the galaxy-map jump),
# the iter-2 in-system supercruise close, camera dollies, and HUD gauge fills. Pure and graphics-free
# (built only on stdlib.math), so it lives in the headless core and is unit-tested in
# tests/loam/test_ease.spr.
#
# Placement rationale: the two raw numeric atoms `fclamp`/`lerp` live in stdlib.math (general enough
# to be language-core), while the *easing curves* (a shading/animation idiom — smoothstep is a GLSL
# built-in, not a general-language primitive) live here in the engine. Promotion loam -> stdlib is
# cheap if a non-graphics consumer ever appears; over-committing the prelude is not.

import stdlib.math (fclamp, lerp)

# Saturate to the unit interval — the common case of fclamp for a 0..1 animation parameter.
export fn clamp01(x: Double) -> Double =
  fclamp(x, 0.0, 1.0)

# Hermite smoothstep 3t^2 - 2t^3 on a clamped input: eases in AND out (zero slope at both ends),
# the standard "soft" 0->1 ramp for fades and cross-dissolves.
export fn smoothstep(t: Double) -> Double =
  let u = clamp01(t)
  in u * u * (3.0 - 2.0 * u)

# Decelerating quadratic 1-(1-t)^2 on a clamped input: fast start, gentle arrival — the natural
# curve for a body "coasting to a stop" (supercruise drop-out, camera settle).
export fn ease_out(t: Double) -> Double =
  let u = clamp01(t)
      inv = 1.0 - u
  in 1.0 - inv * inv

# Inverse of lerp: where does x sit as a 0..1 fraction of [a,b]? UNclamped (may return <0 or >1).
# Degenerate a==b has no fraction; returns 0 rather than dividing by zero.
export fn inv_lerp(a: Double, b: Double, x: Double) -> Double =
  if b == a then 0.0
  else (x - a) / (b - a)

# Linearly remap x from input range [a,b] onto output range [c,d]. UNclamped; clamp the caller's x
# or wrap the result in clamp01/fclamp for a bounded map.
export fn remap(a: Double, b: Double, c: Double, d: Double, x: Double) -> Double =
  lerp(c, d, inv_lerp(a, b, x))
