module loam.terrain

import stdlib.rng (rng_hash2)
import stdlib.mutable (MutMatrix, mutmatrix_new, mutmatrix_get, mutmatrix_set, mutmatrix_rows)
import stdlib.string (words, split_once, string_lines)

# Loam's procedural terrain — a headless, seeded, deterministic terrain MODEL. Like the rest
# of the engine (loam.scene/agent/physics), it imports no graphics and is asserted without a
# window (tests/loam/test_terrain.spr); a view samples it afterward.
#
# Design (docs/terrain-v0.md): generation is a PURE function of (coordinate, seed), so any
# tile can be reproduced identically from its global coordinate — that is what makes huge maps
# streamable (generate upfront to disk; keep only the resident chunks in memory) AND what makes
# the model testable (same seed => same world). A continuous elevation FIELD sits underneath;
# discrete TILES are DERIVED by sampling it and classifying (elevation + moisture + temperature
# -> a Whittaker biome). v0 stores only Ints per tile (a TileKind tag + an integer elevation
# BAND), because the stdlib cannot yet convert Double<->Int or parse a Double from text; the
# only Double->Int crossing is threshold classification, which is comparison-based and needs no
# such primitive. Consequence: v0 terrain is STEPPED (discrete elevation), not smooth — a
# deliberate v0/follow-up boundary, not an accident (docs/terrain-v0.md §4, §9).

# ============================================================================
# TERRAIN TUNING — the knobs that shape the world. All levels are on the noise
# range [0, 1). Callers pass the per-world Config (seed/size/octaves/…); these are
# the biome-classifier thresholds and are the same for every world.
# ============================================================================
# Elevation bands: below sea = Water, then a thin Beach margin; above the caps come
# Mountain then Snow. Raise sea_level for more water; lower snow_level for icier peaks.
# `sea_level` is exported so a hydrology pass (loam.hydrology) can treat sea cells as drainage
# outlets and a view can test "is this the sea" against the same threshold the classifier uses.
export let sea_level = 0.40
let beach_level = 0.44
let mountain_level = 0.68
let snow_level = 0.82
# Lowland biome (between beach and mountain) by temperature/moisture.
let tundra_max_temp = 0.30  # colder than this → Tundra
let desert_min_temp = 0.66  # hotter than this AND drier than desert_max_moist → Desert
let desert_max_moist = 0.33
let forest_min_moist = 0.50  # wetter than this → Forest, else Grass
# Seed offsets that decorrelate the moisture/temperature fields from elevation (same fBm,
# different seed). Distinct large primes so the three fields never share a lattice.
let moist_offset = 1000003
let temp_offset = 2000029
# ============================================================================

# --- Tile taxonomy ----------------------------------------------------------
# A biome. Nullary variants (the 9-field cap is on product FIELDS, not variant count).
# `deriving (Enum)` makes the constructors' declaration order the single source of truth
# for the integer tag — `ordinal`/`from_ordinal` (docs/spec-v0.md §8.6) replace the former
# hand-written tag tables. Tiles persist as their ordinal, so the order below is load-bearing:
# reordering variants would silently remap every tile in every saved `.terrain` file.
export type TileKind (..) deriving (Enum) =
  | Water | Beach | Grass | Forest | Desert | Mountain | Snow | Tundra

# The (de)serialization bridge — tiles persist as their integer tag. `tile_kind_tag` is the
# derived `ordinal`; `tile_kind_of` is its TOTAL inverse — `from_ordinal` is partial, so this
# wrapper supplies the Grass fallback for an unknown tag rather than failing. The concrete
# `TileKind` return type is what pins `from_ordinal`'s return-type dispatch.
export fn tile_kind_tag(k: TileKind) -> Int = ordinal(k)

export fn tile_kind_of(tag: Int) -> TileKind =
  match from_ordinal(tag) with
  | Just k -> k
  | Nothing -> Grass

# --- Generation config ------------------------------------------------------
# seed: world seed; chunk_size: tiles per chunk edge; octaves/lattice0: fBm shape;
# elevation_levels: how many discrete height bands. Moisture/temperature seeds are derived
# from `seed` by offset (below), so they cost no field and stay decorrelated.
export type Config = (seed: Int, chunk_size: Int, octaves: Int,
                      lattice0: Int, elevation_levels: Int)

# --- Stateless spatial hash -------------------------------------------------
# A PURE function of lattice coordinates (not a threaded RNG stream), so the noise value at a
# point never depends on sample order. Delegated to stdlib.rng.rng_hash2, which uses a NONLINEAR
# final mix: a single affine LCG step would map evenly-spaced coordinates to evenly-spaced
# outputs, giving the field a short spatial period that renders as tiled, "copy-pasted" terrain
# (see rng.sprout for the full rationale). `hash_mod` is rng_hash2's exclusive upper bound, used
# below to normalize the hash into [0, 1). Coordinates are non-negative in v0 (a bounded location
# at the origin); world-map negative coords are a follow-up (docs/terrain-v0.md §9).
let hash_mod = 2147483648  # 2^31, == stdlib.rng.rng_modulus (rng_hash2's range is [0, hash_mod))

export fn spatial_hash(ix: Int, iz: Int, seed: Int) -> Int = rng_hash2(ix, iz, seed)

# --- Value noise + fBm ------------------------------------------------------
# Double math internally; the only Int->Double is one-way `to_double`, so no missing primitive
# is needed. `value_at` samples at INTEGER tile coords with an INTEGER lattice spacing L, so the
# lattice cell (integer div) and in-cell fraction (integer remainder, then to_double) are
# computed without a Double->Int floor. fBm sums octaves, halving L and amplitude each octave.

fn hash01(ix: Int, iz: Int, seed: Int) -> Double =
  to_double(spatial_hash(ix, iz, seed)) / to_double(hash_mod)

fn lerp(a: Double, b: Double, t: Double) -> Double = a + ((b - a) * t)

# Hermite smoothstep 3t^2 - 2t^3; softens the value-noise lattice so terrain reads less blocky.
fn smoothstep(t: Double) -> Double = (t * t) * (3.0 - (2.0 * t))

fn value_at(tx: Int, tz: Int, ll: Int, seed: Int) -> Double =
  let cx = tx / ll
      cz = tz / ll
      fx = to_double(tx - (cx * ll)) / to_double(ll)
      fz = to_double(tz - (cz * ll)) / to_double(ll)
      v00 = hash01(cx, cz, seed)
      v10 = hash01(cx + 1, cz, seed)
      v01 = hash01(cx, cz + 1, seed)
      v11 = hash01(cx + 1, cz + 1, seed)
      sx = smoothstep(fx)
      sz = smoothstep(fz)
      top = lerp(v00, v10, sx)
      bot = lerp(v01, v11, sx)
  in lerp(top, bot, sz)

fn fbm_go(tx: Int, tz: Int, seed: Int, ll: Int, amp: Double,
          sum: Double, norm: Double, k: Int) -> Double =
  if (k <= 0) || (ll < 1) then (if norm <= 0.0 then 0.0 else sum / norm)
  else fbm_go(tx, tz, seed, ll / 2, amp * 0.5,
              sum + (amp * value_at(tx, tz, ll, seed)), norm + amp, k - 1)

# Normalized fractal value noise in [0, 1).
export fn fbm(tx: Int, tz: Int, seed: Int, octaves: Int, lattice0: Int) -> Double =
  fbm_go(tx, tz, seed, lattice0, 1.0, 0.0, 0.0, octaves)

# --- Classification (the sole Double->Int gate — comparison only) -----------
# A Whittaker-style ladder over the three fields: water/beach then snow/mountain caps by
# elevation, else a lowland biome by temperature and moisture. All thresholds are the
# module-level TERRAIN TUNING knobs at the top of this file.
export fn classify(elev: Double, moist: Double, temp: Double) -> TileKind =
  if elev < sea_level then Water
  else if elev < beach_level then Beach
  else if elev > snow_level then Snow
  else if elev > mountain_level then Mountain
  else if temp < tundra_max_temp then Tundra
  else if (temp > desert_min_temp) && (moist < desert_max_moist) then Desert
  else if moist > forest_min_moist then Forest
  else Grass

# The elevation BAND: how many of `levels` evenly-spaced thresholds `elev` exceeds. Recursive,
# comparison-only (elev >= i/levels), so it needs no Double->Int. Monotone non-decreasing in
# elev; result in [0, levels).
fn band_go(elev: Double, levels: Int, i: Int, acc: Int) -> Int =
  if i >= levels then acc
  else band_go(elev, levels, i + 1,
               if elev >= (to_double(i) / to_double(levels)) then acc + 1 else acc)

export fn band_of(elev: Double, levels: Int) -> Int = band_go(elev, levels, 1, 0)

# The elevation band at sea level, for `levels` bands — where a view should float its water
# surface so it covers exactly the Water tiles (elev < sea_level). Keeps the water height in
# sync with the classifier's `sea_level`. (`sea_level` itself is now exported for hydrology; this
# stays the convenient band-space accessor a view uses to float its water surface.)
export fn sea_level_band(levels: Int) -> Int = band_of(sea_level, levels)

# --- Per-coordinate field (pure) --------------------------------------------
# The three fields at a GLOBAL tile coordinate, and the derived tile. These are the heart of
# generation: `generate_chunk` just tabulates them over a chunk's cells. Because they depend
# only on the global coord + seed, the tile at a coordinate is identical no matter which chunk
# computes it — the seam-correctness property tested in test_terrain.
# Exported: loam.hydrology samples this continuous Double field over a whole region to route
# drainage (it must route on the smooth field, not the discrete bands, to avoid flat plateaus).
export fn elev_at(cfg: Config, gx: Int, gz: Int) -> Double =
  fbm(gx, gz, cfg.seed, cfg.octaves, cfg.lattice0)

fn moist_at(cfg: Config, gx: Int, gz: Int) -> Double =
  fbm(gx, gz, cfg.seed + moist_offset, cfg.octaves, cfg.lattice0)

fn temp_at(cfg: Config, gx: Int, gz: Int) -> Double =
  fbm(gx, gz, cfg.seed + temp_offset, cfg.octaves, cfg.lattice0)

export fn tile_kind_at(cfg: Config, gx: Int, gz: Int) -> TileKind =
  classify(elev_at(cfg, gx, gz), moist_at(cfg, gx, gz), temp_at(cfg, gx, gz))

export fn tile_band_at(cfg: Config, gx: Int, gz: Int) -> Int =
  band_of(elev_at(cfg, gx, gz), cfg.elevation_levels)

# --- Chunk storage ----------------------------------------------------------
# A fixed-size square block of tiles, SoA: one grid of biome tags, one of elevation bands,
# indexed [row=z][col=x]. `cx`/`cz` are the chunk's coordinate (in chunk units).
export type Chunk = (cx: Int, cz: Int, kind_grid: MutMatrix Int, elev_grid: MutMatrix Int)

# Unchecked-in-practice grid read (cells are always in range); defaults to 0 out of range.
fn mm_get(m: MutMatrix Int, r: Int, c: Int) -> Int !{IO} =
  match mutmatrix_get(m, r, c) with
  | Just v -> v
  | Nothing -> 0

# Tile accessors for the view and tests.
export fn chunk_kind_tag(c: Chunk, r: Int, col: Int) -> Int !{IO} = mm_get(c.kind_grid, r, col)
export fn chunk_band(c: Chunk, r: Int, col: Int) -> Int !{IO} = mm_get(c.elev_grid, r, col)

# Fill both grids by tabulating the pure field at each cell's GLOBAL coordinate. Explicit
# recursion (the loam `_go` idiom) rather than a two-argument lambda into mutmatrix_fill.
fn fill_grid(cfg: Config, cx: Int, cz: Int, size: Int,
             kg: MutMatrix Int, eg: MutMatrix Int, r: Int, col: Int) -> Unit !{IO} =
  if r >= size then ()
  else if col >= size then fill_grid(cfg, cx, cz, size, kg, eg, r + 1, 0)
  else
    do
      let gx = (cx * size) + col
      let gz = (cz * size) + r
      mutmatrix_set(kg, r, col, tile_kind_tag(tile_kind_at(cfg, gx, gz)))
      mutmatrix_set(eg, r, col, tile_band_at(cfg, gx, gz))
      fill_grid(cfg, cx, cz, size, kg, eg, r, col + 1)

# Generate chunk (cx, cz): tabulate every tile from its global coordinate. O(size^2).
export fn generate_chunk(cfg: Config, cx: Int, cz: Int) -> Chunk !{IO} =
  do
    let size = cfg.chunk_size
    kg <- mutmatrix_new(size, size, 0)
    eg <- mutmatrix_new(size, size, 0)
    fill_grid(cfg, cx, cz, size, kg, eg, 0, 0)
    Chunk(cx = cx, cz = cz, kind_grid = kg, elev_grid = eg)

# --- Serialization (text, Int-only, exact round-trip) -----------------------
# Format: header line "cx cz size", then `size` rows, each `size` cells "tag:band" separated
# by spaces. All Ints, so int_to_string / parse_int round-trip exactly (no lossy Double text).

fn row_to_string(c: Chunk, size: Int, r: Int, col: Int, acc: String) -> String !{IO} =
  if col >= size then acc
  else
    do
      k <- chunk_kind_tag(c, r, col)
      b <- chunk_band(c, r, col)
      let cell = int_to_string(k) ++ ":" ++ int_to_string(b)
      let sep = if col == 0 then "" else " "
      row_to_string(c, size, r, col + 1, acc ++ sep ++ cell)

fn rows_to_string(c: Chunk, size: Int, r: Int, acc: String) -> String !{IO} =
  if r >= size then acc
  else
    do
      rs <- row_to_string(c, size, r, 0, "")
      rows_to_string(c, size, r + 1, acc ++ "\n" ++ rs)

export fn chunk_to_string(c: Chunk) -> String !{IO} =
  do
    let size = mutmatrix_rows(c.kind_grid)
    let header = int_to_string(c.cx) ++ " " ++ int_to_string(c.cz) ++ " " ++ int_to_string(size)
    rows_to_string(c, size, 0, header)

fn parse_header(h: String) -> Maybe (Int, Int, Int) =
  let [a, b, cc | _] = words(h) else Nothing
      Just cx = parse_int(a) else Nothing
      Just cz = parse_int(b) else Nothing
      Just size = parse_int(cc) else Nothing
  in Just((cx, cz, size))

# Parse a row's cells ("tag:band" ...) into grids; false on any malformed cell or wrong count.
fn fill_cells(cells: List String, r: Int, col: Int, size: Int,
              kg: MutMatrix Int, eg: MutMatrix Int) -> Bool !{IO} =
  match cells with
  | Nil -> col == size
  | Cons cell rest ->
      if col >= size then false
      else
        match split_once(cell, ":") with
        | Nothing -> false
        | Just (ks, bs) ->
            match (parse_int(ks), parse_int(bs)) with
            | (Just k, Just b) ->
                do
                  mutmatrix_set(kg, r, col, k)
                  mutmatrix_set(eg, r, col, b)
                  fill_cells(rest, r, col + 1, size, kg, eg)
            | _ -> false

fn fill_rows(ls: Vec String, size: Int, kg: MutMatrix Int, eg: MutMatrix Int, r: Int) -> Bool !{IO} =
  if r >= size then true
  else
    match vec_get(r + 1, ls) with
    | Nothing -> false
    | Just line ->
        do
          ok <- fill_cells(words(line), r, 0, size, kg, eg)
          if ok then fill_rows(ls, size, kg, eg, r + 1) else false

export fn chunk_from_string(s: String) -> Maybe Chunk !{IO} =
  do
    let ls = string_lines(s)
    match vec_get(0, ls) with
    | Nothing -> Nothing
    | Just header ->
        match parse_header(header) with
        | Nothing -> Nothing
        | Just (cx, cz, size) ->
            do
              kg <- mutmatrix_new(size, size, 0)
              eg <- mutmatrix_new(size, size, 0)
              ok <- fill_rows(ls, size, kg, eg, 0)
              if ok then Just(Chunk(cx = cx, cz = cz, kind_grid = kg, elev_grid = eg))
              else Nothing

# --- Disk (one file per chunk) ----------------------------------------------
# read_file reads a whole file with no seek, so one file per chunk = one whole-file read per
# resident chunk (docs/terrain-v0.md §5.6). `base_dir` must already exist.
# The cache key includes the generation `seed`: two worlds with different seeds produce different
# terrain, so their chunks must not collide on disk. Changing OTHER generation params (octaves,
# lattice0, …) with the same seed is NOT captured here — clear the cache or bump the seed if you
# retune those. `base_dir` must already exist (write_file does not create directories).
fn chunk_path(base_dir: String, seed: Int, cx: Int, cz: Int) -> String =
  base_dir ++ "/chunk_" ++ int_to_string(seed) ++ "_"
    ++ int_to_string(cx) ++ "_" ++ int_to_string(cz) ++ ".terrain"

export fn save_chunk(base_dir: String, seed: Int, c: Chunk) -> Result String Unit !{IO} =
  do
    s <- chunk_to_string(c)
    write_file(chunk_path(base_dir, seed, c.cx, c.cz), s)

# Match read_file directly (no do-bind): binding a Result via `<-` mis-strips the wrapper.
export fn load_chunk(base_dir: String, seed: Int, cx: Int, cz: Int) -> Maybe Chunk !{IO} =
  match read_file(chunk_path(base_dir, seed, cx, cz)) with
  | Err _ -> Nothing
  | Ok content -> chunk_from_string(content)

# --- World: the resident-chunk cache (paging) -------------------------------
# The resident set is a Dict keyed by "cx,cz", held in a Ref so page_in/out mutate it. A cache
# miss loads the chunk from disk; page_out drops it (reloadable). v0 has no eviction policy.
export type World = (config: Config, base_dir: String, resident: Ref (Dict Chunk))

fn chunk_key(cx: Int, cz: Int) -> String = int_to_string(cx) ++ "," ++ int_to_string(cz)

export fn world_new(cfg: Config, base_dir: String) -> World !{IO} =
  do
    r <- ref_new(dict_empty())
    World(config = cfg, base_dir = base_dir, resident = r)

export fn resident_count(w: World) -> Int !{IO} =
  do
    d <- ref_read(w.resident)
    vec_length(dict_keys(d))

export fn page_in(w: World, cx: Int, cz: Int) -> Maybe Chunk !{IO} =
  do
    d <- ref_read(w.resident)
    let key = chunk_key(cx, cz)
    match dict_get(key, d) with
    | Just c -> Just(c)
    | Nothing ->
        match load_chunk(w.base_dir, w.config.seed, cx, cz) with
        | Nothing -> Nothing
        | Just c ->
            do
              ref_write(w.resident, dict_set(key, c, d))
              Just(c)

export fn page_out(w: World, cx: Int, cz: Int) -> Unit !{IO} =
  do
    d <- ref_read(w.resident)
    ref_write(w.resident, dict_remove(chunk_key(cx, cz), d))
