# Sprout CI dispatcher configuration — TEMPLATE.
#
# Copy to /etc/sprout-ci-dispatcher.env on the dispatcher VM, fill in, and
# `chmod 600` it (it holds a Codeberg token). The systemd unit loads it via
# EnvironmentFile.

# --- Codeberg repos + auth -------------------------------------------------
CODEBERG_OWNER=plushcthulhu
# Space-separated repos (all under CODEBERG_OWNER) sharing the one worker. The
# worker boots if ANY of them has active runs. (The legacy single-repo var
# CODEBERG_REPO is still accepted as a fallback if CODEBERG_REPOS is unset.)
CODEBERG_REPOS="sprout-lang uncharted-suns"
# Read-scoped Codeberg access token (Settings -> Applications -> Generate Token,
# scope: read:repository). Reads each watched repo's Actions runs list.
CODEBERG_TOKEN=

# --- GCP worker instance ---------------------------------------------------
GCP_PROJECT=
GCP_ZONE=europe-west1-b
WORKER_INSTANCE=sprout-ci-worker-x86

# --- Tuning ----------------------------------------------------------------
# Consecutive idle ticks (no active runs) before stopping the worker.
# 3 ticks x 45s ~= 2 min grace, enough to bridge the gap between a run's jobs.
IDLE_GRACE_TICKS=3
# Safety cap (minutes). 0 disables. >0 force-stops a worker that has been up
# this long even if a run still looks active — guards against a wedged job.
# Set comfortably above a full CI run (bootstrap + just test). 0 to start.
MAX_UPTIME_MIN=0
