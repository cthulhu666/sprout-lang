# sprout.lldb — LLDB helpers for debugging Sprout programs
#
# Load at startup: lldb --source tools/sprout.lldb ./my_prog
# Or interactively: (lldb) command source tools/sprout.lldb
#
# Requires a binary built with: just build-debug <file.spr> <out>

# ── Value inspection ──────────────────────────────────────────────────────────
#
# Sprout represents values as i64 in registers:
#   Int/Bool  → raw integer (use sprout-int)
#   ADT       → pointer to SproutObj (use sprout-adt)
#
# Usage:
#   (lldb) sprout-int $x0          # print Int or Bool value in x0
#   (lldb) sprout-adt $x0          # print ADT value in x0 (recursive, depth 4)
#   (lldb) sprout-adt $x1          # inspect second argument
#
# The output goes to stderr of the debugged process (visible in the terminal).

command alias sprout-int  expression -l c -- (void)sprout_debug_int((long long)
command alias sprout-adt  expression -l c -- (void)sprout_debug_adt((long long)

# ── Register shortcuts (arm64) ────────────────────────────────────────────────
#
# Sprout passes arguments in x0, x1, x2, … and returns in x0.
#
# IMPORTANT — DWARF breakpoint offset:
#   Source-line breakpoints fire at the first call in the function body (+28 on
#   arm64), not at function entry.  At that instruction x0 holds the address of
#   the argument's GC root stack slot, NOT the argument value itself.
#   To read an Int/Bool argument, dereference x0:
#     (lldb) memory read -s8 -c1 -fu $x0    → shows the integer value
#   For an ADT argument, x0 is the SproutObj pointer — use sprout-adt directly.
#
# Quick display without calling runtime helpers:
#   (lldb) p/d $x0                    — print x0 as decimal integer
#   (lldb) p/x $x0                    — print x0 as hex
#   (lldb) memory read -s8 -c1 -fu $x0  — dereference stack slot → Int value

# ── Setting breakpoints ───────────────────────────────────────────────────────
#
# LLDB treats '.' in symbol names as an ObjC method separator, so:
#   (lldb) b main.fact                 ← BROKEN — "no locations (pending)"
#   (lldb) br set -n "main.fact"       ← BROKEN — same issue
#
# Working alternatives:
#   (lldb) br set -r "main\.fact$"     ← regex breakpoint, escapes the dot ✓
#   (lldb) b myprog.spr:4              ← source-line breakpoint ✓  (preferred)
#
# For stdlib functions that have no debug info, use address-based breakpoints:
#   (lldb) image lookup -r -s pattern  — find symbol address
#   (lldb) br set -a <address>         — break at that address

# ── Backtrace note ────────────────────────────────────────────────────────────
#
# Sprout functions appear with qualified names in backtraces:
#   main.fact, main.main, stdlib.prelude.list_map, …
# Stdlib frames show "(no debug info)" — expected; stdlib is not DWARF-annotated.

# ── Example session ───────────────────────────────────────────────────────────
#
# $ just build-debug examples/factorial.spr /tmp/factorial_dbg
# $ lldb /tmp/factorial_dbg
# (lldb) command source tools/sprout.lldb
# (lldb) b factorial.spr:4             # source-line breakpoint (recommended)
# (lldb) run
# (lldb) memory read -s8 -c1 -fu $x0  # read first Int arg (n) from stack slot
# (lldb) bt                            # shows Sprout qualified names
# (lldb) sprout-adt $x0               # inspect ADT arg (if applicable)
# (lldb) continue
