<!--
  Loaded only when `com.intellij.modules.lsp` is present — see the optional <depends> in
  plugin.xml. That module ships in the commercial JetBrains IDEs (RubyMine among them) and
  NOT in IntelliJ IDEA open-source builds or Android Studio, so everything here is absent
  rather than broken in those.

  Nothing in the language layer may reference these classes; if it did, the plugin would
  fail to load exactly where this split is supposed to protect it. `just plugin-verify`
  runs the verifier against IntelliJ IDEA Community explicitly to catch that.
-->
<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <!--
      The tag composes with defaultExtensionNs into the FULL extension point name, so this
      one reads `com.intellij.platform.lsp.serverSupportProvider` — which is what the
      platform declares, verbatim, in its own intellij.platform.lsp.xml:

        <extensionPoint qualifiedName="com.intellij.platform.lsp.serverSupportProvider"
                        interface="com.intellij.platform.lsp.api.LspServerSupportProvider"/>

      It was `platformLspServerSupportProvider` for a day, i.e. `com.intellij.platformLspServerSupportProvider`,
      which no IDE declares. An extension registered against a non-existent extension point
      is simply never instantiated: no server, no diagnostics, no hover, no navigation —
      and no error either, while highlighting kept working from the other descriptor.
      SproutLspRegistrationTest asserts this registration, because nothing else can.
    -->
    <platform.lsp.serverSupportProvider
        implementation="dev.sprout.intellij.lsp.SproutLspServerSupportProvider"/>

    <projectConfigurable
        parentId="tools"
        instance="dev.sprout.intellij.lsp.SproutConfigurable"
        id="dev.sprout.settings"
        displayName="Sprout"/>

    <!--
      Reports an unconfigured plugin on the file itself. The balloon below fires once and
      auto-hides; this stays until the cause is gone, which is the difference between a
      user noticing and a user concluding the language has no diagnostics.
    -->
    <editorNotificationProvider
        implementation="dev.sprout.intellij.lsp.SproutEditorNotificationProvider"/>

    <!--
      STICKY_BALLOON, not BALLOON: the transient form was missed in a real session, and the
      thing it reports — no server at all — has no other transient signal.
    -->
    <notificationGroup id="Sprout" displayType="STICKY_BALLOON"/>
  </extensions>
</idea-plugin>
