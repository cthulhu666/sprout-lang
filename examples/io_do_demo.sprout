module examples.io_do_demo

import stdlib.string

# Demonstrates experimental do notation for mixed IO and Maybe sequencing.
#
# Run:
#   python3 -m sprout.cli run examples/io_do_demo.sprout
#   python3 -m sprout.cli run examples/io_do_demo.sprout Ada

fn read_name() -> Maybe String !{IO} =
  do
    print("do:io")
    name <- argv_get(0)
    Just(name)

fn main() -> Unit !{IO} =
  match read_name() with
  | Just name -> print(string.concat("io-do:name=", name))
  | Nothing -> print("io-do:name=anonymous")
