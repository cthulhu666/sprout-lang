module examples.io_do_demo

import stdlib.string

# Demonstrates the preferred narrow do notation for mixed IO and Maybe
# sequencing, including a pure local `let` step inside the effectful block.
#
# Run:
#   python3 -m sprout.cli run examples/io_do_demo.sprout
#   SPROUT_NAME="  Ada  " python3 -m sprout.cli run examples/io_do_demo.sprout

fn configured_name() -> Maybe String !{IO} =
  do
    print("do:io-maybe")
    print("reading SPROUT_NAME")
    raw <- env_get("SPROUT_NAME")
    let cleaned = string.trim(raw)
    Just(cleaned)

fn main() -> Unit !{IO} =
  match configured_name() with
  | Just name -> print(string.concat("io-do:name=", name))
  | Nothing -> print("io-do:name=anonymous")
