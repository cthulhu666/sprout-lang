module examples.io_do_demo

# Demonstrates experimental do notation for IO-style sequencing.
#
# Run:
#   python3 -m sprout.cli run examples/io_do_demo.sprout
#   python3 -m sprout.cli run examples/io_do_demo.sprout Ada

fn render_name(value: Maybe String) -> String =
  match value with
  | Just name -> name
  | Nothing -> "anonymous"

fn main() -> Unit !{IO} =
  do
    print("io-do:start")
    raw <- argv_get(0)
    let label = "io-do:name=" ++ render_name(raw)
    print(label)
