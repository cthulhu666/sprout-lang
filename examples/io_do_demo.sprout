module examples.io_do_demo

import stdlib.string
import stdlib.env as env

# Demonstrates the preferred narrow do notation for mixed IO and Maybe
# sequencing, including a pure local `let` step inside the effectful block.
#
# Run:
#   mise exec -- just run examples/io_do_demo.sprout
#   SPROUT_NAME="  Ada  " mise exec -- just run examples/io_do_demo.sprout

# `env.get` is a `Result` (an `Err` is a value that is not valid UTF-8); the demo treats that like
# an unset name.
fn env_name() -> Maybe String !{IO} =
  result_with_default(Nothing, env.get("SPROUT_NAME"))

fn configured_name() -> Maybe String !{IO} =
  do
    print("do:io-maybe")
    print("reading SPROUT_NAME")
    raw <- env_name()
    let cleaned = string.trim(raw)
    Just(cleaned)

fn main() -> Unit !{IO} =
  match configured_name() with
  | Just name -> print(string.concat("io-do:name=", name))
  | Nothing -> print("io-do:name=anonymous")
