module examples.sentry_api
import stdlib.http (Result, HttpError, http_response_body, HttpResponse)
import stdlib.json (Json, JsonArray, JsonArrayStep, JsonError, json_array_next, json_get_array, json_get_field, json_get_string, parse)
import stdlib.http_client (http_get)
import stdlib.string as strlib

export type IssueRef (..) =
  | IssueRef String String

export type IssueSummary (..) =
  | IssueSummary IssueRef String String

export type IssueIdentity (..) =
  | IssueIdentity String String String

export type IssueStatusInfo (..) =
  | IssueStatusInfo String String

export type IssueLinks (..) =
  | IssueLinks String String

export type IssueDetail (..) =
  | IssueDetail IssueIdentity IssueStatusInfo IssueLinks

export fn sentry_auth_header(token: String) -> String =
  strlib.concat("Authorization: Bearer ", token)

fn concat3(a: String, b: String, c: String) -> String =
  strlib.concat(a, strlib.concat(b, c))

fn concat4(a: String, b: String, c: String, d: String) -> String =
  strlib.concat(a, concat3(b, c, d))

fn sentry_issues_url(org: String, project: String) -> String =
  concat4("https://sentry.io/api/0/projects/", org, "/", concat3(project, "/", "issues/"))

fn sentry_issue_detail_url(issue_id: String) -> String =
  concat4("https://sentry.io/api/0/issues/", issue_id, "/", "")

fn json_error_to_http_error(err: JsonError) -> HttpError =
  match err with
  | JsonDecode msg -> HttpDecode(msg)

fn preview_limit() -> Int =
  160

fn preview_body(body: String) -> String =
  if strlib.length(body) <= preview_limit() then body
  else strlib.concat(strlib.slice(body, 0, preview_limit()), "...")

fn parse_json_response(resp: HttpResponse) -> Result HttpError Json =
  match parse(http_response_body(resp)) with
  | Ok value -> Ok(value)
  | Err err ->
      match json_error_to_http_error(err) with
      | HttpDecode msg ->
          Err(
            HttpDecode(
              concat4(msg, "; body starts with: ", "\"", concat3(preview_body(http_response_body(resp)), "\"", ""))
            )
          )
      | other -> Err(other)

fn json_string_or_fallback(value: Json, fallback: String) -> String =
  match json_get_string(value) with
  | Just text -> text
  | Nothing -> fallback

fn issue_field_or_fallback(issue: Json, key: String, fallback: String) -> String =
  match json_get_field(issue, key) with
  | Just value -> json_string_or_fallback(value, fallback)
  | Nothing -> fallback

fn issue_summary_from_json(issue: Json) -> IssueSummary =
  IssueSummary(
    IssueRef(
      issue_field_or_fallback(issue, "id", "<missing-id>"),
      issue_field_or_fallback(issue, "shortId", "<missing-short-id>")
    ),
    issue_field_or_fallback(issue, "title", "<missing-title>"),
    issue_field_or_fallback(issue, "status", "<missing-status>")
  )

fn issue_detail_from_json(issue: Json) -> IssueDetail =
  IssueDetail(
    IssueIdentity(
      issue_field_or_fallback(issue, "id", "<missing-id>"),
      issue_field_or_fallback(issue, "shortId", "<missing-short-id>"),
      issue_field_or_fallback(issue, "title", "<missing-title>")
    ),
    IssueStatusInfo(
      issue_field_or_fallback(issue, "status", "<missing-status>"),
      issue_field_or_fallback(issue, "level", "<missing-level>")
    ),
    IssueLinks(
      issue_field_or_fallback(issue, "culprit", "<missing-culprit>"),
      issue_field_or_fallback(issue, "permalink", "<missing-permalink>")
    )
  )

fn decode_issue_array(items: JsonArray) -> Vec IssueSummary =
  match json_array_next(items) with
  | Nothing -> vec_empty()
  | Just step ->
      match step with
      | JsonArrayStep issue rest -> vec_prepend(issue_summary_from_json(issue), decode_issue_array(rest))

export fn sentry_decode_issue_summaries(value: Json) -> Vec IssueSummary =
  match json_get_array(value) with
  | Just items -> decode_issue_array(items)
  | Nothing -> vec_empty()

export fn sentry_decode_issue_detail(value: Json) -> IssueDetail =
  issue_detail_from_json(value)

export fn issue_id(summary: IssueSummary) -> String =
  match summary with
  | IssueSummary issue_ref _ _ ->
      match issue_ref with
      | IssueRef issue_id _ -> issue_id

export fn issue_short_id(summary: IssueSummary) -> String =
  match summary with
  | IssueSummary issue_ref _ _ ->
      match issue_ref with
      | IssueRef _ short_id -> short_id

export fn issue_title(summary: IssueSummary) -> String =
  match summary with
  | IssueSummary _ title _ -> title

export fn issue_status(summary: IssueSummary) -> String =
  match summary with
  | IssueSummary _ _ status -> status

export fn issue_detail_id(detail: IssueDetail) -> String =
  match detail with
  | IssueDetail identity _ _ ->
      match identity with
      | IssueIdentity issue_id _ _ -> issue_id

export fn issue_detail_short_id(detail: IssueDetail) -> String =
  match detail with
  | IssueDetail identity _ _ ->
      match identity with
      | IssueIdentity _ short_id _ -> short_id

export fn issue_detail_title(detail: IssueDetail) -> String =
  match detail with
  | IssueDetail identity _ _ ->
      match identity with
      | IssueIdentity _ _ title -> title

export fn issue_detail_status(detail: IssueDetail) -> String =
  match detail with
  | IssueDetail _ status_info _ ->
      match status_info with
      | IssueStatusInfo status _ -> status

export fn issue_detail_level(detail: IssueDetail) -> String =
  match detail with
  | IssueDetail _ status_info _ ->
      match status_info with
      | IssueStatusInfo _ level -> level

export fn issue_detail_culprit(detail: IssueDetail) -> String =
  match detail with
  | IssueDetail _ _ links ->
      match links with
      | IssueLinks culprit _ -> culprit

export fn issue_detail_permalink(detail: IssueDetail) -> String =
  match detail with
  | IssueDetail _ _ links ->
      match links with
      | IssueLinks _ permalink -> permalink

export fn sentry_http_error_message(err: HttpError) -> String =
  match err with
  | HttpTimeout -> "request timed out"
  | HttpNetwork message -> strlib.concat("network error: ", message)
  | HttpBadStatus _ -> "unexpected HTTP status"
  | HttpDecode message -> strlib.concat("decode error: ", message)

export fn sentry_list_issues_json(org: String, project: String, token: String, timeout_ms: Int) -> Result HttpError Json !{IO} =
  match http_get(sentry_issues_url(org, project), sentry_auth_header(token), timeout_ms) with
  | Ok resp -> parse_json_response(resp)
  | Err err -> Err(err)

export fn sentry_list_issues(org: String, project: String, token: String, timeout_ms: Int) -> Result HttpError (Vec IssueSummary) !{IO} =
  match sentry_list_issues_json(org, project, token, timeout_ms) with
  | Ok value -> Ok(sentry_decode_issue_summaries(value))
  | Err err -> Err(err)

export fn sentry_issue_detail_json(issue_id: String, token: String, timeout_ms: Int) -> Result HttpError Json !{IO} =
  match http_get(sentry_issue_detail_url(issue_id), sentry_auth_header(token), timeout_ms) with
  | Ok resp -> parse_json_response(resp)
  | Err err -> Err(err)

export fn sentry_get_issue_detail(issue_id: String, token: String, timeout_ms: Int) -> Result HttpError IssueDetail !{IO} =
  match sentry_issue_detail_json(issue_id, token, timeout_ms) with
  | Ok value -> Ok(issue_detail_from_json(value))
  | Err err -> Err(err)

export fn sentry_first_issue_title(issues: Json) -> String =
  match vec_get(0, sentry_decode_issue_summaries(issues)) with
  | Just summary -> issue_title(summary)
  | Nothing -> "<title-missing>"
