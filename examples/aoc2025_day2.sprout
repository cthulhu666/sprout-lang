# Advent of Code 2025 Day 2: Duplicate and Repeat IDs
# Sample expected answers:
# part1 (exactly repeated twice): 1227775554
# part2 (any repeated pattern, at least twice): 4174379265

type List a =
  | Cons a (List a)
  | Nil

type Range =
  | Range Int Int

type Half =
  | Half Int Int

type Answers =
  | Answers Int Int

fn modn(n: Int, m: Int) -> Int =
  n - (n / m) * m

fn pow10(k: Int) -> Int =
  if k == 0 then 1
  else 10 * pow10(k - 1)

fn num_digits(n: Int) -> Int =
  if n < 10 then 1
  else 1 + num_digits(n / 10)

fn is_even(n: Int) -> Bool =
  modn(n, 2) == 0

fn split_half(n: Int) -> Half =
  Half(n / pow10(num_digits(n) / 2), modn(n, pow10(num_digits(n) / 2)))

fn halves_equal(h: Half) -> Bool =
  match h with
  | Half left right -> left == right

fn is_repeated_twice(n: Int) -> Bool =
  if is_even(num_digits(n)) then halves_equal(split_half(n))
  else false

fn repeated_by_chunk(n: Int, base: Int, pat: Int) -> Bool =
  if n == 0 then true
  else if modn(n, base) == pat then repeated_by_chunk(n / base, base, pat)
  else false

fn matches_period(n: Int, d: Int) -> Bool =
  repeated_by_chunk(n, pow10(d), modn(n, pow10(d)))

fn has_period_from(n: Int, len: Int, d: Int) -> Bool =
  if d >= len then false
  else if modn(len, d) != 0 then has_period_from(n, len, d + 1)
  else if matches_period(n, d) then true
  else has_period_from(n, len, d + 1)

fn is_repeated_any(n: Int) -> Bool =
  has_period_from(n, num_digits(n), 1)

fn sum_range(lo: Int, hi: Int, pred: Int -> Bool) -> Int =
  if lo > hi then 0
  else if pred(lo) then lo + sum_range(lo + 1, hi, pred)
  else sum_range(lo + 1, hi, pred)

fn sum_ranges(rs: List Range, pred: Int -> Bool) -> Int =
  match rs with
  | Nil -> 0
  | Cons r rest ->
      match r with
      | Range lo hi -> sum_range(lo, hi, pred) + sum_ranges(rest, pred)

let r11 = Cons(Range(2121212118, 2121212124), Nil)
let r10 = Cons(Range(824824821, 824824827), r11)
let r9 = Cons(Range(565653, 565659), r10)
let r8 = Cons(Range(38593856, 38593862), r9)
let r7 = Cons(Range(446443, 446449), r8)
let r6 = Cons(Range(1698522, 1698528), r7)
let r5 = Cons(Range(222220, 222224), r6)
let r4 = Cons(Range(1188511880, 1188511890), r5)
let r3 = Cons(Range(998, 1012), r4)
let r2 = Cons(Range(95, 115), r3)
let r1 = Cons(Range(11, 22), r2)

fn sample_ranges() -> List Range = r1

fn main() -> IO Unit =
  print(
    Answers(
      sum_ranges(sample_ranges(), is_repeated_twice),
      sum_ranges(sample_ranges(), is_repeated_any)
    )
  )
