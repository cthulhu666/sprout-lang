module examples.gfx.terrain_rivers_demo

import stdlib.gfx
import loam.terrain (Config, Chunk, World, generate_chunk, save_chunk, load_chunk, world_new, page_in, chunk_kind_tag, chunk_band, sea_level_band, spatial_hash, exposed_step_bands, chunk_linear_index, TileKind, Water, Beach, Grass, Forest, Desert, Mountain, Snow, Tundra, tile_kind_of)
import loam.hydrology (Hydrology, compute_hydrology, hydro_tier)
import loam.vegetation (TreeKind, Palm, Broadleaf, Conifer, DarkConifer, Cactus, Shrub, tree_kind_tag, tree_for_biome)
import loam.camera (Cam, cam_rotate, cam_zoom, cam_pitch, cam_pan)
import loam.view (cam_apply)
import stdlib.mutable (MutVec, mutvec_new, mutvec_at, mutvec_set, MutMatrix, mutmatrix_new, mutmatrix_set, mutmatrix_at_or)

# The Loam terrain demo (see terrain_demo.sprout) WITH RIVERS. loam.hydrology (headless, tested in
# tests/loam/test_hydrology.spr) computes drainage over the whole region as a global upfront pass:
# it fills depressions, routes D8 flow downhill, accumulates drainage area, and buckets it into a
# per-cell flow_tier (0 = none, 1..3 = creek/river/major). THIS file is the view: at startup it
# generates the region, runs the hydrology pass, then BAKES every tile into one static GPU mesh —
# colouring river cells blue-by-tier instead of their biome — so the frame loop draws the whole map
# in a single call. Rivers flow downhill and reach the sea (proven headlessly), the groundwork for a
# raft water-transport game: flow_tier is the future navigability class, flow_dir the current.
#
# Run (auto-closes after N frames with SPROUT_GFX_MAX_FRAMES=N):
#   mise exec -- just run-gfx examples/gfx/terrain_rivers_demo.sprout

# ============================================================================
# TUNABLES — tweak these to change the map. Everything else derives from them.
# ============================================================================
# Map size ------------------------------------------------------------------
let chunk_edge = 32  # tiles per chunk edge
let region_chunks = 32  # map is region_chunks × region_chunks chunks; 32×32 = 1024×1024 tiles
let map_dir = "/tmp"  # one file per chunk lands here (chunk_<cx>_<cz>.terrain)

# Terrain generation (fed into loam.terrain.Config) -------------------------
let world_seed = 2137  # change for a different world
let noise_octaves = 5  # fBm detail layers (more = finer variation)
let noise_lattice0 = 24  # base feature size in tiles (larger = broader landforms)
let elevation_levels = 12  # number of discrete height bands

# Appearance ----------------------------------------------------------------
let tile_size = 1.0  # world units per tile (cube edge)
let band_step = 0.6  # world-unit height per elevation band (larger = taller relief)

# Trees -- biome-driven vegetation scattered over the terrain (loam.vegetation decides WHAT grows
# where; this file resolves each TreeKind to a vendored .glb and instances it). --------------
let tree_count = 15  # number of distinct tree models loaded (must match load_trees / variant_range)
let tree_base_scale = 1.0  # world-unit scale applied to every tree model
let tree_scale_var = 30  # +/- percent hash-driven scale spread, so a stand is not uniform
let tree_jitter = 0.7  # max in-tile position jitter as a fraction of tile_size (breaks the grid)
let variant_offset = 3000017  # seed offset decorrelating the variant/jitter/scale hash from placement

# Water surface (a translucent plane at sea level) --------------------------
let water_r = 45
let water_g = 110
let water_b = 190
let water_alpha = 165  # 0 = invisible, 255 = opaque
let water_lift = 0.5  # bands above the sea-level band to float the surface (hides the beds)

# Camera framing (fractions of the map span, so it scales with map size) ----
let cam_radius_frac = 0.85  # opening horizontal standoff
let cam_height_frac = 0.6  # opening eye height (sets the opening tilt ~35deg)
let cam_min_frac = 0.05  # closest zoom, as a fraction of span (eye→target DISTANCE)
let cam_max_frac = 9.5  # farthest zoom (distance)
let cam_target_y = 4.0  # height of the ground point the eye looks at
# Manual control steps — how far each held button moves the camera PER FRAME.
let cam_zoom_frac = 0.04  # zoom in/out DISTANCE per frame, as a span fraction
let cam_rot_step = 0.02  # rotate radians per frame (~1.1°)
# Tilt is an ANGLE now (orbit at constant distance), so its step and bounds are
# radians, NOT span fractions: ~1.1°/frame, clamped between a low glancing angle
# and a near-top-down one (the opening frame sits at ~35°, inside these bounds).
let cam_pitch_step = 0.02  # tilt radians per frame (~1.1°)
let cam_pitch_min = 0.15  # ~8.6° above the horizon (shallow)
let cam_pitch_max = 1.45  # ~83° (near top-down, not degenerate)
let cam_pan_frac = 0.01  # pan (look-at) per frame, as a span fraction
# ============================================================================

# --- Derived (do not edit; computed from the tunables above) ----------------
let span_tiles = region_chunks * chunk_edge
let chunk_count = region_chunks * region_chunks  # one baked mesh per chunk
# Trees are bucketed into per-chunk groups and frustum-culled. draw_trees_culled compacts the
# visible groups' instances into one draw per model, so the draw-call count is independent of how
# many groups exist — meaning we use the finest (per-chunk) groups for the tightest culling.
let tree_group_edge = chunk_edge  # group edge in tiles (= one chunk)
let tree_group_cols = (span_tiles + tree_group_edge - 1) / tree_group_edge  # ceil, so it need not divide
let tree_group_count = tree_group_cols * tree_group_cols
let world_span = to_double(span_tiles) * tile_size
let half = to_double(span_tiles) / 2.0
let water_y = (to_double(sea_level_band(elevation_levels)) + water_lift) * band_step

# --- Biome palette ----------------------------------------------------------
# Biome -> flat RGB (0..255). Matching on TileKind (not the raw Int tag) means adding a biome
# is a compile error here (non-exhaustive match) rather than a silent wrong colour.
fn biome_rgb(k: TileKind) -> (Int, Int, Int) =
  match k with
  | Water -> (40, 90, 170)
  | Beach -> (205, 185, 125)
  | Grass -> (70, 150, 60)
  | Forest -> (28, 100, 42)
  | Desert -> (212, 190, 110)
  | Mountain -> (120, 112, 104)
  | Snow -> (236, 236, 242)
  | Tundra -> (172, 182, 162)

# River palette by flow_tier: bigger rivers read as deeper, more saturated blue. Only used where
# the hydrology pass marked a land cell as carrying a river (tier > 0).
fn river_rgb(tier: Int) -> (Int, Int, Int) =
  if tier >= 3 then (30, 75, 155)  # major navigable river
  else if tier == 2 then (48, 105, 185)  # river
  else (78, 140, 205)  # creek

# World Y of a band's top face — mirrors the old cube (centre at band*band_step, edge tile_size),
# so the baked top surface sits exactly where the cube tops used to.
fn band_top_y(band: Int) -> Double = (to_double(band) * band_step) + (tile_size * 0.5)

# Exposed side drop (world units) toward the neighbour at (nx, nz). Off-map neighbours drop to the
# floor (y = 0) so the map perimeter reads as a solid slab; in-map, expose the step down to a lower
# neighbour (0 when the neighbour is level-or-higher and hides the side).
fn nbr_drop(this_band: Int, bands: MutMatrix Int, nx: Int, nz: Int, span: Int) -> Double !{IO} =
  if (nx < 0) || (nz < 0) || (nx >= span) || (nz >= span) then band_top_y(this_band)
  else
    do
      nb <- mutmatrix_at_or(bands, nz, nx, this_band)
      to_double(exposed_step_bands(this_band, nb)) * band_step

# Bake ONE tile as a top quad + only its exposed side walls (the top-surface mesh). Colour follows
# the same river-over-biome rule as the old cube path; the four neighbour drops come from the global
# band grid. A flagged river cell (flow_tier > 0) is painted river-blue by tier instead of biome.
fn bake_tile(bands: MutMatrix Int, tags: MutMatrix Int, h: Hydrology, span: Int, gx: Int, gz: Int) -> Unit !{IO} =
  do
    band <- mutmatrix_at_or(bands, gz, gx, 0)
    tag <- mutmatrix_at_or(tags, gz, gx, 0)
    tier <- hydro_tier(h, gx, gz)
    let rgb = if tier > 0 then river_rgb(tier) else biome_rgb(tile_kind_of(tag))
    dn <- nbr_drop(band, bands, gx, gz - 1, span)
    ds <- nbr_drop(band, bands, gx, gz + 1, span)
    de <- nbr_drop(band, bands, gx + 1, gz, span)
    dw <- nbr_drop(band, bands, gx - 1, gz, span)
    match rgb with
    | (r, g, b) ->
        gfx.capture_tile((to_double(gx) - half) * tile_size, (to_double(gz) - half) * tile_size,
                         band_top_y(band), tile_size, r, g, b, dn, ds, de, dw)

# --- Offline generation pass (once at startup) ------------------------------
fn gen_region(cfg: Config, dir: String, ncx: Int, ncz: Int, cx: Int, cz: Int) -> Unit !{IO} =
  if cz >= ncz then ()
  else if cx >= ncx then gen_region(cfg, dir, ncx, ncz, 0, cz + 1)
  else
    do
      # Seed-keyed disk cache: a chunk already on disk under this seed is valid (generation is
      # deterministic), so skip it. Only a first run — or a changed world_seed — pays the fBm cost.
      # Match load_chunk directly (no `<-`): a `<-` bind on a Maybe-returning effect mis-strips it.
      match load_chunk(dir, cfg.seed, cx, cz) with
      | Just _ -> ()
      | Nothing ->
          do
            ch <- generate_chunk(cfg, cx, cz)
            match save_chunk(dir, cfg.seed, ch) with | _ -> ()
      gen_region(cfg, dir, ncx, ncz, cx + 1, cz)

# --- Bake pass --------------------------------------------------------------
# The top-surface bake needs each tile's four neighbour heights, including across chunk seams, so it
# first materialises a global band+tag grid (chunks page in once; page_in caches), then bakes from
# the grid in one flat span×span sweep — neighbour lookups are O(1) and cross-chunk-free.

# Copy one paged chunk's per-cell band + kind tag into the global grids at its world offset.
fn grid_chunk_cells(bands: MutMatrix Int, tags: MutMatrix Int, ch: Chunk, cx: Int, cz: Int, size: Int, r: Int, c: Int) -> Unit !{IO} =
  if r >= size then ()
  else if c >= size then grid_chunk_cells(bands, tags, ch, cx, cz, size, r + 1, 0)
  else
    do
      tag <- chunk_kind_tag(ch, r, c)
      band <- chunk_band(ch, r, c)
      mutmatrix_set(bands, (cz * size) + r, (cx * size) + c, band)
      mutmatrix_set(tags, (cz * size) + r, (cx * size) + c, tag)
      grid_chunk_cells(bands, tags, ch, cx, cz, size, r, c + 1)

fn grid_chunk(w: World, bands: MutMatrix Int, tags: MutMatrix Int, cx: Int, cz: Int, size: Int) -> Unit !{IO} =
  match page_in(w, cx, cz) with
  | Nothing -> ()
  | Just ch -> grid_chunk_cells(bands, tags, ch, cx, cz, size, 0, 0)

# Fill the whole band+tag grid, chunk by chunk (mirrors the old draw_region recursion).
fn build_grids(w: World, bands: MutMatrix Int, tags: MutMatrix Int, size: Int, ncx: Int, ncz: Int, cx: Int, cz: Int) -> Unit !{IO} =
  if cz >= ncz then ()
  else if cx >= ncx then build_grids(w, bands, tags, size, ncx, ncz, 0, cz + 1)
  else
    do
      grid_chunk(w, bands, tags, cx, cz, size)
      build_grids(w, bands, tags, size, ncx, ncz, cx + 1, cz)

# Bake one chunk's tiles into the current capture. Neighbour heights come from the global grid, so
# tiles on a chunk seam still get correct step walls against the adjacent chunk.
fn bake_chunk_tiles(bands: MutMatrix Int, tags: MutMatrix Int, h: Hydrology, span: Int, size: Int, cx: Int, cz: Int, r: Int, c: Int) -> Unit !{IO} =
  if r >= size then ()
  else if c >= size then bake_chunk_tiles(bands, tags, h, span, size, cx, cz, r + 1, 0)
  else
    do
      bake_tile(bands, tags, h, span, (cx * size) + c, (cz * size) + r)
      bake_chunk_tiles(bands, tags, h, span, size, cx, cz, r, c + 1)

# Bake each chunk into its OWN static mesh and record the handle (indexed cz*ncx + cx), so the frame
# loop can frustum-cull per chunk — a zoomed-in view then pays only for the visible handful of
# chunks instead of the whole map. This is what makes zooming in fast.
fn bake_region(bands: MutMatrix Int, tags: MutMatrix Int, h: Hydrology, span: Int, size: Int, ncx: Int, ncz: Int, meshes: MutVec Int, cx: Int, cz: Int) -> Unit !{IO} =
  if cz >= ncz then ()
  else if cx >= ncx then bake_region(bands, tags, h, span, size, ncx, ncz, meshes, 0, cz + 1)
  else
    do
      gfx.mesh_capture_begin()
      bake_chunk_tiles(bands, tags, h, span, size, cx, cz, 0, 0)
      handle <- gfx.mesh_capture_end()
      mutvec_set(meshes, (cz * ncx) + cx, handle)
      bake_region(bands, tags, h, span, size, ncx, ncz, meshes, cx + 1, cz)

# Draw every chunk mesh; gfx.draw_captured frustum-culls the off-screen ones in the shim.
fn draw_meshes(meshes: MutVec Int, i: Int, n: Int) -> Unit !{IO} =
  if i >= n then ()
  else
    do
      mh <- mutvec_at(meshes, i)
      gfx.draw_captured(mh)
      draw_meshes(meshes, i + 1, n)

# --- Trees: load, resolve biome -> model, scatter as instances --------------
# Truncating remainder for the (always non-negative) spatial hashes — the loam idiom.
fn imod(a: Int, b: Int) -> Int = a - ((a / b) * b)

# Bind one model handle into slot `i`. Keeps load_trees to one line per model so the LOAD ORDER
# (which variant_range depends on) reads top-to-bottom.
fn ld(models: MutVec Int, i: Int, path: String) -> Unit !{IO} =
  do
    h <- gfx.load_model(path)
    mutvec_set(models, i, h)

# Load every vegetation variant into `models`. ORDER IS LOAD-BEARING: it must match the (base,
# count) ranges in variant_range below (and the table in assets/models/nature/SOURCE.md).
fn load_trees(models: MutVec Int) -> Unit !{IO} =
  do
    ld(models, 0, "assets/models/nature/tree_palmShort.obj")  # Palm       [0,2)
    ld(models, 1, "assets/models/nature/tree_palmTall.obj")
    ld(models, 2, "assets/models/nature/tree_default.obj")  # Broadleaf  [2,6)
    ld(models, 3, "assets/models/nature/tree_oak.obj")
    ld(models, 4, "assets/models/nature/tree_small.obj")
    ld(models, 5, "assets/models/nature/tree_detailed.obj")
    ld(models, 6, "assets/models/nature/tree_pineTallA.obj")  # Conifer    [6,9)
    ld(models, 7, "assets/models/nature/tree_pineSmallA.obj")
    ld(models, 8, "assets/models/nature/tree_pineDefaultA.obj")
    ld(models, 9, "assets/models/nature/tree_pineDefaultB.obj")  # DarkConifer [9,11)
    ld(models, 10, "assets/models/nature/tree_pineSmallB.obj")
    ld(models, 11, "assets/models/nature/cactus_short.obj")  # Cactus     [11,13)
    ld(models, 12, "assets/models/nature/cactus_tall.obj")
    ld(models, 13, "assets/models/nature/plant_bushLarge.obj")  # Shrub      [13,15)
    ld(models, 14, "assets/models/nature/plant_bushSmall.obj")

# The contiguous (base, count) slice of `models` holding a TreeKind's variants. Mirrors the load
# order above; the hash picks one variant within the slice for natural mixing.
fn variant_range(tag: Int) -> (Int, Int) =
  if tag == tree_kind_tag(Palm) then (0, 2)
  else if tag == tree_kind_tag(Broadleaf) then (2, 4)
  else if tag == tree_kind_tag(Conifer) then (6, 3)
  else if tag == tree_kind_tag(DarkConifer) then (9, 2)
  else if tag == tree_kind_tag(Cactus) then (11, 2)
  else (13, 2)  # Shrub

# Place at most one tree on tile (gx, gz): skip river cells; ask loam.vegetation what (if anything)
# grows on this biome for this tile's hash; then pick a variant + jitter/rotate/scale it (all from
# a decorrelated hash so the scatter looks organic but is fully reproducible) and queue an instance.
fn place_tile(models: MutVec Int, hy: Hydrology, gx: Int, gz: Int, tag: Int, band: Int) -> Unit !{IO} =
  do
    tier <- hydro_tier(hy, gx, gz)
    if tier > 0 then ()
    else
      match tree_for_biome(tile_kind_of(tag), spatial_hash(gx, gz, world_seed)) with
      | Nothing -> ()
      | Just tk ->
          match variant_range(tree_kind_tag(tk)) with
          | (base, cnt) ->
              do
                let hv = spatial_hash(gx, gz, world_seed + variant_offset)
                h <- mutvec_at(models, base + imod(hv, cnt))
                let jx = ((to_double(imod(hv, 1000)) / 1000.0) - 0.5) * tree_jitter * tile_size
                let jz = ((to_double(imod(hv / 7, 1000)) / 1000.0) - 0.5) * tree_jitter * tile_size
                let angle = to_double(imod(hv, 360))
                let sc = tree_base_scale * (1.0 + ((to_double(imod(hv, (2 * tree_scale_var) + 1)) - to_double(tree_scale_var)) / 100.0))
                let wx = ((to_double(gx) - half) * tile_size) + jx
                let wz = ((to_double(gz) - half) * tile_size) + jz
                let wy = (to_double(band) * band_step) + (tile_size * 0.5)
                # Bucket the tree into its chunk's group so the frame loop can frustum-cull whole
                # chunks of vegetation (h is the gfx model handle, doubling as the group's model key).
                gfx.tree_push(chunk_linear_index(gx, gz, tree_group_edge, tree_group_cols), h, wx, wy, wz, angle, sc)

# Walk a chunk's tiles, queueing a tree per eligible cell (mirrors draw_chunk_tiles' recursion).
fn place_chunk_tiles(models: MutVec Int, hy: Hydrology, ch: Chunk, cx: Int, cz: Int, size: Int, r: Int, c: Int) -> Unit !{IO} =
  if r >= size then ()
  else if c >= size then place_chunk_tiles(models, hy, ch, cx, cz, size, r + 1, 0)
  else
    do
      tag <- chunk_kind_tag(ch, r, c)
      band <- chunk_band(ch, r, c)
      place_tile(models, hy, (cx * size) + c, (cz * size) + r, tag, band)
      place_chunk_tiles(models, hy, ch, cx, cz, size, r, c + 1)

fn place_chunk(models: MutVec Int, w: World, hy: Hydrology, cx: Int, cz: Int, size: Int) -> Unit !{IO} =
  match page_in(w, cx, cz) with
  | Nothing -> ()
  | Just ch -> place_chunk_tiles(models, hy, ch, cx, cz, size, 0, 0)

# Scatter trees over the whole region, once at startup (mirrors draw_region). Instances live GPU-
# side thereafter; the frame loop only replays them.
fn place_region(models: MutVec Int, w: World, hy: Hydrology, size: Int, ncx: Int, ncz: Int, cx: Int, cz: Int) -> Unit !{IO} =
  if cz >= ncz then ()
  else if cx >= ncx then place_region(models, w, hy, size, ncx, ncz, 0, cz + 1)
  else
    do
      place_chunk(models, w, hy, cx, cz, size)
      place_region(models, w, hy, size, ncx, ncz, cx + 1, cz)


# --- Camera framing + control steps (derived from the tunables + map span) --
let cam_start_radius = world_span * cam_radius_frac
let cam_start_height = world_span * cam_height_frac
let zoom_step = world_span * cam_zoom_frac
let min_dist = world_span * cam_min_frac  # zoom clamps are eye→target DISTANCE
let max_dist = world_span * cam_max_frac
let pitch_step = cam_pitch_step  # tilt is in radians — NOT scaled by span
let pitch_min = cam_pitch_min
let pitch_max = cam_pitch_max
let pan_step = world_span * cam_pan_frac
let pan_bound = half * tile_size  # keep the look-at over the map (centred on 0,0)

# The starting rig reproduces the old orbit demo's opening frame exactly: same
# horizontal standoff and eye height, looking at the map centre.
let cam_start = Cam(yaw = 0.0, radius = cam_start_radius, height = cam_start_height,
                    tx = 0.0, ty = cam_target_y, tz = 0.0)

# --- Control panel (held buttons: press-and-hold to move continuously) ------
let btn_w = 78
let btn_h = 30
let col_l = 838  # left column: rotate / tilt / zoom-in
let col_r = 920  # right column: pan / zoom-out
let row0 = 300
let row1 = 336
let row2 = 372
let row3 = 408
let row4 = 444

fn bd(b: Bool) -> Double = if b then 1.0 else 0.0

# Fold this frame's held buttons into the next camera state. Pure — the buttons
# are sampled in the loop (IO), the motion they imply is computed here.
fn drive_cam(c: Cam, rl: Bool, rr: Bool, tu: Bool, td: Bool, zi: Bool, zo: Bool,
             pf: Bool, pb: Bool, pl: Bool, pr: Bool) -> Cam =
  let c1 = cam_rotate(c, (bd(rr) - bd(rl)) * cam_rot_step)
      c2 = cam_pitch(c1, (bd(tu) - bd(td)) * pitch_step, pitch_min, pitch_max)
      c3 = cam_zoom(c2, (bd(zo) - bd(zi)) * zoom_step, min_dist, max_dist)
  in cam_pan(c3, (bd(pr) - bd(pl)) * pan_step, (bd(pf) - bd(pb)) * pan_step, pan_bound)

# The terrain+rivers are STATIC, so they are baked into ONE GPU mesh at startup (see main) and
# drawn in a single call per frame — no per-frame per-tile work. The frame loop only drives the
# camera from the on-screen control panel: hold a button to move/rotate/zoom/pan continuously.
fn render_loop(meshes: MutVec Int, models: MutVec Int, cam: Cam) -> Unit !{IO} =
  do
    stop <- gfx.window_should_close()
    if stop then gfx.close_window()
    else
      do
        cam_apply(cam)
        gfx.frame_begin()
        draw_meshes(meshes, 0, chunk_count)
        # Trees on top of the baked terrain, before the water so an above-water tree is not tinted.
        # Each is one instanced draw call over its whole scattered batch.
        gfx.draw_trees_culled(tree_group_count)
        # Water surface last, so depth-testing lets land above sea level poke through the
        # translucent plane while it fills the valleys.
        gfx.draw_plane(0.0, water_y, 0.0, world_span, world_span, water_r, water_g, water_b, water_alpha)
        gfx.draw_fps(10, 10)
        # Camera control panel — left column rotates/tilts/zooms-in, right column pans/zooms-out.
        rl <- gfx.button_held(col_l, row0, btn_w, btn_h, "Rot L")
        rr <- gfx.button_held(col_l, row1, btn_w, btn_h, "Rot R")
        tu <- gfx.button_held(col_l, row2, btn_w, btn_h, "Tilt+")
        tdn <- gfx.button_held(col_l, row3, btn_w, btn_h, "Tilt-")
        zi <- gfx.button_held(col_l, row4, btn_w, btn_h, "Zoom+")
        pf <- gfx.button_held(col_r, row0, btn_w, btn_h, "Fwd")
        pb <- gfx.button_held(col_r, row1, btn_w, btn_h, "Back")
        pl <- gfx.button_held(col_r, row2, btn_w, btn_h, "Left")
        pr <- gfx.button_held(col_r, row3, btn_w, btn_h, "Right")
        zo <- gfx.button_held(col_r, row4, btn_w, btn_h, "Zoom-")
        gfx.frame_end()
        render_loop(meshes, models, drive_cam(cam, rl, rr, tu, tdn, zi, zo, pf, pb, pl, pr))

fn main() -> Unit !{IO} =
  do
    gfx.open_window(1000, 600, "Sprout — Loam terrain with rivers (drainage-routed)")
    gfx.set_target_fps(60)
    let cfg = Config(seed = world_seed, chunk_size = chunk_edge, octaves = noise_octaves,
                     lattice0 = noise_lattice0, elevation_levels = elevation_levels)
    gen_region(cfg, map_dir, region_chunks, region_chunks, 0, 0)
    w <- world_new(cfg, map_dir)
    # Global hydrology pass over the whole region (same cfg + span as the terrain), computed once
    # upfront. flow_tier lines up cell-for-cell with the generated tiles.
    h <- compute_hydrology(cfg, span_tiles)
    # Materialise the global band+tag grid, then bake each chunk into its OWN top-surface mesh (top
    # quad + exposed step walls only; river cells recoloured by tier). Per-chunk meshes let the frame
    # loop frustum-cull off-screen chunks — the win when zoomed in.
    bands <- mutmatrix_new(span_tiles, span_tiles, 0)
    tags <- mutmatrix_new(span_tiles, span_tiles, 0)
    build_grids(w, bands, tags, chunk_edge, region_chunks, region_chunks, 0, 0)
    meshes <- mutvec_new(chunk_count, -1)
    bake_region(bands, tags, h, span_tiles, chunk_edge, region_chunks, region_chunks, meshes, 0, 0)
    # Load the vegetation models and scatter biome-appropriate trees over the region ONCE (the pass
    # queues GPU instances; the frame loop just replays them). Models load after the GL context.
    models <- mutvec_new(tree_count, 0)
    load_trees(models)
    place_region(models, w, h, chunk_edge, region_chunks, region_chunks, 0, 0)
    render_loop(meshes, models, cam_start)
