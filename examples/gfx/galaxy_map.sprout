module examples.gfx.galaxy_map

import stdlib.gfx
import stdlib.string (split_once)
import stdlib.math (min, pi, sin, cos)
import stdlib.json as json
import stdlib.process (proc_run)
import loam.camera (Cam, cam_drive, cam_distance)
import loam.view (cam_apply)
import loam.config (parse_config, cfg_int)
import loam.galaxy_lod (pow2, level_offset, group_of, clampi, desired_level, next_level, tile_index_i)
import loam.galaxy_filter (num_classes, mask_all, mask_none, bit_test, bit_toggle, popcount, class_name, class_rgb)
import loam.orbit (ellipse_point)

# Sprout / Loam — 3D GALAXY MAP (scene 1) with zoom-adaptive streaming.
#
# Renders a star catalog exported from ~/GameDev/universegen (1,000,000 systems) as an instanced 3D
# point cloud you can orbit, tilt, zoom and pan. Stars are coloured by spectral class; black holes
# are the violet/magenta landmarks (the supermassive one sits at the galactic centre).
#
# STREAMING / LoD. The catalog is a quadtree pyramid over the galactic plane (levels L0..L4). Each
# star lives at exactly ONE level (incremental refinement: brightest promoted to coarse levels), so
# the stars visible in a region at detail level L are the UNION of that region's tiles at levels
# 0..L. Every tile has a PERMANENT instance group (id = level_offset(level) + iy*2^level + ix); we
# lazy-load each tile once (throttled to load_budget/frame) and never evict — 341 tiles fit well
# under the 4096-group cap and ~64 MB of transforms. Because levels occupy contiguous ascending
# group ranges, draw_instances(level_offset(L+1), ...) draws EXACTLY levels 0..L — so the zoom-
# derived level is both what we stream and what we draw, and the engine frustum-culls the rest.
#
# Axis map: galaxy (x,y) -> world (x,z), galaxy z -> world height. The disk lies on the ground plane
# so the free-look camera's ground pan glides across it and tilt reveals the halo.
#
# SPECTRAL-CLASS FILTER (scene 1). The right-side legend is 12 clickable class checkboxes (multiselect)
# + All/None; scene 1 draws only the enabled classes via gfx.draw_instances_masked (model index ==
# classCode, so the mask enables whole classes — nearly free, as the draw already batches per model).
# The filter needs a class-BALANCED catalog: the raw universegen catalog is brightest-first (L0 holds
# zero M/F/G/K stars, so filtering to a dim class over it is a blank screen). The demo builds one at
# STARTUP — `ensure_balanced` re-pyramids the catalog per class into `<catalog>-balanced` and caches it
# (rebuilt only if that dir is absent) — so there is no separate tool or just recipe. See the
# "Class-balanced catalog" section below and docs/galaxy-map-demo-v0.md.
#
# Catalog line:  id|xi|yi|zi|classCode|sizeCode|name|detailLine   (xi,yi,zi in integer light-years)
# Produced by `cabal run catalog` in the universegen repo.
#
# Run (pass the SOURCE catalog directory as the first arg; the balanced cache is built on first run):
#   mise exec -- just run-gfx examples/gfx/galaxy_map.sprout ~/GameDev/universegen/catalog
# Canary + screenshot (argv[7] = initial class mask, e.g. 64 = M-only):
#   SPROUT_GFX_MAX_FRAMES=120 SPROUT_GFX_SCREENSHOT=galaxy.png \
#     mise exec -- just run-gfx examples/gfx/galaxy_map.sprout ~/GameDev/universegen/catalog 85000 14000 700 0 0 -1 64

# --- Tunables (compile-time; a .conf loader is a later-stage polish) --------------------------------
let default_catalog = "catalog"  # relative fallback; the real catalog dir is passed as argv[0]

let star_scale = 1.0  # per-star render radius = sizeCode (ly) * this * level falloff (see star_size).
let near_plane = 5.0
let far_plane = 400000.0  # a galaxy is ~100k ly across; the default 1000 far plane would clip it

let init_radius = 90000.0  # opening camera: pulled back to frame the whole ~50k-ly-radius disk
let init_height = 90000.0
let init_yaw = 0.5

let zoom_min = 300.0
let zoom_max = 260000.0
let pan_bound = 60000.0
let pitch_min = 0.03
let pitch_max = 1.52

let drag_yaw_step = 0.005  # radians per pixel of horizontal drag
let drag_pitch_step = 0.005  # radians per pixel of vertical drag
let wheel_zoom_frac = 0.12  # zoom step as a fraction of current eye distance per wheel notch
let key_pan_frac = 0.02  # WASD pan per frame as a fraction of eye distance
let drag_pan_frac = 0.0018  # shift-drag pan per pixel as a fraction of eye distance

# --- Scene 2 (solar-system view) tunables -------------------------------------------------------
# Systems vary wildly in extent (this catalog has compact 0.5-AU systems and spread 30-AU ones), so
# the AU->world scale is FIT per system: the outer orbit maps to `fit_world_radius`, and body sizes
# stay in fixed world units. That frames every system the same way regardless of its AU span.
let fit_world_radius = 520.0  # world radius the outermost orbit's apoapsis is scaled to
let sun_size = 18.0  # star render radius (world units); small enough not to swallow inner orbits
let planet_size_scale = 6.0  # planet render radius (world units) = radiusEarths * this
let planet_min_size = 3.5  # floor so sub-Earth planets stay visible
let orbit_segments = 96  # line segments per orbit ellipse (loam.orbit sampled at 2pi/segments)
let ring_segments = 48  # segments in a planet's ring circle
let ring_scale = 1.9  # ring radius = planet render radius * this
let moon_offset = 12.0  # world-unit gap from a planet's surface to its (schematic) moon dots
let moon_size = 2.2  # moon dot render radius (world units)
let s2_pick_r2 = 400.0  # 20px hover radius (squared) for the scene-2 planet detail panel
let s2_init_radius = 900.0  # opening scene-2 camera: angled overhead of the system at origin
let s2_init_height = 520.0
let s2_zoom_min = 60.0
let s2_zoom_max = 8000.0
let s2_pan_bound = 2500.0

let stream_max_level = 4  # deepest catalog level (matches the exporter's populated depth)
let lod_hysteresis = 0.15  # deadband (fraction of a boundary) so the LoD level never flip-flops on a zoom boundary
let load_budget = 6  # max NEW tiles read per frame — throttles streaming so it never hitches
let neighbor_radius = 1  # (2r+1)^2 block of tiles loaded per level around the camera target
let draw_cull = 0.0  # 0 = frustum-only; group_count already bounds the levels drawn

# --- Spectral-class filter legend (scene 1) -----------------------------------------------------
# A right-side stack of 12 clickable class checkboxes (multiselect): the box is filled with the class
# colour when ON, dark when OFF, so it doubles as the palette swatch. Below the rows sit All / None.
# The demo streams a class-BALANCED catalog (built at startup by ensure_balanced) so every class has
# galaxy-wide coverage at every zoom — the filter draws only the enabled classes via draw_instances_masked.
let leg_x = 1038  # left edge of the legend panel (also the click hit-test left bound)
let leg_y = 62  # top of the first class row
let leg_w = 234  # panel width for the click hit-test
let leg_rh = 30  # per-class row height
let leg_btn_y = leg_y + (num_classes * leg_rh) + 6  # All / None buttons sit just below the 12 rows

fn bd(b: Bool) -> Double = if b then 1.0 else 0.0

# --- Star colour palette: one sphere model per classCode (0..11) --------------------------------
# The instance shader colours per MODEL, so we create the models in class order (handle == classCode).
# Colours come from loam.galaxy_filter.class_rgb — the SINGLE source shared with the filter legend, so
# a star and its checkbox swatch can never disagree. Black-hole classes (9..11) are deliberately
# violet/magenta so they read as exotic landmarks. Created in ascending order so handle == classCode.
fn make_models_from(c: Int) -> Unit !{IO} =
  if c >= num_classes then ()
  else
    match class_rgb(c) with
    | (r, g, b) ->
        do
          _h <- gfx.star_model(r, g, b)
          make_models_from(c + 1)

fn make_models() -> Unit !{IO} = make_models_from(0)

# --- Tile / group math ---------------------------------------------------------------------------
# The pure quadtree math (pow2, level_offset, group_of, clampi, desired_level) lives in the
# graphics-free, headless-tested loam.galaxy_lod. tile_index adds the one impure step — a Double->Int
# floor via gfx.double_to_int (the core stdlib has no such conversion yet) — so it stays here.
fn tile_index(coord: Double, level: Int, radius: Double) -> Int =
  let n = pow2(level)
      raw = gfx.double_to_int((coord + radius) / (2.0 * radius) * to_double(n))
  in clampi(raw, 0, n - 1)

# Per-star render scale for a tile at `level`. A quadtree halves linear tile spacing per level, so
# dividing the render radius by 2^level keeps the star-radius-to-neighbour-spacing ratio roughly
# constant at every depth: the brightest L0 stars stay large landmarks, while the dense deep-level
# stars shrink to fine dots instead of merging into a solid carpet. It also softens LoD pop-in —
# a level that streams in on zoom arrives as small points, not full-size balls.
fn star_size(level: Int) -> Double =
  star_scale / to_double(pow2(level))

fn tile_path(dir: String, level: Int, ix: Int, iy: Int) -> String =
  dir ++ "/L" ++ to_string(level) ++ "/tile_" ++ to_string(ix) ++ "_" ++ to_string(iy) ++ ".txt"

# --- Catalog parsing ----------------------------------------------------------------------------
# Split a pipe-delimited line into fields. detailLine (last) never contains '|'.
fn split_pipe(s: String) -> List String =
  match split_once(s, "|") with
  | Nothing -> Cons(s, Nil)
  | Just (h, rest) -> Cons(h, split_pipe(rest))

# Push one parsed star into instance group `group` (model = classCode, per-star size = scale).
# Galaxy (x,y,z) -> world (x, z, y): the disk lands on the ground plane, halo z becomes height.
fn push_fields(fields: List String, group: Int, sscale: Double) -> Unit !{IO} =
  match fields with
  | [_id, xs, ys, zs, cs, szs | _] ->
      match (parse_int(xs), parse_int(ys), parse_int(zs), parse_int(cs), parse_int(szs)) with
      | (Just xi, Just yi, Just zi, Just ci, Just szi) ->
          gfx.instance_push(group, ci, to_double(xi), to_double(zi), to_double(yi),
                            0.0, to_double(szi) * sscale)
      | _ -> ()
  | _ -> ()

# Push every star line of a tile. Lines come from str_split_lines (a C extern, O(n)); the pure-Sprout
# string_lines is O(n^2) on a ~600 KB tile (char-at per index) and made streaming grind for minutes.
fn push_lines(lines: List String, group: Int, sscale: Double) -> Unit !{IO} =
  match lines with
  | Nil -> ()
  | Cons line rest ->
      do
        push_fields(split_pipe(line), group, sscale)
        push_lines(rest, group, sscale)

# --- Streaming: lazy-load tiles near the camera, once each, throttled ---------------------------
# Load a single tile into its permanent group if not already loaded and budget remains. A missing
# tile (sparse deep grid) is marked loaded without spending budget, so it is never retried. Returns
# the updated (loaded set, remaining budget).
fn load_one(dir: String, level: Int, ix: Int, iy: Int, loaded: Dict Int, budget: Int) -> (Dict Int, Int) !{IO} =
  if budget <= 0 then (loaded, budget)
  else
    let gid = group_of(level, ix, iy)
        key = to_string(gid)
    in match dict_get(key, loaded) with
       | Just _ -> (loaded, budget)
       | Nothing ->
           match read_file(tile_path(dir, level, ix, iy)) with
           | Err _ -> (dict_set(key, 1, loaded), budget)
           | Ok text ->
               do
                 push_lines(str_split_lines(text), gid, star_size(level))
                 (dict_set(key, 1, loaded), budget - 1)

# A row (dj sweep) then the block (di sweep) of tiles around (cx, cy) at one level.
fn load_row(dir: String, level: Int, cx: Int, cy: Int, di: Int, dj: Int, loaded: Dict Int, budget: Int) -> (Dict Int, Int) !{IO} =
  if dj > neighbor_radius then (loaded, budget)
  else
    let n = pow2(level)
        ix = clampi(cx + di, 0, n - 1)
        iy = clampi(cy + dj, 0, n - 1)
    in match load_one(dir, level, ix, iy, loaded, budget) with
       | (l2, b2) -> load_row(dir, level, cx, cy, di, dj + 1, l2, b2)

fn load_cols(dir: String, level: Int, cx: Int, cy: Int, di: Int, loaded: Dict Int, budget: Int) -> (Dict Int, Int) !{IO} =
  if di > neighbor_radius then (loaded, budget)
  else
    match load_row(dir, level, cx, cy, di, 0 - neighbor_radius, loaded, budget) with
    | (l2, b2) -> load_cols(dir, level, cx, cy, di + 1, l2, b2)

# Load the focus block at every level 0..maxlvl (the additive union that covers the region).
fn load_levels(dir: String, cam: Cam, maxlvl: Int, level: Int, radius: Double, loaded: Dict Int, budget: Int) -> (Dict Int, Int) !{IO} =
  if level > maxlvl then (loaded, budget)
  else
    let cx = tile_index(cam.tx, level, radius)
        cy = tile_index(cam.tz, level, radius)
    in match load_cols(dir, level, cx, cy, 0 - neighbor_radius, loaded, budget) with
       | (l2, b2) -> load_levels(dir, cam, maxlvl, level + 1, radius, l2, b2)

# --- Picking: on right-click, re-read the focus tiles and select the star nearest the cursor ------
# A click is rare, so rather than retain every streamed star we re-parse the focus tiles on demand
# and project each star to the screen (gfx.world_to_screen). `best` threads the nearest hit so far as
# (screen-distance^2, name, detailLine). Every arm is !{IO} (via keep_best) so the effect rows unify.
let pick_radius2 = 900.0  # 30px selection radius, squared
let pick_far = 100000000.0  # sentinel screen-distance^2 (Sprout has no 1e8 exponent literal):
                                # larger than any on-screen distance^2, so any real hit beats it

# Lift a pure "keep the current best" into !{IO} so it unifies with the projecting arms.
fn keep_best(best: (Double, String, String)) -> (Double, String, String) !{IO} =
  do
    _t <- gfx.get_time()
    best

# `mask` is threaded through the whole pick chain so a click can only select a star whose spectral
# class is currently VISIBLE — right-clicking never picks a filtered-out (undrawn) star.
fn pick_line(line: String, mx: Double, my: Double, mask: Int, best: (Double, String, String)) -> (Double, String, String) !{IO} =
  match split_pipe(line) with
  | [_id, xs, ys, zs, cs, _szs, name, detail | _] ->
      match (parse_int(xs), parse_int(ys), parse_int(zs), parse_int(cs)) with
      | (Just xi, Just yi, Just zi, Just ci) ->
          if ! bit_test (mask, ci) then keep_best(best)  # class filtered out — not selectable
          else
            do
              front <- gfx.world_to_screen(to_double(xi), to_double(zi), to_double(yi))
              sx <- gfx.projected_x()
              sy <- gfx.projected_y()
              let d2 = if front then ((sx - mx) * (sx - mx)) + ((sy - my) * (sy - my)) else pick_far
              match best with
              | (bd0, bn, bdt) -> if d2 < bd0 then (d2, name, detail) else (bd0, bn, bdt)
      | _ -> keep_best(best)
  | _ -> keep_best(best)

fn pick_lines(lines: List String, mx: Double, my: Double, mask: Int, best: (Double, String, String)) -> (Double, String, String) !{IO} =
  match lines with
  | Nil -> keep_best(best)
  | Cons line rest ->
      do
        b2 <- pick_line(line, mx, my, mask, best)
        pick_lines(rest, mx, my, mask, b2)

fn pick_tile(dir: String, level: Int, ix: Int, iy: Int, mx: Double, my: Double, mask: Int, best: (Double, String, String)) -> (Double, String, String) !{IO} =
  match read_file(tile_path(dir, level, ix, iy)) with
  | Err _ -> keep_best(best)
  | Ok text -> pick_lines(str_split_lines(text), mx, my, mask, best)

fn pick_row(dir: String, level: Int, cx: Int, cy: Int, di: Int, dj: Int, mx: Double, my: Double, mask: Int, best: (Double, String, String)) -> (Double, String, String) !{IO} =
  if dj > neighbor_radius then keep_best(best)
  else
    let n = pow2(level)
        ix = clampi(cx + di, 0, n - 1)
        iy = clampi(cy + dj, 0, n - 1)
    in do
         b2 <- pick_tile(dir, level, ix, iy, mx, my, mask, best)
         pick_row(dir, level, cx, cy, di, dj + 1, mx, my, mask, b2)

fn pick_cols(dir: String, level: Int, cx: Int, cy: Int, di: Int, mx: Double, my: Double, mask: Int, best: (Double, String, String)) -> (Double, String, String) !{IO} =
  if di > neighbor_radius then keep_best(best)
  else
    do
      b2 <- pick_row(dir, level, cx, cy, di, 0 - neighbor_radius, mx, my, mask, best)
      pick_cols(dir, level, cx, cy, di + 1, mx, my, mask, b2)

fn pick_levels(dir: String, cam: Cam, maxlvl: Int, level: Int, radius: Double, mx: Double, my: Double, mask: Int, best: (Double, String, String)) -> (Double, String, String) !{IO} =
  if level > maxlvl then keep_best(best)
  else
    let cx = tile_index(cam.tx, level, radius)
        cy = tile_index(cam.tz, level, radius)
    in do
         b2 <- pick_cols(dir, level, cx, cy, 0 - neighbor_radius, mx, my, mask, best)
         pick_levels(dir, cam, maxlvl, level + 1, radius, mx, my, mask, b2)

# Run a pick this frame only on `do_pick`; otherwise keep the current selection. Factored out so the
# call site binds a plain function (binding an `if` via `<-` does not parse).
fn maybe_pick(do_pick: Bool, dir: String, cam: Cam, maxlvl: Int, radius: Double,
              mx: Double, my: Double, mask: Int, seed: (Double, String, String)) -> (Double, String, String) !{IO} =
  if do_pick then pick_levels(dir, cam, maxlvl, 0, radius, mx, my, mask, seed)
  else keep_best(seed)

# Catalog directory from argv[0], else the built-in default (matched directly — argv_get returns
# Maybe X !{IO}, and binding via `<-` would mis-strip the Maybe, per loam/terrain.sprout).
fn catalog_dir() -> String !{IO} =
  match argv_get(0) with
  | Just p ->
      do
        print("[galaxy] catalog dir: " ++ p)
        p
  | Nothing ->
      do
        print("[galaxy] No catalog directory given. Pass one as the first argument, e.g.:")
        print("[galaxy]   just run-gfx examples/gfx/galaxy_map.sprout <path>/catalog")
        print("[galaxy] Falling back to ./" ++ default_catalog)
        default_catalog

# Optional integer camera override from argv[idx] (falls back to `dflt`). Lets a screenshot/canary
# run script the opening camera without a rebuild, e.g.
#   just run-gfx examples/gfx/galaxy_map.sprout <catalog> <radius> <height> <yaw_milli> <tx> <tz>
# All values are integer light-years except yaw, which is milliradians (500 = 0.5 rad). Absent args
# keep the init_* defaults, so the plain `run-gfx <catalog>` invocation is unchanged.
fn arg_int(idx: Int, dflt: Int) -> Int !{IO} =
  match argv_get(idx) with
  | Nothing -> dflt
  | Just s ->
      match parse_int(s) with
      | Just n -> n
      | Nothing -> dflt

# Galaxy radius from the catalog meta.txt (key/value ints), so tile binning matches the exporter.
fn read_radius(dir: String) -> Double !{IO} =
  match read_file(dir ++ "/meta.txt") with
  | Ok text -> to_double(cfg_int(parse_config(text), "galaxy_radius_ly", 50000))
  | Err _ -> 50000.0

# --- Class-balanced catalog: build-once-and-cache at startup (for the spectral-class filter) -----
# The raw universegen catalog is BRIGHTEST-FIRST, so its coarse levels are all bright classes — L0
# holds zero M/F/G/K/A stars, and filtering to a dim class over it is a BLANK screen zoomed out (M
# dwarfs are 74% of all stars). ensure_balanced re-pyramids the catalog PER CLASS (shallowest-fit with
# a PER-CLASS per-tile budget), so every class fills the coarse levels first and appears galaxy-wide at
# every zoom. It runs at startup (before the window opens), consumes the CATALOG not galaxy.json (so
# universegen is untouched), and is headless — integer-ly coords bin with the pure tile_index_i, no
# double_to_int. Output is cached in `<src>-balanced` (a SIBLING of src, so `<dir>/../systems` still
# resolves for scene 2); it is rebuilt only when the cache's meta.txt is absent — delete that dir to
# force a rebuild. TRADEOFF: the catalog dropped luminosity, so within-class order is a spatial sample
# (as-encountered), not brightest-first (fine for an overview); the per-class budget caps deep M
# density and bounds memory (overflow past the deepest level is dropped). See docs/galaxy-map-demo-v0.md.
let rebalance_budget = 800  # stars kept per class, per tile — L0 gets <= this of each class

fn read_radius_i(dir: String) -> Int !{IO} =
  match read_file(dir ++ "/meta.txt") with
  | Ok text -> cfg_int(parse_config(text), "galaxy_radius_ly", 50000)
  | Err _ -> 50000

# Parse just the fields tiling needs from a catalog line: (xi, yi, classCode). Nothing if malformed.
fn line_key(line: String) -> Maybe (Int, Int, Int) =
  match split_pipe(line) with
  | [_id, xs, ys, _zs, cs | _] ->
      match (parse_int(xs), parse_int(ys), parse_int(cs)) with
      | (Just xi, Just yi, Just ci) -> Just((xi, yi, ci))
      | _ -> Nothing
  | _ -> Nothing

# Packed count key, one slot per (tile-group, class): gid < 341, class < 12, so gid*12+class is unique.
fn count_key(gid: Int, cls: Int) -> String = to_string((gid * num_classes) + cls)
fn get_count(counts: Dict Int, gid: Int, cls: Int) -> Int =
  match dict_get(count_key(gid, cls), counts) with
  | Just n -> n
  | Nothing -> 0

# Shallowest level in [0, stream_max_level] whose (level, tile, class) bucket still has room, or -1 if
# the star overflows every level (dropped). Shallowest-fit like the exporter, but the budget is PER
# CLASS — that is what forces every class into the coarse levels rather than only the brightest.
fn fit_level(xi: Int, yi: Int, cls: Int, radius: Int, counts: Dict Int, level: Int) -> Int =
  if level > stream_max_level then 0 - 1
  else
    let gid = group_of(level, tile_index_i(xi, level, radius), tile_index_i(yi, level, radius))
    in if get_count(counts, gid, cls) < rebalance_budget then level
       else fit_level(xi, yi, cls, radius, counts, level + 1)

fn get_tile_lines(out: Dict (List String), gid: Int) -> List String =
  match dict_get(to_string(gid), out) with
  | Just ls -> ls
  | Nothing -> Nil

# Place one line into its shallowest-fitting (level, tile) at its class budget; drop on overflow.
fn place_line(line: String, radius: Int, st: (Dict Int, Dict (List String))) -> (Dict Int, Dict (List String)) =
  match st with
  | (counts, out) ->
      match line_key(line) with
      | Nothing -> (counts, out)
      | Just (xi, yi, cls) ->
          let level = fit_level(xi, yi, cls, radius, counts, 0)
          in if level < 0 then (counts, out)
             else
               let gid = group_of(level, tile_index_i(xi, level, radius), tile_index_i(yi, level, radius))
                   counts2 = dict_set(count_key(gid, cls), get_count(counts, gid, cls) + 1, counts)
                   out2 = dict_set(to_string(gid), Cons(line, get_tile_lines(out, gid)), out)
               in (counts2, out2)

fn fold_lines(lines: List String, radius: Int, st: (Dict Int, Dict (List String))) -> (Dict Int, Dict (List String)) =
  match lines with
  | Nil -> st
  | Cons line rest -> fold_lines(rest, radius, place_line(line, radius, st))

# Read + fold one source tile (a missing tile in the sparse deep grid is skipped, not an error).
fn rb_tile(src: String, radius: Int, level: Int, ix: Int, iy: Int, st: (Dict Int, Dict (List String))) -> (Dict Int, Dict (List String)) !{IO} =
  match read_file(tile_path(src, level, ix, iy)) with
  | Err _ -> st
  | Ok text -> fold_lines(str_split_lines(text), radius, st)

fn rb_row(src: String, radius: Int, level: Int, ix: Int, iy: Int, n: Int, st: (Dict Int, Dict (List String))) -> (Dict Int, Dict (List String)) !{IO} =
  if iy >= n then st
  else
    do
      st2 <- rb_tile(src, radius, level, ix, iy, st)
      rb_row(src, radius, level, ix, iy + 1, n, st2)

fn rb_cols(src: String, radius: Int, level: Int, ix: Int, n: Int, st: (Dict Int, Dict (List String))) -> (Dict Int, Dict (List String)) !{IO} =
  if ix >= n then st
  else
    do
      st2 <- rb_row(src, radius, level, ix, 0, n, st)
      rb_cols(src, radius, level, ix + 1, n, st2)

fn rb_levels(src: String, radius: Int, level: Int, st: (Dict Int, Dict (List String))) -> (Dict Int, Dict (List String)) !{IO} =
  if level > stream_max_level then st
  else
    do
      print("[galaxy] rebalance: scanning source L" ++ to_string(level) ++ " ...")
      st2 <- rb_cols(src, radius, level, 0, pow2(level), st)
      rb_levels(src, radius, level + 1, st2)

# Write one output tile from its accumulated lines (skip empty — matches the sparse source layout).
fn rb_write_tile(cache: String, out: Dict (List String), level: Int, ix: Int, iy: Int) -> Unit !{IO} =
  let gid = group_of(level, ix, iy)
  in match get_tile_lines(out, gid) with
     | Nil -> ()
     | ls ->
         match write_file(tile_path(cache, level, ix, iy), string_join_newlines(ls)) with
         | Ok _ -> ()
         | Err e -> print("[galaxy] rebalance WRITE FAILED " ++ tile_path(cache, level, ix, iy) ++ ": " ++ e)

fn rb_write_row(cache: String, out: Dict (List String), level: Int, ix: Int, iy: Int, n: Int) -> Unit !{IO} =
  if iy >= n then ()
  else
    do
      rb_write_tile(cache, out, level, ix, iy)
      rb_write_row(cache, out, level, ix, iy + 1, n)

fn rb_write_cols(cache: String, out: Dict (List String), level: Int, ix: Int, n: Int) -> Unit !{IO} =
  if ix >= n then ()
  else
    do
      rb_write_row(cache, out, level, ix, 0, n)
      rb_write_cols(cache, out, level, ix + 1, n)

fn rb_write_levels(cache: String, out: Dict (List String), level: Int) -> Unit !{IO} =
  if level > stream_max_level then ()
  else
    do
      rb_write_cols(cache, out, level, 0, pow2(level))
      rb_write_levels(cache, out, level + 1)

# Copy meta.txt verbatim: the balanced catalog is self-contained (same radius the demo bins with) AND
# meta.txt is the cache-present sentinel (ensure_balanced rebuilds only when it is absent).
fn copy_meta(src: String, cache: String) -> Unit !{IO} =
  match read_file(src ++ "/meta.txt") with
  | Err _ -> print("[galaxy] rebalance WARN: no meta.txt in source; balanced catalog falls back to defaults")
  | Ok text ->
      match write_file(cache ++ "/meta.txt", text) with
      | Ok _ -> ()
      | Err e -> print("[galaxy] rebalance WRITE FAILED meta.txt: " ++ e)

# `mkdir -p` the balanced level dirs (write_file does not create directories) by composing
# stdlib.process — no mkdir builtin needed (Builtin-vs-Stdlib rule 4; the compiler shells mkdir too).
fn level_dirs(cache: String, level: Int, acc: List String) -> List String =
  if level > stream_max_level then acc
  else level_dirs(cache, level + 1, Cons(cache ++ "/L" ++ to_string(level), acc))
fn make_dirs(cache: String) -> Unit !{IO} =
  do
    _r <- proc_run(Cons("mkdir", Cons("-p", level_dirs(cache, 0, Nil))))
    ()

fn build_balanced(src: String, cache: String) -> Unit !{IO} =
  do
    radius <- read_radius_i(src)
    print("[galaxy] rebalance: radius=" ++ to_string(radius) ++ " budget/class/tile=" ++ to_string(rebalance_budget))
    make_dirs(cache)
    final <- rb_levels(src, radius, 0, (dict_empty(), dict_empty()))
    match final with
    | (_, out) ->
        do
          copy_meta(src, cache)
          rb_write_levels(cache, out, 0)
          print("[galaxy] rebalance: done -> " ++ cache)

# Return the class-balanced catalog dir for `src`, building it once if the cache is absent. The cache
# `<src>-balanced` is a SIBLING of src, so the demo's scene-2 `<dir>/../systems` path still resolves.
fn ensure_balanced(src: String) -> String !{IO} =
  let cache = src ++ "-balanced"
  in match read_file(cache ++ "/meta.txt") with
     | Ok _ ->
         do
           print("[galaxy] using cached balanced catalog: " ++ cache)
           cache
     | Err _ ->
         do
           print("[galaxy] building class-balanced catalog (one-time, ~15s) -> " ++ cache)
           build_balanced(src, cache)
           cache

# --- Scene 2: solar-system view -----------------------------------------------------------------
# A planet reduced to what the view draws and reports: orbit shape (semi-major AU `a`, eccentricity
# `e`, argument of periapsis `argperi` rad), current position (`nu` = true anomaly rad), body size
# (`rad` = radiusEarths), `rings`/`moons` (needed by the renderer), and `name` + a PRE-FORMATTED
# `detail` line for the panel. Type/mass/temperature are folded into `detail` at parse time — the
# same trick the star catalog uses — to stay within the 10-field constructor-arity ceiling.
type Planet = (a: Double, e: Double, argperi: Double, nu: Double, rad: Double,
               rings: Bool, moons: Int, name: String, detail: String)

let two_pi = 2.0 * pi
fn deg2rad(d: Double) -> Double = d * pi / 180.0
fn max_d(a: Double, b: Double) -> Double = if a > b then a else b

# Zero-pad a small non-negative Int to 3 digits (block-000 .. block-099) for the systems/ path.
fn pad3(n: Int) -> String =
  let s = to_string(n)
  in if str_len(s) >= 3 then s else if str_len(s) == 2 then "0" ++ s else "00" ++ s

# The catalog `name` / JSON file stem is SYS-%05d (SYS-00001 .. SYS-135793). pad5 rebuilds it from a
# raw id — used only by the argv[6] "open directly into system view" screenshot/canary affordance.
fn pad5(n: Int) -> String =
  let s = to_string(n)
  in if str_len(s) >= 5 then s
     else if str_len(s) == 4 then "0" ++ s
     else if str_len(s) == 3 then "00" ++ s
     else if str_len(s) == 2 then "000" ++ s
     else "0000" ++ s

# Path to a system's JSON from its catalog `name` (== the file stem, e.g. "SYS-00001"). The systems/
# tree is a sibling of the catalog dir; block = floor(id/10000), zero-padded to 3. Nothing if `name`
# is not a "SYS-<id>" stem (e.g. the "No system selected" sentinel).
fn sys_path(dir: String, name: String) -> Maybe String =
  if ! str_starts_with (name, "SYS-") then Nothing
  else
    match parse_int(str_slice(name, 4, str_len(name))) with
    | Nothing -> Nothing
    | Just id -> Just(dir ++ "/../systems/block-" ++ pad3(id / 10000) ++ "/" ++ name ++ ".json")

# Read one Double field of a JSON object, falling back to `dflt` if absent/not a number.
fn jfield_double(obj: json.Json, key: String, dflt: Double) -> Double =
  let Just v = json.json_get_field(obj, key) else dflt
      Just x = json.json_get_float(v) else dflt
  in x

fn jfield_string(obj: json.Json, key: String, dflt: String) -> String =
  let Just v = json.json_get_field(obj, key) else dflt
      Just s = json.json_get_string(v) else dflt
  in s

fn jfield_bool(obj: json.Json, key: String) -> Bool =
  let Just v = json.json_get_field(obj, key) else false
      Just b = json.json_get_bool(v) else false
  in b

fn json_array_len(arr: json.JsonArray, acc: Int) -> Int =
  match json.json_array_next(arr) with
  | Nothing -> acc
  | Just step ->
      match step with
      | json.JsonArrayStep _head tail -> json_array_len(tail, acc + 1)

# Length of an array-valued field (0 if absent/not an array) — used for the moon count.
fn jfield_count(obj: json.Json, key: String) -> Int =
  let Just v = json.json_get_field(obj, key) else 0
      Just arr = json.json_get_array(v) else 0
  in json_array_len(arr, 0)

fn planet_of(j: json.Json) -> Planet =
  let rad = jfield_double(j, "radiusEarths", 1.0)
      a = jfield_double(j, "orbitSemiMajorAU", 1.0)
      ptype = jfield_string(j, "planetType", "?")
      mass = jfield_double(j, "massEarths", 0.0)
      temp = jfield_double(j, "surfaceTemperatureK", 0.0)
  in Planet(a = a,
            e = jfield_double(j, "eccentricity", 0.0),
            argperi = deg2rad(jfield_double(j, "argumentOfPeriapsisDeg", 0.0)),
            nu = deg2rad(jfield_double(j, "trueAnomalyDeg", 0.0)),
            rad = rad,
            rings = jfield_bool(j, "hasRings"),
            moons = jfield_count(j, "moons"),
            name = jfield_string(j, "planetName", "?"),
            detail = ptype ++ "   R " ++ to_string(rad) ++ " Re   M " ++ to_string(mass)
                       ++ " Me   " ++ to_string(temp) ++ " K   a " ++ to_string(a) ++ " AU")

fn planets_from_array(arr: json.JsonArray) -> List Planet =
  match json.json_array_next(arr) with
  | Nothing -> Nil
  | Just step ->
      match step with
      | json.JsonArrayStep head tail -> Cons(planet_of(head), planets_from_array(tail))

# Load a system's planets from its JSON (pure: read_file/json.parse are Result-typed). Any failure
# along the way — no path, unreadable file, parse error, missing "planets" array — yields Nil (the
# scene then draws just the star). Uses the pure-Sprout float-capable json_parse.
fn load_planets(dir: String, name: String) -> List Planet =
  let Just path = sys_path(dir, name) else Nil
      Ok text = read_file(path) else Nil
      Ok root = json.parse(text) else Nil
      Just pv = json.json_get_field(root, "planets") else Nil
      Just arr = json.json_get_array(pv) else Nil
  in planets_from_array(arr)

# Outer extent of a system in AU (max apoapsis a(1+e)), floored so a planetless system still frames.
fn orbit_extent(ps: List Planet, acc: Double) -> Double =
  match ps with
  | Nil -> acc
  | Cons p rest -> orbit_extent(rest, max_d(acc, p.a * (1.0 + p.e)))

# One orbit segment between true anomalies t0..t1, in world units (`scale` = world units per AU;
# orbital plane laid on world x/z).
fn draw_seg(scale: Double, a: Double, e: Double, argperi: Double, t0: Double, t1: Double) -> Unit !{IO} =
  match ellipse_point(a, e, argperi, t0) with
  | (x0, z0) ->
      match ellipse_point(a, e, argperi, t1) with
      | (x1, z1) ->
          gfx.draw_line3d(x0 * scale, 0.0, z0 * scale, x1 * scale, 0.0, z1 * scale, 90, 110, 150)

fn orbit_seg(scale: Double, a: Double, e: Double, argperi: Double, i: Int) -> Unit !{IO} =
  if i >= orbit_segments then ()
  else
    do
      draw_seg(scale, a, e, argperi,
               to_double(i) * two_pi / to_double(orbit_segments),
               to_double(i + 1) * two_pi / to_double(orbit_segments))
      orbit_seg(scale, a, e, argperi, i + 1)

# Colour a planet by size: sub-2-Earth-radii read as rocky (brown), larger as gas/ice (pale).
fn planet_rgb(rad: Double) -> (Int, Int, Int) =
  if rad < 2.0 then (190, 150, 120) else (200, 195, 150)

# A flat circle of `rr` around (cx, cz) on the world x/z plane — a planet's ring, as a line loop.
fn ring_seg(cx: Double, cz: Double, rr: Double, i: Int) -> Unit !{IO} =
  if i >= ring_segments then ()
  else
    do
      let a0 = to_double(i) * two_pi / to_double(ring_segments)
      let a1 = to_double(i + 1) * two_pi / to_double(ring_segments)
      gfx.draw_line3d(cx + (rr * cos(a0)), 0.0, cz + (rr * sin(a0)),
                      cx + (rr * cos(a1)), 0.0, cz + (rr * sin(a1)), 170, 160, 120)
      ring_seg(cx, cz, rr, i + 1)

# `count` schematic moon dots evenly spaced just outside the planet (real moon distances are far
# sub-pixel at system scale, so this indicates moon PRESENCE, not true geometry — see the panel/docs).
fn moon_dots(cx: Double, cz: Double, off: Double, count: Int, i: Int) -> Unit !{IO} =
  if i >= count then ()
  else
    do
      let ang = to_double(i) * two_pi / to_double(if count < 1 then 1 else count)
      gfx.draw_sphere(cx + (off * cos(ang)), 0.0, cz + (off * sin(ang)), moon_size, 180, 180, 195)
      moon_dots(cx, cz, off, count, i + 1)

fn draw_one_planet(scale: Double, p: Planet) -> Unit !{IO} =
  do
    orbit_seg(scale, p.a, p.e, p.argperi, 0)
    match ellipse_point(p.a, p.e, p.argperi, p.nu) with
    | (x, z) ->
        do
          let px = x * scale
          let pz = z * scale
          let prad = max_d(p.rad * planet_size_scale, planet_min_size)
          match planet_rgb(p.rad) with
          | (pr, pg, pb) -> gfx.draw_sphere(px, 0.0, pz, prad, pr, pg, pb)
          if p.rings then ring_seg(px, pz, prad * ring_scale, 0) else ()
          moon_dots(px, pz, prad + moon_offset, p.moons, 0)

fn draw_planets(scale: Double, ps: List Planet) -> Unit !{IO} =
  match ps with
  | Nil -> ()
  | Cons p rest ->
      do
        draw_one_planet(scale, p)
        draw_planets(scale, rest)

# AU->world scale fitting the outermost orbit to `fit_world_radius` (used for drawing AND hover
# projection, so both agree). Computed from the cached planet list in the render loop.
fn system_scale(ps: List Planet) -> Double =
  fit_world_radius / orbit_extent(ps, 0.2)

# Draw a system (already-parsed planets, pre-computed `scale`): star at the origin, then every
# planet's orbit + body + rings + moons. Planets are parsed once on entry and cached in the render
# loop — NOT re-read per frame (that dropped the frame rate).
fn draw_system(scale: Double, ps: List Planet) -> Unit !{IO} =
  do
    gfx.draw_star(0.0, 0.0, 0.0, sun_size, 255, 240, 180)
    draw_planets(scale, ps)

# --- Scene 2 hover: project each planet to screen, keep the one nearest the cursor for the detail
# panel. Mirrors the scene-1 pick, but over the in-memory (cached) planet list — no file re-read. ---
fn keep_np(bd2: Double, best: Maybe Planet) -> (Double, Maybe Planet) !{IO} =
  do
    _t <- gfx.get_time()
    (bd2, best)

fn planet_screen_d2(p: Planet, scale: Double, mx: Double, my: Double) -> Double !{IO} =
  match ellipse_point(p.a, p.e, p.argperi, p.nu) with
  | (x, z) ->
      do
        front <- gfx.world_to_screen(x * scale, 0.0, z * scale)
        sx <- gfx.projected_x()
        sy <- gfx.projected_y()
        if front then ((sx - mx) * (sx - mx)) + ((sy - my) * (sy - my)) else pick_far

fn nearest_planet(ps: List Planet, scale: Double, mx: Double, my: Double,
                  bd2: Double, best: Maybe Planet) -> (Double, Maybe Planet) !{IO} =
  match ps with
  | Nil -> keep_np(bd2, best)
  | Cons p rest ->
      do
        d2 <- planet_screen_d2(p, scale, mx, my)
        let nd = if d2 < bd2 then d2 else bd2
        let nb = if d2 < bd2 then Just(p) else best
        nearest_planet(rest, scale, mx, my, nd, nb)

# Factored so the call site binds a plain function (binding an `if` via `<-` does not parse).
fn maybe_hover(active: Bool, ps: List Planet, scale: Double, mx: Double, my: Double) -> (Double, Maybe Planet) !{IO} =
  if active then nearest_planet(ps, scale, mx, my, pick_far, Nothing)
  else keep_np(pick_far, Nothing)

fn planet_line1(p: Planet) -> String = p.name
fn planet_line2(p: Planet) -> String =
  p.detail ++ "   moons " ++ to_string(p.moons) ++ (if p.rings then "   (rings)" else "")

# Turn a hover result into the two panel lines, blank unless a planet is within the hover radius.
fn hover_lines(h: (Double, Maybe Planet)) -> (String, String) =
  match h with
  | (hd2, Just p) -> if hd2 < s2_pick_r2 then (planet_line1(p), planet_line2(p)) else ("", "")
  | (_, Nothing) -> ("", "")

# --- Spectral-class filter legend: draw + hit-test ----------------------------------------------
# One checkbox row for class `c`: box filled with the class colour when enabled, dark when disabled
# (so the box IS the palette swatch), and the class name bright when enabled, dim when not.
fn draw_legend_row(mask: Int, c: Int) -> Unit !{IO} =
  let ry = leg_y + (c * leg_rh)
  in match class_rgb(c) with
     | (r, g, b) ->
         do
           gfx.draw_rect(leg_x + 8, ry + 5, 18, 18, 200, 200, 210)  # box border
           if bit_test(mask, c)
             then gfx.draw_rect(leg_x + 10, ry + 7, 14, 14, r, g, b)
             else gfx.draw_rect(leg_x + 10, ry + 7, 14, 14, 40, 40, 48)
           if bit_test(mask, c)
             then gfx.draw_text(leg_x + 34, ry + 5, class_name(c), 18, 235, 235, 245)
             else gfx.draw_text(leg_x + 34, ry + 5, class_name(c), 18, 110, 110, 120)

fn draw_legend(mask: Int, c: Int) -> Unit !{IO} =
  if c >= num_classes then ()
  else
    do
      draw_legend_row(mask, c)
      draw_legend(mask, c + 1)

# Class index (0..num_classes-1) under screen pixel (mx, my), or -1 if the cursor is outside the rows.
# Pure integer math — the row is `(my - leg_y) / leg_rh` within the panel's x/y bounds.
fn legend_hit(mx: Int, my: Int) -> Int =
  if (mx >= leg_x) && (mx <= leg_x + leg_w) && (my >= leg_y) && (my < leg_y + (num_classes * leg_rh))
    then (my - leg_y) / leg_rh
    else 0 - 1

# An !{IO} `false` for the inactive branch of a conditional button (binding an `if` via `<-` does not
# parse, so the buttons — which must only draw in scene 1 — go through these plain helpers).
fn no_button() -> Bool !{IO} =
  do
    _t <- gfx.get_time()
    false
fn legend_all_btn(active: Bool) -> Bool !{IO} =
  if active then gfx.button(leg_x + 8, leg_btn_y, 106, 30, "All") else no_button()
fn legend_none_btn(active: Bool) -> Bool !{IO} =
  if active then gfx.button(leg_x + 120, leg_btn_y, 106, 30, "None") else no_button()

# --- Render loop --------------------------------------------------------------------------------
fn render_loop(dir: String, cam: Cam, scam: Cam, radius: Double, loaded: Dict Int,
               sel_name: String, sel_detail: String, prev_rdown: Bool, view: Int, prev_lvl: Int,
               csys: String, cplanets: List Planet, hov1: String, hov2: String,
               mask: Int, prev_ldown: Bool) -> Unit !{IO} =
  do
    stop <- gfx.window_should_close()
    if stop then gfx.close_window()
    else
      do
        let dist = cam_distance(cam)
        # Hysteretic LoD: step at most one level from the previously-committed level, and only once the
        # eye has moved a deadband PAST the boundary — so hovering on a zoom boundary can't flip-flop.
        let lvl = next_level(prev_lvl, dist, stream_max_level, lod_hysteresis)
        # Scene-2 planet cache: (re)parse the selected system's JSON only when it changes, so a static
        # system view runs at full frame rate instead of re-reading the file every frame.
        let need_load = (view == 1) && ! (sel_name == csys)
        let cplanets2 = if need_load then load_planets(dir, sel_name) else cplanets
        let csys2 = if need_load then sel_name else csys
        let s2scale = system_scale(cplanets2)
        streamed <- load_levels(dir, cam, lvl, 0, radius, loaded, load_budget)
        cam_apply(if view == 0 then cam else scam)
        gfx.frame_begin()
        # Scene 1 draws the galaxy point cloud, filtered to the enabled spectral classes (model index
        # == classCode, so the mask enables/disables whole classes); scene 2 draws the selected system.
        if view == 0 then gfx.draw_instances_masked(level_offset(lvl + 1), draw_cull, mask) else draw_system(s2scale, cplanets2)
        gfx.overlay_begin()
        gfx.draw_fps(10, 10)
        if view == 0
          then gfx.draw_text(10, 34, "drag: orbit/tilt   shift+drag / WASD: pan   wheel: zoom   right-click: inspect", 18, 180, 190, 210)
          else gfx.draw_text(10, 34, "SOLAR SYSTEM   drag: orbit/tilt   wheel: zoom   (< Galaxy to return)", 18, 255, 220, 120)
        if view == 0
          then gfx.draw_text(10, 56, "LoD level " ++ to_string(lvl), 18, 150, 200, 150)
          else gfx.draw_text(10, 56, "system " ++ sel_name, 18, 255, 230, 150)
        # Bottom-left panel: galaxy view shows the selected star; system view shows the hovered planet.
        if view == 0
          then
            do
              gfx.draw_text(20, 724, sel_name, 22, 255, 240, 170)
              gfx.draw_text(20, 752, sel_detail, 16, 200, 210, 230)
          else
            do
              gfx.draw_text(20, 724, if hov1 == "" then "hover a planet for details" else hov1, 20, 255, 240, 170)
              gfx.draw_text(20, 752, hov2, 15, 200, 210, 230)
        # Scene-1 spectral-class filter legend: header + 12 class checkboxes (drawn only in the galaxy view).
        if view == 0
          then
            do
              gfx.draw_text(leg_x + 8, leg_y - 26, "SPECTRAL CLASS  " ++ to_string(popcount(mask)) ++ "/" ++ to_string(num_classes), 16, 180, 190, 210)
              draw_legend(mask, 0)
          else ()
        # One scene-switch button; its label and action depend on the current view.
        let toggle_label = if view == 0 then "System >" else "< Galaxy"
        toggle <- gfx.button(1108, 728, 156, 46, toggle_label)
        # All / None mask presets (scene 1 only, via helpers so the buttons don't draw in scene 2).
        all_click <- legend_all_btn(view == 0)
        none_click <- legend_none_btn(view == 0)
        wheel <- gfx.mouse_wheel_y()
        ldown <- gfx.mouse_button_down(gfx.mouse_left)
        rdown <- gfx.mouse_button_down(gfx.mouse_right)
        mx <- gfx.mouse_x()
        my <- gfx.mouse_y()
        gdx <- gfx.mouse_delta_x()
        gdy <- gfx.mouse_delta_y()
        shift <- gfx.key_down(gfx.key_left_shift)
        kw <- gfx.key_down(gfx.key_w)
        ks <- gfx.key_down(gfx.key_s)
        ka <- gfx.key_down(gfx.key_a)
        kd <- gfx.key_down(gfx.key_d)
        gfx.frame_end()
        let do_pick = rdown && ! prev_rdown && (view == 0)
        let pseed = (pick_far, sel_name, sel_detail)
        picked <- maybe_pick(do_pick, dir, cam, lvl, radius, to_double(mx), to_double(my), mask, pseed)
        # Spectral-class filter update (scene 1). A left-click EDGE on a checkbox row toggles that
        # class; All/None set every / no class. Edge-detected so holding the button doesn't re-fire.
        let lclick = ldown && ! prev_ldown && (view == 0)
        let hit = if lclick then legend_hit(mx, my) else 0 - 1
        let mask_row = if hit >= 0 then bit_toggle(mask, hit) else mask
        let mask2 = if all_click then mask_all else if none_click then mask_none else mask_row
        # Scene-2 hover: nearest planet to the cursor (in-memory list, same scale as the draw).
        hovered <- maybe_hover((view == 1), cplanets2, s2scale, to_double(mx), to_double(my))
        let next_view = if toggle then (if view == 0 then 1 else 0) else view
        # Don't treat a left-click over UI as a camera drag: the scene-switch button (bottom-right), or
        # in scene 1 the filter legend + All/None buttons (right side, y from the header to below them).
        let over_legend = (view == 0) && (mx >= leg_x) && (my >= leg_y - 28) && (my <= leg_btn_y + 30)
        let over_ui = over_legend || ((mx >= 1090) && (my >= 715))
        # Whichever view is active drives its own camera; the other's is held. Zoom/pan scale by the
        # ACTIVE eye distance so both the galaxy (ly) and system (AU-world) scales feel the same.
        let active = if view == 0 then cam else scam
        let adist = cam_distance(active)
        let orbit = ldown && ! shift && ! over_ui
        let pan_drag = ldown && shift && ! over_ui
        let d_yaw = if orbit then gdx * drag_yaw_step else 0.0
        let d_pitch = if orbit then gdy * drag_pitch_step else 0.0
        let d_zoom = (0.0 - wheel) * wheel_zoom_frac * adist
        let d_pan_r = ((bd(kd) - bd(ka)) * key_pan_frac * adist)
                        + (if pan_drag then (0.0 - gdx) * drag_pan_frac * adist else 0.0)
        let d_pan_f = ((bd(kw) - bd(ks)) * key_pan_frac * adist)
                        + (if pan_drag then gdy * drag_pan_frac * adist else 0.0)
        let zlo = if view == 0 then zoom_min else s2_zoom_min
        let zhi = if view == 0 then zoom_max else s2_zoom_max
        let pbnd = if view == 0 then pan_bound else s2_pan_bound
        let driven = cam_drive(active, d_yaw, d_pitch, d_zoom, d_pan_r, d_pan_f,
                               zlo, zhi, pitch_min, pitch_max, pbnd)
        let cam2 = if view == 0 then driven else cam
        let scam2 = if view == 1 then driven else scam
        match streamed with
        | (loaded2, _) ->
            match picked with
            | (best_d2, best_name, best_detail) ->
                match hover_lines(hovered) with
                | (hov1b, hov2b) ->
                    let name2 = if best_d2 < pick_radius2 then best_name else sel_name
                        detail2 = if best_d2 < pick_radius2 then best_detail else sel_detail
                    in render_loop(dir, cam2, scam2, radius, loaded2, name2, detail2, rdown, next_view, lvl, csys2, cplanets2, hov1b, hov2b, mask2, ldown)

fn main() -> Unit !{IO} =
  do
    # Resolve the catalog and build/reuse the class-balanced cache BEFORE opening the window, so the
    # one-time ~15s rebuild prints to the console instead of presenting a frozen window.
    src_dir <- catalog_dir()
    dir <- ensure_balanced(src_dir)
    gfx.open_window(1280, 800, "Sprout — Galaxy Map")
    gfx.set_target_fps(60)
    gfx.set_clip_planes(near_plane, far_plane)
    # Bloom makes the emissive stars bleed a soft halo (they read as glowing points, not flat discs);
    # supersample(2) restores anti-aliasing the off-screen post path gives up (a starfield is light
    # geometry, so 2x is cheap). threshold 0.62 concentrates the glow on the genuinely bright bodies
    # (keeps the black backdrop dark instead of a milky haze, and limits scene-2 planet bloom);
    # intensity 0.95. Threshold bloom keys on brightness, not emissiveness — an emissive-only bloom
    # source is the principled upgrade (see BACKLOG); Stage-3 dark procedural planets also mitigate it.
    gfx.supersample(2)
    gfx.post_bloom(0.62, 0.95)
    make_models()
    radius <- read_radius(dir)
    cam_radius <- arg_int(1, gfx.double_to_int(init_radius))
    cam_height <- arg_int(2, gfx.double_to_int(init_height))
    cam_yaw_milli <- arg_int(3, gfx.double_to_int(init_yaw * 1000.0))
    cam_tx <- arg_int(4, 0)
    cam_tz <- arg_int(5, 0)
    let cam0 = Cam(yaw = to_double(cam_yaw_milli) / 1000.0,
                   radius = to_double(cam_radius), height = to_double(cam_height),
                   tx = to_double(cam_tx), ty = 0.0, tz = to_double(cam_tz))
    # Seed the committed LoD level straight off the nominal ladder so the opening frame is at the
    # right detail immediately; render_loop's next_level then applies hysteresis from here on.
    let seed_lvl = min(desired_level(cam_distance(cam0)), stream_max_level)
    # Scene-2 camera: angled overhead of the system at the origin (AU-world scale). Persists across
    # entries; the system is always at the origin so it needs no per-system reset.
    let scam0 = Cam(yaw = 0.6, radius = s2_init_radius, height = s2_init_height,
                    tx = 0.0, ty = 0.0, tz = 0.0)
    # Optional argv[6] = a system id to open DIRECTLY in the solar-system view (screenshot/canary of
    # scene 2, which otherwise needs an interactive right-click). Absent/negative -> normal galaxy start.
    sys_arg <- arg_int(6, 0 - 1)
    let init_view = if sys_arg >= 0 then 1 else 0
    let init_name = if sys_arg >= 0 then "SYS-" ++ pad5(sys_arg) else "No system selected"
    # Optional argv[7] = initial spectral-class filter mask (bit c == class c shown). Absent -> all
    # classes shown (mask_all). Lets a screenshot/canary open on a filtered view, e.g. 64 = M-only.
    init_mask <- arg_int(7, mask_all)
    render_loop(dir, cam0, scam0, radius, dict_empty(),
                init_name, "Right-click a star to inspect it", false, init_view, seed_lvl, "", Nil, "", "",
                init_mask, false)
