module examples.gfx.spinning_cube

import stdlib.gfx
import stdlib.math (sin, cos)

# Milestone 1 — the first 3D frame drawn from Sprout: a cube on a grid with the
# camera orbiting it, rendered via the raylib native backend (stdlib.gfx /
# graphics/sprout_gfx.c). The motion comes from GENERAL primitives — a static
# draw_cube with an orbiting set_camera each frame — so no special "spinning cube"
# builtin is needed.
#
# The render loop is the exact tail-recursive shape verified flat-stack in the
# Milestone 0 loop spike: a `window_should_close` guard, then per-frame draw
# calls, then the recursive call in tail position.
#
# Run:
#   mise exec -- just run-gfx examples/gfx/spinning_cube.sprout
# Auto-close after N frames (non-interactive canary):
#   SPROUT_GFX_MAX_FRAMES=120 mise exec -- just run-gfx examples/gfx/spinning_cube.sprout

let orbit_radius = 8.0

fn render_loop(frame: Int) -> Unit !{IO} =
  do
    stop <- gfx.window_should_close()
    if stop then gfx.close_window()
    else
      do
        let angle = to_double(frame) * 0.02  # radians/frame — the camera circles the cube
        gfx.set_camera(orbit_radius * sin(angle), 5.0, orbit_radius * cos(angle),
                       0.0, 1.0, 0.0, 45.0)
        gfx.frame_begin()
        gfx.draw_grid(20, 1.0)
        gfx.draw_cube(0.0, 1.0, 0.0, 2.0, 190, 60, 60)
        gfx.frame_end()
        render_loop(frame + 1)

fn main() -> Unit !{IO} =
  do
    gfx.open_window(800, 600, "Sprout — orbiting cube")
    gfx.set_target_fps(60)
    render_loop(0)
