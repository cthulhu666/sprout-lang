module examples.gfx.ecs_agents

import stdlib.gfx
import stdlib.linalg (anim_advance)
import stdlib.math (sin, cos, pi)
import stdlib.rng (rng_below)
import loam.scene (Scene, scene_new, scene_count, spawn, scene_model, scene_pos_x, scene_pos_z, scene_heading, scene_frame, scene_resting)
import loam.agent (world_step)
import stdlib.mutable (mutvec_at, mutvec_set)

# A little game grown on Loam (the engine seed). A crowd of characters, each
# driven by a super-simple agent that wanders in random directions and rests when
# it tires — all decided by loam.agent.world_step, which touches only the scene's
# component arrays. THIS file is the view: it advances the model with world_step,
# then reads the same components to animate and draw. The game logic is tested
# headless in tests/loam/test_agent.spr; nothing here re-implements it.
#
# Run:
#   mise exec -- just run-gfx examples/gfx/ecs_agents.sprout

# --- World layout -----------------------------------------------------------
# ONE knob: agent_count. The grid shape, its centring, and the wander arena are
# all DERIVED from it, so resizing the crowd is a single edit here.
let agent_count = 196
let grid_gap = 3.0

# Integer square root (floor) so the crowd forms a near-square grid. O(sqrt n).
fn isqrt_go(n: Int, i: Int) -> Int = if (i + 1) * (i + 1) > n then i else isqrt_go(n, i + 1)
fn isqrt(n: Int) -> Int = if n <= 0 then 0 else isqrt_go(n, 1)

# Near-square grid derived from the count (a non-square count leaves a partial
# last row, which is fine — populate spawns exactly agent_count).
let grid_cols = isqrt(agent_count)
let grid_rows = (agent_count + grid_cols - 1) / grid_cols
let col_center = to_double(grid_cols - 1) / 2.0
let row_center = to_double(grid_rows - 1) / 2.0

# Wander half-extent: enclose the grid plus a margin, so agents bounce at the rim
# rather than inside the crowd.
let grid_span = to_double(if grid_cols > grid_rows then grid_cols else grid_rows) * grid_gap
let arena = (grid_span / 2.0) + 6.0

# Column/row of entity i mapped to a ground offset centred on 0 (no `%` operator,
# so column is i - (i/cols)*cols). Centres are derived, never hardcoded.
fn grid_x(i: Int) -> Double = (to_double(i - (i / grid_cols) * grid_cols) - col_center) * grid_gap
fn grid_z(i: Int) -> Double = (to_double(i / grid_cols) - row_center) * grid_gap

# Per-entity PRNG seed (distinct, scrambled) and a varied starting heading and
# energy so the crowd is out of phase from frame 0 — they don't all turn or tire
# together.
fn seed_of(i: Int) -> Int = (i + 1) * 7919
fn heading_of(i: Int) -> Double = to_double(rng_below(seed_of(i), 628)) / 100.0
fn energy_of(i: Int) -> Double = 20.0 + to_double(i - (i / 80) * 80)  # 20 .. 100

# Load one independent model instance per entity (independent skeletons => each
# poses on its own playhead) and spawn it into the scene.
fn populate(s: Scene, n: Int, i: Int) -> Unit !{IO} =
  if i >= n then ()
  else
    do
      h <- gfx.load_model("assets/models/characterMedium.glb")
      id <- spawn(s, h, grid_x(i), grid_z(i), heading_of(i), seed_of(i), energy_of(i))
      # Stagger each playhead so walkers don't animate in lockstep (the modulo in
      # anim_advance preserves this initial phase offset).
      mutvec_set(scene_frame(s), id, to_double(rng_below(seed_of(i) + 1, 30)))
      populate(s, n, i + 1)

# --- Animation clips --------------------------------------------------------
# The idle and run cycles live in separate GLBs whose skeleton matches the model.
# Clips bundles both (set, clip index, keyframe count) so the render loop threads
# one value instead of six.
type Clips (..) =
  | Clips Int Int Double Int Int Double  # idle_set idle_clip idle_kf run_set run_clip run_kf

let anim_rate = 1.0  # playhead advance per tick
let rad_to_deg = 57.29578  # 180/pi — heading (radians) to raylib's Y-rotation degrees
# raylib's Y-rotation A faces (-sin A, cos A), but travel at heading θ is
# (cos θ, sin θ) — a 90° offset. Face = heading°-90 so walkers face where they go.
let facing_offset = 90.0

# System: pose each entity on its ACTIVE clip — run while walking, idle while
# resting — advancing that clip's playhead (each clip has its own keyframe count).
fn anim_go(s: Scene, c: Clips, i: Int, n: Int) -> Unit !{IO} =
  if i >= n then ()
  else
    match c with
    | Clips is ic ikf rs rc rkf ->
        do
          h <- mutvec_at(scene_model(s), i)
          resting <- mutvec_at(scene_resting(s), i)
          cur <- mutvec_at(scene_frame(s), i)
          if resting == 1
          then
            do
              let nf = anim_advance(cur, anim_rate, ikf)
              mutvec_set(scene_frame(s), i, nf)
              gfx.update_animation(h, is, ic, nf)
          else
            do
              let nf = anim_advance(cur, anim_rate, rkf)
              mutvec_set(scene_frame(s), i, nf)
              gfx.update_animation(h, rs, rc, nf)
          anim_go(s, c, i + 1, n)

fn animation_system(s: Scene, c: Clips) -> Unit !{IO} =
  do
    n <- scene_count(s)
    anim_go(s, c, 0, n)

# System: draw each entity at its ground position, rotated to face its heading.
fn render_go(s: Scene, i: Int, n: Int) -> Unit !{IO} =
  if i >= n then ()
  else
    do
      h <- mutvec_at(scene_model(s), i)
      x <- mutvec_at(scene_pos_x(s), i)
      z <- mutvec_at(scene_pos_z(s), i)
      heading <- mutvec_at(scene_heading(s), i)
      gfx.draw_model(h, x, 0.0, z, (heading * rad_to_deg) - facing_offset, 1.0)
      render_go(s, i + 1, n)

fn render_system(s: Scene) -> Unit !{IO} =
  do
    n <- scene_count(s)
    render_go(s, 0, n)

# --- Orbit camera + zoom UI (as in the crowd demo) --------------------------
let orbit_start_radius = 52.0
let orbit_height = 26.0
let orbit_target_y = 1.5
let orbit_step = 0.008
let two_pi = 2.0 * pi
let zoom_step = 3.0
let min_radius = 18.0
let max_radius = 100.0

fn next_angle(a: Double) -> Double =
  if stepped >= two_pi then stepped - two_pi else stepped
  where stepped = a + orbit_step

fn clampd(v: Double, lo: Double, hi: Double) -> Double =
  if v < lo then lo else if v > hi then hi else v

fn zoomed(radius: Double, plus: Bool, minus: Bool) -> Double =
  if plus then clampd(radius - zoom_step, min_radius, max_radius)
  else if minus then clampd(radius + zoom_step, min_radius, max_radius)
  else radius

fn orbit_camera(radius: Double, angle: Double) -> Unit !{IO} =
  gfx.set_camera(radius * sin(angle), orbit_height, radius * cos(angle),
                 0.0, orbit_target_y, 0.0, 45.0)

# The frame: advance the MODEL (world_step), then the VIEW (animate + draw + UI).
# `paused` gates ONLY the camera orbit (Space toggles it); the simulation and
# animation always run.
fn render_loop(s: Scene, c: Clips, angle: Double, paused: Bool, radius: Double) -> Unit !{IO} =
  do
    stop <- gfx.window_should_close()
    if stop then gfx.close_window()
    else
      do
        toggled <- gfx.space_pressed()
        let now_paused = if toggled then ! paused else paused
        let next = if now_paused then angle else next_angle(angle)
        world_step(s, arena)
        orbit_camera(radius, angle)
        gfx.frame_begin()
        gfx.draw_grid(60, 1.0)
        animation_system(s, c)
        render_system(s)
        gfx.draw_fps(10, 10)
        plus <- gfx.button(940, 20, 44, 44, "+")
        minus <- gfx.button(940, 72, 44, 44, "-")
        gfx.frame_end()
        render_loop(s, c, next, now_paused, zoomed(radius, plus, minus))

fn main() -> Unit !{IO} =
  do
    gfx.open_window(1000, 600, "Sprout — Loam agents (wandering crowd)")
    gfx.set_target_fps(60)

    let n = agent_count
    s <- scene_new(n)
    populate(s, n, 0)

    # Two clips from skeleton-matched GLBs; each is the last (non-pose) clip.
    idle_set <- gfx.load_animations("assets/models/character_idle.glb")
    idle_count <- gfx.animation_count(idle_set)
    let idle_clip = idle_count - 1
    idle_kf <- gfx.animation_keyframes(idle_set, idle_clip)
    run_set <- gfx.load_animations("assets/models/character_run.glb")
    run_count <- gfx.animation_count(run_set)
    let run_clip = run_count - 1
    run_kf <- gfx.animation_keyframes(run_set, run_clip)

    let clips = Clips(idle_set, idle_clip, to_double(idle_kf), run_set, run_clip, to_double(run_kf))
    render_loop(s, clips, 0.0, false, orbit_start_radius)
