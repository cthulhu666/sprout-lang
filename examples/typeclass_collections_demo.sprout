module app.main
import stdlib.collections (Vec, vec_append, vec_empty, vec_fold)

class Summable c {
  fn sum_values(xs: c) -> Int
}

instance Summable (Vec Int) {
  fn sum_values(xs: Vec Int) -> Int =
    vec_fold(xs, 0, add)
}

fn add(acc: Int, value: Int) -> Int = acc + value

fn sum_any(values: a) -> Int where Summable a =
  sum_values(values)

fn sum_vec(values: Vec Int) -> Int where Summable (Vec Int) =
  sum_any(values)

fn main() -> IO Unit =
  print(
    sum_vec(vec_append(vec_append(vec_append(vec_empty(), 3), 4), 5))
  )
