module examples.aoc_2025_day_5
import stdlib.string (split_once, string_lines, trim)
import stdlib.fs as fs

# Advent of Code 2025 Day 5: Cafeteria
# part1 counts how many available ingredient IDs are fresh.
# part2 counts how many total ingredient IDs are covered by the fresh ranges.

export type Answers (..) =
  | Answers Int Int

export type Database = (ranges: Vec IntRange, ids: Vec Int)

# The input is the fresh ranges, a blank line, then the available IDs; `in_ids`
# is which half the scan is in.
type Parse = (ranges: Vec IntRange, ids: Vec Int, in_ids: Bool)

# W8/P1: parse_int is total now; AoC input is well-formed, fall back to 0.
fn id_or_zero(raw: String) -> Int =
  maybe_with_default(0, parse_int(trim(raw)))

fn parse_range(raw: String) -> IntRange =
  match split_once(raw, "-") with
  | Just (low, high) -> range_up(id_or_zero(low), id_or_zero(high))
  | Nothing -> range_up(id_or_zero(raw), id_or_zero(raw))

fn parse_line(state: Parse, raw: String) -> Parse =
  if line == "" then state with (in_ids = true)
  else if state.in_ids then state with (ids = vec_append(id_or_zero(line), state.ids))
  else state with (ranges = vec_append(parse_range(line), state.ranges))
where
  line = trim(raw)

fn parse_database(raw: String) -> Database =
  Database(ranges = parsed.ranges, ids = parsed.ids)
where
  empty = Parse(ranges = vec_empty(), ids = vec_empty(), in_ids = false)
  parsed = vec_fold(parse_line, empty, string_lines(raw))

fn overlaps(left: IntRange, right: IntRange) -> Bool =
  range_start(left) <= range_end(right) && range_start(right) <= range_end(left)

fn merge_pair(left: IntRange, right: IntRange) -> IntRange =
  range_up(
    if range_start(left) < range_start(right) then range_start(left) else range_start(right),
    if range_end(left) > range_end(right) then range_end(left) else range_end(right)
  )

# Sweeping start-sorted ranges, `open` is the one still absorbing overlaps.
# `Nothing` says the sweep has not started — no sentinel range to mistake for data.
type Sweep = (open: Maybe IntRange, merged: Vec IntRange)

fn absorb(sweep: Sweep, fresh: IntRange) -> Sweep =
  match sweep.open with
  | Nothing -> sweep with (open = Just(fresh))
  | Just open ->
      if overlaps(open, fresh) then sweep with (open = Just(merge_pair(open, fresh)))
      else sweep with (open = Just(fresh), merged = vec_append(open, sweep.merged))

fn close_sweep(sweep: Sweep) -> Vec IntRange =
  match sweep.open with
  | Nothing -> sweep.merged
  | Just open -> vec_append(open, sweep.merged)

fn normalized_ranges(ranges: Vec IntRange) -> Vec IntRange =
  close_sweep(vec_fold(absorb, Sweep(open = Nothing, merged = vec_empty()), sorted))
where
  sorted = vec_sort_by(range_start, ranges)

fn is_fresh(ranges: Vec IntRange, ingredient: Int) -> Bool =
  vec_any(range_contains(_, ingredient), ranges)

fn solve_database(db: Database) -> Answers =
  Answers(vec_count(is_fresh(fresh, _), db.ids), vec_sum_by(range_count, fresh))
where
  fresh = normalized_ranges(db.ranges)

export fn solve_stdin() -> Answers !{IO} =
  match fs.read_text("-") with
  | Ok content -> content |> parse_database |> solve_database
  | Err msg -> panic("read_file: " ++ msg)

fn main() -> Unit !{IO} =
  print(solve_stdin())
