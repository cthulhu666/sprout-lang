module examples.aoc_2025_day_5
import stdlib.collections (Vec, vec_append, vec_empty, vec_get, vec_sort_by)
import stdlib.string (split_once, string_lines, trim)
import stdlib.fs as fs

# Advent of Code 2025 Day 5: Cafeteria
# part1 counts how many available ingredient IDs are fresh.
# part2 counts how many total ingredient IDs are covered by the fresh ranges.

export type Answers (..) =
  | Answers Int Int

export type Database (..) =
  | Database (Vec IntRange) (Vec Int)

# W8/P1: parse_int is total now; AoC input is well-formed, fall back to 0.
fn int_or_zero(m: Maybe Int) -> Int =
  match m with
  | Just n -> n
  | Nothing -> 0

fn parse_range(raw: String) -> IntRange =
  match split_once(raw, "-") with
  | Nothing -> range(int_or_zero(parse_int(trim(raw))), int_or_zero(parse_int(trim(raw))))
  | Just pair ->
      match pair with
      | (left, right) -> range(int_or_zero(parse_int(trim(left))), int_or_zero(parse_int(trim(right))))

fn parse_database(lines: Vec String, index: Int, seen_blank: Bool, ranges: Vec IntRange, ids: Vec Int) -> Database =
  match vec_get(index, lines) with
  | Nothing -> Database(ranges, ids)
  | Just raw ->
      if trim(raw) == "" then parse_database(lines, index + 1, true, ranges, ids)
      else if seen_blank then
        parse_database(lines, index + 1, true, ranges, vec_append(int_or_zero(parse_int(trim(raw))), ids))
      else
        parse_database(lines, index + 1, false, vec_append(parse_range(trim(raw)), ranges), ids)

fn fresh_in_any_range(ranges: Vec IntRange, ingredient: Int, index: Int) -> Bool =
  match vec_get(index, ranges) with
  | Nothing -> false
  | Just fresh_range ->
      if range_start(fresh_range) > ingredient then false
      else if range_contains(fresh_range, ingredient) then true
      else fresh_in_any_range(ranges, ingredient, index + 1)

fn count_fresh_ids_from(ranges: Vec IntRange, ingredients: Vec Int, index: Int, acc: Int) -> Int =
  match vec_get(index, ingredients) with
  | Nothing -> acc
  | Just ingredient ->
      if fresh_in_any_range(ranges, ingredient, 0) then
        count_fresh_ids_from(ranges, ingredients, index + 1, acc + 1)
      else
        count_fresh_ids_from(ranges, ingredients, index + 1, acc)

fn count_fresh_ids(ranges: Vec IntRange, ingredients: Vec Int) -> Int =
  count_fresh_ids_from(ranges, ingredients, 0, 0)

fn overlaps(left: IntRange, right: IntRange) -> Bool =
  range_start(left) <= range_end(right) && range_start(right) <= range_end(left)

fn merge_pair(left: IntRange, right: IntRange) -> IntRange =
  range(
    if range_start(left) < range_start(right) then range_start(left) else range_start(right),
    if range_end(left) > range_end(right) then range_end(left) else range_end(right)
  )

fn merge_sorted_ranges(sorted: Vec IntRange, index: Int, current: IntRange, seen_current: Bool, acc: Vec IntRange) -> Vec IntRange =
  match vec_get(index, sorted) with
  | Nothing ->
      if seen_current then vec_append(current, acc)
      else acc
  | Just fresh ->
      if seen_current then
        if overlaps(current, fresh) then
          merge_sorted_ranges(sorted, index + 1, merge_pair(current, fresh), true, acc)
        else
          merge_sorted_ranges(sorted, index + 1, fresh, true, vec_append(current, acc))
      else
        merge_sorted_ranges(sorted, index + 1, fresh, true, acc)


fn normalized_ranges(ranges: Vec IntRange) -> Vec IntRange =
  merge_sorted_ranges(vec_sort_by(range_start, ranges), 0, range(0, 0), false, vec_empty())

fn count_covered_ids_from(merged: Vec IntRange, index: Int, acc: Int) -> Int =
  match vec_get(index, merged) with
  | Nothing -> acc
  | Just fresh_range ->
      count_covered_ids_from(merged, index + 1, acc + range_count(fresh_range))

fn count_covered_ids(ranges: Vec IntRange) -> Int =
  count_covered_ids_from(ranges, 0, 0)

fn solve_ranges(ranges: Vec IntRange, ingredients: Vec Int) -> Answers =
  Answers(count_fresh_ids(merged_ranges, ingredients), count_covered_ids(merged_ranges))
where
  merged_ranges = normalized_ranges(ranges)

fn solve_database(db: Database) -> Answers =
  match db with
  | Database ranges ingredients -> solve_ranges(ranges, ingredients)

export fn solve_stdin() -> Answers !{IO} =
  match fs.read_text("-") with
  | Ok content -> solve_database(parse_database(string_lines(content), 0, false, vec_empty(), vec_empty()))
  | Err msg -> panic("read_file: " ++ msg)

fn main() -> Unit !{IO} =
  print(solve_stdin())
