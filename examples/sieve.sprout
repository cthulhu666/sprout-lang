module examples.sieve
import stdlib.mutable (MutVec, mutvec_new, mutvec_at, mutvec_set, mutvec_fold)
import stdlib.time as time

# Sieve of Eratosthenes: count the primes up to n, once per way Sprout has to
# write an array by index.
#
# 1. Pure, over `Vec`. `vec_set` copies the whole vector, so every write is
#    O(n) and the sieve is O(n² log log n).
# 2. `MutVec`, writing in place: O(n log log n), but `!{IO}`, although the
#    buffer never leaves the function.
# 3. A linear array, `LArr`, writing in place with a pure signature. Proposed,
#    not built (docs/persistent-array-v0.md §5.3), so it is commented out at
#    the end of this file, to be uncommented when `LArr` lands.
#
# Run:
#   mise exec -- just run examples/sieve.sprout
# Expected output (count, wall-clock time):
#   vec_set: 1229 primes up to 10000  (...)
#   MutVec:  1229 primes up to 10000  (...)

# The multiples of `p` that a sieve crosses out: p², p² + p, … up to n.
fn multiples(p: Int, n: Int) -> List Int = [p * k for k in p..(n / p)]

fn none_marked(n: Int) -> Vec Bool = [false for _ in 0..n]

fn count_primes(n: Int, composite: Vec Bool) -> Int =
  list_length([p for p in 2..n if vec_get(p, composite) == Just(false)])

# --- 1. Pure, over Vec ---

fn cross_out(n: Int, composite: Vec Bool, p: Int) -> Vec Bool =
  if vec_get_or(p, true, composite) then composite
  else list_fold(\ (c, m) -> vec_set(m, true, c), composite, multiples(p, n))

fn sieve_vec(n: Int) -> Int =
  count_primes(n, range_fold(cross_out(n, _, _), none_marked(n), 2..n))

# --- 2. In place, over MutVec ---

fn cross_out_mut(n: Int, composite: MutVec Bool, p: Int) -> Unit !{IO} =
  do
    marked <- mutvec_at(composite, p)
    if marked then () else list_each(\m -> mutvec_set(composite, m, true), multiples(p, n))

fn sieve_mutvec(n: Int) -> Int !{IO} =
  do
    composite <- mutvec_new(n + 1, false)
    range_each(cross_out_mut(n, composite, _), 2..n)
    unmarked <- mutvec_fold(\ (acc, c) -> if c then acc else acc + 1, 0, composite)
    unmarked - 2

fn timed(label: String, n: Int, run: Unit -> Int !{IO}) -> Unit !{IO} =
  do
    t0 <- time.now_micros()
    count <- run(())
    t1 <- time.now_micros()
    print(`${label} ${int_to_string(count)} primes up to ${int_to_string(n)}  (${int_to_string((t1 - t0) / 1000)} ms)`)

fn main() -> Unit !{IO} =
  do
    timed("vec_set:", 10000, \_ -> sieve_vec(10000))
    timed("MutVec: ", 10000, \_ -> sieve_mutvec(10000))

# --- 3. In place and pure, over LArr (proposed) ---
#
# A set consumes the array and returns it, so the array is threaded through
# the recursion rather than captured by a lambda: a lambda may not consume a
# linear value (spec §5.8). Reads borrow it. `larr_freeze` ends its life as an
# ordinary `Vec`, in O(1), so counting is shared with version 1.
#
# fn mark_all(ms: List Int, composite: LArr Bool) -> LArr Bool =
#   match ms with
#   | [] -> composite
#   | [m | rest] -> mark_all(rest, larr_set(m, true, composite))
#
# fn sieve_from(p: Int, n: Int, composite: LArr Bool) -> LArr Bool =
#   if p * p > n then composite
#   else if larr_get(p, composite) == Just(true) then sieve_from(p + 1, n, composite)
#   else sieve_from(p + 1, n, mark_all(multiples(p, n), composite))
#
# fn sieve_larr(n: Int) -> Int =
#   count_primes(n, larr_freeze(sieve_from(2, n, larr_new(n + 1, false))))
#
# With the bulk operation, one call marks every multiple of `p`, and
# `mark_all` goes away:
#
#   else sieve_from(p + 1, n, larr_scatter(multiples(p, n), true, composite))
