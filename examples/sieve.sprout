module examples.sieve
import stdlib.linvec (LinVec, linvec_new, linvec_get, linvec_set, linvec_freeze, linvec_scatter)
import stdlib.mutable (MutVec, mutvec_new, mutvec_at, mutvec_set, mutvec_fold)
import stdlib.time as time

# Sieve of Eratosthenes: count the primes up to n, once per way Sprout has to
# write an array by index.
#
# 1. Pure, over `Vec`. `vec_set` copies the whole vector, so every write is
#    O(n) and the sieve is O(n² log log n).
# 2. `MutVec`, writing in place: O(n log log n), but `!{IO}`, although the
#    buffer never leaves the function.
# 3. A linear vector, `LinVec`, writing in place with a pure signature
#    (docs/persistent-array-v0.md §5.3): O(n log log n) and no `!{IO}`. The vector
#    is threaded through the recursion, and `linvec_freeze` hands it back as a `Vec`.
# 4. The same, with `linvec_scatter` marking all the multiples of a prime in one call.
#
# Run:
#   mise exec -- just run examples/sieve.sprout
# Expected output (count, wall-clock time):
#   vec_set: 1229 primes up to 10000  (...)
#   MutVec:  1229 primes up to 10000  (...)
#   LinVec:  1229 primes up to 10000  (...)
#   scatter: 1229 primes up to 10000  (...)

# The multiples of `p` that a sieve crosses out: p², p² + p, … up to n.
fn multiples(p: Int, n: Int) -> List Int = [p * k for k in p..(n / p)]

fn none_marked(n: Int) -> Vec Bool = [false for _ in 0..n]

fn count_primes(n: Int, composite: Vec Bool) -> Int =
  list_length([p for p in 2..n if vec_get(p, composite) == Just(false)])

# --- 1. Pure, over Vec ---

fn cross_out(n: Int, composite: Vec Bool, p: Int) -> Vec Bool =
  if vec_get_or(p, true, composite) then composite
  else list_fold(\ (c, m) -> vec_set(m, true, c), composite, multiples(p, n))

fn sieve_vec(n: Int) -> Int =
  count_primes(n, range_fold(cross_out(n, _, _), none_marked(n), 2..n))

# --- 2. In place, over MutVec ---

fn cross_out_mut(n: Int, composite: MutVec Bool, p: Int) -> Unit !{IO} =
  do
    marked <- mutvec_at(composite, p)
    if marked then () else list_each(\m -> mutvec_set(composite, m, true), multiples(p, n))

fn sieve_mutvec(n: Int) -> Int !{IO} =
  do
    composite <- mutvec_new(n + 1, false)
    range_each(cross_out_mut(n, composite, _), 2..n)
    unmarked <- mutvec_fold(\ (acc, c) -> if c then acc else acc + 1, 0, composite)
    unmarked - 2

fn timed(label: String, n: Int, run: Unit -> Int !{IO}) -> Unit !{IO} =
  do
    t0 <- time.now_micros()
    count <- run(())
    t1 <- time.now_micros()
    print(`${label} ${int_to_string(count)} primes up to ${int_to_string(n)}  (${int_to_string((t1 - t0) / 1000)} ms)`)

# --- 3. In place and pure, over LinVec ---
#
# A set consumes the vector and returns it, so the vector is threaded through the
# recursion rather than captured by a lambda: a lambda may not consume a linear value
# (spec §5.8). Reads borrow it. `linvec_freeze` ends its life as an ordinary `Vec`, in
# O(1), so counting is shared with version 1.

fn mark_all(ms: List Int, composite: LinVec Bool) -> LinVec Bool =
  match ms with
  | [] -> composite
  | [m | rest] -> mark_all(rest, linvec_set(m, true, composite))

fn sieve_from(p: Int, n: Int, composite: LinVec Bool) -> LinVec Bool =
  if p * p > n then composite
  else
    let Just marked = linvec_get(p, composite) else composite
    in if marked then sieve_from(p + 1, n, composite)
    else sieve_from(p + 1, n, mark_all(multiples(p, n), composite))

fn sieve_linvec(n: Int) -> Int =
  count_primes(n, linvec_freeze(sieve_from(2, n, linvec_new(n + 1, false))))

# --- 4. The same, with the bulk operation ---
#
# One `linvec_scatter` call marks every multiple of `p`, and `mark_all` goes away.

fn sieve_from_scatter(p: Int, n: Int, composite: LinVec Bool) -> LinVec Bool =
  if p * p > n then composite
  else
    let Just marked = linvec_get(p, composite) else composite
    in if marked then sieve_from_scatter(p + 1, n, composite)
    else sieve_from_scatter(p + 1, n, linvec_scatter(multiples(p, n), true, composite))

fn sieve_scatter(n: Int) -> Int =
  count_primes(n, linvec_freeze(sieve_from_scatter(2, n, linvec_new(n + 1, false))))

fn main() -> Unit !{IO} =
  do
    timed("vec_set:", 10000, \_ -> sieve_vec(10000))
    timed("MutVec: ", 10000, \_ -> sieve_mutvec(10000))
    timed("LinVec: ", 10000, \_ -> sieve_linvec(10000))
    timed("scatter:", 10000, \_ -> sieve_scatter(10000))
