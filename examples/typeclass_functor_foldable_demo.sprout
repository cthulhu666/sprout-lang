module app.main
import stdlib.collections (Functor, Foldable, List, Vec, vec_append, vec_empty)

fn add_one(x: Int) -> Int = x + 1
fn add(acc: Int, x: Int) -> Int = acc + x

fn map_and_sum(xs: c) -> Int where Functor c, Foldable c =
  fold_values(fmap(add_one, xs), 0, add)

fn map_and_sum_list(xs: List Int) -> Int where Functor List, Foldable List =
  map_and_sum(xs)

fn map_and_sum_vec(xs: Vec Int) -> Int where Functor Vec, Foldable Vec =
  map_and_sum(xs)

fn sample_list() -> List Int =
  Cons(1, Cons(2, Cons(3, Nil)))

fn sample_vec() -> Vec Int =
  vec_append(vec_append(vec_append(vec_empty(), 4), 5), 6)

fn main() -> IO Unit =
  print(map_and_sum_list(sample_list()) + map_and_sum_vec(sample_vec()))
