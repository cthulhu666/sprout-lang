module examples.aoc_2025_day_1

# Advent of Code 2025 Day 1: Secret Entrance
#
# A 100-position dial starts at 50; each rotation turns it left or right by a
# number of clicks. Part 1 counts the rotations that *end* on 0, part 2 counts
# every time the dial passes over or lands on 0 along the way.
#
# Sample answers: Answers(3, 6).

type Rot =
  | L Int
  | R Int

# The state one fold carries: where the dial sits, and both running counts.
type Turn = (dial: Int, hits: Int, passes: Int)

type Answers =
  | Answers Int Int

fn sample_rotations() -> List Rot =
  [L(68), L(30), R(48), L(5), R(60), L(55), L(1), L(99), R(14), L(82)]

# Dial positions are 0..99. `/` truncates toward zero, so the remainder of a
# negative position is negative — shift it back up before wrapping again.
fn on_dial(n: Int) -> Int =
  positive - (positive / 100) * 100
where
  remainder = n - (n / 100) * 100
  positive = remainder + 100

fn clicks(rot: Rot) -> Int =
  match rot with
  | L n -> n
  | R n -> n

fn dial_after(dial: Int, rot: Rot) -> Int =
  match rot with
  | L n -> on_dial(dial - n)
  | R n -> on_dial(dial + n)

# Clicks from `dial` to the next 0 in this rotation's direction. A dial already
# on 0 has to travel a whole turn to reach it again.
fn clicks_to_zero(dial: Int, rot: Rot) -> Int =
  match rot with
  | L _ -> if dial == 0 then 100 else dial
  | R _ -> if dial == 0 then 100 else 100 - dial

# One rotation crosses 0 once on the way to the first zero, then once per turn.
fn zero_crossings(dial: Int, rot: Rot) -> Int =
  if turned < first then 0 else 1 + (turned - first) / 100
where
  turned = clicks(rot)
  first = clicks_to_zero(dial, rot)

fn apply(turn: Turn, rot: Rot) -> Turn =
  Turn(
    dial = next,
    hits = turn.hits + (if next == 0 then 1 else 0),
    passes = turn.passes + zero_crossings(turn.dial, rot)
  )
where
  next = dial_after(turn.dial, rot)

fn solve(rots: List Rot) -> Answers =
  Answers(done.hits, done.passes)
where
  done = list_fold(apply, Turn(dial = 50, hits = 0, passes = 0), rots)

fn main() -> Unit !{IO} =
  print(solve(sample_rotations()))
