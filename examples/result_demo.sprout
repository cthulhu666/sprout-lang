module examples.result_demo

# Demonstrates the preferred narrow `do` style for step-by-step `Result`
# sequencing.
#
# Run:
#   mise exec -- just compile-native examples/result_demo.sprout /tmp/result_demo
#   /tmp/result_demo 21
#   /tmp/result_demo 3

fn require_large(x: Int) -> Result String Int =
  if x > 10 then Ok(x) else Err("too-small")

fn compute(x: Int) -> Result String Int =
  do
    large <- require_large(x)
    Ok((large * 2) + 1)

fn main() -> Unit !{IO} =
  let Just raw = argv_get(0) else print("usage: sprout run examples/result_demo.sprout <int>")
      Just n = parse_int(raw) else print("not a number: " ++ raw)
  in
    match compute(n) with
    | Ok value -> print(value)
    | Err err -> print(err)
