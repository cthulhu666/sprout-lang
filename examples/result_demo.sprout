module examples.result_demo

# Compares a helper-chain `Result` flow with the preferred narrow `do` style
# for step-by-step sequencing.

fn inc(x: Int) -> Int = x + 1

fn double_if_large(x: Int) -> Result String Int =
  if x > 10 then Ok(x * 2) else Err("too-small")

fn prefix_error(e: String) -> String =
  "error:" ++ e

fn show_ok(x: Int) -> Unit !{IO} =
  print(x)

fn show_error(e: String) -> Unit !{IO} =
  print(e)

fn helper_result_flow(seed: Result String Int) -> Result String Int =
  result_map_error(
    prefix_error,
    result_map(
      inc,
      result_and_then(double_if_large, seed)
    )
  )

fn do_result_flow(seed: Result String Int) -> Result String Int =
  result_map_error(
    prefix_error,
    do
      value <- seed
      doubled <- double_if_large(value)
      Ok(inc(doubled))
  )

fn print_result(r: Result String Int, fallback: Int) -> Unit !{IO} =
  do
    match r with
    | Ok value -> show_ok(value)
    | Err err -> show_error(err)
    print(result_with_default(fallback, r))

fn helper_ok_demo() -> Unit !{IO} =
  print_result(helper_result_flow(Ok(pipe(inc, 20))), 0)

fn do_ok_demo() -> Unit !{IO} =
  print_result(do_result_flow(Ok(21)), 0)

fn do_error_demo() -> Unit !{IO} =
  print_result(do_result_flow(Ok(3)), 7)

fn main() -> Unit !{IO} =
  do
    helper_ok_demo()
    do_ok_demo()
    do_error_demo()
