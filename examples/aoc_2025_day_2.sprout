module examples.aoc_2025_day_2

# Advent of Code 2025 Day 2: Duplicate and Repeat IDs
#
# Each range holds a run of IDs; an ID counts when its decimal digits are one
# pattern written over and over. Part 1 wants the pattern repeated exactly
# twice, part 2 any number of times. Both answers are the sum of the IDs that
# qualify.
#
# Sample answers: Answers(1227775554, 4174379265).

type Answers =
  | Answers Int Int

fn sample_ranges() -> List IntRange =
  [
    range_up(11, 22),
    range_up(95, 115),
    range_up(998, 1012),
    range_up(1188511880, 1188511890),
    range_up(222220, 222224),
    range_up(1698522, 1698528),
    range_up(446443, 446449),
    range_up(38593856, 38593862),
    range_up(565653, 565659),
    range_up(824824821, 824824827),
    range_up(2121212118, 2121212124)
  ]

fn modn(n: Int, m: Int) -> Int =
  n - (n / m) * m

fn pow10(k: Int) -> Int =
  if k == 0 then 1
  else 10 * pow10(k - 1)

fn num_digits(n: Int) -> Int =
  if n < 10 then 1
  else 1 + num_digits(n / 10)

# Part 1: an even digit count whose two halves are the same number.
fn is_repeated_twice(n: Int) -> Bool =
  modn(digits, 2) == 0 && n / half == modn(n, half)
where
  digits = num_digits(n)
  half = pow10(digits / 2)

# True when every `width`-digit chunk of `n` equals its lowest one.
fn all_chunks_equal(n: Int, base: Int, pat: Int) -> Bool =
  if n == 0 then true
  else if modn(n, base) == pat then all_chunks_equal(n / base, base, pat)
  else false

fn has_period(n: Int, width: Int) -> Bool =
  all_chunks_equal(n, base, modn(n, base))
where
  base = pow10(width)

# Part 2: any chunk width that divides the digit count and tiles the number.
# A width equal to the digit count is the number itself, so stop one short.
fn is_repeated_any(n: Int) -> Bool =
  any(has_period(n, _), [width for width in 1..(digits - 1) if modn(digits, width) == 0])
where
  digits = num_digits(n)

fn sum_matching(pred: Int -> Bool, ids: IntRange) -> Int =
  range_fold(\ (acc, id) -> if pred(id) then acc + id else acc, 0, ids)

fn sum_all(pred: Int -> Bool, ranges: List IntRange) -> Int =
  list_fold(\ (acc, ids) -> acc + sum_matching(pred, ids), 0, ranges)

fn main() -> Unit !{IO} =
  print(Answers(sum_all(is_repeated_twice, ranges), sum_all(is_repeated_any, ranges)))
where
  ranges = sample_ranges()
