module app.main
import stdlib.collections (Dict, Vec, dict_keys, dict_set, dict_remove, dict_empty, dict_values, vec_append, vec_empty, vec_get_or, vec_reverse, vec_slice, vec_sum_by)

fn sample_vec() -> Vec Int =
  vec_append(vec_append(vec_append(vec_append(vec_empty(), 10), 20), 30), 40)

fn sample_dict() -> Dict Int =
  dict_set(dict_set(dict_empty(), "first", 7), "second", 11)

fn main() -> IO Unit =
  print(
    vec_get_or(
      vec_reverse(vec_slice(sample_vec(), 1, 2)),
      0,
      -1
    )
    + vec_get_or(dict_values(dict_remove(sample_dict(), "first")), 0, -100)
    + str_len(vec_get_or(dict_keys(sample_dict()), 1, ""))
    + vec_sum_by(sample_vec(), half)
  )

fn half(value: Int) -> Int = value / 10
