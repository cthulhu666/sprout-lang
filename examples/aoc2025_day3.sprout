module examples.aoc2025_day3
import stdlib.collections (Vec, vec_empty, vec_append, vec_length, vec_get_or, vec_set)
import stdlib.string (string_digits, string_lines)

# Advent of Code 2025 Day 3: Battery Boost
# For each bank line, pick digits in-order to maximize resulting number.
# part1 uses 2 picks; part2 uses 12 picks.

export type Answers(..) =
  | Answers Int Int

type Shrink =
  | Shrink Int Int

type SizeDrops =
  | SizeDrops Int Int

type PickState =
  | PickState (Vec Int) SizeDrops

fn shrink_for_digit(digits: Vec Int, size: Int, drops: Int, digit: Int) -> Shrink =
  if size <= 0 then Shrink(size, drops)
  else if drops <= 0 then Shrink(size, drops)
  else
    if vec_get_or(digits, size - 1, 0) < digit then shrink_for_digit(digits, size - 1, drops - 1, digit)
    else Shrink(size, drops)

fn write_at_or_append(digits: Vec Int, index: Int, digit: Int) -> Vec Int =
  if index < vec_length(digits) then vec_set(digits, index, digit)
  else vec_append(digits, digit)

fn push_digit(digits: Vec Int, size: Int, drops: Int, digit: Int) -> PickState =
  match shrink_for_digit(digits, size, drops, digit) with
  | Shrink shrunk_size shrunk_drops ->
      PickState(write_at_or_append(digits, shrunk_size, digit), SizeDrops(shrunk_size + 1, shrunk_drops))

fn pick_digits(bank: Vec Int, index: Int, total: Int, digits: Vec Int, size: Int, drops: Int) -> PickState =
  if index >= total then PickState(digits, SizeDrops(size, drops))
  else
    match push_digit(digits, size, drops, vec_get_or(bank, index, 0)) with
    | PickState next_digits sd ->
        match sd with
        | SizeDrops next_size next_drops ->
            pick_digits(bank, index + 1, total, next_digits, next_size, next_drops)

fn fold_prefix_int(digits: Vec Int, index: Int, count: Int, acc: Int) -> Int =
  if index >= count then acc
  else fold_prefix_int(digits, index + 1, count, acc * 10 + vec_get_or(digits, index, 0))

fn best_value_vec(bank: Vec Int, count: Int) -> Int =
  let_best_value_with_len(bank, vec_length(bank), count)

fn let_best_value_with_len(bank: Vec Int, len: Int, count: Int) -> Int =
  if count <= 0 then 0
  else if count > len then 0
  else
    match pick_digits(bank, 0, len, vec_empty(), 0, len - count) with
    | PickState digits _ -> fold_prefix_int(digits, 0, count, 0)

fn sum_best_values(banks: Vec (Vec Int), index: Int, total: Int, count: Int, acc: Int) -> Int =
  if index >= total then acc
  else
    sum_best_values(
      banks,
      index + 1,
      total,
      count,
      acc + best_value_vec(vec_get_or(banks, index, vec_empty()), count)
    )

fn sum_for_count(banks: Vec (Vec Int), count: Int) -> Int =
  sum_best_values(banks, 0, vec_length(banks), count, 0)

fn append_if_non_empty_bank(banks: Vec (Vec Int), bank: Vec Int) -> Vec (Vec Int) =
  if vec_length(bank) == 0 then banks
  else vec_append(banks, bank)

fn lines_to_banks(lines: Vec String, index: Int, total: Int, acc: Vec (Vec Int)) -> Vec (Vec Int) =
  if index >= total then acc
  else
    lines_to_banks(
      lines,
      index + 1,
      total,
      append_if_non_empty_bank(acc, string_digits(vec_get_or(lines, index, "")))
    )

fn parse_all_banks(raw: String) -> Vec (Vec Int) =
  let_lines_to_banks(string_lines(raw))

fn let_lines_to_banks(lines: Vec String) -> Vec (Vec Int) =
  lines_to_banks(lines, 0, vec_length(lines), vec_empty())

fn stdin_banks() -> Vec (Vec Int) =
  parse_all_banks(read_file("-"))

fn solve_for_banks(banks: Vec (Vec Int)) -> Answers =
  Answers(sum_for_count(banks, 2), sum_for_count(banks, 12))

export fn solve_stdin() -> Answers =
  solve_for_banks(stdin_banks())

fn main() -> IO Unit =
  print(solve_stdin())
