module examples.aoc2025_day3
import stdlib.collections (Vec, vec_empty, vec_append, vec_length, vec_get, vec_set)

# Advent of Code 2025 Day 3: Battery Boost
# Sample expected answers:
# part1 (pick 2 batteries): 357
# part2 (pick 12 batteries): 3121910778619

export type Answers =
  | Answers Int Int

type Shrink =
  | Shrink Int Int

type SizeDrops =
  | SizeDrops Int Int

type PickState =
  | PickState (Vec Int) SizeDrops

fn modn(n: Int, m: Int) -> Int =
  n - (n / m) * m

fn pow10(k: Int) -> Int =
  if k == 0 then 1
  else 10 * pow10(k - 1)

fn num_digits(n: Int) -> Int =
  if n < 10 then 1
  else 1 + num_digits(n / 10)

fn digit_at(n: Int, len: Int, index: Int) -> Int =
  modn(n / pow10(len - index - 1), 10)

fn shrink_for_digit(digits: Vec Int, size: Int, drops: Int, digit: Int) -> Shrink =
  if size <= 0 then Shrink(size, drops)
  else if drops <= 0 then Shrink(size, drops)
  else
    match vec_get(digits, size - 1) with
    | Nothing -> Shrink(size, drops)
    | Just last ->
        if last < digit then shrink_for_digit(digits, size - 1, drops - 1, digit)
        else Shrink(size, drops)

fn write_at_or_append(digits: Vec Int, index: Int, digit: Int) -> Vec Int =
  if index < vec_length(digits) then vec_set(digits, index, digit)
  else vec_append(digits, digit)

fn push_digit(digits: Vec Int, size: Int, drops: Int, digit: Int) -> PickState =
  match shrink_for_digit(digits, size, drops, digit) with
  | Shrink shrunk_size shrunk_drops ->
      PickState(write_at_or_append(digits, shrunk_size, digit), SizeDrops(shrunk_size + 1, shrunk_drops))

fn pick_digits(n: Int, len: Int, index: Int, total: Int, digits: Vec Int, size: Int, drops: Int) -> PickState =
  if index >= total then PickState(digits, SizeDrops(size, drops))
  else
    match push_digit(digits, size, drops, digit_at(n, len, index)) with
    | PickState next_digits sd ->
        match sd with
        | SizeDrops next_size next_drops ->
            pick_digits(n, len, index + 1, total, next_digits, next_size, next_drops)

fn fold_prefix_int(digits: Vec Int, index: Int, count: Int, acc: Int) -> Int =
  if index >= count then acc
  else
    match vec_get(digits, index) with
    | Nothing -> acc
    | Just digit -> fold_prefix_int(digits, index + 1, count, acc * 10 + digit)

fn best_value_with_len(n: Int, len: Int, count: Int) -> Int =
  if count <= 0 then 0
  else if count > len then 0
  else
    match pick_digits(n, len, 0, len, vec_empty(), 0, len - count) with
    | PickState digits _ -> fold_prefix_int(digits, 0, count, 0)

fn best_value(n: Int, count: Int) -> Int =
  best_value_with_len(n, num_digits(n), count)

fn sum_best_values(banks: Vec Int, index: Int, total: Int, count: Int, acc: Int) -> Int =
  if index >= total then acc
  else
    match vec_get(banks, index) with
    | Nothing -> acc
    | Just bank -> sum_best_values(banks, index + 1, total, count, acc + best_value(bank, count))

fn sum_for_count(banks: Vec Int, count: Int) -> Int =
  sum_best_values(banks, 0, vec_length(banks), count, 0)

fn sample_banks() -> Vec Int =
  vec_append(
    vec_append(
      vec_append(
        vec_append(vec_empty(), 987654321111111),
        811111111111119
      ),
      234234234234278
    ),
    818181911112111
  )

export fn solve_sample() -> Answers =
  Answers(sum_for_count(sample_banks(), 2), sum_for_count(sample_banks(), 12))

fn main() -> IO Unit =
  print(solve_sample())
