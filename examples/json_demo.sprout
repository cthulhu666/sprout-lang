module examples.json_demo
import stdlib.json as json

fn payload() -> json.Json =
  json.object_from_pairs(
    [
      ("title", json.string("hello")),
      ("count", json.int(2)),
      ("items", json.array_from_list([json.string("a"), json.bool(true)]))
    ]
  )

# JSON has no NaN and no infinities, so `stringify` refuses one instead of inventing a stand-in.
fn unwritable() -> json.Json =
  json.JsonFloat(1.0 / 0.0)

fn render(value: json.Json) -> String =
  match json.stringify(value) with
  | Ok text -> text
  | Err err -> "refused: " ++ json.json_error_message(err)

fn main() -> Unit !{IO} = do
  print(render(payload()))
  print(render(unwritable()))
