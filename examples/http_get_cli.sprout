module examples.http_get_cli
import stdlib.http (HttpError, http_response_text)
import stdlib.http_client (http_get)

# Simple HTTP GET CLI client.
#
# Run (compile natively, then pass the URL to the binary):
#   mise exec -- just compile-native examples/http_get_cli.sprout /tmp/http_get_cli
#   /tmp/http_get_cli http://127.0.0.1:8080/

fn http_error_message(err: HttpError) -> String =
  match err with
  | HttpTimeout -> "request timed out"
  | HttpNetwork msg -> "network error: " ++ msg
  | HttpBadStatus _ -> "http error status"
  | HttpDecode msg -> "decode error: " ++ msg

fn result_from_maybe(err: e, value: Maybe a) -> Result e a =
  match value with
  | Just raw -> Ok(raw)
  | Nothing -> Err(err)

fn fetch_body_from_argv() -> Result String String !{IO} =
  do
    url <- result_from_maybe("usage: sprout run examples/http_get_cli.sprout <url>", argv_get(0))
    resp <- result_map_error(http_error_message, http_get(url, "", 5000))
    # The body is Bytes, so printing it is a decode and a decode can fail. A CLI that prints text
    # says so here rather than having the decision made for it during the read — `http_response_body`
    # is what a caller fetching a PNG would use instead.
    result_map_error(\_ -> "response body is not valid UTF-8 text", http_response_text(resp))

fn main() -> Unit !{IO} =
  match fetch_body_from_argv() with
  | Ok body -> print(body)
  | Err err -> print(err)
