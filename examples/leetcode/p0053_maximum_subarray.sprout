module examples.leetcode.p0053_maximum_subarray
import stdlib.math.int (max, mod)

# 53 Maximum Subarray: Kadane's algorithm. The fold carries (best ending here, best overall).
fn max_sub_array(nums: Vec Int) -> Int =
  let Just first = vec_get(0, nums) else 0
      (_, best) = vec_fold(step, (first, first), vec_slice(1, vec_length(nums) - 1, nums))
  in best

fn step(acc: (Int, Int), x: Int) -> (Int, Int) =
  let (cur, best) = acc
      cur2 = max(x, cur + x)
  in (cur2, max(best, cur2))

fn check(name: String, got: Int, want: Int) -> Unit !{IO} =
  print(`${name}: got ${got} want ${want} ${if got == want then "OK" else "FAIL"}`)

# "big" is 100000 values: -5 at every third index, 3 elsewhere.
fn main() -> Unit !{IO} =
  do
    check("ex1", max_sub_array([-2, 1, -3, 4, -1, 2, 1, -5, 4]), 6)
    check("ex2", max_sub_array([1]), 1)
    check("ex3", max_sub_array([5, 4, -1, 7, 8]), 23)
    check("big", max_sub_array([(if mod(i, 3) == Just(0) then -5 else 3) for i in 0..100000]), 33338)
