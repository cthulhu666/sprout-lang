module examples.leetcode.p0200_number_of_islands
import stdlib.linvec as linvec
import stdlib.linvec (LinVec)
import stdlib.string (string_chars, length)

# 200 Number of Islands: flood fill. Pure: a flat Vec Bool of land cells, a LinVec Bool of
# visited cells and an explicit DFS stack of flat indices.
type Grid = (rows: Int, cols: Int, land: Vec Bool)

fn num_islands(lines: List String) -> Int =
  let g = parse(lines)
  in scan(g, 0, 0, linvec.new(g.rows * g.cols, false))

fn parse(lines: List String) -> Grid =
  Grid(rows = list_length(lines),
   cols = match lines with | [] -> 0 | [l | _] -> length(l),
   land = vec_from_list([ch == '1' for line in lines, ch in vec_to_list(string_chars(line))]))

# Count a new island at each unvisited land cell, then flood it.
fn scan(g: Grid, p: Int, count: Int, seen: LinVec Bool) -> Int =
  if p >= g.rows * g.cols then let _ = linvec.drop(seen) in count
  else if is_fresh(g, seen, p) then scan(g, p + 1, count + 1, flood(g, [p], linvec.set(p, true, seen)))
  else scan(g, p + 1, count, seen)

# Mark on push, so each cell is pushed once.
fn flood(g: Grid, stack: List Int, seen: LinVec Bool) -> LinVec Bool =
  match stack with
  | [] -> seen
  | [p | rest] ->
      let fresh = list_filter(is_fresh(g, seen, _), neighbours(g, p))
      in flood(g, list_append(fresh, rest), linvec.scatter(fresh, true, seen))

fn is_fresh(g: Grid, seen: borrowing LinVec Bool, p: Int) -> Bool =
  is_land(g, p) && linvec.get(p, seen) == Just(false)

fn is_land(g: Grid, p: Int) -> Bool =
  vec_get_or(p, false, g.land)

# Left and right neighbours must not wrap across a row edge; up and down that fall off
# the flat vector read as water.
fn neighbours(g: Grid, p: Int) -> List Int =
  let c = p - (p / g.cols) * g.cols
  in mconcat([[p - g.cols, p + g.cols],
              if c > 0 then [p - 1] else [],
              if c < g.cols - 1 then [p + 1] else []])

fn check(name: String, got: Int, want: Int) -> Unit !{IO} =
  print(`${name}: got ${got} want ${want} ${if got == want then "OK" else "FAIL"}`)

fn main() -> Unit !{IO} =
  do
    check("ex1", num_islands(["11110", "11010", "11000", "00000"]), 1)
    check("ex2", num_islands(["11000", "11000", "00100", "00011"]), 3)
    check("edge-wrap", num_islands(["101", "010"]), 3)
