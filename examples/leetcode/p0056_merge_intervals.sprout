module examples.leetcode.p0056_merge_intervals
import stdlib.math.int (max)

# 56 Merge Intervals: sort by start, then fold, extending the last merged interval
# whenever the next one starts inside it. O(n log n).
fn merge(intervals: List (Int, Int)) -> List (Int, Int) =
  vec_from_list(intervals)
  |> vec_sort
  |> vec_to_list
  |> list_fold(absorb, [])
  |> list_reverse

fn absorb(acc: List (Int, Int), next: (Int, Int)) -> List (Int, Int) =
  let (s, e) = next
  in match acc with
     | [] -> [next]
     | [(ps, pe) | rest] -> if s <= pe then Cons((ps, max(pe, e)), rest) else Cons(next, acc)

fn check(name: String, got: List (Int, Int), want: List (Int, Int)) -> Unit !{IO} =
  print(`${name}: got ${to_string(got)} want ${to_string(want)} ${if got == want then "OK" else "FAIL"}`)

fn main() -> Unit !{IO} =
  do
    check("ex1", merge([(1, 3), (2, 6), (8, 10), (15, 18)]), [(1, 6), (8, 10), (15, 18)])
    check("ex2", merge([(1, 4), (4, 5)]), [(1, 5)])
    check("ex3", merge([(4, 7), (1, 4)]), [(1, 7)])
