module examples.leetcode.p0013_roman_to_integer
import stdlib.string (string_chars)

# 13 Roman to Integer: a numeral smaller than its right neighbour is subtracted,
# any other is added.
fn roman_to_int(s: String) -> Int =
  total(list_map(value_of, vec_to_list(string_chars(s))))

fn total(vs: List Int) -> Int =
  match vs with
  | [a, b | rest] -> (if a < b then -a else a) + total(Cons(b, rest))
  | [a] -> a
  | [] -> 0

fn value_of(c: Char) -> Int =
  match c with
  | 'I' -> 1
  | 'V' -> 5
  | 'X' -> 10
  | 'L' -> 50
  | 'C' -> 100
  | 'D' -> 500
  | 'M' -> 1000
  | _ -> 0

fn check(s: String, want: Int) -> Unit !{IO} =
  let got = roman_to_int(s)
  in print(`roman_to_int("${s}"): got ${got} want ${want} ${if got == want then "OK" else "FAIL"}`)

fn main() -> Unit !{IO} =
  do
    check("III", 3)
    check("LVIII", 58)
    check("MCMXCIV", 1994)
