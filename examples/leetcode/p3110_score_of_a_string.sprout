module examples.leetcode.p3110_score_of_a_string
import stdlib.unicode.utf8 (codepoints)
import stdlib.math.int (abs)
import stdlib.list (map_adjacent)

# 3110 Score of a String: sum of |a - b| over adjacent codepoints.
fn score_of_a_string(s: String) -> Int =
  codepoints(s)
  |> map_adjacent(\ (a, b) -> abs(a - b))
  |> list_fold(\ (acc, d) -> acc + d, 0)

fn check(s: String, want: Int) -> Unit !{IO} =
  let got = score_of_a_string(s)
  in print(`score_of_a_string("${s}"): got ${got} want ${want} ${if got == want then "OK" else "FAIL"}`)

fn main() -> Unit !{IO} =
  do
    check("hello", 13)
    check("zaz", 50)
