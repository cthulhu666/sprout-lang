fn swap(pair: (Int, Bool)) -> (Bool, Int) =
  match pair with
  | (count, flag) -> (flag, count)


fn sum_coords(point: (Int, Int)) -> Int =
  match point with
  | (x, y) -> x + y


fn describe(sample: (Int, (Int, Int))) -> String =
  match sample with
  | (label, (x, y)) ->
      if label > 0
      then "positive tuple"
      else "non-positive tuple"


fn main() -> Unit !{IO} =
  print(
    (
      swap((7, true)),
      sum_coords((20, 22)),
      describe((1, (3, 4)))
    )
  )
