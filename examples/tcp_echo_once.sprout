module examples.tcp_echo_once
import stdlib.net (TcpConnection, TcpListener, accept, close, close_listener, listen_local, read_avail_timeout, tcp_error_message, write_all)

# One-shot TCP echo server. Run and connect once to localhost:8081.
#
# Previously written on raw Int handles and `tcp_read`, both of which this example now avoids for
# reasons worth stating, since an example is read as a recommendation:
#
#  * `tcp_read` is gone. It returned a String assembled from unvalidated socket bytes, which a String
#    may not hold (docs/spec-v0.md:64), and it aborted the process on any socket error — so the
#    smallest possible server could be killed by one client resetting a connection.
#  * echoing needs no String at all. The payload goes straight back out, so Bytes in, Bytes out.
#  * the linear TcpConnection/TcpListener API makes the release discipline a compile error rather than
#    a convention: omit either `close` and this file does not compile.

fn echo(conn: consuming TcpConnection) -> Unit !{IO} =
  do
    match read_avail_timeout(conn, 30000) with
    | Ok payload ->
        match write_all(conn, payload) with
        | Ok sent -> term_write(`echoed ${int_to_string(sent)} bytes\n`)
        | Err err -> term_write(`write failed: ${tcp_error_message(err)}\n`)
    | Err err -> term_write(`read failed: ${tcp_error_message(err)}\n`)
    close(conn)

fn main() -> Unit !{IO} =
  do
    listener <- listen_local(8081)
    conn <- accept(listener)
    echo(conn)
    close_listener(listener)
