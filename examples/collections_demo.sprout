module examples.collections_demo
import stdlib.collections (Dict, Vec, dict_keys, dict_remove, dict_values, foldable_to_vec, vec_get_or, vec_reverse, vec_slice, vec_sum_by)
import stdlib.string as string

# Demonstrates current stdlib collection helpers and literals.

fn half(value: Int) -> Int = value / 10

fn sample_vec() -> Vec Int =
  foldable_to_vec([10, 20, 30, 40])

fn sample_dict() -> Dict Int =
  {first: 7, second: 11}

fn main() -> Unit !{IO} =
  print(
    vec_get_or(
      vec_reverse(vec_slice(sample_vec(), 1, 2)),
      0,
      -1
    )
    + vec_get_or(dict_values(dict_remove(sample_dict(), "first")), 0, -100)
    + string.length(vec_get_or(dict_keys(sample_dict()), 1, ""))
    + vec_sum_by(sample_vec(), half)
  )
