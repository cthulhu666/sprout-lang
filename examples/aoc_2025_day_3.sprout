module examples.aoc_2025_day_3
import stdlib.string (string_digits, string_lines)
import stdlib.fs as fs

# Advent of Code 2025 Day 3: Battery Boost
# For each bank line, pick digits in order to maximize the resulting number.
# part1 uses 2 picks; part2 uses 12 picks.

export type Answers (..) =
  | Answers Int Int

# The greedy scan's state. `kept` is a scratch buffer whose first `size` entries
# are the digits chosen so far; `drops` is how many more may still be discarded.
type Pick = (kept: Vec Int, size: Int, drops: Int)

# Overwrite inside the live prefix, grow past its end — the buffer is reused, so
# a popped slot is refilled rather than reallocated.
fn write_at_or_append(digits: Vec Int, index: Int, digit: Int) -> Vec Int =
  if index < vec_length(digits) then vec_set(index, digit, digits)
  else vec_append(digit, digits)

# Discard kept digits smaller than the arriving one while the budget allows:
# each drop lets a bigger digit move left, which is always worth more.
fn shrink_for(pick: Pick, digit: Int) -> Pick =
  if pick.size <= 0 || pick.drops <= 0 then pick
  else if vec_get_or(pick.size - 1, 0, pick.kept) < digit then
    shrink_for(pick with (size = pick.size - 1, drops = pick.drops - 1), digit)
  else pick

fn push_digit(pick: Pick, digit: Int) -> Pick =
  shrunk with (kept = write_at_or_append(shrunk.kept, shrunk.size, digit), size = shrunk.size + 1)
where
  shrunk = shrink_for(pick, digit)

fn digits_to_int(digits: Vec Int) -> Int =
  vec_fold(\ (acc, digit) -> acc * 10 + digit, 0, digits)

# One left-to-right scan keeps a near-monotonic run; its first `count` digits are
# the largest in-order selection.
fn picked_value(bank: Vec Int, drops: Int, count: Int) -> Int =
  digits_to_int(vec_slice(0, count, scan.kept))
where
  scan = vec_fold(push_digit, Pick(kept = vec_empty(), size = 0, drops = drops), bank)

fn best_value(bank: Vec Int, count: Int) -> Int =
  if count <= 0 || count > len then 0
  else picked_value(bank, len - count, count)
where
  len = vec_length(bank)

fn sum_for_count(count: Int, banks: Vec (Vec Int)) -> Int =
  vec_sum_by(best_value(_, count), banks)

fn has_digits(bank: Vec Int) -> Bool =
  vec_length(bank) != 0

fn parse_banks(raw: String) -> Vec (Vec Int) =
  raw
  |> string_lines
  |> vec_map(string_digits)
  |> vec_filter(has_digits)

fn solve_banks(banks: Vec (Vec Int)) -> Answers =
  Answers(sum_for_count(2, banks), sum_for_count(12, banks))

export fn solve_stdin() -> Answers !{IO} =
  match fs.read_text("-") with
  | Ok content -> content |> parse_banks |> solve_banks
  | Err msg -> panic("read_file: " ++ msg)

fn main() -> Unit !{IO} =
  print(solve_stdin())
