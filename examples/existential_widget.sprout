module examples.existential_widget

# Shared hidden state via the explicit `exists` prefix (docs/gadts-v0.md §5.1,
# spec §5.6) — the flagship existential shape the `any C` sugar CANNOT express.
#
# One `exists s.` binds a hidden STATE type `s` that spans SEVERAL fields: the
# step function `s -> s` and the render function `s -> String`. So each Widget is
# a little state machine closed over private state of its OWN type — and no caller
# can see or unify that `s`. A counter (s = Int) and a text buffer (s = String)
# sit side by side in one flat `List Widget`, each stepped and rendered through the
# shared interface. Neither a closed sum (the set is open to new widget types) nor
# a struct-of-arrays (the state types differ and are private) can express this.
#
# The prefix is what lets one hidden variable scope over MORE THAN ONE field —
# `any C` is single-field sugar and could only hide a lone value.

type Widget = | exists s. Widget s (s -> s)(s -> String)

# A counter widget: private state is an Int; stepping increments it.
fn count_up(n: Int) -> Int = n + 1
fn show_count(n: Int) -> String = `count=${int_to_string(n)}`

# A text-buffer widget: private state is a String; stepping appends a dot.
fn add_dot(buf: String) -> String = buf ++ "."
fn show_buf(buf: String) -> String = `buf="${buf}"`

# Advance a widget `n` times through its own step function, then render — all via
# the shared interface, without ever naming the hidden state type.
fn run(w: Widget, n: Int) -> String =
  match w with
  | Widget st step render -> render(step_n(step, st, n))

fn step_n(step: s -> s, st: s, n: Int) -> s =
  if n <= 0 then st else step_n(step, step(st), n - 1)

fn widgets() -> List Widget =
  [Widget(0, count_up, show_count), Widget("", add_dot, show_buf)]

fn main() -> Unit !{IO} =
  list_each(\w -> print(run(w, 3)), widgets())
