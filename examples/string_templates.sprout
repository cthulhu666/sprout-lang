module examples.string_templates

# Demonstrates two string-template use cases:
# - a template in a String context, replacing long `++` chains
# - a template in a StringTemplate context, keeping parts structured for a sink
#
# Run:
#   python3 -m sprout.cli run examples/string_templates.sprout Ada 3

fn arg_or(index: Int, fallback: String) -> String !{IO} =
  match argv_get(index) with
  | Nothing -> fallback
  | Just value -> value

# Both status helpers return String. This version spells out the older
# concat-chain shape, allocating at each `++`.
fn concat_status_string(user: String, unread: Int) -> String =
  "user="
  ++ user
  ++ " unread="
  ++ to_string(unread)
  ++ " next="
  ++ to_string(unread + 1)

# This returns the same String, but the template lowers to string_concat_many
# when a String is required.
fn template_status_string(user: String, unread: Int) -> String =
  `user=${user} unread=${unread} next=${unread + 1}`

# This mirrors the native compiler's emit_template shape: callers pass a
# StringTemplate, so the sink can decide when to join or write the parts.
fn emit_buffered(line: StringTemplate) -> Unit !{IO} =
  print(template_to_string(line))

fn main() -> Unit !{IO} =
  do
    user <- arg_or(0, "Ada")
    raw_unread <- arg_or(1, "3")
    let unread = parse_int(raw_unread)
    let template_rendered = template_status_string(user, unread)
    let concat_rendered = concat_status_string(user, unread)
    print(`Hello, ${user} ! `)
    print(`template status: ${template_rendered}`)
    print(`concat equivalent: ${concat_rendered}`)
    emit_buffered(`buffered line: %tmp = add i64 ${unread}, ${unread + 1}`)
