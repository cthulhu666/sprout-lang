module examples.digit_recognizer.recognizer
import stdlib.mutable (MutVec, mutvec_new, mutvec_get, mutvec_set, MutMatrix, mutmatrix_new, mutmatrix_get, mutmatrix_set, mutmatrix_cols)

# Handwritten-digit recognition trained on real public data.
#
# Dataset: the UCI "Optical Recognition of Handwritten Digits" set (Alpaydin &
# Kaynak) — the 8x8 cousin of MNIST.  Each sample is 64 pixels (integer 0..16)
# plus a label 0..9.  A bounded subset ships alongside this file:
#   optdigits_train.txt  (500 samples)   optdigits_test.txt (150 samples)
# one sample per line, whitespace-separated, label last.
#
# Model: a 64 -> 24 -> 10 multilayer perceptron.  Hidden activation is softsign,
# s(x) = x/(1+|x|) — smooth and bounded like tanh but pure arithmetic (no exp),
# with derivative (1-|s|)^2.  The 10 linear outputs are trained toward a one-hot
# target under MSE (no softmax, so no exp); the prediction is argmax.  Trained by
# stochastic gradient descent, one weight update per sample.
#
# Weights are held in a `Net` record of two weight matrices and two bias vectors
# (`stdlib.mutable`): W1 (n_hid x n_in), B1 (n_hid), W2 (n_out x n_hid), B2 (n_out).
# `MutMatrix` replaces the earlier single flat MutVec + hand-rolled index math.
# Iteration uses the prelude's effect-polymorphic combinators (`range_each`/
# `range_fold`/`list_each`/`list_fold`); IntRange is inclusive, so a half-open
# [0, n) loop is `range(0, n - 1)`.
#
# Run from the repository root:
#   ./build/compile_driver_bin_stage1 --emit-ir "$PWD/stdlib" \
#       examples/digit_recognizer/recognizer.sprout | clang -x ir - \
#       runtime/sprout_runtime.c -O2 -framework Security -framework CoreFoundation \
#       -o /tmp/digits && /tmp/digits

let n_in = 64
let n_hid = 24
let n_out = 10

# W1: n_hid x n_in, B1: n_hid, W2: n_out x n_hid, B2: n_out.
type Net = Net(MutMatrix Double) (MutVec Double) (MutMatrix Double) (MutVec Double)

# ---------------------------------------------------------------------------
# Activation
# ---------------------------------------------------------------------------
fn dabs(x: Double) -> Double = if x < 0.0 then -x else x

fn softsign(x: Double) -> Double = x / (1.0 + dabs(x))

# s'(x) = (1 - |s(x)|)^2, from the activation output s.
fn softsign_deriv_from_out(s: Double) -> Double =
  (1.0 - dabs(s)) * (1.0 - dabs(s))

# One-hot target component: 1.0 for the true class, else 0.0.
fn target_of(o: Int, label: Int) -> Double = if o == label then 1.0 else 0.0

# ---------------------------------------------------------------------------
# Deterministic LCG weight initialisation
# ---------------------------------------------------------------------------
fn mod_int(a: Int, m: Int) -> Int = a - (a / m) * m

fn lcg_next(state: Int) -> Int = mod_int(1664525 * state + 1013904223, 2147483648)

# Small initial weight in roughly [-0.1, 0.1), scaled for a 64-input fan-in.
fn lcg_to_weight(state: Int) -> Double =
  to_double(mod_int(state, 2000) - 1000) / 10000.0

# Fill matrix cell k (row-major: k -> (k/cols, k%cols)) from the LCG state,
# returning the advanced state so the whole net threads one continuous sequence.
fn fill_matrix_step(m: MutMatrix Double, state: Int, k: Int) -> Int !{IO} =
  do
    let cols = mutmatrix_cols(m)
    _ <- mutmatrix_set(m, k / cols, k - (k / cols) * cols, lcg_to_weight(state))
    lcg_next(state)

fn fill_vec_step(v: MutVec Double, state: Int, k: Int) -> Int !{IO} =
  do
    _ <- mutvec_set(v, k, lcg_to_weight(state))
    lcg_next(state)

# Thread one LCG sequence through W1 (row-major), then B1, then W2, then B2 —
# the same element order the old flat weight vector used, so results are stable.
fn init_net(net: Net) -> Unit !{IO} =
  match net with
  | Net w1 b1 w2 b2 ->
      do
        s1 <- range_fold(\ (s, k) -> fill_matrix_step(w1, s, k), 12345, range(0, n_hid * n_in - 1))
        s2 <- range_fold(\ (s, k) -> fill_vec_step(b1, s, k), s1, range(0, n_hid - 1))
        s3 <- range_fold(\ (s, k) -> fill_matrix_step(w2, s, k), s2, range(0, n_out * n_hid - 1))
        _ <- range_fold(\ (s, k) -> fill_vec_step(b2, s, k), s3, range(0, n_out - 1))
        ()

# ---------------------------------------------------------------------------
# Data loading:  file -> List (pixels: MutVec Double, label: Int)
# ---------------------------------------------------------------------------
fn parse_ints(toks: List String) -> List Int =
  match toks with
  | Nil -> Nil
  | Cons t rest ->
      match parse_int(t) with
      | Just v -> Cons(v, parse_ints(rest))
      | Nothing -> parse_ints(rest)

# Fill pixels[0..63] with normalised values (0..16 -> 0.0..1.0) and return the
# 65th int as the label.
fn fill_sample(ints: List Int, pixels: MutVec Double, i: Int) -> Int !{IO} =
  match ints with
  | Nil -> 0
  | Cons v rest ->
      if i < n_in then
        do
          _ <- mutvec_set(pixels, i, to_double(v) / 16.0)
          fill_sample(rest, pixels, i + 1)
      else v

fn load_lines(lines: List String) -> List (MutVec Double, Int) !{IO} =
  match lines with
  | Nil -> Nil
  | Cons line rest ->
      do
        let ints = parse_ints(split_words(line))
        if list_fold(\ (acc, _) -> acc + 1, 0, ints) < n_in + 1 then load_lines(rest)
        else
          do
            pixels <- mutvec_new(n_in, 0.0)
            label <- fill_sample(ints, pixels, 0)
            others <- load_lines(rest)
            Cons((pixels, label), others)

fn load_dataset(path: String) -> List (MutVec Double, Int) !{IO} =
  # Match read_file directly: a do-bind would strip the Result wrapper.
  match read_file(path) with
  | Err _ -> Nil
  | Ok text -> load_lines(str_split_lines(text))

fn dataset_size(xs: List (MutVec Double, Int)) -> Int =
  list_fold(\ (acc, _) -> acc + 1, 0, xs)

# ---------------------------------------------------------------------------
# Forward pass (writes into caller-provided hidden/out buffers)
# ---------------------------------------------------------------------------
fn hidden_z_step(w1: MutMatrix Double, x: MutVec Double, h: Int, acc: Double, i: Int) -> Double !{IO} =
  do
    wi <- mutmatrix_get(w1, h, i)
    xi <- mutvec_get(x, i)
    acc + wi * xi

fn compute_hidden_unit(w1: MutMatrix Double, b1: MutVec Double, x: MutVec Double, hidden: MutVec Double, h: Int) -> Unit !{IO} =
  do
    b <- mutvec_get(b1, h)
    z <- range_fold(\ (acc, i) -> hidden_z_step(w1, x, h, acc, i), b, range(0, n_in - 1))
    mutvec_set(hidden, h, softsign(z))

fn out_z_step(w2: MutMatrix Double, hidden: MutVec Double, o: Int, acc: Double, h: Int) -> Double !{IO} =
  do
    wh <- mutmatrix_get(w2, o, h)
    hh <- mutvec_get(hidden, h)
    acc + wh * hh

fn compute_output_unit(w2: MutMatrix Double, b2: MutVec Double, hidden: MutVec Double, out: MutVec Double, o: Int) -> Unit !{IO} =
  do
    b <- mutvec_get(b2, o)
    z <- range_fold(\ (acc, h) -> out_z_step(w2, hidden, o, acc, h), b, range(0, n_hid - 1))
    mutvec_set(out, o, z)

fn forward(net: Net, x: MutVec Double, hidden: MutVec Double, out: MutVec Double) -> Unit !{IO} =
  match net with
  | Net w1 b1 w2 b2 ->
      do
        _ <- range_each(\h -> compute_hidden_unit(w1, b1, x, hidden, h), range(0, n_hid - 1))
        range_each(\o -> compute_output_unit(w2, b2, hidden, out, o), range(0, n_out - 1))

# argmax over the output layer, as a fold threading (best_index, best_value).
fn argmax_step(out: MutVec Double, acc: (Int, Double), o: Int) -> (Int, Double) !{IO} =
  do
    v <- mutvec_get(out, o)
    match acc with
    | (best_i, best_v) -> if v > best_v then (o, v) else (best_i, best_v)

fn predict(out: MutVec Double) -> Int !{IO} =
  do
    result <- range_fold(\ (acc, o) -> argmax_step(out, acc, o), (0, -1000000.0), range(0, n_out - 1))
    match result with | (best_i, _) -> best_i

# ---------------------------------------------------------------------------
# Backpropagation with inline SGD weight updates
# ---------------------------------------------------------------------------
# dhidden[h] += dout_o * W2[o][h] for one output o (uses OLD W2, before updates).
fn accum_dhidden_term(w2: MutMatrix Double, dhidden: MutVec Double, o: Int, dout_o: Double, h: Int) -> Unit !{IO} =
  do
    wh <- mutmatrix_get(w2, o, h)
    cur <- mutvec_get(dhidden, h)
    mutvec_set(dhidden, h, cur + dout_o * wh)

fn accum_dhidden_output(w2: MutMatrix Double, out: MutVec Double, label: Int, dhidden: MutVec Double, o: Int) -> Unit !{IO} =
  do
    oo <- mutvec_get(out, o)
    let dout_o = 2.0 * (oo - target_of(o, label))
    range_each(\h -> accum_dhidden_term(w2, dhidden, o, dout_o, h), range(0, n_hid - 1))

# Update W2[o][h] toward the gradient for one output o.
fn update_out_weight(w2: MutMatrix Double, hidden: MutVec Double, o: Int, dout_o: Double, lr: Double, h: Int) -> Unit !{IO} =
  do
    hh <- mutvec_get(hidden, h)
    cur <- mutmatrix_get(w2, o, h)
    mutmatrix_set(w2, o, h, cur - lr * dout_o * hh)

fn update_output_unit(w2: MutMatrix Double, b2: MutVec Double, hidden: MutVec Double, out: MutVec Double, label: Int, lr: Double, o: Int) -> Unit !{IO} =
  do
    oo <- mutvec_get(out, o)
    let dout_o = 2.0 * (oo - target_of(o, label))
    _ <- range_each(\h -> update_out_weight(w2, hidden, o, dout_o, lr, h), range(0, n_hid - 1))
    bo <- mutvec_get(b2, o)
    mutvec_set(b2, o, bo - lr * dout_o)

# Update W1[h][i] toward the gradient for one hidden unit h, given dz.
fn update_hidden_weight(w1: MutMatrix Double, x: MutVec Double, h: Int, dz: Double, lr: Double, i: Int) -> Unit !{IO} =
  do
    xi <- mutvec_get(x, i)
    cur <- mutmatrix_get(w1, h, i)
    mutmatrix_set(w1, h, i, cur - lr * dz * xi)

fn update_hidden_unit(w1: MutMatrix Double, b1: MutVec Double, x: MutVec Double, hidden: MutVec Double, dhidden: MutVec Double, lr: Double, h: Int) -> Unit !{IO} =
  do
    hh <- mutvec_get(hidden, h)
    dh <- mutvec_get(dhidden, h)
    let dz = dh * softsign_deriv_from_out(hh)
    _ <- range_each(\i -> update_hidden_weight(w1, x, h, dz, lr, i), range(0, n_in - 1))
    bh <- mutvec_get(b1, h)
    mutvec_set(b1, h, bh - lr * dz)

fn backprop(net: Net, x: MutVec Double, label: Int, hidden: MutVec Double, out: MutVec Double, dhidden: MutVec Double, lr: Double) -> Unit !{IO} =
  match net with
  | Net w1 b1 w2 b2 ->
      do
        _ <- range_each(\h -> mutvec_set(dhidden, h, 0.0), range(0, n_hid - 1))
        _ <- range_each(\o -> accum_dhidden_output(w2, out, label, dhidden, o), range(0, n_out - 1))  # dhidden from OLD W2
        _ <- range_each(\o -> update_output_unit(w2, b2, hidden, out, label, lr, o), range(0, n_out - 1))  # now update W2/B2
        range_each(\h -> update_hidden_unit(w1, b1, x, hidden, dhidden, lr, h), range(0, n_hid - 1))  # update W1/B1

# ---------------------------------------------------------------------------
# Training and evaluation
# ---------------------------------------------------------------------------
fn train_sample(net: Net, hidden: MutVec Double, out: MutVec Double, dhidden: MutVec Double, lr: Double, sample: (MutVec Double, Int)) -> Unit !{IO} =
  match sample with
  | (x, label) ->
      do
        _ <- forward(net, x, hidden, out)
        backprop(net, x, label, hidden, out, dhidden, lr)

fn train_epoch(net: Net, samples: List (MutVec Double, Int), hidden: MutVec Double, out: MutVec Double, dhidden: MutVec Double, lr: Double) -> Unit !{IO} =
  list_each(\sample -> train_sample(net, hidden, out, dhidden, lr, sample), samples)

fn count_correct_step(net: Net, hidden: MutVec Double, out: MutVec Double, acc: Int, sample: (MutVec Double, Int)) -> Int !{IO} =
  match sample with
  | (x, label) ->
      do
        _ <- forward(net, x, hidden, out)
        pred <- predict(out)
        if pred == label then acc + 1 else acc

fn count_correct(net: Net, samples: List (MutVec Double, Int), hidden: MutVec Double, out: MutVec Double) -> Int !{IO} =
  list_fold(\ (acc, sample) -> count_correct_step(net, hidden, out, acc, sample), 0, samples)

fn accuracy_pct(correct: Int, total: Int) -> Double =
  to_double(correct) * 100.0 / to_double(total)

fn report(net: Net, test_set: List (MutVec Double, Int), hidden: MutVec Double, out: MutVec Double, epoch: Int, n_test: Int) -> Unit !{IO} =
  if mod_int(epoch, 5) == 0 then
    do
      c <- count_correct(net, test_set, hidden, out)
      print("epoch " ++ to_string(epoch) ++ "  test accuracy " ++ to_string(accuracy_pct(c, n_test)) ++ "%")
  else ()

fn train_step(net: Net, train_set: List (MutVec Double, Int), test_set: List (MutVec Double, Int), hidden: MutVec Double, out: MutVec Double, dhidden: MutVec Double, lr: Double, n_test: Int, epoch: Int) -> Unit !{IO} =
  do
    _ <- report(net, test_set, hidden, out, epoch, n_test)
    train_epoch(net, train_set, hidden, out, dhidden, lr)

fn train(net: Net, train_set: List (MutVec Double, Int), test_set: List (MutVec Double, Int), hidden: MutVec Double, out: MutVec Double, dhidden: MutVec Double, lr: Double, total_epochs: Int, n_test: Int) -> Unit !{IO} =
  range_each(
    \epoch -> train_step(net, train_set, test_set, hidden, out, dhidden, lr, n_test, epoch),
    range(0, total_epochs)
  )

fn main() -> Unit !{IO} =
  do
    train_set <- load_dataset("examples/digit_recognizer/optdigits_train.txt")
    test_set <- load_dataset("examples/digit_recognizer/optdigits_test.txt")
    let n_train = dataset_size(train_set)
    let n_test = dataset_size(test_set)
    print("loaded " ++ to_string(n_train) ++ " train / " ++ to_string(n_test) ++ " test samples")

    w1 <- mutmatrix_new(n_hid, n_in, 0.0)
    b1 <- mutvec_new(n_hid, 0.0)
    w2 <- mutmatrix_new(n_out, n_hid, 0.0)
    b2 <- mutvec_new(n_out, 0.0)
    let net = Net(w1, b1, w2, b2)
    _ <- init_net(net)

    hidden <- mutvec_new(n_hid, 0.0)
    out <- mutvec_new(n_out, 0.0)
    dhidden <- mutvec_new(n_hid, 0.0)

    _ <- train(net, train_set, test_set, hidden, out, dhidden, 0.05, 25, n_test)

    c <- count_correct(net, test_set, hidden, out)
    print("final test accuracy: " ++ to_string(accuracy_pct(c, n_test)) ++ "% (" ++ to_string(c) ++ "/" ++ to_string(n_test) ++ ")")
