module examples.digit_recognizer.recognizer

# Handwritten-digit recognition trained on real public data.
#
# Dataset: the UCI "Optical Recognition of Handwritten Digits" set (Alpaydin &
# Kaynak) — the 8x8 cousin of MNIST.  Each sample is 64 pixels (integer 0..16)
# plus a label 0..9.  A bounded subset ships alongside this file:
#   optdigits_train.txt  (500 samples)   optdigits_test.txt (150 samples)
# one sample per line, whitespace-separated, label last.
#
# Model: a 64 -> 24 -> 10 multilayer perceptron.  Hidden activation is softsign,
# s(x) = x/(1+|x|) — smooth and bounded like tanh but pure arithmetic (no exp),
# with derivative (1-|s|)^2.  The 10 linear outputs are trained toward a one-hot
# target under MSE (no softmax, so no exp); the prediction is argmax.  Trained by
# stochastic gradient descent, one weight update per sample.
#
# Iteration is expressed with the prelude's effect-polymorphic combinators —
# `range_each` / `range_fold` over an (inclusive) IntRange and `list_each` /
# `list_fold` over the sample list — instead of hand-rolled counter recursion.
# NOTE IntRange is inclusive on both ends, so a half-open [0, n) loop is
# `range(0, n - 1)`.  Multi-statement loop bodies are lifted to named `*_step`
# helpers because inline multi-line `do`-lambdas do not yet parse (BACKLOG B1).
#
# Run from the repository root:
#   ./build/compile_driver_bin_stage1 --emit-ir "$PWD/stdlib" \
#       examples/digit_recognizer/recognizer.sprout | clang -x ir - \
#       runtime/sprout_runtime.c -O2 -framework Security -framework CoreFoundation \
#       -o /tmp/digits && /tmp/digits

# ---------------------------------------------------------------------------
# Dimensions and flat weight-vector layout
# ---------------------------------------------------------------------------
# All weights live in one MutVec Double, laid out in four contiguous segments:
#   W1[h][i] : off_w1 + h*n_in  + i     input -> hidden   (n_in*n_hid slots)
#   B1[h]    : off_b1 + h                hidden bias        (n_hid slots)
#   W2[o][h] : off_w2 + o*n_hid + h     hidden -> output   (n_hid*n_out slots)
#   B2[o]    : off_b2 + o                output bias        (n_out slots)
let n_in = 64
let n_hid = 24
let n_out = 10

let off_w1 = 0
let off_b1 = off_w1 + n_in * n_hid
let off_w2 = off_b1 + n_hid
let off_b2 = off_w2 + n_hid * n_out
let n_weights = off_b2 + n_out

fn iw1(h: Int, i: Int) -> Int = off_w1 + h * n_in + i
fn ib1(h: Int) -> Int = off_b1 + h
fn iw2(o: Int, h: Int) -> Int = off_w2 + o * n_hid + h
fn ib2(o: Int) -> Int = off_b2 + o

# ---------------------------------------------------------------------------
# Activation
# ---------------------------------------------------------------------------
fn dabs(x: Double) -> Double = if x < 0.0 then -x else x

fn softsign(x: Double) -> Double = x / (1.0 + dabs(x))

# s'(x) = (1 - |s(x)|)^2, from the activation output s.
fn softsign_deriv_from_out(s: Double) -> Double =
  (1.0 - dabs(s)) * (1.0 - dabs(s))

# One-hot target component: 1.0 for the true class, else 0.0.
fn target_of(o: Int, label: Int) -> Double = if o == label then 1.0 else 0.0

# ---------------------------------------------------------------------------
# Deterministic LCG weight initialisation
# ---------------------------------------------------------------------------
fn mod_int(a: Int, m: Int) -> Int = a - (a / m) * m

fn lcg_next(state: Int) -> Int = mod_int(1664525 * state + 1013904223, 2147483648)

# Small initial weight in roughly [-0.1, 0.1), scaled for a 64-input fan-in.
fn lcg_to_weight(state: Int) -> Double =
  to_double(mod_int(state, 2000) - 1000) / 10000.0

# Fold the LCG state across every weight slot, writing an initial weight at each.
fn init_weight_step(w: MutVec Double, state: Int, i: Int) -> Int !{IO} =
  do
    _ <- mutvec_set(w, i, lcg_to_weight(state))
    lcg_next(state)

fn init_weights(w: MutVec Double) -> Unit !{IO} =
  do
    _ <- range_fold(\ (state, i) -> init_weight_step(w, state, i), 12345, range(0, n_weights - 1))
    ()

# ---------------------------------------------------------------------------
# Data loading:  file -> List (pixels: MutVec Double, label: Int)
# ---------------------------------------------------------------------------
# Parse a whitespace-token list into ints, skipping any unparseable token.
fn parse_ints(toks: List String) -> List Int =
  match toks with
  | Nil -> Nil
  | Cons t rest ->
      match parse_int(t) with
      | Just v -> Cons(v, parse_ints(rest))
      | Nothing -> parse_ints(rest)

# Fill pixels[0..63] with normalised values (0..16 -> 0.0..1.0) and return the
# 65th int as the label.
fn fill_sample(ints: List Int, pixels: MutVec Double, i: Int) -> Int !{IO} =
  match ints with
  | Nil -> 0
  | Cons v rest ->
      if i < n_in then
        do
          _ <- mutvec_set(pixels, i, to_double(v) / 16.0)
          fill_sample(rest, pixels, i + 1)
      else v

fn load_lines(lines: List String) -> List (MutVec Double, Int) !{IO} =
  match lines with
  | Nil -> Nil
  | Cons line rest ->
      do
        let ints = parse_ints(split_words(line))
        if list_fold(\ (acc, _) -> acc + 1, 0, ints) < n_in + 1 then load_lines(rest)
        else
          do
            pixels <- mutvec_new(n_in, 0.0)
            label <- fill_sample(ints, pixels, 0)
            others <- load_lines(rest)
            Cons((pixels, label), others)

fn load_dataset(path: String) -> List (MutVec Double, Int) !{IO} =
  # Match read_file directly: a do-bind would strip the Result wrapper.
  match read_file(path) with
  | Err _ -> Nil
  | Ok text -> load_lines(str_split_lines(text))

fn dataset_size(xs: List (MutVec Double, Int)) -> Int =
  list_fold(\ (acc, _) -> acc + 1, 0, xs)

# ---------------------------------------------------------------------------
# Forward pass (writes into caller-provided hidden/out buffers)
# ---------------------------------------------------------------------------
# One term of the hidden pre-activation dot product: acc + W1[h][i] * x[i].
fn hidden_z_step(w: MutVec Double, x: MutVec Double, h: Int, acc: Double, i: Int) -> Double !{IO} =
  do
    wi <- mutvec_get(w, iw1(h, i))
    xi <- mutvec_get(x, i)
    acc + wi * xi

fn compute_hidden_unit(w: MutVec Double, x: MutVec Double, hidden: MutVec Double, h: Int) -> Unit !{IO} =
  do
    b <- mutvec_get(w, ib1(h))
    z <- range_fold(\ (acc, i) -> hidden_z_step(w, x, h, acc, i), b, range(0, n_in - 1))
    mutvec_set(hidden, h, softsign(z))

# One term of an output pre-activation: acc + W2[o][h] * hidden[h].
fn out_z_step(w: MutVec Double, hidden: MutVec Double, o: Int, acc: Double, h: Int) -> Double !{IO} =
  do
    wh <- mutvec_get(w, iw2(o, h))
    hh <- mutvec_get(hidden, h)
    acc + wh * hh

fn compute_output_unit(w: MutVec Double, hidden: MutVec Double, out: MutVec Double, o: Int) -> Unit !{IO} =
  do
    b <- mutvec_get(w, ib2(o))
    z <- range_fold(\ (acc, h) -> out_z_step(w, hidden, o, acc, h), b, range(0, n_hid - 1))
    mutvec_set(out, o, z)

fn forward(w: MutVec Double, x: MutVec Double, hidden: MutVec Double, out: MutVec Double) -> Unit !{IO} =
  do
    _ <- range_each(\h -> compute_hidden_unit(w, x, hidden, h), range(0, n_hid - 1))
    range_each(\o -> compute_output_unit(w, hidden, out, o), range(0, n_out - 1))

# argmax over the output layer, as a fold threading (best_index, best_value).
fn argmax_step(out: MutVec Double, acc: (Int, Double), o: Int) -> (Int, Double) !{IO} =
  do
    v <- mutvec_get(out, o)
    match acc with
    | (best_i, best_v) -> if v > best_v then (o, v) else (best_i, best_v)

fn predict(out: MutVec Double) -> Int !{IO} =
  do
    result <- range_fold(\ (acc, o) -> argmax_step(out, acc, o), (0, -1000000.0), range(0, n_out - 1))
    match result with | (best_i, _) -> best_i

# ---------------------------------------------------------------------------
# Backpropagation with inline SGD weight updates
# ---------------------------------------------------------------------------
# dhidden[h] += dout_o * W2[o][h] for one output o (uses OLD W2, before updates).
fn accum_dhidden_term(w: MutVec Double, dhidden: MutVec Double, o: Int, dout_o: Double, h: Int) -> Unit !{IO} =
  do
    wh <- mutvec_get(w, iw2(o, h))
    cur <- mutvec_get(dhidden, h)
    mutvec_set(dhidden, h, cur + dout_o * wh)

fn accum_dhidden_output(w: MutVec Double, out: MutVec Double, label: Int, dhidden: MutVec Double, o: Int) -> Unit !{IO} =
  do
    oo <- mutvec_get(out, o)
    let dout_o = 2.0 * (oo - target_of(o, label))
    range_each(\h -> accum_dhidden_term(w, dhidden, o, dout_o, h), range(0, n_hid - 1))

# Update W2[o][h] toward the gradient for one output o.
fn update_out_weight(w: MutVec Double, hidden: MutVec Double, o: Int, dout_o: Double, lr: Double, h: Int) -> Unit !{IO} =
  do
    hh <- mutvec_get(hidden, h)
    cur <- mutvec_get(w, iw2(o, h))
    mutvec_set(w, iw2(o, h), cur - lr * dout_o * hh)

fn update_output_unit(w: MutVec Double, hidden: MutVec Double, out: MutVec Double, label: Int, lr: Double, o: Int) -> Unit !{IO} =
  do
    oo <- mutvec_get(out, o)
    let dout_o = 2.0 * (oo - target_of(o, label))
    _ <- range_each(\h -> update_out_weight(w, hidden, o, dout_o, lr, h), range(0, n_hid - 1))
    bo <- mutvec_get(w, ib2(o))
    mutvec_set(w, ib2(o), bo - lr * dout_o)

# Update W1[h][i] toward the gradient for one hidden unit h, given dz.
fn update_hidden_weight(w: MutVec Double, x: MutVec Double, h: Int, dz: Double, lr: Double, i: Int) -> Unit !{IO} =
  do
    xi <- mutvec_get(x, i)
    cur <- mutvec_get(w, iw1(h, i))
    mutvec_set(w, iw1(h, i), cur - lr * dz * xi)

fn update_hidden_unit(w: MutVec Double, x: MutVec Double, hidden: MutVec Double, dhidden: MutVec Double, lr: Double, h: Int) -> Unit !{IO} =
  do
    hh <- mutvec_get(hidden, h)
    dh <- mutvec_get(dhidden, h)
    let dz = dh * softsign_deriv_from_out(hh)
    _ <- range_each(\i -> update_hidden_weight(w, x, h, dz, lr, i), range(0, n_in - 1))
    bh <- mutvec_get(w, ib1(h))
    mutvec_set(w, ib1(h), bh - lr * dz)

fn backprop(w: MutVec Double, x: MutVec Double, label: Int, hidden: MutVec Double, out: MutVec Double, dhidden: MutVec Double, lr: Double) -> Unit !{IO} =
  do
    _ <- range_each(\h -> mutvec_set(dhidden, h, 0.0), range(0, n_hid - 1))
    _ <- range_each(\o -> accum_dhidden_output(w, out, label, dhidden, o), range(0, n_out - 1))  # dhidden from OLD W2
    _ <- range_each(\o -> update_output_unit(w, hidden, out, label, lr, o), range(0, n_out - 1))  # now update W2/B2
    range_each(\h -> update_hidden_unit(w, x, hidden, dhidden, lr, h), range(0, n_hid - 1))  # update W1/B1

# ---------------------------------------------------------------------------
# Training and evaluation
# ---------------------------------------------------------------------------
# One forward+backward pass over a single (pixels, label) sample.
fn train_sample(w: MutVec Double, hidden: MutVec Double, out: MutVec Double, dhidden: MutVec Double, lr: Double, sample: (MutVec Double, Int)) -> Unit !{IO} =
  match sample with
  | (x, label) ->
      do
        _ <- forward(w, x, hidden, out)
        backprop(w, x, label, hidden, out, dhidden, lr)

fn train_epoch(w: MutVec Double, samples: List (MutVec Double, Int), hidden: MutVec Double, out: MutVec Double, dhidden: MutVec Double, lr: Double) -> Unit !{IO} =
  list_each(\sample -> train_sample(w, hidden, out, dhidden, lr, sample), samples)

# Fold the correct-prediction count over the dataset.
fn count_correct_step(w: MutVec Double, hidden: MutVec Double, out: MutVec Double, acc: Int, sample: (MutVec Double, Int)) -> Int !{IO} =
  match sample with
  | (x, label) ->
      do
        _ <- forward(w, x, hidden, out)
        pred <- predict(out)
        if pred == label then acc + 1 else acc

fn count_correct(w: MutVec Double, samples: List (MutVec Double, Int), hidden: MutVec Double, out: MutVec Double) -> Int !{IO} =
  list_fold(\ (acc, sample) -> count_correct_step(w, hidden, out, acc, sample), 0, samples)

fn accuracy_pct(correct: Int, total: Int) -> Double =
  to_double(correct) * 100.0 / to_double(total)

fn report(w: MutVec Double, test_set: List (MutVec Double, Int), hidden: MutVec Double, out: MutVec Double, epoch: Int, n_test: Int) -> Unit !{IO} =
  if mod_int(epoch, 5) == 0 then
    do
      c <- count_correct(w, test_set, hidden, out)
      print("epoch " ++ to_string(epoch) ++ "  test accuracy " ++ to_string(accuracy_pct(c, n_test)) ++ "%")
  else ()

# One epoch: report accuracy, then a full training sweep.
fn train_step(w: MutVec Double, train_set: List (MutVec Double, Int), test_set: List (MutVec Double, Int), hidden: MutVec Double, out: MutVec Double, dhidden: MutVec Double, lr: Double, n_test: Int, epoch: Int) -> Unit !{IO} =
  do
    _ <- report(w, test_set, hidden, out, epoch, n_test)
    train_epoch(w, train_set, hidden, out, dhidden, lr)

fn train(w: MutVec Double, train_set: List (MutVec Double, Int), test_set: List (MutVec Double, Int), hidden: MutVec Double, out: MutVec Double, dhidden: MutVec Double, lr: Double, total_epochs: Int, n_test: Int) -> Unit !{IO} =
  range_each(
    \epoch -> train_step(w, train_set, test_set, hidden, out, dhidden, lr, n_test, epoch),
    range(0, total_epochs)
  )

fn main() -> Unit !{IO} =
  do
    train_set <- load_dataset("examples/digit_recognizer/optdigits_train.txt")
    test_set <- load_dataset("examples/digit_recognizer/optdigits_test.txt")
    let n_train = dataset_size(train_set)
    let n_test = dataset_size(test_set)
    print("loaded " ++ to_string(n_train) ++ " train / " ++ to_string(n_test) ++ " test samples")

    w <- mutvec_new(n_weights, 0.0)
    _ <- init_weights(w)
    hidden <- mutvec_new(n_hid, 0.0)
    out <- mutvec_new(n_out, 0.0)
    dhidden <- mutvec_new(n_hid, 0.0)

    _ <- train(w, train_set, test_set, hidden, out, dhidden, 0.05, 25, n_test)

    c <- count_correct(w, test_set, hidden, out)
    print("final test accuracy: " ++ to_string(accuracy_pct(c, n_test)) ++ "% (" ++ to_string(c) ++ "/" ++ to_string(n_test) ++ ")")
