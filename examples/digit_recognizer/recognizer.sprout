module examples.digit_recognizer.recognizer
import stdlib.mutable (MutVec, mutvec_new, mutvec_at, mutvec_set, mutvec_map_inplace, MutMatrix, mutmatrix_new, mutmatrix_set, mutmatrix_cols, mutmatrix_rows, mutmatrix_row_dot, mutmatrix_row_sub_scaled_inplace, mutmatrix_row_add_scaled_into)
import stdlib.fs as fs
import stdlib.string as string

# Handwritten-digit recognition trained on real public data.
#
# Dataset: the UCI "Optical Recognition of Handwritten Digits" set (Alpaydin &
# Kaynak) — the 8x8 cousin of MNIST.  Each sample is 64 pixels (integer 0..16)
# plus a label 0..9.  A bounded subset ships alongside this file:
#   optdigits_train.txt  (500 samples)   optdigits_test.txt (150 samples)
# one sample per line, whitespace-separated, label last.
#
# Model: a 64 -> 256 -> 10 multilayer perceptron.  Hidden activation is softsign,
# s(x) = x/(1+|x|) — smooth and bounded like tanh but pure arithmetic (no exp),
# with derivative (1-|s|)^2.  The 10 linear outputs are trained toward a one-hot
# target under MSE (no softmax, so no exp); the prediction is argmax.  Trained by
# stochastic gradient descent, one weight update per sample.
#
# Weights are held in a `Net` record of two weight matrices and two bias vectors
# (`stdlib.mutable`): W1 (n_hid x n_in), B1 (n_hid), W2 (n_out x n_hid), B2 (n_out).
# `MutMatrix` replaces the earlier single flat MutVec + hand-rolled index math.  The
# net plus the three reusable scratch buffers (hidden/out/dhidden) travel together in
# a `Ctx` record, so forward/backprop/train take one `ctx` instead of four buffers;
# each opens it with `match ctx with | Ctx (Net ...) hidden out dhidden`.  `lr` stays
# an explicit argument.  Iteration uses the prelude's effect-polymorphic combinators
# (`range_each`/`range_fold`/`list_each`/`list_fold`) over `upto(n)`, the [0, n) bound
# (IntRange is inclusive, so upto wraps the `range_up(0, n - 1)`).  Each loop body is a
# local `let`-closure that captures the enclosing ctx buffers.
#
# Run from the repository root:
#   ./build/compile_driver_bin_stage1 --emit-ir "$PWD/stdlib" \
#       examples/digit_recognizer/recognizer.sprout | clang -x ir - \
#       runtime/sprout_runtime.c -O2 -framework Security -framework CoreFoundation \
#       -o /tmp/digits && /tmp/digits

let n_in = 64
let n_hid = 256
let n_out = 10

# Half-open loop bound: upto(n) spans [0, n) as n iterations. IntRange is inclusive,
# so a raw [0, n) loop would read `range_up(0, n - 1)`; upto keeps that off the call
# sites. `upto(0)` is the empty range, which this comment has always CLAIMED and
# which only became true when a backwards range stopped counting downward — before
# that, upto(0) was range(0, -1) and walked indices 0 and -1 (docs/ranges-v0.md §1).
fn upto(n: Int) -> IntRange = range_up(0, n - 1)

# W1: n_hid x n_in, B1: n_hid, W2: n_out x n_hid, B2: n_out.
type Net = Net(MutMatrix Double) (MutVec Double) (MutMatrix Double) (MutVec Double)

# Training context: the model plus the three reusable scratch buffers, bundled so
# forward/backprop/train pass one `ctx` instead of threading four buffers each.
# Each consumer already opened the net with a `match`, so widening that pattern to
# `Ctx (Net w1 b1 w2 b2) hidden out dhidden` absorbs the buffers at no extra lines.
# `lr` stays an explicit parameter — it is a hyperparameter, not part of the buffers.
type Ctx = Ctx Net (MutVec Double) (MutVec Double) (MutVec Double)
#              net  hidden          out             dhidden

# ---------------------------------------------------------------------------
# Activation
# ---------------------------------------------------------------------------
fn dabs(x: Double) -> Double = if x < 0.0 then -x else x

fn softsign(x: Double) -> Double = x / (1.0 + dabs(x))

# s'(x) = (1 - |s(x)|)^2, from the activation output s.
fn softsign_deriv_from_out(s: Double) -> Double =
  (1.0 - dabs(s)) * (1.0 - dabs(s))

# One-hot target component: 1.0 for the true class, else 0.0.
fn target_of(o: Int, label: Int) -> Double = if o == label then 1.0 else 0.0

# ---------------------------------------------------------------------------
# Deterministic LCG weight initialisation
# ---------------------------------------------------------------------------
fn mod_int(a: Int, m: Int) -> Int = a - (a / m) * m

fn lcg_next(state: Int) -> Int = mod_int(1664525 * state + 1013904223, 2147483648)

# Small initial weight in roughly [-0.1, 0.1), scaled for a 64-input fan-in.
fn lcg_to_weight(state: Int) -> Double =
  to_double(mod_int(state, 2000) - 1000) / 10000.0

# Fill every cell of m in row-major order, threading the LCG state s0 through and
# returning the advanced state. Step k writes cell (k/cols, k%cols).
fn fill_matrix_lcg(m: MutMatrix Double, s0: Int) -> Int !{IO} =
  do
    let cols = mutmatrix_cols(m)
    let step = \ (s, k) -> do
          mutmatrix_set(m, k / cols, k - (k / cols) * cols, lcg_to_weight(s))
          lcg_next(s)
    range_fold(step, s0, upto(mutmatrix_rows(m) * cols))

# Fill v[0..n) from the LCG, threading and returning the advanced state.
fn fill_vec_lcg(v: MutVec Double, n: Int, s0: Int) -> Int !{IO} =
  do
    let step = \ (s, k) -> do
          mutvec_set(v, k, lcg_to_weight(s))
          lcg_next(s)
    range_fold(step, s0, upto(n))

# Thread one LCG sequence through W1 (row-major), then B1, then W2, then B2 — the
# same element order the old flat weight vector used, so results are stable.
fn init_net(net: Net) -> Unit !{IO} =
  match net with
  | Net w1 b1 w2 b2 ->
      do
        s1 <- fill_matrix_lcg(w1, 12345)
        s2 <- fill_vec_lcg(b1, n_hid, s1)
        s3 <- fill_matrix_lcg(w2, s2)
        _ <- fill_vec_lcg(b2, n_out, s3)
        ()

# ---------------------------------------------------------------------------
# Data loading:  file -> List (pixels: MutVec Double, label: Int)
# ---------------------------------------------------------------------------
fn parse_ints(toks: List String) -> List Int =
  match toks with
  | Nil -> Nil
  | Cons t rest ->
      match parse_int(t) with
      | Just v -> Cons(v, parse_ints(rest))
      | Nothing -> parse_ints(rest)

# Fill pixels[0..63] with normalised values (0..16 -> 0.0..1.0) and return the
# 65th int as the label.
fn fill_sample(ints: List Int, pixels: MutVec Double, i: Int) -> Int !{IO} =
  match ints with
  | Nil -> 0
  | Cons v rest ->
      if i < n_in then
        do
          mutvec_set(pixels, i, to_double(v) / 16.0)
          fill_sample(rest, pixels, i + 1)
      else v

fn load_lines(lines: List String) -> List (MutVec Double, Int) !{IO} =
  match lines with
  | Nil -> Nil
  | Cons line rest ->
      do
        let ints = parse_ints(split_words(line))
        if list_fold(\ (acc, _) -> acc + 1, 0, ints) < n_in + 1 then load_lines(rest)
        else
          do
            pixels <- mutvec_new(n_in, 0.0)
            label <- fill_sample(ints, pixels, 0)
            others <- load_lines(rest)
            Cons((pixels, label), others)

fn load_dataset(path: String) -> List (MutVec Double, Int) !{IO} =
  # Match read_file directly: a do-bind would strip the Result wrapper.
  match fs.read_text(path) with
  | Err _ -> Nil
  | Ok text -> load_lines(str_split_lines(text))

fn dataset_size(xs: List (MutVec Double, Int)) -> Int =
  list_fold(\ (acc, _) -> acc + 1, 0, xs)

# ---------------------------------------------------------------------------
# Forward pass (writes into the ctx hidden/out buffers)
# ---------------------------------------------------------------------------
# Each unit closure captures the weights + buffers; the weighted sum is a fused
# `mutmatrix_row_dot` kernel seeded with the bias (no per-element callback closure).
fn forward(ctx: Ctx, x: MutVec Double) -> Unit !{IO} =
  match ctx with
  | Ctx (Net w1 b1 w2 b2) hidden out _ ->
      do
        let hidden_unit = \h -> do
              b <- mutvec_at(b1, h)
              z <- mutmatrix_row_dot(w1, h, x, b)
              mutvec_set(hidden, h, softsign(z))
        let output_unit = \o -> do
              b <- mutvec_at(b2, o)
              z <- mutmatrix_row_dot(w2, o, hidden, b)
              mutvec_set(out, o, z)
        range_each(hidden_unit, upto(n_hid))
        range_each(output_unit, upto(n_out))

# argmax over the output layer, as a fold threading (best_index, best_value).
fn predict(out: MutVec Double) -> Int !{IO} =
  do
    let step = \ (acc, o) -> do
          v <- mutvec_at(out, o)
          match acc with
          | (best_i, best_v) -> if v > best_v then (o, v) else (best_i, best_v)
    result <- range_fold(step, (0, -1000000.0), upto(n_out))
    match result with | (best_i, _) -> best_i

# ---------------------------------------------------------------------------
# Backpropagation with inline SGD weight updates
# ---------------------------------------------------------------------------
# Two phase-closures, each capturing the ctx buffers + learning rate. Per output o,
# dhidden accumulates from row o of the OLD W2 *before* that same row is overwritten —
# each o owns a distinct W2 row, so read-before-write keeps every read on the old value.
fn backprop(ctx: Ctx, x: MutVec Double, label: Int, lr: Double) -> Unit !{IO} =
  match ctx with
  | Ctx (Net w1 b1 w2 b2) hidden out dhidden ->
      do
        # Output o: fold row o into dhidden (uses OLD W2[o]), then update W2[o] and B2[o].
        let update_output = \o -> do
              oo <- mutvec_at(out, o)
              let dout_o = 2.0 * (oo - target_of(o, label))
              # dhidden[h] += dout_o * W2[o][h], ascending h — fused kernel, reads old row.
              mutmatrix_row_add_scaled_into(dhidden, w2, o, dout_o)
              _ <- mutmatrix_row_sub_scaled_inplace(w2, o, hidden, lr * dout_o)
              bo <- mutvec_at(b2, o)
              mutvec_set(b2, o, bo - lr * dout_o)
        # Update W1[h][i] and B1[h] toward the gradient for hidden unit h.
        let update_hidden = \h -> do
              hh <- mutvec_at(hidden, h)
              dh <- mutvec_at(dhidden, h)
              let dz = dh * softsign_deriv_from_out(hh)
              _ <- mutmatrix_row_sub_scaled_inplace(w1, h, x, lr * dz)
              bh <- mutvec_at(b1, h)
              mutvec_set(b1, h, bh - lr * dz)
        mutvec_map_inplace(\_ -> 0.0, dhidden)
        range_each(update_output, upto(n_out))
        range_each(update_hidden, upto(n_hid))

# ---------------------------------------------------------------------------
# Training and evaluation
# ---------------------------------------------------------------------------
fn train_epoch(ctx: Ctx, samples: List (MutVec Double, Int), lr: Double) -> Unit !{IO} =
  do
    let train_sample = \sample -> match sample with
          | (x, label) -> do
              forward(ctx, x)
              backprop(ctx, x, label, lr)
    list_each(train_sample, samples)

fn count_correct(ctx: Ctx, samples: List (MutVec Double, Int)) -> Int !{IO} =
  match ctx with
  | Ctx _ _ out _ ->
      do
        let step = \ (acc, sample) -> match sample with
              | (x, label) -> do
                  forward(ctx, x)
                  pred <- predict(out)
                  if pred == label then acc + 1 else acc
        list_fold(step, 0, samples)

fn accuracy_pct(correct: Int, total: Int) -> Double =
  to_double(correct) * 100.0 / to_double(total)

fn report(ctx: Ctx, test_set: List (MutVec Double, Int), epoch: Int, n_test: Int) -> Unit !{IO} =
  if mod_int(epoch, 5) == 0 then
    do
      c <- count_correct(ctx, test_set)
      print(`epoch ${epoch}  test accuracy ${accuracy_pct(c, n_test)}%`)
  else ()

fn train(ctx: Ctx, train_set: List (MutVec Double, Int), test_set: List (MutVec Double, Int), lr: Double, total_epochs: Int, n_test: Int) -> Unit !{IO} =
  do
    let epoch_step = \epoch -> do
          report(ctx, test_set, epoch, n_test)
          train_epoch(ctx, train_set, lr)
    range_each(epoch_step, range_up(0, total_epochs))

fn main() -> Unit !{IO} =
  do
    train_set <- load_dataset("examples/digit_recognizer/optdigits_train.txt")
    test_set <- load_dataset("examples/digit_recognizer/optdigits_test.txt")
    let n_train = dataset_size(train_set)
    let n_test = dataset_size(test_set)
    print(`loaded ${n_train} train / ${n_test} test samples`)

    w1 <- mutmatrix_new(n_hid, n_in, 0.0)
    b1 <- mutvec_new(n_hid, 0.0)
    w2 <- mutmatrix_new(n_out, n_hid, 0.0)
    b2 <- mutvec_new(n_out, 0.0)
    let net = Net(w1, b1, w2, b2)
    _ <- init_net(net)

    hidden <- mutvec_new(n_hid, 0.0)
    out <- mutvec_new(n_out, 0.0)
    dhidden <- mutvec_new(n_hid, 0.0)
    let ctx = Ctx(net, hidden, out, dhidden)

    _ <- train(ctx, train_set, test_set, 0.05, 25, n_test)

    c <- count_correct(ctx, test_set)
    print(`final test accuracy: ${accuracy_pct(c, n_test)}% (${c}/${n_test})`)
