module testsupport.linear_res

# A linear resource type shared across modules, to exercise that `type linear`
# retains its linearity through the interface round-trip (iface_codec) and that
# M4.2 enforcement sees the imported `@linear:` marker.

export type linear Handle = Handle Int

export fn open_handle(n: Int) -> Handle = Handle(n)

# Consumes the handle exactly once (the match scrutinee).
export fn read_handle(h: Handle) -> Int =
  match h with
  | Handle n -> n

# The same as an abstract `wrap linear`: no box, and no constructor for importers.
export wrap linear Ticket = Int

export fn issue_ticket(n: Int) -> Ticket = Ticket(n)

export fn redeem(t: Ticket) -> Int =
  match t with
  | Ticket n -> n
