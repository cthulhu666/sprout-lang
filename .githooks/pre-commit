#!/usr/bin/env bash
# Sprout pre-commit hook — minimal: fmt --check + lint on staged files.
# Install with: just install-hooks
#
# Check-only: never modifies files or staging. Heavier validation
# (smoke tests, bundler parity, stdlib units, native compiler-stage tests,
# C-builtin guards) lives in CI, not here.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

files=$(git diff --cached --name-only --diff-filter=ACMR -z \
        | tr '\0' '\n' | grep -E '\.(sprout|spr)$' || true)
[[ -z "$files" ]] && exit 0

FMT="./build/fmt_bin"
if [[ ! -x "$FMT" ]]; then
  echo "[pre-commit] $FMT absent — run: just build-fmt-from-seed" >&2
  exit 1
fi

needs_fmt=()
lint_failures=()
tmp=$(mktemp -d /tmp/sprout_hook_XXXXXX)
trap "rm -rf '$tmp'" EXIT

while IFS= read -r f; do
  [[ -z "$f" || ! -f "$f" ]] && continue
  if ! "$FMT" fmt --check "$f" > "$tmp/fmt.err" 2>&1; then
    needs_fmt+=("$f")
  fi
  if ! "$FMT" lint "$f" > "$tmp/lint.err" 2>&1; then
    lint_failures+=("$f: $(tr '\n' ' ' < "$tmp/lint.err" | head -c 200)")
  fi
done <<< "$files"

fail=0
if (( ${#needs_fmt[@]} > 0 )); then
  echo "[pre-commit] formatting drift:" >&2
  printf '  %s\n' "${needs_fmt[@]}" >&2
  echo "  fix: mise exec -- just fmt && git add <files>" >&2
  fail=1
fi
if (( ${#lint_failures[@]} > 0 )); then
  echo "[pre-commit] lint failures:" >&2
  printf '  %s\n' "${lint_failures[@]}" >&2
  echo "  inspect: just lint-file <path>" >&2
  fail=1
fi

exit $fail
