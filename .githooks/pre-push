#!/usr/bin/env bash
# Sprout pre-push hook: run the seed fixed point when a push touches stdlib/ or the seed.
# A rebase replays commits without running pre-commit, so this is where a stale seed shows.
# SPROUT_PRE_PUSH_CHECK replaces the check command (test-only; see scripts/test_pre_push.sh).

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

remote="$1"
zero='^0+$'  # git's null object id: 40 zeros, or 64 in a SHA-256 repo
need_check=0
refused=0

while read -r local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" =~ $zero ]] && continue

  if ! [[ "$remote_sha" =~ $zero ]] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    base="$remote_sha"
  else
    base=$(git merge-base "$local_sha" "refs/remotes/$remote/master" 2>/dev/null) || base=""
  fi

  # A pathspec `*` matches across `/`, so this covers stdlib/compiler/ too.
  if [[ -n "$base" ]] \
     && git diff --quiet "$base" "$local_sha" -- 'stdlib/*.sprout' bootstrap/compile_driver.ll; then
    continue
  fi

  # An annotated tag's sha names the tag object; compare the commit it points at.
  commit=$(git rev-parse -q --verify "${local_sha}^{commit}" || true)
  if [[ "$(git rev-parse HEAD)" != "$commit" ]] \
     || ! git diff --quiet HEAD -- stdlib bootstrap \
     || [[ -n "$(git ls-files --others --exclude-standard -- stdlib bootstrap)" ]]; then
    echo "[pre-push] the seed of $local_ref (${local_sha:0:9}) can't be verified from this checkout." >&2
    echo "    Check out that ref (commit or set aside stdlib/ and bootstrap/ changes, untracked too) and push again," >&2
    echo "    or run 'just verify-bootstrap-fixed-point' there and push with --no-verify." >&2
    refused=1
    continue
  fi
  need_check=1
done

(( refused )) && exit 1
(( need_check )) || exit 0

if ! bash -c "${SPROUT_PRE_PUSH_CHECK:-mise exec -- just verify-bootstrap-fixed-point}" >&2; then
  echo "[pre-push] the seed is stale for this tree." >&2
  echo "    Run: just pr-rebase   (after a rebase), or just refresh-seed and commit the seed," >&2
  echo "    then push again." >&2
  exit 1
fi
echo "[pre-push] seed fixed point ✓"
