# Codeberg PR workflow configuration — TEMPLATE.
#
# Copy this file to .codeberg.config (which is gitignored) and fill in
# your values. The codeberg-merge skill and the recipes in
# docs/codeberg-pr-workflow.md source .codeberg.config at startup.
#
# Nothing in this file is secret — the tea API token stays in your
# tea config file (path below) and is read at runtime, never copied
# into .codeberg.config.

# --- Repo coordinates -----------------------------------------------
# The Codeberg user or organization that owns the repo, and the repo
# name. Used to build API URLs like
#   https://codeberg.org/api/v1/repos/$CODEBERG_OWNER/$CODEBERG_REPO/...
CODEBERG_OWNER=<your-codeberg-username-or-org>
CODEBERG_REPO=<repo-name>

# --- tea config location --------------------------------------------
# Path to your tea CLI config file. The skill reads the API token from
# this file at runtime via:
#   grep -A2 'name: codeberg.org' "$TEA_CONFIG_PATH" | grep token | ...
#
# Platform defaults:
#   macOS:  $HOME/Library/Application Support/tea/config.yml
#   Linux:  $HOME/.config/tea/config.yml
TEA_CONFIG_PATH="$HOME/Library/Application Support/tea/config.yml"
