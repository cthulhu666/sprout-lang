import stdlib.test (TestState, new_state, assert_eq, assert_true, assert_false, summary)
import loam.galaxy_filter (num_classes, mask_all, mask_none, bit_test, bit_set, bit_clear, bit_toggle, popcount, class_name)

# loam.galaxy_filter holds the PURE spectral-class filter math for the galaxy-map demo. A "filter" is
# a class bitmask: bit c set == class c (0..11) is drawn. Sprout has NO bitwise operators (`>>`/`<<`
# are function composition!), so every mask op is integer arithmetic (division + parity) over pow2 —
# which is exactly why it lives here as a graphics-free, headless-tested module (like loam.galaxy_lod).
# The 12 classes mirror the demo palette / universegen classCode table:
#   0 O  1 B  2 A  3 F  4 G  5 K  6 M  7 Red Giant  8 White Dwarf  9 BH-stellar 10 BH-inter 11 BH-super

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    assert_eq(state, "num_classes", num_classes, 12)

    # mask_all sets exactly the low `num_classes` bits: 2^12 - 1 = 4095. mask_none = 0.
    assert_eq(state, "mask_all", mask_all, 4095)
    assert_eq(state, "mask_none", mask_none, 0)

    # bit_test reads a single class bit out of a mask.
    assert_true(state, "all shows class 0", bit_test(mask_all, 0))
    assert_true(state, "all shows class 11", bit_test(mask_all, 11))
    assert_false(state, "none shows class 6", bit_test(mask_none, 6))
    # A single mid bit: 2^6 = 64 shows only class 6 (M).
    assert_true(state, "just-M shows M", bit_test(64, 6))
    assert_false(state, "just-M hides O", bit_test(64, 0))
    assert_false(state, "just-M hides K", bit_test(64, 5))

    # bit_set is idempotent; bit_clear removes; bit_toggle flips.
    assert_eq(state, "set class 6 into empty", bit_set(mask_none, 6), 64)
    assert_eq(state, "set is idempotent", bit_set(64, 6), 64)
    assert_eq(state, "clear class 6 from all", bit_clear(mask_all, 6), 4095 - 64)
    assert_eq(state, "clear absent is no-op", bit_clear(mask_none, 6), 0)
    assert_eq(state, "toggle on", bit_toggle(mask_none, 3), 8)
    assert_eq(state, "toggle off", bit_toggle(8, 3), 0)
    # Setting two distinct bits accumulates (class 0 + class 1 = 1 + 2 = 3).
    assert_eq(state, "set two bits", bit_set(bit_set(mask_none, 0), 1), 3)

    # popcount = number of enabled classes (shown in the demo's "N/12" legend header).
    assert_eq(state, "popcount none", popcount(mask_none), 0)
    assert_eq(state, "popcount all", popcount(mask_all), 12)
    assert_eq(state, "popcount two", popcount(3), 2)
    assert_eq(state, "popcount just-M", popcount(64), 1)

    # class_name maps a code to its short palette label (used for checkbox rows).
    assert_eq(state, "class_name O", class_name(0), "O")
    assert_eq(state, "class_name M", class_name(6), "M")
    assert_eq(state, "class_name Red Giant", class_name(7), "Red Giant")
    assert_eq(state, "class_name BH super", class_name(11), "BH super")

    summary(state)
