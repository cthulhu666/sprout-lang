import stdlib.test (TestState, new_state, assert_true, summary)
import loam.scene (Scene, scene_new, spawn)
import loam.agent (world_step_flock, group_of)
import stdlib.mutable (mutvec_at)
import stdlib.rng (rng_below, rng_next)
import stdlib.math (sqrt)

# Flocking, tested headless — same model/view split as test_agent: world_step_flock
# is the SAME function the ecs_flocking view drives, so passing here means the flock
# behaviour is correct and reproducible, independent of any rendering.

# --- group_of bins entities round-robin ---
# (world_step_flock uses this exact function to assign centroids, so the test's
#  grouping and the engine's always agree.)

# Run the world forward `k` ticks with `groups` flocks.
fn run_steps(s: Scene, bound: Double, groups: Int, k: Int) -> Unit !{IO} =
  if k <= 0 then ()
  else
    do
      world_step_flock(s, bound, groups)
      run_steps(s, bound, groups, k - 1)

# --- Flocking measurement helpers ---
# A group's mean-distance-to-centroid: a scalar "spread" that SHRINKS as the flock
# tightens. Computed in scalar passes (sum_x, sum_z, count -> centroid; then
# distances) to avoid threading a tuple through IO recursion.

fn grp_sum_x(s: Scene, n: Int, groups: Int, g: Int, i: Int, acc: Double) -> Double !{IO} =
  if i >= n then acc
  else
    do
      x <- mutvec_at(s.pos_x, i)
      let a2 = if group_of(i, groups) == g then acc + x else acc
      grp_sum_x(s, n, groups, g, i + 1, a2)

fn grp_sum_z(s: Scene, n: Int, groups: Int, g: Int, i: Int, acc: Double) -> Double !{IO} =
  if i >= n then acc
  else
    do
      z <- mutvec_at(s.pos_z, i)
      let a2 = if group_of(i, groups) == g then acc + z else acc
      grp_sum_z(s, n, groups, g, i + 1, a2)

fn grp_count(s: Scene, n: Int, groups: Int, g: Int, i: Int, acc: Int) -> Int =
  if i >= n then acc
  else grp_count(s, n, groups, g, i + 1, if group_of(i, groups) == g then acc + 1 else acc)

fn grp_spread_go(s: Scene, n: Int, groups: Int, g: Int, cx: Double, cz: Double,
                 i: Int, acc: Double) -> Double !{IO} =
  if i >= n then acc
  else
    do
      x <- mutvec_at(s.pos_x, i)
      z <- mutvec_at(s.pos_z, i)
      let d = if group_of(i, groups) == g
              then sqrt(((x - cx) * (x - cx)) + ((z - cz) * (z - cz)))
              else 0.0
      grp_spread_go(s, n, groups, g, cx, cz, i + 1, acc + d)

# Mean distance of group g's members to their own centroid.
fn group_spread(s: Scene, n: Int, groups: Int, g: Int) -> Double !{IO} =
  do
    sx <- grp_sum_x(s, n, groups, g, 0, 0.0)
    sz <- grp_sum_z(s, n, groups, g, 0, 0.0)
    let c = grp_count(s, n, groups, g, 0, 0)
    total <- grp_spread_go(s, n, groups, g, sx / to_double(c), sz / to_double(c), 0, 0.0)
    total / to_double(c)

# Spawn `n` agents into 2 groups: even ids around home (-12,0), odd ids around
# (+12,0), each jittered so the flocks START spread out. group_of(i, 2) matches this.
# Seeds are advanced through rng_next first: rng_below reads the HIGH bits, so a raw
# small seed (< 65536) would divide to 0 and give every agent identical jitter.
fn spawn_flock(s: Scene, n: Int, i: Int) -> Unit !{IO} =
  if i >= n then ()
  else
    do
      let seed = rng_next(rng_next((i + 1) * 7919))
      let hx = if group_of(i, 2) == 0 then (-12.0) else 12.0
      let jx = (to_double(rng_below(seed, 200)) / 100.0 - 1.0) * 6.0  # [-6, 6]
      let jz = (to_double(rng_below(rng_next(seed), 200)) / 100.0 - 1.0) * 6.0
      let hd = to_double(rng_below(rng_next(rng_next(seed)), 628)) / 100.0
      id <- spawn(s, 1, hx + jx, jz, hd, seed, 100.0)
      spawn_flock(s, n, i + 1)

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # --- group_of: round-robin binning, singleton degenerate ---
    assert_true(state, "group_of round-robins", (group_of(0, 3) == 0) && (group_of(4, 3) == 1))
    assert_true(state, "group_of collapses to 0 for one group", group_of(7, 1) == 0)

    # --- world_step_flock is deterministic: same seeds => same trajectory ---
    sA <- scene_new(8)
    spawn_flock(sA, 8, 0)
    run_steps(sA, 30.0, 2, 20)
    sB <- scene_new(8)
    spawn_flock(sB, 8, 0)
    run_steps(sB, 30.0, 2, 20)
    axA <- mutvec_at(sA.pos_x, 3)
    axB <- mutvec_at(sB.pos_x, 3)
    azA <- mutvec_at(sA.pos_z, 3)
    azB <- mutvec_at(sB.pos_z, 3)
    assert_true(state, "flock deterministic pos_x", axA == axB)
    assert_true(state, "flock deterministic pos_z", azA == azB)

    # --- Flocking: same-group agents converge (each group's spread shrinks) ---
    # Two groups spawned as loose, well-separated clouds. After ticks of cohesion,
    # each group's mean distance to its own centroid must drop — that IS flocking.
    # The arena (30) is far larger than the clusters, so no wall interaction; energy
    # (100) minus 40*spend(0.5)=20 keeps everyone walking the whole run.
    sF <- scene_new(8)
    spawn_flock(sF, 8, 0)
    before0 <- group_spread(sF, 8, 2, 0)
    before1 <- group_spread(sF, 8, 2, 1)
    run_steps(sF, 30.0, 2, 40)
    after0 <- group_spread(sF, 8, 2, 0)
    after1 <- group_spread(sF, 8, 2, 1)
    assert_true(state, "flock: group 0 tightened", after0 < before0)
    assert_true(state, "flock: group 1 tightened", after1 < before1)
    # And the two flocks stay APART — cohesion pulls to the OWN group, not merge.
    c0x <- grp_sum_x(sF, 8, 2, 0, 0, 0.0)
    c1x <- grp_sum_x(sF, 8, 2, 1, 0, 0.0)
    assert_true(state, "flock: groups stay separated on x", (c0x / 4.0) < (c1x / 4.0))

    summary(state)
