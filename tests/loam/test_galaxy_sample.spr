import stdlib.test (check_eq, check_true, run_suite)
import loam.galaxy_sample (star_hash, hash01, sample_seed, level_thresholds, keep_level)

# loam.galaxy_sample holds the PURE spatially-uniform sampling math for the galaxy-map demo's
# class-balanced rebalance. The critical property (the P2 clump-bug regression) is that whether a star
# is kept depends only on hash(id), which is UNCORRELATED with position — so even when id is perfectly
# correlated with position (the worst case that produced the original clump), the kept set is spread
# across the whole tile rather than confined to one sub-quadrant.

# Index into a List Double (avoids relying on a ToString/Eq instance for List in the harness).
fn dnth(xs: List Double, i: Int) -> Double =
  match xs with
  | Nil -> 0.0 - 1.0
  | Cons x rest -> if i <= 0 then x else dnth(rest, i - 1)

# Count ids in [lo, hi) that a hash-threshold `f` would KEEP (hash01 < f). Tail-recursive so the ~4000
# element sweep below does not grow the stack. `id` stands in for position: the test feeds a range in
# which id increases monotonically with x, the exact input that clumped under the old "keep first N".
fn kept_count_go(id: Int, hi: Int, f: Double, acc: Int) -> Int =
  if id >= hi then acc
  else kept_count_go(id + 1, hi, f, acc + (if hash01(id, sample_seed) < f then 1 else 0))
fn kept_count(lo: Int, hi: Int, f: Double) -> Int = kept_count_go(lo, hi, f, 0)

# abs for Double (stdlib.math.abs is Int-only); local so the test stays self-contained.
fn abs_d(x: Double) -> Double = if x < 0.0 then 0.0 - x else x
fn in01(h: Double) -> Bool = (h >= 0.0) && (h < 1.0)

fn main() -> Unit !{IO} =
  run_suite("galaxy_sample", [
    # --- hash01 is a normalized variate in [0, 1) ---
    check_true("hash01 id 0 in [0,1)", in01(hash01(0, sample_seed))),
    check_true("hash01 id 999999 in [0,1)", in01(hash01(999999, sample_seed))),
    # Consecutive ids do NOT produce adjacent hashes (the decorrelation the sampler relies on): at least
    # one of the first three gaps is large. A linear/identity hash would fail this.
    check_true("consecutive ids decorrelated",
      (abs_d(hash01(1, sample_seed) - hash01(0, sample_seed)) > 0.2)
         || (abs_d(hash01(2, sample_seed) - hash01(1, sample_seed)) > 0.2)
         || (abs_d(hash01(3, sample_seed) - hash01(2, sample_seed)) > 0.2)),

    # --- level_thresholds: cumulative min(1, t_{L-1} + budget/count_L) ---
    # counts [400,200,100], budget 100 -> [0.25, 0.75, 1.0] (all exact in binary float).
    check_true("threshold L0 == 0.25", dnth(level_thresholds([400, 200, 100], 100), 0) == 0.25),
    check_true("threshold L1 == 0.75", dnth(level_thresholds([400, 200, 100], 100), 1) == 0.75),
    check_true("threshold L2 caps at 1.0", dnth(level_thresholds([400, 200, 100], 100), 2) == 1.0),
    # Sparse class (count <= budget): threshold saturates at 1.0 immediately -> everything kept at L0.
    check_true("sparse threshold caps 1.0", dnth(level_thresholds([50, 50], 100), 0) == 1.0),
    # Defensive zero guard: no division by zero, threshold is 1.0 (keep).
    check_true("zero-count guard -> 1.0", dnth(level_thresholds([0], 100), 0) == 1.0),

    # --- keep_level: shallowest level whose threshold h falls under, else -1 ---
    check_eq("keep L0 (h=0.1)", keep_level(0.1, [0.25, 0.75, 1.0]), 0),
    check_eq("keep L1 (h=0.5)", keep_level(0.5, [0.25, 0.75, 1.0]), 1),
    check_eq("keep L2 (h=0.9)", keep_level(0.9, [0.25, 0.75, 1.0]), 2),
    check_eq("drop above all (h=1.0)", keep_level(1.0, [0.25, 0.75, 1.0]), 0 - 1),
    check_eq("keep sparse at L0 (h=0.99)", keep_level(0.99, [1.0, 1.0]), 0),

    # --- THE CLUMP REGRESSION -------------------------------------------------------------------
    # 4000 stars whose id increases with x. Keep a ~1/4 hash-threshold sample. The kept set MUST reach
    # into every quarter of the id (position) range; the old "keep first N" kept only quarter 0, so the
    # three assertions on quarters 1..3 are the ones that fail on the clumped implementation.
    check_true("kept reaches quarter 0", kept_count(0, 1000, 0.25) > 0),
    check_true("kept reaches quarter 1", kept_count(1000, 2000, 0.25) > 0),
    check_true("kept reaches quarter 2", kept_count(2000, 3000, 0.25) > 0),
    check_true("kept reaches quarter 3", kept_count(3000, 4000, 0.25) > 0),
    # And the sample size is ~budget fraction (uniformity): 0.25 * 4000 = 1000, allow generous slack.
    check_true("kept count >= 800 (uniform)", kept_count(0, 4000, 0.25) > 800),
    check_true("kept count <= 1200 (uniform)", kept_count(0, 4000, 0.25) < 1200)
  ])
