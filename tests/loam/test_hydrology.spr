import stdlib.test (TestState, new_state, assert_eq, assert_true, summary)
import loam.terrain (Config, elev_at, sea_level)
import loam.hydrology (Hydrology, HydroParams, default_hydro_params, carve_depth, widen_radius, widen_rivers, meander_offset, meander_gate, meander_rivers, compute_hydrology, hydro_tier, hydro_dir, hydro_filled, dir_delta)
import stdlib.mutable (MutMatrix, mutmatrix_new, mutmatrix_set, mutmatrix_at_or)

# loam.hydrology computes drainage over a bounded region as a PURE function of (cfg, span):
# it fills depressions (Planchon-Darboux), assigns a D8 flow direction to every cell, walks
# accumulation downstream, and buckets it into a flow_tier (0 = no river). Every property below
# is asserted headlessly (no window), exactly like tests/loam/test_terrain.spr. The invariants
# that matter most are TERMINATION guards: a flow field with a cycle would hang the gfx demo,
# so we prove (a) every cell drains to a valid outlet within a bounded number of steps and
# (b) every non-sink cell flows to a STRICTLY lower filled-elevation neighbor (no A->B->A).

# A small region: same terrain params as the demo (seed/octaves/lattice0) so the test exercises
# the world the example renders; span kept modest for test speed.
let cfg = Config(seed = 2137, chunk_size = 8, octaves = 5, lattice0 = 24, elevation_levels = 12)
let span = 128

# A cell is a valid drainage outlet iff it is sea (below sea_level) or on the map border
# (drains off-map). Interior pits must NOT be outlets — that is the whole point of filling.
fn is_outlet(gx: Int, gz: Int) -> Bool =
  let is_sea = elev_at(cfg, gx, gz) < sea_level
      is_border = (gx == 0) || (gz == 0) || (gx == (span - 1)) || (gz == (span - 1))
  in is_sea || is_border

# Walk downstream from (gx, gz) following flow_dir; return 1 if it FAILS to reach a valid outlet
# within a step cap (a cap hit means a cycle/non-terminating field — a loud failure, not a hang),
# else 0. Bounded depth (<= 4*span), so this recursion is always shallow.
fn drains_bad(gx: Int, gz: Int, steps: Int, h: Hydrology) -> Int !{IO} =
  if steps > (4 * span) then 1
  else
    do
      d <- hydro_dir(h, gx, gz)
      if d == 0 then (if is_outlet(gx, gz) then 0 else 1)
      else
        match dir_delta(d) with
        | (dr, dc) -> drains_bad(gx + dc, gz + dr, steps + 1, h)

# Sweep every cell, summing drains_bad. 0 == every cell drains to a valid outlet (no inland
# dead-ends, no cycles). Int-returning direct tail recursion (TCO-safe at span^2 cells).
fn scan_drainage(r: Int, c: Int, acc: Int, h: Hydrology) -> Int !{IO} =
  if r >= span then acc
  else if c >= span then scan_drainage(r + 1, 0, acc, h)
  else
    do
      bad <- drains_bad(c, r, 0, h)
      scan_drainage(r, c + 1, acc + bad, h)

# 1 if the cell is non-sink but its downstream neighbor is NOT strictly lower (the failure mode
# that permits cycles), else 0.
fn descent_bad(gx: Int, gz: Int, h: Hydrology) -> Int !{IO} =
  do
    d <- hydro_dir(h, gx, gz)
    if d == 0 then 0
    else
      match dir_delta(d) with
      | (dr, dc) ->
          do
            here <- hydro_filled(h, gx, gz)
            there <- hydro_filled(h, gx + dc, gz + dr)
            if there < here then 0 else 1

fn scan_descent(r: Int, c: Int, acc: Int, h: Hydrology) -> Int !{IO} =
  if r >= span then acc
  else if c >= span then scan_descent(r + 1, 0, acc, h)
  else
    do
      bad <- descent_bad(c, r, h)
      scan_descent(r, c + 1, acc + bad, h)

# Count river cells (flow_tier > 0) so the suite isn't vacuously green on an all-zero field.
fn count_rivers(r: Int, c: Int, acc: Int, h: Hydrology) -> Int !{IO} =
  if r >= span then acc
  else if c >= span then count_rivers(r + 1, 0, acc, h)
  else
    do
      t <- hydro_tier(h, c, r)
      count_rivers(r, c + 1, acc + (if t > 0 then 1 else 0), h)

# Count flow_tier cells that differ between two runs (determinism check). 0 == identical.
fn tier_diff(r: Int, c: Int, acc: Int, a: Hydrology, b: Hydrology) -> Int !{IO} =
  if r >= span then acc
  else if c >= span then tier_diff(r + 1, 0, acc, a, b)
  else
    do
      ta <- hydro_tier(a, c, r)
      tb <- hydro_tier(b, c, r)
      tier_diff(r, c + 1, acc + (if ta == tb then 0 else 1), a, b)

# --- Meander helpers (all headless; meander_offset is PURE, so no window/IO) -----------------
fn iabs(x: Int) -> Int = if x < 0 then 0 - x else x

# Count cells in a 32×32 scan whose meander_offset escapes [-amp, amp] on either axis (must be 0).
fn moff_unbounded(seed: Int, amp: Int, wl: Int, r: Int, c: Int) -> Int =
  if r >= 32 then 0
  else if c >= 32 then moff_unbounded(seed, amp, wl, r + 1, 0)
  else
    match meander_offset(seed, c, r, amp, wl) with
    | (ox, oz) ->
        (if (iabs(ox) > amp) || (iabs(oz) > amp) then 1 else 0)
          + moff_unbounded(seed, amp, wl, r, c + 1)

# Count cells with a non-zero displacement (proves the field is not vacuously flat).
fn moff_nonzero(seed: Int, amp: Int, wl: Int, r: Int, c: Int) -> Int =
  if r >= 32 then 0
  else if c >= 32 then moff_nonzero(seed, amp, wl, r + 1, 0)
  else
    match meander_offset(seed, c, r, amp, wl) with
    | (ox, oz) ->
        (if (ox != 0) || (oz != 0) then 1 else 0) + moff_nonzero(seed, amp, wl, r, c + 1)

# Count horizontally-adjacent cell pairs whose ox jumps by more than `bound` (coherence: a smooth
# field never teleports the ribbon, so with a generous bound this is 0 — the anti-tear guarantee).
fn moff_incoherent(seed: Int, amp: Int, wl: Int, bound: Int, r: Int, c: Int) -> Int =
  if r >= 32 then 0
  else if c >= 31 then moff_incoherent(seed, amp, wl, bound, r + 1, 0)
  else
    match meander_offset(seed, c, r, amp, wl) with
    | (ox0, oz0) ->
        match meander_offset(seed, c + 1, r, amp, wl) with
        | (ox1, oz1) ->
            (if iabs(ox1 - ox0) > bound then 1 else 0)
              + moff_incoherent(seed, amp, wl, bound, r, c + 1)

# Paint a horizontal tier-2 river line across row `row` of a 32×32 grid.
fn paint_river_row(m: MutMatrix Int, row: Int, c: Int) -> Int !{IO} =
  if c >= 32 then 0
  else
    do
      mutmatrix_set(m, row, c, 2)
      paint_river_row(m, row, c + 1)

# Count cells that differ between two 32×32 flow_tier grids (0 == identical masks).
fn grid_diff(a: MutMatrix Int, b: MutMatrix Int, r: Int, c: Int, acc: Int) -> Int !{IO} =
  if r >= 32 then acc
  else if c >= 32 then grid_diff(a, b, r + 1, 0, acc)
  else
    do
      va <- mutmatrix_at_or(a, r, c, 0)
      vb <- mutmatrix_at_or(b, r, c, 0)
      grid_diff(a, b, r, c + 1, acc + (if va == vb then 0 else 1))

# Count river cells (tier > 0) in a 32×32 grid.
fn grid_rivers(m: MutMatrix Int, r: Int, c: Int, acc: Int) -> Int !{IO} =
  if r >= 32 then acc
  else if c >= 32 then grid_rivers(m, r + 1, 0, acc)
  else
    do
      v <- mutmatrix_at_or(m, r, c, 0)
      grid_rivers(m, r, c + 1, acc + (if v > 0 then 1 else 0))

# Set flow_dir = 3 (East) along `row` for cols 0..30 (col 31 left as 0 = outlet), so meander_scatter
# has a real downstream to bridge to along the row.
fn paint_dir_east(m: MutMatrix Int, row: Int, c: Int) -> Int !{IO} =
  if c >= 31 then 0
  else
    do
      mutmatrix_set(m, row, c, 3)
      paint_dir_east(m, row, c + 1)

# 1 if any cell in column `col` (rows 0..31) is a river cell, else 0.
fn col_occupied(m: MutMatrix Int, col: Int, r: Int) -> Int !{IO} =
  if r >= 32 then 0
  else
    do
      v <- mutmatrix_at_or(m, r, col, 0)
      if v > 0 then 1 else col_occupied(m, col, r + 1)

fn first_occ_col(m: MutMatrix Int, col: Int) -> Int !{IO} =
  if col >= 32 then 32
  else
    do
      o <- col_occupied(m, col, 0)
      if o > 0 then col else first_occ_col(m, col + 1)

fn last_occ_col(m: MutMatrix Int, col: Int, best: Int) -> Int !{IO} =
  if col >= 32 then best
  else
    do
      o <- col_occupied(m, col, 0)
      last_occ_col(m, col + 1, if o > 0 then col else best)

# Count columns strictly between the first and last occupied column that hold NO river cell — the
# signature of a torn (dashed) horizontal ribbon. A connected ribbon has zero such gaps.
fn gap_cols(m: MutMatrix Int, col: Int, maxc: Int, acc: Int) -> Int !{IO} =
  if col >= maxc then acc
  else
    do
      o <- col_occupied(m, col, 0)
      gap_cols(m, col + 1, maxc, acc + (if o == 0 then 1 else 0))

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    h <- compute_hydrology(cfg, span, default_hydro_params())

    # --- Termination: every cell drains to a valid outlet, no cycles ---
    dead_ends <- scan_drainage(0, 0, 0, h)
    assert_eq(state, "hydrology: no inland dead-ends / cycles (every cell drains to sea or edge)",
              dead_ends, 0)

    # --- Strict descent: flow_dir always points to a strictly-lower filled neighbor ---
    descent_violations <- scan_descent(0, 0, 0, h)
    assert_eq(state, "hydrology: flow points strictly downhill (no flat/equal steps)",
              descent_violations, 0)

    # --- Non-vacuous: some rivers actually form ---
    rivers <- count_rivers(0, 0, 0, h)
    assert_true(state, "hydrology: some river cells exist", rivers > 0)

    # --- Determinism: same (cfg, span) yields an identical flow_tier field ---
    h2 <- compute_hydrology(cfg, span, default_hydro_params())
    diffs <- tier_diff(0, 0, 0, h, h2)
    assert_eq(state, "hydrology: deterministic (same seed+span => identical rivers)", diffs, 0)

    # --- Thresholds are honored: cutoffs above any achievable drainage area (a span^2 region has
    #     at most span^2 = 16384 cells of accumulation) leave NO river cells, proving flow_tier
    #     actually reads HydroParams rather than a hardcoded threshold. ---
    h_strict <- compute_hydrology(cfg, span,
                                  HydroParams(tier1_min = 100000, tier2_min = 200000, tier3_min = 900000,
                                              carve1 = 1, carve2 = 2, carve3 = 3, widen2 = 0, widen3 = 1,
                                              meander_amp = 0, meander_wavelength = 24))
    rivers_strict <- count_rivers(0, 0, 0, h_strict)
    assert_true(state, "hydrology: raising the tier thresholds yields fewer river cells",
                rivers_strict < rivers)

    # --- Carve depth: 0 for non-river/sea (tier 0), the per-tier depth otherwise, MONOTONIC in tier
    #     (bigger rivers cut deeper — the property that keeps a carved river flowing downhill). ---
    let dp = default_hydro_params()
    assert_eq(state, "carve: tier 0 (no river) is not carved", carve_depth(dp, 0), 0)
    assert_eq(state, "carve: tier 1 (creek) depth", carve_depth(dp, 1), 1)
    assert_eq(state, "carve: tier 2 (river) depth", carve_depth(dp, 2), 2)
    assert_eq(state, "carve: tier 3 (major) depth", carve_depth(dp, 3), 3)
    assert_true(state, "carve: monotonic non-decreasing in tier",
                (carve_depth(dp, 0) <= carve_depth(dp, 1)) && (carve_depth(dp, 1) <= carve_depth(dp, 2))
                  && (carve_depth(dp, 2) <= carve_depth(dp, 3)))
    let dp2 = HydroParams(tier1_min = 40, tier2_min = 200, tier3_min = 900, carve1 = 5, carve2 = 6, carve3 = 7,
                          widen2 = 0, widen3 = 1, meander_amp = 0, meander_wavelength = 24)
    assert_eq(state, "carve: honors HydroParams carve depths", carve_depth(dp2, 1), 5)

    # --- Widen radius: creeks (tier ≤ 1) never widen, river = widen2, major = widen3. ---
    assert_eq(state, "widen: creek radius is 0", widen_radius(dp, 1), 0)
    assert_eq(state, "widen: river radius (default widen2=0)", widen_radius(dp, 2), 0)
    assert_eq(state, "widen: major radius (default widen3=1)", widen_radius(dp, 3), 1)
    let dpw = HydroParams(tier1_min = 40, tier2_min = 200, tier3_min = 900, carve1 = 1, carve2 = 2, carve3 = 3,
                          widen2 = 1, widen3 = 2, meander_amp = 0, meander_wavelength = 24)
    assert_eq(state, "widen: honors HydroParams widen radii", widen_radius(dpw, 3), 2)

    # --- widen_rivers dilates the flow_tier grid in place. Synthetic 3×3: one major (tier 3) at the
    #     centre; with widen3=1 every neighbour (Chebyshev dist 1) is promoted to tier 3. With
    #     widen3=0 nothing spreads. Built directly (not via compute_hydrology) so the check is exact. ---
    ft <- mutmatrix_new(3, 3, 0)
    mutmatrix_set(ft, 1, 1, 3)  # centre cell = major river
    fd <- mutmatrix_new(3, 3, 0)
    fl <- mutmatrix_new(3, 3, 0.0)
    let hw = Hydrology(span = 3, filled = fl, flow_dir = fd, flow_tier = ft)
    widen_rivers(hw, dp, 3)  # dp has widen3 = 1
    corner <- hydro_tier(hw, 0, 0)  # a corner, Chebyshev dist 1 from centre
    centre <- hydro_tier(hw, 1, 1)
    assert_eq(state, "widen: major river spreads to a diagonal neighbour", corner, 3)
    assert_eq(state, "widen: the core major cell is unchanged", centre, 3)

    ft0 <- mutmatrix_new(3, 3, 0)
    mutmatrix_set(ft0, 1, 1, 3)
    fd0 <- mutmatrix_new(3, 3, 0)
    fl0 <- mutmatrix_new(3, 3, 0.0)
    let hw0 = Hydrology(span = 3, filled = fl0, flow_dir = fd0, flow_tier = ft0)
    let no_widen = HydroParams(tier1_min = 40, tier2_min = 200, tier3_min = 900, carve1 = 1, carve2 = 2, carve3 = 3,
                               widen2 = 0, widen3 = 0, meander_amp = 0, meander_wavelength = 24)
    widen_rivers(hw0, no_widen, 3)
    corner0 <- hydro_tier(hw0, 0, 0)
    assert_eq(state, "widen: radius 0 leaves neighbours untouched", corner0, 0)

    # --- Meander: meander_offset is a coherent, bounded, deterministic lateral displacement field.
    #     These are PURE (no terrain, no window) so the offsets are fully predictable from (seed, amp,
    #     wl). amp=3, wl=8 over a 32×32 scan. ---
    let mseed = 2137
    let out_of_range = moff_unbounded(mseed, 3, 8, 0, 0)
    assert_eq(state, "meander: offset stays within [-amp, amp] on both axes", out_of_range, 0)
    let nonzero = moff_nonzero(mseed, 3, 8, 0, 0)
    assert_true(state, "meander: displacement field is non-vacuous (some cells move)", nonzero > 0)
    let jumps = moff_incoherent(mseed, 3, 8, 3, 0, 0)
    assert_eq(state, "meander: field is coherent (no adjacent-cell teleport beyond amp)", jumps, 0)
    let amp0x = moff_nonzero(mseed, 0, 8, 0, 0)
    assert_eq(state, "meander: amp 0 is an exact no-op (zero displacement everywhere)", amp0x, 0)

    # --- meander_rivers relocates the river mask (flow_tier only), forward-scattered so a thin line
    #     stays connected. On a FLAT cfg (octaves 1, huge lattice → ~constant elevation) the flatness
    #     gate opens fully, so displacement is visible. Compare against an un-meandered reference. ---
    let flat_cfg = Config(seed = mseed, chunk_size = 8, octaves = 1, lattice0 = 100000, elevation_levels = 12)
    let mparams = HydroParams(tier1_min = 40, tier2_min = 200, tier3_min = 900,
                              carve1 = 1, carve2 = 2, carve3 = 3, widen2 = 0, widen3 = 0,
                              meander_amp = 3, meander_wavelength = 8)
    # Reference grid (never meandered) and the run grid (meandered), both a tier-2 line across row 16.
    ref_t <- mutmatrix_new(32, 32, 0)
    paint_river_row(ref_t, 16, 0)
    run_t <- mutmatrix_new(32, 32, 0)
    paint_river_row(run_t, 16, 0)
    ref_d <- mutmatrix_new(32, 32, 0)
    run_d <- mutmatrix_new(32, 32, 0)
    ref_f <- mutmatrix_new(32, 32, 0.0)
    run_f <- mutmatrix_new(32, 32, 0.0)
    let h_ref = Hydrology(span = 32, filled = ref_f, flow_dir = ref_d, flow_tier = ref_t)
    let h_run = Hydrology(span = 32, filled = run_f, flow_dir = run_d, flow_tier = run_t)
    meander_rivers(h_run, flat_cfg, mparams, 32)
    moved <- grid_diff(ref_t, run_t, 0, 0, 0)
    assert_true(state, "meander_rivers: displaces the river mask (some cells relocate)", moved > 0)
    river_ct <- grid_rivers(run_t, 0, 0, 0)
    assert_true(state, "meander_rivers: river cells survive relocation (not erased)", river_ct > 0)

    # Determinism: a second identical run relocates cells to exactly the same places.
    run2_t <- mutmatrix_new(32, 32, 0)
    paint_river_row(run2_t, 16, 0)
    run2_d <- mutmatrix_new(32, 32, 0)
    run2_f <- mutmatrix_new(32, 32, 0.0)
    let h_run2 = Hydrology(span = 32, filled = run2_f, flow_dir = run2_d, flow_tier = run2_t)
    meander_rivers(h_run2, flat_cfg, mparams, 32)
    run_diff <- grid_diff(run_t, run2_t, 0, 0, 0)
    assert_eq(state, "meander_rivers: deterministic (same seed => identical relocation)", run_diff, 0)

    # amp 0 is an exact no-op: the mask is byte-identical to the un-meandered reference.
    let nom_params = HydroParams(tier1_min = 40, tier2_min = 200, tier3_min = 900,
                                 carve1 = 1, carve2 = 2, carve3 = 3, widen2 = 0, widen3 = 0,
                                 meander_amp = 0, meander_wavelength = 8)
    nom_t <- mutmatrix_new(32, 32, 0)
    paint_river_row(nom_t, 16, 0)
    nom_d <- mutmatrix_new(32, 32, 0)
    nom_f <- mutmatrix_new(32, 32, 0.0)
    let h_nom = Hydrology(span = 32, filled = nom_f, flow_dir = nom_d, flow_tier = nom_t)
    meander_rivers(h_nom, flat_cfg, nom_params, 32)
    nom_diff <- grid_diff(ref_t, nom_t, 0, 0, 0)
    assert_eq(state, "meander_rivers: amp 0 is an exact no-op (mask unchanged)", nom_diff, 0)

    # --- Flatness gate: the carve-correctness gate has three branches (full / half / zero amplitude).
    #     Test them directly against known relief values so gorge-protection is not left uncovered. ---
    assert_eq(state, "gate: floodplain (relief 0) => full amplitude", meander_gate(0.0, 4), 4)
    assert_eq(state, "gate: moderate slope (relief 0.05) => half amplitude", meander_gate(0.05, 4), 2)
    assert_eq(state, "gate: gorge (relief 0.10) => zero amplitude (river pinned to D8 path)", meander_gate(0.10, 4), 0)
    assert_eq(state, "gate: flat_max boundary (0.04) => half amplitude", meander_gate(0.04, 4), 2)
    assert_eq(state, "gate: steep_min boundary (0.08) => zero amplitude", meander_gate(0.08, 4), 0)

    # --- Ribbon connectivity: forward-scatter alone tears a thin ribbon where the integer offset
    #     increments (consecutive targets land 2 apart). meander_scatter bridges along flow_dir, so the
    #     relocated ribbon has NO column gap between its first and last occupied column. Synthetic
    #     tier-2 river row 16 flowing East, on a flat cfg (full amplitude), amp=3/wl=8 (offset varies
    #     across the row). This assertion FAILS on single-cell scatter and PASSES on bridged scatter. ---
    conn_t <- mutmatrix_new(32, 32, 0)
    paint_river_row(conn_t, 16, 0)
    conn_d <- mutmatrix_new(32, 32, 0)
    paint_dir_east(conn_d, 16, 0)
    conn_f <- mutmatrix_new(32, 32, 0.0)
    let h_conn = Hydrology(span = 32, filled = conn_f, flow_dir = conn_d, flow_tier = conn_t)
    meander_rivers(h_conn, flat_cfg, mparams, 32)
    minc <- first_occ_col(conn_t, 0)
    maxc <- last_occ_col(conn_t, 0, 0)
    conn_gaps <- gap_cols(conn_t, minc, maxc, 0)
    assert_eq(state, "meander_rivers: relocated ribbon is connected (no column gaps)", conn_gaps, 0)

    summary(state)
