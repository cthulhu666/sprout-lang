import stdlib.test (check_true, run_suite)
import stdlib.math (fabs)
import loam.supercruise (sc_idle, sc_align, sc_spool, sc_cruise, sc_speed, sc_step, sc_arrived, sc_advance)

# loam.supercruise — the PURE intra-system supercruise logic for the galaxy-map demo (FTL iteration
# 2). On-rails point-and-go: pick a body in the ship vista, engage, and the ship's AU position slides
# toward it at a proximity-scaled speed, auto-dropping at a standoff radius. No graphics, no IO — just
# the closing kinematics and the phase machine, so it is unit-tested here; the demo threads the ship
# AU position + phase/timer through its render loop and feeds the moving position to project_body.
#
# Guards: the clamped proximity speed, one-frame stepping toward the target, convergence to the
# standoff ring, the standoff arrival test, and every phase transition (spool charge -> cruise ->
# drop when arrived, and the blocked-when-!can idle case).

fn near(a: Double, b: Double) -> Bool = fabs(a - b) < 0.0001

fn near2(res: (Double, Double), ex: Double, ez: Double) -> Bool =
  match res with
  | (x, z) -> near(x, ex) && near(z, ez)

fn ph_ok(res: (Int, Double), ep: Int, et: Double) -> Bool =
  match res with
  | (p, t) -> (p == ep) && near(t, et)

# Iterate sc_step n times from (sx,sz) toward a fixed target (10,0), to test convergence.
fn run_sc(sx: Double, sz: Double, n: Int) -> (Double, Double) =
  if n <= 0 then (sx, sz)
  else
    match sc_step(sx, sz, 10.0, 0.0, 0.5, 0.6, 0.05, 2.0, 0.5) with
    | (nx, nz) -> run_sc(nx, nz, n - 1)

fn arrived_after(n: Int) -> Bool =
  match run_sc(0.0, 0.0, n) with
  | (x, z) -> sc_arrived(x, z, 10.0, 0.0, 0.5)

fn main() -> Unit !{IO} =
  run_suite("supercruise", [
    # --- sc_speed: proportional to remaining approach distance, clamped to [v_min, v_max] ---
    check_true("speed clamps to v_max when far", near(sc_speed(100.0, 0.5, 0.05, 2.0), 2.0)),
    check_true("speed clamps to v_min when near", near(sc_speed(0.01, 0.5, 0.05, 2.0), 0.05)),
    check_true("speed proportional in range", near(sc_speed(2.0, 0.5, 0.05, 2.0), 1.0)),
    # --- sc_arrived: within the standoff radius of the target (inclusive) ---
    check_true("arrived inside standoff", sc_arrived(0.0, 0.0, 3.0, 4.0, 6.0)),
    check_true("not arrived outside standoff",! sc_arrived (0.0, 0.0, 3.0, 4.0, 4.0)),
    check_true("arrived at standoff boundary", sc_arrived(0.0, 0.0, 3.0, 4.0, 5.0)),
    # --- sc_step: one frame moves toward the target; never overshoots past it ---
    # remaining-to-standoff = 10-1 = 9; speed = clamp(9*0.5, .05, 2) = 2; travel = 2*1 = 2 along +x.
    check_true("step moves toward target", near2(sc_step(0.0, 0.0, 10.0, 0.0, 1.0, 0.5, 0.05, 2.0, 1.0), 2.0, 0.0)),
    check_true("step no move when already inside standoff", near2(sc_step(9.5, 0.0, 10.0, 0.0, 1.0, 0.5, 0.05, 2.0, 1.0), 9.5, 0.0)),
    # --- convergence: repeated stepping reaches the standoff ring ---
    check_true("converges to standoff", arrived_after(100)),
    check_true("not yet arrived after 1 step",! arrived_after (1)),
    # --- sc_advance: the phase machine (idle -> align -> spool -> cruise -> drop) ---
    # signature: sc_advance(phase, timer, dt, engage, can, aligned, arrived, spool_s)
    # idle now enters ALIGN (rotate to bearing) before spool; align holds until `aligned`.
    check_true("idle+engage+can -> align",
      ph_ok(sc_advance(sc_idle, 0.0, 0.016, true, true, false, false, 1.0), sc_align, 0.0)),
    check_true("idle+engage+!can stays idle",
      ph_ok(sc_advance(sc_idle, 0.0, 0.016, true, false, false, false, 1.0), sc_idle, 0.0)),
    check_true("idle+!engage stays idle",
      ph_ok(sc_advance(sc_idle, 0.0, 0.016, false, true, false, false, 1.0), sc_idle, 0.0)),
    check_true("align + !aligned accumulates timer",
      ph_ok(sc_advance(sc_align, 0.5, 0.3, false, true, false, false, 1.0), sc_align, 0.8)),
    check_true("align + aligned -> spool",
      ph_ok(sc_advance(sc_align, 0.4, 0.1, false, true, true, false, 1.0), sc_spool, 0.0)),
    check_true("spool accumulates timer",
      ph_ok(sc_advance(sc_spool, 0.5, 0.3, false, true, false, false, 1.0), sc_spool, 0.8)),
    check_true("spool -> cruise at spool_s",
      ph_ok(sc_advance(sc_spool, 0.9, 0.2, false, true, false, false, 1.0), sc_cruise, 0.0)),
    check_true("cruise + !arrived stays cruise",
      ph_ok(sc_advance(sc_cruise, 0.0, 0.1, false, true, false, false, 1.0), sc_cruise, 0.1)),
    check_true("cruise + arrived -> idle",
      ph_ok(sc_advance(sc_cruise, 5.0, 0.1, false, true, false, true, 1.0), sc_idle, 0.0))
  ])
