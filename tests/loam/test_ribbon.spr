import stdlib.test (TestState, new_state, assert_true, summary)
import loam.hydrology (Hydrology)
import loam.ribbon (smooth_positions, ribbon_px, ribbon_pz)
import stdlib.mutable (MutMatrix, mutmatrix_new, mutmatrix_set, mutmatrix_at_or)
import stdlib.math (fabs)

# loam.ribbon smooths the D8 river centerline (a chain of grid-cell centers with 45°/90° kinks) into
# rounded positions for a smooth water-ribbon mesh. smooth_positions runs a neighbour-averaging pass
# over river cells (tier>0), pulling each cell's centerline point toward the mean of its river
# neighbours' points — so a straight run is unchanged and a corner is rounded inward. Pure/headless.

# Build a Hydrology whose flow_tier is the given grid; flow_dir/filled are unused by smoothing.
fn mk_hydro(span: Int, tier: MutMatrix Int) -> Hydrology !{IO} =
  do
    fd <- mutmatrix_new(span, span, 0)
    fl <- mutmatrix_new(span, span, 0.0)
    Hydrology(span = span, filled = fl, flow_dir = fd, flow_tier = tier)

fn set_cell(m: MutMatrix Int, r: Int, c: Int, v: Int) -> Unit !{IO} =
  do
    mutmatrix_set(m, r, c, v)
    ()

# Paint a straight horizontal tier-1 river across row `row`, cols lo..hi.
fn paint_row(m: MutMatrix Int, row: Int, c: Int, hi: Int) -> Int !{IO} =
  if c > hi then 0
  else
    do
      mutmatrix_set(m, row, c, 1)
      paint_row(m, row, c + 1, hi)

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # --- A straight horizontal river must stay straight: every cell's smoothed point keeps its grid
    #     center (px = col+0.5, pz = row+0.5) to within a small epsilon, for any number of passes. ---
    st <- mutmatrix_new(9, 9, 0)
    paint_row(st, 4, 1, 7)
    hs <- mk_hydro(9, st)
    r_straight <- smooth_positions(hs, 9, 3)
    # pz of the middle cell (row 4, col 4) must remain ~4.0 (on the row; centers are at grid (gx,gz)).
    pz_mid <- ribbon_pz(r_straight, 4, 4)
    assert_true(state, "ribbon: straight river stays on its row (pz unchanged)", fabs(pz_mid - 4.0) < 0.001)
    px_mid <- ribbon_px(r_straight, 4, 4)
    assert_true(state, "ribbon: straight river keeps its column (px unchanged)", fabs(px_mid - 4.0) < 0.001)

    # --- An L-bend (east along row 4 cols 1..4, then south down col 4 rows 4..7) must ROUND its
    #     corner: the corner cell (row 4, col 4) is pulled off its grid center toward the inside of
    #     the bend (its smoothed point moves by a non-trivial amount). ---
    lt <- mutmatrix_new(9, 9, 0)
    paint_row(lt, 4, 1, 4)  # horizontal arm
    set_cell(lt, 5, 4, 1)  # vertical arm
    set_cell(lt, 6, 4, 1)
    set_cell(lt, 7, 4, 1)
    hl <- mk_hydro(9, lt)
    r_bend <- smooth_positions(hl, 9, 2)
    cpx <- ribbon_px(r_bend, 4, 4)
    cpz <- ribbon_pz(r_bend, 4, 4)
    # The corner cell had E and S river neighbours, so averaging pulls it off (4.0, 4.0).
    let moved = fabs(cpx - 4.0) + fabs(cpz - 4.0)
    assert_true(state, "ribbon: L-bend corner is rounded (smoothed point leaves its grid center)", moved > 0.05)

    # --- Determinism: identical inputs yield identical smoothed positions. ---
    lt2 <- mutmatrix_new(9, 9, 0)
    paint_row(lt2, 4, 1, 4)
    set_cell(lt2, 5, 4, 1)
    set_cell(lt2, 6, 4, 1)
    set_cell(lt2, 7, 4, 1)
    hl2 <- mk_hydro(9, lt2)
    r_bend2 <- smooth_positions(hl2, 9, 2)
    cpx2 <- ribbon_px(r_bend2, 4, 4)
    cpz2 <- ribbon_pz(r_bend2, 4, 4)
    assert_true(state, "ribbon: smoothing is deterministic", (fabs(cpx - cpx2) < 0.0000001) && (fabs(cpz - cpz2) < 0.0000001))

    summary(state)
