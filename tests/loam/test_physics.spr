import stdlib.test (TestState, new_state, assert_true, summary)
import loam.scene (EntityId)
import loam.physics (Body, body_new, body_y, body_vy, airborne, launch, physics_step, impulse_for_height, earth_gravity)

# Loam's vertical physics is METRIC: 1 world unit = 1 metre, gravity in m/s^2, and the
# integrator advances by real seconds (loam.driver.fixed_dt), not by a bare tick. Tested
# headless — the renderer reads the same `y`, so passing here means the SI hop arc and
# the ground clamp are correct independent of rendering.
#
# Gravity is a FIELD `(EntityId, Double) -> Double` so it can vary per entity / height;
# these tests use a uniform Earth field.

fn earth(e: EntityId, y: Double) -> Double = earth_gravity

fn run(b: Body, n: Int, k: Int) -> Unit !{IO} =
  if k <= 0 then ()
  else
    do
      physics_step(b, n, earth)
      run(b, n, k - 1)

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    b <- body_new(2)
    let e0 = EntityId(0)
    let e1 = EntityId(1)

    # --- A grounded body stays grounded (the vy-reset guard) ---
    # entity 1 is never launched; gravity must not accumulate downward velocity.
    run(b, 2, 50)
    gy <- body_y(b, e1)
    gvy <- body_vy(b, e1)
    assert_true(state, "grounded: y stays 0", gy == 0.0)
    assert_true(state, "grounded: vy stays 0 (clamp resets it)", gvy == 0.0)
    assert_true(state, "grounded: not airborne",! airborne (b, e1))

    # --- A metric hop: launch to a target apex and verify the SI arc ---
    # impulse_for_height(g, H) is the takeoff velocity (m/s) to reach apex H (m) under
    # gravity g. Symplectic Euler undershoots the ideal apex slightly, so the measured
    # peak sits just under the target: assert it lands in (0.9*H, H].
    let target = 0.37  # metres — a realistic human hop
    launch(b, e0, impulse_for_height(earth_gravity, target))
    run(b, 2, 1)
    y1 <- body_y(b, e0)
    assert_true(state, "hop: rises off the ground", y1 > 0.0)
    assert_true(state, "hop: airborne after launch", airborne(b, e0))
    run(b, 2, 15)  # ~tick 16: near the apex
    yp <- body_y(b, e0)
    assert_true(state, "hop: apex approaches target from below", (yp > (0.9 * target)) && (yp <= target))
    ja <- airborne(b, e0)
    assert_true(state, "hop: still airborne near apex", ja)
    run(b, 2, 40)  # well past landing (airtime ~33 ticks at Earth gravity)
    yl <- body_y(b, e0)
    vl <- body_vy(b, e0)
    assert_true(state, "hop: lands back at ground", yl == 0.0)
    assert_true(state, "hop: velocity reset on landing", vl == 0.0)
    assert_true(state, "hop: grounded again",! airborne (b, e0))

    summary(state)
