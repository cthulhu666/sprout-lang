import stdlib.test (check_eq, run_suite)
import loam.galaxy_lod (pow2, level_offset, group_of, clampi, desired_level, next_level, tile_index_i)

# loam.galaxy_lod holds the PURE quadtree level-of-detail math for the galaxy-map demo. These must
# mirror the universegen catalog exporter's tiling: a level-L quadtree has 2^L x 2^L tiles, and each
# tile gets a PERMANENT instance-group id. The critical property is that levels occupy CONTIGUOUS
# ascending id ranges, so drawing groups [0, level_offset(L+1)) covers exactly levels 0..L.

fn main() -> Unit !{IO} =
  run_suite("galaxy_lod", [
    # pow2
    check_eq("pow2 0", pow2(0), 1),
    check_eq("pow2 3", pow2(3), 8),
    check_eq("pow2 4", pow2(4), 16),

    # level_offset = cumulative 4^l: 0, 1, 5, 21, 85, 341
    check_eq("level_offset 0", level_offset(0), 0),
    check_eq("level_offset 1", level_offset(1), 1),
    check_eq("level_offset 2", level_offset(2), 5),
    check_eq("level_offset 3", level_offset(3), 21),
    check_eq("level_offset 4", level_offset(4), 85),
    check_eq("level_offset 5 (total tiles L0..L4)", level_offset(5), 341),

    # group_of: level base + row-major (iy*2^level + ix)
    check_eq("group_of L0 origin", group_of(0, 0, 0), 0),
    check_eq("group_of L1 (0,0)", group_of(1, 0, 0), 1),
    check_eq("group_of L1 (1,1)", group_of(1, 1, 1), 4),
    check_eq("group_of L2 (0,0)", group_of(2, 0, 0), 5),
    check_eq("group_of L4 (0,0)", group_of(4, 0, 0), 85),

    # CONTIGUITY INVARIANT: the last tile of level L is exactly level_offset(L+1) - 1, so level L's
    # ids fill [level_offset(L), level_offset(L+1)) with no gap or overlap into the next level.
    check_eq("L2 last id == level_offset(3)-1", group_of(2, 3, 3), 20),
    check_eq("L4 last id == level_offset(5)-1", group_of(4, 15, 15), 340),

    # tile_index_i: pure integer binning, MUST match the exporter's float floor. radius 50000.
    # L0 has one tile: everything maps to 0.
    check_eq("tile_index_i L0 anything", tile_index_i(0 - 12345, 0, 50000), 0),
    # L1 (n=2): coord just below centre -> lower half (0); centre and above -> upper half (1).
    check_eq("tile_index_i L1 min edge", tile_index_i(0 - 50000, 1, 50000), 0),
    check_eq("tile_index_i L1 just below centre", tile_index_i(0 - 1, 1, 50000), 0),
    check_eq("tile_index_i L1 centre", tile_index_i(0, 1, 50000), 1),
    check_eq("tile_index_i L1 max clamps", tile_index_i(50000, 1, 50000), 1),
    # L4 (n=16): centre coord -> tile 8 (floor(0.5*16)); out-of-range clamps to [0,15].
    check_eq("tile_index_i L4 centre", tile_index_i(0, 4, 50000), 8),
    check_eq("tile_index_i L4 min edge", tile_index_i(0 - 50000, 4, 50000), 0),
    check_eq("tile_index_i L4 above max clamps", tile_index_i(99999, 4, 50000), 15),

    # clampi
    check_eq("clampi below", clampi(0 - 1, 0, 3), 0),
    check_eq("clampi inside", clampi(2, 0, 3), 2),
    check_eq("clampi above", clampi(5, 0, 3), 3),

    # desired_level ladder (far -> coarse, near -> fine), capped by the caller at the populated depth
    check_eq("desired_level far", desired_level(100000.0), 0),
    check_eq("desired_level 40k", desired_level(40000.0), 1),
    check_eq("desired_level 20k", desired_level(20000.0), 2),
    check_eq("desired_level 8k", desired_level(8000.0), 3),
    check_eq("desired_level near", desired_level(1000.0), 4),

    # level_boundary single-sources the ladder thresholds; its values are covered indirectly by the
    # desired_level and next_level assertions (Double has no Eq instance to assert them directly).
    # next_level: hysteresis around the boundaries with a deadband of `hys` (here 0.15). It steps at
    # most ONE level per call and only once the distance has moved a hys-fraction PAST the boundary
    # being crossed, so hovering on a boundary does not flip-flop.
    # Boundary(0)=60000 -> finer band <51000, coarser band >69000.
    check_eq("next_level hold-finer in deadband", next_level(0, 55000.0, 4, 0.15), 0),
    check_eq("next_level step finer past band", next_level(0, 50000.0, 4, 0.15), 1),
    check_eq("next_level hold-coarser in deadband", next_level(1, 65000.0, 4, 0.15), 1),
    check_eq("next_level step coarser past band", next_level(1, 70000.0, 4, 0.15), 0),
    # Steps only one level even when the target is several away (progressive refinement).
    check_eq("next_level one step toward deep", next_level(0, 1000.0, 4, 0.15), 1),
    # Cannot exceed maxlvl.
    check_eq("next_level capped at maxlvl", next_level(4, 1000.0, 4, 0.15), 4),
    # Holds at the exact nominal boundary (inside both deadbands).
    check_eq("next_level holds at nominal boundary", next_level(2, 12000.0, 4, 0.15), 2)
  ])
