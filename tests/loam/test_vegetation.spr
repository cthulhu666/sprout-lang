import stdlib.test (check_eq, run_suite)
import loam.terrain (TileKind, Water, Beach, Grass, Forest, Desert, Mountain, Snow, Tundra)
import loam.vegetation (TreeKind, Palm, Broadleaf, Conifer, DarkConifer, Cactus, Shrub, tree_kind_tag, tree_for_biome)

# loam.vegetation.tree_for_biome is a PURE, headless classifier: (biome, spatial-hash) -> Maybe
# TreeKind. Like the rest of loam it is asserted without a window. Every case below is a pure
# function of its inputs, so equality is exact. We assert on an Int tag (Nothing -> -1, Just k ->
# tree_kind_tag k) because assert_eq needs Eq + ToString, which TreeKind (deriving Enum) lacks.
#
# Hash arithmetic mirrors the implementation: density roll = imod(h, 100), category = imod(h/100, N).
# h is a spatial_hash result in [0, 2^31), always non-negative, so imod is a plain remainder.
#   h = 0   -> roll 0  (passes any non-zero density); category index 0
#   h = 7   -> roll 7  (passes Beach density 8, the boundary's low side)
#   h = 8   -> roll 8  (fails Beach density 8, the boundary's high side)
#   h = 99  -> roll 99 (fails every biome; max density is 55)
#   h = 100 -> roll 0  (passes); category index 1 (h/100 = 1)

# TreeKind ordinals (declaration order): Palm 0, Broadleaf 1, Conifer 2, DarkConifer 3, Cactus 4, Shrub 5.
fn veg_tag(m: Maybe TreeKind) -> Int =
  match m with
  | Nothing -> -1
  | Just k -> tree_kind_tag(k)

fn main() -> Unit !{IO} =
  let once = veg_tag(tree_for_biome(Forest, 424242))
  in let twice = veg_tag(tree_for_biome(Forest, 424242))
  in run_suite("vegetation", [
    # --- Water is always bare, whatever the hash ---
    check_eq("Water: bare at h=0", veg_tag(tree_for_biome(Water, 0)), -1),
    check_eq("Water: bare at h=100", veg_tag(tree_for_biome(Water, 100)), -1),

    # --- each land biome maps to its category when the density roll passes (h=0) ---
    check_eq("Beach -> Palm", veg_tag(tree_for_biome(Beach, 0)), tree_kind_tag(Palm)),
    check_eq("Grass -> Broadleaf", veg_tag(tree_for_biome(Grass, 0)), tree_kind_tag(Broadleaf)),
    check_eq("Forest -> Conifer at category 0", veg_tag(tree_for_biome(Forest, 0)), tree_kind_tag(Conifer)),
    check_eq("Desert -> Cactus", veg_tag(tree_for_biome(Desert, 0)), tree_kind_tag(Cactus)),
    check_eq("Mountain -> Conifer", veg_tag(tree_for_biome(Mountain, 0)), tree_kind_tag(Conifer)),
    check_eq("Snow -> DarkConifer", veg_tag(tree_for_biome(Snow, 0)), tree_kind_tag(DarkConifer)),
    check_eq("Tundra -> Conifer at category 0", veg_tag(tree_for_biome(Tundra, 0)), tree_kind_tag(Conifer)),

    # --- within-biome variety: the category slice (h/100) flips the mix ---
    check_eq("Forest -> Broadleaf at category 1", veg_tag(tree_for_biome(Forest, 100)), tree_kind_tag(Broadleaf)),
    check_eq("Tundra -> Shrub at category 1", veg_tag(tree_for_biome(Tundra, 100)), tree_kind_tag(Shrub)),

    # --- density gate: a high roll leaves the tile bare in every land biome ---
    check_eq("Beach: bare when roll fails", veg_tag(tree_for_biome(Beach, 99)), -1),
    check_eq("Forest: bare when roll fails", veg_tag(tree_for_biome(Forest, 99)), -1),
    check_eq("Desert: bare when roll fails", veg_tag(tree_for_biome(Desert, 99)), -1),
    check_eq("Snow: bare when roll fails", veg_tag(tree_for_biome(Snow, 99)), -1),

    # --- density boundary is exclusive: roll < density passes, roll == density fails (Beach = 8) ---
    check_eq("Beach: roll 7 < density 8 places", veg_tag(tree_for_biome(Beach, 7)), tree_kind_tag(Palm)),
    check_eq("Beach: roll 8 == density 8 is bare", veg_tag(tree_for_biome(Beach, 8)), -1),

    # --- determinism: pure, so the same (biome, hash) always yields the same result ---
    check_eq("determinism: same (biome, hash) => same TreeKind", once, twice)
  ])
