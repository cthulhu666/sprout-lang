import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.math (fabs, pi, sin, sqrt)
import loam.camera (Cam, cam_rotate, cam_zoom, cam_pitch, cam_pan, cam_eye, cam_drive, cam_distance)

# Headless coverage for loam.view's free-look camera controller (the whole package:
# rotate / zoom / tilt / pan). Everything here is PURE state math — no window — so
# passing means the raylib eye placement (cam_apply, the only IO) is fed correct
# numbers. The rig keeps the eye offset in Cartesian (radius, height) form, so the
# four controls are ORTHOGONAL: rotate spins yaw, tilt swings the eye along an arc
# at CONSTANT distance (only the vertical angle changes), zoom scales the distance
# at CONSTANT angle, and pan moves the look-at. No spherical-angle state and no
# atan2 are needed — tilt is an incremental 2D rotation of the offset.

fn near(a: Double, b: Double) -> Bool = fabs(a - b) < 0.0001

# Eye→target distance implied by a Cam: the length of the (horizontal, vertical)
# offset. Tilt must preserve this; zoom must set it.
fn dist_of(c: Cam) -> Double =
  sqrt((c.radius * c.radius) + ((c.height - c.ty) * (c.height - c.ty)))

# A neutral rig at yaw 0 over the origin: eye is `radius` out along +z, `height` up.
fn base() -> Cam = Cam(yaw = 0.0, radius = 10.0, height = 5.0, tx = 0.0, ty = 0.0, tz = 0.0)

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    let c0 = base()

    let d0 = dist_of(c0)

    # --- Zoom: scales the eye's DISTANCE to the target by `dr`, keeping the pitch
    # angle fixed (radius and height-ty scale together). Clamped to [lo, hi] in
    # distance, NOT in horizontal standoff. ---
    let zin = cam_zoom(c0, -3.0, 2.0, 20.0)
    assert_true(state, "zoom sets distance to dist + dr", near(dist_of(zin), d0 - 3.0))
    # Pitch angle preserved: radius/height ratio unchanged (cross-multiplied, no div).
    assert_true(state, "zoom preserves the pitch angle",
                near(zin.radius * c0.height, c0.radius * zin.height))
    let zlo = cam_zoom(c0, -50.0, 2.0, 20.0)
    assert_true(state, "zoom clamps distance at lo", near(dist_of(zlo), 2.0))
    let zhi = cam_zoom(c0, 50.0, 2.0, 20.0)
    assert_true(state, "zoom clamps distance at hi", near(dist_of(zhi), 20.0))

    # --- Tilt: swings the eye along an arc at CONSTANT distance — only the vertical
    # angle changes. `dphi` is radians; the resulting pitch is clamped to
    # [phi_lo, phi_hi]. Tilting up raises the eye and pulls the standoff in. ---
    let pu = cam_pitch(c0, 0.2, 0.05, 1.4)
    assert_true(state, "tilt preserves distance to target", near(dist_of(pu), d0))
    assert_true(state, "tilt up raises the eye", pu.height > c0.height)
    assert_true(state, "tilt up pulls the standoff in", pu.radius < c0.radius)
    # Clamp at the steep bound: tilting up past phi_hi caps the vertical leg at
    # dist * sin(phi_hi) with the distance unchanged. (dphi kept small enough that
    # phi_0 + dphi stays below pi/2, where the arc is still climbing.)
    let phi = cam_pitch(c0, 1.0, 0.05, 1.4)
    assert_true(state, "tilt clamps at phi_hi", near(phi.height - c0.ty, d0 * sin(1.4)))
    assert_true(state, "tilt clamp keeps the distance", near(dist_of(phi), d0))
    let plo = cam_pitch(c0, -1.0, 0.05, 1.4)
    assert_true(state, "tilt clamps at phi_lo", near(plo.height - c0.ty, d0 * sin(0.05)))
    # A single LARGE tilt-up must PIN at phi_hi, not swing past vertical and reflect
    # to a shallower angle. dphi = 1.5 from phi_0 ~ 0.46 lands at ~1.96 rad (past
    # pi/2), where sin has folded back below sin(phi_hi) — the naive vertical-leg
    # clamp misses it. Matters for fast drag-to-tilt (Δy → cam_pitch, >1 rad/frame).
    let pover = cam_pitch(c0, 1.5, 0.05, 1.45)
    assert_true(state, "large tilt-up pins at phi_hi (no overshoot)",
                near(pover.height - c0.ty, d0 * sin(1.45)))
    assert_true(state, "tilt overshoot keeps distance", near(dist_of(pover), d0))

    # --- Rotate: adds yaw, wrapping into [0, 2pi) ---
    let r1 = cam_rotate(c0, 0.5)
    assert_true(state, "rotate adds yaw", near(r1.yaw, 0.5))
    let rw = cam_rotate(Cam(yaw = 6.2, radius = 10.0, height = 5.0, tx = 0.0, ty = 0.0, tz = 0.0), 0.3)
    assert_true(state, "rotate wraps past 2pi", near(rw.yaw, 6.5 - (2.0 * pi)))

    # --- Pan: moves the look-at target in the camera's own ground frame ---
    # At yaw 0, screen-right is +x and forward (into the screen) is -z.
    let pr = cam_pan(c0, 2.0, 0.0, 100.0)
    assert_true(state, "pan right moves target +x", near(pr.tx, 2.0) && near(pr.tz, 0.0))
    let pf = cam_pan(c0, 0.0, 3.0, 100.0)
    assert_true(state, "pan forward moves target -z", near(pf.tx, 0.0) && near(pf.tz, -3.0))
    let pc = cam_pan(c0, 500.0, 0.0, 50.0)
    assert_true(state, "pan clamps target to bound", near(pc.tx, 50.0))

    # --- Eye placement: (tx, height, tz + radius) at yaw 0 ---
    match cam_eye(c0) with
    | (ex, ey, ez) ->
        do
          assert_true(state, "eye x = tx", near(ex, 0.0))
          assert_true(state, "eye y = height", near(ey, 5.0))
          assert_true(state, "eye z = tz + radius", near(ez, 10.0))

    # --- cam_drive: one-frame fold of pre-scaled deltas through all four controls,
    # in the order rotate -> tilt -> zoom -> pan. Shared by the button and gesture
    # input paths so both stay consistent. ---
    # A single delta touches only its own axis.
    let dy = cam_drive(c0, 0.3, 0.0, 0.0, 0.0, 0.0, 2.0, 40.0, 0.05, 1.45, 100.0)
    assert_true(state, "cam_drive dyaw rotates only",
                near(dy.yaw, 0.3) && near(dy.radius, 10.0) && near(dy.height, 5.0))
    let dz = cam_drive(c0, 0.0, 0.0, -3.0, 0.0, 0.0, 2.0, 40.0, 0.05, 1.45, 100.0)
    assert_true(state, "cam_drive dzoom sets distance only",
                near(dist_of(dz), d0 - 3.0) && near(dz.yaw, 0.0))
    # Pan is applied in the POST-rotation frame: rotating a quarter-turn first, then
    # panning "forward", must move the target along the NEW look direction (-x at
    # yaw=pi/2), not the old one (-z). This pins the fold order.
    let dp = cam_drive(c0, pi / 2.0, 0.0, 0.0, 0.0, 3.0, 2.0, 40.0, 0.05, 1.45, 100.0)
    assert_true(state, "cam_drive pans in the post-rotate frame",
                near(dp.tx, -3.0) && near(dp.tz, 0.0))

    # --- cam_distance: eye->target offset length (horizontal radius + vertical
    # height-ty). Used by adaptive zoom to scale the step by how close you are. ---
    assert_true(state, "cam_distance of base", near(cam_distance(c0), d0))
    # With ty != 0 the vertical leg is height - ty, not height.
    let off = Cam(yaw = 0.0, radius = 3.0, height = 6.0, tx = 0.0, ty = 2.0, tz = 0.0)
    assert_true(state, "cam_distance uses height - ty", near(cam_distance(off), 5.0))

    summary(state)
