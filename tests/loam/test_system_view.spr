import stdlib.test (check_true, run_suite)
import loam.system_view (orbit_world_scale, body_world_size)

# loam.system_view holds the PURE scene-2 framing math for the galaxy-map solar-system view: a sqrt
# compression of both orbit radii and body sizes so a system with a huge orbit dynamic range (the outer
# orbit ~70x the inner) does not bury its inner planets inside the star. Numbers below are chosen so the
# sqrt results are exact in binary float (perfect squares), and the range checks are ones a LINEAR scale
# would fail — so these guard the regression, not just the arithmetic.

# World semi-major of an orbit = a * per-orbit scale. Named helper (inline let-in an arg does not parse).
fn world_semi(a: Double, a_ext: Double, fit: Double) -> Double = orbit_world_scale(a, a_ext, fit) * a

fn main() -> Unit !{IO} =
  run_suite("system_view", [
    # --- orbit_world_scale: world semi-major = fit*sqrt(a/a_ext) ---
    # At a == a_ext the compression is identity: the outer orbit still maps to `fit` (unchanged framing).
    check_true("outer orbit maps to fit", world_semi(20.0, 20.0, 520.0) == 520.0),
    # Inner orbit is sqrt-SPREAD: a=5 of a_ext=20 -> world 260, vs a linear scale's 130. This is the fix.
    check_true("inner orbit spread (260 not 130)", world_semi(5.0, 20.0, 520.0) == 260.0),
    check_true("inner spread beats linear", world_semi(5.0, 20.0, 520.0) > 130.0),
    # Monotonic: a larger orbit is farther out, and its per-orbit scale is smaller.
    check_true("world semi monotonic in a", world_semi(5.0, 20.0, 520.0) < world_semi(20.0, 20.0, 520.0)),
    check_true("per-orbit scale shrinks with a", orbit_world_scale(5.0, 20.0, 520.0) > orbit_world_scale(20.0, 20.0, 520.0)),
    # Degenerate inputs are safe (no divide-by-zero / sqrt of nonpositive).
    check_true("guard a<=0 -> 0", orbit_world_scale(0.0, 20.0, 520.0) == 0.0),
    check_true("guard a_ext<=0 -> 0", orbit_world_scale(5.0, 0.0, 520.0) == 0.0),

    # --- body_world_size: sqrt(radiusEarths)*coeff, floored ---
    check_true("1-Earth body == coeff", body_world_size(1.0, 6.0, 3.5) == 6.0),
    check_true("4-Earth body == 12 (not linear 24)", body_world_size(4.0, 6.0, 3.5) == 12.0),
    check_true("sub-Earth hits the floor", body_world_size(0.01, 6.0, 3.5) == 3.5),
    check_true("bigger radius draws bigger", body_world_size(9.0, 6.0, 3.5) > body_world_size(4.0, 6.0, 3.5)),
    # The 10.15-Earth giant of SYS-864731: ~19 under sqrt vs ~61 linear — no longer dwarfs the system.
    check_true("giant compressed (~19, not ~61)",
      (body_world_size(10.15, 6.0, 3.5) > 15.0) && (body_world_size(10.15, 6.0, 3.5) < 25.0))
  ])
