import stdlib.test (TestState, new_state, assert_eq, summary)
import loam.config (parse_config, cfg_int)

# loam.config parses a `key value` (Int) config text into a Dict String Int, so a demo can read
# its tunables from a file at startup instead of recompiling. Blank lines and `#` comment lines
# are ignored; a line whose value is not an integer is skipped (treated as absent). cfg_int looks
# a key up with a default fallback, so a config lists ONLY the knobs it overrides. All pure —
# asserted headlessly, exactly like the other loam tests.

# One text exercising every case: a leading comment, a plain key, a blank line, a key whose value
# has extra spaces, a comment BETWEEN keys, and a key with a non-integer value (must be skipped).
let sample =
  "# terrain-rivers sweep\nregion_chunks 16\n\nlattice0   128\noctaves 3\n# a comment between keys\ntier1_min 80\nbogus notanint\n"

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    let d = parse_config(sample)

    assert_eq(state, "config: parses a plain key", cfg_int(d, "region_chunks", 0 - 1), 16)
    assert_eq(state, "config: collapses extra spaces before the value",
              cfg_int(d, "lattice0", 0 - 1), 128)
    assert_eq(state, "config: parses several keys", cfg_int(d, "octaves", 0 - 1), 3)
    assert_eq(state, "config: reads a key that follows a comment line",
              cfg_int(d, "tier1_min", 0 - 1), 80)
    assert_eq(state, "config: missing key falls back to the default",
              cfg_int(d, "not_present", 42), 42)
    assert_eq(state, "config: malformed value is skipped (default used)",
              cfg_int(d, "bogus", 7), 7)

    summary(state)
