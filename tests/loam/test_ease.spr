import stdlib.test (check_true, run_suite)
import stdlib.math (fabs)
import loam.ease (clamp01, smoothstep, ease_out, inv_lerp, remap)

# loam.ease — the general interpolation/easing atoms shared by any animated surface (the FTL jump
# fade, iter-2 supercruise close, camera dollies, HUD gauge fills). Pure, graphics-free, built on
# stdlib.math (lerp, fclamp). These guard: clamp01 saturation, smoothstep/ease_out endpoints +
# midpoints + input clamping, inv_lerp as the inverse of a blend, and remap = inv_lerp -> lerp.

fn near(a: Double, b: Double) -> Bool = fabs(a - b) < 0.000001

fn main() -> Unit !{IO} =
  run_suite("ease", [
    # --- clamp01 saturates to [0,1] ---
    check_true("clamp01 below -> 0", clamp01(-0.4) == 0.0),
    check_true("clamp01 within -> x", clamp01(0.37) == 0.37),
    check_true("clamp01 above -> 1", clamp01(1.8) == 1.0),
    # --- smoothstep: 0..1 Hermite, flat at both ends, symmetric midpoint ---
    check_true("smoothstep(0) == 0", near(smoothstep(0.0), 0.0)),
    check_true("smoothstep(1) == 1", near(smoothstep(1.0), 1.0)),
    check_true("smoothstep(0.5) == 0.5", near(smoothstep(0.5), 0.5)),
    check_true("smoothstep(0.25) == 0.15625", near(smoothstep(0.25), 0.15625)),
    check_true("smoothstep clamps t<0 -> 0", near(smoothstep(-1.0), 0.0)),
    check_true("smoothstep clamps t>1 -> 1", near(smoothstep(2.0), 1.0)),
    # --- ease_out: decelerating quad, 1-(1-t)^2 ---
    check_true("ease_out(0) == 0", near(ease_out(0.0), 0.0)),
    check_true("ease_out(1) == 1", near(ease_out(1.0), 1.0)),
    check_true("ease_out(0.5) == 0.75", near(ease_out(0.5), 0.75)),
    check_true("ease_out clamps t>1 -> 1", near(ease_out(1.5), 1.0)),
    # --- inv_lerp is the inverse of a blend ---
    check_true("inv_lerp(2,8,5) == 0.5", near(inv_lerp(2.0, 8.0, 5.0), 0.5)),
    check_true("inv_lerp(2,8,2) == 0", near(inv_lerp(2.0, 8.0, 2.0), 0.0)),
    check_true("inv_lerp(2,8,8) == 1", near(inv_lerp(2.0, 8.0, 8.0), 1.0)),
    check_true("inv_lerp degenerate a==b -> 0", near(inv_lerp(4.0, 4.0, 9.0), 0.0)),
    # --- remap = lerp(c,d, inv_lerp(a,b,x)) ---
    check_true("remap(0,10,0,100,3) == 30", near(remap(0.0, 10.0, 0.0, 100.0, 3.0), 30.0)),
    check_true("remap(0,1,10,20,0.5) == 15", near(remap(0.0, 1.0, 10.0, 20.0, 0.5), 15.0))
  ])
