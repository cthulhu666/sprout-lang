import stdlib.test (check_eq, run_suite)

fn double(x: Int) -> Int = x * 2
fn inc(x: Int) -> Int = x + 1
fn square(x: Int) -> Int = x * x

fn main() -> Unit !{IO} =
  let q = double >> double
      p = double << double
  in run_suite("fn_compose", [
    # -----------------------------------------------------------------------
    # rcompose: f >> g applies f first, then g
    # -----------------------------------------------------------------------

    check_eq("rcompose basic", rcompose(double, inc)(3), 7),
    check_eq("rcompose identity left", rcompose(\x -> x, double)(5), 10),
    check_eq("rcompose identity right", rcompose(double, \x -> x)(5), 10),

    # -----------------------------------------------------------------------
    # lcompose: f << g applies g first, then f
    # -----------------------------------------------------------------------

    check_eq("lcompose basic", lcompose(inc, double)(3), 7),
    check_eq("lcompose identity left", lcompose(\x -> x, double)(5), 10),
    check_eq("lcompose identity right", lcompose(double, \x -> x)(5), 10),

    # -----------------------------------------------------------------------
    # >> operator desugars to rcompose
    # -----------------------------------------------------------------------

    check_eq(">> basic", (double >> inc)(3), 7),
    check_eq(">> chained", (double >> inc >> square)(2), 25),

    # let-bound composed function (REPL regression)
    check_eq(">> let bound call", q(4), 16),

    # used with map (REPL regression)
    check_eq(">> with map", map(double >> inc, Cons(1, Cons(2, Cons(3, Nil)))),
                                    Cons(3, Cons(5, Cons(7, Nil)))),

    # -----------------------------------------------------------------------
    # << operator desugars to lcompose
    # -----------------------------------------------------------------------

    check_eq("<< basic", (inc << double)(3), 7),
    check_eq("<< chained", (square << inc << double)(2), 25),

    check_eq("<< let bound call", p(4), 16),

    # -----------------------------------------------------------------------
    # >> and << are inverses: f >> g == g << f
    # -----------------------------------------------------------------------

    check_eq(">> and << inverse",
      (double >> inc)(5),
      (inc << double)(5))
  ])
