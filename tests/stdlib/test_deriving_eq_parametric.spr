import stdlib.test (check_true, run_suite)

# Parametric ADTs with `deriving (Eq)`: the emitter must:
#  - emit `instance Eq (Box a) where Eq a { ... }` (instance constraint on `a`)
#  - generate field-comparing eq bodies that call eq recursively on inner fields

type Box a (..) deriving (Eq) =
  | Empty
  | Hold a

type Pair a b (..) deriving (Eq) =
  | Pair a b

fn not(b: Bool) -> Bool = if b then false else true

fn main() -> Unit !{IO} =
  run_suite("deriving_eq_parametric", [
    # Nullary case in a parametric type — should still match same-ctor pair.
    check_true("Empty eq Empty", eq(Empty, Empty)),
    # Single-field case — field comparison via Eq Int.
    check_true("Hold 5 eq Hold 5", eq(Hold(5), Hold(5))),
    check_true("Hold 5 neq Hold 6", not(eq(Hold(5), Hold(6)))),
    # Cross-ctor case in same type — false.
    check_true("Empty neq Hold 0", not(eq(Empty, Hold(0)))),
    # Two-field ctor — both fields must match (different param types).
    check_true("Pair 1 true eq Pair 1 true", eq(Pair(1, true), Pair(1, true))),
    check_true("Pair 1 true neq Pair 1 false", not(eq(Pair(1, true), Pair(1, false)))),
    check_true("Pair 1 true neq Pair 2 true", not(eq(Pair(1, true), Pair(2, true))))
  ])
