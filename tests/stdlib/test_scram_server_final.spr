import stdlib.test (check_eq, run_suite)
import stdlib.scram as scram

# `verify_server_final` is the client's check of the SERVER's proof — the mutual-auth
# half of SCRAM. A verifier that always answered true would let a client accept a
# forged server, and nothing here would have noticed.
#
# The anchor is the SCRAM-SHA-256 exchange in RFC 7677 §3 (user "user", password
# "pencil"), so the expected messages are quoted, not computed by the code under test.
# The client-final message pins the proof; verifying the RFC's server-final, and
# rejecting a one-character forgery of it, pins the expected server signature.

let server_first_raw: String =
  "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096"

# RFC 7677 §3, the last two lines of the exchange.
let rfc_client_final: String =
  "c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ="
let rfc_client_proof: String = "dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ="
let rfc_server_signature: String = "6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4="

let client_bare: String =
  scram.client_first_bare("user", "rOprNGfwEbeRWgbNEkqO")

fn rendered_text(r: Result scram.ScramError String) -> String =
  match r with
  | Ok value -> value
  | Err err -> `err:${scram.error_message(err)}`

fn rendered_bool(r: Result scram.ScramError Bool) -> String =
  match r with
  | Ok value -> to_string(value)
  | Err err -> `err:${scram.error_message(err)}`

fn final_for(bare: String) -> Result scram.ScramError scram.ScramClientFinal =
  scram.parse_server_first(server_first_raw)
    |> and_then(\server -> scram.client_final("pencil", bare, server, scram.no_channel_binding))

# Built once: each `client_final` runs a 4096-iteration PBKDF2.
let rfc_final: Result scram.ScramError scram.ScramClientFinal = final_for(client_bare)

fn final_text(bare: String) -> String =
  rendered_text(map(scram.client_final_text, final_for(bare)))

# The `raw` argument is a whole server-final message, as it arrives on the wire.
fn verify(raw: String) -> String =
  rendered_bool(and_then(\final -> scram.verify_server_final(final, raw), rfc_final))

fn main() -> Unit !{IO} =
  run_suite("scram client-final and server-final verification", [
    # --- the RFC vector, so the expectations below are not self-referential ---
    check_eq("client-first-bare matches RFC 7677 §3", client_bare, "n=user,r=rOprNGfwEbeRWgbNEkqO"),
    check_eq("client-final matches RFC 7677 §3", rendered_text(map(scram.client_final_text, rfc_final)),
      rfc_client_final),

    # --- verify_server_final: the mutual-auth decision ---
    check_eq("genuine server signature verifies", verify(`v=${rfc_server_signature}`), "true"),
    # The one case a broken check would get wrong silently.
    check_eq("forged server signature is rejected", verify("v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G5="), "false"),
    check_eq("truncated server signature is rejected", verify("v=6rriTRBi23WpRR"), "false"),
    check_eq("empty verifier is rejected", verify("v="), "false"),
    # Keyed by "Client Key" vs "Server Key": a mix-up would accept the client's own proof
    # echoed back at it.
    check_eq("client proof is not accepted as a server signature", verify(`v=${rfc_client_proof}`), "false"),

    # --- the message is malformed or is itself an error ---
    check_eq("server error attribute surfaces", verify("e=other-error"),
      "err:SCRAM server-final error: other-error"),
    # An `e=` wins over a `v=` in the same message: never verify against an error reply.
    check_eq("error attribute beats a verifier", verify(`e=unknown-user,v=${rfc_server_signature}`),
      "err:SCRAM server-final error: unknown-user"),
    check_eq("message with neither v nor e is an error", verify("r=abc,s=def"),
      "err:SCRAM server-final message missing verifier"),

    # --- client_final refuses inputs it cannot sign ---
    check_eq("client-first-bare without a nonce is an error", final_text("n=user"),
      "err:SCRAM client-first-bare message missing nonce"),
    check_eq("server nonce must extend the client nonce", final_text(scram.client_first_bare("user", "other")),
      "err:SCRAM server nonce does not extend client nonce"),

    # --- username escaping (RFC 5802 §5.1): "=" first, or the "=" of "=2C" is escaped again ---
    check_eq("comma and equals are escaped", scram.client_first_bare("a,b=c", "N"), "n=a=2Cb=3Dc,r=N"),
    check_eq("equals before comma is not double-escaped", scram.client_first_bare("x=,y", "N"), "n=x=3D=2Cy,r=N"),
    check_eq("other characters pass through", scram.client_first_bare("żółw", "N"), "n=żółw,r=N")
  ])
