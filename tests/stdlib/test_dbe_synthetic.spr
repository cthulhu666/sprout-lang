import stdlib.test (new_state, assert_eq, summary)

# Do-block `let` bindings that are pure, cannot fail and are never read.
# Each one still runs; the function must return its live value.
# A binding that can panic is covered by `just dead-let-smoke`.

# Case 1: unused arithmetic binding — pure, never read
fn test_unused_int() -> Int !{IO} =
  do
    let _dead = 1 + 2
    42

# Case 2: unused string — heap allocation that is unused but still evaluated
fn test_unused_string() -> String !{IO} =
  do
    let _dead = "hello" ++ " world"
    "result"

# Case 3: cascading dead bindings — y depends on x, both unused
fn test_cascading_dead() -> Int !{IO} =
  do
    let x = 10
    let y = x + 5
    99

# Case 4: one live binding, one dead — live must be preserved
fn test_one_live_one_dead() -> Int !{IO} =
  do
    let live = 7
    let _dead = 3 + 4
    live

# Case 5: unused lambda — closure allocation that is unused but still evaluated
fn test_dead_lambda() -> Int !{IO} =
  do
    let _f = \x -> x + 1
    0

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    r1 <- test_unused_int()
    assert_eq(state, "unused_int", r1, 42)
    r2 <- test_unused_string()
    assert_eq(state, "unused_string", r2, "result")
    r3 <- test_cascading_dead()
    assert_eq(state, "cascading_dead", r3, 99)
    r4 <- test_one_live_one_dead()
    assert_eq(state, "one_live_one_dead", r4, 7)
    r5 <- test_dead_lambda()
    assert_eq(state, "dead_lambda", r5, 0)
    summary(state)
