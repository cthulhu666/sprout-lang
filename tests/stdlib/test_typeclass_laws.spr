import stdlib.test (check_eq, check_true, check_false, run_suite)

# Law-oriented conformance tests for Functor, Semigroup, and Monoid instances.
#
# Functor laws:
#   Identity:    map(\x -> x, xs) == xs
#   Composition: map(f, map(g, xs)) == map(\x -> f(g(x)), xs)
#
# Semigroup law:
#   Associativity: (a ++ b) ++ c == a ++ (b ++ c)
#
# Monoid laws:
#   Left identity:  Nil ++ xs == xs  /  "" ++ s == s
#   Right identity: xs ++ Nil == xs  /  s ++ "" == s

fn double(x: Int) -> Int = x * 2
fn inc(x: Int) -> Int = x + 1

# Combiners for the Applicative laws below.
fn add2(x: Int, y: Int) -> Int = x + y
fn fst2(x: Int, y: Int) -> Int = x
fn snd2(x: Int, y: Int) -> Int = y

# Kleisli arrows (a -> m a) for the Monad laws. One per instance so the concrete
# return type anchors dispatch, same role as m_pure/l_pure for Applicative.
fn mk_inc(x: Int) -> Maybe Int = Just(x + 1)
fn mk_dbl(x: Int) -> Maybe Int = Just(x * 2)
fn lk_dup(x: Int) -> List Int = Cons(x, Cons(x + 100, Nil))
fn lk_inc(x: Int) -> List Int = Cons(x + 1, Nil)
fn rk_inc(x: Int) -> Result String Int = Ok(x + 1)
fn rk_dbl(x: Int) -> Result String Int = Ok(x * 2)
# Typed `pure` anchors for the right-identity law over each instance.
fn r_pure(x: Int) -> Result String Int = pure(x)
fn ok_7() -> Result String Int = Ok(7)

# Typed `pure` anchors: give `map2`'s arguments a concrete `f` so instance dispatch
# resolves (same role as nil_int()/no_int() for Eq). `m_pure(3) == Just(3)` and
# `l_pure(3) == [3]` by definition, so these still exercise the pure/map2 laws.
fn m_pure(x: Int) -> Maybe Int = pure(x)
fn l_pure(x: Int) -> List Int = pure(x)

# Typed helpers that anchor concrete element types for Eq resolution.
fn nil_int() -> List Int = Nil
fn no_int() -> Maybe Int = Nothing

fn main() -> Unit !{IO} =
  let li_empty = nil_int()
      li_single = Cons(42, Nil)
      li_multi = Cons(1, Cons(2, Cons(3, Nil)))
      m_nothing = no_int()
      m_just_1 = Just(7)
      m_just_2 = Just(100)
      la = Cons(1, Cons(2, Nil))
      lb = Cons(3, Nil)
      lc = Cons(4, Cons(5, Nil))
      sa = "foo"
      sb = "bar"
      sc = "baz"
      s_empty = ""
      s_single = "x"
      s_multi = "hello"
  in run_suite("typeclass_laws", [
    # -----------------------------------------------------------------------
    # Functor List — identity law
    # nil_int() gives a concrete List Int so Eq (List Int) resolves.
    # -----------------------------------------------------------------------

    check_eq("functor list identity empty", map(\x -> x, li_empty), li_empty),
    check_eq("functor list identity single", map(\x -> x, li_single), li_single),
    check_eq("functor list identity multi", map(\x -> x, li_multi), li_multi),

    # -----------------------------------------------------------------------
    # Functor List — composition law (f = double, g = inc)
    # -----------------------------------------------------------------------

    check_eq("functor list composition empty",
      map(double, map(inc, li_empty)),
      map(\x -> double(inc(x)), li_empty)),

    check_eq("functor list composition single",
      map(double, map(inc, li_single)),
      map(\x -> double(inc(x)), li_single)),

    check_eq("functor list composition multi",
      map(double, map(inc, li_multi)),
      map(\x -> double(inc(x)), li_multi)),

    # -----------------------------------------------------------------------
    # Functor Maybe — identity law
    # no_int() gives a concrete Maybe Int so Eq (Maybe Int) resolves.
    # -----------------------------------------------------------------------

    check_eq("functor maybe identity nothing", map(\x -> x, m_nothing), m_nothing),
    check_eq("functor maybe identity just 7", map(\x -> x, m_just_1), m_just_1),
    check_eq("functor maybe identity just 100", map(\x -> x, m_just_2), m_just_2),

    # -----------------------------------------------------------------------
    # Functor Maybe — composition law (f = double, g = inc)
    # -----------------------------------------------------------------------

    check_eq("functor maybe composition nothing",
      map(double, map(inc, m_nothing)),
      map(\x -> double(inc(x)), m_nothing)),

    check_eq("functor maybe composition just 7",
      map(double, map(inc, m_just_1)),
      map(\x -> double(inc(x)), m_just_1)),

    check_eq("functor maybe composition just 100",
      map(double, map(inc, m_just_2)),
      map(\x -> double(inc(x)), m_just_2)),

    # -----------------------------------------------------------------------
    # Semigroup List — associativity
    # -----------------------------------------------------------------------

    check_eq("semigroup list assoc non-empty",
      (la ++ lb) ++ lc,
      la ++ (lb ++ lc)),

    check_eq("semigroup list assoc left empty",
      (nil_int() ++ lb) ++ lc,
      nil_int() ++ (lb ++ lc)),

    check_eq("semigroup list assoc right empty",
      (la ++ lb) ++ nil_int(),
      la ++ (lb ++ nil_int())),

    # -----------------------------------------------------------------------
    # Semigroup String — associativity
    # -----------------------------------------------------------------------

    check_eq("semigroup string assoc non-empty",
      (sa ++ sb) ++ sc,
      sa ++ (sb ++ sc)),

    check_eq("semigroup string assoc left empty",
      ("" ++ sb) ++ sc,
      "" ++ (sb ++ sc)),

    check_eq("semigroup string assoc right empty",
      (sa ++ sb) ++ "",
      sa ++ (sb ++ "")),

    # -----------------------------------------------------------------------
    # Monoid List — left and right identity
    # nil_int() is used so the empty side has a concrete type for Eq.
    # -----------------------------------------------------------------------

    check_eq("monoid list left identity empty", nil_int() ++ li_empty, li_empty),
    check_eq("monoid list left identity single", nil_int() ++ li_single, li_single),
    check_eq("monoid list left identity multi", nil_int() ++ li_multi, li_multi),

    check_eq("monoid list right identity empty", li_empty ++ nil_int(), li_empty),
    check_eq("monoid list right identity single", li_single ++ nil_int(), li_single),
    check_eq("monoid list right identity multi", li_multi ++ nil_int(), li_multi),

    # -----------------------------------------------------------------------
    # Monoid String — left and right identity
    # -----------------------------------------------------------------------

    check_eq("monoid string left identity empty", "" ++ s_empty, s_empty),
    check_eq("monoid string left identity single", "" ++ s_single, s_single),
    check_eq("monoid string left identity multi", "" ++ s_multi, s_multi),

    check_eq("monoid string right identity empty", s_empty ++ "", s_empty),
    check_eq("monoid string right identity single", s_single ++ "", s_single),
    check_eq("monoid string right identity multi", s_multi ++ "", s_multi),

    # -----------------------------------------------------------------------
    # Applicative laws (map2/pure "monoidal" formulation).
    #   Homomorphism:  map2(g, pure(x), pure(y)) == pure(g(x, y))
    #   Left identity:  map2(snd, pure(u), v)    == v
    #   Right identity: map2(fst, v, pure(u))    == v
    # The concrete expected value on the RHS anchors `f` so `pure` dispatches.
    # -----------------------------------------------------------------------

    # Maybe (fail-fast).
    check_eq("applicative maybe homomorphism",
      map2(add2, m_pure(1), m_pure(2)), Just(3)),
    check_eq("applicative maybe left identity",
      map2(snd2, m_pure(0), m_just_1), m_just_1),
    check_eq("applicative maybe right identity",
      map2(fst2, m_just_1, m_pure(0)), m_just_1),

    # List (cartesian product): pure is a singleton, so it is the product unit.
    check_eq("applicative list homomorphism",
      map2(add2, l_pure(1), l_pure(2)), Cons(3, Nil)),
    check_eq("applicative list left identity",
      map2(snd2, l_pure(0), li_multi), li_multi),
    check_eq("applicative list right identity",
      map2(fst2, li_multi, l_pure(0)), li_multi),

    # -----------------------------------------------------------------------
    # Monad laws (generic and_then / flat_map).
    #   Left identity:  and_then(f, pure(x)) == f(x)
    #   Right identity: and_then(pure, m)    == m
    #   Associativity:  and_then(g, and_then(f, m))
    #                     == and_then(\x -> and_then(g, f(x)), m)
    # Result is reduced to Int via result_with_default to avoid needing Eq Result.
    # -----------------------------------------------------------------------

    # Maybe — left identity (both the Just and Nothing carriers).
    check_eq("monad maybe left identity", and_then(mk_inc, m_pure(5)), mk_inc(5)),
    # Maybe — right identity.
    check_eq("monad maybe right identity just", and_then(m_pure, m_just_1), m_just_1),
    check_eq("monad maybe right identity nothing", and_then(m_pure, m_nothing), m_nothing),
    # Maybe — associativity.
    check_eq("monad maybe associativity",
      and_then(mk_dbl, and_then(mk_inc, m_just_1)),
      and_then(\x -> and_then(mk_dbl, mk_inc(x)), m_just_1)),

    # List — left identity, right identity, associativity.
    check_eq("monad list left identity", and_then(lk_dup, l_pure(5)), lk_dup(5)),
    check_eq("monad list right identity", and_then(l_pure, li_multi), li_multi),
    check_eq("monad list associativity",
      and_then(lk_dup, and_then(lk_inc, li_multi)),
      and_then(\x -> and_then(lk_dup, lk_inc(x)), li_multi)),

    # Result — same laws, reduced to Int (Ok path) via result_with_default.
    check_eq("monad result left identity",
      result_with_default(-1, and_then(rk_inc, r_pure(5))),
      result_with_default(-1, rk_inc(5))),
    check_eq("monad result right identity",
      result_with_default(-1, and_then(r_pure, ok_7())),
      result_with_default(-1, ok_7())),
    check_eq("monad result associativity",
      result_with_default(-1, and_then(rk_dbl, and_then(rk_inc, ok_7()))),
      result_with_default(-1, and_then(\x -> and_then(rk_dbl, rk_inc(x)), ok_7())))
  ])
