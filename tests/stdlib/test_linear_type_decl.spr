import stdlib.test (check_eq, run_suite)

# Linear types — M4.1 (syntax + accept, no enforcement yet).
# Per-declaration attachment: `linear` is a contextual marker between `type` and
# the type name, mirroring the existing `type alias Name = ...` shape. It reserves
# `linear` only in that one position (no lexer keyword), so existing identifiers
# are unaffected. See docs/linear-types-m4-scoping-2026-08-01.md.
#
# RED on the unfixed compiler: `type linear File = File Int` parses `linear` as the
# TYPE NAME and `File` as a type parameter, so the constructor `File` is undefined
# and every use below fails to compile. GREEN once the marker is recognized: the
# type is correctly named `File` / `Pos`, and (M4.1) the checker ACCEPTS linear
# values used any number of times — enforcement of consume-once is M4.2.

type linear File = File Int
type linear Pos = (x: Int, y: Int)

fn fd(f: File) -> Int =
  match f with
  | File n -> n

# M4.1 accepts (does not yet enforce) — `p` is read twice here on purpose, which a
# later milestone will reject; for now it must type-check and run.
fn manhattan(p: Pos) -> Int = p.x + p.y

fn main() -> Unit !{IO} =
  run_suite("linear_type_decl", [
    check_eq("linear ADT field", fd(File(7)), 7),
    check_eq("linear record fields", manhattan(Pos(x = 3, y = 4)), 7)
  ])
