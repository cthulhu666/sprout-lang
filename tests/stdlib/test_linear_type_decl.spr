import stdlib.test (check_eq, run_suite)

# Linear types — M4.1 (syntax) + M4.2 (consume-exactly-once enforcement).
# Per-declaration attachment: `linear` is a contextual marker between `type` and
# the type name. Every value of a linear type must be used EXACTLY ONCE in a
# function body (M4.2). This file exercises the VALID single-use shapes; the
# reuse/leak/divergence errors live in tests/conformance/type_error/linear_*.
# See docs/linear-types-m4.2-enforcement-2026-08-06.md.

type linear File = File Int
type linear Pos = (x: Int, y: Int)

# `f` is consumed exactly once — as the match scrutinee.
fn fd(f: File) -> Int =
  match f with
  | File n -> n

# `p` is consumed exactly once — a single field read. (Reading a second field
# would consume `p` twice: records have no destructuring pattern. See the doc.)
fn get_x(p: Pos) -> Int = p.x

# `f` is consumed exactly once on EVERY branch — branch convergence holds.
fn choose(c: Bool, f: File) -> Int =
  if c then fd(f) else fd(f)

fn main() -> Unit !{IO} =
  run_suite("linear_type_decl", [
    check_eq("linear ADT single-use", fd(File(7)), 7),
    check_eq("linear record single field", get_x(Pos(x = 3, y = 4)), 3),
    check_eq("linear convergent branches", choose(true, File(9)), 9)
  ])
