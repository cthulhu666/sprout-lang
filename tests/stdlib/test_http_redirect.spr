import stdlib.test (check_eq, run_suite)
import stdlib.http (MovedPermanently301, Found302, TemporaryRedirect307, PermanentRedirect308)
import stdlib.http_server (redirect, render, see_other)

# `redirect(status, location)`: an empty body and a `location` header. `see_other` is the 303 case,
# the Post/Redirect/Get answer to a form POST, so a browser refresh re-GETs the result page.

fn main() -> Unit !{IO} =
  run_suite("http_redirect", [
    check_eq("see_other is a 303 with a location",
      render(see_other("/users")),
      "HTTP/1.1 303 See Other\r\nlocation: /users\r\ncontent-type: text/plain\r\ncontent-length: 0\r\n\r\n"),
    check_eq("301", render(redirect(MovedPermanently301, "/reactor/")),
      "HTTP/1.1 301 Moved Permanently\r\nlocation: /reactor/\r\ncontent-type: text/plain\r\ncontent-length: 0\r\n\r\n"),
    check_eq("302", render(redirect(Found302, "/a")),
      "HTTP/1.1 302 Found\r\nlocation: /a\r\ncontent-type: text/plain\r\ncontent-length: 0\r\n\r\n"),
    check_eq("307", render(redirect(TemporaryRedirect307, "/a")),
      "HTTP/1.1 307 Temporary Redirect\r\nlocation: /a\r\ncontent-type: text/plain\r\ncontent-length: 0\r\n\r\n"),
    check_eq("308", render(redirect(PermanentRedirect308, "/a")),
      "HTTP/1.1 308 Permanent Redirect\r\nlocation: /a\r\ncontent-type: text/plain\r\ncontent-length: 0\r\n\r\n")
  ])
