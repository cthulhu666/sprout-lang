import stdlib.test (check_eq, run_suite)
import stdlib.string (byte_length, length, concat, slice)
import stdlib.bytes as bytes

# Pins byte_length across the string-representation change (headered literals).
# byte_length must equal the UTF-8 byte count for BOTH string literals (static,
# .rodata) and GC-managed strings (concat/slice results). The multi-byte cases
# are the load-bearing guard: if the literal's payload pointer were mis-offset
# (e.g. pointing into the header prefix instead of the bytes), both the byte
# count AND the string content would be wrong, so these checks fail loudly.
fn main() -> Unit !{IO} =
  run_suite("byte_length", [
    # ASCII literals: byte length == codepoint length
    check_eq("ascii literal", byte_length("hello"), 5),
    check_eq("empty literal", byte_length(""), 0),

    # Multi-byte UTF-8 literals: bytes > codepoints (guards literal content survives)
    check_eq("accented bytes", byte_length("café"), 5),
    check_eq("accented codepoints", length("café"), 4),
    check_eq("emoji bytes", byte_length("😀"), 4),
    check_eq("emoji codepoints", length("😀"), 1),

    # GC-managed strings (already headered): concat + slice results
    check_eq("concat bytes", byte_length(concat("ab", "cde")), 5),
    check_eq("slice bytes", byte_length(slice("hello", 1, 3)), 3),
    check_eq("concat multibyte bytes", byte_length(concat("ca", "fé")), 5),

    # Content integrity: a multi-byte literal round-trips unchanged
    check_eq("literal content", concat("ca", "fé"), "café"),

    # Map keys are interned strings (a previously bare producer); their
    # byte_length must be correct via the headered read. Multi-byte key guards
    # both the aux value and content of the interned string.
    check_eq("map key bytes (interned)",
      byte_length(vec_get_or(0, "", dict_keys(dict_from_list([("café", 1)])))), 5),
    check_eq("map key content (interned)",
      vec_get_or(0, "", dict_keys(dict_from_list([("café", 1)]))), "café"),

    # --- bytes.from_string must agree with byte_length ---
    # `bytes_from_utf8` measured with strlen while `str_byte_len` reads the CSTR header, so the two
    # DISAGREED on any String containing an interior 0x00. Such a String is ILLEGAL — a String is
    # valid UTF-8 and NUL-free (docs/spec-v0.md:64) — but it was constructible, because
    # sprout_gc_adopt_cstr copies an explicit length without rejecting a NUL, and anything handing it
    # unvalidated input minted one. The socket readers used to; `proc_run` still does (W2 R2's
    # remaining half, filed in BACKLOG). Measured before the fix, a String holding "a\0b" reported
    # byte_length 3 and bytes.length(from_string(...)) 1, so bytes.from_string SILENTLY DROPPED
    # payload — turning an illegal value into a wrong one instead of a rejected one.
    #
    # Agreement is what makes rejection possible: bytes.to_string is the single choke point and it
    # refuses a NUL as well as invalid UTF-8, but only sees the payload if from_string preserved it.
    #
    # These literals cannot contain a NUL (source strings are validated UTF-8, which excludes it), so
    # they pin the invariant on every case expressible here; the interior-NUL case is covered
    # end-to-end by tests/task_io_smoke/http_binary_body.spr, whose payload starts with 0x00.
    check_eq("from_string preserves the ascii byte count",
      bytes.length(bytes.from_string("hello")), byte_length("hello")),
    check_eq("from_string preserves the multi-byte count",
      bytes.length(bytes.from_string("café")), byte_length("café")),
    check_eq("from_string preserves a 4-byte character",
      bytes.length(bytes.from_string("🌱")), byte_length("🌱")),
    check_eq("from_string round-trips through to_string",
      decoded(bytes.to_string(bytes.from_string("café 日本"))), "café 日本"),
    check_eq("from_string of empty", bytes.length(bytes.from_string("")), 0)
  ])

fn decoded(r: Result bytes.Utf8Error String) -> String =
  match r with
  | Ok text -> text
  | Err _ -> "<not-utf8>"
