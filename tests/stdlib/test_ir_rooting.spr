import stdlib.test (TestState, new_state, assert_eq, assert_true, assert_false, summary)
import stdlib.compiler.sprout_ir as sprout_ir
import stdlib.compiler.ir_lowering as ir_lowering
import stdlib.compiler.ir_rooting as ir_rooting

# ---------------------------------------------------------------------------
# Tests for Milestone 2, PR 2.2: dataflow rooting pass.
# See docs/gc-rooting-model-c-plan-2026-06-02.md and the corrected test
# specification in the implementation prompt.
#
# Each test hand-builds an IRProgram and asserts on the LLVM rendered by
# `ir_lowering.lower_program(ir_rooting.insert_roots(prog, dict_empty()))`.
#
# Live-across semantics used here: an op's operands are NOT considered live
# across that op at the IR level — the runtime's internal SPROUT_HANDLE
# covers the call window.  The IR pass only roots values defined before a
# trigger AND used after it.

fn contains(haystack: String, needle: String) -> Bool =
  str_find(haystack, needle) != -1

fn count_substrs(haystack: String, needle: String, acc: Int) -> Int =
  if pos == -1 then acc
  else count_substrs(str_slice(haystack, pos + str_len(needle), str_len(haystack)),
                     needle, acc + 1)
  where pos = str_find(haystack, needle)

fn count(haystack: String, needle: String) -> Int =
  count_substrs(haystack, needle, 0)

# Pipeline: insert_roots then lower.
fn lower(prog: sprout_ir.IRProgram) -> String =
  ir_lowering.lower_program(ir_rooting.insert_roots(prog, dict_empty()))

# ---------------------------------------------------------------------------
# Test 1: single concat — no rooting needed (concat's operands are not "live
# across" the concat at the IR level; concat's result has no downstream use).

# fn one_concat() -> String = "a" ++ "b"
fn test1_program() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("one_concat", Nil, "i64", Cons(
      sprout_ir.IRBlock("entry", Cons(
        sprout_ir.IRStrConst("%t1", "%t0", "a"),
        Cons(sprout_ir.IRStrConst("%t3", "%t2", "b"),
        Cons(sprout_ir.IRStrConcat("%t4", "%t1", "%t3"),
        Cons(sprout_ir.IRRet("%t4"), Nil))))),
      Nil)),
    Nil), Nil, Nil, Nil)

# ---------------------------------------------------------------------------
# Test 2: %ab live across the second concat (which is a trigger).
# Expected: 1 IRRoot before %cd's concat, 1 IRUnroot(i64 1) after.

# IR for:
#   %ab = "a" ++ "b"
#   %cd = "c" ++ "d"      ← root %ab across this
#   %r  = %ab ++ %cd
fn test2_program() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("one_live", Nil, "i64", Cons(
      sprout_ir.IRBlock("entry", Cons(
        sprout_ir.IRStrConst("%a1", "%a1_raw", "a"),
        Cons(sprout_ir.IRStrConst("%a2", "%a2_raw", "b"),
        Cons(sprout_ir.IRStrConcat("%ab", "%a1", "%a2"),
        Cons(sprout_ir.IRStrConst("%c1", "%c1_raw", "c"),
        Cons(sprout_ir.IRStrConst("%c2", "%c2_raw", "d"),
        Cons(sprout_ir.IRStrConcat("%cd", "%c1", "%c2"),
        Cons(sprout_ir.IRStrConcat("%r", "%ab", "%cd"),
        Cons(sprout_ir.IRRet("%r"), Nil))))))))),
      Nil)),
    Nil), Nil, Nil, Nil)

# ---------------------------------------------------------------------------
# Test 3: two heap values live across a trigger, plus a 1-root and another
# 1-root.  Expected counts per op: 0, 1, 2, 1, 0 = 4 total roots.

# IR for:
#   %ab = "a"++"b";  %cd = "c"++"d" [live_across = %ab]
#   %ef = "e"++"f"   [live_across = %ab, %cd]
#   %t1 = %ab ++ %cd [live_across = %ef]
#   %r  = %t1 ++ %ef
fn test3_program() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("three_concat", Nil, "i64", Cons(
      sprout_ir.IRBlock("entry", Cons(
        sprout_ir.IRStrConst("%a1", "%a1_raw", "a"),
        Cons(sprout_ir.IRStrConst("%a2", "%a2_raw", "b"),
        Cons(sprout_ir.IRStrConcat("%ab", "%a1", "%a2"),
        Cons(sprout_ir.IRStrConst("%c1", "%c1_raw", "c"),
        Cons(sprout_ir.IRStrConst("%c2", "%c2_raw", "d"),
        Cons(sprout_ir.IRStrConcat("%cd", "%c1", "%c2"),
        Cons(sprout_ir.IRStrConst("%e1", "%e1_raw", "e"),
        Cons(sprout_ir.IRStrConst("%e2", "%e2_raw", "f"),
        Cons(sprout_ir.IRStrConcat("%ef", "%e1", "%e2"),
        Cons(sprout_ir.IRStrConcat("%t1", "%ab", "%cd"),
        Cons(sprout_ir.IRStrConcat("%r", "%t1", "%ef"),
        Cons(sprout_ir.IRRet("%r"), Nil))))))))))))),
      Nil)),
    Nil), Nil, Nil, Nil)

# ---------------------------------------------------------------------------
# Test 4: phi-of-heap with a trigger AFTER the join — validates the load-
# bearing assumption that each arm roots locally and IRBr is not a trigger.
#
# IR shape:
#   entry: condbr %cond, then, else
#   then:  %xt = "x"; br join
#   else:  %ye = "y"; br join
#   join:  %phi = phi [%xt, then], [%ye, else]
#          %z1 = "z"; %z2 = "w"; %zw = %z1++%z2    [trigger; live_across = %phi]
#          %r  = %phi ++ %zw; ret %r

fn test4_program() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("phi_heap", Cons(("cond", sprout_ir.IRTHeap), Nil), "i64", Cons(
      sprout_ir.IRBlock("entry", Cons(
        sprout_ir.IRCondBr("%cond", "then", "else"), Nil)),
      Cons(sprout_ir.IRBlock("then", Cons(
        sprout_ir.IRStrConst("%xt", "%xt_raw", "x"),
        Cons(sprout_ir.IRBr("join"), Nil))),
      Cons(sprout_ir.IRBlock("else", Cons(
        sprout_ir.IRStrConst("%ye", "%ye_raw", "y"),
        Cons(sprout_ir.IRBr("join"), Nil))),
      Cons(sprout_ir.IRBlock("join", Cons(
        sprout_ir.IRPhi("%phi", "i64",
          Cons(("%xt", "then"), Cons(("%ye", "else"), Nil))),
        Cons(sprout_ir.IRStrConst("%z1", "%z1_raw", "z"),
        Cons(sprout_ir.IRStrConst("%z2", "%z2_raw", "w"),
        Cons(sprout_ir.IRStrConcat("%zw", "%z1", "%z2"),
        Cons(sprout_ir.IRStrConcat("%r", "%phi", "%zw"),
        Cons(sprout_ir.IRRet("%r"), Nil))))))),
      Nil))))),
    Nil), Nil, Nil, Nil)

# ---------------------------------------------------------------------------
# Test 5: heap param live across a trigger (bug S2 regression).
#
# IR for:
#   fn f(%s: String) -> T3 =
#     %r0 = call bar(%s)           ← IRCall trigger; %s live across (used by IRMakeCtor)
#     %ctor = IRMakeCtor "T3" 0 [%s, %z0, %z0]
#     ret %ctor
#
# Without seeding params_heap_origin, %s is absent from heap_origin, no
# IRRoot is emitted, and %s's string storage may be freed inside bar().
# With the fix, %s IS in heap_origin → it appears in in_scope_ord at block
# entry → live_across for the IRCall includes %s → 1 root is emitted.

fn test5_program() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("f_heap_param", Cons(("s", sprout_ir.IRTHeap), Nil), "i64", Cons(
      sprout_ir.IRBlock("entry",
        Cons(sprout_ir.IRConst("%z0", 0),
        Cons(sprout_ir.IRCall("%r0", sprout_ir.IRTUnknown, "bar", Cons("%s", Nil)),
        Cons(sprout_ir.IRMakeCtor("%ctor", "T3", 0, Cons("%s", Cons("%z0", Cons("%z0", Nil)))),
        Cons(sprout_ir.IRRet("%ctor"), Nil))))),
      Nil)),
    Nil), Nil, Nil, Nil)

# ---------------------------------------------------------------------------
# Test 6: IRMakeCtor with a heap operand that is DEAD after the make.
#
# IR for:
#   %a = "a"                       (heap)
#   %r = IRMakeCtor "Box" 1 [%a]   ← trigger; %a is an operand, dead afterward
#   ret %r
#
# @sprout_makeN allocates (a GC point) BEFORE storing its operand registers,
# and — unlike @str_concat — does NOT SPROUT_HANDLE them.  So %a must be rooted
# across the make even though it is not live after it.  Expected: 1 root.
fn test6_program() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("ctor_operand", Nil, "i64", Cons(
      sprout_ir.IRBlock("entry",
        Cons(sprout_ir.IRStrConst("%a", "%a_raw", "a"),
        Cons(sprout_ir.IRMakeCtor("%r", "Box", 1, Cons("%a", Nil)),
        Cons(sprout_ir.IRRet("%r"), Nil)))),
      Nil)),
    Nil), Nil, Nil, Nil)

# ---------------------------------------------------------------------------
# Test 7: IRMkClosure with a heap capture that is DEAD after the mk-closure.
#
# IR for:
#   %c   = "c"                       (heap)
#   %clo = IRMkClosure "lam" [%c]    ← trigger; %c is a capture, dead afterward
#   ret %clo
#
# @sprout_alloc_closure_env allocates the env (a GC point) before the capture
# stores emitted by ir_lowering; the capture is not handle-protected, so %c
# must be rooted across the mk-closure.  Expected: 1 root.
fn test7_program() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("closure_cap", Nil, "i64", Cons(
      sprout_ir.IRBlock("entry",
        Cons(sprout_ir.IRStrConst("%c", "%c_raw", "c"),
        Cons(sprout_ir.IRMkClosure("%clo", "lam", Cons("%c", Nil)),
        Cons(sprout_ir.IRRet("%clo"), Nil)))),
      Nil)),
    Nil), Nil, Nil, Nil)

# ---------------------------------------------------------------------------
# Test 8: IRMakeTuple with a heap operand that is DEAD after the tuple build.
#
# IR for:
#   %a   = "a"                 (heap)
#   %tup = IRMakeTuple [%a]    ← trigger; %a is an operand, dead afterward
#   ret %tup
#
# @sprout_alloc_tuple_blob calls sprout_gc_maybe_collect_threshold() then
# allocates then stores the fields — so a tuple build is a GC trigger and its
# operands are exposed, exactly like @sprout_makeN.  %a must be rooted.
fn test8_program() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("tuple_operand", Nil, "i64", Cons(
      sprout_ir.IRBlock("entry",
        Cons(sprout_ir.IRStrConst("%a", "%a_raw", "a"),
        Cons(sprout_ir.IRMakeTuple("%tup", Cons("%a", Nil)),
        Cons(sprout_ir.IRRet("%tup"), Nil)))),
      Nil)),
    Nil), Nil, Nil, Nil)

# ---------------------------------------------------------------------------
# Test 9: IRGetTupleField result live across a later trigger.
#
# IR for:
#   %a   = "a"                          (heap; tuple operand → 1 root at the build)
#   %tup = IRMakeTuple [%a]
#   %x   = IRGetTupleField %tup 0        (heap — the result must be tracked)
#   %c1  = "c"; %c2 = "d"; %cd = %c1++%c2  ← trigger; %x is live across it
#   %r   = %x ++ %cd
#   ret %r
#
# %x (an IRGetTupleField result) is live across the %cd concat and is NOT that
# op's operand, so it must be rooted there.  Pre-fix IRGetTupleField is not
# heap-classified, so %x gets no root.  Expected post-fix: 2 pushes total
# (%a at the tuple build, %x across the %cd concat).
fn test9_program() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("tuple_extract_live", Nil, "i64", Cons(
      sprout_ir.IRBlock("entry",
        Cons(sprout_ir.IRStrConst("%a", "%a_raw", "a"),
        Cons(sprout_ir.IRMakeTuple("%tup", Cons("%a", Nil)),
        Cons(sprout_ir.IRGetTupleField("%x", "%tup", 0),
        Cons(sprout_ir.IRStrConst("%c1", "%c1_raw", "c"),
        Cons(sprout_ir.IRStrConst("%c2", "%c2_raw", "d"),
        Cons(sprout_ir.IRStrConcat("%cd", "%c1", "%c2"),
        Cons(sprout_ir.IRStrConcat("%r", "%x", "%cd"),
        Cons(sprout_ir.IRRet("%r"), Nil))))))))),
      Nil)),
    Nil), Nil, Nil, Nil)

# ---------------------------------------------------------------------------
# Test 10: a heap value (%a) live ACROSS an IRMakeTuple is rooted, even though
# it is not a tuple element.  IRMakeTuple is a GC trigger (@sprout_alloc_tuple_blob
# collects), so %a — used after the tuple build — must be rooted across it.  The
# tuple element %n is a scalar, so it contributes no root.  Exactly 1 root.
# Guards that IRMakeTuple stays in op_triggers_gc (the exhaustive classifier
# turns any future omission into a compile error, not a silent UAF — P11-2e).
fn test10_program() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("live_across_tuple", Nil, "i64", Cons(
      sprout_ir.IRBlock("entry",
        Cons(sprout_ir.IRStrConst("%a", "%a_raw", "a"),
        Cons(sprout_ir.IRConst("%n", 5),
        Cons(sprout_ir.IRMakeTuple("%tup", Cons("%n", Nil)),
        Cons(sprout_ir.IRStrConst("%c", "%c_raw", "c"),
        Cons(sprout_ir.IRStrConcat("%r", "%a", "%c"),
        Cons(sprout_ir.IRRet("%r"), Nil))))))),
      Nil)),
    Nil), Nil, Nil, Nil)

# ---------------------------------------------------------------------------
# Test 11: IRCall with a heap operand that is DEAD after the call (PR 11 item 4
# GC-UAF regression).
#
# IR for:
#   %a = "a"                                   (heap)
#   %r = IRCall ref_new IRTUnknown [%a]        ← trigger; %a operand, dead afterward
#   ret %r
#
# @ref_new calls sprout_gc_maybe_collect_threshold() and allocates the RefVal
# BEFORE `r->value = value` — so it can collect before consuming its operand,
# exactly like @sprout_makeN.  %a is NOT live after the call, so live_across
# alone misses it; the operand must be rooted because IRCall exposes operands.
# Pre-fix (IRCall not exposing operands): 0 roots → this test FAILS.
# Post-fix: exactly 1 root.  Distinct from T5, where %s is live-AFTER the call.
fn test11_program() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("call_operand", Nil, "i64", Cons(
      sprout_ir.IRBlock("entry",
        Cons(sprout_ir.IRStrConst("%a", "%a_raw", "a"),
        Cons(sprout_ir.IRCall("%r", sprout_ir.IRTUnknown, "ref_new", Cons("%a", Nil)),
        Cons(sprout_ir.IRRet("%r"), Nil)))),
      Nil)),
    Nil), Nil, Nil, Nil)

# ---------------------------------------------------------------------------
# Test 12: IRCall with a MIXED operand list (heap + scalar) — only the heap
# operand is rooted across the call.
#
# IR for:
#   %a = "a"                                     (heap)
#   %n = 5                                        (scalar)
#   %r = IRCall foo IRTUnknown [%a, %n]          ← trigger; exposes operands
#   ret %r
#
# Guards that operand exposure (IRCall -> op_exposes_operands) roots only the
# in-scope HEAP operands: %a gets a root, the scalar %n (an IRConst, never in
# heap_origin) does not.  Complements T11 (single heap operand) by exercising
# the scalar-filtering path in roots_across_loop.  Expected: exactly 1 root.
fn test12_program() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("call_mixed_operands", Nil, "i64", Cons(
      sprout_ir.IRBlock("entry",
        Cons(sprout_ir.IRStrConst("%a", "%a_raw", "a"),
        Cons(sprout_ir.IRConst("%n", 5),
        Cons(sprout_ir.IRCall("%r", sprout_ir.IRTUnknown, "foo", Cons("%a", Cons("%n", Nil))),
        Cons(sprout_ir.IRRet("%r"), Nil))))),
      Nil)),
    Nil), Nil, Nil, Nil)

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # --- Test 1: no rooting emitted.  Search for the call site, not the
    # declare line (the header always declares the runtime functions).
    assert_false(state, "T1: no push_i64_root call site for single concat",
                 contains(lower(test1_program()), "call i64 @sprout_gc_push_i64_root"))
    assert_false(state, "T1: no pop_roots call site for single concat",
                 contains(lower(test1_program()), "call i64 @sprout_gc_pop_roots"))

    # --- Test 2: exactly one root pushed and one pop(i64 1).
    assert_eq(state, "T2: exactly one push_i64_root call",
              count(lower(test2_program()), "call i64 @sprout_gc_push_i64_root"), 1)
    assert_eq(state, "T2: exactly one pop_roots(i64 1) call",
              count(lower(test2_program()), "@sprout_gc_pop_roots(i64 1)"), 1)

    # --- Test 3: 4 total root pushes; at least one pop(2); at least two pop(1).
    assert_eq(state, "T3: four push_i64_root calls",
              count(lower(test3_program()), "call i64 @sprout_gc_push_i64_root"), 4)
    assert_true(state, "T3: at least one pop_roots(i64 2)",
                contains(lower(test3_program()), "@sprout_gc_pop_roots(i64 2)"))
    assert_true(state, "T3: at least two pop_roots(i64 1)",
                count(lower(test3_program()), "@sprout_gc_pop_roots(i64 1)") >= 2)

    # --- Test 4: phi-of-heap — exactly one push.  Neither arm pre-roots; the
    # root sits in the join block before the %zw concat.
    assert_eq(state, "T4: exactly one push_i64_root (phi rooted across %zw)",
              count(lower(test4_program()), "call i64 @sprout_gc_push_i64_root"), 1)
    assert_eq(state, "T4: exactly one pop_roots(i64 1)",
              count(lower(test4_program()), "@sprout_gc_pop_roots(i64 1)"), 1)

    # --- Test 5: heap param %s seeded into heap_origin (S2 regression).
    # %s is live across IRCall bar(%s) → 1 root there.  %s is ALSO an operand of
    # the following IRMakeCtor, and @sprout_makeN allocates before storing its
    # operands without SPROUT_HANDLE-protecting them, so %s must be rooted across
    # the make too → a second root.  (Both roots are pop_roots(i64 1).)
    assert_eq(state, "T5: two push_i64_root (heap param across call AND make operand)",
              count(lower(test5_program()), "call i64 @sprout_gc_push_i64_root"), 2)
    assert_eq(state, "T5: two pop_roots(i64 1) for heap param",
              count(lower(test5_program()), "@sprout_gc_pop_roots(i64 1)"), 2)

    # --- Test 6: IRMakeCtor operand rooted across the make (PR-A regression).
    # %a is dead after the make but must be rooted because @sprout_makeN
    # allocates before storing operands and does not handle-protect them.
    assert_eq(state, "T6: exactly one push_i64_root for IRMakeCtor operand",
              count(lower(test6_program()), "call i64 @sprout_gc_push_i64_root"), 1)
    assert_eq(state, "T6: exactly one pop_roots(i64 1) around the make",
              count(lower(test6_program()), "@sprout_gc_pop_roots(i64 1)"), 1)

    # --- Test 7: IRMkClosure capture rooted across the mk-closure (PR-A regression).
    # %c is dead after the mk-closure but must be rooted because
    # @sprout_alloc_closure_env allocates before the capture stores.
    assert_eq(state, "T7: exactly one push_i64_root for IRMkClosure capture",
              count(lower(test7_program()), "call i64 @sprout_gc_push_i64_root"), 1)
    assert_eq(state, "T7: exactly one pop_roots(i64 1) around the mk-closure",
              count(lower(test7_program()), "@sprout_gc_pop_roots(i64 1)"), 1)

    # --- Test 8: IRMakeTuple operand rooted across the tuple build.
    assert_eq(state, "T8: exactly one push_i64_root for IRMakeTuple operand",
              count(lower(test8_program()), "call i64 @sprout_gc_push_i64_root"), 1)
    assert_eq(state, "T8: exactly one pop_roots(i64 1) around the tuple build",
              count(lower(test8_program()), "@sprout_gc_pop_roots(i64 1)"), 1)

    # --- Test 9: IRGetTupleField result rooted across a later trigger.
    # 2 pushes: %a at the tuple build, %x across the %cd concat.
    assert_eq(state, "T9: two push_i64_root (tuple operand + extracted value across trigger)",
              count(lower(test9_program()), "call i64 @sprout_gc_push_i64_root"), 2)

    # --- Test 10: value live across IRMakeTuple is rooted (IRMakeTuple is a trigger).
    assert_eq(state, "T10: one push_i64_root (heap value live across IRMakeTuple)",
              count(lower(test10_program()), "call i64 @sprout_gc_push_i64_root"), 1)

    # --- Test 11: IRCall operand rooted across the call (PR 11 item 4 regression).
    # %a is dead after the call but must be rooted because @ref_new (and any
    # runtime builtin) may collect before consuming its operand.
    assert_eq(state, "T11: exactly one push_i64_root for IRCall operand",
              count(lower(test11_program()), "call i64 @sprout_gc_push_i64_root"), 1)
    assert_eq(state, "T11: exactly one pop_roots(i64 1) around the call",
              count(lower(test11_program()), "@sprout_gc_pop_roots(i64 1)"), 1)

    # --- Test 12: IRCall with mixed heap+scalar operands roots only the heap one.
    assert_eq(state, "T12: exactly one push_i64_root (heap operand only, scalar skipped)",
              count(lower(test12_program()), "call i64 @sprout_gc_push_i64_root"), 1)

    # --- Header declares the rooting runtime functions.
    assert_true(state, "header declares @sprout_gc_push_i64_root",
                contains(lower(test1_program()),
                         "declare i64 @sprout_gc_push_i64_root(ptr)"))
    assert_true(state, "header declares @sprout_gc_pop_roots",
                contains(lower(test1_program()),
                         "declare i64 @sprout_gc_pop_roots(i64)"))

    summary(state)
