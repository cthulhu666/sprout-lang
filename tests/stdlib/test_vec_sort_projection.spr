import stdlib.test (TestState, new_state, assert_eq, assert_true, summary)

# Regression: vec_sort_by with a projection whose key type differs from the
# element type (f: a -> k with k != a). Before the dict-resolver fix, the
# `Ord k` obligation was resolved to `Ord a` (the ELEMENT type) instead of
# `Ord k` (the projected KEY type): resolve_obligation's precise
# prog_to_fresh lookup missed (the callee's env scheme is generalized to fresh
# var names while the @constrained marker keeps the source var name `k`), so it
# fell to the order-dependent scan_prog_to_fresh_for_instance heuristic, which
# grabbed the first prog_to_fresh entry with an instance — the element type.
# The wrong dict (e.g. `Ord (Int,Int)`) then dereferenced small Int keys as
# tuple pointers → SIGSEGV via self-referential dict recursion. This drives the
# projection path with >= 2 elements, which crashed on the unfixed compiler.

fn fst(p: (Int, Int)) -> Int =
  match p with
  | (k, _) -> k

fn key_at(i: Int, v: Vec (Int, Int)) -> Int =
  match vec_get(i, v) with
  | Nothing -> -1
  | Just p -> match p with | (k, _) -> k

fn tag_at(i: Int, v: Vec (Int, Int)) -> Int =
  match vec_get(i, v) with
  | Nothing -> -1
  | Just p -> match p with | (_, t) -> t

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # --- projection ordering: sort tuples by their first component ---
    let v = foldable_to_vec([(3, 100), (1, 200), (2, 50)])
    let sorted = vec_sort_by(fst, v)
    assert_eq(state, "proj key[0]", key_at(0, sorted), 1)
    assert_eq(state, "proj key[1]", key_at(1, sorted), 2)
    assert_eq(state, "proj key[2]", key_at(2, sorted), 3)

    # --- stability: equal keys preserve input order (deferred in the
    # stack-safety test until this dispatch fix; now runnable). Input has three
    # key=1 and two key=2 rows with distinct tags; sorting by key must keep the
    # tags in their original relative order. ---
    let s = foldable_to_vec([(1, 10), (2, 20), (1, 30), (2, 40), (1, 50)])
    let st = vec_sort_by(fst, s)
    assert_eq(state, "stable key[0]", key_at(0, st), 1)
    assert_eq(state, "stable key[1]", key_at(1, st), 1)
    assert_eq(state, "stable key[2]", key_at(2, st), 1)
    assert_eq(state, "stable key[3]", key_at(3, st), 2)
    assert_eq(state, "stable key[4]", key_at(4, st), 2)
    assert_eq(state, "stable tag[0]", tag_at(0, st), 10)
    assert_eq(state, "stable tag[1]", tag_at(1, st), 30)
    assert_eq(state, "stable tag[2]", tag_at(2, st), 50)
    assert_eq(state, "stable tag[3]", tag_at(3, st), 20)
    assert_eq(state, "stable tag[4]", tag_at(4, st), 40)

    summary(state)
