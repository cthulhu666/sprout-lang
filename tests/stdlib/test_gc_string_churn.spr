import stdlib.test (check_eq, check_true, run_suite)

# Invariant net for CSTR (heap-allocated C string) lifecycle across a GC rewrite.
# All anchor strings are built at runtime via str_concat so they live on the GC
# heap (not as static constants) and must genuinely survive collection cycles.
# ~5000 short-lived concatenations are churned so the sweeper runs many times
# before we re-assert anchor identity and length.

# Each call allocates two CSTRs (int_to_string result + concat) and drops them.
fn churn(n: Int, acc: Int) -> Int =
  if n <= 0 then acc
  else churn(n - 1, acc + str_len("ab" ++ int_to_string(n)))

fn main() -> Unit !{IO} =
  # Runtime-allocated anchor strings (heap CSTRs, not static literals).
  let anchor_a = "hello, " ++ "world"
  in let anchor_b = "sprout " ++ "language"
  in let anchor_c = "prefix-" ++ int_to_string(42)
  in let pre_len_a = str_len(anchor_a)
  in let pre_len_b = str_len(anchor_b)
  in let pre_len_c = str_len(anchor_c)
  # 5000 iterations: each iteration allocates and drops two CSTRs.
  # The GC sweeps the dead strings repeatedly between collections.
  in let total = churn(5000, 0)
  # Fresh allocations after churn must work — tests reuse of freed CSTR slots.
  in let post = "post" ++ "-churn"
  in run_suite("gc_string_churn", [
    check_true("churn produced nonzero total", total > 0),

    # Exact-content identity after thousands of GC cycles.
    check_eq("anchor_a content survives churn", anchor_a, "hello, world"),
    check_eq("anchor_b content survives churn", anchor_b, "sprout language"),
    check_eq("anchor_c content survives churn", anchor_c, "prefix-42"),

    # Length of a surviving string must be stable across collections.
    check_eq("anchor_a str_len stable after churn", str_len(anchor_a), pre_len_a),
    check_eq("anchor_b str_len stable after churn", str_len(anchor_b), pre_len_b),
    check_eq("anchor_c str_len stable after churn", str_len(anchor_c), pre_len_c),
    check_eq("pre_len_a is 12", pre_len_a, 12),
    check_eq("pre_len_b is 15", pre_len_b, 15),
    check_eq("pre_len_c is 9", pre_len_c, 9),

    # str_slice: codepoint offset arithmetic on a surviving CSTR.
    check_eq("str_slice first 5 chars", str_slice(anchor_a, 0, 5), "hello"),
    check_eq("str_slice tail 5 chars", str_slice(anchor_a, 7, 5), "world"),

    check_eq("fresh concat after churn", post, "post-churn"),
    check_eq("fresh concat str_len", str_len(post), 10)
  ])
