import stdlib.test (check_eq, check_true, check_false, run_suite)

# Verifies that String equality (`==` / `!=`) lowers correctly
# (M3 PR 9).
#
# Before PR 9: ast_to_ir errors with
#   ERROR: ast_to_ir: binary op '==' requires Int operands
# for any source that compares two String values.  The binary-op handler
# had a monomorphic int-type guard that rejected all other operand types.
#
# After PR 9: a special-case sits before the int-type guard in
# translate_binary.  When both operands are String-typed and op is `==`
# or `!=`, it emits IRStrEq (a new IR op):
#
#   IRStrEq <result> <lhs-i64> <rhs-i64>
#     →  %result$lptr = inttoptr i64 %lhs to ptr
#        %result$rptr = inttoptr i64 %rhs to ptr
#        %result$i1   = call i1 @str_eq(ptr %result$lptr, ptr %result$rptr)
#        %result      = zext i1 %result$i1 to i64
#
# For `!=`, an IRBoolNot (`xor i64 %r, 1`) follows IRStrEq.
#
# This file defines representative functions and asserts their results, so both
# ops are checked in isolation and in composition.
#
# Note: StringPattern-in-match (| "let" -> ...) is a separate IR parity
# gap; those cases are intentionally absent here, not forgotten.

# String == in isolation.
fn str_eq_fn(a: String, b: String) -> Bool = a == b

# String != in isolation.
fn str_neq_fn(a: String, b: String) -> Bool = a != b

# String == as an if-condition — exercises the IRStrEq → IRTruncI64ToI1
# path (the zext'd i64 Bool is re-narrowed before the br i1).
fn classify(s: String) -> String =
  if s == "yes" then "positive" else "other"

# String != as an if-condition.
fn non_empty(s: String) -> Bool =
  s != ""

# Both ops composed in the same function — tests that successive IRStrEq
# ops in one block don't clobber each other's SSA names.
fn same_or_empty(a: String, b: String) -> Bool =
  (a == b) || (b == "")

# String == chained — exercises multiple IRStrEq in the same function,
# covering the common real-world pattern of keyword checking.
fn is_keyword(s: String) -> Bool =
  s == "let" || s == "fn" || s == "if" || s == "then" || s == "else"

fn main() -> Unit !{IO} =
  run_suite("ir_codegen_string_eq", [
    check_true("== equal", str_eq_fn("abc", "abc")),
    check_false("== differ", str_eq_fn("abc", "abd")),
    check_false("== prefix", str_eq_fn("abc", "ab")),
    check_true("== both empty", str_eq_fn("", "")),
    check_false("!= equal", str_neq_fn("abc", "abc")),
    check_true("!= differ", str_neq_fn("abc", "abd")),
    check_eq("classify yes", classify("yes"), "positive"),
    check_eq("classify no", classify("no"), "other"),
    check_true("non_empty x", non_empty("x")),
    check_false("non_empty empty", non_empty("")),
    check_true("same_or_empty equal", same_or_empty("a", "a")),
    check_true("same_or_empty empty b", same_or_empty("a", "")),
    check_false("same_or_empty neither", same_or_empty("a", "b")),
    check_true("is_keyword let", is_keyword("let")),
    check_true("is_keyword fn", is_keyword("fn")),
    check_true("is_keyword if", is_keyword("if")),
    check_true("is_keyword then", is_keyword("then")),
    check_true("is_keyword else", is_keyword("else")),
    check_false("is_keyword other", is_keyword("match"))
  ])
