import stdlib.test (TestState, new_state, assert_eq, summary)

# Tests for the byte-indexed str_slice_bytes builtin.
# str_slice_bytes(s, byte_start, byte_len) -> String
# Caller is responsible for honoring UTF-8 codepoint boundaries; the runtime
# panics if byte_start or byte_start+byte_len lands in the middle of a
# multi-byte codepoint.

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # --- ASCII basics ---
    assert_eq(state, "ascii prefix", str_slice_bytes("hello", 0, 3), "hel")
    assert_eq(state, "ascii mid", str_slice_bytes("hello", 1, 3), "ell")
    assert_eq(state, "ascii suffix", str_slice_bytes("hello", 2, 3), "llo")
    assert_eq(state, "ascii full", str_slice_bytes("hello", 0, 5), "hello")

    # --- Edges ---
    assert_eq(state, "empty range", str_slice_bytes("hello", 2, 0), "")
    assert_eq(state, "from empty", str_slice_bytes("", 0, 0), "")
    assert_eq(state, "clamp overflow", str_slice_bytes("hi", 0, 100), "hi")
    assert_eq(state, "clamp start at end", str_slice_bytes("hi", 2, 5), "")

    # --- UTF-8 multi-byte (codepoint-boundary respect) ---
    # "Cześć" byte layout: C(1) z(1) e(1) ś(2) ć(2) = 7 bytes total.
    # Slicing on codepoint boundaries must yield valid UTF-8.
    assert_eq(state, "utf8 first byte (C)", str_slice_bytes("Cześć", 0, 1), "C")
    assert_eq(state, "utf8 ascii prefix Cze", str_slice_bytes("Cześć", 0, 3), "Cze")
    assert_eq(state, "utf8 multi-byte ś", str_slice_bytes("Cześć", 3, 2), "ś")
    assert_eq(state, "utf8 multi-byte ć tail", str_slice_bytes("Cześć", 5, 2), "ć")
    assert_eq(state, "utf8 full", str_slice_bytes("Cześć", 0, 7), "Cześć")

    # --- Equivalence to str_slice for ASCII (semantically: codepoint==byte) ---
    assert_eq(state, "matches str_slice on ascii",
              str_slice_bytes("hello world", 6, 5),
              str_slice("hello world", 6, 5))

    summary(state)
