import stdlib.test (check_eq, run_suite)

# Tests for the byte-indexed str_slice_bytes builtin.
# str_slice_bytes(s, byte_start, byte_len) -> String
# Caller is responsible for honoring UTF-8 codepoint boundaries; the runtime
# panics if byte_start or byte_start+byte_len lands in the middle of a
# multi-byte codepoint.

fn main() -> Unit !{IO} =
  run_suite("str_slice_bytes", [
    # --- ASCII basics ---
    check_eq("ascii prefix", str_slice_bytes("hello", 0, 3), "hel"),
    check_eq("ascii mid", str_slice_bytes("hello", 1, 3), "ell"),
    check_eq("ascii suffix", str_slice_bytes("hello", 2, 3), "llo"),
    check_eq("ascii full", str_slice_bytes("hello", 0, 5), "hello"),

    # --- Edges ---
    check_eq("empty range", str_slice_bytes("hello", 2, 0), ""),
    check_eq("from empty", str_slice_bytes("", 0, 0), ""),
    check_eq("clamp overflow", str_slice_bytes("hi", 0, 100), "hi"),
    check_eq("clamp start at end", str_slice_bytes("hi", 2, 5), ""),

    # --- UTF-8 multi-byte (codepoint-boundary respect) ---
    # "Cześć" byte layout: C(1) z(1) e(1) ś(2) ć(2) = 7 bytes total.
    # Slicing on codepoint boundaries must yield valid UTF-8.
    check_eq("utf8 first byte (C)", str_slice_bytes("Cześć", 0, 1), "C"),
    check_eq("utf8 ascii prefix Cze", str_slice_bytes("Cześć", 0, 3), "Cze"),
    check_eq("utf8 multi-byte ś", str_slice_bytes("Cześć", 3, 2), "ś"),
    check_eq("utf8 multi-byte ć tail", str_slice_bytes("Cześć", 5, 2), "ć"),
    check_eq("utf8 full", str_slice_bytes("Cześć", 0, 7), "Cześć"),

    # --- Equivalence to str_slice for ASCII (semantically: codepoint==byte) ---
    check_eq("matches str_slice on ascii",
              str_slice_bytes("hello world", 6, 5),
              str_slice("hello world", 6, 5))
  ])
