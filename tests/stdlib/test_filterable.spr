import stdlib.test (check_eq, run_suite)

# Tests for `Filterable` — the container-preserving generalization of `filter`
# (docs/filterable-v0.md).
#
# The property that makes this class necessary rather than a Foldable
# derivation: `filter` returns the SAME container it was given. A Vec filtered
# is a Vec, not a List — so every Vec case below is also a type-level assertion
# that nothing collapsed to a list on the way through.
#
# Both instances are covered. A `where Filterable c` signature that only ever
# saw `List` would not prove the genericity is real.

type Person = (name: String, age: Int) deriving (Eq, ToString)

# Type anchors. An empty container leaves the element type free on both sides
# of the comparison, so each empty case needs a typed nullary fn.
fn nil_int() -> List Int = Nil
fn empty_vec_int() -> Vec Int = vec_empty()

# No modulo operator in the core language; the fizzbuzz example spells `rem`
# out the same way.
fn is_even(n: Int) -> Bool = n - (n / 2) * 2 == 0
fn is_positive(n: Int) -> Bool = n > 0
fn always(n: Int) -> Bool = true
fn never(n: Int) -> Bool = false
fn is_adult(p: Person) -> Bool = p.age >= 18
fn name_of(p: Person) -> String = p.name

# Dictionary forwarding. `filter` carries `where Filterable c` and so does this
# caller, so the dictionary is genuinely PASSED here rather than devirtualized
# away as it is at a concrete call site. Without a caller of this shape the
# forwarding path is untested.
fn keep(pred: a -> Bool, xs: c a) -> c a where Filterable c =
  filter(pred, xs)

# Two constraints on one container variable: filtering and then mapping the
# same generic container exercises Filterable and Functor dictionaries side by
# side, which is where a mis-slotted dictionary shows up.
fn evens_doubled(xs: c Int) -> c Int where Filterable c, Functor c =
  map(\n -> n * 2, filter(is_even, xs))

fn main() -> Unit !{IO} =
  let ints = Cons(1, Cons(2, Cons(3, Cons(4, Cons(5, Nil)))))
      ints_vec = vec_from_list(ints)
      people = Cons(Person(name = "ada", age = 36),
               Cons(Person(name = "kid", age = 9),
               Cons(Person(name = "bob", age = 18), Nil)))
  in run_suite("filterable", [
    # --- List: the behaviour `filter` had before it was generic --------------
    check_eq("filter over List keeps matches in order",
      filter(is_even, ints), Cons(2, Cons(4, Nil))),
    check_eq("filter over List with a record element",
      map(name_of, filter(is_adult, people)), Cons("ada", Cons("bob", Nil))),
    check_eq("list_filter is the concrete List form",
      list_filter(is_even, ints), Cons(2, Cons(4, Nil))),

    # --- Vec: the new instance, and the container is PRESERVED ---------------
    check_eq("filter over Vec keeps matches in order",
      filter(is_even, ints_vec), vec_from_list(Cons(2, Cons(4, Nil)))),
    check_eq("filter over Vec agrees with vec_filter",
      filter(is_positive, ints_vec), vec_filter(is_positive, ints_vec)),
    check_eq("filter over Vec preserves length",
      vec_length(filter(always, ints_vec)), 5),

    # --- Edges: empty in, everything kept, everything dropped ----------------
    check_eq("filter of the empty list", filter(is_even, nil_int()), nil_int()),
    check_eq("filter of the empty vec", filter(is_even, empty_vec_int()), empty_vec_int()),
    check_eq("a predicate that always holds is the identity", filter(always, ints), ints),
    check_eq("a predicate that never holds empties the list", filter(never, ints), nil_int()),
    check_eq("a predicate that never holds empties the vec",
      filter(never, ints_vec), empty_vec_int()),

    # --- Laws ----------------------------------------------------------------
    # filter p . filter q == filter (\x -> p x && q x): two passes see the same
    # elements one combined pass does, which is what "order preserving and
    # stateless" amounts to.
    check_eq("filter composes as predicate conjunction",
      filter(is_even, filter(is_positive, ints)),
      filter(\n -> is_even(n) && is_positive(n), ints)),

    # --- Dictionary forwarding through a constrained caller ------------------
    check_eq("forwarded filter over List", keep(is_even, ints), Cons(2, Cons(4, Nil))),
    check_eq("forwarded filter over Vec",
      keep(is_even, ints_vec), vec_from_list(Cons(2, Cons(4, Nil)))),
    check_eq("forwarded filter of empty", keep(is_even, nil_int()), nil_int()),
    check_eq("Filterable and Functor forwarded together over List",
      evens_doubled(ints), Cons(4, Cons(8, Nil))),
    check_eq("Filterable and Functor forwarded together over Vec",
      evens_doubled(ints_vec), vec_from_list(Cons(4, Cons(8, Nil))))
  ])
