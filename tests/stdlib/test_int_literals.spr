import stdlib.test (TestState, new_state, assert_eq, assert_true, summary)
import stdlib.bits

# Hex (`0x`) and binary (`0b`) integer literals.
#
# WHY THEY WERE ADDED. The lexer scanned decimal digit runs only, so every mask
# had to be written in base 10 with its hex spelling relegated to a comment —
# `tests/stdlib/test_double_bits.spr` still shows what that costs. A bitwise API
# whose masks are unwritable in hex undercuts its own expressibility, so these
# landed alongside stdlib.bits (docs/bitwise-int-ops-v0.md §5.5).
#
# WHAT IS DELIBERATELY NOT HERE. A `_` digit separator (`1_000_000`): `_` is an
# identifier-start character, so `1_000` currently lexes as the int `1` followed
# by the identifier `_000`, and changing that is a lexer decision of its own
# rather than part of this one.
#
# The literal's SOURCE SPELLING survives into the token, which is what lets
# `just fmt` reprint `0xFF` as `0xFF` rather than 255. `just fmt-check` in CI is
# the real guard on that; this file pins the values.

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # --- hex, and the fact that it means the same thing as decimal ---
    assert_eq(state, "0x0 is 0", 0x0, 0)
    assert_eq(state, "0xFF is 255", 0xFF, 255)
    assert_eq(state, "hex is case-insensitive in its digits", 0xff, 0xFF)
    assert_eq(state, "hex is case-insensitive in its prefix", 0Xff, 0xFF)
    assert_eq(state, "0xDEADBEEF", 0xDEADBEEF, 3735928559)
    assert_eq(state, "0x7FFFFFFFFFFFFFFF is the largest Int", 0x7FFFFFFFFFFFFFFF,
      9223372036854775807)

    # The IEEE 754 constants that motivated this, now readable. Compare
    # test_double_bits.spr, where the same values appear as bare decimals.
    assert_eq(state, "2^52, one unit in the exponent field",
      0x0010000000000000, 4503599627370496)
    assert_eq(state, "the encoding of 1.0", 0x3FF0000000000000,
      4607182418800017408)

    # --- binary ---
    assert_eq(state, "0b0 is 0", 0b0, 0)
    assert_eq(state, "0b1010 is 10", 0b1010, 10)
    assert_eq(state, "0b11111111 is 255", 0b11111111, 0xFF)
    assert_eq(state, "binary prefix is case-insensitive", 0B1010, 0b1010)

    # --- they compose with everything, being ordinary Int literals ---
    assert_eq(state, "hex in arithmetic", 0x10 + 0x20, 48)
    assert_eq(state, "hex as a bitwise mask", bit_and(0xDEAD, 0x00FF), 0xAD)
    assert_eq(state, "hex as a shift count", bit_shl(1, 0x3F),
      -9223372036854775808)
    assert_eq(state, "binary reads as a bit pattern",
      bit_or(0b1010, 0b0101), 0b1111)

    # --- in a pattern position, not just an expression ---
    assert_eq(state, "hex literal as a match pattern", classify(0xFF), 1)
    assert_eq(state, "binary literal as a match pattern", classify(0b10), 2)
    assert_eq(state, "no pattern matched", classify(7), 0)

    # --- hex/binary denote a 64-bit pattern; decimal literals are range-checked
    # (bigint-v0 Stage 1, docs/bigint-v0.md §5.3) ---
    # Radix literals are NEVER rejected: every 64-bit pattern is writable, so an
    # all-ones mask can be spelled 0xFFFFFFFFFFFFFFFF rather than -1. A decimal
    # literal, by contrast, denotes a mathematical value and is a compile-time
    # error if it does not fit in Int — EXCEPT directly after unary minus, where
    # it is range-checked against [-2^63, 2^63-1] rather than [0, 2^63-1], so
    # -9223372036854775808 (INT_MIN) stays valid (mirrors Rust and Java). What
    # used to be asserted here — a bare over-range decimal literal wrapping —
    # no longer compiles at all; its replacement is the negative fixture
    # tests/conformance/parse_error/int_literal_overflow.spr. Design note:
    # docs/bitwise-int-ops-v0.md §5.6, docs/bigint-v0.md §5.3.
    assert_eq(state, "0x8000000000000000 is INT_MIN", 0x8000000000000000,
      -9223372036854775808)
    assert_eq(state, "0xFFFFFFFFFFFFFFFF is all ones, i.e. -1",
      0xFFFFFFFFFFFFFFFF, -1)
    assert_eq(state, "an all-ones mask leaves a value unchanged",
      bit_and(48350, 0xFFFFFFFFFFFFFFFF), 48350)
    # Compared against the arithmetic route, NOT against 0x8000000000000000:
    # the first assertion above already equates that hex literal with this
    # decimal one, so repeating the pair reversed would add no coverage.
    assert_eq(state,
      "decimal INT_MIN survives as the direct operand of unary minus (the carve-out)",
      -9223372036854775808, 0 - 9223372036854775807 - 1)
    assert_eq(state, "the sign-bit mask agrees with the complement route",
      0x8000000000000000, bit_not(bit_shr_zf(bit_not(0), 1)))

    # The carve-out matches the TOKEN after `-`, so layout between the two is
    # invisible to it — the lexer has already dropped it. Rust and Java accept the
    # spaced form for the same reason (each matches the parsed operand of unary
    # minus, not source adjacency). Nothing pinned this before and the spec
    # sentence claimed the opposite; docs/spec-v0.md §2 and docs/bigint-v0.md §5.3
    # now say "the next token".
    #
    # A LINE BREAK, not a space: `just fmt` reprints `- 9223372036854775808`
    # without the space, so a spaced assertion silently decays into a copy of the
    # one above. That the formatter deletes the space is itself the point — it too
    # treats the gap as insignificant.
    assert_eq(state, "the carve-out sees through a line break after the minus",
      -
      9223372036854775808, 0 - 9223372036854775807 - 1)

    # --- a prefix with no digits is NOT a radix literal ---
    # `0x` alone falls back to the decimal 0 plus an identifier, which is a parse
    # error in any expression — so there is no silent misreading to test for here,
    # only the fact that a lone 0 still lexes normally next to identifiers.
    assert_eq(state, "a bare 0 still lexes as 0", 0, 0)
    assert_true(state, "0x0 and 0 are the same value", 0x0 == 0)

    summary(state)

fn classify(n: Int) -> Int =
  match n with
  | 0xFF -> 1
  | 0b10 -> 2
  | _ -> 0
