import stdlib.test (check_eq, run_suite)

fn add_idx(acc: Int, i: Int, x: Int) -> Int =
  acc + (i * x)

fn main() -> Unit !{IO} =
  run_suite("native_fold_indexed", [
    check_eq(
      "fold_indexed propagates accumulator updates",
      fold_indexed(add_idx, 0, Cons(10, Cons(20, Cons(30, Nil)))),
      80
    )
  ])
