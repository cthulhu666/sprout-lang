import stdlib.test (check_true, run_suite)
import stdlib.math (pi, abs, floor, sqrt, pow, sin, cos, tan, radians, clamp, lerp, nan, is_nan, atan, atan2, asin, acos)

# TDD — the Double math primitives that back the M2 vector/matrix layer.
# All implemented in PURE Sprout — no C builtins:
# sqrt via Newton-Raphson, sin/cos via range reduction + Taylor series, floor
# via the 2^52 magic-number trick. RED until the real implementations land.

# Local approximate equality — Double `==` is exact, useless for transcendentals.
fn dabs(x: Double) -> Double = if x < 0.0 then -x else x
fn close(a: Double, b: Double) -> Bool = dabs(a - b) < 0.000001

# Relative comparison, for values whose magnitude makes an absolute epsilon meaningless.
fn rel_close(a: Double, b: Double) -> Bool = dabs(a - b) / dabs(b) < 0.000000000001

# 10^n (valid to n = 308) and 2^-n (exact at every step, down to 2^-1074).
fn p10(n: Int) -> Double = if n <= 0 then 1.0 else 10.0 * p10(n - 1)
fn halves(n: Int) -> Double = if n <= 0 then 1.0 else 0.5 * halves(n - 1)

# Counts inputs where asin/acos escape the range POSIX guarantees them — [-pi/2, pi/2] and
# [0, pi]. The point assertions below cannot establish this, and the defect it exists to
# catch was invisible to `close`: the unbranched half-angle form overshoots pi/2 by one ulp
# at x = 1, which is a NEGATIVE acos. Sweeps i = 0..n over x = -1 + 2i/n, so both endpoints
# are sampled exactly.
fn range_violations(i: Int, n: Int, acc: Int) -> Int =
  if i > n then acc
  else range_violations(i + 1, n, acc + bad)
where
  x = 2.0 * to_double(i) / to_double(n) - 1.0
  a = asin(x)
  c = acos(x)
  bad = if (a < 0.0 - pi / 2.0) || (a > pi / 2.0) || (c < 0.0) || (c > pi) then 1 else 0

fn main() -> Unit !{IO} =
  run_suite("math_double", [
    # --- abs (the Double abs; the Int one is stdlib.math.int.abs) ---
    check_true("abs(-2.5) == 2.5", abs(-2.5) == 2.5),
    check_true("abs(2.5) == 2.5", abs(2.5) == 2.5),
    # REGRESSION: the guard was `x < 0.0`, which is FALSE for -0.0, so abs(-0.0) returned
    # -0.0. IEEE-754 abs (and C fabs, whose name this function now carries) must clear the
    # sign bit unconditionally. Detected via the reciprocal, since -0.0 == 0.0 is true.
    check_true("abs(-0.0) is +0.0", 1.0 / abs(-0.0) == (1.0 / 0.0)),
    check_true("abs(0.0) is +0.0", 1.0 / abs(0.0) == (1.0 / 0.0)),
    check_true("abs(NaN) is NaN", is_nan(abs(nan))),
    # --- floor (incl. negatives, where round-toward-zero would differ) ---
    check_true("floor(3.7) == 3.0", floor(3.7) == 3.0),
    check_true("floor(5.0) == 5.0", floor(5.0) == 5.0),
    check_true("floor(-1.2) == -2.0", floor(-1.2) == -2.0),
    # regression: negative fractionals whose nearest 0.5-grid point is a half-integer
    # (round_nearest magic-number bug — the value's frac part in ~(0.25, 0.75))
    check_true("floor(-0.3) == -1.0", floor(-0.3) == -1.0),
    check_true("floor(-0.5) == -1.0", floor(-0.5) == -1.0),
    check_true("floor(-0.7) == -1.0", floor(-0.7) == -1.0),
    check_true("floor(-2.4) == -3.0", floor(-2.4) == -3.0),
    check_true("floor(-2.6) == -3.0", floor(-2.6) == -3.0),
    # Mirror-image of the abs defect: the 2^52 magic-number round sends -0.0 through the
    # positive path, so floor(-0.0) returned +0.0 where IEEE requires -0.0 (floor
    # preserves the sign of a zero argument).
    check_true("floor(-0.0) is -0.0", 1.0 / floor(-0.0) == (0.0 - 1.0 / 0.0)),
    check_true("floor(0.0) is +0.0", 1.0 / floor(0.0) == (1.0 / 0.0)),
    # --- sqrt (Newton-Raphson) ---
    check_true("sqrt(0.0) == 0.0", sqrt(0.0) == 0.0),
    # Out-of-domain (x < 0) is IEEE NaN, not the old silent 0.0 lie
    # (Rule 2, docs/math-partiality-v0.md). Regression guard.
    check_true("sqrt(-4.0) is NaN", is_nan(sqrt(-4.0))),
    check_true("sqrt(-0.001) is NaN", is_nan(sqrt(-0.001))),
    check_true("exported nan is NaN", is_nan(nan)),
    # In-domain edge cases still follow IEEE: +inf is its own root (Newton would
    # compute inf/inf = NaN), and -0.0 keeps its sign (1.0 / -0.0 == -inf < 0).
    check_true("sqrt(+inf) == +inf", sqrt(1.0 / 0.0) == (1.0 / 0.0)),
    check_true("sqrt(-0.0) keeps the sign", 1.0 / sqrt(-0.0) < 0.0),
    check_true("sqrt(1.0) == 1.0", close(sqrt(1.0), 1.0)),
    check_true("sqrt(16.0) == 4.0", close(sqrt(16.0), 4.0)),
    check_true("sqrt(2.0) ~ 1.41421356", close(sqrt(2.0), 1.4142135623)),
    check_true("sqrt(1e6) == 1000.0", close(sqrt(1000000.0), 1000.0)),
    # REGRESSION: sqrt was seeded with `x` itself and capped at 60 Newton steps. Newton
    # only roughly HALVES a guess that starts far above the root, so above ~1e35 the cap
    # was hit long before convergence and an unconverged guess was returned silently —
    # sqrt(1e40) gave 8.674e21 instead of 1e20. The fix is an exact power-of-four range
    # reduction, so these must now hold across the whole exponent range.
    check_true("sqrt(1e40) == 1e20", rel_close(sqrt(p10(40)), p10(20))),
    check_true("sqrt(1e60) == 1e30", rel_close(sqrt(p10(60)), p10(30))),
    check_true("sqrt(1e100) == 1e50", rel_close(sqrt(p10(100)), p10(50))),
    check_true("sqrt(1e200) == 1e100", rel_close(sqrt(p10(200)), p10(100))),
    check_true("sqrt(1e300) == 1e150", rel_close(sqrt(p10(300)), p10(150))),
    check_true("sqrt(1e-100) == 1e-50", rel_close(sqrt(1.0 / p10(100)), 1.0 / p10(50))),
    check_true("sqrt(1e-300) == 1e-150", rel_close(sqrt(1.0 / p10(300)), 1.0 / p10(150))),
    # Subnormal input: 2^-1070 is exact, so its root is exactly 2^-535.
    check_true("sqrt(2^-1070) == 2^-535", rel_close(sqrt(halves(1070)), halves(535))),
    # Exact powers of four must come back exactly, not merely close.
    check_true("sqrt(2^512) == 2^256 exactly", sqrt(1.0 / halves(512)) == 1.0 / halves(256)),
    # Self-consistency with the exp/ln path, which was already correct at these
    # magnitudes and so made the sqrt defect visible inside one module.
    check_true("sqrt agrees with pow(x,0.5) at 1e100",
      rel_close(sqrt(p10(100)), pow(p10(100), 0.5))),
    # --- pi ---
    check_true("pi ~ 3.14159265", close(pi, 3.14159265)),
    # --- sin / cos (range reduction + Taylor) ---
    check_true("sin(0) == 0", close(sin(0.0), 0.0)),
    check_true("sin(pi/2) == 1", close(sin(pi / 2.0), 1.0)),
    check_true("sin(pi) == 0", close(sin(pi), 0.0)),
    check_true("cos(0) == 1", close(cos(0.0), 1.0)),
    check_true("cos(pi/2) == 0", close(cos(pi / 2.0), 0.0)),
    check_true("cos(pi) == -1", close(cos(pi), -1.0)),
    # identity check at an arbitrary angle: sin^2 + cos^2 == 1
    check_true("sin^2+cos^2 == 1 @ 2.3",
      close(sin(2.3) * sin(2.3) + cos(2.3) * cos(2.3), 1.0)),
    # range reduction: large angle wraps correctly (sin(2pi + pi/6) == 0.5)
    check_true("sin(2pi + pi/6) == 0.5",
      close(sin(2.0 * pi + pi / 6.0), 0.5)),
    # --- radians (deg -> rad) ---
    check_true("radians(180) == pi", close(radians(180.0), pi)),
    check_true("radians(90) == pi/2", close(radians(90.0), pi / 2.0)),
    check_true("radians(0) == 0", close(radians(0.0), 0.0)),
    # --- tan = sin/cos ---
    check_true("tan(0) == 0", close(tan(0.0), 0.0)),
    check_true("tan(pi/4) == 1", close(tan(pi / 4.0), 1.0)),
    check_true("tan(radians(45)) == 1", close(tan(radians(45.0)), 1.0)),
    # Rule 2: tan blows up at the pole (odd multiples of pi/2). Pins the
    # documented out-of-domain behavior so a sin/cos change can't silently break it.
    check_true("tan(pi/2) blows up (pole)", abs(tan(pi / 2.0)) > 1000.0),
    # --- clamp (the Double clamp; the Int one is stdlib.math.int.clamp) ---
    check_true("clamp below -> lo", clamp(-1.0, 0.0, 10.0) == 0.0),
    check_true("clamp within -> x", clamp(5.0, 0.0, 10.0) == 5.0),
    check_true("clamp above -> hi", clamp(12.5, 0.0, 10.0) == 10.0),
    check_true("clamp at lo edge", clamp(0.0, 0.0, 10.0) == 0.0),
    check_true("clamp at hi edge", clamp(10.0, 0.0, 10.0) == 10.0),
    # --- lerp (Double-only; exact at these binary-representable points) ---
    check_true("lerp t=0 -> a", lerp(2.0, 8.0, 0.0) == 2.0),
    check_true("lerp t=1 -> b", lerp(2.0, 8.0, 1.0) == 8.0),
    check_true("lerp t=0.5 -> mid", lerp(2.0, 8.0, 0.5) == 5.0),
    check_true("lerp extrapolates t=2", lerp(2.0, 8.0, 2.0) == 14.0),
    check_true("lerp negative t", lerp(0.0, 10.0, -0.5) == -5.0),
    # --- atan (pure; accurate on and beyond [-1,1] via halving reduction) ---
    check_true("atan(0) == 0", close(atan(0.0), 0.0)),
    check_true("atan(1) == pi/4", close(atan(1.0), pi / 4.0)),
    check_true("atan(-1) == -pi/4", close(atan(0.0 - 1.0), 0.0 - pi / 4.0)),
    check_true("atan(odd) matches tan inverse", close(atan(tan(0.6)), 0.6)),
    # atan(x)+atan(1/x)==pi/2 for x>0 — exercises large-argument handling without the
    # common wrong assumption that atan(1000)~pi/2 (it is pi/2 - atan(1/1000) ~ 0.001 off).
    check_true("atan(1000)+atan(1/1000) == pi/2",
      close(atan(1000.0) + atan(1.0 / 1000.0), pi / 2.0)),
    # --- atan2 (full-circle bearing; quadrant-correct) ---
    check_true("atan2(0,1) == 0", close(atan2(0.0, 1.0), 0.0)),
    check_true("atan2(1,0) == pi/2", close(atan2(1.0, 0.0), pi / 2.0)),
    check_true("atan2(0,-1) == pi", close(atan2(0.0, 0.0 - 1.0), pi)),
    check_true("atan2(-1,0) == -pi/2", close(atan2(0.0 - 1.0, 0.0), 0.0 - pi / 2.0)),
    check_true("atan2(1,1) == pi/4", close(atan2(1.0, 1.0), pi / 4.0)),
    check_true("atan2(1,-1) == 3pi/4", close(atan2(1.0, 0.0 - 1.0), 3.0 * pi / 4.0)),
    check_true("atan2(-1,-1) == -3pi/4", close(atan2(0.0 - 1.0, 0.0 - 1.0), 0.0 - 3.0 * pi / 4.0)),
    check_true("atan2(-1,1) == -pi/4", close(atan2(0.0 - 1.0, 1.0), 0.0 - pi / 4.0)),
    check_true("atan2(0,0) == 0 (defined)", close(atan2(0.0, 0.0), 0.0)),
    check_true("atan2 odd symmetry", close(atan2(0.0 - 0.7, 0.4), 0.0 - atan2(0.7, 0.4))),
    # --- asin / acos (half-angle form over atan; range [-pi/2,pi/2] and [0,pi]) ---
    check_true("asin(0) == 0", close(asin(0.0), 0.0)),
    check_true("asin(0.5) == pi/6", close(asin(0.5), pi / 6.0)),
    check_true("asin(1) == pi/2", close(asin(1.0), pi / 2.0)),
    check_true("asin(-1) == -pi/2", close(asin(0.0 - 1.0), 0.0 - pi / 2.0)),
    check_true("asin odd symmetry", close(asin(0.0 - 0.3), 0.0 - asin(0.3))),
    check_true("asin(sin(x)) == x on the principal branch", close(asin(sin(0.6)), 0.6)),
    check_true("acos(1) == 0", close(acos(1.0), 0.0)),
    check_true("acos(0) == pi/2", close(acos(0.0), pi / 2.0)),
    check_true("acos(0.5) == pi/3", close(acos(0.5), pi / 3.0)),
    check_true("acos(-1) == pi", close(acos(0.0 - 1.0), pi)),
    check_true("acos(cos(x)) == x on the principal branch", close(acos(cos(2.0)), 2.0)),
    check_true("asin + acos == pi/2", close(asin(0.42) + acos(0.42), pi / 2.0)),
    # Rule 2 (docs/math-partiality-v0.md): |x| > 1 is out of domain -> NaN, never a
    # clamped edge value. The naive `atan2(x, sqrt(1-x*x))` form would return pi/2 here:
    # sqrt of a negative is NaN, and atan2's cascade falls through both NaN-false
    # comparisons on x into its `y > 0.0` arm. Regression guard against that rewrite.
    check_true("asin(2) is NaN", is_nan(asin(2.0))),
    check_true("asin(-2) is NaN", is_nan(asin(0.0 - 2.0))),
    check_true("acos(2) is NaN", is_nan(acos(2.0))),
    check_true("acos(-2) is NaN", is_nan(acos(0.0 - 2.0))),
    check_true("asin(NaN) is NaN", is_nan(asin(nan))),
    check_true("acos(NaN) is NaN", is_nan(acos(nan))),
    # RANGE GUARANTEE at the endpoints, where `close` is far too loose to see the defect.
    # The bare half-angle form computes 2*atan(1) = 1.5707963267948974 — one ulp ABOVE pi/2 —
    # so acos(1.0) came out as -8.9e-16, a negative angle. Every `acos(dot(u, v))` caller on
    # unit vectors hits exactly 1.0 for parallel inputs, so this is the common case, not a
    # corner. Exactness is asserted with `==`, and the sign of the zero via its reciprocal
    # (-0.0 == 0.0 is true, so a plain comparison cannot distinguish them).
    check_true("asin(1) is exactly pi/2", asin(1.0) == pi / 2.0),
    check_true("asin(-1) is exactly -pi/2", asin(0.0 - 1.0) == 0.0 - pi / 2.0),
    check_true("acos(1) is exactly +0.0", 1.0 / acos(1.0) == (1.0 / 0.0)),
    check_true("acos(-1) is exactly pi", acos(0.0 - 1.0) == pi),
    check_true("acos(0) is exactly pi/2", acos(0.0) == pi / 2.0),
    # One ulp inside the domain the general path resumes, and must stay in range: acos leaves
    # 1.0 like sqrt(2*eps), so the true value is ~1.5e-8 here, well clear of the error floor.
    check_true("acos just inside 1 stays positive", acos(1.0 - 0.0000000000000002) > 0.0),
    check_true("asin just inside 1 stays under pi/2", asin(1.0 - 0.0000000000000002) < pi / 2.0),
    # POSIX asin(3): asin(+-0) is +-0, i.e. asin preserves the sign of a zero argument.
    # Same reciprocal trick as the abs/floor signed-zero guards above.
    check_true("asin(0.0) is +0.0", 1.0 / asin(0.0) == (1.0 / 0.0)),
    check_true("asin(-0.0) is -0.0", 1.0 / asin(-0.0) == (0.0 - 1.0 / 0.0)),
    # The range guarantee as a sweep rather than a handful of points. 20001 samples of
    # [-1, 1], endpoints included; without the endpoint branch in asin this reports 1.
    check_true("asin/acos stay in range across [-1,1]", range_violations(0, 20000, 0) == 0),
    # RELATIVE accuracy as x -> 1, where acos(x) -> 0 and an absolute epsilon is blind.
    # `pi/2 - asin(x)` subtracts two nearly-equal numbers, so its ~1.6e-15 absolute error
    # lands on a result of ~2e-8: eight significant digits gone. The half-angle branch
    # avoids the cancellation entirely — `1 - x` is EXACT for x in [0.5, 2] by Sterbenz,
    # which is precisely why the branch threshold is 0.5 and not a tuned constant.
    # Oracle is libm's acos(1 - 2^-52); Sprout has no exponent literals, hence `/ p10(8)`.
    check_true("acos keeps relative accuracy as x -> 1",
      rel_close(acos(1.0 - halves(52)), 2.1073424255447017 / p10(8))),
    check_true("acos relative accuracy holds mid-way too",
      rel_close(acos(1.0 - halves(40)), 1.3486991523487112 / p10(6)))
  ])
