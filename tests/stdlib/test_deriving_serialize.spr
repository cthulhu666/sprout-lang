import stdlib.test (TestState, new_state, assert_eq, summary)

# `deriving (Serialize)` synthesizes an instance that renders the value as an
# S-expression: `(CtorName field0_ser field1_ser ...)`.
#   Nullary ctor C   -> "(C)"
#   N-field ctor C   -> "(C " ++ serialize(f0) ++ " " ++ ... ++ serialize(fN-1) ++ ")"

type Color (..) deriving(Serialize) =
  | Red
  | Green
  | Blue

type Box a (..) deriving(Serialize) =
  | Empty
  | Hold a

type Pair a b (..) deriving(Serialize) =
  | Pair a b

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    # Nullary cases.
    assert_eq(state, "serialize Red", serialize(Red), "(Red)")
    assert_eq(state, "serialize Green", serialize(Green), "(Green)")
    assert_eq(state, "serialize Blue", serialize(Blue), "(Blue)")
    # Parametric, nullary ctor.
    assert_eq(state, "serialize Empty", serialize(Empty), "(Empty)")
    # Parametric, single-field — uses Serialize Int.
    assert_eq(state, "serialize Hold 42", serialize(Hold(42)), "(Hold 42)")
    # Two-field ctor.
    assert_eq(state, "serialize Pair 1 true", serialize(Pair(1, true)), "(Pair 1 true)")
    summary(state)
