# Regression: the REPL / analysis-service eval path must link the WHOLE runtime,
# not just runtime/sprout_runtime.c.  sprout_runtime.c's tcp_* functions call
# scheduler_park_on_fd, which is defined in the sibling TU sprout_scheduler.c.
# Object files link wholesale, so linking runtime/sprout_runtime.o alone leaves
# scheduler_park_on_fd undefined and the eval link fails — which is exactly the
# bug this guards.  Because the reference is IR-independent, a trivial
# `define i64 @main` IR is enough to reproduce it: it links cleanly only when
# every runtime .c is compiled in.
#
# This test LINKS (it does not string-match a command): unfixed driver -> Err
# carrying "Undefined symbols" / scheduler_park_on_fd -> RED; fixed -> Ok -> GREEN.
import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.compiler.analysis_service_driver as service
import stdlib.terminal as terminal
import stdlib.fs as fs
import stdlib.string as string
import testsupport.toolchain (clang_available, is_darwin)

let trivial_main_ir: String =
  "define i64 @main() {\nentry:\n  ret i64 0\n}\n"

fn copy_text(from: String, to: String) -> Bool !{IO} =
  match fs.read_text(from) with
  | Err _ -> false
  | Ok text -> is_ok(fs.write_text(to, text))

fn copy_runtime_file(state: TestState, rt_dir: String, name: String) -> Unit !{IO} =
  assert_true(state, "copy runtime/" ++ name, copy_text("runtime/" ++ name, rt_dir ++ "/" ++ name))

# A runtime dir with a stray `._sprout_runtime.c` (not C, as macOS leaves beside a file): the
# eval path skips names that start with '.', so the link still succeeds and makes no object for it.
fn dotfile_case(state: TestState, use_darwin: Bool) -> Unit !{IO} =
  match fs.make_temp_dir("sprout-eval-dot-") with
  | Err e -> assert_true(state, "make a temp dir (" ++ fs.fs_error_message(e) ++ ")", false)
  | Ok dir ->
      do
        let rt_dir = dir ++ "/runtime"
        let objs_dir = dir ++ "/objs"
        objs_ref <- ref_new(false)
        assert_true(state, "make the runtime copy dir", is_ok(fs.make_dir_all(rt_dir)))
        match fs.list_dir("runtime") with
        | Err _ -> assert_true(state, "list runtime/", false)
        | Ok names ->
            list_each(\n -> copy_runtime_file(state, rt_dir, n),
                      list_filter(\n -> string.ends_with(n, ".c") || string.ends_with(n, ".h"), names))
        assert_true(state, "write the stray file", is_ok(fs.write_text(rt_dir ++ "/._sprout_runtime.c", "this is not C\n")))
        assert_true(state, "write the IR", is_ok(fs.write_text(dir ++ "/eval.ll", trivial_main_ir)))
        match service.compile_runtime_and_link_eval(
          rt_dir, dir ++ "/eval.ll", dir ++ "/eval_bin", objs_dir, objs_ref, use_darwin) with
        | Ok _ -> assert_true(state, "a dot-prefixed .c file is not compiled", !fs.exists(objs_dir ++ "/._sprout_runtime.o"))
        | Err emsg ->
            do
              terminal.write("[test_repl_eval_link] link failed:\n" ++ emsg ++ "\n")
              assert_true(state, "a dot-prefixed .c file is not compiled", false)
        assert_true(state, "the temp dir is removed", is_ok(fs.remove_dir_all(dir)))

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    have_clang <- clang_available()
    match have_clang with
    | false ->
        do
          terminal.write("[test_repl_eval_link] clang not in PATH — assertion auto-passes\n")
          assert_true(state, "runtime links as a whole (auto-skipped: no clang)", true)
    | true ->
        match fs.make_temp_dir("sprout-eval-link-") with
        | Err e -> assert_true(state, "make a temp dir (" ++ fs.fs_error_message(e) ++ ")", false)
        | Ok dir ->
            do
              let ir_path = dir ++ "/eval.ll"
              let bin_path = dir ++ "/eval_bin"
              let objs_dir = dir ++ "/objs"
              use_darwin <- is_darwin()
              objs_ref <- ref_new(false)
              match fs.write_text(ir_path, trivial_main_ir) with
              | Err msg -> assert_true(state, "write trivial IR", false)
              | Ok _ ->
                  # CWD is the repo root under `just test`, so "runtime" resolves.
                  # Match the IO-Result action directly: a `<-` do-bind would strip
                  # the Result wrapper (do-block Result-unwrap quirk).
                  match service.compile_runtime_and_link_eval(
                    "runtime", ir_path, bin_path, objs_dir, objs_ref, use_darwin) with
                  | Ok _ ->
                      assert_true(state, "eval path links the whole runtime (scheduler_park_on_fd resolves)", true)
                  | Err emsg ->
                      do
                        terminal.write("[test_repl_eval_link] link failed:\n")
                        terminal.write(emsg)
                        terminal.write("\n")
                        assert_true(state, "eval path links the whole runtime (scheduler_park_on_fd resolves)", false)
              assert_true(state, "the temp dir is removed", is_ok(fs.remove_dir_all(dir)))
              dotfile_case(state, use_darwin)

    summary(state)
