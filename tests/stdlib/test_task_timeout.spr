import stdlib.test (TestState, new_state, assert_true, assert_eq, summary)
import stdlib.task as task
import stdlib.chan as chan
import stdlib.string as string

# L0.7 deadlines (EXPERIMENTAL). with_timeout(ms, body) runs `body` as a child green task and
# returns Completed(result) if it finishes within ~ms, else Expired — the child is force-
# dropped. Delivery is cooperative + scheduler-drop (no exceptions), like Go/Kotlin/Trio.
# MVP boundary: the body must park DIRECTLY on I/O / task_sleep; a body blocked in a nested
# with_scope join loud-fails (deadline cascade deferred). These cases stay within that MVP.

# Completes instantly, well within a generous deadline -> Completed(42).
fn fast() -> Int !{IO} = 42

# Parks on a long sleep; the 20ms deadline must fire first and DROP it. Appends "!" to the log
# ONLY if it runs to completion — so a broken drop (child not dropped) leaves "!" behind and
# the assertion below fails with the wrong marker instead of the empty string.
fn slow(log: Ref String) -> Int !{IO} =
  do
    task.task_sleep(2000)
    ref_write(log, string.concat(ref_read(log), "!"))
    99

fn is_completed_42(r: task.TimeoutResult Int) -> Bool =
  match r with
  | task.Completed (v) -> v == 42
  | task.Expired -> false

fn is_expired(r: task.TimeoutResult Int) -> Bool =
  match r with
  | task.Completed (v) -> false
  | task.Expired -> true

# A completed child's COMPUTED result (not a literal 42) must round-trip through
# fork/await unchanged. Regression guard for the run_with_deadline do-tail: the
# final `outcome <- await_and_finish(...)` binding was collapsed to a bare
# tail call, and this pins that the child's payload is still delivered intact.
fn fast_compute() -> Int !{IO} = 100 + 23

fn is_completed(r: task.TimeoutResult Int, expected: Int) -> Bool =
  match r with
  | task.Completed (v) -> v == expected
  | task.Expired -> false

# Parks, WAKES, then parks again — the shape that used to hang. When the deadline landed in the
# same poll batch as the first park's wake, __await_deadline classified the body as `in_rq`, read
# that as "one tick from done", and re-awaited it with its timer already spent; the body then
# parked on the second sleep and with_timeout never returned. The classification is now a loop
# that yields and re-reads, so the second park is seen as a park and dropped.
#
# This cannot reproduce the race itself — that needs the deadline and a readiness event in one poll
# batch, timer first, which no test can schedule (the source invariant is pinned in
# tests/c_runtime/run.sh instead). What it does pin is the property the fix must preserve on the
# path that IS reachable: a body which makes progress and then re-parks still expires, and is still
# dropped before its post-park side effect.
fn wake_then_park(log: Ref String) -> Int !{IO} =
  do
    task.task_sleep(1)
    ref_write(log, string.concat(ref_read(log), "w"))
    task.task_sleep(2000)
    ref_write(log, string.concat(ref_read(log), "!"))
    99

# Parked in chan_recv on a channel no one ever sends to (PARK_CHAN, not the poller). Distinct
# branch of the same classification loop from the task_sleep cases above, which land on
# g_io_head; this one is force-dropped off the channel's wait queue instead.
fn recv_forever(ch: chan.Chan Int, log: Ref String) -> Int !{IO} =
  match chan.chan_recv(ch) with
  | chan.Got (v) -> after_recv(log)
  | chan.Closed -> after_recv(log)

# Parked in chan_select on channels no one ever sends to (PARK_SELECT). A select registers the
# parked task on EVERY channel it lists, so its force-drop unlinks all of them at once — a
# different branch from the PARK_CHAN case above, which removes the task from one wait queue.
# Two channels, because a drop that unlinked only the first would leave the second holding a
# registration that points at a freed task.
fn select_forever(cs: List (chan.Chan Int), log: Ref String) -> Int !{IO} =
  match chan.chan_select(cs) with
  | (_, _) -> after_recv(log)

# Only reachable if the recv/select above ever returns, which under this test's deadline it must not.
fn after_recv(log: Ref String) -> Int !{IO} =
  do
    ref_write(log, string.concat(ref_read(log), "!"))
    77

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    # 1. fast body completes within the deadline -> Completed(42) (no ~10s wait: it finishes at once).
    let r1 = task.with_timeout(10000, \_ -> fast())
    assert_true(state, "fast body completes within deadline", is_completed_42(r1))
    # 1b. a completed child's computed result round-trips intact (guards the do-tail collapse).
    let r1b = task.with_timeout(10000, \_ -> fast_compute())
    assert_true(state, "completed child's computed result round-trips (123)", is_completed(r1b, 123))
    # 2. slow body overruns the 20ms deadline -> Expired; the dropped body's "!" is absent.
    log <- ref_new("")
    let r2 = task.with_timeout(20, \_ -> slow(log))
    assert_true(state, "slow body times out", is_expired(r2))
    assert_eq(state, "timed-out body dropped before its side effect", ref_read(log), "")
    # 3. ms <= 0 -> immediate Expired; the body is never forked or run.
    zlog <- ref_new("")
    let r3 = task.with_timeout(0, \_ -> slow(zlog))
    assert_true(state, "zero-ms deadline expires immediately", is_expired(r3))
    assert_eq(state, "zero-ms body never ran", ref_read(zlog), "")
    # 4. a body that parks, wakes, and parks AGAIN still expires — it must not be re-awaited without
    #    a deadline once it has been classified as runnable. "w" proves it really did wake and make
    #    progress; the absent "!" proves the second park was dropped rather than waited on.
    wlog <- ref_new("")
    let r4 = task.with_timeout(30, \_ -> wake_then_park(wlog))
    assert_true(state, "body that re-parks after waking still times out", is_expired(r4))
    assert_eq(state, "re-parking body woke once, then was dropped", ref_read(wlog), "w")
    # 5. a body parked on a channel (PARK_CHAN) is force-dropped off the wait queue, not the poller.
    clog <- ref_new("")
    let r5 = chan_recv_timeout(clog)
    assert_true(state, "channel-parked body times out", is_expired(r5))
    assert_eq(state, "channel-parked body dropped before its side effect", ref_read(clog), "")
    # 6. a body parked in chan_select (PARK_SELECT) is unlinked from EVERY channel it registered on,
    #    not just the first — the multi-registration force-drop branch.
    slog <- ref_new("")
    let r6 = select_timeout(slog)
    assert_true(state, "select-parked body times out", is_expired(r6))
    assert_eq(state, "select-parked body dropped before its side effect", ref_read(slog), "")
    summary(state)

# The channel must outlive the with_timeout call, so it belongs to an enclosing scope — the body
# parks on an ANCESTOR scope's channel, which is exactly the case the force-drop walk has to handle.
fn chan_recv_timeout(log: Ref String) -> task.TimeoutResult Int !{IO} =
  task.with_scope(\s -> chan_recv_timeout_in(s, log))

fn chan_recv_timeout_in(s: task.Scope, log: Ref String) -> task.TimeoutResult Int !{IO} =
  do
    ch <- chan.chan_new(s, 1)
    task.with_timeout(30, \_ -> recv_forever(ch, log))

# Same ancestor-scope ownership as chan_recv_timeout, over two channels so the select parks
# registered on both.
fn select_timeout(log: Ref String) -> task.TimeoutResult Int !{IO} =
  task.with_scope(\s -> select_timeout_in(s, log))

fn select_timeout_in(s: task.Scope, log: Ref String) -> task.TimeoutResult Int !{IO} =
  do
    a <- chan.chan_new(s, 1)
    b <- chan.chan_new(s, 1)
    task.with_timeout(30, \_ -> select_forever([a, b], log))
