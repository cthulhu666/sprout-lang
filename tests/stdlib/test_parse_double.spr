import stdlib.test (check_true, run_suite)
import stdlib.math

# parse_double (prelude) parses a decimal Double from text: optional '-', integer part,
# optional '.frac', optional 'e'/'E' exponent. Pure Sprout (no strtod builtin). Double has
# no Eq instance, so results are checked with an absolute-tolerance `approx`, not assert_eq.
#
# Two properties below need `double_to_bits` (stdlib.math) rather than `approx`, because the
# values they distinguish are numerically EQUAL: -0.0 compares equal to 0.0 under IEEE 754,
# so only the bit pattern shows whether the sign survived the parse.

fn abs_d(x: Double) -> Double = if x < 0.0 then 0.0 - x else x

fn approx(m: Maybe Double, target: Double, eps: Double) -> Bool =
  match m with
  | Nothing -> false
  | Just x -> abs_d(x - target) < eps

fn is_nothing(m: Maybe Double) -> Bool =
  match m with
  | Nothing -> true
  | Just _ -> false

# Built by arithmetic, not by parsing: -1.0 * 0.0 is -0.0 under IEEE 754, so this reference
# is independent of both parse_double and the unary-minus lowering it is used to check.
fn neg_zero() -> Double = (0.0 - 1.0) * 0.0

fn has_bits_of(m: Maybe Double, reference: Double) -> Bool =
  match m with
  | Nothing -> false
  | Just x -> double_to_bits(x) == double_to_bits(reference)

# 10^k as a Double, without a scientific-notation literal.
fn pow_ten(k: Int) -> Double = if k <= 0 then 1.0 else 10.0 * pow_ten(k - 1)

# The full writer -> reader round trip, at the magnitude where the writer switches to
# exponential form. `double_to_string` renders 10^15 as "1e+15" (%.15g), which is exactly
# the form the reader used to reject.
fn round_trips_at(k: Int) -> Bool =
  let x = pow_ten(k)
  in approx(parse_double(double_to_string(x)), x, 1.0)

fn main() -> Unit !{IO} =
  run_suite("parse_double", [
    # --- well-formed numbers ---
    check_true("integer", approx(parse_double("42"), 42.0, 0.0001)),
    check_true("zero", approx(parse_double("0"), 0.0, 0.0001)),
    check_true("simple decimal <1", approx(parse_double("0.104"), 0.104, 0.00001)),
    check_true("decimal >1", approx(parse_double("179.84"), 179.84, 0.001)),
    check_true("negative decimal", approx(parse_double("-179.84"), 0.0 - 179.84, 0.001)),
    check_true("leading-zero fraction", approx(parse_double("0.085"), 0.085, 0.00001)),
    check_true("sci notation neg exp", approx(parse_double("8.5e-2"), 0.085, 0.00001)),
    check_true("sci notation capital E", approx(parse_double("2.34E-2"), 0.0234, 0.00001)),
    check_true("sci notation pos exp", approx(parse_double("1.5e3"), 1500.0, 0.01)),
    check_true("negative sci", approx(parse_double("-1.0e-1"), 0.0 - 0.1, 0.0001)),
    check_true("trailing dot", approx(parse_double("5."), 5.0, 0.0001)),
    check_true("leading dot", approx(parse_double(".5"), 0.5, 0.0001)),

    # --- '+'-signed exponents (JSON and IEEE 754 both permit one) ---
    # The writer emits this form for any magnitude %g renders exponentially, so rejecting it
    # made a Double unable to survive its own round trip above 1e15 (text) / 1e17 (JSON).
    check_true("explicit + exponent", approx(parse_double("1e+3"), 1000.0, 0.01)),
    check_true("explicit + exponent, capital E", approx(parse_double("2.5E+2"), 250.0, 0.01)),
    check_true("+ exponent with a fraction", approx(parse_double("1.25e+2"), 125.0, 0.01)),
    check_true("+0 exponent is the identity", approx(parse_double("7.5e+0"), 7.5, 0.0001)),
    check_true("round trip at 1e15 (writer switches to 1e+15)", round_trips_at(15)),
    check_true("round trip at 1e17", round_trips_at(17)),
    check_true("round trip at 1e21", round_trips_at(21)),

    # A '+' is legal ONLY in the exponent. Accepting one on the mantissa would make the JSON
    # reader accept "+1.5", which RFC 8259's grammar does not allow.
    check_true("leading + on mantissa -> Nothing", is_nothing(parse_double("+1.5"))),
    check_true("leading + on a bare integer -> Nothing", is_nothing(parse_double("+42"))),
    check_true("dangling + exponent -> Nothing", is_nothing(parse_double("1e+"))),
    check_true("double-signed exponent -> Nothing", is_nothing(parse_double("1e+-3"))),

    # --- signed zero survives the parse ---
    # -0.0 and 0.0 are numerically equal, so these compare bit patterns.
    check_true("control: the -0.0 reference differs from 0.0",
               double_to_bits(neg_zero()) != double_to_bits(0.0)),
    check_true("negative zero keeps its sign", has_bits_of(parse_double("-0.0"), neg_zero())),
    check_true("negative zero, no fraction", has_bits_of(parse_double("-0"), neg_zero())),
    check_true("negative zero via exponent", has_bits_of(parse_double("-0.0e5"), neg_zero())),
    check_true("positive zero stays positive", has_bits_of(parse_double("0.0"), 0.0)),
    check_true("a negative value is still negative",
               has_bits_of(parse_double("-2.5"), 0.0 - 2.5)),

    # --- malformed input returns Nothing, never crashes ---
    check_true("empty -> Nothing", is_nothing(parse_double(""))),
    check_true("garbage -> Nothing", is_nothing(parse_double("abc"))),
    check_true("dangling exponent -> Nothing", is_nothing(parse_double("1.0e"))),
    check_true("lone dot -> Nothing", is_nothing(parse_double("."))),
    check_true("trailing garbage -> Nothing", is_nothing(parse_double("1.5x")))
  ])
