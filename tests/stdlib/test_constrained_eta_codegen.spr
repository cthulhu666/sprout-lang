import stdlib.test (TestState, new_state, assert_true, summary)

class MyEq a {
  fn my_eq(x: a, y: a) -> Bool
}

type Box a = Box a

instance MyEq Int {
  fn my_eq(x: Int, y: Int) -> Bool = x == y
}

instance MyEq (Box a) where MyEq a {
  fn my_eq(x: Box a, y: Box a) -> Bool = true
}

fn apply_box_eq(f: Box Int -> Box Int -> Bool) -> Bool =
  f(Box(1), Box(2))

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    assert_true(state, "constrained eta method compiles and runs", apply_box_eq(my_eq))
    summary(state)
