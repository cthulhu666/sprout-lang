# Tests for time_now_micros: monotonic microsecond counter (CLOCK_MONOTONIC).
# Only elapsed differences are meaningful; the epoch is unspecified.
import stdlib.test (TestState, new_state, assert_true, summary)

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    t0 <- time_now_micros()
    assert_true(state, "time_now_micros > 0", t0 > 0)

    t1 <- time_now_micros()
    assert_true(state, "monotonic: t1 >= t0", t1 >= t0)

    t2 <- time_now_micros()
    assert_true(state, "monotonic: t2 >= t1", t2 >= t1)

    summary(state)
