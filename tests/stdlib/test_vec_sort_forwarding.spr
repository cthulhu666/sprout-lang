import stdlib.test (TestState, new_state, assert_eq, summary)

# Regression test for the dict-resolution soundness bug (BACKLOG §1):
# `vec_sort(vec: Vec a) -> Vec a where Ord a = vec_sort_by(\v -> v, vec)`.
# The forwarded `Ord a` constraint was mis-resolved to the parametric
# `instance Ord (Vec a)`, so `vec_sort` sorted `Vec Int` by comparing the Int
# keys via `Ord Vec` → `vec_length` dereferenced an integer → SIGSEGV.
# The fix must forward `vec_sort`'s own `Ord a` dict into `vec_sort_by`.
# Before the fix, every assertion here crashes (exit 139) rather than failing.

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    assert_eq(state, "vec_sort ascending",
      vec_sort(foldable_to_vec([5, 3, 1, 4, 2])),
      foldable_to_vec([1, 2, 3, 4, 5]))
    assert_eq(state, "vec_sort already sorted",
      vec_sort(foldable_to_vec([1, 2, 3])),
      foldable_to_vec([1, 2, 3]))
    assert_eq(state, "vec_sort singleton",
      vec_sort(foldable_to_vec([42])),
      foldable_to_vec([42]))
    assert_eq(state, "vec_sort empty",
      vec_sort(vec_empty()),
      foldable_to_vec([]))
    assert_eq(state, "vec_sort to_string",
      to_string(vec_sort(foldable_to_vec([3, 1, 2]))),
      "[1, 2, 3]")

    summary(state)
