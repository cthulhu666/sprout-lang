import stdlib.test (check_eq, run_suite)
import stdlib.string as string

# Regression (PR 11, typed IR codegen): a top-level `let` bound to a closure must
# be lowered via IRLoadGlobal + IRApplyClosure, not a direct `call` against the
# global slot (which segfaulted at runtime on the typed --use-ir-codegen path).
#
# Under Package C-b (n-ary) the closure is built with a `_`-placeholder partial
# (`f(a, _)` desugars to `\p -> f(a, p)`); implicit partial application (`f(a)`)
# is now a compile error. The lowering path exercised here is unchanged.

fn add3(a: Int, b: Int, c: Int) -> Int = a + b + c

# top-level let bound to a placeholder partial of a stdlib fn (captures "ab")
let rep = string.repeat("ab", _)

# top-level let bound to a placeholder partial of a user fn (captures 5, 6)
let add_5_6 = add3(5, 6, _)

fn main() -> Unit !{IO} =
  run_suite("ir_partial_application", [
    check_eq("stdlib partial: rep(3) = ababab", rep(3), "ababab"),
    check_eq("stdlib partial: rep(0) = ''", rep(0), ""),
    check_eq("stdlib partial: rep(1) = ab", rep(1), "ab"),
    check_eq("user-fn partial: add_5_6(7) = 18", add_5_6(7), 18),
    check_eq("user-fn partial: add_5_6(0) = 11", add_5_6(0), 11)
  ])
