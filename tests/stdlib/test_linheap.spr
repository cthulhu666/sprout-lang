import stdlib.test (check_eq, run_suite)
import stdlib.list
import stdlib.linheap (LinHeap)
import stdlib.linheap as linheap

# `stdlib.linheap` (docs/linheap-v0.md §7). The linear rejections are in
# tests/conformance/type_error/linheap_*; the vector counts are `just linear-reuse-smoke`.

fn rem(a: Int, n: Int) -> Int =
  a - (a / n) * n

# Pseudo-random Ints in -100..99, so a long list has duplicates and negatives.
fn gen(n: Int, seed: Int, acc: List Int) -> List Int =
  if n <= 0 then acc
  else
    let s = rem(seed * 1103515245 + 12345, 2147483648)
    in gen(n - 1, s, Cons(rem(s / 65536, 200) - 100, acc))

fn sorted(xs: List a) -> List a where Ord a =
  vec_to_list(vec_sort(vec_from_list(xs)))

fn empty_int() -> LinHeap Int = linheap.new()

let empty_ints: List Int = []

fn push_all(xs: List a, h: LinHeap a) -> LinHeap a where Ord a =
  match xs with
  | [] -> h
  | [x | rest] -> push_all(rest, linheap.push(x, h))

fn drain_go(h: LinHeap a, acc: List a) -> List a where Ord a =
  match linheap.pop(h) with
  | Nothing -> list_reverse(acc)
  | Just (x, rest) -> drain_go(rest, Cons(x, acc))

fn drain(h: LinHeap a) -> List a where Ord a = drain_go(h, [])

# The size after each push, then after each pop.
fn sizes_up(xs: List a, h: LinHeap a, acc: List Int) -> (List Int, LinHeap a) where Ord a =
  match xs with
  | [] -> (list_reverse(acc), h)
  | [x | rest] ->
      let h2 = linheap.push(x, h)
          n = linheap.size(h2)
      in sizes_up(rest, h2, Cons(n, acc))

fn sizes_down(h: LinHeap a, acc: List Int) -> List Int where Ord a =
  match linheap.pop(h) with
  | Nothing -> list_reverse(acc)
  | Just (_, rest) ->
      let n = linheap.size(rest)
      in sizes_down(rest, Cons(n, acc))

fn growth_sizes(n: Int) -> (List Int, List Int) =
  let (up, h) = sizes_up(gen(n, 7, []), empty_int(), [])
  in (up, sizes_down(h, []))

# Pops `p` elements; an empty heap stays empty.
fn pop_n(p: Int, h: LinHeap a) -> LinHeap a where Ord a =
  if p <= 0 then h
  else
    match linheap.pop(h) with
    | Nothing -> linheap.new()
    | Just (_, rest) -> pop_n(p - 1, rest)

fn pop_empty() -> String =
  match linheap.pop(empty_int()) with
  | Nothing -> "nothing"
  | Just (x, rest) -> let _ = linheap.drop(rest) in `just ${int_to_string(x)}`

fn peek_empty() -> Maybe Int =
  let h = empty_int()
      p = linheap.peek(h)
      _ = linheap.drop(h)
  in p

# The peek and the pop that follows it, on a heap holding `xs`.
fn peek_then_pop(xs: List Int) -> (Maybe Int, Maybe Int) =
  let h = push_all(xs, empty_int())
      p = linheap.peek(h)
  in match linheap.pop(h) with
     | Nothing -> (p, Nothing)
     | Just (x, rest) -> let _ = linheap.drop(rest) in (p, Just(x))

# --- push, pop to empty, push again ---

fn emptied() -> LinHeap Int =
  match linheap.pop(linheap.push(5, empty_int())) with
  | Nothing -> empty_int()
  | Just (_, rest) -> rest

fn emptied_size() -> Int =
  let h = emptied()
      n = linheap.size(h)
      _ = linheap.drop(h)
  in n

fn emptied_peek() -> Maybe Int =
  let h = emptied()
      p = linheap.peek(h)
      _ = linheap.drop(h)
  in p

fn emptied_pop() -> String =
  match linheap.pop(emptied()) with
  | Nothing -> "nothing"
  | Just (x, rest) -> let _ = linheap.drop(rest) in `just ${int_to_string(x)}`

fn emptied_then_push() -> List Int =
  drain(linheap.push(9, linheap.push(7, emptied())))

# --- keys ordered on every field ---

type Key (..) deriving (Eq, Ord) =
  | Key Int Int

fn key_pair(k: Key) -> (Int, Int) =
  match k with
  | Key a b -> (a, b)

fn keys_from(xs: List Int, i: Int) -> List Key =
  match xs with
  | [] -> []
  | [x | rest] -> Cons(Key(rem(x, 5), i), keys_from(rest, i + 1))

fn pairs(ks: List Key) -> List (Int, Int) = list_map(key_pair, ks)

fn sorted_keys_of(xs: List Int) -> List (Int, Int) = pairs(sorted(keys_from(xs, 0)))

fn from_list_drains(n: Int) -> List (Int, Int) =
  pairs(drain(linheap.from_list(keys_from(gen(n, 11, []), 0))))

fn pushed_drains(n: Int) -> List (Int, Int) =
  pairs(drain(push_all(keys_from(gen(n, 11, []), 0), linheap.new())))

fn from_list_matches_pushes(n: Int) -> Bool =
  from_list_drains(n) == pushed_drains(n) && from_list_drains(n) == sorted_keys_of(gen(n, 11, []))

# Sizes up to `m` whose descending build does not drain sorted. Every sift goes to a leaf,
# and even sizes end on a parent with only a left child.
fn descending_failures(m: Int) -> List Int =
  [n for n in 1..m if drain(linheap.from_list([i for i in range_down(n, 1)])) != [i for i in 1..n]]

# --- from_list followed by pushes and pops ---

# Builds from `n` Ints, pops `p`, pushes `k` more, drains; "" when that is the sorted rest.
fn sweep_one(n: Int, p: Int, k: Int) -> String =
  let xs = gen(n, 3, [])
      extra = gen(k, 5, [])
      got = drain(push_all(extra, pop_n(p, linheap.from_list(xs))))
      want = sorted(list.drop(p, sorted(xs)) ++ extra)
  in if got == want then "" else `n=${int_to_string(n)} p=${int_to_string(p)} k=${int_to_string(k)};`

# Every pop count from 0 to past the end, so the quarter-shrink steps are all crossed.
fn sweep(n: Int) -> String =
  string_concat_many([sweep_one(n, p, k) for p in 0..(n + 1), k in [0, 1, 3, 17, 70]])

# --- a counter in the key breaks ties ---

type Job (..) deriving (Eq, Ord) =
  | Job Int Int

fn job_pair(j: Job) -> (Int, Int) =
  match j with
  | Job a b -> (a, b)

fn jobs_from(prios: List Int, i: Int) -> List Job =
  match prios with
  | [] -> []
  | [p | rest] -> Cons(Job(p, i), jobs_from(rest, i + 1))

fn job_order() -> List (Int, Int) =
  list_map(job_pair, drain(push_all(jobs_from([3, 1, 3, 1, 2, 3], 0), linheap.new())))

# --- other key types ---

fn string_order() -> List String =
  drain(push_all(["pear", "apple", "fig", "apple", "zebra", ""], linheap.new()))

fn maybe_order() -> List (Maybe Int) =
  drain(push_all([Just(3), Nothing, Just(-1), Just(3), Nothing], linheap.new()))

fn double_order() -> List Double =
  drain(push_all([2.5, -1.0, 3.25, 0.0, -1.0], linheap.new()))

# --- a `where Ord a` caller ---

fn take_k(k: Int, h: LinHeap a, acc: List a) -> List a where Ord a =
  if k <= 0 then
    let _ = linheap.drop(h)
    in list_reverse(acc)
  else
    match linheap.pop(h) with
    | Nothing -> list_reverse(acc)
    | Just (x, rest) -> take_k(k - 1, rest, Cons(x, acc))

# The `k` least of `xs`, by pushes.
fn top_k(k: Int, xs: List a) -> List a where Ord a =
  take_k(k, push_all(xs, linheap.new()), [])

# The same, by a build.
fn top_k_built(k: Int, xs: List a) -> List a where Ord a =
  take_k(k, linheap.from_list(xs), [])

fn empty_size() -> Int =
  let h = linheap.from_list(empty_ints)
      n = linheap.size(h)
      _ = linheap.drop(h)
  in n

fn main() -> Unit !{IO} =
  let xs250 = gen(250, 1, [])
      xs30 = gen(30, 2, [])
  in run_suite("linheap", [
       check_eq("drain equals sort, 250 keys with duplicates and negatives",
                drain(push_all(xs250, linheap.new())), sorted(xs250)),
       check_eq("drain equals sort, 30 keys", drain(push_all(xs30, linheap.new())), sorted(xs30)),
       check_eq("drain of all-equal keys", drain(push_all([4, 4, 4, 4, 4], linheap.new())), [4, 4, 4, 4, 4]),
       check_eq("sizes while growing to 70 and while draining",
                growth_sizes(70), ([i for i in 1..70], [i for i in range_down(69, 0)])),
       check_eq("pop on empty is Nothing", pop_empty(), "nothing"),
       check_eq("peek on empty is Nothing", peek_empty(), Nothing),
       check_eq("peek is the next pop", peek_then_pop([5, 2, 8, 2, 9]), (Just(2), Just(2))),
       check_eq("peek is the next pop, one key", peek_then_pop([-3]), (Just(-3), Just(-3))),
       check_eq("peek and pop on an empty heap", peek_then_pop([]), (Nothing, Nothing)),
       check_eq("size after popping the last key", emptied_size(), 0),
       check_eq("peek after popping the last key", emptied_peek(), Nothing),
       check_eq("pop after popping the last key", emptied_pop(), "nothing"),
       check_eq("push after popping the last key", emptied_then_push(), [7, 9]),
       check_eq("from_list of 0 drains empty", from_list_drains(0), []),
       check_eq("from_list of 0 has size 0", empty_size(), 0),
       check_eq("from_list matches pushes, 1", from_list_matches_pushes(1), true),
       check_eq("from_list matches pushes, 2", from_list_matches_pushes(2), true),
       check_eq("from_list matches pushes, 7", from_list_matches_pushes(7), true),
       check_eq("from_list matches pushes, 13", from_list_matches_pushes(13), true),
       check_eq("from_list of 13 keeps all 13", list_length(from_list_drains(13)), 13),
       check_eq("from_list of descending keys, sizes 1 to 20", descending_failures(20), empty_ints),
       check_eq("from_list of all-equal keys", drain(linheap.from_list([4, 4, 4, 4, 4, 4])),
                [4, 4, 4, 4, 4, 4]),
       check_eq("from_list then pops and pushes, 0", sweep(0), ""),
       check_eq("from_list then pops and pushes, 1", sweep(1), ""),
       check_eq("from_list then pops and pushes, 2", sweep(2), ""),
       check_eq("from_list then pops and pushes, 7", sweep(7), ""),
       check_eq("from_list then pops and pushes, 13", sweep(13), ""),
       check_eq("equal first fields pop in counter order", job_order(),
                [(1, 1), (1, 3), (2, 4), (3, 0), (3, 2), (3, 5)]),
       check_eq("String keys", string_order(), ["", "apple", "apple", "fig", "pear", "zebra"]),
       check_eq("Maybe Int keys", maybe_order(), [Nothing, Nothing, Just(-1), Just(3), Just(3)]),
       check_eq("Double keys", double_order(), [-1.0, -1.0, 0.0, 2.5, 3.25]),
       check_eq("top_k at Int", top_k(4, xs30), list.take(4, sorted(xs30))),
       check_eq("top_k_built at Int", top_k_built(4, xs30), list.take(4, sorted(xs30))),
       check_eq("top_k past the length", top_k(50, [3, 1, 2]), [1, 2, 3]),
       check_eq("top_k of nothing", top_k(3, empty_ints), empty_ints),
       check_eq("top_k at a derived key", pairs(top_k(5, keys_from(xs30, 0))),
                list.take(5, sorted_keys_of(xs30))),
       check_eq("top_k_built at a derived key", pairs(top_k_built(5, keys_from(xs30, 0))),
                list.take(5, sorted_keys_of(xs30)))
     ])
