import stdlib.test (TestState, new_state, assert_eq, summary)
import stdlib.log (Level, Logger, Debug, Info, Warn, Error, stderr_logger, logger_with_sink, with_field, base_fields, should_log, level_name, format_line, log, info_f, error)
import stdlib.string as string

# stdlib.log: leveled, structured logging. The sink and the record formatter are
# decoupled, so the pure pieces (gate, level name, line format) are asserted
# directly; the effectful `log` path is exercised through a Ref-backed capture
# sink (no stderr, no wall clock in the asserted value).

fn yn(b: Bool) -> String =
  if b then "yes" else "no"

fn has_substr(haystack: String, needle: String) -> String =
  match string.find(haystack, needle) with
  | Nothing -> "no"
  | Just _ -> "yes"

# A capture sink appends each formatted record (plus its own newline — the sink
# owns line termination, per the design contract) to a shared buffer.
fn append_line(buf: Ref String, line: String) -> Unit !{IO} =
  do
    cur <- ref_read(buf)
    ref_write(buf, string.concat(cur, string.concat(line, "\n")))

fn capture_logger(buf: Ref String) -> Logger =
  logger_with_sink(Info, \line -> append_line(buf, line))

# One record with a single field, minus the fixed `T INFO m ` prefix and the field's leading space, so each case reads as the
# field text alone.
fn field_text(k: String, v: String) -> String =
  string.drop(format_line("T", Info, "m", [(k, v)]), 9)

# The message part of a record with no fields, minus the `T INFO ` prefix.
fn msg_text(msg: String) -> String =
  string.drop(format_line("T", Info, msg, vec_empty()), 7)

fn ctl(code: Int) -> String =
  string.string_from_char(char_from_codepoint(code))

fn count_lines(buf: String) -> Int =
  list_length(string.split(buf, "\n")) - 1

let newlines_20000: String = string_concat_many(list_map(\_ -> "\n", range_to_list(0..19999)))

let two_fields: Vec (String, String) =
  [("method", "GET"), ("status", "200")]

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # --- Pure: level gate --------------------------------------------------
    assert_eq(state, "Debug is filtered out under an Info logger",
      yn(should_log(stderr_logger(Info), Debug)), "no")
    assert_eq(state, "Error passes an Info logger",
      yn(should_log(stderr_logger(Info), Error)), "yes")
    assert_eq(state, "Debug passes a Debug logger",
      yn(should_log(stderr_logger(Debug), Debug)), "yes")
    assert_eq(state, "Warn passes an Info logger",
      yn(should_log(stderr_logger(Info), Warn)), "yes")

    # --- Pure: level name --------------------------------------------------
    assert_eq(state, "level_name Warn", level_name(Warn), "WARN")
    assert_eq(state, "level_name Debug", level_name(Debug), "DEBUG")

    # --- Pure: line formatting (fixed timestamp in) ------------------------
    assert_eq(state, "formatted line: ts LEVEL msg then k=v fields in order",
      format_line("2026-07-18T14:03:21Z", Info, "request", two_fields),
      "2026-07-18T14:03:21Z INFO request method=GET status=200")
    assert_eq(state, "one field",
      format_line("2026-07-18T14:03:21Z", Info, "request", [("k", "v")]),
      "2026-07-18T14:03:21Z INFO request k=v")
    assert_eq(state, "no fields: no trailing space",
      format_line("2026-07-18T14:03:21Z", Error, "boom", vec_empty()),
      "2026-07-18T14:03:21Z ERROR boom")

    # --- Pure: with_field returns an independent, enriched logger ----------
    assert_eq(state, "a fresh logger has no base fields",
      int_to_string(vec_length(base_fields(stderr_logger(Info)))), "0")
    assert_eq(state, "with_field adds exactly one base field",
      int_to_string(vec_length(base_fields(with_field("svc", "api", stderr_logger(Info))))), "1")

    # --- Effectful: the capture-sink path gates and emits ------------------
    buf <- ref_new("")
    log(capture_logger(buf), Debug, "hidden", vec_empty())
    after_debug <- ref_read(buf)
    assert_eq(state, "a gated-out record writes nothing to the sink",
      after_debug, "")

    log(capture_logger(buf), Error, "boom", vec_empty())
    after_error <- ref_read(buf)
    assert_eq(state, "an emitted record reaches the sink with level+message",
      has_substr(after_error, "ERROR boom"), "yes")
    assert_eq(state, "the emitted record is newline-terminated by the sink",
      has_substr(after_error, "\n"), "yes")

    # Base context fields and per-call fields both appear in the emitted line.
    buf2 <- ref_new("")
    error(with_field("svc", "api", capture_logger(buf2)), "kaboom")
    after_ctx <- ref_read(buf2)
    assert_eq(state, "base context field is emitted",
      has_substr(after_ctx, "svc=api"), "yes")

    buf3 <- ref_new("")
    info_f(with_field("svc", "api", capture_logger(buf3)), "req",
      [("code", "500")])
    after_merge <- ref_read(buf3)
    assert_eq(state, "base fields precede per-call fields",
      has_substr(after_merge, "svc=api code=500"), "yes")

    # --- Pure: field values are bare unless they need quoting ---------------
    assert_eq(state, "a plain value stays bare", field_text("k", "v-1.2/x_y"), "k=v-1.2/x_y")
    assert_eq(state, "a lone backslash stays bare", field_text("k", "a\\b"), "k=a\\b")
    assert_eq(state, "non-ASCII UTF-8 stays bare", field_text("k", "café/日本"), "k=café/日本")
    assert_eq(state, "an empty value is quoted", field_text("k", ""), "k=\"\"")
    assert_eq(state, "a space quotes the value", field_text("k", "a b"), "k=\"a b\"")
    assert_eq(state, "an equals sign quotes the value", field_text("k", "a=b"), "k=\"a=b\"")
    assert_eq(state, "a double quote is escaped inside quotes", field_text("k", "a\"b"), "k=\"a\\\"b\"")
    assert_eq(state, "a backslash is escaped once the value is quoted",
      field_text("k", "a b\\c"), "k=\"a b\\\\c\"")
    assert_eq(state, "LF becomes \\n", field_text("k", "a\nb"), "k=\"a\\nb\"")
    assert_eq(state, "CR becomes \\r", field_text("k", "a\rb"), "k=\"a\\rb\"")
    assert_eq(state, "TAB becomes \\t", field_text("k", "a\tb"), "k=\"a\\tb\"")
    assert_eq(state, "ESC becomes \\x1b", field_text("k", `a${ctl(27)}[0mb`), "k=\"a\\x1b[0mb\"")
    assert_eq(state, "DEL becomes \\x7f", field_text("k", `a${ctl(127)}b`), "k=\"a\\x7fb\"")
    assert_eq(state, "NUL-range byte 0x01 becomes \\x01", field_text("k", `a${ctl(1)}b`), "k=\"a\\x01b\"")
    assert_eq(state, "non-ASCII stays as is inside quotes",
      field_text("k", "café 日本\n"), "k=\"café 日本\\n\"")
    assert_eq(state, "every control byte in one value is escaped",
      field_text("k", `${ctl(10)}${ctl(13)}${ctl(9)}${ctl(27)}${ctl(127)}`), "k=\"\\n\\r\\t\\x1b\\x7f\"")

    # --- Pure: keys follow the same rule ------------------------------------
    assert_eq(state, "a key with a space is quoted", field_text("my key", "v"), "\"my key\"=v")
    assert_eq(state, "a key with LF is quoted and escaped", field_text("a\nb", "v"), "\"a\\nb\"=v")
    assert_eq(state, "an empty key is quoted", field_text("", "v"), "\"\"=v")
    assert_eq(state, "a key with an equals sign is quoted", field_text("a=b", "v"), "\"a=b\"=v")

    # --- Pure: the message is not quoted, but control bytes are escaped ------
    assert_eq(state, "a plain message is unchanged", msg_text("request handled"), "request handled")
    assert_eq(state, "quotes and equals in a message are unchanged", msg_text("say \"a=b\""), "say \"a=b\"")
    assert_eq(state, "non-ASCII in a message is unchanged", msg_text("café 日本"), "café 日本")
    assert_eq(state, "LF in a message is escaped", msg_text("a\nb"), "a\\nb")
    assert_eq(state, "CR in a message is escaped", msg_text("a\rb"), "a\\rb")
    assert_eq(state, "TAB in a message is escaped", msg_text("a\tb"), "a\\tb")
    assert_eq(state, "ESC in a message is escaped", msg_text(`a${ctl(27)}[31mb`), "a\\x1b[31mb")
    assert_eq(state, "DEL in a message is escaped", msg_text(`a${ctl(127)}b`), "a\\x7fb")
    assert_eq(state, "a backslash in a message is escaped, so \\n text differs from LF",
      msg_text("a\\nb"), "a\\\\nb")
    assert_eq(state, "a message escape does not touch the fields after it",
      format_line("T", Info, "a\nb", [("k", "v")]), "T INFO a\\nb k=v")

    # --- Pure: C1 controls and U+2028/U+2029 are escaped; other non-ASCII is not ------
    assert_eq(state, "U+009B in a value is quoted and escaped",
      field_text("k", `a${ctl(155)}b`), "k=\"a\\u009bb\"")
    assert_eq(state, "U+0085 in a value is quoted and escaped",
      field_text("k", `a${ctl(133)}b`), "k=\"a\\u0085b\"")
    assert_eq(state, "U+0080 and U+009F bound the C1 range",
      field_text("k", `${ctl(128)}${ctl(159)}`), "k=\"\\u0080\\u009f\"")
    assert_eq(state, "U+2028 in a value is quoted and escaped",
      field_text("k", `a${ctl(8232)}b`), "k=\"a\\u2028b\"")
    assert_eq(state, "U+2029 in a value is quoted and escaped",
      field_text("k", `a${ctl(8233)}b`), "k=\"a\\u2029b\"")
    assert_eq(state, "U+009B in a key is quoted and escaped",
      field_text(`a${ctl(155)}b`, "v"), "\"a\\u009bb\"=v")
    assert_eq(state, "U+0085 in a key is quoted and escaped",
      field_text(`a${ctl(133)}b`, "v"), "\"a\\u0085b\"=v")
    assert_eq(state, "U+2028 in a key is quoted and escaped",
      field_text(`a${ctl(8232)}b`, "v"), "\"a\\u2028b\"=v")
    assert_eq(state, "U+2029 in a key is quoted and escaped",
      field_text(`a${ctl(8233)}b`, "v"), "\"a\\u2029b\"=v")
    assert_eq(state, "U+009B in a message is escaped, not quoted",
      msg_text(`a${ctl(155)}b`), "a\\u009bb")
    assert_eq(state, "U+0085 in a message is escaped, not quoted",
      msg_text(`a${ctl(133)}b`), "a\\u0085b")
    assert_eq(state, "U+2028 in a message is escaped, not quoted",
      msg_text(`a${ctl(8232)}b`), "a\\u2028b")
    assert_eq(state, "U+2029 in a message is escaped, not quoted",
      msg_text(`a${ctl(8233)}b`), "a\\u2029b")
    assert_eq(state, "U+00A0 passes through bare",
      field_text("k", `a${ctl(160)}b`), `k=a${ctl(160)}b`)
    assert_eq(state, "U+2027 passes through bare",
      field_text("k", `a${ctl(8231)}b`), `k=a${ctl(8231)}b`)
    assert_eq(state, "e-acute passes through bare", field_text("k", "café"), "k=café")
    assert_eq(state, "U+00A0, U+2027 and e-acute pass through a key",
      field_text(`${ctl(160)}${ctl(8231)}é`, "v"), `${ctl(160)}${ctl(8231)}é=v`)
    assert_eq(state, "U+00A0, U+2027 and e-acute pass through a message",
      msg_text(`${ctl(160)}${ctl(8231)}é`), `${ctl(160)}${ctl(8231)}é`)
    assert_eq(state, "a passing codepoint beside an escaped one is kept",
      field_text("k", `${ctl(160)}${ctl(133)}${ctl(8231)}${ctl(8232)}`),
      `k="${ctl(160)}\\u0085${ctl(8231)}\\u2028"`)
    assert_eq(state, "ASCII and Unicode escapes mix in one value",
      field_text("k", `a\n${ctl(155)}"${ctl(8233)}\\${ctl(27)}`),
      "k=\"a\\n\\u009b\\\"\\u2029\\\\\\x1b\"")
    assert_eq(state, "a record with U+2028 and U+0085 stays one line",
      count_lines(string.concat(format_line("T", Info, `a${ctl(8232)}b${ctl(133)}c`, [("k", `${ctl(8233)}`)]), "\n")), 1)

    # A long run of escapes is one linear pass; a quadratic builder would not finish this size.
    assert_eq(state, "20000 escapes are rewritten in one pass",
      string.byte_length(field_text("k", newlines_20000)), 2 + 2 + 2 * 20000)

    # --- Effectful: one record stays one line ---------------------------------
    buf4 <- ref_new("")
    info_f(with_field("svc", "a\nb", capture_logger(buf4)), "two\nlines", [("q", "x\ry"), ("e", `${ctl(27)}[2J`)])
    after_ctl <- ref_read(buf4)
    assert_eq(state, "a record with control bytes is one line", count_lines(after_ctl), 1)
    assert_eq(state, "the quoted fields reach the sink",
      has_substr(after_ctl, "two\\nlines svc=\"a\\nb\" q=\"x\\ry\" e=\"\\x1b[2J\""), "yes")

    summary(state)
