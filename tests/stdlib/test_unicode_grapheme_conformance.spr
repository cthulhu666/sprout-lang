fn all_data() -> String =
  string_concat_many(collect_chunks(0, gbt_chunks(), Nil))

fn collect_chunks(i: Int, n: Int, acc: List String) -> List String =
  if i >= n then list_reverse(acc)
  else collect_chunks(i + 1, n, Cons(gbt_chunk(i), acc))

fn decode4(s: String, i: Int, n: Int, acc: List Int) -> List Int =
  if i >= n then list_reverse(acc)
  else decode4(s, i + 4, n, Cons(lookup.b62_decode(string.slice(s, i, 4)), acc))

# Tested at the CODEPOINT level, not by round-tripping through a String:
# a Sprout String is NUL-terminated, so the suite's U+0000 cases would lose
# that codepoint and silently pass with the wrong cluster count.
#
# Both sides render as comma-joined sizes so a failure reads as
# "1,2 vs 3" rather than as two opaque structures.
fn actual_sizes(cps_enc: String) -> String =
  string.join(",", list_map(\n -> to_string(n),
    grapheme.cluster_sizes(decode4(cps_enc, 0, string.length(cps_enc), Nil))))

fn expected_sizes(sizes_enc: String) -> String =
  string.join(",", list_map(\n -> to_string(n),
                            decode4(sizes_enc, 0, string.length(sizes_enc), Nil)))

fn run_case(state: TestState, c: String) -> Unit !{IO} =
  match string.split_once(c, ";") with
  | Nothing -> ()
  | Just (cps_enc, sizes_enc) ->
      assert_eq(state, `case ${cps_enc}`,
                actual_sizes(cps_enc), expected_sizes(sizes_enc))

fn run_cases(state: TestState, cases: List String) -> Unit !{IO} =
  match cases with
  | Nil -> ()
  | Cons c rest -> do
      run_case(state, c)
      run_cases(state, rest)

fn main() -> Unit !{IO} = do
  state <- new_state()
  run_cases(state, string.split(all_data(), "\n"))
  summary(state)
