import stdlib.test (check_eq, run_suite)

# Concrete-instance devirtualization (docs/scalar-replacement-v0.md, A-full): a class-method call
# whose dictionary is a fully-resolved concrete instance (no forwarded/polymorphic dict) is lowered
# to a DIRECT call of the concrete `__tc_{Class}_{Type}_{method}` fn, dropping the runtime dictionary
# entirely — no `sprout_alloc_closure`, no generic `__cm_` wrapper indirection. The optimization
# is value-NEUTRAL, so these assert the SEMANTICS are unchanged; the IR-shape win (no closure allocs
# at the concrete site) is checked separately against the emitted IR / smoke shape 09.

type Dir (..) deriving (Enum) = North | East | South | West

# CONCRETE return-type dispatch: from_ordinal @ Dir — the demo's `tile_kind_of` shape. Devirt target.
fn dir_of(tag: Int) -> Dir =
  match from_ordinal(tag) with
  | Just d -> d
  | Nothing -> North

# CONCRETE argument dispatch: ordinal @ Dir. Devirt target.
fn dir_tag(d: Dir) -> Int = ordinal(d)

# POLYMORPHIC consumer: `ordinal(v)` here dispatches on a FORWARDED dict (Enum a is a hidden param),
# NOT a concrete instance — devirt must NOT fire, the dict stays forwarded. Guards the soundness gate:
# the result must still be correct when called at a concrete type.
fn generic_tag(v: a) -> Int !{} where Enum a = ordinal(v)

# CONCRETE Eq, NO context (instance Eq Int) — proves devirt is not Enum-only: fires for any class
# without superclass/context. `eq(a,b)` at Int -> direct __tc_Eq_Int_eq, no dict.
fn int_eq(a: Int, b: Int) -> Bool = eq(a, b)

# CONCRETE Eq WITH context (instance Eq (Maybe a) where Eq a) — devirt-beyond passes the RESOLVED
# inner Eq Int dict as a trailing arg to __tc_Eq_Maybe_a_eq (drops the outer wrapper, keeps the inner).
# A wrong inner-dict count would be an arity mismatch / miscompile; a correct bool proves it.
fn maybe_int_eq(a: Maybe Int, b: Maybe Int) -> Bool = eq(a, b)

# CONCRETE Ord (instance Ord Int) — Ord has superclass Eq, so the dispatch evidence is multi-block
# (Ord block + Eq super block). devirt-beyond DROPS the sibling Eq super block: __tc_Ord_Int_compare
# takes only (a,b), no dicts (2 closures -> 0).
fn int_lt(a: Int, b: Int) -> Bool = compare(a, b) < 0

# USER Ord instance whose compare USES the superclass eq — the soundness case. `eq(a,b)` inside compare
# resolves CONCRETELY (to __tc_Eq_Rank_eq), so __tc_Ord_Rank_compare still takes no Eq dict; dropping
# the sibling Eq super block at the call site is sound. Verified: the concrete fn arity is (a,b) only.
type Rank = Lo | Mid | Hi

fn rank_ord(r: Rank) -> Int =
  match r with
  | Lo -> 0
  | Mid -> 1
  | Hi -> 2

instance Eq Rank
  fn eq(a: Rank, b: Rank) -> Bool = rank_ord(a) == rank_ord(b)

instance Ord Rank
  fn compare(a: Rank, b: Rank) -> Int =
    if eq(a, b) then 0
    else rank_ord(a) - rank_ord(b)

fn rank_lt(a: Rank, b: Rank) -> Bool = compare(a, b) < 0
fn rank_eq(a: Rank, b: Rank) -> Bool = eq(a, b)

# COMBINED: Ord (Maybe a) where Ord a — multi-block (Ord super Eq) AND context-constrained (inner Ord).
# devirt-beyond retargets to __tc_Ord_Maybe_a_compare and passes the resolved inner Ord Int dict(s),
# dropping the sibling super block. The hardest shape; a correct result proves inner dicts survive.
fn maybe_int_lt(a: Maybe Int, b: Maybe Int) -> Bool = compare(a, b) < 0

# MULTI-CHILD context (instance Ord (a,b) where Ord a, Ord b) — TWO distinct inner dicts. This is the
# dict-ORDERING guard: consume_inner_dicts must hand the concrete fn its inner dicts in inst_constraints
# order. A swap (Ord String where Ord Int is expected) runs an Int through the String dict — wrong/crash
# — yet still passes opt-verify (all dicts are i64), so ONLY a value test catches it. Inputs are chosen
# so the SECOND (String) component decides (equal Ints), exercising the b-dict, not short-circuiting it.
fn pair_lt(a: (Int, String), b: (Int, String)) -> Bool = compare(a, b) < 0

fn main() -> Unit !{IO} =
  run_suite("devirt_classmethods", [
    # concrete from_ordinal round-trips through the derived ordinal
    check_eq("dir_of 0 -> North -> 0", dir_tag(dir_of(0)), 0),
    check_eq("dir_of 2 -> South -> 2", dir_tag(dir_of(2)), 2),
    check_eq("dir_of 3 -> West -> 3", dir_tag(dir_of(3)), 3),
    # out-of-range from_ordinal -> Nothing -> North (0)
    check_eq("dir_of 9 -> Nothing -> North -> 0", dir_tag(dir_of(9)), 0),
    # concrete ordinal directly
    check_eq("ordinal East -> 1", dir_tag(East), 1),
    # polymorphic path (forwarded dict, must NOT devirt) still correct at a concrete type
    check_eq("generic_tag West -> 3", generic_tag(West), 3),
    check_eq("generic_tag North -> 0", generic_tag(North), 0),
    # concrete Eq, no context -> devirt fires (non-Enum class)
    check_eq("int_eq 5 5 -> True", int_eq(5, 5), true),
    check_eq("int_eq 5 6 -> False", int_eq(5, 6), false),
    # concrete Eq WITH context -> MUST fall back; correct result proves the inner dict survived
    check_eq("maybe_int_eq Just5 Just5 -> True", maybe_int_eq(Just(5), Just(5)), true),
    check_eq("maybe_int_eq Just5 Just6 -> False", maybe_int_eq(Just(5), Just(6)), false),
    check_eq("maybe_int_eq Just5 Nothing -> False", maybe_int_eq(Just(5), Nothing), false),
    # concrete Ord (superclass Eq) -> devirt-beyond drops the sibling super block; still correct
    check_eq("int_lt 3 5 -> True", int_lt(3, 5), true),
    check_eq("int_lt 5 3 -> False", int_lt(5, 3), false),
    # user Ord whose compare uses eq -> concrete eq resolution, devirt sound
    check_eq("rank_lt Lo Hi -> True", rank_lt(Lo, Hi), true),
    check_eq("rank_lt Hi Lo -> False", rank_lt(Hi, Lo), false),
    check_eq("rank_lt Mid Mid -> False (equal)", rank_lt(Mid, Mid), false),
    check_eq("rank_eq Mid Mid -> True", rank_eq(Mid, Mid), true),
    check_eq("rank_eq Lo Hi -> False", rank_eq(Lo, Hi), false),
    # combined Ord (Maybe Int): multi-block + context -> inner dicts must survive
    check_eq("maybe_int_lt Just1 Just2 -> True", maybe_int_lt(Just(1), Just(2)), true),
    check_eq("maybe_int_lt Just2 Just1 -> False", maybe_int_lt(Just(2), Just(1)), false),
    check_eq("maybe_int_lt Just5 Just5 -> False (equal)", maybe_int_lt(Just(5), Just(5)), false),
    # multi-child dict ORDERING: 2nd (String) component decides -> exercises the b-dict specifically
    check_eq("pair_lt (1,a) (1,b) -> True (2nd decides)", pair_lt((1, "a"), (1, "b")), true),
    check_eq("pair_lt (1,b) (1,a) -> False (2nd decides)", pair_lt((1, "b"), (1, "a")), false),
    check_eq("pair_lt (1,z) (2,a) -> True (1st decides)", pair_lt((1, "z"), (2, "a")), true)
  ])
