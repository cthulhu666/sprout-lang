import stdlib.test (TestState, new_state, assert_eq, assert_true, summary)
import stdlib.task (Scope, with_scope, task_spawn, task_fork, task_await, task_yield)
import stdlib.chan (Chan, ChanError, ChanNegativeCapacity, Recv, Got, Closed, chan_new, chan_error_message, chan_send, chan_recv)
import stdlib.string as string
import stdlib.terminal as terminal

# L0.8 bounded buffered channels (EXPERIMENTAL). `chan_new(scope, cap)` creates a
# cap-slot channel tied to `scope` (freed at scope close). `chan_send` parks the
# task when the buffer is full; `chan_recv` parks it when empty. Values are FIFO.
# Backed by the scheduler's park/wake mechanism, with the buffer GC-rooted.
#
# `chan_recv` returns `Recv a = Got a | Closed` (L0.9). None of these tests close the
# channel, so `Closed` is unreachable here — the helpers unwrap `Got`; close behavior
# is covered by test_chan_close.spr.

fn recv_int(ch: Chan Int) -> Int !{IO} =
  match chan_recv(ch) with
  | Got v -> v
  | Closed -> 0  # unreachable: channel is never closed in this file

fn recv_str(ch: Chan String) -> String !{IO} =
  match chan_recv(ch) with
  | Got v -> v
  | Closed -> ""

# --- round-trip within one task: cap-4 buffer, two sends (no park, space free)
# then two recvs. The simplest happy path — no parking involved. ---
fn roundtrip(s: Scope) -> Int !{IO} =
  do
    let Ok ch = chan_new(s, 4) else Err e -> panic(chan_error_message(e))
    chan_send(ch, 10)
    chan_send(ch, 20)
    a <- recv_int(ch)
    b <- recv_int(ch)
    a + b

# --- backpressure: a cap-2 buffer with a producer that sends 4 values. The
# producer send-parks when the buffer fills (after 2), and each recv on the
# consumer side frees a slot that wakes it to deposit the next. Exercises BOTH
# park directions (send-park + the recv that drains) and FIFO order. ---
fn produce(ch: Chan Int, n: Int, i: Int) -> Unit !{IO} =
  if i > n then
    terminal.write("")
  else
    do
      chan_send(ch, i)  # parks here once the buffer is full
      produce(ch, n, i + 1)

fn consume(ch: Chan Int, n: Int, acc: Int) -> Int !{IO} =
  if n <= 0 then
    acc
  else
    do
      v <- recv_int(ch)
      consume(ch, n - 1, acc + v)

fn backpressure(s: Scope) -> Int !{IO} =
  do
    let Ok ch = chan_new(s, 2) else Err e -> panic(chan_error_message(e))
    task_spawn(s, \_ -> produce(ch, 4, 1))  # sends 1,2,3,4; parks at the fill line
    consume(ch, 4, 0)  # 1+2+3+4 = 10

# --- fan-in: three producer tasks each send one value into a cap-1 channel; one
# consumer recvs all three. Scheduling order varies but the sum is fixed. Each
# producer that finds the buffer full (or a receiver already waiting) hands off
# through the scheduler. ---
fn fan_in(s: Scope) -> Int !{IO} =
  do
    let Ok ch = chan_new(s, 1) else Err e -> panic(chan_error_message(e))
    task_spawn(s, \_ -> chan_send(ch, 100))
    task_spawn(s, \_ -> chan_send(ch, 20))
    task_spawn(s, \_ -> chan_send(ch, 3))
    a <- recv_int(ch)
    b <- recv_int(ch)
    c <- recv_int(ch)
    a + b + c

# --- heap-value rooting oracle: two heap Strings sit BUFFERED in the channel
# while a GC storm (churn under SPROUT_GC_STRESS=1) runs, THEN are received. If
# the buffer slots were not rooted, the strings would be collected during the
# churn and come back corrupted. `noise` is consumed so it is not eliminated. ---
fn churn(n: Int, acc: String) -> String =
  if n <= 0 then acc else churn(n - 1, acc ++ "x")

fn heap_rooting(s: Scope) -> String !{IO} =
  do
    let Ok ch = chan_new(s, 3) else Err e -> panic(chan_error_message(e))
    chan_send(ch, "al" ++ "pha")
    chan_send(ch, "be" ++ "ta")
    let noise = churn(200, "")
    x <- recv_str(ch)
    y <- recv_str(ch)
    `${x}${y}${string.length(noise)}`

# --- FIFO order: cap-3 buffer, send "a","b","c", recv three. Order-sensitive (unlike the
# commutative sums above) so a head/tail ring regression is caught. ---
fn fifo(s: Scope) -> String !{IO} =
  do
    let Ok ch = chan_new(s, 3) else Err e -> panic(chan_error_message(e))
    chan_send(ch, "a")
    chan_send(ch, "b")
    chan_send(ch, "c")
    x <- recv_str(ch)
    y <- recv_str(ch)
    z <- recv_str(ch)
    `${x}${y}${z}`

# --- chan_pending rooting oracle, DIRECT-HANDOFF path: a forked receiver parks on an empty
# channel; the owner sends a FRESH heap string (not bound in the owner's frame, so its ONLY
# root is the receiver's `chan_pending`), then churns to force a GC BEFORE the receiver runs.
# If &t->chan_pending were not rooted at task_create, the handed-off string is collected during
# the churn and the receiver reads garbage. Exercises design §5 mechanism (b), which the
# buffer-only heap_rooting test above does not (there nothing parks). ---
fn recv_one(ch: Chan String) -> String !{IO} =
  recv_str(ch)

fn parked_recv_heap_on(s: Scope, ch: Chan String) -> String !{IO} =
  do
    h <- task_fork(s, \_ -> recv_one(ch))
    task_yield()  # let the receiver reach chan_recv and park
    chan_send(ch, "hel" ++ "lo")  # direct handoff; the temp is not bound here
    let noise = churn(300, "")  # GC storm before the receiver runs
    got <- task_await(h)
    `${got}${string.length(noise)}`

fn parked_recv_heap_driver(s: Scope) -> String !{IO} =
  do
    let Ok ch = chan_new(s, 1) else Err e -> panic(chan_error_message(e))
    parked_recv_heap_on(s, ch)

# --- send-park with heap values (behavioral): a producer sends 3 heap strings into a cap-1
# channel, so its 2nd/3rd sends PARK holding a heap value; the consumer churns (GC) between recvs
# while a sender is parked. NOTE: this does NOT discriminate chan_pending rooting — a send-parked
# task is still inside the chan_send call, so its value is also rooted by the caller's argument
# slot across the park (chan_pending is redundant there; the recv-delivery test above is the
# discriminating oracle). This still exercises the full send-park→drain flow under GC. ---
fn produce_heap(ch: Chan String, tags: String, i: Int, n: Int) -> Unit !{IO} =
  if i > n then
    terminal.write("")
  else
    do
      chan_send(ch, `${tags}${i}`)  # 2nd+ send parks holding this value
      produce_heap(ch, tags, i + 1, n)

fn drain_heap(ch: Chan String, n: Int, acc: String) -> String !{IO} =
  if n <= 0 then
    acc
  else
    do
      let noise = churn(120, "")  # GC while a sender is parked holding a value
      v <- recv_str(ch)
      drain_heap(ch, n - 1, acc ++ v)

fn sendpark_heap(s: Scope) -> String !{IO} =
  do
    let Ok ch = chan_new(s, 1) else Err e -> panic(chan_error_message(e))
    task_spawn(s, \_ -> produce_heap(ch, "v", 1, 3))
    drain_heap(ch, 3, "")

# --- a channel's lifetime is [chan_new, join of its scope]. A task of a NESTED scope may use an
# enclosing scope's channel, since the outer scope is still open when the inner one joins. ---
fn nested_use(s: Scope) -> Int !{IO} =
  do
    let Ok ch = chan_new(s, 4) else Err e -> panic(chan_error_message(e))
    with_scope(\inner -> task_spawn(inner, \_ -> chan_send(ch, 5)))
    recv_int(ch)

# --- the capacity is a bound, not an allocation: the buffer starts small and grows on demand. ---

# Send i, i+1, .. n. Parks once the bound is reached, as any send does.
fn send_range(ch: Chan Int, i: Int, n: Int) -> Unit !{IO} =
  if i > n then
    terminal.write("")
  else
    do
      chan_send(ch, i)
      send_range(ch, i + 1, n)

# Receive n - i + 1 values and check they are exactly i, i+1, .. n in that order.
fn recv_range(ch: Chan Int, i: Int, n: Int) -> Bool !{IO} =
  if i > n then
    true
  else
    do
      v <- recv_int(ch)
      if v == i then recv_range(ch, i + 1, n) else false

# A capacity far beyond anything allocatable: creating the channel costs nothing, and 40 sends
# (past the initial buffer, so it grows) come back in order with no receiver in between.
fn huge_capacity(s: Scope, cap: Int) -> Bool !{IO} =
  do
    let Ok ch = chan_new(s, cap) else Err e -> panic(chan_error_message(e))
    send_range(ch, 1, 40)
    recv_range(ch, 1, 40)

# Grow while the ring is wrapped: 10 in, 5 out leaves the head mid-buffer, then enough sends to
# wrap the tail and force several growths. FIFO order must survive each copy.
fn grow_wrapped(s: Scope) -> Bool !{IO} =
  do
    let Ok ch = chan_new(s, 100) else Err e -> panic(chan_error_message(e))
    send_range(ch, 1, 10)
    first <- recv_range(ch, 1, 5)
    send_range(ch, 11, 70)
    rest <- recv_range(ch, 6, 70)
    first && rest

fn flag_then_recv(ran: Ref Bool, ch: Chan Int) -> Bool !{IO} =
  do
    ref_write(ran, true)
    recv_range(ch, 1, 21)

# The bound holds after the buffer has grown to it: 20 sends buffer without parking, the 21st
# parks until the consumer runs (the flag is set by the consumer, which only runs once the owner
# parks), and the consumer then sees all 21 in order.
fn bound_after_growth(s: Scope) -> (Bool, Bool) !{IO} =
  do
    let Ok ch = chan_new(s, 20) else Err e -> panic(chan_error_message(e))
    ran <- ref_new(false)
    send_range(ch, 1, 20)
    before <- ref_read(ran)
    h <- task_fork(s, \_ -> flag_then_recv(ran, ch))
    chan_send(ch, 21)  # full: parks, so the consumer gets to run
    after <- ref_read(ran)
    in_order <- task_await(h)
    (!before && after, in_order)

# Heap values buffered across several growths stay intact (SPROUT_GC_STRESS collects on every
# allocation, so a buffer that is not scanned through a growth loses them).
fn grow_heap_strings(s: Scope) -> String !{IO} =
  do
    let Ok ch = chan_new(s, 64) else Err e -> panic(chan_error_message(e))
    send_strings(ch, 1, 40)
    drain_strings(ch, 40, "")

fn send_strings(ch: Chan String, i: Int, n: Int) -> Unit !{IO} =
  if i > n then
    terminal.write("")
  else
    do
      chan_send(ch, `s${i}`)
      send_strings(ch, i + 1, n)

fn drain_strings(ch: Chan String, n: Int, acc: String) -> String !{IO} =
  if n <= 0 then
    acc
  else
    do
      v <- recv_str(ch)
      drain_strings(ch, n - 1, `${acc}${v},`)

fn send_lists(ch: Chan (List Int), i: Int, n: Int) -> Unit !{IO} =
  if i > n then
    terminal.write("")
  else
    do
      chan_send(ch, [i, i + 1, i + 2])
      send_lists(ch, i + 1, n)

fn recv_list_sum(ch: Chan (List Int), n: Int, acc: Int) -> Int !{IO} =
  if n <= 0 then
    acc
  else
    match chan_recv(ch) with
    | Got xs -> recv_list_sum(ch, n - 1, acc * 1000 + list_fold(\ (a, x) -> a + x, 0, xs))
    | Closed -> -1

fn grow_heap_lists(s: Scope) -> Int !{IO} =
  do
    let Ok ch = chan_new(s, 64) else Err e -> panic(chan_error_message(e))
    send_lists(ch, 1, 20)
    recv_list_sum(ch, 3, 0)  # the first three lists: sums 6, 9, 12

fn negative_capacity_value(s: Scope) -> Int !{IO} =
  match chan_new(s, -1) with
  | Err (ChanNegativeCapacity n) -> n
  | Ok _ -> 0

fn negative_capacity_message(s: Scope) -> String !{IO} =
  match chan_new(s, -1) with
  | Err e -> chan_error_message(e)
  | Ok _ -> ""

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    r1 <- with_scope(\s -> roundtrip(s))
    assert_eq(state, "chan round-trip within one task (no park)", r1, 30)
    r2 <- with_scope(\s -> backpressure(s))
    assert_eq(state, "chan backpressure: producer send-parks, consumer drains FIFO", r2, 10)
    r3 <- with_scope(\s -> fan_in(s))
    assert_eq(state, "chan fan-in: three producers into one consumer", r3, 123)
    r4 <- with_scope(\s -> heap_rooting(s))
    assert_eq(state, "chan buffered heap values survive a GC storm (rooting oracle)", r4, "alphabeta200")
    r5 <- with_scope(\s -> fifo(s))
    assert_eq(state, "chan preserves FIFO order", r5, "abc")
    r6 <- with_scope(\s -> parked_recv_heap_driver(s))
    assert_eq(state, "handed-off heap value survives GC via a parked receiver's chan_pending", r6, "hello300")
    r7 <- with_scope(\s -> sendpark_heap(s))
    assert_eq(state, "send-parked heap values drain in order under GC", r7, "v1v2v3")
    r8 <- with_scope(\s -> nested_use(s))
    assert_eq(state, "outer-scope channel is usable by a task of a nested scope", r8, 5)
    h1 <- with_scope(\s -> huge_capacity(s, 2305843009213693952))
    assert_true(state, "capacity 2^61: creating it costs nothing, 40 sends buffer and drain in order", h1)
    h2 <- with_scope(\s -> huge_capacity(s, 9223372036854775807))
    assert_true(state, "capacity Int max: creating it costs nothing, 40 sends buffer and drain in order", h2)
    g1 <- with_scope(\s -> grow_wrapped(s))
    assert_true(state, "buffer growth on a wrapped ring keeps FIFO order", g1)
    g2 <- with_scope(\s -> bound_after_growth(s))
    assert_eq(state, "send past a grown buffer's bound parks until a consumer drains it", g2, (true, true))
    g3 <- with_scope(\s -> grow_heap_strings(s))
    assert_eq(state, "heap strings buffered across growth come back intact", g3, "s1,s2,s3,s4,s5,s6,s7,s8,s9,s10,s11,s12,s13,s14,s15,s16,s17,s18,s19,s20,s21,s22,s23,s24,s25,s26,s27,s28,s29,s30,s31,s32,s33,s34,s35,s36,s37,s38,s39,s40,")
    g4 <- with_scope(\s -> grow_heap_lists(s))
    assert_eq(state, "heap lists buffered across growth come back intact", g4, 6009012)
    n1 <- with_scope(\s -> negative_capacity_value(s))
    assert_eq(state, "chan_new with a negative capacity is Err (ChanNegativeCapacity n)", n1, -1)
    n2 <- with_scope(\s -> negative_capacity_message(s))
    assert_eq(state, "chan_error_message names the bad capacity", n2, "channel capacity must be >= 0 (0 = rendezvous / unbuffered), got -1")
    summary(state)
