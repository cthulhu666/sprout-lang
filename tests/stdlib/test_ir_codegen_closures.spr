import stdlib.test (TestState, new_state, assert_eq, assert_true, assert_false, summary)
import stdlib.compiler.sprout_ir as sprout_ir
import stdlib.compiler.ir_lowering as ir_lowering
import stdlib.compiler.ir_rooting as ir_rooting
import stdlib.compiler.lexer as lexer
import stdlib.compiler.parser as parser
import stdlib.compiler.checker as checker
import stdlib.compiler.lowering as lowering
import stdlib.compiler.ast_to_ir as ast_to_ir
import stdlib.compiler.typed_ast as typed_ast

# Tests for Milestone 2, PR 2.4: lambda lifting + closure emission.
# See docs/gc-rooting-model-c-plan-2026-06-02.md.
#
# Exercises:
#   - TLambda -> IRMkClosure + lifted IRFunction (__sprout_ir_lambda_<N>)
#   - Closure call via IRApplyClosure when callee is a param of function type
#   - Free-variable capture (captured vars become IRLoadEnvSlot in lifted body)
#   - Partial application -> Err (deferred)

fn contains(haystack: String, needle: String) -> Bool =
  str_find(haystack, needle) != -1

# Drive a Sprout source string through lex -> parse -> typecheck -> lower ->
# ast_to_ir.translate_program.  Returns the translator's Result.
# Mirrors translate_source in test_ir_codegen_ctors.spr.
fn translate_source(src: String) -> Result String String !{IO} =
  match lexer.tokenize(src) with
  | Err _ -> Err("lex error")
  | Ok toks ->
      match parser.parse_program(toks) with
      | Err _ -> Err("parse error")
      | Ok prog ->
          do
            tc <- checker.typecheck_typed(prog, Nil)
            match tc with
            | typed_ast.TypedErr msg -> Err("check: " ++ msg)
            | typed_ast.TypedOk typed_prog env ->
                match lowering.lower_program(typed_prog, env) with
                | lowering.LowerErr msg -> Err("lower: " ++ msg)
                | lowering.LowerOk lowered ->
                    match ast_to_ir.translate_program(lowered) with
                    | Err msg -> Err(msg)
                    | Ok pair ->
                        match pair with
                        | (ir_prog, idx_map) ->
                            Ok(ir_lowering.lower_program(ir_rooting.insert_roots(ir_prog, idx_map)))

fn translated_err_contains(src: String, needle: String) -> Bool !{IO} =
  match translate_source(src) with
  | Err msg -> str_find(msg, needle) != -1
  | Ok _ -> false

fn translated_ok_ir_contains(src: String, needle: String) -> Bool !{IO} =
  match translate_source(src) with
  | Ok ir -> str_find(ir, needle) != -1
  | Err _ -> false

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # Note: Sprout function-typed param annotations use polymorphic vars (e.g.
    # `pred: a -> Bool`) — monomorphic `Int -> Int` does not parse as a top-level
    # param annotation. Tests below use polymorphic shapes that match prelude
    # conventions. Lowering still asserts on the SSA-level LLVM substring.

    # T1: A lambda lifted into a synthetic function gets named __sprout_ir_lambda_<N>.
    # The @__sprout_ir_lambda_ prefix should appear in the emitted LLVM.
    t1 <- translated_ok_ir_contains(
      "fn mk() -> (a -> a) = \\x -> x",
      "@__sprout_ir_lambda_")
    assert_true(state, "T1: lambda lifts to @__sprout_ir_lambda_ function", t1)

    # T2: Closure call via a lambda-bound param. Outer lambda takes `f` (an
    # inner lambda), body calls f(5). Body of outer lambda emits IRApplyClosure
    # -> lowering includes "load ptr, ptr" (the indirect-call code-ptr load).
    t2 <- translated_ok_ir_contains(
      "fn compose() -> Int = (\\f -> f(5))(\\x -> x + 1)",
      "load ptr, ptr")
    assert_true(state, "T2: closure-call body emits load ptr (indirect call setup)", t2)

    # T3: Capturing IIFE — inner lambda captures outer fn's param `n`.
    # `(\\x -> x + n)(7)` lifts the lambda, captures n, applies it.
    t3 <- translated_ok_ir_contains(
      "fn outer(n: Int) -> Int = (\\x -> x + n)(7)",
      "@__sprout_ir_lambda_")
    assert_true(state, "T3: capturing IIFE lifts to @__sprout_ir_lambda_", t3)

    # T4: Capturing lambda emits sprout_alloc_closure_env at the IRMkClosure
    # site (call into the runtime to allocate the env+captures heap block).
    t4 <- translated_ok_ir_contains(
      "fn outer(n: Int) -> Int = (\\x -> x + n)(7)",
      "@sprout_alloc_closure_env")
    assert_true(state, "T4: capturing lambda calls sprout_alloc_closure_env", t4)

    # T5: Directly-applied lambda (IIFE): (\x -> x + 1)(5).
    # translate_call's TLambda case lifts then immediately applies — output
    # should still contain @__sprout_ir_lambda_ (the lifted body).
    t5 <- translated_ok_ir_contains(
      "fn iife() -> Int = (\\x -> x + 1)(5)",
      "@__sprout_ir_lambda_")
    assert_true(state, "T5: directly applied lambda lifts to @__sprout_ir_lambda_", t5)

    # T6: Regression — capturing lambda must emit env-slot LOADs in the lifted
    # body. Slot 0 is the code pointer; captured values live at slots 1..N.
    # The lowered IR for IRLoadEnvSlot contains `getelementptr i64, ptr` for
    # the slot-pointer computation. Bug fixed 2026-06-05: subagent's initial
    # implementation treated outer fn's params as `bound`, excluding them
    # from compute_free_vars and breaking capture.
    t6 <- translated_ok_ir_contains(
      "fn outer(n: Int) -> Int = (\\x -> x + n)(7)",
      "getelementptr i64, ptr")
    assert_true(state, "T6: capturing lambda emits env-slot GEP for the load", t6)

    # T7: Finding #1 — idx_map collision: rooting pass starts fresh names at
    # idx=0 for lifted lambdas not in idx_map, colliding with %t0..%t(n_caps-1)
    # emitted by IRLoadEnvSlot. A capturing lambda whose body has a GC-trigger
    # (str_concat) must NOT emit "%t0 = alloca" — that would shadow the
    # IRLoadEnvSlot %t0 = inttoptr. Assert no such alloca appears.
    t7 <- translated_ok_ir_contains(
      "fn f(s: String) -> String = (\\x -> str_concat(x, s))(\"!\")",
      "%t0 = alloca i64")
    assert_false(state, "T7: rooting pass must not allocate %t0 alloca in lifted lambda body (would collide with IRLoadEnvSlot %t0)", t7)

    # T8: Finding #5 — TVar-typed higher-order function argument. A function
    # that takes a polymorphic fn-typed parameter and applies it twice should
    # translate to Ok, not fail with "must be Int or String". Verifies
    # is_supported_arg_type accepts TFunc (or resolved TVar -> TFunc).
    t8 <- translated_ok_ir_contains(
      "fn twice_then(g: a -> a, x: a) -> a = g(g(x))",
      "load ptr, ptr")
    assert_true(state, "T8: polymorphic fn-typed arg (a -> a) accepted by translator (no TVar rejection)", t8)

    # T9: Finding #6 — is_supported_arg_type widening must not leak to direct
    # calls. Passing a closure (fn-typed) to a direct-call site expecting Int
    # should be rejected. Latent — fix the source if Sprout typechecker changes.
    # Currently the typechecker enforces the type mismatch, so we assert Err.
    t9 <- translated_err_contains(
      "fn id(x: Int) -> Int = x\nfn bad(c: a -> a) -> Int = id(c)",
      "check:")
    assert_true(state, "T9: closure arg passed to Int-expecting direct call is rejected (typechecker or translator)", t9)

    # T10: Finding #10 — name collision guard. A user-defined function named
    # ir_lambda_0 coexists with a lifted lambda in another function; the
    # synthesized lambda uses @__sprout_ir_lambda_ (distinct prefix), so no
    # LLVM symbol collision occurs. Assert the LLVM still contains the user's
    # ir_lambda_0 define (the guard did not accidentally suppress it).
    t10 <- translated_ok_ir_contains(
      "fn ir_lambda_0(x: Int) -> Int = x\nfn lifter() -> Int = (\\y -> y + 1)(5)",
      "define i64 @ir_lambda_0(")
    assert_true(state, "T10: user function named ir_lambda_0 still appears in LLVM (name-collision check — synthesized lambda must use a distinct name)", t10)

    # T11: CRITICAL — env param collision. A lambda whose param is named `env`
    # would produce two params both called `env` in the lifted IRFunction (the
    # implicit closure-env pointer and the user param). LLVM rejects duplicate
    # SSA names. The fix renames the implicit env-pointer param to `env$` (a
    # name that source-Sprout cannot tokenize). After the fix the lowered LLVM
    # must contain `%env$` for the implicit slot and `%env` for the user param.
    t11 <- translated_ok_ir_contains(
      "fn f() -> Int = (\\env -> env + 1)(5)",
      "%env$")
    assert_true(state, "T11: lambda param named env does not collide with implicit env ptr (implicit slot renamed to %env$)", t11)

    # T12: CRITICAL — extern guard bypass. The __sprout_ reservation prefix check
    # only fires for TFnDecl. A user `extern fn __sprout_ir_lambda_0` slips
    # through and collides with a synthesized lifted function. After the fix,
    # translate_program must return Err mentioning the reserved prefix.
    t12 <- translated_err_contains(
      "extern fn __sprout_ir_lambda_0(x: Int) -> Int\nfn lifter() -> Int = (\\y -> y + 1)(5)",
      "__sprout_")
    assert_true(state, "T12: extern fn with __sprout_ prefix rejected by translate_program (reserved namespace guard)", t12)

    summary(state)
