import stdlib.test (check_true, run_suite)

# Derived Ord calls `compare` on the constructor indexes. A module-level `compare` of the
# same type, reversed, must not reach it: the bundler qualifies the user's to `main.compare`,
# so derived code still gets the class method and the order stays by declaration.

fn compare(a: Int, b: Int) -> Int = b - a

type Rank (..) deriving (Eq, Ord) =
  | Low
  | Mid
  | High

fn main() -> Unit !{IO} =
  run_suite("deriving_ord_shadow", [
    check_true("Low < High", ord_lt(Low, High)),
    check_true("High > Mid", ord_gt(High, Mid)),
    check_true("Mid <= Mid", ord_lte(Mid, Mid)),
    check_true("the local compare is still the reversed one", compare(1, 2) == 1)
  ])
