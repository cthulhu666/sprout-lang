import stdlib.test (TestState, new_state, assert_eq, summary)

# Records v0 — construction + field access (dot, Scope A variable chains).
# Surface fixed by docs/records-v0.md:
#   declaration   type P = (x: Int, y: Int)     ( ':' = has-type )
#   construction  P(x = v, y = v)                ( '=' = has-value, tag-prefixed )
#   access        p.x                            ( resolver rule; total, no Maybe )
#
# `with` update and error-message/parametric coverage land in later PRs.

type Point = (x: Int, y: Int)
type Line = (from: Point, to: Point)

fn origin() -> Point = Point(x = 0, y = 0)

fn get_x(p: Point) -> Int = p.x

fn get_y(p: Point) -> Int = p.y

fn manhattan(p: Point) -> Int = p.x + p.y

# Chained access: head is a bare variable (Scope A), so `l.from.x` resolves as
# GetField(GetField(l, from), x).
fn line_from_x(l: Line) -> Int = l.from.x

fn line_to_y(l: Line) -> Int = l.to.y

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # Construction + direct field access.
    assert_eq(state, "access x of Point(3, 4)", get_x(Point(x = 3, y = 4)), 3)
    assert_eq(state, "access y of Point(3, 4)", get_y(Point(x = 3, y = 4)), 4)
    assert_eq(state, "origin().x is 0", get_x(origin()), 0)

    # Field access composes with arithmetic.
    assert_eq(state, "manhattan(3, 4) = 7", manhattan(Point(x = 3, y = 4)), 7)

    # Chained access through a nested record.
    assert_eq(state, "l.from.x", line_from_x(Line(from = Point(x = 5, y = 6), to = Point(x = 7, y = 8))), 5)
    assert_eq(state, "l.to.y", line_to_y(Line(from = Point(x = 5, y = 6), to = Point(x = 7, y = 8))), 8)

    summary(state)
