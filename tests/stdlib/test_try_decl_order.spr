import stdlib.test (check_eq, run_suite)

# A fused `try` uses the instance's failure arm, which calls `tagged`. Here
# `tagged` is unannotated and declared after its users, and `first`, a `try` on
# a Maybe, is used by `tagged` at two types: neither may change how the program
# is typed compared with the call to `branch` it stands for.

type Outcome a =
  | Good a
  | Bad String

instance Propagate Outcome
  fn branch(value: Outcome a) -> ControlFlow (Outcome b) a =
    match value with
    | Good v -> Continue(v)
    | Bad s -> Break(tagged(s))

fn bump(o: Outcome Int) -> Outcome Int =
  let v = try o
  in Good(v + 1)

fn shout(o: Outcome String) -> Outcome String =
  let s = try o
  in Good(s ++ "!")

fn first(m) =
  let v = try m
  in Just(v)

fn tagged(s) =
  if first(Just(1)) == Just(1) && first(Just("a")) == Just("a") then Bad("tagged: " ++ s) else Bad(s)

fn text(o: Outcome a) -> String where ToString a =
  match o with
  | Good v -> `good ${v}`
  | Bad s -> `bad ${s}`

fn main() -> Unit !{IO} =
  run_suite("try declaration order", [
    check_eq("int success", text(bump(Good(1))), "good 2"),
    check_eq("int failure", text(bump(Bad("x"))), "bad tagged: x"),
    check_eq("string success", text(shout(Good("hi"))), "good hi!"),
    check_eq("string failure", text(shout(Bad("y"))), "bad tagged: y"),
    check_eq("maybe at two types", first(Just(true)), Just(true))
  ])
