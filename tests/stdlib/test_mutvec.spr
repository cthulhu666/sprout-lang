import stdlib.test (TestState, new_state, assert_eq, assert_true, summary)
import stdlib.mutable (MutVec, mutvec_new, mutvec_at, mutvec_set, mutvec_len, mutvec_each, mutvec_fold, mutvec_zip_fold, mutvec_map_inplace)

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # mutvec_new: all slots initialised to fill value
    v <- mutvec_new(5, 42)
    v0 <- mutvec_at(v, 0)
    v4 <- mutvec_at(v, 4)
    assert_eq(state, "mutvec_new fill slot 0", v0, 42)
    assert_eq(state, "mutvec_new fill slot 4", v4, 42)

    # mutvec_set: targeted write does not disturb other slots
    mutvec_set(v, 2, 99)
    a0 <- mutvec_at(v, 0)
    a2 <- mutvec_at(v, 2)
    a4 <- mutvec_at(v, 4)
    assert_eq(state, "mutvec_set target slot", a2, 99)
    assert_eq(state, "mutvec_set untouched slot 0", a0, 42)
    assert_eq(state, "mutvec_set untouched slot 4", a4, 42)

    # mutvec_set: overwrite same slot again
    mutvec_set(v, 2, 7)
    b2 <- mutvec_at(v, 2)
    assert_eq(state, "mutvec_set overwrite", b2, 7)

    # mutvec_at: unchecked direct read (no Maybe) agrees with mutvec_get in-bounds
    at2 <- mutvec_at(v, 2)
    at0 <- mutvec_at(v, 0)
    assert_eq(state, "mutvec_at reads written slot", at2, 7)
    assert_eq(state, "mutvec_at reads fill slot", at0, 42)

    # two independent MutVecs do not alias each other
    p <- mutvec_new(3, 0)
    q <- mutvec_new(3, 0)
    mutvec_set(p, 1, 100)
    q1 <- mutvec_at(q, 1)
    assert_eq(state, "mutvec no alias between vecs", q1, 0)

    # large allocation (10000 elements — same size as astar arrays)
    big <- mutvec_new(10000, 9999999)
    big0 <- mutvec_at(big, 0)
    big9999 <- mutvec_at(big, 9999)
    assert_eq(state, "mutvec_new large fill slot 0", big0, 9999999)
    assert_eq(state, "mutvec_new large fill slot 9999", big9999, 9999999)
    mutvec_set(big, 5000, 1)
    bigmid <- mutvec_at(big, 5000)
    bigadj <- mutvec_at(big, 4999)
    assert_eq(state, "mutvec_set large mid slot", bigmid, 1)
    assert_eq(state, "mutvec_set large adjacent untouched", bigadj, 9999999)

    assert_eq(state, "mutvec_len reports fixed length", mutvec_len(v), 5)

    seen <- mutvec_new(1, 0)
    _ <- mutvec_each(\x -> add_into(seen, x), v)
    seen_total <- mutvec_at(seen, 0)
    assert_eq(state, "mutvec_each visits each element in order", seen_total, 42 + 42 + 7 + 42 + 42)

    folded <- mutvec_fold(\ (acc, x) -> acc * 10 + x, 0, v)
    assert_eq(state, "mutvec_fold preserves order", folded, 463162)

    left <- mutvec_new(4, 0)
    right <- mutvec_new(2, 0)
    mutvec_set(left, 0, 2)
    mutvec_set(left, 1, 3)
    mutvec_set(left, 2, 5)
    mutvec_set(left, 3, 7)
    mutvec_set(right, 0, 11)
    mutvec_set(right, 1, 13)
    zipped <- mutvec_zip_fold(\ (acc, x, y) -> acc + x * y, 0, left, right)
    assert_eq(state, "mutvec_zip_fold stops at shorter input", zipped, 61)

    _ <- mutvec_map_inplace(\x -> x * 2, right)
    r0 <- mutvec_at(right, 0)
    r1 <- mutvec_at(right, 1)
    assert_eq(state, "mutvec_map_inplace updates slot 0", r0, 22)
    assert_eq(state, "mutvec_map_inplace updates slot 1", r1, 26)

    empty <- mutvec_new(0, 123)
    assert_eq(state, "mutvec_len empty", mutvec_len(empty), 0)
    empty_fold <- mutvec_fold(\ (acc, x) -> acc + x, 17, empty)
    assert_eq(state, "mutvec_fold empty returns init", empty_fold, 17)
    empty_zip <- mutvec_zip_fold(\ (acc, x, y) -> acc + x * y, 23, empty, right)
    assert_eq(state, "mutvec_zip_fold empty returns init", empty_zip, 23)
    _ <- mutvec_each(\x -> add_into(seen, x), empty)
    after_empty_each <- mutvec_at(seen, 0)
    assert_eq(state, "mutvec_each empty is no-op", after_empty_each, seen_total)
    _ <- mutvec_map_inplace(\x -> x * 2, empty)

    summary(state)

fn add_into(cell: MutVec Int, x: Int) -> Unit !{IO} =
  do
    cur <- mutvec_at(cell, 0)
    mutvec_set(cell, 0, cur + x)
