import stdlib.test (check_eq, run_suite)
import stdlib.http_server (HttpRequest, HttpServerError, HttpInvalidRequest, HttpServerUnsupportedStatus, parse, request_method, request_path, request_body)

# Regression: a header-less request (request line immediately followed by the blank
# line) used to abort in str_slice — parse_request_prefix sliced a NEGATIVE header-
# block length (headers_end == line_end). HTTP/1.0 permits no headers, so the parser
# must accept it as an empty-header request, not crash. On the unfixed parser the
# `header-less` case aborts the whole test binary (str_slice: length must be >= 0).

fn describe(r: Result HttpServerError HttpRequest) -> String =
  match r with
  | Ok req -> `${request_method(req)} ${request_path(req)} body=${body_text(req)}`
  | Err e -> describe_err(e)

# The body is `Bytes`, so decoding is the caller's step and can fail. Rendering the failure inline
# keeps every check below a single string comparison, and makes the decode boundary visible: framing
# succeeded (the request parsed) while decoding did not.
fn body_text(req: HttpRequest) -> String =
  match request_body(req) with
  | Ok text -> text
  | Err _ -> "<not-utf8>"

fn describe_err(e: HttpServerError) -> String =
  match e with
  | HttpInvalidRequest msg -> `Err ${msg}`
  | HttpServerUnsupportedStatus code -> `Err status ${int_to_string(code)}`
  # `parse` works on an already-read String, so it can never produce this — a timeout can only come
  # from the read path (see tests/task_io_smoke/http_idle_timeout.spr). Named anyway: the
  # exhaustiveness checker is what made this file the first thing to notice the new variant.
  | HttpRequestTimeout -> "Err request timeout"
  | HttpHeadersTooLarge -> "Err headers too large"
  | HttpBodyTooLarge -> "Err body too large"

fn main() -> Unit !{IO} =
  run_suite("http_server_parse", [
    # The regression case: no headers at all.
    check_eq("header-less request parses to empty-header request",
      describe(parse("GET / HTTP/1.1\r\n\r\n")), "GET / body="),
    # Contrast: the normal path with headers + a body still parses.
    check_eq("request with headers + body",
      describe(parse("POST /x HTTP/1.1\r\nHost: h\r\nContent-Length: 3\r\n\r\nabc")),
      "POST /x body=abc"),
    # Multiple headers before the body — exercises parse_header_line across several
    # lines and the body-offset computation (request_body_start).
    check_eq("request with multiple headers + body",
      describe(parse("POST /y HTTP/1.1\r\nHost: h\r\nX-Tag: v\r\nContent-Length: 5\r\n\r\nhello")),
      "POST /y body=hello"),
    # A structurally invalid request (no header terminator) is still a clean Err.
    check_eq("missing terminator is a clean Err",
      describe(parse("GET / HTTP/1.1\r\n")), "Err missing header terminator"),

    # Regression (concurrency review C5): `Content-Length` is denominated in BYTES, but the body
    # was framed with string.length / string.take / string.drop, which are all denominated in
    # CODEPOINTS. Every test above uses an ASCII body, where the two index spaces coincide — which
    # is exactly why the mixing survived. `café` is 5 bytes and 4 codepoints, so it separates them.
    #
    # Under-read: 4 codepoints < 5 bytes, so the parser declared a complete body short.
    check_eq("multi-byte body framed by bytes, not codepoints",
      describe(parse("POST /x HTTP/1.1\r\nContent-Length: 5\r\n\r\ncafé")),
      "POST /x body=café"),
    # Over-read, the same bug in the other direction and the one that matters for keep-alive:
    # taking 5 CODEPOINTS of a 6-byte body swallows the trailing `!`, which on a pipelined
    # connection is the first byte of the NEXT request rather than part of this body.
    check_eq("body stops at the byte count, leaving trailing bytes alone",
      describe(parse("POST /x HTTP/1.1\r\nContent-Length: 5\r\n\r\ncafé!")),
      "POST /x body=café"),
    # A byte count that falls INSIDE a multi-byte sequence: the client announced 4 bytes of a 5-byte
    # character. This CHANGED when the body became `Bytes` — it used to be a parse-time 400 ("request
    # body is not valid UTF-8"), and is now a successful parse whose DECODE fails. That is the honest
    # split: the framing was exactly what the client asked for, so parsing succeeds; the bytes are not
    # text, so `request_body` reports it. A binary endpoint reading `request_body_bytes` gets its 4
    # bytes and is no longer refused on a text assumption it never made.
    check_eq("a byte count splitting a codepoint parses but does not decode",
      describe(parse("POST /x HTTP/1.1\r\nContent-Length: 4\r\n\r\ncafé")),
      "POST /x body=<not-utf8>"),
    # Multi-byte text in a HEADER value shifts every codepoint index after it, so the body offset
    # must be derived in bytes too — not just the body length.
    check_eq("multi-byte header value does not shift the body offset",
      describe(parse("POST /x HTTP/1.1\r\nX-Note: café\r\nContent-Length: 3\r\n\r\nabc")),
      "POST /x body=abc"),
    # The REQUEST LINE goes through http.parse_request_line, which pairs `str_find` with `str_slice`.
    # Both are codepoint-indexed (str_find converts its byte offset to a codepoint count before
    # returning), so the pairing is consistent — this pins that, since on an ASCII path the two index
    # spaces are indistinguishable. A raw UTF-8 path is what a browser sends before percent-encoding.
    check_eq("multi-byte path parses and does not shift the version",
      describe(parse("GET /café HTTP/1.1\r\n\r\n")), "GET /café body="),
    # The sharpest test of the body-offset derivation: a multi-byte PATH makes the header region's
    # codepoint and byte indices genuinely diverge (`/日本` is 3 codepoints and 7 bytes), so the body
    # offset can only be right if it is derived as `byte_length(take(raw, body_start))` rather than by
    # assuming `body_start` is already a byte count. `café` is 5 bytes.
    check_eq("multi-byte path with a body keeps both intact",
      describe(parse("POST /日本 HTTP/1.1\r\nContent-Length: 5\r\n\r\ncafé")),
      "POST /日本 body=café")
  ])
