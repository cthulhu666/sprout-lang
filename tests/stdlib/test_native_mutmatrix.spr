import stdlib.test (TestState, new_state, assert_eq, assert_true, summary)
import stdlib.mutable (MutVec, MutMatrix, mutvec_new, mutvec_at, mutvec_set, mutmatrix_new, mutmatrix_get, mutmatrix_at, mutmatrix_at_or, mutmatrix_set, mutmatrix_rows, mutmatrix_cols, mutmatrix_fold, mutmatrix_fill, mutmatrix_row_zip_fold, mutmatrix_row_zip_update, mutmatrix_row_dot, mutmatrix_row_sub_scaled_inplace, mutmatrix_row_add_scaled_into)

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    m <- mutmatrix_new(2, 3, 0)
    assert_eq(state, "mutmatrix_rows", mutmatrix_rows(m), 2)
    assert_eq(state, "mutmatrix_cols", mutmatrix_cols(m), 3)

    # set/get roundtrip at (1, 2)
    _ <- mutmatrix_set(m, 1, 2, 42)
    got <- mutmatrix_at(m, 1, 2)
    assert_eq(state, "set/get roundtrip", got, 42)

    # distinct cells addressed independently (row-major)
    _ <- mutmatrix_set(m, 0, 0, 7)
    _ <- mutmatrix_set(m, 1, 0, 9)
    a <- mutmatrix_at(m, 0, 0)
    b <- mutmatrix_at(m, 1, 0)
    assert_eq(state, "independent cell (0,0)", a, 7)
    assert_eq(state, "independent cell (1,0)", b, 9)

    # bounds: an out-of-range COLUMN must return Nothing, not silently read the
    # adjacent row (raw r*cols+c delegation would return cell (1,0) here).
    assert_true(state, "col overflow returns Nothing",
      match mutmatrix_get(m, 0, 3) with | Nothing -> true | Just _ -> false)
    assert_true(state, "row overflow returns Nothing",
      match mutmatrix_get(m, 2, 0) with | Nothing -> true | Just _ -> false)

    folded <- mutmatrix_fold(\ (acc, x) -> acc * 10 + x, 0, m)
    assert_eq(state, "mutmatrix_fold visits row-major", folded, 700942)

    _ <- mutmatrix_fill(\ (r, c) -> r * 10 + c, m)
    f00 <- mutmatrix_at(m, 0, 0)
    f02 <- mutmatrix_at(m, 0, 2)
    f10 <- mutmatrix_at(m, 1, 0)
    f12 <- mutmatrix_at(m, 1, 2)
    assert_eq(state, "mutmatrix_fill writes (0,0)", f00, 0)
    assert_eq(state, "mutmatrix_fill writes (0,2)", f02, 2)
    assert_eq(state, "mutmatrix_fill writes (1,0)", f10, 10)
    assert_eq(state, "mutmatrix_fill writes (1,2)", f12, 12)

    v <- mutvec_new(4, 0)
    mutvec_set(v, 0, 2)
    mutvec_set(v, 1, 3)
    mutvec_set(v, 2, 5)
    mutvec_set(v, 3, 7)
    row_dot <- mutmatrix_row_zip_fold(\ (acc, cell, x) -> acc + cell * x, 0, m, 1, v)
    assert_eq(state, "mutmatrix_row_zip_fold stops at row width", row_dot, 10 * 2 + 11 * 3 + 12 * 5)

    bad_row_dot <- mutmatrix_row_zip_fold(\ (acc, cell, x) -> acc + cell * x, 99, m, 2, v)
    assert_eq(state, "mutmatrix_row_zip_fold invalid row returns init", bad_row_dot, 99)

    _ <- mutmatrix_row_zip_update(\ (cell, x) -> cell + x, m, 0, v)
    u00 <- mutmatrix_at(m, 0, 0)
    u01 <- mutmatrix_at(m, 0, 1)
    u02 <- mutmatrix_at(m, 0, 2)
    assert_eq(state, "mutmatrix_row_zip_update updates first cell", u00, 2)
    assert_eq(state, "mutmatrix_row_zip_update updates middle cell", u01, 4)
    assert_eq(state, "mutmatrix_row_zip_update updates last row-width cell", u02, 7)

    _ <- mutmatrix_row_zip_update(\ (cell, x) -> cell + x, m, -1, v)
    still00 <- mutmatrix_at(m, 0, 0)
    assert_eq(state, "mutmatrix_row_zip_update invalid row is no-op", still00, 2)

    empty <- mutmatrix_new(0, 3, 0)
    empty_fold <- mutmatrix_fold(\ (acc, x) -> acc + x, 31, empty)
    assert_eq(state, "mutmatrix_fold empty returns init", empty_fold, 31)
    _ <- mutmatrix_fill(\ (r, c) -> r + c, empty)
    empty_row <- mutmatrix_row_zip_fold(\ (acc, cell, x) -> acc + cell * x, 37, empty, 0, v)
    assert_eq(state, "mutmatrix_row_zip_fold empty invalid row returns init", empty_row, 37)
    _ <- mutmatrix_row_zip_update(\ (cell, x) -> cell + x, empty, 0, v)

    invalid <- mutmatrix_new(-2, -3, 5)
    invalid_fold <- mutmatrix_fold(\ (acc, x) -> acc + x, 41, invalid)
    assert_eq(state, "mutmatrix_fold negative dimensions returns init", invalid_fold, 41)
    fill_counter <- mutvec_new(1, 0)
    _ <- mutmatrix_fill(\ (r, c) -> mark_invalid_fill(fill_counter, r, c), invalid)
    fill_count <- mutvec_at(fill_counter, 0)
    assert_eq(state, "mutmatrix_fill negative dimensions is no-op", fill_count, 0)
    invalid_row <- mutmatrix_row_zip_fold(\ (acc, cell, x) -> acc + cell * x, 43, invalid, 0, v)
    assert_eq(state, "mutmatrix_row_zip_fold negative dimensions returns init", invalid_row, 43)
    # mutmatrix_row_dot: fused Double matvec kernel (seed + sum of m[r][i]*v[i], ascending i).
    # Values are exactly representable, so Double equality is deterministic. assert_true + ==
    # is used deliberately: assert_eq's ToString/Eq dispatch is a silent no-op on Double.
    dm <- mutmatrix_new(2, 3, 0.0)
    mutmatrix_set(dm, 0, 0, 1.0)
    mutmatrix_set(dm, 0, 1, 2.0)
    mutmatrix_set(dm, 0, 2, 3.0)
    mutmatrix_set(dm, 1, 0, 10.0)
    mutmatrix_set(dm, 1, 1, 20.0)
    mutmatrix_set(dm, 1, 2, 30.0)
    dv <- mutvec_new(3, 0.0)
    mutvec_set(dv, 0, 4.0)
    mutvec_set(dv, 1, 5.0)
    mutvec_set(dv, 2, 6.0)
    dot0 <- mutmatrix_row_dot(dm, 0, dv, 0.5)
    assert_true(state, "mutmatrix_row_dot row 0 seeded", dot0 == 32.5)
    dot1 <- mutmatrix_row_dot(dm, 1, dv, 0.0)
    assert_true(state, "mutmatrix_row_dot row 1 unseeded", dot1 == 320.0)
    bad_dot <- mutmatrix_row_dot(dm, 5, dv, 7.0)
    assert_true(state, "mutmatrix_row_dot invalid row returns seed", bad_dot == 7.0)
    short <- mutvec_new(2, 0.0)
    mutvec_set(short, 0, 4.0)
    mutvec_set(short, 1, 5.0)
    dot_short <- mutmatrix_row_dot(dm, 0, short, 0.0)
    assert_true(state, "mutmatrix_row_dot stops at shorter vector", dot_short == 14.0)

    # mutmatrix_row_sub_scaled_inplace: m[r][i] -= scale * v[i] (ascending i, in place).
    # dm row 0 is [1,2,3]; subtracting scale=2.0 * dv[0..2]=[4,5,6] -> [1-8, 2-10, 3-12].
    _ <- mutmatrix_row_sub_scaled_inplace(dm, 0, dv, 2.0)
    s00 <- mutmatrix_at(dm, 0, 0)
    s01 <- mutmatrix_at(dm, 0, 1)
    s02 <- mutmatrix_at(dm, 0, 2)
    assert_true(state, "row_sub_scaled cell (0,0)", s00 == 0.0 - 7.0)
    assert_true(state, "row_sub_scaled cell (0,1)", s01 == 0.0 - 8.0)
    assert_true(state, "row_sub_scaled cell (0,2)", s02 == 0.0 - 9.0)
    # row 1 untouched (still [10,20,30]).
    s10 <- mutmatrix_at(dm, 1, 0)
    assert_true(state, "row_sub_scaled leaves other rows", s10 == 10.0)
    # invalid row is a no-op.
    _ <- mutmatrix_row_sub_scaled_inplace(dm, 9, dv, 2.0)
    again10 <- mutmatrix_at(dm, 1, 0)
    assert_true(state, "row_sub_scaled invalid row no-op", again10 == 10.0)
    # stops at shorter vector: only cols 0,1 of row 1 updated by 'short'=[4,5].
    _ <- mutmatrix_row_sub_scaled_inplace(dm, 1, short, 1.0)
    t10 <- mutmatrix_at(dm, 1, 0)
    t11 <- mutmatrix_at(dm, 1, 1)
    t12 <- mutmatrix_at(dm, 1, 2)
    assert_true(state, "row_sub_scaled shorter updates col 0", t10 == 6.0)
    assert_true(state, "row_sub_scaled shorter updates col 1", t11 == 15.0)
    assert_true(state, "row_sub_scaled shorter leaves col 2", t12 == 30.0)

    # mutmatrix_row_add_scaled_into: dst[i] += scale * m[r][i] (ascending i, into dst).
    # This is the fused dhidden-accumulate kernel (dst += scale * W_row). A fresh matrix
    # km row 0 = [1,2,3], row 1 = [10,20,30]; kdst = [100,100,100].
    km <- mutmatrix_new(2, 3, 0.0)
    mutmatrix_set(km, 0, 0, 1.0)
    mutmatrix_set(km, 0, 1, 2.0)
    mutmatrix_set(km, 0, 2, 3.0)
    mutmatrix_set(km, 1, 0, 10.0)
    mutmatrix_set(km, 1, 1, 20.0)
    mutmatrix_set(km, 1, 2, 30.0)
    kdst <- mutvec_new(3, 100.0)
    # dst[i] += 2.0 * m[0][i] -> [100+2, 100+4, 100+6]. do-bind strips the Maybe, so the
    # bound value is the unwrapped Double; compare with == (assert_eq is a no-op on Double).
    _ <- mutmatrix_row_add_scaled_into(kdst, km, 0, 2.0)
    k0 <- mutvec_at(kdst, 0)
    k1 <- mutvec_at(kdst, 1)
    k2 <- mutvec_at(kdst, 2)
    assert_true(state, "row_add_scaled_into cell 0", k0 == 102.0)
    assert_true(state, "row_add_scaled_into cell 1", k1 == 104.0)
    assert_true(state, "row_add_scaled_into cell 2", k2 == 106.0)
    # invalid row is a no-op (dst unchanged).
    _ <- mutmatrix_row_add_scaled_into(kdst, km, 9, 5.0)
    k0b <- mutvec_at(kdst, 0)
    assert_true(state, "row_add_scaled_into invalid row no-op", k0b == 102.0)
    # stops at shorter dst: dst len 2 vs cols 3 -> only i=0,1 accumulate from row 1.
    kshort <- mutvec_new(2, 0.0)
    _ <- mutmatrix_row_add_scaled_into(kshort, km, 1, 1.0)
    ks0 <- mutvec_at(kshort, 0)
    ks1 <- mutvec_at(kshort, 1)
    assert_true(state, "row_add_scaled_into shorter dst col 0", ks0 == 10.0)
    assert_true(state, "row_add_scaled_into shorter dst col 1", ks1 == 20.0)

    # mutmatrix_at_or: non-allocating (no Maybe) bounds-checked read with a default. In-range must
    # return the element; out-of-range (either axis, negative or overflow) must return the default —
    # matching mutmatrix_get's bounds semantics but without allocating a Just per read.
    ao <- mutmatrix_new(2, 3, 0)
    mutmatrix_set(ao, 1, 2, 88)
    mutmatrix_set(ao, 0, 0, 5)
    in_elem <- mutmatrix_at_or(ao, 1, 2, -1)
    assert_eq(state, "mutmatrix_at_or in-range returns element", in_elem, 88)
    in_zero <- mutmatrix_at_or(ao, 0, 0, -1)
    assert_eq(state, "mutmatrix_at_or in-range distinct cell", in_zero, 5)
    col_of <- mutmatrix_at_or(ao, 0, 3, -1)
    assert_eq(state, "mutmatrix_at_or col overflow returns default", col_of, -1)
    row_of <- mutmatrix_at_or(ao, 2, 0, -1)
    assert_eq(state, "mutmatrix_at_or row overflow returns default", row_of, -1)
    neg <- mutmatrix_at_or(ao, -1, 0, -1)
    assert_eq(state, "mutmatrix_at_or negative index returns default", neg, -1)
    # Double matrix: the hot-path type in hydrology; exact values so == is safe.
    aod <- mutmatrix_new(2, 2, 0.0)
    mutmatrix_set(aod, 1, 1, 2.5)
    d_in <- mutmatrix_at_or(aod, 1, 1, 9.0)
    assert_true(state, "mutmatrix_at_or Double in-range", d_in == 2.5)
    d_of <- mutmatrix_at_or(aod, 5, 5, 9.0)
    assert_true(state, "mutmatrix_at_or Double OOB returns default", d_of == 9.0)

    summary(state)

fn mark_invalid_fill(counter: MutVec Int, r: Int, c: Int) -> Int !{IO} =
  do
    cur <- mutvec_at(counter, 0)
    _ <- mutvec_set(counter, 0, cur + 1)
    r + c
