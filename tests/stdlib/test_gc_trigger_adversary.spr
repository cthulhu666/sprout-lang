import stdlib.test (check_eq, run_suite)

# Termination workload for the GC trigger's footprint floor (`free=` under SPROUT_DEBUG_GC=1).
#
# Shape: 100,000 dead Wide slots no allocation reuses, a trickle of short-lived Wides so their
# class still has demand every cycle, and one Link kept per 2,000 rounds so the regions the churn
# bumps into are pinned and never released. A floor that counts free slots in classes with demand
# grows ~100,000 slots a cycle here; a damped floor settles.
#
# KNOWN ANSWER: the free pool stops growing. `just gc-trigger-check` asserts it.
# The assertions below only confirm the workload ran; the measurement is in the runtime counters.

type Wide (..) =
  | WEnd
  | Wide Int Int Int Int Int Wide

type Chain (..) =
  | End
  | Link Int Chain

fn build_sparse(n: Int, gap: Int, wides: Wide, keep: Chain) -> (Wide, Chain) =
  if n <= 0 then (wides, keep)
  else if gap <= 1 then build_sparse(n - 1, 64, Wide(n, 0, 0, 0, 0, wides), Link(n, keep))
  else build_sparse(n - 1, gap - 1, Wide(n, 0, 0, 0, 0, wides), keep)

fn wide_len(w: Wide, acc: Int) -> Int =
  match w with
  | Wide _ _ _ _ _ rest -> wide_len(rest, acc + 1)
  | WEnd -> acc

fn chain_len(c: Chain, acc: Int) -> Int =
  match c with
  | Link _ rest -> chain_len(rest, acc + 1)
  | End -> acc

fn build(n: Int, acc: Chain) -> Chain =
  if n <= 0 then acc
  else build(n - 1, Link(n, acc))

fn sparse_survivors(n: Int) -> (Int, Chain) =
  let (wides, keep) = build_sparse(n, 64, WEnd, End)
  in (wide_len(wides, 0), keep)

fn dead_wide(n: Int) -> Int = wide_len(Wide(n, 0, 0, 0, 0, WEnd), 0)

# `tick` counts down a 2,000-round period: a dead Wide halfway through, and at its end
# a dead Wide plus a Link kept for good.
fn churn(n: Int, tick: Int, keep: Chain, acc: Int) -> (Int, Chain) =
  if n <= 0 then (acc, keep)
  else
    let round = acc + chain_len(build(8, End), 0)
    in
    if tick == 1 then churn(n - 1, 2000, Link(n, keep), round + dead_wide(n))
    else if tick == 1001 then churn(n - 1, tick - 1, keep, round + dead_wide(n))
    else churn(n - 1, tick - 1, keep, round)

fn main() -> Unit !{IO} =
  let (wides_built, pins) = sparse_survivors(100000)
      (churned, kept) = churn(300000, 2000, End, 0)
      pins_after = chain_len(pins, 0)
      kept_after = chain_len(kept, 0)
  in
  run_suite("gc_trigger_adversary", [
    check_eq("all wides built", wides_built, 100000),
    check_eq("one pin per 64 wides survives the churn", pins_after, 1562),
    check_eq("one link kept per 2000 rounds", kept_after, 150),
    check_eq("churn walked every round", churned, 2400300)
  ])
