import stdlib.test (check_eq, run_suite)

# bigint-v0 Stage 1 (docs/bigint-v0.md §5.1's "parse_int stays total" carve-out):
# parse_int must return Nothing on an over-range digit run rather than wrapping
# (stdlib/prelude.sprout's accum_digits does `(acc * 10) + digit`, which wraps
# today). It must NOT panic — http_server.sprout parses Content-Length and
# json.sprout parses JSON numbers through it, both on network input.
fn describe(m: Maybe Int) -> String =
  match m with
  | Just n -> "Just " ++ int_to_string(n)
  | Nothing -> "Nothing"

# Int's minimum, spelled without a literal — see stdlib/math.sprout's min_int
# for the same idiom (the lexer historically could not write it directly).
fn min_int() -> Int = 0 - 9223372036854775807 - 1

fn main() -> Unit !{IO} =
  run_suite("parse_int_overflow", [
    check_eq("20-digit over-range = Nothing",
      describe(parse_int("99999999999999999999")), "Nothing"),
    check_eq("2^63 (one past INT_MAX) = Nothing",
      describe(parse_int("9223372036854775808")), "Nothing"),
    check_eq("INT_MAX itself still parses (boundary must not be off by one)",
      describe(parse_int("9223372036854775807")), "Just 9223372036854775807"),
    check_eq(
      "INT_MIN (negative boundary) still parses — a naive magnitude check " ++
        "that rejects 2^63 BEFORE applying the sign would wrongly reject this",
      describe(parse_int("-9223372036854775808")), describe(Just(min_int()))),
    check_eq("20-digit negative over-range = Nothing",
      describe(parse_int("-99999999999999999999")), "Nothing"),
    check_eq("ordinary parse_int 42 unaffected", describe(parse_int("42")), "Just 42"),
    check_eq("ordinary parse_int -7 unaffected", describe(parse_int("-7")), "Just -7"),
    check_eq("ordinary parse_int 0 unaffected", describe(parse_int("0")), "Just 0")
  ])
