import stdlib.test (TestState, new_state, assert_true, assert_eq, summary)
import stdlib.mutable (MutVec, MutMatrix, mutvec_new, mutvec_set, mutvec_get, mutvec_len, mutmatrix_new, mutmatrix_set, mutmatrix_get, mutmatrix_row_sub_scaled_inplace, mutmatrix_row_dot, mutmatrix_row_add_scaled_into)

# B1 codegen-optimization regression guard.
#
# Characterizes the concrete `Vector Double` fused kernels in stdlib/mutable.sprout:
# mutmatrix_row_sub_scaled_inplace, mutmatrix_row_dot, mutmatrix_row_add_scaled_into.
# The B1 optimization must not change these numeric results — this test is green now
# and must stay green after B1 lands (a characterization test, not a red-first TDD test).
#
# Shape choices that catch bugs:
#   * 2x3 matrices (rows != cols) with distinct per-cell values, so a row/col
#     transposition or an off-by-one in row_start = r*cols shows up as a wrong number.
#   * All literals are exactly representable in binary float (integers and halves) so
#     `==` on the Double results is deterministic — no rounding flakiness.
#
# Double assertion discipline: assert_eq is a SILENT no-op on Double (Eq/ToString
# dispatch does nothing), so every Double check uses assert_true(state, ..., x == y).
# Getters return `Maybe Double`; we `match` the call directly (never bind-then-match)
# so an index/bounds regression surfaces as `Nothing -> false` (a failing assert),
# not a silently short-circuited monad. assert_eq is used only for Int lengths.

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # -----------------------------------------------------------------------
    # Test 1: mutmatrix_row_sub_scaled_inplace — m[r][i] -= scale * v[i].
    #   m row 0 = [1, 2, 3], row 1 = [10, 20, 30];  v = [4, 5, 6];  scale = 2.0.
    #   row 0 -> [1 - 2*4, 2 - 2*5, 3 - 2*6] = [-7, -8, -9].  row 1 untouched.
    m1 <- mutmatrix_new(2, 3, 0.0)
    mutmatrix_set(m1, 0, 0, 1.0)
    mutmatrix_set(m1, 0, 1, 2.0)
    mutmatrix_set(m1, 0, 2, 3.0)
    mutmatrix_set(m1, 1, 0, 10.0)
    mutmatrix_set(m1, 1, 1, 20.0)
    mutmatrix_set(m1, 1, 2, 30.0)
    v1 <- mutvec_new(3, 0.0)
    mutvec_set(v1, 0, 4.0)
    mutvec_set(v1, 1, 5.0)
    mutvec_set(v1, 2, 6.0)
    assert_eq(state, "sub: vector length", mutvec_len(v1), 3)

    _ <- mutmatrix_row_sub_scaled_inplace(m1, 0, v1, 2.0)
    assert_true(state, "sub: row 0 col 0 = -7",
      match mutmatrix_get(m1, 0, 0) with | Just x -> x == 0.0 - 7.0 | Nothing -> false)
    assert_true(state, "sub: row 0 col 1 = -8",
      match mutmatrix_get(m1, 0, 1) with | Just x -> x == 0.0 - 8.0 | Nothing -> false)
    assert_true(state, "sub: row 0 col 2 = -9 (catches a col-index transposition)",
      match mutmatrix_get(m1, 0, 2) with | Just x -> x == 0.0 - 9.0 | Nothing -> false)
    # Row 1 must be untouched (row_start = r*cols must isolate row 0).
    assert_true(state, "sub: row 1 col 0 untouched (= 10)",
      match mutmatrix_get(m1, 1, 0) with | Just x -> x == 10.0 | Nothing -> false)
    assert_true(state, "sub: row 1 col 2 untouched (= 30)",
      match mutmatrix_get(m1, 1, 2) with | Just x -> x == 30.0 | Nothing -> false)

    # -----------------------------------------------------------------------
    # Test 2: mutmatrix_row_dot — seed + Σ m[r][i]*v[i], ascending i.
    #   Fresh m2 row 0 = [1, 2, 3], row 1 = [10, 20, 30];  v2 = [4, 5, 6].
    #   row 1, seed 0.5 -> 0.5 + (10*4 + 20*5 + 30*6) = 0.5 + 320 = 320.5.
    #   row 0, seed 0.0 -> 1*4 + 2*5 + 3*6 = 4 + 10 + 18 = 32.
    m2 <- mutmatrix_new(2, 3, 0.0)
    mutmatrix_set(m2, 0, 0, 1.0)
    mutmatrix_set(m2, 0, 1, 2.0)
    mutmatrix_set(m2, 0, 2, 3.0)
    mutmatrix_set(m2, 1, 0, 10.0)
    mutmatrix_set(m2, 1, 1, 20.0)
    mutmatrix_set(m2, 1, 2, 30.0)
    v2 <- mutvec_new(3, 0.0)
    mutvec_set(v2, 0, 4.0)
    mutvec_set(v2, 1, 5.0)
    mutvec_set(v2, 2, 6.0)

    dot1 <- mutmatrix_row_dot(m2, 1, v2, 0.5)
    assert_true(state, "dot: row 1 with seed 0.5 = 320.5", dot1 == 320.5)
    dot0 <- mutmatrix_row_dot(m2, 0, v2, 0.0)
    assert_true(state, "dot: row 0 with seed 0.0 = 32 (distinct from row 1)", dot0 == 32.0)
    # invalid row returns seed unchanged.
    bad <- mutmatrix_row_dot(m2, 9, v2, 7.0)
    assert_true(state, "dot: invalid row returns seed", bad == 7.0)

    # -----------------------------------------------------------------------
    # Test 3: mutmatrix_row_add_scaled_into — dst[i] += scale * m[r][i], ascending i.
    #   Fresh m3 row 0 = [1, 2, 3], row 1 = [10, 20, 30].
    #   dst prefilled with DISTINCT values [100, 200, 300];  scale = 3.0, row = 1.
    #   dst -> [100 + 3*10, 200 + 3*20, 300 + 3*30] = [130, 260, 390].
    m3 <- mutmatrix_new(2, 3, 0.0)
    mutmatrix_set(m3, 0, 0, 1.0)
    mutmatrix_set(m3, 0, 1, 2.0)
    mutmatrix_set(m3, 0, 2, 3.0)
    mutmatrix_set(m3, 1, 0, 10.0)
    mutmatrix_set(m3, 1, 1, 20.0)
    mutmatrix_set(m3, 1, 2, 30.0)
    dst <- mutvec_new(3, 0.0)
    mutvec_set(dst, 0, 100.0)
    mutvec_set(dst, 1, 200.0)
    mutvec_set(dst, 2, 300.0)

    _ <- mutmatrix_row_add_scaled_into(dst, m3, 1, 3.0)
    assert_true(state, "add_into: dst 0 = 100 + 3*10 = 130",
      match mutvec_get(dst, 0) with | Just x -> x == 130.0 | Nothing -> false)
    assert_true(state, "add_into: dst 1 = 200 + 3*20 = 260",
      match mutvec_get(dst, 1) with | Just x -> x == 260.0 | Nothing -> false)
    assert_true(state, "add_into: dst 2 = 300 + 3*30 = 390 (catches an off-by-one)",
      match mutvec_get(dst, 2) with | Just x -> x == 390.0 | Nothing -> false)
    # invalid row is a no-op (dst unchanged).
    _ <- mutmatrix_row_add_scaled_into(dst, m3, 9, 5.0)
    assert_true(state, "add_into: invalid row leaves dst 0 = 130",
      match mutvec_get(dst, 0) with | Just x -> x == 130.0 | Nothing -> false)

    summary(state)
