import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.math (abs)
import stdlib.linalg.vec3 (Vec3)
import stdlib.linalg.vec3

fn close(a: Double, b: Double) -> Bool = abs(a - b) < 0.000001

fn same(a: Vec3, b: Vec3) -> Bool = close(a.x, b.x) && close(a.y, b.y) && close(a.z, b.z)

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    let a = vec3.new(1.0, 2.0, 3.0)
    let b = vec3.new(4.0, 5.0, 6.0)
    let ex = vec3.new(1.0, 0.0, 0.0)
    let ey = vec3.new(0.0, 1.0, 0.0)
    let ez = vec3.new(0.0, 0.0, 1.0)
    let v345 = vec3.new(3.0, 4.0, 0.0)

    assert_true(state, "new components", close(a.x, 1.0) && close(a.y, 2.0) && close(a.z, 3.0))
    assert_true(state, "zero", same(vec3.zero, vec3.new(0.0, 0.0, 0.0)))
    assert_true(state, "add", same(vec3.add(a, b), vec3.new(5.0, 7.0, 9.0)))
    assert_true(state, "sub", same(vec3.sub(b, a), vec3.new(3.0, 3.0, 3.0)))
    assert_true(state, "neg", same(vec3.neg(a), vec3.new(-1.0, -2.0, -3.0)))
    assert_true(state, "scale", same(vec3.scale(2.0, a), vec3.new(2.0, 4.0, 6.0)))
    assert_true(state, "dot == 32", close(vec3.dot(a, b), 32.0))

    assert_true(state, "cross x*y = z", same(vec3.cross(ex, ey), ez))
    assert_true(state, "cross y*z = x", same(vec3.cross(ey, ez), ex))
    assert_true(state, "cross z*x = y", same(vec3.cross(ez, ex), ey))
    assert_true(state, "cross anti-commutes", same(vec3.cross(a, b), vec3.neg(vec3.cross(b, a))))
    assert_true(state, "cross a*b", same(vec3.cross(a, b), vec3.new(-3.0, 6.0, -3.0)))

    assert_true(state, "length_squared == 25", close(vec3.length_squared(v345), 25.0))
    assert_true(state, "length == 5", close(vec3.length(v345), 5.0))
    assert_true(state, "length of zero == 0", close(vec3.length(vec3.zero), 0.0))
    assert_true(state, "distance == 5", close(vec3.distance(vec3.new(1.0, 1.0, 1.0), vec3.new(4.0, 5.0, 1.0)), 5.0))

    assert_true(state, "normalize direction", same(vec3.normalize(v345), vec3.new(0.6, 0.8, 0.0)))
    assert_true(state, "normalized length == 1", close(vec3.length(vec3.normalize(v345)), 1.0))
    assert_true(state, "normalize zero is zero", same(vec3.normalize(vec3.zero), vec3.zero))

    assert_true(state, "to_string non-empty", to_string(a) != "")

    # values are immutable: a is unchanged by the ops above
    assert_true(state, "a unchanged", same(a, vec3.new(1.0, 2.0, 3.0)))

    summary(state)
