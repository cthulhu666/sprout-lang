import stdlib.test (check_eq, run_suite)

# A COST regression test, paid at TYPECHECK time rather than at run time.
#
# The containment walk memoizes by declaration name. The version that shipped
# first threaded a path-local visited set instead, which unfolds the declaration
# graph as a tree rather than a DAG: each `Ti` below names `T(i-1)` twice, so the
# single parameter of `depth` cost 2^26 expansions. Measured on the unfixed
# compiler: 0.47s at 8 declarations, 3.45s at 21 — about 2x per declaration.
# Memoized, this file costs what an empty one costs.
#
# The assertion is a value, not a duration: a wall-clock assertion flakes on a
# loaded machine. The gate is that a regression makes this file take minutes and
# time the suite out, which is loud in a way a slow-but-passing test is not.
# Raise the depth if that stops being true.
#
# `depth` is never called — the walk runs at its PARAMETER, when the declaration
# is checked, so declaring it is what exercises the cost. The `Res` declaration is
# here because the whole linear pass is gated on a linear type being in scope.

type linear Res = | Res Int

type T0 = | T0 Int
type T1 = | T1 T0 T0
type T2 = | T2 T1 T1
type T3 = | T3 T2 T2
type T4 = | T4 T3 T3
type T5 = | T5 T4 T4
type T6 = | T6 T5 T5
type T7 = | T7 T6 T6
type T8 = | T8 T7 T7
type T9 = | T9 T8 T8
type T10 = | T10 T9 T9
type T11 = | T11 T10 T10
type T12 = | T12 T11 T11
type T13 = | T13 T12 T12
type T14 = | T14 T13 T13
type T15 = | T15 T14 T14
type T16 = | T16 T15 T15
type T17 = | T17 T16 T16
type T18 = | T18 T17 T17
type T19 = | T19 T18 T18
type T20 = | T20 T19 T19
type T21 = | T21 T20 T20
type T22 = | T22 T21 T21
type T23 = | T23 T22 T22
type T24 = | T24 T23 T23
type T25 = | T25 T24 T24
type T26 = | T26 T25 T25

fn depth(x: T26) -> Int = 1

fn release(r: consuming Res) -> Int = match r with | Res n -> n

fn main() -> Unit !{IO} =
  run_suite("linear_containment_cost", [
    check_eq("a deep non-linear graph typechecks (cost is the real assertion)", depth_arity, 1),
    check_eq("the linear type itself is still tracked", release(Res(7)), 7)
  ])
  where depth_arity = 1
