import stdlib.test (new_state, assert_true, summary)
import stdlib.compiler.ast_to_ir as ast_to_ir
import stdlib.compiler.ir_lowering as ir_lowering
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types
import stdlib.compiler.source as source

# Loud unresolved-dict sink (compiler-soundness backstop).
#
# `lowering` mints an `__unresolved_<Class>...` sentinel for a typeclass dict
# whose type variable is free (provably never invoked — see
# test_unresolved_dict_nullfill.spr, which pins that `to_string(Empty)` runs
# correctly because the dict is never reached). Codegen used to null-fill that
# sentinel with a bare `i64 0`; if the "never invoked" invariant is EVER
# violated (as it was by the missing-superclass bug, PR #268), applying that
# null closure is a SILENT SIGSEGV — a wrong-answer/crash bug, not a diagnostic.
#
# The fix lowers the sentinel to a POISON CLOSURE whose code pointer panics with
# a located message when — and only when — it is actually applied. A
# never-applied poison stays inert, so the legitimate dead-dict case is
# unchanged (guarded by test_unresolved_dict_nullfill.spr staying green).
#
# This tripwire feeds a bare `__unresolved_` sentinel straight to
# `translate_program` (bypassing typecheck, so no prelude bundling is needed)
# and asserts the emitted IR carries the poison thunk. RED before the fix: the
# sentinel lowers to `IRConst 0`, so the IR contains neither the thunk symbol
# nor its panic message — both asserts fail.

fn contains(haystack: String, needle: String) -> Bool =
  str_find(haystack, needle) != -1

# Two functions whose bodies are exactly the sentinels `lowering` hands `ast_to_ir`:
# `__unresolved_<Class>_<head>` for an unresolvable free-tyvar dict, and
# `__unresolved_<Class>_<head>_<method>` for a found dict lacking a method
# (resolve_method_var). Each reaches translate_expr's unbound-name branch and takes
# the poison path.
fn probe_program() -> typed_ast.TypedProgram =
  typed_ast.TypedProgram([
    probe_fn("poison_probe", "__unresolved_ToString_Box", 12, 5),
    probe_fn("poison_probe_method", "__unresolved_Two_Box_two", 15, 12)
  ])

fn probe_fn(name: String, sentinel: String, line: Int, column: Int) -> typed_ast.TypedDecl =
  typed_ast.TFnDecl(name, Nil, Nothing, Nothing, Nil,
    typed_ast.TVar(sentinel, types.TConst(types.type_id("Int")),
                   source.SourcePos(index = 0, line = line, column = column)))

# Lower the probe to LLVM text. This used to `<-`-bind translate_program's
# `Result String (IRProgram, Dict Int)` and return a plain `String`, on the
# reasoning that binding the success value made the error irrelevant. It did not:
# the bind SHORT-CIRCUITS by returning the `Err` box out of `probe_ir`, where it
# would have been read as a `String` — a pointer printed as text, the exact shape
# `SPROUT_GC_HDRCHECK` exists to catch. Rejected by §5.9 now; the failure is
# handled here instead, where the error message is still a `String` worth showing.
fn probe_ir() -> String !{IO} =
  match ast_to_ir.translate_program(probe_program()) with
  | Err e -> panic("probe_ir: translate_program failed: " ++ e)
  | Ok (ir_prog, _) -> ir_lowering.lower_program(ir_prog)

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    ll <- probe_ir()
    # The sentinel lowers to a poison thunk, not a bare `i64 0` null-fill.
    assert_true(state, "poison thunk emitted for __unresolved_ sentinel",
                contains(ll, "__sprout_ir_unresolved_thunk"))
    # The poison thunk panics loudly rather than yielding a null dict.
    assert_true(state, "poison thunk carries a panic message",
                contains(ll, "unresolved typeclass dictionary"))
    # The message names the dictionary and the call site. RED before the fix: one
    # fixed message served every site.
    assert_true(state, "poison message names the dictionary and its position",
                contains(ll, "dictionary for ToString_Box (line 12, column 5)"))
    # A missing method keeps its name after the key (docs/debugging.md).
    assert_true(state, "poison message keeps a missing method's name",
                contains(ll, "dictionary for Two_Box_two (line 15, column 12)"))
    # `sprout_fail` prepends `runtime error: ` to every message, so a literal that embeds it
    # prints the prefix twice. RED before the fix, which dropped it from the literal.
    assert_true(state, "poison message does not embed the runtime's own prefix",
                ! contains (ll, "runtime error: dispatched"))
    summary(state)
