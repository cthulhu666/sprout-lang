import stdlib.test (new_state, assert_eq, summary)

# M3 PR 11 — do-block + IO effects + main body lowering.
#
# Self-contained Sprout functions with do-blocks that use only pure arithmetic
# steps; stdlib.test is imported only to assert their results.
#
# Do-blocks here are IO-typed functions (fn f() -> T !{IO}) but the steps
# contain only let-bindings and pure arithmetic expressions.  The IO effect
# annotation is an upper bound in Sprout — pure-body do-blocks are valid.
#
# main calls each function and asserts its result.
# Behavioral correctness for do-blocks with real IO effects is exercised by
# the broader stdlib test suite (test_ir_codegen_basic.spr, etc.).

# TDoExprStep (last-step value):
# A do-block whose only step is an expression returns that expression's value.
fn do_single_expr() -> Int !{IO} =
  do
    42

# TDoLetStep: let binding inside a do-block.
# `let x = N` binds `x` for subsequent steps; final step is the value.
fn do_let_bind(n: Int) -> Int !{IO} =
  do
    let x = n + n
    x + 1

# TDoExprStep (non-last) + TDoExprStep (last):
# Non-last TDoExprStep results are discarded; last step value returned.
fn do_two_exprs(a: Int, b: Int) -> Int !{IO} =
  do
    a + b
    a * b

# TDoBindStep (plain IO) using a helper that returns Int !{IO}.
# Verifies `name <- fn_call()` binds the i64 result correctly.
fn identity_io(n: Int) -> Int !{IO} = n

fn do_bind_plain_io(x: Int) -> Int !{IO} =
  do
    y <- identity_io(x)
    y + y

# Nested binds: multiple TDoBindStep steps, each result used in the next.
fn do_nested_binds(a: Int, b: Int) -> Int !{IO} =
  do
    x <- identity_io(a)
    y <- identity_io(b)
    x + y

# Mixed: TDoLetStep + TDoBindStep + TDoExprStep.
fn do_mixed(n: Int) -> Int !{IO} =
  do
    let base = n + 10
    v <- identity_io(base)
    v + v
    v * 3

# main with a TDo body: proves validate_main_body accepts TDo.
fn main() -> Unit !{IO} =
  do
    state <- new_state()
    r1 <- do_single_expr()
    assert_eq(state, "do_single_expr", r1, 42)
    r2 <- do_let_bind(3)
    assert_eq(state, "do_let_bind", r2, 7)
    r3 <- do_two_exprs(2, 5)
    assert_eq(state, "do_two_exprs", r3, 10)
    r4 <- do_bind_plain_io(7)
    assert_eq(state, "do_bind_plain_io", r4, 14)
    r5 <- do_nested_binds(4, 6)
    assert_eq(state, "do_nested_binds", r5, 10)
    r6 <- do_mixed(2)
    assert_eq(state, "do_mixed", r6, 36)
    summary(state)
