import stdlib.test (TestState, new_state, assert_eq, summary)

# POSITIVE half of the `P0` fallible-bind rule (spec-v0.md §5.9). The rejections live in
# tests/conformance/type_error/{fallible,maybe,result}_bind_*; these pin the shapes that must keep
# WORKING, and exercise both paths of each -- a rule that only ever rejects is easy to make too
# strong, and the `Ok`/`Err` and `Just`/`Nothing` arms are what a too-strong version would break.

fn may_fail(x: Int) -> Result String Int =
  if x > 0 then Ok(x) else Err("boom")

fn find_it(x: Int) -> Maybe Int =
  if x > 0 then Just(x) else Nothing

# A `Result` bind in a matching `Result`-returning function: the legal shape.
fn result_tail(x: Int) -> Result String Int =
  do
    v <- may_fail(x)
    Ok(v + 1)

# Same, `Maybe`.
fn maybe_tail(x: Int) -> Maybe Int =
  do
    v <- find_it(x)
    Just(v + 1)

# Two binds of the same family in sequence, with the second depending on the first.
fn two_binds(x: Int) -> Result String Int =
  do
    a <- may_fail(x)
    b <- may_fail(a)
    Ok(a + b)

# `_ <-` keeps its meaning: it propagates, and is legal where a named binder would be.
fn wildcard_propagates(x: Int) -> Result String Int =
  do
    _ <- may_fail(x)
    Ok(42)

# The DISCARD form: a bare `Result`-valued statement runs the call, throws the whole `Result` away,
# and CONTINUES -- which is why the 21 `_ <-`-in-a-non-Result-function sites migrate to it. The
# enclosing function is not fallible and must stay legal.
fn bare_stmt_continues(x: Int) -> Int =
  do
    may_fail(x)
    999

# An ordinary non-fallible effectful bind is untouched by the rule.
fn plain_bind() -> Int !{IO} =
  do
    r <- ref_new(5)
    v <- ref_read(r)
    v * 2

fn show_result(r: Result String Int) -> String =
  match r with
  | Ok n -> "Ok " ++ int_to_string(n)
  | Err e -> "Err " ++ e

fn show_maybe(m: Maybe Int) -> String =
  match m with
  | Just n -> "Just " ++ int_to_string(n)
  | Nothing -> "Nothing"

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    assert_eq(state, "Result bind, Ok path", show_result(result_tail(5)), "Ok 6")
    assert_eq(state, "Result bind, Err path propagates", show_result(result_tail(0)), "Err boom")

    assert_eq(state, "Maybe bind, Just path", show_maybe(maybe_tail(5)), "Just 6")
    assert_eq(state, "Maybe bind, Nothing path propagates", show_maybe(maybe_tail(0)), "Nothing")

    assert_eq(state, "two binds, both Ok", show_result(two_binds(5)), "Ok 10")
    assert_eq(state, "two binds, first Err", show_result(two_binds(0)), "Err boom")

    assert_eq(state, "`_ <-` Ok path", show_result(wildcard_propagates(5)), "Ok 42")
    assert_eq(state, "`_ <-` still propagates Err", show_result(wildcard_propagates(0)), "Err boom")

    # The discard form continues past a failure -- that is the whole point of it.
    assert_eq(state, "bare statement, call succeeds", bare_stmt_continues(5), 999)
    assert_eq(state, "bare statement, call fails but block continues", bare_stmt_continues(0), 999)

    p <- plain_bind()
    assert_eq(state, "non-fallible bind unaffected", p, 10)

    summary(state)
