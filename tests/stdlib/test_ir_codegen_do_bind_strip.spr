import stdlib.test (check_eq, run_suite)

# `x <- f()` with `f : Maybe a !{IO}` binds `x : a`, and a `Nothing` ends the
# block as its value. ast_to_ir's translate_do_bind_short lowers it: tag test,
# a short branch that builds `Nothing`, a continue branch that reads the payload,
# and a phi joining the two.

# A Maybe-returning IO helper. It returns Just(n) so the continue branch is
# exercised; a negative argument gives the short-circuit.
fn maybe_id(n: Int) -> Maybe Int !{IO} =
  do
    if n < 0 then Nothing else Just(n)

# Test 1 — single bind, named pattern, payload threaded into the continue branch.
fn bind_one_named() -> Maybe Int !{IO} =
  do
    n <- maybe_id(5)
    maybe_id(n + 1)

# Test 2 — two stacked binds.  Each bind compounds the short-circuit ladder.
# Result: nested CFG of (br i1 short / cont) ⤳ (br i1 short / cont) ⤳ phi ⤳ phi.
fn bind_two_named() -> Maybe Int !{IO} =
  do
    a <- maybe_id(2)
    b <- maybe_id(a)
    maybe_id(a + b)

# Test 3 — wildcard bind.  Exercises the WildcardPattern arm of
# do_bind_captures (no name added to captures).
fn bind_wildcard() -> Maybe Int !{IO} =
  do
    _ <- maybe_id(0)
    maybe_id(7)

# Test 4 — mixed: wildcard bind followed by named bind that uses its payload.
fn bind_mixed() -> Maybe Int !{IO} =
  do
    _ <- maybe_id(0)
    n <- maybe_id(1)
    maybe_id(n + n)

# Test 5 — the first bind short-circuits.
fn bind_first_short() -> Maybe Int !{IO} =
  do
    n <- maybe_id(-1)
    maybe_id(n)

# Test 6 — the second bind short-circuits, after the first bound a value.
fn bind_second_short() -> Maybe Int !{IO} =
  do
    a <- maybe_id(2)
    b <- maybe_id(-a)
    maybe_id(a + b)

fn main() -> Unit !{IO} =
  run_suite("do bind strip", [
    check_eq("one named", bind_one_named(), Just(6)),
    check_eq("two named", bind_two_named(), Just(4)),
    check_eq("wildcard", bind_wildcard(), Just(7)),
    check_eq("mixed", bind_mixed(), Just(2)),
    check_eq("first short", bind_first_short(), Nothing),
    check_eq("second short", bind_second_short(), Nothing)
  ])
