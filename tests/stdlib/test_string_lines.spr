import stdlib.test (check_eq, run_suite)
import stdlib.string (string_lines)

# Characterization test for string_lines, pinning its exact splitting contract so the O(n)
# reimplementation (str_split_lines + post-pass) preserves behavior for its REPL/LSP/compiler
# consumers. Contract: split on '\n'; strip a '\r' immediately before a '\n' (CRLF); preserve
# interior empty lines; NO trailing empty line after a final '\n'; "" -> no lines; a final
# non-newline-terminated line keeps any trailing '\r'.

fn nth(v: Vec String, i: Int) -> String = vec_get_or(i, "<none>", v)

fn main() -> Unit !{IO} =
  let empty = string_lines("")
      one = string_lines("a")
      trail = string_lines("a\n")
      two = string_lines("a\nb")
      blank = string_lines("a\n\nb")
      crlf = string_lines("a\r\nb")
      crlf_trail = string_lines("a\r\nb\r\n")
      lone = string_lines("\n")
      final_cr = string_lines("a\nb\r")
  in run_suite("string_lines", [
    check_eq("empty string -> no lines", vec_length(empty), 0),

    check_eq("no newline: one line", vec_length(one), 1),
    check_eq("no newline: content", nth(one, 0), "a"),

    check_eq("trailing newline: no empty tail", vec_length(trail), 1),
    check_eq("trailing newline: content", nth(trail, 0), "a"),

    check_eq("two lines: count", vec_length(two), 2),
    check_eq("two lines [0]", nth(two, 0), "a"),
    check_eq("two lines [1]", nth(two, 1), "b"),

    check_eq("interior blank: count", vec_length(blank), 3),
    check_eq("interior blank [0]", nth(blank, 0), "a"),
    check_eq("interior blank [1] empty", nth(blank, 1), ""),
    check_eq("interior blank [2]", nth(blank, 2), "b"),

    check_eq("CRLF: count", vec_length(crlf), 2),
    check_eq("CRLF [0] cr stripped", nth(crlf, 0), "a"),
    check_eq("CRLF [1]", nth(crlf, 1), "b"),

    check_eq("CRLF + trailing: count", vec_length(crlf_trail), 2),
    check_eq("CRLF trailing [0]", nth(crlf_trail, 0), "a"),
    check_eq("CRLF trailing [1] cr stripped", nth(crlf_trail, 1), "b"),

    check_eq("lone newline -> one empty line", vec_length(lone), 1),
    check_eq("lone newline [0] empty", nth(lone, 0), ""),

    check_eq("final non-terminated line keeps cr: count", vec_length(final_cr), 2),
    check_eq("final cr [0]", nth(final_cr, 0), "a"),
    check_eq("final cr [1] keeps cr", nth(final_cr, 1), "b\r")
  ])
