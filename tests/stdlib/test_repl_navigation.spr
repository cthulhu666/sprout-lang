# Coverage for repl line-editing and history navigation pure helpers.
# Note: the redraw_input rendering bug (ESC[K fix), the ctrl-L runtime key
# mapping, and the module-level `esc` constant are IO-only or cosmetic and
# cannot be regression-tested in this framework.
import stdlib.test (check_eq, run_suite)
import stdlib.repl (insert_at, delete_before, history_prev, history_next, is_declaration)
import stdlib.collections (Vec, foldable_to_vec)

fn main() -> Unit !{IO} =
  let h = foldable_to_vec(["old", "mid", "new"])
  in let (txt1, idx1, _) = history_prev("", h, -1, "")
         (txt2, idx2, _) = history_prev("new", h, 2, "")
         (txt3, idx3, _) = history_prev("old", h, 0, "")
         (txt4, idx4, _) = history_next("new", h, 2, "my draft")
         (txt5, idx5, _) = history_next("mid", h, 1, "")
         (txt6, idx6, _) = history_next("", h, -1, "")
  in run_suite("repl_navigation", [
    check_eq("insert at start", insert_at("hello", 0, "X"), "Xhello"),
    check_eq("insert at end", insert_at("hello", 5, "X"), "helloX"),
    check_eq("insert at middle", insert_at("hello", 2, "XY"), "heXYllo"),

    check_eq("delete before 0 (no-op)", delete_before("hello", 0), "hello"),
    check_eq("delete before 1", delete_before("hello", 1), "ello"),
    check_eq("delete before 3", delete_before("hello", 3), "helo"),
    check_eq("delete before end", delete_before("hello", 5), "hell"),

    check_eq("up from -1 shows newest", txt1, "new"),
    check_eq("up from -1 sets index", idx1, 2),

    check_eq("up from 2 shows mid", txt2, "mid"),
    check_eq("up from 2 decrements index", idx2, 1),

    check_eq("up at 0 stays", txt3, "old"),
    check_eq("up at 0 keeps index 0", idx3, 0),

    check_eq("down from top restores draft", txt4, "my draft"),
    check_eq("down from top sets index -1", idx4, -1),

    check_eq("down from 1 shows new", txt5, "new"),
    check_eq("down from 1 increments index", idx5, 2),

    check_eq("down at -1 is no-op (text)", txt6, ""),
    check_eq("down at -1 is no-op (index)", idx6, -1),

    # is_declaration must recognise every top-level decl keyword the parser
    # dispatches on (parser.parse_decl_body), so the REPL routes them to the
    # declaration path instead of splicing them into an expression context.
    check_eq("fn is a declaration", is_declaration("fn f() = 1"), true),
    check_eq("let is a declaration", is_declaration("let x = 1"), true),
    check_eq("type is a declaration", is_declaration("type T = | A"), true),
    check_eq("class is a declaration", is_declaration("class C a where"), true),
    check_eq("instance is a declaration", is_declaration("instance C Int where"), true),
    check_eq("export is a declaration", is_declaration("export fn f() = 1"), true),
    check_eq("wrap is a declaration", is_declaration("wrap Minutes = Int"), true),
    check_eq("extern is a declaration", is_declaration("extern fn c_now() -> Int"), true),
    check_eq("expression is not a declaration", is_declaration("1 + 2"), false)
  ])
