import stdlib.test (check_eq, run_suite)

# Regression test: class method wrappers must receive their hidden typeclass-dict
# parameter.  The bug in build_fn_sigs_acc used extract_param_lls_from_type
# (which only counts function arrows in the scheme type) instead of
# list_map(\_ -> ll_i64(), params).  For to_string the scheme is `∀a. a→String`
# (1 arrow) but the wrapper TFnDecl has 2 params (user value + hidden dict),
# so the LLVM stub was emitted with arity 1 and always returned 0 (null),
# causing string_concat_many to crash whenever a template literal was used.

fn apply_any(x: a, f: a -> String) -> String =
  f(x)

fn apply_stringer(f: Int -> String, xs: List Int) -> List String =
  list_map(f, xs)

# Regression: class method passed as value to a user-defined higher-order function in a
# let-decl. If lowering's eta-expansion fails, the sentinel (__eta_unresolved_*) causes
# a linker error rather than SIGBUS — ensuring compile-time detection.
let applied_via_ho = apply_stringer(to_string, [10, 20, 30])

fn show_via_value_method(x: a) -> String where ToString a =
  apply_any(x, to_string)

# Regression: let-decl path must apply substitution so that typeclass method
# eta-expansion resolves the concrete instance (REPL wraps all exprs as let-decls).
let to_string_int_list = list_map(to_string, [1, 2, 3])

fn main() -> Unit !{IO} =
  run_suite("to_string", [
    check_eq("to_string Int 0", to_string(0), "0"),
    check_eq("to_string Int 42", to_string(42), "42"),
    check_eq("to_string Int neg", to_string(-7), "-7"),
    check_eq("to_string Bool true", to_string(true), "true"),
    check_eq("to_string Bool false", to_string(false), "false"),
    check_eq("to_string String id", to_string("hello"), "hello"),
    check_eq("to_string String empty", to_string(""), ""),
    check_eq("polymorphic imported to_string eta", show_via_value_method(42), "42"),
    check_eq("to_string via let-decl list_map", to_string_int_list, ["1", "2", "3"]),
    check_eq("to_string via user-defined higher-order let-decl", applied_via_ho, ["10", "20", "30"]),
    check_eq("to_string IntRange ascending", to_string(range(0, 10)), "IntRange(0, 10)"),
    check_eq("to_string IntRange descending", to_string(range(5, 1)), "IntRange(5, 1)"),
    check_eq("to_string IntRange single", to_string(range(3, 3)), "IntRange(3, 3)")
  ])
