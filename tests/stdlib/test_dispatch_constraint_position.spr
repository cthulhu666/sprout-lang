import stdlib.test (check_eq, run_suite)

# W4 (F-DISPATCH): the class variable `a` is the SECOND parameter of `describe`.
# The first *concrete* argument is the String `tag`. The instance dict must be
# selected by the class-var PARAMETER POSITION (`x: a`), not by "first concrete
# arg" — otherwise `describe("tag", 42)` wrongly selects the `Desc String`
# instance and prints "STRING". (fundamentals review W4 / probe sr_dispatch.)
class Desc a {
  fn describe(tag: String, x: a) -> String
}

instance Desc String {
  fn describe(tag: String, x: String) -> String = "STRING"
}

instance Desc Int {
  fn describe(tag: String, x: Int) -> String = "INT"
}

fn main() -> Unit !{IO} =
  run_suite("dispatch_constraint_position", [
    # Discriminating case: class-var arg (pos 2) is Int → must pick Desc Int.
    check_eq("class-var Int at position 2 picks Desc Int", describe("tag", 42), "INT"),
    # Control: class-var arg (pos 2) is String → Desc String.
    check_eq("class-var String at position 2 picks Desc String", describe("tag", "hi"), "STRING")
  ])
