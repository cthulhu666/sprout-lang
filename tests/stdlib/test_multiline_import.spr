import stdlib.test (TestState, new_state,
                    assert_true, summary)
import stdlib.math (pi,
                    sqrt,
                    floor)
# A trailing comment must not be counted: the `(` below is inside a comment, so
# this import is balanced and complete. Counting it would swallow the next line
# into this import's list and drop whatever it declared. Comment lines have
# broken import collection before, which is why this is pinned.
import stdlib.string (trim)  # a comment with an unbalanced ( paren
# A comment INSIDE an open list is a different case from the one above, which
# sits on an already-CLOSED import and so never reaches the joiner at all. The
# lines of a wrapped list are spliced into one string before its names are
# scanned, and that scan stops dead at the first `#` — so a comment anywhere in
# the list dropped every name after it, surfacing far away as `Unknown variable`.
import stdlib.math (abs,
                    # a comment line inside the list, with an unbalanced ( too
                    ceiling,
                    truncate)
# The same hazard on the FIRST line of an open list: the joined string starts as
# that line, so its trailing comment lands in the MIDDLE of the splice.
import stdlib.math (exp,  # trailing comment while the list is still open
                    is_nan)

# A parenthesised import list may span lines.
#
# It could not before: header stripping and import collection are both
# LINE-based, so the continuation line was not recognised as part of the header.
# Stripping stopped there and the parser was handed `cos, sqrt)`, reported as a
# generic `Expected declaration at 2:21`; independently, import collection saw
# only the names on the first line and silently dropped the rest.
#
# The rule this file pins: an import's parenthesised list continues until the
# parenthesis closes, however many lines that takes. This file imports six names
# across three wrapped lists, and every one of them must resolve — a fix that
# only stopped the parse error while still dropping the continuation names would
# fail here rather than pass quietly.

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    assert_true(state, "a name from the first line of a wrapped list resolves", pi > 3.14)
    assert_true(state, "a name from a continuation line resolves", sqrt(4.0) == 2.0)
    assert_true(state, "a name from a third line resolves", floor(2.7) == 2.0)
    assert_true(state, "the assert helpers themselves came from a wrapped list", true)
    assert_true(state, "a `(` in a trailing comment is not counted", trim("  x  ") == "x")

    # Names on BOTH sides of a comment line inside an open list must resolve. The
    # name before it proves the splice still works; the two after it are the ones
    # the comment used to swallow.
    assert_true(state, "a name before a comment line in the list resolves", abs(-2.0) == 2.0)
    assert_true(state, "a name after a comment line in the list resolves", ceiling(2.1) == 3.0)
    assert_true(state, "a later name after a comment line resolves", truncate(-2.7) == -2.0)

    # And past a comment trailing the list's FIRST line.
    assert_true(state, "a name before a first-line trailing comment resolves", exp(0.0) == 1.0)
    # Spelled `== false` rather than with a prefix `!`: `just fmt` currently
    # rewrites `!f(x)` to `! f (x)` and eats the preceding space (BACKLOG P3).
    assert_true(state, "a name after a first-line trailing comment resolves", is_nan(1.0) == false)

    summary(state)
