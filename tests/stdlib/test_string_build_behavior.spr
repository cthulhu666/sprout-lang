import stdlib.test (new_state, assert_true, assert_eq, summary)
import stdlib.string as string

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    assert_eq(state, "replace empty from", string.replace_all("", "x", "abc"), "abc")
    assert_eq(state, "replace overlap", string.replace_all("aa", "b", "aaa"), "ba")
    assert_eq(state, "replace run", string.replace_all("aa", "b", "aaaa"), "bb")
    assert_eq(state, "replace none", string.replace_all("z", "b", "aaa"), "aaa")
    assert_eq(state, "replace empty s", string.replace_all("a", "b", ""), "")
    assert_eq(state, "replace to empty", string.replace_all("a", "", "banana"), "bnn")
    assert_eq(state, "replace utf8", string.replace_all("é", "e", "éaé"), "eae")
    assert_eq(state, "replace edges", string.replace_all("/", "-", "/a//b/"), "-a--b-")
    assert_eq(state, "repeat 3", string.repeat("ab", 3), "ababab")
    assert_eq(state, "repeat 0", string.repeat("ab", 0), "")
    assert_eq(state, "repeat neg", string.repeat("ab", -2), "")
    assert_eq(state, "repeat empty", string.repeat("", 5), "")
    assert_true(state, "is_empty empty", string.is_empty(""))
    assert_true(state, "is_empty nonempty",! string.is_empty ("é"))
    assert_true(state, "ends_with empty suffix", string.ends_with("abc", ""))
    assert_true(state, "ends_with empty both", string.ends_with("", ""))
    assert_true(state, "ends_with longer suffix",! string.ends_with ("bc", "abc"))
    assert_true(state, "ends_with yes", string.ends_with("abc", "bc"))
    assert_true(state, "ends_with no",! string.ends_with ("abc", "ab"))
    assert_true(state, "ends_with utf8", string.ends_with("aéü", "éü"))
    assert_true(state, "ends_with utf8 no",! string.ends_with ("aéü", "e"))
    assert_true(state, "ends_with first char",! string.ends_with ("aé", "a"))
    assert_eq(state, "digits", string.string_digits("a1b23c"), vec_from_list([1, 2, 3]))
    assert_eq(state, "digits none", string.string_digits("abc"), vec_empty())
    assert_eq(state, "digits empty", string.string_digits(""), vec_empty())
    assert_eq(state, "chars ascii", string.string_chars("abc"), vec_from_list(['a', 'b', 'c']))
    assert_eq(state, "chars utf8", string.string_chars("aéü€"), vec_from_list(['a', 'é', 'ü', '€']))
    assert_eq(state, "chars empty", string.string_chars(""), vec_empty())
    assert_eq(state, "vec_prepend", vec_prepend(0, vec_from_list([1, 2, 3])), vec_from_list([0, 1, 2, 3]))
    assert_eq(state, "vec_prepend empty", vec_prepend(7, vec_empty()), vec_from_list([7]))
    assert_eq(state, "range_to_vec", range_to_vec(1..4), vec_from_list([1, 2, 3, 4]))
    summary(state)
