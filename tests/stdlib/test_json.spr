import stdlib.test (check_true, check_false, run_suite)
import stdlib.json as json

fn is_ok(r: Result json.JsonError json.Json) -> Bool =
  match r with
  | Ok _ -> true
  | Err _ -> false

fn is_err(r: Result json.JsonError json.Json) -> Bool =
  match r with
  | Ok _ -> false
  | Err _ -> true

fn is_nothing_json(m: Maybe json.Json) -> Bool =
  match m with
  | Nothing -> true
  | Just _ -> false

fn is_nothing_string(m: Maybe String) -> Bool =
  match m with
  | Nothing -> true
  | Just _ -> false

fn is_nothing_int(m: Maybe Int) -> Bool =
  match m with
  | Nothing -> true
  | Just _ -> false

fn is_nothing_array(m: Maybe json.JsonArray) -> Bool =
  match m with
  | Nothing -> true
  | Just _ -> false

fn stringify_round_trip_ok(input: String) -> Bool =
  match json.parse(input) with
  | Err _ -> false
  | Ok v -> is_ok(json.parse(json.stringify(v)))

fn abs_d(x: Double) -> Double = if x < 0.0 then 0.0 - x else x

# Double has no Eq instance, so float results are checked with an absolute tolerance.
fn top_float_approx(input: String, target: Double, eps: Double) -> Bool =
  let Ok v = json.parse(input) else false
      Just x = json.json_get_float(v) else false
  in abs_d(x - target) < eps

fn field_float_approx(input: String, key: String, target: Double, eps: Double) -> Bool =
  let Ok v = json.parse(input) else false
      Just fv = json.json_get_field(v, key) else false
      Just x = json.json_get_float(fv) else false
  in abs_d(x - target) < eps

# Asserts the DECODED value, not just parse success: a parser that dropped or truncated multi-byte
# bytes could still report Ok.
fn field_string_is(input: String, key: String, want: String) -> Bool =
  let Ok v = json.parse(input) else false
      Just fv = json.json_get_field(v, key) else false
      Just s = json.json_get_string(fv) else false
  in s == want

fn int_on_float_is_nothing(input: String) -> Bool =
  match json.parse(input) with
  | Err _ -> false
  | Ok v -> is_nothing_int(json.json_get_int(v))

fn bool_of(input: String) -> Maybe Bool =
  match json.parse(input) with
  | Err _ -> Nothing
  | Ok v -> json.json_get_bool(v)

fn is_just_true(m: Maybe Bool) -> Bool =
  match m with
  | Just b -> b
  | Nothing -> false

fn is_nothing_bool(m: Maybe Bool) -> Bool =
  match m with
  | Nothing -> true
  | Just _ -> false

fn main() -> Unit !{IO} =
  let obj_result = json.parse("{\"name\": \"Alice\", \"age\": 30}")

      missing_key_result =
        match obj_result with
        | Ok v -> json.json_get_field(v, "missing")
        | Err _ -> Nothing

      str_field =
        match obj_result with
        | Ok v -> json.json_get_field(v, "age")
        | Err _ -> Nothing

      str_on_nonstring =
        match str_field with
        | Nothing -> Nothing
        | Just v -> json.json_get_string(v)

      int_field =
        match obj_result with
        | Ok v -> json.json_get_field(v, "name")
        | Err _ -> Nothing

      int_on_nonint =
        match int_field with
        | Nothing -> Nothing
        | Just v -> json.json_get_int(v)

      arr_on_nonarr =
        match obj_result with
        | Ok v ->
            match json.json_get_field(v, "name") with
            | Nothing -> Nothing
            | Just name_val -> json.json_get_array(name_val)
        | Err _ -> Nothing

      # Regression: CPR worker for non-allowlisted externs (json_parse) previously
      # generated `ret { i64, i64 } undef`, causing non-exhaustive match at runtime.
      cpr_regression_ok =
        match json.parse("99") with
        | Ok _ -> true
        | Err _ -> false
  in run_suite("json", [
    # --- Happy-path sanity checks ---

    check_true("parse simple object", is_ok(json.parse("{\"key\": \"value\"}"))),
    check_true("parse integer", is_ok(json.parse("42"))),
    check_true("parse boolean true", is_ok(json.parse("true"))),
    check_true("parse null", is_ok(json.parse("null"))),
    check_true("parse array", is_ok(json.parse("[1, 2, 3]"))),

    # --- Malformed input: parse must return Err, not crash ---

    check_true("malformed: empty string", is_err(json.parse(""))),
    check_true("malformed: truncated object", is_err(json.parse("{"))),
    check_true("malformed: trailing garbage", is_err(json.parse("42 garbage"))),
    check_true("malformed: mismatched brackets", is_err(json.parse("[1, 2"))),
    check_true("malformed: bare word undefined", is_err(json.parse("undefined"))),
    check_true("malformed: unclosed string", is_err(json.parse("\"hello"))),
    check_true("malformed: double comma", is_err(json.parse("[1,,2]"))),
    check_true("malformed: unquoted key", is_err(json.parse("{key: 1}"))),

    # --- Edge cases for json_get_* helpers on valid JSON ---

    check_true("json_get_field missing key returns Nothing", is_nothing_json(missing_key_result)),

    check_true("json_get_string on non-string returns Nothing", is_nothing_string(str_on_nonstring)),

    check_true("json_get_int on non-int returns Nothing", is_nothing_int(int_on_nonint)),

    check_true("json_get_array on non-array returns Nothing", is_nothing_array(arr_on_nonarr)),

    # --- json_stringify round-trip ---

    check_true("stringify round-trip parses back successfully", stringify_round_trip_ok("{\"x\": 1}")),

    check_true("CPR regression: inline do-block match on parse result", cpr_regression_ok),

    # --- float parsing (Scope B: pure-Sprout parser, JsonFloat) ---

    check_true("parse decimal <1", top_float_approx("0.104", 0.104, 0.00001)),
    check_true("parse decimal >1", top_float_approx("179.84", 179.84, 0.001)),
    check_true("parse negative decimal", top_float_approx("-179.84", 0.0 - 179.84, 0.001)),
    check_true("parse scientific notation", top_float_approx("8.5e-2", 0.085, 0.00001)),
    check_true("parse capital-E exponent", top_float_approx("2.34E-2", 0.0234, 0.00001)),
    check_true("json_get_float coerces an integer", top_float_approx("42", 42.0, 0.0001)),
    check_true("float object field", field_float_approx("{\"au\": 0.5}", "au", 0.5, 0.0001)),
    check_true("array of floats parses", is_ok(json.parse("[0.1, 0.2, 0.3]"))),
    check_true("json_get_int on a float returns Nothing", int_on_float_is_nothing("0.104")),
    check_true("float round-trips through stringify", stringify_round_trip_ok("{\"au\": 0.104}")),
    check_true("negative float round-trips", stringify_round_trip_ok("-1.5e-1")),

    # --- json_get_bool (accessor for the JsonBool variant) ---
    check_true("json_get_bool on true", is_just_true(bool_of("true"))),
    check_false("json_get_bool on false", is_just_true(bool_of("false"))),
    check_true("json_get_bool on a non-bool returns Nothing", is_nothing_bool(bool_of("42"))),

    # --- non-ASCII input (regression: this ABORTED the process) ---
    # `byte1(s, i) = str_slice_bytes(s, i, 1)` sliced one byte for character dispatch. On the LEAD
    # byte of a multi-byte sequence the builtin's end-offset check saw a continuation byte and called
    # `tcp_fail` — the process-fatal path — so ANY non-ASCII character anywhere in the input killed
    # the program instead of parsing or returning Err. Reachable from the LSP server (a Sprout file
    # with a non-ASCII literal) and from any HTTP server parsing a JSON body, where it is an
    # unauthenticated remote process kill.
    #
    # These checks were impossible to fail before because there were none: this suite had ZERO
    # non-ASCII bytes in 133 lines, which is the same blind spot that hid the http_server body
    # framing bug — byte and codepoint index spaces agree on ASCII, so an all-ASCII corpus cannot
    # tell a byte-correct parser from a codepoint-confused one.
    #
    # Every check here is also a liveness assertion: on the unfixed parser the suite binary dies at
    # the first one and reports nothing, so the *count* of results is itself the signal.
    check_true("string value with a multi-byte character parses",
      is_ok(json.parse("{\"a\": \"café\"}"))),
    check_true("multi-byte character in an object KEY parses",
      is_ok(json.parse("{\"café\": 1}"))),
    check_true("multi-byte character survives a stringify round trip",
      stringify_round_trip_ok("{\"a\": \"café\"}")),
    # A 3-byte sequence (CJK) and a 4-byte one (emoji, a surrogate pair in UTF-16 terms) exercise
    # continuation-byte runs longer than é's single one.
    check_true("3-byte character parses", is_ok(json.parse("{\"a\": \"日本語\"}"))),
    check_true("4-byte character parses", is_ok(json.parse("{\"a\": \"🌱\"}"))),
    # Non-ASCII adjacent to the structural positions the scanner dispatches on, where a byte-at-cursor
    # read is most likely to land on a lead byte.
    check_true("multi-byte character before a comma parses",
      is_ok(json.parse("[\"café\", 1]"))),
    check_true("bare multi-byte string at top level parses",
      is_ok(json.parse("\"café\""))),
    # The decoded value must be correct, not merely non-fatal: a parser that skipped or truncated
    # the multi-byte bytes could return Ok with a mangled string.
    check_true("multi-byte string value decodes byte-for-byte",
      field_string_is("{\"a\": \"café\"}", "a", "café")),
    check_true("3-byte string value decodes byte-for-byte",
      field_string_is("{\"a\": \"日本語\"}", "a", "日本語"))
  ])
