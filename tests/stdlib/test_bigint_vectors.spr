    check_eq("mul 0", big.to_string(big.mul(parse("164220786268160210619852918880475198055"), parse("10653949364491338486455296910966840795028504690491488540170065845802110258722038364423040575361075325162529956562728515257348110886040897"))), "1749599941497933401952984695476021113877137168321563698792120733132187992589083379620339942619021664711546139415325812679463823767792074785302738985018052699254406320904855335"),
    check_eq("div 0", quot(parse("164220786268160210619852918880475198055"), parse("10653949364491338486455296910966840795028504690491488540170065845802110258722038364423040575361075325162529956562728515257348110886040897")), "0"),
    check_eq("rem 0", rest(parse("164220786268160210619852918880475198055"), parse("10653949364491338486455296910966840795028504690491488540170065845802110258722038364423040575361075325162529956562728515257348110886040897")), "164220786268160210619852918880475198055"),
