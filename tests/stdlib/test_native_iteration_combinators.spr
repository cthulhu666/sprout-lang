import stdlib.test (TestState, new_state, assert_eq, summary)
import stdlib.mutable (MutVec, mutvec_new, mutvec_at, mutvec_set)

# Named helper steps (B1: multi-statement lambda bodies must be lifted to named fns).
# Single-expression lambdas at call sites may still close over locals (e.g. `v`).

fn dot_step(a: MutVec Int, b: MutVec Int, acc: Int, i: Int) -> Int !{IO} =
  do
    ai <- mutvec_at(a, i)
    bi <- mutvec_at(b, i)
    acc + ai * bi

fn add_step(acc: Int, x: Int) -> Int = acc + x

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # 1. range_fold, PURE step, data-last new arg order (reorder regression).
    #    IntRange is inclusive: range_up(0, 4) = 0+1+2+3+4 = 10.
    assert_eq(
      state,
      "range_fold pure sum over inclusive range_up(0,4)",
      range_fold(add_step, 0, range_up(0, 4)),
      10
    )

    # 2. range_each, effectful step (single-expression lambda closing over v).
    #    range_up(0, 3) writes indices 0..3; v[i] = i*i, so v[3] = 9.
    v <- mutvec_new(4, 0)
    _ <- range_each(\i -> mutvec_set(v, i, i * i), range_up(0, 3))
    v3 <- mutvec_at(v, 3)
    assert_eq(state, "range_each fills v[3] = 3*3", v3, 9)

    # 3. range_fold, EFFECTFUL step: dot product of two length-4 vectors.
    #    a = [1,2,3,4], b = [10,20,30,40] -> 10+40+90+160 = 300.
    a <- mutvec_new(4, 0)
    _ <- range_each(\i -> mutvec_set(a, i, i + 1), range_up(0, 3))
    b <- mutvec_new(4, 0)
    _ <- range_each(\i -> mutvec_set(b, i, (i + 1) * 10), range_up(0, 3))
    assert_eq(
      state,
      "range_fold effectful dot product",
      range_fold(\ (acc, i) -> dot_step(a, b, acc, i), 0, range_up(0, 3)),
      300
    )

    # 4. list_each, effectful step: sum a list into a cell.
    cell <- mutvec_new(1, 0)
    _ <- list_each(\x -> add_into(cell, x), Cons(10, Cons(20, Cons(30, Nil))))
    total <- mutvec_at(cell, 0)
    assert_eq(state, "list_each accumulates into cell", total, 60)

    # 5. list_fold, PURE step, data-last.
    assert_eq(
      state,
      "list_fold pure sum",
      list_fold(add_step, 0, Cons(10, Cons(20, Cons(30, Nil)))),
      60
    )

    summary(state)

# Read-modify-write a single cell; used by the list_each case (needs a captured MutVec,
# so it is invoked via a single-expression lambda at the call site).
fn add_into(cell: MutVec Int, x: Int) -> Unit !{IO} =
  do
    cur <- mutvec_at(cell, 0)
    mutvec_set(cell, 0, cur + x)
