import stdlib.test (check_eq, run_suite)

# M4.2 tracks linear values through ALL binder forms (post-review soundness fix).
# This file exercises the VALID single-use shapes for each; the reuse/leak
# counterparts live in tests/conformance/type_error/linear_alias_*, linear_dobind,
# linear_viral_field. See docs/linear-types-m4.2-enforcement-2026-08-06.md.

type linear File = File Int
type linear Wrap = Wrap File

type Box a = Box a

fn use_file(f: File) -> Int = match f with | File n -> n

# let..in alias, used once.
fn via_let(f: File) -> Int =
  let g = f
  in use_file(g)

# match variable pattern, used once.
fn via_match(f: File) -> Int =
  match f with
  | g -> use_file(g)

# viral: destructure a linear field, used once.
fn via_field(w: Wrap) -> Int =
  match w with
  | Wrap f -> use_file(f)

# do-bind a linear payload, used once.
fn via_dobind(m: Maybe File) -> Maybe Int =
  do
    x <- m
    Just(use_file(x))

# A SHORT-CIRCUITING block's trailing step may produce a linear value: it is the
# block's result, so the obligation passes to the caller, who binds and consumes
# it. Every step of a Maybe/Result block has type `Maybe X`/`Result E X`, so the
# discard rule must look through the container to work here at all — the
# non-trailing counterpart is tests/conformance/type_error/linear_discarded_result_block.
fn open_maybe(n: Int) -> Maybe File =
  do
    k <- Just(n)
    Just(File(k))

fn via_trailing_maybe(n: Int) -> Maybe Int =
  do
    f <- open_maybe(n)
    Just(use_file(f))

# `_ <-` is rejected only when the payload is (or may be) linear. The ordinary
# non-linear wildcard bind — "run this step for its effect, ignore the value" —
# stays legal; breaking it would break most existing do-blocks.
fn wildcard_non_linear(n: Int) -> Maybe Int =
  do
    _ <- Just(n)
    Just(n + 1)

# --- containment (docs/linearity-virality-v0.md, Option 1) --------------------
#
# A binder is obliged when its type CONTAINS a linear type, not only when its head
# is one. These are the positive half: a rule that rejected every container of a
# linear would close the leak and be useless. The leak/reuse/divergence
# counterparts are tests/conformance/type_error/linear_drop_in_* and
# linear_container_*.

fn close_all(m: Maybe File) -> Int =
  match m with
  | Just f -> use_file(f)
  | Nothing -> 0

fn close_list(fs: List File) -> Int =
  match fs with
  | Nil -> 0
  | Cons f rest -> use_file(f) + close_list(rest)

# `Maybe File` bound by `let..in`, consumed exactly once.
fn container_used_once(n: Int) -> Int =
  let m = Just(File(n))
  in close_all(m)

# A tuple component, and the non-linear component still readable alongside it.
fn tuple_used_once(n: Int) -> Int =
  let p = (File(n), 10)
  in match p with | (f, k) -> use_file(f) + k

# A user-declared container: `Box` is nothing special to the checker.
fn boxed_used_once(n: Int) -> Int =
  let b = Box(File(n))
  in match b with | Box f -> use_file(f)

# A NON-PARAMETRIC container: the field is concrete, so there is no type argument
# to walk and containment has to read what the declaration stores. `Crate` is the
# shape a resource wrapper is naturally written in, and the one that used to be
# untracked — the leak and reuse counterparts are
# tests/conformance/type_error/linear_concrete_field_*.
type Crate =
  | Crate File

fn crate_used_once(n: Int) -> Int =
  let c = Crate(File(n))
  in match c with | Crate f -> use_file(f)

# Two declarations deep, neither of them linear itself.
type Inner =
  | Inner File

type Outer =
  | Outer Inner

fn nested_crate_used_once(n: Int) -> Int =
  let o = Outer(Inner (File(n)))
  in match o with | Outer i -> match i with | Inner f -> use_file(f)

# A `wrap` over a linear type stores it just as a constructor field does.
wrap Sealed = File

fn sealed_used_once(n: Int) -> Int =
  let s = Sealed(File(n))
  in match s with | Sealed f -> use_file(f)

# A declaration may store ITSELF, or cycle through a sibling. The stored-field
# walk memoizes by name so both terminate; before it there was nothing to descend
# and the question never arose.
#
# Each needs a BINDER to prove anything: containment is only ever entered from a
# parameter, `let`, pattern variable or `<-`, so a declaration nobody binds is
# never walked. The mutual pair first shipped with neither a binder nor a base
# constructor, which made it decoration — `chain_depth` alone exercised the
# self-recursive half and the sibling cycle went untested.
type Chain =
  | End Int
  | Link Chain

type Ping =
  | PingEnd Int
  | Ping Pong

type Pong =
  | Pong Ping

fn chain_depth(c: Chain) -> Int =
  match c with
  | End n -> n
  | Link inner -> chain_depth(inner) + 1

fn ping_depth(p: Ping) -> Int =
  match p with
  | PingEnd n -> n
  | Ping q -> match q with | Pong inner -> ping_depth(inner) + 1

# The same shape through a do-block `let`, which is a separate binder path
# (lin_do_let) from the pattern one.
fn do_let_container_once(n: Int) -> Maybe Int =
  do
    let fs = [File(n)]
    Just(close_list(fs))

# §5.8's function-type carve-out, pinned: `type_mentions_linear` must NOT descend
# an arrow. `Unit -> File` is a recipe for a resource, not a resource, so binding
# one and never calling it leaks nothing and must keep compiling.
fn recipe_is_not_a_resource(n: Int) -> Int =
  let make = \k -> File(k)
  in n

# The same carve-out reached through a BARE CONSTRUCTOR used as a value, which is
# a function value (`Int -> File`) and so a linear type behind an arrow. Binding
# one and never calling it allocates nothing and must stay legal.
fn ctor_value_is_not_a_resource(n: Int) -> Int =
  let mk = File
  in n

fn ctor_value_applied_once(n: Int) -> Int =
  let mk = File
  in use_file(mk(n))

# A container of a NON-linear type is untouched by any of this.
fn plain_container(n: Int) -> Int =
  let xs = [n, n + 1]
  in list_length(xs)

# --- phantom type parameters ------------------------------------------------
#
# Containment asks what a declaration STORES, not what its type application
# mentions. `Handle a` keeps only an Int, so a `Handle File` holds no File and
# binding one obliges nothing — the shape `stdlib.chan`'s `type Chan a = | Chan
# Int` has, and the reason `pool_worker(ch: Chan TcpConnection, ...)` compiles.
# Descending the application blindly made `Handle File` a container and had the
# leak diagnostic name a File the value does not hold.

type Handle a =
  | Handle Int

fn phantom_let_dropped(n: Int) -> Int =
  let h = Handle(n)
  in n

fn phantom_param_dropped(h: Handle File) -> Int = 1

# A parameter behind an ARROW is not stored either, matching the carve-out for a
# function type: `Recipe File` holds a way to make a File, not a File.
type Recipe a =
  | Recipe (Int -> a)

fn recipe_param_dropped(r: Recipe File) -> Int = 1

# The nested case is deliberately conservative: `Boxed File` is tracked because
# the occurrence test reads one declaration deep and sees `a` under `Handle a`,
# without asking that `Handle` drops it. Sound, and over-strict only here.
type Boxed a =
  | Boxed (Handle a)

fn boxed_phantom_tracked(n: Int) -> Int =
  let b = Boxed(Handle(n))
  in match b with | Boxed h -> match h with | Handle k -> k

# The cases above leave `a` free — `Handle(n)` alone is `Handle a` — so they pass
# with or without the phantom skip. These pin it concretely: each is rejected
# without the skip, and each is a binder form that must agree with the others.

fn make_handle(n: Int) -> Handle File = Handle(n)

fn make_handle_io(n: Int) -> Handle File !{IO} = Handle(n)

fn phantom_let_concrete(n: Int) -> Int =
  let h = make_handle(n)
  in n

# A `<-` bind must not strip the position the declaration drops: `Handle File`
# yields no File, so binding one obliges nothing — the same answer `let` and a
# parameter give.
fn phantom_dobind_dropped(n: Int) -> Int !{IO} =
  do
    h <- make_handle_io(n)
    n

# `read_handle` reads the Int a `Handle` really stores; the `File` in its type sits
# at the phantom position.
fn read_handle(h: Handle File) -> Int =
  match h with
  | Handle k -> k

# The shape `stdlib.http_server`'s `pooled_run` is written in: a phantom container
# bound with `<-` and then used MORE THAN ONCE — once to spawn the workers, once
# to feed them. An obligation on `h` would report "used more than once" here, so
# this is what makes the bind form writable rather than merely legal.
fn phantom_dobind_used_twice(n: Int) -> Int !{IO} =
  do
    h <- make_handle_io(n)
    read_handle(h) + read_handle(h)

# A comprehension BUILDING linear elements. The synthesized fold's accumulator is
# `List File` on every step; searching it rejected this and named the generator,
# which binds an Int.
fn comprehension_builds_linears(n: Int) -> Int = close_list([File(k) for k in [1, 2, n]])

# A record's phantom marker must be registered before any body is checked, so a
# function may be written ABOVE the record declaration it depends on.
fn record_phantom_before_decl(s: Slot File) -> Int = 1

type Slot a = (id: Int)

fn main() -> Unit !{IO} =
  run_suite("linear_binders", [
    check_eq("let..in alias once", via_let(File(1)), 1),
    check_eq("match var once", via_match(File(2)), 2),
    check_eq("viral field once", via_field(Wrap (File(3))), 3),
    check_eq("do-bind once", via_dobind(Just (File(4))), Just(4)),
    check_eq("trailing linear in a Maybe block", via_trailing_maybe(5), Just(5)),
    check_eq("non-linear `_ <-` still legal", wildcard_non_linear(6), Just(7)),
    check_eq("Maybe of a linear, used once", container_used_once(7), 7),
    check_eq("tuple holding a linear, used once", tuple_used_once(8), 18),
    check_eq("user ADT holding a linear, used once", boxed_used_once(9), 9),
    check_eq("concrete linear field, used once", crate_used_once(23), 23),
    check_eq("concrete linear field two declarations deep", nested_crate_used_once(24), 24),
    check_eq("a wrap over a linear, used once", sealed_used_once(25), 25),
    check_eq("a self-recursive declaration terminates", chain_depth(Link (End(26))), 27),
    check_eq("a declaration cycling through a sibling terminates",
      ping_depth(Ping (Pong (PingEnd(27)))), 28),
    check_eq("do-let List of a linear, used once", do_let_container_once(10), Just(10)),
    check_eq("a function returning a linear is not a resource", recipe_is_not_a_resource(11), 11),
    check_eq("a bare linear ctor as a value is not a resource", ctor_value_is_not_a_resource(12), 12),
    check_eq("a bare linear ctor applied once", ctor_value_applied_once(13), 13),
    check_eq("container of a non-linear is untouched", plain_container(14), 2),
    check_eq("a phantom parameter stores nothing (let)", phantom_let_dropped(15), 15),
    check_eq("a phantom parameter stores nothing (param)", phantom_param_dropped(Handle(16)), 1),
    check_eq("a parameter behind an arrow is not stored", recipe_param_dropped(Recipe (File)), 1),
    check_eq("a phantom nested one level deeper stays tracked", boxed_phantom_tracked(17), 17),
    check_eq("a concretely-instantiated phantom let is dropped", phantom_let_concrete(18), 18),
    check_eq("a phantom container bound with `<-` is dropped", phantom_dobind_dropped(19), 19),
    check_eq("a phantom container bound with `<-`, used twice", phantom_dobind_used_twice(22), 44),
    check_eq("a comprehension may build linear elements", comprehension_builds_linears(20), 23),
    check_eq("a record's phantom marker precedes its user", record_phantom_before_decl(Slot(id = 21)), 1)
  ])
