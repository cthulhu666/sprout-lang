import stdlib.test (check_eq, run_suite)

# Tuple-CPR (docs/scalar-replacement-v0.md, Stage 1): a fn returning a 2-tuple that is immediately
# matched by a tuple pattern unboxes to a `{ i64, i64 }` worker — the tuple never touches the heap.
# The optimization is value-NEUTRAL, so these assert the SEMANTICS are identical whether the result
# is boxed or unboxed. The IR-shape win (no sprout_alloc_tuple_blob at the matched call site) is
# checked separately via tests/smoke_shapes/07_tuple_cpr.spr. Three tail shapes are exercised so the
# worker's every path is covered:
#   - direct tuple literal `(b, a)`          → the fast IRRetUnboxed2 path
#   - if-chain bottoming in tuple literals    → recursion into the tuple tail per branch
#   - forwarding another tuple call           → the tuple-repack catch-all (box then extract fields)

fn swap_pair(a: Int, b: Int) -> (Int, Int) = (b, a)

fn use_swap(a: Int, b: Int) -> Int =
  match swap_pair(a, b) with
  | (x, y) -> (x * 10) + y

fn slice_of(tag: Int) -> (Int, Int) =
  if tag == 0 then (0, 2)
  else if tag == 1 then (2, 4)
  else (6, 3)

fn base_plus_cnt(tag: Int) -> Int =
  match slice_of(tag) with
  | (base, cnt) -> base + cnt

fn forward(a: Int, b: Int) -> (Int, Int) = swap_pair(a, b)

fn use_forward(a: Int, b: Int) -> Int =
  match forward(a, b) with
  | (x, y) -> x - y

# --- Width 3 (C1): the { i64, i64, i64 } direct-return worker ---

fn rgb3(k: Int) -> (Int, Int, Int) = (k, k + 1, k + 2)

fn use_rgb3(k: Int) -> Int =
  match rgb3(k) with
  | (r, g, b) -> (r * 100) + (g * 10) + b

fn shift3(tag: Int) -> (Int, Int, Int) =
  if tag == 0 then (1, 2, 3)
  else (7, 8, 9)

fn sum3(tag: Int) -> Int =
  match shift3(tag) with
  | (a, b, c) -> a + b + c

fn fwd3(k: Int) -> (Int, Int, Int) = rgb3(k)

fn use_fwd3(k: Int) -> Int =
  match fwd3(k) with
  | (r, g, b) -> r + g + b

# Width-3 REPACK path: a `wrap (Int,Int,Int)` unwrapped via a bare-var match tail. As a routed
# worker, rgb_unwrap's tail is `match x with Rgb p -> p` — NOT a tuple literal and NOT a chain, so
# it hits translate_tail_tuple_repack (box-and-extract → 3× IRGetTupleField + IRRetUnboxed3). This
# is the width-3 analogue of the `wrap (Int,Int)` case that segfaulted at width-2 before the repack
# fix; without this test the width-3 repack branch is unexercised.
wrap Rgb = (Int, Int, Int)

fn rgb_unwrap(x: Rgb) -> (Int, Int, Int) =
  match x with | Rgb p -> p

fn use_rgb_unwrap(a: Int, b: Int, c: Int) -> Int =
  match rgb_unwrap(Rgb((a, b, c))) with
  | (r, g, b2) -> (r * 100) + (g * 10) + b2

fn main() -> Unit !{IO} =
  run_suite("tuple_cpr", [
    # direct tuple-literal tail
    check_eq("swap 3,4 -> (4,3) -> 43", use_swap(3, 4), 43),
    check_eq("swap 0,0 -> 0", use_swap(0, 0), 0),
    # if-chain tail bottoming in tuple literals
    check_eq("slice tag0 -> 0+2", base_plus_cnt(0), 2),
    check_eq("slice tag1 -> 2+4", base_plus_cnt(1), 6),
    check_eq("slice tag9 -> 6+3", base_plus_cnt(9), 9),
    # forwarding (non-literal) tail → repack path; forward(7,2)=swap(7,2)=(2,7) -> 2-7
    check_eq("forward 7,2 -> (2,7) -> -5", use_forward(7, 2), 0 - 5),
    # width-3: direct tuple-literal tail
    check_eq("rgb3 1 -> (1,2,3) -> 123", use_rgb3(1), 123),
    check_eq("rgb3 5 -> (5,6,7) -> 567", use_rgb3(5), 567),
    # width-3: if-chain tail bottoming in tuple literals
    check_eq("shift3 tag0 -> 1+2+3", sum3(0), 6),
    check_eq("shift3 tag9 -> 7+8+9", sum3(9), 24),
    # width-3: forwarding (non-literal) tail -> chain path
    check_eq("fwd3 2 -> (2,3,4) -> 9", use_fwd3(2), 9),
    # width-3: wrap-unwrap bare-var tail -> repack path (box-and-extract, IRRetUnboxed3)
    check_eq("rgb_unwrap 4,5,6 -> 456", use_rgb_unwrap(4, 5, 6), 456),
    check_eq("rgb_unwrap 0,0,0 -> 0", use_rgb_unwrap(0, 0, 0), 0)
  ])
