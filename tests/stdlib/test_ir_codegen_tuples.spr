import stdlib.test (check_eq, run_suite)

# Verifies tuple expressions and tuple patterns lower
# (M3 PR 7).  Closes the dominant blocker exposed by PR 6: 72 of 85
# remaining IR_XFAIL entries fail at `ast_to_ir.sprout:699` with
# `Tuple not yet supported` because TTuple expression case currently
# returns Err.  Once that clears, the 1 remaining `tuples.sprout` example
# additionally needs TuplePattern in match arms (ast_to_ir.sprout:1600).
#
# This PR implements both:
#
#   IRMakeTuple <result> <element-ssas>
#     →  %r    = call i64 @sprout_alloc_tuple_blob(i64 <N*8>)
#        %r$ptr = inttoptr i64 %r to ptr
#        %r$s0  = getelementptr i64, ptr %r$ptr, i64 0
#        store i64 %a0, ptr %r$s0
#        ... per element
#
#   IRGetTupleField <result> <tuple-ssa> <field-idx>
#     →  %r$ptr = inttoptr i64 %t to ptr
#        %r$gep = getelementptr i64, ptr %r$ptr, i64 <idx>
#        %r     = load i64, ptr %r$gep
#
# Mirrors codegen.sprout's tuple-as-blob lowering (lines 940-968, 1197-1219).

# Pair construction.
fn make_pair(a: Int, b: Int) -> (Int, Int) = (a, b)

# Triple construction.
fn make_triple(a: Int, b: Int, c: Int) -> (Int, Int, Int) = (a, b, c)

# Match destructuring on a 2-tuple.
fn fst(p: (Int, Int)) -> Int =
  match p with
  | (a, _) -> a

fn snd(p: (Int, Int)) -> Int =
  match p with
  | (_, b) -> b

# Match on a 3-tuple — exercises N=3 element binding.
fn mid_of_triple(t: (Int, Int, Int)) -> Int =
  match t with
  | (_, m, _) -> m

# Compose: construct then destructure.
fn round_trip(a: Int, b: Int) -> Int =
  fst(make_pair(a, b)) + snd(make_pair(a, b))

# Tuple holding a String field (heap value) — coverage gap for the IRGetTupleField
# kind field added in sprout_ir.sprout.  Ensures extraction of a heap-typed element
# round-trips correctly (field index 0 = String, field index 1 = Int).
fn make_labeled(s: String, n: Int) -> (String, Int) = (s, n)

fn get_label(p: (String, Int)) -> String =
  match p with
  | (lbl, _) -> lbl

fn get_count(p: (String, Int)) -> Int =
  match p with
  | (_, n) -> n

fn main() -> Unit !{IO} =
  run_suite("ir_codegen_tuples", [
    check_eq("pair fst", fst(make_pair(1, 2)), 1),
    check_eq("pair snd", snd(make_pair(1, 2)), 2),
    check_eq("triple middle", mid_of_triple(make_triple(1, 2, 3)), 2),
    check_eq("round_trip", round_trip(10, 20), 30),
    check_eq("labeled String field", get_label(make_labeled("tag", 7)), "tag"),
    check_eq("labeled Int field", get_count(make_labeled("tag", 7)), 7)
  ])
