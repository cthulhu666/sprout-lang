import stdlib.test (TestState, new_state, assert_true, summary)

# Regression net for exact-size OBJ allocation: each ctor arity gets its own
# slot size and freelist class, freelists link through the slot's first payload
# word (tag lives in the object header at payload-8), and field values must
# survive GC cycles and freelist reuse. Covers the arity spectrum (0..9).

type Spectrum (..) =
  | A0
  | A1 Int
  | A2 Int Int
  | A9 Int Int Int Int Int Int Int Int Int

fn spectrum_sum(s: Spectrum) -> Int =
  match s with
  | A9 a b c d e f g h i -> a + b + c + d + e + f + g + h + i
  | A2 a b -> a + b
  | A1 a -> a
  | A0 -> 0

# Allocate and drop mixed-arity objects so collections run at the default
# threshold and the per-arity freelists fill, then get reused.
fn churn(n: Int, acc: Int) -> Int =
  if n <= 0 then acc
  else churn(n - 1, acc + spectrum_sum(A2(1, 1)) + spectrum_sum(A0) + spectrum_sum(A9(1, 0, 0, 0, 0, 0, 0, 0, 0)))

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # Objects allocated before the churn: fields must survive collections.
    let keep1 = A1(7)
    let keep9 = A9(1, 2, 3, 4, 5, 6, 7, 8, 9)
    let churned = churn(10000, 0)
    assert_true(state, "churn allocated and summed", churned == 30000)
    assert_true(state, "arity-1 field survives churn", spectrum_sum(keep1) == 7)
    assert_true(state, "arity-9 fields survive churn", spectrum_sum(keep9) == 45)

    # Fresh allocations reuse freelist blocks left by the churn garbage;
    # fields must round-trip in every arity class.
    let fresh0 = A0
    let fresh2 = A2(11, 31)
    let fresh9 = A9(9, 8, 7, 6, 5, 4, 3, 2, 1)
    assert_true(state, "arity-0 after freelist reuse", spectrum_sum(fresh0) == 0)
    assert_true(state, "arity-2 fields after freelist reuse", spectrum_sum(fresh2) == 42)
    assert_true(state, "arity-9 fields after freelist reuse", spectrum_sum(fresh9) == 45)

    summary(state)
