import stdlib.test (check_eq, run_suite)

# D7 rejects linear values in a comprehension, and the two diagnostics each end
# with a concrete rewrite. This file pins those rewrites: if either stops
# compiling, the advice becomes impossible to follow — which is exactly the
# defect the reworded messages were fixing, so it must fail loudly rather than
# rot in a message nobody re-checks.
#
# The rejections themselves live in
# tests/conformance/type_error/comprehension_linear_{binder,capture,ctor_binder}.

type linear File = File Int

fn use_file(f: File) -> Int = match f with | File n -> n

# "consume the elements in an explicit recursive function instead"
# — the rewrite for `[use_file(f) for f in fs]`.
fn sizes(fs: List File) -> List Int =
  match fs with
  | Nil -> Nil
  | Cons f rest -> Cons(use_file(f), sizes(rest))

# "consume it before the comprehension and use the result inside"
# — the rewrite for `[i * use_file(f) for i in 1..3]`. The linear value is
# consumed exactly once, outside; the comprehension only sees an Int.
fn scaled(f: File) -> List Int =
  let n = use_file(f)
  in [i * n for i in 1..3]

fn main() -> Unit !{IO} =
  run_suite("comprehension linear advice", [

    check_eq("explicit recursion consumes linear elements",
      sizes([File(1), File(2), File(3)]), [1, 2, 3]),

    check_eq("linear value consumed before the comprehension",
      scaled(File(5)), [5, 10, 15])
  ])
