import stdlib.test (check_eq, run_suite)

# Applying a function whose declared return type is itself a function type.
#
# `test_function_returning_function.spr` covers such a function being DEFINED and
# its result passed to a higher-order helper (`apply_int(adder(5), 3)`). It never
# applies the result directly, and that gap hid a wrong-code bug: an exact-arity
# call followed by a second application (`adder(5)(3)`) is the only legal spelling,
# and the illegal one-call spelling (`adder(5, 3)`) compiled to a direct call to
# the arity-1 symbol with two arguments. LLVM discards the surplus, so the call
# yielded the closure handle as an Int — exit 0, no diagnostic.
#
# Sprout is n-ary with exact-arity calls (docs/currying-and-pipe-decision-v1.md
# §9a.5), so a call supplies exactly the declared parameters and each further
# application is written separately. The over-applied spelling is now a located
# error, pinned by tests/conformance/type_error/over_application.spr.
#
# The cases below are the DIRECT-call class: a callee named at the call site, whose
# declared arity the checker reads from `@arity:<name>`. Through a function-typed
# VALUE that marker is gone — bind_local_scheme drops it for a local, as it must,
# since the name now refers to a value — and the type cannot stand in for it,
# because `pair_add` and `nested_add` below are the proof that one type spans two
# arities. Those applications are checked at runtime instead, against the arity
# recorded in the closure header: tests/closure_arity_smoke/, `just
# closure-arity-smoke`.

# One declared parameter, one arrow in the return type.
fn adder(n: Int) -> Int -> Int = \m -> n + m

# ZERO declared parameters. `mk()` is an exact-arity call — it was rejected with
# "'mk' requires arguments but was called with none", which keyed on the result
# TYPE being a function rather than on the declared parameter count, leaving a
# function of this shape impossible to call at all.
fn mk() -> Int -> Int = \x -> x + 1

# Two arrows, body is a single TWO-parameter lambda: one application of two args.
fn pair_add() -> Int -> Int -> Int = \ (x, y) -> x + y

# Two arrows, body is NESTED one-parameter lambdas: two applications of one arg.
# The closure's runtime arity follows the body, not the type, which is why the
# surplus arguments of an over-applied call cannot simply be re-applied as a group.
fn nested_add() -> Int -> Int -> Int = \x -> \y -> x + y

fn main() -> Unit !{IO} =
  run_suite("curried_return_application", [
    check_eq("declared param, then apply the result", adder(5)(3), 8),
    check_eq("zero declared params is an exact-arity call", mk()(4), 5),
    check_eq("two-param lambda takes both at once", pair_add()(1, 2), 3),
    check_eq("nested lambdas take one at a time", nested_add()(1)(2), 3)
  ])
