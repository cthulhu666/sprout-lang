import stdlib.test (TestState, new_state, assert_eq, assert_true, assert_false, summary)
import stdlib.process as process
import stdlib.compiler.sprout_ir as sprout_ir
import stdlib.compiler.ir_lowering as ir_lowering
import stdlib.compiler.ir_rooting as ir_rooting
import stdlib.compiler.lexer as lexer
import stdlib.compiler.parser as parser
import stdlib.compiler.checker as checker
import stdlib.compiler.lowering as lowering
import stdlib.compiler.ast_to_ir as ast_to_ir
import stdlib.compiler.typed_ast as typed_ast

# PR 2.5 — IR-level pattern matching.
# Phase 1 (this file): hand-built IRPrograms exercising the new IR ops
# (IRGetTag, IRGetField, IRAbortMatch) through the IR lowering and
# dataflow-rooting passes.  Phase 2 (translator-driven cases) exercises
# `translate_match` in `ast_to_ir.sprout` end-to-end.
#
# Design reference: docs/pr-2.5-pattern-matching-plan.md.
# Post-ship cleanup batch tracked in docs/backlog.md.
# /code-review fix #7 + #8: accumulator conventions in bind_ctor_field_args
# and translate_match_arms switched from O(N²) list_append-to-tail to
# O(N) Cons-prepend with single final reverse. Behavior unchanged; tests
# below are the regression gate.
# /code-review fix #10: field-kind encoder + decoder + helpers extracted
# to stdlib.compiler.field_kinds (was triplicated across codegen.sprout
# and ast_to_ir.sprout). Existing assertions cover behavior; structural
# change validated by the IR codegen suite still passing end-to-end.
# /code-review-v2: stale-comment audit applied after fix #2 unified Bool
# as i64 throughout the IR pipeline. See sprout_ir.sprout:143, ast_to_ir
# translate_call/lambda/module-docblock for the updated comments.
# /code-review-v2 #9 + #10: translate_match_after_scrut and finish_match use
# list_append at the boundary with translate_expr's source-ordered output.
# This is O(|s_ops|)/O(|s_blocks|) once per match expression — NOT O(N²) per
# arm. The Cons-prepend convention (fix #7/#8) is internal to translate_match_arms
# only; widening it into translate_expr is out of scope. These refactors are
# behavior-preserving; the T-match-1 through T-match-6 assertions below are
# the regression gate.

fn contains(haystack: String, needle: String) -> Bool =
  str_find(haystack, needle) != -1

# Pipeline: insert_roots then lower.  Same shape as test_ir_rooting.spr.
fn lower_with_roots(prog: sprout_ir.IRProgram) -> String =
  ir_lowering.lower_program(ir_rooting.insert_roots(prog, dict_empty()))

# Drive a Sprout source string through lex -> parse -> typecheck_typed ->
# lower_program -> ast_to_ir.translate_program.  Same shape as
# test_ir_codegen_ctors.spr's helper.  Used for Phase-2 translator-
# driven match coverage.
fn translate_source(src: String) -> Result String String !{IO} =
  match lexer.tokenize(src) with
  | Err _ -> Err("lex error")
  | Ok toks ->
      match parser.parse_program(toks) with
      | Err _ -> Err("parse error")
      | Ok prog ->
          do
            tc <- checker.typecheck_typed(prog, Nil)
            match tc with
            | typed_ast.TypedErr _ msg -> Err("check: " ++ msg)
            | typed_ast.TypedOk typed_prog env ->
                match lowering.lower_program(typed_prog, env) with
                | lowering.LowerErr msg -> Err("lower: " ++ msg)
                | lowering.LowerOk lowered ->
                    match ast_to_ir.translate_program(lowered) with
                    | Err msg -> Err(msg)
                    | Ok pair ->
                        match pair with
                        | (ir_prog, idx_map) ->
                            Ok(ir_lowering.lower_program(ir_rooting.insert_roots(ir_prog, idx_map)))

# True iff translate_source(src) returned Err whose message contains needle.
fn translated_err_contains(src: String, needle: String) -> Bool !{IO} =
  match translate_source(src) with
  | Err msg -> str_find(msg, needle) != -1
  | Ok _ -> false

# True iff translate_source(src) returned Ok whose lowered IR contains needle.
fn translated_ok_ir_contains(src: String, needle: String) -> Bool !{IO} =
  match translate_source(src) with
  | Ok ir -> str_find(ir, needle) != -1
  | Err _ -> false

# Verify that an already-lowered IR string passes clang's LLVM verifier.
#
# /code-review-v2 fix D (issues #8, #14, #15):
#  - #15: takes the IR string directly (not src), so translate_source
#    is called only ONCE per test — the caller matches on translate_source
#    and passes `ir` here. The old translated_ir_verifies(src) re-ran
#    translate_source internally, duplicating the pipeline whenever a
#    T-match-N also called translated_ok_ir_contains on the same src.
#  - #14: probes `clang --version` before verifying. If clang is absent
#    from PATH the helper emits a diagnostic and returns true (auto-skip)
#    rather than false (false-failure). Auto-skip is friendlier to
#    environments where clang is not always installed; CI always has it.
#    The clang-availability check runs per-call (7 invocations). At 7
#    calls that is negligible — a Ref cache would add surface area for
#    no measurable gain.
#  - #8: on clang-rejects-IR, surface clang's stderr via term_write
#    before returning false. Previously both an Err from translate_source
#    AND a clang rejection produced a silent false, making failures
#    impossible to diagnose without re-running manually.
#    Note: term_write writes to stdout (not stderr) — no stderr-writing
#    builtin exists; stdout diagnostic is better than silence.
fn clang_verifies_ir(ir: String) -> Bool !{IO} =
  do
    probe <- process.proc_run(Cons("clang", Cons("--version", Nil)))
    match process.proc_ok(probe) with
    | false ->
        do
          term_write("[clang_verifies_ir] clang not in PATH — assertion auto-passes\n")
          true
    | true ->
        do
          result <- process.proc_run_stdin(
            Cons("clang",
            Cons("-c",
            Cons("-x", Cons("ir",
            Cons("-o", Cons("/dev/null",
            Cons("-", Nil))))))),
            ir)
          match process.proc_ok(result) with
          | true -> true
          | false ->
              do
                term_write("[clang_verifies_ir] clang rejected IR — stderr:\n")
                term_write(process.proc_stderr(result))
                term_write("\n")
                false

# --------------------------------------------------------------------------
# Hand-built programs for each new op.
# --------------------------------------------------------------------------

# tag_program: IRGetTag returns a scalar i64 tag from a (pretend) handle.
# Tests bare lowering of IRGetTag.
fn tag_program() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("get_tag_demo", Cons(("h", sprout_ir.IRTHeap), Nil), "i64", Cons(
      sprout_ir.IRBlock("entry", Cons(
        sprout_ir.IRGetTag("%t0", "%h"),
        Cons(sprout_ir.IRRet("%t0"), Nil))),
      Nil)),
    Nil), Nil)

# field_program_scalar: IRGetField with "scalar" kind — result is not heap.
fn field_program_scalar() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("get_field_scalar", Cons(("h", sprout_ir.IRTHeap), Nil), "i64", Cons(
      sprout_ir.IRBlock("entry", Cons(
        sprout_ir.IRGetField("%t0", "%h", 0, sprout_ir.IRTScalar),
        Cons(sprout_ir.IRRet("%t0"), Nil))),
      Nil)),
    Nil), Nil)

# field_program_heap: IRGetField with "heap" kind whose result lives
# across a *non-consuming* trigger.  The first IRMakeCtor ("Marker", 0
# args) allocates but does NOT take %f as an operand, so %f is genuinely
# live across that trigger — rooter must push a root for %f before
# "Marker" and pop after.  Mirrors the real pattern-matching case where
# a field bound at the top of a branch body is used after one or more
# intermediate allocations.
fn field_program_heap() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("get_field_heap", Cons(("h", sprout_ir.IRTHeap), Nil), "i64", Cons(
      sprout_ir.IRBlock("entry", Cons(
        sprout_ir.IRGetField("%f", "%h", 0, sprout_ir.IRTHeap),
        Cons(sprout_ir.IRMakeCtor("%marker", "Marker", 50, Nil),
        Cons(sprout_ir.IRMakeCtor("%r", "WrapBoxed", 99,
                                  Cons("%f", Cons("%marker", Nil))),
        Cons(sprout_ir.IRRet("%r"), Nil))))),
      Nil)),
    Nil), Nil)

# field_program_scalar_across_trigger: IRGetField with "scalar" kind
# (Int field) whose result lives across an allocation.  Rooter must NOT
# push a root — scalars are not GC handles.  Negative control.
fn field_program_scalar_across_trigger() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("get_field_scalar_across", Cons(("h", sprout_ir.IRTHeap), Nil), "i64", Cons(
      sprout_ir.IRBlock("entry", Cons(
        sprout_ir.IRGetField("%n", "%h", 0, sprout_ir.IRTScalar),
        Cons(sprout_ir.IRMakeCtor("%marker", "Marker", 50, Nil),
        Cons(sprout_ir.IRMakeCtor("%r", "WrapInt", 51,
                                  Cons("%n", Cons("%marker", Nil))),
        Cons(sprout_ir.IRRet("%r"), Nil))))),
      Nil)),
    Nil), Nil)

# abort_program: IRAbortMatch produces the abort+unreachable terminator pair.
# Post /code-review fix #15: IRAbortMatch is field-less (declared void noreturn).
fn abort_program() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("abort_demo", Nil, "i64", Cons(
      sprout_ir.IRBlock("entry", Cons(
        sprout_ir.IRAbortMatch, Nil)),
      Nil)),
    Nil), Nil)

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # --- Pretty printer covers each new op ---
    assert_true(state, "pretty: get_tag rendered",
                contains(sprout_ir.print_ir_program(tag_program()), "get_tag"))
    assert_true(state, "pretty: get_field rendered",
                contains(sprout_ir.print_ir_program(field_program_scalar()), "get_field"))
    assert_true(state, "pretty: abort_match rendered",
                contains(sprout_ir.print_ir_program(abort_program()), "abort_match"))
    # --- Runtime decls appear in lowered output ---
    assert_true(state, "header declares @sprout_tag",
                contains(ir_lowering.lower_program(tag_program()),
                         "declare i64 @sprout_tag(i64)"))
    assert_true(state, "header declares @sprout_field",
                contains(ir_lowering.lower_program(field_program_scalar()),
                         "declare i64 @sprout_field(i64, i64)"))
    assert_true(state, "header declares @sprout_abort_match (void noreturn)",
                contains(ir_lowering.lower_program(abort_program()),
                         "declare void @sprout_abort_match() noreturn"))

    # --- IRGetTag lowers to call @sprout_tag ---
    assert_true(state, "IRGetTag lowers to call @sprout_tag",
                contains(ir_lowering.lower_program(tag_program()),
                         "%t0 = call i64 @sprout_tag(i64 %h)"))
    # /code-review-v2 fix #5 regression: lower_params used to produce
    # `i64 %%h` when hand-built IRPrograms supplied param names already
    # prefixed with '%'. After stripping the prefix from test programs
    # (and updating lower_params expectations), the function signature
    # must contain `i64 %h` (single %).
    assert_true(state, "hand-built tag_program signature uses single %",
                contains(ir_lowering.lower_program(tag_program()),
                         "define i64 @get_tag_demo(i64 %h)"))
    assert_false(state, "must NOT emit `i64 %%h` (double %) — regression guard",
                 contains(ir_lowering.lower_program(tag_program()),
                          "i64 %%h"))

    # --- IRGetField lowers to call @sprout_field with index ---
    assert_true(state, "IRGetField lowers to call @sprout_field(handle, idx)",
                contains(ir_lowering.lower_program(field_program_scalar()),
                         "%t0 = call i64 @sprout_field(i64 %h, i64 0)"))

    # --- IRAbortMatch emits call + unreachable ---
    # /code-review fix #15: @sprout_abort_match declared void noreturn;
    # the call no longer allocates a dead i64 result SSA register.
    assert_true(state, "IRAbortMatch lowers to call void @sprout_abort_match",
                contains(ir_lowering.lower_program(abort_program()),
                         "call void @sprout_abort_match()"))
    assert_true(state, "IRAbortMatch emits unreachable terminator",
                contains(ir_lowering.lower_program(abort_program()), "unreachable"))
    assert_false(state, "IRAbortMatch must NOT emit a dead i64 result SSA",
                 contains(ir_lowering.lower_program(abort_program()),
                          "= call i64 @sprout_abort_match"))
    assert_true(state, "@sprout_abort_match declared void noreturn",
                contains(ir_lowering.lower_program(abort_program()),
                         "declare void @sprout_abort_match() noreturn"))

    # IRConstBool / IRICmpBool removed in /code-review fix #2 — Bool flows
    # as i64 uniformly through the IR; the i1 specialty ops introduced an
    # avoidable type mismatch with i64 function parameters and produced
    # invalid LLVM IR when a Bool param was used as a match scrutinee.
    # See the i64-uniform assertions in T-match-2 below.

    # --- Rooting: IRGetField with kind="heap" whose result lives across
    # IRMakeCtor MUST get a root pushed before the ctor and popped after.
    # This is the load-bearing rooting case for pattern-match field binds.
    # Looking for the CALL site (prefixed by "call i64") to exclude the
    # `declare i64 @sprout_gc_push_i64_root(ptr)` line in the IR header,
    # which trivially appears regardless of rooting work.
    assert_true(state, "rooting: IRGetField heap result has a root-push call",
                contains(lower_with_roots(field_program_heap()),
                         "call i64 @sprout_gc_push_i64_root"))
    assert_true(state, "rooting: IRGetField heap result has a root-pop call",
                contains(lower_with_roots(field_program_heap()),
                         "call i64 @sprout_gc_pop_roots"))
    # Negative control: IRGetField with kind="scalar" across the SAME
    # cross-trigger shape must NOT push a root — scalar fields are i64
    # values (Int), not GC handles.  Differs from field_program_scalar
    # above (which has no trigger at all) — this version exercises the
    # heap-vs-scalar discrimination in op_produces_simple_heap.
    assert_false(state, "rooting: IRGetField scalar across trigger does NOT push a root",
                 contains(lower_with_roots(field_program_scalar_across_trigger()),
                          "call i64 @sprout_gc_push_i64_root"))

    # =================================================================
    # Phase 2 — translator-driven tests for ast_to_ir.translate_match.
    # Source pattern follows test_ir_codegen_ctors.spr exactly: bare
    # function definitions, no `fn main()`, no `print`, no `(..)`
    # visibility markers.  IRAbortMatch coverage stays in Phase 1
    # (abort_program above) — adding an inexhaustive-match translator
    # case would require an `is_open` AST flag that is out of PR 2.5
    # scope.
    # =================================================================

    # T-match-1: int match — wildcard fallthrough.  Lowering must show
    # icmp eq i64 (for the literal `0`) and a phi at the join.
    # translate_source runs ONCE; both substring and clang checks share the
    # same ir value. /code-review-v2 fix #15.
    let src_int_match = "fn classify(n: Int) -> Int = match n with | 0 -> 1 | _ -> 2"
    match translate_source(src_int_match) with
    | Err msg ->
        do
          term_write("T-match-1: translate_source failed: ")
          term_write(msg)
          term_write("\n")
          assert_true(state, "T-match-1: int match compiles via IR codegen", false)
    | Ok ir_int_match ->
        do
          assert_true(state, "T-match-1: int match compiles via IR codegen",
                      contains(ir_int_match, "define i64 @classify"))
          assert_true(state, "T-match-1: int match emits icmp eq i64",
                      contains(ir_int_match, "icmp eq i64"))
          assert_true(state, "T-match-1: int match emits phi at join",
                      contains(ir_int_match, "= phi i64"))
          clang_ok_1 <- clang_verifies_ir(ir_int_match)
          assert_true(state, "T-match-1: lowered IR passes clang verifier", clang_ok_1)

    # T-match-2: bool match — verifies TBool literal lowering AND
    # BoolPattern lowering together. After /code-review fix #2, Bool flows
    # as i64 throughout (0 or 1), eliminating the i64/i1 LLVM type mismatch
    # that the previous IRConstBool/IRICmpBool path produced when the
    # scrutinee was a Bool function parameter (declared i64 by lower_params).
    # The test asserts the *correct* i64-uniform lowering: TBool → `add i64`,
    # BoolPattern → `icmp eq i64`. The negative assertions guard against
    # regression of the old i1 path.
    # translate_source runs ONCE; both substring and clang checks share the
    # same ir value. /code-review-v2 fix #15.
    let src_bool_match = "fn not_b(b: Bool) -> Int = match b with | true -> 0 | false -> 1"
    match translate_source(src_bool_match) with
    | Err msg ->
        do
          term_write("T-match-2: translate_source failed: ")
          term_write(msg)
          term_write("\n")
          assert_true(state, "T-match-2: bool match compiles via IR codegen", false)
    | Ok ir_bool_match ->
        do
          assert_true(state, "T-match-2: bool match compiles via IR codegen",
                      contains(ir_bool_match, "define i64 @not_b"))
          assert_true(state, "T-match-2: bool match emits icmp eq i64 (no i1 mismatch)",
                      contains(ir_bool_match, "icmp eq i64"))
          assert_true(state, "T-match-2: TBool literal lowers to add i64 (uniform i64 path)",
                      contains(ir_bool_match, "add i64 0,"))
          # /code-review fix #2 regression: must NOT emit `icmp eq i1 %b` where %b
          # is a Bool function parameter declared i64. The old path emitted this
          # and produced invalid LLVM IR (silently passing substring tests).
          assert_false(state, "T-match-2: must NOT emit icmp eq i1 %b (Bool param i64/i1 mismatch)",
                       contains(ir_bool_match, "icmp eq i1 %b"))
          assert_false(state, "T-match-2: must NOT emit add i1 (Bool literal kept as i64)",
                       contains(ir_bool_match, "add i1 0,"))
          # This is the assertion that, had it existed before fix #2, would have
          # caught the i64/i1 mismatch directly — clang's verifier rejects
          # 'icmp eq i1' applied to an i64-declared SSA name.
          clang_ok_2 <- clang_verifies_ir(ir_bool_match)
          assert_true(state, "T-match-2: lowered IR passes clang verifier (the bug #2 catcher)",
                      clang_ok_2)

    # T-match-3: ctor match no binding — boxed ADT (0-arity, escapes
    # ctor_is_cpr_eligible: max_arity ∈ {1,2}).  Asserts @sprout_tag.
    # translate_source runs ONCE. /code-review-v2 fix #15.
    let src_ctor_no_bind = "type Shape = Red | Blue\nfn label(c: Shape) -> Int = match c with | Red -> 0 | Blue -> 1"
    match translate_source(src_ctor_no_bind) with
    | Err msg ->
        do
          term_write("T-match-3: translate_source failed: ")
          term_write(msg)
          term_write("\n")
          assert_true(state, "T-match-3: 0-arity ctor match compiles", false)
    | Ok ir_ctor_no_bind ->
        do
          assert_true(state, "T-match-3: 0-arity ctor match compiles",
                      contains(ir_ctor_no_bind, "define i64 @label"))
          assert_true(state, "T-match-3: ctor match emits @sprout_tag call",
                      contains(ir_ctor_no_bind, "call i64 @sprout_tag"))
          clang_ok_3 <- clang_verifies_ir(ir_ctor_no_bind)
          assert_true(state, "T-match-3: lowered IR passes clang verifier", clang_ok_3)

    # T-match-4: ctor match WITH binding — max_arity=3 escapes CPR.
    # Asserts @sprout_tag AND @sprout_field calls appear.
    # translate_source runs ONCE. /code-review-v2 fix #15.
    let src_ctor_bind = "type Trip = MyTrip Int Int Int | MyEmpty\nfn sum_or_zero(t: Trip) -> Int = match t with | MyTrip a b c -> a + b + c | MyEmpty -> 0"
    match translate_source(src_ctor_bind) with
    | Err msg ->
        do
          term_write("T-match-4: translate_source failed: ")
          term_write(msg)
          term_write("\n")
          assert_true(state, "T-match-4: ctor-with-binding match compiles", false)
    | Ok ir_ctor_bind ->
        do
          assert_true(state, "T-match-4: ctor-with-binding match compiles",
                      contains(ir_ctor_bind, "define i64 @sum_or_zero"))
          assert_true(state, "T-match-4: emits @sprout_tag for ctor discrimination",
                      contains(ir_ctor_bind, "call i64 @sprout_tag"))
          assert_true(state, "T-match-4: emits @sprout_field for binding extraction",
                      contains(ir_ctor_bind, "call i64 @sprout_field"))
          clang_ok_4 <- clang_verifies_ir(ir_ctor_bind)
          assert_true(state, "T-match-4: lowered IR passes clang verifier", clang_ok_4)

    # T-match-5: String constructor field translates end-to-end. This is a
    # translator-level smoke test for /code-review fix #1 (field-kinds 's'
    # → "heap"). The fix's rooting correctness — that IRGetField with
    # kind="heap" results in @sprout_gc_push_i64_root when the field is
    # live across an alloc — is already covered by the Phase-1 hand-built
    # `field_program_heap` test above. Using max_arity=3 to escape CPR.
    # translate_source runs ONCE. /code-review-v2 fix #15.
    let src_string_field = "type StrBox = SBox3 String Int Int | EmptyBox\nfn extract(w: StrBox) -> Int = match w with | SBox3 _ n _ -> n | EmptyBox -> 0"
    match translate_source(src_string_field) with
    | Err msg ->
        do
          term_write("T-match-5: translate_source failed: ")
          term_write(msg)
          term_write("\n")
          assert_true(state, "T-match-5: String-field ctor match translates end-to-end", false)
    | Ok ir_string_field ->
        do
          assert_true(state, "T-match-5: String-field ctor match translates end-to-end",
                      contains(ir_string_field, "define i64 @extract"))
          clang_ok_5 <- clang_verifies_ir(ir_string_field)
          assert_true(state, "T-match-5: lowered IR passes clang verifier", clang_ok_5)

    # T-match-6: wildcard-not-last preserves subsequent arms in the IR
    # AND produces structurally-valid LLVM IR.
    #
    # /code-review #3 + #6 fix: previously translate_match_arm_body_always
    # short-circuited without recursing into rest_arms — any arm after a
    # wildcard was silently dropped from the IR. The runtime semantics
    # were correct (wildcard catches everything), but the structure was
    # fragile: the function performed an early `list_reverse` on the
    # phi accumulator that would scramble phi ordering if anyone later
    # added recursion. The fix unifies the recursion shape with the
    # test-bearing arm functions, eliminating the fragility and matching
    # the old codegen's "emit dead-arm blocks, let LLVM DCE remove them"
    # convention.
    # translate_source runs ONCE. /code-review-v2 fix #15.
    let src_wildcard_first = "fn classify(n: Int) -> Int = match n with | _ -> 1 | 5 -> 99"
    match translate_source(src_wildcard_first) with
    | Err msg ->
        do
          term_write("T-match-6: translate_source failed: ")
          term_write(msg)
          term_write("\n")
          assert_true(state, "T-match-6: wildcard-first compiles via IR codegen", false)
    | Ok ir_wildcard_first ->
        do
          assert_true(state, "T-match-6: wildcard-first compiles via IR codegen",
                      contains(ir_wildcard_first, "define i64 @classify"))
          assert_true(state, "T-match-6: dead arm after wildcard IS translated (icmp present)",
                      contains(ir_wildcard_first, "icmp eq i64"))
          clang_ok_6 <- clang_verifies_ir(ir_wildcard_first)
          assert_true(state, "T-match-6: wildcard-first lowered IR passes clang verifier",
                      clang_ok_6)

    # T-match-7: ctor-field binding must NOT leak into subsequent arms.
    #
    # /code-review fix #4: translate_match_arm_body_with_test_and_ops
    # previously forwarded `captures` (= arm_captures, the outer captures
    # extended with this arm's field bindings) to translate_match_arms for
    # rest_arms. If an outer name (e.g. a function parameter `x`) was
    # SHADOWED by a ctor field of the same name in one arm, a SIBLING arm
    # that referenced the outer `x` would resolve to the field binding's
    # SSA name — a value defined in a foreign basic block. LLVM's verifier
    # rejects cross-block SSA references without an intervening phi.
    #
    # Scenario from V4 verifier: outer `x` shadowed by Foo's first-field
    # binding; Bar's body references outer `x`. Assertion uses the
    # clang-verify gate (substring matches can't distinguish a correct
    # %x from a leaked one — only the LLVM verifier can).
    # translate_source runs ONCE. /code-review-v2 fix #15.
    let src_capture_leak = "type Tag = Foo Int Int Int | Bar\nfn use_x(x: Int, t: Tag) -> Int = match t with | Foo x _ _ -> x | Bar -> x"
    match translate_source(src_capture_leak) with
    | Err msg ->
        do
          term_write("T-match-7: translate_source failed: ")
          term_write(msg)
          term_write("\n")
          assert_true(state, "T-match-7: shadowed-field + sibling-arm match compiles", false)
    | Ok ir_capture_leak ->
        do
          assert_true(state, "T-match-7: shadowed-field + sibling-arm match compiles",
                      contains(ir_capture_leak, "define i64 @use_x"))
          clang_ok_7 <- clang_verifies_ir(ir_capture_leak)
          assert_true(state, "T-match-7: lowered IR passes clang verifier (captures-leak detector)",
                      clang_ok_7)

    # T-match-8: VarPattern binding must NOT leak into subsequent arms.
    #
    # /code-review-v2 fix #4 (always-arm path): translate_match_arm_body_always
    # previously passed the extended captures dict (with the VarPattern binding
    # added by translate_match_one_arm) into the translate_match_arms recursion
    # for rest_arms. If an outer name was shadowed by the VarPattern binding,
    # a sibling arm would resolve to the scrutinee SSA — a value defined in
    # a foreign basic block. Clang's verifier rejects cross-block SSA references
    # without an intervening phi.
    #
    # Example: `| x -> 0` binds scrutinee n to local x (shadows param x);
    # `| _ -> x` must resolve x back to the param, not the scrutinee SSA.
    # The clang-verify gate is the only reliable detector here — substring
    # assertions cannot distinguish a correct %x (param) from a leaked one.
    # translate_source runs ONCE. /code-review-v2 fix #15.
    let src_var_capture_leak = "fn use_x(x: Int, n: Int) -> Int = match n with | x -> 0 | _ -> x"
    match translate_source(src_var_capture_leak) with
    | Err msg ->
        do
          term_write("T-match-8: translate_source failed: ")
          term_write(msg)
          term_write("\n")
          assert_true(state, "T-match-8: VarPattern binding compiles via IR codegen", false)
    | Ok ir_var_capture_leak ->
        do
          assert_true(state, "T-match-8: VarPattern binding compiles via IR codegen",
                      contains(ir_var_capture_leak, "define i64 @use_x"))
          clang_ok_8 <- clang_verifies_ir(ir_var_capture_leak)
          assert_true(state, "T-match-8: VarPattern binding must NOT leak into sibling arms (clang verifier)",
                      clang_ok_8)

    # Regression guard: translator-driven path must NOT emit `call i64 @sprout_abort_match`.
    # The hand-built abort_program test (Phase 1, above) guards the new IR-lowering path;
    # this assertion extends coverage to the old codegen path invoked by translate_source.
    assert_false(state, "translator path must NOT emit `call i64 @sprout_abort_match` (void fix regression)",
                 translated_ok_ir_contains(src_int_match, "call i64 @sprout_abort_match"))

    # T-match-9: Bool-returning match with a comparison body arm — exercises
    # /code-review-v2 fix #3 (IRZext after IRICmp + IRTrunc before IRCondBr).
    let src_bool_ret_match = "fn classify(n: Int) -> Bool = match n with | 0 -> false | _ -> n > 0"
    match translate_source(src_bool_ret_match) with
    | Err msg_9 ->
        do
          term_write("T-match-9 translate_source failed: ")
          term_write(msg_9)
          term_write("\n")
          assert_true(state, "T-match-9: Bool-returning match compiles", false)
    | Ok ir_bool_match ->
        do
          assert_true(state, "T-match-9: Bool-returning match with comparison arm compiles",
                      contains(ir_bool_match, "define i64 @classify"))
          assert_true(state, "T-match-9: phi at match join is typed i64 (post IRZext)",
                      contains(ir_bool_match, "= phi i64"))
          assert_true(state, "T-match-9: comparison result widened via zext i1 ... to i64",
                      contains(ir_bool_match, "zext i1"))
          clang_ok_9 <- clang_verifies_ir(ir_bool_match)
          assert_true(state, "T-match-9: lowered IR passes clang verifier (#3 closed)",
                      clang_ok_9)

    # T-match-10: Bool-returning lambda — /code-review-v2 fix #6.
    # Post fix #3, Bool-returning closures emit consistent i64 IR. The guard
    # in translate_lambda was removed; this test asserts the lambda lowers
    # cleanly (no Err) and the resulting IR is verifier-clean.
    let src_bool_lambda = "fn apply_pred(n: Int) -> Bool = (\\x -> x > 0)(n)"
    match translate_source(src_bool_lambda) with
    | Err msg_10 ->
        do
          term_write("T-match-10 translate_source failed: ")
          term_write(msg_10)
          term_write("\n")
          assert_true(state, "T-match-10: Bool-returning lambda compiles (#6 closed)", false)
    | Ok ir_bool_lambda ->
        do
          assert_true(state, "T-match-10: Bool-returning lambda compiles (#6 closed)",
                      contains(ir_bool_lambda, "define i64 @apply_pred"))
          clang_ok_10 <- clang_verifies_ir(ir_bool_lambda)
          assert_true(state, "T-match-10: Bool-returning lambda IR passes clang verifier",
                      clang_ok_10)

    # T-match-11: Bool-capturing lambda — /code-review-v2 fix #7.
    # Same rationale as T-match-10. IRLoadEnvSlot returns i64 which matches
    # the captured Bool's i64 representation.
    let src_bool_capture = "fn apply_with_flag(flag: Bool, n: Int) -> Int = (\\x -> if flag then x + 1 else x - 1)(n)"
    match translate_source(src_bool_capture) with
    | Err msg_11 ->
        do
          term_write("T-match-11 translate_source failed: ")
          term_write(msg_11)
          term_write("\n")
          assert_true(state, "T-match-11: Bool-capturing lambda compiles (#7 closed)", false)
    | Ok ir_bool_capture ->
        do
          assert_true(state, "T-match-11: Bool-capturing lambda compiles (#7 closed)",
                      contains(ir_bool_capture, "define i64 @apply_with_flag"))
          clang_ok_11 <- clang_verifies_ir(ir_bool_capture)
          assert_true(state, "T-match-11: Bool-capturing lambda IR passes clang verifier",
                      clang_ok_11)

    summary(state)
