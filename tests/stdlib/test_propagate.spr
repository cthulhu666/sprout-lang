import stdlib.test (check_eq, run_suite)

# Propagate: `branch` splits a `t a` into its value or its failure, and the
# failure comes back re-typed as `t b` for any `b` (docs/try-propagate-v0.md §4.1).

# The failure holds no `a`, so it fits a block of another success type.
fn maybe_len(m: Maybe String) -> Maybe Int =
  match branch(m) with
  | Continue s -> Just(str_len(s))
  | Break r -> r

fn result_len(r: Result String String) -> Result String Int =
  match branch(r) with
  | Continue s -> Ok(str_len(s))
  | Break failure -> failure

# A user type with two kinds of failure.
type Fetch a =
  | Got a
  | NotFound
  | Failed String

instance Propagate Fetch
  fn branch(value: Fetch a) -> ControlFlow (Fetch b) a =
    match value with
    | Got v -> Continue(v)
    | NotFound -> Break(NotFound)
    | Failed why -> Break(Failed(why))

fn fetch_text(f: Fetch Int) -> String =
  match f with
  | Got v -> `got ${v}`
  | NotFound -> "not found"
  | Failed why -> `failed: ${why}`

fn fetch_double(f: Fetch Int) -> Fetch Int =
  match branch(f) with
  | Continue v -> Got(v * 2)
  | Break r -> r

# Generic code needs `Applicative t` too, to build the success (§9 Q14).
fn bump(x: t Int) -> t Int where Propagate t, Applicative t =
  match branch(x) with
  | Continue v -> pure(v + 1)
  | Break r -> r

# Each names the instance it exercises, with the failure kept at its own type.
fn maybe_flow(m: Maybe Int) -> ControlFlow (Maybe Int) Int = branch(m)

fn result_flow(r: Result String Int) -> ControlFlow (Result String Int) Int = branch(r)

# The law `branch(pure(x)) == Continue(x)`, for each prelude instance.
fn maybe_law(x: Int) -> Bool = maybe_flow(pure(x)) == Continue(x)

fn result_law(x: Int) -> Bool = result_flow(pure(x)) == Continue(x)

fn main() -> Unit !{IO} =
  run_suite("propagate", [
    check_eq("maybe continue", maybe_flow(Just(3)), Continue(3)),
    check_eq("maybe break", maybe_flow(Nothing), Break (Nothing)),
    check_eq("result continue", result_flow(Ok(4)), Continue(4)),
    check_eq("result break", result_flow(Err("no")), Break (Err("no"))),
    check_eq("maybe retyped success", maybe_len(Just("abc")), Just(3)),
    check_eq("maybe retyped failure", maybe_len(Nothing), Nothing),
    check_eq("result retyped success", result_len(Ok("ab")), Ok(2)),
    check_eq("result failure keeps its error", result_len(Err("bad")), Err("bad")),
    check_eq("user instance success", fetch_text(fetch_double(Got(5))), "got 10"),
    check_eq("user instance not found", fetch_text(fetch_double(NotFound)), "not found"),
    check_eq("user instance failed", fetch_text(fetch_double(Failed("x"))), "failed: x"),
    check_eq("generic maybe", bump(Just(1)), Just(2)),
    check_eq("generic maybe failure", bump(Nothing), Nothing),
    check_eq("generic result", bump(Ok(1)), Ok(2)),
    check_eq("generic result failure", bump(Err("e")), Err("e")),
    check_eq("flows differ", maybe_flow(Just(3)) == maybe_flow(Nothing), false),
    check_eq("to_string continue", to_string(maybe_flow(Just(3))), "Continue(3)"),
    check_eq("to_string break", to_string(result_flow(Err("no"))), "Break(Err(no))"),
    check_eq("law: maybe", maybe_law(7), true),
    check_eq("law: result", result_law(7), true)
  ])
