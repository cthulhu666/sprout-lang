import stdlib.test (check_eq, check_true, run_suite)
import stdlib.compiler.sprout_ir as sprout_ir
import stdlib.compiler.ir_lowering as ir_lowering

# ---------------------------------------------------------------------------
# Tests for Milestone 1, PR 1.2: trivial-program IR construction + rendering.
# See docs/gc-rooting-model-c-plan-2026-06-02.md.

fn contains(haystack: String, needle: String) -> Bool =
  str_find(haystack, needle) != -1

# Build the IR equivalent of `fn answer() -> Int = 42`.
fn answer_program() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("answer", Nil, "i64", Cons(
      sprout_ir.IRBlock("entry", Cons(
        sprout_ir.IRConst("%t0", 42),
        Cons(sprout_ir.IRRet("%t0"), Nil))),
      Nil)),
    Nil), Nil, Nil, Nil)

# Build the IR equivalent of `fn id(x: Int) -> Int = x`.
fn identity_program() -> sprout_ir.IRProgram =
  sprout_ir.IRProgram(Cons(
    sprout_ir.IRFunction("id", Cons(("x", sprout_ir.IRTHeap), Nil), "i64", Cons(
      sprout_ir.IRBlock("entry", Cons(
        sprout_ir.IRRet("%x"),
        Nil)),
      Nil)),
    Nil), Nil, Nil, Nil)

fn main() -> Unit !{IO} =
  run_suite("ir_codegen_basic", [
    # print_ir_program: pretty-printer marks a populated program with a
    # non-empty header line.
    check_eq("print_ir_program empty",
              sprout_ir.print_ir_program(sprout_ir.IRProgram(Nil, Nil, Nil, Nil)),
              "; sprout-ir: empty"),
    check_true("print_ir_program contains fn header",
                contains(sprout_ir.print_ir_program(answer_program()), "fn answer")),
    check_true("print_ir_program contains const op",
                contains(sprout_ir.print_ir_program(answer_program()), "const 42")),

    # lower_program: produces valid LLVM for the answer() program.
    check_true("lower_program emits target triple",
                contains(ir_lowering.lower_program(answer_program()), "target triple")),
    check_true("lower_program defines answer as i64",
                contains(ir_lowering.lower_program(answer_program()), "define i64 @answer()")),
    check_true("lower_program returns the literal 42",
                contains(ir_lowering.lower_program(answer_program()), "ret i64 %t0")),
    check_true("lower_program binds %t0 = add i64 0, 42",
                contains(ir_lowering.lower_program(answer_program()), "add i64 0, 42")),

    # Identity function: parameter typed as i64 and returned directly.
    check_true("identity emits typed parameter",
                contains(ir_lowering.lower_program(identity_program()), "define i64 @id(i64 %x)")),
    check_true("identity returns the parameter",
                contains(ir_lowering.lower_program(identity_program()), "ret i64 %x")),

    # Synthetic C-ABI main shim is always present so the IR links cleanly.
    check_true("main shim is emitted",
                contains(ir_lowering.lower_program(answer_program()), "define i32 @main(i32 %argc, ptr %argv)"))
  ])
