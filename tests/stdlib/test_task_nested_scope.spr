import stdlib.test (TestState, new_state, assert_eq, summary)
import stdlib.task (Scope, with_scope, scope_spawn, task_yield)
import stdlib.string as string

# Nested structured concurrency under the top-level scheduler pump. Outer scope
# runs tasks P and Q; P opens its OWN inner scope (leaves X and Y) between two
# yields.
#
# Property under the pump: opening a nested scope does NOT freeze outer siblings
# (Trio/Kotlin semantics — nesting governs lifetime, not scheduling exclusion).
# While P is parked in its inner join, the single global ready queue keeps running
# Q. Lifetime is still enforced: the inner scope (X, Y) fully drains before P
# proceeds past its `with_scope`.
#
# Deterministic round-robin trace (one global ready queue):
#   P1          P -> first yield;      queue [Q, P]
#   Q1          Q -> first yield;      queue [P, Q]
#   (P opens inner scope, spawns X,Y -> queue [Q, X, Y], then parks in inner join)
#   Q2          Q -> second yield;     queue [X, Y, Q]
#   X           leaf X finishes
#   Y           leaf Y finishes -> inner drained -> wakes P; queue [Q, P]
#   Q3          Q finishes
#   P2          P resumes past inner scope -> third yield; queue [P]
#   P3          P finishes
# => "P1Q1Q2XYQ3P2P3"  (Q interleaves with the inner scope; X,Y still drain before P2)
# NB: helper is `record`, not `append` — `append` is the Semigroup class method
# that `++` desugars to; a top-level `fn append` shadows it and breaks `++`
# resolution across the whole bundle.
fn record(log: Ref String, s: String) -> Unit !{IO} =
  ref_write(log, string.concat(ref_read(log), s))

fn spawn_leaves(s: Scope, log: Ref String) -> Unit !{IO} =
  do
    scope_spawn(s, \_ -> record(log, "X"))
    scope_spawn(s, \_ -> record(log, "Y"))

fn p_worker(log: Ref String) -> Unit !{IO} =
  do
    record(log, "P1")
    task_yield()
    with_scope(\inner -> spawn_leaves(inner, log))
    record(log, "P2")
    task_yield()
    record(log, "P3")

fn q_worker(log: Ref String) -> Unit !{IO} =
  do
    record(log, "Q1")
    task_yield()
    record(log, "Q2")
    task_yield()
    record(log, "Q3")

fn spawn_pq(s: Scope, log: Ref String) -> Unit !{IO} =
  do
    scope_spawn(s, \_ -> p_worker(log))
    scope_spawn(s, \_ -> q_worker(log))

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    log <- ref_new("")
    with_scope(\s -> spawn_pq(s, log))
    assert_eq(state, "nested scope interleaving under pump", ref_read(log), "P1Q1Q2XYQ3P2P3")
    summary(state)
