import stdlib.test (check_eq, run_suite)

# `let … in` block: layout-aligned bindings under one `let`, `in` dedented to the
# `let` column. Each binding `<pat> = <e>` (irrefutable) or `<pat> = <e> else <fb>`
# (refutable). Sequential; a refute short-circuits the whole block to that else.

# Single refutable binding over a bare ADT (List).
fn first_or(xs: List Int, dflt: Int) -> Int =
  let [h | _] = xs else dflt
  in h

# Two chained bindings, each with its own distinct sentinel.
fn second(xs: List Int) -> Int =
  let [_ | rest] = xs else -1
      [y | _] = rest else -2
  in y

# Refutable binding over a Result (refutability comes from the pattern).
fn ok_or(r: Result String Int, dflt: Int) -> Int =
  let Ok v = r else dflt
  in v

# Irrefutable bindings, no else (the plain `where`-complement use); sequential.
fn plain(n: Int) -> Int =
  let x = n + 1
      y = x * 2
  in y

# Mixed block: an irrefutable binding then a refutable one whose else refers to it.
fn mixed(mx: Maybe Int) -> Int =
  let base = 10
      Just v = mx else base
  in base + v

# Tier 1b: binding-else — the else's residual pattern names the failing payload.
# `Err code` binds the Int carried by the failing branch; a constant else can't.
fn recover_code(r: Result Int Int) -> Int =
  let Ok v = r else Err code -> code
  in v

# A residual pattern that carries no payload (a plain `Nothing`), distinct from a
# constant else only in that it is a pattern — exhaustiveness still self-enforces.
fn maybe_or_zero(mx: Maybe Int) -> Int =
  let Just v = mx else Nothing -> 0
  in v

# Chained binding-else: each Result step recovers from its own payload; a first
# failure short-circuits the whole block (the second step never runs).
fn two_step(a: Result Int Int, b: Result Int Int) -> Int =
  let Ok x = a else Err code -> code
      Ok y = b else Err code -> code
  in x + y

# A bare *variable* residual binds the WHOLE scrutinee (the full Result), not an
# unwrapped payload — the design decision that keeps this parser-only and uniform
# with bare-ADT bindings. Here `other` is the failing `Result Int Int` itself.
fn whole_scrut(r: Result Int Int) -> Int =
  let Ok v = r else other ->
        (match other with
         | Err e -> e + 100
         | Ok w -> w)
  in v

fn main() -> Unit !{IO} =
  run_suite("let_else", [
    check_eq("single refutable: match", first_or(Cons(7, Nil), 0), 7),
    check_eq("single refutable: else", first_or(Nil, 99), 99),
    check_eq("two bindings: second element", second(Cons(1, Cons(2, Nil))), 2),
    check_eq("two bindings: first sentinel", second(Nil), -1),
    check_eq("two bindings: second sentinel", second(Cons(1, Nil)), -2),
    check_eq("Result: Ok binds value", ok_or(Ok(5), 0), 5),
    check_eq("Result: Err takes else", ok_or(Err("nope"), 42), 42),
    check_eq("irrefutable block, no else", plain(3), 8),
    check_eq("mixed block: Just", mixed(Just(5)), 15),
    check_eq("mixed block: Nothing short-circuits to else", mixed(Nothing), 10),
    check_eq("binding-else: Ok binds value", recover_code(Ok(5)), 5),
    check_eq("binding-else: Err payload recovered", recover_code(Err(42)), 42),
    check_eq("maybe residual: Just", maybe_or_zero(Just(7)), 7),
    check_eq("maybe residual: Nothing", maybe_or_zero(Nothing), 0),
    check_eq("chained binding-else: both Ok", two_step(Ok(3), Ok(4)), 7),
    check_eq("chained binding-else: first Err short-circuits", two_step(Err(7), Ok(4)), 7),
    check_eq("chained binding-else: second Err", two_step(Ok(3), Err(9)), 9),
    check_eq("bare residual binds whole scrutinee", whole_scrut(Err(5)), 105)
  ])
