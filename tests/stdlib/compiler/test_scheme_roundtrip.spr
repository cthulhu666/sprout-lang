import stdlib.test (TestState, new_state, assert_eq, assert_true, summary)
import stdlib.compiler.types as types
import stdlib.compiler.iface_codec as iface_codec

# Phase 1 iface codec round-trip: hand-written encode/decode for
# types.Scheme + its transitive deps (types.Type, types.Effect) must produce
# structurally-equal output through every Sprout-compiler-relevant variant.
#
# Format reference: stdlib/compiler/iface_codec.sprout module header.
# Design ref: docs/iface-precompiled-modules-v1-draft.md §"Smallest verifiable
# Phase 1 unit".

fn roundtrip(s: types.Scheme) -> Maybe types.Scheme =
  iface_codec.decode_scheme(iface_codec.encode_scheme(s))

# Convenience constructors to keep test cases readable.
fn mono_const(name: String) -> types.Scheme = types.mono(types.TConst(types.type_id(name)))

# Unconstrained scheme (empty constraint list) — the common case here.
fn sch(tvars: List String, evars: List String, body: types.Type, effect: types.Effect) -> types.Scheme =
  types.Scheme(tvars, evars, body, effect, Nil)

fn scheme_just_tvar(v: String) -> types.Scheme =
  sch(Cons(v, Nil), Nil, types.TVar(types.tyvar_id(v)), types.EffectPure)

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # --- TConst variants ---
    assert_eq(state, "tconst int", roundtrip(mono_const("Int")), Just(mono_const("Int")))
    assert_eq(state, "tconst bool", roundtrip(mono_const("Bool")), Just(mono_const("Bool")))
    assert_eq(state, "tconst string", roundtrip(mono_const("String")), Just(mono_const("String")))
    assert_eq(state, "tconst qualified",
              roundtrip(mono_const("stdlib.compiler.types.Type")),
              Just(mono_const("stdlib.compiler.types.Type")))

    # --- TVar variants ---
    assert_eq(state, "tvar single", roundtrip(scheme_just_tvar("a")), Just(scheme_just_tvar("a")))
    assert_eq(state, "tvar t123",
              roundtrip(sch(Cons("t123", Nil), Nil, types.TVar(types.tyvar_id("t123")), types.EffectPure)),
              Just(sch(Cons("t123", Nil), Nil, types.TVar(types.tyvar_id("t123")), types.EffectPure)))

    # --- TApp variants (parametric types) ---
    assert_eq(state, "tapp maybe int",
              roundtrip(types.mono(types.TApp(types.TConst(types.type_id("Maybe")), types.TConst(types.type_id("Int"))))),
              Just(types.mono(types.TApp(types.TConst(types.type_id("Maybe")), types.TConst(types.type_id("Int"))))))
    assert_eq(state, "tapp nested list maybe a",
              roundtrip(sch(
                Cons("a", Nil), Nil,
                types.TApp(types.TConst(types.type_id("List")), types.TApp(types.TConst(types.type_id("Maybe")), types.TVar(types.tyvar_id("a")))),
                types.EffectPure)),
              Just(sch(
                Cons("a", Nil), Nil,
                types.TApp(types.TConst(types.type_id("List")), types.TApp(types.TConst(types.type_id("Maybe")), types.TVar(types.tyvar_id("a")))),
                types.EffectPure)))

    # --- TFunc with various effects ---
    assert_eq(state, "tfunc pure",
              roundtrip(types.mono(types.TFunc(types.TConst(types.type_id("Int")), types.TConst(types.type_id("Int")), types.EffectPure))),
              Just(types.mono(types.TFunc(types.TConst(types.type_id("Int")), types.TConst(types.type_id("Int")), types.EffectPure))))
    assert_eq(state, "tfunc io",
              roundtrip(types.mono(types.TFunc(types.TConst(types.type_id("String")), types.TConst(types.type_id("Unit")), types.EffectIO))),
              Just(types.mono(types.TFunc(types.TConst(types.type_id("String")), types.TConst(types.type_id("Unit")), types.EffectIO))))
    assert_eq(state, "tfunc polymorphic",
              roundtrip(sch(
                Cons("a", Cons("b", Nil)), Nil,
                types.TFunc(types.TVar(types.tyvar_id("a")), types.TVar(types.tyvar_id("b")), types.EffectPure),
                types.EffectPure)),
              Just(sch(
                Cons("a", Cons("b", Nil)), Nil,
                types.TFunc(types.TVar(types.tyvar_id("a")), types.TVar(types.tyvar_id("b")), types.EffectPure),
                types.EffectPure)))

    # --- TTuple variants ---
    assert_eq(state, "ttuple pair",
              roundtrip(types.mono(types.TTuple(Cons(types.TConst(types.type_id("Int")), Cons(types.TConst(types.type_id("Bool")), Nil))))),
              Just(types.mono(types.TTuple(Cons(types.TConst(types.type_id("Int")), Cons(types.TConst(types.type_id("Bool")), Nil))))))
    assert_eq(state, "ttuple empty",
              roundtrip(types.mono(types.TTuple(Nil))),
              Just(types.mono(types.TTuple(Nil))))
    assert_eq(state, "ttuple nested",
              roundtrip(types.mono(types.TTuple(Cons(types.TTuple(Cons(types.TConst(types.type_id("Int")), Nil)), Cons(types.TConst(types.type_id("Bool")), Nil))))),
              Just(types.mono(types.TTuple(Cons(types.TTuple(Cons(types.TConst(types.type_id("Int")), Nil)), Cons(types.TConst(types.type_id("Bool")), Nil))))))

    # --- Effect variants ---
    assert_eq(state, "effect pure top-level",
              roundtrip(sch(Nil, Nil, types.TConst(types.type_id("Int")), types.EffectPure)),
              Just(sch(Nil, Nil, types.TConst(types.type_id("Int")), types.EffectPure)))
    assert_eq(state, "effect io top-level",
              roundtrip(sch(Nil, Nil, types.TConst(types.type_id("Int")), types.EffectIO)),
              Just(sch(Nil, Nil, types.TConst(types.type_id("Int")), types.EffectIO)))
    assert_eq(state, "effect var",
              roundtrip(sch(Nil, Cons("e", Nil),
                            types.TFunc(types.TConst(types.type_id("Int")), types.TConst(types.type_id("Int")), types.EffectVar("e")),
                            types.EffectPure)),
              Just(sch(Nil, Cons("e", Nil),
                       types.TFunc(types.TConst(types.type_id("Int")), types.TConst(types.type_id("Int")), types.EffectVar("e")),
                       types.EffectPure)))
    assert_eq(state, "effect row multi",
              roundtrip(sch(Nil, Nil,
                            types.TFunc(types.TConst(types.type_id("Int")), types.TConst(types.type_id("Int")), types.EffectRow(Cons("IO", Cons("Async", Nil)))),
                            types.EffectPure)),
              Just(sch(Nil, Nil,
                       types.TFunc(types.TConst(types.type_id("Int")), types.TConst(types.type_id("Int")), types.EffectRow(Cons("IO", Cons("Async", Nil)))),
                       types.EffectPure)))
    assert_eq(state, "effect row empty",
              roundtrip(sch(Nil, Nil,
                            types.TFunc(types.TConst(types.type_id("Int")), types.TConst(types.type_id("Int")), types.EffectRow(Nil)),
                            types.EffectPure)),
              Just(sch(Nil, Nil,
                       types.TFunc(types.TConst(types.type_id("Int")), types.TConst(types.type_id("Int")), types.EffectRow(Nil)),
                       types.EffectPure)))

    # --- Combined: realistic compiler-style schemes ---
    # `forall a. (List a) -> Int`  — list_length-style
    assert_eq(state, "list_length scheme",
              roundtrip(sch(
                Cons("a", Nil), Nil,
                types.TFunc(types.TApp(types.TConst(types.type_id("List")), types.TVar(types.tyvar_id("a"))), types.TConst(types.type_id("Int")), types.EffectPure),
                types.EffectPure)),
              Just(sch(
                Cons("a", Nil), Nil,
                types.TFunc(types.TApp(types.TConst(types.type_id("List")), types.TVar(types.tyvar_id("a"))), types.TConst(types.type_id("Int")), types.EffectPure),
                types.EffectPure)))
    # `forall a b. a -> b -> (a, b)` — pair-construction style
    assert_eq(state, "make_pair scheme",
              roundtrip(sch(
                Cons("a", Cons("b", Nil)), Nil,
                types.TFunc(types.TVar(types.tyvar_id("a")), types.TFunc(types.TVar(types.tyvar_id("b")), types.TTuple(Cons(types.TVar(types.tyvar_id("a")), Cons(types.TVar(types.tyvar_id("b")), Nil))), types.EffectPure), types.EffectPure),
                types.EffectPure)),
              Just(sch(
                Cons("a", Cons("b", Nil)), Nil,
                types.TFunc(types.TVar(types.tyvar_id("a")), types.TFunc(types.TVar(types.tyvar_id("b")), types.TTuple(Cons(types.TVar(types.tyvar_id("a")), Cons(types.TVar(types.tyvar_id("b")), Nil))), types.EffectPure), types.EffectPure),
                types.EffectPure)))

    # --- Constrained schemes (§13.3(B): constraints carried in the Scheme) ---
    # `forall a. a -> String  where Semigroup a` — one tyvar constraint, token "#pos:0".
    assert_eq(state, "one constraint roundtrip",
              roundtrip(types.Scheme(
                Cons("a", Nil), Nil,
                types.TFunc(types.TVar(types.tyvar_id("a")), types.TConst(types.type_id("String")), types.EffectPure),
                types.EffectPure,
                Cons(("#pos:0", "Semigroup"), Nil))),
              Just(types.Scheme(
                Cons("a", Nil), Nil,
                types.TFunc(types.TVar(types.tyvar_id("a")), types.TConst(types.type_id("String")), types.EffectPure),
                types.EffectPure,
                Cons(("#pos:0", "Semigroup"), Nil))))
    # Mixed head tokens: a positional tyvar, a concrete-ctor name, and a headless
    # sentinel — exercises every head_token form through the wire round-trip.
    assert_eq(state, "multi constraint roundtrip",
              roundtrip(types.Scheme(
                Cons("a", Cons("b", Nil)), Nil,
                types.TFunc(types.TVar(types.tyvar_id("a")), types.TFunc(types.TVar(types.tyvar_id("b")), types.TConst(types.type_id("String")), types.EffectPure), types.EffectPure),
                types.EffectPure,
                Cons(("#pos:0", "Show"), Cons(("List", "Foldable"), Cons(("#none", "Default"), Nil))))),
              Just(types.Scheme(
                Cons("a", Cons("b", Nil)), Nil,
                types.TFunc(types.TVar(types.tyvar_id("a")), types.TFunc(types.TVar(types.tyvar_id("b")), types.TConst(types.type_id("String")), types.EffectPure), types.EffectPure),
                types.EffectPure,
                Cons(("#pos:0", "Show"), Cons(("List", "Foldable"), Cons(("#none", "Default"), Nil))))))
    # A wrong constraint must NOT compare equal (guards scheme_eq actually checks constraints).
    assert_eq(state, "constraint mismatch is not equal",
              (roundtrip(types.Scheme(Cons("a", Nil), Nil, types.TVar(types.tyvar_id("a")), types.EffectPure, Cons(("#pos:0", "Semigroup"), Nil)))
                == Just(types.Scheme(Cons("a", Nil), Nil, types.TVar(types.tyvar_id("a")), types.EffectPure, Cons(("#pos:0", "Eq"), Nil)))),
              false)
    # Empty constraints must still round-trip (the monomorphic/unconstrained default).
    assert_eq(state, "empty constraints roundtrip", roundtrip(mono_const("Int")), Just(mono_const("Int")))

    # --- Malformed input rejection ---
    assert_eq(state, "decode empty rejected", iface_codec.decode_scheme(""), Nothing)
    assert_eq(state, "decode garbage rejected", iface_codec.decode_scheme("not a scheme"), Nothing)
    assert_eq(state, "decode trailing chars rejected",
              iface_codec.decode_scheme("(Scheme () () (TConst Int) (EffectPure) ())  garbage"),
              Nothing)
    # An old 4-field scheme string (no constraints atom) must now be REJECTED.
    assert_eq(state, "decode old 4-field scheme rejected",
              iface_codec.decode_scheme("(Scheme () () (TConst Int) (EffectPure))"),
              Nothing)
    assert_true(state, "decode well-formed 5-field accepted",
                match iface_codec.decode_scheme("(Scheme () () (TConst Int) (EffectPure) ())") with
                | Just _ -> true
                | Nothing -> false)

    # --- Malformed TFunc rejection (exercises each failure branch of
    #     decode_tfunc_at individually — not just the whole-scheme case above) ---
    assert_eq(state, "tfunc missing return type rejected",
              iface_codec.decode_scheme("(Scheme () () (TFunc (TConst Int)) (EffectPure))"),
              Nothing)
    assert_eq(state, "tfunc missing effect rejected",
              iface_codec.decode_scheme("(Scheme () () (TFunc (TConst Int) (TConst Int)) (EffectPure))"),
              Nothing)
    assert_eq(state, "tfunc missing closing paren rejected",
              iface_codec.decode_scheme("(Scheme () () (TFunc (TConst Int) (TConst Int) (EffectPure)"),
              Nothing)
    assert_eq(state, "tfunc malformed effect rejected",
              iface_codec.decode_scheme("(Scheme () () (TFunc (TConst Int) (TConst Int) (NotAnEffect)) (EffectPure))"),
              Nothing)

    summary(state)
