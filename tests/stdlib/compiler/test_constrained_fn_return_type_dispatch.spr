import stdlib.test (TestState, new_state, assert_eq, summary)

# Regression tests for constrained-function return-type dispatch.
#
# Bug: when a constrained function's type variable appears ONLY in the return
# type (not in any argument), inject_constrained_fn_dicts ran before the
# body-vs-return-type unification (s2) and could not resolve the dict.
# The post-pass (maybe_rewrite_constrained_fn_call) now corrects this.
#
# PR fix: add post-pass for constrained fn calls mirroring resolve_dispatch_typed_expr.

class Deser a {
  fn deser(s: String) -> Maybe a
}

instance Deser Int {
  fn deser(s: String) -> Maybe Int = Just(42)
}

instance Deser Bool {
  fn deser(s: String) -> Maybe Bool = Just(true)
}

# Single-level return-type dispatch (already worked via resolve_dispatch_typed_expr).
fn deser_direct_int(s: String) -> Maybe Int = deser(s)
fn deser_direct_bool(s: String) -> Maybe Bool = deser(s)

# 2-level chain: both fn vars named 'a'.
fn deser_mid_a(s: String) -> Maybe a where Deser a = deser(s)
fn deser_outer_a(s: String) -> Maybe a where Deser a = deser_mid_a(s)
fn get_int_a(s: String) -> Maybe Int = deser_outer_a(s)
fn get_bool_a(s: String) -> Maybe Bool = deser_outer_a(s)

# 2-level chain with different prog-var names ('a' vs 'v').
fn deser_mid_v(s: String) -> Maybe a where Deser a = deser(s)
fn deser_outer_v(s: String) -> Maybe v where Deser v = deser_mid_v(s)
fn get_int_v(s: String) -> Maybe Int = deser_outer_v(s)
fn get_bool_v(s: String) -> Maybe Bool = deser_outer_v(s)

# 3-level chain.
fn deser_level3(s: String) -> Maybe a where Deser a = deser_outer_a(s)
fn get_int_3(s: String) -> Maybe Int = deser_level3(s)
fn get_bool_3(s: String) -> Maybe Bool = deser_level3(s)

fn is_just_int_42(m: Maybe Int) -> Bool =
  match m with | Just 42 -> true | _ -> false

fn is_just_true(m: Maybe Bool) -> Bool =
  match m with | Just b -> b | _ -> false

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # Single-level (pre-existing working case)
    assert_eq(state, "direct Int works", is_just_int_42(deser_direct_int("x")), true)
    assert_eq(state, "direct Bool works", is_just_true(deser_direct_bool("x")), true)

    # 2-level consistent 'a' chain (was BROKEN — no dict injected)
    assert_eq(state, "2-level_a Int", is_just_int_42(get_int_a("x")), true)
    assert_eq(state, "2-level_a Bool", is_just_true(get_bool_a("x")), true)

    # 2-level name-mismatch chain (was BROKEN)
    assert_eq(state, "2-level_v Int", is_just_int_42(get_int_v("x")), true)
    assert_eq(state, "2-level_v Bool", is_just_true(get_bool_v("x")), true)

    # 3-level chain
    assert_eq(state, "3-level Int", is_just_int_42(get_int_3("x")), true)
    assert_eq(state, "3-level Bool", is_just_true(get_bool_3("x")), true)

    summary(state)
