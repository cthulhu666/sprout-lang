module main
import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.compiler.ast_to_ir as ast_to_ir
import stdlib.compiler.ir_lowering as ir_lowering
import stdlib.compiler.ir_rooting as ir_rooting
import stdlib.compiler.sprout_ir as sprout_ir
import stdlib.string as string
import stdlib.compiler.ast as ast
import stdlib.compiler.type_kind as type_kind

# A scalar kind, minted through type_kind as the compiler does.
fn scalar() -> sprout_ir.IRType =
  match type_kind.scalar_of_type_expr(ast.TypeName("Int")) with
  | Just why -> sprout_ir.IRTScalar(why)
  | Nothing -> panic("type_kind rejects Int")

# Unit tests for the mutual-TCO rewrite (musttail / IRTailCall).  Pure
# IRFunction -> IRFunction; no seed churn (runs on the current stage-1).
# See docs/mutual-tco-v0.md.

# Pre-rooting IR for a same-prototype cycle member:
#   a(x, y) = if x <= 0 then y else b(x, y)     -- b is a() 's cycle partner
# The tail call `%r = call @main.b(%x, %y)` in `elseb` flows through join's phi
# to the ret (the scram hi_loop shape).  With ("main.b", 2) eligible, the rewrite
# must drop the call+br and emit `musttail call @main.b` + `ret`, and strip the
# [%r, elseb] incoming from join's phi (leaving the single then-incoming).
fn make_a() -> sprout_ir.IRFunction =
  sprout_ir.IRFunction("main.a",
    Cons(("x", scalar()), Cons(("y", sprout_ir.IRTHeap), Nil)),
    "i64",
    Cons(sprout_ir.IRBlock("entry",
      Cons(sprout_ir.IRConst("%t0", 0),
      Cons(sprout_ir.IRICmp("%t1", "sle", sprout_ir.param_ssa("x"), "%t0"),
      Cons(sprout_ir.IRCondBr("%t1", "thenb", "elseb"), Nil)))),
    Cons(sprout_ir.IRBlock("thenb",
      Cons(sprout_ir.IRBr("joinb"), Nil)),
    Cons(sprout_ir.IRBlock("elseb",
      Cons(sprout_ir.IRCall("%r", sprout_ir.IRTHeap, "main.b", Cons(sprout_ir.param_ssa("x"), Cons(sprout_ir.param_ssa("y"), Nil))),
      Cons(sprout_ir.IRBr("joinb"), Nil))),
    Cons(sprout_ir.IRBlock("joinb",
      Cons(sprout_ir.IRPhi("%m", "i64", Cons((sprout_ir.param_ssa("y"), "thenb"), Cons(("%r", "elseb"), Nil))),
      Cons(sprout_ir.IRRet("%m"), Nil))),
    Nil)))))

# A self-TCO'd function (carries an IRTcoEntry).  Phase A must SKIP it even
# though it contains a mutual call to main.b.
fn make_self_tco_fn() -> sprout_ir.IRFunction =
  sprout_ir.IRFunction("main.c",
    Cons(("x", scalar()), Cons(("y", sprout_ir.IRTHeap), Nil)),
    "i64",
    Cons(sprout_ir.IRBlock("entry",
      Cons(sprout_ir.IRTcoEntry(Cons(("%slot", "i64", sprout_ir.param_ssa("x$in")), Nil), "%sp"),
      Cons(sprout_ir.IRBr("tco_loop"), Nil))),
    Cons(sprout_ir.IRBlock("tco_loop",
      Cons(sprout_ir.IRCall("%r", sprout_ir.IRTHeap, "main.b", Cons(sprout_ir.param_ssa("x"), Cons(sprout_ir.param_ssa("y"), Nil))),
      Cons(sprout_ir.IRRet("%r"), Nil))),
    Nil)))

# A non-i64-returning function (i1): must be skipped (musttail needs matching
# return types).
fn make_i1_fn() -> sprout_ir.IRFunction =
  sprout_ir.IRFunction("main.p",
    Cons(("x", scalar()), Cons(("y", sprout_ir.IRTHeap), Nil)),
    "i1",
    Cons(sprout_ir.IRBlock("entry",
      Cons(sprout_ir.IRCall("%r", scalar(), "main.b", Cons(sprout_ir.param_ssa("x"), Cons(sprout_ir.param_ssa("y"), Nil))),
      Cons(sprout_ir.IRRet("%r"), Nil))),
    Nil))

# A function that tail-calls its cycle partner AND recurses into itself non-tail.
# LLVM's tailcallelim turns the self-call into an accumulator loop and puts the
# accumulate between the musttail call and its ret — invalid IR, fatal at -O2.
# Phase A must not emit musttail here.  End-to-end fixture: tests/codegen_o2/.
fn make_self_calling_fn() -> sprout_ir.IRFunction =
  sprout_ir.IRFunction("main.s",
    Cons(("x", scalar()), Cons(("y", sprout_ir.IRTHeap), Nil)),
    "i64",
    Cons(sprout_ir.IRBlock("entry",
      Cons(sprout_ir.IRConst("%t0", 0),
      Cons(sprout_ir.IRICmp("%t1", "sle", sprout_ir.param_ssa("x"), "%t0"),
      Cons(sprout_ir.IRCondBr("%t1", "thenb", "elseb"), Nil)))),
    Cons(sprout_ir.IRBlock("thenb",
      Cons(sprout_ir.IRCall("%s", sprout_ir.IRTHeap, "main.s", Cons(sprout_ir.param_ssa("x"), Cons(sprout_ir.param_ssa("y"), Nil))),
      Cons(sprout_ir.IRIAdd("%s2", "%s", "%t0"),
      Cons(sprout_ir.IRRet("%s2"), Nil)))),
    Cons(sprout_ir.IRBlock("elseb",
      Cons(sprout_ir.IRCall("%r", sprout_ir.IRTHeap, "main.b", Cons(sprout_ir.param_ssa("x"), Cons(sprout_ir.param_ssa("y"), Nil))),
      Cons(sprout_ir.IRRet("%r"), Nil))),
    Nil))))

# Tail-calls the cycle partner (→ musttail) and also calls an unrelated main.z.
# The second call is what must come out `noinline`.
fn make_two_call_fn() -> sprout_ir.IRFunction =
  sprout_ir.IRFunction("main.t",
    Cons(("x", scalar()), Cons(("y", sprout_ir.IRTHeap), Nil)),
    "i64",
    Cons(sprout_ir.IRBlock("entry",
      Cons(sprout_ir.IRConst("%t0", 0),
      Cons(sprout_ir.IRICmp("%t1", "sle", sprout_ir.param_ssa("x"), "%t0"),
      Cons(sprout_ir.IRCondBr("%t1", "thenb", "elseb"), Nil)))),
    Cons(sprout_ir.IRBlock("thenb",
      Cons(sprout_ir.IRCall("%z", sprout_ir.IRTHeap, "main.z", Cons(sprout_ir.param_ssa("x"), Cons(sprout_ir.param_ssa("y"), Nil))),
      Cons(sprout_ir.IRRet("%z"), Nil))),
    Cons(sprout_ir.IRBlock("elseb",
      Cons(sprout_ir.IRCall("%r", sprout_ir.IRTHeap, "main.b", Cons(sprout_ir.param_ssa("x"), Cons(sprout_ir.param_ssa("y"), Nil))),
      Cons(sprout_ir.IRRet("%r"), Nil))),
    Nil))))

# --- structural helper: count the incomings of block `lbl`'s first IRPhi. ---
fn fn_blocks(f: sprout_ir.IRFunction) -> List sprout_ir.IRBlock =
  match f with | sprout_ir.IRFunction _ _ _ bs -> bs

fn phi_incoming_count(blocks: List sprout_ir.IRBlock, lbl: String) -> Int =
  match blocks with
  | Nil -> -1
  | Cons b rest ->
      match b with
      | sprout_ir.IRBlock l ops ->
          if l == lbl then ops_phi_count(ops) else phi_incoming_count(rest, lbl)

fn ops_phi_count(ops: List sprout_ir.IROp) -> Int =
  match ops with
  | Nil -> -1
  | Cons op rest ->
      match op with
      | sprout_ir.IRPhi _ _ inc -> list_length(inc)
      | _ -> ops_phi_count(rest)

# Pre-TCO IR for a function with a self-tail-call and a partner tail-call:
#   s(x, y) = if x <= 0 then y
#             else if x == 1 then s(x - 1, y)      -- selfb
#             else b(x - 1, y)                      -- partnerb
fn make_self_loop_fn() -> sprout_ir.IRFunction =
  sprout_ir.IRFunction("main.s",
    Cons(("x", scalar()), Cons(("y", sprout_ir.IRTHeap), Nil)),
    "i64",
    Cons(sprout_ir.IRBlock("entry",
      Cons(sprout_ir.IRConst("%t0", 0),
      Cons(sprout_ir.IRICmp("%t1", "sle", sprout_ir.param_ssa("x"), "%t0"),
      Cons(sprout_ir.IRCondBr("%t1", "thenb", "midb"), Nil)))),
    Cons(sprout_ir.IRBlock("thenb",
      Cons(sprout_ir.IRBr("joinb"), Nil)),
    Cons(sprout_ir.IRBlock("midb",
      Cons(sprout_ir.IRConst("%one", 1),
      Cons(sprout_ir.IRICmp("%t2", "eq", sprout_ir.param_ssa("x"), "%one"),
      Cons(sprout_ir.IRCondBr("%t2", "selfb", "partnerb"), Nil)))),
    Cons(sprout_ir.IRBlock("selfb",
      Cons(sprout_ir.IRISub("%xs", sprout_ir.param_ssa("x"), "%one"),
      Cons(sprout_ir.IRCall("%rs", sprout_ir.IRTHeap, "main.s", Cons("%xs", Cons(sprout_ir.param_ssa("y"), Nil))),
      Cons(sprout_ir.IRBr("joinb"), Nil)))),
    Cons(sprout_ir.IRBlock("partnerb",
      Cons(sprout_ir.IRISub("%xp", sprout_ir.param_ssa("x"), "%one"),
      Cons(sprout_ir.IRCall("%rp", sprout_ir.IRTHeap, "main.b", Cons("%xp", Cons(sprout_ir.param_ssa("y"), Nil))),
      Cons(sprout_ir.IRBr("joinb"), Nil)))),
    Cons(sprout_ir.IRBlock("joinb",
      Cons(sprout_ir.IRPhi("%m", "i64",
             Cons((sprout_ir.param_ssa("y"), "thenb"), Cons(("%rs", "selfb"), Cons(("%rp", "partnerb"), Nil)))),
      Cons(sprout_ir.IRRet("%m"), Nil))),
    Nil)))))))

# make_self_loop_fn whose partner edge calls an unknown fn (a GC trigger) twice: the first
# result `%h` is rooted across the second call, a block-local root that needs the stack reset.
# The heap param `y` is a TCO slot of the frame.
fn make_rooted_self_loop_fn() -> sprout_ir.IRFunction =
  match make_self_loop_fn() with
  | sprout_ir.IRFunction name params ret blocks ->
      sprout_ir.IRFunction(name, params, ret, list_map(alloc_in_partner, blocks))

fn alloc_in_partner(b: sprout_ir.IRBlock) -> sprout_ir.IRBlock =
  match b with
  | sprout_ir.IRBlock "partnerb" _ ->
      sprout_ir.IRBlock("partnerb",
        Cons(sprout_ir.IRConst("%one2", 1),
        Cons(sprout_ir.IRISub("%xp", sprout_ir.param_ssa("x"), "%one2"),
        Cons(sprout_ir.IRCall("%h", sprout_ir.IRTHeap, "main.mk", Cons("%xp", Nil)),
        Cons(sprout_ir.IRCall("%g", sprout_ir.IRTHeap, "main.mk", Cons("%xp", Nil)),
        Cons(sprout_ir.IRCall("%rp", sprout_ir.IRTHeap, "main.b", Cons("%h", Cons(sprout_ir.param_ssa("y"), Nil))),
        Cons(sprout_ir.IRBr("joinb"), Nil)))))))
  | _ -> b

# Pre-TCO IR with NO base case: every path tail-calls, so the join phi holds only
# the two tail-call results:
#   n(x, y) = if x > 0 then n(x - 1, y) else b(x, y)
fn make_no_base_fn() -> sprout_ir.IRFunction =
  sprout_ir.IRFunction("main.n",
    Cons(("x", scalar()), Cons(("y", sprout_ir.IRTHeap), Nil)),
    "i64",
    Cons(sprout_ir.IRBlock("entry",
      Cons(sprout_ir.IRConst("%t0", 0),
      Cons(sprout_ir.IRICmp("%t1", "sgt", sprout_ir.param_ssa("x"), "%t0"),
      Cons(sprout_ir.IRCondBr("%t1", "selfb", "partnerb"), Nil)))),
    Cons(sprout_ir.IRBlock("selfb",
      Cons(sprout_ir.IRConst("%one", 1),
      Cons(sprout_ir.IRISub("%xs", sprout_ir.param_ssa("x"), "%one"),
      Cons(sprout_ir.IRCall("%rs", sprout_ir.IRTHeap, "main.n", Cons("%xs", Cons(sprout_ir.param_ssa("y"), Nil))),
      Cons(sprout_ir.IRBr("joinb"), Nil))))),
    Cons(sprout_ir.IRBlock("partnerb",
      Cons(sprout_ir.IRCall("%rp", sprout_ir.IRTHeap, "main.b", Cons(sprout_ir.param_ssa("x"), Cons(sprout_ir.param_ssa("y"), Nil))),
      Cons(sprout_ir.IRBr("joinb"), Nil))),
    Cons(sprout_ir.IRBlock("joinb",
      Cons(sprout_ir.IRPhi("%m", "i64", Cons(("%rs", "selfb"), Cons(("%rp", "partnerb"), Nil))),
      Cons(sprout_ir.IRRet("%m"), Nil))),
    Nil)))))

# Self-TCO, then mutual-TCO, as the pipeline orders them (both pre-rooting).
fn self_then_mutual(f: sprout_ir.IRFunction) -> sprout_ir.IRFunction =
  match ast_to_ir.tco_rewrite(f, 700) with
  | (tco_f, _) -> ast_to_ir.mutual_tco_rewrite_fn(tco_f, Cons(("main.b", 2), Nil))

fn self_then_mutual_rooted(f: sprout_ir.IRFunction) -> sprout_ir.IRFunction =
  ir_rooting.rewrite_one_fn_with_summary(
    self_then_mutual(f), dict_from_list([(sprout_ir.ir_fn_name(f), 800)]), dict_empty())

fn lower_rooted(f: sprout_ir.IRFunction, next_idx: Int) -> String =
  ir_lowering.lower_fn_with_table(
    ir_rooting.rewrite_one_fn_with_summary(f, dict_from_list([(sprout_ir.ir_fn_name(f), next_idx)]), dict_empty()),
    dict_empty())

# Lines `a` then `b` appear on consecutive lines of the lowered text.
fn adjacent_lines(lines: List String, a: String, b: String) -> Bool =
  match lines with
  | [l1 | rest] ->
      match rest with
      | [l2 | _] ->
          if str_find(l1, a) != -1 && str_find(l2, b) != -1 then true
          else adjacent_lines(rest, a, b)
      | [] -> false
  | [] -> false

fn count_substr(haystack: String, needle: String) -> Int =
  match string.find(haystack, needle) with
  | Nothing -> 0
  | Just pos -> 1 + count_substr(string.drop(haystack, pos + string.length(needle)), needle)

# Root-stack depth on reaching the first line that contains `stop`: each push is
# +1, each `pop_roots(i64 N)` is -N.
fn root_depth_before(lines: List String, stop: String, depth: Int) -> Int =
  match lines with
  | Nil -> -1000
  | Cons l rest ->
      if str_find(l, stop) != -1 then depth
      else if str_find(l, "@sprout_gc_push_i64_root") != -1 || str_find(l, "@sprout_gc_push_scan_root") != -1
      then root_depth_before(rest, stop, depth + 1)
      else root_depth_before(rest, stop, depth - pop_count(l))

fn pop_count(line: String) -> Int =
  match string.find(line, "@sprout_gc_pop_roots(i64 ") with
  | Nothing -> 0
  | Just pos ->
      let tail = string.drop(line, pos + string.length("@sprout_gc_pop_roots(i64 "))
      in
        match string.find(tail, ")") with
        | Nothing -> 0
        | Just stop ->
            match parse_int(string.take(tail, stop)) with
            | Nothing -> 0
            | Just n -> n

fn is_terminator(op: sprout_ir.IROp) -> Bool =
  match op with
  | sprout_ir.IRBr _ -> true
  | sprout_ir.IRCondBr _ _ _ -> true
  | sprout_ir.IRRet _ -> true
  | sprout_ir.IRTcoBack _ _ _ -> true
  | sprout_ir.IRTailCall _ _ _ _ -> true
  | _ -> false

fn ends_terminated(ops: List sprout_ir.IROp) -> Bool =
  match ops with
  | Nil -> false
  | Cons op rest ->
      match rest with
      | Nil -> is_terminator(op)
      | _ -> ends_terminated(rest)

fn all_blocks_terminated(blocks: List sprout_ir.IRBlock) -> Bool =
  match blocks with
  | Nil -> true
  | Cons b rest ->
      match b with
      | sprout_ir.IRBlock _ ops -> ends_terminated(ops) && all_blocks_terminated(rest)

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    # 1. Same-prototype cycle edge → rewritten to musttail.
    let rw = ast_to_ir.mutual_tco_rewrite_fn(make_a(), Cons(("main.b", 2), Nil))
    let rir = ir_lowering.lower_fn_with_table(rw, dict_empty())
    assert_true(state, "cycle edge: emits musttail to the partner",
      string.contains(rir, "musttail call i64 @main.b"))
    assert_true(state, "cycle edge: plain (non-tail) call to partner is gone",
      string.contains(rir, "%r = call i64 @main.b") == false)
    assert_true(state, "cycle edge: musttail is followed by ret",
      string.contains(rir, "ret i64 %r"))
    assert_true(state, "cycle edge: join phi lost the elseb incoming (no dangling phi)",
      phi_incoming_count(fn_blocks(rw), "joinb") == 1)

    # 2. Arity guard: eligible name but wrong arity → no rewrite.
    let bad = ast_to_ir.mutual_tco_rewrite_fn(make_a(), Cons(("main.b", 3), Nil))
    let bir = ir_lowering.lower_fn_with_table(bad, dict_empty())
    assert_true(state, "arity mismatch: NOT rewritten (stays a plain call)",
      string.contains(bir, "musttail") == false)
    assert_true(state, "arity mismatch: plain call retained",
      string.contains(bir, "call i64 @main.b"))

    # 3. Self-TCO'd function → its mutual edge is a musttail too, after the loop's
    # stackrestore (the sp is the IRTcoEntry's).
    let stc = ast_to_ir.mutual_tco_rewrite_fn(make_self_tco_fn(), Cons(("main.b", 2), Nil))
    let sir = ir_lowering.lower_fn_with_table(stc, dict_empty())
    let slines = string.split(sir, "\n")
    assert_true(state, "self-TCO'd fn: mutual edge is musttail",
      string.contains(sir, "musttail call i64 @main.b"))
    assert_true(state, "self-TCO'd fn: stackrestore(sp) immediately before the musttail",
      adjacent_lines(slines, "call void @llvm.stackrestore(ptr %sp)", "musttail call i64 @main.b"))
    assert_true(state, "self-TCO'd fn: ret immediately after the musttail",
      adjacent_lines(slines, "musttail call i64 @main.b", "ret i64 %r"))
    assert_true(state, "self-TCO'd fn: plain call to partner is gone",
      string.contains(sir, "%r = call i64 @main.b") == false)

    # 3a. Same fn through rooting: no IRRoot, so the stack save/restore pair is
    # cleared from the entry, the back-edge and the tail call alike.
    let sir_rooted = lower_rooted(stc, 600)
    assert_true(state, "self-TCO'd fn, no roots: still musttail",
      string.contains(sir_rooted, "musttail call i64 @main.b"))
    assert_true(state, "self-TCO'd fn, no roots: no stackrestore left",
      string.contains(sir_rooted, "stackrestore") == false)
    assert_true(state, "self-TCO'd fn, no roots: no stacksave left",
      string.contains(sir_rooted, "stacksave") == false)

    # 3a'. A self loop with a base case, a self edge and a partner edge, run the
    # way the pipeline does: self-TCO, then mutual-TCO, then rooting.
    let loop_fn = self_then_mutual(make_self_loop_fn())
    let loop_ir = ir_lowering.lower_fn_with_table(loop_fn, dict_empty())
    let loop_lines = string.split(loop_ir, "\n")
    assert_true(state, "self loop + partner: partner edge is musttail",
      string.contains(loop_ir, "musttail call i64 @main.b"))
    assert_true(state, "self loop + partner: stackrestore(sp) immediately before the musttail",
      adjacent_lines(loop_lines, "call void @llvm.stackrestore(ptr", "musttail call i64 @main.b"))
    assert_true(state, "self loop + partner: one stacksave, a restore on the back-edge and one on the tail call",
      count_substr(loop_ir, "@llvm.stacksave") == 1 && count_substr(loop_ir, "@llvm.stackrestore") == 2)
    assert_true(state, "self loop + partner: back-edge kept",
      string.contains(loop_ir, "br label %tco_loop"))
    assert_true(state, "self loop + partner: join phi keeps only the base-case incoming",
      phi_incoming_count(fn_blocks(loop_fn), "joinb") == 1)

    # 3a''. Premise: the root stack is empty at the tail call.  stackrestore frees
    # the root allocas, so a root still pushed there would leave a dangling slot.
    let rooted_fn = self_then_mutual_rooted(make_rooted_self_loop_fn())
    let rooted_ir = ir_lowering.lower_fn_with_table(rooted_fn, dict_empty())
    let rooted_lines = string.split(rooted_ir, "\n")
    assert_true(state, "rooted self loop: the heap param is in the frame",
      string.contains(rooted_ir, "@sprout_gc_push_scan_root"))
    assert_true(state, "rooted self loop: a block-local value is rooted across the second alloc",
      string.contains(rooted_ir, "@sprout_gc_push_i64_root"))
    assert_true(state, "rooted self loop: stackrestore kept (the fn has roots)",
      adjacent_lines(rooted_lines, "call void @llvm.stackrestore(ptr", "musttail call i64 @main.b"))
    assert_true(state, "rooted self loop: no root pushed at the musttail (pushes - pops == 0)",
      root_depth_before(rooted_lines, "musttail call i64 @main.b", 0) == 0)

    # 3a'''. No base case: both successors of the entry branch leave the function,
    # so the ret-feeding join loses every incoming and must go.
    let nb = self_then_mutual(make_no_base_fn())
    let nb_ir = ir_lowering.lower_fn_with_table(nb, dict_empty())
    assert_true(state, "no base case: partner edge is musttail",
      string.contains(nb_ir, "musttail call i64 @main.b"))
    assert_true(state, "no base case: self edge is a back-edge",
      string.contains(nb_ir, "br label %tco_loop"))
    assert_true(state, "no base case: emptied join block is gone (no phi, no reference)",
      string.contains(nb_ir, "joinb") == false && string.contains(nb_ir, " phi ") == false)
    assert_true(state, "no base case: every block ends in a terminator",
      all_blocks_terminated(fn_blocks(nb)))
    assert_true(state, "no base case: ends in IRTcoBack or musttail only (no ret of a phi)",
      string.contains(nb_ir, "ret i64 %m") == false)

    # 3b. Non-tail self-call → skipped (tailcallelim would break the musttail).
    let slf = ast_to_ir.mutual_tco_rewrite_fn(make_self_calling_fn(), Cons(("main.b", 2), Nil))
    let slfir = ir_lowering.lower_fn_with_table(slf, dict_empty())
    assert_true(state, "non-tail self-call: mutual edge skipped (no musttail)",
      string.contains(slfir, "musttail") == false)
    assert_true(state, "non-tail self-call: partner call stays a plain call",
      string.contains(slfir, "call i64 @main.b"))

    # 3c. A musttail carrier marks EVERY call noinline — the musttail one included,
    # or the inliner pulls the partner in through the tail edge and makes the carrier
    # self-recursive, which is the shape tailcallelim breaks.
    let carrier = ir_lowering.lower_fn_with_table(
      ast_to_ir.mutual_tco_rewrite_fn(make_two_call_fn(), Cons(("main.b", 2), Nil)), dict_empty())
    assert_true(state, "musttail carrier: the partner edge is still musttail",
      string.contains(carrier, "musttail call i64 @main.b"))
    assert_true(state, "musttail carrier: the musttail call itself carries noinline",
      string.contains(carrier, "musttail call i64 @main.b(i64 %p$x, i64 %p$y) noinline"))
    assert_true(state, "musttail carrier: its other direct call carries noinline",
      string.contains(carrier, "@main.z(i64 %p$x, i64 %p$y) noinline"))
    assert_true(state, "no musttail: plain calls carry no noinline",
      string.contains(bir, "noinline") == false)

    # 4. Non-i64 return → skipped.
    let i1f = ast_to_ir.mutual_tco_rewrite_fn(make_i1_fn(), Cons(("main.b", 2), Nil))
    let i1ir = ir_lowering.lower_fn_with_table(i1f, dict_empty())
    assert_true(state, "i1-returning fn: skipped (no musttail)",
      string.contains(i1ir, "musttail") == false)

    # 5. No eligible targets → unchanged.
    let none = ast_to_ir.mutual_tco_rewrite_fn(make_a(), Nil)
    let nir = ir_lowering.lower_fn_with_table(none, dict_empty())
    assert_true(state, "no eligible targets: unchanged (plain call kept)",
      string.contains(nir, "call i64 @main.b"))
    assert_true(state, "no eligible targets: no musttail",
      string.contains(nir, "musttail") == false)

    # 6. Eligibility logic: a 2-cycle a<->b (arity 2, i64) yields both edges.
    let raw = Cons(("a", (false, set_insert("b", set_empty()))),
              Cons(("b", (false, set_insert("a", set_empty()))), Nil))
    # mutual-TCO eligibility reads only the arity column of FnInfo; `cpr_result`
    # belongs to the CPR router gate and is not consulted on this path.
    let arities = dict_set("a", ast_to_ir.fn_info(2, false),
                    dict_set("b", ast_to_ir.fn_info(2, false), dict_empty()))
    let rets = dict_set("a", true, dict_set("b", true, dict_empty()))
    let elig = ast_to_ir.mutual_build_eligible(raw, arities, rets)
    assert_true(state, "eligible: a<->b cycle gives a a target", list_length(ast_to_ir.mutual_eligible_for("a", elig)) == 1)
    assert_true(state, "eligible: a<->b cycle gives b a target", list_length(ast_to_ir.mutual_eligible_for("b", elig)) == 1)

    # 7. one-way a->b (b does not call a) is NOT a cycle → no edge.
    let raw2 = Cons(("a", (false, set_insert("b", set_empty()))),
               Cons(("b", (false, set_empty())), Nil))
    let elig2 = ast_to_ir.mutual_build_eligible(raw2, arities, rets)
    assert_true(state, "eligible: one-way a->b not a cycle", list_length(ast_to_ir.mutual_eligible_for("a", elig2)) == 0)

    # 8. SCC membership decides eligibility, not just one-step reachability.
    # a->b, b->c, c->b, c->ext (ext has no node entry): b<->c is a cycle, a is not
    # on it, ext is outside the graph.
    let raw3 = Cons(("a", (false, set_from_list(["b"]))),
               Cons(("b", (false, set_from_list(["c"]))),
               Cons(("c", (false, set_from_list(["b", "ext"]))), Nil)))
    let ar3 = dict_set("a", ast_to_ir.fn_info(1, false), dict_set("b", ast_to_ir.fn_info(1, false),
                dict_set("c", ast_to_ir.fn_info(1, false), dict_set("ext", ast_to_ir.fn_info(1, false), dict_empty()))))
    let rt3 = dict_set("a", true, dict_set("b", true, dict_set("c", true, dict_set("ext", true, dict_empty()))))
    let elig3 = ast_to_ir.mutual_build_eligible(raw3, ar3, rt3)
    assert_true(state, "eligible: edge into a cycle from outside is not eligible",
      list_length(ast_to_ir.mutual_eligible_for("a", elig3)) == 0)
    assert_true(state, "eligible: b->c on the cycle",
      ast_to_ir.mutual_eligible_for("b", elig3) == [("c", 1)])
    assert_true(state, "eligible: c->b kept, c->ext (outside the graph) dropped",
      ast_to_ir.mutual_eligible_for("c", elig3) == [("b", 1)])

    # 9. Arity and return kind still gate an edge on a cycle.
    let ar4 = dict_set("a", ast_to_ir.fn_info(2, false), dict_set("b", ast_to_ir.fn_info(3, false), dict_empty()))
    let elig4 = ast_to_ir.mutual_build_eligible(raw, ar4, rets)
    assert_true(state, "eligible: arity mismatch on a cycle is not eligible",
      list_length(ast_to_ir.mutual_eligible_for("a", elig4)) == 0)
    let rt5 = dict_set("a", true, dict_set("b", false, dict_empty()))
    let elig5 = ast_to_ir.mutual_build_eligible(raw, arities, rt5)
    assert_true(state, "eligible: non-i64 partner on a cycle is not eligible",
      list_length(ast_to_ir.mutual_eligible_for("a", elig5)) == 0)

    # 10. Two disjoint 3-rings of equal arity: every ring edge is eligible, and a
    # one-way bridge between the rings is not.
    let names6 = ["r0", "r1", "r2", "s0", "s1", "s2"]
    let ring_raw = [("r0", (false, set_from_list(["r1", "s0"]))), ("r1", (false, set_from_list(["r2"]))),
                    ("r2", (false, set_from_list(["r0"]))), ("s0", (false, set_from_list(["s1"]))),
                    ("s1", (false, set_from_list(["s2"]))), ("s2", (false, set_from_list(["s0"])))]
    let ring_ar = dict_from_list(list_map(\ (n: String) -> (n, ast_to_ir.fn_info(1, false)), names6))
    let ring_rt = dict_from_list(list_map(\ (n: String) -> (n, true), names6))
    let ring_el = ast_to_ir.mutual_build_eligible(ring_raw, ring_ar, ring_rt)
    assert_true(state, "eligible: ring edge r0->r1 only, bridge r0->s0 dropped",
      ast_to_ir.mutual_eligible_for("r0", ring_el) == [("r1", 1)])
    assert_true(state, "eligible: ring edge s2->s0",
      ast_to_ir.mutual_eligible_for("s2", ring_el) == [("s0", 1)])
    summary(state)
