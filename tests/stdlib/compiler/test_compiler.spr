module main
import stdlib.test (TestState, new_state, assert_eq, assert_true, assert_false, summary)
import stdlib.compiler.compiler as compiler
import stdlib.compiler.module_loader as module_loader
import stdlib.compiler.types as types

fn is_ok(r: compiler.CompileResult) -> Bool =
  match r with
  | compiler.CompileOk _ -> true
  | compiler.CompileFail _ -> false

fn is_fail(r: compiler.CompileResult) -> Bool =
  match r with
  | compiler.CompileFail _ -> true
  | compiler.CompileOk _ -> false

fn scheme_str(name: String, r: compiler.CompileResult) -> String =
  match r with
  | compiler.CompileFail _ -> "<compile failed>"
  | compiler.CompileOk env ->
      match dict_get(name, env) with
      | Nothing -> "<not found>"
      | Just s -> types.scheme_to_string(s)

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # new_cache() creates an independent, empty cache each time
    cache1 <- module_loader.new_cache()
    d1 <- ref_read(cache1)
    assert_eq(state, "new_cache starts empty", vec_length(dict_keys(d1)), 0)

    cache2 <- module_loader.new_cache()
    d2 <- ref_read(cache2)
    assert_eq(state, "each new_cache is independent", vec_length(dict_keys(d2)), 0)

    # compile_source_with_cache: pre-seed "stdlib.prelude" so load_prelude_pairs
    # takes the cache-hit branch and skips file I/O.  This lets us test the
    # cache-sharing invariant without needing a real stdlib_root on disk.
    cache3 <- module_loader.new_cache()
    d3 <- ref_read(cache3)
    ref_write(cache3, dict_set("stdlib.prelude", Nil, d3))

    r1 <- compiler.compile_source_with_cache("fn x() -> Int = 42", "", cache3)
    assert_true(state, "compile_source_with_cache: valid source compiles ok", is_ok(r1))

    # Second call on the same cache — prelude entry is still there, no re-read.
    r2 <- compiler.compile_source_with_cache("fn y() -> Bool = true", "", cache3)
    assert_true(state, "compile_source_with_cache: cache persists across calls", is_ok(r2))

    # A type error is still caught even through the cache path.
    r3 <- compiler.compile_source_with_cache("fn z() -> Int = true", "", cache3)
    assert_true(state, "compile_source_with_cache: type error detected via cache path", is_fail(r3))

    # compile_source (no root needed) is unaffected by M1
    r4 <- compiler.compile_source("fn w() -> Int = 99")
    assert_true(state, "compile_source still works", is_ok(r4))

    # ---------------------------------------------------------------------------
    # Unannotated fn param — inferred scheme correctness
    #
    # These tests guard against register_fn_decl_scheme rebuilding from AST and
    # discarding the substitution that resolves _unann vars to concrete types.
    # The bugs they catch: double(4) → garbage, :t double → "forall a b. a -> b",
    # fmap(double, xs) → codegen failure.
    # ---------------------------------------------------------------------------
    r_double_scheme <- compiler.compile_source("fn double(x) = x * 2")
    assert_eq(state, "unannotated fn: scheme is Int -> Int (not forall a b. a -> b)",
      scheme_str("double", r_double_scheme), "Int -> Int")

    r_id_scheme <- compiler.compile_source("fn id(x) = x")
    assert_eq(state, "unannotated identity fn: scheme is forall a. a -> a",
      scheme_str("id", r_id_scheme), "forall a. a -> a")

    # ---------------------------------------------------------------------------
    # Generalization correctness with multiple preceding declarations
    #
    # Guards the ftv_env hoisting optimization: env_ftv is computed once from
    # the pre-scanned env rather than calling ftv_env(env) per declaration.
    # If env_ftv is stale or wrong, polymorphic functions at any position in
    # the file will get incorrect (over-monomorphised or wrong-variable) schemes.
    # ---------------------------------------------------------------------------
    r_id_many_decls <- compiler.compile_source("fn f1() -> Int = 1\nfn f2() -> Int = 2\nfn f3() -> Int = 3\nfn f4() -> Int = 4\nfn f5() -> Int = 5\nfn id(x) = x")
    assert_eq(state, "generalize: id still forall a. a -> a after many preceding decls",
      scheme_str("id", r_id_many_decls), "forall a. a -> a")

    r_double_many_decls <- compiler.compile_source("fn f1(x) = x\nfn f2(x) = x\nfn f3(x) = x\nfn double(x) = x * 2")
    assert_eq(state, "generalize: double still Int -> Int after polymorphic preceding decls",
      scheme_str("double", r_double_many_decls), "Int -> Int")

    # ---------------------------------------------------------------------------
    # Module loader: qualified import access (requires real stdlib on disk)
    #
    # These tests use SPROUT_STDLIB_ROOT (set by `just test`) to load real stdlib
    # modules and verify that qualified names survive import resolution correctly.
    # Skipped gracefully when running outside the just test harness.
    # ---------------------------------------------------------------------------
    match env_get("SPROUT_STDLIB_ROOT") with
    | Nothing -> ()
    | Just stdlib_root ->
        do
          # Regression: collections.vec_singleton was silently dropped from
          # own_pairs by filter_own_pairs because its name collides with the
          # prelude's vec_singleton.  After the fix, load_module uses
          # program_declared_names so the collision no longer matters.
          cache_c <- module_loader.new_cache()
          r_collections <- compiler.compile_source_with_cache(
            "import collections\nfn foo() -> Vec Int = collections.vec_singleton(42)",
            stdlib_root, cache_c)
          assert_true(state,
            "collections.vec_singleton accessible after 'import collections'",
            is_ok(r_collections))

          # Regression guard: a module that only re-declares a prelude name
          # (with no other names) must not produce an empty qualified namespace.
          cache_c2 <- module_loader.new_cache()
          r_qualified_alias <- compiler.compile_source_with_cache(
            "import stdlib.collections as col\nfn bar() -> Vec Bool = col.vec_singleton(true)",
            stdlib_root, cache_c2)
          assert_true(state,
            "collections.vec_singleton accessible via explicit stdlib alias",
            is_ok(r_qualified_alias))

          # Sanity: an unknown qualified name still fails (guard against false OK).
          cache_c3 <- module_loader.new_cache()
          r_bad <- compiler.compile_source_with_cache(
            "import collections\nfn baz() -> Int = collections.no_such_fn()",
            stdlib_root, cache_c3)
          assert_true(state,
            "unknown qualified name still fails type check",
            is_fail(r_bad))

          # Regression: unannotated function with parameter was rejected with
          # "Return type mismatch: Int vs Unit" in REPL session context.
          # Test matrix: with/without module header, with/without spaces around *.

          # No module header, no param annotation — baseline
          cache_d <- module_loader.new_cache()
          r_bare <- compiler.compile_source_with_cache(
            "fn double(x) = x * 2",
            stdlib_root, cache_d)
          assert_true(state,
            "unannotated fn with param, no module header, compiles ok",
            is_ok(r_bare))

          # module app.session header, spaces around operator
          cache_d2 <- module_loader.new_cache()
          r_session_space <- compiler.compile_source_with_cache(
            "module app.session\n\nfn double(x) = x * 2",
            stdlib_root, cache_d2)
          assert_true(state,
            "unannotated fn with param, session header, spaces, compiles ok",
            is_ok(r_session_space))

          # module app.session header, no spaces around operator
          cache_d3 <- module_loader.new_cache()
          r_session_nospace <- compiler.compile_source_with_cache(
            "module app.session\n\nfn double(x) = x*2",
            stdlib_root, cache_d3)
          assert_true(state,
            "unannotated fn with param, session header, no spaces, compiles ok",
            is_ok(r_session_nospace))

    summary(state)
