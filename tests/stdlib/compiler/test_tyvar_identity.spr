import stdlib.test (TestState, new_state, assert_eq, assert_true, summary)
import stdlib.compiler.types as types

# Characterization of the TyVarId accessor contract (canonical-identity campaign,
# Stage 2 / E0 scaffolding). These pin the observable behavior that every later
# stage must preserve:
#   * `tyvar_id` mints a payload from a name; `tyvar_name` recovers that name
#     (mint→name roundtrip is the identity in E0, and stays the *print* name in E1).
# In E0 both are String pass-throughs, so this is a green characterization test,
# not a red-first TDD test — its job is to fail loudly if a future edit (the E1
# representation swap, or a mis-routed site) breaks the roundtrip.

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    assert_eq(state, "mint/name roundtrip: fresh var",
              types.tyvar_name(types.tyvar_id("t5")), "t5")
    assert_eq(state, "mint/name roundtrip: source var",
              types.tyvar_name(types.tyvar_id("a")), "a")
    assert_eq(state, "mint/name roundtrip: qualified-ish",
              types.tyvar_name(types.tyvar_id("t42")), "t42")
    # Exercise the payload through the Type ADT: a TVar built from a minted
    # payload must render its name (pins the wrap roundtrip across the E0->E1 flip).
    assert_eq(state, "TVar renders its name via type_to_string",
              types.type_to_string(types.TVar(types.tyvar_id("z9"))), "z9")
    # Pass-B accessor contract. In E0, tyvar_identity returns the name string (so
    # every flipped site stays byte-identical); tyvar_eq is identity equality.
    assert_eq(state, "tyvar_identity is the name in E0",
              types.tyvar_identity(types.tyvar_id("q7")), "q7")
    assert_true(state, "tyvar_eq: same identity",
                types.tyvar_eq(types.tyvar_id("q7"), types.tyvar_id("q7")))
    assert_true(state, "tyvar_eq: distinct identities",
                ! types.tyvar_eq (types.tyvar_id("q7"), types.tyvar_id("q8")))
    summary(state)
