import stdlib.test (check_eq, check_true, run_suite)
import stdlib.compiler.types as types
import stdlib.compiler.unifier as unifier

# What a peer join records, read straight off the substitution rather than
# inferred from an accept/reject verdict at the end of a whole compile.
#
# The shape is `(Int -> Int !{cb}) -> Int -> Int !{res}`: a CALLBACK SLOT, which
# is contravariant, under a result, which is not. Joining an `!{IO}` one with a
# pure one must leave the slot at the MEET — the pure callback both branches
# accept — whichever branch is compared first.

fn arrow(cb_eff: types.Effect, res_eff: types.Effect) -> types.Type =
  types.TFunc(
    types.TFunc(types.type_int(), types.type_int(), cb_eff, types.OwnConsume),
    types.TFunc(types.type_int(), types.type_int(), res_eff, types.OwnConsume),
    types.EffectPure, types.OwnConsume)

fn io_arrow() -> types.Type = arrow(types.EffectIO, types.EffectIO)

fn pure_arrow() -> types.Type = arrow(types.EffectPure, types.EffectPure)

fn result_var() -> types.Type = types.TVar(types.tyvar_id("r"))

# What a laundered join renders as: the slot took the IO callback.
fn io_join_rendering() -> String = "(Int -> Int !{IO}) -> Int -> Int !{IO}"

# Both branches judged against one fresh result variable, the way `infer_if_join`
# and `infer_branch_unify` do it. Renders the joined type, or the rejection.
fn join(first: types.Type, second: types.Type) -> String =
  let unifier.UnifyOk s1 es1 =
        unifier.unify_actual_expected(dict_empty(), dict_empty(), first, result_var())
        else unifier.UnifyErr e -> "REJECT"
      unifier.UnifyOk s2 es2 =
        unifier.unify_actual_expected(s1, es1, second, result_var())
        else unifier.UnifyErr e -> "REJECT"
  in types.type_to_string(unifier.apply_full_subst(s2, es2, result_var()))

# A slot carrying an OPEN effect variable — the `!{e}` of a signature the joined
# value is passed to. Flowing the join into it aliases the joined slot's variable
# to this one, and a ceiling left behind under the old name is unreachable after.
fn alias_slot() -> types.Type =
  types.TFunc(types.type_int(), types.type_int(), types.EffectVar("$alias"), types.OwnConsume)

fn alias_slot_arrow() -> types.Type =
  types.TFunc(alias_slot(),
    types.TFunc(types.type_int(), types.type_int(), types.EffectIO, types.OwnConsume),
    types.EffectPure, types.OwnConsume)

fn io_callback() -> types.Type =
  types.TFunc(types.type_int(), types.type_int(), types.EffectIO, types.OwnConsume)

# Join, pass the result into a signature whose slot is open, then supply an IO
# callback for that slot. The ceiling has to follow the alias or this accepts.
fn io_through_alias(first: types.Type, second: types.Type) -> String =
  let unifier.UnifyOk s1 es1 =
        unifier.unify_actual_expected(dict_empty(), dict_empty(), first, result_var())
        else unifier.UnifyErr e -> "REJECT"
      unifier.UnifyOk s2 es2 =
        unifier.unify_actual_expected(s1, es1, second, result_var())
        else unifier.UnifyErr e -> "REJECT"
      unifier.UnifyOk s3 es3 =
        unifier.unify_actual_expected(s2, es2, result_var(), alias_slot_arrow())
        else unifier.UnifyErr e -> "REJECT"
      unifier.UnifyOk s4 es4 =
        unifier.unify_actual_expected(s3, es3, io_callback(), alias_slot())
        else unifier.UnifyErr e -> "REJECT"
  in "ACCEPT"

fn main() -> Unit !{IO} =
  run_suite("effect_join_bounds", [
    # The defect this pins: the pure branch's slot obligation was dropped, so the
    # IO branch bound the slot to IO and the join laundered. The two orders leave
    # the slot spelled differently — resolved pure, or a variable carrying a pure
    # ceiling — so what is asserted is that neither is IO.
    check_true("a joined callback slot does not take an IO callback",
      join(pure_arrow(), io_arrow()) != io_join_rendering()),

    # The mirror. A join has no first branch, so the two must not disagree.
    check_true("and not in the other order either",
      join(io_arrow(), pure_arrow()) != io_join_rendering()),

    # `!=` against the IO rendering is satisfied by a slot left as a BARE variable,
    # which is what one order produces — so it passes while holding nothing. These
    # two ask the question the rendering cannot: does the slot still refuse IO once
    # it has been aliased to the `!{e}` of a signature it was passed to?
    check_eq("a ceiling survives being aliased to another open variable",
      io_through_alias(pure_arrow(), io_arrow()), "REJECT"),
    check_eq("and in the other order too",
      io_through_alias(io_arrow(), pure_arrow()), "REJECT"),

    # Uniform joins keep their own effect — the meet of one effect is itself.
    check_eq("two pure arrows join pure",
      join(pure_arrow(), pure_arrow()),
      "(Int -> Int) -> Int -> Int"),
    check_eq("two IO arrows join IO",
      join(io_arrow(), io_arrow()),
      "(Int -> Int !{IO}) -> Int -> Int !{IO}"),

    # Both orders, because "REJECT" also satisfies the not-IO assertions above —
    # a one-sided guard leaves the mirror's false rejection invisible.
    check_true("neither order rejects a legal join",
      join(io_arrow(), pure_arrow()) != "REJECT"),
    check_true("nor does the mirror",
      join(pure_arrow(), io_arrow()) != "REJECT")
  ])
