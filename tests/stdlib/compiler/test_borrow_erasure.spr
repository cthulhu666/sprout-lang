module main
import stdlib.test (TestState, new_state, assert_eq, assert_true, assert_false, summary)
import stdlib.compiler.compiler as compiler
import stdlib.compiler.source as source
import stdlib.fs as fs
import testsupport.envvar as envvar

# M4.5 ERASURE. `borrowing`/`consuming` are a type-checker feature: they reach no
# IR pass and change no emitted instruction, with one exception: whether an owned
# linear parameter's cell may be reused (docs/linear-reuse-v0.md §4.1).
#
# This matters beyond tidiness. docs/linear-ir-m5-feasibility-2026-08-07.md found
# that the historical GC-use-after-free bugs were all CLASSIFICATION-COMPLETENESS
# failures — a lowering pass meeting a shape it does not handle. A modifier that
# never influences lowering cannot introduce that failure mode: ir_lowering and
# ir_rooting see exactly the TcpConnection handle they saw before.
#
# The guarantee is enforced as "lowering reads the mode only to pick a reuse token",
# not "the mode is absent from the AST" — ast_to_ir.owned_param_ssas reads it, and
# only a `borrowing` parameter that is matched and rebuilt emits different IR from an
# owned one. The field is still present on the node. The testable form is
# byte-identical IR for every other case, which is what the first assertion below pins.
#
# `consuming` vs unmodified is the exact pair to compare: ParamMode.ModeConsuming
# and ModeDefault mean the same thing to the checker (passing a linear value IS a
# consume), so the two sources below differ in EXACTLY one token and must emit
# byte-identical IR. `just ir-golden-diff` is the standing whole-corpus version of
# this same guard.

fn contains(haystack: String, needle: String) -> Bool =
  str_find(haystack, needle) != -1

let unmodified_src =
  "type linear File = File Int\n" ++
  "fn release(f: File) -> Int = match f with | File n -> n\n" ++
  "fn main() -> Int !{IO} = release(File(42))\n"

let consuming_src =
  "type linear File = File Int\n" ++
  "fn release(f: consuming File) -> Int = match f with | File n -> n\n" ++
  "fn main() -> Int !{IO} = release(File(42))\n"

# M4.4a. The same one-token comparison for `once`, and it is the ONLY direct proof
# of its erasure: `just ir-golden-diff` cannot serve as the standing guard here the
# way it does for `borrowing`, because the corpus programs that exercise `once`
# (http_echo_server, http_web_server) migrated from raw `Int` handles to the boxed
# linear TcpConnection in the same change, so their IR legitimately moved. Two
# sources differing in exactly the `once` token, with the shape it exists for — a
# linear value MOVED into a one-shot closure — must emit byte-identical IR.
#
# Every identifier here deliberately avoids the substring "once" — a helper named
# `run_once` would satisfy the "no 'once' token survives" assertion from its own
# symbol name and prove nothing.
let once_src =
  "type linear File = File Int\n" ++
  "fn release(f: consuming File) -> Int = match f with | File n -> n\n" ++
  "fn handoff(work: once Unit -> Int) -> Int = work(())\n" ++
  "fn move_in(f: File) -> Int = handoff(\\_ -> release(f))\n" ++
  "fn main() -> Int !{IO} = move_in(File(42))\n"

# The counterpart WITHOUT the modifier. It does not typecheck (the capture is
# rejected — that is lambda_capture_still_rejected), so it cannot be compiled for
# a byte comparison; the pair below instead varies `once` against `consuming` on a
# NON-capturing call, where both are accepted and mean the same thing to lowering.
let once_plain_src =
  "type linear File = File Int\n" ++
  "fn release(f: consuming File) -> Int = match f with | File n -> n\n" ++
  "fn run_once(work: once Unit -> Int) -> Int = work(())\n" ++
  "fn zero(u: Unit) -> Int = 0\n" ++
  "fn main() -> Int !{IO} = run_once(zero) + release(File(42))\n"

let once_absent_src =
  "type linear File = File Int\n" ++
  "fn release(f: consuming File) -> Int = match f with | File n -> n\n" ++
  "fn run_once(work: Unit -> Int) -> Int = work(())\n" ++
  "fn zero(u: Unit) -> Int = 0\n" ++
  "fn main() -> Int !{IO} = run_once(zero) + release(File(42))\n"

# `local` (docs/local-closures-v0.md): the same one-token comparison. The
# helper names avoid the substring "local" so that the absence check below
# cannot be satisfied by a symbol name.
let local_src =
  "type linear File = File Int\n" ++
  "fn release(f: consuming File) -> Int = match f with | File n -> n\n" ++
  "fn peek(f: borrowing File) -> Int = 1\n" ++
  "fn handoff(work: local Unit -> Int) -> Int = work(())\n" ++
  "fn lend(f: File) -> Int = handoff(\\_ -> peek(f)) + release(f)\n" ++
  "fn main() -> Int !{IO} = lend(File(42))\n"

let local_plain_src =
  "type linear File = File Int\n" ++
  "fn release(f: consuming File) -> Int = match f with | File n -> n\n" ++
  "fn handoff(work: local Unit -> Int) -> Int = work(())\n" ++
  "fn zero(u: Unit) -> Int = 0\n" ++
  "fn main() -> Int !{IO} = handoff(zero) + release(File(42))\n"

let local_absent_src =
  "type linear File = File Int\n" ++
  "fn release(f: consuming File) -> Int = match f with | File n -> n\n" ++
  "fn handoff(work: Unit -> Int) -> Int = work(())\n" ++
  "fn zero(u: Unit) -> Int = 0\n" ++
  "fn main() -> Int !{IO} = handoff(zero) + release(File(42))\n"

# Exercises a real borrow: `peek` borrows, `release` consumes.
let borrowing_src =
  "type linear File = File Int\n" ++
  "fn peek(f: borrowing File) -> Int = 1\n" ++
  "fn release(f: consuming File) -> Int = match f with | File n -> n\n" ++
  "fn use_it(f: File) -> Int =\n" ++
  "  do\n" ++
  "    let a = peek(f)\n" ++
  "    a + release(f)\n" ++
  "fn main() -> Int !{IO} = use_it(File(42))\n"

# The one place the mode shows: a linear parameter matched and rebuilt. Owned, the cell is
# reused; `borrowing`, the lender still holds it, so the rebuild allocates.
let rebuild_owned_src =
  "type linear Cell = Cell Int Int\n" ++
  "fn bump(c: Cell) -> Cell = match c with | Cell a b -> Cell(b, a)\n" ++
  "fn finish(c: Cell) -> Int = match c with | Cell a _ -> a\n" ++
  "fn main() -> Int !{IO} = finish(bump(Cell(1, 2)))\n"

let rebuild_consuming_src =
  "type linear Cell = Cell Int Int\n" ++
  "fn bump(c: consuming Cell) -> Cell = match c with | Cell a b -> Cell(b, a)\n" ++
  "fn finish(c: Cell) -> Int = match c with | Cell a _ -> a\n" ++
  "fn main() -> Int !{IO} = finish(bump(Cell(1, 2)))\n"

let rebuild_borrowing_src =
  "type linear Cell = Cell Int Int\n" ++
  "fn bump(c: borrowing Cell) -> Cell = match c with | Cell a b -> Cell(b, a)\n" ++
  "fn finish(c: Cell) -> Int = match c with | Cell a _ -> a\n" ++
  "fn main() -> Int !{IO} =\n" ++
  "  do\n" ++
  "    let c = Cell(1, 2)\n" ++
  "    let d = bump(c)\n" ++
  "    finish(c) + finish(d)\n"

# Calls to the allocator inside `@$entry.bump`.
fn bump_allocs(ir: String) -> Int =
  if start == -1 then -1
  else
    let rest = str_slice(ir, start, str_len(ir))
    in count_allocs(str_slice(rest, 0, str_find(rest, "\n}\n")), 0)
  where start = str_find(ir, "define i64 @$entry.bump(")

fn count_allocs(text: String, acc: Int) -> Int =
  if pos == -1 then acc
  else count_allocs(str_slice(text, pos + 1, str_len(text)), acc + 1)
  where pos = str_find(text, "@sprout_alloc_obj(")

fn ir_ok(r: compiler.IrFullResult) -> Bool =
  match r with
  | compiler.IrFullOk _ -> true
  | compiler.IrFullFail _ -> false

fn ir_text(r: compiler.IrFullResult) -> String =
  match r with
  | compiler.IrFullOk ir -> ir
  | compiler.IrFullFail _ -> ""

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    match envvar.read("SPROUT_STDLIB_ROOT") with
    | Nothing -> ()
    | Just stdlib_root ->
        do
          let unmod_path = "/tmp/sprout_test_borrow_erasure_unmod.sprout"
          let consuming_path = "/tmp/sprout_test_borrow_erasure_consuming.sprout"
          let borrowing_path = "/tmp/sprout_test_borrow_erasure_borrowing.sprout"
          let once_path = "/tmp/sprout_test_borrow_erasure_once.sprout"
          let once_plain_path = "/tmp/sprout_test_borrow_erasure_once_plain.sprout"
          let once_absent_path = "/tmp/sprout_test_borrow_erasure_once_absent.sprout"
          let local_path = "/tmp/sprout_test_borrow_erasure_local.sprout"
          let local_plain_path = "/tmp/sprout_test_borrow_erasure_local_plain.sprout"
          let local_absent_path = "/tmp/sprout_test_borrow_erasure_local_absent.sprout"
          let rebuild_owned_path = "/tmp/sprout_test_borrow_erasure_rebuild_owned.sprout"
          let rebuild_consuming_path = "/tmp/sprout_test_borrow_erasure_rebuild_consuming.sprout"
          let rebuild_borrowing_path = "/tmp/sprout_test_borrow_erasure_rebuild_borrowing.sprout"
          fs.write_text(rebuild_owned_path, rebuild_owned_src)
          fs.write_text(rebuild_consuming_path, rebuild_consuming_src)
          fs.write_text(rebuild_borrowing_path, rebuild_borrowing_src)
          fs.write_text(local_path, local_src)
          fs.write_text(local_plain_path, local_plain_src)
          fs.write_text(local_absent_path, local_absent_src)
          fs.write_text(unmod_path, unmodified_src)
          fs.write_text(consuming_path, consuming_src)
          fs.write_text(borrowing_path, borrowing_src)
          fs.write_text(once_path, once_src)
          fs.write_text(once_plain_path, once_plain_src)
          fs.write_text(once_absent_path, once_absent_src)

          r_unmod <- compiler.compile_full_ir(source.FilePath(unmod_path), source.StdlibRoot(stdlib_root))
          r_consuming <- compiler.compile_full_ir(source.FilePath(consuming_path), source.StdlibRoot(stdlib_root))
          r_borrowing <- compiler.compile_full_ir(source.FilePath(borrowing_path), source.StdlibRoot(stdlib_root))
          r_once <- compiler.compile_full_ir(source.FilePath(once_path), source.StdlibRoot(stdlib_root))
          r_once_plain <- compiler.compile_full_ir(source.FilePath(once_plain_path), source.StdlibRoot(stdlib_root))
          r_once_absent <- compiler.compile_full_ir(source.FilePath(once_absent_path), source.StdlibRoot(stdlib_root))
          r_local <- compiler.compile_full_ir(source.FilePath(local_path), source.StdlibRoot(stdlib_root))
          r_local_plain <- compiler.compile_full_ir(source.FilePath(local_plain_path), source.StdlibRoot(stdlib_root))
          r_local_absent <- compiler.compile_full_ir(source.FilePath(local_absent_path), source.StdlibRoot(stdlib_root))
          r_rebuild_owned <- compiler.compile_full_ir(source.FilePath(rebuild_owned_path), source.StdlibRoot(stdlib_root))
          r_rebuild_consuming <- compiler.compile_full_ir(source.FilePath(rebuild_consuming_path), source.StdlibRoot(stdlib_root))
          r_rebuild_borrowing <- compiler.compile_full_ir(source.FilePath(rebuild_borrowing_path), source.StdlibRoot(stdlib_root))

          assert_true(state, "unmodified linear param compiles", ir_ok(r_unmod))
          assert_true(state, "consuming linear param compiles", ir_ok(r_consuming))
          assert_true(state, "borrowing linear param compiles", ir_ok(r_borrowing))
          assert_true(state, "linear value moved into a once closure compiles", ir_ok(r_once))

          let unmod_ir = ir_text(r_unmod)
          let consuming_ir = ir_text(r_consuming)
          let borrowing_ir = ir_text(r_borrowing)

          # Guard the absence proofs below: if compilation had failed, the IR
          # would be "" and every `assert_false(contains(...))` would pass for
          # the wrong reason.
          #
          # `$entry.` is the synthetic module name a headerless entry file gets
          # (docs/prelude-scope-v0.md §4.2 step 2) — these fixture sources declare
          # no `module` header, so their symbols qualify under it. Matching the
          # qualified spelling keeps the guard a real guard: a bare `@release`
          # would silently stop matching and take the absence proofs down with it.
          assert_true(state, "unmodified IR contains @$entry.release definition",
            contains(unmod_ir, "define i64 @$entry.release"))
          assert_true(state, "borrowing IR contains @$entry.peek definition",
            contains(borrowing_ir, "define i64 @$entry.peek"))

          # THE erasure assertion: one token of source difference, zero bytes of
          # IR difference.
          assert_true(state, "consuming emits byte-identical IR to unmodified",
            consuming_ir == unmod_ir)

          # No modifier text leaks into a symbol name, type name or comment.
          assert_false(state, "no 'borrowing' token survives into IR",
            contains(borrowing_ir, "borrowing"))
          assert_false(state, "no 'consuming' token survives into IR",
            contains(consuming_ir, "consuming"))

          # M4.4a erasure. Same one-token comparison: `once` on a parameter versus
          # no modifier on it, everything else byte-for-byte the same source.
          assert_true(state, "once emits byte-identical IR to an unannotated parameter",
            ir_text(r_once_plain) == ir_text(r_once_absent))
          assert_false(state, "no 'once' token survives into IR",
            contains(ir_text(r_once), "once"))

          # `local` erasure: one token of source, zero bytes of IR.
          assert_true(state, "a borrow lent to a local closure compiles", ir_ok(r_local))
          assert_true(state, "local emits byte-identical IR to an unannotated parameter",
            ir_text(r_local_plain) == ir_text(r_local_absent))
          assert_false(state, "no 'local' token survives into IR",
            contains(ir_text(r_local), "local"))

          # The exception (docs/linear-reuse-v0.md §4.1): a linear parameter that is matched and
          # rebuilt. `consuming` still means what an unmodified parameter means, byte for byte.
          assert_true(state, "a matched-and-rebuilt linear parameter compiles", ir_ok(r_rebuild_owned))
          assert_true(state, "a matched-and-rebuilt borrowed parameter compiles", ir_ok(r_rebuild_borrowing))
          assert_true(state, "consuming rebuild emits byte-identical IR to an unmodified parameter",
            ir_text(r_rebuild_consuming) == ir_text(r_rebuild_owned))
          assert_eq(state, "an owned parameter's rebuild reuses its cell",
            bump_allocs(ir_text(r_rebuild_owned)), 0)
          assert_eq(state, "a borrowing parameter's rebuild allocates",
            bump_allocs(ir_text(r_rebuild_borrowing)), 1)

    summary(state)
