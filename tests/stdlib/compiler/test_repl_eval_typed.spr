module main
import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.compiler.compiler as compiler
import stdlib.compiler.source as source
import stdlib.compiler.bundler as bundler
import stdlib.fs as fs
import stdlib.env as env

# Coverage + forward-regression guard for `compile_full_ir_with_cache`, the
# entry point the REPL / analysis-service daemon uses to compile an eval
# expression (analysis_service_driver.compile_and_run_eval).
#
# Before this test, compile_full_ir_with_cache was exercised by ZERO tests.
# It now emits through the typed IR pipeline (ir_pipeline) rather than the
# retired direct backend.  Because the typed corpus is already compiled+run by
# `just test` via --emit-ir, this guard only needs to prove that the
# cache-threaded eval entry produces linkable IR and maps failures to the
# IrFullResult shape link_and_run_eval depends on:
#   1. IrFullOk with a real `define ` block for a trivial valid source.
#   2. IrFullFail for an unresolved-name source.
#   3. IrFullFail with a "check: "-prefixed diagnostic for a type error, so the
#      daemon's error_response surfaces the checker message.

fn is_ir_ok(r: compiler.IrFullResult) -> Bool =
  match r with
  | compiler.IrFullOk _ -> true
  | compiler.IrFullFail _ -> false

fn ir_has_define(r: compiler.IrFullResult) -> Bool =
  match r with
  | compiler.IrFullFail _ -> false
  | compiler.IrFullOk ir -> str_find(ir, "define ") != -1

fn ir_text(r: compiler.IrFullResult) -> String =
  match r with
  | compiler.IrFullFail _ -> ""
  | compiler.IrFullOk ir -> ir

fn is_ir_fail(r: compiler.IrFullResult) -> Bool =
  match r with
  | compiler.IrFullFail _ -> true
  | compiler.IrFullOk _ -> false

fn first_diag_msg(r: compiler.IrFullResult) -> String =
  match r with
  | compiler.IrFullOk _ -> ""
  | compiler.IrFullFail diags ->
      match diags with
      | Nil -> ""
      | [d | _] ->
          match d with
          | compiler.DiagError _ msg -> msg
          | compiler.DiagWarning _ msg -> msg

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    match env.get("SPROUT_STDLIB_ROOT") with
    | Nothing -> ()
    | Just stdlib_root ->
        do
          let ok_path = "/tmp/sprout_test_repl_eval_typed_ok.sprout"
          fs.write_text(ok_path, "fn answer() -> Int = 42\n")
          r <- compiler.compile_full_ir(source.FilePath(ok_path), source.StdlibRoot(stdlib_root))
          assert_true(state, "compile_full_ir returns Ok for trivial input", is_ir_ok(r))
          assert_true(state, "typed eval path emits a `define ` block", ir_has_define(r))

          let bad_path = "/tmp/sprout_test_repl_eval_typed_bad.sprout"
          fs.write_text(bad_path, "fn broken() -> Int = undefined_name_xyz_99887766\n")
          r_bad <- compiler.compile_full_ir(source.FilePath(bad_path), source.StdlibRoot(stdlib_root))
          assert_true(state, "compile_full_ir returns Fail for unresolved name", is_ir_fail(r_bad))

          let type_err_path = "/tmp/sprout_test_repl_eval_typed_type_err.sprout"
          fs.write_text(type_err_path, "fn bad_type() -> String = 42\n")
          r_type_err <- compiler.compile_full_ir(source.FilePath(type_err_path), source.StdlibRoot(stdlib_root))
          assert_true(state, "compile_full_ir returns Fail for type error", is_ir_fail(r_type_err))
          assert_true(state, "type-error diagnostic starts with 'check: '",
            str_starts_with(first_diag_msg(r_type_err), "check: "))

          # The cached, in-memory entry the daemon's eval uses: the same IR as the
          # file path, and a shared LoadEnv never serves one eval's source to the next.
          cache <- bundler.new_load_env()
          let root = source.StdlibRoot(stdlib_root)
          c1 <- compiler.compile_source_full_ir("fn answer() -> Int = 42\n", "/tmp/sprout_eval_x.sprout", root, Nil, cache)
          c2 <- compiler.compile_source_full_ir("fn answer() -> Int = 43\n", "/tmp/sprout_eval_x.sprout", root, Nil, cache)
          c3 <- compiler.compile_source_full_ir("fn answer() -> Int = 42\n", "/tmp/sprout_eval_x.sprout", root, Nil, cache)
          c_bad <- compiler.compile_source_full_ir("fn broken() -> Int = undefined_name_xyz_99887766\n", "/tmp/sprout_eval_x.sprout", root, Nil, cache)
          c_after_bad <- compiler.compile_source_full_ir("fn answer() -> Int = 42\n", "/tmp/sprout_eval_x.sprout", root, Nil, cache)
          assert_true(state, "cached eval entry emits a `define ` block", ir_has_define(c1))
          assert_true(state, "cached eval IR equals the file path's IR", ir_text(c1) == ir_text(r) && ir_text(c1) != "")
          assert_true(state, "a changed source changes the IR", ir_text(c1) != ir_text(c2))
          assert_true(state, "reverting the source restores the IR", ir_text(c1) == ir_text(c3))
          assert_true(state, "cached eval Fails on an unresolved name", is_ir_fail(c_bad))
          assert_true(state, "a failed eval does not poison the cache", ir_text(c1) == ir_text(c_after_bad))

          # An import edited on disk between two compiles through one LoadEnv is re-read:
          # a memo hit needs the same source text, so eval never sees a stale module.
          let pkg_root = "/tmp/sprout_test_memo_pkg"
          let mod_path = pkg_root ++ "/memo_pkg/foo.sprout"
          fs.make_dir_all(pkg_root ++ "/memo_pkg")
          fs.write_text(mod_path, "module memo_pkg.foo\n\nexport fn answer() -> Int = 42\n")
          let user_src = "import memo_pkg.foo (answer)\n\nfn use_it() -> Int = answer()\n"
          let user_path = "/tmp/sprout_test_memo_user.sprout"
          memo_cache <- bundler.new_load_env()
          m1 <- compiler.compile_source_full_ir(user_src, user_path, root, [pkg_root], memo_cache)
          m1_again <- compiler.compile_source_full_ir(user_src, user_path, root, [pkg_root], memo_cache)
          fs.write_text(mod_path, "module memo_pkg.foo\n\nexport fn answer() -> Int = 43\n")
          m2 <- compiler.compile_source_full_ir(user_src, user_path, root, [pkg_root], memo_cache)
          m2_fresh <- compiler.compile_source_full_ir(user_src, user_path, root, [pkg_root], bundler.new_load_env())
          assert_true(state, "import compiles through the shared cache", ir_has_define(m1))
          assert_true(state, "an unchanged import gives identical IR on a memo hit", ir_text(m1) == ir_text(m1_again))
          assert_true(state, "an import edited on disk changes the IR", ir_text(m1) != ir_text(m2))
          assert_true(state, "the cached result equals a cold compile of the edited import", ir_text(m2) == ir_text(m2_fresh) && ir_text(m2) != "")
    summary(state)
