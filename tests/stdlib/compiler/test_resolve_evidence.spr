import stdlib.test (TestState, new_state, assert_eq, assert_true, summary)
import stdlib.compiler.resolve as resolve
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.ast as ast
import stdlib.compiler.types as types
import stdlib.compiler.source as source

# M3b-2 regression: resolve_program populates each TDict's Evidence with the
# resolved dictionary tree. The top level is always EvClasses — one block per
# effective class, i.e. the constraint's class followed by its transitive
# superclasses (matching lowering's class_with_transitive_supers). So a plain
# Eq yields a 1-block EvClasses; an Ord yields a 2-block [Ord, Eq] EvClasses.

fn dpos() -> source.SourcePos = source.SourcePos(index = 0, line = 1, column = 1)

fn tn(name: String) -> ast.TypeExpr = ast.TypeName(name)

fn tapp(base: ast.TypeExpr, arg: ast.TypeExpr) -> ast.TypeExpr = ast.TypeApply(base, arg)

fn ec(class_name: String, args: List ast.TypeExpr) -> ast.TypeConstraint =
  ast.TypeConstraint(class_name, args)

fn mk_fn(name: String, c: ast.TypeConstraint) -> typed_ast.TypedDecl =
  typed_ast.TFnDecl(name, Nil, Nothing, Nothing, Nil,
    typed_ast.TDict(c, types.TVar(types.tyvar_id("dummy")), dpos(), typed_ast.EvUnresolved))

fn mk_inst(c: ast.TypeConstraint, ctx: List ast.TypeConstraint) -> typed_ast.TypedDecl =
  typed_ast.TInstanceDecl(c, ctx, Nil)

# A class decl (as the checker passes it through) so resolve can build super_map.
fn mk_class(name: String, supers: List ast.TypeConstraint) -> typed_ast.TypedDecl =
  typed_ast.TPassThrough(ast.ClassDecl(name, ["a"], Nil, supers, dpos()))

fn find_fn_body(decls: List typed_ast.TypedDecl, name: String) -> Maybe typed_ast.TypedExpr =
  match decls with
  | Nil -> Nothing
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl n _ _ _ _ body -> if n == name then Just(body) else find_fn_body(rest, name)
      | _ -> find_fn_body(rest, name)

fn body_evidence(mb: Maybe typed_ast.TypedExpr) -> typed_ast.Evidence =
  match mb with
  | Just body ->
      match body with
      | typed_ast.TDict _ _ _ ev -> ev
      | _ -> typed_ast.EvUnresolved
  | Nothing -> typed_ast.EvUnresolved

fn ev_tag(ev: typed_ast.Evidence) -> String =
  match ev with
  | typed_ast.EvUnresolved -> "U"
  | typed_ast.EvClasses _ -> "C"
  | typed_ast.EvInstance _ _ _ -> "I"
  | typed_ast.EvForward _ _ -> "F"
  | typed_ast.EvMissing _ -> "M"

fn ev_key(ev: typed_ast.Evidence) -> String =
  match ev with
  | typed_ast.EvInstance _ k _ -> k
  | typed_ast.EvForward _ k -> k
  | _ -> ""

# The i-th effective-class block of an EvClasses (EvUnresolved if out of range).
fn ev_block(ev: typed_ast.Evidence, i: Int) -> typed_ast.Evidence =
  match ev with
  | typed_ast.EvClasses blocks -> nth_ev(blocks, i)
  | _ -> typed_ast.EvUnresolved

fn nth_ev(blocks: List typed_ast.Evidence, i: Int) -> typed_ast.Evidence =
  match blocks with
  | Nil -> typed_ast.EvUnresolved
  | Cons h t -> if i == 0 then h else nth_ev(t, i - 1)

fn ev_first_child(ev: typed_ast.Evidence) -> typed_ast.Evidence =
  match ev with
  | typed_ast.EvInstance _ _ children ->
      match children with
      | [c | _] -> c
      | Nil -> typed_ast.EvUnresolved
  | _ -> typed_ast.EvUnresolved

fn program_decls(r: resolve.ResolveResult) -> List typed_ast.TypedDecl =
  match r with
  | resolve.ResolveOk prog ->
      match prog with
      | typed_ast.TypedProgram decls -> decls
  | resolve.ResolveErr _ _ -> Nil

fn is_ok(r: resolve.ResolveResult) -> Bool =
  match r with
  | resolve.ResolveOk _ -> true
  | resolve.ResolveErr _ _ -> false

fn ev_of(r: resolve.ResolveResult, fn_name: String) -> typed_ast.Evidence =
  body_evidence(find_fn_body(program_decls(r), fn_name))

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    let result = resolve.resolve_program(
      typed_ast.TypedProgram([
        mk_class("Eq", Nil),
        mk_class("Ord", [ec("Eq", [tn("a")])]),
        mk_inst(ec("Eq", [tn("Int")]), Nil),
        mk_inst(ec("Eq", [tapp(tn("Maybe"), tn("a"))]), [ec("Eq", [tn("a")])]),
        mk_inst(ec("Ord", [tn("Int")]), Nil),
        mk_fn("test_concrete", ec("Eq", [tn("Int")])),
        mk_fn("test_constrained", ec("Eq", [tapp(tn("Maybe"), tn("Int"))])),
        mk_fn("test_forward", ec("Eq", [tn("a")])),
        mk_fn("test_ord_concrete", ec("Ord", [tn("Int")])),
        mk_fn("test_ord_forward", ec("Ord", [tn("a")]))
      ]),
      dict_empty())

    assert_true(state, "resolve_program returns Ok", is_ok(result))

    # top level is always EvClasses
    assert_eq(state, "concrete top tag", ev_tag(ev_of(result, "test_concrete")), "C")

    # Eq has no supers → single block EvInstance("Eq_Int", [])
    assert_eq(state, "concrete block0 tag", ev_tag(ev_block(ev_of(result, "test_concrete"), 0)), "I")
    assert_eq(state, "concrete block0 key", ev_key(ev_block(ev_of(result, "test_concrete"), 0)), "Eq_Int")
    assert_eq(state, "concrete has no block1", ev_tag(ev_block(ev_of(result, "test_concrete"), 1)), "U")

    # constrained: block0 = EvInstance("Eq_Maybe", [EvClasses([EvInstance("Eq_Int",[])])])
    assert_eq(state, "constrained block0 key", ev_key(ev_block(ev_of(result, "test_constrained"), 0)), "Eq_Maybe")
    assert_eq(state, "constrained child block0 key",
      ev_key(ev_block(ev_first_child(ev_block(ev_of(result, "test_constrained"), 0)), 0)), "Eq_Int")

    # forward: block0 = EvForward("Eq_a")
    assert_eq(state, "forward block0 tag", ev_tag(ev_block(ev_of(result, "test_forward"), 0)), "F")
    assert_eq(state, "forward block0 key", ev_key(ev_block(ev_of(result, "test_forward"), 0)), "Eq_a")

    # SUPER-EXPANSION: Ord Int → EvClasses([EvInstance("Ord_Int",[]), EvInstance("Eq_Int",[])])
    assert_eq(state, "ord block0 key", ev_key(ev_block(ev_of(result, "test_ord_concrete"), 0)), "Ord_Int")
    assert_eq(state, "ord block1 key (super)", ev_key(ev_block(ev_of(result, "test_ord_concrete"), 1)), "Eq_Int")

    # forwarded super-expansion: Ord a → [EvForward("Ord_a"), EvForward("Eq_a")]
    assert_eq(state, "ord fwd block0 key", ev_key(ev_block(ev_of(result, "test_ord_forward"), 0)), "Ord_a")
    assert_eq(state, "ord fwd block1 key (super)", ev_key(ev_block(ev_of(result, "test_ord_forward"), 1)), "Eq_a")

    summary(state)
