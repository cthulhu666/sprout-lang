import stdlib.test (new_state, assert_true, summary)
import stdlib.compiler.compiler as compiler
import stdlib.compiler.source as source
import stdlib.env as env
import stdlib.fs as fs

# A callee constraint whose argument is nested (`where ToString (Box (List b))`) or a
# tuple (`where ToString (b, Int)`) carries no variable the call can read, so its
# dictionary is GUESSED from the first argument with that head constructor. A guess
# must stay a hole (`_`): named, it took the other argument's variable and ran its
# dictionary on these values — Int's `to_string` on a String pointer. As a hole it is
# the poison thunk, which fails loudly if reached. Making these exact needs the
# constraint's written argument at the call (BACKLOG); this pins the loud failure.
# Not covered, because it does not hold: a caller whose own `where` has the guess's
# head (`where ToString (c, Int)`) gets the guess forwarded to that `where`.

let nested_src: String =
  `type Box a deriving (ToString) = Box a

fn pick(x: Box (List a), y: Box (List b)) -> String where ToString (Box (List b)) = to_string(y)

fn caller(p: c, q: d) -> String where ToString c, ToString d = pick(Box([p]), Box([q]))

fn main() -> Unit !{IO} = print(caller(1, "s"))
`

let tuple_src: String =
  `fn pt(x: (a, Int), y: (b, Int)) -> String where ToString (b, Int) = to_string(y)

fn caller(p: c, q: d) -> String where ToString c, ToString d = pt((p, 1), (q, 2))

fn main() -> Unit !{IO} = print(caller(1, "s"))
`

fn contains(haystack: String, needle: String) -> Bool = str_find(haystack, needle) != -1

fn ir_text(r: compiler.IrFullResult) -> String =
  match r with
  | compiler.IrFullOk ir -> ir
  | compiler.IrFullFail _ -> ""

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    match env.get("SPROUT_STDLIB_ROOT") with
    | Nothing -> ()
    | Just stdlib_root ->
        do
          let nested_path = "/tmp/sprout_test_guessed_dict_nested.sprout"
          let tuple_path = "/tmp/sprout_test_guessed_dict_tuple.sprout"
          fs.write_text(nested_path, nested_src)
          fs.write_text(tuple_path, tuple_src)
          r_nested <- compiler.compile_full_ir(source.FilePath(nested_path), source.StdlibRoot(stdlib_root))
          r_tuple <- compiler.compile_full_ir(source.FilePath(tuple_path), source.StdlibRoot(stdlib_root))
          assert_true(state, "nested compound constraint: guessed inner dict is a hole",
            contains(ir_text(r_nested), "__sprout_ir_unresolved_thunk"))
          assert_true(state, "tuple constraint: guessed inner dict is a hole",
            contains(ir_text(r_tuple), "__sprout_ir_unresolved_thunk"))
    summary(state)
