module main
import stdlib.test (TestState, new_state, assert_eq, summary)
import stdlib.compiler.source as source

# `source.SourcePos` is a RECORD, not a positional three-`Int` ADT.
#
# The type it replaced was `SourcePos Int Int Int`, and nothing at a construction
# site said which Int was which: `SourcePos(0, 0, 0)` is equally readable as
# index/line/column, line/column/index, or a typo. Two of the three fields are
# 1-based and one is 0-based, so a swap is silent — it produces a plausible
# position that points at the wrong character.
#
# What this file pins is the *named* surface, from both directions:
#
#   CONSTRUCTION must be by field name. On the old ADT `SourcePos(index = 5, …)`
#     was a parse error, so this file is the failing test that drove the change.
#   READING must be by field name too. The `position_index` / `position_line` /
#     `position_column` accessors that the ADT needed are gone — they named the
#     slots of a positional type, which the field labels now do at the
#     declaration — so `pos.index` and friends are the only spelling.
#
# The read assertions use three DISTINCT values, deliberately. Equal values would
# let any permutation of the fields pass; 5/2/3 fails unless each field is wired
# to the label that names it.
#
# `index` is the CODEPOINT index, not the byte offset — `SourceCursor` carries the
# byte offset in a separate slot (`source.sprout`, `cursor_byte_offset`). The
# name is load-bearing: the two were conflatable while the field was anonymous.

fn a_pos() -> source.SourcePos = source.SourcePos(index = 5, line = 2, column = 3)

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # ---- construction and reading are both by field name --------------------
    assert_eq(state, "`.index` reads the index field", a_pos().index, 5)
    assert_eq(state, "`.line` reads the line field", a_pos().line, 2)
    assert_eq(state, "`.column` reads the column field", a_pos().column, 3)

    # ---- a field survives being carried through a record-typed slot ---------
    # `with` rebuilds the record; the untouched fields must come across intact.
    # This is the shape every compiler site relies on when it advances a position
    # one codepoint without disturbing the line.
    let bumped = a_pos() with (index = a_pos().index + 1)
    assert_eq(state, "`with` advances the named field", bumped.index, 6)
    assert_eq(state, "`with` leaves line alone", bumped.line, 2)
    assert_eq(state, "`with` leaves column alone", bumped.column, 3)

    # ---- the origin position, spelled out ----------------------------------
    # `cursor_from_string` starts at codepoint 0 on line 1, column 1 — the one
    # place the 0-based/1-based split is visible in a single value. Written as a
    # record so the asymmetry is legible instead of being `SourcePos(0, 1, 1)`.
    let origin = source.source_position(source.cursor_from_string("hello"))
    assert_eq(state, "a fresh cursor starts at codepoint index 0", origin.index, 0)
    assert_eq(state, "a fresh cursor starts on line 1", origin.line, 1)
    assert_eq(state, "a fresh cursor starts at column 1", origin.column, 1)

    summary(state)
