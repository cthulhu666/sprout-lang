module main
import stdlib.test (check_eq, run_suite)
import stdlib.compiler.lsp_driver as lsp
import stdlib.json as json

fn hover_params_json(uri: json.Json, position: json.Json) -> json.Json =
  json.JsonObject(
    json.JsonObjectCons("textDocument",
      json.JsonObject(json.JsonObjectCons("uri", uri, json.JsonObjectNil)),
    json.JsonObjectCons("position", position,
    json.JsonObjectNil)))

fn well_formed_position() -> json.Json =
  json.JsonObject(
    json.JsonObjectCons("line", json.JsonInt(3),
    json.JsonObjectCons("character", json.JsonInt(7),
    json.JsonObjectNil)))

# A JSON-RPC message with an id is a REQUEST and must be answered; one without is a
# NOTIFICATION and must not be. Real clients send plenty of both that this server does
# not implement — documentSymbol, semanticTokens, codeAction, $/cancelRequest — and
# dropping a request leaves the client waiting for a reply that never comes.
fn request_json(id: Int, method: String) -> json.Json =
  json.JsonObject(
    json.JsonObjectCons("jsonrpc", json.JsonString("2.0"),
    json.JsonObjectCons("id", json.JsonInt(id),
    json.JsonObjectCons("method", json.JsonString(method),
    json.JsonObjectNil))))

fn notification_json(method: String) -> json.Json =
  json.JsonObject(
    json.JsonObjectCons("jsonrpc", json.JsonString("2.0"),
    json.JsonObjectCons("method", json.JsonString(method),
    json.JsonObjectNil)))

fn stringified(j: json.Json) -> String =
  match json.stringify(j) with
  | Ok text -> text
  | Err _ -> ""

fn rendered(value: Maybe json.Json) -> String =
  match value with
  | Nothing -> ""
  | Just j -> stringified(j)

fn main() -> Unit !{IO} =
  run_suite("lsp_driver", [
    # parse_content_length
    check_eq("parse_content_length: valid header",
      lsp.parse_content_length("Content-Length: 42"), Just(42)),
    check_eq("parse_content_length: zero",
      lsp.parse_content_length("Content-Length: 0"), Just(0)),
    check_eq("parse_content_length: unrelated header",
      lsp.parse_content_length("Content-Type: application/vscode-jsonrpc"), Nothing),
    check_eq("parse_content_length: empty string",
      lsp.parse_content_length(""), Nothing),
    check_eq("parse_content_length: partial prefix",
      lsp.parse_content_length("Content-Length:42"), Nothing),
    # W8/P1: correct prefix but a non-numeric value — parse_int is total, so the
    # Just-arm must yield Nothing (not Just(0)). Exercises the and_then bind arm.
    check_eq("parse_content_length: malformed value",
      lsp.parse_content_length("Content-Length: abc"), Nothing),

    # extract_word — basic identifiers
    check_eq("extract_word: middle of word",
      lsp.extract_word("hello world", 2), "hello"),
    check_eq("extract_word: second word",
      lsp.extract_word("hello world", 8), "world"),
    check_eq("extract_word: start of string",
      lsp.extract_word("hello", 0), "hello"),
    check_eq("extract_word: end of word (col at last char)",
      lsp.extract_word("hello", 4), "hello"),

    # extract_word — at a non-ident character gives empty string
    check_eq("extract_word: space gives empty",
      lsp.extract_word("hello world", 5), ""),
    check_eq("extract_word: open paren gives empty",
      lsp.extract_word("foo(bar)", 3), ""),

    # extract_word — qualified names (dot included)
    check_eq("extract_word: dotted name from middle",
      lsp.extract_word("string.join(\"|\")", 8), "string.join"),
    check_eq("extract_word: dotted name from start",
      lsp.extract_word("string.join(\"|\")", 0), "string.join"),

    # extract_word — empty string input
    check_eq("extract_word: empty line",
      lsp.extract_word("", 0), ""),

    # extract_word — col past end of line
    check_eq("extract_word: col past end",
      lsp.extract_word("hi", 10), ""),
    # The off-by-one boundary specifically: col == length, not merely far past it.
    check_eq("extract_word: col exactly at end of line",
      lsp.extract_word("hi", 2), ""),
    check_eq("extract_word: operator gives empty",
      lsp.extract_word("let x = 1", 6), ""),

    # extract_word — the rest of the qualified-name surface hover depends on.
    # `.` is an ident char here, so the cursor may sit ON the dot, and the word must
    # stop before a following paren rather than swallowing it.
    check_eq("extract_word: cursor on the dot itself",
      lsp.extract_word("string.join(\"|\")", 6), "string.join"),
    check_eq("extract_word: last char before a paren",
      lsp.extract_word("string.join(\"|\")", 10), "string.join"),
    # Digits continue an identifier (is_ident_continue admits them); nothing else
    # in this file has a digit inside a name.
    check_eq("extract_word: digits continue an identifier",
      lsp.extract_word("read_u32_be(b)", 6), "read_u32_be"),

    # `..` is the range operator, not part of a name — hover on either endpoint
    # of `lo..hi` must resolve that endpoint. It used to extract the whole
    # `lo..hi`, which resolves to nothing (BACKLOG P1, 2026-08-19).
    check_eq("extract_word: left endpoint of a range",
      lsp.extract_word("lo..hi", 0), "lo"),
    check_eq("extract_word: right endpoint of a range",
      lsp.extract_word("lo..hi", 4), "hi"),
    check_eq("extract_word: right endpoint, cursor on its last char",
      lsp.extract_word("lo..hi", 5), "hi"),
    # A field path either side of the operator: the field dots still join.
    check_eq("extract_word: field path left of a range",
      lsp.extract_word("p.x..p.y", 1), "p.x"),
    check_eq("extract_word: field path right of a range",
      lsp.extract_word("p.x..p.y", 6), "p.y"),
    # A single dot is unaffected — the guard needs a dot ADJACENT to a dot.
    check_eq("extract_word: lone dot still joins a qualified name",
      lsp.extract_word("a.b", 2), "a.b"),

    # extract_hover_params — exercises every failure branch individually,
    # plus the well-formed happy path.
    check_eq("extract_hover_params: well-formed accepted",
      lsp.extract_hover_params(hover_params_json(json.JsonString("file:///a.spr"), well_formed_position())),
      Just(lsp.HoverParams("file:///a.spr", 3, 7))),
    check_eq("extract_hover_params: missing textDocument rejected",
      lsp.extract_hover_params(json.JsonObject(json.JsonObjectCons("position", well_formed_position(), json.JsonObjectNil))),
      Nothing),
    check_eq("extract_hover_params: missing uri rejected",
      lsp.extract_hover_params(hover_params_json(json.JsonInt(1), well_formed_position())),
      Nothing),
    check_eq("extract_hover_params: missing position rejected",
      lsp.extract_hover_params(json.JsonObject(json.JsonObjectCons("textDocument",
        json.JsonObject(json.JsonObjectCons("uri", json.JsonString("file:///a.spr"), json.JsonObjectNil)),
        json.JsonObjectNil))),
      Nothing),
    check_eq("extract_hover_params: missing line rejected",
      lsp.extract_hover_params(hover_params_json(json.JsonString("file:///a.spr"),
        json.JsonObject(json.JsonObjectCons("character", json.JsonInt(7), json.JsonObjectNil)))),
      Nothing),
    check_eq("extract_hover_params: missing character rejected",
      lsp.extract_hover_params(hover_params_json(json.JsonString("file:///a.spr"),
        json.JsonObject(json.JsonObjectCons("line", json.JsonInt(3), json.JsonObjectNil)))),
      Nothing),
    # Line 0, character 0 is the first position in the file and a perfectly legal
    # hover target. It is also the one position a truthiness-style guard would drop,
    # so pin it rather than assume the field checks stay shape-based.
    check_eq("extract_hover_params: position 0,0 accepted",
      lsp.extract_hover_params(hover_params_json(json.JsonString("file:///a.spr"),
        json.JsonObject(
          json.JsonObjectCons("line", json.JsonInt(0),
          json.JsonObjectCons("character", json.JsonInt(0),
          json.JsonObjectNil))))),
      Just(lsp.HoverParams("file:///a.spr", 0, 0))),
    check_eq("extract_hover_params: empty object rejected",
      lsp.extract_hover_params(json.JsonObject(json.JsonObjectNil)), Nothing),

    # unknown_method_response — request vs notification
    check_eq("unknown method: a request is answered with method-not-found",
      rendered(lsp.unknown_method_response("textDocument/documentSymbol",
        request_json(41, "textDocument/documentSymbol"))),
      "{\"jsonrpc\":\"2.0\",\"id\":41,\"error\":{\"code\":-32601,"
        ++ "\"message\":\"method not implemented: textDocument/documentSymbol\"}}"),
    # The id must be echoed VERBATIM: a client matches the reply to its pending request
    # by it, so a response carrying the wrong id is worse than none.
    check_eq("unknown method: a string id is echoed unchanged",
      rendered(lsp.unknown_method_response("x",
        json.JsonObject(
          json.JsonObjectCons("id", json.JsonString("abc"),
          json.JsonObjectNil)))),
      "{\"jsonrpc\":\"2.0\",\"id\":\"abc\",\"error\":{\"code\":-32601,"
        ++ "\"message\":\"method not implemented: x\"}}"),
    # Json has no Eq instance, so the absence is asserted through the same rendering as
    # the cases above; "" is unambiguous because a reply always renders non-empty.
    check_eq("unknown method: a notification is not answered",
      rendered(lsp.unknown_method_response("$/cancelRequest",
        notification_json("$/cancelRequest"))),
      "")
  ])
