module main
import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.compiler.ast_to_ir as ast_to_ir
import stdlib.compiler.ir_rooting as ir_rooting
import stdlib.compiler.ir_lowering as ir_lowering
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types
import stdlib.compiler.ast as ast
import stdlib.compiler.source as source

# Tier-1 CPR peephole: a `match` whose scrutinee is a direct call to a
# Maybe-returning C extern with an `_unboxed` variant must lower to an
# UNBOXED { i64, i64 } call + extractvalue — NOT a boxed @vector_get call
# read back with @sprout_tag / @sprout_field.  This eliminates the per-call
# `Just` heap allocation (measured ~20 ns/get, ~71% of the get cost).

fn no_pos() -> source.SourcePos = source.SourcePos(0, 0, 0)

fn maybe_int() -> types.Type =
  types.TApp(types.TConst("Maybe"), types.TConst("Int"))

# fn probe(v, i) =
#   match vector_get(v, i) with
#   | Just x  -> x
#   | Nothing -> 0
# Maybe declared so Just/Nothing land in the ctor table (prelude does this in
# real compilation; a hand-built TypedProgram must supply it).
fn maybe_decl() -> typed_ast.TypedDecl =
  typed_ast.TPassThrough(
    ast.TypeDecl("Maybe", Cons("a", Nil),
      Cons(ast.TypeConstructor("Just", Cons(ast.TypeName("a"), Nil)),
        Cons(ast.TypeConstructor("Nothing", Nil), Nil)),
      Nil, no_pos()))

fn probe_program() -> typed_ast.TypedProgram =
  typed_ast.TypedProgram(
    Cons(maybe_decl(),
    Cons(
      typed_ast.TFnDecl("probe",
        Cons(ast.Param("v", Nothing), Cons(ast.Param("i", Nothing), Nil)),
        Nothing, Nothing, Nil,
        typed_ast.TMatch(
          typed_ast.TCall(
            typed_ast.TVar("vector_get", types.TConst("Int"), no_pos()),
            Cons(typed_ast.TVar("v", types.TConst("Int"), no_pos()),
              Cons(typed_ast.TVar("i", types.TConst("Int"), no_pos()), Nil)),
            maybe_int(), no_pos()),
          Cons(
            typed_ast.TypedMatchBranch(
              ast.ConstructorPattern("Just", Cons(ast.VarPattern("x", no_pos()), Nil), no_pos()),
              typed_ast.TVar("x", types.TConst("Int"), no_pos())),
            Cons(
              typed_ast.TypedMatchBranch(
                ast.ConstructorPattern("Nothing", Nil, no_pos()),
                typed_ast.TInt(0, types.TConst("Int"), no_pos())),
              Nil)),
          types.TConst("Int"), no_pos())),
      Nil)))

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    match ast_to_ir.translate_program(probe_program()) with
    | Err msg ->
        do
          assert_true(state, "translate should succeed (got Err: " ++ msg ++ ")", false)
          summary(state)
    | Ok pair ->
        match pair with
        | (ir_prog, idx_map) ->
            do
              let ir = ir_lowering.lower_program(ir_rooting.insert_roots(ir_prog, idx_map))
              assert_true(state, "unboxed call emitted",
                str_find(ir, "@vector_get_unboxed") >= 0)
              assert_true(state, "extractvalue emitted",
                str_find(ir, "extractvalue") >= 0)
              assert_true(state, "no boxed vector_get call at match site",
                str_find(ir, "call i64 @vector_get(") < 0)
              summary(state)
