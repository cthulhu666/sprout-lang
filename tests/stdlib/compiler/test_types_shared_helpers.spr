import stdlib.test (TestState, new_state, assert_eq, summary)
import stdlib.compiler.types as types

# The type helpers that lowering, resolve and linear_check share.

fn con(n: String) -> types.Type = types.TConst(types.type_id(n))
fn var(n: String) -> types.Type = types.TVar(types.tyvar_id(n))
fn app(f: types.Type, x: types.Type) -> types.Type = types.TApp(f, x)

fn bound(pattern: types.Type, actual: types.Type, v: String) -> String =
  match dict_get(v, types.match_type_vars(pattern, actual, dict_empty())) with
  | Nothing -> "-"
  | Just t -> types.type_to_string(t)

fn head(t: types.Type) -> String = maybe_with_default("-", types.first_concrete_head_str(t))

fn var_head(t: types.Type) -> String = maybe_with_default("-", types.head_var(t))

# Class `Show a`, keyed by its full name, whose method `show` has the scheme `a String`;
# a binding that is not found is "-".
fn eta_of(class_name: String, method: String, used: types.Type) -> String =
  match types.eta_class_type_of(dict_set("Show", "a", dict_empty()),
                                dict_set("show", types.mono(app(var("a"), con("String"))), dict_empty()),
                                class_name, method, used) with
  | Just t -> types.type_to_string(t)
  | Nothing -> "-"

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    assert_eq(state, "a variable binds the whole type", bound(var("a"), con("Int"), "a"), "Int")
    assert_eq(state, "an application binds its argument",
      bound(app(con("List"), var("a")), app(con("List"), con("Int")), "a"), "Int")
    assert_eq(state, "a higher-kinded variable binds the head",
      bound(app(var("f"), var("a")), app(con("Maybe"), con("Int")), "f"), "Maybe")
    assert_eq(state, "a shape mismatch binds nothing",
      bound(app(con("List"), var("a")), con("Int"), "a"), "-")
    assert_eq(state, "a tuple aligns pairwise",
      bound(types.TTuple([var("a"), var("b")]), types.TTuple([con("Int"), con("Bool")]), "b"), "Bool")
    assert_eq(state, "a shorter actual tuple stops early",
      bound(types.TTuple([var("a"), var("b")]), types.TTuple([con("Int")]), "b"), "-")

    assert_eq(state, "head of a constructor", head(con("Int")), "Int")
    assert_eq(state, "head of an application", head(app(app(con("Either"), con("Int")), var("b"))), "Either")
    assert_eq(state, "head of a tuple", head(types.TTuple([con("Int"), con("Int")])), "Tuple2")
    assert_eq(state, "a variable has no head", head(var("a")), "-")

    assert_eq(state, "a variable head is open", types.head_is_var(var("a")), true)
    assert_eq(state, "an applied variable head is open", types.head_is_var(app(var("f"), con("Int"))), true)
    assert_eq(state, "a constructor head is not open", types.head_is_var(app(con("List"), var("a"))), false)
    assert_eq(state, "a tuple head is not open", types.head_is_var(types.TTuple([var("a")])), false)

    assert_eq(state, "head_var names a variable head", var_head(var("a")), "a")
    assert_eq(state, "head_var looks through applications", var_head(app(app(var("f"), con("Int")), var("b"))), "f")
    assert_eq(state, "a constructor head has no head_var", var_head(app(con("List"), var("a"))), "-")
    assert_eq(state, "a tuple has no head_var", var_head(types.TTuple([var("a")])), "-")

    assert_eq(state, "eta_class_type_of finds the class type", eta_of("Show", "show", app(con("Int"), con("String"))), "Int")
    assert_eq(state, "eta_class_type_of is Nothing for an unknown class", eta_of("Eq", "show", app(con("Int"), con("String"))), "-")
    assert_eq(state, "eta_class_type_of is Nothing for an unbound class parameter", eta_of("Show", "show", con("Int")), "-")

    assert_eq(state, "eta_class_type_of finds the method by its short name",
      eta_of("Show", "prelude.show", app(con("Int"), con("String"))), "Int")
    assert_eq(state, "eta_class_type_of finds a class by its full name only",
      eta_of("main.Show", "show", app(con("Int"), con("String"))), "-")
    assert_eq(state, "eta_class_type_of is Nothing for an unknown method",
      eta_of("Show", "eq", app(con("Int"), con("String"))), "-")

    summary(state)
