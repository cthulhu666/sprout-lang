module main
import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.compiler.compiler as compiler
import stdlib.compiler.bundler as bundler
import stdlib.compiler.source as source
import stdlib.env as env

# Regression: constraint-class validation must see PRELUDE classes on the REPL /
# analysis-service path (compile_source_with_cache). A correct `where ToString a` was
# wrongly rejected as "`ToString` is not a class" because the class set was scanned from
# the session's own decls alone, and on that path the prelude arrived as env schemes
# (@class: markers) rather than ClassDecl nodes.
#
# That asymmetry is GONE: compile_source_with_cache now bundles, so the prelude reaches
# the checker as decls exactly as it does for a file. The assertions stay — they pin the
# behaviour, not the mechanism, and they are how we would notice the path regressing to a
# second answer. `scripts/front_end_agreement.sh` guards the general case.

fn is_compile_ok(r: compiler.CompileResult) -> Bool =
  match r with
  | compiler.CompileOk _ -> true
  | compiler.CompileFail _ -> false

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    match env.get("SPROUT_STDLIB_ROOT") with
    | Nothing -> ()
    | Just stdlib_root ->
        do
          cache <- bundler.new_load_env()
          # Correct form using a prelude class must be ACCEPTED.
          let good = "module app.session\n\nfn tostr(x: a) -> String where ToString a = to_string(x)\n"
          r_good <- compiler.compile_source_with_cache(good, source.StdlibRoot(stdlib_root), cache)
          assert_true(state, "REPL: `where ToString a` (prelude class) accepted", is_compile_ok(r_good))
          # The genuine order-swap must still be REJECTED on this path.
          let bad = "module app.session\n\nfn tostr(x: a) -> String where a ToString = to_string(x)\n"
          r_bad <- compiler.compile_source_with_cache(bad, source.StdlibRoot(stdlib_root), cache)
          assert_true(state, "REPL: `where a ToString` (swap) still rejected", is_compile_ok(r_bad) == false)
          # A phantom constraint variable must still be REJECTED on this path.
          let phantom = "module app.session\n\nfn tostr(x) -> String where ToString x = to_string(x)\n"
          r_phantom <- compiler.compile_source_with_cache(phantom, source.StdlibRoot(stdlib_root), cache)
          assert_true(state, "REPL: phantom constraint tyvar still rejected", is_compile_ok(r_phantom) == false)
    summary(state)
