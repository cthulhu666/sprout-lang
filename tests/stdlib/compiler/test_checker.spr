import stdlib.test (TestState, new_state, assert_eq, assert_true, assert_false, summary)
import stdlib.compiler.lexer as lexer
import stdlib.compiler.parser as parser
import stdlib.compiler.checker as checker

fn run_check(src: String) -> checker.CheckResult !{IO} =
  match lexer.tokenize(src) with
  | Err _ -> checker.CheckErr("lex error")
  | Ok toks ->
      match parser.parse_program(toks) with
      | Err _ -> checker.CheckErr("parse error")
      | Ok prog -> checker.check_program(prog)

fn is_check_ok(r: checker.CheckResult) -> Bool =
  match r with
  | checker.CheckOk _ -> true
  | checker.CheckErr _ -> false

fn is_check_err(r: checker.CheckResult) -> Bool =
  match r with
  | checker.CheckErr _ -> true
  | checker.CheckOk _ -> false

fn check_err_msg(r: checker.CheckResult) -> String =
  match r with
  | checker.CheckErr msg -> msg
  | checker.CheckOk _ -> ""

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # Successful type checks
    r1 <- run_check("fn val() -> Int = 42")
    assert_true(state, "int literal typechecks", is_check_ok(r1))

    r2 <- run_check("")
    assert_true(state, "empty program typechecks", is_check_ok(r2))

    r3 <- run_check("fn id(x: Int) -> Int = x")
    assert_true(state, "identity function typechecks", is_check_ok(r3))

    r4 <- run_check("fn add(a: Int, b: Int) -> Int = a + b")
    assert_true(state, "binary add typechecks", is_check_ok(r4))

    r5 <- run_check("fn always_true() -> Bool = true")
    assert_true(state, "bool literal typechecks", is_check_ok(r5))

    r6 <- run_check("fn greet() -> String = \"hello\"")
    assert_true(state, "string literal typechecks", is_check_ok(r6))

    r7 <- run_check("fn a() -> Int = 1\nfn b() -> Int = 2")
    assert_true(state, "two functions typecheck", is_check_ok(r7))

    r8 <- run_check("fn cond(x: Int) -> Int = if x == 0 then 1 else 2")
    assert_true(state, "conditional typechecks", is_check_ok(r8))

    # Type errors
    r9 <- run_check("fn val() -> Bool = 42")
    assert_true(state, "int body with bool annotation fails", is_check_err(r9))

    r10 <- run_check("fn val() -> Int = true")
    assert_true(state, "bool body with int annotation fails", is_check_err(r10))

    r11 <- run_check("fn val() -> String = 42")
    assert_true(state, "int body with string annotation fails", is_check_err(r11))

    r12 <- run_check("fn f(x: Int) -> Int = x\nfn g() -> Int = f()")
    assert_true(state, "zero-arg call on function fails", is_check_err(r12))
    assert_true(state, "zero-arg error names the callee", str_find(check_err_msg(r12), "'f'") != -1)

    # Exhaustiveness checking
    r13 <- run_check("type Color = Red | Green | Blue\nfn f(c: Color) -> Int = match c with | Red -> 1 | Blue -> 2")
    assert_true(state, "non-exhaustive match on ADT fails", is_check_err(r13))
    assert_true(state, "non-exhaustive error mentions missing ctor", str_find(check_err_msg(r13), "Green") != -1)

    r14 <- run_check("type Color = Red | Green | Blue\nfn f(c: Color) -> Int = match c with | Red -> 1 | Blue -> 2 | Green -> 3")
    assert_true(state, "exhaustive match on ADT typechecks", is_check_ok(r14))

    r15 <- run_check("type Color = Red | Green | Blue\nfn f(c: Color) -> Int = match c with | Red -> 1 | _ -> 2")
    assert_true(state, "wildcard arm makes match exhaustive", is_check_ok(r15))

    r16 <- run_check("type Color = Red | Green | Blue\nfn f(c: Color) -> Int = match c with | Red -> 1 | x -> 2")
    assert_true(state, "var-pattern arm makes match exhaustive", is_check_ok(r16))

    # Strict type-name validation
    r17 <- run_check("type Foo = | Bar Baz")
    assert_true(state, "undeclared constructor field type fails", is_check_err(r17))
    assert_true(state, "undeclared type error names the unknown type", str_find(check_err_msg(r17), "Baz") != -1)
    assert_true(state, "undeclared type error names the enclosing decl", str_find(check_err_msg(r17), "Foo") != -1)

    r18 <- run_check("type A = | MkA B\ntype B = | MkB A")
    assert_true(state, "mutually recursive ADTs compile", is_check_ok(r18))

    r19 <- run_check("fn id(x: a) -> a = x")
    assert_true(state, "generic type param does not trigger unknown-type error", is_check_ok(r19))

    r20 <- run_check("type Wrapper = | Wrap Int")
    assert_true(state, "builtin Int as constructor field compiles", is_check_ok(r20))

    summary(state)
