module main
import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.compiler.source as source

# FilePath and StdlibRoot exist as distinct wraps and roundtrip through
# their inner accessors.  If either wrap is removed or renamed, this file
# fails to compile.

fn make_filepath() -> source.FilePath = source.FilePath("/tmp/foo.sprout")

fn make_stdlib_root() -> source.StdlibRoot = source.StdlibRoot("/usr/lib/sprout")

fn filepath_inner(p: source.FilePath) -> String =
  match p with | source.FilePath s -> s

fn stdlib_root_inner(r: source.StdlibRoot) -> String =
  match r with | source.StdlibRoot s -> s

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    assert_true(state, "FilePath roundtrips through inner",
      filepath_inner(make_filepath()) == "/tmp/foo.sprout")

    assert_true(state, "StdlibRoot roundtrips through inner",
      stdlib_root_inner(make_stdlib_root()) == "/usr/lib/sprout")

    summary(state)
