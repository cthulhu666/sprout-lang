import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.compiler.types as types
import stdlib.compiler.iface_codec as iface_codec

# Phase 1.x iface file format round-trip: tests the wrapper format that
# packages a module's schemes as a single artifact, layered on top of the
# bare Scheme codec proven by test_scheme_roundtrip.spr.
#
# Format reference: stdlib/compiler/iface_codec.sprout §"IfaceFile" section.
# Schema is intentionally minimal for Phase 1 — version, module_name,
# named-scheme list. Source-hash + compiler-fingerprint + ctor/class/
# instance tables are deferred to subsequent phases.

# --- Manual structural comparison ----------------------------------------
# stdlib.test.assert_eq needs Eq + ToString; we haven't added those for
# IfaceFile / NamedScheme yet (and don't need to clutter types.sprout for
# a single test file). Use assert_true with hand-written predicates instead.

# Round-trip test: encode(f) -> decode -> re-encode and assert the two
# encoded strings are byte-identical. This covers every field automatically
# (no per-ADT structural-eq helper needed) and exploits the encoder's
# deterministic output. If a field is lost in decode but re-emitted by
# encode, the strings would diverge — bug caught.
#
# Avoids the BACKLOG §7.5 "ADT == doesn't dispatch through Eq" trap by
# never comparing ADTs directly; String == is a primitive that works.
fn roundtrip_eq(f: iface_codec.IfaceFile) -> Bool =
  match iface_codec.decode_iface_file(encoded) with
  | Nothing -> false
  | Just g -> encoded == iface_codec.encode_iface_file(g)
  where encoded = iface_codec.encode_iface_file(f)

# --- Sample scheme constructors for readable test cases ------------------

fn sample_const_scheme(name: String) -> types.Scheme =
  types.mono(types.TConst(name))

fn sample_poly_scheme() -> types.Scheme =
  # forall a. (List a) -> Int
  types.Scheme(
    Cons("a", Nil), Nil,
    types.TFunc(types.TApp(types.TConst("List"), types.TVar("a")), types.TConst("Int"), types.EffectPure),
    types.EffectPure)

fn sample_io_scheme() -> types.Scheme =
  # String -> Unit !{IO}
  types.mono(types.TFunc(types.TConst("String"), types.TConst("Unit"), types.EffectIO))

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # --- Empty iface (module with no exports) ---
    assert_true(state, "empty schemes roundtrip",
      roundtrip_eq(iface_codec.IfaceFile(2, "stdlib.compiler.empty", Nil, Nil, Nil, Nil)))

    # --- Single-scheme iface ---
    assert_true(state, "single scheme roundtrip",
      roundtrip_eq(iface_codec.IfaceFile(2, "stdlib.foo",
        Cons(iface_codec.NamedScheme("stdlib.foo.bar", sample_const_scheme("Int")), Nil),
        Nil, Nil, Nil)))

    # --- Multi-scheme iface mirroring a real module shape ---
    assert_true(state, "multi-scheme roundtrip",
      roundtrip_eq(iface_codec.IfaceFile(2, "stdlib.compiler.types",
        Cons(iface_codec.NamedScheme("stdlib.compiler.types.type_int", sample_const_scheme("Int")),
          Cons(iface_codec.NamedScheme("stdlib.compiler.types.type_bool", sample_const_scheme("Bool")),
            Cons(iface_codec.NamedScheme("stdlib.compiler.types.list_length", sample_poly_scheme()),
              Cons(iface_codec.NamedScheme("stdlib.io.print", sample_io_scheme()), Nil)))),
        Nil, Nil, Nil)))

    # --- Qualified module names with dots ---
    assert_true(state, "qualified module name",
      roundtrip_eq(iface_codec.IfaceFile(2, "stdlib.compiler.iface_codec",
        Cons(iface_codec.NamedScheme("stdlib.compiler.iface_codec.encode_scheme", sample_io_scheme()), Nil),
        Nil, Nil, Nil)))

    # --- v2 with non-empty metadata tables ---
    # CtorInfo: simulates `type Maybe a = Just a | Nothing` registered metadata
    assert_true(state, "iface with ctors roundtrip",
      roundtrip_eq(iface_codec.IfaceFile(2, "stdlib.foo", Nil,
        Cons(iface_codec.CtorInfo("Just", "Maybe", Cons(types.TVar("a"), Nil)),
          Cons(iface_codec.CtorInfo("Nothing", "Maybe", Nil), Nil)),
        Nil, Nil)))
    # ClassInfo: simulates `class Eq a where Ord a { fn eq(...) }`
    assert_true(state, "iface with class roundtrip",
      roundtrip_eq(iface_codec.IfaceFile(2, "stdlib.foo", Nil, Nil,
        Cons(iface_codec.ClassInfo("Eq",
          Cons("a", Nil),
          Cons("Ord", Nil),
          Cons(iface_codec.NamedScheme("eq", sample_poly_scheme()), Nil)), Nil),
        Nil)))
    # InstanceInfo: simulates `instance Eq Int = int_eq_inst`
    assert_true(state, "iface with instances roundtrip",
      roundtrip_eq(iface_codec.IfaceFile(2, "stdlib.foo", Nil, Nil, Nil,
        Cons(iface_codec.InstanceInfo("Eq", types.TConst("Int"), "stdlib.prelude.int_eq_inst"), Nil))))

    # --- Malformed input rejection (v2 wire format) ---
    assert_true(state, "decode empty rejected",
      match iface_codec.decode_iface_file("") with | Nothing -> true | _ -> false)
    assert_true(state, "decode wrong-tag rejected",
      match iface_codec.decode_iface_file("(NotAnIface 2 foo () () () ())") with | Nothing -> true | _ -> false)
    assert_true(state, "decode unsupported-version rejected (v99)",
      match iface_codec.decode_iface_file("(IfaceFile 99 foo () () () ())") with | Nothing -> true | _ -> false)
    assert_true(state, "decode v1 rejected (retired)",
      match iface_codec.decode_iface_file("(IfaceFile 1 foo ())") with | Nothing -> true | _ -> false)
    assert_true(state, "decode trailing chars rejected",
      match iface_codec.decode_iface_file("(IfaceFile 2 foo () () () ()) garbage") with | Nothing -> true | _ -> false)
    assert_true(state, "decode well-formed accepted",
      match iface_codec.decode_iface_file("(IfaceFile 2 foo () () () ())") with | Just _ -> true | _ -> false)

    # --- extract_named_schemes: env-filtering helper ---
    # Build a Dict simulating a post-typecheck env with entries from two
    # different modules. extract_named_schemes(env, "stdlib.foo") should
    # yield only the two stdlib.foo.* entries, dropping stdlib.other.qux.
    let test_env =
      dict_set("stdlib.foo.bar", types.mono(types.TConst("Int")),
        dict_set("stdlib.foo.baz", types.mono(types.TConst("Bool")),
          dict_set("stdlib.other.qux", types.mono(types.TConst("String")),
            dict_empty())))
    assert_true(state, "extract filters by module prefix",
      list_length(iface_codec.extract_named_schemes(test_env, "stdlib.foo")) == 2)
    assert_true(state, "extract empty prefix yields empty",
      list_length(iface_codec.extract_named_schemes(test_env, "stdlib.absent")) == 0)
    assert_true(state, "extract other module yields one",
      list_length(iface_codec.extract_named_schemes(test_env, "stdlib.other")) == 1)

    # Sanity: --check-iface CLI mode (driver-level IO wrapper) is a thin shell
    # around decode_iface_file. These assertions pin the contract the CLI
    # relies on: well-formed input decodes, truncated input fails.
    assert_true(state, "check-iface contract: well-formed minimal accepted",
      match iface_codec.decode_iface_file("(IfaceFile 2 foo () () () ())") with
      | Just _ -> true
      | Nothing -> false)
    assert_true(state, "check-iface contract: missing trailing paren rejected",
      match iface_codec.decode_iface_file("(IfaceFile 2 foo () () () ()") with
      | Nothing -> true
      | _ -> false)

    summary(state)
