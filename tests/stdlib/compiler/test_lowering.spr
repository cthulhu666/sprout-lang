import stdlib.test (TestState, new_state, assert_eq, assert_true, assert_false, summary)
import stdlib.compiler.lexer as lexer
import stdlib.compiler.parser as parser
import stdlib.compiler.checker as checker
import stdlib.compiler.lowering as lowering
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types

fn run_lower(src: String) -> lowering.LowerResult !{IO} =
  match lexer.tokenize(src) with
  | Err _ -> lowering.LowerErr("lex error")
  | Ok toks ->
      match parser.parse_program(toks) with
      | Err _ -> lowering.LowerErr("parse error")
      | Ok prog ->
          do
            tc <- checker.typecheck_typed(prog, Nil)
            match tc with
            | typed_ast.TypedErr msg -> lowering.LowerErr("typecheck: " ++ msg)
            | typed_ast.TypedOk typed_prog env -> lowering.lower_program(typed_prog, env)

fn is_lower_ok(r: lowering.LowerResult) -> Bool =
  match r with
  | lowering.LowerOk _ -> true
  | lowering.LowerErr _ -> false

fn lower_err_msg(r: lowering.LowerResult) -> String =
  match r with
  | lowering.LowerOk _ -> "__ok"
  | lowering.LowerErr msg -> msg

fn has_tc_name_in(decls: List typed_ast.TypedDecl) -> Bool =
  match decls with
  | Nil -> false
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name _ _ _ _ _ ->
          if str_starts_with(name, "__tc_") then true
          else has_tc_name_in(rest)
      | _ -> has_tc_name_in(rest)

fn lower_has_tc_decl(r: lowering.LowerResult) -> Bool =
  match r with
  | lowering.LowerErr _ -> false
  | lowering.LowerOk prog ->
      match prog with
      | typed_ast.TypedProgram decls -> has_tc_name_in(decls)

fn first_fn_body_in(decls: List typed_ast.TypedDecl) -> Maybe typed_ast.TypedExpr =
  match decls with
  | Nil -> Nothing
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl _ _ _ _ _ body -> Just(body)
      | _ -> first_fn_body_in(rest)

fn is_sentinel_type(t: types.Type) -> Bool =
  match t with
  | types.TVar name -> name == "?gen" || name == "?lambda"
  | _ -> false

fn body_type_is_sentinel(r: lowering.LowerResult) -> Bool =
  match r with
  | lowering.LowerErr _ -> false
  | lowering.LowerOk prog ->
      match prog with
      | typed_ast.TypedProgram decls ->
          match first_fn_body_in(decls) with
          | Nothing -> false
          | Just body -> is_sentinel_type(typed_ast.typed_expr_type(body))

fn first_fn_body_named(decls: List typed_ast.TypedDecl, fname: String) -> Maybe typed_ast.TypedExpr =
  match decls with
  | Nil -> Nothing
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name _ _ _ _ body ->
          if name == fname then Just(body)
          else first_fn_body_named(rest, fname)
      | _ -> first_fn_body_named(rest, fname)

fn first_arg_is_lambda(args: List typed_ast.TypedExpr) -> Bool =
  match args with
  | Nil -> false
  | Cons first _ ->
      match first with
      | typed_ast.TLambda _ _ _ _ -> true
      | _ -> false

fn body_first_arg_is_lambda(body: typed_ast.TypedExpr) -> Bool =
  match body with
  | typed_ast.TCall _ args _ _ -> first_arg_is_lambda(args)
  | _ -> false

fn lowered_fn_body_has_lambda_first_arg(result: lowering.LowerResult, fname: String) -> Bool =
  match result with
  | lowering.LowerErr _ -> false
  | lowering.LowerOk prog ->
      match prog with
      | typed_ast.TypedProgram decls ->
          match first_fn_body_named(decls, fname) with
          | Nothing -> false
          | Just body -> body_first_arg_is_lambda(body)

# After lowering, TDict args become TVar nodes named __tc_ClassName_Type_method.
# Scan a call's arg list for the first such var and return its name.
fn tc_var_name_if_any(arg: typed_ast.TypedExpr) -> Maybe String =
  match arg with
  | typed_ast.TVar name _ _ ->
      if str_starts_with(name, "__tc_") then Just(name) else Nothing
  | _ -> Nothing

fn find_tc_var_in_args(args: List typed_ast.TypedExpr) -> String =
  match args with
  | Nil -> "__none"
  | Cons first rest ->
      match tc_var_name_if_any(first) with
      | Just name -> name
      | Nothing -> find_tc_var_in_args(rest)

fn call_body_first_tc_var(body: typed_ast.TypedExpr) -> String =
  match body with
  | typed_ast.TCall _ args _ _ -> find_tc_var_in_args(args)
  | _ -> "__not_call"

# Return the name of the first __tc_* TVar found in fname's lowered body call args.
fn lowered_fn_body_dict_var_name(result: lowering.LowerResult, fname: String) -> String =
  match result with
  | lowering.LowerErr _ -> "__lower_err"
  | lowering.LowerOk prog ->
      match prog with
      | typed_ast.TypedProgram decls ->
          match first_fn_body_named(decls, fname) with
          | Nothing -> "__no_fn"
          | Just body -> call_body_first_tc_var(body)

# Find the first __tc_* TVar in args whose name starts with the given prefix.
fn find_tc_var_for_prefix_in_args(args: List typed_ast.TypedExpr, prefix: String) -> String =
  match args with
  | Nil -> "__none"
  | Cons first rest ->
      match tc_var_name_if_any(first) with
      | Just name ->
          if str_starts_with(name, prefix) then name
          else find_tc_var_for_prefix_in_args(rest, prefix)
      | Nothing -> find_tc_var_for_prefix_in_args(rest, prefix)

fn call_body_tc_var_for_prefix(body: typed_ast.TypedExpr, prefix: String) -> String =
  match body with
  | typed_ast.TCall _ args _ _ -> find_tc_var_for_prefix_in_args(args, prefix)
  | _ -> "__not_call"

# Return the name of the first __tc_* TVar in fname's body that matches prefix.
fn lowered_fn_body_dict_var_for_prefix(result: lowering.LowerResult, fname: String, prefix: String) -> String =
  match result with
  | lowering.LowerErr _ -> "__lower_err"
  | lowering.LowerOk prog ->
      match prog with
      | typed_ast.TypedProgram decls ->
          match first_fn_body_named(decls, fname) with
          | Nothing -> "__no_fn"
          | Just body -> call_body_tc_var_for_prefix(body, prefix)

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # Simple function — no typeclasses, passes through lowering unchanged
    r1 <- run_lower("fn val() -> Int = 42")
    assert_true(state, "simple fn lowers ok", is_lower_ok(r1))
    assert_false(state, "simple fn has no tc decls", lower_has_tc_decl(r1))

    # Two mutually-referencing functions
    r2 <- run_lower("fn a() -> Int = 1\nfn b(x: Int) -> Int = a() + x")
    assert_true(state, "two fns lower ok", is_lower_ok(r2))

    # ADT with match — exercises TypeDecl pass-through and match lowering
    r3 <- run_lower("type Color = Red | Green | Blue\nfn tag(c: Color) -> Int = match c with | Red -> 0 | Green -> 1 | Blue -> 2")
    assert_true(state, "adt and match lower ok", is_lower_ok(r3))
    assert_false(state, "adt program has no tc decls", lower_has_tc_decl(r3))

    # Class + instance — lowering generates __tc_* dispatch functions
    r4 <- run_lower("class Greet a {\n  fn greet(x: a) -> String\n}\ninstance Greet Int {\n  fn greet(x: Int) -> String = \"hi\"\n}")
    assert_true(state, "class and instance lower ok", is_lower_ok(r4))
    assert_true(state, "instance produces __tc_ decl", lower_has_tc_decl(r4))

    # Type preservation: lower_expr must pass types through, not erase to ?gen/?lambda
    assert_false(state, "simple fn body type is non-sentinel", body_type_is_sentinel(r1))
    assert_false(state, "class wrapper body type is non-sentinel", body_type_is_sentinel(r4))

    # Error propagation — lex errors become LowerErr
    r5 <- run_lower("@invalid syntax")
    assert_false(state, "lex error propagates to LowerErr", is_lower_ok(r5))

    # Regression: class method in value position must be eta-expanded to a TLambda,
    # not left as a bare TVar (which generates a generic closure including dict slots
    # as extra args — callers without the dict arity SIGBUS on AArch64).
    r_eta_conc <- run_lower("class MyShow a {\n  fn myshow(x: a) -> String\n}\ninstance MyShow Int {\n  fn myshow(x: Int) -> String = \"int\"\n}\nfn test(f: (Int -> String) -> String, n: Int) -> String = f(myshow)")
    assert_true(state, "class method value-pos (concrete) lowers ok", is_lower_ok(r_eta_conc))
    assert_true(state, "class method value-pos (concrete) eta-expanded to lambda", lowered_fn_body_has_lambda_first_arg(r_eta_conc, "test"))

    r_eta_poly <- run_lower("class MyShow a {\n  fn myshow(x: a) -> String\n}\nfn test(f: (b -> String) -> String, n: b) -> String where MyShow b = f(myshow)")
    assert_true(state, "class method value-pos (poly) lowers ok", is_lower_ok(r_eta_poly))
    assert_true(state, "class method value-pos (poly) eta-expanded to lambda", lowered_fn_body_has_lambda_first_arg(r_eta_poly, "test"))

    # Regression: constrained fn call must inject the element dict (Int), not the
    # container dict (Box Int) when the constraint variable appears inside a container
    # param type and an instance for the container also exists.
    # Bug: resolve_obligation fell through to first-concrete-arg heuristic which
    # found Box Int's head "Box" and picked @inst:MyC:Box instead of @inst:MyC:Int.
    # Use a user-defined Box type (avoids Cons/Nil not being in scope in the isolated
    # typecheck env) with a concrete Box Int instance so the first-arg heuristic
    # resolves to Box (wrong) vs the prog_to_fresh scan which resolves to Int (correct).
    r_dict_conc <- run_lower("class MyC a {\n  fn myop(x: a) -> String\n}\ninstance MyC Int {\n  fn myop(x: Int) -> String = \"int\"\n}\ntype Box a = Box a\ninstance MyC (Box Int) {\n  fn myop(xs: Box Int) -> String = \"boxint\"\n}\nfn wrap(xs: Box a) -> String where MyC a = \"ok\"\nfn main() -> String = wrap(Box(42))")
    assert_true(state, "constrained dict injection (container arg) lowers ok", is_lower_ok(r_dict_conc))
    assert_true(state, "constrained dict injection uses Int dict not Box dict",
      str_starts_with(lowered_fn_body_dict_var_name(r_dict_conc, "main"), "__tc_MyC_Int_"))

    # Gap 2: two independent constraint vars, both in container positions.
    # Each must resolve to its own element dict (Int / Bool), not the container dicts.
    r_dual <- run_lower("class CA a {\n  fn opA(x: a) -> String\n}\nclass CB a {\n  fn opB(x: a) -> Int\n}\ninstance CA Int {\n  fn opA(x: Int) -> String = \"a\"\n}\ninstance CB Bool {\n  fn opB(x: Bool) -> Int = 0\n}\ntype BoxA a = BoxA a\ntype BoxB a = BoxB a\ninstance CA (BoxA Int) {\n  fn opA(xs: BoxA Int) -> String = \"abox\"\n}\ninstance CB (BoxB Bool) {\n  fn opB(xs: BoxB Bool) -> Int = 1\n}\nfn dual(x: BoxA a, y: BoxB b) -> String where CA a, CB b = \"ok\"\nfn main() -> String = dual(BoxA(42), BoxB(true))")
    assert_true(state, "dual constraint (two containers) lowers ok", is_lower_ok(r_dual))
    assert_true(state, "dual constraint: first var resolves to Int dict (CA)",
      str_starts_with(lowered_fn_body_dict_var_for_prefix(r_dual, "main", "__tc_CA_Int_"), "__tc_CA_Int_"))
    assert_true(state, "dual constraint: second var resolves to Bool dict (CB)",
      str_starts_with(lowered_fn_body_dict_var_for_prefix(r_dual, "main", "__tc_CB_Bool_"), "__tc_CB_Bool_"))

    # Gap 3: direct (non-container) constrained call — constraint var is the arg type
    # itself.  Verifies scan_prog_to_fresh_for_instance works for the simple case and
    # doesn't regress (the fix must not break non-container dispatch).
    r_direct <- run_lower("class Greet a {\n  fn greet(x: a) -> String\n}\ninstance Greet Int {\n  fn greet(x: Int) -> String = \"hi\"\n}\nfn main() -> String = greet(42)")
    assert_true(state, "direct constrained call lowers ok", is_lower_ok(r_direct))
    assert_true(state, "direct constrained call injects correct dict",
      str_starts_with(lowered_fn_body_dict_var_name(r_direct, "main"), "__tc_Greet_Int_"))

    summary(state)
