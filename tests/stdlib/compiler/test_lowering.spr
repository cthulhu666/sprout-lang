import stdlib.test (TestState, new_state, assert_eq, assert_true, assert_false, summary)
import stdlib.compiler.lexer as lexer
import stdlib.compiler.parser as parser
import stdlib.compiler.checker as checker
import stdlib.compiler.resolve as resolve
import stdlib.compiler.lowering as lowering
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types

fn run_lower(src: String) -> lowering.LowerResult !{IO} =
  match lexer.tokenize(src) with
  | Err _ -> lowering.LowerErr("lex error")
  | Ok toks ->
      match parser.parse_program(toks) with
      | Err _ -> lowering.LowerErr("parse error")
      | Ok prog ->
          do
            tc <- checker.typecheck_typed(prog, Nil)
            match tc with
            | typed_ast.TypedErr _ msg -> lowering.LowerErr("typecheck: " ++ msg)
            | typed_ast.TypedOk typed_prog env ->
                # Post-M3b, lowering is a mechanical Evidence consumer: the resolve
                # pass must run first to populate each TDict's Evidence (mirrors the
                # production pipeline in compiler.compile_phase_check).
                match resolve.resolve_program(typed_prog, env) with
                | resolve.ResolveErr _ msg -> lowering.LowerErr("resolve: " ++ msg)
                | resolve.ResolveOk resolved -> lowering.lower_program(resolved, env)

fn is_lower_ok(r: lowering.LowerResult) -> Bool =
  match r with
  | lowering.LowerOk _ -> true
  | lowering.LowerErr _ -> false

fn lower_err_msg(r: lowering.LowerResult) -> String =
  match r with
  | lowering.LowerOk _ -> "__ok"
  | lowering.LowerErr msg -> msg

fn has_tc_name_in(decls: List typed_ast.TypedDecl) -> Bool =
  match decls with
  | Nil -> false
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name _ _ _ _ _ ->
          if str_starts_with(name, "__tc_") then true
          else has_tc_name_in(rest)
      | _ -> has_tc_name_in(rest)

fn lower_has_tc_decl(r: lowering.LowerResult) -> Bool =
  match r with
  | lowering.LowerErr _ -> false
  | lowering.LowerOk prog ->
      match prog with
      | typed_ast.TypedProgram decls -> has_tc_name_in(decls)

fn first_fn_body_in(decls: List typed_ast.TypedDecl) -> Maybe typed_ast.TypedExpr =
  match decls with
  | Nil -> Nothing
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl _ _ _ _ _ body -> Just(body)
      | _ -> first_fn_body_in(rest)

fn is_sentinel_type(t: types.Type) -> Bool =
  match t with
  | types.TVar name -> types.tyvar_name(name) == "?gen" || types.tyvar_name(name) == "?lambda"
  | _ -> false

fn body_type_is_sentinel(r: lowering.LowerResult) -> Bool =
  match r with
  | lowering.LowerErr _ -> false
  | lowering.LowerOk prog ->
      match prog with
      | typed_ast.TypedProgram decls ->
          match first_fn_body_in(decls) with
          | Nothing -> false
          | Just body -> is_sentinel_type(typed_ast.typed_expr_type(body))

fn first_fn_body_named(decls: List typed_ast.TypedDecl, fname: String) -> Maybe typed_ast.TypedExpr =
  match decls with
  | Nil -> Nothing
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name _ _ _ _ body ->
          if name == fname then Just(body)
          else first_fn_body_named(rest, fname)
      | _ -> first_fn_body_named(rest, fname)

fn first_arg_is_lambda(args: List typed_ast.TypedExpr) -> Bool =
  match args with
  | Nil -> false
  | [first | _] ->
      match first with
      | typed_ast.TLambda _ _ _ _ -> true
      | _ -> false

fn body_first_arg_is_lambda(body: typed_ast.TypedExpr) -> Bool =
  match body with
  | typed_ast.TCall _ args _ _ -> first_arg_is_lambda(args)
  | _ -> false

fn lowered_fn_body_has_lambda_first_arg(result: lowering.LowerResult, fname: String) -> Bool =
  match result with
  | lowering.LowerErr _ -> false
  | lowering.LowerOk prog ->
      match prog with
      | typed_ast.TypedProgram decls ->
          match first_fn_body_named(decls, fname) with
          | Nothing -> false
          | Just body -> body_first_arg_is_lambda(body)

# Extract the callee name from the first lambda arg's body call.
# For f(myshow) after eta-expansion: TCall(f, [TLambda(_, TCall(TVar(callee), _), _)], _)
fn lambda_arg_inner_callee(body: typed_ast.TypedExpr) -> String =
  match body with
  | typed_ast.TCall _ args _ _ ->
      match args with
      | [typed_ast.TLambda _ lambda_body _ _ | _] ->
          match lambda_body with
          | typed_ast.TCall (typed_ast.TVar callee _ _) _ _ _ -> callee
          | _ -> "__lambda_body_not_call"
      | _ -> "__first_arg_not_lambda"
  | _ -> "__body_not_call"

fn lowered_fn_lambda_inner_callee(result: lowering.LowerResult, fname: String) -> String =
  match result with
  | lowering.LowerErr _ -> "__lower_err"
  | lowering.LowerOk prog ->
      match prog with
      | typed_ast.TypedProgram decls ->
          match first_fn_body_named(decls, fname) with
          | Nothing -> "__no_fn"
          | Just body -> lambda_arg_inner_callee(body)

# Count args in the inner call inside the first lambda arg.
# For f(eta_lambda) where eta_lambda = TLambda(ps, TCall(impl, args, ...), ...):
# returns list_length(args) — used to verify dict args are included.
fn count_typed_exprs(xs: List typed_ast.TypedExpr) -> Int =
  match xs with
  | Nil -> 0
  | Cons _ rest -> 1 + count_typed_exprs(rest)

fn lambda_arg_inner_call_arg_count(body: typed_ast.TypedExpr) -> Int =
  match body with
  | typed_ast.TCall _ args _ _ ->
      match args with
      | [typed_ast.TLambda _ lambda_body _ _ | _] ->
          match lambda_body with
          | typed_ast.TCall _ inner_args _ _ -> count_typed_exprs(inner_args)
          | _ -> -1
      | _ -> -2
  | _ -> -3

fn lowered_fn_lambda_inner_arg_count(result: lowering.LowerResult, fname: String) -> Int =
  match result with
  | lowering.LowerErr _ -> -4
  | lowering.LowerOk prog ->
      match prog with
      | typed_ast.TypedProgram decls ->
          match first_fn_body_named(decls, fname) with
          | Nothing -> -5
          | Just body -> lambda_arg_inner_call_arg_count(body)

# After lowering, TDict args become TVar nodes named __tc_ClassName_Type_method.
# Scan a call's arg list for the first such var and return its name.
fn tc_var_name_if_any(arg: typed_ast.TypedExpr) -> Maybe String =
  match arg with
  | typed_ast.TVar name _ _ ->
      if str_starts_with(name, "__tc_") then Just(name) else Nothing
  | _ -> Nothing

fn find_tc_var_in_args(args: List typed_ast.TypedExpr) -> String =
  match args with
  | Nil -> "__none"
  | Cons first rest ->
      match tc_var_name_if_any(first) with
      | Just name -> name
      | Nothing -> find_tc_var_in_args(rest)

fn call_body_first_tc_var(body: typed_ast.TypedExpr) -> String =
  match body with
  | typed_ast.TCall _ args _ _ -> find_tc_var_in_args(args)
  | _ -> "__not_call"

# Return the name of the first __tc_* TVar found in fname's lowered body call args.
fn lowered_fn_body_dict_var_name(result: lowering.LowerResult, fname: String) -> String =
  match result with
  | lowering.LowerErr _ -> "__lower_err"
  | lowering.LowerOk prog ->
      match prog with
      | typed_ast.TypedProgram decls ->
          match first_fn_body_named(decls, fname) with
          | Nothing -> "__no_fn"
          | Just body -> call_body_first_tc_var(body)

# The callee name of fname's lowered body call.  Used to assert concrete-instance
# devirtualization: a direct call at a known instance retargets its callee to the
# concrete __tc_{Class}_{Type}_{method} fn (docs/devirtualization-v0.md).
fn call_body_callee_name(body: typed_ast.TypedExpr) -> String =
  match body with
  | typed_ast.TCall (typed_ast.TVar name _ _) _ _ _ -> name
  | typed_ast.TCall _ _ _ _ -> "__not_var_callee"
  | _ -> "__not_call"

fn lowered_fn_body_callee_name(result: lowering.LowerResult, fname: String) -> String =
  match result with
  | lowering.LowerErr _ -> "__lower_err"
  | lowering.LowerOk prog ->
      match prog with
      | typed_ast.TypedProgram decls ->
          match first_fn_body_named(decls, fname) with
          | Nothing -> "__no_fn"
          | Just body -> call_body_callee_name(body)

# Find the first __tc_* TVar in args whose name starts with the given prefix.
fn find_tc_var_for_prefix_in_args(args: List typed_ast.TypedExpr, prefix: String) -> String =
  match args with
  | Nil -> "__none"
  | Cons first rest ->
      match tc_var_name_if_any(first) with
      | Just name ->
          if str_starts_with(name, prefix) then name
          else find_tc_var_for_prefix_in_args(rest, prefix)
      | Nothing -> find_tc_var_for_prefix_in_args(rest, prefix)

fn call_body_tc_var_for_prefix(body: typed_ast.TypedExpr, prefix: String) -> String =
  match body with
  | typed_ast.TCall _ args _ _ -> find_tc_var_for_prefix_in_args(args, prefix)
  | _ -> "__not_call"

# Return the name of the first __tc_* TVar in fname's body that matches prefix.
fn lowered_fn_body_dict_var_for_prefix(result: lowering.LowerResult, fname: String, prefix: String) -> String =
  match result with
  | lowering.LowerErr _ -> "__lower_err"
  | lowering.LowerOk prog ->
      match prog with
      | typed_ast.TypedProgram decls ->
          match first_fn_body_named(decls, fname) with
          | Nothing -> "__no_fn"
          | Just body -> call_body_tc_var_for_prefix(body, prefix)

# Dig into the first branch body of a TMatch expression.
fn first_match_branch_body(body: typed_ast.TypedExpr) -> Maybe typed_ast.TypedExpr =
  match body with
  | typed_ast.TMatch _ branches _ _ ->
      match branches with
      | Nil -> Nothing
      | [b | _] ->
          match b with
          | typed_ast.TypedMatchBranch _ branch_body -> Just(branch_body)
  | _ -> Nothing

fn lowered_fn_match_branch_has_lambda_first_arg(result: lowering.LowerResult, fname: String) -> Bool =
  match result with
  | lowering.LowerErr _ -> false
  | lowering.LowerOk prog ->
      match prog with
      | typed_ast.TypedProgram decls ->
          match first_fn_body_named(decls, fname) with
          | Nothing -> false
          | Just body ->
              match first_match_branch_body(body) with
              | Nothing -> false
              | Just branch_body -> body_first_arg_is_lambda(branch_body)

# Dig into the last TDoExprStep of a TDo expression.
fn last_do_expr_step_body(steps: List typed_ast.TypedDoStep) -> Maybe typed_ast.TypedExpr =
  match steps with
  | Nil -> Nothing
  | Cons s rest ->
      match rest with
      | Nil ->
          match s with
          | typed_ast.TDoExprStep e -> Just(e)
          | _ -> Nothing
      | _ -> last_do_expr_step_body(rest)

fn lowered_fn_do_last_step_has_lambda_first_arg(result: lowering.LowerResult, fname: String) -> Bool =
  match result with
  | lowering.LowerErr _ -> false
  | lowering.LowerOk prog ->
      match prog with
      | typed_ast.TypedProgram decls ->
          let Just body = first_fn_body_named(decls, fname) else false
              typed_ast.TDo steps _ _ = body else false
          in
            match last_do_expr_step_body(steps) with
            | Nothing -> false
            | Just expr -> body_first_arg_is_lambda(expr)

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # Simple function — no typeclasses, passes through lowering unchanged
    r1 <- run_lower("fn val() -> Int = 42")
    assert_true(state, "simple fn lowers ok", is_lower_ok(r1))
    assert_false(state, "simple fn has no tc decls", lower_has_tc_decl(r1))

    # Two mutually-referencing functions
    r2 <- run_lower("fn a() -> Int = 1\nfn b(x: Int) -> Int = a() + x")
    assert_true(state, "two fns lower ok", is_lower_ok(r2))

    # ADT with match — exercises TypeDecl pass-through and match lowering
    r3 <- run_lower("type Color = Red | Green | Blue\nfn tag(c: Color) -> Int = match c with | Red -> 0 | Green -> 1 | Blue -> 2")
    assert_true(state, "adt and match lower ok", is_lower_ok(r3))
    assert_false(state, "adt program has no tc decls", lower_has_tc_decl(r3))

    # Class + instance — lowering generates __tc_* dispatch functions
    r4 <- run_lower("class Greet a {\n  fn greet(x: a) -> String\n}\ninstance Greet Int {\n  fn greet(x: Int) -> String = \"hi\"\n}")
    assert_true(state, "class and instance lower ok", is_lower_ok(r4))
    assert_true(state, "instance produces __tc_ decl", lower_has_tc_decl(r4))

    # Type preservation: lower_expr must pass types through, not erase to ?gen/?lambda
    assert_false(state, "simple fn body type is non-sentinel", body_type_is_sentinel(r1))
    assert_false(state, "class wrapper body type is non-sentinel", body_type_is_sentinel(r4))

    # Error propagation — lex errors become LowerErr
    r5 <- run_lower("@invalid syntax")
    assert_false(state, "lex error propagates to LowerErr", is_lower_ok(r5))

    # Regression: class method in value position must be eta-expanded to a TLambda,
    # not left as a bare TVar (which generates a generic closure including dict slots
    # as extra args — callers without the dict arity SIGBUS on AArch64).
    r_eta_conc <- run_lower("class MyShow a {\n  fn myshow(x: a) -> String\n}\ninstance MyShow Int {\n  fn myshow(x: Int) -> String = \"int\"\n}\nfn test(f: (Int -> String) -> String, n: Int) -> String = f(myshow)")
    assert_true(state, "class method value-pos (concrete) lowers ok", is_lower_ok(r_eta_conc))
    assert_true(state, "class method value-pos (concrete) eta-expanded to lambda", lowered_fn_body_has_lambda_first_arg(r_eta_conc, "test"))

    r_eta_poly <- run_lower("class MyShow a {\n  fn myshow(x: a) -> String\n}\nfn test(f: (b -> String) -> String, n: b) -> String where MyShow b = f(myshow)")
    assert_true(state, "class method value-pos (poly) lowers ok", is_lower_ok(r_eta_poly))
    assert_true(state, "class method value-pos (poly) eta-expanded to lambda", lowered_fn_body_has_lambda_first_arg(r_eta_poly, "test"))

    # P2 regression: two same-class constraints (where MyShow a, MyShow b).
    # Prefix scan always picks the alphabetically-first slot ("MyShow_a", idx 0) regardless
    # of which type the method value is inferred for.  When myshow appears in value position
    # typed as (b -> String), the correct slot is __tc_MyShow_1_myshow (idx 1 = b).
    r_eta_two_same_class <- run_lower("class MyShow a {\n  fn myshow(x: a) -> String\n}\nfn test_b(fb: (b -> String) -> String) -> String where MyShow a, MyShow b = fb(myshow)")
    assert_true(state, "same-class two-vars fwd: lowers ok", is_lower_ok(r_eta_two_same_class))
    assert_true(state, "same-class two-vars fwd: picks b-slot (__tc_MyShow_1) not a-slot",
      str_starts_with(lowered_fn_lambda_inner_callee(r_eta_two_same_class, "test_b"), "__tc_MyShow_1_"))

    # Regression: constrained fn call must inject the element dict (Int), not the
    # container dict (Box Int) when the constraint variable appears inside a container
    # param type and an instance for the container also exists.
    # Bug: resolve_obligation fell through to first-concrete-arg heuristic which
    # found Box Int's head "Box" and picked @inst:MyC:Box instead of @inst:MyC:Int.
    # Use a user-defined Box type (avoids Cons/Nil not being in scope in the isolated
    # typecheck env) with a concrete Box Int instance so the first-arg heuristic
    # resolves to Box (wrong) vs the prog_to_fresh scan which resolves to Int (correct).
    r_dict_conc <- run_lower("class MyC a {\n  fn myop(x: a) -> String\n}\ninstance MyC Int {\n  fn myop(x: Int) -> String = \"int\"\n}\ntype Box a = Box a\ninstance MyC (Box Int) {\n  fn myop(xs: Box Int) -> String = \"boxint\"\n}\nfn boxwrap(xs: Box a) -> String where MyC a = \"ok\"\nfn probe() -> String = boxwrap(Box(42))")
    assert_true(state, "constrained dict injection (container arg) lowers ok", is_lower_ok(r_dict_conc))
    assert_true(state, "constrained dict injection uses Int dict not Box dict",
      str_starts_with(lowered_fn_body_dict_var_name(r_dict_conc, "probe"), "__tc_MyC_Int_"))

    # Gap 2: two independent constraint vars, both in container positions.
    # Each must resolve to its own element dict (Int / Bool), not the container dicts.
    r_dual <- run_lower("class CA a {\n  fn opA(x: a) -> String\n}\nclass CB a {\n  fn opB(x: a) -> Int\n}\ninstance CA Int {\n  fn opA(x: Int) -> String = \"a\"\n}\ninstance CB Bool {\n  fn opB(x: Bool) -> Int = 0\n}\ntype BoxA a = BoxA a\ntype BoxB a = BoxB a\ninstance CA (BoxA Int) {\n  fn opA(xs: BoxA Int) -> String = \"abox\"\n}\ninstance CB (BoxB Bool) {\n  fn opB(xs: BoxB Bool) -> Int = 1\n}\nfn dual(x: BoxA a, y: BoxB b) -> String where CA a, CB b = \"ok\"\nfn probe() -> String = dual(BoxA(42), BoxB(true))")
    assert_true(state, "dual constraint (two containers) lowers ok", is_lower_ok(r_dual))
    assert_true(state, "dual constraint: first var resolves to Int dict (CA)",
      str_starts_with(lowered_fn_body_dict_var_for_prefix(r_dual, "probe", "__tc_CA_Int_"), "__tc_CA_Int_"))
    assert_true(state, "dual constraint: second var resolves to Bool dict (CB)",
      str_starts_with(lowered_fn_body_dict_var_for_prefix(r_dual, "probe", "__tc_CB_Bool_"), "__tc_CB_Bool_"))

    # Gap 3: direct (non-container) constrained call — constraint var is the arg type
    # itself.  With concrete-instance devirtualization (docs/devirtualization-v0.md) this
    # direct call at a KNOWN instance resolves to the Int instance by RETARGETING the callee
    # to the concrete __tc_Greet_Int_greet fn and DROPPING the dict witness (no __cm_ wrapper,
    # no dict arg).  The "resolves to Int not the wrong instance" intent is now expressed as
    # the callee name; the absence of an injected dict is the devirt signature.
    r_direct <- run_lower("class Greet a {\n  fn greet(x: a) -> String\n}\ninstance Greet Int {\n  fn greet(x: Int) -> String = \"hi\"\n}\nfn probe() -> String = greet(42)")
    assert_true(state, "direct constrained call lowers ok", is_lower_ok(r_direct))
    assert_true(state, "direct constrained call devirtualizes to the Int instance fn",
      str_starts_with(lowered_fn_body_callee_name(r_direct, "probe"), "__tc_Greet_Int_greet"))
    assert_eq(state, "direct constrained call injects NO dict (devirtualized)",
      lowered_fn_body_dict_var_name(r_direct, "probe"), "__none")

    # P1-shadowed: a function parameter named after a class method must NOT be eta-expanded.
    # The name 'myshow' here refers to the local param (Int -> String), not the class method.
    # Bug: lower_expr's TVar case would see the name in the class env and wrap it in a lambda.
    r_shadowed <- run_lower("class MyShow a {\n  fn myshow(x: a) -> String\n}\ninstance MyShow Int {\n  fn myshow(x: Int) -> String = \"int\"\n}\nfn test(f: (Int -> String) -> String, myshow: Int -> String) -> String = f(myshow)")
    assert_true(state, "shadowed param: lowers ok", is_lower_ok(r_shadowed))
    assert_false(state, "shadowed param: NOT eta-expanded to lambda", lowered_fn_body_has_lambda_first_arg(r_shadowed, "test"))

    # P1-constrained: class method in value position where the instance is parameterized
    # (instance MyEq (Box a) where MyEq a) AND the outer constraint MyEq (Box a) is
    # forwarded.  M3b-5: resolve emits EvForward for the forwarded MyEq (Box a) key, so
    # lowering uses the forwarded slot DIRECTLY (2-arg inner call) — the same path as
    # p2-fwd-only below.  The forwarded MyEq (Box a) dict is already complete (its inner
    # MyEq a was supplied by the caller), so no separate inner-dict reconstruction is
    # needed.  (The deleted resolve_tdict eta path reconstructed from the concrete
    # instance + inner dict — 3 args — only when the inner was ALSO forwarded; that
    # inconsistency with the call path is now unified.  Runtime-verified: observable
    # inner dispatch through the forwarded slot is correct.)
    r_p1c <- run_lower("class MyEq a {\n  fn my_eq(x: a, y: a) -> Bool\n}\ntype Box a = Box a\ninstance MyEq Int {\n  fn my_eq(x: Int, y: Int) -> Bool = true\n}\ninstance MyEq (Box a) where MyEq a {\n  fn my_eq(x: Box a, y: Box a) -> Bool = true\n}\nfn test(f: (Box a -> Box a -> Bool) -> Bool) -> Bool where MyEq (Box a), MyEq a = f(my_eq)")
    assert_true(state, "p1-constrained: lowers ok", is_lower_ok(r_p1c))
    assert_true(state, "p1-constrained: my_eq is eta-expanded to lambda", lowered_fn_body_has_lambda_first_arg(r_p1c, "test"))
    assert_eq(state, "p1-constrained: forwarded slot used directly (2-arg inner call)", lowered_fn_lambda_inner_arg_count(r_p1c, "test"), 2)

    # P1-match-binder: a variable bound by a match pattern that shares a class method name
    # must NOT be eta-expanded in the branch body.
    # Bug: lower_branches lowered branch bodies with ctx unchanged (pattern binders absent
    # from ctx_bound_vars), so a name like 'myshow' would be eta-expanded to a TLambda.
    # h takes (Int -> String) directly; myshow is passed as the first arg.
    r_match_bind <- run_lower("class MyShow a {\n  fn myshow(x: a) -> String\n}\ninstance MyShow Int {\n  fn myshow(x: Int) -> String = \"int\"\n}\ntype Val = Val (Int -> String)\nfn test(v: Val, h: (Int -> String) -> String) -> String =\n  match v with\n  | Val myshow -> h(myshow)")
    assert_true(state, "match-binder shadow: lowers ok", is_lower_ok(r_match_bind))
    assert_false(state, "match-binder shadow: myshow NOT eta-expanded in branch body", lowered_fn_match_branch_has_lambda_first_arg(r_match_bind, "test"))

    # P1-do-let-binder: a name introduced by a do-let step must be in scope (as a
    # local) for all subsequent steps, preventing eta-expansion.
    # Uses a pure do-block (no IO) to keep the inline source self-contained.
    r_do_let <- run_lower("class MyShow a {\n  fn myshow(x: a) -> String\n}\ninstance MyShow Int {\n  fn myshow(x: Int) -> String = \"int\"\n}\nfn test(h: (Int -> String) -> String) -> String =\n  do\n    let myshow = \\x -> \"local\"\n    h(myshow)")
    assert_true(state, "do-let-binder shadow: lowers ok", is_lower_ok(r_do_let))
    assert_false(state, "do-let-binder shadow: myshow NOT eta-expanded in later step", lowered_fn_do_last_step_has_lambda_first_arg(r_do_let, "test"))

    # P1-do-bind-binder: same as do-let but using monadic bind (<-).
    # Uses extern to supply an IO-wrapped value; last step is io_of(h(myshow)).
    r_do_bind <- run_lower("class MyShow a {\n  fn myshow(x: a) -> String\n}\ninstance MyShow Int {\n  fn myshow(x: Int) -> String = \"int\"\n}\nextern fn io_of(x: a) -> a !{IO}\nfn test(h: (Int -> String) -> String) -> String !{IO} =\n  do\n    myshow <- io_of(\\x -> \"local\")\n    io_of(h(myshow))")
    assert_true(state, "do-bind-binder shadow: lowers ok", is_lower_ok(r_do_bind))

    # P1b-concrete-inner: eta-expansion for an instance (MyEq (Box a) where MyEq a) at a
    # CONCRETE instantiation (Box Int) must still thread the inner MyEq Int dict.
    # Bug: inner_tvar_of_tapp returns Nothing for TConst inner, falling back to no-dict lambda.
    r_p1b_conc <- run_lower("class MyEq a {\n  fn my_eq(x: a, y: a) -> Bool\n}\ntype Box a = Box a\ninstance MyEq Int {\n  fn my_eq(x: Int, y: Int) -> Bool = true\n}\ninstance MyEq (Box a) where MyEq a {\n  fn my_eq(x: Box a, y: Box a) -> Bool = true\n}\nfn test(f: (Box Int -> Box Int -> Bool) -> Bool) -> Bool = f(my_eq)")
    assert_true(state, "p1b-concrete-inner: lowers ok", is_lower_ok(r_p1b_conc))
    assert_eq(state, "p1b-concrete-inner: inner call has 3 args (1 dict + 2 value)", lowered_fn_lambda_inner_arg_count(r_p1b_conc, "test"), 3)

    # P1b-multi-var: instance MyEq (Pair a b) where MyEq a, MyEq b, with the outer
    # MyEq (Pair a b) forwarded.  M3b-5: resolve emits EvForward for the forwarded
    # Pair key → forwarded slot used directly (2-arg inner call).  The forwarded
    # MyEq (Pair a b) dict already encapsulates both inner dicts (caller-supplied), so
    # no reconstruction of the two inner dicts is needed (was 4 args via resolve_tdict).
    r_p1b_multi <- run_lower("class MyEq a {\n  fn my_eq(x: a, y: a) -> Bool\n}\ntype Pair a b = Pair a b\ninstance MyEq Int {\n  fn my_eq(x: Int, y: Int) -> Bool = true\n}\ninstance MyEq Bool {\n  fn my_eq(x: Bool, y: Bool) -> Bool = true\n}\ninstance MyEq (Pair a b) where MyEq a, MyEq b {\n  fn my_eq(x: Pair a b, y: Pair a b) -> Bool = true\n}\nfn test(f: (Pair a b -> Pair a b -> Bool) -> Bool) -> Bool where MyEq (Pair a b), MyEq a, MyEq b = f(my_eq)")
    assert_true(state, "p1b-multi-var: lowers ok", is_lower_ok(r_p1b_multi))
    assert_eq(state, "p1b-multi-var: forwarded slot used directly (2-arg inner call)", lowered_fn_lambda_inner_arg_count(r_p1b_multi, "test"), 2)

    # P1b-multi-concrete: the same Pair instance at Pair Int Bool must resolve
    # both concrete inner dictionaries. The old eta path only looked at the final
    # concrete type arg (Bool), so it built an under-applied wrapper.
    r_p1b_multi_concrete <- run_lower("class MyEq a {\n  fn my_eq(x: a, y: a) -> Bool\n}\ntype Pair a b = Pair a b\ninstance MyEq Int {\n  fn my_eq(x: Int, y: Int) -> Bool = true\n}\ninstance MyEq Bool {\n  fn my_eq(x: Bool, y: Bool) -> Bool = true\n}\ninstance MyEq (Pair a b) where MyEq a, MyEq b {\n  fn my_eq(x: Pair a b, y: Pair a b) -> Bool = true\n}\nfn test(f: (Pair Int Bool -> Pair Int Bool -> Bool) -> Bool) -> Bool = f(my_eq)")
    assert_true(state, "p1b-multi-concrete: lowers ok", is_lower_ok(r_p1b_multi_concrete))
    assert_eq(state, "p1b-multi-concrete: inner call has 4 args (2 dicts + 2 value)", lowered_fn_lambda_inner_arg_count(r_p1b_multi_concrete, "test"), 4)

    # P1b-mixed-inner: Pair a Bool with the outer MyEq (Pair a Bool) forwarded.
    # M3b-5: resolve emits EvForward for the forwarded Pair key → forwarded slot used
    # directly (2-arg inner call); the forwarded dict already carries both inner dicts
    # (was 4 args via resolve_tdict reconstruction).
    r_p1b_mixed <- run_lower("class MyEq a {\n  fn my_eq(x: a, y: a) -> Bool\n}\ntype Pair a b = Pair a b\ninstance MyEq Int {\n  fn my_eq(x: Int, y: Int) -> Bool = true\n}\ninstance MyEq Bool {\n  fn my_eq(x: Bool, y: Bool) -> Bool = true\n}\ninstance MyEq (Pair a b) where MyEq a, MyEq b {\n  fn my_eq(x: Pair a b, y: Pair a b) -> Bool = true\n}\nfn test(f: (Pair a Bool -> Pair a Bool -> Bool) -> Bool) -> Bool where MyEq (Pair a Bool), MyEq a = f(my_eq)")
    assert_true(state, "p1b-mixed-inner: lowers ok", is_lower_ok(r_p1b_mixed))
    assert_eq(state, "p1b-mixed-inner: forwarded slot used directly (2-arg inner call)", lowered_fn_lambda_inner_arg_count(r_p1b_mixed, "test"), 2)

    # P1b-super-inner: forwarded inner constraint with a superclass (MyOrd a where
    # MyEq a), outer MyOrd (Box a) forwarded.  M3b-5: resolve emits EvForward for the
    # forwarded MyOrd (Box a) key → forwarded slot used directly (2-arg inner call).
    # The forwarded MyOrd (Box a) dict already carries its own + superclass slots, so
    # they are not reconstructed here (was 4 args via resolve_tdict).
    r_p1b_super <- run_lower("class MyEq a {\n  fn my_eq(x: a, y: a) -> Bool\n}\nclass MyOrd a where MyEq a {\n  fn my_less(x: a, y: a) -> Bool\n}\ntype Box a = Box a\ninstance MyEq Int {\n  fn my_eq(x: Int, y: Int) -> Bool = true\n}\ninstance MyOrd Int {\n  fn my_less(x: Int, y: Int) -> Bool = true\n}\ninstance MyOrd (Box a) where MyOrd a {\n  fn my_less(x: Box a, y: Box a) -> Bool = true\n}\ninstance MyEq (Box a) where MyEq a {\n  fn my_eq(x: Box a, y: Box a) -> Bool = true\n}\nfn test(f: (Box a -> Box a -> Bool) -> Bool) -> Bool where MyOrd (Box a), MyOrd a = f(my_less)")
    assert_true(state, "p1b-super-inner: lowers ok", is_lower_ok(r_p1b_super))
    assert_eq(state, "p1b-super-inner: forwarded slot used directly (2-arg inner call)", lowered_fn_lambda_inner_arg_count(r_p1b_super, "test"), 2)

    # P1c-class-type-not-first-param: Decode's class parameter is the return
    # type, not the String input. Eta expansion must pick Decode Int for
    # (String -> Int), even when Decode String also exists.
    r_p1c_decode <- run_lower("class Decode a {\n  fn decode(s: String) -> a\n}\ninstance Decode Int {\n  fn decode(s: String) -> Int = 1\n}\ninstance Decode String {\n  fn decode(s: String) -> String = s\n}\nfn test(f: (String -> Int) -> Int) -> Int = f(decode)")
    assert_true(state, "p1c-decode: lowers ok", is_lower_ok(r_p1c_decode))
    assert_true(state, "p1c-decode: picks Decode Int not Decode String",
      str_starts_with(lowered_fn_lambda_inner_callee(r_p1c_decode, "test"), "__tc_Decode_Int_"))

    r_p1c_make <- run_lower("class Make a {\n  fn make() -> a\n}\ninstance Make Int {\n  fn make() -> Int = 1\n}\ninstance Make String {\n  fn make() -> String = \"s\"\n}\nfn test(f: (Unit -> Int) -> Int) -> Int = f(make)")
    assert_true(state, "p1c-zero-arg: lowers ok", is_lower_ok(r_p1c_make))
    assert_true(state, "p1c-zero-arg: picks Make Int not Make Unit",
      str_starts_with(lowered_fn_lambda_inner_callee(r_p1c_make, "test"), "__tc_Make_Int_"))

    # P2: forwarded parameterised constraint (MyEq (Box a)) with NO MyEq a in scope.
    # Bug: concrete-head branch fires for head "Box", but inner dict for MyEq a cannot
    # be resolved — produces __unresolved_* TVar (3-arg inner call, wrong callee).
    # Fix: prefer ctx_fwd["MyEq_Box"] so the forwarded slot is used directly (2-arg call).
    r_p2 <- run_lower("class MyEq a {\n  fn my_eq(x: a, y: a) -> Bool\n}\ntype Box a = Box a\ninstance MyEq Int {\n  fn my_eq(x: Int, y: Int) -> Bool = true\n}\ninstance MyEq (Box a) where MyEq a {\n  fn my_eq(x: Box a, y: Box a) -> Bool = true\n}\nfn test(f: (Box a -> Box a -> Bool) -> Bool) -> Bool where MyEq (Box a) = f(my_eq)")
    assert_true(state, "p2-fwd-only: lowers ok", is_lower_ok(r_p2))
    assert_true(state, "p2-fwd-only: uses forwarded slot (__tc_MyEq_0_) not concrete instance",
      str_starts_with(lowered_fn_lambda_inner_callee(r_p2, "test"), "__tc_MyEq_0_"))
    assert_eq(state, "p2-fwd-only: 2 args in inner call (fwd slot, no unresolved inner dict)",
      lowered_fn_lambda_inner_arg_count(r_p2, "test"), 2)

    # TVar-headed forwarded constraint: eta_forwarded_method_for_prog_var path.
    # `where MyEq a` — no concrete head; must use ctx_fwd["MyEq_a"] slot directly.
    r_tvar_fwd <- run_lower("class MyEq a {\n  fn my_eq(x: a, y: a) -> Bool\n}\nfn test(f: (a -> a -> Bool) -> Bool) -> Bool where MyEq a = f(my_eq)")
    assert_true(state, "tvar-fwd: lowers ok", is_lower_ok(r_tvar_fwd))
    assert_true(state, "tvar-fwd: uses forwarded slot (__tc_MyEq_0_)",
      str_starts_with(lowered_fn_lambda_inner_callee(r_tvar_fwd, "test"), "__tc_MyEq_0_"))
    assert_eq(state, "tvar-fwd: 2 args in inner call (value args only, no dict in lambda body)",
      lowered_fn_lambda_inner_arg_count(r_tvar_fwd, "test"), 2)

    summary(state)
