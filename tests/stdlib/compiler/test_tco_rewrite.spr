module main
import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.compiler.ast_to_ir as ast_to_ir
import stdlib.compiler.ir_rooting as ir_rooting
import stdlib.compiler.ir_lowering as ir_lowering
import stdlib.compiler.sprout_ir as sprout_ir
import stdlib.string as string

# Pre-rooting IR for:
#   loop(n, s) = if n <= 0 then str_len(s) else loop(n - 1, int_to_string(n))
# The tail self-call is `%t$9 = call @main.loop(%t$7, %t$8)` in else_3, whose
# result flows through join_3's phi to the ret. tco_rewrite must turn it into an
# alloca-slot loop: %n/%s slots, a tco_loop header reloading them, and an
# IRTcoBack back-edge in the former else block.
fn make_loop_fn() -> sprout_ir.IRFunction =
  sprout_ir.IRFunction("main.loop",
    Cons(("n", sprout_ir.IRTScalar), Cons(("s", sprout_ir.IRTHeap), Nil)),
    "i64",
    Cons(sprout_ir.IRBlock("entry",
      Cons(sprout_ir.IRConst("%t$0", 0),
      Cons(sprout_ir.IRICmp("%t$1", "sle", sprout_ir.param_ssa("n"), "%t$0"),
      Cons(sprout_ir.IRCondBr("%t$1", "then_3", "else_3"), Nil)))),
    Cons(sprout_ir.IRBlock("then_3",
      Cons(sprout_ir.IRStrFromInt("%t$11", sprout_ir.param_ssa("n")),
      Cons(sprout_ir.IRCall("%t$5", sprout_ir.IRTScalar, "str_len", Cons(sprout_ir.param_ssa("s"), Nil)),
      Cons(sprout_ir.IRCall("%t$12", sprout_ir.IRTScalar, "str_len", Cons("%t$11", Nil)),
      Cons(sprout_ir.IRBr("join_3"), Nil))))),
    Cons(sprout_ir.IRBlock("else_3",
      Cons(sprout_ir.IRConst("%t$6", 1),
      Cons(sprout_ir.IRISub("%t$7", sprout_ir.param_ssa("n"), "%t$6"),
      Cons(sprout_ir.IRStrFromInt("%t$8", sprout_ir.param_ssa("n")),
      Cons(sprout_ir.IRCall("%t$9", sprout_ir.IRTScalar, "main.loop", Cons("%t$7", Cons("%t$8", Nil))),
      Cons(sprout_ir.IRBr("join_3"), Nil)))))),
    Cons(sprout_ir.IRBlock("join_3",
      Cons(sprout_ir.IRPhi("%t$4", "i64", Cons(("%t$5", "then_3"), Cons(("%t$9", "else_3"), Nil))),
      Cons(sprout_ir.IRRet("%t$4"), Nil))),
    Nil)))))

# Lower `f` after rooting it, as the pipeline does. Rooting temps start at
# `next_idx`, past the rewrite's own.
fn lower_rooted(f: sprout_ir.IRFunction, next_idx: Int) -> String =
  ir_lowering.lower_fn_with_table(
    ir_rooting.rewrite_one_fn_with_summary(f, dict_from_list([(sprout_ir.ir_fn_name(f), next_idx)]), dict_empty()),
    dict_empty())

# Pre-rooting IR for a NESTED tail call (two phi levels):
#   g(n) = if c1 then base1 else (if c2 then base2 else g(x))
# The self-call %rx in else2 flows through join2's phi, then join1's phi, to the
# ret. tco_rewrite must trace phi -> phi -> ret and still catch it.
fn make_nested_fn() -> sprout_ir.IRFunction =
  sprout_ir.IRFunction("main.g",
    Cons(("n", sprout_ir.IRTScalar), Nil),
    "i64",
    Cons(sprout_ir.IRBlock("entry",
      Cons(sprout_ir.IRConst("%c1", 1),
      Cons(sprout_ir.IRCondBr("%c1", "then1", "else1"), Nil))),
    Cons(sprout_ir.IRBlock("then1",
      Cons(sprout_ir.IRConst("%base1", 10), Cons(sprout_ir.IRBr("join1"), Nil))),
    Cons(sprout_ir.IRBlock("else1",
      Cons(sprout_ir.IRConst("%c2", 1), Cons(sprout_ir.IRCondBr("%c2", "then2", "else2"), Nil))),
    Cons(sprout_ir.IRBlock("then2",
      Cons(sprout_ir.IRConst("%base2", 20), Cons(sprout_ir.IRBr("join2"), Nil))),
    Cons(sprout_ir.IRBlock("else2",
      Cons(sprout_ir.IRConst("%one", 1),
      Cons(sprout_ir.IRISub("%x", sprout_ir.param_ssa("n"), "%one"),
      Cons(sprout_ir.IRCall("%rx", sprout_ir.IRTScalar, "main.g", Cons("%x", Nil)),
      Cons(sprout_ir.IRBr("join2"), Nil))))),
    Cons(sprout_ir.IRBlock("join2",
      Cons(sprout_ir.IRPhi("%m2", "i64", Cons(("%base2", "then2"), Cons(("%rx", "else2"), Nil))),
      Cons(sprout_ir.IRBr("join1"), Nil))),
    Cons(sprout_ir.IRBlock("join1",
      Cons(sprout_ir.IRPhi("%m1", "i64", Cons(("%base1", "then1"), Cons(("%m2", "join2"), Nil))),
      Cons(sprout_ir.IRRet("%m1"), Nil))),
    Nil))))))))

# make_nested_fn plus a second phi in join1 that carries the same (value, pred)
# pair as the incoming dropped from join2. The drop is keyed by the phi's own
# block, so join1's copy stays.
fn make_same_pair_fn() -> sprout_ir.IRFunction =
  match make_nested_fn() with
  | sprout_ir.IRFunction name params ret blocks ->
      sprout_ir.IRFunction(name, params, ret, list_map(add_same_pair, blocks))

fn add_same_pair(b: sprout_ir.IRBlock) -> sprout_ir.IRBlock =
  match b with
  | sprout_ir.IRBlock "join1" ops ->
      sprout_ir.IRBlock("join1",
        Cons(sprout_ir.IRPhi("%same", "i64", Cons(("%rx", "else2"), Cons(("%base1", "then1"), Nil))), ops))
  | _ -> b

# Pre-rooting IR for a SINGLE-ARM tuple-destructure tail call:
#   h(n) = if c1 then base1
#          else (match scan(n) with | (x, _) -> h(x))
# A single-arm match lowers to one real arm (arm_0) plus an `unreachable`
# exhaustiveness sibling, so the join (join_inner) has a SINGLE-incoming
# pass-through phi `%mi = phi [%r, arm_0]`. The old tco_safe_hits punted here
# (removing the lone incoming would empty the phi), leaving a native self-call
# that overflows at scale (this is the tokenize_from blocker). The fix keeps the
# hit, empties join_inner, drops it, and STRIPS [%mi, join_inner] from join1's
# parent phi — the cascade this test exercises directly.
fn make_single_arm_fn() -> sprout_ir.IRFunction =
  sprout_ir.IRFunction("main.h",
    Cons(("n", sprout_ir.IRTScalar), Nil),
    "i64",
    Cons(sprout_ir.IRBlock("entry",
      Cons(sprout_ir.IRConst("%c1", 1),
      Cons(sprout_ir.IRCondBr("%c1", "then1", "else1"), Nil))),
    Cons(sprout_ir.IRBlock("then1",
      Cons(sprout_ir.IRConst("%base1", 10), Cons(sprout_ir.IRBr("join1"), Nil))),
    Cons(sprout_ir.IRBlock("else1",
      Cons(sprout_ir.IRConst("%one", 1),
      Cons(sprout_ir.IRISub("%x", sprout_ir.param_ssa("n"), "%one"),
      Cons(sprout_ir.IRBr("arm_0"), Nil)))),
    Cons(sprout_ir.IRBlock("arm_0",
      Cons(sprout_ir.IRCall("%r", sprout_ir.IRTScalar, "main.h", Cons("%x", Nil)),
      Cons(sprout_ir.IRBr("join_inner"), Nil))),
    Cons(sprout_ir.IRBlock("join_inner",
      Cons(sprout_ir.IRPhi("%mi", "i64", Cons(("%r", "arm_0"), Nil)),
      Cons(sprout_ir.IRBr("join1"), Nil))),
    Cons(sprout_ir.IRBlock("join1",
      Cons(sprout_ir.IRPhi("%m1", "i64", Cons(("%base1", "then1"), Cons(("%mi", "join_inner"), Nil))),
      Cons(sprout_ir.IRRet("%m1"), Nil))),
    Nil)))))))

# A function with NO self-call at all: tco_collect finds nothing, so tco_rewrite
# must return it byte-identical — params NOT renamed to $in, no tco_loop block.
# This locks the no-op early-return path (distinct from make_non_tail_fn, which
# DOES contain a self-call that is then filtered out as non-tail).
fn make_no_self_call_fn() -> sprout_ir.IRFunction =
  sprout_ir.IRFunction("main.inc",
    Cons(("n", sprout_ir.IRTScalar), Nil),
    "i64",
    Cons(sprout_ir.IRBlock("entry",
      Cons(sprout_ir.IRConst("%one", 1),
      Cons(sprout_ir.IRIAdd("%r", sprout_ir.param_ssa("n"), "%one"),
      Cons(sprout_ir.IRRet("%r"), Nil)))),
    Nil))

# A self-call whose result is used by a COMPUTATIONAL op before the return is NOT
# in tail position — e.g. `r <- g(n-1); h(r); r` (path-compression in union-find:
# `root <- find_root(..); ref_write(.., BoundTo(root)); root`).  The return value
# traces back to the call through the join phi, but the call's result is also an
# operand of `h`/make-ctor, so converting the call to an IRTcoBack back-edge drops
# the value `h` needs (an SSA "use of undefined value").  tco_rewrite must leave
# such a call as a normal IRCall.
fn make_non_tail_fn() -> sprout_ir.IRFunction =
  sprout_ir.IRFunction("main.g",
    Cons(("n", sprout_ir.IRTScalar), Nil),
    "i64",
    Cons(sprout_ir.IRBlock("entry",
      Cons(sprout_ir.IRConst("%c", 1),
      Cons(sprout_ir.IRCondBr("%c", "then1", "else1"), Nil))),
    Cons(sprout_ir.IRBlock("then1",
      Cons(sprout_ir.IRConst("%base", 10), Cons(sprout_ir.IRBr("join1"), Nil))),
    Cons(sprout_ir.IRBlock("else1",
      Cons(sprout_ir.IRConst("%one", 1),
      Cons(sprout_ir.IRISub("%x", sprout_ir.param_ssa("n"), "%one"),
      Cons(sprout_ir.IRCall("%r", sprout_ir.IRTScalar, "main.g", Cons("%x", Nil)),
      Cons(sprout_ir.IRIAdd("%w", "%r", "%r"),
      Cons(sprout_ir.IRBr("join1"), Nil)))))),
    Cons(sprout_ir.IRBlock("join1",
      Cons(sprout_ir.IRPhi("%m", "i64", Cons(("%base", "then1"), Cons(("%r", "else1"), Nil))),
      Cons(sprout_ir.IRRet("%m"), Nil))),
    Nil)))))

# A wide dispatcher: arms 0..5 each call main.wide and branch to one join phi;
# arm 2 uses its result after the call (not a tail call), arm 6 is the base.
fn wide_arm(i: Int) -> sprout_ir.IRBlock =
  sprout_ir.IRBlock("arm_" ++ int_to_string(i),
    Cons(sprout_ir.IRConst("%x_" ++ int_to_string(i), i),
    Cons(sprout_ir.IRCall("%r_" ++ int_to_string(i), sprout_ir.IRTScalar, "main.wide",
           Cons("%x_" ++ int_to_string(i), Nil)),
    if i == 2
    then Cons(sprout_ir.IRIAdd("%w", "%r_2", "%r_2"), Cons(sprout_ir.IRBr("join"), Nil))
    else Cons(sprout_ir.IRBr("join"), Nil))))

fn wide_incoming(i: Int) -> (String, String) =
  ("%r_" ++ int_to_string(i), "arm_" ++ int_to_string(i))

fn make_wide_fn() -> sprout_ir.IRFunction =
  sprout_ir.IRFunction("main.wide",
    Cons(("n", sprout_ir.IRTScalar), Nil),
    "i64",
    Cons(sprout_ir.IRBlock("entry",
      Cons(sprout_ir.IRConst("%c", 1), Cons(sprout_ir.IRCondBr("%c", "arm_0", "base"), Nil))),
    list_append(list_map(wide_arm, [0, 1, 2, 3, 4, 5]),
    Cons(sprout_ir.IRBlock("base",
      Cons(sprout_ir.IRConst("%b", 10), Cons(sprout_ir.IRBr("join"), Nil))),
    Cons(sprout_ir.IRBlock("join",
      Cons(sprout_ir.IRPhi("%m", "i64",
             list_append(list_map(wide_incoming, [0, 1, 2, 3, 4, 5]), Cons(("%b", "base"), Nil))),
      Cons(sprout_ir.IRRet("%m"), Nil))),
    Nil)))))

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    match ast_to_ir.tco_rewrite(make_wide_fn(), 600) with
    | (wide, _niw) ->
        do
          let wir = ir_lowering.lower_fn_with_table(wide, dict_empty())
          # Five back-edges plus the entry block's jump into the loop.
          assert_true(state, "wide: five tail arms become back-edges",
            list_length(string.split(wir, "br label %tco_loop")) == 7)
          assert_true(state, "wide: the non-tail arm keeps its call",
            list_length(string.split(wir, "call i64 @main.wide")) == 2)
          assert_true(state, "wide: tail arms drop their phi incoming",
            string.contains(wir, "[%r_0, %arm_0]") == false && string.contains(wir, "[%r_5, %arm_5]") == false)
          assert_true(state, "wide: non-tail and base incomings stay",
            string.contains(wir, "[%r_2, %arm_2]") && string.contains(wir, "[%b, %base]"))
    match ast_to_ir.tco_rewrite(make_same_pair_fn(), 700) with
    | (sp, _nisp) ->
        do
          let spir = ir_lowering.lower_fn_with_table(sp, dict_empty())
          assert_true(state, "same pair: join1's own incoming stays",
            string.contains(spir, "%same = phi i64 [%rx, %else2]"))
          assert_true(state, "same pair: join2's incoming is dropped",
            string.contains(spir, "%m2 = phi i64 [%base2, %then2]"))
    match ast_to_ir.tco_rewrite(make_no_self_call_fn(), 500) with
    | (unchanged, _ni5) ->
        do
          let ncir = ir_lowering.lower_fn_with_table(unchanged, dict_empty())
          assert_true(state, "no-self-call: not rewritten (no tco_loop)", string.contains(ncir, "tco_loop") == false)
          assert_true(state, "no-self-call: param kept (not renamed to $in)", string.contains(ncir, "%p$n$in") == false)
          assert_true(state, "no-self-call: define keeps plain param", string.contains(ncir, "define i64 @main.inc(i64 %p$n)"))
    match ast_to_ir.tco_rewrite(make_non_tail_fn(), 400) with
    | (nt, _ni4) ->
        do
          let ntir = ir_lowering.lower_fn_with_table(nt, dict_empty())
          assert_true(state, "non-tail: self-call kept (not TCO'd)", string.contains(ntir, "call i64 @main.g"))
          assert_true(state, "non-tail: no back-edge emitted", string.contains(ntir, "br label %tco_loop") == false)
    match ast_to_ir.tco_rewrite(make_single_arm_fn(), 300) with
    | (sa, _ni3) ->
        do
          let sair = ir_lowering.lower_fn_with_table(sa, dict_empty())
          assert_true(state, "single-arm: has tco_loop", string.contains(sair, "tco_loop:"))
          assert_true(state, "single-arm: back-edge to loop", string.contains(sair, "br label %tco_loop"))
          assert_true(state, "single-arm: self-call gone", string.contains(sair, "call i64 @main.h") == false)
          assert_true(state, "single-arm: dead join_inner block removed", string.contains(sair, "join_inner") == false)
    match ast_to_ir.tco_rewrite(make_nested_fn(), 200) with
    | (nested, nested_ni) ->
        do
          let nir = ir_lowering.lower_fn_with_table(nested, dict_empty())
          assert_true(state, "nested: renames param", string.contains(nir, "@main.g(i64 %p$n$in)"))
          assert_true(state, "nested: has tco_loop", string.contains(nir, "tco_loop:"))
          assert_true(state, "nested: back-edge to loop", string.contains(nir, "br label %tco_loop"))
          assert_true(state, "nested: self-call gone", string.contains(nir, "call i64 @main.g") == false)
          # The pair only frees an iteration's root slots. An all-scalar loop has
          # none, so rooting drops it: LLVM treats stackrestore as a write.
          let rnir = lower_rooted(nested, nested_ni)
          assert_true(state, "nested, rooted: no stacksave", string.contains(rnir, "@llvm.stacksave") == false)
          assert_true(state, "nested, rooted: no stackrestore", string.contains(rnir, "@llvm.stackrestore") == false)
    match ast_to_ir.tco_rewrite(make_loop_fn(), 100) with
    | (rewritten, next_idx) ->
        do
          let ir = ir_lowering.lower_fn_with_table(rewritten, dict_empty())
          assert_true(state, "renames params to $in",
            string.contains(ir, "define i64 @main.loop(i64 %p$n$in, i64 %p$s$in)"))
          assert_true(state, "has a tco_loop block", string.contains(ir, "tco_loop:"))
          assert_true(state, "entry stacksaves", string.contains(ir, "@llvm.stacksave()"))
          assert_true(state, "entry slots are one per line",
            string.contains(ir, "store i64 %p$n$in, ptr %t$100\n  %t$101 = alloca i64\n"))
          assert_true(state, "loop header reloads n", string.contains(ir, "%p$n = load i64, ptr"))
          assert_true(state, "loop header reloads s", string.contains(ir, "%p$s = load i64, ptr"))
          assert_true(state, "back-edge stores new n", string.contains(ir, "store i64 %t$7, ptr"))
          assert_true(state, "back-edge stores new s", string.contains(ir, "store i64 %t$8, ptr"))
          assert_true(state, "back-edge stackrestores", string.contains(ir, "@llvm.stackrestore"))
          assert_true(state, "back-edge branches to the loop", string.contains(ir, "br label %tco_loop"))
          assert_true(state, "the self-call is gone",
            string.contains(ir, "call i64 @main.loop") == false)
          # The rewritten arm branches back to tco_loop instead of falling into
          # join_3, so join_3's phi must lose that incoming — otherwise it names
          # a predecessor that no longer reaches it and the module fails verify.
          assert_true(state, "phi drops the rewritten predecessor",
            string.contains(ir, "[%t$9, %else_3]") == false)
          assert_true(state, "phi keeps the base arm as its only incoming",
            string.contains(ir, "%t$4 = phi i64 [%t$5, %then_3]"))
          # Under an empty summary str_len is a GC trigger. The carried heap param `s` lives in a
          # slot of the frame (docs/frame-slot-rooting-v0.md); `%t$11`, live across the first
          # str_len and defined in the same block, is the block-local root that needs the stack reset.
          let kir = lower_rooted(rewritten, next_idx)
          assert_true(state, "rooted loop keeps its heap param in the frame",
            string.contains(kir, "@sprout_gc_push_scan_root"))
          assert_true(state, "rooted loop pushes a block-local root", string.contains(kir, "@sprout_gc_push_i64_root"))
          assert_true(state, "rooted loop keeps its stacksave", string.contains(kir, "@llvm.stacksave()"))
          assert_true(state, "rooted loop keeps its stackrestore", string.contains(kir, "@llvm.stackrestore"))
          summary(state)
