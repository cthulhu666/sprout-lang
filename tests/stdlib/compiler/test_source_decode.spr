import stdlib.test (TestState, new_state, assert_eq, summary)
import stdlib.compiler.source as source

# decode_char_at(s, i) -> Maybe (Char, Int): total UTF-8 decode over a String.
# Returns the codepoint as a Char plus the next byte offset, or Nothing at end,
# out of range, below zero, or on a continuation byte (not a lead byte). Safe by
# construction: every read is a bounds-checked str_byte_at, so no offset can read
# out of bounds. A String is valid UTF-8, so a truncated sequence cannot be built;
# the invalid-lead cases are the offsets that land mid-character.

fn dchar(s: String, i: Int) -> String =
  match source.decode_char_at(s, i) with
  | Nothing -> "none"
  | Just (ch, _) -> char_to_string(ch)

fn dnext(s: String, i: Int) -> Int =
  match source.decode_char_at(s, i) with
  | Nothing -> -1
  | Just (_, next) -> next

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # ASCII: one byte, advances by 1
    assert_eq(state, "ascii char @0", dchar("abc", 0), "a")
    assert_eq(state, "ascii next @0", dnext("abc", 0), 1)
    assert_eq(state, "ascii char @1", dchar("abc", 1), "b")
    assert_eq(state, "ascii next @2", dnext("abc", 2), 3)

    # Two-byte codepoint (U+00E9 'é' = 0xC3 0xA9): advances by 2
    assert_eq(state, "2-byte char", dchar("é", 0), "é")
    assert_eq(state, "2-byte next", dnext("é", 0), 2)

    # Three-byte codepoint (U+20AC '€'): advances by 3
    assert_eq(state, "3-byte char", dchar("€", 0), "€")
    assert_eq(state, "3-byte next", dnext("€", 0), 3)

    # Four-byte codepoint (U+1F600 '😀' emoji): advances by 4 — exercises decode4
    assert_eq(state, "4-byte char", dchar("😀", 0), "😀")
    assert_eq(state, "4-byte next", dnext("😀", 0), 4)

    # A codepoint at a nonzero offset, after a multi-byte one
    assert_eq(state, "after 2-byte char", dchar("é€", 2), "€")
    assert_eq(state, "after 2-byte next", dnext("é€", 2), 5)

    # End of input -> Nothing
    assert_eq(state, "end -> none", dchar("ab", 2), "none")
    assert_eq(state, "empty -> none", dchar("", 0), "none")

    # Out of range -> Nothing (cannot read past the end)
    assert_eq(state, "oob -> none", dchar("ab", 99), "none")
    assert_eq(state, "negative -> none", dchar("ab", 0 - 1), "none")

    # An offset on a continuation byte is not a lead byte -> Nothing
    assert_eq(state, "continuation of 2-byte -> none", dchar("é", 1), "none")
    assert_eq(state, "continuation 1 of 3-byte -> none", dchar("€", 1), "none")
    assert_eq(state, "continuation 2 of 3-byte -> none", dchar("€", 2), "none")
    assert_eq(state, "continuation 1 of 4-byte -> none", dchar("😀", 1), "none")
    assert_eq(state, "continuation 2 of 4-byte -> none", dchar("😀", 2), "none")
    assert_eq(state, "continuation 3 of 4-byte -> none", dchar("😀", 3), "none")

    summary(state)
