import stdlib.test (TestState, new_state, assert_eq, assert_true, assert_false, summary)
import stdlib.compiler.lexer as lexer
import stdlib.compiler.parser as parser
import stdlib.compiler.ast as ast
import stdlib.compiler.source as source

# One named reason per destructure step, so the `let … in` block's per-binding
# `else` records *where* it stopped — the whole point of distinct `else`s.
# Eq drives the assert_eq comparisons; ToString prints the reason on failure.
type BodyLineError deriving (Eq, ToString) =
  | LexError
  | ParseError
  | NoDecls
  | FirstNotFn
  | BodyNotMatch

# W9/X5: line of the first fn's desugared body. A where-binding lowers to a
# single-arm `MatchExpr` on the bound value — the SAME node `let … in` builds
# (parser.wrap_where_binding / build_let_binding_match). It used to lower to a
# CallExpr wrapping an unannotated lambda, which typed the body before the bound
# value and so defaulted `where`-bound Doubles to Int; that is why the node shape
# here is a MatchExpr and not a CallExpr.
#
# Each step bails to its own reason, so a failure says which stage stopped it —
# lex, parse, empty, non-fn, or non-match body.
fn first_fn_body_line(src: String) -> Result BodyLineError Int =
  let Ok toks = lexer.tokenize(src) else Err(LexError)
      Ok prog = parser.parse_program(toks) else Err(ParseError)
      ast.Program([d | _]) _ = prog else Err(NoDecls)
      ast.FnDecl _ _ _ _ _ body _ = d else Err(FirstNotFn)
      ast.MatchExpr _ _ pos = body else Err(BodyNotMatch)
  in Ok(source.position_line(pos))

# The desugared body's node shape, so a test can assert that `where` and the
# equivalent `let … in` lower to the SAME constructor. Two desugarings for one
# binding construct is what allowed them to type differently.
fn first_fn_body_shape(src: String) -> String =
  match lexer.tokenize(src) with
  | Err _ -> "lex-error"
  | Ok toks ->
      match parser.parse_program(toks) with
      | Err _ -> "parse-error"
      | Ok prog ->
          match prog with
          | ast.Program decls _ ->
              match decls with
              | [] -> "no-decls"
              | [d | _] ->
                  match d with
                  | ast.FnDecl _ _ _ _ _ body _ -> expr_shape(body)
                  | _ -> "not-fn"

fn expr_shape(e: ast.Expr) -> String =
  match e with
  | ast.MatchExpr _ _ _ -> "match"
  | ast.CallExpr _ _ _ -> "call"
  | ast.LambdaExpr _ _ _ -> "lambda"
  | ast.IntExpr _ _ -> "int"
  | ast.VarExpr _ _ -> "var"
  | _ -> "other"

fn parse_ok(src: String) -> Bool =
  match lexer.tokenize(src) with
  | Err _ -> false
  | Ok toks ->
      match parser.parse_program(toks) with
      | Ok _ -> true
      | Err _ -> false

fn parse_fails(src: String) -> Bool =
  match lexer.tokenize(src) with
  | Err _ -> true
  | Ok toks ->
      match parser.parse_program(toks) with
      | Err _ -> true
      | Ok _ -> false

fn count_list(lst: List a) -> Int =
  match lst with
  | [] -> 0
  | Cons _ rest -> 1 + count_list(rest)

fn decl_count(src: String) -> Int =
  match lexer.tokenize(src) with
  | Err _ -> -1
  | Ok toks ->
      match parser.parse_program(toks) with
      | Err _ -> -1
      | Ok prog ->
          match prog with
          | ast.Program decls _ -> count_list(decls)

fn first_fn_name(src: String) -> String =
  match lexer.tokenize(src) with
  | Err _ -> ""
  | Ok toks ->
      match parser.parse_program(toks) with
      | Err _ -> ""
      | Ok prog ->
          match prog with
          | ast.Program decls _ ->
              match decls with
              | [] -> ""
              | [d | _] ->
                  match d with
                  | ast.FnDecl name _ _ _ _ _ _ -> name
                  | _ -> ""

fn first_is_type_decl(src: String) -> Bool =
  match lexer.tokenize(src) with
  | Err _ -> false
  | Ok toks ->
      match parser.parse_program(toks) with
      | Err _ -> false
      | Ok prog ->
          match prog with
          | ast.Program decls _ ->
              match decls with
              | [] -> false
              | [d | _] ->
                  match d with
                  | ast.TypeDecl _ _ _ _ _ _ -> true
                  | _ -> false

fn first_typedecl_deriving(src: String) -> List String =
  match lexer.tokenize(src) with
  | Err _ -> Nil
  | Ok toks ->
      match parser.parse_program(toks) with
      | Err _ -> Nil
      | Ok prog ->
          match prog with
          | ast.Program decls _ ->
              match decls with
              | [] -> Nil
              | [d | _] ->
                  match d with
                  | ast.TypeDecl _ _ _ deriving_classes _ _ -> deriving_classes
                  | _ -> Nil

# True when the first decl is a `type linear ...` (multiplicity recorded as Linear).
# This is the test that would catch a Linear->Unrestricted drop-the-bit regression:
# it asserts the multiplicity the parser actually stored on the TypeDecl, not just
# that the marker parsed. See docs/linear-types-m4-scoping-2026-08-01.md (M4.1).
fn first_typedecl_is_linear(src: String) -> Bool =
  match lexer.tokenize(src) with
  | Err _ -> false
  | Ok toks ->
      match parser.parse_program(toks) with
      | Err _ -> false
      | Ok prog ->
          match prog with
          | ast.Program decls _ ->
              match decls with
              | [] -> false
              | [d | _] ->
                  match d with
                  | ast.TypeDecl _ _ _ _ mult _ -> mult_is_linear(mult)
                  | ast.RecordDecl _ _ _ _ mult _ -> mult_is_linear(mult)
                  | _ -> false

fn mult_is_linear(m: ast.Multiplicity) -> Bool =
  match m with
  | ast.Linear -> true
  | ast.Unrestricted -> false

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # Well-formed programs
    assert_true(state, "simple fn parses", parse_ok("fn val() -> Int = 42"))
    assert_true(state, "fn with one param", parse_ok("fn id(x: Int) -> Int = x"))
    assert_true(state, "fn with two params", parse_ok("fn add(a: Int, b: Int) -> Int = a + b"))
    assert_true(state, "type decl parses", parse_ok("type Color = Red | Green | Blue"))
    assert_true(state, "let decl parses", parse_ok("let x = 42"))
    assert_true(state, "match expr parses",
      parse_ok("fn f(x: Int) -> Int = match x with | 0 -> 1 | _ -> 2"))
    assert_true(state, "if then else parses",
      parse_ok("fn f(x: Int) -> Int = if x == 0 then 1 else 2"))
    assert_true(state, "lambda parses",
      parse_ok("fn apply(f: Int -> Int, x: Int) -> Int = f(x)"))
    assert_true(state, "two decls parse",
      parse_ok("fn a() -> Int = 1\nfn b() -> Int = 2"))

    # Malformed programs
    assert_true(state, "bare equals fails", parse_fails("="))
    assert_true(state, "fn without body fails", parse_fails("fn val() -> Int"))
    assert_true(state, "lex error propagates", parse_fails("@"))

    # Structural assertions
    assert_eq(state, "fn name extracted", first_fn_name("fn myFunc() -> Int = 1"), "myFunc")
    assert_eq(state, "fn with params name", first_fn_name("fn add(a: Int, b: Int) -> Int = a + b"), "add")

    assert_eq(state, "single decl count", decl_count("fn val() -> Int = 42"), 1)
    assert_eq(state, "two decls count", decl_count("fn a() -> Int = 1\nfn b() -> Int = 2"), 2)
    assert_eq(state, "empty program count", decl_count(""), 0)

    assert_true(state, "type decl identified", first_is_type_decl("type Color = Red | Green"))
    assert_false(state, "fn decl not type decl", first_is_type_decl("fn val() -> Int = 1"))

    # Linear marker (M4.1): the parser must RECORD the multiplicity, not just skip
    # the token. `type linear` -> Linear; a plain `type` -> Unrestricted.
    assert_true(state, "linear marker recorded", first_typedecl_is_linear("type linear Color = Red | Green"))
    assert_false(state, "unmarked type is unrestricted", first_typedecl_is_linear("type Color = Red | Green"))
    assert_true(state, "linear record recorded", first_typedecl_is_linear("type linear Pos = (x: Int, y: Int)"))
    # Parametric linear type (phantom parameter): `type linear Task a` must record
    # Linear too — the type parameter does not defeat the marker (used by stdlib.task).
    assert_true(state, "parametric linear recorded", first_typedecl_is_linear("type linear Task a = Task Int"))

    # List pattern syntax — desugars to ConstructorPattern "Cons"/"Nil" chains
    # (ast.list_ctor_cons / ast.list_ctor_nil); parse_ok below exercises both
    # the empty-list ("Nil") and non-empty ("Cons") desugar branches.
    assert_true(state, "empty list pattern",
      parse_ok("fn f(xs: List Int) -> Int = match xs with | [] -> 0 | _ -> 1"))
    assert_true(state, "single-element list pattern",
      parse_ok("fn f(xs: List Int) -> Int = match xs with | [x] -> x | _ -> 0"))
    assert_true(state, "two-element list pattern",
      parse_ok("fn f(xs: List Int) -> Int = match xs with | [a, b] -> a | _ -> 0"))
    assert_true(state, "list pattern with tail",
      parse_ok("fn f(xs: List Int) -> Int = match xs with | [h | _] -> h | _ -> 0"))
    assert_true(state, "list pattern with heads and tail",
      parse_ok("fn f(xs: List Int) -> Int = match xs with | [a, b | _] -> a | _ -> 0"))
    assert_true(state, "list pattern string literals",
      parse_ok("fn f(xs: List String) -> String = match xs with | [\"foo\", x] -> x | _ -> \"\""))
    assert_true(state, "list pattern string head with wildcard tail",
      parse_ok("fn f(xs: List String) -> String = match xs with | [\"a\" | _] -> \"yes\" | _ -> \"no\""))
    assert_true(state, "nested list pattern",
      parse_ok("fn f(xs: List (List Int)) -> Int = match xs with | [[a, b], _] -> a | _ -> 0"))
    assert_true(state, "list pattern as constructor arg atom",
      parse_ok("fn f(xs: List Int) -> Int = match xs with | [a, b | rest] -> a | _ -> 0"))
    assert_true(state, "multiple list pattern arms",
      parse_ok("fn f(xs: List Int) -> Int = match xs with | [] -> 0 | [x] -> x | [a, b | _] -> a"))
    assert_true(state, "list pattern with qualified constructor head",
      parse_ok("fn f(xs: List a) -> Bool = match xs with | [Foo.Bar _ _, x | _] -> true | _ -> false"))
    assert_true(state, "list pattern two qualified constructors",
      parse_ok("fn f(xs: List a) -> Bool = match xs with | [Foo.A _ _, Foo.B _ | _] -> true | _ -> false"))

    # ---------------------------------------------------------------------------
    # deriving clause on TypeDecl (Phase 1 of docs/deriving-v1-draft.md)
    # `deriving` is a hard keyword; clause appears between `(..)` and `=`.
    assert_true(state, "type decl with deriving (Eq) parses",
      parse_ok("type Color (..) deriving (Eq) = | Red | Green | Blue"))
    assert_true(state, "type decl with multi-class deriving parses",
      parse_ok("type Color (..) deriving (Eq, ToString, Ord) = | Red | Green"))
    assert_true(state, "deriving works without (..) export marker",
      parse_ok("type Color deriving (Eq) = | Red | Green"))
    assert_true(state, "type decl without deriving still parses (backward compat)",
      parse_ok("type Color = | Red | Green"))
    assert_eq(state, "deriving clause class count (one)",
      list_length(first_typedecl_deriving("type Color (..) deriving (Eq) = | Red")), 1)
    assert_eq(state, "deriving clause class count (three)",
      list_length(first_typedecl_deriving("type T (..) deriving (Eq, Ord, ToString) = | A")), 3)
    assert_eq(state, "no deriving clause yields empty list",
      list_length(first_typedecl_deriving("type Color = | Red | Green")), 0)
    assert_true(state, "deriving () empty class list rejected",
      parse_fails("type Color (..) deriving () = | Red"))
    assert_true(state, "deriving without parens rejected (bare ClassName)",
      parse_fails("type Color (..) deriving Eq = | Red"))
    assert_true(state, "deriving as let-binding identifier rejected (hard keyword)",
      parse_fails("let deriving = 1"))
    assert_true(state, "deriving as fn name rejected (hard keyword)",
      parse_fails("fn deriving() -> Int = 1"))

    # W9/X5: a where-binding with a non-variable (tuple) pattern must carry the
    # pattern's own span, not SourcePos(0,0,0). The whole program is on line 1,
    # so the desugared body's line must be 1 (was 0 before the fix).
    assert_eq(state, "tuple where-pattern body carries a real line",
      first_fn_body_line("fn f() -> Int = a where (a, b) = (1, 2)"), Ok(1))
    # Control: a variable where-pattern already threads its own span.
    assert_eq(state, "variable where-pattern body carries a real line",
      first_fn_body_line("fn g() -> Int = x where x = 5"), Ok(1))

    # Each `let … in` step bails to its own reason — exercise all five so the
    # distinct `else`s are tested, not just decorative.
    assert_eq(state, "bail: lex error",
      first_fn_body_line("@"), Err (LexError))
    assert_eq(state, "bail: parse error",
      first_fn_body_line("fn f() -> Int"), Err (ParseError))
    assert_eq(state, "bail: no declarations",
      first_fn_body_line(""), Err (NoDecls))
    assert_eq(state, "bail: first decl not a fn",
      first_fn_body_line("type Color = Red | Green"), Err (FirstNotFn))
    assert_eq(state, "bail: body not a match",
      first_fn_body_line("fn f() -> Int = 42"), Err (BodyNotMatch))

    # `where` and the equivalent `let … in` must desugar to the SAME node. They are
    # one binding construct with two syntaxes; when they had two desugarings they
    # also typed differently — `where` inferred the binding from the BODY (an
    # applied lambda with an unannotated param, so `where a = 2.5` defaulted to Int
    # and failed), while `let` inferred it from the value. This pins the shared shape
    # so the two cannot silently diverge again.
    assert_eq(state, "where desugars to a match",
      first_fn_body_shape("fn f() -> Int = x where x = 5"), "match")
    assert_eq(state, "let..in desugars to a match",
      first_fn_body_shape("fn f() -> Int =\n  let x = 5\n  in x"), "match")
    assert_eq(state, "where and let..in agree on node shape",
      first_fn_body_shape("fn f() -> Int = x where x = 5"),
      first_fn_body_shape("fn f() -> Int =\n  let x = 5\n  in x"))
    assert_eq(state, "tuple where desugars to a match too",
      first_fn_body_shape("fn f() -> Int = a where (a, b) = (1, 2)"), "match")

    summary(state)
