module main
import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.compiler.ast_to_ir as ast_to_ir
import stdlib.compiler.ir_lowering as ir_lowering
import stdlib.compiler.sprout_ir as sprout_ir
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types
import stdlib.compiler.ast as ast
import stdlib.compiler.source as source
import stdlib.string as string

# A call-site-directed intrinsic referenced as a VALUE. `eprint` and `to_double` have no
# symbol a plain `call @<name>` could reach (`eprint` lowers to @eprint_str through a ptr
# coercion, `to_double` is one instruction), so the generic eta wrapper named nothing and the
# program failed at `opt` or at LINK. synthesize_intrinsic_eta_closure lowers the wrapper BODY
# through the same translator as a direct call, which means the wrapper is only well-defined
# where the argument type is known.
#
# Asserted here rather than only in tests/conformance/run/intrinsic_as_value.spr because
# that fixture can show the program works, not WHICH lowering each wrapper took, and it
# cannot reach the rejection at all (a rejected program emits no stdout to compare).

fn no_pos() -> source.SourcePos = source.SourcePos(index = 0, line = 0, column = 0)

fn string_t() -> types.Type = types.TConst(types.type_id("String"))
fn int_t() -> types.Type = types.TConst(types.type_id("Int"))
fn double_t() -> types.Type = types.TConst(types.type_id("Double"))
fn unit_t() -> types.Type = types.TConst(types.type_id("Unit"))
fn free_t() -> types.Type = types.TVar(types.tyvar_id("a"))

fn io_arrow(param: types.Type) -> types.Type =
  types.TFunc(param, unit_t(), types.EffectIO, types.OwnConsume)

fn pure_arrow(param: types.Type, ret: types.Type) -> types.Type =
  types.TFunc(param, ret, types.EffectPure, types.OwnConsume)

# `fn f() -> ty = name` — the intrinsic `name` in value position, at type `ty`.
fn intrinsic_as_value(name: String, ty: types.Type) -> typed_ast.TypedDecl =
  typed_ast.TFnDecl("f", Nil, Nothing, Nothing, Nil, typed_ast.TVar(name, ty, no_pos()))

fn eprint_as_value(t: types.Type) -> typed_ast.TypedDecl =
  intrinsic_as_value("eprint", io_arrow(t))

fn to_double_as_value(t: types.Type) -> typed_ast.TypedDecl =
  intrinsic_as_value("to_double", pure_arrow(t, double_t()))

fn intrinsic_arities() -> Dict ast_to_ir.FnInfo =
  dict_set("to_double", ast_to_ir.fn_info(1, false),
    dict_set("eprint", ast_to_ir.fn_info(1, false), dict_empty()))

# Lower the decl and hand back the whole emitted text — the wrapper is a LIFTED
# function, so the decl's own body is only the IRMkClosure that references it.
fn lower_all(d: typed_ast.TypedDecl) -> Result String String !{IO} =
  do
    ctr <- ref_new(0)
    lidx <- ref_new(dict_empty())
    etas <- ref_new(dict_empty())
    match ast_to_ir.translate_decl_with_idx(d, ast_to_ir.ProgEnv(
            ctors = dict_empty(), top_level = set_empty(), let_names = set_empty(),
            fn_arities = intrinsic_arities(), lambda_ctr_ref = ctr, lifted_idx_ref = lidx,
            adt_index = dict_empty(), argw = dict_empty(), groups = dict_empty(),
            eta_wrappers_ref = etas)) with
    | Err msg -> Err(msg)
    | Ok maybe ->
        match maybe with
        | Nothing -> Err("expected a translated fn")
        | Just triple ->
            match triple with
            | (f, _idx, lifted) ->
                Ok(list_fold(\ (acc, g) -> acc ++ ir_lowering.lower_fn_with_table(g, dict_empty()),
                             ir_lowering.lower_fn_with_table(f, dict_empty()), lifted))

fn check_lowering(state: TestState, label: String, d: typed_ast.TypedDecl,
                  expect: String, absent: String) -> Unit !{IO} =
  match lower_all(d) with
  | Err msg -> assert_true(state, label ++ ": lowered (got Err: " ++ msg ++ ")", false)
  | Ok text ->
      do
        assert_true(state, label ++ ": wrapper contains " ++ expect, string.contains(text, expect))
        # The bug this replaces: a wrapper body forwarding to the absent symbol.
        assert_true(state, label ++ ": no call to the absent " ++ absent,
          string.contains(text, "call i64 " ++ absent ++ "(") == false)

# A free type variable carries no lowering, and must be REJECTED rather than silently
# lowered at the wrong operand type.
fn check_rejected(state: TestState, label: String, d: typed_ast.TypedDecl, name: String) -> Unit !{IO} =
  match lower_all(d) with
  | Ok _ -> assert_true(state, label ++ ": rejected", false)
  | Err msg ->
      do
        assert_true(state, label ++ ": rejected, naming the intrinsic",
          string.contains(msg, "'" ++ name ++ "' cannot be used as a first-class value"))
        assert_true(state, label ++ ": rejection says what to do instead",
          string.contains(msg, "Wrap it in an ordinary function"))

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    check_lowering(state, "eprint at String", eprint_as_value(string_t()), "@eprint_str", "@eprint")
    check_lowering(state, "to_double at Int", to_double_as_value(int_t()), "sitofp i64", "@to_double")
    check_rejected(state, "eprint at a free tyvar", eprint_as_value(free_t()), "eprint")
    check_rejected(state, "to_double at a free tyvar", to_double_as_value(free_t()), "to_double")
    summary(state)
