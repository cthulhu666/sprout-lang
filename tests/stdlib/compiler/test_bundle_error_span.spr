module main
import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.compiler.compiler as compiler
import stdlib.compiler.source as source
import stdlib.string as string
import stdlib.fs as fs
import stdlib.env as env

# Regression for guideline #5 (errors carry a source location from inception),
# BundleErr edition. A bundle-time failure — here an invalid `deriving` clause —
# must carry the SourcePos of the offending declaration.
#
# Before the fix, BundleErr held a bare String and compile_full folded it into
# DiagError(no_pos(), ...), so the user saw line 0. This asserts the real line
# of the offending `type` declaration (line 1 in the fixture below).

fn first_full_diag(r: compiler.FullResult) -> Maybe compiler.Diagnostic =
  match r with
  | compiler.FullOk _ _ -> Nothing
  | compiler.FullFail diags ->
      match diags with
      | Nil -> Nothing
      | [d | _] -> Just(d)

fn diag_line(d: compiler.Diagnostic) -> Int =
  match d with
  | compiler.DiagError pos _ -> pos.line
  | compiler.DiagWarning pos _ -> pos.line

fn diag_msg(d: compiler.Diagnostic) -> String =
  match d with
  | compiler.DiagError _ msg -> msg
  | compiler.DiagWarning _ msg -> msg

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    match env.get("SPROUT_STDLIB_ROOT") with
    | Nothing -> ()
    | Just stdlib_root ->
        do
          let path = "/tmp/sprout_bundle_error_span_fixture.spr"
          # `Bogus` is not a derivable class; the offending TypeDecl is on line 1.
          fs.write_text(path, "type Color (..) deriving (Bogus) =\n  | Red\n  | Green\n  | Blue\n")
          r <- compiler.compile_full(source.FilePath(path), source.StdlibRoot(stdlib_root))
          assert_true(state, "bad deriving produces FullFail",
            match r with | compiler.FullFail _ -> true | _ -> false)
          assert_true(state, "bundle error message names the unknown class",
            match first_full_diag(r) with
            | Nothing -> false
            | Just d -> string.contains(diag_msg(d), "Bogus"))
          assert_true(state, "bundle error carries the offending decl's line (1, not 0)",
            match first_full_diag(r) with
            | Nothing -> false
            | Just d -> diag_line(d) == 1)
    summary(state)
