module main
import stdlib.test (check_eq, check_true, run_suite)
import stdlib.compiler.analysis_service_driver as svc
import stdlib.string as string

fn empty_session() -> svc.SessionState =
  svc.SessionState(vec_empty(), vec_empty())

fn main() -> Unit !{IO} =
  let s0 = empty_session()
  in let s1 = svc.session_add_line(s0, "import", "import stdlib.string as string")
  in let src1 = svc.rebuild_session_source(s1)
  in let s2 = svc.session_add_line(s1, "declaration", "fn greet() -> String = \"hi\"")
  in let src2 = svc.rebuild_session_source(s2)
  in let src_empty = svc.rebuild_session_source(empty_session())
  in let s_imp = svc.session_add_line(empty_session(), "import", "import stdlib.math as math")
  in let src_imp = svc.rebuild_session_source(s_imp)
  in let s_decl = svc.session_add_line(empty_session(), "declaration", "let x = 42")
  in let src_decl = svc.rebuild_session_source(s_decl)
  in let s_two_imp = svc.session_add_line(
       svc.session_add_line(empty_session(), "import", "import stdlib.string as string"),
       "import", "import stdlib.math as math")
  in let src_two = svc.rebuild_session_source(s_two_imp)
  # Redefining a top-level name replaces the prior declaration instead of
  # appending a duplicate (which would make the rebuilt source emit two
  # `define @app.session.foo` blocks and fail to link).
  in let s_redef = svc.session_add_line(
       svc.session_add_line(empty_session(), "declaration", "fn foo() -> Int = 1"),
       "declaration", "fn foo() -> Int = 2")
  in let src_redef = svc.rebuild_session_source(s_redef)
  # Redefining `foo` must not disturb an unrelated `bar` already in the session.
  in let s_mixed = svc.session_add_line(
       svc.session_add_line(
         svc.session_add_line(empty_session(), "declaration", "fn foo() -> Int = 1"),
         "declaration", "fn bar() -> Int = 9"),
       "declaration", "fn foo() -> Int = 2")
  in let src_mixed = svc.rebuild_session_source(s_mixed)
  in run_suite("session_state", [
    # session_add_line — import kind
    check_true("add import: source contains import line",
      string.contains(src1, "import stdlib.string as string")),

    # session_add_line — declaration kind
    check_true("add decl: source contains import",
      string.contains(src2, "import stdlib.string as string")),
    check_true("add decl: source contains declaration",
      string.contains(src2, "fn greet()")),

    # rebuild_session_source — no imports, no decls → just module header
    check_eq("empty session source is module header only",
      src_empty, "module app.session"),

    # rebuild_session_source — import only, no decls
    check_true("import-only session has module header",
      string.starts_with(src_imp, "module app.session")),
    check_true("import-only session has import line",
      string.contains(src_imp, "import stdlib.math as math")),
    check_true("import-only session has no extra blank decl section",
      string.contains(src_imp, "fn ") == false),

    # session_add_line — wrong kind defaults to declaration bucket
    check_true("declaration-only session contains let binding",
      string.contains(src_decl, "let x = 42")),

    # Multiple imports accumulate
    check_true("two imports: first present", string.contains(src_two, "import stdlib.string")),
    check_true("two imports: second present", string.contains(src_two, "import stdlib.math")),

    # Redefinition replaces by name
    check_true("redef foo: new body kept", string.contains(src_redef, "= 2")),
    check_true("redef foo: old body dropped", string.contains(src_redef, "= 1") == false),

    # Redefinition leaves unrelated decls intact
    check_true("mixed redef: bar preserved", string.contains(src_mixed, "fn bar()")),
    check_true("mixed redef: foo new body kept", string.contains(src_mixed, "= 2")),
    check_true("mixed redef: foo old body dropped", string.contains(src_mixed, "= 1") == false)
  ])
