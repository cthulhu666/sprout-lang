module main
import stdlib.test (check_true, run_suite)
import stdlib.compiler.ast_to_ir as ast_to_ir
import stdlib.compiler.ir_rooting as ir_rooting
import stdlib.compiler.ir_lowering as ir_lowering
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types
import stdlib.compiler.ast as ast
import stdlib.compiler.source as source

# Tier-2 CPR: a `match` whose scrutinee is a direct call to a Maybe-returning
# *Sprout* function (not a C extern) must route to an emitted worker that
# returns { i64, i64 } — NOT the boxed `i64 @mvget` that allocates a `Just`.
# `mvget` mirrors stdlib.mutable.mutvec_get: a thin wrapper whose Maybe escapes
# as a return value, so Tier-1 (direct-extern only) never fires on it.

fn no_pos() -> source.SourcePos = source.SourcePos(0, 0, 0)

fn maybe_int() -> types.Type =
  types.TApp(types.TConst(types.type_id("Maybe")), types.TConst(types.type_id("Int")))

# Maybe declared so Just/Nothing land in the ctor table (prelude does this in
# real compilation; a hand-built TypedProgram must supply it).
fn maybe_decl() -> typed_ast.TypedDecl =
  typed_ast.TPassThrough(
    ast.TypeDecl("Maybe", Cons("a", Nil),
      Cons(ast.TypeConstructor("Just", Cons(ast.TypeName("a"), Nil), Nil, Nil),
        Cons(ast.TypeConstructor("Nothing", Nil, Nil, Nil), Nil)),
      Nil, ast.Unrestricted, no_pos()))

# fn mvget(v, i) = vector_get(v, i)        -- Maybe-returning Sprout wrapper
fn mvget_decl() -> typed_ast.TypedDecl =
  typed_ast.TFnDecl("mvget",
    Cons(ast.Param("v", Nothing), Cons(ast.Param("i", Nothing), Nil)),
    Nothing, Nothing, Nil,
    typed_ast.TCall(
      typed_ast.TVar("vector_get", types.TConst(types.type_id("Int")), no_pos()),
      Cons(typed_ast.TVar("v", types.TConst(types.type_id("Int")), no_pos()),
        Cons(typed_ast.TVar("i", types.TConst(types.type_id("Int")), no_pos()), Nil)),
      maybe_int(), no_pos()))

# fn probe(v, i) =
#   match mvget(v, i) with
#   | Just x  -> x
#   | Nothing -> 0
fn probe_decl() -> typed_ast.TypedDecl =
  typed_ast.TFnDecl("probe",
    Cons(ast.Param("v", Nothing), Cons(ast.Param("i", Nothing), Nil)),
    Nothing, Nothing, Nil,
    typed_ast.TMatch(
      typed_ast.TCall(
        typed_ast.TVar("mvget", types.TConst(types.type_id("Int")), no_pos()),
        Cons(typed_ast.TVar("v", types.TConst(types.type_id("Int")), no_pos()),
          Cons(typed_ast.TVar("i", types.TConst(types.type_id("Int")), no_pos()), Nil)),
        maybe_int(), no_pos()),
      Cons(
        typed_ast.TypedMatchBranch(
          ast.ConstructorPattern("Just", Cons(ast.VarPattern("x", no_pos()), Nil), no_pos()),
          typed_ast.TVar("x", types.TConst(types.type_id("Int")), no_pos())),
        Cons(
          typed_ast.TypedMatchBranch(
            ast.ConstructorPattern("Nothing", Nil, no_pos()),
            typed_ast.TInt(0, types.TConst(types.type_id("Int")), no_pos())),
          Nil)),
      types.TConst(types.type_id("Int")), no_pos()))

fn probe_program() -> typed_ast.TypedProgram =
  typed_ast.TypedProgram(
    Cons(maybe_decl(),
    Cons(mvget_decl(),
    Cons(probe_decl(), Nil))))

fn main() -> Unit !{IO} =
  run_suite("unboxed_maybe_worker",
    match ast_to_ir.translate_program(probe_program()) with
    | Err msg -> [check_true("translate should succeed (got Err: " ++ msg ++ ")", false)]
    | Ok pair ->
        match pair with
        | (ir_prog, idx_map) ->
            let ir = ir_lowering.lower_program(ir_rooting.insert_roots(ir_prog, idx_map))
            in [
              check_true("worker define emitted",
                str_find(ir, "define { i64, i64 } @mvget_worker(") >= 0),
              check_true("match site calls the worker",
                str_find(ir, "call { i64, i64 } @mvget_worker(") >= 0),
              check_true("no boxed mvget call at match site",
                str_find(ir, "call i64 @mvget(") < 0)
            ])
