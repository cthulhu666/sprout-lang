import stdlib.test (check_eq, run_suite)
import stdlib.compiler.source as source

# The cursor walks a String by byte offset while counting codepoints, lines and
# columns. "aé\n€x" is a(0) é(1-2) \n(3) €(4-6) x(7): the byte offset, the
# codepoint index and the column drift apart at every multi-byte char.

let sample: String = "aé\n€x"

fn show(c: source.SourceCursor) -> String =
  let pos = source.source_position(c)
  in `${source.cursor_byte_offset(c)}/${pos.index}/${pos.line}/${pos.column}`

# The cursor after `n` calls to `next`.
fn step(c: source.SourceCursor, n: Int) -> source.SourceCursor =
  if n <= 0 then c
  else match source.next(c) with
  | Nothing -> c
  | Just (_, c2) -> step(c2, n - 1)

fn char_after(n: Int) -> String =
  match source.peek(step(source.cursor_from_string(sample), n)) with
  | Nothing -> "none"
  | Just ch -> char_to_string(ch)

fn at(n: Int) -> String = show(step(source.cursor_from_string(sample), n))

fn not_newline(ch: Char) -> Bool = ch != '\n'

fn main() -> Unit !{IO} =
  run_suite("source_cursor", [
    check_eq("start", at(0), "0/0/1/1"),
    check_eq("after a", at(1), "1/1/1/2"),
    check_eq("after é: 2 bytes, 1 codepoint, 1 column", at(2), "3/2/1/3"),
    check_eq("after newline: line 2, column 1", at(3), "4/3/2/1"),
    check_eq("after €: 3 bytes, 1 codepoint", at(4), "7/4/2/2"),
    check_eq("after x: end of input", at(5), "8/5/2/3"),
    check_eq("next at end changes nothing", at(6), "8/5/2/3"),

    check_eq("peek @0", char_after(0), "a"),
    check_eq("peek @1 is the multi-byte é", char_after(1), "é"),
    check_eq("peek @2 is the newline", char_after(2), "\n"),
    check_eq("peek @3 is the 3-byte €", char_after(3), "€"),
    check_eq("peek @5 at end", char_after(5), "none"),

    check_eq("take_while stops at the newline, past the é",
      show(source.take_while(source.cursor_from_string(sample), not_newline)), "3/2/1/3"),
    check_eq("take_while runs across lines and multi-byte chars to the end",
      show(source.take_while(source.cursor_from_string(sample), \_ -> true)), "8/5/2/3"),
    check_eq("take_while from the middle of a line",
      show(source.take_while(step(source.cursor_from_string(sample), 3), \_ -> true)), "8/5/2/3"),
    check_eq("take_while consuming nothing leaves the cursor",
      show(source.take_while(step(source.cursor_from_string(sample), 3), \ch -> ch == 'x')), "4/3/2/1"),

    check_eq("match_string after a multi-byte char",
      match source.match_string("\n€", step(source.cursor_from_string(sample), 2)) with
      | Nothing -> "no match"
      | Just c -> show(c),
      "7/4/2/2")
  ])
