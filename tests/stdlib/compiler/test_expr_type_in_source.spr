module main

import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.compiler.compiler as compiler
import stdlib.compiler.source as source
import stdlib.compiler.bundler as bundler
import stdlib.string as string
import stdlib.env as env

# THE TYPE OF AN EXPRESSION IN A SOURCE CONTEXT — ONE AUTHORITY.
#
# The expression is typed after the module's declarations, as a question rather than a
# binding. It had two copies in analysis_service_driver (op_type_of_in_source and
# op_eval_expr_in_source), and hover needed a third. Three copies of a mechanism is how the
# module-surface bugs happened, so it lives in one place and all three call it.
#
# Two properties the copies could not have:
#
#   1. PACKAGE ROOTS. The service reaches this through a builtin that talks to a
#      co-process started as `sproutd --analysis-service <stdlib_root>` — a command line
#      with no package roots. Hover routed that way would fail on any project with a
#      dotted non-stdlib import while diagnostics for the same file succeeded.
#   2. THE SCHEME ITSELF. eval_expr_in_source branches on pure vs !{IO} to decide how to
#      print a value, so the core returns the Scheme and rendering is a wrapper over it.
#      A string-only API would have forced eval to keep its own copy.
#
# Failures are an ADT, not a message: the service's error strings and the REPL's :type
# output are observable, so each caller renders its own wording.

fn stdlib_root() -> String !{IO} =
  match env.get("SPROUT_STDLIB_ROOT") with
  | Just root -> root
  | Nothing -> "stdlib"

let package_root: String = "tests/conformance/package_resolution/roots"

fn plain_source() -> String =
  "let answer = 42\n"
    ++ "\n"
    ++ "fn twice(n: Int) -> Int = n * 2\n"

# A declared effect is recorded in two places — on the innermost arrow of the type, and on
# the Scheme — because a zero-parameter function has no arrow to hold one (see
# `types.scheme_effect_suffix`). Only the first survives re-inference, so `boot` is the case
# that loses its effect and `shout` is the case that accidentally keeps it.
fn effectful_source() -> String =
  "fn boot() -> Unit !{IO} = ()\n"
    ++ "\n"
    ++ "fn shout(text: String) -> Unit !{IO} = ()\n"
    ++ "\n"
    ++ "fn pure_boot() -> Int = 1\n"
    ++ "\n"
    ++ "fn ident(x: a) -> a = x\n"

# The entry file's `main`, with and without a `module` header. The bundler names it
# `source.entry_main_name` either way, and a bare `main` must still resolve.
let entry_main_source: String = "fn main() -> Unit !{IO} = ()\n"

fn named_entry_main_source() -> String =
  "module foo\n"
    ++ "\n"
    ++ "fn twice(x: Int) -> Int = x * 2\n"
    ++ "\n"
    ++ "fn main() -> Unit !{IO} = print(twice(1))\n"

# A constrained polymorphic name declared in the source under test, as opposed to one
# imported from the prelude. The two behave differently and both are pinned below.
fn constrained_source() -> String =
  "class MyShow a {\n"
    ++ "  fn myshow(x: a) -> String\n"
    ++ "}\n"
    ++ "\n"
    ++ "fn show_via(x: a) -> String where MyShow a = myshow(x)\n"

# An existential constructor: the only place a generated variable reaches BOTH halves of the
# rendering, since its constraint head is the variable's own name rather than a position.
fn existential_source() -> String =
  "class MyShow a {\n"
    ++ "  fn myshow(x: a) -> String\n"
    ++ "}\n"
    ++ "\n"
    ++ "instance MyShow Int {\n"
    ++ "  fn myshow(x: Int) -> String = \"i\"\n"
    ++ "}\n"
    ++ "\n"
    ++ "type Shown = | Shown (any MyShow)\n"

# A type with no instances, so a dictionary for it can only be missing.
let bare_type_source: String = "type Opaque = Opaque Int\n"

# A linear type, so the expression has a value that must be used exactly once.
fn linear_source() -> String =
  "type linear File = File Int\n"
    ++ "\n"
    ++ "fn release(f: File) -> Int = match f with | File n -> n\n"

fn source_using_package() -> String =
  "import demo.greet (greeting)\n"
    ++ "\n"
    ++ "fn use_it() -> String = greeting()\n"

# Diagnostic has no Eq instance, so `diags != Nil` will not typecheck.
fn reports_diagnostics(r: compiler.ExprSchemeResult) -> Bool =
  match r with
  | compiler.ExprCheckFailed diags ->
      match diags with
      | Nil -> false
      | [_ | _] -> true
  | compiler.ExprSchemeOk _ -> false

fn is_scheme_ok(r: compiler.ExprSchemeResult) -> Bool =
  match r with
  | compiler.ExprSchemeOk _ -> true
  | compiler.ExprCheckFailed _ -> false

# `== false` rather than a prefix `!` on the call: the formatter renders `!f(x)` as
# `! f (x)`, which reads worse than the comparison it replaces.
fn mentions_no_effect(text: String) -> Bool = string.contains(text, "!{") == false

# A `<-` bind strips the Maybe off an effectful function's result, so the Maybe is
# matched at the call instead. "" stands for "no type": a Scheme never renders empty.
fn rendered_type(src: String, expr: String, sr: source.StdlibRoot, roots: List String,
                 cache: bundler.LoadEnv) -> String !{IO} =
  match compiler.type_of_expr_in_source(src, expr, sr, roots, cache) with
  | Nothing -> ""
  | Just text -> text

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    root <- stdlib_root()
    let sr = source.StdlibRoot(root)
    cache <- bundler.new_load_env()

    # --- the rendered form, which is what hover shows ---
    literal <- rendered_type(plain_source(), "42", sr, Nil, cache)
    assert_true(state, "a literal's type is reported", string.contains(literal, "Int"))

    bound <- rendered_type(plain_source(), "answer", sr, Nil, cache)
    assert_true(state, "a name declared in the source has its type reported",
      string.contains(bound, "Int"))

    # A function's type must render as a function, not as its result. Sprout function
    # types are curried, so the arrow is what distinguishes them.
    fn_type <- rendered_type(plain_source(), "twice", sr, Nil, cache)
    assert_true(state, "a function's type renders as a function type, not as its result",
      string.contains(fn_type, "->"))

    # --- the Scheme form, which eval needs ---
    scheme <- compiler.scheme_of_expr_in_source(plain_source(), "answer", sr, Nil, cache)
    assert_true(state, "the Scheme form succeeds on the same expression",
      is_scheme_ok(scheme))

    # --- a declared name reports what it was DECLARED as, effects included ---
    #
    # Hover, the REPL's :type and the analysis service all read this. Before the fix they
    # answered `Unit` for every `main` in the tree: typing the name types a *reference*,
    # and referencing a value is pure, so the Scheme-level effect of a nullary function was
    # lost. The checked env had `Unit !{IO}` under the name's own key the whole time.
    nullary_effect <- rendered_type(effectful_source(), "boot", sr, Nil, cache)
    assert_true(state, "a nullary effectful function reports its effect",
      string.contains(nullary_effect, "!{IO}"))

    entry_main <- rendered_type(entry_main_source, "main", sr, Nil, cache)
    assert_true(state, "a headerless entry's main resolves bare",
      string.contains(entry_main, "!{IO}"))

    named_main <- rendered_type(named_entry_main_source(), "main", sr, Nil, cache)
    assert_true(state, "a named entry's main resolves bare",
      string.contains(named_main, "!{IO}"))

    # The control that says the fix is about the Scheme and not about effects generally:
    # this one already worked, because its effect rides on the arrow inside the type.
    arrow_effect <- rendered_type(effectful_source(), "shout", sr, Nil, cache)
    assert_true(state, "an effectful function with a parameter still reports its effect",
      string.contains(arrow_effect, "!{IO}"))

    # The opposite control. Without it, "always print !{IO}" would satisfy the assertions
    # above, and every pure function would start reading as effectful.
    pure_nullary <- rendered_type(effectful_source(), "pure_boot", sr, Nil, cache)
    assert_true(state, "a pure nullary function reports no effect",
      string.contains(pure_nullary, "Int") && mentions_no_effect(pure_nullary))

    # Preferring the declared scheme must not disturb polymorphism: a type variable stays a
    # type variable rather than being instantiated by typing a reference to it.
    poly <- rendered_type(effectful_source(), "ident", sr, Nil, cache)
    assert_true(state, "a polymorphic name still renders as a function over a variable",
      string.contains(poly, "->") && mentions_no_effect(poly))

    # An expression that is not a bare name has no env entry, so it is typed as a question
    # — and must not acquire an effect on the way.
    call <- rendered_type(effectful_source(), "pure_boot()", sr, Nil, cache)
    assert_true(state, "a call expression is typed as a question",
      string.contains(call, "Int") && mentions_no_effect(call))

    # --- unexported prelude names are not askable ---
    #
    # A private prelude helper is not in scope outside the prelude, so asking its type
    # fails; an exported name beside it still answers.
    private_name <- compiler.scheme_of_expr_in_source(plain_source(), "split_on_char", sr, Nil, cache)
    assert_true(state, "an unexported prelude name has no type outside the prelude",
      reports_diagnostics(private_name))

    exported_name <- compiler.scheme_of_expr_in_source(plain_source(), "list_length", sr, Nil, cache)
    assert_true(state, "an exported prelude name is still typed",
      is_scheme_ok(exported_name))

    # --- a constrained name is a question, not a binding ---
    #
    # `:type minimum` used to be asked as `let __repl_source_value = minimum`: a top-level
    # binding that generalizes a variable it needs an `Ord` dictionary for.
    # `infer.let_dict_ambiguity_msg` rejects exactly that, and is right to for a module —
    # the binding is one slot holding one closure, so the instance picked at definition is
    # the one every use gets. Here it described a binding nobody wrote, and made every
    # constrained prelude name (`minimum`, `maximum`, `min_by`) unaskable.
    prelude_constrained <- rendered_type(plain_source(), "minimum", sr, Nil, cache)
    assert_true(state, "a constrained prelude name is typed, not rejected as a binding",
      string.contains(prelude_constrained, "->"))

    # The constraint is the reason the type has variables it cannot resolve, so an answer
    # that drops it is not the type of anything: `a b -> Maybe b` is a higher-kinded
    # application with nothing to explain it.
    assert_true(state, "a constrained prelude name reports its constraints",
      string.contains(prelude_constrained, "where ")
        && string.contains(prelude_constrained, "Ord"))

    # A constrained name declared in the SAME source always typed — every probe that
    # reproduces the rejection references a name from another module (the prelude). So
    # this is a control for the recovery above: the path that already worked must keep
    # working, and must not start reporting through the fallback.
    constrained <- rendered_type(constrained_source(), "show_via", sr, Nil, cache)
    assert_true(state, "a same-file constrained name is still typed",
      string.contains(constrained, "->"))

    # Its constraint was dropped from the answer just the same, so it is the red case for
    # the rendering even though it was never the red case for the rejection.
    #
    # The class name is matched WITHOUT its module prefix: a name declared in the buffer
    # under test renders qualified (`$entry.MyShow`, or `app.session.MyShow` in the REPL),
    # which the type body already does too — `make_box` renders as `a -> $entry.Box a`
    # today, no constraint involved. Pinning the prefix here would pin a separate,
    # pre-existing display defect as if it were intended.
    assert_true(state, "a constrained name reports the constraint that makes it one",
      string.contains(constrained, "where ") && string.contains(constrained, "MyShow a"))

    # --- a class method is constrained by its own class ---
    #
    # Its Scheme carries no constraint list, so `fmap` rendered with nothing explaining its
    # higher-kinded head.
    method <- rendered_type(plain_source(), "fmap", sr, Nil, cache)
    assert_true(state, "a class method reports the class that constrains its variable",
      string.contains(method, "where ") && string.contains(method, "Functor f"))

    # The prelude writes `fn fmap(f: a -> b, xs: f a) -> f b`, and that is what hover shows.
    # Renaming by binder position printed `(b -> c) -> a b -> a c where Functor a`, because
    # a method's class parameter is prepended to its binders and so always landed on `a`.
    assert_true(state, "a class method's variables read as the class declares them",
      string.contains(method, "(a -> b) -> f a -> f b"))

    # A free function over the same class is written with its own letters and keeps them, so
    # the two now differ only where the source does.
    free_fn <- rendered_type(plain_source(), "map", sr, Nil, cache)
    assert_true(state, "a free function keeps the variables its signature declares",
      string.contains(free_fn, "(a -> b) -> c a -> c b")
        && string.contains(free_fn, "Functor c"))

    # --- a constructor names the type's parameters, not its own argument order ---
    #
    # `type Result e a = Ok a | Err e`. Binders come from the TYPE declaration, so position
    # ordering lettered one constructor's payload `b` and the other's `a`, and `Result a b`
    # meant something different on each line.
    ok_ctor <- rendered_type(plain_source(), "Ok", sr, Nil, cache)
    assert_true(state, "a constructor reports the type parameters as declared",
      string.contains(ok_ctor, "a -> Result e a"))

    err_ctor <- rendered_type(plain_source(), "Err", sr, Nil, cache)
    assert_true(state, "a sibling constructor agrees on what those parameters are called",
      string.contains(err_ctor, "e -> Result e a"))

    # `parser.build_any_field` names this variable, not the author, so it is renamed like any
    # other generated one — and the clause must follow, since its head is that same name.
    exist_ctor <- rendered_type(existential_source(), "Shown", sr, Nil, cache)
    assert_true(state, "an existential constructor renames the variable the parser minted",
      string.contains(exist_ctor, "existv") == false)

    assert_true(state, "its constraint names the variable its type shows",
      string.contains(exist_ctor, "a -> ") && string.contains(exist_ctor, "MyShow a"))

    # A buffer-declared class: its method is `$entry.myshow`, looked up through a bare
    # alias of its env entry and its `@class:` marker, so hover must follow both.
    own_method <- rendered_type(constrained_source(), "myshow", sr, Nil, cache)
    assert_true(state, "a class method declared in the same source reports its class",
      string.contains(own_method, "where ") && string.contains(own_method, "MyShow a"))

    # Negative control: "attach a clause to any name found in the env" passes both
    # assertions above and fails here.
    unconstrained <- rendered_type(plain_source(), "twice", sr, Nil, cache)
    assert_true(state, "an unconstrained function reports no constraints",
      string.contains(unconstrained, "where ") == false)

    # The recovery is for a NAME. An ill-typed expression has no env entry to fall back
    # on, so its diagnostics survive — without this control, "answer from the env on any
    # failure" would look identical and would swallow every real type error.
    ill_typed <- rendered_type(plain_source(), "twice(true)", sr, Nil, cache)
    assert_true(state, "an ill-typed expression still fails", ill_typed == "")

    # --- failures are distinguishable, so each caller can word its own message ---
    unknown <- compiler.scheme_of_expr_in_source(plain_source(), "nope", sr, Nil, cache)
    assert_true(state, "an unknown name reports the typecheck diagnostics",
      reports_diagnostics(unknown))

    unknown_rendered <- rendered_type(plain_source(), "nope", sr, Nil, cache)
    assert_true(state, "the rendered form answers Nothing on a failure",
      unknown_rendered == "")

    # --- a question is not a binding ---
    #
    # Nothing is bound by asking, so no rule about what a top-level `let` may hold applies.
    # A linear value cannot sit in a module binding, since every function could use it; asked
    # about, it is just a value of its type.
    linear <- rendered_type(linear_source(), "File(1)", sr, Nil, cache)
    assert_true(state, "a linear expression is typed, not rejected as a module binding",
      string.contains(linear, "File"))

    # The value restriction refuses to generalize a non-value binding, because one slot read
    # at two types is unsound. A question has no slot.
    non_value <- rendered_type(plain_source(), "list_reverse(Nil)", sr, Nil, cache)
    assert_true(state, "a polymorphic non-value expression is typed, not value-restricted",
      string.contains(non_value, "List "))

    # Sprout does not infer `where` clauses, so an expression whose dictionary depends on a
    # type it leaves open has no type to report. Answering without the constraint would state
    # a type the expression does not have.
    open_dict <- rendered_type(plain_source(), "\\xs -> minimum(xs)", sr, Nil, cache)
    assert_true(state, "an expression needing an undetermined dictionary is not typed",
      open_dict == "")

    # The same for a class method at a type the expression leaves open: no dictionary
    # argument marks these, so only the dispatch verifier sees them.
    open_method <- rendered_type(plain_source(), "\\x -> to_string(x)", sr, Nil, cache)
    assert_true(state, "a class method at an open type is not typed", open_method == "")
    open_eq <- rendered_type(plain_source(), "\\x -> x == x", sr, Nil, cache)
    assert_true(state, "an operator method at an open type is not typed", open_eq == "")
    open_pure <- rendered_type(plain_source(), "pure(1)", sr, Nil, cache)
    assert_true(state, "a method dispatched on its return type alone is not typed", open_pure == "")
    open_user <- rendered_type(existential_source(), "\\x -> myshow(x)", sr, Nil, cache)
    assert_true(state, "a user class method at an open type is not typed", open_user == "")
    # The expression's effect is part of its type; eval reads it to run an action rather
    # than print it.
    action <- rendered_type(plain_source(), "print(\"hi\")", sr, Nil, cache)
    assert_true(state, "an effectful expression's type carries its effect", action == "Unit !{IO}")
    closed_method <- rendered_type(plain_source(), "\\(x: Int) -> to_string(x)", sr, Nil, cache)
    assert_true(state, "a class method at a concrete type is typed",
      string.contains(closed_method, "Int -> String"))

    # The expression is parsed as an expression. Appended to the source as text, a line break
    # in it ended the binding and the rest was read as declarations.
    trailing <- rendered_type(plain_source(), "1\nfn sneaky() -> Int = 2", sr, Nil, cache)
    assert_true(state, "declarations after the expression are rejected", trailing == "")

    # The refusals that stay. A skolem has no name outside its match branch.
    skolem <- rendered_type(existential_source(), "match Shown(1) with | Shown x -> x", sr, Nil, cache)
    assert_true(state, "an unpacked existential is not the type of the expression", skolem == "")

    # The instance for a list exists; its context, ToString of the element, does not. Only the
    # dictionary pass sees that, so without it this answered String.
    context <- rendered_type(bare_type_source, "to_string([Opaque(1)])", sr, Nil, cache)
    assert_true(state, "a missing instance in an instance's context is reported", context == "")

    # Type names in the expression are resolved in the buffer's scope, and an unknown one is
    # refused rather than becoming a fresh opaque type.
    unknown_type <- rendered_type(plain_source(), "\\(x: Nope) -> x", sr, Nil, cache)
    assert_true(state, "an unknown type in the expression is refused", unknown_type == "")

    # No name is reserved: the source may declare any name, including the one the question
    # used to be bound to.
    reserved <- rendered_type("let __repl_source_value = 1\n", "42", sr, Nil, cache)
    assert_true(state, "a source may bind any name without colliding with the question",
      string.contains(reserved, "Int"))

    # --- package roots reach it: the property the builtin route cannot have ---
    let roots = Cons(package_root, Nil)
    with_roots <- rendered_type(source_using_package(), "use_it", sr, roots, cache)
    assert_true(state, "an expression using a package-root import is typed when the root is given",
      string.contains(with_roots, "String"))

    # Negative control: without the root it must fail. A pass here would mean the default
    # search path had been widened, which is a worse bug than the one being fixed.
    cache2 <- bundler.new_load_env()
    without_roots <- rendered_type(source_using_package(), "use_it", sr, Nil, cache2)
    assert_true(state, "the same expression is untyped with no root registered",
      without_roots == "")

    summary(state)
