module main
import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.compiler.ir_lowering as ir_lowering
import stdlib.compiler.sprout_ir as sprout_ir
import stdlib.string as string

# Tests for the lower_fn_with_table export added in the streaming-codegen prep.
# lower_fn_with_table(f, fn_table) must produce the same LLVM IR fragment as
# lower_program would emit for a single-function program (minus header/globals).

let make_trivial_fn =
  sprout_ir.IRFunction(
    "my_test_fn",
    Nil,
    "i64",
    Cons(sprout_ir.IRBlock("entry", Cons(sprout_ir.IRConst("%r", 42), Cons(sprout_ir.IRRet("%r"), Nil))), Nil)
  )

# A self-tail-recursive `tco_fn(p)` lowered as an alloca-slot loop: entry
# allocas the param slot and branches to tco_loop; the loop header re-loads the
# slot; the back-edge stores a new value and branches back. Exercises the
# IRTcoEntry / IRTcoLoad / IRTcoBack lowering. `loop_ops` go before the back-edge.
fn make_tco_fn(loop_ops: List sprout_ir.IROp) -> sprout_ir.IRFunction =
  sprout_ir.IRFunction(
    "tco_fn",
    Cons(("p$in", sprout_ir.IRTScalar), Nil),
    "i64",
    Cons(sprout_ir.IRBlock("entry",
           Cons(sprout_ir.IRTcoEntry(Cons(("%p.slot", "i64", sprout_ir.param_ssa("p$in")), Nil), "%sp"),
           Cons(sprout_ir.IRBr("tco_loop"), Nil))),
    Cons(sprout_ir.IRBlock("tco_loop",
           Cons(sprout_ir.IRTcoLoad(sprout_ir.param_ssa("p"), "i64", "%p.slot", sprout_ir.IRTScalar),
           loop_ops ++ [sprout_ir.IRTcoBack(Cons(("%p.slot", "i64", sprout_ir.param_ssa("p")), Nil), "%sp", "tco_loop")])),
    Nil)))

# Three string constants over two blocks, collected from index 5.  The walk
# gathers its text as reversed parts and joins once, so a missed reverse would
# emit the globals backwards; this pins order, numbering and the table.
let str_blocks =
  Cons(sprout_ir.IRBlock("entry",
         Cons(sprout_ir.IRStrConst("%a", "%a_raw", "x"),
         Cons(sprout_ir.IRStrConst("%b", "%b_raw", "yy"),
         Cons(sprout_ir.IRBr("next"), Nil)))),
  Cons(sprout_ir.IRBlock("next",
         Cons(sprout_ir.IRStrConst("%c", "%c_raw", "zzz"),
         Cons(sprout_ir.IRRet("%c"), Nil))),
  Nil))

fn global_text(idx: Int, s: String) -> String =
  match ir_lowering.emit_str_global(idx, s) with
  | (decl, _, _) -> decl

fn str_body(s: String) -> String =
  "c\"" ++ s ++ "\\00\" }\n"

fn escape_ok(raw: String, encoded: String, len: Int) -> Bool =
  global_text(3, raw) ==
    "@.str.3 = private unnamed_addr constant { i64, [" ++ int_to_string(len) ++ " x i8] } { i64 "
      ++ int_to_string(10 + (len - 1) * 16384) ++ ", [" ++ int_to_string(len) ++ " x i8] "
      ++ str_body(encoded)

let ctor_regs =
  Cons(sprout_ir.CtorReg("Foo", 7, 2, "ip"),
  Cons(sprout_ir.CtorReg("Ba\"r", 8, 0, ""),
  Cons(sprout_ir.CtorReg("Baz", 9, 1, "s"), Nil)))

let let_globals =
  Cons(sprout_ir.IRGlobalDecl("a", "i64", sprout_ir.GlobalConst("5")),
  Cons(sprout_ir.IRGlobalDecl("b", "i64", sprout_ir.GlobalZeroInit), Nil))

fn table_names(raw: String, table: Dict (String, Int), gname: String, len: Int) -> Bool =
  match dict_get(raw, table) with
  | Just (g, l) -> g == gname && l == len
  | Nothing -> false

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    let f = make_trivial_fn
    let fn_table = dict_empty()
    let ir = ir_lowering.lower_fn_with_table(f, fn_table)

    assert_true(state, "lower_fn_with_table output starts with define",
      str_starts_with(ir, "define "))
    assert_true(state, "lower_fn_with_table output starts with expected header",
      str_starts_with(ir, "define i64 @my_test_fn()"))

    let tco_ir = ir_lowering.lower_fn_with_table(make_tco_fn(Nil), dict_empty())
    assert_true(state, "tco define renames param to <p>$in",
      string.contains(tco_ir, "define i64 @tco_fn(i64 %p$p$in)"))
    assert_true(state, "tco entry allocas the param slot",
      string.contains(tco_ir, "%p.slot = alloca i64"))
    assert_true(state, "tco entry stores the incoming param into the slot",
      string.contains(tco_ir, "store i64 %p$p$in, ptr %p.slot"))
    # The save/restore pair frees an iteration's root slots; with none it is
    # dropped, since LLVM treats stackrestore as a write and stops hoisting loads.
    assert_true(state, "tco entry without root slots does not stacksave",
      string.contains(tco_ir, "@llvm.stacksave") == false)
    assert_true(state, "tco loop header reloads the slot",
      string.contains(tco_ir, "%p$p = load i64, ptr %p.slot"))
    assert_true(state, "tco back-edge stores the new value",
      string.contains(tco_ir, "store i64 %p$p, ptr %p.slot"))
    assert_true(state, "tco back-edge without root slots does not stackrestore",
      string.contains(tco_ir, "@llvm.stackrestore") == false)
    assert_true(state, "tco back-edge branches to the loop header",
      string.contains(tco_ir, "br label %tco_loop"))
    let rooted_ir = ir_lowering.lower_fn_with_table(
      make_tco_fn([sprout_ir.IRRoot("%r.slot", sprout_ir.param_ssa("p"), "%r.d")]), dict_empty())
    assert_true(state, "tco entry with a root slot stacksaves",
      string.contains(rooted_ir, "%sp = call ptr @llvm.stacksave()"))
    assert_true(state, "tco back-edge with a root slot stackrestores",
      string.contains(rooted_ir, "call void @llvm.stackrestore(ptr %sp)\n  br label %tco_loop"))

    match ir_lowering.walk_blocks_for_strs(str_blocks, 5, dict_empty()) with
    | (text, next_idx, table) ->
        do
          assert_true(state, "string globals come out in document order, numbered from 5",
            text == global_text(5, "x") ++ global_text(6, "yy") ++ global_text(7, "zzz"))
          assert_true(state, "the walk returns the next free string index",
            next_idx == 8)
          assert_true(state, "the table maps each raw name to its global and byte length",
            table_names("%a_raw", table, "@.str.5", 2) && table_names("%c_raw", table, "@.str.7", 4))

    assert_true(state, "backslash is escaped", escape_ok("\\", "\\5C", 2))
    assert_true(state, "quote is escaped", escape_ok("\"", "\\22", 2))
    assert_true(state, "newline is escaped", escape_ok("\n", "\\0A", 2))
    assert_true(state, "carriage return is escaped", escape_ok("\r", "\\0D", 2))
    assert_true(state, "tab is escaped", escape_ok("\t", "\\09", 2))
    assert_true(state, "adjacent escapes", escape_ok("\\\"\n\r\t", "\\5C\\22\\0A\\0D\\09", 6))
    assert_true(state, "escape first and last", escape_ok("\nab\"", "\\0Aab\\22", 5))
    assert_true(state, "empty string is just the NUL", escape_ok("", "", 1))
    assert_true(state, "plain text is copied", escape_ok("hello world", "hello world", 12))
    assert_true(state, "non-ASCII stays raw bytes", escape_ok("é", "é", 3))
    assert_true(state, "mix of ASCII, escapes and non-ASCII",
      escape_ok("aé\"b\\ü\nz", "aé\\22b\\5Cü\\0Az", 11))

    assert_true(state, "ctor globals: name and fkinds per reg, in order",
      ir_lowering.collect_ctor_globals(ctor_regs) ==
        "@.cname.7 = private unnamed_addr constant [4 x i8] c\"Foo\\00\"\n"
        ++ "@.cfkinds.7 = private unnamed_addr constant [3 x i8] c\"ip\\00\"\n"
        ++ "@.cname.8 = private unnamed_addr constant [5 x i8] c\"Ba\\22r\\00\"\n"
        ++ "@.cfkinds.8 = private unnamed_addr constant [1 x i8] c\"\\00\"\n"
        ++ "@.cname.9 = private unnamed_addr constant [4 x i8] c\"Baz\\00\"\n"
        ++ "@.cfkinds.9 = private unnamed_addr constant [2 x i8] c\"s\\00\"\n")
    assert_true(state, "ctor globals: no regs is empty",
      ir_lowering.collect_ctor_globals(Nil) == "")

    let shim = ir_lowering.main_shim(ctor_regs, false, false, false)
    assert_true(state, "main_shim: ctor registrations in order, then ret",
      string.contains(shim, "%creg_7 = call i64 @sprout_register_ctor(i64 7, ptr %cname_ptr_7, i64 2, ptr %cfkinds_ptr_7)\n  %cname_ptr_8")
        && string.contains(shim, "%creg_8 = call i64 @sprout_register_ctor(i64 8, ptr %cname_ptr_8, i64 0, ptr %cfkinds_ptr_8)\n  %cname_ptr_9")
        && string.ends_with(shim, "ptr %cfkinds_ptr_9)\n  ret i32 0\n}\n"))
    assert_true(state, "main_shim: no regs has no registrations",
      ! string.contains (ir_lowering.main_shim(Nil, false, false, false), "sprout_register_ctor"))

    assert_true(state, "lower_globals: one line per global, in order",
      ir_lowering.lower_globals(let_globals) ==
        "@a = private constant i64 5\n@b = global i64 zeroinitializer\n")
    assert_true(state, "lower_globals: empty", ir_lowering.lower_globals(Nil) == "")

    summary(state)
