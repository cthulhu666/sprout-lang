module main
import stdlib.test (TestState, new_state, assert_eq, assert_true, summary)
import stdlib.compiler.types as types

# G6: the opaque TypeId API centralizes every operation on a type's canonical
# identity, so no consumer does raw string surgery on it (after_last_dot,
# replace_all, uppercase-first-char, ...). Identity keeps the dotted name; display
# and symbol derive from it; concreteness reads the LAST segment (a qualified
# concrete type starts with a lowercase module component).
fn main() -> Unit !{IO} =
  do
    state <- new_state()
    # equality is exact on the canonical (dotted) name
    assert_true(state, "eq same", types.type_id_eq(types.type_id("main.Maybe"), types.type_id("main.Maybe")))
    assert_true(state, "neq cross-module",
      types.type_id_eq(types.type_id("main.Maybe"), types.type_id("Maybe")) == false)
    # display shows the short name
    assert_eq(state, "display strips module", types.type_id_display(types.type_id("main.Maybe")), "Maybe")
    assert_eq(state, "display bare", types.type_id_display(types.type_id("Int")), "Int")
    # concreteness reads the last segment's case
    assert_true(state, "qualified concrete is concrete", types.type_id_is_concrete(types.type_id("main.Maybe")))
    assert_true(state, "bare concrete is concrete", types.type_id_is_concrete(types.type_id("Int")))
    assert_true(state, "lowercase tyvar not concrete", types.type_id_is_concrete(types.type_id("a")) == false)
    # symbol mangling sanitizes dots for LLVM
    assert_eq(state, "symbol dots to underscores", types.type_id_symbol(types.type_id("main.Maybe")), "main_Maybe")
    assert_eq(state, "symbol bare unchanged", types.type_id_symbol(types.type_id("Int")), "Int")
    summary(state)
