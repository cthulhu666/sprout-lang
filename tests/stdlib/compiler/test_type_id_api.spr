module main
import stdlib.test (check_eq, check_true, run_suite)
import stdlib.compiler.types as types

# G6: the opaque TypeId API centralizes every operation on a type's canonical
# identity, so no consumer does raw string surgery on it (after_last_dot,
# replace_all, uppercase-first-char, ...). Identity keeps the dotted name; display
# and symbol derive from it; concreteness reads the LAST segment (a qualified
# concrete type starts with a lowercase module component).
fn main() -> Unit !{IO} =
  run_suite("type_id_api", [
    # equality is exact on the canonical (dotted) name
    check_true("eq same", types.type_id_eq(types.type_id("main.Maybe"), types.type_id("main.Maybe"))),
    check_true("neq cross-module",
      types.type_id_eq(types.type_id("main.Maybe"), types.type_id("Maybe")) == false),
    # display shows the short name
    check_eq("display strips module", types.type_id_display(types.type_id("main.Maybe")), "Maybe"),
    check_eq("display bare", types.type_id_display(types.type_id("Int")), "Int"),
    # concreteness reads the last segment's case
    check_true("qualified concrete is concrete", types.type_id_is_concrete(types.type_id("main.Maybe"))),
    check_true("bare concrete is concrete", types.type_id_is_concrete(types.type_id("Int"))),
    check_true("lowercase tyvar not concrete", types.type_id_is_concrete(types.type_id("a")) == false),
    # symbol mangling sanitizes dots for LLVM
    check_eq("symbol dots to underscores", types.type_id_symbol(types.type_id("main.Maybe")), "main_Maybe"),
    check_eq("symbol bare unchanged", types.type_id_symbol(types.type_id("Int")), "Int"),
    # round-trip: mint then read back the raw canonical name
    check_eq("round-trip name", types.type_id_name(types.type_id("stdlib.compiler.types.Type")), "stdlib.compiler.types.Type")
  ])
