# Regression: `fn main() -> Int !{IO}` must propagate its returned value as
# the process exit code. main_shim (ir_lowering.sprout) used to discard
# __sprout_user_main's result and unconditionally `ret i32 0`, so every
# compiled Sprout program exited 0 regardless of what `main` computed —
# silently breaking any tool (e.g. fmt_driver.sprout's `fmt --check`) that
# relies on a nonzero exit code to signal failure.
#
# This test compiles a real fixture through the actual compiler (not
# hand-written IR), links it, runs it, and asserts the OS-level exit code.
# Unfixed: exit code 0 -> RED. Fixed: exit code 7 -> GREEN.
import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.process as process
import stdlib.terminal as terminal
import stdlib.fs as fs
import testsupport.toolchain (clang_available, is_darwin)

let fixture_source: String =
  "module main_int_exit_fixture\n\nfn main() -> Int !{IO} =\n  do\n    print(\"fixture running\")\n    7\n"

let runtime_sources: List String =
  ["runtime/sprout_poll.c", "runtime/sprout_runtime.c", "runtime/sprout_scheduler.c"]

fn link_argv(ll_path: String, bin_path: String, use_darwin: Bool) -> List String =
  let base = [ll_path] ++ runtime_sources ++ ["-o", bin_path]
      extra = if use_darwin then ["-framework", "Security", "-framework", "CoreFoundation"] else []
  in ["clang"] ++ base ++ extra

# The emitted IR is ASCII in practice, but the decode can fail in principle and writing a fallback
# string would surface as a baffling LINK error rather than a clear one — so the failure is named
# here. Folding the decode and the write into one Bool also keeps the caller a level FLATTER than the
# two nested matches it replaces.
fn write_emitted_ir(ll_path: String, compiled: process.ProcResult) -> Bool !{IO} =
  match process.proc_stdout_text(compiled) with
  | Err _ -> false
  | Ok ir_text ->
      match fs.write_text(ll_path, ir_text) with
      | Err _ -> false
      | Ok _ -> true

# Runs `argv`. A child that could not run records a failed assertion named `label` and yields Nothing.
fn run_any(state: TestState, label: String, argv: List String) -> Maybe process.ProcResult !{IO} =
  match process.proc_run(argv) with
  | Ok r -> Just(r)
  | Err e ->
      do
        terminal.write("[test_main_int_exit_code] " ++ label ++ ": " ++ process.proc_error_message(e) ++ "\n")
        assert_true(state, label, false)
        Nothing

# Like `run_any`, but a non-zero exit also records the failure and shows the child's stderr.
fn run_step(state: TestState, label: String, argv: List String) -> Maybe process.ProcResult !{IO} =
  match run_any(state, label, argv) with
  | Nothing -> Nothing
  | Just r ->
      if process.proc_ok(r) then Just(r)
      else
        do
          terminal.write("[test_main_int_exit_code] " ++ label ++ " failed:\n")
          terminal.write(process.proc_stderr_or(r, "<stderr was not valid UTF-8>"))
          terminal.write("\n")
          assert_true(state, label, false)
          Nothing

# Compiles and links the fixture. Nothing means a step failed and has been recorded.
fn build_fixture(state: TestState, src_path: String, ll_path: String, bin_path: String, use_darwin: Bool) -> Maybe Unit !{IO} =
  do
    compiled <- run_step(state, "fixture compiles", ["build/compile_driver_bin_stage1", "--emit-ir", "stdlib", src_path])
    wrote <- write_emitted_ir(ll_path, compiled)
    if wrote then
      do
        _ <- run_step(state, "fixture links", link_argv(ll_path, bin_path, use_darwin))
        Just(())
    else
      do
        assert_true(state, "write emitted IR", false)
        Nothing

fn exited_with(r: process.ProcResult, code: Int) -> Bool =
  match process.proc_exit(r) with
  | process.Exited n -> n == code
  | process.Signaled _ -> false

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    have_clang <- clang_available()
    match have_clang with
    | false ->
        do
          terminal.write("[test_main_int_exit_code] clang not in PATH — assertion auto-passes\n")
          assert_true(state, "Int-returning main propagates exit code (auto-skipped: no clang)", true)
    | true ->
        do
          let src_path = "/tmp/sprout_main_int_exit_fixture.sprout"
          let ll_path = "/tmp/sprout_main_int_exit_fixture.ll"
          let bin_path = "/tmp/sprout_main_int_exit_fixture_bin"
          use_darwin <- is_darwin()
          match fs.write_text(src_path, fixture_source) with
          | Err _ -> assert_true(state, "write fixture source", false)
          | Ok _ ->
              match build_fixture(state, src_path, ll_path, bin_path, use_darwin) with
              | Nothing -> ()
              | Just _ ->
                  match run_any(state, "fixture runs", [bin_path]) with
                  | Nothing -> ()
                  | Just ran ->
                      assert_true(state, "Int-returning main's return value becomes the process exit code",
                        exited_with(ran, 7))

    summary(state)
