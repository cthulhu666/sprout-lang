import stdlib.test (TestState, new_state, assert_eq, assert_true, assert_false, summary)
import stdlib.compiler.lexer as lexer
import stdlib.compiler.parser as parser
import stdlib.compiler.checker as checker
import stdlib.compiler.lowering as lowering
import stdlib.compiler.codegen as codegen
import stdlib.compiler.typed_ast as typed_ast

# Full pipeline: lex → parse → typecheck → lower → emit IR.
# lower_program preserves types, so no second typecheck pass is needed.
fn run_codegen(src: String) -> codegen.IrResult !{IO} =
  match lexer.tokenize(src) with
  | Err _ -> codegen.IrErr("lex error")
  | Ok toks ->
      match parser.parse_program(toks) with
      | Err _ -> codegen.IrErr("parse error")
      | Ok prog ->
          do
            tc <- checker.typecheck_typed(prog, Nil)
            match tc with
            | typed_ast.TypedErr msg -> codegen.IrErr("check: " ++ msg)
            | typed_ast.TypedOk typed_prog env ->
                match lowering.lower_program(typed_prog, env) with
                | lowering.LowerErr msg -> codegen.IrErr("lower: " ++ msg)
                | lowering.LowerOk typed_lowered ->
                    codegen.compile_to_ir(typed_lowered, env)

fn ir_contains(ir: String, sub: String) -> Bool =
  str_find(ir, sub) != -1

fn codegen_ok(src: String) -> Bool !{IO} =
  do
    r <- run_codegen(src)
    match r with
    | codegen.IrOk _ -> true
    | codegen.IrErr _ -> false

fn get_ir(src: String) -> String !{IO} =
  do
    r <- run_codegen(src)
    match r with
    | codegen.IrOk ir -> ir
    | codegen.IrErr msg -> "ERROR: " ++ msg

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # Pipeline succeeds for well-typed programs
    ok1 <- codegen_ok("fn val() -> Int = 42")
    assert_true(state, "int fn compiles to IR", ok1)

    ok2 <- codegen_ok("fn id(x: Int) -> Int = x")
    assert_true(state, "one-param fn compiles to IR", ok2)

    ok3 <- codegen_ok("fn always_true() -> Bool = true")
    assert_true(state, "bool fn compiles to IR", ok3)

    ok4 <- codegen_ok("fn greeting() -> String = \"hello\"")
    assert_true(state, "string fn compiles to IR", ok4)

    ok5 <- codegen_ok("fn add(a: Int, b: Int) -> Int = a + b")
    assert_true(state, "two-param fn compiles to IR", ok5)

    # Structural IR markers — Int return uses i64
    ir1 <- get_ir("fn val() -> Int = 42")
    assert_true(state, "int fn emits @val", ir_contains(ir1, "@val"))
    assert_true(state, "int fn emits define", ir_contains(ir1, "define"))
    assert_true(state, "int fn returns i64 42", ir_contains(ir1, "ret i64 42"))

    # Bool return uses i1 (not i64)
    ir2 <- get_ir("fn always_true() -> Bool = true")
    assert_true(state, "bool fn has i1 type", ir_contains(ir2, "i1"))

    # String return uses i64 (GC Option C — strings are i64 raw pointer)
    ir3 <- get_ir("fn greeting() -> String = \"hello\"")
    assert_true(state, "string return is i64 (GC Option C)", ir_contains(ir3, "define i64 @greeting"))

    # Conditional generates a branch instruction
    ir4 <- get_ir("fn cond(x: Int) -> Int = if x == 0 then 1 else 2")
    assert_true(state, "if/then/else emits br", ir_contains(ir4, "br "))

    # Error propagation
    err1 <- codegen_ok("@invalid")
    assert_false(state, "lex error fails codegen", err1)

    err2 <- codegen_ok("fn val() -> Bool = 42")
    assert_false(state, "type error fails codegen", err2)

    # CPR (Constructed Product Result) unboxing — Chunk 1: declare lines for _unboxed variants
    # A Maybe-returning extern should produce a `declare { i64, i64 } @name_unboxed(...)` line
    # in the emitted IR header so the unboxed fast path can be called without a forward-ref error.
    let cpr_src = "type Maybe a = Nothing | Just a\nextern fn vector_get(v: Vec Int, idx: Int) -> Maybe Int\nfn get_or_default(v: Vec Int, i: Int) -> Int = match vector_get(v, i) with | Just x -> x | Nothing -> -1"
    cpr_ir <- get_ir(cpr_src)
    assert_true(state, "CPR: Maybe-returning extern emits declare for _unboxed variant", ir_contains(cpr_ir, "declare { i64, i64 } @vector_get_unboxed"))

    # CPR — Chunk 2: extractvalue replaces sprout_field in match-on-call pattern
    assert_true(state, "CPR: match-on-call uses extractvalue for field access", ir_contains(cpr_ir, "extractvalue { i64, i64 }"))
    assert_true(state, "CPR: match-on-call uses extractvalue for tag access", ir_contains(cpr_ir, "extractvalue { i64, i64 }"))

    # FnSig arity invariant: constrained functions have hidden dict args not in their scheme type.
    # build_fn_sigs_acc must fall back to all-i64 when extracted param count < actual param count.
    # This verifies the function compiles to IR without a codegen arity mismatch crash.
    let constrained_src = "class Eq a { fn eq(x: a, y: a) -> Bool }\ninstance Eq Int { fn eq(x: Int, y: Int) -> Bool = x == y }\nfn same(x: a, y: a) -> Bool where Eq a = eq(x, y)"
    constrained_ir <- get_ir(constrained_src)
    assert_true(state, "constrained fn compiles to IR (FnSig arity invariant)", ir_contains(constrained_ir, "define"))

    # build_fn_sigs_acc invariant: tuple-typed params must preserve their struct IR type.
    # If the count-mismatch guard fires unconditionally, (Int, Bool) collapses to i64
    # and LLVM rejects the IR at link time (phi type mismatch). This pins that invariant.
    let swap_src = "fn swap(pair: (Int, Bool)) -> (Bool, Int) = match pair with | (x, b) -> (b, x)"
    swap_ir <- get_ir(swap_src)
    assert_true(state, "tuple param (Int,Bool) emits struct type { i64, i1 } not i64 blob", ir_contains(swap_ir, "{ i64, i1 }"))

    # GC root skipping for scalar types (Int, Bool, Char).
    # Int args to function calls must NOT emit sprout_gc_push_i64_root.
    # Only heap-allocated args (Vec, ADT handles, etc.) should be rooted.
    # This pins the optimization that avoids ~50% wasted push/pop pairs.
    let int_call_src = "extern fn uses_ints(a: Int, b: Int) -> Int\nfn call_with_ints(x: Int, y: Int) -> Int = uses_ints(x, y)"
    int_call_ir <- get_ir(int_call_src)
    assert_false(state, "Int args to call must NOT emit gc_push_i64_root", ir_contains(int_call_ir, "call i64 @sprout_gc_push_i64_root"))

    # A Vec (heap) arg MUST still be rooted
    let vec_call_src = "extern fn uses_vec(v: Vec Int) -> Int\nextern fn make_v() -> Vec Int\nfn call_with_vec() -> Int = uses_vec(make_v())"
    vec_call_ir <- get_ir(vec_call_src)
    assert_true(state, "Vec arg to call MUST emit gc_push_i64_root", ir_contains(vec_call_ir, "call i64 @sprout_gc_push_i64_root"))

    # Mixed: only the Vec arg should be rooted, not the Int
    let mixed_call_src = "extern fn mixed(n: Int, v: Vec Int) -> Int\nextern fn make_v2() -> Vec Int\nfn call_mixed(x: Int) -> Int = mixed(x, make_v2())"
    mixed_call_ir <- get_ir(mixed_call_src)
    assert_true(state, "mixed call: Vec arg rooted", ir_contains(mixed_call_ir, "call i64 @sprout_gc_push_i64_root"))

    summary(state)
