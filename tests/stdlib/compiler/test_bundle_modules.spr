module main
import stdlib.test (TestState, new_state, assert_true, assert_eq, summary)
import stdlib.compiler.bundler as bundler
import stdlib.compiler.ast as ast
import stdlib.compiler.source as source
import stdlib.fs as fs
import stdlib.env as env

# BundleOk's modules are what infer checks one at a time (a class is checked at
# its module's start, an instance registered there), so each must be one module:
# the prelude's first and the entry's last, with deriving's instances in their module.

fn bundled_modules(src: String, path: String, stdlib_root: String) -> Maybe (List (List ast.Decl)) !{IO} =
  do
    fs.write_text(path, src)
    r <- bundler.bundle_file(source.FilePath(path), source.StdlibRoot(stdlib_root))
    match r with
    | bundler.BundleErr _ _ -> Nothing
    | bundler.BundleOk modules -> Just(modules)

fn last_size(modules: List (List ast.Decl)) -> Maybe Int =
  match list_reverse(modules) with
  | [decls | _] -> Just(list_length(decls))
  | [] -> Nothing

fn check_modules(state: TestState, modules: List (List ast.Decl)) -> Unit !{IO} =
  do
    assert_true(state, "the prelude, json and the entry are separate modules", list_length(modules) >= 3)
    assert_eq(state, "the entry's type, derived instance and main are its module", Just(3), last_size(modules))

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    match env.get_or_panic("SPROUT_STDLIB_ROOT") with
    | Nothing ->
        assert_true(state, "SPROUT_STDLIB_ROOT is set (the suite cannot bundle without it)", false)
    | Just stdlib_root ->
        do
          match bundled_modules(
            "import stdlib.json as json\n\ntype Coin (..) deriving (Eq) =\n  | Heads\n  | Tails\n\nfn main() -> Unit !{IO} = print(to_string(Heads == Tails))\n",
            "/tmp/sprout_bundle_modules.spr", stdlib_root) with
          | Nothing -> assert_true(state, "the file bundles", false)
          | Just modules -> check_modules(state, modules)
    summary(state)
