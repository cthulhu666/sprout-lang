import stdlib.test (TestState, new_state, assert_eq, summary)
import stdlib.compiler.ast as ast
import stdlib.compiler.typed_ast as typed_ast

# The instance dispatch key lowering and resolve both build: the bare class, then the
# head constructor of each argument, kept module-qualified so it matches infer's @inst.

fn name(n: String) -> ast.TypeExpr = ast.TypeName(n)

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    assert_eq(state, "a bare head", typed_ast.constraint_key_str("Show", [name("Int")]), "Show_Int")
    assert_eq(state, "an applied type keys by its head",
      typed_ast.constraint_key_str("Show", [ast.TypeApply(name("List"), name("a"))]), "Show_List")
    assert_eq(state, "a tuple keys by its arity",
      typed_ast.constraint_key_str("Eq", [ast.TupleType([name("Int"), name("Bool")])]), "Eq_Tuple2")
    assert_eq(state, "an arrow keys as Fn",
      typed_ast.constraint_key_str("C", [ast.TypeArrow(name("Int"), name("Int"), Nothing, ast.ModeDefault)]),
      "C_Fn")
    assert_eq(state, "a thunk keys as Fn",
      typed_ast.constraint_key_str("C", [ast.TypeThunk(name("Int"), Nothing)]), "C_Fn")
    assert_eq(state, "an effect type keys as Eff",
      typed_ast.constraint_key_str("C", [ast.TypeEffect(name("Int"), ["IO"])]), "C_Eff")
    assert_eq(state, "each argument adds its head",
      typed_ast.constraint_key_str("Convert", [name("Int"), name("String")]), "Convert_Int_String")
    assert_eq(state, "no arguments is the class alone", typed_ast.constraint_key_str("C", []), "C")

    assert_eq(state, "the class is stripped, the head stays qualified",
      typed_ast.constraint_key_from_tc(ast.TypeConstraint("prelude.Eq", [name("stdlib.x.Bar")])),
      "Eq_stdlib.x.Bar")
    assert_eq(state, "head name of a nested application",
      typed_ast.type_expr_head_name(ast.TypeApply(ast.TypeApply(name("Dict"), name("k")), name("v"))),
      "Dict")

    # type_expr_head: the same head, and none for a function or effect type.
    assert_eq(state, "head of a nested application",
      head_or_none(ast.TypeApply(ast.TypeApply(name("Dict"), name("k")), name("v"))), "Dict")
    assert_eq(state, "head of a tuple is its arity",
      head_or_none(ast.TupleType([name("Int"), name("Bool"), name("Char")])), "Tuple3")
    assert_eq(state, "an arrow has no head",
      head_or_none(ast.TypeArrow(name("Int"), name("Int"), Nothing, ast.ModeDefault)), "<none>")
    assert_eq(state, "a thunk has no head", head_or_none(ast.TypeThunk(name("Int"), Nothing)), "<none>")
    assert_eq(state, "an effect type has no head", head_or_none(ast.TypeEffect(name("Int"), ["IO"])), "<none>")

    summary(state)

fn head_or_none(te: ast.TypeExpr) -> String = maybe_with_default("<none>", typed_ast.type_expr_head(te))
