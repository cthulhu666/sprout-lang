module main
import stdlib.test (check_eq, run_suite)

# Regression guard for module-qualified type identity across the dispatch paths the
# original T7 tests missed (code-review finding 1,
# docs/archive/type-identity-review-findings-2026-07-10.md): instance dispatch on a MODULE-LOCAL
# concrete type (canonical id "main.Box") via
#   (a) a constrained function's concrete argument (concrete_typeexpr / TDict-head path), and
#   (b) return-position dispatch (find_inst_in_return_type / type_to_typeexpr path).
# Both build a dispatch TDict head from the concrete type; if that head strips the module
# prefix ("Box") while @inst/ctx_inst register the full name ("main.Box"), dispatch misses.

# (Also guards the TConst-TypeId migration of ast_to_ir consumers merged from master
# during the PR #156 rebase — type_head_name and the Unit placeholders.)
type Box a = MkBox a

instance ToString (Box a)
  fn to_string(m: Box a) -> String = "BOX"

# (a) constrained-function concrete-argument dispatch
fn describe(x: a) -> String where ToString a =
  to_string(x)

type Cell = MkCell Int

class Zero a
  fn zero() -> a

instance Zero Cell
  fn zero() -> Cell = MkCell(7)

fn cell_val(c: Cell) -> Int =
  match c with
  | MkCell n -> n

# (b) return-position dispatch: zero()'s instance is chosen by the return type main.Cell
fn get_zero() -> Cell =
  zero()

fn main() -> Unit !{IO} =
  run_suite("type_identity_dispatch_paths", [
    check_eq("constrained-fn dispatch on module-local type", describe(MkBox(1)), "BOX"),
    check_eq("return-type dispatch on module-local type", cell_val(get_zero()), 7)
  ])
