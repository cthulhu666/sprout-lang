module main

import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.repl as repl
import stdlib.env as env
import stdlib.process as process
import stdlib.string as string

# THE REPL'S MODULE-NAME COMPLETION LIST MUST NOT ROT.
#
# `repl.stdlib_module_completion_names` is a literal, because the language has no
# directory-listing primitive and shelling out per keypress would cost a subprocess
# and silently offer nothing on the Windows port. A literal that nothing checks,
# though, goes stale invisibly: it was missing 15 of 30 modules — `json`, `time`,
# `fs`, `rng`, `regex`, `task`, `chan` and every module added since it was written,
# `bits` included.
#
# So the staleness is caught here instead, at a place where a subprocess is free.
# This is the whole reason the literal is acceptable.

fn stdlib_root() -> String !{IO} =
  match env.get_or_panic("SPROUT_STDLIB_ROOT") with
  | Just root -> root
  | Nothing -> "stdlib"

# Module leaves on disk, minus `prelude` (always in scope, never imported by name).
# `sh -c` because proc_run is argv-based and does not expand the glob itself.
fn modules_on_disk(root: String) -> List String !{IO} =
  do
    result <- process.proc_run(["sh", "-c", "ls " ++ root ++ "/*.sprout"])
    leaves_of_lines(string.string_lines(process.proc_stdout_or(result, "")), 0, root ++ "/", Nil)

fn leaves_of_lines(lines: Vec String, index: Int, prefix: String, acc: List String) -> List String =
  match vec_get(index, lines) with
  | Nothing -> list_reverse(acc)
  | Just line ->
      let leaf = leaf_of_path(string.trim(line), prefix)
      in if leaf == "" || leaf == "prelude" then leaves_of_lines(lines, index + 1, prefix, acc)
         else leaves_of_lines(lines, index + 1, prefix, Cons(leaf, acc))

fn leaf_of_path(path: String, prefix: String) -> String =
  if string.starts_with(path, prefix)
  then strip_suffix(string.slice(path, string.length(prefix),
    string.length(path) - string.length(prefix)), ".sprout")
  else ""

fn strip_suffix(raw: String, suffix: String) -> String =
  if string.ends_with(raw, suffix)
  then string.slice(raw, 0, string.length(raw) - string.length(suffix))
  else raw

fn missing_from_list(disk: List String, offered_names: Vec String) -> List String =
  list_filter(\leaf -> !member(leaf, offered_names), disk)

# Offered names with no `<root>/<name>.sprout`: modules that were removed or renamed.
fn stale_in_list(offered_names: Vec String, disk: List String) -> List String =
  list_filter(\name -> !member(name, disk), vec_to_list(offered_names))

fn report_missing(state: TestState, missing: List String) -> Unit !{IO} =
  match missing with
  | Nil -> ()
  | Cons name rest ->
      do
        assert_true(state, "module `" ++ name ++ "` is offered for completion", false)
        report_missing(state, rest)

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    root <- stdlib_root()
    disk <- modules_on_disk(root)
    let offered_names = repl.stdlib_module_completion_names()

    # If `ls` produced nothing the check is vacuous, and a vacuous pass is the trap
    # this file exists to avoid — so say so out loud.
    assert_true(state, "the module enumeration found something to check",
      list_length(disk) > 10)

    assert_true(state, "every stdlib module on disk is offered for completion",
      list_length(missing_from_list(disk, offered_names)) == 0)
    # Name each straggler, so a failure says WHICH module to add.
    report_missing(state, missing_from_list(disk, offered_names))

    # The other direction: every offered name is a module on disk. Name each stale one.
    let stale = stale_in_list(offered_names, disk)
    assert_true(state, "every offered module exists on disk", list_length(stale) == 0)
    list_each(\name -> assert_true(state, "offered module `" ++ name ++ "` exists on disk", false),
      stale)

    # Spot checks.
    assert_true(state, "`bits` is offered", member("bits", offered_names))
    assert_true(state, "a module that does not exist is not offered",
      member("no_such_module", offered_names) == false)

    summary(state)
