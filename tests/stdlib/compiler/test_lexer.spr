import stdlib.test (TestState, new_state, assert_eq, assert_true, assert_false, summary)
import stdlib.compiler.lexer as lexer
import stdlib.compiler.token as token
import stdlib.collections (Vec, vec_get)

fn kind_str(t: token.Token) -> String =
  match token.token_kind(t) with
  | token.TokenIdentKind -> "ident"
  | token.TokenKeywordKind -> "keyword"
  | token.TokenIntKind -> "int"
  | token.TokenFloatKind -> "float"
  | token.TokenCharKind -> "char"
  | token.TokenStringKind -> "string"
  | token.TokenSymbolKind -> "symbol"
  | token.TokenEofKind -> "eof"
  | token.TokenTemplateStart -> "template_start"
  | token.TokenTemplateLit -> "template_lit"
  | token.TokenTemplateInterpStart -> "template_interp_start"
  | token.TokenTemplateInterpEnd -> "template_interp_end"
  | token.TokenTemplateEnd -> "template_end"

fn tok_kind_at(src: String, n: Int) -> String =
  match lexer.tokenize(src) with
  | Err _ -> "lex_error"
  | Ok toks ->
      match vec_get(n, toks) with
      | Nothing -> "missing"
      | Just t -> kind_str(t)

fn tok_text_at(src: String, n: Int) -> String =
  match lexer.tokenize(src) with
  | Err _ -> "lex_error"
  | Ok toks ->
      match vec_get(n, toks) with
      | Nothing -> "missing"
      | Just t -> token.token_text(t)

fn lex_ok(src: String) -> Bool =
  match lexer.tokenize(src) with
  | Ok _ -> true
  | Err _ -> false

fn token_count(src: String) -> Int =
  match lexer.tokenize(src) with
  | Err _ -> -1
  | Ok toks -> vec_length(toks)

# Build a string of n backtick template literals "`x` " to stress the
# tokenize_from ↔ scan_template_from mutual recursion cycle.
fn make_templates(n: Int, acc: List String) -> String =
  if n <= 0 then string_concat_many(list_reverse(acc))
  else make_templates(n - 1, Cons("`x` ", acc))

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # Keywords
    assert_eq(state, "fn kind", tok_kind_at("fn", 0), "keyword")
    assert_eq(state, "fn text", tok_text_at("fn", 0), "fn")
    assert_eq(state, "type keyword", tok_kind_at("type", 0), "keyword")
    assert_eq(state, "match keyword", tok_kind_at("match", 0), "keyword")
    assert_eq(state, "true keyword", tok_kind_at("true", 0), "keyword")
    assert_eq(state, "false keyword", tok_kind_at("false", 0), "keyword")
    assert_eq(state, "if keyword", tok_kind_at("if", 0), "keyword")
    assert_eq(state, "do keyword", tok_kind_at("do", 0), "keyword")
    assert_eq(state, "where keyword", tok_kind_at("where", 0), "keyword")
    assert_eq(state, "let keyword", tok_kind_at("let", 0), "keyword")

    # Identifiers
    assert_eq(state, "ident kind", tok_kind_at("main", 0), "ident")
    assert_eq(state, "ident text", tok_text_at("main", 0), "main")
    assert_eq(state, "ident underscore", tok_kind_at("my_var", 0), "ident")

    # Integer literals
    assert_eq(state, "int kind", tok_kind_at("42", 0), "int")
    assert_eq(state, "int text", tok_text_at("42", 0), "42")
    assert_eq(state, "zero int", tok_kind_at("0", 0), "int")

    # Float literals (Double feature) — `digits.digits` lexes as one float token
    assert_eq(state, "float kind", tok_kind_at("3.14", 0), "float")
    assert_eq(state, "float text", tok_text_at("3.14", 0), "3.14")
    assert_eq(state, "float leading-zero kind", tok_kind_at("0.5", 0), "float")
    # A range `1..5` must NOT be eaten as a float: `.` needs a digit after it
    assert_eq(state, "range first token stays int", tok_kind_at("1..5", 0), "int")
    assert_eq(state, "range first int text", tok_text_at("1..5", 0), "1")

    # String literals
    assert_eq(state, "string kind", tok_kind_at("\"hello\"", 0), "string")
    assert_eq(state, "string text", tok_text_at("\"hello\"", 0), "hello")
    assert_eq(state, "empty string kind", tok_kind_at("\"\"", 0), "string")
    assert_eq(state, "empty string text", tok_text_at("\"\"", 0), "")

    # Char literals
    assert_eq(state, "char kind", tok_kind_at("'a'", 0), "char")
    assert_eq(state, "char text", tok_text_at("'a'", 0), "a")

    # Symbols
    assert_eq(state, "arrow kind", tok_kind_at("->", 0), "symbol")
    assert_eq(state, "arrow text", tok_text_at("->", 0), "->")
    assert_eq(state, "equals kind", tok_kind_at("=", 0), "symbol")
    assert_eq(state, "double equals kind", tok_kind_at("==", 0), "symbol")
    assert_eq(state, "pipe kind", tok_kind_at("|", 0), "symbol")
    assert_eq(state, "colon kind", tok_kind_at(":", 0), "symbol")
    assert_eq(state, "backslash kind", tok_kind_at("\\", 0), "symbol")

    # Two-token sequence
    assert_eq(state, "fn main first kind", tok_kind_at("fn main", 0), "keyword")
    assert_eq(state, "fn main second kind", tok_kind_at("fn main", 1), "ident")
    assert_eq(state, "fn main second text", tok_text_at("fn main", 1), "main")

    # EOF on empty input
    assert_eq(state, "empty string eof", tok_kind_at("", 0), "eof")

    # Comments are skipped
    assert_eq(state, "comment skipped kind", tok_kind_at("# a comment\nfoo", 0), "ident")
    assert_eq(state, "comment skipped text", tok_text_at("# a comment\nfoo", 0), "foo")

    # Error case
    assert_false(state, "at-sign is lex error", lex_ok("@"))

    # Template literal: tokens and content ordering
    # Token layout for `hello`: [template_start, template_lit, template_end, eof]
    assert_eq(state, "template start kind", tok_kind_at("`hello`", 0), "template_start")
    assert_eq(state, "template lit kind", tok_kind_at("`hello`", 1), "template_lit")
    assert_eq(state, "template lit text correct order", tok_text_at("`hello`", 1), "hello")
    assert_eq(state, "template end kind", tok_kind_at("`hello`", 2), "template_end")

    # Template with escape sequence — ensures escape decoding preserves order
    assert_eq(state, "template escape text", tok_text_at("`a\\nb`", 1), "a\nb")

    # String escape sequence — ensures escape decoding preserves order
    assert_eq(state, "string escape text", tok_text_at("\"a\\nb\"", 0), "a\nb")

    # Mutual-recursion stress: tokenize_from ↔ scan_template_from cycle.
    # N simple templates produce 3N + 1 tokens (start, lit, end per template, plus eof).
    assert_eq(state, "200 templates token count", token_count(make_templates(200, Nil)), 601)

    summary(state)
