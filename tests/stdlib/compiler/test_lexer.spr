import stdlib.test (check_eq, check_true, check_false, run_suite)
import stdlib.compiler.lexer as lexer
import stdlib.compiler.token as token

fn kind_str(t: token.Token) -> String =
  match token.token_kind(t) with
  | token.TokenIdentKind -> "ident"
  | token.TokenKeywordKind -> "keyword"
  | token.TokenIntKind -> "int"
  | token.TokenFloatKind -> "float"
  | token.TokenCharKind -> "char"
  | token.TokenStringKind -> "string"
  | token.TokenSymbolKind -> "symbol"
  | token.TokenEofKind -> "eof"
  | token.TokenTemplateStart -> "template_start"
  | token.TokenTemplateLit -> "template_lit"
  | token.TokenTemplateInterpStart -> "template_interp_start"
  | token.TokenTemplateInterpEnd -> "template_interp_end"
  | token.TokenTemplateEnd -> "template_end"

fn tok_kind_at(src: String, n: Int) -> String =
  match lexer.tokenize(src) with
  | Err _ -> "lex_error"
  | Ok toks ->
      match vec_get(n, toks) with
      | Nothing -> "missing"
      | Just t -> kind_str(t)

fn tok_text_at(src: String, n: Int) -> String =
  match lexer.tokenize(src) with
  | Err _ -> "lex_error"
  | Ok toks ->
      match vec_get(n, toks) with
      | Nothing -> "missing"
      | Just t -> token.token_text(t)

fn lex_ok(src: String) -> Bool =
  match lexer.tokenize(src) with
  | Ok _ -> true
  | Err _ -> false

fn token_count(src: String) -> Int =
  match lexer.tokenize(src) with
  | Err _ -> -1
  | Ok toks -> vec_length(toks)

# Build a string of n backtick template literals "`x` " to stress the
# tokenize_from ↔ scan_template_from mutual recursion cycle.
fn make_templates(n: Int, acc: List String) -> String =
  if n <= 0 then string_concat_many(list_reverse(acc))
  else make_templates(n - 1, Cons("`x` ", acc))

fn main() -> Unit !{IO} =
  run_suite("lexer", [
    # Keywords
    check_eq("fn kind", tok_kind_at("fn", 0), "keyword"),
    check_eq("fn text", tok_text_at("fn", 0), "fn"),
    check_eq("type keyword", tok_kind_at("type", 0), "keyword"),
    check_eq("match keyword", tok_kind_at("match", 0), "keyword"),
    check_eq("true keyword", tok_kind_at("true", 0), "keyword"),
    check_eq("false keyword", tok_kind_at("false", 0), "keyword"),
    check_eq("if keyword", tok_kind_at("if", 0), "keyword"),
    check_eq("do keyword", tok_kind_at("do", 0), "keyword"),
    check_eq("where keyword", tok_kind_at("where", 0), "keyword"),
    check_eq("let keyword", tok_kind_at("let", 0), "keyword"),

    # Identifiers
    check_eq("ident kind", tok_kind_at("main", 0), "ident"),
    check_eq("ident text", tok_text_at("main", 0), "main"),
    check_eq("ident underscore", tok_kind_at("my_var", 0), "ident"),

    # Integer literals
    check_eq("int kind", tok_kind_at("42", 0), "int"),
    check_eq("int text", tok_text_at("42", 0), "42"),
    check_eq("zero int", tok_kind_at("0", 0), "int"),

    # Float literals (Double feature) — `digits.digits` lexes as one float token
    check_eq("float kind", tok_kind_at("3.14", 0), "float"),
    check_eq("float text", tok_text_at("3.14", 0), "3.14"),
    check_eq("float leading-zero kind", tok_kind_at("0.5", 0), "float"),
    # A range `1..5` must NOT be eaten as a float: `.` needs a digit after it
    check_eq("range first token stays int", tok_kind_at("1..5", 0), "int"),
    check_eq("range first int text", tok_text_at("1..5", 0), "1"),

    # Dotted identifiers: `.` is an ident-CONTINUE character, so a qualified
    # name or a Scope-A field path is ONE token.
    check_eq("qualified name is one token", tok_text_at("string.trim", 0), "string.trim"),
    check_eq("qualified name token count", token_count("string.trim"), 2),
    check_eq("deep path is one token", tok_text_at("a.b.c", 0), "a.b.c"),
    # A TRAILING dot rides on the identifier — parse_var_or_ctor relies on it to
    # report `exists a.` as a missing field name rather than as two expressions.
    check_eq("trailing dot rides on ident", tok_text_at("exists a.", 1), "a."),
    check_eq("trailing dot before ')'", tok_text_at("f(a.)", 2), "a."),

    # `..` TERMINATES an identifier run, so an identifier-bounded range needs no
    # spaces: `lo..hi` is three tokens, not one dotted ident.  Regression guard —
    # `take_while(is_ident_continue)` used to swallow the operator, and the range
    # then reached the checker as a field read (`Cannot infer the record type of
    # `.hi``).  BACKLOG P1, 2026-08-19.
    check_eq("ident range: left endpoint", tok_text_at("lo..hi", 0), "lo"),
    check_eq("ident range: operator", tok_text_at("lo..hi", 1), ".."),
    check_eq("ident range: right endpoint", tok_text_at("lo..hi", 2), "hi"),
    check_eq("ident range token count", token_count("lo..hi"), 4),
    check_eq("ident range operator kind", tok_kind_at("lo..hi", 1), "symbol"),
    # Digit on the right is the same shape (the right endpoint is not an ident).
    check_eq("ident..int: left endpoint", tok_text_at("lo..5", 0), "lo"),
    check_eq("ident..int: operator", tok_text_at("lo..5", 1), ".."),
    check_eq("ident..int: right endpoint kind", tok_kind_at("lo..5", 2), "int"),
    # A field path on both sides: only the `..` stops the run, not the field dots.
    check_eq("field-path range: left endpoint", tok_text_at("p.x..p.y", 0), "p.x"),
    check_eq("field-path range: operator", tok_text_at("p.x..p.y", 1), ".."),
    check_eq("field-path range: right endpoint", tok_text_at("p.x..p.y", 2), "p.y"),
    # `${...}` bodies are scanned by scan_interp_body, which reuses the same
    # identifier scanner — so a range splits there too (tokens: `, ${, lo, .., hi).
    check_eq("range inside a template interpolation: left endpoint",
      tok_text_at("`${lo..hi}`", 2), "lo"),
    check_eq("range inside a template interpolation: operator",
      tok_text_at("`${lo..hi}`", 3), ".."),
    check_eq("range inside a template interpolation: right endpoint",
      tok_text_at("`${lo..hi}`", 4), "hi"),

    # String literals
    check_eq("string kind", tok_kind_at("\"hello\"", 0), "string"),
    check_eq("string text", tok_text_at("\"hello\"", 0), "hello"),
    check_eq("empty string kind", tok_kind_at("\"\"", 0), "string"),
    check_eq("empty string text", tok_text_at("\"\"", 0), ""),

    # Char literals
    check_eq("char kind", tok_kind_at("'a'", 0), "char"),
    check_eq("char text", tok_text_at("'a'", 0), "a"),

    # Symbols
    check_eq("arrow kind", tok_kind_at("->", 0), "symbol"),
    check_eq("arrow text", tok_text_at("->", 0), "->"),
    check_eq("equals kind", tok_kind_at("=", 0), "symbol"),
    check_eq("double equals kind", tok_kind_at("==", 0), "symbol"),
    check_eq("pipe kind", tok_kind_at("|", 0), "symbol"),
    check_eq("colon kind", tok_kind_at(":", 0), "symbol"),
    check_eq("backslash kind", tok_kind_at("\\", 0), "symbol"),

    # Two-token sequence
    check_eq("fn main first kind", tok_kind_at("fn main", 0), "keyword"),
    check_eq("fn main second kind", tok_kind_at("fn main", 1), "ident"),
    check_eq("fn main second text", tok_text_at("fn main", 1), "main"),

    # EOF on empty input
    check_eq("empty string eof", tok_kind_at("", 0), "eof"),

    # Comments are skipped
    check_eq("comment skipped kind", tok_kind_at("# a comment\nfoo", 0), "ident"),
    check_eq("comment skipped text", tok_text_at("# a comment\nfoo", 0), "foo"),

    # Error case
    check_false("at-sign is lex error", lex_ok("@")),

    # Template literal: tokens and content ordering
    # Token layout for `hello`: [template_start, template_lit, template_end, eof]
    check_eq("template start kind", tok_kind_at("`hello`", 0), "template_start"),
    check_eq("template lit kind", tok_kind_at("`hello`", 1), "template_lit"),
    check_eq("template lit text correct order", tok_text_at("`hello`", 1), "hello"),
    check_eq("template end kind", tok_kind_at("`hello`", 2), "template_end"),

    # Template with escape sequence — ensures escape decoding preserves order
    check_eq("template escape text", tok_text_at("`a\\nb`", 1), "a\nb"),

    # W9/X1+X2: template escapes must match spec §5.7 (only \` \${ \n \t \\).
    # An unrecognised escape used to silently pass through as the raw char
    # (\r -> "r", \0 -> "0"); it must now be a clean tokenize error, matching
    # how string/char literals already reject \0.
    check_false("template \\r rejected (not a spec escape)", lex_ok("`a\\rb`")),
    check_false("template \\0 rejected (as in string literals)", lex_ok("`a\\0b`")),
    check_false("template unknown escape \\z rejected", lex_ok("`a\\zb`")),
    # Controls: the five spec-sanctioned escapes stay valid.
    check_true("template \\n \\t \\\\ still valid", lex_ok("`x\\ny\\tz\\\\w`")),

    # String escape sequence — ensures escape decoding preserves order
    check_eq("string escape text", tok_text_at("\"a\\nb\"", 0), "a\nb"),

    # Mutual-recursion stress: tokenize_from ↔ scan_template_from cycle.
    # N simple templates produce 3N + 1 tokens (start, lit, end per template, plus eof).
    check_eq("200 templates token count", token_count(make_templates(200, Nil)), 601)
  ])
