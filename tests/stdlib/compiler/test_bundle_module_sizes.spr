module main
import stdlib.test (TestState, new_state, assert_true, assert_eq, summary)
import stdlib.compiler.bundler as bundler
import stdlib.compiler.ast as ast
import stdlib.compiler.checker as checker
import stdlib.compiler.source as source
import stdlib.compiler.typed_ast as typed_ast
import stdlib.fs as fs
import stdlib.env as env
import stdlib.string as string

# BundleOk's module sizes are what infer splits the program by (a class is checked
# at its module's start), so they must cover every declaration, the prelude's
# first and the entry's last, with deriving's instances counted in their module.

# The bundle's module sizes and declaration count, or Nothing when it fails.
fn sizes_and_count(src: String, path: String, stdlib_root: String) -> Maybe (List Int, Int) !{IO} =
  do
    fs.write_text(path, src)
    r <- bundler.bundle_file(source.FilePath(path), source.StdlibRoot(stdlib_root))
    match r with
    | bundler.BundleErr _ _ -> Nothing
    | bundler.BundleOk (ast.Program decls _) sizes -> Just((sizes, list_length(decls)))

fn total(sizes: List Int) -> Int = list_fold(\ (acc, n) -> acc + n, 0, sizes)

fn last_size(sizes: List Int) -> Maybe Int =
  match list_reverse(sizes) with
  | [n | _] -> Just(n)
  | [] -> Nothing

fn check_sizes(state: TestState, sizes: List Int, count: Int) -> Unit !{IO} =
  do
    assert_eq(state, "module sizes cover every declaration", count, total(sizes))
    assert_true(state, "the prelude, json and the entry are separate modules", list_length(sizes) >= 3)
    assert_eq(state, "the entry's type, derived instance and main are its module", Just(3), last_size(sizes))

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    match env.get("SPROUT_STDLIB_ROOT") with
    | Nothing ->
        assert_true(state, "SPROUT_STDLIB_ROOT is set (the suite cannot bundle without it)", false)
    | Just stdlib_root ->
        do
          match sizes_and_count(
            "import stdlib.json as json\n\ntype Coin (..) deriving (Eq) =\n  | Heads\n  | Tails\n\nfn main() -> Unit !{IO} = print(to_string(Heads == Tails))\n",
            "/tmp/sprout_bundle_module_sizes.spr", stdlib_root) with
          | Nothing -> assert_true(state, "the file bundles", false)
          | Just (sizes, count) -> check_sizes(state, sizes, count)
          # Sizes that do not cover the program are a compiler bug, reported, not guessed around.
          r <- checker.typecheck_bundle(ast.Program([], source.SourcePos(index = 0, line = 1, column = 1)), [1], Nil)
          assert_true(state, "sizes that do not cover the declarations are an internal error", is_internal_err(r))
    summary(state)

fn is_internal_err(r: typed_ast.TypedResult) -> Bool =
  match r with
  | typed_ast.TypedErr _ msg -> string.starts_with(msg, "internal: module sizes")
  | typed_ast.TypedOk _ _ -> false
