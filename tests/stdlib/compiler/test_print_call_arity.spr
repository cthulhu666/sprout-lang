module main
import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.compiler.ast_to_ir as ast_to_ir
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types
import stdlib.compiler.source as source
import stdlib.string as string

# `eprint` and `print_str` take one String. The type checker rejects any other arity, so
# a call that reaches lowering with none is a compiler bug and fails loudly rather than
# lowering to a stray unit constant.

fn no_pos() -> source.SourcePos = source.SourcePos(index = 0, line = 0, column = 0)
fn unit_t() -> types.Type = types.TConst(types.type_id("Unit"))
fn string_t() -> types.Type = types.TConst(types.type_id("String"))

# fn f() = <callee>()  -- the callee called with no arguments
fn nullary_call(callee: String) -> typed_ast.TypedDecl =
  typed_ast.TFnDecl("f", Nil, Nothing, Nothing, Nil,
    typed_ast.TCall(typed_ast.TVar(callee, types.TFunc(string_t(), unit_t(), types.EffectIO, types.OwnConsume), no_pos()),
      Nil, unit_t(), no_pos()))

# fn f() = <callee>("x")
fn unary_call(callee: String) -> typed_ast.TypedDecl =
  typed_ast.TFnDecl("f", Nil, Nothing, Nothing, Nil,
    typed_ast.TCall(typed_ast.TVar(callee, types.TFunc(string_t(), unit_t(), types.EffectIO, types.OwnConsume), no_pos()),
      Cons(typed_ast.TString("x", string_t(), no_pos()), Nil), unit_t(), no_pos()))

fn translate(d: typed_ast.TypedDecl) -> Result String Bool !{IO} =
  do
    penv <- ast_to_ir.new_prog_env(Cons(d, Nil), dict_empty())
    match ast_to_ir.translate_decl_with_idx(d, penv) with
    | Err msg -> Err(msg)
    | Ok _ -> Ok(true)

fn check_rejects_nullary(state: TestState, callee: String) -> Unit !{IO} =
  match translate(nullary_call(callee)) with
  | Ok _ -> assert_true(state, callee ++ "() is rejected", false)
  | Err msg ->
      assert_true(state, callee ++ "() is rejected, naming the function",
        string.contains(msg, callee ++ " expects 1 argument, got 0"))

fn check_accepts_unary(state: TestState, callee: String) -> Unit !{IO} =
  match translate(unary_call(callee)) with
  | Ok _ -> assert_true(state, callee ++ "(\"x\") lowers", true)
  | Err msg -> assert_true(state, callee ++ "(\"x\") lowers (got Err: " ++ msg ++ ")", false)

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    check_rejects_nullary(state, "eprint")
    check_rejects_nullary(state, "print_str")
    check_accepts_unary(state, "eprint")
    check_accepts_unary(state, "print_str")
    summary(state)
