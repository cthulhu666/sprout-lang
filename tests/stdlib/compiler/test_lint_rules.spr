# --- list-shape-pattern fixtures -----------------------------------------
# Scoped to fixed-length chains only (a chain that terminates in a literal
# Nil, e.g. `Cons a (Cons b Nil)`) — a corpus scan showed ordinary head/tail
# decomposition (`Cons h t`) and discard-the-rest (`Cons h _`) together are
# ~99% of all hand-written Cons/Nil patterns in this codebase, and `[h | t]`/
# `[h | _]` convey nothing those don't already say. Only the fixed-length
# case reads more clearly as `[...]` sugar.

let list_recursion_hand_written =
  "fn join_list(sep: String, xs: List String) -> String =\n" ++
  "  match xs with\n" ++
  "  | Nil -> \"\"\n" ++
  "  | Cons h t -> h ++ sep ++ join_list(sep, t)\n"

let list_recursion_sugar =
  "fn join_list(sep: String, xs: List String) -> String =\n" ++
  "  match xs with\n" ++
  "  | [] -> \"\"\n" ++
  "  | [h | t] -> h ++ sep ++ join_list(sep, t)\n"

let fixed_length_sugar =
  "fn pair_sum(xs: List Int) -> Int =\n" ++
  "  match xs with\n" ++
  "  | [a, b] -> a + b\n" ++
  "  | _ -> 0\n"

let fixed_length_hand_written =
  "fn pair_sum(xs: List Int) -> Int =\n" ++
  "  match xs with\n" ++
  "  | Cons a (Cons b Nil) -> a + b\n" ++
  "  | _ -> 0\n"

let nested_fixed_length_in_head =
  "fn f(xs: List (List Int)) -> Int =\n" ++
  "  match xs with\n" ++
  "  | Nil -> 0\n" ++
  "  | Cons (Cons a (Cons b Nil)) t -> a + b\n"

let non_list_pattern_unaffected =
  "fn f(x: Maybe Int) -> Int =\n" ++
  "  match x with\n" ++
  "  | Nothing -> 0\n" ++
  "  | Just v -> v\n"

# These exercise the list-shape/list-prefix lint on a refutable list pattern
# reached via a do-bind. A refutable `<-` pattern now requires an `else` (parser:
# is_irrefutable_do_bind_pattern), so each carries one; it desugars to a match at
# parse time, and the lint still flags the hand-written list pattern in that match.
let do_bind_hand_written_var_tail =
  "fn f() -> Int !{IO} =\n" ++
  "  do\n" ++
  "    Cons h t <- get_list() else 0\n" ++
  "    h\n"

let do_bind_hand_written_fixed_length =
  "fn f() -> Int !{IO} =\n" ++
  "  do\n" ++
  "    Cons a (Cons b Nil) <- get_pair() else 0\n" ++
  "    a + b\n"

# --- list-prefix-pattern fixtures -----------------------------------------
# Sibling rule to list-shape-pattern: flags a hand-written Cons chain whose
# tail is a discarded wildcard (`Cons h _`), not a bound variable — the
# `Cons h _` case deliberately deferred out of list-shape-pattern's scope
# (BACKLOG.md). `[h | _]` conveys "match a prefix, don't care about the
# rest" more clearly than the raw constructor form; unlike `Cons h t` (used
# for var-tail recursion), a wildcard tail can never be inspected further,
# so there's nothing lost by naming the shape.

let wildcard_tail_hand_written =
  "fn f(xs: List Int) -> Int =\n" ++
  "  match xs with\n" ++
  "  | Cons h _ -> h\n" ++
  "  | _ -> 0\n"

let wildcard_tail_sugar =
  "fn f(xs: List Int) -> Int =\n" ++
  "  match xs with\n" ++
  "  | [h | _] -> h\n" ++
  "  | _ -> 0\n"

let multi_wildcard_tail_hand_written =
  "fn f(xs: List Int) -> Int =\n" ++
  "  match xs with\n" ++
  "  | Cons a (Cons b _) -> a + b\n" ++
  "  | _ -> 0\n"

let wildcard_tail_nested_in_head =
  "fn f(xs: List (List Int)) -> Int =\n" ++
  "  match xs with\n" ++
  "  | Nil -> 0\n" ++
  "  | Cons (Cons a _) t -> a\n"

let do_bind_hand_written_wildcard_tail =
  "fn f() -> Int !{IO} =\n" ++
  "  do\n" ++
  "    Cons h _ <- get_list() else 0\n" ++
  "    h\n"

# --- deprecated-brace-body fixtures -------------------------------------
#
# Both body forms parse (the brace form is still accepted); the rule is what
# makes the deprecated one visible.

let brace_class =
  "class Codec a {\n" ++
  "  fn from_int(n: Int) -> a\n" ++
  "}\n"

let brace_instance =
  "instance Codec Int {\n" ++
  "  fn from_int(n: Int) -> Int = n\n" ++
  "}\n"

let brace_class_superclass =
  "class Applicative f where Functor f {\n" ++
  "  fn pure(x: a) -> f a\n" ++
  "}\n"

let brace_two_blocks =
  "class Codec a {\n" ++
  "  fn from_int(n: Int) -> a\n" ++
  "}\n" ++
  "\n" ++
  "instance Codec Int {\n" ++
  "  fn from_int(n: Int) -> Int = n\n" ++
  "}\n"

let layout_class =
  "class Codec a\n" ++
  "  fn from_int(n: Int) -> a\n"

let layout_instance =
  "instance Codec Int\n" ++
  "  fn from_int(n: Int) -> Int = n\n"

# `instance Boxer (a !{IO})` — a `{` sits between the keyword and the body, but
# it belongs to an effect annotation, not to a body.
let instance_head_effect =
  "class Boxer a\n" ++
  "  fn box_size(v: a) -> Int\n" ++
  "\n" ++
  "instance Boxer (a !{IO})\n" ++
  "  fn box_size(v: a) -> Int = 0\n"

let layout_class_effect_sig =
  "class Runner a\n" ++
  "  fn run(v: a) -> Unit !{IO}\n"

let brace_in_string =
  "fn snippet() -> String = \"class Foo { fn f(x: Int) -> Int }\"\n"

# --- multi-line-lambda-arg fixtures --------------------------------------

# The shape the rule exists for: control flow inside a call argument, spread
# over lines the reader has to reassemble before the call itself makes sense.
let multiline_match_lambda =
  "fn evs(xs: List (Maybe Int)) -> List Int =\n" ++
  "  filter_map(\\o -> match o with\n" ++
  "                   | Nothing -> Nothing\n" ++
  "                   | Just p -> Just(p + 1),\n" ++
  "             xs)\n"

# `let .. in` is the same AST node as `match` (spec §5.1), so it is the same
# finding — this is the front_gap shape from uncharted-suns.
let multiline_let_lambda =
  "fn gaps(xs: List Int) -> List Int =\n" ++
  "  filter_map(\\o -> let d = measure(o)\n" ++
  "                   in if d > 0 then Just(d) else Nothing,\n" ++
  "             xs)\n"

let multiline_if_lambda =
  "fn pick(xs: List Int) -> List Int =\n" ++
  "  find_map(\\a -> if a > 0\n" ++
  "                 then Just(a)\n" ++
  "                 else Nothing,\n" ++
  "           xs)\n"

# Control flow that fits on its line reads fine and stays silent — the rule is
# about the reassembly cost, not about `if` in an argument.
let single_line_if_lambda =
  "fn pick(xs: List Int) -> List Int =\n" ++
  "  filter_map(\\a -> if a > 0 then Just(a) else Nothing, xs)\n"

# Width-only wrapping: a record literal too wide for one line is not the thing
# this rule is for, however many lines it takes.
let multiline_record_lambda =
  "fn evs(ms: Int, xs: List Int) -> List Ev =\n" ++
  "  list_map(\\p -> Ev(ms = ms, kind = 1,\n" ++
  "                    actor = p),\n" ++
  "           xs)\n"

# Not an argument: a `where`-bound lambda is out of scope even when its body is
# a multi-line match.
let multiline_lambda_in_where =
  "fn pick(xs: List Int) -> List Int = filter_map(f, xs)\n" ++
  "where\n" ++
  "  f = \\a -> if a > 0\n" ++
  "            then Just(a)\n" ++
  "            else Nothing\n"

# A `_` placeholder is a lambda by the time the rule sees it (spec §5.3), so a
# wrapped placeholder call must not read as a hand-written multi-line lambda.
let multiline_placeholder_partial =
  "fn evs(ms: Int, xs: List Int) -> List Int =\n" ++
  "  list_map(shape(ms, 1,\n" ++
  "                 2, _),\n" ++
  "           xs)\n"

# Two of them in one call are two findings, not one per call.
let two_multiline_lambdas =
  "fn both(xs: List Int, ys: List Int) -> Int =\n" ++
  "  combine(filter_map(\\a -> if a > 0\n" ++
  "                           then Just(a)\n" ++
  "                           else Nothing,\n" ++
  "                     xs),\n" ++
  "          filter_map(\\b -> if b > 0\n" ++
  "                           then Just(b)\n" ++
  "                           else Nothing,\n" ++
  "                     ys))\n"

# --- nullary-const-fn fixtures -------------------------------------------
#
# A pure `fn` taking no parameters is a constant written as a function: the
# body is re-evaluated at every call, and the name reads as a call at every
# use. The gate is the type checker's own `is_syntactic_value`.

let nullary_int_literal =
  "fn bulk_size() -> Int = 65600\n"

let nullary_string_literal =
  "fn marker() -> String = \"@canonical:\"\n"

# Brackets desugar to Cons/Nil at parse time (parser.desugar_list_literal), so
# a list of literals arrives as a constructor applied to values and needs no
# arm of its own — here or in the predicate.
let nullary_list_literal =
  "fn items() -> List String = [\"alpha\", \"beta\"]\n"

let nullary_empty_list =
  "fn none_yet() -> List Int = []\n"

let nullary_ctor_app =
  "fn origin() -> Version = Version(0)\n"

let nullary_bare_ctor =
  "fn no_style() -> Maybe Style = Nothing\n"

let nullary_tuple =
  "fn corner() -> (Int, Int) = (0, 0)\n"

# Prefix `-` builds a UnaryExpr, which `is_syntactic_value` rejects: to the
# type checker `-1` and `negate(x)` pose the same generalization question. They
# are not the same question here, so the rule widens by exactly this shape.
let nullary_negative_literal =
  "fn sentinel() -> Int = -1\n"

# Where the body's line break falls is irrelevant — the rule reads the AST.
let nullary_wrapped_body =
  "fn no_channel_binding() -> String =\n" ++
  "  \"biws\"\n"

# A `Vec` written in list syntax is a `Vec` because the RETURN TYPE says so
# (spec §5.5.1). The suggested rewrite has to carry that annotation across or
# the same brackets become a `List`, so the message names it.
let nullary_vec_literal =
  "fn lengths() -> Vec Int = [1, 2, 3]\n"

# Effectful: a top-level `let` initializer must be pure (spec §5.2), and that
# is NOT enforced today — so a finding here would yield code that compiles
# and silently moves the effect to program startup.
#
# The body is a LITERAL on purpose. With an effectful body the value gate
# rejects it first and the purity gate is never consulted, which is how the
# first draft of this fixture left that gate entirely untested.
let nullary_effectful =
  "fn stamp() -> Int !{IO} = 65600\n"

# The same fn with its effect row dropped — the one-token difference that has
# to be what decides it.
let nullary_effectful_twin =
  "fn stamp() -> Int = 65600\n"

# A lowercase callee is a function call, not a constructor: `bytes_empty()`
# allocates per call, and no top-level `let` can stand in for that.
let nullary_fn_call =
  "fn empty() -> Bytes = bytes_empty()\n"

let nullary_arithmetic =
  "fn min_int() -> Int = 0 - 9223372036854775807 - 1\n"

# One computed element disqualifies the whole list.
let nullary_list_with_call =
  "fn sizes() -> List Int = [width(), 2]\n"

# A record literal is a RecordExpr, which the value restriction excludes.
let nullary_record_literal =
  "fn scratch() -> Document = Document(file = Nothing, dirty = false)\n"

# Parameters are a function's reason to exist. The rule is only about a
# function that has none.
let unary_literal_fn =
  "fn always(n: Int) -> Int = 65600\n"

# A LINEAR value must be consumed exactly once. A `fn` mints a fresh one per
# call, so that obligation is real; a single shared binding makes it vanish, and
# nothing downstream catches the second consume — `letdecl_linear_gate` checks
# the initializer, not the uses.
let nullary_linear_ctor =
  "type linear Token (..) =\n" ++
  "  | Token Int\n" ++
  "\n" ++
  "fn make_token() -> Token = Token(0)\n"

# A linear RECORD is already out of reach of the value gate — named-field
# construction is a RecordExpr, which is not a syntactic value. Pinned so that
# stays true if RecordExpr ever joins the predicate.
let nullary_linear_record =
  "record linear Handle (..) =\n" ++
  "  fd: Int\n" ++
  "\n" ++
  "fn make_handle() -> Handle = Handle(fd = 1)\n"

# The same shape at an UNRESTRICTED type still converts, so the gate keys on the
# declaration's multiplicity and not merely on naming a local constructor.
let nullary_unrestricted_ctor =
  "type Token (..) =\n" ++
  "  | Token Int\n" ++
  "\n" ++
  "fn make_token() -> Token = Token(0)\n"

# A context-typed body one CONSTRUCTOR deep. `Just(label)` is a syntactic value
# and `takes_type_from_context` saw only the top node, so this was reported with
# no rewrite that compiles: annotated hits the non-prelude type limitation,
# unannotated hits `ambiguous typeclass binding`.
let nullary_ctor_wrapping_var =
  "fn pick() -> Maybe (Colour -> String) = Just(label)\n"

# The same, one TUPLE deep.
let nullary_tuple_wrapping_var =
  "fn pick2() -> (Colour -> String, Int) = (label, 1)\n"

# And one constructor deep around a lambda.
let nullary_ctor_wrapping_lambda =
  "fn boxed() -> Box (Int -> String) = Box(\\n -> label(n))\n"

# A `where` constraint means the dictionary is chosen per CALL. A top-level
# binding holds one value and one choice, and an open one is rejected as an
# ambiguous typeclass binding — three in-tree suites failed exactly this way.
let nullary_constrained =
  "fn pick_where() -> a -> String where ToString a = label\n"

# A bare name and a lambda are syntactic values, but they take their type from
# CONTEXT — the declared return type is what selects the instance. The rewrite
# can only preserve that by carrying an annotation, which is not always
# writable, so the rule declines.
let nullary_bare_var =
  "fn pick_color() -> Color -> String = label\n"

let nullary_lambda =
  "fn pick_lambda() -> Int -> String = \\n -> label(n)\n"

# The entry point stays a function whatever its body: `let main` is not a
# program. A real `main` is `!{IO}` and the purity gate would stop it, so the
# pure one is the case that needs its own guard.
let nullary_main =
  "fn main() -> Int = 0\n"

let nullary_suppressed =
  "# sprout-ignore-all lint/nullary-const-fn: generated table\n" ++
  "\n" ++
  "fn bulk_size() -> Int = 65600\n"

# A file that does not PARSE cannot have any AST rule run against it, and the
# honest answer is to say so. Reporting it as clean makes an unchecked file
# indistinguishable from a checked one at the lint gate — and `just lint` over a
# tree could no longer be read as "every file was linted".
let unparseable =
  "fn gap(n: Int) -> Int =\n" ++
  "  let d = n + 1 in\n" ++
  "  d * 2\n"

# The earlier of the two failure points: this one never reaches the parser.
let unlexable =
  "fn f() -> String = \"abc\n"

# --- suppression directives ---------------------------------------------
#
# `# sprout-ignore-all lint/<rule>: <reason>`, transliterated from Biome's
# `// biome-ignore-all <category>: <explanation>` (biomejs.dev/analyzer/
# suppressions). Rule name and explanation are both required and the directive
# is honoured only at the top of the file, exactly as Biome specifies.

let suppressed_unparseable =
  "# sprout-ignore-all lint/unparsed: parse-error fixture, by construction\n" ++
  unparseable

let suppressed_unlexable =
  "# sprout-ignore-all lint/unparsed: lex-error fixture, by construction\n" ++
  unlexable

let suppressed_wrong_rule =
  "# sprout-ignore-all lint/staircase-of-doom: not the rule that fires here\n" ++
  unparseable

let suppressed_staircase =
  "# sprout-ignore-all lint/staircase-of-doom: this file IS the staircase test\n" ++
  three_deep_chain

# Two directives, and a `module` line between them — the header block is a
# block, not just line 1, so both must still be found.
let suppressed_two_rules =
  "# sprout-ignore-all lint/unparsed: first\n" ++
  "module main\n" ++
  "# sprout-ignore-all lint/staircase-of-doom: second\n" ++
  unparseable

# Past the first line of code the directive is an ordinary comment.
let suppression_after_code =
  "fn noop() -> Int = 1\n" ++
  "# sprout-ignore-all lint/unparsed: too late to count\n" ++
  unparseable

# Both halves are mandatory: no explanation, and a category missing `lint/`.
let suppression_no_reason =
  "# sprout-ignore-all lint/unparsed\n" ++
  unparseable

let suppression_bad_category =
  "# sprout-ignore-all unparsed: category needs the lint/ prefix\n" ++
  unparseable

# A well-formed directive naming `malformed-suppression` must NOT silence the
# report of the broken one below it — otherwise a typo could be papered over by
# the very mechanism whose typo it is.
let suppression_self_shield =
  "# sprout-ignore-all lint/malformed-suppression: cannot silence its own diagnostic\n" ++
  "# sprout-ignore-all lint/unparsed\n" ++
  unparseable

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    assert_eq(state, "unparseable file: reported, not silently clean", count_list(lint_rules.lint_ast(unparseable)), 1)
    assert_eq(state, "unparseable file: rule id", first_rule(lint_rules.lint_ast(unparseable)), "unparsed")
    assert_eq(state, "unparseable file: anchored at the offending line", first_line(lint_rules.lint_ast(unparseable)), 2)
    assert_eq(state, "unparseable file: message carries the parser's reason", mentions_one_binding(first_message(lint_rules.lint_ast(unparseable))), true)
    assert_eq(state, "unlexable file: reported, not silently clean", count_list(lint_rules.lint_ast(unlexable)), 1)
    assert_eq(state, "unlexable file: rule id", first_rule(lint_rules.lint_ast(unlexable)), "unparsed")
    assert_eq(state, "unlexable file: anchored at the offending line", first_line(lint_rules.lint_ast(unlexable)), 1)

    assert_eq(state, "ignore-all: suppresses the named rule on an unparseable file", count_list(lint_rules.lint_ast(suppressed_unparseable)), 0)
    assert_eq(state, "ignore-all: suppresses a lex failure too", count_list(lint_rules.lint_ast(suppressed_unlexable)), 0)
    assert_eq(state, "ignore-all: a different rule id suppresses nothing", count_by_rule(lint_rules.lint_ast(suppressed_wrong_rule), "unparsed"), 1)
    assert_eq(state, "ignore-all: suppresses an AST rule", count_by_rule(lint_rules.lint_ast(suppressed_staircase), "staircase-of-doom"), 0)
    assert_eq(state, "ignore-all: found anywhere in the header block", count_list(lint_rules.lint_ast(suppressed_two_rules)), 0)
    assert_eq(state, "ignore-all: not honoured past the header block", count_by_rule(lint_rules.lint_ast(suppression_after_code), "unparsed"), 1)
    assert_eq(state, "ignore-all: missing explanation is itself reported", count_by_rule(lint_rules.lint_ast(suppression_no_reason), "malformed-suppression"), 1)
    assert_eq(state, "ignore-all: missing explanation suppresses nothing", count_by_rule(lint_rules.lint_ast(suppression_no_reason), "unparsed"), 1)
    assert_eq(state, "ignore-all: category needs the lint/ prefix", count_by_rule(lint_rules.lint_ast(suppression_bad_category), "malformed-suppression"), 1)
    assert_eq(state, "ignore-all: cannot suppress its own malformed-directive report", count_by_rule(lint_rules.lint_ast(suppression_self_shield), "malformed-suppression"), 1)

    assert_eq(state, "docs example (depth 2): below min_staircase_depth=3, no finding", count_list(lint_rules.lint_ast(docs_example)), 0)

    assert_eq(state, "3-branch outer: no finding", count_list(lint_rules.lint_ast(three_branch_outer)), 0)
    assert_eq(state, "flat match: no finding", count_list(lint_rules.lint_ast(flat_match)), 0)
    assert_eq(state, "boolean-pattern nesting: no finding", count_list(lint_rules.lint_ast(boolean_nested)), 0)
    assert_eq(state, "both branches continue: no finding", count_list(lint_rules.lint_ast(ambiguous_both_continue)), 0)

    assert_eq(state, "3-deep chain: exactly one finding (meets threshold)", count_list(lint_rules.lint_ast(three_deep_chain)), 1)
    assert_eq(state, "3-deep chain: anchored at outermost match", first_line(lint_rules.lint_ast(three_deep_chain)), 2)
    assert_eq(state, "3-deep chain: rule id", first_rule(lint_rules.lint_ast(three_deep_chain)), "staircase-of-doom")

    assert_eq(state, "4-deep chain: still exactly one finding (not one per link)", count_list(lint_rules.lint_ast(four_deep_chain)), 1)
    assert_eq(state, "4-deep chain: anchored at outermost match", first_line(lint_rules.lint_ast(four_deep_chain)), 2)

    assert_eq(state, "Result chain (depth 2): below threshold, no finding", count_list(lint_rules.lint_ast(result_chain)), 0)

    assert_eq(state, "3-deep chain inside lambda/do: still found", count_list(lint_rules.lint_ast(nested_in_lambda)), 1)

    assert_eq(state, "list Cons/Nil recursion: no staircase-of-doom finding (not a Maybe/Result unwrap)", count_by_rule(lint_rules.lint_ast(list_recursion), "staircase-of-doom"), 0)
    assert_eq(state, "list recursion wrapping an inner Maybe match: no staircase-of-doom finding", count_by_rule(lint_rules.lint_ast(list_recursion_wrapping_maybe), "staircase-of-doom"), 0)

    assert_eq(state, "already let..else (desugars to the same MatchExpr shape): no finding", count_list(lint_rules.lint_ast(already_let_else)), 0)
    assert_eq(state, "do binding-else (new syntax, desugars to matches at bind positions): no finding", count_by_rule(lint_rules.lint_ast(already_do_binding_else), "staircase-of-doom"), 0)

    assert_eq(state, "clean chain: message references let..else", mentions_let_else(first_message(lint_rules.lint_ast(three_deep_chain))), true)

    assert_eq(state, "blocked chain (terminal uses own payload): still reported", count_list(lint_rules.lint_ast(blocked_own_payload)), 1)
    assert_eq(state, "blocked chain: rule id unchanged", first_rule(lint_rules.lint_ast(blocked_own_payload)), "staircase-of-doom")
    assert_eq(state, "payload chain: message points to let..else (binding-else, Tier 1b)", mentions_let_else(first_message(lint_rules.lint_ast(blocked_own_payload))), true)

    assert_eq(state, "leaf match arm using its own payload stays clean (leaf never becomes an else-fallback)", count_list(lint_rules.lint_ast(leaf_match_arm_uses_own_payload_is_clean)), 1)
    assert_eq(state, "leaf match arm using its own payload: message still references let..else", mentions_let_else(first_message(lint_rules.lint_ast(leaf_match_arm_uses_own_payload_is_clean))), true)

    assert_eq(state, "blocked at intermediate link: still reported once", count_list(lint_rules.lint_ast(blocked_at_intermediate_link)), 1)
    assert_eq(state, "payload at intermediate link: binding-else message propagates to the root", mentions_let_else(first_message(lint_rules.lint_ast(blocked_at_intermediate_link))), true)

    assert_eq(state, "redundant wrap at Vec-typed call arg: reported", count_list(lint_rules.lint_ast(redundant_call_arg)), 1)
    assert_eq(state, "redundant wrap at Vec-typed call arg: rule id", first_rule(lint_rules.lint_ast(redundant_call_arg)), "redundant-vec-from-list")

    assert_eq(state, "redundant wrap at Vec-typed return position: reported", count_list(lint_rules.lint_ast(redundant_return_position)), 1)

    assert_eq(state, "redundant wrap in both if branches: two findings", count_list(lint_rules.lint_ast(redundant_in_if_branches)), 2)

    assert_eq(state, "bare list literal (no wrapper): no finding", count_list(lint_rules.lint_ast(no_wrapper_bare_literal)), 0)

    assert_eq(state, "vec_from_list wrapping a real value (not a literal): no finding", count_list(lint_rules.lint_ast(wrap_of_real_value_not_redundant)), 0)

    assert_eq(state, "wrap at a call to an unresolved callee (no Vec context): no finding", count_list(lint_rules.lint_ast(wrap_outside_vec_context)), 0)

    # Rule-scoped: this fixture needs a second declaration to place the `let`
    # after, and `fn g() -> Int = 1` is legitimately a nullary-const-fn.
    assert_eq(state, "wrap in a top-level let binding (no Vec context): no finding",
      count_by_rule(lint_rules.lint_ast(wrap_in_let_binding_no_context), "redundant-vec-from-list"), 0)

    assert_eq(state, "hand-written Cons h t head/tail recursion: no finding (var tail, not fixed-length)", count_list(lint_rules.lint_ast(list_recursion_hand_written)), 0)

    assert_eq(state, "[] / [h | t] sugar: no finding", count_list(lint_rules.lint_ast(list_recursion_sugar)), 0)

    assert_eq(state, "[a, b] fixed-length sugar: no finding", count_list(lint_rules.lint_ast(fixed_length_sugar)), 0)

    assert_eq(state, "hand-written Cons a (Cons b Nil) fixed-length pattern: reported", count_list(lint_rules.lint_ast(fixed_length_hand_written)), 1)
    assert_eq(state, "hand-written fixed-length pattern: rule id", first_rule(lint_rules.lint_ast(fixed_length_hand_written)), "list-shape-pattern")

    assert_eq(state, "fixed-length pattern nested in a head position (outer chain stays var-tailed): one finding (the inner [a, b])", count_list(lint_rules.lint_ast(nested_fixed_length_in_head)), 1)

    assert_eq(state, "non-list ADT pattern (Maybe): no finding", count_list(lint_rules.lint_ast(non_list_pattern_unaffected)), 0)

    assert_eq(state, "hand-written Cons h t pattern in a do-bind: no finding (var tail, not fixed-length)", count_list(lint_rules.lint_ast(do_bind_hand_written_var_tail)), 0)

    assert_eq(state, "hand-written fixed-length pattern in a do-bind: reported", count_list(lint_rules.lint_ast(do_bind_hand_written_fixed_length)), 1)

    assert_eq(state, "fixed-length pattern: no list-prefix-pattern finding (mutually exclusive from list-shape-pattern)", count_by_rule(lint_rules.lint_ast(fixed_length_hand_written), "list-prefix-pattern"), 0)

    assert_eq(state, "hand-written Cons h _ wildcard-tail: reported", count_list(lint_rules.lint_ast(wildcard_tail_hand_written)), 1)
    assert_eq(state, "hand-written wildcard-tail pattern: rule id", first_rule(lint_rules.lint_ast(wildcard_tail_hand_written)), "list-prefix-pattern")

    assert_eq(state, "[h | _] sugar: no finding", count_list(lint_rules.lint_ast(wildcard_tail_sugar)), 0)

    assert_eq(state, "hand-written Cons a (Cons b _) multi-element wildcard tail: one finding, not one per link", count_list(lint_rules.lint_ast(multi_wildcard_tail_hand_written)), 1)

    assert_eq(state, "wildcard-tail pattern nested in a head position: one finding (the inner [a | _])", count_list(lint_rules.lint_ast(wildcard_tail_nested_in_head)), 1)

    assert_eq(state, "hand-written wildcard-tail pattern in a do-bind: reported", count_list(lint_rules.lint_ast(do_bind_hand_written_wildcard_tail)), 1)

    assert_eq(state, "hand-written Cons h t var-tail recursion: no list-prefix-pattern finding either", count_by_rule(lint_rules.lint_ast(list_recursion_hand_written), "list-prefix-pattern"), 0)

    # --- deprecated-brace-body ------------------------------------------
    assert_eq(state, "brace class body: one finding",
      count_by_rule(lint_rules.lint_ast(brace_class), "deprecated-brace-body"), 1)
    assert_eq(state, "brace instance body: one finding",
      count_by_rule(lint_rules.lint_ast(brace_instance), "deprecated-brace-body"), 1)
    assert_eq(state, "brace class with a superclass clause: one finding",
      count_by_rule(lint_rules.lint_ast(brace_class_superclass), "deprecated-brace-body"), 1)
    assert_eq(state, "two brace blocks: one finding each",
      count_by_rule(lint_rules.lint_ast(brace_two_blocks), "deprecated-brace-body"), 2)

    # The finding anchors on the `{` itself, not the declaration head — that is
    # the token the author has to delete.
    assert_eq(state, "brace class: anchored at the opening brace's line",
      first_line(lint_rules.lint_ast(brace_class)), 1)
    assert_eq(state, "brace class: rule id",
      first_rule(lint_rules.lint_ast(brace_class)), "deprecated-brace-body")

    # The layout form is the point of the rule — it must stay silent.
    assert_eq(state, "layout class body: no finding",
      count_by_rule(lint_rules.lint_ast(layout_class), "deprecated-brace-body"), 0)
    assert_eq(state, "layout instance body: no finding",
      count_by_rule(lint_rules.lint_ast(layout_instance), "deprecated-brace-body"), 0)

    # An effect annotation in an instance HEAD puts a `{` between the keyword
    # and the body — `instance Boxer (a !{IO})`. It is `!{`, not a body brace,
    # and tests/conformance/type_error/tyvar_instance_head_effect.spr is a live
    # in-tree file of exactly this shape.
    assert_eq(state, "effect annotation in an instance head: no finding",
      count_by_rule(lint_rules.lint_ast(instance_head_effect), "deprecated-brace-body"), 0)
    assert_eq(state, "effect annotation in a class method sig: no finding",
      count_by_rule(lint_rules.lint_ast(layout_class_effect_sig), "deprecated-brace-body"), 0)

    # A string literal is a single token, so the scan cannot see into one — but
    # this file itself is full of brace snippets inside strings and is staged
    # through the pre-commit hook, so the property is worth pinning.
    assert_eq(state, "brace syntax inside a string literal: no finding",
      count_by_rule(lint_rules.lint_ast(brace_in_string), "deprecated-brace-body"), 0)

    # --- multi-line-lambda-arg -------------------------------------------
    assert_eq(state, "multi-line match lambda in a call argument: one finding",
      count_by_rule(lint_rules.lint_ast(multiline_match_lambda), "multi-line-lambda-arg"), 1)
    assert_eq(state, "multi-line let..in lambda in a call argument: one finding",
      count_by_rule(lint_rules.lint_ast(multiline_let_lambda), "multi-line-lambda-arg"), 1)
    assert_eq(state, "multi-line if lambda in a call argument: one finding",
      count_by_rule(lint_rules.lint_ast(multiline_if_lambda), "multi-line-lambda-arg"), 1)

    # Anchored on the lambda itself — the `\` the author has to lift out.
    assert_eq(state, "multi-line match lambda: anchored at the lambda's line",
      first_line(lint_rules.lint_ast(multiline_match_lambda)), 2)
    assert_eq(state, "multi-line match lambda: rule id",
      first_rule(lint_rules.lint_ast(multiline_match_lambda)), "multi-line-lambda-arg")

    assert_eq(state, "single-line if lambda: no finding",
      count_by_rule(lint_rules.lint_ast(single_line_if_lambda), "multi-line-lambda-arg"), 0)
    assert_eq(state, "multi-line record literal lambda (width, not control flow): no finding",
      count_by_rule(lint_rules.lint_ast(multiline_record_lambda), "multi-line-lambda-arg"), 0)
    assert_eq(state, "multi-line lambda bound in a where block (not an argument): no finding",
      count_by_rule(lint_rules.lint_ast(multiline_lambda_in_where), "multi-line-lambda-arg"), 0)
    assert_eq(state, "wrapped `_` placeholder partial: no finding",
      count_by_rule(lint_rules.lint_ast(multiline_placeholder_partial), "multi-line-lambda-arg"), 0)

    assert_eq(state, "two multi-line lambdas in one call: two findings",
      count_by_rule(lint_rules.lint_ast(two_multiline_lambdas), "multi-line-lambda-arg"), 2)

    # --- nullary-const-fn ------------------------------------------------
    assert_eq(state, "nullary fn with an Int literal body: one finding",
      count_by_rule(lint_rules.lint_ast(nullary_int_literal), "nullary-const-fn"), 1)
    assert_eq(state, "nullary fn with a String literal body: one finding",
      count_by_rule(lint_rules.lint_ast(nullary_string_literal), "nullary-const-fn"), 1)
    assert_eq(state, "nullary fn with a list-literal body: one finding",
      count_by_rule(lint_rules.lint_ast(nullary_list_literal), "nullary-const-fn"), 1)
    assert_eq(state, "nullary fn returning []: one finding",
      count_by_rule(lint_rules.lint_ast(nullary_empty_list), "nullary-const-fn"), 1)
    assert_eq(state, "nullary fn applying a constructor to values: one finding",
      count_by_rule(lint_rules.lint_ast(nullary_ctor_app), "nullary-const-fn"), 1)
    assert_eq(state, "nullary fn returning a bare constructor: one finding",
      count_by_rule(lint_rules.lint_ast(nullary_bare_ctor), "nullary-const-fn"), 1)
    assert_eq(state, "nullary fn returning a tuple of values: one finding",
      count_by_rule(lint_rules.lint_ast(nullary_tuple), "nullary-const-fn"), 1)
    assert_eq(state, "nullary fn returning a negated literal: one finding",
      count_by_rule(lint_rules.lint_ast(nullary_negative_literal), "nullary-const-fn"), 1)
    assert_eq(state, "nullary fn whose body wraps to the next line: one finding",
      count_by_rule(lint_rules.lint_ast(nullary_wrapped_body), "nullary-const-fn"), 1)
    assert_eq(state, "nullary fn returning a Vec written in list syntax: one finding",
      count_by_rule(lint_rules.lint_ast(nullary_vec_literal), "nullary-const-fn"), 1)

    # Anchored on the declaration, which is what gets rewritten.
    assert_eq(state, "nullary const fn: anchored at the fn's line",
      first_line(lint_rules.lint_ast(nullary_int_literal)), 1)
    assert_eq(state, "nullary const fn: rule id",
      first_rule(lint_rules.lint_ast(nullary_int_literal)), "nullary-const-fn")

    # The rewrite is `let <name>: <T> = <body>`, never a bare `let <name> =`.
    # Dropping the annotation turns `Vec Int` into `List Int` — they are
    # distinct types, so the message has to say to carry it.
    assert_eq(state, "nullary const fn: message names the type annotation",
      mentions_annotation(first_message(lint_rules.lint_ast(nullary_vec_literal))), true)

    assert_eq(state, "effectful nullary fn with a literal body: no finding",
      count_by_rule(lint_rules.lint_ast(nullary_effectful), "nullary-const-fn"), 0)
    assert_eq(state, "the same fn without the effect row: one finding",
      count_by_rule(lint_rules.lint_ast(nullary_effectful_twin), "nullary-const-fn"), 1)
    assert_eq(state, "nullary fn calling a function: no finding",
      count_by_rule(lint_rules.lint_ast(nullary_fn_call), "nullary-const-fn"), 0)
    assert_eq(state, "nullary fn computing arithmetic: no finding",
      count_by_rule(lint_rules.lint_ast(nullary_arithmetic), "nullary-const-fn"), 0)
    assert_eq(state, "nullary fn with one computed list element: no finding",
      count_by_rule(lint_rules.lint_ast(nullary_list_with_call), "nullary-const-fn"), 0)
    assert_eq(state, "nullary fn returning a record literal: no finding",
      count_by_rule(lint_rules.lint_ast(nullary_record_literal), "nullary-const-fn"), 0)
    assert_eq(state, "literal-bodied fn that takes a parameter: no finding",
      count_by_rule(lint_rules.lint_ast(unary_literal_fn), "nullary-const-fn"), 0)
    assert_eq(state, "nullary fn building a LINEAR value: no finding",
      count_by_rule(lint_rules.lint_ast(nullary_linear_ctor), "nullary-const-fn"), 0)
    assert_eq(state, "nullary fn building a linear RECORD: no finding",
      count_by_rule(lint_rules.lint_ast(nullary_linear_record), "nullary-const-fn"), 0)
    assert_eq(state, "the same shape at an unrestricted type: one finding",
      count_by_rule(lint_rules.lint_ast(nullary_unrestricted_ctor), "nullary-const-fn"), 1)

    assert_eq(state, "context-typed body one constructor deep: no finding",
      count_by_rule(lint_rules.lint_ast(nullary_ctor_wrapping_var), "nullary-const-fn"), 0)
    assert_eq(state, "context-typed body one tuple deep: no finding",
      count_by_rule(lint_rules.lint_ast(nullary_tuple_wrapping_var), "nullary-const-fn"), 0)
    assert_eq(state, "lambda one constructor deep: no finding",
      count_by_rule(lint_rules.lint_ast(nullary_ctor_wrapping_lambda), "nullary-const-fn"), 0)

    # The annotation resolves only prelude types, so the message must not send a
    # reader at a `Version` or a `mod.T` without saying so.
    assert_eq(state, "nullary const fn: message flags the prelude-only annotation",
      mentions_prelude_only(first_message(lint_rules.lint_ast(nullary_ctor_app))), true)

    assert_eq(state, "nullary fn with a where constraint: no finding",
      count_by_rule(lint_rules.lint_ast(nullary_constrained), "nullary-const-fn"), 0)
    assert_eq(state, "nullary fn whose body is a bare name: no finding",
      count_by_rule(lint_rules.lint_ast(nullary_bare_var), "nullary-const-fn"), 0)
    assert_eq(state, "nullary fn whose body is a lambda: no finding",
      count_by_rule(lint_rules.lint_ast(nullary_lambda), "nullary-const-fn"), 0)
    assert_eq(state, "pure nullary main with a literal body: no finding",
      count_by_rule(lint_rules.lint_ast(nullary_main), "nullary-const-fn"), 0)
    assert_eq(state, "nullary const fn under a suppression directive: no finding",
      count_by_rule(lint_rules.lint_ast(nullary_suppressed), "nullary-const-fn"), 0)

    summary(state)
