import stdlib.test (TestState, new_state, assert_eq, summary)
import stdlib.compiler.lint_rules as lint_rules

fn count_list(lst: List a) -> Int =
  match lst with
  | Nil -> 0
  | Cons _ rest -> 1 + count_list(rest)

fn finding_line(f: lint_rules.LintFinding) -> Int =
  match f with
  | lint_rules.LintFinding ln _ _ _ -> ln

fn finding_rule(f: lint_rules.LintFinding) -> String =
  match f with
  | lint_rules.LintFinding _ _ rule_id _ -> rule_id

fn first_line(findings: List lint_rules.LintFinding) -> Int =
  match findings with
  | [] -> -1
  | [f | _] -> finding_line(f)

fn first_rule(findings: List lint_rules.LintFinding) -> String =
  match findings with
  | [] -> ""
  | [f | _] -> finding_rule(f)

fn finding_message(f: lint_rules.LintFinding) -> String =
  match f with
  | lint_rules.LintFinding _ _ _ msg -> msg

fn first_message(findings: List lint_rules.LintFinding) -> String =
  match findings with
  | [] -> ""
  | [f | _] -> finding_message(f)

fn mentions_let_else(msg: String) -> Bool =
  str_find(msg, "let..else") != -1

fn mentions_one_binding(msg: String) -> Bool =
  str_find(msg, "one binding per line") != -1

fn mentions_annotation(msg: String) -> Bool =
  str_find(msg, "let <name>: <type>") != -1

fn mentions_prelude_only(msg: String) -> Bool =
  str_find(msg, "only prelude types") != -1

# Rule-scoped count — keeps an assertion about ONE rule from breaking when a
# fixture also happens to trip a different rule (e.g. a Cons/Nil-recursion
# fixture used for staircase-of-doom now also legitimately trips
# list-shape-pattern; each rule's own test should only assert its own count).
fn count_by_rule(findings: List lint_rules.LintFinding, rule_id: String) -> Int =
  match findings with
  | Nil -> 0
  | Cons f rest -> (if finding_rule(f) == rule_id then 1 else 0) + count_by_rule(rest, rule_id)

