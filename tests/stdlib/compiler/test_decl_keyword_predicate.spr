module main
import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.compiler.parser as parser

# The decl-keyword predicate is the single source of truth for which keywords
# begin a top-level declaration (parse_decl_body guards its dispatch on it).
# submission_starts_decl is the string-level classifier clients use to route a
# submission to the declaration path; it must agree with the full keyword set,
# skip an `export` modifier, and reject expressions.

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # is_decl_keyword covers every keyword parse_decl_dispatch handles.
    assert_true(state, "extern is a decl keyword", parser.is_decl_keyword("extern"))
    assert_true(state, "fn is a decl keyword", parser.is_decl_keyword("fn"))
    assert_true(state, "let is a decl keyword", parser.is_decl_keyword("let"))
    assert_true(state, "class is a decl keyword", parser.is_decl_keyword("class"))
    assert_true(state, "instance is a decl keyword", parser.is_decl_keyword("instance"))
    assert_true(state, "type is a decl keyword", parser.is_decl_keyword("type"))
    assert_true(state, "wrap is a decl keyword", parser.is_decl_keyword("wrap"))
    assert_true(state, "export is not itself a decl keyword",
      parser.is_decl_keyword("export") == false)
    assert_true(state, "an identifier is not a decl keyword",
      parser.is_decl_keyword("foo") == false)

    # submission_starts_decl routes real submissions, including the wrap and
    # extern cases the REPL previously misrouted to the expression path.
    assert_true(state, "wrap submission is a declaration",
      parser.submission_starts_decl("wrap Minutes = Int"))
    assert_true(state, "extern submission is a declaration",
      parser.submission_starts_decl("extern fn c_now() -> Int"))
    assert_true(state, "fn submission is a declaration",
      parser.submission_starts_decl("fn f() = 1"))
    assert_true(state, "exported wrap is a declaration",
      parser.submission_starts_decl("export wrap Minutes = Int"))
    assert_true(state, "exported fn is a declaration",
      parser.submission_starts_decl("export fn f() = 1"))
    assert_true(state, "an expression is not a declaration",
      parser.submission_starts_decl("1 + 2") == false)
    assert_true(state, "a call is not a declaration",
      parser.submission_starts_decl("Minutes(5)") == false)
    assert_true(state, "empty input is not a declaration",
      parser.submission_starts_decl("") == false)

    summary(state)
