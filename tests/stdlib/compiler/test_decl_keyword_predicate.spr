module main
import stdlib.test (check_true, run_suite)
import stdlib.compiler.parser as parser

# The decl-keyword predicate is the single source of truth for which keywords
# begin a top-level declaration (parse_decl_body guards its dispatch on it).
# submission_starts_decl is the string-level classifier clients use to route a
# submission to the declaration path; it must agree with the full keyword set,
# skip an `export` modifier, and reject expressions.

fn main() -> Unit !{IO} =
  run_suite("decl_keyword_predicate", [
    # is_decl_keyword covers every keyword parse_decl_dispatch handles.
    check_true("extern is a decl keyword", parser.is_decl_keyword("extern")),
    check_true("fn is a decl keyword", parser.is_decl_keyword("fn")),
    check_true("let is a decl keyword", parser.is_decl_keyword("let")),
    check_true("class is a decl keyword", parser.is_decl_keyword("class")),
    check_true("instance is a decl keyword", parser.is_decl_keyword("instance")),
    check_true("type is a decl keyword", parser.is_decl_keyword("type")),
    check_true("wrap is a decl keyword", parser.is_decl_keyword("wrap")),
    check_true("export is not itself a decl keyword",
      parser.is_decl_keyword("export") == false),
    check_true("an identifier is not a decl keyword",
      parser.is_decl_keyword("foo") == false),

    # submission_starts_decl routes real submissions, including the wrap and
    # extern cases the REPL previously misrouted to the expression path.
    check_true("wrap submission is a declaration",
      parser.submission_starts_decl("wrap Minutes = Int")),
    check_true("extern submission is a declaration",
      parser.submission_starts_decl("extern fn c_now() -> Int")),
    check_true("fn submission is a declaration",
      parser.submission_starts_decl("fn f() = 1")),
    check_true("exported wrap is a declaration",
      parser.submission_starts_decl("export wrap Minutes = Int")),
    check_true("exported fn is a declaration",
      parser.submission_starts_decl("export fn f() = 1")),
    check_true("an expression is not a declaration",
      parser.submission_starts_decl("1 + 2") == false),
    check_true("a call is not a declaration",
      parser.submission_starts_decl("Minutes(5)") == false),
    check_true("empty input is not a declaration",
      parser.submission_starts_decl("") == false)
  ])
