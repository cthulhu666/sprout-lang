import stdlib.test (check_eq, run_suite)
import stdlib.compiler.source as source
import stdlib.compiler.types as types
import stdlib.compiler.typed_ast as typed_ast

# `typed_ast.callee_is_pure` and the nullary arrow.
#
# A call's purity is read off the CALLEE's type. A nullary callee is a
# `TThunk ret eff`, which carries its own effect slot; a parameterised one is a
# `TFunc`. Both have to be read, and the failure is silent either way.
#
# The effectful cases are the ones that must not regress: bounds-check
# elimination and the CSE census trust "pure" to mean the call cannot do IO.

fn pos() -> source.SourcePos = source.SourcePos(index = 0, line = 0, column = 0)

fn int_ty() -> types.Type = types.TConst(types.type_id("Int"))

fn arrow_ty(eff: types.Effect) -> types.Type =
  types.TFunc(int_ty(), int_ty(), eff, types.OwnBorrow)

# `Int -> Int -> Int`, the shape of a two-parameter declaration. `infer` puts a
# declared effect on the LAST arrow, so `outer` is Pure for every such function
# and reading it alone reports the whole call pure.
fn curried_ty(outer: types.Effect, inner: types.Effect) -> types.Type =
  types.TFunc(int_ty(), arrow_ty(inner), outer, types.OwnBorrow)

fn callee(ty: types.Type) -> typed_ast.TypedExpr = typed_ast.TVar("f", ty, pos())

fn main() -> Unit !{IO} =
  run_suite("callee_purity", [
    check_eq("pure nullary call is pure",
      typed_ast.callee_is_pure(callee(types.TThunk(int_ty(), types.EffectPure)), 0), true),
    check_eq("effectful nullary call is not pure",
      typed_ast.callee_is_pure(callee(types.TThunk(int_ty(), types.EffectIO)), 0), false),
    check_eq("pure call with an argument is pure",
      typed_ast.callee_is_pure(callee(arrow_ty(types.EffectPure)), 1), true),
    check_eq("effectful call with an argument is not pure",
      typed_ast.callee_is_pure(callee(arrow_ty(types.EffectIO)), 1), false),
    check_eq("saturated curried call is not pure for an effect on the inner arrow",
      typed_ast.callee_is_pure(callee(curried_ty(types.EffectPure, types.EffectIO)), 2), false),
    check_eq("saturated curried call is pure when every arrow is pure",
      typed_ast.callee_is_pure(callee(curried_ty(types.EffectPure, types.EffectPure)), 2), true),
    # One argument against two arrows: the inner arrow is returned, not consumed,
    # so its effect has not happened yet.
    check_eq("partial application stops before the arrow it does not consume",
      typed_ast.callee_is_pure(callee(curried_ty(types.EffectPure, types.EffectIO)), 1), true)
  ])
