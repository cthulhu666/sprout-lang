module main
import stdlib.test (TestState, new_state, assert_eq, summary)

# Regression guard for module-qualified type identity — POLYMORPHIC / eta-expanded
# dispatch of a shadowed-type instance
# (docs/module-qualified-type-identity-design-2026-07-10.md §10).
#
# Complements test_type_name_collision_instance_dispatch.spr (a direct concrete call)
# by exercising the eta-expansion path: `to_string` is passed as a VALUE to list_map,
# so the compiler builds an eta-expanded dictionary for a main.Maybe value. That path
# runs is_type_var_name / first_concrete_head_str / head_is_concrete on the type head.
# With module-qualified identity the head is the dotted "main.Maybe"; a concreteness or
# type-variable check that reads the leading (lowercase) module component instead of the
# last segment would mis-resolve to a forwarded/null dict and SIGSEGV. Must print "WW".
type Maybe a = Wrap a

instance ToString (Maybe a) {
  fn to_string(m: Maybe a) -> String = "W"
}

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    assert_eq(state, "eta-expanded dispatch of shadowed instance",
      string_concat_many(list_map(to_string, Cons (Wrap(1), Cons (Wrap(2), Nil)))), "WW")
    summary(state)
