import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.compiler.unifier as unifier

# Regression test for the fresh-type-variable / user-identifier namespace
# invariant.
#
# `unifier.fresh` / `fresh_effect` mint compiler-internal type/effect
# variables. `infer.is_lowercase_name` only inspects the FIRST character of a
# TypeName, so a user type variable spelled like a bare fresh name (e.g. "t1")
# is wrongly accepted as a scheme-quantified variable. If a minted name ever
# equals a live user-written name in the same substitution, `apply_full_subst`'s
# transitive lookup fuses two type variables the user declared as independent
# (silent type confusion).
#
# Whether that runtime collision actually fires depends on the exact fresh
# counter value when a scheme is instantiated (it only lines up when the
# counter is very low, e.g. 0/1) — so a scenario-based test is fragile and
# non-discriminating once `check_program` seeds a builtin env that advances the
# counter. This test instead pins the INVARIANT the fix establishes: a fresh
# name must never be spellable as a Sprout identifier. The "$" prefix is
# illegal at identifier start (`string.is_ident_start` admits only [A-Za-z_]),
# so a "$"-prefixed name can never collide with any user identifier.

fn main() -> Unit !{IO} =
  do
    istate <- unifier.new_state()
    tv <- unifier.fresh(istate)
    ev <- unifier.fresh_effect(istate)
    state <- new_state()
    assert_true(
      state,
      "fresh type var is unspellable by users (\"$\"-prefixed)",
      str_find(tv, "$t") == 0
    )
    assert_true(
      state,
      "fresh effect var is unspellable by users (\"$\"-prefixed)",
      str_find(ev, "$e") == 0
    )
    summary(state)
