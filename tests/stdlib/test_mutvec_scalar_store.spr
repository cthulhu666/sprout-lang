import stdlib.test (TestState, new_state, assert_eq, summary)
import stdlib.mutable (MutVec, mutvec_new, mutvec_at, mutvec_set)

# Scalar stores through `mutvec_set` lower inline (scripts/b1_gate.sh checks the IR); these
# check that each element type reads back what was written, and that a neighbour is untouched.

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    ints <- mutvec_new(3, 0)
    mutvec_set(ints, 1, 42)
    i0 <- mutvec_at(ints, 0)
    i1 <- mutvec_at(ints, 1)
    assert_eq(state, "Int slot written", i1, 42)
    assert_eq(state, "Int neighbour untouched", i0, 0)

    bools <- mutvec_new(3, false)
    mutvec_set(bools, 2, true)
    b1 <- mutvec_at(bools, 1)
    b2 <- mutvec_at(bools, 2)
    assert_eq(state, "Bool slot written", b2, true)
    assert_eq(state, "Bool neighbour untouched", b1, false)

    chars <- mutvec_new(3, 'a')
    mutvec_set(chars, 0, 'z')
    c0 <- mutvec_at(chars, 0)
    c1 <- mutvec_at(chars, 1)
    assert_eq(state, "Char slot written", c0, 'z')
    assert_eq(state, "Char neighbour untouched", c1, 'a')

    doubles <- mutvec_new(3, 0.5)
    mutvec_set(doubles, 1, 2.25)
    d0 <- mutvec_at(doubles, 0)
    d1 <- mutvec_at(doubles, 1)
    assert_eq(state, "Double slot written", d1, 2.25)
    assert_eq(state, "Double neighbour untouched", d0, 0.5)

    strs <- mutvec_new(2, "x")
    mutvec_set(strs, 1, "y")
    s0 <- mutvec_at(strs, 0)
    s1 <- mutvec_at(strs, 1)
    assert_eq(state, "String slot written", s1, "y")
    assert_eq(state, "String neighbour untouched", s0, "x")

    summary(state)
