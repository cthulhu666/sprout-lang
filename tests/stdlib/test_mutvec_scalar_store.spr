import stdlib.test (TestState, new_state, assert_eq, summary)
import stdlib.mutable (MutVec, mutvec_new, mutvec_at, mutvec_set)

# Scalar stores through `mutvec_set` lower inline (scripts/b1_gate.sh checks the IR); these
# check that each element type reads back what was written, and that a neighbour is untouched.

# Locals named like the extern the `wsi` pass inserts (`vector_mutset`). The bundler renames
# them (docs/prelude-name-identity-v0.md §5), so the inserted call cannot be captured.
fn store_with_int_local(g: MutVec Int, vector_mutset: Int) -> Unit !{IO} =
  mutvec_set(g, 0, vector_mutset)

fn store_with_closure_local(g: MutVec Int, x: Int, vector_mutset: Int -> Int -> Int -> Int) -> Unit !{IO} =
  mutvec_set(g, 0, x + vector_mutset(1, 2, 3))

fn store_with_let_local(g: MutVec Int, x: Int) -> Unit !{IO} =
  let vector_mutset = x * 2
  in mutvec_set(g, 1, vector_mutset)

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    shadowed <- mutvec_new(2, 0)
    store_with_int_local(shadowed, 7)
    store_with_closure_local(shadowed, 5, \ (a, b, c) -> a + b + c)
    s0 <- mutvec_at(shadowed, 0)
    assert_eq(state, "closure local not called as the store", s0, 11)
    store_with_int_local(shadowed, 9)
    s0b <- mutvec_at(shadowed, 0)
    assert_eq(state, "Int local named vector_mutset stored", s0b, 9)
    store_with_let_local(shadowed, 4)
    s1 <- mutvec_at(shadowed, 1)
    assert_eq(state, "let local named vector_mutset stored", s1, 8)

    ints <- mutvec_new(3, 0)
    mutvec_set(ints, 1, 42)
    i0 <- mutvec_at(ints, 0)
    i1 <- mutvec_at(ints, 1)
    assert_eq(state, "Int slot written", i1, 42)
    assert_eq(state, "Int neighbour untouched", i0, 0)

    bools <- mutvec_new(3, false)
    mutvec_set(bools, 2, true)
    b1 <- mutvec_at(bools, 1)
    b2 <- mutvec_at(bools, 2)
    assert_eq(state, "Bool slot written", b2, true)
    assert_eq(state, "Bool neighbour untouched", b1, false)

    chars <- mutvec_new(3, 'a')
    mutvec_set(chars, 0, 'z')
    c0 <- mutvec_at(chars, 0)
    c1 <- mutvec_at(chars, 1)
    assert_eq(state, "Char slot written", c0, 'z')
    assert_eq(state, "Char neighbour untouched", c1, 'a')

    doubles <- mutvec_new(3, 0.5)
    mutvec_set(doubles, 1, 2.25)
    d0 <- mutvec_at(doubles, 0)
    d1 <- mutvec_at(doubles, 1)
    assert_eq(state, "Double slot written", d1, 2.25)
    assert_eq(state, "Double neighbour untouched", d0, 0.5)

    strs <- mutvec_new(2, "x")
    mutvec_set(strs, 1, "y")
    s0 <- mutvec_at(strs, 0)
    s1 <- mutvec_at(strs, 1)
    assert_eq(state, "String slot written", s1, "y")
    assert_eq(state, "String neighbour untouched", s0, "x")

    summary(state)
