# Behavioral lock for the Char representation campaign (Char-as-immediate-codepoint).
#
# Every observable Char behavior must stay identical across the representation
# flip (heap UTF-8 string -> immediate i64 codepoint).  This file is the
# regression guard: it passes under the current heap representation AND must keep
# passing after the flip.  It deliberately exercises the surfaces the flip
# touches:
#   - equality / inequality (str_eq path -> integer compare)
#   - pattern-match dispatch returning values (IRStrEq -> IRICmp)
#   - to_string / char_to_string / char_to_str encoding
#   - char_from_codepoint round-trip (encode -> identity)
#   - char_at / str_char_at result (Maybe Char return value flips ABI)
#   - a Char carried in a tuple
#   - a Char in a constructor field and a record field (field kind 'i', a scalar)
#   - MULTI-BYTE chars throughout (the swept-multi-byte-char UAF class)
import stdlib.string (char_at)
import stdlib.test (check_eq, check_true, check_false, run_suite)

# A Char beside a String in a constructor and in a record.
type Glyph = Glyph Char String
type Cell = (ch: Char, label: String)

fn glyph_char(g: Glyph) -> Char =
  match g with
  | Glyph c _ -> c

# One- to four-byte UTF-8 codepoints, so a misread field cannot pass by chance.
fn nth_char(i: Int) -> Char =
  match i - i / 4 * 4 with
  | 0 -> 'a'
  | 1 -> 'λ'
  | 2 -> '✓'
  | _ -> '😀'

fn label_of(i: Int, ch: Char) -> String = int_to_string(i) ++ "-" ++ to_string(ch)

# The i-th Glyph and Cell, sharing one Char and one label. Each call allocates,
# so collections run while the list of earlier ones is live.
fn fields_at(i: Int) -> (Int, Glyph, Cell) =
  let ch = nth_char(i)
      lbl = label_of(i, ch)
  in (i, Glyph(ch, lbl), Cell(ch = ch, label = lbl))

fn fields_intact(f: (Int, Glyph, Cell)) -> Bool =
  let (i, g, c) = f
      ch = nth_char(i)
  in glyph_char(g) == ch && c.ch == ch && (c with (label = "x")).ch == ch
     && c.label == label_of(i, ch)

# Non-trivial: builds a Maybe, compares the payload (not a trivial accessor).
fn char_at_eq(s: String, i: Int, expected: Char) -> Bool =
  match char_at(s, i) with
  | Just c -> c == expected
  | Nothing -> false

# Multi-arm Char dispatch including a multi-byte arm.
fn rank(c: Char) -> Int =
  match c with
  | 'a' -> 1
  | 'b' -> 2
  | 'λ' -> 3
  | _ -> 0

# Char carried inside a tuple, then destructured and compared.
fn pair_snd_is(c: Char) -> Bool =
  match ('x', c) with
  | (_, b) -> b == c

fn main() -> Unit !{IO} =
  run_suite("char_representation", [
    # Equality — ASCII
    check_true("eq a a", 'a' == 'a'),
    check_false("eq a b", 'a' == 'b'),
    check_true("ne a b", 'a' != 'b'),

    # Equality — multi-byte (2-byte UTF-8)
    check_true("eq lambda lambda", 'λ' == 'λ'),
    check_false("eq lambda a", 'λ' == 'a'),
    check_true("ne lambda a", 'λ' != 'a'),

    # Pattern dispatch returns the right value, incl. multi-byte arm + default
    check_eq("rank a", rank('a'), 1),
    check_eq("rank b", rank('b'), 2),
    check_eq("rank lambda", rank('λ'), 3),
    check_eq("rank default", rank('z'), 0),

    # to_string / char_to_string / char_to_str encoding
    check_eq("to_string a", to_string('a'), "a"),
    check_eq("char_to_string a", char_to_string('a'), "a"),
    check_eq("to_string lambda", to_string('λ'), "λ"),
    check_eq("char_to_str 97", char_to_str(97), "a"),
    check_eq("char_to_str 955", char_to_str(955), "λ"),

    # char_from_codepoint round-trip (encode today, identity after the flip)
    check_true("from_cp 97", char_from_codepoint(97) == 'a'),
    check_true("from_cp 955", char_from_codepoint(955) == 'λ'),
    check_true("from_cp 10003", char_from_codepoint(10003) == '✓'),

    # char_at / str_char_at result equality (Maybe Char ABI flips in Phase 2)
    check_true("char_at ascii", char_at_eq("abc", 1, 'b')),
    check_true("char_at multibyte", char_at_eq("aλb", 1, 'λ')),

    # Char in a tuple
    check_true("tuple snd ascii", pair_snd_is('q')),
    check_true("tuple snd multibyte", pair_snd_is('λ')),

    # Char in constructor and record fields, read back after collections
    check_true("ctor and record fields", all(fields_intact, [fields_at(i) for i in 0..4999])),

    # 4-byte / high-codepoint chars (U+1F600 = 128512) — the path most likely to
    # surprise the i64-codepoint flip.
    check_true("eq emoji emoji", '😀' == '😀'),
    check_false("eq emoji lambda", '😀' == 'λ'),
    check_eq("to_string emoji", to_string('😀'), "😀"),
    check_eq("char_to_str 128512", char_to_str(128512), "😀"),
    check_true("from_cp 128512", char_from_codepoint(128512) == '😀'),
    check_true("char_at emoji", char_at_eq("a😀b", 1, '😀')),

    # Ordering is by codepoint value and is preserved across UTF-8 byte widths.
    # (In Phase 2 this lowers to integer icmp on codepoints, replacing str_compare;
    # UTF-8 byte order and codepoint order coincide, so results are unchanged.)
    check_true("ord ascii lt 2byte", 'a' < 'λ'),
    check_true("ord 2byte lt 3byte", 'λ' < '✓'),
    check_true("ord 3byte lt 4byte", '✓' < '😀'),
    check_false("ord 4byte lt ascii", '😀' < 'a'),
    check_true("ord ge emoji ascii", '😀' >= 'a')
  ])
