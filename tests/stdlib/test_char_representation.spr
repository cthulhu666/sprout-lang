# Behavioral lock for the Char representation campaign (Char-as-immediate-codepoint).
#
# Every observable Char behavior must stay identical across the representation
# flip (heap UTF-8 string -> immediate i64 codepoint).  This file is the
# regression guard: it passes under the current heap representation AND must keep
# passing after the flip.  It deliberately exercises the surfaces the flip
# touches:
#   - equality / inequality (str_eq path -> integer compare)
#   - pattern-match dispatch returning values (IRStrEq -> IRICmp)
#   - to_string / char_to_string / char_to_str encoding
#   - char_from_codepoint round-trip (encode -> identity)
#   - char_at / str_char_at result (Maybe Char return value flips ABI)
#   - a Char carried in a tuple
#   - MULTI-BYTE chars throughout (the swept-multi-byte-char UAF class)
import stdlib.string (char_at)
import stdlib.test (TestState, new_state, assert_eq, assert_true, assert_false, summary)

# Non-trivial: builds a Maybe, compares the payload (not a trivial accessor).
fn char_at_eq(s: String, i: Int, expected: Char) -> Bool =
  match char_at(s, i) with
  | Just c -> c == expected
  | Nothing -> false

# Multi-arm Char dispatch including a multi-byte arm.
fn rank(c: Char) -> Int =
  match c with
  | 'a' -> 1
  | 'b' -> 2
  | 'λ' -> 3
  | _ -> 0

# Char carried inside a tuple, then destructured and compared.
fn pair_snd_is(c: Char) -> Bool =
  match ('x', c) with
  | (_, b) -> b == c

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # Equality — ASCII
    assert_true(state, "eq a a", 'a' == 'a')
    assert_false(state, "eq a b", 'a' == 'b')
    assert_true(state, "ne a b", 'a' != 'b')

    # Equality — multi-byte (2-byte UTF-8)
    assert_true(state, "eq lambda lambda", 'λ' == 'λ')
    assert_false(state, "eq lambda a", 'λ' == 'a')
    assert_true(state, "ne lambda a", 'λ' != 'a')

    # Pattern dispatch returns the right value, incl. multi-byte arm + default
    assert_eq(state, "rank a", rank('a'), 1)
    assert_eq(state, "rank b", rank('b'), 2)
    assert_eq(state, "rank lambda", rank('λ'), 3)
    assert_eq(state, "rank default", rank('z'), 0)

    # to_string / char_to_string / char_to_str encoding
    assert_eq(state, "to_string a", to_string('a'), "a")
    assert_eq(state, "char_to_string a", char_to_string('a'), "a")
    assert_eq(state, "to_string lambda", to_string('λ'), "λ")
    assert_eq(state, "char_to_str 97", char_to_str(97), "a")
    assert_eq(state, "char_to_str 955", char_to_str(955), "λ")

    # char_from_codepoint round-trip (encode today, identity after the flip)
    assert_true(state, "from_cp 97", char_from_codepoint(97) == 'a')
    assert_true(state, "from_cp 955", char_from_codepoint(955) == 'λ')
    assert_true(state, "from_cp 10003", char_from_codepoint(10003) == '✓')

    # char_at / str_char_at result equality (Maybe Char ABI flips in Phase 2)
    assert_true(state, "char_at ascii", char_at_eq("abc", 1, 'b'))
    assert_true(state, "char_at multibyte", char_at_eq("aλb", 1, 'λ'))

    # Char in a tuple
    assert_true(state, "tuple snd ascii", pair_snd_is('q'))
    assert_true(state, "tuple snd multibyte", pair_snd_is('λ'))

    # 4-byte / high-codepoint chars (U+1F600 = 128512) — the path most likely to
    # surprise the i64-codepoint flip.
    assert_true(state, "eq emoji emoji", '😀' == '😀')
    assert_false(state, "eq emoji lambda", '😀' == 'λ')
    assert_eq(state, "to_string emoji", to_string('😀'), "😀")
    assert_eq(state, "char_to_str 128512", char_to_str(128512), "😀")
    assert_true(state, "from_cp 128512", char_from_codepoint(128512) == '😀')
    assert_true(state, "char_at emoji", char_at_eq("a😀b", 1, '😀'))

    summary(state)
