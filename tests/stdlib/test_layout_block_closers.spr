# sprout-ignore-all lint/multi-line-lambda-arg: fixture — a do lambda closed by `)` or `,` is what it tests
# sprout-ignore-all lint/hand-rolled-combinator: fixture — the one-line match is the layout under test
import stdlib.test (TestState, new_state, assert_eq, summary)

# An implicit block also ends at a token that closes something opened before it:
# a bracket, a `,` inside one, `in`, `then`, `else`, a comprehension `if`. The layout pass closes the
# block there, so the token can do its job on the same line as the last step.

fn fold_with_do_lambda() -> Int =
  list_fold(\ (s, k) -> do
      let t = s + k
      t * 1, 0, [1, 2, 3])

fn do_in_middle_arg() -> Int =
  list_fold(\ (s, k) -> do
      let t = s + k
      t, 10, [1, 2])

fn match_closed_by_else(c: Bool, m: Maybe Int) -> Int =
  if c then match m with | Just v -> v | Nothing -> 0 else 7

fn match_closed_by_paren(m: Maybe Int) -> Int =
  1 + (match m with | Just v -> v | Nothing -> 0)

fn match_closed_by_guard(m: Maybe (List Int)) -> List Int =
  [x * 10 for x in match m with | Just xs -> xs | Nothing -> [] if x > 1]

fn let_closed_by_in() -> Int =
  let a = 1 in a + 1

fn one_line_let(n: Int) -> Int = let x = n + 1 in x + 10

fn after_one_line_let(n: Int) -> Int = n

# An `else` closes nothing its `if` needs: left of the `do`, it still takes the
# `if` that follows the operand `3` on the line before.
fn else_left_of_do(c: Bool) -> Int =
  do
    let k = 3
    if c then
      k
  else
      0

fn sum_at_one_two(f: Int -> Int) -> Int = f(1) + f(2)

# The same inside a do lambda passed as an argument: an `if` step there is no guard.
fn else_left_of_do_argument(c: Bool) -> Int =
  sum_at_one_two(\n -> do
      let k = n * 10
      if c then
        k
    else
        0)

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    assert_eq(state, "`)` and `,` close a do block on its last line", fold_with_do_lambda(), 6)
    assert_eq(state, "a do lambda as the first of several arguments", do_in_middle_arg(), 13)
    assert_eq(state, "`else` closes a one-line match", match_closed_by_else(true, Just(4)), 4)
    assert_eq(state, "`else` branch after a one-line match", match_closed_by_else(false, Just(4)), 7)
    assert_eq(state, "`)` closes a one-line match", match_closed_by_paren(Just(2)), 3)
    assert_eq(state, "a comprehension `if` closes a one-line match", match_closed_by_guard(Just([1, 2, 3])), [20, 30])
    assert_eq(state, "`in` closes a one-line let", let_closed_by_in(), 2)
    assert_eq(state, "a one-line let..in body, then a declaration", one_line_let(1) + after_one_line_let(5), 17)
    assert_eq(state, "an `else` left of the do", else_left_of_do(false), 0)
    assert_eq(state, "the `then` branch before it", else_left_of_do(true), 3)
    assert_eq(state, "an `else` left of a do lambda argument", else_left_of_do_argument(true), 30)
    assert_eq(state, "its `else` branch", else_left_of_do_argument(false), 0)
    summary(state)
