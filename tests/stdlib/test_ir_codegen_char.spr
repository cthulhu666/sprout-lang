import stdlib.test (check_eq, check_true, check_false, run_suite)

# M3 PR 12 — Char literal + char_to_string + CharPattern lowering.
#
# Sprout functions exercising the three Char sub-tasks:
#   1. TChar literal  — 'a' lowers to IRStrConst (mirrors TString).
#   2. char_to_string — explicit call to the prelude extern.
#   3. CharPattern    — match on a Char literal lowers to IRStrEq + IRCondBr.
#
# char_to_string is a non-intrinsic prelude extern, so it must resolve from the prelude.

# 0. A prelude extern (str_len), to keep prelude bundling deterministic.
fn len_of(s: String) -> Int = str_len(s)

# 1. TChar literal: returns the char value as a String via char_to_string.
fn char_as_string(c: Char) -> String =
  char_to_string(c)

# 2. Char literal: produce the 'a' constant directly.
let get_a: Char = 'a'

# 3. CharPattern in match: single-char dispatch.
fn is_a(c: Char) -> Bool =
  match c with
  | 'a' -> true
  | _ -> false

# 4. multi-arm CharPattern: returns an Int for each recognised char.
fn char_rank(c: Char) -> Int =
  match c with
  | 'a' -> 1
  | 'b' -> 2
  | 'c' -> 3
  | _ -> 0

fn main() -> Unit !{IO} =
  run_suite("ir_codegen_char", [
    check_eq("len_of", len_of("abc"), 3),
    check_eq("char_as_string", char_as_string('z'), "z"),
    check_eq("get_a through char_as_string", char_as_string(get_a), "a"),
    check_true("is_a 'a'", is_a('a')),
    check_false("is_a 'b'", is_a('b')),
    check_eq("char_rank a", char_rank('a'), 1),
    check_eq("char_rank b", char_rank('b'), 2),
    check_eq("char_rank c", char_rank('c'), 3),
    check_eq("char_rank other", char_rank('z'), 0)
  ])
