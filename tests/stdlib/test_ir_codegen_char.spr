# M3 PR 12 — Char literal + char_to_string + CharPattern lowering.
#
# Sprout functions exercising the three Char sub-tasks:
#   1. TChar literal  — 'a' lowers to IRStrConst (mirrors TString).
#   2. char_to_string — explicit call to the prelude extern.
#   3. CharPattern    — match on a Char literal lowers to IRStrEq + IRCondBr.
#
# Imports the prelude (via stdlib.string) so the non-intrinsic extern
# char_to_string resolves.  An importless file is self-contained and does NOT
# get the prelude, so a char_to_string call there is a hard "unresolved call"
# error (codegen.emit_named_call) rather than a silent zero_val.
import stdlib.string (str_len)

# 0. Use the import so it is not dead, and keep prelude bundling deterministic.
fn len_of(s: String) -> Int = str_len(s)

# 1. TChar literal: returns the char value as a String via char_to_string.
fn char_as_string(c: Char) -> String =
  char_to_string(c)

# 2. Char literal: produce the 'a' constant directly.
fn get_a() -> Char = 'a'

# 3. CharPattern in match: single-char dispatch.
fn is_a(c: Char) -> Bool =
  match c with
  | 'a' -> true
  | _ -> false

# 4. multi-arm CharPattern: returns an Int for each recognised char.
fn char_rank(c: Char) -> Int =
  match c with
  | 'a' -> 1
  | 'b' -> 2
  | 'c' -> 3
  | _ -> 0

fn main() -> Unit !{IO} = ()
