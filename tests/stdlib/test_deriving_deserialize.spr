import stdlib.test (TestState, new_state, assert_eq, summary)

# `deriving (Deserialize)` on a nullary-only ADT synthesizes an instance
# that recognizes "(CtorName)" inputs and returns Just(Ctor) or Nothing.
# Round-trips with `deriving (Serialize)` for the same type.

type Status (..) deriving (Serialize, Deserialize, Eq) =
  | Pending
  | Active
  | Closed

fn rt_status(s: Status) -> Maybe Status = deserialize(serialize(s))

fn just_eq(m: Maybe Status, expected: Status) -> Bool =
  match m with
  | Just s -> eq(s, expected)
  | Nothing -> false

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    # Recognises each ctor's S-expression form.
    assert_eq(state, "deserialize Pending", just_eq(deserialize("(Pending)"), Pending), true)
    assert_eq(state, "deserialize Active", just_eq(deserialize("(Active)"), Active), true)
    assert_eq(state, "deserialize Closed", just_eq(deserialize("(Closed)"), Closed), true)
    # Round-trips via serialize.
    assert_eq(state, "rt Pending", just_eq(rt_status(Pending), Pending), true)
    assert_eq(state, "rt Active", just_eq(rt_status(Active), Active), true)
    assert_eq(state, "rt Closed", just_eq(rt_status(Closed), Closed), true)
    # Malformed input -> Nothing.
    assert_eq(state, "bad input", just_eq(deserialize("(Foo)"), Pending), false)
    summary(state)
