import stdlib.test (TestState, new_state, assert_eq, assert_true, summary)

# IntRange is a Sprout value, not an opaque runtime handle (docs/ranges-v0.md
# Appendix B, reversed). These tests pin the two things that only become true once
# the representation moves into Sprout, so they fail against the extern version:
#
#  1. It can be PATTERN MATCHED. Against the extern `IntRange` there is no
#     constructor to match, so `match r with | IntRange s e st -> ...` does not
#     compile at all.
#  2. The constructor is directly constructible, and therefore constructible
#     WRONG — the `tcp_fail` in `int_range_by` that rejected a step outside
#     {+1, -1} has no Sprout equivalent, because prelude constructors are in
#     scope everywhere regardless of `(..)` (the prelude is inlined, not
#     imported). A malformed step must therefore be survivable rather than
#     fatal: the walkers stop on "past the end" as well as "at the end", so a
#     step that skips over the end terminates instead of running to Int overflow.
#
# (2) is the safety property that the C validation used to provide for free. It
# is tested here because it is the one thing this change makes WORSE if the
# walkers are not written for it, and the failure mode is a hang rather than a
# wrong answer.

fn add_all(acc: Int, x: Int) -> Int = acc + x

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # 1. Destructuring — impossible while IntRange is an extern type.
    let r = range_up(2, 6)

    assert_eq(state, "an ascending range destructures to its three fields",
      match r with
      | IntRange s e st -> s + e + st,
      2 + 6 + 1)

    assert_eq(state, "a descending range carries step -1 in the value",
      match range_down(6, 2) with
      | IntRange _ _ st -> st,
      -1)

    # The accessors agree with the fields they read.
    assert_eq(state, "range_start agrees with the first field", range_start(r), 2)
    assert_eq(state, "range_end agrees with the second field", range_end(r), 6)
    assert_eq(state, "range_step agrees with the third field", range_step(r), 1)

    # 2. A malformed step is constructible now, and is NORMALIZED to its sign
    # rather than honoured.
    #
    # Honouring it would be the worse choice, and not merely because the docs say
    # step is +1 or -1. A step of 4 from 1 lands on 1, 5, 9 — it never *equals* the
    # end bound, so `range_at_end` (exact equality) cannot fire, and near MAX_INT
    # `current + step` would jump over the end, wrap negative, and leave
    # `range_past_end` permanently false: a hang. Normalizing in `range_step`
    # keeps every walker seeing +1 or -1, which is exactly the condition under
    # which the boundary guard is sound.
    let skipping = IntRange(1, 6, 4)

    assert_eq(state, "an oversized step is normalized to +1, not honoured",
      range_step(skipping), 1)

    assert_eq(state, "so it walks every element in between",
      range_fold(add_all, 0, skipping), 1 + 2 + 3 + 4 + 5 + 6)

    assert_eq(state, "an oversized negative step normalizes to -1",
      range_step(IntRange(6, 1, 0 - 4)), -1)

    # A zero step cannot advance at all, so it cannot mean "descending"; it
    # normalizes upward like any non-negative step.
    assert_eq(state, "a zero step normalizes to +1 rather than stalling",
      range_step(IntRange(1, 6, 0)), 1)

    assert_eq(state, "and therefore walks normally instead of hanging",
      range_count(IntRange(1, 6, 0)), 6)

    # 3. Stringification carries the direction. Without it the two ranges below —
    # one with five elements, one with none — are indistinguishable as text.
    assert_eq(state, "to_string shows the step, so direction survives",
      to_string(range_up(1, 5)), "IntRange(1, 5, 1)")

    assert_eq(state, "and the empty descending range over the same bounds differs",
      to_string(range_down(1, 5)), "IntRange(1, 5, -1)")

    summary(state)
