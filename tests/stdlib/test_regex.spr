import stdlib.test (check_eq, check_true, check_false, run_suite)
import stdlib.regex as regex
# The Match constructor is needed unqualified to destructure find_first's result in a pattern.
import stdlib.regex (Match)

fn compile_ok(pattern: String) -> Bool =
  match regex.compile(pattern) with
  | Ok _ -> true
  | Err _ -> false

fn is_match(pattern: String, text: String) -> Bool =
  match regex.compile(pattern) with
  | Ok re -> regex.is_match(re, text)
  | Err _ -> false

fn find_some(pattern: String, text: String) -> Bool =
  match regex.compile(pattern) with
  | Ok re ->
      match regex.find_first(re, text) with
      | Just _ -> true
      | Nothing -> false
  | Err _ -> false

# -1 rather than a Maybe so a missing match is a visibly wrong number in the failure message.
fn match_start(pattern: String, text: String) -> Int =
  match regex.compile(pattern) with
  | Ok re ->
      match regex.find_first(re, text) with
      | Just (Match start _) -> start
      | Nothing -> 0 - 1
  | Err _ -> 0 - 2

fn match_end(pattern: String, text: String) -> Int =
  match regex.compile(pattern) with
  | Ok re ->
      match regex.find_first(re, text) with
      | Just (Match _ end) -> end
      | Nothing -> 0 - 1
  | Err _ -> 0 - 2

fn split_before(pattern: String, text: String) -> String =
  match regex.compile(pattern) with
  | Ok re ->
      match regex.split_first(re, text) with
      | Just (before, _) -> before
      | Nothing -> "no-match"
  | Err _ -> "compile-error"

fn split_after(pattern: String, text: String) -> String =
  match regex.compile(pattern) with
  | Ok re ->
      match regex.split_first(re, text) with
      | Just (_, after) -> after
      | Nothing -> "no-match"
  | Err _ -> "compile-error"

fn replace(pattern: String, replacement: String, text: String) -> String =
  match regex.compile(pattern) with
  | Ok re -> regex.replace_all_literal(re, replacement, text)
  | Err _ -> "compile-error"

fn main() -> Unit !{IO} =
  run_suite("regex", [
    check_true("compile valid digit pattern", compile_ok("[0-9]+")),
    check_true("compile valid word pattern", compile_ok("[A-Za-z_][A-Za-z0-9_]*")),
    check_false("compile invalid unclosed bracket", compile_ok("[invalid")),

    check_true("is_match digits found", is_match("[0-9]+", "abc 42 def")),
    check_false("is_match digits not found", is_match("[0-9]+", "hello world")),
    check_true("is_match uppercase ticket id", is_match("[A-Z][A-Z]-[0-9]+", "ticket=AB-42")),
    check_false("is_match no ticket id", is_match("[A-Z][A-Z]-[0-9]+", "no match here")),

    check_true("find_first found", find_some("[0-9]+", "abc 42 def")),
    check_false("find_first not found", find_some("[0-9]+", "hello")),

    check_eq("replace_all single", replace("[0-9]+", "NUM", "foo 42 baz"), "foo NUM baz"),
    check_eq("replace_all multiple", replace("[0-9]+", "NUM", "a 1 b 22 c 333"), "a NUM b NUM c NUM"),
    check_eq("replace_all no match", replace("[0-9]+", "NUM", "no digits"), "no digits"),

    check_eq("escape literal chars", regex.escape("[A-Z]+"), "\\[A\\-Z\\]\\+"),
    check_eq("escape plain string unchanged", regex.escape("hello"), "hello"),

    # --- non-ASCII text (this suite had no non-ASCII coverage at all) ---
    # The native engine is POSIX regexec, which reports rm_so/rm_eo as BYTE offsets, while
    # `split_first` feeds them to `str_slice`, which is CODEPOINT-indexed. The runtime bridges the two
    # with sprout_utf8_codepoint_prefix_count; these checks are what pin that conversion, because on
    # ASCII text the two offsets are identical and nothing here could tell them apart.
    #
    # `café ` is 5 codepoints and 6 bytes, so the match offset differs between the two spaces by
    # exactly one — asserted as a number rather than as "it worked".
    check_eq("match start is a codepoint offset, not a byte offset",
      match_start("[0-9]+", "café 42"), 5),
    check_eq("match end is a codepoint offset", match_end("[0-9]+", "café 42"), 7),
    # A ZERO-WIDTH match, which is where a Match span and an IntRange disagree most
    # sharply: `Match(0, 0)` is an EMPTY half-open span, while the IntRange this
    # span used to be carried in is inclusive, so the same pair of numbers means
    # "one element" there. The distinction was unobservable only because
    # match_from_range threw the range away immediately; these pin start == end as
    # a real, reachable result rather than a degenerate one.
    check_eq("a zero-width match starts where it ends", match_start("x*", "abc"), 0),
    check_eq("a zero-width match ends where it starts", match_end("x*", "abc"), 0),
    check_true("a zero-width match is still a match", find_some("x*", "abc")),
    # split_first is where a byte/codepoint mix-up would corrupt output rather than just shift a
    # number: the prefix would keep a stray continuation byte and the suffix would lose one.
    check_eq("split_first prefix keeps the multi-byte character whole",
      split_before("[0-9]+", "café 42 tail"), "café "),
    check_eq("split_first suffix starts after the match",
      split_after("[0-9]+", "café 42 tail"), " tail"),
    # A 4-byte character (3 bytes of drift) before the match, so an off-by-one bridge would not pass.
    check_eq("match start after a 4-byte character", match_start("[0-9]+", "🌱 7"), 2),
    # Matching and replacing must leave non-ASCII text byte-for-byte intact.
    check_true("is_match over non-ASCII text", is_match("caf", "café")),
    check_eq("replace_all preserves surrounding non-ASCII",
      replace("[0-9]+", "N", "日本 42 語"), "日本 N 語"),
    check_eq("escape leaves non-ASCII unchanged", regex.escape("café"), "café")
  ])
