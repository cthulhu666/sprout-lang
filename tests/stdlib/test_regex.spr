import stdlib.test (check_eq, check_true, check_false, run_suite)
import stdlib.regex as regex

fn compile_ok(pattern: String) -> Bool =
  match regex.compile(pattern) with
  | Ok _ -> true
  | Err _ -> false

fn is_match(pattern: String, text: String) -> Bool =
  match regex.compile(pattern) with
  | Ok re -> regex.is_match(re, text)
  | Err _ -> false

fn find_some(pattern: String, text: String) -> Bool =
  match regex.compile(pattern) with
  | Ok re ->
      match regex.find_first(re, text) with
      | Just _ -> true
      | Nothing -> false
  | Err _ -> false

fn replace(pattern: String, replacement: String, text: String) -> String =
  match regex.compile(pattern) with
  | Ok re -> regex.replace_all_literal(re, replacement, text)
  | Err _ -> "compile-error"

fn main() -> Unit !{IO} =
  run_suite("regex", [
    check_true("compile valid digit pattern", compile_ok("[0-9]+")),
    check_true("compile valid word pattern", compile_ok("[A-Za-z_][A-Za-z0-9_]*")),
    check_false("compile invalid unclosed bracket", compile_ok("[invalid")),

    check_true("is_match digits found", is_match("[0-9]+", "abc 42 def")),
    check_false("is_match digits not found", is_match("[0-9]+", "hello world")),
    check_true("is_match uppercase ticket id", is_match("[A-Z][A-Z]-[0-9]+", "ticket=AB-42")),
    check_false("is_match no ticket id", is_match("[A-Z][A-Z]-[0-9]+", "no match here")),

    check_true("find_first found", find_some("[0-9]+", "abc 42 def")),
    check_false("find_first not found", find_some("[0-9]+", "hello")),

    check_eq("replace_all single", replace("[0-9]+", "NUM", "foo 42 baz"), "foo NUM baz"),
    check_eq("replace_all multiple", replace("[0-9]+", "NUM", "a 1 b 22 c 333"), "a NUM b NUM c NUM"),
    check_eq("replace_all no match", replace("[0-9]+", "NUM", "no digits"), "no digits"),

    check_eq("escape literal chars", regex.escape("[A-Z]+"), "\\[A\\-Z\\]\\+"),
    check_eq("escape plain string unchanged", regex.escape("hello"), "hello")
  ])
