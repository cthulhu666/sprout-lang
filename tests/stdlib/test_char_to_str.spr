import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.string as string

# `char_to_str` encodes a codepoint at each edge of the 1-, 2-, 3- and 4-byte UTF-8 forms, and
# on both sides of the surrogate gap, to the same bytes `char_to_string` gives.

# (codepoint, UTF-8 width): first and last of each form, and 55295 / 57344 around the surrogates.
let edges = [(1, 1), (127, 1), (128, 2), (2047, 2), (2048, 3), (55295, 3), (57344, 3), (65535, 3),
             (65536, 4), (1114111, 4)]

fn check_edge(state: TestState, edge: (Int, Int)) -> Unit !{IO} =
  let (cp, width) = edge in
  assert_true(state, `${cp} is a ${width}-byte form`,
              string.byte_length(char_to_str(cp)) == width
                && char_to_str(cp) == char_to_string(char_from_codepoint(cp)))

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    list_each(\edge -> check_edge(state, edge), edges)
    summary(state)
