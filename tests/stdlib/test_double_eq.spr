import stdlib.test (check_true, check_false, run_suite)

# TDD — `==` / `!=` on Double.
#
# Ordering comparisons (`< <= > >=`) on Double route through check_compare and
# already work (ordered fcmp).  But `==`/`!=` route through check_eq, whose
# is_primitive_eq_type short-circuit listed only Int/Bool/Char/String — Double
# fell through to the Eq typeclass, which has no Double instance, so `3.0 == 3.0`
# failed with "No instance of Eq for Double".  Codegen was already ready
# (float_cmp_predicate maps == -> oeq, != -> one); the fix is adding Double to
# is_primitive_eq_type.  RED until that lands.
#
# Uses only values that are exactly representable in IEEE-754 double, so the
# equality checks are deterministic (no rounding surprises).
#
# An `Eq Double` instance has since landed (docs/eq-ord-double-v0.md), so the
# "has no Double instance" above is history, not current state. This file still
# covers only the OPERATOR path, which the instance does not touch — the
# short-circuit above means `==` never reaches the class. The class is covered by
# test_double_ord.spr, which asserts the two disagree at NaN.

fn main() -> Unit !{IO} =
  run_suite("double_eq", [
    # --- == on Double (RED today) ---
    check_true("3.0 == 3.0", 3.0 == 3.0),
    check_false("3.0 == 4.0", 3.0 == 4.0),
    check_true("0.5 == 0.5", 0.5 == 0.5),
    check_true("arithmetic result equality: 1.0 + 2.0 == 3.0", 1.0 + 2.0 == 3.0),

    # --- != on Double (lowers to !(oeq); the != path wraps in TUnary "!") ---
    check_true("3.0 != 4.0", 3.0 != 4.0),
    check_false("3.0 != 3.0", 3.0 != 3.0)
  ])
