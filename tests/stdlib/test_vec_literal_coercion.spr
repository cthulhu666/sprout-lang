import stdlib.test (TestState, new_state, assert_eq, summary)
import stdlib.collections (Vec, foldable_to_vec, vec_get_or, vec_sum_by)

# A Vec-typed parameter, exercised below with a bare list literal at the call
# site — the coercion inserts vec_from_list around the [..] literal.
fn sum3(v: Vec Int) -> Int =
  vec_get_or(0, 0, v) + vec_get_or(1, 0, v) + vec_get_or(2, 0, v)

fn vlen(v: Vec Int) -> Int =
  vec_sum_by(\_ -> 1, v)

# Vec-typed return position — the function body is a bare list literal, coerced
# at the return-type context.
fn make_vec() -> Vec Int =
  [10, 20, 30]

# Empty list literal in Vec context exercises the Nil head-shape.
fn empty_vec() -> Vec Int =
  []

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # Coercion at a call argument: [1,2,3] : List Int flows into a Vec Int slot.
    assert_eq(state, "vec literal arg", sum3([1, 2, 3]), 6)

    # Coercion at fn-return position.
    assert_eq(state, "vec literal return len", vlen(make_vec()), 3)
    assert_eq(state, "vec literal return elem", vec_get_or(1, -1, make_vec()), 20)

    # Empty list literal -> empty Vec.
    assert_eq(state, "empty vec literal len", vlen(empty_vec()), 0)

    # Negative guard: a real Vec value passes through unwrapped (no double-wrap
    # into vec_from_list(vec), which would be a type error).
    let real = foldable_to_vec([7, 8, 9])
    assert_eq(state, "real vec passthrough", sum3(real), 24)

    summary(state)
