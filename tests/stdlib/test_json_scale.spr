import stdlib.test (TestState, new_state, assert_true, summary)
import stdlib.json as json
import stdlib.string as string
import testsupport.cost (assert_scales, grow)

# Large JSON inputs: an HTTP or LSP body is untrusted, and 1 MiB of it must neither crash the
# process nor cost more than linear time.

# 2^19 elements is about 1 MiB of `[0,1,…]`. The array and object builders used to recurse once
# per element, so this size overflowed the stack and killed the process.
let many = 524288

fn int_list(n: Int) -> List String =
  list_map(int_to_string, ints(n))

# `[0,1,…,n-1]`
fn array_text(n: Int) -> String =
  "[" ++ string.join(",", int_list(n)) ++ "]"

# `{"k":0,"k":1,…}` — duplicate keys are legal JSON and keep the input small.
fn object_text(n: Int) -> String =
  "{" ++ string.join(",", list_map(\i -> "\"k\":" ++ i, int_list(n))) ++ "}"

# Walks the array checking element i is i, so order is checked as well as length.
fn array_in_order(arr: json.JsonArray, i: Int) -> Int =
  match arr with
  | json.JsonArrayNil -> i
  | json.JsonArrayCons (json.JsonInt v) rest -> if v == i then array_in_order(rest, i + 1) else -1
  | json.JsonArrayCons _ _ -> -1

fn object_in_order(obj: json.JsonObject, i: Int) -> Int =
  match obj with
  | json.JsonObjectNil -> i
  | json.JsonObjectCons "k" (json.JsonInt v) rest -> if v == i then object_in_order(rest, i + 1) else -1
  | json.JsonObjectCons _ _ _ -> -1

fn ints(n: Int) -> List Int =
  range_to_list(range_up(0, n - 1))

fn built_array(n: Int) -> json.JsonArray =
  match json.array_from_list(list_map(json.int, ints(n))) with
  | json.JsonArray arr -> arr
  | _ -> json.JsonArrayNil

fn built_object(n: Int) -> json.JsonObject =
  match json.object_from_pairs(list_map(\i -> ("k", i), ints(n))) with
  | json.JsonObject obj -> obj
  | _ -> json.JsonObjectNil

fn array_count(raw: String) -> Int =
  match json.parse(raw) with
  | Ok (json.JsonArray arr) -> array_in_order(arr, 0)
  | _ -> -1

fn object_count(raw: String) -> Int =
  match json.parse(raw) with
  | Ok (json.JsonObject obj) -> object_in_order(obj, 0)
  | _ -> -1

# A string literal of 2^k repeats of `a\n`. Each escape appended to the decoded string used to copy
# everything decoded so far.
fn escaped_literal(k: Int) -> (String, String) =
  ("\"" ++ grow("a\\n", k) ++ "\"", grow("a\n", k))

# 2^k surrogate pairs `\ud83d\ude00` (U+1F600), which take the `\u` path of the escape step.
fn pair_literal(k: Int) -> (String, String) =
  ("\"" ++ grow("\\ud83d\\ude00", k) ++ "\"", grow("😀", k))

# 2^k valid escapes, then `\x`: the failure at the end of a long run must still reach the caller.
fn bad_tail_literal(k: Int) -> String =
  "\"" ++ grow("\\n", k) ++ "\\x\""

fn rejects(raw: String) -> Bool =
  match json.parse(raw) with
  | Ok _ -> false
  | Err _ -> true

fn decodes(case: (String, String)) -> Bool =
  match case with
  | (raw, expected) ->
      match json.parse(raw) with
      | Ok (json.JsonString s) -> s == expected
      | _ -> false

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    # 64x more input: linear ~64x, quadratic ~4000x. CI runs this under SPROUT_GC_HDRCHECK=1, where
    # `str_byte_len` is O(n), so the parser must not read it per byte (docs/gates.md §ratio arms).
    assert_scales(state, "string escapes", decodes, escaped_literal(9), escaped_literal(15), 400)
    # The escape step and the run loop tail-call each other, and the run loop also calls itself:
    # when that cycle was not compiled as a loop, 2^15 escapes (64 KiB) overflowed the stack.
    assert_true(state, "a string of 2^17 escapes parses", decodes(escaped_literal(17)))
    assert_true(state, "a string of 2^17 surrogate pairs parses", decodes(pair_literal(17)))
    assert_true(state, "a bad escape after 2^17 good ones is rejected", rejects(bad_tail_literal(17)))
    assert_true(state, "a 2^19-element array parses in order", array_count(array_text(many)) == many)
    assert_true(state, "a 2^19-member object parses in order", object_count(object_text(many)) == many)
    assert_true(state, "array_from_list keeps 2^19 elements in order",
                array_in_order(built_array(many), 0) == many)
    assert_true(state, "object_from_pairs keeps 2^19 members in order",
                object_in_order(built_object(many), 0) == many)
    summary(state)
