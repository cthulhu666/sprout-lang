import stdlib.test (check_eq, check_true, run_suite)

# Regression net for hole reuse under the occupancy-map collector.
#
# The sweep (`sprout_holes_sweep_region`) clears the `occ` bits of dead slots,
# which makes them holes, and `sprout_holes_take` hands them to the allocator.
# Two cases pinned down here, both of which produce a WRONG hole set rather
# than an obvious crash:
#
#   1. A slot freed in an EARLIER cycle is still a hole in this one. A sweep
#      that re-marks it occupied silently shrinks the hole set, so the
#      allocator stops reusing memory the process already owns.
#   2. A region the sweep empties is released (`sprout_sweep_release_regions`),
#      so no cursor or freed-tail entry may still point into it.
#
# Neither is observable from Sprout as a wrong value, so this file's job is to
# DRIVE those states, not to assert on them: the anchors keep regions non-empty
# across collections (so they are retained, not released), two churn rounds
# leave holes across a cycle boundary, and every size class is then
# re-allocated. The invariant itself is checked by the runtime, under
# SPROUT_FL_VERIFY=1 (`g_holes_verify`).
#
# WHAT THE ASSERTIONS BELOW ARE WORTH: they confirm the churn ran and values
# round-tripped. They do not look at the hole set, so on their own this file is a
# workload, not a test. `just test-stress` and `just test-freelist-verify` set
# SPROUT_FL_VERIFY=1, which is the check.
#
# This file deliberately keeps a SMALL heap so it can run under
# SPROUT_GC_STRESS=1 (collect on every allocation) where the number of sweeps is
# maximal. The consequence is that `sprout_sweep_release_regions` barely
# releases any region here, so case 2 is only weakly covered:
# `test_gc_region_release.spr` drives it with a multi-region heap at the
# default threshold.

type Shape (..) =
  | S0
  | S1 Int
  | S3 Int Int Int
  | S7 Int Int Int Int Int Int Int

fn shape_sum(s: Shape) -> Int =
  match s with
  | S7 a b c d e f g -> a + b + c + d + e + f + g
  | S3 a b c -> a + b + c
  | S1 a -> a
  | S0 -> 0

# One round of garbage spread over four OBJ slot classes and two CSTR classes,
# so several size classes of holes open at once rather than just one.
fn churn(n: Int, acc: Int) -> Int =
  if n <= 0 then acc
  else churn(n - 1,
    acc
      + shape_sum(S0)
      + shape_sum(S1(1))
      + shape_sum(S3(1, 1, 1))
      + shape_sum(S7(1, 1, 1, 1, 1, 1, 1))
      + str_len("k" ++ int_to_string(n))
      + str_len("longer-key-" ++ int_to_string(n)))

fn main() -> Unit !{IO} =
  # Allocated before any churn, and live to the end: these keep their regions
  # from being released, so those regions are swept and kept.
  let anchor0 = S0
      anchor1 = S1(11)
      anchor3 = S3(1, 2, 3)
      anchor7 = S7(1, 2, 3, 4, 5, 6, 7)
      anchor_s = "anchor-" ++ int_to_string(99)
      # Round 1 leaves free slots in every class it touched.
      round1 = churn(4000, 0)
      # Round 2 runs with round 1's slots ALREADY free: a sweep that only reuses
      # the slots it frees this cycle loses them permanently.
      round2 = churn(4000, 0)
      # Fresh allocations must come back out of those reused slots intact.
      fresh0 = S0
      fresh1 = S1(77)
      fresh3 = S3(10, 20, 30)
      fresh7 = S7(7, 7, 7, 7, 7, 7, 7)
      fresh_s = "fresh-" ++ int_to_string(5)
  in
  run_suite("gc_freelist_reuse", [
    check_true("round 1 churn ran", round1 > 0),
    check_eq("both churn rounds agree", round1, round2),

    check_eq("anchor S0 survives both rounds", shape_sum(anchor0), 0),
    check_eq("anchor S1 survives both rounds", shape_sum(anchor1), 11),
    check_eq("anchor S3 survives both rounds", shape_sum(anchor3), 6),
    check_eq("anchor S7 survives both rounds", shape_sum(anchor7), 28),
    check_eq("anchor string survives both rounds", anchor_s, "anchor-99"),

    check_eq("S0 reused from a hole", shape_sum(fresh0), 0),
    check_eq("S1 reused from a hole", shape_sum(fresh1), 77),
    check_eq("S3 reused from a hole", shape_sum(fresh3), 60),
    check_eq("S7 reused from a hole", shape_sum(fresh7), 49),
    check_eq("CSTR reused from a hole", fresh_s, "fresh-5")
  ])
