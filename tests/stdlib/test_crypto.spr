import stdlib.test (check_eq, check_true, check_false, run_suite)
import stdlib.crypto as crypto
import stdlib.bytes as bytes

# stdlib.crypto had NO test coverage anywhere in tests/ — only a passing mention in
# examples/io_result_do_demo.sprout. This closes that gap (AGENTS.md "What tests to
# write" #3) ahead of removing the duplicate crypto_* extern declarations from the
# prelude.
#
# It also pins the property that removal depends on: every call here goes through
# `import stdlib.crypto`, so the suite proves the module is self-sufficient without
# the prelude's copies. That failure mode is otherwise silent — externs are invisible
# to the module system (bundler.sprout:597), so a missing declaration surfaces as an
# `Unknown variable` or a link error rather than a scoping diagnostic.
#
# Digests are compared as base64 rather than hex so no hex helper is needed. Every
# expected value below was generated locally, not recalled:
#   printf 'abc' | openssl dgst -sha256 -binary | openssl base64
#   printf 'what do ya want for nothing?' | openssl dgst -sha256 -hmac 'Jefe' -binary | openssl base64
#   printf 'foobar' | openssl base64

fn sha256_b64(text: String) -> String =
  crypto.base64_encode(crypto.sha256(bytes.from_string(text)))

fn hmac_b64(key: String, message: String) -> String =
  crypto.base64_encode(crypto.hmac_sha256(bytes.from_string(key), bytes.from_string(message)))

fn encode(text: String) -> String =
  crypto.base64_encode(bytes.from_string(text))

# Decode back to text so a padding or alphabet bug shows as corrupted output rather
# than as an opaque Bytes comparison.
fn roundtrip(text: String) -> String =
  match crypto.base64_decode(crypto.base64_encode(bytes.from_string(text))) with
  | Ok raw ->
      match bytes.to_string(raw) with
      | Ok back -> back
      | Err _ -> "utf8-error"
  | Err _ -> "decode-error"

fn decode_rejects(raw: String) -> Bool =
  match crypto.base64_decode(raw) with
  | Ok _ -> false
  | Err _ -> true

fn url_encode(text: String) -> String =
  crypto.base64url_encode(bytes.from_string(text))

# 0xfb 0xff encodes as "+/8=" in the standard alphabet, so it exercises both swapped
# characters and the dropped padding.
let plus_slash: Bytes = bytes.append(bytes.singleton(251), bytes.singleton(255))

fn url_decodes_to(raw: String, want: Bytes) -> Bool =
  match crypto.base64url_decode(raw) with
  | Ok out -> out == want
  | Err _ -> false

fn url_decode_rejects(raw: String) -> Bool =
  match crypto.base64url_decode(raw) with
  | Ok _ -> false
  | Err _ -> true

fn url_roundtrips(value: Bytes) -> Bool =
  url_decodes_to(crypto.base64url_encode(value), value)

fn xor_b64(left: String, right: String) -> String =
  match crypto.bytes_xor(bytes.from_string(left), bytes.from_string(right)) with
  | Ok out -> crypto.base64_encode(out)
  | Err _ -> "xor-error"

fn xor_length_mismatch_errs() -> Bool =
  match crypto.bytes_xor(bytes.from_string("ab"), bytes.from_string("abc")) with
  | Ok _ -> false
  | Err _ -> true

fn ct_eq(left: String, right: String) -> Bool =
  crypto.const_time_eq(bytes.from_string(left), bytes.from_string(right))

let tag: Bytes =
  crypto.hmac_sha256(bytes.from_string("key"), bytes.from_string("message"))

# The accept path at the length the function is actually used on. It pins no fold
# boundary — a self-XOR is all zeros, so any subrange of it ORs to zero.
fn tag_matches_itself() -> Bool =
  crypto.const_time_eq(tag, tag)

# The far end of a real 32-byte tag. The short-string cases pin both ends at length
# 3; this is the only case that fails if the fold stops one byte early at tag length.
fn tag_rejects_a_changed_last_byte() -> Bool =
  let full = tag
  in let last = maybe_with_default(0, bytes.get(full, bytes.length(full) - 1))
  in let altered = bytes.append(bytes.drop_last(full, 1),
       bytes.singleton(if last == 0 then 1 else 0))
  in crypto.const_time_eq(full, altered)

# A tag for a different message differs in about half its bytes, so this says only
# that an unrelated tag is refused — not that any particular byte is read.
fn tag_rejects_a_different_message() -> Bool =
  crypto.const_time_eq(tag,
    crypto.hmac_sha256(bytes.from_string("key"), bytes.from_string("messagf")))

fn main() -> Unit !{IO} =
  run_suite("crypto", [
    # --- SHA-256 (RFC 6234 vectors) ---
    check_eq("sha256 of \"abc\"", sha256_b64("abc"),
      "ungWv48Bz+pBQUDeXa4iI7ADYaOWF3qctBD/YfIAFa0="),
    # The empty input is the case a length-prefix or padding bug breaks first.
    check_eq("sha256 of the empty string", sha256_b64(""),
      "47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU="),

    # --- HMAC-SHA256 (RFC 4231 test case 2) ---
    # Argument order matters and is not symmetric: swapping key and message yields a
    # different digest, so this pins the parameter order against the C, which is the
    # exact defect class that put regex_replace_all_literal wrong in the prelude.
    check_eq("hmac_sha256 key=Jefe", hmac_b64("Jefe", "what do ya want for nothing?"),
      "W9zBRr9gdU5qBCQmCJV1x1oAPwidJzmDnexYuWTsOEM="),

    # --- base64 (RFC 4648 vectors, covering all three padding lengths) ---
    check_eq("base64 no padding", encode("foobar"), "Zm9vYmFy"),
    check_eq("base64 one pad char", encode("Hi"), "SGk="),
    check_eq("base64 empty input", encode(""), ""),

    check_eq("base64 round-trips ASCII", roundtrip("foobar"), "foobar"),
    check_eq("base64 round-trips non-ASCII", roundtrip("café 日本"), "café 日本"),
    check_true("base64_decode rejects a non-alphabet character", decode_rejects("Zm9v*mFy")),

    # --- base64url (RFC 4648 section 5, unpadded; decode is strict) ---
    check_eq("base64url empty input", url_encode(""), ""),
    check_eq("base64url one byte", url_encode("f"), "Zg"),
    check_eq("base64url two bytes", url_encode("fo"), "Zm8"),
    check_eq("base64url three bytes", url_encode("foo"), "Zm9v"),
    check_eq("base64url four bytes", url_encode("foob"), "Zm9vYg"),
    check_eq("base64url uses - and _, no padding", crypto.base64url_encode(plus_slash), "-_8"),
    check_true("base64url_decode accepts unpadded", url_decodes_to("Zm9vYg", bytes.from_string("foob"))),
    check_true("base64url_decode accepts padded", url_decodes_to("Zm9vYg==", bytes.from_string("foob"))),
    check_true("base64url_decode reads - and _", url_decodes_to("-_8", plus_slash)),
    check_true("base64url_decode accepts the empty string", url_decodes_to("", bytes.empty())),
    check_true("base64url round-trips - and _ bytes", url_roundtrips(plus_slash)),
    check_true("base64url round-trips ASCII", url_roundtrips(bytes.from_string("foobar"))),
    check_true("base64url round-trips a 32-byte tag", url_roundtrips(tag)),
    check_true("base64url_decode rejects the standard alphabet", url_decode_rejects("+/8")),
    check_true("base64url_decode rejects an impossible final group", url_decode_rejects("Z")),
    check_true("base64url_decode rejects padding off a multiple of 4", url_decode_rejects("Zm9vYg=")),
    check_true("base64url_decode rejects = mid-string", url_decode_rejects("Zg=g")),
    check_true("base64url_decode rejects a non-ASCII character", url_decode_rejects("Zm9vé")),
    check_true("base64url_decode rejects a space", url_decode_rejects("Zm9v Yg")),
    check_true("base64url_decode rejects three =", url_decode_rejects("Zg===")),
    check_true("base64url_decode rejects non-canonical trailing bits (1 byte)", url_decode_rejects("Zh")),
    check_true("base64url_decode rejects non-canonical trailing bits (2 bytes)", url_decode_rejects("Zm9")),
    check_true("base64url_decode rejects non-canonical trailing bits (padded)", url_decode_rejects("Zh==")),

    # --- bytes_xor ---
    # Self-XOR is all zeros, which needs no external vector to be obviously right.
    check_eq("xor of a value with itself is zero", xor_b64("abc", "abc"), "AAAA"),
    check_true("xor rejects mismatched lengths", xor_length_mismatch_errs()),

    # --- const_time_eq ---
    # Both ends of the buffer, because a fold that stops early passes the first case
    # and a fold that starts late passes the second.
    check_true("const_time_eq accepts identical values", ct_eq("abc", "abc")),
    check_false("const_time_eq rejects a difference in the first byte", ct_eq("abc", "xbc")),
    check_false("const_time_eq rejects a difference in the last byte", ct_eq("abc", "abx")),
    check_true("const_time_eq accepts two empty values", ct_eq("", "")),
    # A length mismatch is false, not an error: the caller wants "not ours". The length
    # itself is not hidden, which is what every comparable library also accepts.
    check_false("const_time_eq rejects a length mismatch", ct_eq("abc", "abcd")),
    check_false("const_time_eq rejects a prefix", ct_eq("abc", "ab")),
    check_true("const_time_eq accepts an hmac tag against itself", tag_matches_itself()),
    check_false("const_time_eq rejects a tag whose last byte changed",
      tag_rejects_a_changed_last_byte()),
    check_false("const_time_eq rejects a tag from a different message",
      tag_rejects_a_different_message())
  ])

# Not covered here: crypto.random_bytes, which is !{IO} and so cannot appear in the
# pure `check_*` list this suite is built from.
