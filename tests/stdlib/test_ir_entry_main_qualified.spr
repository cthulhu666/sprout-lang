module tests.stdlib.test_ir_entry_main_qualified

import stdlib.test (new_state, assert_true, summary)

# Regression: an entry `main` in a file with a `module` declaration is qualified
# by the bundler. The typed-IR path (ast_to_ir) only renamed a bare `main` to
# `__sprout_user_main`, so a qualified entry main was emitted under its qualified
# name and the @main C-ABI shim never called it — producing EMPTY output for
# every program that declares a module (the dominant empty-output miscompile class
# found by ir_runtime_parity.sh). The bundler now names the entry's `main`
# `source.entry_main_name` whatever the module is called, and codegen tests it
# through `source.is_entry_main`.
#
# The suite verdict is printed only if the entry main runs, so a main that never
# ran leaves no `SUITE PASSED` line and the runner fails the suite (NO VERDICT).
# Before the fix this program printed nothing.

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    assert_true(state, "entry main ran", true)
    summary(state)
