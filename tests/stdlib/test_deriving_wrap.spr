import stdlib.test (check_eq, check_true, run_suite)

# End-to-end test for `deriving (Eq, Ord, ToString)` on `wrap` declarations.
# A wrap IS a single-constructor, single-positional-field product, so the
# synthesized instances are the ADT emitters over the wrap's own constructor:
#   Eq       -> `eq` on the inner value
#   Ord      -> `compare` on the inner value
#   ToString -> "Name(inner)" — POSITIONAL, matching the ADT path, not a record's
#               `Name(f = v)`. Rendering is structural, not lifted: `Line(3)`,
#               never `3`, so a wrap stays visible in output rather than reading
#               as a transparent alias. See docs/deriving-records-v0.md §wrap.
# `deriving` sits trailing, after the RHS: `wrap Line = Int deriving (Eq, ...)`.

wrap Line = Int deriving (Eq, Ord, ToString)

# Wrap over a heap type: exercises the same emitters where the inner `eq` /
# `compare` / `to_string` witness is String's, not Int's.
wrap Name = String deriving (Eq, Ord, ToString)

# Two wraps over the SAME representation stay distinct types with distinct
# instances — the property `wrap` exists for. `Line(1) == Col(1)` does not
# type-check at all, so what is testable here is that each renders its own name.
wrap Col = Int deriving (Eq, Ord, ToString)

# A wrap with no deriving clause still parses (backward compatibility).
wrap Untouched = Int

# Records of derived wraps: this is the case that motivated the feature. The
# record's own derived `eq` calls `eq(left.line, right.line)`, which needs an
# `Eq Line` witness — unavailable until a wrap could derive one.
type Caret = (line: Line, col: Col) deriving (Eq, Ord, ToString)

fn not(b: Bool) -> Bool = if b then false else true

fn main() -> Unit !{IO} =
  run_suite("deriving_wrap", [
    # --- Eq over the inner value ---
    check_true("Line eq self", eq(Line(3), Line(3))),
    check_true("Line neq", not(eq(Line(3), Line(4)))),
    check_true("Line == operator routes to derived instance", Line(7) == Line(7)),

    # --- Ord over the inner value ---
    check_eq("Line compare self is 0", compare(Line(5), Line(5)), 0),
    check_true("Line compare lt", compare(Line(1), Line(2)) < 0),
    check_true("Line compare gt", compare(Line(9), Line(2)) > 0),

    # --- ToString: structural and positional, NOT lifted ---
    check_eq("Line to_string is structural", to_string(Line(3)), "Line(3)"),
    check_eq("Col to_string names its own wrap", to_string(Col(3)), "Col(3)"),

    # --- Wrap over String: inner witness is String's ---
    check_true("Name eq self", eq(Name("ada"), Name("ada"))),
    check_true("Name neq", not(eq(Name("ada"), Name("grace")))),
    check_true("Name compare lt", compare(Name("ada"), Name("grace")) < 0),
    check_eq("Name compare self is 0", compare(Name("ada"), Name("ada")), 0),
    check_eq("Name to_string (string inner unquoted)", to_string(Name("ada")), "Name(ada)"),

    # --- Record of wraps: derives through the wraps' own instances ---
    check_true("Caret eq self",
      eq(Caret(line = Line(1), col = Col(2)), Caret(line = Line(1), col = Col(2)))),
    check_true("Caret neq on line",
      not(eq(Caret(line = Line(1), col = Col(2)), Caret(line = Line(9), col = Col(2))))),
    check_true("Caret neq on col",
      not(eq(Caret(line = Line(1), col = Col(2)), Caret(line = Line(1), col = Col(9))))),
    check_true("Caret compare line dominates",
      compare(Caret(line = Line(1), col = Col(9)), Caret(line = Line(2), col = Col(0))) < 0),
    check_true("Caret compare col breaks tie",
      compare(Caret(line = Line(1), col = Col(1)), Caret(line = Line(1), col = Col(2))) < 0),
    check_eq("Caret to_string nests wrap rendering",
      to_string(Caret(line = Line(4), col = Col(7))),
      "Caret(line = Line(4), col = Col(7))"),

    # --- A wrap remains zero-cost: pattern destructuring is unaffected ---
    check_eq("Line destructures to its inner value", match Line(42) with | Line n -> n, 42),
    check_eq("Untouched (no deriving) still constructs and destructures",
      match Untouched(8) with | Untouched n -> n, 8)
  ])
