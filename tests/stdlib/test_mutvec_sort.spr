import stdlib.test (TestState, new_state, assert_eq, summary)
import stdlib.mutable (MutVec, mutvec_empty, mutvec_push, mutvec_fold, mutvec_sort, mutvec_sort_by)
import stdlib.rng (rng_hash2)

# `vec_sort` and `vec_sort_by` are stable, so agreeing with them on inputs that
# carry equal keys checks the order of equal elements, not only that the output
# is sorted.

fn from_list(xs: List a) -> MutVec a !{IO} =
  do
    v <- mutvec_empty()
    _ <- list_each(\x -> mutvec_push(v, x), xs)
    v

fn to_list(v: MutVec a) -> List a !{IO} =
  list_reverse(mutvec_fold(\ (acc, x) -> Cons(x, acc), Nil, v))

# A pseudo-random Int in [0, m).
fn small(i: Int, m: Int) -> Int =
  let h = rng_hash2(i, 11, 5) in h - (h / m) * m

fn ints(n: Int, m: Int) -> List Int =
  list_map(\i -> small(i, m), range_to_list(0..n - 1))

# (key, id) pairs: keys repeat, ids record the input order.
fn keyed(n: Int, m: Int) -> List (Int, Int) =
  list_map(\i -> (small(i, m), i), range_to_list(0..n - 1))

fn first(p: (Int, Int)) -> Int =
  match p with
  | (k, _) -> k

fn descending(p: (Int, Int)) -> Int = 0 - first(p)

fn sorted_by_descending(xs: List (Int, Int)) -> List (Int, Int) !{IO} =
  do
    v <- from_list(xs)
    _ <- mutvec_sort_by(descending, v)
    to_list(v)

fn sorted(xs: List a) -> List a !{IO} where Ord a =
  do
    v <- from_list(xs)
    _ <- mutvec_sort(v)
    to_list(v)

fn sorted_by_key(xs: List (Int, Int)) -> List (Int, Int) !{IO} =
  do
    v <- from_list(xs)
    _ <- mutvec_sort_by(first, v)
    to_list(v)

fn check_ints(state: TestState, n: Int, m: Int) -> Unit !{IO} =
  assert_eq(state, `mutvec_sort n=${to_string(n)} m=${to_string(m)}`, sorted(ints(n, m)),
    vec_to_list(vec_sort(vec_from_list(ints(n, m)))))

fn maybe_at(i: Int) -> Maybe Int =
  if small(i, 5) == 0 then Nothing else Just(small(i, 100))

# Nothing first, so the merge reads it as the scratch fill and in every pass.
fn maybes(n: Int) -> List (Maybe Int) =
  Cons(Nothing, list_map(maybe_at, range_to_list(1..n - 1)))

# 16-element blocks: n = 3, 17, 33, 65, 257, 1001 merge 1, 2, 3, 5, 17, 63 runs.
fn check_stable(state: TestState, n: Int) -> Unit !{IO} =
  assert_eq(state, `mutvec_sort_by stable n=${to_string(n)}`, sorted_by_key(keyed(n, 4)),
    vec_to_list(vec_sort_by(first, vec_from_list(keyed(n, 4)))))

fn main() -> Unit !{IO} =
  do
    state <- new_state()
    _ <- list_each(\n -> check_ints(state, n, 1000), [0, 1, 2, 15, 16, 17, 33, 100, 1001])
    _ <- check_ints(state, 500, 3)
    _ <- list_each(\n -> check_stable(state, n), [3, 17, 33, 65, 257, 1001])
    # A key that reverses the order: descending by key, equal keys still in input order.
    _ <- assert_eq(state, "mutvec_sort_by descending key", sorted_by_descending(keyed(200, 4)),
      vec_to_list(vec_sort_by(descending, vec_from_list(keyed(200, 4)))))
    _ <- assert_eq(state, "already sorted", sorted(range_to_list(0..99)), range_to_list(0..99))
    _ <- assert_eq(state, "reversed", sorted(list_reverse(range_to_list(0..99))), range_to_list(0..99))
    _ <- assert_eq(state, "strings", sorted(["pear", "fig", "apple", "fig"]), ["apple", "fig", "fig", "pear"])
    # A `<-` on a Maybe unwraps it; the element reads must not, Nothing included.
    _ <- assert_eq(state, "maybes", sorted([Just(3), Nothing, Just(1)]), [Nothing, Just(1), Just(3)])
    _ <- assert_eq(state, "maybes through the merge", sorted(maybes(41)),
      vec_to_list(vec_sort(vec_from_list(maybes(41)))))
    summary(state)
