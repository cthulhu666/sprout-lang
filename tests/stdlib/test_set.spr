import stdlib.test (TestState, new_state, assert_eq, assert_true, assert_false, summary)

# Regression tests for stdlib `Set`.  These were added after a June 2026
# investigation into a suspected Set-in-Dict GC anomaly — under stress GC
# (SPROUT_GC_THRESHOLD=1), no anomaly reproduces.  Set works correctly across
# Dict roundtrip, List roundtrip, list_fold accumulation, and lambda capture.
# The tests below pin that behaviour so future Set changes don't regress.

fn build_set() -> Set =
  set_insert("c", set_insert("b", set_insert("a", set_empty())))

fn put_in_dict(s: Set) -> Dict Set =
  dict_set("k", s, dict_empty())

fn get_from_dict(d: Dict Set) -> Set =
  match dict_get("k", d) with
  | Nothing -> set_empty()
  | Just s -> s

fn allocate_strings(n: Int, acc: List String) -> List String =
  if n == 0 then acc
  else allocate_strings(n - 1, Cons(int_to_string(n), acc))

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    # Baseline: direct membership before any storage.
    let s = build_set()
    assert_true(state, "direct: a present", set_member("a", s))
    assert_true(state, "direct: b present", set_member("b", s))
    assert_true(state, "direct: c present", set_member("c", s))

    # Store in Dict, retrieve, check.
    let d = put_in_dict(s)
    let s_back = get_from_dict(d)
    assert_true(state, "dict-roundtrip: a present", set_member("a", s_back))
    assert_true(state, "dict-roundtrip: b present", set_member("b", s_back))
    assert_true(state, "dict-roundtrip: c present", set_member("c", s_back))
    assert_false(state, "dict-roundtrip: x absent", set_member("x", s_back))

    # Same as above but with allocations between store and retrieve.
    let d2 = put_in_dict(build_set())
    let _garbage = allocate_strings(50, Nil)
    let s_back2 = get_from_dict(d2)
    assert_true(state, "alloc-then-get: a present", set_member("a", s_back2))
    assert_true(state, "alloc-then-get: b present", set_member("b", s_back2))
    assert_true(state, "alloc-then-get: c present", set_member("c", s_back2))

    # Store Set in List<Set>; force allocations; pull head; check.
    let s_in_list = Cons(build_set(), Nil)
    let _g2 = allocate_strings(50, Nil)
    let s_back3 = match s_in_list with
                  | Nil -> set_empty()
                  | [h | _] -> h
    assert_true(state, "list-roundtrip: a present", set_member("a", s_back3))
    assert_true(state, "list-roundtrip: b present", set_member("b", s_back3))
    assert_true(state, "list-roundtrip: c present", set_member("c", s_back3))

    # Dict<String, Set> built incrementally — mimics per-block liveness store.
    let d3 = dict_set("blk2", set_insert("y", set_insert("x", set_empty())),
              dict_set("blk1", build_set(), dict_empty()))
    let _g3 = allocate_strings(50, Nil)
    let s_blk1_direct = match dict_get("blk1", d3) with | Nothing -> set_empty() | Just s -> s
    assert_true(state, "dict-of-sets: blk1 has a", set_member("a", s_blk1_direct))
    assert_true(state, "dict-of-sets: blk1 has c", set_member("c", s_blk1_direct))
    let s_blk2 = match dict_get("blk2", d3) with | Nothing -> set_empty() | Just s -> s
    assert_true(state, "dict-of-sets: blk2 has x", set_member("x", s_blk2))
    assert_true(state, "dict-of-sets: blk2 has y", set_member("y", s_blk2))
    assert_false(state, "dict-of-sets: blk1 missing x", set_member("x", s_blk1_direct))

    # Set merged via list_fold — mimics ls_union pattern over many ops.
    let merged = list_fold(\ (s, x) -> set_insert(x, s),
                            set_empty(),
                            Cons("p", Cons("q", Cons("r", Cons("s", Nil)))))
    let _g4 = allocate_strings(50, Nil)
    assert_true(state, "fold-built: p present", set_member("p", merged))
    assert_true(state, "fold-built: q present", set_member("q", merged))
    assert_true(state, "fold-built: r present", set_member("r", merged))
    assert_true(state, "fold-built: s present", set_member("s", merged))

    # Set passed through higher-order function (\s -> set_insert(..., s)).
    let s5 = (\s -> set_insert("z", set_insert("w", s)))(build_set())
    let _g5 = allocate_strings(50, Nil)
    assert_true(state, "hof-passed: a survives", set_member("a", s5))
    assert_true(state, "hof-passed: z added", set_member("z", s5))

    # set_union: combine two disjoint sets, then with overlap.
    let u_disjoint = set_union(build_set(), set_insert("y", set_insert("x", set_empty())))
    assert_eq(state, "set_union disjoint: size", set_size(u_disjoint), 5)
    assert_true(state, "set_union disjoint: a", set_member("a", u_disjoint))
    assert_true(state, "set_union disjoint: y", set_member("y", u_disjoint))
    let u_overlap = set_union(build_set(), set_insert("b", set_insert("a", set_empty())))
    assert_eq(state, "set_union overlap: size dedup'd", set_size(u_overlap), 3)

    # set_diff: remove a subset.
    let big = set_insert("d", set_insert("c", set_insert("b", set_insert("a", set_empty()))))
    let rem = set_insert("c", set_insert("a", set_empty()))
    let dif = set_diff(big, rem)
    assert_eq(state, "set_diff: size", set_size(dif), 2)
    assert_true(state, "set_diff: b kept", set_member("b", dif))
    assert_true(state, "set_diff: d kept", set_member("d", dif))
    assert_false(state, "set_diff: a removed", set_member("a", dif))
    assert_false(state, "set_diff: c removed", set_member("c", dif))

    # set_remove: drop a single element.
    let dropped = set_remove("b", build_set())
    assert_eq(state, "set_remove: size", set_size(dropped), 2)
    assert_true(state, "set_remove: a kept", set_member("a", dropped))
    assert_false(state, "set_remove: b gone", set_member("b", dropped))
    # Removing a non-member is a no-op.
    let same = set_remove("zzz", build_set())
    assert_eq(state, "set_remove non-member: size", set_size(same), 3)

    # ToString instance — order is BST in-order (alphabetic for strings).
    assert_eq(state, "to_string Set", to_string(build_set()), "{a, b, c}")
    assert_eq(state, "to_string empty Set", to_string(set_empty()), "{}")

    summary(state)
