import stdlib.test (check_true, check_false, run_suite)

# Regression test: `==` / `!=` on ADT values must desugar to `eq()` dispatch,
# not fall through to pointer-identity icmp.
# Bug: Dead == Dead returned false (pointer comparison); eq(Dead, Dead) was true.

type Player (..) deriving (Eq, ToString) =
  | Dead
  | Alive Int

fn not(b: Bool) -> Bool = if b then false else true

# Polymorphic helper — exercises the TVar / @fwd path.
fn equal_pair(x: a, y: a) -> Bool where Eq a = x == y

fn main() -> Unit !{IO} =
  run_suite("eq_operator_adt_dispatch", [
    # ---- 1. Nullary concrete ------------------------------------------------
    check_true("Dead == Dead is true", Dead == Dead),
    check_false("Dead == Alive 1 is false", Dead == Alive(1)),

    # ---- 2. Field-bearing concrete -----------------------------------------
    check_true("Alive 1 == Alive 1 is true", Alive(1) == Alive(1)),
    check_false("Alive 1 == Alive 2 is false", Alive(1) == Alive(2)),

    # ---- 3. != operator ----------------------------------------------------
    check_true("Dead != Alive 0 is true", Dead != Alive(0)),
    check_false("Dead != Dead is false", Dead != Dead),

    # ---- 4. Polymorphic via equal_pair -------------------------------------
    check_true("equal_pair Dead Dead", equal_pair(Dead, Dead)),
    check_false("equal_pair Dead (Alive 1)", equal_pair(Dead, Alive(1))),
    check_true("equal_pair 42 42 (Int)", equal_pair(42, 42)),
    check_false("equal_pair 1 2 (Int)", equal_pair(1, 2)),

    # ---- 5. Maybe Int (predeclared Eq instance) ----------------------------
    check_true("Just 1 == Just 1", Just(1) == Just(1)),
    check_false("Just 1 == Just 2", Just(1) == Just(2)),
    check_false("Just 1 == Nothing", Just(1) == Nothing),
    check_true("Nothing == Nothing", Nothing == Nothing)
  ])
