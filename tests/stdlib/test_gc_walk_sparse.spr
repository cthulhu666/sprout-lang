import stdlib.test (check_eq, run_suite)

# Calibration workload for the sweep-walk counter (`walked=` under SPROUT_DEBUG_GC=1).
#
# Shape: regions left mostly FREE in a slot class nothing allocates again, each
# pinned by a few survivors so it is never released. Every later collection walks
# those FREE slots and reclaims nothing from them — #407's shape in miniature: a
# live set shrank and the sweep did not.
#
# KNOWN ANSWER: with SPROUT_GC_THRESHOLD pinned (footprint floor off), slots walked
# per object swept is HIGH here and ~1 for `test_gc_age_retain_none.spr`;
# `just gc-walk-check` asserts the separation. With the floor on it is LOW, and
# `just gc-trigger-check` asserts that.
# The assertions below only confirm the workload ran; the measurement is in the
# runtime counters.

# Arity 6, so a different slot class from Chain's arity 2: a FREE Wide slot can
# never be refilled by the churn below.
type Wide (..) =
  | WEnd
  | Wide Int Int Int Int Int Wide

type Chain (..) =
  | End
  | Link Int Chain

# All n Wides are live at once, so they bump-fill regions instead of recycling
# each other's slots; one Link per 64 lands among them and pins the region.
# `gap` counts down to the next Link.
fn build_sparse(n: Int, gap: Int, wides: Wide, keep: Chain) -> (Wide, Chain) =
  if n <= 0 then (wides, keep)
  else if gap <= 1 then build_sparse(n - 1, 64, Wide(n, 0, 0, 0, 0, wides), Link(n, keep))
  else build_sparse(n - 1, gap - 1, Wide(n, 0, 0, 0, 0, wides), keep)

fn wide_len(w: Wide, acc: Int) -> Int =
  match w with
  | Wide _ _ _ _ _ rest -> wide_len(rest, acc + 1)
  | WEnd -> acc

fn chain_len(c: Chain, acc: Int) -> Int =
  match c with
  | Link _ rest -> chain_len(rest, acc + 1)
  | End -> acc

fn build(n: Int, acc: Chain) -> Chain =
  if n <= 0 then acc
  else build(n - 1, Link(n, acc))

# Returns only the survivors: the Wides die together when this frame returns.
fn sparse_survivors(n: Int) -> (Int, Chain) =
  let (wides, keep) = build_sparse(n, 64, WEnd, End)
  in (wide_len(wides, 0), keep)

# Narrow garbage only, so every collection it drives walks the FREE Wide slots.
fn churn(n: Int, acc: Int) -> Int =
  if n <= 0 then acc
  else churn(n - 1, acc + chain_len(build(8, End), 0))

fn main() -> Unit !{IO} =
  let (wides_built, keep) = sparse_survivors(100000)
      churned = churn(34000, 0)
      # Keeps the pins reachable across all of the churn above.
      kept_after = chain_len(keep, 0)
  in
  run_suite("gc_walk_sparse", [
    check_eq("all wides built", wides_built, 100000),
    check_eq("one pin per 64 wides survives the churn", kept_after, 1562),
    check_eq("churn walked every round", churned, 272000)
  ])
