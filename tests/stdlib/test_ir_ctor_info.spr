import stdlib.test (check_eq, check_true, run_suite)
import stdlib.compiler.sprout_ir as sprout_ir

# Unit tests for sprout_ir.CtorInfo, the name-keyed constructor-table value
# ast_to_ir reads. The field values are all distinct (5 / 2 / 3 / "ips" /
# ["a", "b"]), so a field read through the wrong name cannot pass by accident.
# field_names is empty for ADT and wrap constructors (positional) and the
# declaration-order labels for a record.

fn main() -> Unit !{IO} =
  let ci = sprout_ir.CtorInfo(tag = 5, arity = 2, max_arity = 3, field_kinds = "ips",
                              field_names = ["a", "b"])
      wrap_ci = sprout_ir.CtorInfo(tag = -1, arity = 1, max_arity = 1, field_kinds = "p",
                                   field_names = Nil)
  in run_suite("ir_ctor_info", [
    check_eq("CtorInfo: tag", ci.tag, 5),
    check_eq("CtorInfo: arity", ci.arity, 2),
    check_eq("CtorInfo: max_arity", ci.max_arity, 3),
    check_true("CtorInfo: field_kinds", ci.field_kinds == "ips"),
    check_eq("CtorInfo: a record's field_names keep declaration order", ci.field_names, ["a", "b"]),
    check_eq("CtorInfo: wrap sentinel tag is -1", wrap_ci.tag, -1),
    check_eq("CtorInfo: wrap sentinel arity is 1", wrap_ci.arity, 1),
    check_true("CtorInfo: positional ctor has no field_names", wrap_ci.field_names == Nil)
  ])
