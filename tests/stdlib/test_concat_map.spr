import stdlib.test (TestState, new_state, assert_eq, summary)

fn duplicate(x: Int) -> List Int = [x, x]

fn main() -> Unit !{IO} =
  do
    state <- new_state()

    assert_eq(state, "concat_map over List: maps then flattens, order preserved",
      concat_map(duplicate, [1, 2, 3]), [1, 1, 2, 2, 3, 3])
    assert_eq(state, "concat_map over an empty List", concat_map(duplicate, []), [])
    assert_eq(state, "concat_map where f returns Nil for some elements",
      concat_map(\x -> if x == 2 then Nil else [x], [1, 2, 3]), [1, 3])

    # Vec has only a Semigroup instance (no Monoid/empty()), so the input
    # container being Vec while the per-element result stays List exercises
    # the genuinely independent c/t type parameters.
    assert_eq(state, "concat_map over a Vec container (independent of the result Monoid)",
      concat_map(duplicate, foldable_to_vec([1, 2])), [1, 1, 2, 2])

    summary(state)
