module main

# bigint-v0 Stage 1 smoke (docs/bigint-v0.md §5.1, Option A of
# docs/int-overflow-policy-decision.md): INT_MAX + 1 must panic. The addend is
# `1 + list_length(args)`, and `args` is empty when the binary runs with no
# arguments — so the addend is 1 at RUNTIME, but neither the Sprout compiler
# nor clang can fold it away (it depends on argv, read at process start).
# Before the fix `+` silently wraps to INT_MIN and this prints it with exit 0.
# After the fix it panics with a located "Int overflow in +" and a non-zero exit.
fn main() -> Unit !{IO} =
  do
    args <- argv_all()
    print(int_to_string(9223372036854775807 + (1 + list_length(args))))
