module main

# An unused `let` whose RHS negates INT_MIN must still panic. INT_MIN is built at
# run time so the compiler cannot fold the negation.

fn main() -> Unit !{IO} =
  do
    args <- argv_all_bytes()
    let int_min = 0 - 9223372036854775807 - 1 + list_length(args)
    let negated = -int_min
    print("reached")
