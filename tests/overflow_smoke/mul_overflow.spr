module main

# bigint-v0 Stage 1 smoke (docs/bigint-v0.md §5.1, Option A of
# docs/int-overflow-policy-decision.md): INT_MAX * 2 must panic. The multiplier
# is `2 + list_length(args)`, and `args` is empty when the binary runs with no
# arguments — so the multiplier is 2 at RUNTIME, but neither the Sprout
# compiler nor clang can fold it away. Before the fix `*` silently wraps and
# this prints a garbage value with exit 0. After the fix it panics with a
# located "Int overflow in *" and a non-zero exit.
fn main() -> Unit !{IO} =
  do
    args <- argv_all()
    print(int_to_string(9223372036854775807 * (2 + list_length(args))))
