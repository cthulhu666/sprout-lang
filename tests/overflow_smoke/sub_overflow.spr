module main

# bigint-v0 Stage 1 smoke (docs/bigint-v0.md §5.1, Option A of
# docs/int-overflow-policy-decision.md): INT_MIN - 1 must panic. INT_MIN is
# written as `0 - 9223372036854775807 - 1` rather than the (also valid, per
# §5.3's unary-minus carve-out) decimal literal `-9223372036854775808`, so this
# runtime-overflow gate stays independent of the separate literal-range-check
# rule — a regression in one must not be masked by the other. `one` is
# `1 + list_length(args)`, and `args` is empty with no argv — so it is 1 at
# RUNTIME but not a compile-time constant, so neither the Sprout compiler nor
# clang can fold the overflowing subtraction away. Before the fix `-` silently
# wraps to INT_MAX and this prints it with exit 0. After the fix it panics with
# a located "Int overflow in -" and a non-zero exit.
fn main() -> Unit !{IO} =
  do
    args <- argv_all()
    let int_min = 0 - 9223372036854775807 - 1
        one = 1 + list_length(args)
    print(int_to_string(int_min - one))
