  $entry.same [Eq_Int] <- direct
  $entry.same [Eq_Maybe([Eq_Int])] <- direct
  $entry.same [Eq_String] <- direct
  $entry.same_both [Eq_Bool] <- direct
  $entry.traverse_some [Eq_Int] <- direct
