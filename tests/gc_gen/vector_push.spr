module main
import stdlib.mutable (MutVec, mutvec_empty, mutvec_push, mutvec_at, mutvec_len)

# Barrier site: vector_push, through mutvec_push. Run by `just gc-gen-check` under
# SPROUT_GC_MINOR=1 SPROUT_GC_GENCHECK=1 SPROUT_GC_STRESS=1. The vector starts empty, so it grows
# past its inline capacity (inline buffer, then 8, 16, 32, 64 elements) while old; each push
# stores a fresh String and the whole vector is read back every round. Without the barrier a
# pushed String is reachable only through the old vector: GENCHECK aborts.

fn churn(n: Int, acc: Int) -> Int =
  if n <= 0 then acc else churn(n - 1, acc + str_len(int_to_string(n)))

fn read_all(v: MutVec String, i: Int, n: Int, acc: Int) -> Int !{IO} =
  if i >= n then acc
  else
    do
      s <- mutvec_at(v, i)
      read_all(v, i + 1, n, acc + str_len(s))

fn rounds(v: MutVec String, i: Int, n: Int, acc: Int) -> Int !{IO} =
  if i >= n then acc
  else
    do
      _ <- mutvec_push(v, "item-" ++ int_to_string(i))
      _ <- churn(2, 0)
      len <- mutvec_len(v)
      total <- read_all(v, 0, len, 0)
      rounds(v, i + 1, n, acc + total)

fn main() -> Unit !{IO} =
  do
    v <- mutvec_empty()
    total <- rounds(v, 0, 70, 0)
    print(`gc-gen vector_push ${int_to_string(total)}`)
