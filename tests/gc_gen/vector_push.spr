module main
import stdlib.mutable (MutVec, mutvec_new, mutvec_push, mutvec_fold)

# Barrier site: vector_push, through mutvec_push. Run by `just gc-gen-check` under
# SPROUT_GC_MINOR=1 SPROUT_GC_GENCHECK=1 SPROUT_GC_STRESS=1. Each vector starts inline, so its
# first push past 4 elements edits an old header in place. Only an old `Holder` reaches it, so a
# growth that dropped its colour bit leaves it unmarked and GENCHECK aborts — when the next
# collection is a minor, hence eight vectors growing at different points. A pushed String is
# reachable only through the old vector, so a missing barrier aborts too.

type Holder = Holder(MutVec String)

fn churn(n: Int, acc: Int) -> Int =
  if n <= 0 then acc else churn(n - 1, acc + str_len(int_to_string(n)))

fn push_item(h: Holder, s: String) -> Unit !{IO} =
  let Holder(v) = h in mutvec_push(v, s)

fn total_len(h: Holder) -> Int !{IO} =
  let Holder(v) = h in mutvec_fold(\ (sum, s) -> sum + str_len(s), 0, v)

fn rounds(h: Holder, i: Int, n: Int, acc: Int) -> Int !{IO} =
  if i >= n then acc
  else
    do
      _ <- push_item(h, "item-" ++ int_to_string(i))
      _ <- churn(2, 0)
      total <- total_len(h)
      rounds(h, i + 1, n, acc + total)

fn new_holder() -> Holder !{IO} =
  do
    v <- mutvec_new(4, "start")
    Holder(v)

fn experiments(j: Int, acc: Int) -> Int !{IO} =
  if j >= 8 then acc
  else
    do
      h <- new_holder()
      total <- rounds(h, 0, 6 + j, 0)
      experiments(j + 1, acc + total)

fn main() -> Unit !{IO} =
  do
    total <- experiments(0, 0)
    print(`gc-gen vector_push ${int_to_string(total)}`)
