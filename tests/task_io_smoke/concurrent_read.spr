import stdlib.task (Scope, with_scope, task_spawn)
import stdlib.net (TcpConnection, close, close_listener, connect, accept, listen_local, read_avail_timeout, write_all_utf8)
import stdlib.string as string
import stdlib.bytes as bytes

# L0.3 I/O parking smoke. Two green tasks share one loopback connection pair:
# `reader` reads before any data exists, `writer` then sends. With I/O parking,
# reader suspends on EAGAIN, the scheduler runs writer, the write wakes reader,
# and the program completes printing:
#   writer sent
#   reader got ping
# With the BLOCKING baseline, reader's read freezes the OS thread and writer
# never runs -> the program HANGS (the RED signal, caught by a timeout wrapper).
#
# Runs on the LINEAR TcpConnection since M4.4a. Each socket is MOVED into the
# spawned task that owns it (`task_spawn`'s work parameter is `once`), so the
# task itself holds the single consume — which is why `close` moved from main
# into reader/writer. Before M4.4a this shape needed raw Int handles and got no
# release enforcement at all; both sockets and the listener are now closed on
# every path because omitting one would not compile.
# This is the fixture that covers the PARK inside the new read loop. `read_avail_timeout` is Sprout
# now — tcp_read_some returns Err(TcpWouldBlock) because no data exists yet, and the loop calls
# tcp_wait, which is what suspends the reader so the writer can run. If that loop ever stopped
# parking (say by spinning on WouldBlock), this test would not fail loudly; it would spin until the
# recipe's timeout and report a HANG, the same RED signal as the blocking baseline it was written for.
#
# The bound is generous because nothing here is testing a deadline. Before, this read had no bound at
# all — `read_avail` has been deleted, since an unbounded socket read is the hazard this series has
# spent its time removing.
fn reader(server: consuming TcpConnection) -> Unit !{IO} =
  match read_avail_timeout(server, 5000) with
  | Ok data ->
      match bytes.to_string(data) with
      | Ok text -> report_and_close(server, string.concat("reader got ", text))
      | Err _ -> report_and_close(server, "reader: payload was not text")
  | Err _ -> report_and_close(server, "reader: read failed")

fn writer(client: consuming TcpConnection) -> Unit !{IO} =
  do
    term_write("writer sent\n")
    match write_all_utf8(client, "ping") with
    | Ok _ -> close(client)
    | Err _ -> report_and_close(client, "writer: write failed")

# The borrow-then-consume tail both tasks share: write the line, then release.
fn report_and_close(conn: consuming TcpConnection, line: String) -> Unit !{IO} =
  do
    term_write(line)
    term_write("\n")
    close(conn)

fn run(s: Scope, server: consuming TcpConnection, client: consuming TcpConnection) -> Unit !{IO} =
  do
    task_spawn(s, \_ -> reader(server))
    task_spawn(s, \_ -> writer(client))

fn main() -> Unit !{IO} =
  do
    listener <- listen_local(28999)
    match connect("127.0.0.1", 28999) with
    | Ok conn ->
        do
          server <- accept(listener)
          close_listener(listener)
          with_scope(\s -> run(s, server, conn))
    | Err e ->
        do
          close_listener(listener)
          term_write("connect failed\n")
