import stdlib.task (Scope, with_scope, task_spawn)
import stdlib.net (tcp_connect, tcp_write_string, tcp_listen, tcp_accept, tcp_read, tcp_close)
import stdlib.string as string

# L0.3 I/O parking smoke. Two green tasks share one loopback connection pair:
# `reader` calls tcp_read before any data exists, `writer` then sends. With I/O
# parking, reader suspends on EAGAIN, the scheduler runs writer, the write wakes
# reader, and the program completes printing:
#   writer sent
#   reader got ping
# With the BLOCKING baseline, reader's tcp_read freezes the OS thread and writer
# never runs -> the program HANGS (the RED signal, caught by a timeout wrapper).
#
# Uses RAW Int handles on both sides, not the linear TcpConnection. The socket is
# handed to a SPAWNED task, i.e. captured by an escaping closure, which is
# higher-order linearity (M4.4) and is NOT unblocked by borrowing — the same
# reason stdlib.http_server stays on raw handles. Revisit when M4.4 lands.
fn reader(server: Int) -> Unit !{IO} =
  do
    data <- tcp_read(server)
    term_write(string.concat("reader got ", data))
    term_write("\n")

fn writer(client: Int) -> Unit !{IO} =
  do
    term_write("writer sent\n")
    match tcp_write_string(client, "ping") with
    | Ok _ -> term_write("")
    | Err _ -> term_write("writer: write failed\n")

fn run(s: Scope, server: Int, client: Int) -> Unit !{IO} =
  do
    task_spawn(s, \_ -> reader(server))
    task_spawn(s, \_ -> writer(client))

fn main() -> Unit !{IO} =
  do
    listener <- tcp_listen(28999)
    match tcp_connect("127.0.0.1", 28999) with
    | Ok conn ->
        do
          server <- tcp_accept(listener)
          with_scope(\s -> run(s, server, conn))
          tcp_close(conn)
    | Err e -> term_write("connect failed\n")
