import stdlib.task (Scope, with_scope, with_timeout, TimeoutResult, Completed, Expired)
import stdlib.chan (Chan, Recv, Got, Closed, chan_new, chan_recv)
import stdlib.terminal as terminal

# L0.8 with_timeout over a channel recv (EXPERIMENTAL). A timed body that parks in
# chan_recv on an empty channel nobody sends to must be FORCE-DROPPED when its deadline
# fires — __await_deadline classifies the child as PARK_CHAN and drops it, so the inner
# scope join returns and with_timeout yields Expired (not a loud-fail or a hang). The
# channel is created in the OUTER scope (freed at its join); the body is a with_timeout
# child that recv-parks on it. `held` is bound across the park so the drop reclaims a
# stack-rooted heap value (the ASan-gated path).
# NOTE: this fn is deliberately NOT named `body` — a top-level name that collides with
# `with_timeout`'s `body` parameter miscompiles (the parameter reference resolves to the
# user global). Pre-existing compiler name-resolution bug, tracked separately.
fn timed_recv(ch: Chan Int) -> Int !{IO} =
  do
    let held = "live-" ++ "root"
    r <- chan_recv(ch)  # parks here forever — nobody ever sends
    terminal.write(held)  # unreachable; forces `held` rooted across the park
    match r with
    | Got v -> v
    | Closed -> 0

fn run(s: Scope) -> Unit !{IO} =
  do
    ch <- chan_new(s, 1)
    let result = with_timeout(50, \_ -> timed_recv(ch))
    match result with
    | Completed v -> terminal.write("completed\n")
    | Expired -> terminal.write("expired\n")

fn main() -> Unit !{IO} =
  do
    with_scope(\s -> run(s))
    terminal.write("done\n")  # reached only after the timed-out recv body was force-dropped
