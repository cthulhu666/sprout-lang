import stdlib.task (Scope, with_scope, with_timeout, TimeoutResult, Completed, Expired)
import stdlib.chan (Chan, Recv, Got, Closed, chan_new, chan_select)

# L0.11 with_timeout over a chan_select body (EXPERIMENTAL). A timed body parked in chan_select on
# channels nobody sends to must be FORCE-DROPPED when its deadline fires — __await_deadline
# classifies the child as PARK_SELECT (like PARK_CHAN) and drops it, unlinking it from every
# channel, so the inner scope join returns and with_timeout yields Expired (not a loud-fail/hang).
# `held` is bound across the park so the drop reclaims a stack-rooted heap value (the ASan path).
# NOTE: deliberately NOT named `body` — a top-level name colliding with with_timeout's `body`
# parameter miscompiles (pre-existing name-resolution bug, tracked separately).
fn sel_val(a: Chan Int, b: Chan Int) -> Int !{IO} =
  match chan_select([a, b]) with  # parks on both — nobody ever sends
  | (_, r) ->
    match r with
    | Got v -> v
    | Closed -> 0

fn timed_select(a: Chan Int, b: Chan Int) -> Int !{IO} =
  do
    let held = "live-" ++ "root"
    v <- sel_val(a, b)  # parks on both a and b forever
    term_write(held)  # unreachable; forces `held` rooted across the park
    v

fn run(s: Scope) -> Unit !{IO} =
  do
    a <- chan_new(s, 1)
    b <- chan_new(s, 1)
    let result = with_timeout(50, \_ -> timed_select(a, b))
    match result with
    | Completed v -> term_write("completed\n")
    | Expired -> term_write("expired\n")

fn main() -> Unit !{IO} =
  do
    with_scope(\s -> run(s))
    term_write("done\n")  # reached only after the timed-out select body was force-dropped
