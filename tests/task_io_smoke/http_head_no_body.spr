import stdlib.task (Scope, with_scope, task_spawn)
import stdlib.net (TcpConnection, TcpEndOfStream, connect, close, local_port, write_all_utf8, read_avail_timeout)
import testsupport.listen (listen_or_die)
import stdlib.http_server (HttpRequest, HttpServerResponse, ok, serve_n)
import stdlib.string as string
import stdlib.bytes as bytes
import stdlib.terminal as terminal

# RFC 9110 §9.3.2: a response to HEAD has the headers a GET would get and no content. The server
# used to write the body anyway. Close framed it, so nothing broke; on a persistent connection the
# body would be read as the start of the next response.

fn handle(req: HttpRequest) -> HttpServerResponse !{IO} = ok("hello")

# Everything the server sends, up to its close.
fn read_to_end(conn: borrowing TcpConnection, acc: Bytes) -> String !{IO} =
  match read_avail_timeout(conn, 2000) with
  | Ok chunk -> read_to_end(conn, bytes.append(acc, chunk))
  | Err TcpEndOfStream -> bytes.to_string(acc) |> result_with_default("NOT UTF-8")
  | Err _ -> "READ FAILED"

fn exchange(port: Int, request: String) -> String !{IO} =
  match connect("127.0.0.1", port) with
  | Ok conn ->
      do
        reply <- match write_all_utf8(conn, request) with
                 | Ok _ -> read_to_end(conn, bytes.empty())
                 | Err _ -> "WRITE FAILED"
        close(conn)
        reply
  | Err _ -> "CONNECT FAILED"

fn report(label: String, pass: Bool, reply: String) -> Unit !{IO} =
  if pass then terminal.write(`${label}\n`)
  else terminal.write(`MISMATCH: ${label} got ${reply}\n`)

fn client(port: Int) -> Unit !{IO} =
  do
    head <- exchange(port, "HEAD / HTTP/1.1\r\nHost: x\r\n\r\n")
    report("head-keeps-length", string.contains(head, "content-length: 5\r\n"), head)
    report("head-has-no-body", string.ends_with(head, "\r\n\r\n"), head)
    get <- exchange(port, "GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    report("get-has-body", string.ends_with(get, "\r\n\r\nhello"), get)

fn run(s: Scope) -> Unit !{IO} =
  do
    listener <- listen_or_die(0)
    port <- local_port(listener)
    task_spawn(s, \_ -> serve_n(listener, 2, handle))
    task_spawn(s, \_ -> client(port))

fn main() -> Unit !{IO} =
  do
    with_scope(\s -> run(s))
    terminal.write("done\n")
