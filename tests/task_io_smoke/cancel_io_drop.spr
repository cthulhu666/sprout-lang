import stdlib.task (Scope, with_scope, task_fork, detach, task_spawn, task_yield, scope_cancel)
import stdlib.net (tcp_listen, tcp_accept, tcp_close)
import stdlib.string as string
import stdlib.terminal as terminal

# L0.5 I/O-drop cancellation (EXPERIMENTAL). A task suspended in the poller (here on
# tcp_accept, with nobody ever connecting) cannot check task_cancelled — it is asleep
# in kqueue/epoll. So scope_cancel must FORCE-DROP it: deregister its fd and reclaim
# it, without the fd ever becoming ready. Both spawn kinds must be droppable:
#   * task_fork (awaitable)      — reclaim keeps the record (roots freed, roots=NULL).
#   * task_spawn (fire-and-forget) — reclaim frees the whole record.
# Without the drop, live never reaches 0 and __scope_join blocks the pump in the
# poller forever: the perl `alarm` timeout fires and this fixture "does not complete".
# The task binds a HEAP string `held` BEFORE parking and uses it AFTER, so the dropped
# task is suspended with a GC root pointing INTO its green stack (not just &work in the
# record) — the case where reclaim must free roots and stack together. Exercises the full
# reclaim path, not the degenerate roots-only-into-record one.
fn accept_forever(listener: Int) -> Int !{IO} =
  do
    let held = string.concat("live-", "root")
    # `match` rather than `conn <- tcp_accept(…)`: a fallible bind in an `Int`-returning function is
    # rejected by §5.9 (on `Err` it would return the `Err` box as an `Int`). `held` is still read on
    # the `Ok` arm, so it is still rooted across the park, which is what this fixture measures.
    match tcp_accept(listener) with  # parks here forever — no client ever connects
    | Err _ -> panic("accept_forever: accept returned instead of parking")
    | Ok conn ->
        do
          terminal.write(held)  # unreachable; forces `held` rooted across the park
          tcp_close(conn)  # unreachable; present only so `conn` is used
          99

fn accept_forever_unit(listener: Int) -> Unit !{IO} =
  do
    _ <- accept_forever(listener)
    terminal.write("")

fn body(s: Scope, la: Int, lb: Int) -> Unit !{IO} =
  do
    detach(task_fork(s, \_ -> accept_forever(la)))  # awaitable, parks on la; detach relinquishes (cancel force-drops it)
    task_spawn(s, \_ -> accept_forever_unit(lb))  # fire-and-forget, parks on lb
    task_yield()  # let both reach accept and park
    scope_cancel(s)  # force-drop both parked tasks
    terminal.write("cancelled\n")  # owner continues; awaits neither

fn main() -> Unit !{IO} =
  do
    la <- tcp_listen(28996)
    lb <- tcp_listen(28997)
    with_scope(\s -> body(s, la, lb))
    terminal.write("done\n")  # reached only if both parked tasks were dropped by cancel
