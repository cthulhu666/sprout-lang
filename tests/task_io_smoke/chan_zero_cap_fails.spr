import stdlib.task (Scope, with_scope)
import stdlib.chan (Chan, chan_new)

# L0.8 channel capacity guard: chan_new with capacity < 1 must LOUD-FAIL (rendezvous / cap-0
# channels are a later increment, so a zero-capacity request is rejected rather than silently
# treated as unbuffered). A broken guard would allocate a 0-slot ring and later corrupt.
fn make_zero(s: Scope) -> Chan Int !{IO} =
  chan_new(s, 0)  # rejected: capacity must be >= 1

fn body(s: Scope) -> Unit !{IO} =
  do
    ch <- make_zero(s)
    term_write("should-not-reach\n")

fn main() -> Unit !{IO} =
  do
    with_scope(\s -> body(s))
    term_write("done\n")
