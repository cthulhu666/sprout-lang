module main
import stdlib.argv as argv

# Regression fixture for the typed-codegen flip blocker: the typed `main` shim
# must call @sprout_set_argv so argv.all() works in typed-built binaries.
# Run via `just argv-smoke` (builds with --use-ir-codegen, runs WITH args).
# The parity corpus runs every binary with NO args, so this gap was invisible
# there — the compiler is the first program that reads its own argv.

fn main() -> Unit !{IO} =
  match argv.all() with
  | Ok ["ping", x | _] -> print("pong:" ++ x)
  | Ok [solo | _] -> print("solo:" ++ solo)
  | Ok _ -> print("empty")
  | Err _ -> print("bad-utf8")
