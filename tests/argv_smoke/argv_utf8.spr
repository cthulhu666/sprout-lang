module main

import stdlib.argv as argv
import stdlib.string as string

# Prints every argument joined by `|`, or its own message when one is not valid UTF-8.
#
# `argv.all` answers `Err` for an argument that is not valid UTF-8; nothing in the runtime stops
# the program, and the exit status is whatever this program chooses (here 0). A valid non-ASCII
# argument is handled like any other. Run via `just argv-smoke`, which passes the arguments.

fn main() -> Unit !{IO} =
  do
    match argv.all() with
    | Ok args -> print("Ok " ++ string.join("|", args))
    | Err _ -> print("argument is not valid UTF-8")
    print("end")
