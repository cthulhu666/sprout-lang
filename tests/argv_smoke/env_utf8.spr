module main

import stdlib.env as env

# Prints what `env.get` answers for the environment variable SPROUT_SMOKE_VALUE:
#   Err                 the value is not valid UTF-8 (the outer layer is validity)
#   unset               the variable is not set (the inner layer is presence)
#   Just <v> <int>      the value, and what `parse_int` makes of it
# Run via `just argv-smoke`, which sets the variable.

fn show_int(m: Maybe Int) -> String =
  match m with
  | Just n -> "Just " ++ int_to_string(n)
  | Nothing -> "Nothing"

fn main() -> Unit !{IO} =
  do
    match env.get("SPROUT_SMOKE_VALUE") with
    | Err _ -> print("Err")
    | Ok Nothing -> print("unset")
    | Ok (Just v) -> print("Just " ++ v ++ " " ++ show_int(parse_int(v)))
