module main

# Regression fixture: `parse_int` on a String that is not valid UTF-8.
#
# `argv_get` interns the raw argv bytes without validating them (BACKLOG: "Three R2 producers
# still mint Strings…"), so it is the one way a stdlib-level program holds such a String. The digit
# scan stops at the first byte that is not a digit, so `parse_int` must answer Nothing there
# without reading the rest. Computing the string's length first walked the whole value and
# aborted at the bad byte. Run via `just argv-smoke`, which passes the arguments.

fn show(m: Maybe Int) -> String =
  match m with
  | Just n -> "Just " ++ int_to_string(n)
  | Nothing -> "Nothing"

fn report(args: List String) -> Unit !{IO} =
  match args with
  | [a | rest] ->
      do
        print(show(parse_int(a)))
        report(rest)
  | _ -> print("end")

fn main() -> Unit !{IO} =
  do
    args <- argv_all()
    report(args)
