module main

# Width-3 tuple-CPR shape (docs/scalar-replacement-v0.md, C1): a fn returning a scalar 3-tuple that
# is immediately destructured by a 3-var tuple pattern at a match scrutinee should NOT heap-allocate
# the tuple. The worker returns { i64, i64, i64 } directly (LLVM-to-LLVM, no sret). Before C1,
# `use_rgb` boxes the `rgb3` call + three field loads; after, it calls the unboxed worker and binds
# r/g/b directly.

fn rgb3(k: Int) -> (Int, Int, Int) = (k, k + 1, k + 2)

fn use_rgb(k: Int) -> Int =
  match rgb3(k) with
  | (r, g, b) -> (r * 100) + (g * 10) + b

fn main() -> Unit !{IO} = print(use_rgb(1))
