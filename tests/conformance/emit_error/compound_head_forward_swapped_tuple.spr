module main

# `outer` declares `ToString ((b, a))` but `f` needs `ToString ((a, b))`: same head,
# same variables, other order. Forwarding would render each element with the other's
# dictionary.
fn label(x: t) -> String where ToString t = to_string(x)

fn f(x: a, y: b) -> String where ToString ((a, b)) = label((x, y))

fn outer(x: a, y: b) -> String where ToString ((b, a)) = f(x, y) ++ label((y, x))

fn main() -> Unit !{IO} = print(outer(1, "s"))
