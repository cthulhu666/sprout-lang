module main

# `outer` passes on `ToString (List a)` without declaring it, so it has no dictionary
# to forward. It must stay a compile-time failure; forwarding an open `List _` here
# compiles into a dictionary nothing fills, and the program aborts at run time.
fn label(x: t) -> String where ToString t = to_string(x)

fn f(x: a) -> String where ToString (List a) = label([x])

fn outer(x: a) -> String = f(x)

fn main() -> Unit !{IO} = print(outer(3))
