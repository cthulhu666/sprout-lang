module main

type linear L = L Int

fn close(l: L) -> Int = match l with | L n -> n

fn dup(z: b) -> (b, b) = (z, z)

fn peek(l: borrowing L) -> Int = match l with | L n -> n

fn run(f: L -> Int, x: L) -> Int = f(x)

type Taker = Taker(L -> Int)

fn mk() -> Taker = Taker(peek)
#~^ ERROR

fn main() -> Unit !{IO} = match mk() with | Taker f -> print(int_to_string(f(L(1))))
