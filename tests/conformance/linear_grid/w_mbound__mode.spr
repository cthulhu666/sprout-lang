module main

wrap linear L = Int

fn close(l: L) -> Int = match l with | L n -> n

fn dup(z: b) -> (b, b) = (z, z)

fn peek_a(r: borrowing a) -> Int where linear a = 1

fn run_a(f: a -> Int, x: a) -> Int where linear a = f(x)

class K t
  fn m(s: t, x: a) -> Int where linear a

instance K Int
  fn m(s: Int, x: a) -> Int where linear a = run_a(peek_a, x)
  #~^ ERROR

fn main() -> Unit !{IO} = print(int_to_string(m(0, L(1))))
