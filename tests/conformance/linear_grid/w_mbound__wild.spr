module main

wrap linear L = Int

fn close(l: L) -> Int = match l with | L n -> n

fn dup(z: b) -> (b, b) = (z, z)

class K t
  fn m(s: t, x: a) -> Int !{IO} where linear a

instance K Int
  fn m(s: Int, x: a) -> Int !{IO} where linear a =
    do
      _ <- after(print("w"), x)
      s

fn main() -> Unit !{IO} = print(int_to_string(m(0, L(1))))
