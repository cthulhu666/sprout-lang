module main

wrap linear L = Int

fn close(l: L) -> Int = match l with | L n -> n

fn dup(z: b) -> (b, b) = (z, z)

class Taker t
  fn take(x: t) -> Int

instance Taker L
  fn take(x: L) -> Int = close(x)

type Box a = | Box a

type Wrap a = | Wrap a

instance Taker (a, b)
  fn take(x: (a, b)) -> Int = 0

fn main() -> Unit !{IO} = print(int_to_string(take((L(1), 2))))
