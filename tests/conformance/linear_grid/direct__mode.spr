module main

type linear L = L Int

fn close(l: L) -> Int = match l with | L n -> n

fn dup(z: b) -> (b, b) = (z, z)

fn peek(l: borrowing L) -> Int = match l with | L n -> n

fn run(f: L -> Int, x: L) -> Int = f(x)

fn g(x: L) -> Int = run(peek, x)
#~^ ERROR

fn main() -> Unit !{IO} = print(int_to_string(g(L(1))))
