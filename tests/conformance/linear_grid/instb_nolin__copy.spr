module main

fn dup(z: b) -> (b, b) = (z, z)

class Dup2 t
  fn dup2(x: t) -> (t, t)

instance Dup2 (Maybe a) where linear a
  fn dup2(x: Maybe a) -> (Maybe a, Maybe a) = (x, x)

fn eat(m: Maybe Int) -> Int = maybe_with_default(0, m)

fn main() -> Unit !{IO} = match dup2(Just(1)) with | (p, q) -> print(int_to_string(eat(p) + eat(q)))
