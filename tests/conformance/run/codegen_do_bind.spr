no_prelude

# This fixture defines its OWN `Maybe` and relies on `<-` binding it, so it opts
# out of the prelude (docs/prelude-scope-v0.md §4.2 step 5).
#
# Not a workaround for this change: a `module demo` header reproduces the same
# failure (`Int vs demo.Maybe Int`), because do-notation resolves the monad family
# by UNQUALIFIED name and so does not recognise a user-defined `Maybe`. That gap
# is pre-existing and tracked in BACKLOG; the file previously escaped it only by
# getting no prelude at all, which is now explicit rather than incidental.

type Maybe a = Just a | Nothing

fn safe_div(a: Int, b: Int) -> Maybe Int =
  if b == 0 then Nothing else Just(a / b)

fn chain(a: Int, b: Int, c: Int) -> Maybe Int =
  do
    x <- safe_div(a, b)
    y <- safe_div(x, c)
    Just(y + 1)

fn main() -> Unit !{IO} =
  match chain(10, 2, 1) with
  | Just n -> print(n)
  | Nothing -> print("none")
