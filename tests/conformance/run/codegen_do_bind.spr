# `<-` on the prelude's `Maybe` unwraps it and ends the block on `Nothing`.
# A file's own `Maybe` does not: it ends a block through `try` and a
# `Propagate` instance (try_own_maybe.spr).

fn safe_div(a: Int, b: Int) -> Maybe Int =
  if b == 0 then Nothing else Just(a / b)

fn chain(a: Int, b: Int, c: Int) -> Maybe Int =
  do
    x <- safe_div(a, b)
    y <- safe_div(x, c)
    Just(y + 1)

fn main() -> Unit !{IO} =
  match chain(10, 2, 1) with
  | Just n -> print(n)
  | Nothing -> print("none")
