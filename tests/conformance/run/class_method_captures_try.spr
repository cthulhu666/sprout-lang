# A user method named `branch` is not what an unfused `try` calls: `try` names the
# prelude's `Propagate.branch` (docs/qualified-class-methods-v0.md).

class Tree t
  fn branch(x: t) -> Int

instance Tree Int
  fn branch(x: Int) -> Int = x + 1

type Box a =
  | Full a
  | Empty

# Not one `match`, so a `try` on a `Box` calls `branch`.
instance Propagate Box
  fn branch(value: Box a) -> ControlFlow (Box b) a where linear a, linear b = box_flow(value)

fn box_flow(value: Box a) -> ControlFlow (Box b) a where linear a, linear b =
  match value with
  | Full v -> Continue(v)
  | Empty -> Break(Empty)

fn f(b: Box Int) -> Box Int =
  let v = try b
  in Full(v + 1)

fn main() -> Unit !{IO} =
  match f(Full(1)) with
  | Full v -> print(to_string(v))
  | Empty -> print("empty")
