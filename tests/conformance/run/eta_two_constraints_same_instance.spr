module main

# Both constraints at one instance: the two slots then carry the same impl, and
# each occurrence must still resolve (to the right slot, not by the any-slot scan).

class Make t
  fn from_int(n: Int) -> t

instance Make Int
  fn from_int(n: Int) -> Int = n + 100

instance Make String
  fn from_int(n: Int) -> String = "made"

fn apply_int(f: Int -> a, n: Int) -> a = f(n)

fn makes(x: a, y: b) -> (a, b) where Make a, Make b =
  (apply_int(from_int, 1), apply_int(from_int, 2))

fn main() -> Unit !{IO} = do
  match makes(0, 1) with
  | (m, n) -> print(int_to_string(m) ++ "|" ++ int_to_string(n))
  match makes("p", "q") with
  | (m, n) -> print(m ++ "|" ++ n)
