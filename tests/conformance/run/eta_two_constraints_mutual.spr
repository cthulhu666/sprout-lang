module main

# Two mutually recursive functions, each with two `Make` constraints.

class Make t
  fn from_int(n: Int) -> t

instance Make Int
  fn from_int(n: Int) -> Int = n + 100

instance Make String
  fn from_int(n: Int) -> String = "made"

fn apply_int(f: Int -> a, n: Int) -> a = f(n)

fn ping(n: Int, x: a, y: b) -> (a, b) where Make a, Make b =
  if n == 0 then (apply_int(from_int, 1), apply_int(from_int, 2)) else pong(n - 1, x, y)

fn pong(n: Int, x: a, y: b) -> (a, b) where Make a, Make b =
  if n == 0 then (apply_int(from_int, 3), apply_int(from_int, 4)) else ping(n - 1, x, y)

fn main() -> Unit !{IO} = do
  match ping(0, 0, "q") with
  | (m, n) -> print(int_to_string(m) ++ "|" ++ n)
  match ping(1, 0, "q") with
  | (m, n) -> print(int_to_string(m) ++ "|" ++ n)
  match pong(1, "q", 0) with
  | (m, n) -> print(m ++ "|" ++ int_to_string(n))
