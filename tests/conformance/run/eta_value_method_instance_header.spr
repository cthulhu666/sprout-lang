module main

# A method used as a value twice inside an instance whose header has two same-class
# constraints. Each occurrence takes the slot of the header variable it is used at.

class Make t
  fn from_int(n: Int) -> t

instance Make Int
  fn from_int(n: Int) -> Int = n + 100

instance Make String
  fn from_int(n: Int) -> String = "made"

type Pair a b = Pair a b

fn apply_int(f: Int -> a, n: Int) -> a = f(n)

instance Make (Pair a b) where Make a, Make b
  fn from_int(n: Int) -> Pair a b = Pair(apply_int(from_int, n), apply_int(from_int, n))

fn show(p: Pair Int String) -> String =
  match p with
  | Pair m s -> int_to_string(m) ++ "|" ++ s

fn show_swapped(p: Pair String Int) -> String =
  match p with
  | Pair s m -> s ++ "|" ++ int_to_string(m)

fn main() -> Unit !{IO} = do
  print(show(from_int(1)))
  print(show_swapped(from_int(2)))
