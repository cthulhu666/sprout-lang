module main

type linear L = L Int

fn close(l: L) -> Int = match l with | L n -> n

fn dup(z: b) -> (b, b) = (z, z)

type Box a = Box a

fn main() -> Unit !{IO} =
  do
    print(int_to_string(match Box(L(6)) with | Box l -> close(l)))
    print(int_to_string(match Just(L(7)) with | Just l -> close(l) | Nothing -> 0))
