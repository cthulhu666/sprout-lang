module main

type linear L = L Int

fn close(l: L) -> Int = match l with | L n -> n

fn dup(z: b) -> (b, b) = (z, z)

class Take t
  fn take(x: t) -> t

instance Take (Maybe a)
  fn take(x: Maybe a) -> Maybe a = x

fn main() -> Unit !{IO} = print(int_to_string(match take(Just (L(6))) with | Just l -> close(l) | Nothing -> 0))
