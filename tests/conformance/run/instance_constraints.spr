type Maybe a =
  | Nothing
  | Just a

class Positive a {
  fn is_pos(x: a) -> Bool
}

instance Positive Int {
  fn is_pos(x: Int) -> Bool = x > 0
}

instance Positive (Maybe a) where Positive a {
  fn is_pos(x: Maybe a) -> Bool =
    match x with
    | Nothing -> 1 > 2
    | Just v -> is_pos(v)
}

fn nothing_int() -> Maybe Int = Nothing

fn say(b: Bool) -> Unit !{IO} =
  if b then print("yes") else print("no")

fn main() -> Unit !{IO} = do
  say(is_pos(1))
  say(is_pos(-1))
  say(is_pos(Just(5)))
  say(is_pos(nothing_int()))
  say(is_pos(Just (Just(3))))
  say(is_pos(Just (Just(-1))))
