# Two `_` parameters in one function: a lambda, a lambda with a capture, a
# top-level fn, a tail-recursive fn, an instance method, a class method's
# dispatch wrapper, a fn returning a scalar tuple (which also gets an unboxed
# `_worker` copy) and a mutual tail call between fns of different arity (which
# goes through a trampoline).
class Pick a
  fn pick(x: a, _: a, _: a) -> a

instance Pick Int
  fn pick(x: Int, _: Int, _: Int) -> Int = x

fn pick_via(v: a) -> a where Pick a = pick(v, v, v)

fn apply(f: Int -> Int -> Int -> Int) -> Int = f(1, 2, 3)

fn first(a: Int, _: Int, _: Int) -> Int = a

fn count(n: Int, _: Int, _: Int) -> Int =
  if n == 0 then 7 else count(n - 1, n, n)

fn split(a: Int, _: Int, _: Int) -> (Int, Int) = (a, a + 1)

fn sum_split(n: Int) -> Int =
  match split(n, 0, 0) with
  | (x, y) -> x + y

fn ping(n: Int, _: Int, _: Int) -> Int = if n == 0 then 1 else pong(n - 1)

fn pong(n: Int) -> Int = if n == 0 then 2 else ping(n - 1, n, n)

fn main() -> Unit !{IO} =
  let k = 10
  in do
    print(apply(\ (a, _, _) -> a))
    print(apply(\ (_, _, c) -> c + k))
    print(first(4, 5, 6))
    print(count(5, 2, 3))
    print(pick(8, 9, 0))
    print(pick_via(3))
    print(sum_split(2))
    print(ping(5, 0, 0))
