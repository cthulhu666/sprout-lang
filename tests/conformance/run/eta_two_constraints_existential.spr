module main

# `makes` is reached with dictionaries unpacked from two existentials, so what it
# forwards is not a known instance at the call. Inside `makes` each occurrence
# still takes its own constraint's slot.

class Make t
  fn from_int(n: Int) -> t

instance Make Int
  fn from_int(n: Int) -> Int = n + 100

instance Make String
  fn from_int(n: Int) -> String = "made"

type Pack = | exists a. Pack a where Make a, ToString a

fn apply_int(f: Int -> a, n: Int) -> a = f(n)

fn makes(x: a, y: b) -> (a, b) where Make a, Make b =
  (apply_int(from_int, 1), apply_int(from_int, 2))

fn made_pair(p: Pack, q: Pack) -> String =
  match p with
  | Pack x -> match q with
    | Pack y -> match makes(x, y) with
      | (m, n) -> to_string(m) ++ "|" ++ to_string(n)

fn main() -> Unit !{IO} = do
  print(made_pair(Pack(0), Pack("q")))
  print(made_pair(Pack("q"), Pack(0)))
