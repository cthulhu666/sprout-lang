module main

# A comprehension elaborates into calls to bare prelude names (`list_fold`,
# `list_reverse`, `Cons`). A local with one of those names is renamed by the
# bundler, so the elaborated call still reaches the prelude's
# (docs/prelude-name-identity-v0.md).
fn shadowed(xs: List Int) -> List Int =
  let list_fold = 5
  in [x * x for x in xs]

fn main() -> Unit !{IO} = print(to_string(shadowed([1, 2, 3])))
