module main

# `outer` has `ToString a` but not `ToString (List a)`, so the list dictionary is
# built from the List instance over `outer`'s own `ToString a`. Handing over the
# element dictionary itself read an Int through the List instance.
fn label(x: t) -> String where ToString t = to_string(x)

fn f(x: a) -> String where ToString (List a) = label([x])

fn outer(x: a) -> String where ToString a = f(x) ++ " " ++ label(x)

fn main() -> Unit !{IO} = print(outer(3))
