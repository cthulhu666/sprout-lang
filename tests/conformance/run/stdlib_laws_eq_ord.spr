fn check(label: String, ok: Bool) -> Unit !{IO} =
  if ok then print(label ++ ": ok")
  else print(label ++ ": FAIL")

fn main() -> Unit !{IO} = do
  check("int reflexivity", 42 == 42)
  check("str reflexivity", "hello" == "hello")
  check("bool reflexivity", (1 > 0) == (1 > 0))
  check("int symmetry eq", (1 == 2) == (2 == 1))
  check("int symmetry ne", (3 == 3) == (3 == 3))
  check("str symmetry", ("a" == "b") == ("b" == "a"))
  check("int trans", if 1 <= 2 && 2 <= 3 then 1 <= 3 else false)
  check("int antisymm", if 5 <= 5 && 5 <= 5 then 5 == 5 else false)
  check("int totality", 1 <= 2 || 2 <= 1)
