# The instance is declared after the `try`. Instances are in scope throughout
# their module, so the `try` finds it as the call to `branch` would.

type Fetch a =
  | Got a
  | Failed String

fn bump(f: Fetch Int) -> Fetch Int =
  let v = try f
  in Got(v + 1)

instance Propagate Fetch
  fn branch(value: Fetch a) -> ControlFlow (Fetch b) a where linear a, linear b =
    match value with
    | Got v -> Continue(v)
    | Failed why -> Break(Failed(why))

fn main() -> Unit !{IO} =
  match bump(Got(1)) with
  | Got v -> print(to_string(v))
  | Failed why -> print(why)
