module main

fn dup(z: b) -> (b, b) = (z, z)

class Take t
  fn take(x: t) -> t

instance Take (Maybe a) where linear a
  fn take(x: Maybe a) -> Maybe a = match (x, 0) with | (y, _) -> y

fn eat(m: Maybe Int) -> Int = maybe_with_default(0, m)

fn main() -> Unit !{IO} = print(int_to_string(eat(take(Just(1)))))
