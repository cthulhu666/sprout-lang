module main

type linear L = L Int

fn close(l: L) -> Int = match l with | L n -> n

fn dup(z: b) -> (b, b) = (z, z)

type Box a = Box a

fn peek(l: borrowing L) -> Int = match l with | L n -> n

fn g(b: Box L) -> Int =
  match b with
  | Box l ->
    let n = list_fold(\ (acc, i) -> acc + i + peek(l), 0, [1, 2])
    in n + close(l)

fn main() -> Unit !{IO} = print(int_to_string(g(Box (L(10)))))
