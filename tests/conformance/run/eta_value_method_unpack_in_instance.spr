module main

# Two existentials unpacked inside an instance method, each using a method as a
# value: the unpacks' slots inside an instance body, not a function's.

class Step t
  fn bump(x: t) -> t

instance Step Int
  fn bump(x: Int) -> Int = x + 1

instance Step String
  fn bump(x: String) -> String = x ++ "!"

type Pack = | exists a. Pack a where Step a, ToString a

type Two = Two Pack Pack

fn app(f: a -> a, v: a) -> a = f(v)

instance ToString Two
  fn to_string(t: Two) -> String =
    match t with
    | Two p q -> match p with
      | Pack x -> match q with
        | Pack y -> to_string(app(bump, x)) ++ "|" ++ to_string(app(bump, y))

fn main() -> Unit !{IO} = do
  print(to_string(Two (Pack(1), Pack("q"))))
  print(to_string(Two (Pack("q"), Pack(1))))
