module main

# The CPR worker for an extern that returns a `Result` is `name(p0, ...)` over the extern's own
# parameters. A parameter spelled like the extern is renamed by the bundler, so the worker still
# calls the extern. The extern is redeclared here and `stdlib.regex` is not imported, so this
# declaration's parameter names are the ones used.

extern fn regex_validate(regex_validate: String) -> Result String Unit

fn probe() -> Int =
  match regex_validate("(") with
  | Ok _ -> 1
  | Err _ -> 2

fn main() -> Unit !{IO} =
  do
    n <- probe()
    print(n)
