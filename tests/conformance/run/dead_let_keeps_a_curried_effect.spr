module main

# A declared effect sits on the LAST arrow, so a two-parameter `!{IO}` function
# has a PURE outer arrow. A pass that reads only the outermost arrow calls this
# call pure and may delete it, and reachability then drops `logit` itself. The
# effect must survive the binding being dead — only the name is unused, not the
# work.

fn logit(a: Int, b: Int) -> Int !{IO} = do
  print("effect")
  a + b

fn main() -> Unit !{IO} = do
  let dead = logit(1, 2)
  print("done")
