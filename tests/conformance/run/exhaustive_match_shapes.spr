module main

# W5 positive guard: these matches ARE exhaustive / reachable and MUST stay
# accepted after the exhaustiveness + unreachability checks land. This is the
# false-positive tripwire — per-column coverage must accept nested Bool.

# Nested Bool: Just's field column covers {true, false}; Nothing covers the rest.
# The coarse "any literal subpattern -> not covered" rule would WRONGLY reject this.
fn describe(m: Maybe Bool) -> String =
  match m with
  | Just true -> "jt"
  | Just false -> "jf"
  | Nothing -> "n"

# Full ADT coverage via a binder (Just x covers every Just).
fn unwrap_or(m: Maybe Int, d: Int) -> Int =
  match m with
  | Just x -> x
  | Nothing -> d

# Bool with both branches — exhaustive, no catchall needed.
fn neg(b: Bool) -> Bool =
  match b with
  | true -> false
  | false -> true

# Catchall only — exhaustive, and the single branch is reachable.
fn always(n: Int) -> String =
  match n with
  | _ -> "any"

fn main() -> Unit !{IO} =
  do
    print(describe(Just(true)))
    print(describe(Just(false)))
    print(describe(Nothing))
    print(int_to_string(unwrap_or(Just(7), 0)))
    print(int_to_string(unwrap_or(Nothing, 9)))
    print(if neg(false) then "T" else "F")
    print(always(123))
