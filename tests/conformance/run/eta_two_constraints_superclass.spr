module main

# The constraints are on a subclass; the method used as a value belongs to its
# superclass, whose slots are the subclass constraints' transitive supers.

class Make t
  fn from_int(n: Int) -> t

class Make2 t where Make t
  fn name2(x: t) -> String

instance Make Int
  fn from_int(n: Int) -> Int = n + 100

instance Make String
  fn from_int(n: Int) -> String = "made"

instance Make2 Int
  fn name2(x: Int) -> String = "int"

instance Make2 String
  fn name2(x: String) -> String = "string"

fn apply_int(f: Int -> a, n: Int) -> a = f(n)

fn supers(x: a, y: b) -> (a, b) where Make2 a, Make2 b =
  (apply_int(from_int, 1), apply_int(from_int, 2))

fn main() -> Unit !{IO} = do
  match supers(0, "q") with
  | (m, n) -> print(int_to_string(m) ++ "|" ++ n)
  match supers("q", 0) with
  | (m, n) -> print(m ++ "|" ++ int_to_string(n))
