no_prelude

# `rec_inline` copies a callee's body into its caller. `f` reads the top-level `k`; every caller
# below has a local `k`, so a copy placed there would read the local. The pass leaves such a call.
# A `no_prelude` entry keeps its names bare, so the bundler's local rename does not protect it
# (a normal entry is qualified to `$entry.k`). Each line is 3 + 2 + 100, or 3 * 2 + 100.

type Pair = (x: Int, y: Int)
type Box = Box Int
type Fun = Fun(Pair -> Int)

let k: Int = 2

fn f(v: Pair) -> Int = v.x + k

# Reads nothing a caller could shadow: still inlined.
fn twice(v: Pair) -> Int = v.x * 2

fn by_let(z: Int) -> Int =
  let k = 100
  in f(Pair(x = z, y = z)) + k

fn by_param(k: Int, z: Int) -> Int = f(Pair(x = z, y = z)) + k

fn by_arm(b: Box, z: Int) -> Int =
  match b with
  | Box k -> f(Pair(x = z, y = z)) + k

fn by_lambda(z: Int) -> Int =
  let g = \k -> f(Pair(x = z, y = z)) + k
  in g(100)

fn by_do(z: Int) -> Int !{IO} =
  do
    let k = 100
    f(Pair(x = z, y = z)) + k

fn unrelated(z: Int) -> Int =
  let k = 100
  in twice(Pair(x = z, y = z)) + k

# The other direction: the local has the name of the callee. `f(..)` below is the local `f`, which
# is `twice`: 2 * 3, not the top-level `f` (3 + 2).
fn name_by_let(z: Int) -> Int =
  let f = twice
  in f(Pair(x = z, y = z))

fn name_by_param(f: Pair -> Int, z: Int) -> Int = f(Pair(x = z, y = z))

fn name_by_arm(u: Fun, z: Int) -> Int =
  match u with
  | Fun f -> f(Pair(x = z, y = z))

fn name_by_lambda(z: Int) -> Int =
  let h = \f -> f(Pair(x = z, y = z))
  in h(twice)

fn name_by_do(z: Int) -> Int !{IO} =
  do
    let f = twice
    f(Pair(x = z, y = z))

# A callee whose own body has a local `f`: copied into a caller, it still calls its local.
fn body_local(v: Pair) -> Int =
  let f = twice
  in f(v)

# `g(x)` calls the local `g`, so it uses `x` whole: `x` does not split, and the field-only `twice`
# is not inlined on it either.
fn g(v: Pair) -> Int = v.x

fn whole_use(z: Int) -> Int =
  let x = Pair(x = z, y = z)
  in let g = twice
     in g(x) + twice(x)

fn name_in_body(z: Int) -> Int = body_local(Pair(x = z, y = z))

fn main() -> Unit !{IO} =
  do
    n <- by_do(3)
    m <- name_by_do(3)
    print_str(int_to_string(by_let(3)))
    print_str(int_to_string(by_param(100, 3)))
    print_str(int_to_string(by_arm(Box(100), 3)))
    print_str(int_to_string(by_lambda(3)))
    print_str(int_to_string(n))
    print_str(int_to_string(unrelated(3)))
    print_str(int_to_string(name_by_let(3)))
    print_str(int_to_string(name_by_param(twice, 3)))
    print_str(int_to_string(name_by_arm(Fun(twice), 3)))
    print_str(int_to_string(name_by_lambda(3)))
    print_str(int_to_string(m))
    print_str(int_to_string(name_in_body(3)))
    print_str(int_to_string(whole_use(3)))
