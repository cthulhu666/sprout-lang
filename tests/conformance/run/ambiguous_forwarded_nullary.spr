module main

# `blank`'s result IS the class variable. With two same-class constraints both
# slots carry `blank`; the occurrence's type is an inference variable that
# `@eta_fwdvar` maps back to the written `a` or `b`, so each use reaches its own
# constraint's instance whichever of them it belongs to.

class Blank t
  fn blank() -> t
  fn combine(x: t, y: t) -> t

instance Blank Int
  fn blank() -> Int = 0
  fn combine(x: Int, y: Int) -> Int = x + y

instance Blank String
  fn blank() -> String = ""
  fn combine(x: String, y: String) -> String = x ++ y

fn run_thunk(th: () -> a) -> a = th()

fn only_b(x: a, y: b) -> b where Blank a, Blank b = combine(y, run_thunk(blank))

fn main() -> Unit !{IO} = print(only_b(7, "q"))
