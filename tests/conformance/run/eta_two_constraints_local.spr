module main

# A monomorphic local lambda pinned to one constraint's type, and a higher-order
# local given the method as a value.

class Make t
  fn from_int(n: Int) -> t

instance Make Int
  fn from_int(n: Int) -> Int = n + 100

instance Make String
  fn from_int(n: Int) -> String = "made"

fn apply_int(f: Int -> a, n: Int) -> a = f(n)

fn same(v: t, w: t) -> t = v

fn locals(x: a, y: b) -> (a, b) where Make a, Make b =
  let first = \n -> same(apply_int(from_int, n), x)
      second = \n -> same(apply_int(from_int, n), y)
  in (first(1), second(2))

fn higher(x: a, y: b) -> (a, b) where Make a, Make b =
  let ha = \g -> g(5)
      hb = \g -> g(5)
  in (same(ha(from_int), x), same(hb(from_int), y))

fn main() -> Unit !{IO} = do
  match locals(0, "q") with
  | (m, n) -> print(int_to_string(m) ++ "|" ++ n)
  match higher(0, "q") with
  | (m, n) -> print(int_to_string(m) ++ "|" ++ n)
