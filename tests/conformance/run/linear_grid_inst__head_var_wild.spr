module main

type linear L = L Int

fn close(l: L) -> Int = match l with | L n -> n

fn dup(z: b) -> (b, b) = (z, z)

class Count t
  fn count(x: t) -> Maybe Int

instance Count (Maybe a)
  fn count(x: Maybe a) -> Maybe Int =
    do
      _ <- x
      Just(0)

fn main() -> Unit !{IO} = print(match count(Just(1)) with | Just n -> int_to_string(n) | Nothing -> "none")
