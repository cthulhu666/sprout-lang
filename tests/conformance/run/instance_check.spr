no_prelude

# This fixture declares its OWN `class Eq`, which the prelude also declares, so it
# opts out of the prelude (docs/prelude-scope-v0.md §4.2 step 5).
#
# Not a workaround for this change: a `module demo` header reproduces the same
# failure — `invalid redefinition of function '__cm_Eq_eq'` — because the
# class-method wrapper is mangled from the CLASS and METHOD names only, dropping
# the module prefix that the dictionary parameter (`__tc_demo.Eq_0_eq`) does carry.
# That gap is pre-existing and tracked in BACKLOG; the file previously escaped it
# only by getting no prelude at all, which is now explicit rather than incidental.

class Eq a
  fn eq(x: a, y: a) -> Bool

instance Eq Int
  fn eq(x: Int, y: Int) -> Bool = x == y

instance Eq String
  fn eq(x: String, y: String) -> Bool = x == y

fn check_ints() -> Bool = eq(1, 2)

fn check_strings() -> Bool = eq("hello", "world")

fn main() -> Unit !{IO} =
  if check_ints() then print("equal") else print("not-equal")
