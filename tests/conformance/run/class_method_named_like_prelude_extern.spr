module main

# A user class method named like a prelude extern leaves the extern's own
# declaration alone.

class Render a
  fn double_to_string(x: a) -> String

instance Render Int
  fn double_to_string(x: Int) -> String = "int " ++ int_to_string(x)

fn main() -> Unit !{IO} = print(double_to_string(7))
