module main

# An instance method may rename the method's own variables (`x`, `y` for the class's
# `a`, `b`), constrained ones too when its `where` follows the rename, and may be
# more general than its class (`extra: n` where the class says Int), and may return a
# pure function where the class allows an `!{IO}` one. Only the head's variables
# must keep the head's names.

class Mapper f
  fn map_it(g: a -> b, xs: f a) -> f b

type Box a = Box a

instance Mapper Box
  fn map_it(h: x -> y, xs: Box x) -> Box y =
    match xs with
    | Box v -> Box(h(v))

class Sized t
  fn size_of(x: t, extra: Int) -> Int

instance Sized (Box a)
  fn size_of(x: Box a, extra: n) -> Int = 1

class Tagged t
  fn tagged(x: t, label: a, count: b) -> String where ToString a, ToString b

instance Tagged (Box a)
  fn tagged(x: Box a, label: l, count: c) -> String where ToString l, ToString c =
    to_string(label) ++ ":" ++ to_string(count)

class Doubler t
  fn doubler(k: t) -> Int -> Int !{IO}

instance Doubler (Box a)
  fn doubler(k: Box a) -> Int -> Int = \n -> n * 2

fn unbox(b: Box Int) -> Int =
  match b with
  | Box v -> v

fn main() -> Unit !{IO} =
  do
    print(int_to_string(unbox(map_it(\v -> v + 1, Box(41)))))
    print(int_to_string(size_of(Box("s"), 5)))
    print(tagged(Box(0), "n", 3))
    print(int_to_string(doubler(Box(0))(21)))
