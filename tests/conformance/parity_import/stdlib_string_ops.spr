import stdlib.string as strlib

fn count_words(s: String) -> Int =
  list_length(strlib.words(s))

fn first_word(s: String) -> Maybe String =
  match strlib.words(s) with
  | Nil      -> Nothing
  | Cons w _ -> Just(w)

fn words_joined(sep: String, s: String) -> String =
  match strlib.words(s) with
  | Nil -> ""
  | parts -> str_concat(sep, str_concat(sep, str_concat(sep, sep)))

fn main() -> Unit !{IO} =
  print(count_words("hello world foo"))
