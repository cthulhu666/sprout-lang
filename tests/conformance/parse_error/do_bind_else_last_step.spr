# sprout-ignore-all lint/unparsed: parse-error fixture — this file must not parse
module main

# A binding with `else` continues into the steps after it; as the last step it
# has none.

fn get() -> Maybe Int !{IO} =
  do
    print("start")
    Just(1)

fn main() -> Unit !{IO} =
  do
    print("a")
    Just x <- get() else print("none")
