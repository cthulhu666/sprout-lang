module main

# `linear_discarded_container.spr` with its error's hint applied.

type linear File = File Int

fn find(n: Int) -> Maybe File !{IO} =
  do
    let m = n
    Just(File(m))

fn close(f: File) -> Int =
  match f with
  | File n -> n

fn go() -> Int !{IO} =
  do
    let m = find(1)
    let r = match m with | Just f -> close(f) | Nothing -> 0
    7 + r

fn main() -> Unit !{IO} = print(to_string(go()))
