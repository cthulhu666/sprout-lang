module main

# The hint applied: a constructor type, matched to take every linear field.

type linear R = R(Int)
type linear P = P R R

fn spend(r: R) -> Int =
  match r with
  | R (n) -> n

fn first(p: P) -> Int =
  match p with
  | P a b -> spend(a) + spend(b)

fn main() -> Unit !{IO} = print("x")
