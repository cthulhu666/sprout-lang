module main

# `lambda_borrow_param_captures_linear.spr` with its error's hint applied.

type linear File = File Int

fn peek(f: borrowing File) -> Int = 0
fn release(f: consuming File) -> Int = match f with | File n -> n

fn with_file(n: Int, work: once (borrowing File) -> Int) -> Int =
  do
    let f = File(n)
    let r = work(f)
    r + release(f)

fn leaky(n: Int) -> Int =
  do
    let outer = File(n)
    with_file(n, \c -> peek(c) + release(outer))

fn main() -> Unit !{IO} = print(to_string(leaky(1)))
