module main

# M4.5 v0 limit (design note 7): a borrowed value may not be captured by a
# lambda. Soundness would turn on whether the closure escapes and outlives the
# consume, and Sprout has no escaping/non-escaping distinction. Unlocked by the
# same non-escaping-closure notion M4.4 needs -- filed once, not twice.

type linear File = File Int

fn peek(f: borrowing File) -> Int = 0

fn capture(f: borrowing File) -> Int =
  let g = \_ -> peek(f)
  in g(0)

fn main() -> Unit !{IO} =
  print(to_string(capture(File(1))))
