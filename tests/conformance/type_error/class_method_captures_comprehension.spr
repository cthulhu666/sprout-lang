module main

# A known limit (spec §3.1): class methods keep bare names, so a method named
# like a prelude function is what a comprehension calls. When the limit is
# lifted, this fixture moves to run/.

class Rev a
  fn list_reverse(x: a) -> Int

instance Rev Int
  fn list_reverse(x: Int) -> Int = x

fn squares(xs: List Int) -> List Int = [x * x for x in xs]

fn main() -> Unit !{IO} = print(squares(range_to_list(1..3)))
