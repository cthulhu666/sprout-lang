module main

# The linear rule of spec-v0.md §5.8 must still fire inside an EFFECTFUL block. The spec used to
# claim the opposite -- "Effectful blocks (`!{IO}`) run every step and are unaffected" -- and
# `linear_check` implemented that literally, which is how `bench/http_worker_pool` leaked a
# connection on every read timeout with the checker silent.
#
# This fixture is deliberately the case the §5.9 TYPING rule does NOT catch: the function returns
# `Result`, so the fallible bind is perfectly well-typed and propagates legally. Only the linearity
# check can see that `release` is skipped on the failure path. Without it, this compiles clean.
#
# Keep it that way. If someone concludes the typing rule made §5.8's consume rule redundant, this is
# the counter-example: well-typed, effectful, and still a leak.

type linear File = File Int

fn release(f: consuming File) -> Int = match f with | File n -> n
fn step(f: borrowing File) -> Result Int Int !{IO} = Ok(1)

fn talk(f: File) -> Result Int Unit !{IO} =
  do
    a <- step(f)
    let _ = release(f)
    print(to_string(a))
    Ok(())

fn main() -> Unit !{IO} =
  match talk(File(1)) with
  | Ok _ -> print("ok")
  | Err _ -> print("err")
