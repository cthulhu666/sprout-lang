module main

# `borrow_capture_in_lambda.spr` with its error's hint applied.

type linear File = File Int

fn peek(f: borrowing File) -> Int = 0

fn release(f: consuming File) -> Int = match f with | File n -> n

fn capture(f: borrowing File) -> Int =
  let v = peek(f)
  in let g = \_ -> v
  in g(0)

fn main() -> Unit !{IO} =
  do
    let f = File(1)
    let r = capture(f)
    print(to_string(r + release(f)))
