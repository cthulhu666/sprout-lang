# The instance's `Break` arm is wrong, and it is declared below the `try`. A `try`
# fuses only with a checked instance, so the error is the instance's, not `bump`'s.

type Fetch a =
  | Got a
  | Failed String

fn bump(f: Fetch Int) -> Fetch Int =
  let v = try f
  in Got(v + 1)

instance Propagate Fetch
  fn branch(value: Fetch a) -> ControlFlow (Fetch b) a where linear a, linear b =
    match value with
    | Got v -> Continue(v)
    | Failed why -> Break(Failed(why + 1))

fn main() -> Unit !{IO} =
  match bump(Got(1)) with
  | Got v -> print(to_string(v))
  | Failed why -> print(why)
