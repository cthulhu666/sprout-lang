module main

# An `exists` variable is bounded like a function's: without its bound the pack
# is rejected, since `unbox` could otherwise reach the `L` twice.

type linear L = L Int

fn close(l: L) -> Int = match l with | L n -> n

class Taker a
  fn take(x: a) -> Int

instance Taker L
  fn take(x: L) -> Int = close(x)

type Boxed = | exists a. Boxed a where Taker a

fn unbox(b: Boxed) -> Int = match b with | Boxed x -> take(x)

fn main() -> Unit !{IO} =
  do
    let b = Boxed(L(1))
    print(int_to_string(unbox(b) + unbox(b)))
