module main

# `linear_discarded_result_block.spr` with its error's hint applied.

type linear File = File Int

fn acquire(n: Int) -> Result String File = Ok(File(n))

fn close(f: File) -> Int =
  match f with
  | File n -> n

fn go(n: Int) -> Result String Int =
  do
    f <- acquire(1)
    let m = close(f)
    Ok(n + m)

fn main() -> Unit !{IO} = print(to_string(go(2)))
