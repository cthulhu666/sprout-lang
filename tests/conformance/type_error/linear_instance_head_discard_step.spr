module main

# `first(x)` discards a value of the instance head's `a`. A use of the instance
# can make `a` linear, and step 3 of docs/linearity-bound-v0.md has not yet
# made those uses checked, so the discard is rejected in the body.

type linear L = L Int

class Count t
  fn count(x: t) -> Int

fn first(m: Maybe a) -> a = match m with | Just v -> v | Nothing -> panic("none")

instance Count (Maybe a)
  fn count(x: Maybe a) -> Int =
    do
      first(x)
      0

fn main() -> Unit !{IO} = print(int_to_string(count(Just (L(1)))))
