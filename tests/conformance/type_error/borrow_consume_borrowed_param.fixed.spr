module main

# `borrow_consume_borrowed_param.spr` with its error's hint applied.

type linear File = File Int

fn release(f: consuming File) -> Int = match f with | File n -> n

fn bad(f: consuming File) -> Int = release(f)

fn main() -> Unit !{IO} =
  do
    let f = File(1)
    print(to_string(bad(f)))
