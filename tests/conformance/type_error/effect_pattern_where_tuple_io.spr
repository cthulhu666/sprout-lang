module main

# The binder keeps the `!{IO}` arrow through a tuple pattern in a `where` binding,
# so calling it in a pure fn performs IO.

fn shout(n: Int) -> Int !{IO} =
  do
    print(n)
    n

fn pure_f(x: Int) -> Int = g(x)
where
  (g, _) = (shout, 1)

fn main() -> Unit !{IO} = print(pure_f(3))
