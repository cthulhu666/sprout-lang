module main

# A row on the CLASS side only, and this check is the only thing that reaches it:
# a class method signature has no body and so records no EffectReport
# (docs/effect-enforcement-v0.md §13.7). Declining it here means declining it
# everywhere, which let `pure_user` below run the IO.
#
# The expected position is the CLASS declaration's, not this instance's — the
# message names a class method, so the caret must point at one (guidelines.md §5).

class Quiet a
  fn calc(x: a) -> Int !{IO, e}

type Q = Q

instance Quiet Q
  fn calc(x: Q) -> Int !{IO} =
    do
      print("io")
      1

fn pure_user() -> Int = calc(Q)

fn main() -> Unit !{IO} = print(int_to_string(pure_user()))
