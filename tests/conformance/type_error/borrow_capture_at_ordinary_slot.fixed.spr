module main

# `borrow_capture_at_ordinary_slot.spr` with its error's hint applied.

type linear File = File Int

fn peek(f: borrowing File) -> Int = 0

fn run_plain(work: local Unit -> Int) -> Int = work(())

fn lend(c: borrowing File) -> Int = run_plain(\_ -> peek(c))

fn main() -> Unit !{IO} = print("unreachable")
