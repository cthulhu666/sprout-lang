# `linear_wildcard_field.spr` with its error's hint applied.

type linear Conn = Conn Int
type linear Wrap = Wrap Conn

fn close(c: Conn) -> Int = match c with | Conn n -> n

fn drop(w: Wrap) -> Int =
  match w with
  | Wrap c -> close(c)

fn main() -> Unit !{IO} = print(int_to_string(drop(Wrap (Conn(1)))))
