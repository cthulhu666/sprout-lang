module main

# A method used as a value, whose instance context needs a class the
# constructor does not pack, has no instance.

class Step t
  fn bump(x: t) -> t

instance Step Int
  fn bump(x: Int) -> Int = x + 1

type Pack = | exists a. Pack a where Step a

fn app2(f: a -> String, v: a) -> String = f(v)

fn show(p: Pack) -> String =
  match p with
  | Pack x -> app2(to_string, [x])
#~^ ERROR

fn main() -> Unit !{IO} = print(show(Pack(1)))
