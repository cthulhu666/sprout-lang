# A class with more than one parameter is rejected at its declaration, before any
# instance or mention of its methods is looked at.
class Conv a b
#~^ ERROR
  fn conv(x: a) -> b

instance Conv Int String
  fn conv(x: Int) -> String = "int->string"

fn apply(f: Int -> String, n: Int) -> String = f(n)

fn main() -> Unit !{IO} = print(apply(conv, 1))
