import stdlib.task (Scope, with_scope, task_fork, task_await)

# The hint in the .err applied; the comments below describe the rejected program.

# The real-world shape of the discarded-linear-result hole: forking without
# binding the handle. `linear_task_leak` covers the BOUND-and-dropped case
# (`h <- task_fork(...)`, `h` never used); this is the never-bound one, which
# the binder-keyed analysis cannot see at all. Both leak the `Task`.
fn body(s: Scope) -> Int !{IO} =
  do
    t <- task_fork(s, \_ -> 41)
    n <- task_await(t)
    n + 7

fn main() -> Unit !{IO} =
  print(to_string(with_scope(body)))
