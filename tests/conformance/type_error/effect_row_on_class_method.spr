module main

# A row on BOTH sides. It must never be reported as a MISMATCH: a row is outside
# the order spec §7 rule 8's comparison ranks, and left to rank one it said
# `declared !{IO, e}, but the class declares !{IO, e}` — a contradiction on its
# face. The two sides are written identically here so any mismatch complaint is
# wrong by construction.
#
# The class-side scan reaches it first and names the class method; its single-side
# twins are effect_row_on_class_method_no_instance.spr and
# effect_row_on_instance_method_only.spr.

class Quiet a
  fn calc(x: a) -> Int !{IO, e}

instance Quiet Int
  fn calc(x: Int) -> Int !{IO, e} = x + 1

fn main() -> Unit !{IO} = print(int_to_string(calc(1)))
