module main

# A method that writes the class's `a` as `q` calls it `q`, so a restated
# `where ToString a` names nothing in its signature, and bare `z` is seeded `q`.
# Keeping `z` as the class's `a` instead would make it a different variable from
# `g`'s `q`, and a body calling `g(z)` would fail with "a merged with q".

type Box = Box

class H t
  fn h(k: t, g: a -> String, z: a) -> String where ToString a

instance H Box
  fn h(k: Box, g: q -> String, z) -> String where ToString a = to_string(z)

fn main() -> Unit !{IO} = print(h(Box, \n -> "x", 2))
