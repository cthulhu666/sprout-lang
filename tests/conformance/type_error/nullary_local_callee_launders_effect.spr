module main

# Binding a nullary IO function to a local must not launder its effect. The
# direct call reads it off the callee's Scheme; only the thunk arrow survives
# the `let`, so this spelling is the one that proves the arrow is consulted.

fn io_thunk() -> Int !{IO} = do
  print("io")
  34

fn launder() -> Int =
  let t = io_thunk
  in t()

fn main() -> Unit !{IO} = print(int_to_string(launder()))
