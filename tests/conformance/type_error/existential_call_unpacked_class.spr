module main

# A direct call of a class method the constructor does not pack is rejected.

class Step t
  fn bump(x: t) -> t

instance Step Int
  fn bump(x: Int) -> Int = x + 1

type Pack = | exists a. Pack a where ToString a

fn show(p: Pack) -> String =
  match p with
  | Pack x -> to_string(bump(x))
#~^ ERROR

fn main() -> Unit !{IO} = print(show(Pack(1)))
