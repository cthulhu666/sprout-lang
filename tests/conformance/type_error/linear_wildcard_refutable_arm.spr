# `Just (File 1)` has a refutable sub-pattern, so it rules nothing out: the
# `_` arm can still match a `Just`, and drops its `File`.

type linear File = File Int

fn close(f: File) -> Int = match f with | File n -> n

fn peek(m: Maybe File) -> Int =
  match m with
  | Just (File 1) -> 1
  | _ -> 0
#~^ ERROR

fn main() -> Unit !{IO} = print(int_to_string(peek(Just (File(1)))))
