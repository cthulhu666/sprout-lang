module main

# The hint applied: `Boxed` is linear, so `b` is unboxed once.

type linear L = L Int

fn close(l: L) -> Int = match l with | L n -> n

class Taker a
  fn take(x: a) -> Int

instance Taker L
  fn take(x: L) -> Int = close(x)

type Boxed = | exists a. Boxed a where linear a, Taker a

fn unbox(b: Boxed) -> Int = match b with | Boxed x -> take(x)

fn main() -> Unit !{IO} =
  do
    let b = Boxed(L(1))
    print(int_to_string(unbox(b)))
