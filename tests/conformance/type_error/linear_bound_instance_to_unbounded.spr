module main

# An instance method's bounded variable is linear in its body too, so it cannot
# be handed to `dup`, which copies its `b`.

class Wrap f
  fn wrap1(x: a) -> f a where linear a

type Two a = Two a a

fn dup(z: b) -> (b, b) = (z, z)

fn two_of(p: (a, a)) -> Two a where linear a = match p with | (x, y) -> Two(x, y)

instance Wrap Two
  fn wrap1(x: a) -> Two a where linear a = two_of(dup(x))

fn main() -> Unit !{IO} = print("x")
