module main

# `lambda_borrow_param_captured_by_nested.spr` with its error's hint applied.

type linear File = File Int

fn peek(f: borrowing File) -> Int = 0
fn release(f: consuming File) -> Int = match f with | File n -> n

fn with_file(n: Int, work: (borrowing File) -> Int) -> Int =
  do
    let f = File(n)
    let r = work(f)
    r + release(f)

fn nested(n: Int) -> Int = with_file(n, \c -> let v = peek(c) in with_file(1, \d -> v))

fn main() -> Unit !{IO} = print(to_string(nested(1)))
