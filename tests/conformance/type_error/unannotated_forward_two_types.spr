module main

# A quantified placeholder let ONE unannotated function be used at two different
# types by two different callers, both accepted, neither matching its real type.
#
# `fwd` is a dependency of both callers, so it is inferred first and is genuinely
# `Bool`. The first caller to disagree is rejected, and the message names the type
# `fwd` actually has — which the caller-order-dependent version could not do,
# because at that point nothing knew it yet.
fn use_as_string() -> String = fwd()

fn use_as_int() -> Int = fwd()

fn fwd() = true

fn main() -> Unit !{IO} = print(use_as_string())
