import stdlib.task (Scope, with_scope, task_fork, task_await)

# M4 linear `Task a`: a forked handle is consumed by `task_await`. Awaiting the
# same handle twice reuses a linear value — a compile error.
# See docs/linear-task-v0.md.
fn body(s: Scope) -> Int !{IO} =
  do
    h <- task_fork(s, \_ -> 42)
    a <- task_await(h)
    b <- task_await(h)
    a + b

fn main() -> Unit !{IO} =
  print(to_string(with_scope(body)))
