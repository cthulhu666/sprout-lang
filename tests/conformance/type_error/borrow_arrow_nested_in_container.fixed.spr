module main

# The hint in the .err applied; the comments below describe the rejected program.

# A modifier written inside an arrow that is itself inside a type CONSTRUCTOR.
# The validation walked only the arrow spine, so anything reached through a type
# argument or a tuple component was never asked about — and `borrowing a` is
# exactly the type-variable case spec §5.8 says is rejected, the one whose whole
# point is that `borrowing Int` must not be reachable by instantiating it.

type linear File = File Int

fn apply(gs: List ((borrowing a) -> Int)) -> Int where linear a = 0

fn main() -> Unit !{IO} = print(to_string(apply(Nil)))
