module main

# The worst shape: the `Nothing` box returned as a `List Int` matches NEITHER `Nil`
# NOR `[h | t]`, so a match the compiler proved total under §5.5 dies at runtime
# with `non-exhaustive match`. Exhaustiveness is only sound if this is rejected.

fn find_it(x: Int) -> Maybe Int =
  if x > 0 then Just(x) else Nothing

fn returns_list() -> List Int =
  do
    v <- find_it(0)
    Cons(v, Nil)

fn main() -> Unit !{IO} =
  print(int_to_string(list_length(returns_list())))
