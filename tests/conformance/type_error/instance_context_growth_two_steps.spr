# The context `Foo (Maybe (List a))` is larger than the head `Foo (List a)`. The second
# instance alone is fine.
class Foo t
  fn foo(x: t) -> Int

instance Foo (List a) where Foo (Maybe (List a))
#~^ ERROR
  fn foo(x: List a) -> Int = 1

instance Foo (Maybe a) where Foo a
  fn foo(x: Maybe a) -> Int = 2

fn main() -> Unit !{IO} = print(to_string(foo([1])))
