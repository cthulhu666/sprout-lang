# A function's unannotated return needs `Eq`, and a slot with no annotation has no
# variable to constrain, so the message names the return type, not a parameter.
fn g() =
  let v = panic("never")
  in if Just(v) == Just(v) then v else v
#~^ ERROR

fn main() -> Unit !{IO} = print(to_string(g() == 1))
