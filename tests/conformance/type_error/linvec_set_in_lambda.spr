module main
import stdlib.linvec (LinVec, linvec_set)

# A lambda may take a linear value only if it borrows it, so a set cannot run inside one.
# Use explicit recursion, or `linvec_scatter`.

fn fill(is: List Int, v: LinVec Int) -> LinVec Int =
  list_fold(\ (acc, i) -> linvec_set(i, 0, acc), v, is)
#~^ ERROR

