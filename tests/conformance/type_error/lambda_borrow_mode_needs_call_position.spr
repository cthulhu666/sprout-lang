module main

# M4.4b LIMIT, recorded rather than claimed. The mode is pushed down from the
# expected slot, and a `let`-bound lambda has no expected slot where it is
# written — so this one shape still needs the mode spelled out:
#
#     let work = \(c: borrowing File) -> peek(c)
#
# which compiles. Lifting the limit means propagating an expected type into a
# `let` right-hand side generally; see BACKLOG, "Higher-order linearity (M4.4)".
# If that lands, this fixture is the one that should start failing.

type linear File = File Int

fn peek(f: borrowing File) -> Int = 0
fn release(f: consuming File) -> Int = match f with | File n -> n

fn with_file(n: Int, work: (borrowing File) -> Int) -> Int =
  do
    let f = File(n)
    let r = work(f)
    r + release(f)

fn via_let(n: Int) -> Int =
  let work = \c -> peek(c)
  in with_file(n, work)

fn main() -> Unit !{IO} = print(to_string(via_let(1)))
