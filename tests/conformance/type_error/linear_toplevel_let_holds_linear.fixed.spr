module main

# `linear_toplevel_let_holds_linear.spr` with its error's hint applied.

type linear File = File Int

fn release(f: File) -> Int = match f with | File n -> n

fn a(g: File) -> Int = release(g)

fn b(g: File) -> Int = release(g)

fn main() -> Unit !{IO} = print(to_string(a(File(1)) + b(File(2))))
