module main

# `Maybe` short-circuits identically -- `infer.do_unwrap_type` peels `Maybe a` for
# the binder exactly as it peels `Result e a`.

fn find_it(x: Int) -> Maybe Int =
  if x > 0 then Just(x) else Nothing

fn returns_int() -> Int =
  do
    v <- find_it(0)
    v + 999

fn main() -> Unit !{IO} =
  print(int_to_string(returns_int()))
