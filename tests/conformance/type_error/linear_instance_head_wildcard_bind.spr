module main

# `_ <- x` drops the instance head's `a`, which a use of the instance can make
# linear (docs/linearity-bound-v0.md §12, step 3).

type linear L = L Int

class Count t
  fn count(x: t) -> Maybe Int

instance Count (Maybe a)
  fn count(x: Maybe a) -> Maybe Int =
    do
      _ <- x
      Just(0)

fn main() -> Unit !{IO} =
  print(match count(Just (L(1))) with | Just n -> int_to_string(n) | Nothing -> "none")
