# `linear_wildcard_let_else.spr` with its error's hint applied.

type linear Conn = Conn Int
type Two =
  | A Conn
  | B Conn

fn close(c: Conn) -> Int = match c with | Conn n -> n

fn first(t: Two) -> Int =
  let A(c) = t else B(d) -> close(d)
  in close(c)

fn main() -> Unit !{IO} = print(int_to_string(first(A (Conn(1)))))
