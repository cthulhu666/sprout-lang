# Class methods keep bare names (spec §3.1), so a method named `branch` is what an
# unfused `try` calls. Pins the limit; BACKLOG has the fix.

class Tree t
  fn branch(x: t) -> Int

instance Tree Int
  fn branch(x: Int) -> Int = x + 1

type Box a =
  | Full a
  | Empty

# Not one `match`, so a `try` on a `Box` calls `branch`.
instance Propagate Box
  fn branch(value: Box a) -> ControlFlow (Box b) a = box_flow(value)

fn box_flow(value: Box a) -> ControlFlow (Box b) a =
  match value with
  | Full v -> Continue(v)
  | Empty -> Break(Empty)

fn f(b: Box Int) -> Box Int =
  let v = try b
  in Full(v + 1)

fn main() -> Unit !{IO} =
  match f(Full(1)) with
  | Full v -> print(to_string(v))
  | Empty -> print("empty")
