module main

# M4.6: a modifier on an instance method is now allowed — the mode rides on the
# method's type, so a call site can see it. What is NOT allowed is an instance
# DISAGREEING with the class it implements: a call dispatches through the class
# signature, so if the class says the parameter is consumed and the instance
# only borrows it, the obligation is discharged by nobody and the resource
# leaks. That is the exact defect M4.5 rejected the whole feature to avoid.
#
# The modifiers must therefore match exactly, which is also Swift SE-0377's rule
# for protocol conformances at a noncopyable parameter. Writing `consuming`
# where the class omits the modifier is NOT a disagreement — both consume; see
# tests/stdlib/test_linear_borrow_in_type.spr.
#
# The class here declares `r: a`, an unmodified (consuming) parameter; the
# instance declares `borrowing Res`.

type linear Res = Res Int

class Peekable a
  fn peek(r: a) -> Int

instance Peekable Res
  fn peek(r: borrowing Res) -> Int =
    match r with
    | Res n -> n

fn go(r: Res) -> Int = peek(r)

fn main() -> Unit !{IO} = print(to_string(go(Res(1))))
