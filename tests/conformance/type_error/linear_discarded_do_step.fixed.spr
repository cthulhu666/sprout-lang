module main

# `linear_discarded_do_step.spr` with its error's hint applied.

type linear File = File Int

fn open(n: Int) -> File !{IO} =
  do
    print("open")
    File(n)

fn close(f: File) -> Int =
  match f with
  | File n -> n

fn main() -> Unit !{IO} =
  do
    f <- open(1)
    let n = close(f)
    print("done")
