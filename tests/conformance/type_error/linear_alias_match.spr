module main

# M4.2 soundness: a match VARIABLE pattern binds the WHOLE linear scrutinee, so
# the bound name is itself linear and must be tracked. Here `g` aliases `f` and
# is used twice.

type linear File = File Int

fn use_file(f: File) -> Int = match f with | File n -> n

fn dup(f: File) -> Int =
  match f with
  | g -> use_file(g) + use_file(g)

fn main() -> Unit !{IO} = print(to_string(dup(File(7))))
