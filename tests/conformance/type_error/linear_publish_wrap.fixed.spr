module main

# The hint applied: the wrap is abstract, and the module exports the functions
# that build and take it apart.

export wrap linear LinVec a = Vector a

export fn linvec_of(v: Vector a) -> LinVec a = LinVec(v)

export fn linvec_free(arr: LinVec a) -> Unit =
  match arr with
  | LinVec _ -> ()

fn main() -> Unit !{IO} = print("x")
