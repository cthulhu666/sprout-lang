# `linear_wildcard_do_ctor_bind.spr` with its error's hint applied.

type linear Conn = Conn Int
type linear Wrap = Wrap Conn

fn close(c: Conn) -> Int = match c with | Conn n -> n

fn drop(m: Maybe Wrap) -> Maybe Int =
  do
    Wrap c <- m
    Just(close(c))

fn main() -> Unit !{IO} = print(to_string(drop(Just (Wrap (Conn(1))))))
