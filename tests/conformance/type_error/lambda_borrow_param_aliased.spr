module main

# M4.4b GUARD: consuming the borrow through an ALIAS must be refused too, or
# the rule is one `match` away from meaning nothing. The existing destructured-
# from-a-borrow rule already says this; the fixture is here because the lambda
# parameter is a binder kind that could not reach it before.

type linear File = File Int

fn release(f: consuming File) -> Int = match f with | File n -> n

fn with_file(n: Int, work: (borrowing File) -> Int) -> Int =
  do
    let f = File(n)
    let r = work(f)
    r + release(f)

fn aliased(n: Int) -> Int = with_file(n, \c -> match c with | d -> release(d))

fn main() -> Unit !{IO} = print(to_string(aliased(1)))
