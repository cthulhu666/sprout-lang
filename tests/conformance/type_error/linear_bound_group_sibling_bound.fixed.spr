module main

# Hint applied: `where linear b` on `dup`, which now uses its `b` once.

type linear L = L Int

fn eat(l: L) -> Int = match l with | L n -> n

fn dup(z: b) -> b where linear b = z

fn ping(x: a, n: Int) -> a where linear a = pong(x, n)

fn pong(y, n: Int) = if n > 0 then ping(y, n - 1) else dup(y)

fn main() -> Unit !{IO} = print(int_to_string(eat(ping(L(7), 2))))
