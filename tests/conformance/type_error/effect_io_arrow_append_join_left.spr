module main

# `++` joins its two operands through a `unify_join` site part 2 did NOT change
# (append_via_semigroup). It stays correct for a different reason than `if`: what
# is joined here is `List X` against `List Y`, so the arrow sits under a type
# argument and the ELEMENT variable carries the bounds. The swallow only loses an
# effect when the joined thing is the arrow itself.
#
# Mirror: effect_io_arrow_append_join_right.spr. Both orders must reject.

fn quiet(n: Int) -> Int = n + 1

fn shout(n: Int) -> Int !{IO} =
  do
    print("io")
    n + 1

fn handlers() -> List (Int -> Int) = [shout] ++ [quiet]

fn main() -> Unit !{IO} = print(int_to_string(list_length(handlers())))
