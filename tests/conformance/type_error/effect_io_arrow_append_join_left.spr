module main

# `++` joins its two operands through a `unify_join` site part 2 did NOT change
# (append_via_semigroup). A join records no bound at any depth, so what rejects
# here is the declared return type, closing the bound the way it does for `if`.
# Both element effects are concrete, so the join has no variable to overwrite.
#
# Mirror: effect_io_arrow_append_join_right.spr. Both orders must reject.

fn quiet(n: Int) -> Int = n + 1

fn shout(n: Int) -> Int !{IO} =
  do
    print("io")
    n + 1

fn handlers() -> List (Int -> Int) = [shout] ++ [quiet]

fn main() -> Unit !{IO} = print(int_to_string(list_length(handlers())))
