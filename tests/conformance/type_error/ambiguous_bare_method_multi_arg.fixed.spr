module main

# Fixed: a typed parameter fixes the class variable.

# A bare method of two parameters passed as a two-argument function value, its class
# variable unfixed: the same ambiguity as a one-parameter method.

class Make t
  fn from_pair(a: Int, b: Int) -> t

instance Make Int
  fn from_pair(a: Int, b: Int) -> Int = a * 10 + b

instance Make String
  fn from_pair(a: Int, b: Int) -> String = "pair"

fn apply_two(f: Int -> Int -> a, x: Int, y: Int) -> a = f(x, y)

fn ignore_it(x: Int) -> Int = 0

fn main() -> Unit !{IO} = print(ignore_it(apply_two(from_pair, 1, 2)))
