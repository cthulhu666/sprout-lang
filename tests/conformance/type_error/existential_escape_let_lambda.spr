module main

# A local `let` is monomorphic, so a lambda bound outside the arm has one
# parameter type. Applying it to the unpacked value fixes that type to the hidden
# one for every unpack (spec-v0.md §5.6). The fix defines the lambda in the arm.

type Shown = | exists a. Shown a where ToString a

fn two(x: a, n: Int) -> String where ToString a = to_string(x) ++ int_to_string(n)

fn go(s: Shown) -> String =
  let g = \z -> two(z, 9)
  in match s with
    | Shown v -> g(v)
#~^ ERROR

fn main() -> Unit !{IO} = print(go(Shown(5)))
