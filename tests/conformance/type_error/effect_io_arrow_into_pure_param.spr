module main

# An `!{IO}` function reaching a PURE arrow parameter: `pure_map` declares no effect
# and prints three times. No effect variable is involved — `list_map`'s callback is
# a plain arrow, so this is spec §7 property 2 swallowing the mismatch.
#
# RED, quarantined in test-type-errors' xfail list until the check lands. Expected
# wording: docs/effect-subsumption-v0.md §7.

fn shout(n: Int) -> Int !{IO} =
  do
    print("io")
    n + 1

fn pure_map(xs: List Int) -> List Int = list_map(shout, xs)

fn main() -> Unit !{IO} = print(to_string(list_length(pure_map([1, 2, 3]))))
