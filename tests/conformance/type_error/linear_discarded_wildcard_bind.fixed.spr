import stdlib.task (Scope, with_scope, task_fork, task_await)

# The hint in the .err applied; the comments below describe the rejected program.

# `_ <-` binds nothing, so the binder-keyed rules attach no obligation to the
# forked handle and it leaks. This is the shape a user reaches by following the
# discarded-step diagnostic's own advice to "bind its result with `<-`", so it
# must be rejected too. The named form `_h <- …` is already caught as a leak.
fn body(s: Scope) -> Int !{IO} =
  do
    t <- task_fork(s, \_ -> 41)
    n <- task_await(t)
    n + 7

fn main() -> Unit !{IO} = print(to_string(with_scope(body)))
