module main

# Class `once local`, instance plain: both axes differ.
# The message must name both.

class Runner a
  fn run_it(s: a, work: once local Unit -> Int) -> Int

instance Runner Int
  fn run_it(s: Int, work: Unit -> Int) -> Int = s + work(())

fn main() -> Unit !{IO} = print(to_string(run_it(1, \_ -> 2)))
