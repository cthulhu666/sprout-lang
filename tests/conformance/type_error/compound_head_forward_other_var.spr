module main

# `outer` declares `ToString (List b)` but `f` needs `ToString (List a)`. Forwarding
# would pass `b`'s dictionary for `a`, and the List instance needs `ToString a`, which
# `outer` does not have.
fn label(x: t) -> String where ToString t = to_string(x)

fn f(x: a) -> String where ToString (List a) = label([x])

fn outer(x: a, y: b) -> String where ToString (List b) = f(x) ++ label([y])

fn main() -> Unit !{IO} = print(outer(3, "s"))
