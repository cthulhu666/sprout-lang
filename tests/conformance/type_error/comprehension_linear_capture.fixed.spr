module main

# `comprehension_linear_capture.spr` with its error's hint applied.

type linear File = File Int

fn use_file(f: File) -> Int = match f with | File n -> n

fn scaled(f: File) -> List Int =
  let k = use_file(f)
  in [i * k for i in 1..3]

fn main() -> Unit !{IO} = print(to_string(list_length(scaled(File(2)))))
