import stdlib.task (Scope, with_scope, task_fork)

# `f(1)` discards a value of the rigid type `a`. Without a bound `a` is never
# linear, so the body is accepted, and the caller that would instantiate `a :=
# Task Int` and leak the handle is rejected instead (docs/linearity-bound-v0.md
# §6.4). The rule moved from the body to the call.
fn run_it(f: Int -> a !{IO}) -> Int !{IO} =
  do
    f(1)
    7

fn body(s: Scope) -> Int !{IO} = run_it(\x -> task_fork(s, \_ -> x))

fn main() -> Unit !{IO} = print(to_string(with_scope(body)))
