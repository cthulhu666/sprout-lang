# A NESTED type as an instance argument — the third route to a head the key
# cannot represent. `List (Maybe a)` is neither a concrete argument nor a
# repeated variable, but it still keys `@inst:Nested:List`, so it answers for
# every `List` whatsoever.
#
# This is the case GHC's FlexibleInstances is named for: it "allows the head of
# the instance declaration to mention arbitrary nested types", which Haskell 2010
# forbids. Sprout takes the Haskell 2010 position for now (spec §8.5).
class Nested a
  fn depth(x: a) -> Int

instance Nested (List (Maybe a))
  fn depth(x: List (Maybe a)) -> Int = 2

fn plain() -> List Int = Cons(1, Nil)

fn main() -> Unit !{IO} = print(depth(plain()))
