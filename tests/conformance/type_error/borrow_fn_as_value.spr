module main

# M4.6: the ownership mode is part of the function TYPE, so `peek` no longer
# needs a blanket "cannot be used as a value" rejection — it is now a plain type
# mismatch, reported where the mismatch actually is.
#
# `apply` annotates its parameter as `(File) -> Int`. Arrow-type syntax cannot
# yet spell `borrowing` (deferred; see BACKLOG), so an annotated arrow means
# CONSUMING, and `peek` — which only borrows — has a different type. Allowing
# the substitution would discharge the caller's obligation via a call that
# releases nothing, and `f` would leak with no diagnostic. Per Swift SE-0377,
# for a noncopyable parameter "the convention must match exactly".
#
# The converse direction is
# tests/conformance/type_error/mode_mismatch_consume_for_borrow.

type linear File = File Int

fn peek(f: borrowing File) -> Int = 0
fn release(f: consuming File) -> Int = match f with | File n -> n

fn apply(g: (File) -> Int, f: File) -> Int = g(f)

fn use_it(f: File) -> Int = apply(peek, f)

fn main() -> Unit !{IO} = print(to_string(use_it(File(1))))
