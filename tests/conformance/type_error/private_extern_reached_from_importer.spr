module main

# `stdlib.mutable` declares `vector_mutset` for `MutVec`'s own use. Importing the
# module for something else does not make it callable here: an extern is private
# to its module unless that module writes `export extern fn`.

import stdlib.mutable

wrap linear Box = Vector Int

fn peek(b: borrowing Box) -> Vector Int =
  match b with
  | Box raw -> raw

fn first(b: borrowing Box) -> Int =
  match b with
  | Box raw -> maybe_with_default(-1, vector_get(raw, 0))

fn main() -> Unit !{IO} =
  let b = Box(vector_from_list([1, 2, 3]))
      raw = peek(b)
  in do
    vector_mutset(raw, 0, 99)
#~^ ERROR
    print(int_to_string(first(b)))
    match b with
    | Box _ -> ()
