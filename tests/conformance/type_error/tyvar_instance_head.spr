# A bare type variable as an instance head is accepted by the parser but is DEAD:
# register_instance_marker keys the instance on `@inst:Boxer:<tyvar>`, and no
# dispatch site ever looks up a tyvar key, so every use fails "No instance of
# Boxer for T" while the declaration itself looked fine. Sprout has no
# catch-all/overlapping-instance resolution, so reject it at the instance site
# rather than let it register an unreachable marker.
class Boxer a {
  fn box_size(v: a) -> Int
}

instance Boxer a {
  fn box_size(v: a) -> Int = 0
}

fn main() -> Unit !{IO} = print(box_size(true))
