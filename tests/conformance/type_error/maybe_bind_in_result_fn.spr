module main

# Wrong FAMILY: a `Maybe` bind propagates `Nothing`, which is returned as a
# `Result`. Reaching this needs a tail whose type is a fresh type VARIABLE
# (`panic : a`): with a concrete tail, one of two pre-existing checks already fires
# -- a `Result` tail trips the one-family-per-block rule, and any other tail trips
# the block-type-vs-return-type unification. A tyvar tail slips past both, then
# unifies with the declared `Result`.
#
# Measured before the rule existed: this COMPILED, and the `Nothing` box matched
# neither `Ok` nor `Err` at runtime -- `runtime error: non-exhaustive match`.

fn find_it(x: Int) -> Maybe Int =
  if x > 0 then Just(x) else Nothing

fn wrong_family(x: Int) -> Result String Int !{IO} =
  do
    v <- find_it(x)
    panic("unreachable " ++ int_to_string(v))

fn main() -> Unit !{IO} =
  match wrong_family(0) with
  | Ok n -> print(int_to_string(n))
  | Err e -> print(e)
