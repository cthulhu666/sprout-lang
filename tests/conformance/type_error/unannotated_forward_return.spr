module main

# The forward reference that used to compile clean and then SIGSEGV.
#
# `summarize` has no return annotation. It used to be published with a
# UNIVERSALLY QUANTIFIED placeholder, refreshed at every use — so `report`
# unified its own private copy with String and nothing ever reconciled that
# against the Int the body returns. `report` then concatenated an i64 as if it
# were a string pointer.
#
# `summarize` is now inferred first, because `report` depends on it and groups are
# checked in dependency order, so `report` meets its real type `List Int -> Int`
# and the mismatch is reported here rather than at the callee. Its twin
# `unannotated_backward_return` is the same program with the declarations swapped
# and the same expected diagnostic — together they pin that order does not matter.
fn report(xs: List Int) -> String = "count=" ++ summarize(xs)

fn summarize(xs: List Int) = list_length(xs)

fn main() -> Unit !{IO} = print(report(Cons(1, Cons(2, Nil))))
