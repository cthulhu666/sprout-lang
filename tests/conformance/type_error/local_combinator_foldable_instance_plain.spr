module main

# `Foldable.fold_values` takes its step function `local`, and an instance must match the class on
# it: a call dispatches through the class signature. See
# local_combinator_foldable_instance_plain.fixed.spr.

type Box a = Box(a)

instance Foldable Box
  fn fold_values(step: b -> a -> b, init: b, xs: Box a) -> b =
    match xs with
    | Box x -> step(init, x)
  fn fold_while_values(step: local b -> a -> b, cond: local b -> Bool, init: b, xs: Box a) -> b =
    match xs with
    | Box x -> list_fold_while(step, cond, init, [x])

fn main() -> Unit !{IO} = print("unreachable")
