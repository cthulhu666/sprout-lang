# An instance method's unannotated return takes the class's `r`, so the message
# names `r`: nothing supplies the `Eq r` that `Maybe r`'s `Eq` instance needs.
class Mk t
  fn mk(x: t) -> r

instance Mk Int
  fn mk(x: Int) =
    let v = panic("never")
    in if Just(v) == Just(v) then v else v

fn main() -> Unit !{IO} = print(to_string(mk(1) == 1))
