module main

# The hint in the .err applied; the comments below describe the rejected program.

# A bare reference to a linear binding as a statement. The reference itself
# satisfies "used exactly once" syntactically, but nothing is done with the
# value — it is simply dropped. The diagnostic must say that rather than tell
# the author to bind a result they already hold.

type linear File = File Int

fn use_it(f: File) -> Int = match f with | File n -> n

fn go(x: File) -> Int !{IO} =
  do
    let n = use_it(x)
    n

fn main() -> Unit !{IO} = print(to_string(go(File(1))))
