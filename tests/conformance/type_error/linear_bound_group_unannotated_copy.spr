module main

# An unannotated member of a binding group sees its sibling's bounded variable as
# linear, so it cannot copy the value it is handed.

type linear L = L Int

fn eat(l: L) -> Int = match l with | L n -> n

fn ping(x: a, n: Int) -> (a, a) where linear a = pong(x, n)

fn pong(y, n: Int) = if n > 0 then ping(y, n - 1) else (y, y)

fn main() -> Unit !{IO} =
  match ping(L(7), 2) with
  | (p, q) -> print(int_to_string(eat(p) + eat(q)))
