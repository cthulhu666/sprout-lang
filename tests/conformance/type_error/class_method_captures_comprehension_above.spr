module main

# The known limit of class_method_captures_comprehension.spr (spec §3.1), above the
# class: a class is in scope throughout its module, so the comprehension written
# before it calls the method too. When the limit is lifted, this moves to run/.

fn squares(xs: List Int) -> List Int = [x * x for x in xs]

fn main() -> Unit !{IO} = print(squares(range_to_list(1..3)))

class Rev a
  fn list_reverse(x: a) -> Int

instance Rev Int
  fn list_reverse(x: Int) -> Int = x
