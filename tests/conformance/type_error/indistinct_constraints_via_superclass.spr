# `Ord (Maybe a)` brings `Eq (Maybe a)` as its superclass, and `Eq (Maybe b)` needs the
# same hidden-dictionary slot (one per class and head constructor). Accepted, one of the
# two comparisons used the other's dictionary.
fn f(x: Maybe a, y: Maybe a, p: Maybe b, q: Maybe b) -> (Bool, Bool) where Ord (Maybe a), Eq (Maybe b) =
  (x == y, p == q)

fn main() -> Unit !{IO} = print(to_string(f(Just(1), Just(1), Just(2), Just(3))))
