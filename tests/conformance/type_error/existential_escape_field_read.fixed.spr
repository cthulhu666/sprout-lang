module main

type Shape = | exists a. Shape a (a -> Int)

type Holder = (cell: Ref (List Int))

fn go(shapes: List Shape) -> Unit !{IO} = do
  let body = \o -> list_each(\s -> match s with | Shape x f -> ref_write(o.cell, [f(x)]), shapes)
  r <- ref_new([])
  body(Holder(cell = r))

fn main() -> Unit !{IO} = go([Shape("hello", str_len), Shape(12345, \n -> n + 1)])
