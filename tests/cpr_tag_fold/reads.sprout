module main
import stdlib.bytes as bytes

# Fixture for scripts/cpr_tag_fold_check.sh: each loop reads through a `Just`/`Nothing`
# match, the shape that lowers to a `_unboxed` runtime read. Each loop is its own
# top-level fn so the check can inspect its optimised body.

fn sum_vec(xs: Vec Int, i: Int, acc: Int) -> Int =
  match vec_get(i, xs) with
  | Just x -> sum_vec(xs, i + 1, acc + x)
  | Nothing -> acc

fn sum_bytes(b: Bytes, i: Int, acc: Int) -> Int =
  match bytes.get(b, i) with
  | Just x -> sum_bytes(b, i + 1, acc + x)
  | Nothing -> acc

fn main() -> Unit !{IO} =
  let xs = range_to_vec(0..1000) in
  let b = bytes.from_string("the quick brown fox") in
  print(sum_vec(xs, 0, 0) + sum_bytes(b, 0, 0))
