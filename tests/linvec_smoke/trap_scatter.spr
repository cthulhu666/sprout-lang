module main
import stdlib.linvec (linvec_new, linvec_scatter, linvec_length, linvec_drop)

# `linvec_scatter` calls `linvec_set`, so an index out of range traps.

fn main() -> Unit !{IO} =
  let v = linvec_scatter([0, 1, 7], 1, linvec_new(3, 0))
      n = linvec_length(v)
      _ = linvec_drop(v)
  in print(int_to_string(n))
