module main
import stdlib.linvec as linvec

# `linvec.accum` reads the old cell before it writes, so an index out of range traps
# in the read, with its own message.

fn main() -> Unit !{IO} =
  let v = linvec.accum(\ (a, b) -> a + b, [(0, 1), (3, 1)], linvec.new(3, 0))
      n = linvec.length(v)
      _ = linvec.drop(v)
  in print(int_to_string(n))
