module main
import stdlib.linvec (linvec_new, linvec_accum, linvec_length, linvec_drop)

# `linvec_accum` reads the old cell before it writes, so an index out of range traps
# in the read, with its own message.

fn main() -> Unit !{IO} =
  let v = linvec_accum(\ (a, b) -> a + b, [(0, 1), (3, 1)], linvec_new(3, 0))
      n = linvec_length(v)
      _ = linvec_drop(v)
  in print(int_to_string(n))
