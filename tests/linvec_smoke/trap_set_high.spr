module main
import stdlib.linvec as linvec

# `linvec.set` past the end traps (docs/persistent-array-v0.md §12 step 13). The length is
# printed so the set has a use and cannot be dropped as dead code.

fn main() -> Unit !{IO} =
  let v = linvec.set(3, 1, linvec.new(3, 0))
      n = linvec.length(v)
      _ = linvec.drop(v)
  in print(int_to_string(n))
