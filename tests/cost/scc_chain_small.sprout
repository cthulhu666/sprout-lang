# Cost fixture for `just scc-cost-gate` -- see scripts/scc_cost_gate.sh.
#
# A chain of top-level functions, each passing a lambda to `apply1` and
# tail-calling the next. Arities alternate 1, 2, 1, 2, so no tail edge joins two
# functions of equal arity: mutual TCO's Phase A rejects every edge on arity
# before it searches the graph. What is priced is Phase B's SCC pass over the
# whole chain, and inference's per-lambda work, which once walked the whole type
# environment (infer.aliases_for_annotations). The lambda is annotated, so it
# takes the full annotation path.
#
# Three sizes that MUST differ only in link count, this header included: the
# gate reads the differences between them, so anything else that differs is
# measured as per-link cost.  Change one, change all three.

fn apply1(f: Int -> Int, x: Int) -> Int = f(x)

fn link_0(a: Int) -> Int =
  if a > 1000 then a else link_1(apply1(\ (x: Int) -> x + 1, a), a)

fn link_1(a: Int, b: Int) -> Int =
  if a > 1000 then a + b else link_2(apply1(\ (x: Int) -> x + 1, a + b))

fn link_2(a: Int) -> Int =
  if a > 1000 then a else link_3(apply1(\ (x: Int) -> x + 1, a), a)

fn link_3(a: Int, b: Int) -> Int =
  if a > 1000 then a + b else link_4(apply1(\ (x: Int) -> x + 1, a + b))

fn link_4(a: Int) -> Int =
  if a > 1000 then a else link_5(apply1(\ (x: Int) -> x + 1, a), a)

