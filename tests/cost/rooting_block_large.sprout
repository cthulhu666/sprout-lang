# Cost fixture for `just rooting-cost-gate` -- see scripts/rooting_cost_gate.sh.
#
# One function, one basic block, one list literal.  Every element is a freshly
# allocated String that stays live until the list is built, so the block's
# live set grows with the literal and the rooting pass sees a long live range
# at every op.  This is the shape of the generated vector suites
# (tests/stdlib/test_bigint_vectors.spr), reduced to what the gate needs.
#
# Three sizes that MUST differ only in element count, this header included: the
# gate reads the differences between them, so anything else that differs is
# measured as per-element cost.  Change one, change all three.

fn rows() -> List String =
  [
    int_to_string(0) ++ "-row",
    int_to_string(1) ++ "-row",
    int_to_string(2) ++ "-row",
    int_to_string(3) ++ "-row",
    int_to_string(4) ++ "-row",
    int_to_string(5) ++ "-row",
