# Cost fixture for `just scc-cost-gate` -- see scripts/scc_cost_gate.sh.
#
# A chain of top-level functions, each tail-calling the next. Arities alternate
# 1, 2, 1, 2, so no tail edge joins two functions of equal arity: mutual TCO's
# Phase A rejects every edge on arity before it searches the graph, and what is
# priced is Phase B's SCC pass over the whole chain.
#
# Three sizes that MUST differ only in link count, this header included: the
# gate reads the differences between them, so anything else that differs is
# measured as per-link cost.  Change one, change all three.

fn link_0(a: Int) -> Int =
  if a > 1000 then a else link_1(a + 1, a)

fn link_1(a: Int, b: Int) -> Int =
  if a > 1000 then a + b else link_2(a + b)

fn link_2(a: Int) -> Int =
  if a > 1000 then a else link_3(a + 1, a)

