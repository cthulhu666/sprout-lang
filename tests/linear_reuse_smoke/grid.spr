module main
import stdlib.linvec (LinVec)
import stdlib.linvec as linvec

# `just linear-reuse-smoke` compiles this with NSIZE replaced and compares the runtime's
# allocation counters across sizes: a sieve over a `LinVec` behind a linear wrapper strikes
# once per multiple, and each strike rebuilds the wrapper in place, allocating nothing.
# It prints the number of primes below NSIZE.

type linear Grid = Grid Int (LinVec Bool)

fn is_set(i: Int, g: borrowing Grid) -> Bool =
  match g with
  | Grid _ v ->
      match linvec.get(i, v) with
      | Just b -> b
      | Nothing -> false

fn grid_set(i: Int, x: Bool, g: Grid) -> Grid =
  match g with
  | Grid n v -> Grid(n, linvec.set(i, x, v))

fn strike(j: Int, p: Int, n: Int, g: Grid) -> Grid =
  if j >= n then g else strike(j + p, p, n, grid_set(j, true, g))

fn sieve(p: Int, n: Int, g: Grid) -> Grid =
  if p * p >= n then g
  else if is_set(p, g) then sieve(p + 1, n, g)
  else sieve(p + 1, n, strike(p * p, p, n, g))

fn count(i: Int, n: Int, acc: Int, g: borrowing Grid) -> Int =
  if i >= n then acc
  else count(i + 1, n, if is_set(i, g) then acc else acc + 1, g)

fn main() -> Unit !{IO} =
  let n = NSIZE
      g = sieve(2, n, Grid(n, linvec.new(n, false)))
      c = count(2, n, 0, g)
  in match g with
     | Grid _ v ->
         let _ = linvec.drop(v)
         in print(int_to_string(c))
