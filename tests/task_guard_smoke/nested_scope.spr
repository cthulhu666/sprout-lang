import stdlib.task (Scope, with_scope, scope_spawn)

# L0.1 boundary: opening a scope from inside a spawned task must fail loud.
# The single-scheduler-context scheduler cannot yet support nesting; without
# this guard a nested scope would silently corrupt the return context. Expected
# to abort with "nested scope from within a task".
fn inner(s: Scope) -> Unit !{IO} =
  term_write("inner scope body ran (should be unreachable)\n")

fn main() -> Unit !{IO} =
  do
    with_scope(\outer -> scope_spawn(outer, \_ -> with_scope(\s -> inner(s))))
    term_write("reached main tail (should be unreachable)\n")
