module stdlib.chan

import stdlib.task (Scope, scope_handle)

# Layer-0 channels (EXPERIMENTAL): FIFO queues for streaming values between cooperative green
# tasks (see stdlib.task). A channel has a fixed capacity of `>= 0` slots. With capacity `>= 1`
# it is BOUNDED BUFFERED: `chan_send` parks the current task when the buffer is full, `chan_recv`
# parks it when the buffer is empty. With capacity `0` it is a RENDEZVOUS (unbuffered) channel:
# there is no buffer, so a send always parks until a receiver takes the value directly, and a
# receive always parks until a sender provides one (Go/Kotlin default). Either way the scheduler
# runs the siblings that make progress.
#
# Channels are tied to a `Scope`: created with `chan_new(scope, capacity)` and freed when
# that scope closes (Sprout has no finalizers, so a free-floating channel could not be
# reclaimed). Consequences: there are no top-level channels, and a channel cannot outlive
# the scope that created it.
#
# MVP boundary: bounded buffered (L0.8) + rendezvous (L0.10) + `close`/recv-on-closed (L0.9) +
# `select` over same-typed channels, recv-only (L0.11). Send-cases in select, a non-blocking
# `default`, and randomized fairness are later increments. Delivery is cooperative and integrates
# with cancellation — a task parked in `chan_send`/`chan_recv`/`chan_select` when its scope is
# cancelled (or a `with_timeout` deadline fires) is force-dropped by the scheduler. See
# docs/concurrency-channels-design-2026-07-16.md,
# docs/concurrency-channel-close-design-2026-07-16.md, and
# docs/concurrency-select-design-2026-07-17.md.

export type Chan a =
  | Chan Int

# The outcome of `chan_recv` (L0.9). `Got v` carries the next value; `Closed` means the channel
# was closed AND fully drained (no more values will ever arrive). Buffered values always drain as
# `Got` before `Closed` is reported. `(..)` exports the constructors so consumers can match them.
export type Recv a (..) =
  | Got a
  | Closed

# Internal result of `__chan_select` (L0.11): which listed channel became ready (`Int` index) and
# its `Recv` outcome. Built by the runtime; `chan_select` unwraps it to the public `(Int, Recv a)`.
# Not exported — the public surface is the tuple.
type Selected a =
  | Selected Int (Recv a)

# Runtime primitives (green-thread scheduler; cannot be expressed in Sprout — they park and
# resume tasks via context switching). Internal: the public API below wraps them.
# See runtime/APPROVED_BUILTINS.
extern fn __chan_new(scope_id: Int, capacity: Int) -> Int !{IO}
extern fn __chan_send(chan_id: Int, value: a) -> Unit !{IO}
extern fn __chan_recv(chan_id: Int) -> Recv a !{IO}
extern fn __chan_close(chan_id: Int) -> Unit !{IO}
extern fn __chan_select(chan_ids: List Int) -> Selected a !{IO}

# Create a `capacity`-slot channel belonging to `scope`, freed when the scope closes.
# `capacity >= 1` is bounded buffered; `capacity == 0` is a rendezvous (unbuffered) channel
# (direct sender→receiver hand-off). `capacity < 0` loud-fails.
# `scope_handle` (from stdlib.task) reads the scope's raw scheduler handle without exposing
# the opaque `Scope` constructor to this module — `chan_new` never destructures a `Scope`.
export fn chan_new(scope: Scope, capacity: Int) -> Chan a !{IO} =
  Chan(__chan_new(scope_handle(scope), capacity))

# Send `value` into `ch`. Returns once the value is buffered (or handed directly to a waiting
# receiver). If the buffer is full — or the channel is rendezvous (capacity 0, no buffer) with no
# receiver ready — the current task parks until a receiver takes the value.
export fn chan_send(ch: Chan a, value: a) -> Unit !{IO} =
  match ch with
  | Chan cid -> __chan_send(cid, value)

# Receive the next value from `ch` in FIFO order, as a `Recv a`. Returns `Got v` while values
# remain (buffered values drain first, or on a rendezvous channel takes a waiting sender's value
# directly). If the buffer is empty (rendezvous: always) and the channel is open, the current task
# parks until a sender provides a value. Once the channel is closed AND drained, returns `Closed`
# without parking (and a task already parked here is woken with `Closed`).
export fn chan_recv(ch: Chan a) -> Recv a !{IO} =
  match ch with
  | Chan cid -> __chan_recv(cid)

# Close `ch`: signal that no more values will be sent. Receivers drain any buffered values
# (`Got`), then observe `Closed`; a receiver parked on an empty channel is woken with `Closed`.
# Any task holding the channel may close it. LOUD-FAILS on a send into a closed channel or a
# double close — both are program bugs Sprout cannot recover from (no exceptions).
export fn chan_close(ch: Chan a) -> Unit !{IO} =
  match ch with
  | Chan cid -> __chan_close(cid)

# The raw scheduler handle inside a `Chan` — used only to pass a channel list to `__chan_select`.
fn chan_id(ch: Chan a) -> Int =
  match ch with
  | Chan cid -> cid

# Wait on several same-typed channels at once; return the list index of the channel that became
# ready FIRST and its `Recv` outcome (`Got v` / `Closed`). Blocks until at least one is ready. A
# closed channel is always ready (yields `Closed`). When several are ready at entry, the LOWEST
# index wins. An empty list loud-fails (a select with no cases can never proceed). Recv-only:
# there are no send cases in this increment. See docs/concurrency-select-design-2026-07-17.md.
export fn chan_select(chans: List (Chan a)) -> (Int, Recv a) !{IO} =
  match __chan_select(list_map(chan_id, chans)) with
  | Selected i r -> (i, r)
