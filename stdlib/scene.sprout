module stdlib.scene

import stdlib.mutable (MutVec, mutvec_new, mutvec_at, mutvec_set)

# ECS-v0 skeleton: a fixed-capacity, structure-of-arrays scene (docs/ecs-v0.md).
#
# An *entity* is an integer slot. A `Scene` bundles one `MutVec` per *component*
# (model handle, transform x/z on the ground plane, animation frame, speed) plus
# a one-cell live-count.
# A *system* is a plain function that iterates the arrays (`move_system` here;
# gfx systems live in the renderer-facing example, since this module stays
# renderer-independent so it links and tests under the core runtime).
#
# Substrate note: the design (§5) wanted a record, but records don't reach
# codegen yet (ast_to_ir:926 rejects them), so `Scene` is a single-constructor
# ADT over the component arrays — validated in §6.1. This is the same nominal
# shape `MutVec` itself uses, and unlike a `wrap` it resolves unqualified across
# module boundaries (a `wrap` hits the §6.2 annotation-canonicalization wart).
# The constructor is immutable, but the arrays it holds are mutable, so the Scene
# value still shares mutable component storage: exactly the SoA shape the ECS
# wants.
#
# Storage is fixed at `scene_new(cap)`; `spawn` fills up to `cap` (despawn /
# growable storage are follow-ups, §2 non-goals).

# Fields: count_cell, model, pos_x, pos_z, frame, speed.
export type Scene (..) =
  | Scene (MutVec Int) (MutVec Int) (MutVec Double) (MutVec Double) (MutVec Double) (MutVec Double)

# One-cell live-entity counter (a MutVec is our only mutable cell, so a bump-able
# `spawn` needs one). Kept module-private; callers use `scene_count`.
fn count_cell(s: Scene) -> MutVec Int =
  match s with | Scene c _ _ _ _ _ -> c

export fn scene_model(s: Scene) -> MutVec Int =
  match s with | Scene _ m _ _ _ _ -> m

export fn scene_pos_x(s: Scene) -> MutVec Double =
  match s with | Scene _ _ x _ _ _ -> x

export fn scene_pos_z(s: Scene) -> MutVec Double =
  match s with | Scene _ _ _ z _ _ -> z

export fn scene_frame(s: Scene) -> MutVec Double =
  match s with | Scene _ _ _ _ f _ -> f

export fn scene_speed(s: Scene) -> MutVec Double =
  match s with | Scene _ _ _ _ _ sp -> sp

# Allocate SoA storage for up to `cap` entities; the scene starts empty.
export fn scene_new(cap: Int) -> Scene !{IO} =
  do
    cc <- mutvec_new(1, 0)
    model <- mutvec_new(cap, 0)
    pos_x <- mutvec_new(cap, 0.0)
    pos_z <- mutvec_new(cap, 0.0)
    frame <- mutvec_new(cap, 0.0)
    speed <- mutvec_new(cap, 0.0)
    Scene(cc, model, pos_x, pos_z, frame, speed)

# O(1). The number of live (spawned) entities.
export fn scene_count(s: Scene) -> Int !{IO} = mutvec_at(count_cell(s), 0)

# Write one entity's components at the next free slot, bump the count, and return
# its id. Caller must not exceed the capacity passed to `scene_new` (fixed
# storage, §6.3). `frame` starts at 0.0.
export fn spawn(s: Scene, model: Int, x: Double, z: Double, speed: Double) -> Int !{IO} =
  do
    id <- scene_count(s)
    mutvec_set(scene_model(s), id, model)
    mutvec_set(scene_pos_x(s), id, x)
    mutvec_set(scene_pos_z(s), id, z)
    mutvec_set(scene_frame(s), id, 0.0)
    mutvec_set(scene_speed(s), id, speed)
    mutvec_set(count_cell(s), 0, id + 1)
    id

# Advance every live entity's pos_x by speed * dt, in place. A minimal example of
# a "system": a plain function iterating the component arrays. O(n) in the live
# entity count.
fn move_go(s: Scene, dt: Double, i: Int, n: Int) -> Unit !{IO} =
  if i >= n then ()
  else
    do
      x <- mutvec_at(scene_pos_x(s), i)
      v <- mutvec_at(scene_speed(s), i)
      mutvec_set(scene_pos_x(s), i, x + (v * dt))
      move_go(s, dt, i + 1, n)

export fn move_system(s: Scene, dt: Double) -> Unit !{IO} =
  do
    n <- scene_count(s)
    move_go(s, dt, 0, n)
