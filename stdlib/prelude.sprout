# Sprout Prelude (v0)
# Foundational helpers implemented in Sprout itself.

export type Maybe a =
  | Just a
  | Nothing

# StringTemplate runtime ADT — produced by context-aware template desugar
# when the expected type at the use-site is StringTemplate (Phase 4B).
# Each TemplatePart holds an already-evaluated String; the ADT is opaque
# to the HM typechecker and carries no type variables.

export type TemplatePart =
  | TemplateLit String
  | TemplateInterp String

export type StringTemplate =
  | StringTemplate (List TemplatePart)

export fn template_to_string(t: StringTemplate) -> String =
  match t with
  | StringTemplate parts -> string_concat_many(template_parts_to_strings(parts))

export fn template_parts_to_strings(parts: List TemplatePart) -> List String =
  match parts with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | TemplateLit s -> Cons(s, template_parts_to_strings(rest))
      | TemplateInterp s -> Cons(s, template_parts_to_strings(rest))

export type List a =
  | Cons a (List a)
  | Nil

export type Result e a =
  | Ok a
  | Err e

export type Vec a =
  | Vec (Vector a)

type MutVec a = MutVec(Vector a)

export type Dict v =
  | Dict (Map v)

export type Set =
  | Set NativeSet

export fn range(lo: Int, hi: Int) -> IntRange =
  int_range(lo, hi)

export fn range_start(value: IntRange) -> Int =
  int_range_start(value)

export fn range_end(value: IntRange) -> Int =
  int_range_end(value)

export fn range_step(value: IntRange) -> Int =
  if range_start(value) <= range_end(value) then 1 else -1

export fn range_contains(value: IntRange, target: Int) -> Bool =
  if range_step(value) > 0 then
    target >= range_start(value) && target <= range_end(value)
  else
    target <= range_start(value) && target >= range_end(value)

export fn range_count(value: IntRange) -> Int =
  if range_step(value) > 0 then
    (range_end(value) - range_start(value)) + 1
  else
    (range_start(value) - range_end(value)) + 1

fn range_to_list_go(current: Int, end_value: Int, step: Int) -> List Int =
  if current == end_value then Cons(current, Nil)
  else Cons(current, range_to_list_go(current + step, end_value, step))

export fn range_to_list(value: IntRange) -> List Int =
  range_to_list_go(range_start(value), range_end(value), range_step(value))

fn range_fold_go(current: Int, end_value: Int, step: Int, acc: a, f: a -> Int -> a) -> a =
  if current == end_value then f(acc, current)
  else range_fold_go(current + step, end_value, step, f(acc, current), f)

export fn range_fold(value: IntRange, init: a, f: a -> Int -> a) -> a =
  range_fold_go(range_start(value), range_end(value), range_step(value), init, f)

fn list_map_go(f: a -> b, xs: List a) -> List b =
  match xs with
  | Nil -> Nil
  | Cons x rest -> Cons(f(x), list_map_go(f, rest))

fn list_fold_go(f: b -> a -> b, init: b, xs: List a) -> b =
  match xs with
  | Nil -> init
  | Cons x rest -> list_fold_go(f, f(init, x), rest)

export fn filter(pred: a -> Bool, xs: List a) -> List a =
  match xs with
  | Nil -> Nil
  | Cons x rest ->
      if pred(x) then Cons(x, filter(pred, rest))
      else filter(pred, rest)

export fn split_ints(s: String) -> List Int =
  list_map_go(parse_int, split_words(s))

export fn list_map(f: a -> b, xs: List a) -> List b =
  list_map_go(f, xs)

export fn list_fold(step: b -> a -> b, init: b, xs: List a) -> b =
  list_fold_go(step, init, xs)

export fn list_append(left: List a, right: List a) -> List a =
  match left with
  | Nil -> right
  | Cons x rest -> Cons(x, list_append(rest, right))

export fn vec_empty() -> Vec a =
  Vec(vector_empty())

# O(n): the native/vector builtin returns a fresh vector and copies existing items.
export fn vec_singleton(value: a) -> Vec a =
  vec_append(value, vec_empty())

fn vec_prepend_into(acc: Vector a, first: a, source: Vector a, index: Int, total: Int) -> Vector a =
  if index == 0 then
    vec_prepend_into(vector_append(acc, first), first, source, 1, total)
  else if index > total then acc
  else
    match vector_get(source, index - 1) with
    | Nothing -> acc
    | Just item -> vec_prepend_into(vector_append(acc, item), first, source, index + 1, total)

export fn vec_prepend(value: a, vec: Vec a) -> Vec a =
  match vec with
  | Vec raw ->
      Vec(vec_prepend_into(vector_empty(), value, raw, 0, vector_length(raw)))

# O(n): `vector_append` is persistent and copies the input vector.
export fn vec_append(value: a, vec: Vec a) -> Vec a =
  match vec with
  | Vec raw -> Vec(vector_append(raw, value))

fn range_vec_step(acc: Vec Int, item: Int) -> Vec Int =
  vec_append(item, acc)

export fn range_to_vec(value: IntRange) -> Vec Int =
  range_fold(value, vec_empty(), range_vec_step)

export fn vec_length(vec: Vec a) -> Int =
  match vec with
  | Vec raw -> vector_length(raw)

# O(1): indexed lookup in the native vector representation.
export fn vec_get(index: Int, vec: Vec a) -> Maybe a =
  match vec with
  | Vec raw -> vector_get(raw, index)

export fn vec_get_or(index: Int, fallback: a, vec: Vec a) -> a =
  match vec_get(index, vec) with
  | Just value -> value
  | Nothing -> fallback

export fn vec_set(index: Int, value: a, vec: Vec a) -> Vec a =
  match vec with
  | Vec raw -> Vec(vector_set(raw, index, value))

fn vec_map_indexed(f: a -> b, vec: Vec a, index: Int, total: Int, acc: Vec b) -> Vec b =
  if index >= total then acc
  else
    match vec_get(index, vec) with
    | Nothing -> acc
    | Just value -> vec_map_indexed(f, vec, index + 1, total, vec_append(f(value), acc))

export fn vec_map(f: a -> b, vec: Vec a) -> Vec b =
  vec_map_indexed(f, vec, 0, vec_length(vec), vec_empty())

fn vec_fold_indexed(f: b -> a -> b, acc: b, vec: Vec a, index: Int, total: Int) -> b =
  if index >= total then acc
  else
    match vec_get(index, vec) with
    | Nothing -> acc
    | Just value -> vec_fold_indexed(f, f(acc, value), vec, index + 1, total)

export fn vec_fold(f: b -> a -> b, init: b, vec: Vec a) -> b =
  vec_fold_indexed(f, init, vec, 0, vec_length(vec))

fn vec_filter_indexed(pred: a -> Bool, vec: Vec a, index: Int, total: Int, acc: Vec a) -> Vec a =
  if index >= total then acc
  else
    match vec_get(index, vec) with
    | Nothing -> acc
    | Just value ->
        if pred(value) then vec_filter_indexed(pred, vec, index + 1, total, vec_append(value, acc))
        else vec_filter_indexed(pred, vec, index + 1, total, acc)

export fn vec_filter(pred: a -> Bool, vec: Vec a) -> Vec a =
  vec_filter_indexed(pred, vec, 0, vec_length(vec), vec_empty())

fn vec_filter_map_indexed(f: a -> Maybe b, vec: Vec a, index: Int, total: Int, acc: Vec b) -> Vec b =
  if index >= total then acc
  else
    match vec_get(index, vec) with
    | Nothing -> acc
    | Just value ->
        match f(value) with
        | Nothing -> vec_filter_map_indexed(f, vec, index + 1, total, acc)
        | Just mapped -> vec_filter_map_indexed(f, vec, index + 1, total, vec_append(mapped, acc))

export fn vec_filter_map(f: a -> Maybe b, vec: Vec a) -> Vec b =
  vec_filter_map_indexed(f, vec, 0, vec_length(vec), vec_empty())

fn vec_any_indexed(pred: a -> Bool, vec: Vec a, index: Int, total: Int) -> Bool =
  if index >= total then false
  else
    match vec_get(index, vec) with
    | Nothing -> false
    | Just value -> if pred(value) then true else vec_any_indexed(pred, vec, index + 1, total)

export fn vec_any(pred: a -> Bool, vec: Vec a) -> Bool =
  vec_any_indexed(pred, vec, 0, vec_length(vec))

fn vec_all_indexed(pred: a -> Bool, vec: Vec a, index: Int, total: Int) -> Bool =
  if index >= total then true
  else
    match vec_get(index, vec) with
    | Nothing -> true
    | Just value -> if pred(value) then vec_all_indexed(pred, vec, index + 1, total) else false

export fn vec_all(pred: a -> Bool, vec: Vec a) -> Bool =
  vec_all_indexed(pred, vec, 0, vec_length(vec))

fn vec_count_indexed(pred: a -> Bool, vec: Vec a, index: Int, total: Int, acc: Int) -> Int =
  if index >= total then acc
  else
    match vec_get(index, vec) with
    | Nothing -> acc
    | Just value ->
        if pred(value) then vec_count_indexed(pred, vec, index + 1, total, acc + 1)
        else vec_count_indexed(pred, vec, index + 1, total, acc)

export fn vec_count(pred: a -> Bool, vec: Vec a) -> Int =
  vec_count_indexed(pred, vec, 0, vec_length(vec), 0)

fn vec_slice_from(start: Int, count: Int, vec: Vec a, index: Int, total: Int, acc: Vec a) -> Vec a =
  if index >= total then acc
  else if index < start then
    vec_slice_from(start, count, vec, index + 1, total, acc)
  else if index >= start + count then acc
  else
    match vec_get(index, vec) with
    | Nothing -> acc
    | Just value -> vec_slice_from(start, count, vec, index + 1, total, vec_append(value, acc))

export fn vec_slice(start: Int, count: Int, vec: Vec a) -> Vec a =
  if count <= 0 then vec_empty()
  else
    vec_slice_from(if start < 0 then 0 else start, count, vec, 0, vec_length(vec), vec_empty())

fn vec_reverse_from(vec: Vec a, index: Int, acc: Vec a) -> Vec a =
  if index < 0 then acc
  else
    match vec_get(index, vec) with
    | Nothing -> acc
    | Just value -> vec_reverse_from(vec, index - 1, vec_append(value, acc))

export fn vec_reverse(vec: Vec a) -> Vec a =
  vec_reverse_from(vec, vec_length(vec) - 1, vec_empty())

fn vec_to_list_go(vec: Vec a, index: Int, acc: List a) -> List a =
  if index < 0 then acc
  else
    match vec_get(index, vec) with
    | Nothing -> acc
    | Just value -> vec_to_list_go(vec, index - 1, Cons(value, acc))

# O(n): walks the vector backwards, building a forward-order list in one pass.
export fn vec_to_list(vec: Vec a) -> List a =
  vec_to_list_go(vec, vec_length(vec) - 1, Nil)

fn add_ints(left: Int, right: Int) -> Int = left + right
export fn negate(x: Int) -> Int = -x

export fn vec_sum(vec: Vec Int) -> Int =
  vec_fold(add_ints, 0, vec)

export fn vec_sum_by(f: a -> Int, vec: Vec a) -> Int =
  vec_fold(\ (acc, x) -> acc + f(x), 0, vec)

export class Eq a {
  fn eq(left: a, right: a) -> Bool
}

export class ToString a {
  fn to_string(value: a) -> String
}

export class Ord a where Eq a {
  fn compare(left: a, right: a) -> Int
}

export fn ord_lt(x: a, y: a) -> Bool where Ord a =
  compare(x, y) < 0

export fn ord_lte(x: a, y: a) -> Bool where Ord a =
  compare(x, y) <= 0

export fn ord_gt(x: a, y: a) -> Bool where Ord a =
  compare(x, y) > 0

export fn ord_gte(x: a, y: a) -> Bool where Ord a =
  compare(x, y) >= 0

fn vec_sort_by_collect(f: a -> k, vec: Vec a, index: Int, total: Int, acc: List (k, Int, a)) -> List(k, Int, a) =
  if index >= total then acc
  else
    match vec_get(index, vec) with
    | Nothing -> acc
    | Just value -> vec_sort_by_collect(f, vec, index + 1, total, Cons((f(value), index, value), acc))

fn decorated_key_lt(left: (k, Int, a), right: (k, Int, a)) -> Bool where Ord k =
  match left with
  | (left_key, left_index, _) ->
      match right with
      | (right_key, right_index, _) ->
          if ord_lt(left_key, right_key) then true
          else if ord_gt(left_key, right_key) then false
          else left_index < right_index

fn list_reverse_go(xs: List a, acc: List a) -> List a =
  match xs with
  | Nil -> acc
  | Cons item rest -> list_reverse_go(rest, Cons(item, acc))

export fn list_reverse(xs: List a) -> List a =
  list_reverse_go(xs, Nil)

export fn list_member(x: a, xs: List a) -> Bool where Eq a =
  match xs with
  | Nil -> false
  | Cons h t -> if eq(h, x) then true else list_member(x, t)

export fn list_add_unique(x: a, xs: List a) -> List a where Eq a =
  if list_member(x, xs) then xs else list_append(xs, Cons(x, Nil))

export fn list_union(xs: List a, ys: List a) -> List a where Eq a =
  match xs with
  | Nil -> ys
  | Cons h t ->
      if list_member(h, ys) then list_union(t, ys)
      else Cons(h, list_union(t, ys))

export fn list_diff(xs: List a, ys: List a) -> List a where Eq a =
  match xs with
  | Nil -> Nil
  | Cons h t ->
      if list_member(h, ys) then list_diff(t, ys)
      else Cons(h, list_diff(t, ys))

fn list_dedup_acc(xs: List a, seen: List a) -> List a where Eq a =
  match xs with
  | Nil -> Nil
  | Cons h t ->
      if list_member(h, seen) then list_dedup_acc(t, seen)
      else Cons(h, list_dedup_acc(t, Cons(h, seen)))

export fn list_dedup(xs: List a) -> List a where Eq a =
  list_dedup_acc(xs, Nil)

fn list_take(xs: List a, count: Int) -> List a =
  if count <= 0 then Nil
  else
    match xs with
    | Nil -> Nil
    | Cons item rest -> Cons(item, list_take(rest, count - 1))

fn list_drop(xs: List a, count: Int) -> List a =
  if count <= 0 then xs
  else
    match xs with
    | Nil -> Nil
    | Cons _ rest -> list_drop(rest, count - 1)

fn list_length_go(xs: List a, acc: Int) -> Int =
  match xs with
  | Nil -> acc
  | Cons _ rest -> list_length_go(rest, acc + 1)

fn list_length(xs: List a) -> Int =
  list_length_go(xs, 0)

fn decorated_merge_sorted(left: List (k, Int, a), right: List (k, Int, a)) -> List(k, Int, a) where Ord k =
  match left with
  | Nil -> right
  | Cons left_item left_rest ->
      match right with
      | Nil -> left
      | Cons right_item right_rest ->
          if decorated_key_lt(right_item, left_item) then Cons(right_item, decorated_merge_sorted(left, right_rest))
          else Cons(left_item, decorated_merge_sorted(left_rest, right))

fn decorated_sort_split(xs: List (k, Int, a), mid: Int) -> List(k, Int, a) where Ord k =
  decorated_merge_sorted(
    decorated_sort(list_take(xs, mid)),
    decorated_sort(list_drop(xs, mid))
  )

fn decorated_sort(xs: List (k, Int, a)) -> List(k, Int, a) where Ord k =
  match xs with
  | Nil -> Nil
  | [_] -> xs
  | _ -> decorated_sort_split(xs, list_length(xs) / 2)

# O(n): one pass over the list plus one native allocation/copy into the vector.
export fn vec_from_list(xs: List a) -> Vec a =
  Vec(vector_from_list(xs))

fn decorated_values_to_vec(xs: List (k, Int, a), acc: Vec a) -> Vec a =
  match xs with
  | Nil -> acc
  | Cons entry rest ->
      match entry with
      | (_, _, value) -> decorated_values_to_vec(rest, vec_append(value, acc))

# O(n log n): stable merge sort in Sprout space, plus O(n) decoration and rebuild passes.
export fn vec_sort_by(f: a -> k, vec: Vec a) -> Vec a where Ord k =
  decorated_values_to_vec(
    decorated_sort(list_reverse(vec_sort_by_collect(f, vec, 0, vec_length(vec), Nil))),
    vec_empty()
  )

export fn vec_sort(vec: Vec a) -> Vec a where Ord a =
  vec_sort_by(\value -> value, vec)

export fn dict_empty() -> Dict v =
  Dict(map_empty())

# O(n): the native map is a linear key/value array, so lookup scans keys.
export fn dict_get(key: String, dict: Dict v) -> Maybe v =
  match dict with
  | Dict raw -> map_get(raw, key)

# O(n): persistent update copies entries, with an O(n) key search first.
export fn dict_set(key: String, value: v, dict: Dict v) -> Dict v =
  match dict with
  | Dict raw -> Dict(map_set(raw, key, value))

# O(n): remove scans for the key and copies the surviving entries.
export fn dict_remove(key: String, dict: Dict v) -> Dict v =
  match dict with
  | Dict raw -> Dict(map_remove(raw, key))

fn dict_keys_from(raw: Map v, index: Int, total: Int, acc: List String) -> List String =
  if index >= total then acc
  else
    match map_nth_key(raw, index) with
    | Nothing -> acc
    | Just key -> dict_keys_from(raw, index + 1, total, Cons(key, acc))

# O(n): accumulates keys into a reversed list then converts in one allocation.
export fn dict_keys(dict: Dict v) -> Vec String =
  match dict with
  | Dict raw -> vec_from_list(list_reverse_go(dict_keys_from(raw, 0, map_size(raw), Nil), Nil))

fn dict_values_from(raw: Map v, index: Int, total: Int, acc: List v) -> List v =
  if index >= total then acc
  else
    match map_nth_value(raw, index) with
    | Nothing -> acc
    | Just value -> dict_values_from(raw, index + 1, total, Cons(value, acc))

# O(n): accumulates values into a reversed list then converts in one allocation.
export fn dict_values(dict: Dict v) -> Vec v =
  match dict with
  | Dict raw -> vec_from_list(list_reverse_go(dict_values_from(raw, 0, map_size(raw), Nil), Nil))

fn dict_entries_from(raw: Map v, index: Int, total: Int, acc: List (String, v)) -> List (String, v) =
  if index >= total then acc
  else
    match map_nth_key(raw, index) with
    | Nothing -> acc
    | Just key ->
        match map_nth_value(raw, index) with
        | Nothing -> acc
        | Just value -> dict_entries_from(raw, index + 1, total, Cons((key, value), acc))

# O(n): accumulates entries into a reversed list then converts in one allocation.
export fn dict_entries(dict: Dict v) -> Vec (String, v) =
  match dict with
  | Dict raw -> vec_from_list(list_reverse_go(dict_entries_from(raw, 0, map_size(raw), Nil), Nil))

# O(1).
export fn set_empty() -> Set =
  Set(native_set_empty())

# O(log n): persistent AVL tree (self-balancing) with path-copying on insert.
export fn set_insert(item: String, s: Set) -> Set =
  match s with
  | Set raw -> Set(native_set_insert(item, raw))

# O(log n): AVL binary search.
export fn set_member(item: String, s: Set) -> Bool =
  match s with
  | Set raw -> native_set_member(item, raw)

# O(n): in-order traversal; the returned list is sorted by interned-key order.
export fn set_to_list(s: Set) -> List String =
  match s with
  | Set raw -> native_set_to_list(raw)

# O(1): the AVL nodes cache `size`.
export fn set_size(s: Set) -> Int =
  match s with
  | Set raw -> native_set_size(raw)

# O(m log(n+m)) where n = |xs|, m = |ys|: walks ys (O(m)), set_inserts each
# into xs (O(log(n+m)) per insert as the tree grows).
export fn set_union(xs: Set, ys: Set) -> Set =
  list_fold(\ (acc, y) -> set_insert(y, acc), xs, set_to_list(ys))

# O(n log(n+m)) where n = |xs|, m = |ys|: walks xs (O(n)), checks ys
# membership (O(log m)), inserts kept items into a fresh set (O(log n)).
export fn set_diff(xs: Set, ys: Set) -> Set =
  list_fold(\ (acc, x) -> if set_member(x, ys) then acc else set_insert(x, acc),
            set_empty(), set_to_list(xs))

# O(n log n): reinserts every element into a fresh set, dropping the target.
export fn set_remove(target: String, xs: Set) -> Set =
  list_fold(\ (acc, x) -> if x == target then acc else set_insert(x, acc),
            set_empty(), set_to_list(xs))

export class Semigroup t {
  fn append(left: t, right: t) -> t
}

export class Monoid t where Semigroup t {
  fn empty() -> t
}

export class Functor f {
  fn fmap(f: a -> b, xs: f a) -> f b
}

export class Foldable f {
  fn fold_values(step: b -> a -> b, init: b, xs: f a) -> b
}

export fn map(f: a -> b, xs: c a) -> c b where Functor c =
  fmap(f, xs)

export fn fold(step: b -> a -> b, init: b, xs: f a) -> b where Foldable f =
  fold_values(step, init, xs)

# O(n): fold exposing the 0-based element index to the step function.
export fn fold_indexed(f: b -> Int -> a -> b, init: b, xs: f a) -> b where Foldable f =
  match fold(\ (s, x) -> match s with | (i, acc) -> (i + 1, f(acc, i, x)), (0, init), xs) with
  | (_, result) -> result

export fn mconcat(xs: f a) -> a where Foldable f, Monoid a =
  fold(\ (acc, x) -> acc ++ x, empty(), xs)

instance Semigroup String {
  fn append(left: String, right: String) -> String =
    str_concat(left, right)
}

instance Eq Int {
  fn eq(left: Int, right: Int) -> Bool = left == right
}

instance Eq Bool {
  fn eq(left: Bool, right: Bool) -> Bool = left == right
}

instance Eq String {
  fn eq(left: String, right: String) -> Bool = left == right
}

instance Eq (Maybe a) where Eq a {
  fn eq(left: Maybe a, right: Maybe a) -> Bool =
    match left with
    | Nothing -> match right with | Nothing -> true | Just _ -> false
    | Just x -> match right with | Nothing -> false | Just y -> eq(x, y)
}

fn list_eq(left: List a, right: List a) -> Bool where Eq a =
  match left with
  | Nil -> match right with | Nil -> true | Cons _ _ -> false
  | Cons x xs -> match right with
      | Nil -> false
      | Cons y ys -> if eq(x, y) then list_eq(xs, ys) else false

instance Eq (List a) where Eq a {
  fn eq(left: List a, right: List a) -> Bool = list_eq(left, right)
}

instance Eq (Result e a) where Eq e, Eq a {
  fn eq(left: Result e a, right: Result e a) -> Bool =
    match left with
    | Ok x -> match right with | Ok y -> eq(x, y) | Err _ -> false
    | Err e -> match right with | Ok _ -> false | Err f -> eq(e, f)
}

fn vec_eq_from(left: Vec a, right: Vec a, i: Int, total: Int) -> Bool where Eq a =
  if i == total then true
  else
    match vec_get(i, left) with
    | Nothing -> false
    | Just lv ->
        match vec_get(i, right) with
        | Nothing -> false
        | Just rv ->
            if eq(lv, rv) then vec_eq_from(left, right, i + 1, total)
            else false

instance Eq (Vec a) where Eq a {
  fn eq(left: Vec a, right: Vec a) -> Bool =
    if vec_length(left) != vec_length(right) then false
    else vec_eq_from(left, right, 0, vec_length(left))
}

fn dict_entries_eq(le: Vec (String, v), re: Vec (String, v), i: Int, total: Int) -> Bool where Eq v =
  if i == total then true
  else
    match vec_get(i, le) with
    | Nothing -> false
    | Just (lk, lv) ->
        match vec_get(i, re) with
        | Nothing -> false
        | Just (rk, rv) ->
            if lk == rk && eq(lv, rv)
            then dict_entries_eq(le, re, i + 1, total)
            else false

fn dict_eq(le: Vec (String, v), re: Vec (String, v)) -> Bool where Eq v =
  if vec_length(le) != vec_length(re) then false
  else dict_entries_eq(le, re, 0, vec_length(le))

instance Eq (Dict v) where Eq v {
  fn eq(left: Dict v, right: Dict v) -> Bool =
    dict_eq(dict_entries(left), dict_entries(right))
}

instance ToString Int {
  fn to_string(value: Int) -> String =
    int_to_string(value)
}

instance ToString Bool {
  fn to_string(value: Bool) -> String =
    if value then "true" else "false"
}

instance ToString String {
  fn to_string(value: String) -> String =
    value
}

instance ToString IntRange {
  fn to_string(value: IntRange) -> String =
    "IntRange(" ++ int_to_string(range_start(value)) ++ ", " ++ int_to_string(range_end(value)) ++ ")"
}

instance Ord Int {
  fn compare(left: Int, right: Int) -> Int =
    if left < right then -1
    else if left > right then 1
    else 0
}

instance Ord Bool {
  fn compare(left: Bool, right: Bool) -> Int =
    if left == right then 0
    else if left then 1
    else -1
}

instance Ord String {
  fn compare(left: String, right: String) -> Int =
    str_compare(left, right)
}

instance Semigroup (List a) {
  fn append(left: List a, right: List a) -> List a =
    list_append(left, right)
}

instance Monoid String {
  fn empty() -> String = ""
}

instance Monoid (List a) {
  fn empty() -> List a = Nil
}

instance Functor List {
  fn fmap(f: a -> b, xs: List a) -> List b =
    list_map(f, xs)
}

instance Functor Maybe {
  fn fmap(f: a -> b, xs: Maybe a) -> Maybe b =
    match xs with
    | Nothing -> Nothing
    | Just x -> Just(f(x))
}

instance Foldable List {
  fn fold_values(step: b -> a -> b, init: b, xs: List a) -> b =
    list_fold(step, init, xs)
}

instance Functor Vec {
  fn fmap(f: a -> b, xs: Vec a) -> Vec b =
    vec_map(f, xs)
}

instance Foldable Vec {
  fn fold_values(step: b -> a -> b, init: b, xs: Vec a) -> b =
    vec_fold(step, init, xs)
}

fn vec_append_flip(acc: Vec a, item: a) -> Vec a =
  vec_append(item, acc)

instance Semigroup (Vec a) {
  fn append(left: Vec a, right: Vec a) -> Vec a =
    vec_from_list(list_append(vec_to_list(left), vec_to_list(right)))
}

fn dict_append_entries(acc: Dict v, raw: Map v, index: Int, total: Int) -> Dict v =
  if index >= total then acc
  else
    match map_nth_key(raw, index) with
    | Nothing -> acc
    | Just key ->
        match map_nth_value(raw, index) with
        | Nothing -> acc
        | Just value -> dict_append_entries(dict_set(key, value, acc), raw, index + 1, total)

instance Semigroup (Dict v) {
  fn append(left: Dict v, right: Dict v) -> Dict v =
    match right with
    | Dict raw -> dict_append_entries(left, raw, 0, map_size(raw))
}

export fn foldable_to_vec(xs: f a) -> Vec a where Foldable f =
  vec_from_list(list_reverse_go(fold(\ (acc, x) -> Cons(x, acc), Nil, xs), Nil))

export fn dict_from_list(pairs: List (String, v)) -> Dict v =
  dict_from_list_loop(pairs, dict_empty())

fn dict_from_list_loop(pairs: List (String, v), acc: Dict v) -> Dict v =
  match pairs with
  | Nil -> acc
  | Cons head rest ->
      match head with
      | (k, val) -> dict_from_list_loop(rest, dict_set(k, val, acc))

# Renamed from `pipe` to avoid colliding with POSIX pipe() in linked C code.
# The |> operator desugars via the parser, not through this function.
export fn pipe_apply(f: a -> b, value: a) -> b =
  f(value)

export fn result_map(f: a -> b, r: Result e a) -> Result e b =
  match r with
  | Ok x -> Ok(f(x))
  | Err e -> Err(e)

export fn result_map_error(f: e -> f_err, r: Result e a) -> Result f_err a =
  match r with
  | Ok x -> Ok(x)
  | Err e -> Err(f(e))

export fn result_and_then(f: a -> Result e b, r: Result e a) -> Result e b =
  match r with
  | Ok x -> f(x)
  | Err e -> Err(e)

export fn result_with_default(fallback: a, r: Result e a) -> a =
  match r with
  | Ok x -> x
  | Err _ -> fallback

export fn result_pipe(f: a -> Result e b, r: Result e a) -> Result e b =
  result_and_then(f, r)

export fn result_pipe_ok(f: a -> b, r: Result e a) -> Result e b =
  result_map(f, r)

export fn result_pipe_error(f: e -> f_err, r: Result e a) -> Result f_err a =
  result_map_error(f, r)

export fn after(effect: Unit !{IO}, value: a) -> a !{IO} =
  value

export fn when_ok(f: a -> Unit !{IO}, r: Result e a) -> Result e a !{IO} =
  match r with
  | Ok x -> after(f(x), r)
  | Err e -> Err(e)

export fn when_error(f: e -> Unit !{IO}, r: Result e a) -> Result e a !{IO} =
  match r with
  | Ok x -> Ok(x)
  | Err e -> after(f(e), r)

instance ToString (Maybe a) where ToString a {
  fn to_string(x: Maybe a) -> String =
    match x with
    | Nothing -> "Nothing"
    | Just v -> "Just(" ++ to_string(v) ++ ")"
}

fn list_to_string_go(strs: List String, acc: String) -> String =
  match strs with
  | Nil -> acc
  | Cons s rest ->
    list_to_string_go(rest, if acc == "" then s else acc ++ ", " ++ s)

instance ToString (List a) where ToString a {
  fn to_string(xs: List a) -> String =
    "[" ++ list_to_string_go(list_map(\ (v) -> to_string(v), xs), "") ++ "]"
}

instance ToString (Result e a) where ToString e, ToString a {
  fn to_string(x: Result e a) -> String =
    match x with
    | Ok v -> "Ok(" ++ to_string(v) ++ ")"
    | Err e -> "Err(" ++ to_string(e) ++ ")"
}

fn vec_to_string_go(vec: Vec a, i: Int, total: Int, acc: String) -> String where ToString a =
  if i == total then acc
  else
    match vec_get(i, vec) with
    | Nothing -> acc
    | Just v ->
        vec_to_string_go(vec, i + 1, total,
          if acc == "" then to_string(v) else acc ++ ", " ++ to_string(v))

instance ToString (Vec a) where ToString a {
  fn to_string(vec: Vec a) -> String =
    "[" ++ vec_to_string_go(vec, 0, vec_length(vec), "") ++ "]"
}

fn dict_to_string_go(entries: Vec (String, v), i: Int, total: Int, acc: String) -> String where ToString v =
  if i == total then acc
  else
    match vec_get(i, entries) with
    | Nothing -> acc
    | Just (k, v) ->
        dict_to_string_go(entries, i + 1, total,
          if acc == "" then k ++ ": " ++ to_string(v)
          else acc ++ ", " ++ k ++ ": " ++ to_string(v))

fn dict_entries_to_string(entries: Vec (String, v)) -> String where ToString v =
  dict_to_string_go(entries, 0, vec_length(entries), "")

instance ToString (Dict v) where ToString v {
  fn to_string(dict: Dict v) -> String =
    "{" ++ dict_entries_to_string(dict_entries(dict)) ++ "}"
}

instance ToString Set {
  # O(n²): set_to_list is O(n); list_to_string_go does n string concats each
  # touching the growing accumulator (worst-case O(n)).
  fn to_string(s: Set) -> String =
    "{" ++ list_to_string_go(set_to_list(s), "") ++ "}"
}

# O(1)
instance ToString (a, b) where ToString a, ToString b {
  fn to_string(t: (a, b)) -> String =
    match t with
    | (x, y) -> "(" ++ to_string(x) ++ ", " ++ to_string(y) ++ ")"
}

# O(1)
instance ToString (a, b, c) where ToString a, ToString b, ToString c {
  fn to_string(t: (a, b, c)) -> String =
    match t with
    | (x, y, z) -> "(" ++ to_string(x) ++ ", " ++ to_string(y) ++ ", " ++ to_string(z) ++ ")"
}

# O(1)
instance ToString (a, b, c, d) where ToString a, ToString b, ToString c, ToString d {
  fn to_string(t: (a, b, c, d)) -> String =
    match t with
    | (x, y, z, w) -> "(" ++ to_string(x) ++ ", " ++ to_string(y) ++ ", " ++ to_string(z) ++ ", " ++ to_string(w) ++ ")"
}

# O(1)
instance ToString (a, b, c, d, e) where ToString a, ToString b, ToString c, ToString d, ToString e {
  fn to_string(t: (a, b, c, d, e)) -> String =
    match t with
    | (x, y, z, w, v) -> "(" ++ to_string(x) ++ ", " ++ to_string(y) ++ ", " ++ to_string(z) ++ ", " ++ to_string(w) ++ ", " ++ to_string(v) ++ ")"
}

# ---------------------------------------------------------------------------
# Extern fn declarations for user-callable C builtins.
# These give the codegen accurate LLVM types without a hardcoded table.
# extern fn declarations below are the authoritative type signatures for the
# Sprout type checker (checker.sprout no longer seeds these in builtin_entries).
# ---------------------------------------------------------------------------

# I/O
extern fn print(val: a) -> Unit !{IO}
extern fn eprint(val: String) -> Unit !{IO}
extern fn print_int(n: Int) -> Int !{IO}
extern fn read_file(path: String) -> Result String String !{IO}
extern fn write_file(path: String, content: String) -> Result String Unit !{IO}
extern fn panic(msg: String) -> a !{IO}
extern fn read_lines(path: String) -> List String !{IO}
extern fn read_int_lines(path: String) -> Vector Int !{IO}
extern fn argv_get(idx: Int) -> Maybe String !{IO}

export fn argv_all() -> List String !{IO} =
  argv_collect(0)

fn argv_collect(i: Int) -> List String !{IO} =
  match argv_get(i) with
  | Nothing -> Nil
  | Just s -> do
      rest <- argv_collect(i + 1)
      Cons(s, rest)

extern fn env_get(name: String) -> Maybe String !{IO}
# Returns microseconds from a monotonic clock (CLOCK_MONOTONIC).
# Only differences between two calls are meaningful — the epoch is unspecified.
# Use for elapsed-time measurement (benchmarks, timeouts); not for wall-clock timestamps.
extern fn time_now_micros() -> Int !{IO}

# Numeric / string conversions
extern fn parse_int(s: String) -> Int
extern fn int_to_string(n: Int) -> String
extern fn char_to_string(c: Char) -> String
extern fn char_to_str(codepoint: Int) -> String

# Integer ranges
extern fn int_range(start: Int, end: Int) -> IntRange
extern fn int_range_start(r: IntRange) -> Int
extern fn int_range_end(r: IntRange) -> Int

# String primitives
extern fn str_concat(a: String, b: String) -> String
extern fn string_concat_many(xs: List String) -> String
extern fn string_join_newlines(xs: List String) -> String
extern fn str_len(s: String) -> Int
extern fn str_slice(s: String, from: Int, to: Int) -> String
# O(strlen + byte_len). Byte-indexed substring; faster than str_slice when the
# caller already tracks byte positions (most compiler stdlib scanning loops).
# CALLER CONTRACT: byte_start and byte_start+byte_len MUST land on UTF-8
# codepoint boundaries. The runtime panics on mid-codepoint split rather than
# silently emitting invalid UTF-8. For codepoint-indexed slicing of arbitrary
# user input, use str_slice instead.
extern fn str_slice_bytes(s: String, byte_start: Int, byte_len: Int) -> String
extern fn str_char_at(s: String, i: Int) -> Maybe Char
extern fn str_find(haystack: String, needle: String) -> Int
extern fn str_starts_with(s: String, prefix: String) -> Bool
extern fn str_compare(a: String, b: String) -> Int
extern fn str_split_lines(s: String) -> List String
extern fn str_char_at_byte(s: String, byte: Int) -> Maybe Char
extern fn str_char_width_at_byte(s: String, byte: Int) -> Int
extern fn str_byte_len(s: String) -> Int
extern fn str_starts_with_at_byte(s: String, byte: Int, prefix: String) -> Bool
extern fn split_words(s: String) -> List String

# Raw vector (unboxed mutable array)
extern fn vector_empty() -> Vector a
extern fn vector_length(v: Vector a) -> Int
extern fn vector_get(v: Vector a, i: Int) -> Maybe a
extern fn vector_set(v: Vector a, i: Int, val: a) -> Vector a
extern fn vector_append(v: Vector a, val: a) -> Vector a
extern fn vector_from_list(xs: List a) -> Vector a
extern fn vec_make_filled(n: Int, val: a) -> Vector a !{IO}
extern fn vector_mutset(v: Vector a, i: Int, val: a) -> Unit !{IO}
extern fn vector_get_direct(v: Vector a, i: Int) -> a !{IO}

# Raw map (string-keyed hash map)
extern fn map_empty() -> Map v
extern fn map_get(m: Map v, key: String) -> Maybe v
extern fn map_set(m: Map v, key: String, val: v) -> Map v
extern fn map_remove(m: Map v, key: String) -> Map v
extern fn map_size(m: Map v) -> Int
extern fn map_nth_key(m: Map v, n: Int) -> Maybe String
extern fn map_nth_value(m: Map v, n: Int) -> Maybe v

# Raw native set (string-keyed hash set)
extern fn native_set_empty() -> NativeSet
extern fn native_set_insert(key: String, s: NativeSet) -> NativeSet
extern fn native_set_member(key: String, s: NativeSet) -> Bool
extern fn native_set_to_list(s: NativeSet) -> List String
extern fn native_set_size(s: NativeSet) -> Int

# Bytes
extern fn bytes_empty() -> Bytes
extern fn bytes_length(b: Bytes) -> Int
extern fn bytes_get(b: Bytes, i: Int) -> Maybe Int
extern fn bytes_slice(b: Bytes, from: Int, to: Int) -> Bytes
extern fn bytes_append(b: Bytes, other: Bytes) -> Bytes
extern fn bytes_singleton(val: Int) -> Bytes
extern fn bytes_from_utf8(s: String) -> Bytes

# Mutable references
extern fn ref_new(val: a) -> Ref a !{IO}
extern fn ref_read(r: Ref a) -> a !{IO}
extern fn ref_write(r: Ref a, val: a) -> Unit !{IO}

# Mutable vectors (opaque; use mutvec_* functions only)
fn mutvec_raw(v: MutVec a) -> Vector a =
  match v with | MutVec raw -> raw

export fn mutvec_new(n: Int, val: a) -> MutVec a !{IO} =
  do
    raw <- vec_make_filled(n, val)
    MutVec(raw)

export fn mutvec_get(v: MutVec a, i: Int) -> a !{IO} =
  vector_get_direct(mutvec_raw(v), i)

export fn mutvec_set(v: MutVec a, i: Int, val: a) -> Unit !{IO} =
  vector_mutset(mutvec_raw(v), i, val)

# Regex
extern fn regex_validate(pattern: String) -> Result String Unit
extern fn regex_is_match(pattern: String, text: String) -> Bool
extern fn regex_find_range(pattern: String, text: String) -> Maybe IntRange
extern fn regex_replace_all_literal(s: String, pattern: String, replacement: String) -> String
extern fn regex_escape(s: String) -> String

# Network
extern fn tcp_read(conn: Int) -> String !{IO}

# Terminal
extern fn term_clear() -> Unit !{IO}
extern fn term_move(row: Int, col: Int) -> Unit !{IO}
extern fn term_hide_cursor() -> Unit !{IO}
extern fn term_show_cursor() -> Unit !{IO}
extern fn term_is_interactive() -> Bool !{IO}
extern fn term_read_key() -> String !{IO}
extern fn term_read_line() -> Maybe String !{IO}
extern fn term_write(text: String) -> Unit !{IO}


# Crypto
extern fn crypto_sha256(b: Bytes) -> Bytes
extern fn crypto_hmac_sha256(key: Bytes, msg: Bytes) -> Bytes
extern fn crypto_base64_encode(b: Bytes) -> String
