# Sprout Prelude (v0)
# Pure helpers implemented in Sprout itself.

type List a =
  | Cons a (List a)
  | Nil

type Result e a =
  | Ok a
  | Err e

fn map(xs: List a, f: a -> b) -> List b =
  match xs with
  | Nil -> Nil
  | Cons x rest -> Cons(f(x), map(rest, f))

fn fold(xs: List a, init: b, f: b -> a -> b) -> b =
  match xs with
  | Nil -> init
  | Cons x rest -> fold(rest, f(init, x), f)

fn filter(xs: List a, pred: a -> Bool) -> List a =
  match xs with
  | Nil -> Nil
  | Cons x rest ->
      if pred(x) then Cons(x, filter(rest, pred))
      else filter(rest, pred)

fn split_ints(s: String) -> List Int =
  map(split_words(s), parse_int)

fn result_map(r: Result e a, f: a -> b) -> Result e b =
  match r with
  | Ok x -> Ok(f(x))
  | Err e -> Err(e)

fn result_map_error(r: Result e a, f: e -> f_err) -> Result f_err a =
  match r with
  | Ok x -> Ok(x)
  | Err e -> Err(f(e))

fn result_and_then(r: Result e a, f: a -> Result e b) -> Result e b =
  match r with
  | Ok x -> f(x)
  | Err e -> Err(e)

fn result_with_default(r: Result e a, fallback: a) -> a =
  match r with
  | Ok x -> x
  | Err _ -> fallback

fn keep_after(effect: IO Unit, value: a) -> a =
  value

fn when_ok(r: Result e a, f: a -> IO Unit) -> Result e a =
  match r with
  | Ok x -> keep_after(f(x), r)
  | Err e -> Err(e)

fn when_error(r: Result e a, f: e -> IO Unit) -> Result e a =
  match r with
  | Ok x -> Ok(x)
  | Err e -> keep_after(f(e), r)
