# Sprout Prelude (v0)
# Foundational helpers implemented in Sprout itself.

type Maybe a =
  | Just a
  | Nothing

type List a =
  | Cons a (List a)
  | Nil

type Result e a =
  | Ok a
  | Err e

type Vec a =
  | Vec (Vector a)

type Dict v =
  | Dict (Map v)

fn map(f: a -> b, xs: List a) -> List b =
  match xs with
  | Nil -> Nil
  | Cons x rest -> Cons(f(x), map(f, rest))

fn fold(f: b -> a -> b, init: b, xs: List a) -> b =
  match xs with
  | Nil -> init
  | Cons x rest -> fold(f, f(init, x), rest)

fn filter(pred: a -> Bool, xs: List a) -> List a =
  match xs with
  | Nil -> Nil
  | Cons x rest ->
      if pred(x) then Cons(x, filter(pred, rest))
      else filter(pred, rest)

fn split_ints(s: String) -> List Int =
  map(parse_int, split_words(s))

fn list_map(f: a -> b, xs: List a) -> List b =
  map(f, xs)

fn list_fold(step: b -> a -> b, init: b, xs: List a) -> b =
  fold(step, init, xs)

fn list_append(left: List a, right: List a) -> List a =
  match left with
  | Nil -> right
  | Cons x rest -> Cons(x, list_append(rest, right))

fn vec_empty() -> Vec a =
  Vec(vector_empty())

fn vec_prepend_into(acc: Vector a, first: a, source: Vector a, index: Int, total: Int) -> Vector a =
  if index == 0 then
    vec_prepend_into(vector_append(acc, first), first, source, 1, total)
  else if index > total then acc
  else
    match vector_get(source, index - 1) with
    | Nothing -> acc
    | Just item -> vec_prepend_into(vector_append(acc, item), first, source, index + 1, total)

fn vec_prepend(value: a, vec: Vec a) -> Vec a =
  match vec with
  | Vec raw ->
      Vec(vec_prepend_into(vector_empty(), value, raw, 0, vector_length(raw)))

fn vec_append(value: a, vec: Vec a) -> Vec a =
  match vec with
  | Vec raw -> Vec(vector_append(raw, value))

fn vec_length(vec: Vec a) -> Int =
  match vec with
  | Vec raw -> vector_length(raw)

fn vec_get(index: Int, vec: Vec a) -> Maybe a =
  match vec with
  | Vec raw -> vector_get(raw, index)

fn vec_get_or(index: Int, fallback: a, vec: Vec a) -> a =
  match vec_get(index, vec) with
  | Just value -> value
  | Nothing -> fallback

fn vec_set(index: Int, value: a, vec: Vec a) -> Vec a =
  match vec with
  | Vec raw -> Vec(vector_set(raw, index, value))

fn vec_map_indexed(f: a -> b, vec: Vec a, index: Int, total: Int, acc: Vec b) -> Vec b =
  if index >= total then acc
  else
    match vec_get(index, vec) with
    | Nothing -> acc
    | Just value -> vec_map_indexed(f, vec, index + 1, total, vec_append(f(value), acc))

fn vec_map(f: a -> b, vec: Vec a) -> Vec b =
  vec_map_indexed(f, vec, 0, vec_length(vec), vec_empty())

fn vec_fold_indexed(f: b -> a -> b, acc: b, vec: Vec a, index: Int, total: Int) -> b =
  if index >= total then acc
  else
    match vec_get(index, vec) with
    | Nothing -> acc
    | Just value -> vec_fold_indexed(f, f(acc, value), vec, index + 1, total)

fn vec_fold(f: b -> a -> b, init: b, vec: Vec a) -> b =
  vec_fold_indexed(f, init, vec, 0, vec_length(vec))

fn vec_slice_from(start: Int, count: Int, vec: Vec a, index: Int, total: Int, acc: Vec a) -> Vec a =
  if index >= total then acc
  else if index < start then
    vec_slice_from(start, count, vec, index + 1, total, acc)
  else if index >= start + count then acc
  else
    match vec_get(index, vec) with
    | Nothing -> acc
    | Just value -> vec_slice_from(start, count, vec, index + 1, total, vec_append(value, acc))

fn vec_slice(start: Int, count: Int, vec: Vec a) -> Vec a =
  if count <= 0 then vec_empty()
  else
    vec_slice_from(if start < 0 then 0 else start, count, vec, 0, vec_length(vec), vec_empty())

fn vec_reverse_from(vec: Vec a, index: Int, acc: Vec a) -> Vec a =
  if index < 0 then acc
  else
    match vec_get(index, vec) with
    | Nothing -> acc
    | Just value -> vec_reverse_from(vec, index - 1, vec_append(value, acc))

fn vec_reverse(vec: Vec a) -> Vec a =
  vec_reverse_from(vec, vec_length(vec) - 1, vec_empty())

fn add_ints(left: Int, right: Int) -> Int = left + right

fn vec_sum(vec: Vec Int) -> Int =
  vec_fold(add_ints, 0, vec)

fn vec_sum_by(f: a -> Int, vec: Vec a) -> Int =
  vec_sum(vec_map(f, vec))

fn dict_empty() -> Dict v =
  Dict(map_empty())

fn dict_get(key: String, dict: Dict v) -> Maybe v =
  match dict with
  | Dict raw -> map_get(raw, key)

fn dict_set(key: String, value: v, dict: Dict v) -> Dict v =
  match dict with
  | Dict raw -> Dict(map_set(raw, key, value))

fn dict_remove(key: String, dict: Dict v) -> Dict v =
  match dict with
  | Dict raw -> Dict(map_remove(raw, key))

fn dict_keys_from(raw: Map v, index: Int, total: Int, acc: Vec String) -> Vec String =
  if index >= total then acc
  else
    match map_nth_key(raw, index) with
    | Nothing -> acc
    | Just key -> dict_keys_from(raw, index + 1, total, vec_append(key, acc))

fn dict_keys(dict: Dict v) -> Vec String =
  match dict with
  | Dict raw -> dict_keys_from(raw, 0, map_size(raw), vec_empty())

fn dict_values_from(raw: Map v, index: Int, total: Int, acc: Vec v) -> Vec v =
  if index >= total then acc
  else
    match map_nth_value(raw, index) with
    | Nothing -> acc
    | Just value -> dict_values_from(raw, index + 1, total, vec_append(value, acc))

fn dict_values(dict: Dict v) -> Vec v =
  match dict with
  | Dict raw -> dict_values_from(raw, 0, map_size(raw), vec_empty())

class Semigroup t {
  fn append(x: t, y: t) -> t
}

class Functor f {
  fn fmap(f: a -> b, xs: f a) -> f b
}

class Foldable f {
  fn fold_values(step: b -> a -> b, init: b, xs: f a) -> b
}

instance Semigroup String {
  fn append(x: String, y: String) -> String =
    str_concat(x, y)
}

instance Semigroup (List a) {
  fn append(x: List a, y: List a) -> List a =
    list_append(x, y)
}

instance Functor List {
  fn fmap(f: a -> b, xs: List a) -> List b =
    list_map(f, xs)
}

instance Foldable List {
  fn fold_values(step: b -> a -> b, init: b, xs: List a) -> b =
    list_fold(step, init, xs)
}

instance Functor Vec {
  fn fmap(f: a -> b, xs: Vec a) -> Vec b =
    vec_map(f, xs)
}

instance Foldable Vec {
  fn fold_values(step: b -> a -> b, init: b, xs: Vec a) -> b =
    vec_fold(step, init, xs)
}

fn vec_append_flip(acc: Vec a, item: a) -> Vec a =
  vec_append(item, acc)

instance Semigroup (Vec a) {
  fn append(x: Vec a, y: Vec a) -> Vec a =
    vec_fold(vec_append_flip, x, y)
}

fn dict_append_entries(acc: Dict v, raw: Map v, index: Int, total: Int) -> Dict v =
  if index >= total then acc
  else
    match map_nth_key(raw, index) with
    | Nothing -> acc
    | Just key ->
        match map_nth_value(raw, index) with
        | Nothing -> acc
        | Just value -> dict_append_entries(dict_set(key, value, acc), raw, index + 1, total)

instance Semigroup (Dict v) {
  fn append(x: Dict v, y: Dict v) -> Dict v =
    match y with
    | Dict raw -> dict_append_entries(x, raw, 0, map_size(raw))
}

fn foldable_to_vec(xs: f a) -> Vec a where Foldable f =
  fold_values(vec_append_flip, vec_empty(), xs)

fn pipe(value: a, f: a -> b) -> b =
  f(value)

fn result_map(r: Result e a, f: a -> b) -> Result e b =
  match r with
  | Ok x -> Ok(f(x))
  | Err e -> Err(e)

fn result_map_error(r: Result e a, f: e -> f_err) -> Result f_err a =
  match r with
  | Ok x -> Ok(x)
  | Err e -> Err(f(e))

fn result_and_then(r: Result e a, f: a -> Result e b) -> Result e b =
  match r with
  | Ok x -> f(x)
  | Err e -> Err(e)

fn result_with_default(r: Result e a, fallback: a) -> a =
  match r with
  | Ok x -> x
  | Err _ -> fallback

fn result_pipe(r: Result e a, f: a -> Result e b) -> Result e b =
  result_and_then(r, f)

fn result_pipe_ok(r: Result e a, f: a -> b) -> Result e b =
  result_map(r, f)

fn result_pipe_error(r: Result e a, f: e -> f_err) -> Result f_err a =
  result_map_error(r, f)

fn keep_after(effect: Unit !{IO}, value: a) -> a !{IO} =
  value

fn when_ok(r: Result e a, f: a -> Unit !{IO}) -> Result e a !{IO} =
  match r with
  | Ok x -> keep_after(f(x), r)
  | Err e -> Err(e)

fn when_error(r: Result e a, f: e -> Unit !{IO}) -> Result e a !{IO} =
  match r with
  | Ok x -> Ok(x)
  | Err e -> keep_after(f(e), r)
