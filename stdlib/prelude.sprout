# Sprout Prelude (v0)
# Foundational helpers implemented in Sprout itself.

export type Maybe a =
  | Nothing
  | Just a

# StringTemplate runtime ADT — produced by context-aware template desugar
# when the expected type at the use-site is StringTemplate (Phase 4B).
# Each TemplatePart holds an already-evaluated String; the ADT is opaque
# to the HM typechecker and carries no type variables.

export type TemplatePart =
  | TemplateLit String
  | TemplateInterp String

export type StringTemplate =
  | StringTemplate (List TemplatePart)

export fn template_to_string(t: StringTemplate) -> String =
  match t with
  | StringTemplate parts -> string_concat_many(template_parts_to_strings(parts))

export fn template_parts_to_strings(parts: List TemplatePart) -> List String =
  match parts with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | TemplateLit s -> Cons(s, template_parts_to_strings(rest))
      | TemplateInterp s -> Cons(s, template_parts_to_strings(rest))

export type List a =
  | Nil
  | Cons a (List a)

export type Result e a =
  | Ok a
  | Err e

# W7/D1: the total division API. The `/` operator panics on a zero divisor and on
# the INT_MIN / -1 overflow (both undefined for machine integers); safe_div is the
# non-panicking sibling, returning Err(DivByZero) in exactly those two cases.
export type DivByZero =
  | DivByZero

# True iff a is the most-negative Int (INT_MIN), for which a / -1 overflows.
# Detected without an INT_MIN literal (which the lexer cannot yet represent):
# negating INT_MIN wraps back to a negative value.  # O(1)
fn int_is_min(a: Int) -> Bool =
  a < 0 && (0 - a) < 0

# O(1)
export fn safe_div(a: Int, b: Int) -> Result DivByZero Int =
  if b == 0 then Err(DivByZero)
  else if b == -1 && int_is_min(a) then Err(DivByZero)
  else Ok(a / b)

export type Vec a =
  | Vec (Vector a)

export type Dict v =
  | Dict (Map v)

export type Set =
  | Set NativeSet

export fn range(lo: Int, hi: Int) -> IntRange =
  int_range(lo, hi)

export fn range_start(value: IntRange) -> Int =
  int_range_start(value)

export fn range_end(value: IntRange) -> Int =
  int_range_end(value)

export fn range_step(value: IntRange) -> Int =
  if range_start(value) <= range_end(value) then 1 else -1

export fn range_contains(value: IntRange, target: Int) -> Bool =
  if range_step(value) > 0 then
    target >= range_start(value) && target <= range_end(value)
  else
    target <= range_start(value) && target >= range_end(value)

export fn range_count(value: IntRange) -> Int =
  if range_step(value) > 0 then
    (range_end(value) - range_start(value)) + 1
  else
    (range_start(value) - range_end(value)) + 1

fn range_to_list_go(current: Int, end_value: Int, step: Int) -> List Int =
  if current == end_value then Cons(current, Nil)
  else Cons(current, range_to_list_go(current + step, end_value, step))

export fn range_to_list(value: IntRange) -> List Int =
  range_to_list_go(range_start(value), range_end(value), range_step(value))

fn range_fold_go(current: Int, end_value: Int, by: Int, acc: b, step: b -> Int -> b !{e}) -> b !{e} =
  if current == end_value then step(acc, current)
  else
    do
      next <- step(acc, current)
      range_fold_go(current + by, end_value, by, next, step)

# O(n): inclusive fold over [start, end] following the range's step. The step's effect
# row is polymorphic (`!{e}`), so pure callers get `e = {}` and effectful callers may
# read/write mutable state inside `step`. Data-last: the range is the final argument.
export fn range_fold(step: b -> Int -> b !{e}, init: b, r: IntRange) -> b !{e} =
  range_fold_go(range_start(r), range_end(r), range_step(r), init, step)

fn range_each_go(f: Int -> Unit !{e}, current: Int, end_value: Int, by: Int) -> Unit !{e} =
  if current == end_value then f(current)
  else
    do
      _ <- f(current)
      range_each_go(f, current + by, end_value, by)

# O(n): inclusive imperative loop over [start, end]; `f` runs for its effect at each index.
export fn range_each(f: Int -> Unit !{e}, r: IntRange) -> Unit !{e} =
  range_each_go(f, range_start(r), range_end(r), range_step(r))

fn list_map_go(f: a -> b, xs: List a) -> List b =
  match xs with
  | Nil -> Nil
  | Cons x rest -> Cons(f(x), list_map_go(f, rest))

fn list_fold_go(step: b -> a -> b !{e}, init: b, xs: List a) -> b !{e} =
  match xs with
  | Nil -> init
  | Cons x rest ->
      do
        next <- step(init, x)
        list_fold_go(step, next, rest)

fn list_each_go(f: a -> Unit !{e}, xs: List a) -> Unit !{e} =
  match xs with
  | Nil -> ()
  | Cons x rest ->
      do
        _ <- f(x)
        list_each_go(f, rest)

export fn filter(pred: a -> Bool, xs: List a) -> List a =
  match xs with
  | Nil -> Nil
  | Cons x rest ->
      if pred(x) then Cons(x, filter(pred, rest))
      else filter(pred, rest)

export fn list_map(f: a -> b, xs: List a) -> List b =
  list_map_go(f, xs)

# O(n): left fold; `step`'s effect row is polymorphic, so this serves both pure folds and
# effectful accumulation (reading/writing mutable state inside `step`). Data-last.
export fn list_fold(step: b -> a -> b !{e}, init: b, xs: List a) -> b !{e} =
  list_fold_go(step, init, xs)

# O(n): imperative traversal; `f` runs for its effect on each element.
export fn list_each(f: a -> Unit !{e}, xs: List a) -> Unit !{e} =
  list_each_go(f, xs)

export fn list_append(left: List a, right: List a) -> List a =
  match left with
  | Nil -> right
  | Cons x rest -> Cons(x, list_append(rest, right))

# O(sum of |f(x)|) with repeated append cost: bind for the List monad — apply f
# to each element and concatenate the results (flatten-map). Backs `Monad List`.
export fn list_flat_map(f: a -> List b, xs: List a) -> List b =
  match xs with
  | Nil -> Nil
  | Cons x rest -> list_append(f(x), list_flat_map(f, rest))

export fn vec_empty() -> Vec a =
  Vec(vector_empty())

# O(n): the native/vector builtin returns a fresh vector and copies existing items.
export fn vec_singleton(value: a) -> Vec a =
  vec_append(value, vec_empty())

fn vec_prepend_into(acc: Vector a, first: a, source: Vector a, index: Int, total: Int) -> Vector a =
  if index == 0 then
    vec_prepend_into(vector_append(acc, first), first, source, 1, total)
  else if index > total then acc
  else
    match vector_get(source, index - 1) with
    | Nothing -> acc
    | Just item -> vec_prepend_into(vector_append(acc, item), first, source, index + 1, total)

export fn vec_prepend(value: a, vec: Vec a) -> Vec a =
  match vec with
  | Vec raw ->
      Vec(vec_prepend_into(vector_empty(), value, raw, 0, vector_length(raw)))

# O(n): `vector_append` is persistent and copies the input vector.
export fn vec_append(value: a, vec: Vec a) -> Vec a =
  match vec with
  | Vec raw -> Vec(vector_append(raw, value))

fn range_vec_step(acc: Vec Int, item: Int) -> Vec Int =
  vec_append(item, acc)

export fn range_to_vec(value: IntRange) -> Vec Int =
  range_fold(range_vec_step, vec_empty(), value)

export fn vec_length(vec: Vec a) -> Int =
  match vec with
  | Vec raw -> vector_length(raw)

# O(1): indexed lookup in the native vector representation.
export fn vec_get(index: Int, vec: Vec a) -> Maybe a =
  match vec with
  | Vec raw -> vector_get(raw, index)

export fn vec_get_or(index: Int, fallback: a, vec: Vec a) -> a =
  match vec_get(index, vec) with
  | Just value -> value
  | Nothing -> fallback

export fn vec_set(index: Int, value: a, vec: Vec a) -> Vec a =
  match vec with
  | Vec raw -> Vec(vector_set(raw, index, value))

fn vec_map_indexed(f: a -> b, vec: Vec a, index: Int, total: Int, acc: List b) -> Vec b =
  if index >= total then vec_from_list(list_reverse_go(acc, Nil))
  else
    match vec_get(index, vec) with
    | Nothing -> vec_from_list(list_reverse_go(acc, Nil))
    | Just value -> vec_map_indexed(f, vec, index + 1, total, Cons(f(value), acc))

# O(n): one pass over the vec; result built via vec_from_list in a single allocation.
export fn vec_map(f: a -> b, vec: Vec a) -> Vec b =
  vec_map_indexed(f, vec, 0, vec_length(vec), Nil)

fn vec_fold_indexed(f: b -> a -> b, acc: b, vec: Vec a, index: Int, total: Int) -> b =
  if index >= total then acc
  else
    match vec_get(index, vec) with
    | Nothing -> acc
    | Just value -> vec_fold_indexed(f, f(acc, value), vec, index + 1, total)

export fn vec_fold(f: b -> a -> b, init: b, vec: Vec a) -> b =
  vec_fold_indexed(f, init, vec, 0, vec_length(vec))

fn vec_filter_indexed(pred: a -> Bool, vec: Vec a, index: Int, total: Int, acc: List a) -> Vec a =
  if index >= total then vec_from_list(list_reverse_go(acc, Nil))
  else
    match vec_get(index, vec) with
    | Nothing -> vec_from_list(list_reverse_go(acc, Nil))
    | Just value ->
        if pred(value) then vec_filter_indexed(pred, vec, index + 1, total, Cons(value, acc))
        else vec_filter_indexed(pred, vec, index + 1, total, acc)

# O(n): one pass; result built via vec_from_list in a single allocation.
export fn vec_filter(pred: a -> Bool, vec: Vec a) -> Vec a =
  vec_filter_indexed(pred, vec, 0, vec_length(vec), Nil)

fn vec_filter_map_indexed(f: a -> Maybe b, vec: Vec a, index: Int, total: Int, acc: List b) -> Vec b =
  if index >= total then vec_from_list(list_reverse_go(acc, Nil))
  else
    match vec_get(index, vec) with
    | Nothing -> vec_from_list(list_reverse_go(acc, Nil))
    | Just value ->
        match f(value) with
        | Nothing -> vec_filter_map_indexed(f, vec, index + 1, total, acc)
        | Just mapped -> vec_filter_map_indexed(f, vec, index + 1, total, Cons(mapped, acc))

# O(n): one pass; result built via vec_from_list in a single allocation.
export fn vec_filter_map(f: a -> Maybe b, vec: Vec a) -> Vec b =
  vec_filter_map_indexed(f, vec, 0, vec_length(vec), Nil)

fn vec_any_indexed(pred: a -> Bool, vec: Vec a, index: Int, total: Int) -> Bool =
  if index >= total then false
  else
    match vec_get(index, vec) with
    | Nothing -> false
    | Just value -> if pred(value) then true else vec_any_indexed(pred, vec, index + 1, total)

export fn vec_any(pred: a -> Bool, vec: Vec a) -> Bool =
  vec_any_indexed(pred, vec, 0, vec_length(vec))

fn vec_all_indexed(pred: a -> Bool, vec: Vec a, index: Int, total: Int) -> Bool =
  if index >= total then true
  else
    match vec_get(index, vec) with
    | Nothing -> true
    | Just value -> if pred(value) then vec_all_indexed(pred, vec, index + 1, total) else false

export fn vec_all(pred: a -> Bool, vec: Vec a) -> Bool =
  vec_all_indexed(pred, vec, 0, vec_length(vec))

fn vec_count_indexed(pred: a -> Bool, vec: Vec a, index: Int, total: Int, acc: Int) -> Int =
  if index >= total then acc
  else
    match vec_get(index, vec) with
    | Nothing -> acc
    | Just value ->
        if pred(value) then vec_count_indexed(pred, vec, index + 1, total, acc + 1)
        else vec_count_indexed(pred, vec, index + 1, total, acc)

export fn vec_count(pred: a -> Bool, vec: Vec a) -> Int =
  vec_count_indexed(pred, vec, 0, vec_length(vec), 0)

fn vec_slice_from(start: Int, count: Int, vec: Vec a, index: Int, total: Int, acc: List a) -> Vec a =
  if index >= total then vec_from_list(list_reverse_go(acc, Nil))
  else if index < start then
    vec_slice_from(start, count, vec, index + 1, total, acc)
  else if index >= start + count then vec_from_list(list_reverse_go(acc, Nil))
  else
    match vec_get(index, vec) with
    | Nothing -> vec_from_list(list_reverse_go(acc, Nil))
    | Just value -> vec_slice_from(start, count, vec, index + 1, total, Cons(value, acc))

# O(n): one pass over the range; result built via vec_from_list in a single allocation.
export fn vec_slice(start: Int, count: Int, vec: Vec a) -> Vec a =
  if count <= 0 then vec_empty()
  else
    vec_slice_from(if start < 0 then 0 else start, count, vec, 0, vec_length(vec), Nil)

fn vec_reverse_from(vec: Vec a, index: Int, total: Int, acc: List a) -> Vec a =
  if index >= total then vec_from_list(acc)
  else
    match vec_get(index, vec) with
    | Nothing -> vec_from_list(acc)
    | Just value -> vec_reverse_from(vec, index + 1, total, Cons(value, acc))

# O(n): forward-iterate, Cons-prepend into a List (naturally reverses), freeze with vec_from_list.
export fn vec_reverse(vec: Vec a) -> Vec a =
  vec_reverse_from(vec, 0, vec_length(vec), Nil)

fn vec_to_list_go(vec: Vec a, index: Int, acc: List a) -> List a =
  if index < 0 then acc
  else
    match vec_get(index, vec) with
    | Nothing -> acc
    | Just value -> vec_to_list_go(vec, index - 1, Cons(value, acc))

# O(n): walks the vector backwards, building a forward-order list in one pass.
export fn vec_to_list(vec: Vec a) -> List a =
  vec_to_list_go(vec, vec_length(vec) - 1, Nil)

fn add_ints(left: Int, right: Int) -> Int = left + right
export fn negate(x: Int) -> Int = -x

export fn vec_sum(vec: Vec Int) -> Int =
  vec_fold(add_ints, 0, vec)

export fn vec_sum_by(f: a -> Int, vec: Vec a) -> Int =
  vec_fold(\ (acc, x) -> acc + f(x), 0, vec)

export class Eq a {
  fn eq(left: a, right: a) -> Bool
}

export class ToString a {
  fn to_string(value: a) -> String
}

export class Ord a where Eq a {
  fn compare(left: a, right: a) -> Int
}

# A type whose values map to and from a contiguous 0-based ordinal — the
# declaration-order index of each constructor. `deriving (Enum)` synthesizes
# both methods for a nullary-only ADT (docs/spec-v0.md §8.6). `from_ordinal` is
# partial: an out-of-range ordinal yields `Nothing` rather than coercing. Its
# class variable appears only in the return, so a call must fix the target type
# through a concrete boundary (a typed fn return / annotation), not a fully
# polymorphic context.
export class Enum a {
  fn ordinal(v: a) -> Int
  fn from_ordinal(n: Int) -> Maybe a
}

export fn ord_lt(x: a, y: a) -> Bool where Ord a =
  compare(x, y) < 0

export fn ord_lte(x: a, y: a) -> Bool where Ord a =
  compare(x, y) <= 0

export fn ord_gt(x: a, y: a) -> Bool where Ord a =
  compare(x, y) > 0

export fn ord_gte(x: a, y: a) -> Bool where Ord a =
  compare(x, y) >= 0

fn vec_sort_by_collect(f: a -> k, vec: Vec a, index: Int, total: Int, acc: List (k, Int, a)) -> List(k, Int, a) =
  if index >= total then acc
  else
    match vec_get(index, vec) with
    | Nothing -> acc
    | Just value -> vec_sort_by_collect(f, vec, index + 1, total, Cons((f(value), index, value), acc))

fn decorated_key_lt(left: (k, Int, a), right: (k, Int, a)) -> Bool where Ord k =
  match left with
  | (left_key, left_index, _) ->
      match right with
      | (right_key, right_index, _) ->
          if ord_lt(left_key, right_key) then true
          else if ord_gt(left_key, right_key) then false
          else left_index < right_index

fn list_reverse_go(xs: List a, acc: List a) -> List a =
  match xs with
  | Nil -> acc
  | Cons item rest -> list_reverse_go(rest, Cons(item, acc))

export fn list_reverse(xs: List a) -> List a =
  list_reverse_go(xs, Nil)

export fn list_member(x: a, xs: List a) -> Bool where Eq a =
  match xs with
  | Nil -> false
  | Cons h t -> if eq(h, x) then true else list_member(x, t)

export fn list_add_unique(x: a, xs: List a) -> List a where Eq a =
  if list_member(x, xs) then xs else list_append(xs, Cons(x, Nil))

export fn list_union(xs: List a, ys: List a) -> List a where Eq a =
  match xs with
  | Nil -> ys
  | Cons h t ->
      if list_member(h, ys) then list_union(t, ys)
      else Cons(h, list_union(t, ys))

export fn list_diff(xs: List a, ys: List a) -> List a where Eq a =
  match xs with
  | Nil -> Nil
  | Cons h t ->
      if list_member(h, ys) then list_diff(t, ys)
      else Cons(h, list_diff(t, ys))

fn list_dedup_acc(xs: List a, seen: List a) -> List a where Eq a =
  match xs with
  | Nil -> Nil
  | Cons h t ->
      if list_member(h, seen) then list_dedup_acc(t, seen)
      else Cons(h, list_dedup_acc(t, Cons(h, seen)))

# O(n²): list_member on 'seen' is O(n); called once per element.
# A sub-quadratic algorithm needs Ord or Hash — neither is available as a constraint here.
export fn list_dedup(xs: List a) -> List a where Eq a =
  list_dedup_acc(xs, Nil)

fn list_length_go(xs: List a, acc: Int) -> Int =
  match xs with
  | Nil -> acc
  | Cons _ rest -> list_length_go(rest, acc + 1)

fn list_length(xs: List a) -> Int =
  list_length_go(xs, 0)

# Bottom-up (iterative) stable merge sort over decorated (key, index, value)
# tuples. Every helper is tail-recursive or O(log n)-deep, so recursion never
# grows with n — unlike a top-down merge, whose O(n)-deep merge/flatten exhausted
# the GC root pool above ~50k. Stability is guaranteed by decorated_key_lt's
# (key, index) total order, so the order in which runs are paired is irrelevant.

# Merge two sorted runs into one, tail-recursively: push the chosen element onto
# `acc` (built reversed), then flush the remaining run with one list_reverse_go
# (= reverse(acc) ++ rest). Tie goes to the left run (stable, though the index
# tiebreak already makes ties impossible).
fn merge_runs(left: List (k, Int, a), right: List (k, Int, a), acc: List (k, Int, a)) -> List(k, Int, a) where Ord k =
  match left with
  | Nil -> list_reverse_go(acc, right)
  | Cons left_item left_rest ->
      match right with
      | Nil -> list_reverse_go(acc, left)
      | Cons right_item right_rest ->
          if decorated_key_lt(right_item, left_item) then merge_runs(left, right_rest, Cons(right_item, acc))
          else merge_runs(left_rest, right, Cons(left_item, acc))

# One pass: merge adjacent pairs across the run list, tail-recursively. An odd
# trailing run is carried forward unmerged.
fn merge_pass(runs: List (List(k, Int, a)), acc: List (List(k, Int, a))) -> List (List(k, Int, a)) where Ord k =
  match runs with
  | Nil -> list_reverse_go(acc, Nil)
  | Cons a rest ->
      match rest with
      | Nil -> list_reverse_go(acc, Cons(a, Nil))
      | Cons b rest2 -> merge_pass(rest2, Cons(merge_runs(a, b, Nil), acc))

# Repeat passes until a single run remains. Depth is O(log n) — one frame per pass.
fn merge_all(runs: List (List(k, Int, a))) -> List(k, Int, a) where Ord k =
  match runs with
  | Nil -> Nil
  | Cons only rest ->
      match rest with
      | Nil -> only
      | _ -> merge_all(merge_pass(runs, Nil))

# Seed: one singleton (already-sorted) run per element, tail-recursively. Run
# order need not match the input (see stability note above).
fn to_runs(xs: List (k, Int, a), acc: List (List(k, Int, a))) -> List (List(k, Int, a)) =
  match xs with
  | Nil -> acc
  | Cons x rest -> to_runs(rest, Cons (Cons(x, Nil), acc))

# O(n): one pass over the list plus one native allocation/copy into the vector.
export fn vec_from_list(xs: List a) -> Vec a =
  Vec(vector_from_list(xs))

# Tail-recursive: strip values into `acc` (reversed); the caller reverses once.
fn decorated_values_go(xs: List (k, Int, a), acc: List a) -> List a =
  match xs with
  | Nil -> acc
  | Cons entry rest ->
      match entry with
      | (_, _, value) -> decorated_values_go(rest, Cons(value, acc))

# O(n log n): bottom-up stable merge sort. Decoration/collect, run-seeding,
# value-flatten and vec_from_list are each a single O(n) pass; no per-node
# length/take/drop. Recursion depth is O(log n) at most, so it has no size ceiling
# (the old top-down merge exhausted the GC root pool above ~50k). The collect pass
# emits the decorated tuples in reverse index order, which is fine: merge_all sorts
# by the (key, index) total order regardless of input arrangement.
export fn vec_sort_by(f: a -> k, vec: Vec a) -> Vec a where Ord k =
  vec_from_list(
    list_reverse(
      decorated_values_go(
        merge_all(to_runs(vec_sort_by_collect(f, vec, 0, vec_length(vec), Nil), Nil)),
        Nil)))

export fn vec_sort(vec: Vec a) -> Vec a where Ord a =
  vec_sort_by(\value -> value, vec)

export fn dict_empty() -> Dict v =
  Dict(map_empty())

# O(log n): the native map is a balanced AVL tree; lookup is a strcmp descent.
export fn dict_get(key: String, dict: Dict v) -> Maybe v =
  match dict with
  | Dict raw -> map_get(raw, key)

# O(log n): AVL insert; path-copies only the nodes on the root-to-key path.
export fn dict_set(key: String, value: v, dict: Dict v) -> Dict v =
  match dict with
  | Dict raw -> Dict(map_set(raw, key, value))

# O(log n): AVL delete; path-copies the search path and rebalances.
export fn dict_remove(key: String, dict: Dict v) -> Dict v =
  match dict with
  | Dict raw -> Dict(map_remove(raw, key))

fn dict_keys_from(raw: Map v, index: Int, total: Int, acc: List String) -> List String =
  if index >= total then acc
  else
    match map_nth_key(raw, index) with
    | Nothing -> acc
    | Just key -> dict_keys_from(raw, index + 1, total, Cons(key, acc))

# O(n log n): n indexed map_nth_key lookups, each an O(log n) order-statistic descent.
export fn dict_keys(dict: Dict v) -> Vec String =
  match dict with
  | Dict raw -> vec_from_list(list_reverse_go(dict_keys_from(raw, 0, map_size(raw), Nil), Nil))

fn dict_values_from(raw: Map v, index: Int, total: Int, acc: List v) -> List v =
  if index >= total then acc
  else
    match map_nth_value(raw, index) with
    | Nothing -> acc
    | Just value -> dict_values_from(raw, index + 1, total, Cons(value, acc))

# O(n log n): n indexed map_nth_value lookups, each an O(log n) order-statistic descent.
export fn dict_values(dict: Dict v) -> Vec v =
  match dict with
  | Dict raw -> vec_from_list(list_reverse_go(dict_values_from(raw, 0, map_size(raw), Nil), Nil))

fn dict_entries_from(raw: Map v, index: Int, total: Int, acc: List (String, v)) -> List (String, v) =
  if index >= total then acc
  else
    match map_nth_key(raw, index) with
    | Nothing -> acc
    | Just key ->
        match map_nth_value(raw, index) with
        | Nothing -> acc
        | Just value -> dict_entries_from(raw, index + 1, total, Cons((key, value), acc))

# O(n log n): n indexed map_nth key+value lookups, each an O(log n) order-statistic descent.
export fn dict_entries(dict: Dict v) -> Vec (String, v) =
  match dict with
  | Dict raw -> vec_from_list(list_reverse_go(dict_entries_from(raw, 0, map_size(raw), Nil), Nil))

# O(1).
export fn set_empty() -> Set =
  Set(native_set_empty())

# O(log n): persistent AVL tree (self-balancing) with path-copying on insert.
export fn set_insert(item: String, s: Set) -> Set =
  match s with
  | Set raw -> Set(native_set_insert(item, raw))

# O(log n): AVL binary search.
export fn set_member(item: String, s: Set) -> Bool =
  match s with
  | Set raw -> native_set_member(item, raw)

# O(n): in-order traversal; the returned list is sorted by interned-key order.
export fn set_to_list(s: Set) -> List String =
  match s with
  | Set raw -> native_set_to_list(raw)

# O(1): the AVL nodes cache `size`.
export fn set_size(s: Set) -> Int =
  match s with
  | Set raw -> native_set_size(raw)

# O(m log(n+m)) where n = |xs|, m = |ys|: walks ys (O(m)), set_inserts each
# into xs (O(log(n+m)) per insert as the tree grows).
export fn set_union(xs: Set, ys: Set) -> Set =
  list_fold(\ (acc, y) -> set_insert(y, acc), xs, set_to_list(ys))

# O(n log(n+m)) where n = |xs|, m = |ys|: walks xs (O(n)), checks ys
# membership (O(log m)), inserts kept items into a fresh set (O(log n)).
export fn set_diff(xs: Set, ys: Set) -> Set =
  list_fold(\ (acc, x) -> if set_member(x, ys) then acc else set_insert(x, acc),
            set_empty(), set_to_list(xs))

# O(n log n): reinserts every element into a fresh set, dropping the target.
export fn set_remove(target: String, xs: Set) -> Set =
  list_fold(\ (acc, x) -> if x == target then acc else set_insert(x, acc),
            set_empty(), set_to_list(xs))

export class Semigroup t {
  fn append(left: t, right: t) -> t
}

export class Monoid t where Semigroup t {
  fn empty() -> t
}

export class Functor f {
  fn fmap(f: a -> b, xs: f a) -> f b
}

export class Foldable f {
  fn fold_values(step: b -> a -> b, init: b, xs: f a) -> b
}

# Applicative (Package C-b shape): the primitive is `map2` (apply an n-ary function
# to values in a context), NOT `ap`/`<*>` — the latter feeds one wrapped argument at
# a time, which needs curried partial application that Sprout does not have. `pure`
# lifts a plain value; its `f`-only-in-return signature dispatches on the target type
# (same as `Enum`). `map3`..`map5` derive from `map2` below.
export class Applicative f where Functor f {
  fn pure(x: a) -> f a
  fn map2(g: a -> b -> c, xs: f a, ys: f b) -> f c
}

# Monad completes the Functor -> Applicative -> Monad tower: `flat_map` is
# monadic bind (thread `xs : m a` into `f : a -> m b`, short-circuiting on the
# empty/error case). `pure` is inherited from the Applicative superclass, so
# Monad adds only bind. The method is `flat_map`; the exported combinator is
# `and_then` (the `fmap`/`map`, `fold_values`/`fold` free-fn-delegates-to-method
# idiom), keeping the class-method name out of the global namespace.
export class Monad m where Applicative m {
  fn flat_map(f: a -> m b, xs: m a) -> m b
}

export fn and_then(f: a -> m b, xs: m a) -> m b where Monad m =
  flat_map(f, xs)

export fn map(f: a -> b, xs: c a) -> c b where Functor c =
  fmap(f, xs)

export fn fold(step: b -> a -> b, init: b, xs: f a) -> b where Foldable f =
  fold_values(step, init, xs)

# O(n): fold exposing the 0-based element index to the step function.
export fn fold_indexed(f: b -> Int -> a -> b, init: b, xs: f a) -> b where Foldable f =
  match fold(\ (s, x) -> match s with | (i, acc) -> (i + 1, f(acc, i, x)), (0, init), xs) with
  | (_, result) -> result

# O(n²) when 'a = String': each '++' copies the growing accumulator (O(total chars so far)).
# Use string_concat_many directly for String; a String-specific fast path would need Monoid dispatch.
export fn mconcat(xs: f a) -> a where Foldable f, Monoid a =
  fold(\ (acc, x) -> acc ++ x, empty(), xs)

# Map each element to a Monoid value, then concatenate the results — the
# "flatten a per-element list of findings" shape. Same O(n²) tradeoff as
# mconcat (a fold over '++' repeatedly copies the growing accumulator); fine
# for typical-sized inputs (e.g. walking one source file's AST), not a
# replacement for a container-specific bulk-concat builtin on hot paths.
export fn concat_map(f: a -> t, xs: c a) -> t where Functor c, Foldable c, Monoid t =
  mconcat(map(f, xs))

# Internal pairing combiner for the map3..map5 derivations below: without currying,
# an n-ary lift is built by threading arguments through `map2` as tuples and
# destructuring them in the final combiner.
fn ap_pair(x: a, y: b) -> (a, b) = (x, y)

# map3..map5: lift a 3-, 4-, or 5-argument function over an Applicative, derived from
# map2 by threading arguments through the context as tuples and destructuring them in
# a final combiner (no currying is used or required). map5 reuses map3 over three
# independent sub-results to keep each combiner shallow.
export fn map3(g: a -> b -> c -> d, fa: f a, fb: f b, fc: f c) -> f d where Applicative f =
  map2(\ (ab, c) -> match ab with | (a, b) -> g(a, b, c), map2(ap_pair, fa, fb), fc)

export fn map4(g: a -> b -> c -> d -> e, fa: f a, fb: f b, fc: f c, fd: f d) -> f e where Applicative f =
  map2(\ (ab, cd) -> match ab with | (a, b) -> match cd with | (c, d) -> g(a, b, c, d),
       map2(ap_pair, fa, fb), map2(ap_pair, fc, fd))

export fn map5(g: a -> b -> c -> d -> e -> r, fa: f a, fb: f b, fc: f c, fd: f d, fe: f e) -> f r where Applicative f =
  map3(\ (ab, cd, ev) -> match ab with | (a, b) -> match cd with | (c, d) -> g(a, b, c, d, ev),
       map2(ap_pair, fa, fb), map2(ap_pair, fc, fd), fe)

instance Semigroup String {
  fn append(left: String, right: String) -> String =
    str_concat(left, right)
}

instance Eq Int {
  fn eq(left: Int, right: Int) -> Bool = left == right
}

instance Eq Bool {
  fn eq(left: Bool, right: Bool) -> Bool = left == right
}

instance Eq String {
  fn eq(left: String, right: String) -> Bool = left == right
}

instance Eq Char {
  # O(1). A Char is an immediate i64 codepoint; == is an integer compare.
  fn eq(left: Char, right: Char) -> Bool = left == right
}

instance Eq (Maybe a) where Eq a {
  fn eq(left: Maybe a, right: Maybe a) -> Bool =
    match left with
    | Nothing -> match right with | Nothing -> true | Just _ -> false
    | Just x -> match right with | Nothing -> false | Just y -> eq(x, y)
}

fn list_eq(left: List a, right: List a) -> Bool where Eq a =
  match left with
  | Nil -> match right with | Nil -> true | [_ | _] -> false
  | Cons x xs -> match right with
      | Nil -> false
      | Cons y ys -> if eq(x, y) then list_eq(xs, ys) else false

instance Eq (List a) where Eq a {
  fn eq(left: List a, right: List a) -> Bool = list_eq(left, right)
}

instance Eq (Result e a) where Eq e, Eq a {
  fn eq(left: Result e a, right: Result e a) -> Bool =
    match left with
    | Ok x -> match right with | Ok y -> eq(x, y) | Err _ -> false
    | Err e -> match right with | Ok _ -> false | Err f -> eq(e, f)
}

instance Eq (a, b) where Eq a, Eq b {
  fn eq(left: (a, b), right: (a, b)) -> Bool =
    match left with
    | (x1, y1) -> match right with
      | (x2, y2) -> eq(x1, x2) && eq(y1, y2)
}

instance Eq (a, b, c) where Eq a, Eq b, Eq c {
  fn eq(left: (a, b, c), right: (a, b, c)) -> Bool =
    match left with
    | (x1, y1, z1) -> match right with
      | (x2, y2, z2) -> eq(x1, x2) && eq(y1, y2) && eq(z1, z2)
}

instance Eq (a, b, c, d) where Eq a, Eq b, Eq c, Eq d {
  fn eq(left: (a, b, c, d), right: (a, b, c, d)) -> Bool =
    match left with
    | (x1, y1, z1, w1) -> match right with
      | (x2, y2, z2, w2) -> eq(x1, x2) && eq(y1, y2) && eq(z1, z2) && eq(w1, w2)
}

instance Eq (a, b, c, d, e) where Eq a, Eq b, Eq c, Eq d, Eq e {
  fn eq(left: (a, b, c, d, e), right: (a, b, c, d, e)) -> Bool =
    match left with
    | (x1, y1, z1, w1, v1) -> match right with
      | (x2, y2, z2, w2, v2) -> eq(x1, x2) && eq(y1, y2) && eq(z1, z2) && eq(w1, w2) && eq(v1, v2)
}

fn vec_eq_from(left: Vec a, right: Vec a, i: Int, total: Int) -> Bool where Eq a =
  if i == total then true
  else
    let Just lv = vec_get(i, left) else false
        Just rv = vec_get(i, right) else false
    in if eq(lv, rv) then vec_eq_from(left, right, i + 1, total)
       else false

instance Eq (Vec a) where Eq a {
  fn eq(left: Vec a, right: Vec a) -> Bool =
    if vec_length(left) != vec_length(right) then false
    else vec_eq_from(left, right, 0, vec_length(left))
}

fn dict_entries_eq(le: Vec (String, v), re: Vec (String, v), i: Int, total: Int) -> Bool where Eq v =
  if i == total then true
  else
    let Just(lk, lv) = vec_get(i, le) else false
        Just(rk, rv) = vec_get(i, re) else false
    in if lk == rk && eq(lv, rv)
       then dict_entries_eq(le, re, i + 1, total)
       else false

fn dict_eq(le: Vec (String, v), re: Vec (String, v)) -> Bool where Eq v =
  if vec_length(le) != vec_length(re) then false
  else dict_entries_eq(le, re, 0, vec_length(le))

instance Eq (Dict v) where Eq v {
  fn eq(left: Dict v, right: Dict v) -> Bool =
    dict_eq(dict_entries(left), dict_entries(right))
}

instance ToString Double {
  fn to_string(value: Double) -> String =
    double_to_string(value)
}

instance ToString Int {
  fn to_string(value: Int) -> String =
    int_to_string(value)
}

instance ToString Bool {
  fn to_string(value: Bool) -> String =
    if value then "true" else "false"
}

instance ToString String {
  fn to_string(value: String) -> String =
    value
}

instance ToString Char {
  # O(1). A Char is an i64 codepoint; char_to_string encodes it to a UTF-8 String.
  fn to_string(value: Char) -> String =
    char_to_string(value)
}

instance ToString IntRange {
  fn to_string(value: IntRange) -> String =
    "IntRange(" ++ int_to_string(range_start(value)) ++ ", " ++ int_to_string(range_end(value)) ++ ")"
}

instance Ord Int {
  fn compare(left: Int, right: Int) -> Int =
    if left < right then -1
    else if left > right then 1
    else 0
}

instance Ord Bool {
  fn compare(left: Bool, right: Bool) -> Int =
    if left == right then 0
    else if left then 1
    else -1
}

instance Ord String {
  fn compare(left: String, right: String) -> Int =
    str_compare(left, right)
}

# Ord for tuples (arities 2-5): lexicographic, short-circuiting on the first
# unequal component (mirrors the chain `deriving (Ord)` emits).
instance Ord (a, b) where Ord a, Ord b {
  fn compare(left: (a, b), right: (a, b)) -> Int =
    match left with
    | (x1, y1) -> match right with
      | (x2, y2) -> match compare(x1, x2) with | 0 -> compare(y1, y2) | c -> c
}

instance Ord (a, b, c) where Ord a, Ord b, Ord c {
  fn compare(left: (a, b, c), right: (a, b, c)) -> Int =
    match left with
    | (x1, y1, z1) -> match right with
      | (x2, y2, z2) ->
        match compare(x1, x2) with
        | 0 -> match compare(y1, y2) with | 0 -> compare(z1, z2) | c -> c
        | c -> c
}

instance Ord (a, b, c, d) where Ord a, Ord b, Ord c, Ord d {
  fn compare(left: (a, b, c, d), right: (a, b, c, d)) -> Int =
    match left with
    | (x1, y1, z1, w1) -> match right with
      | (x2, y2, z2, w2) ->
        match compare(x1, x2) with
        | 0 -> match compare(y1, y2) with
          | 0 -> match compare(z1, z2) with | 0 -> compare(w1, w2) | c -> c
          | c -> c
        | c -> c
}

instance Ord (a, b, c, d, e) where Ord a, Ord b, Ord c, Ord d, Ord e {
  fn compare(left: (a, b, c, d, e), right: (a, b, c, d, e)) -> Int =
    match left with
    | (x1, y1, z1, w1, v1) -> match right with
      | (x2, y2, z2, w2, v2) ->
        match compare(x1, x2) with
        | 0 -> match compare(y1, y2) with
          | 0 -> match compare(z1, z2) with
            | 0 -> match compare(w1, w2) with | 0 -> compare(v1, v2) | c -> c
            | c -> c
          | c -> c
        | c -> c
}

# Nothing < Just (declaration/tag order now matches the semantic convention).
instance Ord (Maybe a) where Ord a {
  fn compare(left: Maybe a, right: Maybe a) -> Int =
    match left with
    | Nothing -> match right with | Nothing -> 0 | Just _ -> 0 - 1
    | Just x -> match right with | Nothing -> 1 | Just y -> compare(x, y)
}

# Lexicographic; empty list is smallest (Nil < Cons). O(shared prefix).
fn list_compare(left: List a, right: List a) -> Int where Ord a =
  match left with
  | Nil -> match right with | Nil -> 0 | [_ | _] -> 0 - 1
  | Cons x xs -> match right with
      | Nil -> 1
      | Cons y ys -> match compare(x, y) with | 0 -> list_compare(xs, ys) | c -> c

instance Ord (List a) where Ord a {
  fn compare(left: List a, right: List a) -> Int = list_compare(left, right)
}

# Ok < Err (declaration/tag order).
instance Ord (Result e a) where Ord e, Ord a {
  fn compare(left: Result e a, right: Result e a) -> Int =
    match left with
    | Ok x -> match right with | Ok y -> compare(x, y) | Err _ -> 0 - 1
    | Err e -> match right with | Ok _ -> 1 | Err f -> compare(e, f)
}

# Lexicographic; shorter vec is smaller when it is a prefix. O(shared prefix).
fn vec_compare_from(left: Vec a, right: Vec a, i: Int, ltot: Int, rtot: Int) -> Int where Ord a =
  if i == ltot then (if i == rtot then 0 else 0 - 1)
  else if i == rtot then 1
  else
    let Just lv = vec_get(i, left) else 0
        Just rv = vec_get(i, right) else 0
    in
      match compare(lv, rv) with
      | 0 -> vec_compare_from(left, right, i + 1, ltot, rtot)
      | c -> c

instance Ord (Vec a) where Ord a {
  fn compare(left: Vec a, right: Vec a) -> Int =
    vec_compare_from(left, right, 0, vec_length(left), vec_length(right))
}

instance Semigroup (List a) {
  fn append(left: List a, right: List a) -> List a =
    list_append(left, right)
}

instance Monoid String {
  fn empty() -> String = ""
}

instance Monoid (List a) {
  fn empty() -> List a = Nil
}

instance Functor List {
  fn fmap(f: a -> b, xs: List a) -> List b =
    list_map(f, xs)
}

instance Functor Maybe {
  fn fmap(f: a -> b, xs: Maybe a) -> Maybe b =
    match xs with
    | Nothing -> Nothing
    | Just x -> Just(f(x))
}

# Functor (Result e): map over the Ok value, pass Err through unchanged. Required as
# the superclass of Applicative (Result e) — without it, a forwarded Applicative dict
# (map3/map4/map5) over Result has an unresolvable Functor slot and null-fills.
instance Functor (Result e) {
  fn fmap(f: a -> b, r: Result e a) -> Result e b =
    match r with
    | Err x -> Err(x)
    | Ok v -> Ok(f(v))
}

instance Foldable List {
  fn fold_values(step: b -> a -> b, init: b, xs: List a) -> b =
    list_fold(step, init, xs)
}

# O(n·m): the cartesian ("list monad") product — for each x in xs, combine it with
# every y in ys. This is the instance consistent with a List monad; the pairwise
# ("zip") behaviour is a separate ZipList newtype, deferred.
fn map2_list(g: a -> b -> c, xs: List a, ys: List b) -> List c =
  match xs with
  | Nil -> Nil
  | Cons x rest -> list_append(list_map(\y -> g(x, y), ys), map2_list(g, rest, ys))

instance Applicative List {
  # pure produces a singleton — the unit of the cartesian product.
  fn pure(x: a) -> List a = Cons(x, Nil)
  fn map2(g: a -> b -> c, xs: List a, ys: List b) -> List c = map2_list(g, xs, ys)
}

instance Monad List {
  # Bind = flatten-map: concatenate f applied across every element. Consistent
  # with the cartesian-product Applicative above.
  fn flat_map(f: a -> List b, xs: List a) -> List b = list_flat_map(f, xs)
}

instance Applicative Maybe {
  fn pure(x: a) -> Maybe a = Just(x)
  # Fail-fast: any Nothing collapses the whole result. `do` desugars to the same
  # nested match, so this is flat source with identical short-circuit codegen.
  fn map2(g: a -> b -> c, mx: Maybe a, my: Maybe b) -> Maybe c =
    do
      x <- mx
      y <- my
      Just(g(x, y))
}

instance Monad Maybe {
  # Nothing short-circuits; Just x feeds the payload to the continuation.
  fn flat_map(f: a -> Maybe b, mx: Maybe a) -> Maybe b =
    match mx with
    | Nothing -> Nothing
    | Just x -> f(x)
}

instance Applicative (Result e) {
  fn pure(x: a) -> Result e a = Ok(x)
  # Fail-fast: the first Err short-circuits (left-biased); `do` carries the Err
  # through automatically. Error-accumulating semantics need a distinct type
  # (Validation), deferred — a type has one instance.
  fn map2(g: a -> b -> c, rx: Result e a, ry: Result e b) -> Result e c =
    do
      x <- rx
      y <- ry
      Ok(g(x, y))
}

instance Monad (Result e) {
  # Left-biased: the first Err short-circuits; Ok x feeds the payload onward.
  fn flat_map(f: a -> Result e b, rx: Result e a) -> Result e b =
    match rx with
    | Err e -> Err(e)
    | Ok x -> f(x)
}

instance Functor Vec {
  fn fmap(f: a -> b, xs: Vec a) -> Vec b =
    vec_map(f, xs)
}

instance Foldable Vec {
  fn fold_values(step: b -> a -> b, init: b, xs: Vec a) -> b =
    vec_fold(step, init, xs)
}

fn vec_append_flip(acc: Vec a, item: a) -> Vec a =
  vec_append(item, acc)

# O(n+m): one fresh backing array, both element blocks copied in a single pass
# via the vector_concat builtin (no intermediate cons cells).
instance Semigroup (Vec a) {
  fn append(left: Vec a, right: Vec a) -> Vec a =
    match left with
    | Vec lraw ->
        match right with
        | Vec rraw -> Vec(vector_concat(lraw, rraw))
}

# O(m · log(n + m)): each of the m right-hand entries is read via an O(log m) map_nth
# and inserted via an O(log) dict_set on the growing (n..n+m) left. No bulk-build map primitive exists.
fn dict_append_entries(acc: Dict v, raw: Map v, index: Int, total: Int) -> Dict v =
  if index >= total then acc
  else
    match map_nth_key(raw, index) with
    | Nothing -> acc
    | Just key ->
        match map_nth_value(raw, index) with
        | Nothing -> acc
        | Just value -> dict_append_entries(dict_set(key, value, acc), raw, index + 1, total)

instance Semigroup (Dict v) {
  fn append(left: Dict v, right: Dict v) -> Dict v =
    match right with
    | Dict raw -> dict_append_entries(left, raw, 0, map_size(raw))
}

export fn foldable_to_vec(xs: f a) -> Vec a where Foldable f =
  vec_from_list(list_reverse_go(fold(\ (acc, x) -> Cons(x, acc), Nil, xs), Nil))

export fn dict_from_list(pairs: List (String, v)) -> Dict v =
  dict_from_list_loop(pairs, dict_empty())

fn dict_from_list_loop(pairs: List (String, v), acc: Dict v) -> Dict v =
  match pairs with
  | Nil -> acc
  | Cons head rest ->
      match head with
      | (k, val) -> dict_from_list_loop(rest, dict_set(k, val, acc))

# Renamed from `pipe` to avoid colliding with POSIX pipe() in linked C code.
# The |> operator desugars via the parser, not through this function.
export fn pipe_apply(f: a -> b, value: a) -> b =
  f(value)

# f >> g desugars to rcompose(f, g): apply f first, then g.  O(1)
export fn rcompose(f: a -> b, g: b -> c) =
  \x -> g(f(x))

# f << g desugars to lcompose(f, g): apply g first, then f.  O(1)
export fn lcompose(f: b -> c, g: a -> b) =
  \x -> f(g(x))

export fn result_map(f: a -> b, r: Result e a) -> Result e b =
  match r with
  | Ok x -> Ok(f(x))
  | Err e -> Err(e)

export fn result_map_error(f: e -> f_err, r: Result e a) -> Result f_err a =
  match r with
  | Ok x -> Ok(x)
  | Err e -> Err(f(e))

export fn result_and_then(f: a -> Result e b, r: Result e a) -> Result e b =
  match r with
  | Ok x -> f(x)
  | Err e -> Err(e)

export fn result_with_default(fallback: a, r: Result e a) -> a =
  match r with
  | Ok x -> x
  | Err _ -> fallback

export fn result_pipe(f: a -> Result e b, r: Result e a) -> Result e b =
  result_and_then(f, r)

export fn result_pipe_ok(f: a -> b, r: Result e a) -> Result e b =
  result_map(f, r)

export fn result_pipe_error(f: e -> f_err, r: Result e a) -> Result f_err a =
  result_map_error(f, r)

# Maybe combinators, mirroring the result_* family. Bind/map are the generic
# `and_then`/`map` (Monad/Functor); these cover the axes those classes do not:
# unwrap-or-default and left-biased fallback (the Alternative `<|>` shape, kept
# as a free fn because a Maybe-only Alternative class would be single-instance).
export fn maybe_with_default(fallback: a, m: Maybe a) -> a =
  match m with
  | Just x -> x
  | Nothing -> fallback

export fn maybe_or_else(primary: Maybe a, fallback: Maybe a) -> Maybe a =
  match primary with
  | Just x -> Just(x)
  | Nothing -> fallback

export fn after(effect: Unit !{IO}, value: a) -> a !{IO} =
  value

export fn when_ok(f: a -> Unit !{IO}, r: Result e a) -> Result e a !{IO} =
  match r with
  | Ok x -> after(f(x), r)
  | Err e -> Err(e)

export fn when_error(f: e -> Unit !{IO}, r: Result e a) -> Result e a !{IO} =
  match r with
  | Ok x -> Ok(x)
  | Err e -> after(f(e), r)

instance ToString (Maybe a) where ToString a {
  fn to_string(x: Maybe a) -> String =
    match x with
    | Nothing -> "Nothing"
    | Just v -> "Just(" ++ to_string(v) ++ ")"
}

fn list_to_string_parts(strs: List String, first: Bool, acc: List String) -> String =
  match strs with
  | Nil -> string_concat_many(list_reverse_go(acc, Nil))
  | Cons s rest ->
      if first then list_to_string_parts(rest, false, Cons(s, acc))
      else list_to_string_parts(rest, false, Cons(s, Cons(", ", acc)))

# O(n): accumulates parts into a reversed List, then string_concat_many joins in one pass.
fn list_to_string_go(strs: List String) -> String =
  list_to_string_parts(strs, true, Nil)

# O(n): one to_string call per element; string joining via string_concat_many is O(total chars).
instance ToString (List a) where ToString a {
  fn to_string(xs: List a) -> String =
    "[" ++ list_to_string_go(list_map(\ (v) -> to_string(v), xs)) ++ "]"
}

instance ToString (Result e a) where ToString e, ToString a {
  fn to_string(x: Result e a) -> String =
    match x with
    | Ok v -> "Ok(" ++ to_string(v) ++ ")"
    | Err e -> "Err(" ++ to_string(e) ++ ")"
}

fn vec_to_string_go(vec: Vec a, i: Int, total: Int, first: Bool, acc: List String) -> String where ToString a =
  if i == total then string_concat_many(list_reverse_go(acc, Nil))
  else
    match vec_get(i, vec) with
    | Nothing -> string_concat_many(list_reverse_go(acc, Nil))
    | Just v ->
        if first then vec_to_string_go(vec, i + 1, total, false, Cons(to_string(v), acc))
        else vec_to_string_go(vec, i + 1, total, false, Cons(to_string(v), Cons(", ", acc)))

# O(n): one to_string call per element; string joining via string_concat_many is O(total chars).
instance ToString (Vec a) where ToString a {
  fn to_string(vec: Vec a) -> String =
    "[" ++ vec_to_string_go(vec, 0, vec_length(vec), true, Nil) ++ "]"
}

fn dict_to_string_go(entries: Vec (String, v), i: Int, total: Int, first: Bool, acc: List String) -> String where ToString v =
  if i == total then string_concat_many(list_reverse_go(acc, Nil))
  else
    match vec_get(i, entries) with
    | Nothing -> string_concat_many(list_reverse_go(acc, Nil))
    | Just (k, v) ->
        if first then dict_to_string_go(entries, i + 1, total, false, Cons(k ++ ": " ++ to_string(v), acc))
        else dict_to_string_go(entries, i + 1, total, false, Cons(k ++ ": " ++ to_string(v), Cons(", ", acc)))

# O(n): accumulates parts into a reversed List, then string_concat_many joins in one pass.
fn dict_entries_to_string(entries: Vec (String, v)) -> String where ToString v =
  dict_to_string_go(entries, 0, vec_length(entries), true, Nil)

instance ToString (Dict v) where ToString v {
  fn to_string(dict: Dict v) -> String =
    "{" ++ dict_entries_to_string(dict_entries(dict)) ++ "}"
}

instance ToString Set {
  # O(n): set_to_list is O(n); list_to_string_go joins parts via string_concat_many.
  fn to_string(s: Set) -> String =
    "{" ++ list_to_string_go(set_to_list(s)) ++ "}"
}

# O(1)
instance ToString (a, b) where ToString a, ToString b {
  fn to_string(t: (a, b)) -> String =
    match t with
    | (x, y) -> "(" ++ to_string(x) ++ ", " ++ to_string(y) ++ ")"
}

# O(1)
instance ToString (a, b, c) where ToString a, ToString b, ToString c {
  fn to_string(t: (a, b, c)) -> String =
    match t with
    | (x, y, z) -> "(" ++ to_string(x) ++ ", " ++ to_string(y) ++ ", " ++ to_string(z) ++ ")"
}

# O(1)
instance ToString (a, b, c, d) where ToString a, ToString b, ToString c, ToString d {
  fn to_string(t: (a, b, c, d)) -> String =
    match t with
    | (x, y, z, w) -> "(" ++ to_string(x) ++ ", " ++ to_string(y) ++ ", " ++ to_string(z) ++ ", " ++ to_string(w) ++ ")"
}

# O(1)
instance ToString (a, b, c, d, e) where ToString a, ToString b, ToString c, ToString d, ToString e {
  fn to_string(t: (a, b, c, d, e)) -> String =
    match t with
    | (x, y, z, w, v) -> "(" ++ to_string(x) ++ ", " ++ to_string(y) ++ ", " ++ to_string(z) ++ ", " ++ to_string(w) ++ ", " ++ to_string(v) ++ ")"
}

# ---------------------------------------------------------------------------
# Extern fn declarations for user-callable C builtins.
# These give the codegen accurate LLVM types without a hardcoded table.
# extern fn declarations below are the authoritative type signatures for the
# Sprout type checker (checker.sprout no longer seeds these in builtin_entries).
# ---------------------------------------------------------------------------

# I/O
extern fn print(val: a) -> Unit !{IO}
extern fn eprint(val: String) -> Unit !{IO}
extern fn print_int(n: Int) -> Int !{IO}
extern fn read_file(path: String) -> Result String String !{IO}
extern fn write_file(path: String, content: String) -> Result String Unit !{IO}
extern fn panic(msg: String) -> a !{IO}
extern fn read_lines(path: String) -> List String !{IO}
extern fn read_int_lines(path: String) -> Vector Int !{IO}
extern fn argv_get(idx: Int) -> Maybe String !{IO}

export fn argv_all() -> List String !{IO} =
  argv_collect(0)

fn argv_collect(i: Int) -> List String !{IO} =
  match argv_get(i) with
  | Nothing -> Nil
  | Just s -> do
      rest <- argv_collect(i + 1)
      Cons(s, rest)

extern fn env_get(name: String) -> Maybe String !{IO}
# Returns microseconds from a monotonic clock (CLOCK_MONOTONIC).
# Only differences between two calls are meaningful — the epoch is unspecified.
# Use for elapsed-time measurement (benchmarks, timeouts); not for wall-clock timestamps.
extern fn time_now_micros() -> Int !{IO}

# Returns microseconds since the Unix epoch from the wall clock (CLOCK_REALTIME).
# NOT monotonic — subject to NTP steps and manual clock changes, so it must not be
# used for elapsed-time measurement (use time_now_micros for that). Use for civil-time
# rendering such as log timestamps (see stdlib.log).
extern fn wall_time_micros() -> Int !{IO}

# Numeric / string conversions
# W8/P1 (D5): total signed-decimal integer parse. Returns Nothing for anything
# that is not `-?[0-9]+` (previously the C `strtoll` extern silently returned 0
# for junk). Pure Sprout — the digit value comes from `==` against char literals
# (no per-digit String allocation). Overflow wraps at i64 (documented v0 Int
# behavior; overflow *rejection* is the separate W9/X4 work).  # O(n)
fn digit_value(c: Char) -> Int =
  if c == '0' then 0
  else if c == '1' then 1
  else if c == '2' then 2
  else if c == '3' then 3
  else if c == '4' then 4
  else if c == '5' then 5
  else if c == '6' then 6
  else if c == '7' then 7
  else if c == '8' then 8
  else if c == '9' then 9
  else 0 - 1

# Accumulate digits from index i. Nothing if any char is a non-digit, or if no
# digit was seen at all. `seen` guards against empty / lone-sign input.
fn accum_digits(s: String, i: Int, acc: Int, seen: Bool) -> Maybe Int =
  match str_char_at(s, i) with
  | Nothing -> if seen then Just(acc) else Nothing
  | Just c ->
      if digit_value(c) < 0 then Nothing
      else accum_digits(s, i + 1, (acc * 10) + digit_value(c), true)

fn negate_maybe(m: Maybe Int) -> Maybe Int =
  match m with
  | Nothing -> Nothing
  | Just n -> Just(0 - n)

# O(n)
export fn parse_int(s: String) -> Maybe Int =
  match str_char_at(s, 0) with
  | Nothing -> Nothing
  | Just c ->
      if c == '-' then negate_maybe(accum_digits(s, 1, 0, false))
      else accum_digits(s, 0, 0, false)

# 10^k as a Double for any k (k < 0 divides). Places the fraction and applies a
# scientific-notation exponent in parse_double.
fn pow10_pos(k: Int) -> Double = if k <= 0 then 1.0 else 10.0 * pow10_pos(k - 1)
fn pow10(k: Int) -> Double = if k < 0 then 1.0 / pow10_pos(0 - k) else pow10_pos(k)

# Split `s` on the first occurrence of single-char `sep` into (before, after); Nothing if
# absent. Prelude-native (str_find/str_slice) since split_once lives in stdlib.string, which
# depends on prelude. NB str_slice's third arg is a LENGTH, not an end index (both char-based).
fn split_on_char(s: String, sep: String) -> Maybe (String, String) =
  let i = str_find(s, sep)
  in if i < 0 then Nothing
     else Just((str_slice(s, 0, i), str_slice(s, i + str_len(sep), str_len(s))))

# A run of decimal digits as a non-negative Double; empty string -> 0.0 (so an absent int or
# fraction part reads as zero). Nothing on any non-digit. Leading zeros are preserved by the
# caller passing the substring's length to pow10.
fn digits_double(s: String) -> Maybe Double =
  if str_len(s) <= 0 then Just(0.0)
  else match parse_int(s) with
       | Nothing -> Nothing
       | Just n -> if n < 0 then Nothing else Just(to_double(n))

# Non-negative mantissa "int[.frac]" -> Double. `int` or `frac` may be empty (".5", "5.");
# a lone "." is rejected.
fn parse_mantissa(mant: String) -> Maybe Double =
  match split_on_char(mant, ".") with
  | Nothing -> if str_len(mant) <= 0 then Nothing else digits_double(mant)
  | Just (ip, fp) ->
      if (str_len(ip) <= 0) && (str_len(fp) <= 0) then Nothing
      else match (digits_double(ip), digits_double(fp)) with
           | (Just iv, Just fv) -> Just(iv + (fv / pow10(str_len(fp))))
           | _ -> Nothing

# Split off an optional 'e'/'E' exponent: returns (mantissa, exponent). No exponent -> 0;
# a present-but-malformed exponent -> Nothing.
fn split_exponent(body: String) -> Maybe (String, Int) =
  match (match split_on_char(body, "e") with
         | Just p -> Just(p)
         | Nothing -> split_on_char(body, "E")) with
  | Nothing -> Just((body, 0))
  | Just (mant, es) ->
      match parse_int(es) with
      | Nothing -> Nothing
      | Just e -> Just((mant, e))

# Parse a decimal Double from text: optional leading '-', an integer part, an optional
# '.' fraction, and an optional 'e'/'E' exponent (with optional sign). Returns Nothing on
# any malformed input, never crashes. Pure Sprout — no strtod builtin: the magnitude is
# `intpart + frac/10^len(frac)`, then scaled by `10^exp`. Accurate to Double arithmetic
# (fine for config/JSON data), NOT a bit-exact strtod round-trip.
export fn parse_double(s: String) -> Maybe Double =
  let neg = str_starts_with(s, "-")
      body = if neg then str_slice(s, 1, str_len(s)) else s
  in match split_exponent(body) with
     | Nothing -> Nothing
     | Just (mant, e) ->
         match parse_mantissa(mant) with
         | Nothing -> Nothing
         | Just mag -> Just(if neg then 0.0 - (mag * pow10(e)) else mag * pow10(e))
extern fn int_to_string(n: Int) -> String
extern fn double_to_string(x: Double) -> String
extern fn char_to_string(c: Char) -> String
extern fn char_to_str(codepoint: Int) -> String
extern fn char_from_codepoint(cp: Int) -> Char

# Compiler intrinsic: intercepted in ast_to_ir/codegen and lowered to an inline
# `sitofp` (an Int value to the equal Double value), NOT a runtime call — there
# is no @to_double symbol.  The extern decl exists only to give it a type, the
# same way `print` is declared-but-intercepted.  Like `print`, and for the same
# reason, it cannot be used as a first-class value (e.g. `map(to_double, xs)`):
# that references the undefined @to_double and fails to link (loud, not silent).
extern fn to_double(n: Int) -> Double

