module stdlib.net

import stdlib.bytes (Utf8Error, from_string, to_string, length)

export extern fn tcp_listen(port: Int) -> Int !{IO}
export extern fn tcp_accept(listener: Int) -> Int !{IO}
export extern fn tcp_read(conn: Int) -> String !{IO}
export extern fn tcp_write(conn: Int, data: String) -> Unit !{IO}
# Recoverable read-available: like tcp_read, but returns Err on a socket failure instead of
# aborting the process (Ok("") on peer EOF). The missing member of the Result-returning socket
# family — tcp_read_exact blocks for an exact count, so it cannot read a header block of unknown
# length. Lets a server drop one failing connection rather than exit(1).
export extern fn tcp_read_avail(conn: Int) -> Result TcpError String !{IO}
# Deadline-bounded read-available: waits at most `timeout_ms` for data, then `Err TcpTimeout` with
# the connection STILL VALID (Go's SetReadDeadline / Java's SO_TIMEOUT semantics, not cancellation).
# `timeout_ms <= 0` polls once without waiting, so a caller enforcing a TOTAL budget can pass the
# remaining slice and get an immediate timeout when it is spent — see stdlib.http_server, which
# needs a total bound because a per-read one is defeated by a peer dribbling a byte per interval.
export extern fn tcp_read_avail_timeout(conn: Int, timeout_ms: Int) -> Result TcpError String !{IO}
# Raw connect. Exported for the same reason tcp_listen/tcp_accept/tcp_read/
# tcp_write/tcp_close are: code whose shape the linear TcpConnection API cannot
# yet express must still be able to speak TCP. Callers on this path get no
# release enforcement; prefer `connect` where the shape allows.
#
# The accept -> hand the socket to a SPAWNED task shape used to be on that list.
# It no longer is: M4.4a's `once` parameters let a linear value be MOVED into a
# closure the callee invokes at most once, and stdlib.http_server now runs on
# TcpConnection/TcpListener throughout. What remains unexpressible is a closure
# that BORROWS across a spawn, and a linear value captured by a lambda at an
# unannotated parameter — the rest of M4.4.
export extern fn tcp_connect(host: String, port: Int) -> Result TcpError Int !{IO}
# Readiness, moving no data: parks until the connection is ready for `interest` or `ms` elapses.
# Ok(1) = ready, Ok(0) = the deadline passed; `ms <= 0` answers 0 without parking. One primitive for
# read, write, connect and accept — the park is scheduler-internal, so it must be a builtin, but
# every policy above it (a total budget, a minimum data rate, a size cap) is ordinary Sprout.
extern fn tcp_wait(conn: Int, interest: Int, ms: Int) -> Result TcpError Int !{IO}
# Transfer, never parking: one send from `offset`. Ok(n > 0) on progress, Err(TcpWouldBlock) when the
# kernel took nothing, Ok(0) only for an exhausted payload. `offset` rather than a re-sliced tail so
# a caller's loop stays linear instead of going quadratic in the payload length.
extern fn tcp_write_some(conn: Int, data: Bytes, offset: Int) -> Result TcpError Int !{IO}

extern fn tcp_read_exact(conn: Int, count: Int) -> Result TcpError Bytes !{IO}
extern fn tcp_write_all(conn: Int, data: Bytes) -> Result TcpError Int !{IO}
# Idle-bounded write: no single stall may exceed `idle_ms`, and any byte the kernel accepts re-arms
# the bound. These are nginx's send_timeout semantics — "the timeout is set only between two
# successive write operations, not for the transmission of the whole response" — so a slow but
# reading client is never cut off, while one that stops reading entirely is. `idle_ms <= 0` attempts
# the write once without parking, matching tcp_read_avail_timeout.
extern fn tcp_write_all_timeout(conn: Int, data: Bytes, idle_ms: Int) -> Result TcpError Int !{IO}
export extern fn tcp_close(conn: Int) -> Unit !{IO}
export extern fn tcp_close_listener(listener: Int) -> Unit !{IO}
extern fn tcp_echo_serve(port: Int, max_connections: Int) -> Unit !{IO}

export type TcpError (..) =
  | TcpInvalidArgument String
  | TcpInvalidHandle
  | TcpConnectFailed String
  | TcpReadFailed String
  | TcpWriteFailed String
  | TcpEndOfStream
  # A deadline-bounded read or write ran out of time. Distinct from TcpReadFailed/TcpWriteFailed
  # because it is not a fault: the connection is still valid, so the caller may retry with a fresh
  # budget or run its normal close path.
  | TcpTimeout
  # The kernel accepted no bytes right now. Also not a fault, and distinct from TcpTimeout: nothing
  # has expired, the caller simply has to wait for readiness before retrying. Reported only by the
  # non-parking transfer primitives, whose whole purpose is to hand that decision back to Sprout.
  | TcpWouldBlock

# LINEAR (M4.5). A connection is acquire -> use N times -> release once: reads and
# writes `borrow` it, `close` consumes it. Linearity turns the release discipline
# from a convention into a compile error — omit `close` and the caller is rejected
# with a leak. This shape is only expressible because of borrowing; under strict
# M4.2 consume-exactly-once the first `write_all` would consume the connection and
# every later use would be a reuse. See docs/linear-borrowing-v0.md.
export type linear TcpConnection =
  | TcpConnection Int

export type linear TcpListener =
  | TcpListener Int

export fn tcp_error_message(err: TcpError) -> String =
  match err with
  | TcpInvalidArgument msg -> msg
  | TcpInvalidHandle -> "invalid handle"
  | TcpConnectFailed msg -> msg
  | TcpReadFailed msg -> msg
  | TcpWriteFailed msg -> msg
  | TcpEndOfStream -> "end of stream"
  | TcpTimeout -> "timed out"
  | TcpWouldBlock -> "would block"

# Reads the handle out without taking the connection: `match` on a borrowed
# binding is a read, not a consume, so this composes into every borrowing op below.
fn tcp_connection_handle(conn: borrowing TcpConnection) -> Int =
  match conn with
  | TcpConnection handle -> handle

fn tcp_listener_handle(listener: borrowing TcpListener) -> Int =
  match listener with
  | TcpListener handle -> handle

# Cost is dominated by the underlying network connect attempt. A connect that cannot complete at
# once PARKS the calling task rather than blocking the scheduler, so siblings keep running and a
# `with_timeout` around it works — a stalled peer costs this task, not the process.
export fn connect(host: String, port: Int) -> Result TcpError TcpConnection !{IO} =
  do
    handle <- tcp_connect(host, port)
    Ok(TcpConnection(handle))

# O(count) once bytes arrive: fills a fresh buffer of the requested size.
export fn read_exact(conn: borrowing TcpConnection, count: Int) -> Result TcpError Bytes !{IO} =
  tcp_read_exact(tcp_connection_handle(conn), count)

# O(|payload|): writes the full payload, retrying partial sends as needed.
export fn write_all(conn: borrowing TcpConnection, payload: Bytes) -> Result TcpError Int !{IO} =
  tcp_write_all(tcp_connection_handle(conn), payload)

# `write_all` with an idle bound: `Err TcpTimeout` once a single stall exceeds `idle_ms`, with the
# connection still valid so the caller closes it normally. Any accepted byte re-arms the bound, so
# this bounds a peer that STOPPED reading without penalising one that reads slowly. A server needs it
# for the same reason it needs a read deadline: an unbounded write parks the handler forever and its
# connection handle is never returned to the table. See stdlib.http_server.
export fn write_all_timeout(conn: borrowing TcpConnection, payload: Bytes, idle_ms: Int) -> Result TcpError Int !{IO} =
  tcp_write_all_timeout(tcp_connection_handle(conn), payload, idle_ms)

# `write_all` bounded by an ABSOLUTE deadline (monotonic microseconds, as from time_now_micros).
#
# This is the shape `write_all_timeout` cannot have. Its bound is idle and re-armed inside C on every
# accepted byte, so a peer taking one byte per interval holds the call forever and no deadline
# computed here can intervene — the caller never regains control mid-payload. Written as a Sprout
# loop over the non-parking `tcp_write_some` plus `tcp_wait`, the deadline is checked on every
# iteration, so the TOTAL is bounded no matter how the peer paces its reads.
#
# "Attempt the transfer, then wait" is the only shape this loop can take, because tcp_write_some
# never parks: the ordering that a hand-written C retry loop keeps getting wrong is structural here.
# `offset` advances instead of the payload being re-sliced, so an n-byte write stays O(n).
# Mirrors SPROUT_POLL_WRITE in runtime/sprout_scheduler.h.
let poll_write = 2

fn write_all_by_wait(handle: Int, payload: Bytes, deadline_us: Int, offset: Int, total: Int) -> Result TcpError Int !{IO} =
  do
    now <- time_now_micros()
    # A `remaining <= 0` makes tcp_wait answer "not ready" without parking, so an already-spent
    # budget needs no special case here.
    ready <- tcp_wait(handle, poll_write, (deadline_us - now) / 1000)
    if ready == 1 then write_all_by_go(handle, payload, deadline_us, offset, total)
    else Err(TcpTimeout)

fn write_all_by_go(handle: Int, payload: Bytes, deadline_us: Int, offset: Int, total: Int) -> Result TcpError Int !{IO} =
  if offset >= total then Ok(total)
  else
    match tcp_write_some(handle, payload, offset) with
    | Ok sent ->
        if sent <= 0 then Ok(total)
        else write_all_by_go(handle, payload, deadline_us, offset + sent, total)
    | Err TcpWouldBlock -> write_all_by_wait(handle, payload, deadline_us, offset, total)
    | Err err -> Err(err)

export fn write_all_by(conn: borrowing TcpConnection, payload: Bytes, deadline_us: Int) -> Result TcpError Int !{IO} =
  write_all_by_go(tcp_connection_handle(conn), payload, deadline_us, 0, length(payload))

export fn write_all_utf8_by(conn: borrowing TcpConnection, payload: String, deadline_us: Int) -> Result TcpError Int !{IO} =
  write_all_by(conn, from_string(payload), deadline_us)

# Recoverable string write over a raw connection handle, for callers holding an Int rather
# than the opaque TcpConnection. Returns Err on a socket failure instead of aborting — the
# write counterpart to tcp_read_avail.
#
# It has NO caller in-tree since stdlib.http_server moved to the linear API (M4.4a); it names
# no consumer here for that reason. Kept as an exported escape hatch alongside the raw
# tcp_* externs above, for code whose shape the linear API still cannot express — retire it
# with them, not before, so the raw-handle path stays complete rather than half-usable.
export fn tcp_write_string(conn: Int, data: String) -> Result TcpError Int !{IO} =
  tcp_write_all(conn, from_string(data))

# Read whatever has arrived, without taking the connection. The unknown-length
# counterpart to read_exact: an HTTP header block ends at a delimiter, not at a
# byte count, so a server cannot ask for an exact size. Err on socket failure,
# Ok("") on a clean peer EOF — so one client's reset drops one connection rather
# than aborting the process.
export fn read_avail(conn: borrowing TcpConnection) -> Result TcpError String !{IO} =
  tcp_read_avail(tcp_connection_handle(conn))

# `read_avail` with a deadline: `Err TcpTimeout` if no data arrives within `timeout_ms`, leaving the
# connection valid to read again. `timeout_ms <= 0` polls once without waiting. Bounding a read is
# how a server survives a peer that connects and then says nothing; see stdlib.http_server.
export fn read_avail_timeout(conn: borrowing TcpConnection, timeout_ms: Int) -> Result TcpError String !{IO} =
  tcp_read_avail_timeout(tcp_connection_handle(conn), timeout_ms)

# O(count): reads bytes, then validates and copies the UTF-8 payload.
export fn read_exact_utf8(conn: borrowing TcpConnection, count: Int) -> Result TcpError String !{IO} =
  do
    payload <- read_exact(conn, count)
    match to_string(payload) with
    | Ok text -> Ok(text)
    | Err utf8_err -> Err(TcpReadFailed(utf8_error_message(utf8_err)))

# O(|payload|): UTF-8 encoding copy plus the full network write.
export fn write_all_utf8(conn: borrowing TcpConnection, payload: String) -> Result TcpError Int !{IO} =
  write_all(conn, from_string(payload))

# O(|payload|): `write_all_utf8` under `write_all_timeout`'s idle bound.
export fn write_all_utf8_timeout(conn: borrowing TcpConnection, payload: String, idle_ms: Int) -> Result TcpError Int !{IO} =
  write_all_timeout(conn, from_string(payload), idle_ms)

# The single consuming use. Every acquired connection must reach exactly one of
# these, on every control-flow path, or the program does not compile.
export fn close(conn: consuming TcpConnection) -> Unit !{IO} =
  match conn with
  | TcpConnection handle -> tcp_close(handle)

export fn listen_local(port: Int) -> TcpListener !{IO} =
  TcpListener(tcp_listen(port))

export fn accept(listener: borrowing TcpListener) -> TcpConnection !{IO} =
  TcpConnection(tcp_accept(tcp_listener_handle(listener)))

export fn close_listener(listener: consuming TcpListener) -> Unit !{IO} =
  match listener with
  | TcpListener handle -> tcp_close_listener(handle)

type alias TcpResult a = Result TcpError a

fn utf8_error_message(err: Utf8Error) -> String =
  match err with
  | Utf8DecodeError msg -> msg
