module stdlib.net

import stdlib.bytes (Utf8Error, Utf8DecodeError, builder_append, builder_build, builder_bytes, builder_empty, empty, from_string, to_string, length)
import stdlib.time as time

export extern fn tcp_listen(port: Int) -> Int !{IO}
# Recoverable since the C3 fix: `Err TcpAcceptFailed` for a listener that is broken rather than busy.
# Everything transient is absorbed inside the builtin — EAGAIN parks; EINTR, ECONNABORTED and the eight
# pending-network errnos accept(2) says to treat like EAGAIN retry; descriptor exhaustion and a full
# handle table park on the listener and retry, since no Sprout-visible primitive can wait for those.
export extern fn tcp_accept(listener: Int) -> Result TcpError Int !{IO}
export extern fn tcp_write(conn: Int, data: String) -> Unit !{IO}
# Raw connect. Exported for the same reason tcp_listen/tcp_accept/tcp_write/tcp_close are: code whose
# shape the linear TcpConnection API cannot yet express must still be able to speak TCP. Callers on
# this path get no release enforcement; prefer `connect` where the shape allows.
#
# The accept -> hand the socket to a SPAWNED task shape used to be on that list.
# It no longer is: M4.4a's `once` parameters let a linear value be MOVED into a
# closure the callee invokes at most once, and stdlib.http_server now runs on
# TcpConnection/TcpListener throughout. What remains unexpressible is a closure
# that BORROWS across a spawn, and a linear value captured by a lambda at an
# unannotated parameter — the rest of M4.4.
export extern fn tcp_connect(host: String, port: Int) -> Result TcpError Int !{IO}
# Readiness, moving no data: parks until the connection is ready for `interest` or `ms` elapses.
# Ok(1) = ready, Ok(0) = the deadline passed; `ms <= 0` answers 0 without parking. One primitive for
# read, write, connect and accept — the park is scheduler-internal, so it must be a builtin, but
# every policy above it (a total budget, a minimum data rate, a size cap) is ordinary Sprout.
extern fn tcp_wait(conn: Int, interest: Int, ms: Int) -> Result TcpError Int !{IO}
# Transfer, never parking: one send from `offset`. Ok(n > 0) on progress, Err(TcpWouldBlock) when the
# kernel took nothing, Ok(0) only for an exhausted payload. `offset` rather than a re-sliced tail so
# a caller's loop stays linear instead of going quadratic in the payload length.
extern fn tcp_write_some(conn: Int, data: Bytes, offset: Int) -> Result TcpError Int !{IO}
# The read-side twin: one recv of at most `max_bytes` (clamped to 64 KiB), never parking. Ok(chunk)
# holds at least one byte; Err(TcpWouldBlock) means the kernel had none; Err(TcpEndOfStream) means the
# peer closed cleanly.
#
# BYTES, not String, and that is the substantive part. This replaced tcp_read, tcp_read_avail and
# tcp_read_avail_timeout, all three of which adopted the received bytes as a String — so a payload
# containing 0x00 produced a value violating the String invariant ("always valid UTF-8, contains no
# NUL byte", docs/spec-v0.md:64). Nothing validated it, and the corruption was silent: byte_length
# read the length header and was right while every strlen-based operation stopped at the NUL. There is
# no validation to add here; bytes.to_string is the one choke point and it rejects a NUL as well as
# invalid UTF-8, so every String derived from a socket now passes through a Result.
#
# EOF is a distinct error rather than an empty Ok. `Ok("")`-means-EOF was an in-band sentinel of
# exactly the kind this whole change removes, and it read as "nothing yet" at the call sites that
# most needed to distinguish the two.
#
# Exported, unlike its write-side twin, because it is now the ONLY read on the raw-handle path. That
# path cannot be retired yet: a task force-dropped by `scope_cancel` or `with_timeout` never runs its
# linear `close`, so the fixtures that deliberately park a connection and have it dropped
# (tests/task_io_smoke/cancel_io_drop.spr and friends) cannot hold a TcpConnection at all. Deleting
# tcp_read without exporting this would have left the family able to accept and write but not read —
# half-usable, which is worse than either keeping it whole or retiring it outright. See BACKLOG.
export extern fn tcp_read_some(conn: Int, max_bytes: Int) -> Result TcpError Bytes !{IO}

extern fn tcp_read_exact(conn: Int, count: Int) -> Result TcpError Bytes !{IO}
extern fn tcp_write_all(conn: Int, data: Bytes) -> Result TcpError Int !{IO}
# Idle-bounded write: no single stall may exceed `idle_ms`, and any byte the kernel accepts re-arms
# the bound. These are nginx's send_timeout semantics — "the timeout is set only between two
# successive write operations, not for the transmission of the whole response" — so a slow but
# reading client is never cut off, while one that stops reading entirely is. `idle_ms <= 0` attempts
# the write once without parking, the convention every non-parking primitive here shares.
extern fn tcp_write_all_timeout(conn: Int, data: Bytes, idle_ms: Int) -> Result TcpError Int !{IO}
export extern fn tcp_close(conn: Int) -> Unit !{IO}
export extern fn tcp_close_listener(listener: Int) -> Unit !{IO}

export type TcpError (..) =
  | TcpInvalidArgument String
  | TcpInvalidHandle
  | TcpConnectFailed String
  | TcpReadFailed String
  | TcpWriteFailed String
  | TcpEndOfStream
  # A deadline-bounded read or write ran out of time. Distinct from TcpReadFailed/TcpWriteFailed
  # because it is not a fault: the connection is still valid, so the caller may retry with a fresh
  # budget or run its normal close path.
  | TcpTimeout
  # The kernel accepted no bytes right now. Also not a fault, and distinct from TcpTimeout: nothing
  # has expired, the caller simply has to wait for readiness before retrying. Reported only by the
  # non-parking transfer primitives, whose whole purpose is to hand that decision back to Sprout.
  | TcpWouldBlock
  # The accept itself failed for a reason that is neither transient nor a resource limit — a closed or
  # broken listener, or a bug (EBADF/EINVAL/ENOTSOCK). Retrying will not help, so a server should stop
  # rather than spin.
  #
  # There is deliberately no `TcpAcceptExhausted` beside this. Descriptor exhaustion and a full handle
  # table are handled inside `tcp_accept`, which parks on the listener and retries, because that is the
  # only layer that CAN wait for them: the wait must be on the listener fd, and Sprout has no primitive
  # that registers one — `tcp_wait` takes a connection handle, and `task_sleep` needs the very
  # descriptor that is missing. A variant no producer can return would be worse than none.
  | TcpAcceptFailed String

# LINEAR (M4.5). A connection is acquire -> use N times -> release once: reads and
# writes `borrow` it, `close` consumes it. Linearity turns the release discipline
# from a convention into a compile error — omit `close` and the caller is rejected
# with a leak. This shape is only expressible because of borrowing; under strict
# M4.2 consume-exactly-once the first `write_all` would consume the connection and
# every later use would be a reuse. See docs/linear-borrowing-v0.md.
export type linear TcpConnection =
  | TcpConnection Int

export type linear TcpListener =
  | TcpListener Int

export fn tcp_error_message(err: TcpError) -> String =
  match err with
  | TcpInvalidArgument msg -> msg
  | TcpInvalidHandle -> "invalid handle"
  | TcpConnectFailed msg -> msg
  | TcpReadFailed msg -> msg
  | TcpWriteFailed msg -> msg
  | TcpEndOfStream -> "end of stream"
  | TcpTimeout -> "timed out"
  | TcpWouldBlock -> "would block"
  | TcpAcceptFailed msg -> msg

# Reads the handle out without taking the connection: `match` on a borrowed
# binding is a read, not a consume, so this composes into every borrowing op below.
fn tcp_connection_handle(conn: borrowing TcpConnection) -> Int =
  match conn with
  | TcpConnection handle -> handle

fn tcp_listener_handle(listener: borrowing TcpListener) -> Int =
  match listener with
  | TcpListener handle -> handle

# Cost is dominated by the underlying network connect attempt. A connect that cannot complete at
# once PARKS the calling task rather than blocking the scheduler, so siblings keep running and a
# `with_timeout` around it works — a stalled peer costs this task, not the process.
export fn connect(host: String, port: Int) -> Result TcpError TcpConnection !{IO} =
  do
    handle <- tcp_connect(host, port)
    Ok(TcpConnection(handle))

# O(count) once bytes arrive: fills a fresh buffer of the requested size.
export fn read_exact(conn: borrowing TcpConnection, count: Int) -> Result TcpError Bytes !{IO} =
  tcp_read_exact(tcp_connection_handle(conn), count)

# O(|payload|): writes the full payload, retrying partial sends as needed.
export fn write_all(conn: borrowing TcpConnection, payload: Bytes) -> Result TcpError Int !{IO} =
  tcp_write_all(tcp_connection_handle(conn), payload)

# `write_all` with an idle bound: `Err TcpTimeout` once a single stall exceeds `idle_ms`, with the
# connection still valid so the caller closes it normally. Any accepted byte re-arms the bound, so
# this bounds a peer that STOPPED reading without penalising one that reads slowly. A server needs it
# for the same reason it needs a read deadline: an unbounded write parks the handler forever and its
# connection handle is never returned to the table. See stdlib.http_server.
export fn write_all_timeout(conn: borrowing TcpConnection, payload: Bytes, idle_ms: Int) -> Result TcpError Int !{IO} =
  tcp_write_all_timeout(tcp_connection_handle(conn), payload, idle_ms)

# `write_all` bounded by an ABSOLUTE deadline (monotonic microseconds, as from time_now_micros).
#
# This is the shape `write_all_timeout` cannot have. Its bound is idle and re-armed inside C on every
# accepted byte, so a peer taking one byte per interval holds the call forever and no deadline
# computed here can intervene — the caller never regains control mid-payload. Written as a Sprout
# loop over the non-parking `tcp_write_some` plus `tcp_wait`, the deadline is checked on every
# iteration, so the TOTAL is bounded no matter how the peer paces its reads.
#
# "Attempt the transfer, then wait" is the only shape this loop can take, because tcp_write_some
# never parks: the ordering that a hand-written C retry loop keeps getting wrong is structural here.
# `offset` advances instead of the payload being re-sliced, so an n-byte write stays O(n).
# Mirrors SPROUT_POLL_WRITE in runtime/sprout_scheduler.h.
let poll_write = 2

fn write_all_by_wait(handle: Int, payload: Bytes, deadline_us: Int, offset: Int, total: Int) -> Result TcpError Int !{IO} =
  do
    now <- time.now_micros()
    # A `remaining <= 0` makes tcp_wait answer "not ready" without parking, so an already-spent
    # budget needs no special case here.
    ready <- tcp_wait(handle, poll_write, (deadline_us - now) / 1000)
    if ready == 1 then write_all_by_go(handle, payload, deadline_us, offset, total)
    else Err(TcpTimeout)

fn write_all_by_go(handle: Int, payload: Bytes, deadline_us: Int, offset: Int, total: Int) -> Result TcpError Int !{IO} =
  if offset >= total then Ok(total)
  else
    match tcp_write_some(handle, payload, offset) with
    | Ok sent ->
        if sent <= 0 then Ok(total)
        else write_all_by_go(handle, payload, deadline_us, offset + sent, total)
    | Err TcpWouldBlock -> write_all_by_wait(handle, payload, deadline_us, offset, total)
    | Err err -> Err(err)

export fn write_all_by(conn: borrowing TcpConnection, payload: Bytes, deadline_us: Int) -> Result TcpError Int !{IO} =
  write_all_by_go(tcp_connection_handle(conn), payload, deadline_us, 0, length(payload))

export fn write_all_utf8_by(conn: borrowing TcpConnection, payload: String, deadline_us: Int) -> Result TcpError Int !{IO} =
  write_all_by(conn, from_string(payload), deadline_us)

# Recoverable string write over a raw connection handle, for callers holding an Int rather than the
# opaque TcpConnection. Returns Err on a socket failure instead of aborting, where the raw `tcp_write`
# is fatal — so it is the write-side partner of the exported `tcp_read_some`.
#
# It has NO caller in-tree since stdlib.http_server moved to the linear API (M4.4a); it names no
# consumer here for that reason. Its stated retirement condition — go when the raw tcp_* externs go,
# not before, so the raw-handle path stays complete rather than half-usable — still holds, and that
# condition is now pinned to something concrete: the family survives because a force-dropped task
# cannot run a linear `close`. See the note on tcp_read_some.
#
# `from_string` cannot lose data here: a String is valid UTF-8 and NUL-free by construction
# (docs/spec-v0.md:64), so the byte encoding is total in this direction. It is the other direction —
# bytes to String — that needs a Result, which is why the read returns Bytes.
export fn tcp_write_string(conn: Int, data: String) -> Result TcpError Int !{IO} =
  tcp_write_all(conn, from_string(data))

# Mirrors SPROUT_POLL_READ in runtime/sprout_scheduler.h.
let poll_read = 1

# One recv's worth. tcp_read_some clamps to the same figure, so asking for more cannot return more;
# naming it here keeps the request honest about what a single round can deliver.
let read_chunk = 65536

# `read_avail_timeout`'s loop, and the read-side mirror of write_all_by_go/write_all_by_wait.
#
# "Attempt the transfer, then wait" is the only shape it can take, because tcp_read_some never parks.
# That ordering is not a style choice: it guarantees a timeout can never be reported while data is
# already sitting in the socket buffer, since every path to `Err TcpTimeout` has performed a recv
# first. The three deleted C loops each had to get that right independently, and Go's SetReadDeadline
# makes the same guarantee for the same reason.
fn read_avail_go(handle: Int, deadline_us: Int) -> Result TcpError Bytes !{IO} =
  match tcp_read_some(handle, read_chunk) with
  | Ok chunk -> Ok(chunk)
  | Err TcpWouldBlock -> read_avail_wait(handle, deadline_us)
  | Err err -> Err(err)

fn read_avail_wait(handle: Int, deadline_us: Int) -> Result TcpError Bytes !{IO} =
  do
    now <- time.now_micros()
    # A non-positive remainder makes tcp_wait answer "not ready" without parking, so a spent budget
    # needs no special case — and the recv above has already run, so buffered data still wins.
    ready <- tcp_wait(handle, poll_read, (deadline_us - now) / 1000)
    if ready == 1 then read_avail_go(handle, deadline_us)
    else Err(TcpTimeout)

# Read whatever has arrived, bounded by `timeout_ms`, without taking the connection.
#
# The unknown-length counterpart to read_exact: an HTTP header block ends at a delimiter, not at a
# byte count, so a server cannot ask for an exact size. Returns BYTES — a socket carries bytes, and a
# String may not hold an arbitrary one (docs/spec-v0.md:64), so decoding is the caller's decision and
# goes through `bytes.to_string`, which returns a Result. `Err TcpEndOfStream` on a clean peer close,
# `Err TcpTimeout` when the budget runs out with the connection still valid, and `Err TcpReadFailed`
# on a socket fault — so one client's reset drops one connection rather than aborting the process.
#
# `timeout_ms <= 0` polls once without waiting, which is what makes a caller-side TOTAL budget
# composable: pass the remaining slice and an expired budget needs no special case. A total bound is
# the one that matters, because a peer dribbling one byte per interval renews a per-read timer forever
# — see stdlib.http_server, which owns that policy now that it is expressible in Sprout.
#
# The bound is enforced by the Sprout loop above, not inside C. Note what that does NOT give you: the
# deadline is only consulted when the socket would block, so a peer that keeps the socket continuously
# readable never reaches it. A caller enforcing a phase budget across many reads must check the clock
# in its own loop as well; http_server does.
export fn read_avail_timeout(conn: borrowing TcpConnection, timeout_ms: Int) -> Result TcpError Bytes !{IO} =
  do
    now <- time.now_micros()
    read_avail_go(tcp_connection_handle(conn), now + timeout_ms * 1000)

# `read_exact` bounded by an ABSOLUTE deadline, the read-side twin of write_all_by. A deadline
# parameter rather than `with_timeout` around the call, which cannot wrap a read: that would capture
# a connection the caller already owns, and higher-order linearity does not allow it yet.
#
# Each recv asks for exactly the shortfall, never read_chunk. Over-reading would swallow bytes
# belonging to the NEXT message, and a length-prefixed protocol is the whole reason this exists.
#
# ATTEMPT, THEN WAIT — one recv always precedes any clock read, so `Err TcpTimeout` is never reported
# over bytes that were already buffered. Do not reorder without verifying all three bodies:
#   _go   recvs, builds the result and reports a socket error. Reads no clock at all.
#   _step reads the clock AFTER progress, and must stay after the recv that produced that progress.
#   _wait reads the clock when nothing arrived, and is the only body that parks.
# It is NOT a promise the buffer is empty: bytes landing after _wait times out are missed, which is
# what a deadline means. read_avail_go holds the same invariant across its own pair.
#
# `Err TcpTimeout` DISCARDS the bytes already taken and leaves the stream mid-message, so the caller
# must close rather than reuse; a peer closing before `count` arrives is `Err TcpEndOfStream`.
#
# O(count) in bytes, plus O(k log k) pointer copies over the k chunks the peer sends — k is the
# peer's choice, not the caller's, so see merge_chunk_pairs for why it is not a left fold.
fn read_exact_by_go(handle: Int, count: Int, deadline_us: Int, acc: List Builder, have: Int) -> Result TcpError Bytes !{IO} =
  if have >= count then Ok(build_chunks(acc))
  else
    match tcp_read_some(handle, count - have) with
    # tcp_read_some never answers an empty Ok — recv's 0 is TcpEndOfStream, caught by the arm below —
    # but an empty chunk would leave `have` unmoved and spin at full CPU without ever parking, so it
    # waits instead. This is what declining to trust that promise costs.
    | Ok chunk ->
        if length(chunk) <= 0 then read_exact_by_wait(handle, count, deadline_us, acc, have)
        else read_exact_by_step(handle, count, deadline_us, Cons(builder_bytes(chunk), acc),
                                have + length(chunk))
    | Err TcpWouldBlock -> read_exact_by_wait(handle, count, deadline_us, acc, have)
    | Err err -> Err(err)

# The clock is consulted after PROGRESS too, not only on a would-block. A peer that keeps the socket
# continuously readable never reaches tcp_wait, and nothing preempts this loop — the scheduler is
# cooperative — so without this a large `count` from a fast peer overruns its budget and holds the
# worker for the whole transfer. read_avail_timeout documents that hole; this one closes it.
#
# A COMPLETE read is delivered even past the deadline: the bytes are in hand, and discarding them to
# report a timeout would drop data the peer sent inside the budget.
fn read_exact_by_step(handle: Int, count: Int, deadline_us: Int, acc: List Builder, have: Int) -> Result TcpError Bytes !{IO} =
  do
    now <- time.now_micros()
    if have >= count || now < deadline_us then read_exact_by_go(handle, count, deadline_us, acc, have)
    else Err(TcpTimeout)

fn read_exact_by_wait(handle: Int, count: Int, deadline_us: Int, acc: List Builder, have: Int) -> Result TcpError Bytes !{IO} =
  do
    now <- time.now_micros()
    # A non-positive remainder makes tcp_wait answer "not ready" without parking, and the recv
    # above has already run, so buffered data still beats a spent budget.
    ready <- tcp_wait(handle, poll_read, (deadline_us - now) / 1000)
    if ready == 1 then read_exact_by_go(handle, count, deadline_us, acc, have)
    else Err(TcpTimeout)

# builder_append copies BOTH operands' chunk arrays, so folding k of them left to right costs O(k^2)
# pointer copies. Merging adjacent PAIRS halves the list each pass instead: O(k log k) at depth
# log2(k). bigint's builder_of_mag halves for the same reason (docs/bigint-v0.md).
fn merge_chunk_pairs(parts: List Builder) -> List Builder =
  match parts with
  | [left, right | more] -> Cons(builder_append(left, right), merge_chunk_pairs(more))
  # Fewer than two left: nothing to pair, so the list passes through unchanged. An odd tail chunk
  # rides to the next pass rather than being dropped.
  | _ -> parts

fn merge_chunks(parts: List Builder) -> Builder =
  match parts with
  | [] -> builder_empty()
  | [only] -> only
  | _ -> merge_chunks(merge_chunk_pairs(parts))

# `parts` arrives in REVERSE order because the loop prepends — the O(1) step that keeps the loop off
# the quadratic shape. The O(k) reverse is paid once, here.
fn build_chunks(parts: List Builder) -> Bytes =
  builder_build(merge_chunks(list_reverse(parts)))

export fn read_exact_by(conn: borrowing TcpConnection, count: Int, deadline_us: Int) -> Result TcpError Bytes !{IO} =
  # A NEGATIVE count is refused, not silently satisfied: it means the caller's arithmetic went wrong —
  # an underflowing `content_length - already_read`, or a corrupt length prefix — and `Ok(empty)` would
  # let a length-prefixed reader take a desynchronised stream for a complete message. Same answer and
  # same message as the tcp_read_exact builtin, which guards the same way.
  if count < 0 then Err(TcpInvalidArgument("count must be >= 0"))
  else if count == 0 then Ok(empty())
  else read_exact_by_go(tcp_connection_handle(conn), count, deadline_us, [], 0)

# `read_exact_utf8` under read_exact_by's deadline. `count` is BYTES, as everywhere on a socket, so a
# multibyte character split across two arrivals is reassembled before anything decodes it — decoding
# per chunk would reject a partial sequence that is merely incomplete.
#
# A decode failure is `Err TcpReadFailed`, never `TcpTimeout`: the bytes arrived inside the budget and
# were not valid UTF-8, which is a different fault, and a caller retrying on a timeout must not retry
# on this one.
export fn read_exact_utf8_by(conn: borrowing TcpConnection, count: Int, deadline_us: Int) -> Result TcpError String !{IO} =
  do
    payload <- read_exact_by(conn, count, deadline_us)
    match to_string(payload) with
    | Ok text -> Ok(text)
    | Err utf8_err -> Err(TcpReadFailed(utf8_error_message(utf8_err)))

# O(count): reads bytes, then validates and copies the UTF-8 payload.
export fn read_exact_utf8(conn: borrowing TcpConnection, count: Int) -> Result TcpError String !{IO} =
  do
    payload <- read_exact(conn, count)
    match to_string(payload) with
    | Ok text -> Ok(text)
    | Err utf8_err -> Err(TcpReadFailed(utf8_error_message(utf8_err)))

# O(|payload|): UTF-8 encoding copy plus the full network write.
export fn write_all_utf8(conn: borrowing TcpConnection, payload: String) -> Result TcpError Int !{IO} =
  write_all(conn, from_string(payload))

# O(|payload|): `write_all_utf8` under `write_all_timeout`'s idle bound.
export fn write_all_utf8_timeout(conn: borrowing TcpConnection, payload: String, idle_ms: Int) -> Result TcpError Int !{IO} =
  write_all_timeout(conn, from_string(payload), idle_ms)

# The single consuming use. Every acquired connection must reach exactly one of
# these, on every control-flow path, or the program does not compile.
export fn close(conn: consuming TcpConnection) -> Unit !{IO} =
  match conn with
  | TcpConnection handle -> tcp_close(handle)

export fn listen_local(port: Int) -> TcpListener !{IO} =
  TcpListener(tcp_listen(port))

# Recoverable, unlike the shape this had before: a failed accept is an Err rather than an exit(1).
#
# There is deliberately NO deadline parameter. An accept loop wants to wait indefinitely for the next
# connection — that is its whole job — so the argument that made every read need a bound does not
# apply here. What it needs instead is to survive a failure, which is what the Result provides. The
# park on "no connection yet" stays inside the builtin for the same reason.
export fn accept(listener: borrowing TcpListener) -> Result TcpError TcpConnection !{IO} =
  do
    handle <- tcp_accept(tcp_listener_handle(listener))
    Ok(TcpConnection(handle))

export fn close_listener(listener: consuming TcpListener) -> Unit !{IO} =
  match listener with
  | TcpListener handle -> tcp_close_listener(handle)

type alias TcpResult a = Result TcpError a

fn utf8_error_message(err: Utf8Error) -> String =
  match err with
  | Utf8DecodeError msg -> msg
