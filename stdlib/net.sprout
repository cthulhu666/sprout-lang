module stdlib.net

import stdlib.bytes (Utf8Error, from_string, to_string)

export type TcpError(..) =
  | TcpInvalidArgument String
  | TcpInvalidHandle
  | TcpConnectFailed String
  | TcpReadFailed String
  | TcpWriteFailed String
  | TcpEndOfStream

export type TcpConnection =
  | TcpConnection Int

export type TcpListener =
  | TcpListener Int

export fn tcp_error_message(err: TcpError) -> String =
  match err with
  | TcpInvalidArgument msg -> msg
  | TcpInvalidHandle -> "invalid handle"
  | TcpConnectFailed msg -> msg
  | TcpReadFailed msg -> msg
  | TcpWriteFailed msg -> msg
  | TcpEndOfStream -> "end of stream"

fn tcp_connection_handle(conn: TcpConnection) -> Int =
  match conn with
  | TcpConnection handle -> handle

fn tcp_listener_handle(listener: TcpListener) -> Int =
  match listener with
  | TcpListener handle -> handle

export fn connect(host: String, port: Int) -> TcpResult TcpConnection !{IO} =
  do
    handle <- tcp_connect(host, port)
    Ok(TcpConnection(handle))

export fn read_exact(conn: TcpConnection, count: Int) -> TcpResult Bytes !{IO} =
  tcp_read_exact(tcp_connection_handle(conn), count)

export fn write_all(conn: TcpConnection, payload: Bytes) -> TcpResult Int !{IO} =
  tcp_write_all(tcp_connection_handle(conn), payload)

export fn read_exact_utf8(conn: TcpConnection, count: Int) -> TcpResult String !{IO} =
  do
    payload <- read_exact(conn, count)
    match to_string(payload) with
    | Ok text -> Ok(text)
    | Err utf8_err -> Err(TcpReadFailed(utf8_error_message(utf8_err)))

export fn write_all_utf8(conn: TcpConnection, payload: String) -> TcpResult Int !{IO} =
  write_all(conn, from_string(payload))

export fn close(conn: TcpConnection) -> Unit !{IO} =
  tcp_close(tcp_connection_handle(conn))

export fn listen_local(port: Int) -> TcpListener !{IO} =
  TcpListener(tcp_listen(port))

export fn accept(listener: TcpListener) -> TcpConnection !{IO} =
  TcpConnection(tcp_accept(tcp_listener_handle(listener)))

export fn close_listener(listener: TcpListener) -> Unit !{IO} =
  tcp_close_listener(tcp_listener_handle(listener))

type alias TcpResult a = Result TcpError a

fn utf8_error_message(err: Utf8Error) -> String =
  match err with
  | Utf8DecodeError msg -> msg
