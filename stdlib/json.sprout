module stdlib.json
import stdlib.string as string

export type JsonError (..) =
  | JsonDecode String

export type Json (..) =
  | JsonNull
  | JsonBool Bool
  | JsonInt Int
  | JsonFloat Double
  | JsonString String
  | JsonArray JsonArray
  | JsonObject JsonObject

export type JsonArray (..) =
  | JsonArrayCons Json JsonArray
  | JsonArrayNil

export type JsonObject (..) =
  | JsonObjectCons String Json JsonObject
  | JsonObjectNil

export type JsonArrayStep (..) =
  | JsonArrayStep Json JsonArray

export type JsonObjectStep (..) =
  | JsonObjectStep String Json JsonObject

export class JsonEncode a {
  fn encode_json(value: a) -> Json
}

export fn null() -> Json =
  JsonNull

export fn bool(value: Bool) -> Json =
  JsonBool(value)

export fn int(value: Int) -> Json =
  JsonInt(value)

export fn string(value: String) -> Json =
  JsonString(value)

extern fn json_stringify(value: Json) -> String

# ---- Pure-Sprout JSON parser (replaces the former C `json_parse` extern) ---------------------
# Byte-cursor recursive descent, O(n): a structural peek (str_starts_with_at_byte) and a token
# slice (str_slice_bytes) are both O(1)/O(len) at a byte OFFSET, so one left-to-right pass over
# the UTF-8 bytes is linear. A codepoint-index parser would be O(n^2) — char_at re-walks from the
# start each call (the trap that made string_lines grind). Each parser threads a byte cursor and
# returns Maybe (value, nextByte); Nothing means malformed, which the public parser maps to Err.
# Element loops (arrays/objects) recurse in tail position, so TCO keeps large inputs stack-safe;
# only nesting depth uses the stack.

# DISPATCH READS MUST NOT SLICE THE INPUT. `str_slice_bytes` calls `tcp_fail` — the process-fatal
# path — when a cut splits a UTF-8 codepoint, so the former `byte1(s, i) = str_slice_bytes(s, i, 1)`
# aborted the whole program whenever the cursor reached the LEAD byte of a multi-byte character:
# `json.parse("{\"a\":\"café\"}")` did not return `Err`, it killed the process. Reachable from the LSP
# server and from any HTTP server parsing a JSON body, i.e. an unauthenticated remote process kill.
#
# So every dispatch below is a byte COMPARISON at an offset (`str_starts_with_at_byte`), which reads
# in place and cannot abort. Verbose, but it is the idiom `is_ws_at` already used here, and it also
# removed an allocation per inspected byte — `byte1` built a GC-managed 1-byte String for every byte
# the scanner looked at and then searched a set for it, which `num_end` did once per byte of every
# numeric literal.
#
# `str_char_at` is not an option: it is codepoint-indexed and O(n) per call, which would make the
# parser quadratic — the trap this module's byte cursor exists to avoid.
#
# The remaining `str_slice_bytes` calls take TOKEN spans, not dispatch bytes, and every one is
# provably codepoint-aligned at both ends: a run stops at an ASCII delimiter or at end-of-input, and
# starts where the previous one stopped. Slicing an ASCII-delimited span is safe; probing an
# attacker-chosen offset was not.
fn at_end(s: String, i: Int) -> Bool = i >= str_byte_len(s)

fn is_ws_at(s: String, i: Int) -> Bool =
  str_starts_with_at_byte(s, i, " ") || str_starts_with_at_byte(s, i, "\t")
    || str_starts_with_at_byte(s, i, "\n") || str_starts_with_at_byte(s, i, "\r")

fn skip_ws(s: String, i: Int) -> Int =
  if is_ws_at(s, i) then skip_ws(s, i + 1) else i

fn is_digit_at(s: String, i: Int) -> Bool =
  str_starts_with_at_byte(s, i, "0") || str_starts_with_at_byte(s, i, "1")
    || str_starts_with_at_byte(s, i, "2") || str_starts_with_at_byte(s, i, "3")
    || str_starts_with_at_byte(s, i, "4") || str_starts_with_at_byte(s, i, "5")
    || str_starts_with_at_byte(s, i, "6") || str_starts_with_at_byte(s, i, "7")
    || str_starts_with_at_byte(s, i, "8") || str_starts_with_at_byte(s, i, "9")

# Digits first: they dominate a numeric literal, so the short-circuit usually stops early.
fn is_num_byte_at(s: String, i: Int) -> Bool =
  is_digit_at(s, i)
    || str_starts_with_at_byte(s, i, "-") || str_starts_with_at_byte(s, i, "+")
    || str_starts_with_at_byte(s, i, ".") || str_starts_with_at_byte(s, i, "e")
    || str_starts_with_at_byte(s, i, "E")

fn is_num_start(s: String, i: Int) -> Bool =
  str_starts_with_at_byte(s, i, "-") || is_digit_at(s, i)

# --- number ---------------------------------------------------------------------------------
# Consume the maximal run of number characters, then let parse_int/parse_double validate it: any
# structurally bad literal (e.g. "1.2.3", "1e") is rejected there. A '.'/'e'/'E' selects JsonFloat.
fn num_end(s: String, i: Int) -> Int =
  if is_num_byte_at(s, i) then num_end(s, i + 1) else i

fn p_number(s: String, i: Int) -> Maybe (Json, Int) =
  let j = num_end(s, i)
      tok = str_slice_bytes(s, i, j - i)
  in if str_len(tok) <= 0 then Nothing
     else if (str_find(tok, ".") >= 0) || (str_find(tok, "e") >= 0) || (str_find(tok, "E") >= 0)
          then match parse_double(tok) with
               | Nothing -> Nothing
               | Just x -> Just((JsonFloat(x), j))
          else match parse_int(tok) with
               | Nothing -> Nothing
               | Just n -> Just((JsonInt(n), j))

# --- string (with escapes, incl. \uXXXX and surrogate pairs) --------------------------------
# The value of the hex digit at byte `i`, or -1 if that byte is not a hex digit. A non-ASCII byte
# here means malformed input (a \u escape is always four ASCII hex digits), so it must yield -1 and
# a clean Nothing — which is precisely what the old `hexval(byte1(...))` could not do, because it
# aborted before it could judge the byte. The linear probe costs up to 22 comparisons, which is
# irrelevant: \u escapes are rare, and the hot path is plain_end.
fn hex_at(s: String, i: Int) -> Int =
  if str_starts_with_at_byte(s, i, "0") then 0
  else if str_starts_with_at_byte(s, i, "1") then 1
  else if str_starts_with_at_byte(s, i, "2") then 2
  else if str_starts_with_at_byte(s, i, "3") then 3
  else if str_starts_with_at_byte(s, i, "4") then 4
  else if str_starts_with_at_byte(s, i, "5") then 5
  else if str_starts_with_at_byte(s, i, "6") then 6
  else if str_starts_with_at_byte(s, i, "7") then 7
  else if str_starts_with_at_byte(s, i, "8") then 8
  else if str_starts_with_at_byte(s, i, "9") then 9
  else if str_starts_with_at_byte(s, i, "a") || str_starts_with_at_byte(s, i, "A") then 10
  else if str_starts_with_at_byte(s, i, "b") || str_starts_with_at_byte(s, i, "B") then 11
  else if str_starts_with_at_byte(s, i, "c") || str_starts_with_at_byte(s, i, "C") then 12
  else if str_starts_with_at_byte(s, i, "d") || str_starts_with_at_byte(s, i, "D") then 13
  else if str_starts_with_at_byte(s, i, "e") || str_starts_with_at_byte(s, i, "E") then 14
  else if str_starts_with_at_byte(s, i, "f") || str_starts_with_at_byte(s, i, "F") then 15
  else 0 - 1

fn hex4(s: String, i: Int) -> Int =
  let a = hex_at(s, i)
      b = hex_at(s, i + 1)
      c = hex_at(s, i + 2)
      d = hex_at(s, i + 3)
  in if (a < 0) || (b < 0) || (c < 0) || (d < 0) then 0 - 1
     else (a * 4096) + (b * 256) + (c * 16) + d

# End of a run of "plain" string bytes (stops at '"', '\', or end).
#
# This walks multi-byte characters ONE BYTE AT A TIME and that is correct, not a bug: a UTF-8
# continuation byte is never 0x22 or 0x5C, so no byte inside a multi-byte sequence can be mistaken
# for the closing quote or an escape. The run therefore ends on an ASCII delimiter or at end-of-input,
# which is what makes the caller's token slice codepoint-aligned and the character bytes pass through
# verbatim.
fn plain_end(s: String, i: Int) -> Int =
  if at_end(s, i) then i
  else if str_starts_with_at_byte(s, i, "\"") || str_starts_with_at_byte(s, i, "\\") then i
  else plain_end(s, i + 1)

fn p_unicode(s: String, i: Int, acc: String) -> Maybe (String, Int) =
  let cp = hex4(s, i)
  in if cp < 0 then Nothing
     else if (cp >= 55296) && (cp <= 56319) then
       if str_starts_with_at_byte(s, i + 4, "\\u") then
         let lo = hex4(s, i + 6)
         in if (lo >= 56320) && (lo <= 57343)
            then p_string_run(s, i + 10, str_concat(acc, char_to_str(65536 + ((cp - 55296) * 1024) + (lo - 56320))))
            else Nothing
       else Nothing
     else if (cp >= 56320) && (cp <= 57343) then Nothing
     else p_string_run(s, i + 4, str_concat(acc, char_to_str(cp)))

fn p_escape(s: String, i: Int, acc: String) -> Maybe (String, Int) =
  if str_starts_with_at_byte(s, i, "\"") then p_string_run(s, i + 1, str_concat(acc, "\""))
  else if str_starts_with_at_byte(s, i, "\\") then p_string_run(s, i + 1, str_concat(acc, "\\"))
  else if str_starts_with_at_byte(s, i, "/") then p_string_run(s, i + 1, str_concat(acc, "/"))
  else if str_starts_with_at_byte(s, i, "n") then p_string_run(s, i + 1, str_concat(acc, "\n"))
  else if str_starts_with_at_byte(s, i, "t") then p_string_run(s, i + 1, str_concat(acc, "\t"))
  else if str_starts_with_at_byte(s, i, "r") then p_string_run(s, i + 1, str_concat(acc, "\r"))
  else if str_starts_with_at_byte(s, i, "b") then p_string_run(s, i + 1, str_concat(acc, char_to_str(8)))
  else if str_starts_with_at_byte(s, i, "f") then p_string_run(s, i + 1, str_concat(acc, char_to_str(12)))
  else if str_starts_with_at_byte(s, i, "u") then p_unicode(s, i + 1, acc)
  else Nothing

# i points into the string body (after the opening quote). Returns (decoded, indexAfterCloseQuote).
fn p_string_run(s: String, i: Int, acc: String) -> Maybe (String, Int) =
  if at_end(s, i) then Nothing
  else if str_starts_with_at_byte(s, i, "\"") then Just((acc, i + 1))
  else if str_starts_with_at_byte(s, i, "\\") then p_escape(s, i + 1, acc)
  else
    let j = plain_end(s, i)
    in p_string_run(s, j, str_concat(acc, str_slice_bytes(s, i, j - i)))

# i at the opening quote.
fn p_string(s: String, i: Int) -> Maybe (String, Int) = p_string_run(s, i + 1, "")

# --- array ----------------------------------------------------------------------------------
fn p_array_items(s: String, i: Int, acc: List Json) -> Maybe (Json, Int) =
  match p_value(s, i) with
  | Nothing -> Nothing
  | Just (v, j) ->
      let k = skip_ws(s, j)
      in if str_starts_with_at_byte(s, k, "]")
         then Just((JsonArray(json_array_from_list(list_reverse(Cons(v, acc)))), k + 1))
         else if str_starts_with_at_byte(s, k, ",") then p_array_items(s, skip_ws(s, k + 1), Cons(v, acc))
         else Nothing

fn p_array(s: String, i: Int) -> Maybe (Json, Int) =
  let j = skip_ws(s, i + 1)
  in if str_starts_with_at_byte(s, j, "]")
     then Just((JsonArray (JsonArrayNil), j + 1))
     else p_array_items(s, j, Nil)

# --- object ---------------------------------------------------------------------------------
# Build a JsonObject from already-Json pairs (no JsonEncode constraint, unlike json_object_from_pairs).
fn json_object_from_json_pairs(items: List (String, Json)) -> JsonObject =
  match items with
  | Nil -> JsonObjectNil
  | Cons pair rest ->
      match pair with
      | (key, value) -> JsonObjectCons(key, value, json_object_from_json_pairs(rest))

fn p_object_members(s: String, i: Int, acc: List (String, Json)) -> Maybe (Json, Int) =
  if str_starts_with_at_byte(s, i, "\"") then
    match p_string(s, i) with
    | Nothing -> Nothing
    | Just (key, j) ->
        let k = skip_ws(s, j)
        in if str_starts_with_at_byte(s, k, ":") then
             match p_value(s, k + 1) with
             | Nothing -> Nothing
             | Just (v, m) ->
                 let n = skip_ws(s, m)
                 in if str_starts_with_at_byte(s, n, "}")
                    then Just((JsonObject(json_object_from_json_pairs(list_reverse(Cons((key, v), acc)))), n + 1))
                    else if str_starts_with_at_byte(s, n, ",") then p_object_members(s, skip_ws(s, n + 1), Cons((key, v), acc))
                    else Nothing
           else Nothing
  else Nothing

fn p_object(s: String, i: Int) -> Maybe (Json, Int) =
  let j = skip_ws(s, i + 1)
  in if str_starts_with_at_byte(s, j, "}")
     then Just((JsonObject (JsonObjectNil), j + 1))
     else p_object_members(s, j, Nil)

# --- value dispatch ---------------------------------------------------------------------------
fn p_value(s: String, i0: Int) -> Maybe (Json, Int) =
  let i = skip_ws(s, i0)
  in if str_starts_with_at_byte(s, i, "\"") then
       match p_string(s, i) with
       | Nothing -> Nothing
       | Just (str, j) -> Just((JsonString(str), j))
     else if str_starts_with_at_byte(s, i, "{") then p_object(s, i)
     else if str_starts_with_at_byte(s, i, "[") then p_array(s, i)
     else if str_starts_with_at_byte(s, i, "true") then Just((JsonBool(true), i + 4))
     else if str_starts_with_at_byte(s, i, "false") then Just((JsonBool(false), i + 5))
     else if str_starts_with_at_byte(s, i, "null") then Just((JsonNull, i + 4))
     else if is_num_start(s, i) then p_number(s, i)
     else Nothing

# Parse a complete JSON document. Trailing non-whitespace after the top-level value is an error.
export fn json_parse(raw: String) -> Result JsonError Json =
  match p_value(raw, 0) with
  | Nothing -> Err(JsonDecode("invalid JSON"))
  | Just (v, j) ->
      if skip_ws(raw, j) >= str_byte_len(raw) then Ok(v)
      else Err(JsonDecode("trailing characters after JSON value"))

export fn encode(value: a) -> Json where JsonEncode a =
  encode_json(value)

# O(|raw|): parsing scales with the JSON input size.
export fn parse(raw: String) -> Result JsonError Json =
  json_parse(raw)

# O(size of JSON tree): walks the whole value and builds a fresh string.
export fn stringify(value: Json) -> String =
  json_stringify(value)

fn json_array_from_list(items: List Json) -> JsonArray =
  match items with
  | Nil -> JsonArrayNil
  | Cons item rest -> JsonArrayCons(item, json_array_from_list(rest))

# O(n): builds a linked JsonArray by traversing the source list once.
export fn array_from_list(items: List Json) -> Json =
  JsonArray(json_array_from_list(items))

fn json_object_from_pairs(items: List (String, a)) -> JsonObject where JsonEncode a =
  match items with
  | Nil -> JsonObjectNil
  | Cons pair rest ->
      match pair with
      | (key, value) -> JsonObjectCons(key, encode(value), json_object_from_pairs(rest))

# O(n): traverses the input list once and encodes each value once.
export fn object_from_pairs(items: List (String, a)) -> Json where JsonEncode a =
  JsonObject(json_object_from_pairs(items))

fn json_object_from_dict_entries(entries: Vec (String, a), index: Int, total: Int, obj: JsonObject) -> JsonObject where JsonEncode a =
  if index >= total then obj
  else
    match vec_get(index, entries) with
    | Nothing -> obj
    | Just (key, value) ->
        json_object_from_dict_entries(entries, index + 1, total, JsonObjectCons(key, encode(value), obj))

# O(n^2): `dict_entries` itself is quadratic on persistent vectors, then this pass walks the entries again.
export fn object_from_dict(items: Dict a) -> Json where JsonEncode a =
  JsonObject(json_object_from_dict_entries(dict_entries(items), 0, vec_length(dict_entries(items)), JsonObjectNil))

instance JsonEncode Json {
  fn encode_json(value: Json) -> Json =
    value
}

instance JsonEncode Int {
  fn encode_json(value: Int) -> Json =
    int(value)
}

instance JsonEncode Bool {
  fn encode_json(value: Bool) -> Json =
    bool(value)
}

instance JsonEncode String {
  fn encode_json(value: String) -> Json =
    string(value)
}

fn json_object_find(obj: JsonObject, key: String) -> Maybe Json =
  match obj with
  | JsonObjectNil -> Nothing
  | JsonObjectCons k v rest ->
      if k == key then Just(v) else json_object_find(rest, key)

# O(n): linear scan through object fields.
export fn json_get_field(value: Json, key: String) -> Maybe Json =
  match value with
  | JsonObject obj -> json_object_find(obj, key)
  | _ -> Nothing

export fn json_get_string(value: Json) -> Maybe String =
  match value with
  | JsonString s -> Just(s)
  | _ -> Nothing

export fn json_get_int(value: Json) -> Maybe Int =
  match value with
  | JsonInt n -> Just(n)
  | _ -> Nothing

export fn json_get_bool(value: Json) -> Maybe Bool =
  match value with
  | JsonBool b -> Just(b)
  | _ -> Nothing

# A number as a Double, accepting either a float OR an integer literal (integers still parse to
# JsonInt, so callers wanting a Double from any JSON number use this rather than json_get_int).
export fn json_get_float(value: Json) -> Maybe Double =
  match value with
  | JsonFloat x -> Just(x)
  | JsonInt n -> Just(to_double(n))
  | _ -> Nothing

export fn json_get_array(value: Json) -> Maybe JsonArray =
  match value with
  | JsonArray arr -> Just(arr)
  | _ -> Nothing

export fn json_array_next(arr: JsonArray) -> Maybe JsonArrayStep =
  match arr with
  | JsonArrayNil -> Nothing
  | JsonArrayCons head tail -> Just(JsonArrayStep(head, tail))

export fn json_get_object(value: Json) -> Maybe JsonObject =
  match value with
  | JsonObject obj -> Just(obj)
  | _ -> Nothing

export fn json_object_next(obj: JsonObject) -> Maybe JsonObjectStep =
  match obj with
  | JsonObjectNil -> Nothing
  | JsonObjectCons key value rest -> Just(JsonObjectStep(key, value, rest))
