module stdlib.json

export type JsonError(..) =
  | JsonDecode String

export type Json(..) =
  | JsonNull
  | JsonBool Bool
  | JsonInt Int
  | JsonString String
  | JsonArray JsonArray
  | JsonObject JsonObject

export type JsonArray(..) =
  | JsonArrayCons Json JsonArray
  | JsonArrayNil

export type JsonObject(..) =
  | JsonObjectCons String Json JsonObject
  | JsonObjectNil

export type JsonArrayStep(..) =
  | JsonArrayStep Json JsonArray

export type JsonObjectStep(..) =
  | JsonObjectStep String Json JsonObject

export fn null() -> Json =
  JsonNull

export fn bool(value: Bool) -> Json =
  JsonBool(value)

export fn int(value: Int) -> Json =
  JsonInt(value)

export fn string(value: String) -> Json =
  JsonString(value)

export fn parse(raw: String) -> Result JsonError Json =
  json_parse(raw)

export fn stringify(value: Json) -> String =
  json_stringify(value)

fn json_array_from_list(items: List Json) -> JsonArray =
  match items with
  | Nil -> JsonArrayNil
  | Cons item rest -> JsonArrayCons(item, json_array_from_list(rest))

export fn array_from_list(items: List Json) -> Json =
  JsonArray(json_array_from_list(items))

fn json_object_from_pairs(items: List (String, Json)) -> JsonObject =
  match items with
  | Nil -> JsonObjectNil
  | Cons pair rest ->
      match pair with
      | (key, value) -> JsonObjectCons(key, value, json_object_from_pairs(rest))

export fn object_from_pairs(items: List (String, Json)) -> Json =
  JsonObject(json_object_from_pairs(items))

fn json_object_find(obj: JsonObject, key: String) -> Maybe Json =
  match obj with
  | JsonObjectNil -> Nothing
  | JsonObjectCons k v rest ->
      if k == key then Just(v) else json_object_find(rest, key)

export fn json_get_field(value: Json, key: String) -> Maybe Json =
  match value with
  | JsonObject obj -> json_object_find(obj, key)
  | _ -> Nothing

export fn json_get_string(value: Json) -> Maybe String =
  match value with
  | JsonString s -> Just(s)
  | _ -> Nothing

export fn json_get_int(value: Json) -> Maybe Int =
  match value with
  | JsonInt n -> Just(n)
  | _ -> Nothing

export fn json_get_array(value: Json) -> Maybe JsonArray =
  match value with
  | JsonArray arr -> Just(arr)
  | _ -> Nothing

export fn json_array_next(arr: JsonArray) -> Maybe JsonArrayStep =
  match arr with
  | JsonArrayNil -> Nothing
  | JsonArrayCons head tail -> Just(JsonArrayStep(head, tail))

export fn json_get_object(value: Json) -> Maybe JsonObject =
  match value with
  | JsonObject obj -> Just(obj)
  | _ -> Nothing

export fn json_object_next(obj: JsonObject) -> Maybe JsonObjectStep =
  match obj with
  | JsonObjectNil -> Nothing
  | JsonObjectCons key value rest -> Just(JsonObjectStep(key, value, rest))
