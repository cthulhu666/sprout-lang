module stdlib.compiler
import stdlib.string as string

export type CompilerSession (..) =
  | CompilerSession (Vec String) (Vec String)

export type SymbolInventory (..) =
  | SymbolInventory (Vec String) (Vec String) (Vec String)

export type ReportEntry (..) =
  | ReportEntry String Int Int

export type InstanceMatches (..) =
  | InstanceMatches String (Vec String)

type ReportPayload =
  | ReportPayload (Vec ReportEntry) (SymbolInventory)

export type CompilerReport (..) =
  | CompilerReport Bool (Maybe String) (ReportPayload)

export fn empty_session() -> CompilerSession =
  CompilerSession(vec_empty(), vec_empty())

export fn session_imports(session: CompilerSession) -> Vec String =
  match session with
  | CompilerSession imports _ -> imports

export fn session_declarations(session: CompilerSession) -> Vec String =
  match session with
  | CompilerSession _ declarations -> declarations

export fn with_import(line: String, session: CompilerSession) -> CompilerSession =
  match session with
  | CompilerSession imports declarations -> CompilerSession(vec_append(line, imports), declarations)

export fn with_declaration(line: String, session: CompilerSession) -> CompilerSession =
  match session with
  | CompilerSession imports declarations -> CompilerSession(imports, vec_append(line, declarations))

fn append_nonempty_chunk(chunk: String, chunks: Vec String) -> Vec String =
  if string.is_empty(chunk) then chunks else vec_append(chunk, chunks)

export fn session_source(session: CompilerSession) -> String =
  match session with
  | CompilerSession imports declarations ->
      string.join(
        "\n\n",
        append_nonempty_chunk(
          string.join("\n\n", declarations),
          append_nonempty_chunk(
            string.join("\n\n", imports),
            vec_append("module app.session", vec_empty())
          )
        )
      )

export fn check(session: CompilerSession) -> Result String Unit !{IO} =
  analysis_check_source(session_source(session))

export fn check_source(module_source: String) -> Result String Unit !{IO} =
  analysis_check_source(module_source)

fn empty_inventory() -> SymbolInventory =
  SymbolInventory(vec_empty(), vec_empty(), vec_empty())

export fn declared_names(session: CompilerSession) -> Result String (Vec String) !{IO} =
  analysis_declared_names_in_source(session_source(session))

export fn declared_names_in_source(module_source: String) -> Result String (Vec String) !{IO} =
  analysis_declared_names_in_source(module_source)

export fn exported_names(session: CompilerSession) -> Result String (Vec String) !{IO} =
  analysis_exported_names_in_source(session_source(session))

export fn exported_names_in_source(module_source: String) -> Result String (Vec String) !{IO} =
  analysis_exported_names_in_source(module_source)

export fn type_of(session: CompilerSession, expr: String) -> Result String String !{IO} =
  analysis_type_of_in_source(session_source(session), expr)

export fn type_of_in_source(module_source: String, expr: String) -> Result String String !{IO} =
  analysis_type_of_in_source(module_source, expr)

fn compiler_eval_lines_in_source(module_source: String, expr: String) -> Result String (Vec String) !{IO} =
  analysis_eval_expr_in_source(module_source, expr)

export fn eval_lines(session: CompilerSession, expr: String) -> Result String (Vec String) !{IO} =
  compiler_eval_lines_in_source(session_source(session), expr)

export fn eval_lines_in_source(module_source: String, expr: String) -> Result String (Vec String) !{IO} =
  compiler_eval_lines_in_source(module_source, expr)

export fn instances(session: CompilerSession, query: String) -> Result String InstanceMatches !{IO} =
  match analysis_instances_in_source(session_source(session), query) with
  | Err message -> Err(message)
  | Ok payload -> Ok(instance_matches_from_pair(payload))

export fn instances_in_source(module_source: String, query: String) -> Result String InstanceMatches !{IO} =
  match analysis_instances_in_source(module_source, query) with
  | Err message -> Err(message)
  | Ok payload -> Ok(instance_matches_from_pair(payload))

fn instance_matches_from_pair(payload: (String, Vec String)) -> InstanceMatches =
  match payload with
  | (query_type, matches) -> InstanceMatches(query_type, matches)

export fn instance_query_type(value: InstanceMatches) -> String =
  match value with
  | InstanceMatches query_type _ -> query_type

export fn instance_match_names(value: InstanceMatches) -> Vec String =
  match value with
  | InstanceMatches _ matches -> matches

export fn symbol_inventory(session: CompilerSession) -> Result String SymbolInventory !{IO} =
  match analysis_symbol_inventory_in_source(session_source(session)) with
  | Err message -> Err(message)
  | Ok payload -> Ok(symbol_inventory_from_tuple(payload))

export fn symbol_inventory_in_source(module_source: String) -> Result String SymbolInventory !{IO} =
  match analysis_symbol_inventory_in_source(module_source) with
  | Err message -> Err(message)
  | Ok payload -> Ok(symbol_inventory_from_tuple(payload))

fn symbol_inventory_from_tuple(payload: (Vec String, Vec String, Vec String)) -> SymbolInventory =
  match payload with
  | (declared, imported, exported) -> SymbolInventory(declared, imported, exported)

fn map_diagnostics(lines: Vec (String, Int, Int), index: Int, acc: Vec ReportEntry) -> Vec ReportEntry =
  match vec_get(index, lines) with
  | Just value -> map_diagnostics(lines, index + 1, vec_append(diagnostic_from_tuple(value), acc))
  | Nothing -> acc

fn diagnostic_from_tuple(value: (String, Int, Int)) -> ReportEntry =
  match value with
  | (message, line, column) -> ReportEntry(message, line, column)

export fn diagnostics(session: CompilerSession) -> Vec ReportEntry !{IO} =
  map_diagnostics(analysis_diagnostics_in_source(session_source(session)), 0, vec_empty())

export fn diagnostics_in_source(module_source: String) -> Vec ReportEntry !{IO} =
  map_diagnostics(analysis_diagnostics_in_source(module_source), 0, vec_empty())

export fn symbol_locations_in_source(module_source: String) -> Result String (Vec (String, String, Int, Int)) !{IO} =
  analysis_symbol_locations_in_source(module_source)

fn compiler_complete_in_state(line_buffer: String, imports: Vec String, declarations: Vec String) -> (String, Vec String) !{IO} =
  analysis_complete_in_state(line_buffer, imports, declarations)

export fn complete(session: CompilerSession, line_buffer: String) -> (String, Vec String) !{IO} =
  compiler_complete_in_state(line_buffer, session_imports(session), session_declarations(session))

export fn complete_in_state(line_buffer: String, imports: Vec String, declarations: Vec String) -> (String, Vec String) !{IO} =
  compiler_complete_in_state(line_buffer, imports, declarations)

fn inventory_or_empty(session: CompilerSession) -> SymbolInventory !{IO} =
  match symbol_inventory(session) with
  | Ok inventory -> inventory
  | Err _ -> empty_inventory()

fn build_report(ok: Bool, message: Maybe String, session: CompilerSession) -> CompilerReport !{IO} =
  CompilerReport(ok, message, ReportPayload(diagnostics(session), inventory_or_empty(session)))

export fn analyze(session: CompilerSession) -> CompilerReport !{IO} =
  match check(session) with
  | Ok _ -> build_report(true, Nothing, session)
  | Err message -> build_report(false, Just(message), session)

export fn report_is_ok(report: CompilerReport) -> Bool =
  match report with
  | CompilerReport ok _ _ -> ok

export fn report_error_message(report: CompilerReport) -> Maybe String =
  match report with
  | CompilerReport _ message _ -> message

export fn report_diagnostics(report: CompilerReport) -> Vec ReportEntry =
  match report with
  | CompilerReport _ _ payload -> payload_diagnostics(payload)

export fn report_symbol_inventory(report: CompilerReport) -> SymbolInventory =
  match report with
  | CompilerReport _ _ payload -> payload_inventory(payload)

fn payload_diagnostics(payload: ReportPayload) -> Vec ReportEntry =
  match payload with
  | ReportPayload items inventory -> items

fn payload_inventory(payload: ReportPayload) -> SymbolInventory =
  match payload with
  | ReportPayload items inventory -> inventory

export fn diagnostic_message(value: ReportEntry) -> String =
  match value with
  | ReportEntry message _ _ -> message

# ---------------------------------------------------------------------------
# StatefulSession — server-side session state (M2)
#
# Carries the server-assigned Int session ID plus local mirrors of imports
# and declarations.  The mirrors are kept in sync by session_import /
# session_declare (updated only when the server returns Ok) and are used
# by the REPL's tab-completion system, which needs the raw lists locally
# without an extra round-trip.

export type StatefulSession (..) = StatefulSession Int (Vec String) (Vec String)
  # session_id, local_imports_mirror, local_declarations_mirror

export fn stateful_session_imports(session: StatefulSession) -> Vec String =
  match session with | StatefulSession _ imports _ -> imports

export fn stateful_session_declarations(session: StatefulSession) -> Vec String =
  match session with | StatefulSession _ _ declarations -> declarations

fn stateful_session_source(session: StatefulSession) -> String =
  match session with
  | StatefulSession _ imports declarations -> session_source(CompilerSession(imports, declarations))

extern fn analysis_session_create(dummy: String) -> Int !{IO}
extern fn analysis_session_update(session_id: Int, kind: String, line: String) -> Result String Unit !{IO}
extern fn analysis_session_eval(session_id: Int, expr: String) -> Result String (Vec String) !{IO}
extern fn analysis_session_type_of(session_id: Int, expr: String) -> Result String String !{IO}
extern fn analysis_session_diagnostics(session_id: Int) -> Vec(String, Int, Int) !{IO}
extern fn analysis_session_destroy(session_id: Int) -> Unit !{IO}

export fn create_session() -> StatefulSession !{IO} =
  do
    id <- analysis_session_create("")
    StatefulSession(id, vec_empty(), vec_empty())

export fn session_import(session: StatefulSession, line: String) -> Result String StatefulSession !{IO} =
  match session with
  | StatefulSession id imports declarations ->
      match analysis_session_update(id, "import", line) with
      | Err msg -> Err(msg)
      | Ok _ -> Ok(StatefulSession(id, vec_append(line, imports), declarations))

export fn session_declare(session: StatefulSession, line: String) -> Result String StatefulSession !{IO} =
  match session with
  | StatefulSession id imports declarations ->
      match analysis_session_update(id, "declaration", line) with
      | Err msg -> Err(msg)
      | Ok _ -> Ok(StatefulSession(id, imports, vec_append(line, declarations)))

export fn eval_in_session(session: StatefulSession, expr: String) -> Result String (Vec String) !{IO} =
  match session with
  | StatefulSession id _ _ -> analysis_session_eval(id, expr)

export fn type_of_in_session(session: StatefulSession, expr: String) -> Result String String !{IO} =
  match session with
  | StatefulSession id _ _ -> analysis_session_type_of(id, expr)

export fn diagnostics_in_session(session: StatefulSession) -> Vec ReportEntry !{IO} =
  match session with
  | StatefulSession id _ _ -> map_diagnostics(analysis_session_diagnostics(id), 0, vec_empty())

export fn destroy_session(session: StatefulSession) -> Unit !{IO} =
  match session with
  | StatefulSession id _ _ -> analysis_session_destroy(id)
