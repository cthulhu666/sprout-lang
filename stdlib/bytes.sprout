module stdlib.bytes

export type Utf8Error (..) =
  | Utf8DecodeError String

extern fn bytes_empty() -> Bytes
extern fn bytes_singleton(val: Int) -> Bytes
extern fn bytes_length(b: Bytes) -> Int
extern fn bytes_get(b: Bytes, i: Int) -> Maybe Int
extern fn bytes_slice(b: Bytes, from: Int, to: Int) -> Bytes
extern fn bytes_append(a: Bytes, b: Bytes) -> Bytes
extern fn bytes_from_utf8(s: String) -> Bytes
extern fn bytes_to_utf8(b: Bytes) -> Result Utf8Error String
extern fn bytes_builder_empty() -> Builder
extern fn bytes_builder_bytes(b: Bytes) -> Builder
extern fn bytes_builder_byte(val: Int) -> Builder
extern fn bytes_builder_u16_be(val: Int) -> Builder
extern fn bytes_builder_u32_be(val: Int) -> Builder
extern fn bytes_builder_append(a: Builder, b: Builder) -> Builder
extern fn bytes_builder_build(b: Builder) -> Bytes

export fn empty() -> Bytes =
  bytes_empty()

export fn singleton(value: Int) -> Bytes =
  bytes_singleton(value)

# O(1): length is stored on the native bytes object.
export fn length(value: Bytes) -> Int =
  bytes_length(value)

# O(1): direct indexed lookup on the native bytes object.
export fn get(value: Bytes, index: Int) -> Maybe Int =
  bytes_get(value, index)

# O(count): allocates and copies the requested byte window.
export fn slice(value: Bytes, start: Int, count: Int) -> Bytes =
  bytes_slice(value, start, count)

# O(|left| + |right|): allocates one output buffer and copies both inputs.
export fn append(left: Bytes, right: Bytes) -> Bytes =
  bytes_append(left, right)

# O(|raw|): copies the UTF-8 bytes into a fresh bytes object.
export fn from_string(raw: String) -> Bytes =
  bytes_from_utf8(raw)

# O(|value|): validates UTF-8 and copies the decoded bytes into a fresh string.
export fn to_string(value: Bytes) -> Result Utf8Error String =
  bytes_to_utf8(value)

# O(1): the builder stores chunk references and the total length.
export fn builder_empty() -> Builder =
  bytes_builder_empty()

# O(1): wraps the existing bytes chunk without flattening.
export fn builder_bytes(value: Bytes) -> Builder =
  bytes_builder_bytes(value)

export fn builder_byte(value: Int) -> Builder =
  bytes_builder_byte(value)

export fn builder_u16_be(value: Int) -> Builder =
  bytes_builder_u16_be(value)

export fn builder_u32_be(value: Int) -> Builder =
  bytes_builder_u32_be(value)

# O(chunks_left + chunks_right): concatenates chunk tables without flattening bytes yet.
export fn builder_append(left: Builder, right: Builder) -> Builder =
  bytes_builder_append(left, right)

# O(total_bytes): flattens all builder chunks into one contiguous bytes value.
export fn builder_build(value: Builder) -> Bytes =
  bytes_builder_build(value)

fn mod_256(value: Int) -> Int =
  value - (value / 256) * 256

export fn u16_be(value: Int) -> Bytes =
  append(singleton(mod_256(value / 256)), singleton(mod_256(value)))

export fn u32_be(value: Int) -> Bytes =
  append(
    singleton(mod_256(value / 16777216)),
    append(
      singleton(mod_256(value / 65536)),
      append(singleton(mod_256(value / 256)), singleton(mod_256(value)))
    )
  )

export fn read_u16_be(value: Bytes) -> Maybe Int =
  do
    b0 <- get(value, 0)
    b1 <- get(value, 1)
    Just(b0 * 256 + b1)

export fn read_u32_be(value: Bytes) -> Maybe Int =
  do
    b0 <- get(value, 0)
    b1 <- get(value, 1)
    b2 <- get(value, 2)
    b3 <- get(value, 3)
    Just(b0 * 16777216 + b1 * 65536 + b2 * 256 + b3)

# O(1) indexed read defaulting to -1, so a scan can compare Ints instead of `Maybe Int`s. -1 is
# outside the 0..255 byte range, so an out-of-bounds read can never compare equal to a real byte.
fn byte_at(value: Bytes, index: Int) -> Int =
  maybe_with_default(-1, get(value, index))

fn matches_at(haystack: Bytes, needle: Bytes, at: Int, index: Int, needle_len: Int) -> Bool =
  if index >= needle_len then true
  else if byte_at(haystack, at + index) == byte_at(needle, index) then
    matches_at(haystack, needle, at, index + 1, needle_len)
  else false

fn find_from(haystack: Bytes, needle: Bytes, start: Int, last: Int, needle_len: Int) -> Maybe Int =
  if start > last then Nothing
  else if matches_at(haystack, needle, start, 0, needle_len) then Just(start)
  else find_from(haystack, needle, start + 1, last, needle_len)

# Byte-exact substring search: the index of the first occurrence of `needle`, or Nothing.
#
# This is the search `str_find` cannot perform. A String is NUL-free and valid UTF-8 by construction
# (docs/spec-v0.md:64), so locating a delimiter in bytes that have just arrived from a socket had to
# either mint a String that violates that invariant — the W2 R2 defect — or work on Bytes. This is
# the Bytes half.
#
# O(|haystack| * |needle|): a plain scan with no skip table. That is deliberate. The delimiters this
# exists for are 1-4 bytes (HTTP's "\r\n\r\n"), where Boyer-Moore's preprocessing costs more than it
# saves, and a caller searching a GROWING buffer must not re-scan from 0 each round anyway — the
# quadratic blowup that matters lives in the caller's loop, not here. stdlib.http_server bounds it by
# searching only a 3-byte overlap plus the new chunk per read, which is O(total) across the whole
# header phase; a caller that instead rescans the accumulated block per chunk is quadratic no matter
# how fast this function is.
#
# An empty needle matches at 0, following str_find and the same convention as C's strstr.
export fn find(haystack: Bytes, needle: Bytes) -> Maybe Int =
  find_from(haystack, needle, 0, length(haystack) - needle_len, needle_len)
where
  needle_len = length(needle)

fn c_string_len_from(value: Bytes, index: Int, total: Int) -> Int =
  if index >= total then total
  else
    match get(value, index) with
    | Nothing -> total
    | Just b ->
        if b == 0 then index
        else c_string_len_from(value, index + 1, total)

# O(|raw|): appends a trailing NUL after copying the string bytes.
export fn c_string(raw: String) -> Bytes =
  append(from_string(raw), singleton(0))

# O(n): scans for the first NUL, slices, then validates/copies the substring.
export fn read_c_string(value: Bytes) -> Result Utf8Error String =
  to_string(slice(value, 0, c_string_len_from(value, 0, length(value))))
