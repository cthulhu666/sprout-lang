module stdlib.linheap

import stdlib.linvec (LinVec)
import stdlib.linvec as linvec

# A binary min-heap over `LinVec`, linear so pushes and pops write in place. The smallest
# element by `compare` pops first; ties pop in no fixed order. Design: docs/linheap-v0.md.

# The heap is the whole `LinVec`: its length is the size. The type is abstract, as `LinVec` is.
export wrap linear LinHeap a = LinVec a

fn at(i: Int, v: borrowing LinVec a) -> a =
  let Just x = linvec.get(i, v) else panic("linheap: index out of range (internal error)")
  in x

fn sift_up(i: Int, x: a, v: LinVec a) -> LinVec a where Ord a =
  if i == 0 then linvec.set(0, x, v)
  else
    let p = (i - 1) / 2
        px = at(p, v)
    in if compare(x, px) < 0 then sift_up(p, x, linvec.set(i, px, v))
    else linvec.set(i, x, v)

# Places `x` at the first slot from `i` down where no child is smaller; `n` is the heap size.
fn sift_down(i: Int, n: Int, x: a, v: LinVec a) -> LinVec a where Ord a =
  let l = 2 * i + 1
  in if l >= n then linvec.set(i, x, v)
  else
    let r = l + 1
        lx = at(l, v)
        (c, cx) =
          if r >= n then (l, lx)
          else
            let rx = at(r, v)
            in if compare(rx, lx) < 0 then (r, rx) else (l, lx)
    in if compare(cx, x) < 0 then sift_down(c, n, x, linvec.set(i, cx, v))
    else linvec.set(i, x, v)

# Floyd's build: sifts down each parent, last first.
fn heapify(i: Int, n: Int, v: LinVec a) -> LinVec a where Ord a =
  if i < 0 then v
  else heapify(i - 1, n, sift_down(i, n, at(i, v), v))

export fn new() -> LinHeap a = LinHeap(linvec.empty())

# O(n).
export fn from_list(xs: List a) -> LinHeap a where Ord a =
  let v = linvec.from_list(xs)
      n = linvec.length(v)
  in LinHeap(heapify(n / 2 - 1, n, v))

# O(log n) amortised.
export fn push(x: a, h: LinHeap a) -> LinHeap a where Ord a =
  match h with
  | LinHeap v ->
      let n = linvec.length(v)
      in LinHeap(sift_up(n, x, linvec.push(x, v)))

# Moves the last key `x` of `v` to the root and returns the root it replaces. `v` holds the
# remaining `n` keys, with `x` already removed.
fn replace_root(n: Int, x: a, v: LinVec a) -> (Maybe a, LinHeap a) where Ord a =
  let top = linvec.get(0, v)
  in (top, LinHeap(sift_down(0, n, x, v)))

# O(log n) amortised. An empty heap yields `Nothing` and comes back unchanged.
export fn pop(h: LinHeap a) -> (Maybe a, LinHeap a) where Ord a =
  match h with
  | LinHeap v ->
      match linvec.pop(v) with
      | (Nothing, rest) -> (Nothing, LinHeap(rest))
      | (Just last, rest) ->
          let n = linvec.length(rest)
          in if n == 0 then (Just(last), LinHeap(rest))
          else replace_root(n, last, rest)

# O(1).
export fn peek(h: borrowing LinHeap a) -> Maybe a =
  match h with
  | LinHeap v -> linvec.get(0, v)

# O(1).
export fn size(h: borrowing LinHeap a) -> Int =
  match h with
  | LinHeap v -> linvec.length(v)

export fn drop(h: LinHeap a) -> Unit =
  match h with
  | LinHeap v -> linvec.drop(v)
