module stdlib.test

import stdlib.math (fabs)

# ---------------------------------------------------------------------------
# Minimal unit test framework for Sprout stdlib.
#
# Design mirrors HUnit (Haskell) and hspec: Eq a for the equality check,
# ToString a for failure messages — two orthogonal constraints at the call site.
#
# Usage pattern:
#
#   import stdlib.test (TestState, new_state, assert_eq, assert_true,
#                       assert_false, summary)
#
#   fn main() -> Unit !{IO} =
#     do
#       state <- new_state()
#       assert_eq(state, "abs(-3)", abs(-3), 3)
#       assert_true(state, "is_even 4", is_even(4))
#       summary(state)
#
# Output: one "PASS: …" or "FAIL: …" line per assertion, then:
#   "N passed, M failed"
#   "SUITE PASSED"   ← or "SUITE FAILED" if M > 0
#
# The justfile test-stdlib recipe greps for "SUITE FAILED" to detect failures.
# ---------------------------------------------------------------------------

export type TestState =
  | TestState (Ref Int) (Ref Int)
  # TestState pass_count fail_count

export fn new_state() -> TestState !{IO} =
  do
    p <- ref_new(0)
    f <- ref_new(0)
    TestState(p, f)

export fn assert_true(state: TestState, label: String, condition: Bool) -> Unit !{IO} =
  match state with
  | TestState pass_ref fail_ref ->
      if condition then
        do
          p <- ref_read(pass_ref)
          ref_write(pass_ref, p + 1)
          print("PASS: " ++ label)
      else
        do
          f <- ref_read(fail_ref)
          ref_write(fail_ref, f + 1)
          print("FAIL: " ++ label)

export fn assert_false(state: TestState, label: String, condition: Bool) -> Unit !{IO} =
  assert_true(state, label, condition == false)

# Eq a: used for the equality check (correct semantics).
# ToString a: used only for failure messages (display).
# Mirrors: HUnit assertEqual :: (Eq a, Show a) => String -> a -> a -> Assertion
#          Rust assert_eq! requiring PartialEq + Debug
export fn assert_eq(state: TestState, label: String, actual: a, expected: a) -> Unit !{IO} where Eq a, ToString a =
  match state with
  | TestState pass_ref fail_ref ->
      if eq(actual, expected) then
        do
          p <- ref_read(pass_ref)
          ref_write(pass_ref, p + 1)
          print("PASS: " ++ label)
      else
        do
          f <- ref_read(fail_ref)
          ref_write(fail_ref, f + 1)
          print("FAIL: " ++ label ++ " (expected " ++ to_string(expected) ++ ", got " ++ to_string(actual) ++ ")")

# Prints pass/fail counts, then "SUITE PASSED" or "SUITE FAILED".
# The justfile runner greps for "SUITE FAILED" to set the exit code.
export fn summary(state: TestState) -> Unit !{IO} =
  match state with
  | TestState pass_ref fail_ref ->
      do
        p <- ref_read(pass_ref)
        f <- ref_read(fail_ref)
        print(int_to_string(p) ++ " passed, " ++ int_to_string(f) ++ " failed")
        if f > 0 then print("SUITE FAILED")
        else print("SUITE PASSED")

# ---------------------------------------------------------------------------
# Pure-list API (preferred). An assertion is a value, not an effect: `check_eq`
# evaluates `eq`/`to_string` eagerly and returns a monomorphic `TestCase`, so a
# heterogeneous set of assertions (Int here, String there) forms one homogeneous
# `Vec TestCase`. `run_suite` folds it purely and prints once — no `TestState`
# threaded through every call, no `do`, no per-assertion IO.
#
#   import stdlib.test (check_eq, check_true, check_approx, run_suite)
#
#   fn main() -> Unit !{IO} =
#     run_suite("math", [
#       check_eq("abs(-3)", abs(-3), 3),
#       check_true("is_even 4", is_even(4)),
#       check_approx("sqrt(2)", sqrt(2.0), 1.41421, 0.0001),
#     ])
#
# `check_eq` does not type-check on `Double`: it needs an `Eq Double` instance (its `eq`
# call goes through the `Eq` typeclass, unlike the `==` operator, which on `Double` is a
# built-in primitive comparison), and no `Eq Double` instance exists — a `check_eq` on
# Double fails with "No instance of Eq for Double". Use `check_approx` / `check_approx2`
# for floating-point and 2D `(x, z)` checks: they compare with `-`/`<` directly, carry a
# tolerance (exact float equality is wrong for computed values anyway), and diagnose.
#
# Use the effectful TestState API above only when producing the actual value
# needs IO (e.g. a Ref-backed capture sink, channels) — those cases can't be a
# pure `TestCase`.
# ---------------------------------------------------------------------------

export type TestCase (..) =
  | TestCase String Bool String
  # TestCase label passed detail

# eq for the check, ToString only for the failure detail — same two orthogonal
# constraints as assert_eq, resolved concretely at each (monomorphic) call site.
export fn check_eq(label: String, actual: a, expected: a) -> TestCase where Eq a, ToString a =
  if eq(actual, expected) then TestCase(label, true, "")
  else TestCase(label, false, "expected " ++ to_string(expected) ++ ", got " ++ to_string(actual))

export fn check_true(label: String, condition: Bool) -> TestCase =
  TestCase(label, condition, "expected true, got false")

export fn check_false(label: String, condition: Bool) -> TestCase =
  TestCase(label, condition == false, "expected false, got true")

# Float sibling of check_eq: passes when |actual - expected| < eps. check_eq can't be used
# on Double — its `eq` goes through the `Eq` typeclass, which has no `Double` instance (the
# `==` operator on Double is a built-in primitive, not that typeclass), so it fails to
# compile with "No instance of Eq for Double"; and exact float equality would be wrong for
# computed values anyway. check_approx compares with the `-`/`<` operators directly and
# renders the message via the monomorphic ToString Double instance. eps is explicit at the
# call site — the visible tolerance is part of the test.
export fn check_approx(label: String, actual: Double, expected: Double, eps: Double) -> TestCase =
  if fabs(actual - expected) < eps then TestCase(label, true, "")
  else TestCase(label, false,
    "expected " ++ to_string(expected) ++ " +/- " ++ to_string(eps) ++ ", got " ++ to_string(actual))

# 2D (x, z) sibling of check_approx for position assertions: both components must be within
# eps. Scoped to 2-tuples (the system-view plane); a 3D need should add a check_approx3 rather
# than nest tuples here. Exists because a flat `[...]` suite can't destructure a tuple result
# mid-literal to split it into two scalar check_approx rows.
export fn check_approx2(label: String, actual: (Double, Double), ex: Double, ez: Double, eps: Double) -> TestCase =
  match actual with
  | (ax, az) ->
      if (fabs(ax - ex) < eps) && (fabs(az - ez) < eps) then TestCase(label, true, "")
      else TestCase(label, false,
        "expected (" ++ to_string(ex) ++ ", " ++ to_string(ez) ++ ") +/- " ++ to_string(eps)
          ++ ", got (" ++ to_string(ax) ++ ", " ++ to_string(az) ++ ")")

# Fold helpers (private): build the per-case report and count failures.
fn case_report(acc: String, c: TestCase) -> String =
  match c with
  | TestCase label passed detail ->
      if passed then acc ++ "PASS: " ++ label ++ "\n"
      else acc ++ "FAIL: " ++ label ++ " (" ++ detail ++ ")\n"

fn case_fail_count(acc: Int, c: TestCase) -> Int =
  match c with
  | TestCase _ passed _ -> if passed then acc else acc + 1

# Print one PASS/FAIL line per case, then "N passed, M failed" and the
# SUITE PASSED/FAILED verdict the justfile runner greps for. Emits a single
# print (the whole report is a pure fold) so output survives buffered capture.
export fn run_suite(name: String, cases: Vec TestCase) -> Unit !{IO} =
  do
    let report = vec_fold(case_report, "", cases)
    let fails = vec_fold(case_fail_count, 0, cases)
    let total = vec_length(cases)
    let verdict = if fails > 0 then "SUITE FAILED" else "SUITE PASSED"
    print(report ++ name ++ ": " ++ int_to_string(total - fails) ++ " passed, " ++ int_to_string(fails) ++ " failed\n" ++ verdict)
