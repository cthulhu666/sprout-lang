module stdlib.gfx

# Native graphics backend binding (Milestone 1: raylib), implemented by the C
# shim graphics/sprout_gfx.c. This is a *native binding*, not portable core
# stdlib — it links only via `just run-gfx` and never enters the bootstrap seed.
# See docs/graphics-v0.md.
#
# Every extern below matches a `long long`-ABI function in the shim. Doubles
# cross as their raw bit pattern; the shim reinterprets them as floats.

# --- C ABI bridge (module-private) ---

extern fn gfx_open_window(w: Int, h: Int, title: String) -> Unit !{IO}
extern fn gfx_set_target_fps(fps: Int) -> Unit !{IO}
extern fn gfx_window_should_close() -> Int !{IO}
extern fn gfx_get_frame_time() -> Double !{IO}
extern fn gfx_set_camera(px: Double, py: Double, pz: Double,
                         tx: Double, ty: Double, tz: Double,
                         fovy: Double) -> Unit !{IO}
extern fn gfx_frame_begin() -> Unit !{IO}
extern fn gfx_draw_grid(slices: Int, spacing: Double) -> Unit !{IO}
extern fn gfx_draw_spinning_cube(size: Double, angle: Double) -> Unit !{IO}
extern fn gfx_load_model(path: String) -> Int !{IO}
extern fn gfx_terrain_begin() -> Unit !{IO}
extern fn gfx_terrain_end() -> Unit !{IO}
extern fn gfx_draw_cube(x: Double, y: Double, z: Double, size: Double, r: Int, g: Int, b: Int) -> Unit !{IO}
extern fn gfx_mesh_capture_begin() -> Unit !{IO}
extern fn gfx_mesh_capture_end() -> Int !{IO}
extern fn gfx_draw_captured(handle: Int) -> Unit !{IO}
extern fn gfx_draw_plane(x: Double, y: Double, z: Double, sx: Double, sz: Double, r: Int, g: Int, b: Int, a: Int) -> Unit !{IO}
extern fn gfx_draw_model(handle: Int, x: Double, y: Double, z: Double, angle: Double, scale: Double) -> Unit !{IO}
extern fn gfx_load_animations(path: String) -> Int !{IO}
extern fn gfx_animation_count(set: Int) -> Int !{IO}
extern fn gfx_animation_keyframes(set: Int, index: Int) -> Int !{IO}
extern fn gfx_update_animation(model: Int, set: Int, index: Int, frame: Double) -> Unit !{IO}
extern fn gfx_draw_fps(x: Int, y: Int) -> Unit !{IO}
extern fn gfx_space_pressed() -> Int !{IO}
extern fn gfx_button(x: Int, y: Int, w: Int, h: Int, label: String) -> Int !{IO}
extern fn gfx_frame_end() -> Unit !{IO}
extern fn gfx_close_window() -> Unit !{IO}

# --- Public API ---

export fn open_window(w: Int, h: Int, title: String) -> Unit !{IO} =
  gfx_open_window(w, h, title)

export fn set_target_fps(fps: Int) -> Unit !{IO} =
  gfx_set_target_fps(fps)

# Real seconds elapsed since the previous frame (raylib GetFrameTime). Feed this to
# loam.driver.fixed_step so the simulation advances at a constant wall-clock pace
# regardless of FPS. ~0 on the first frame; jitters around 1/target_fps thereafter.
export fn get_frame_time() -> Double !{IO} =
  gfx_get_frame_time()

# True once the window has been asked to close or the frame budget is spent.
export fn window_should_close() -> Bool !{IO} =
  do
    flag <- gfx_window_should_close()
    flag == 1

export fn set_camera(px: Double, py: Double, pz: Double,
                     tx: Double, ty: Double, tz: Double,
                     fovy: Double) -> Unit !{IO} =
  gfx_set_camera(px, py, pz, tx, ty, tz, fovy)

export fn frame_begin() -> Unit !{IO} =
  gfx_frame_begin()

export fn draw_grid(slices: Int, spacing: Double) -> Unit !{IO} =
  gfx_draw_grid(slices, spacing)

export fn draw_spinning_cube(size: Double, angle: Double) -> Unit !{IO} =
  gfx_draw_spinning_cube(size, angle)

# Load a model (glTF/GLB/OBJ/IQM/M3D — not FBX) and return its handle. Call after
# open_window; a handle of -1 means the model registry is full.
export fn load_model(path: String) -> Int !{IO} =
  gfx_load_model(path)

# Begin/end a terrain batch: bind the vertex-colour cube shader ONCE around many draw_cube
# calls, so a whole terrain draws under a single shader activation (no per-cube GL state
# change). Wrap the tile loop: `terrain_begin(); <draw_cube per tile>; terrain_end()`.
export fn terrain_begin() -> Unit !{IO} = gfx_terrain_begin()
export fn terrain_end() -> Unit !{IO} = gfx_terrain_end()

# Draw an axis-aligned cube of edge `size` at (x,y,z) in flat RGB (each of r,g,b in 0..255).
# Inside a mesh_capture_begin/end pair it is APPENDED to a static mesh (drawn later in one
# call); otherwise it draws immediately (inside a terrain_begin/end pair). Shaded by the scene
# key light (top faces brighter than sides) so stepped relief is visible.
export fn draw_cube(x: Double, y: Double, z: Double, size: Double, r: Int, g: Int, b: Int) -> Unit !{IO} =
  gfx_draw_cube(x, y, z, size, r, g, b)

# Bake many draw_cube calls into ONE static GPU mesh: mesh_capture_begin(), run the tile loop
# (each draw_cube appends its geometry), then handle <- mesh_capture_end(). Thereafter draw the
# whole terrain in a single call per frame with draw_captured(handle) — no per-frame per-tile
# work. This is how large static terrain stays at 60 FPS (docs/terrain-v0.md §7). -1 on failure.
export fn mesh_capture_begin() -> Unit !{IO} = gfx_mesh_capture_begin()
export fn mesh_capture_end() -> Int !{IO} = gfx_mesh_capture_end()
export fn draw_captured(handle: Int) -> Unit !{IO} = gfx_draw_captured(handle)

# Draw a filled horizontal (XZ) plane centred at (x,y,z), size (sx,sz), in RGBA (0..255). With
# alpha < 255 it blends — a translucent water surface. Draw AFTER the terrain so peaks poke
# through (depth test) while valleys are covered.
export fn draw_plane(x: Double, y: Double, z: Double, sx: Double, sz: Double,
                     r: Int, g: Int, b: Int, a: Int) -> Unit !{IO} =
  gfx_draw_plane(x, y, z, sx, sz, r, g, b, a)

# Draw a loaded model at (x,y,z), rotated `angle` degrees about Y, scaled by `scale`.
export fn draw_model(handle: Int, x: Double, y: Double, z: Double, angle: Double, scale: Double) -> Unit !{IO} =
  gfx_draw_model(handle, x, y, z, angle, scale)

# Load an animation set (glTF/GLB/IQM/M3D) whose skeleton matches a model; returns
# a set handle. A clip is identified by (set, index); animation_count gives how many.
export fn load_animations(path: String) -> Int !{IO} =
  gfx_load_animations(path)

export fn animation_count(set: Int) -> Int !{IO} =
  gfx_animation_count(set)

# Keyframe count of a clip — the modulus for looping the playhead (see anim_advance).
export fn animation_keyframes(set: Int, index: Int) -> Int !{IO} =
  gfx_animation_keyframes(set, index)

# Pose a model to clip (set, index) at the given frame; fractional frames interpolate.
export fn update_animation(model: Int, set: Int, index: Int, frame: Double) -> Unit !{IO} =
  gfx_update_animation(model, set, index, frame)

# Draw raylib's built-in FPS counter at screen pixel (x, y). Call inside a frame
# (between frame_begin and frame_end); it renders as a 2D overlay over the scene.
export fn draw_fps(x: Int, y: Int) -> Unit !{IO} =
  gfx_draw_fps(x, y)

# True on the frame the Space key is pressed (edge-triggered — one True per
# press, not while held). Suited to toggles.
export fn space_pressed() -> Bool !{IO} =
  do
    flag <- gfx_space_pressed()
    flag == 1

# Immediate-mode button: draw a labelled box (2D overlay, inside a frame) and
# return True on the frame it is left-clicked. Draw and hit-test are one call —
# `clicked <- button(x, y, w, h, "+")`.
export fn button(x: Int, y: Int, w: Int, h: Int, label: String) -> Bool !{IO} =
  do
    clicked <- gfx_button(x, y, w, h, label)
    clicked == 1

export fn frame_end() -> Unit !{IO} =
  gfx_frame_end()

export fn close_window() -> Unit !{IO} =
  gfx_close_window()
