module stdlib.gfx

# Native graphics backend binding (Milestone 1: raylib), implemented by the C
# shim graphics/sprout_gfx.c. This is a *native binding*, not portable core
# stdlib — it links only via `just run-gfx` and never enters the bootstrap seed.
# See docs/graphics-v0.md.
#
# Every extern below matches a `long long`-ABI function in the shim. Doubles
# cross as their raw bit pattern; the shim reinterprets them as floats.

# --- C ABI bridge (module-private) ---

extern fn gfx_open_window(w: Int, h: Int, title: String) -> Unit !{IO}
extern fn gfx_set_target_fps(fps: Int) -> Unit !{IO}
extern fn gfx_window_should_close() -> Int !{IO}
extern fn gfx_get_frame_time() -> Double !{IO}
extern fn gfx_set_camera(px: Double, py: Double, pz: Double,
                         tx: Double, ty: Double, tz: Double,
                         fovy: Double) -> Unit !{IO}
extern fn gfx_frame_begin() -> Unit !{IO}
extern fn gfx_draw_grid(slices: Int, spacing: Double) -> Unit !{IO}
extern fn gfx_load_model(path: String) -> Int !{IO}
extern fn gfx_draw_cube(x: Double, y: Double, z: Double, size: Double, r: Int, g: Int, b: Int) -> Unit !{IO}
extern fn gfx_draw_line3d(x0: Double, y0: Double, z0: Double, x1: Double, y1: Double, z1: Double, r: Int, g: Int, b: Int) -> Unit !{IO}
extern fn gfx_draw_sphere(x: Double, y: Double, z: Double, radius: Double, r: Int, g: Int, b: Int) -> Unit !{IO}
extern fn gfx_draw_star(x: Double, y: Double, z: Double, radius: Double, r: Int, g: Int, b: Int) -> Unit !{IO}
extern fn gfx_draw_planet(x: Double, y: Double, z: Double, radius: Double, seed: Double, kind: Int, r: Int, g: Int, b: Int) -> Unit !{IO}
extern fn gfx_capture_quad(p0x: Double, p0y: Double, p0z: Double,
                           p1x: Double, p1y: Double, p1z: Double,
                           p2x: Double, p2y: Double, p2z: Double,
                           p3x: Double, p3y: Double, p3z: Double,
                           nx: Double, ny: Double, nz: Double,
                           r: Int, g: Int, b: Int) -> Unit !{IO}
extern fn gfx_mesh_capture_begin() -> Unit !{IO}
extern fn gfx_mesh_capture_end() -> Int !{IO}
extern fn gfx_mesh_reset() -> Unit !{IO}
extern fn gfx_capture_quad_data(p0x: Double, p0y: Double, p0z: Double, p1x: Double, p1y: Double, p1z: Double, p2x: Double, p2y: Double, p2z: Double, p3x: Double, p3y: Double, p3z: Double, nx: Double, ny: Double, nz: Double, tag: Int, tier: Int, dir: Int, band: Int, lake: Int) -> Unit !{IO}
extern fn gfx_capture_quad_data_vn(p0x: Double, p0y: Double, p0z: Double, p1x: Double, p1y: Double, p1z: Double, p2x: Double, p2y: Double, p2z: Double, p3x: Double, p3y: Double, p3z: Double, n0x: Double, n0y: Double, n0z: Double, n1x: Double, n1y: Double, n1z: Double, n2x: Double, n2y: Double, n2z: Double, n3x: Double, n3y: Double, n3z: Double, tag: Int, tier: Int, dir: Int, band0: Double, band1: Double, band2: Double, band3: Double, lake: Int) -> Unit !{IO}
extern fn gfx_set_time(t: Double) -> Unit !{IO}
extern fn gfx_get_time() -> Double !{IO}
extern fn gfx_begin_blend_alpha() -> Unit !{IO}
extern fn gfx_end_blend() -> Unit !{IO}
extern fn gfx_set_depth_mask(on: Bool) -> Unit !{IO}
extern fn gfx_set_view_mode(mode: Int) -> Unit !{IO}
extern fn gfx_set_terrain_levels(levels: Int) -> Unit !{IO}
extern fn gfx_draw_captured(handle: Int) -> Unit !{IO}
extern fn gfx_draw_plane(x: Double, y: Double, z: Double, sx: Double, sz: Double, r: Int, g: Int, b: Int, a: Int) -> Unit !{IO}
extern fn gfx_draw_model(handle: Int, x: Double, y: Double, z: Double, angle: Double, scale: Double) -> Unit !{IO}
extern fn gfx_instance_push(group: Int, model: Int, x: Double, y: Double, z: Double, angle: Double, scale: Double) -> Unit !{IO}
extern fn gfx_instance_clear(group: Int) -> Unit !{IO}
extern fn gfx_draw_instances(group_count: Int, cull_dist: Double) -> Unit !{IO}
extern fn gfx_draw_instances_masked(group_count: Int, cull_dist: Double, class_mask: Int) -> Unit !{IO}
extern fn gfx_load_animations(path: String) -> Int !{IO}
extern fn gfx_animation_count(set: Int) -> Int !{IO}
extern fn gfx_animation_keyframes(set: Int, index: Int) -> Int !{IO}
extern fn gfx_update_animation(model: Int, set: Int, index: Int, frame: Double) -> Unit !{IO}
extern fn gfx_draw_fps(x: Int, y: Int) -> Unit !{IO}
extern fn gfx_space_pressed() -> Int !{IO}
extern fn gfx_key_down(key: Int) -> Int !{IO}
extern fn gfx_mouse_button_down(button: Int) -> Int !{IO}
extern fn gfx_mouse_wheel_y() -> Double !{IO}
extern fn gfx_mouse_delta_x() -> Double !{IO}
extern fn gfx_mouse_delta_y() -> Double !{IO}
extern fn gfx_mouse_x() -> Int !{IO}
extern fn gfx_mouse_y() -> Int !{IO}
extern fn gfx_button(x: Int, y: Int, w: Int, h: Int, label: String) -> Int !{IO}
extern fn gfx_button_held(x: Int, y: Int, w: Int, h: Int, label: String) -> Int !{IO}
extern fn gfx_frame_end() -> Unit !{IO}
extern fn gfx_post_vignette(intensity: Double, radius: Double) -> Unit !{IO}
extern fn gfx_post_tonemap(exposure: Double, saturation: Double) -> Unit !{IO}
extern fn gfx_post_motion_blur(static_amount: Double, motion_gain: Double) -> Unit !{IO}
extern fn gfx_post_bloom(threshold: Double, intensity: Double) -> Unit !{IO}
extern fn gfx_post_altitude_blur(low_alt: Double, high_alt: Double, amt_low: Double, amt_high: Double) -> Unit !{IO}
extern fn gfx_post_disable() -> Unit !{IO}
extern fn gfx_fog(density: Double, r: Int, g: Int, b: Int) -> Unit !{IO}
extern fn gfx_supersample(factor: Int) -> Unit !{IO}
extern fn gfx_overlay_begin() -> Unit !{IO}
extern fn gfx_close_window() -> Unit !{IO}
extern fn gfx_set_clip_planes(near_plane: Double, far_plane: Double) -> Unit !{IO}
extern fn gfx_sphere_model(r: Int, g: Int, b: Int) -> Int !{IO}
extern fn gfx_star_model(r: Int, g: Int, b: Int) -> Int !{IO}
extern fn gfx_world_to_screen(x: Double, y: Double, z: Double) -> Int !{IO}
extern fn gfx_projected_x() -> Double !{IO}
extern fn gfx_projected_y() -> Double !{IO}
extern fn gfx_draw_text(x: Int, y: Int, text: String, size: Int, r: Int, g: Int, b: Int) -> Unit !{IO}
extern fn gfx_draw_rect(x: Int, y: Int, w: Int, h: Int, r: Int, g: Int, b: Int) -> Unit !{IO}
extern fn gfx_double_to_int(d: Double) -> Int

# --- Public API ---

export fn open_window(w: Int, h: Int, title: String) -> Unit !{IO} =
  gfx_open_window(w, h, title)

export fn set_target_fps(fps: Int) -> Unit !{IO} =
  gfx_set_target_fps(fps)

# Real seconds elapsed since the previous frame (raylib GetFrameTime). Feed this to
# loam.driver.fixed_step so the simulation advances at a constant wall-clock pace
# regardless of FPS. ~0 on the first frame; jitters around 1/target_fps thereafter.
export fn get_frame_time() -> Double !{IO} =
  gfx_get_frame_time()

# True once the window has been asked to close or the frame budget is spent.
export fn window_should_close() -> Bool !{IO} =
  do
    flag <- gfx_window_should_close()
    flag == 1

export fn set_camera(px: Double, py: Double, pz: Double,
                     tx: Double, ty: Double, tz: Double,
                     fovy: Double) -> Unit !{IO} =
  gfx_set_camera(px, py, pz, tx, ty, tz, fovy)

export fn frame_begin() -> Unit !{IO} =
  gfx_frame_begin()

export fn draw_grid(slices: Int, spacing: Double) -> Unit !{IO} =
  gfx_draw_grid(slices, spacing)

# Load a model (glTF/GLB/OBJ/IQM/M3D — not FBX) and return its handle. Call after
# open_window; a handle of -1 means the model registry is full.
export fn load_model(path: String) -> Int !{IO} =
  gfx_load_model(path)

# Draw an axis-aligned cube of edge `size` at (x,y,z) in flat RGB (each of r,g,b in 0..255).
# Inside a mesh_capture_begin/end pair it is APPENDED to a static mesh (drawn later in one call);
# otherwise it draws immediately. Shaded by the scene key light (top faces brighter than sides).
export fn draw_cube(x: Double, y: Double, z: Double, size: Double, r: Int, g: Int, b: Int) -> Unit !{IO} =
  gfx_draw_cube(x, y, z, size, r, g, b)

# Draw a 3D line segment in a flat RGB colour (immediate-mode, inside frame_begin/frame_end).
# Scene 2 draws each planet's orbit as a loop of these along loam.orbit.ellipse_point samples.
export fn draw_line3d(x0: Double, y0: Double, z0: Double, x1: Double, y1: Double, z1: Double, r: Int, g: Int, b: Int) -> Unit !{IO} =
  gfx_draw_line3d(x0, y0, z0, x1, y1, z1, r, g, b)

# Draw a solid sphere in a flat RGB colour (immediate-mode). Diffuse-lit (a shaded near/far side),
# which is correct for planets and moons — scene 2 draws those with this.
export fn draw_sphere(x: Double, y: Double, z: Double, radius: Double, r: Int, g: Int, b: Int) -> Unit !{IO} =
  gfx_draw_sphere(x, y, z, radius, r, g, b)

# Draw an EMISSIVE (self-luminous) sphere in a flat RGB colour — a star. Unlike draw_sphere it is
# full-bright with no shaded side (a star IS the light, not lit by one) and tessellates finer, so a
# large on-screen body stays smooth. Scene 2 draws the sun with this; the scene-1 point cloud uses
# the instanced equivalent (star_model). Immediate-mode.
export fn draw_star(x: Double, y: Double, z: Double, radius: Double, r: Int, g: Int, b: Int) -> Unit !{IO} =
  gfx_draw_star(x, y, z, radius, r, g, b)

# Draw a PROCEDURAL planet or moon (scene 2): a diffuse-lit sphere whose surface is synthesised in the
# shader — no texture asset. `seed` varies the surface per body; `kind` selects the style: 0 = rocky
# (noise continents + oceans + polar ice caps), 1 = gas giant (turbulent latitude bands), 2 = moon
# (grey cratered mottle). (r,g,b) is the base tint the surface derives from. Lit from a star assumed
# at the WORLD ORIGIN (the day side faces it), with a blue atmosphere limb on rocky/gas bodies. Use
# this for planets/moons; use draw_star for the (emissive) star. Immediate-mode.
export fn draw_planet(x: Double, y: Double, z: Double, radius: Double, seed: Double, kind: Int, r: Int, g: Int, b: Int) -> Unit !{IO} =
  gfx_draw_planet(x, y, z, radius, seed, kind, r, g, b)

# Bake many draw_cube calls into ONE static GPU mesh: mesh_capture_begin(), run the tile loop
# (each draw_cube appends its geometry), then handle <- mesh_capture_end(). Thereafter draw the
# whole terrain in a single call per frame with draw_captured(handle) — no per-frame per-tile
# work. This is how large static terrain stays at 60 FPS (docs/terrain-v0.md §7). -1 on failure.
# Append one quad to the current static mesh: corners p0..p3 (baked as triangles p0,p1,p2 and
# p0,p2,p3, so wind them CCW for the face `(nx,ny,nz)`), flat colour (r,g,b). The GENERAL
# mesh-building primitive — a caller bakes arbitrary static geometry, e.g. loam.terrain_mesh
# decomposes a terrain tile into a top quad + exposed wall quads. Capture-mode only (no-op outside
# a mesh_capture_begin/end pair; there is no immediate-mode fallback).
export fn capture_quad(p0x: Double, p0y: Double, p0z: Double,
                       p1x: Double, p1y: Double, p1z: Double,
                       p2x: Double, p2y: Double, p2z: Double,
                       p3x: Double, p3y: Double, p3z: Double,
                       nx: Double, ny: Double, nz: Double,
                       r: Int, g: Int, b: Int) -> Unit !{IO} =
  gfx_capture_quad(p0x, p0y, p0z, p1x, p1y, p1z, p2x, p2y, p2z, p3x, p3y, p3z, nx, ny, nz, r, g, b)

# Like capture_quad, but the vertex-colour attribute carries per-vertex DATA for the shader-decoded
# terrain views (see gfx_capture_quad_data / CUBE_FS): tag=biome, tier=river size, dir=D8 flow, band=
# elevation, lake=1 for a lake-surface quad. The shader turns this into the colour for the current
# view (set_view_mode), so a view switch is one uniform write — no re-bake. tag/tier/dir < 128, band <= 126.
export fn capture_quad_data(p0x: Double, p0y: Double, p0z: Double,
                            p1x: Double, p1y: Double, p1z: Double,
                            p2x: Double, p2y: Double, p2z: Double,
                            p3x: Double, p3y: Double, p3z: Double,
                            nx: Double, ny: Double, nz: Double,
                            tag: Int, tier: Int, dir: Int, band: Int, lake: Int) -> Unit !{IO} =
  gfx_capture_quad_data(p0x, p0y, p0z, p1x, p1y, p1z, p2x, p2y, p2z, p3x, p3y, p3z, nx, ny, nz, tag, tier, dir, band, lake)

# Like capture_quad_data but with FOUR per-vertex normals (n0..n3) AND FOUR per-vertex bands
# (band0..band3, one per corner). The smooth terrain bake supplies height-gradient normals (smooth
# Gouraud shading) and per-corner blended elevation bands (so the Relief ramp interpolates smoothly
# instead of faceting per tile). Bands are Double here (the shim rounds each to the alpha byte) so the
# caller needs no Double→Int. tag/tier/dir/lake packed exactly as capture_quad_data.
export fn capture_quad_data_vn(p0x: Double, p0y: Double, p0z: Double,
                               p1x: Double, p1y: Double, p1z: Double,
                               p2x: Double, p2y: Double, p2z: Double,
                               p3x: Double, p3y: Double, p3z: Double,
                               n0x: Double, n0y: Double, n0z: Double,
                               n1x: Double, n1y: Double, n1z: Double,
                               n2x: Double, n2y: Double, n2z: Double,
                               n3x: Double, n3y: Double, n3z: Double,
                               tag: Int, tier: Int, dir: Int,
                               band0: Double, band1: Double, band2: Double, band3: Double, lake: Int) -> Unit !{IO} =
  gfx_capture_quad_data_vn(p0x, p0y, p0z, p1x, p1y, p1z, p2x, p2y, p2z, p3x, p3y, p3z, n0x, n0y, n0z, n1x, n1y, n1z, n2x, n2y, n2z, n3x, n3y, n3z, tag, tier, dir, band0, band1, band2, band3, lake)

# Select which colour a data-encoded terrain mesh renders: -1 raw vertex colour (default), 0 Main /
# 1 Relief / 2 Flow / 3 Lakes. The instant view switch. Cheap enough to call every frame.
export fn set_view_mode(mode: Int) -> Unit !{IO} = gfx_set_view_mode(mode)

# Elevation band count for the shader's grey relief ramp (Relief/Lakes). Set once when config is known.
export fn set_terrain_levels(levels: Int) -> Unit !{IO} = gfx_set_terrain_levels(levels)

# Animation clock (seconds) for any uTime-driven shader surface; get_time is the engine wall-clock.
export fn set_time(t: Double) -> Unit !{IO} = gfx_set_time(t)
export fn get_time() -> Double !{IO} = gfx_get_time()

# General transparency state — compose a transparent pass: draw opaque, then begin_blend_alpha();
# set_depth_mask(false); <draw transparent>; set_depth_mask(true); end_blend(). Not water-specific.
export fn begin_blend_alpha() -> Unit !{IO} = gfx_begin_blend_alpha()
export fn end_blend() -> Unit !{IO} = gfx_end_blend()
export fn set_depth_mask(on: Bool) -> Unit !{IO} = gfx_set_depth_mask(on)

export fn mesh_capture_begin() -> Unit !{IO} = gfx_mesh_capture_begin()
export fn mesh_capture_end() -> Int !{IO} = gfx_mesh_capture_end()
# Free every captured mesh and reset the handle range to 0.. so a fresh set can be baked in place.
# Only captured meshes are dropped — loaded models and their instances survive. Lets a demo re-bake a
# whole terrain (e.g. to switch its colouring/view) without leaking, since the registry has no per-mesh
# free. Call OUTSIDE a frame_begin/frame_end pair (it uploads/frees GPU meshes).
export fn mesh_reset() -> Unit !{IO} = gfx_mesh_reset()
export fn draw_captured(handle: Int) -> Unit !{IO} = gfx_draw_captured(handle)

# Draw a filled horizontal (XZ) plane centred at (x,y,z), size (sx,sz), in RGBA (0..255). With
# alpha < 255 it blends — a translucent water surface. Draw AFTER the terrain so peaks poke
# through (depth test) while valleys are covered.
export fn draw_plane(x: Double, y: Double, z: Double, sx: Double, sz: Double,
                     r: Int, g: Int, b: Int, a: Int) -> Unit !{IO} =
  gfx_draw_plane(x, y, z, sx, sz, r, g, b, a)

# Draw a loaded model at (x,y,z), rotated `angle` degrees about Y, scaled by `scale`.
export fn draw_model(handle: Int, x: Double, y: Double, z: Double, angle: Double, scale: Double) -> Unit !{IO} =
  gfx_draw_model(handle, x, y, z, angle, scale)

# Instanced-props rendering: one system for every repeated model (trees, rocks, crowds, …), drawn
# with frustum + distance culling. `instance_push` queues one instance of `model` into spatial
# bucket `group` (a caller-assigned id — keep it spatially coherent, e.g. one per chunk, so culling
# can drop whole buckets); the transform is Y-rotation `angle` + uniform `scale` at (x,y,z). A group
# in [0, 4096); a model handle in [0, 64). Static scenery pushes once at setup; dynamic movers
# `instance_clear` their group each frame and re-push.
export fn instance_push(group: Int, model: Int, x: Double, y: Double, z: Double, angle: Double, scale: Double) -> Unit !{IO} =
  gfx_instance_push(group, model, x, y, z, angle, scale)

# Empty one spatial bucket (counts -> 0, allocations kept) so a dynamic caller can re-push it this
# frame. Static callers never need this.
export fn instance_clear(group: Int) -> Unit !{IO} =
  gfx_instance_clear(group)

# Draw all groups [0, group_count) in one pass: one instanced draw per model over the compacted
# visible instances, so the draw-call count is ~constant regardless of group count. A group draws
# only if its centre is within `cull_dist` world units of the camera (distance-LOD, so a zoomed-out
# overview draws almost none) AND its AABB is in the frustum. `cull_dist` <= 0 disables the distance
# test (draw all visible).
export fn draw_instances(group_count: Int, cull_dist: Double) -> Unit !{IO} =
  gfx_draw_instances(group_count, cull_dist)

# Like draw_instances, but draw only the models whose bit is set in `class_mask` (bit m == model m).
# Since a starfield pushes one model per class (model index == class code), this filters by class —
# nearly free, as the draw already batches per model. All-bits mask == draw_instances.
export fn draw_instances_masked(group_count: Int, cull_dist: Double, class_mask: Int) -> Unit !{IO} =
  gfx_draw_instances_masked(group_count, cull_dist, class_mask)

# Load an animation set (glTF/GLB/IQM/M3D) whose skeleton matches a model; returns
# a set handle. A clip is identified by (set, index); animation_count gives how many.
export fn load_animations(path: String) -> Int !{IO} =
  gfx_load_animations(path)

export fn animation_count(set: Int) -> Int !{IO} =
  gfx_animation_count(set)

# Keyframe count of a clip — the modulus for looping the playhead (see anim_advance).
export fn animation_keyframes(set: Int, index: Int) -> Int !{IO} =
  gfx_animation_keyframes(set, index)

# Pose a model to clip (set, index) at the given frame; fractional frames interpolate.
export fn update_animation(model: Int, set: Int, index: Int, frame: Double) -> Unit !{IO} =
  gfx_update_animation(model, set, index, frame)

# Draw raylib's built-in FPS counter at screen pixel (x, y). Call inside a frame
# (between frame_begin and frame_end); it renders as a 2D overlay over the scene.
export fn draw_fps(x: Int, y: Int) -> Unit !{IO} =
  gfx_draw_fps(x, y)

# True on the frame the Space key is pressed (edge-triggered — one True per
# press, not while held). Suited to toggles.
export fn space_pressed() -> Bool !{IO} =
  do
    flag <- gfx_space_pressed()
    flag == 1

# --- Raw per-frame input, for direct-manipulation camera control ------------
# These read live device state each frame (held keys/buttons, wheel, mouse
# position/delta), which the GUI-button widgets and term_* cannot express. Held
# state (not edge), so a caller drives continuous motion while input is held.

# raylib key codes (a small subset — extend as needed). Exposed as constants so
# call sites read `gfx.key_w` instead of a bare magic number.
export let key_w = 87
export let key_a = 65
export let key_s = 83
export let key_d = 68
export let key_left_shift = 340
# raylib mouse-button codes.
export let mouse_left = 0
export let mouse_right = 1

# True while `key` (a gfx.key_* code) is held down.
export fn key_down(key: Int) -> Bool !{IO} =
  do
    d <- gfx_key_down(key)
    d == 1

# True while mouse `button` (a gfx.mouse_* code) is held down.
export fn mouse_button_down(button: Int) -> Bool !{IO} =
  do
    d <- gfx_mouse_button_down(button)
    d == 1

# Vertical scroll this frame (wheel notches, or trackpad two-finger scroll).
# Positive = scroll up. Uses the vector wheel internally so a Mac trackpad's
# blended X/Y scroll reports vertical intent correctly.
export fn mouse_wheel_y() -> Double !{IO} =
  gfx_mouse_wheel_y()

# Mouse movement since the previous frame, in pixels (x = right, y = down).
export fn mouse_delta_x() -> Double !{IO} =
  gfx_mouse_delta_x()

export fn mouse_delta_y() -> Double !{IO} =
  gfx_mouse_delta_y()

# Mouse cursor position in window pixels — to gate a drag against a screen region.
export fn mouse_x() -> Int !{IO} =
  gfx_mouse_x()

export fn mouse_y() -> Int !{IO} =
  gfx_mouse_y()

# Immediate-mode button: draw a labelled box (2D overlay, inside a frame) and
# return True on the frame it is left-clicked. Draw and hit-test are one call —
# `clicked <- button(x, y, w, h, "+")`.
export fn button(x: Int, y: Int, w: Int, h: Int, label: String) -> Bool !{IO} =
  do
    clicked <- gfx_button(x, y, w, h, label)
    clicked == 1

# Held variant of `button`: True on EVERY frame the box is held down (not edge-
# triggered), so holding it repeats an action smoothly. Suited to continuous
# camera control — rotate/pan/zoom nudge each frame while pressed.
export fn button_held(x: Int, y: Int, w: Int, h: Int, label: String) -> Bool !{IO} =
  do
    held <- gfx_button_held(x, y, w, h, label)
    held == 1

export fn frame_end() -> Unit !{IO} =
  gfx_frame_end()

# --- Post-processing (opt-in full-screen effects) ---------------------------
# Effects are OFF by default; each setter below turns ONE on and configures it,
# so a demo opts in à la carte (e.g. call post_vignette + post_tonemap in main).
# With any effect enabled the shim renders the 3D scene into an off-screen target
# and presents it through one full-screen shader; with none, it draws straight to
# the window (unchanged, and keeps 4x MSAA). See docs/gfx-postprocess-v0.md.
#
# NB: the 2D overlays (draw_fps, button/_held) are drawn INTO the scene between
# frame_begin and frame_end, so they are post-processed too (a first-cut tradeoff;
# UI-crisp-on-top is the documented Phase-2 follow-up).

# Darken the frame toward the corners. `intensity` 0..1 (0 = none, 1 = corners to
# black); `radius` 0..1 is the normalised centre→corner distance where darkening
# begins (smaller = larger dark border). Focuses the eye on the map centre.
export fn post_vignette(intensity: Double, radius: Double) -> Unit !{IO} =
  gfx_post_vignette(intensity, radius)

# Filmic tone-map (ACES) with pre-exposure and a saturation grade. `exposure` scales scene
# brightness before the curve (1.0 = neutral; >1 brightens, then highlights roll off instead of
# clipping — tames blown-out sky/water glints and enriches midtone contrast). `saturation` grades
# the result: 1.0 = neutral, >1 = punchier colour (counters ACES' highlight desaturation), <1 =
# toward greyscale. Saturation is the most VISIBLE knob on a mostly-midtone scene.
export fn post_tonemap(exposure: Double, saturation: Double) -> Unit !{IO} =
  gfx_post_tonemap(exposure, saturation)

# Additive bloom: a blurred bright-pass composited over the scene, so emissive pixels (stars) bleed a
# soft glow. `threshold` is the luminance (0..~1) above which a pixel contributes to the glow (lower =
# more of the scene blooms); `intensity` scales the added glow (1.0 = full, 0 = none). Enables the
# off-screen post path, which trades the window's MSAA — pair with `supersample(2)` if edges alias.
# Over a dark backdrop (a starfield) it reads as a star halo; this is the LDR approximation of PBR
# bloom (a thresholdless HDR version awaits an RGBA16F target). See docs/gfx-effects-roadmap-v0.md #5.
export fn post_bloom(threshold: Double, intensity: Double) -> Unit !{IO} =
  gfx_post_bloom(threshold, intensity)

# Blur that scales with camera motion. Both args are a unitless "amount" (~0.5 reads as
# clearly soft, 1.0 strong; the shim maps amount -> ~6 px of kernel radius). `static_amount`
# is the constant softness while the camera is still (0 = sharp); `motion_gain` adds amount
# per world-unit of per-frame camera travel, so the view softens while orbiting/zooming and
# snaps back to `static_amount` at rest. Total amount is clamped so a fast whip can't smear to
# mush. NB: amounts below ~0.15 are sub-pixel and invisible (they sample the same texel).
export fn post_motion_blur(static_amount: Double, motion_gain: Double) -> Unit !{IO} =
  gfx_post_motion_blur(static_amount, motion_gain)

# Drive the blur baseline from camera ALTITUDE (eye height) instead of a constant: height in
# [low_alt, high_alt] maps linearly to a blur amount in [amt_low, amt_high] (clamped outside).
# amt_high > amt_low blurs the high overview (haze); swap them to blur when low. Motion blur, if
# also set, still adds on top. To combine both, call post_motion_blur FIRST (it clears any altitude
# map), then post_altitude_blur (it keeps the motion gain). Enables the blur effect.
export fn post_altitude_blur(low_alt: Double, high_alt: Double, amt_low: Double, amt_high: Double) -> Unit !{IO} =
  gfx_post_altitude_blur(low_alt, high_alt, amt_low, amt_high)

# Turn ALL post-effects off, restoring the direct-to-screen (MSAA) render.
export fn post_disable() -> Unit !{IO} =
  gfx_post_disable()

# Exponential distance fog — the cheapest cohesion/atmosphere cue (roadmap #1). `density` is the
# Beer-Lambert coefficient (fog = 1 - exp(-density * view_depth)); 0 disables it. The colour is RGB
# 0..255, usually a pale sky/haze tone; the background clears to it too, so distant terrain fades
# into the horizon with no visible edge. Applied in the SCENE shaders (independent of the post pass
# and of MSAA), so it works with or without post-processing. Set once at setup.
# Tip: half the scene fades to fog at ~0.69/density view units — e.g. density 0.002 ≈ 350-unit half.
export fn fog(density: Double, r: Int, g: Int, b: Int) -> Unit !{IO} =
  gfx_fog(density, r, g, b)

# Supersampling anti-aliasing. Render the scene at `factor`× the window resolution, then downsample
# on present — the honest fix for the minification "shimmer/crawl" of high-frequency tile terrain
# during camera motion (MSAA can't touch that; it only smooths silhouettes). `factor` 1 = off
# (direct render, keeps MSAA); 2 = the sweet spot (~4× fragments, cheap on a light scene). Set once
# at setup. Composes with post effects and fog. Trades the window's 4× MSAA for higher-quality SSAA.
export fn supersample(factor: Int) -> Unit !{IO} =
  gfx_supersample(factor)

# Mark the scene -> HUD transition so UI draws CRISP on top of the post-processed scene (unblurred,
# unvignetted). Call AFTER the 3D draws and BEFORE the UI (draw_fps / button / button_held), then
# frame_end. Without it, UI is drawn into the scene and post-processed too. Harmless without any
# effect enabled (UI is crisp either way). Once per frame.
export fn overlay_begin() -> Unit !{IO} =
  gfx_overlay_begin()

export fn close_window() -> Unit !{IO} =
  gfx_close_window()

# --- Galaxy-map primitives (large-scale scenes, point clouds, picking, HUD text) ---

# Override the projection near/far clip planes (raylib defaults 0.01 / 1000). A scene that spans tens
# of thousands of world units — e.g. a ~100k-light-year galaxy — clips to black under the default far
# plane, so push it out (near small, far large). Persists; call once after open_window.
export fn set_clip_planes(near_plane: Double, far_plane: Double) -> Unit !{IO} =
  gfx_set_clip_planes(near_plane, far_plane)

# Create a uniformly-coloured unit-radius sphere model and return its handle (same registry as
# load_model). For instancing a starfield: draw_instances colours per MODEL (not per instance), so
# make one sphere per star class and vary per-star size via the instance_push `scale`. The handle of
# the first sphere_model created is 0, the next 1, … — create them in class order so handle == class
# code. Call after open_window (it uploads a mesh to the GPU).
export fn sphere_model(r: Int, g: Int, b: Int) -> Int !{IO} =
  gfx_sphere_model(r, g, b)

# Like sphere_model, but the sphere is EMISSIVE (self-luminous): draw_instances renders it full-bright
# with no key-light shading, so it reads as a glowing star rather than a matte shaded ball. This is
# the starfield primitive — one per spectral class, handle == class code, per-star size via the
# instance_push `scale`, exactly like sphere_model. Emissiveness only takes effect for handles in the
# instanced range (< 64). Call after open_window.
export fn star_model(r: Int, g: Int, b: Int) -> Int !{IO} =
  gfx_star_model(r, g, b)

# Project a world point to 2D screen pixels against the current camera, for click-picking. Returns
# True if the point is in front of the camera — then projected_x()/projected_y() hold its screen
# coords; False if behind (coords meaningless). Usage: on a click, project each candidate point and
# pick the one whose (projected_x, projected_y) is nearest the mouse within a pixel radius.
export fn world_to_screen(x: Double, y: Double, z: Double) -> Bool !{IO} =
  do
    front <- gfx_world_to_screen(x, y, z)
    front == 1

# Screen coords cached by the most recent world_to_screen call (only meaningful when it returned True).
export fn projected_x() -> Double !{IO} = gfx_projected_x()
export fn projected_y() -> Double !{IO} = gfx_projected_y()

# Draw a line of text at screen pixel (x, y), `size` px tall, in flat RGB (each 0..255). A 2D overlay
# like draw_fps/button — call inside a frame (ideally after overlay_begin for a crisp HUD). The
# default raylib font is ASCII; keep text to basic Latin.
export fn draw_text(x: Int, y: Int, text: String, size: Int, r: Int, g: Int, b: Int) -> Unit !{IO} =
  gfx_draw_text(x, y, text, size, r, g, b)

# Draw a filled `w` x `h` rectangle at screen pixel (x, y) in flat RGB (each 0..255). A 2D overlay
# like draw_text — call inside a frame (after overlay_begin for a crisp HUD). Used for the galaxy
# map's spectral-class legend swatches / checkbox boxes.
export fn draw_rect(x: Int, y: Int, w: Int, h: Int, r: Int, g: Int, b: Int) -> Unit !{IO} =
  gfx_draw_rect(x, y, w, h, r, g, b)

# Floor a Double to an Int. Stopgap for a missing core primitive (stdlib has no Double->Int; math.floor
# returns a Double) — the galaxy map bins world coords into integer tile indices. Pure. See BACKLOG:
# promote to a core runtime/prelude builtin.
export fn double_to_int(d: Double) -> Int =
  gfx_double_to_int(d)
