module stdlib.rng

import stdlib.bits

# Deterministic seeded pseudo-random numbers — a linear congruential generator
# (LCG). Same seed produces the same sequence on every target, so it suits
# simulations, sampling, shuffling, jitter, and property tests where
# reproducibility matters. It is NOT cryptographic: the stream is fully
# predictable from any output. For unpredictable bytes use crypto.random_bytes.
#
# Any Int is a valid state. It is reduced mod 2^31 first, so seeds equal mod 2^31 give
# the same stream. To derive a well-spread seed from a 64-bit value, hash it with
# `rng_hash2` rather than relying on that truncation. One step is the classic recurrence
#   state' = (A * state + C) mod M      M = 2^31, A = 1103515245, C = 12345
# The reduced state keeps A * state < 2^62 < 2^63, so the multiply never overflows an
# i64 — the stream is identical regardless of a target's integer-overflow semantics.

let rng_modulus = 2147483648  # 2^31
let rng_mult = 1103515245
let rng_incr = 12345
let rng_mask = 2147483647  # 2^31 - 1

# High-bit shift: the low bits of an LCG cycle with short periods, so rng_below
# derives values from the upper bits (drop the low 16). 2^16 = 65536.
let rng_high_shift = 65536

# Non-negative modulo. Sprout has no `%` operator; for a, b >= 0 the remainder is
# a - (a / b) * b (integer `/` truncates toward zero).
fn imod(a: Int, b: Int) -> Int = a - ((a / b) * b)

# The non-negative residue mod 2^31 for any Int (two's complement): one `and`. Same values
# as `imod` plus a sign fix, for every Int. O(1).
fn rng_mod(a: Int) -> Int = bit_and(a, rng_mask)

# Advance the generator one step. Pure: threading the returned state is how a
# caller draws successive values. Accepts any Int state. O(1).
export fn rng_next(state: Int) -> Int =
  rng_mod((rng_mult * rng_mod(state)) + rng_incr)

# A value in [0, n) derived from `state`, taken from its high bits for better
# uniformity than a raw `state mod n`. Total: n <= 0 yields 0. O(1).
# Draws from 15 bits (state / 65536 < 32768): n > 32768 is not covered, and an n that
# does not divide 32768 is slightly biased.
export fn rng_below(state: Int, n: Int) -> Int =
  if n <= 0 then 0 else imod(rng_mod(state) / rng_high_shift, n)

# The two large primes that decorrelate the x and z axes of a spatial hash (the classic
# Perlin lattice constants). Distinct primes so the two coordinates never share a stride.
let rng_hash_px = 73856093
let rng_hash_pz = 19349663

# A stateless 2D spatial hash: a pure Int hash of a coordinate pair, uniform in
# [0, rng_modulus). Suits value/Perlin noise, spatial hashing, and per-cell jitter — any
# place that needs a repeatable "random" value AT a coordinate rather than a threaded stream.
#
# It is a HASH, not an iterated generator: the value at a point must not depend on draw order,
# and — crucially — evenly-spaced coordinates must not produce evenly-spaced outputs. A single
# `rng_next` step cannot do this: it is affine (A * x + C mod 2^31), so a coordinate progression
# maps to an output progression, and for these primes A * rng_hash_pz mod 2^31 ~= (3/5) * 2^31 —
# meaning hash(x, z+5) ~= hash(x, z). That short spatial period renders as tiled, "copy-pasted"
# noise. The final step multiplies the two coordinate-hashes together (`s1 * (2*s2+1)`), a mix
# that is NONLINEAR in the coordinates, which breaks the resonance. Both factors are reduced
# below rng_modulus first, so the product stays < 2^62 and never overflows i64.
#
# Coordinates may be any Int; negatives are handled. O(1).
#
# Every operand of a multiply or add is below 2^31 (`rng_next` reduces its own input), so each
# product stays below 2^62 and nothing here can leave i64. That is a pure guard, not a change of
# function: reducing a factor or an addend leaves the result's residue alone, so no hash value
# moves — `tests/stdlib/test_rng.spr` pins the same reference hashes across this change. The
# reduced coordinate term is at most 2^31 * 73856093 < 2^58.
#
# Reducing afterwards was enough while overflow wrapped, because the wrap was itself a mod
# 2^64 and the residue survived it. Under trapping arithmetic (bigint-v0 Stage 1) it is not:
# a seed within `rng_hash_px` of MAX_INT, or a coordinate past ~1.25e11, aborted the process.
# The coordinate magnitude had been a documented assumption rather than an enforced one,
# which is the weakest form a precondition can take once breaking it is fatal.
export fn rng_hash2(ix: Int, iz: Int, seed: Int) -> Int =
  let s1 = rng_next(rng_mod(seed) + (rng_mod(ix) * rng_hash_px))
      s2 = rng_next(s1 + (rng_mod(iz) * rng_hash_pz))
  in rng_next(s1 * rng_mod((2 * s2) + 1))
