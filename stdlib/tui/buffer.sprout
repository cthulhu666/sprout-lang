module stdlib.tui.buffer

# The document behind `text_area`: the lines above, the line being edited, the
# lines below. Design: docs/tui-text-area-v0.md §4.1.
#
# `above` is reversed, so moving between adjacent lines is a head operation on
# both sides — the same trick the line zipper plays on clusters, one level up.

import stdlib.string as string
import stdlib.tui.line_zipper as lz

# `goal` is the display column a vertical move is trying to return to (§4.7).
#
# GOAL INVARIANT — `landed` is the only place that INTRODUCES one. A vertical
# move carries whatever is there, including when it is blocked; everything else
# constructs `Fields` with `Nothing`, blocked or not. Clearing on a blocked
# vertical move forfeits the column; keeping it on a horizontal one drags the
# caret back to a column the reader left several keystrokes ago.
type Fields = (above: List String, line: lz.Zipper, below: List String,
               goal: Maybe Int)

# Opaque: a single-constructor ADT declared without `(..)`, so `Fields` can
# grow a selection anchor later without breaking a caller (§4.9). A record
# would be transparent whatever its declaration said.
export type Buffer =
  | Buf Fields

fn fields(b: Buffer) -> Fields =
  match b with
  | Buf f -> f

# ── opening and reading ─────────────────────────────────────────────────────

export fn buffer_open(s: String) -> Buffer =
  opened_at(split_lines(s))

fn opened_at(ls: List String) -> Buffer =
  match list_reverse(ls) with
  | Nil -> Buf (Fields(above = Nil, line = lz.zipper_empty(), below = Nil,
                      goal = Nothing))
  | [last | rest] -> Buf (Fields(above = rest, line = lz.zipper_open(last),
                                below = Nil, goal = Nothing))

# Split on LF, CRLF and a lone CR (§4.4), then flatten what is left: blanking
# CR as a control character instead would put a trailing space on every line of
# every Windows paste.
fn split_lines(s: String) -> List String =
  list_map(lz.flatten, string.split(normalized(s), "\n"))

fn normalized(s: String) -> String =
  string.replace_all("\r", "\n", string.replace_all("\r\n", "\n", s))

export fn buffer_lines(b: Buffer) -> List String = all_lines(fields(b))

# A position in the document. A record rather than two adjacent `Int`s, which
# swap silently — and because both axes clamp, a swapped pair would land a
# plausible caret in the wrong place instead of failing (guidelines §3).
export type Caret = (row: Int, col: Int) deriving (Eq, Ord, ToString)

export fn buffer_caret(b: Buffer) -> Caret =
  Caret(row = buffer_row(b), col = buffer_col(b))

# The caret at `c`, each axis clamped into the document. The text does not
# move; only the caret does. `buffer_goto(buffer_caret(old), new)` is the whole
# point: a caret carried into a file being reopened
# (docs/tui-content-update-v0.md §9.3).
export fn buffer_goto(c: Caret, b: Buffer) -> Buffer =
  walked(c.col, c.row, all_lines(fields(b)), Nil)

fn walked(col: Int, n: Int, rest: List String, above: List String) -> Buffer =
  match rest with
  # Past the last line: back onto it rather than inventing an empty one, which
  # would put a trailing newline in a document nobody edited.
  | Nil -> backed_onto(col, above)
  | [here | below] ->
      if n <= 0 then landed_at(col, here, above, below)
      else walked(col, n - 1, below, Cons(here, above))

fn backed_onto(col: Int, above: List String) -> Buffer =
  match above with
  | Nil -> landed_at(col, "", Nil, Nil)
  | [last | rest] -> landed_at(col, last, rest, Nil)

fn landed_at(col: Int, here: String, above: List String,
             below: List String) -> Buffer =
  Buf(Fields(above = above, line = lz.zipper_at(col, lz.zipper_open(here)),
              below = below, goal = Nothing))

fn all_lines(f: Fields) -> List String =
  list_append(list_reverse(f.above), Cons(lz.zipper_text(f.line), f.below))

# §4.8 pins the join: `\n` between lines, no trailing terminator, `""` when
# empty. Every application mirrors this value, so an ambiguity here becomes N
# incompatible mirrors.
export fn buffer_text(b: Buffer) -> String =
  string.join("\n", all_lines(b |> fields))

export fn buffer_row(b: Buffer) -> Int = list_length(fields(b).above)

export fn buffer_col(b: Buffer) -> Int = lz.zipper_col(fields(b).line)

# The line the caret is on, read directly rather than indexed out of
# `buffer_lines`, which costs a walk of the whole document.
export fn buffer_line(b: Buffer) -> String = lz.zipper_text(fields(b).line)

# ── editing ─────────────────────────────────────────────────────────────────

# `Nothing` when nothing changed, so the widget can tell "I claimed the key but
# the value stands" from "I changed the document".
export fn buffer_insert(s: String, b: Buffer) -> Maybe Buffer =
  if string.is_empty(s) then Nothing
  else Just(inserted(fields(b), split_lines(s)))

# Several segments cannot be applied one at a time: the first would re-segment
# against text the next break is about to move to another line, and the caret
# would round back in front of it, splitting the line in the wrong place. The
# caret's two halves are taken once, up front.
fn inserted(f: Fields, segs: List String) -> Buffer =
  match segs with
  | Nil -> Buf((f with (goal = Nothing)))
  | [only] -> Buf(extended(f, only))
  | [first | rest] ->
      broken_at(f, lz.zipper_before_text(f.line) ++ first, rest,
                lz.zipper_after_text(f.line))

fn extended(f: Fields, seg: String) -> Fields =
  (f with (line = maybe_with_default(f.line, lz.zipper_insert(seg, f.line)),
           goal = Nothing))

# `done` is a finished line. Every segment but the last completes one; the last
# starts the line the caret ends on and keeps what followed the caret.
fn broken_at(f: Fields, done: String, rest: List String,
             tail: String) -> Buffer =
  match rest with
  | Nil -> Buf (Fields(above = f.above, line = restarted(done, tail),
                      below = f.below, goal = Nothing))
  | [next | more] ->
      broken_at((f with (above = Cons(done, f.above))), next, more, tail)

fn restarted(head: String, tail: String) -> lz.Zipper =
  maybe_with_default(fresh, lz.zipper_insert(head, fresh))
where
  fresh = lz.zipper_open(tail) |> lz.zipper_start

export fn buffer_backspace(b: Buffer) -> Maybe Buffer =
  backspaced(fields(b))

fn backspaced(f: Fields) -> Maybe Buffer =
  if lz.zipper_is_at_start(f.line) then joined_above(f)
  else map(with_line(f, _), lz.zipper_backspace(f.line))

fn with_line(f: Fields, z: lz.Zipper) -> Buffer =
  Buf(Fields(above = f.above, line = z, below = f.below, goal = Nothing))

# The caret lands at the seam, which is the end of what used to be the line
# above — so the join is visible without moving the eye.
fn joined_above(f: Fields) -> Maybe Buffer =
  match f.above with
  | Nil -> Nothing
  | [prev | rest] ->
      Just(Buf (Fields(above = rest,
                      line = seamed(prev, lz.zipper_text(f.line)),
                      below = f.below, goal = Nothing)))

fn seamed(head: String, tail: String) -> lz.Zipper =
  lz.zipper_to_display_col(lz.zipper_display_col(lz.zipper_open(head)),
                           lz.zipper_open(head ++ tail))

export fn buffer_delete(b: Buffer) -> Maybe Buffer =
  deleted(fields(b))

fn deleted(f: Fields) -> Maybe Buffer =
  if lz.zipper_is_at_end(f.line) then pulled_up(f)
  else map(with_line(f, _), lz.zipper_delete(f.line))

fn pulled_up(f: Fields) -> Maybe Buffer =
  match f.below with
  | Nil -> Nothing
  | [next | rest] ->
      Just(Buf (Fields(above = f.above,
                      line = seamed(lz.zipper_text(f.line), next),
                      below = rest, goal = Nothing)))

# ── moving ──────────────────────────────────────────────────────────────────

export fn buffer_left(b: Buffer) -> Buffer = stepped_left(fields(b))

fn stepped_left(f: Fields) -> Buffer =
  if lz.zipper_is_at_start(f.line) then wrapped_up(f)
  else Buf(Fields(above = f.above, line = lz.zipper_left(f.line),
                  below = f.below, goal = Nothing))

# A move with nowhere to go is still a horizontal move, so it still clears the
# goal — leaving it set sends the next vertical move to a column the reader has
# already left.
fn wrapped_up(f: Fields) -> Buffer =
  match f.above with
  | Nil -> Buf((f with (goal = Nothing)))
  | [prev | rest] ->
      Buf(Fields(above = rest, line = lz.zipper_open(prev),
                 below = Cons(lz.zipper_text(f.line), f.below),
                 goal = Nothing))

export fn buffer_right(b: Buffer) -> Buffer = stepped_right(fields(b))

fn stepped_right(f: Fields) -> Buffer =
  if lz.zipper_is_at_end(f.line) then wrapped_down(f)
  else Buf(Fields(above = f.above, line = lz.zipper_right(f.line),
                  below = f.below, goal = Nothing))

fn wrapped_down(f: Fields) -> Buffer =
  match f.below with
  | Nil -> Buf((f with (goal = Nothing)))
  | [next | rest] ->
      Buf(Fields(above = Cons(lz.zipper_text(f.line), f.above),
                 line = lz.zipper_open(next) |> lz.zipper_start, below = rest,
                 goal = Nothing))

export fn buffer_home(b: Buffer) -> Buffer = anchored(fields(b), lz.zipper_start)

export fn buffer_end(b: Buffer) -> Buffer = anchored(fields(b), lz.zipper_end)

fn anchored(f: Fields, to: lz.Zipper -> lz.Zipper) -> Buffer =
  Buf(Fields(above = f.above, line = to(f.line), below = f.below,
             goal = Nothing))

export fn buffer_up(b: Buffer) -> Buffer = moved_up(fields(b))

fn moved_up(f: Fields) -> Buffer =
  match f.above with
  | Nil -> Buf(f)
  | [prev | rest] ->
      landed(prev, rest, Cons(lz.zipper_text(f.line), f.below), goal_of(f))

export fn buffer_down(b: Buffer) -> Buffer = moved_down(fields(b))

fn moved_down(f: Fields) -> Buffer =
  match f.below with
  | Nil -> Buf(f)
  | [next | rest] ->
      landed(next, Cons(lz.zipper_text(f.line), f.above), rest, goal_of(f))

# The goal is taken from the caret only on the FIRST vertical move; after that
# it is carried, which is what a run of Downs through short lines needs.
fn goal_of(f: Fields) -> Int =
  maybe_with_default(lz.zipper_display_col(f.line), f.goal)

fn landed(target: String, above: List String, below: List String,
          goal: Int) -> Buffer =
  Buf(Fields(above = above,
             line = lz.zipper_to_display_col(goal, lz.zipper_open(target)),
             below = below, goal = Just(goal)))
