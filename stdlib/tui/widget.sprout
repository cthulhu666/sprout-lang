module stdlib.tui.widget

# The widget box: private state, shared message vocabulary. Design:
# docs/tui-widgets-v0.md §3.1.
#
# Everything here except `render` is a total function over values, so a widget
# is testable without a terminal — which is the reason `on_event` and `measure`
# are pure and only painting is `!{IO}`.

import stdlib.string as string
import stdlib.tui.event as event
import stdlib.tui.geometry as geometry
import stdlib.tui.screen as screen

# Every widget ID, keybinding and plugin key is a String underneath, because
# `Dict` and `Set` are String-keyed only. Decided up front rather than
# retrofitted; docs/tui-widgets-v0.md §3.7.
export wrap WidgetId = String

export fn id_text(i: WidgetId) -> String =
  match i with
  | WidgetId s -> s

export fn id_eq(a: WidgetId, b: WidgetId) -> Bool = id_text(a) == id_text(b)

# What travels DOWN to one addressed widget, as opposed to `on_event`, which
# broadcasts to every widget in the tree. A message is a command's answer
# coming home; an event is a keystroke going to whoever holds focus. One sum
# rather than two entry points, so the widget contract opens once.
export type Delivery m (..) =
  | ToMsg m
  | ToEvent event.Event

# A unit of IO that a widget or application WANTS performed, but does not
# perform. Pure code builds one; only the app loop runs it, in a task of its
# own, so a slow read cannot stall the frame. The `Maybe WidgetId` is the
# return address: `Just id` delivers the answer back to that widget.
#
# A newtype over a concrete `!{IO}` arrow rather than an effect-polymorphic
# field: an `!{e}` field is erased when the record is constructed, which lets
# IO run inside a function the checker still believes is pure.
export type Cmd m (..) =
  | Cmd (Maybe WidgetId) (Unit -> m !{IO})

# Work whose answer belongs to the application: quit, reload everything.
export fn cmd(f: Unit -> m !{IO}) -> Cmd m = Cmd(Nothing, f)

# Work whose answer belongs to the widget that asked for it.
export fn cmd_to(id: WidgetId, f: Unit -> m !{IO}) -> Cmd m = Cmd(Just(id), f)

export fn cmd_addr(c: Cmd m) -> Maybe WidgetId =
  match c with
  | Cmd a _ -> a

# Perform the work. The app loop calls this and nothing else does.
export fn cmd_run(c: Cmd m) -> m !{IO} =
  match c with
  | Cmd _ f -> f(())

# Retarget a command's result, so an embedded widget's work reports in the
# embedding application's vocabulary. Pure: it composes thunks, runs neither.
# The address rides through unchanged — retargeting what an answer SAYS must
# not change who it is FOR.
export fn cmd_map(f: m -> n, c: Cmd m) -> Cmd n =
  match c with
  | Cmd a g -> Cmd(a, cmd_mapped(f, g, _))

fn cmd_mapped(f: m -> n, g: Unit -> m !{IO}, u: Unit) -> n !{IO} = do
  x <- g(())
  f(x)

# Retarget a command's RETURN ADDRESS, leaving what it says alone — the exact
# complement of `cmd_map`. A namespacing wrapper needs it: the answer must come
# back to the qualified id, not the bare one the inner widget knows itself by.
# An application-global command has no address and stays global.
export fn cmd_readdress(f: WidgetId -> WidgetId, c: Cmd m) -> Cmd m =
  match c with
  | Cmd a g -> Cmd(map(f, a), g)

# Whether a widget wants a size, or wants whatever is left. A `Size` cannot say
# the second: every number in that vocabulary reads as a demand, and `solve`
# pays fixed asks before fractions — so "I yield" spelled as a large number
# becomes "I demand everything" and starves the siblings it meant to yield to.
# Design: docs/tui-widget-set-v0.md §4.3.
export type Grow (..) deriving (Eq, ToString) =
  | Fixed
  | Greedy

# What `measure` answers: a natural size, plus how the widget grows on each
# axis. A container turns `Greedy` into `layout.Fraction` and `Fixed` into
# `layout.Auto`.
export type Measured = (size: geometry.Size, cols: Grow, rows: Grow)

# The leaf spelling — a widget with a definite size and nothing to say about
# growth, which is most of them.
export fn fixed_size(sz: geometry.Size) -> Measured =
  Measured(size = sz, cols = Fixed, rows = Fixed)

# The other leaf spelling: a widget that fills what it is given on both axes,
# such as a log pane. `sz` is its size if nothing is left to divide.
export fn greedy_size(sz: geometry.Size) -> Measured =
  Measured(size = sz, cols = Greedy, rows = Greedy)

# The five things a widget can do, over its own state type. `on_event`
# broadcasts, `route` is addressed; both are pure, asking for IO with a `Cmd`
# rather than performing any, which is what keeps a widget testable and the
# loop responsive.
#
# `route` answers `Nothing` when the delivery was not this widget's. Declining
# and handling-without-change are indistinguishable from outside, so the
# distinction has to be in the reply — and as `Maybe` rather than a flag beside
# the state, a decline cannot also carry a state, a message or a command that
# the caller would have to be trusted to discard.
export type View s m = (
  state: s,
  on_event: s -> event.Event -> (s, List m, List (Cmd m)),
  route: s -> WidgetId -> Delivery m -> Maybe(s, List m, List (Cmd m)),
  render: s -> geometry.Region -> screen.Screen -> Unit !{IO},
  measure: s -> geometry.Size -> Measured
)

# A widget nothing is ever addressed to — every leaf until it wants a command
# of its own. Declines everything, so an undeliverable answer reaches the
# application instead of disappearing here.
export fn no_route(st: s, target: WidgetId,
                   d: Delivery m) -> Maybe(s, List m, List (Cmd m)) =
  Nothing

# The leaf spelling: handle a delivery addressed to `mine`. Applied with `_`
# holes as a field value, since the field wants the last three arguments.
#
# The claim is by ADDRESS, not by what the handler did: an answer arriving at
# the widget that asked for it has got home whether or not the state moved.
export fn route_if(mine: WidgetId,
                   handler: s -> Delivery m -> (s, List m, List (Cmd m)),
                   st: s, target: WidgetId,
                   d: Delivery m) -> Maybe(s, List m, List (Cmd m)) =
  if id_eq(mine, target) then Just(handler(st, d)) else Nothing

# The other half: the claim is the HANDLER's to make, not the address's. A
# focused widget that ignores a keystroke must let it fall back to `update`,
# which `route_if` cannot express — it has got home either way, which is right
# for a command's answer and wrong for a key.
export fn route_when(mine: WidgetId,
                     handler: s -> Delivery m -> Maybe(s, List m, List (Cmd m)),
                     st: s, target: WidgetId,
                     d: Delivery m) -> Maybe(s, List m, List (Cmd m)) =
  if id_eq(mine, target) then handler(st, d) else Nothing

# `s` is EXISTENTIAL and `m` is UNIVERSAL, which is the whole design: a text
# input and a tree sit in one `List (Widget AppMsg)` with neither able to see
# the other's state, while both speak the one vocabulary the application
# declared. `exists` rather than `any C` because the hidden variable spans four
# fields and `any C` is single-field sugar.
export type Widget m (..) =
  | exists s. Widget (View s m)

# Hand one event to a widget: the box comes back rebuilt around its new state,
# still hiding the same type, plus what it wants to say and what it wants done.
export fn on_event(w: Widget m, ev: event.Event) -> (Widget m, List m, List (Cmd m)) =
  match w with
  | Widget v -> repack(v, v.on_event(v.state, ev))

# Repacking is a separate function because the skolem `s` is only in scope
# under the `Widget v` pattern; naming it here keeps `on_event` one line and
# the existential's scope obvious.
fn repack(v: View s m,
          r: (s, List m, List (Cmd m))) -> (Widget m, List m, List (Cmd m)) =
  match r with
  | (s2, msgs, cmds) -> (Widget(v with (state = s2)), msgs, cmds)

# Fold a batch of events in order, concatenating what each one said and asked
# for. One read
# of the terminal yields several events, and they must be applied in arrival
# order — a widget's reply depends on the state the previous event left.
export fn feed(w: Widget m,
               evs: List event.Event) -> (Widget m, List m, List (Cmd m)) =
  feed_go(w, evs, Nil, Nil)

fn feed_go(w: Widget m, evs: List event.Event, msgs: List m,
           cmds: List (Cmd m)) -> (Widget m, List m, List (Cmd m)) =
  match evs with
  | Nil -> (w, list_reverse(msgs), list_reverse(cmds))
  | [e | rest] -> feed_step(on_event(w, e), rest, msgs, cmds)

fn feed_step(r: (Widget m, List m, List (Cmd m)), rest: List event.Event,
             msgs: List m,
             cmds: List (Cmd m)) -> (Widget m, List m, List (Cmd m)) =
  match r with
  | (w2, ms, cs) -> feed_go(w2, rest, push_all(ms, msgs), push_all(cs, cmds))

# Accumulate reversed and reverse once at the end, so a long batch is linear
# rather than quadratic in `++`.
fn push_all(xs: List a, acc: List a) -> List a =
  list_fold(\ (seen, x) -> Cons(x, seen), acc, xs)

# Hand one delivery to ONE widget, named. `Nothing` means nobody was home; a
# container forwards down and answers with whatever its children said, which is
# the only way an address can cross the existential — the framework cannot see
# through `Widget m` to know whether it holds children at all.
export fn deliver(w: Widget m, target: WidgetId,
                  d: Delivery m) -> Maybe (Widget m, List m, List (Cmd m)) =
  match w with
  | Widget v -> repack_route(v, v.route(v.state, target, d))

# The reply now has `on_event`'s shape under the `Maybe`, so repacking is the
# same function both paths already needed.
fn repack_route(v: View s m,
                r: Maybe (s, List m, List (Cmd m))) -> Maybe (Widget m, List m, List (Cmd m)) =
  match r with
  | Nothing -> Nothing
  | Just t -> Just(repack(v, t))

# The widget's natural size within `avail`, and how it grows.
export fn measure(w: Widget m, avail: geometry.Size) -> Measured =
  match w with
  | Widget v -> v.measure(v.state, avail)

# Paint into `r`. A widget is handed a region, never the whole screen, so
# composition is the caller's arithmetic and not the widget's concern.
export fn render(w: Widget m, r: geometry.Region, s: screen.Screen) -> Unit !{IO} =
  match w with
  | Widget v -> v.render(v.state, r, s)

# Retarget a widget's messages AND the results of its commands, so one written
# against its own vocabulary can be embedded in an application with a different
# one. This is what makes `m`
# universal rather than merely fixed: without it, a reusable widget would have
# to be written against the vocabulary of every application that used it.
#
# A PRISM, not a functor: `route` takes `m`, so a message must be translated
# backwards too, and `n -> m` does not exist. `unf` recognises the messages
# that belong to the embedded widget and rejects the rest — an embedder that
# tags with `ChildMsg` already owns that match. docs/tui-routing-v0.md §3.3.
export fn map_msgs(f: m -> n, unf: n -> Maybe m, w: Widget m) -> Widget n =
  match w with
  | Widget v -> Widget (View(state = v.state,
                            on_event = mapped_on_event(f, v.on_event, _, _),
                            route = mapped_route(f, unf, v.route, _, _, _),
                            render = v.render,
                            measure = v.measure))

fn mapped_route(f: m -> n, unf: n -> Maybe m,
                inner: s -> WidgetId -> Delivery m -> Maybe(s, List m, List (Cmd m)),
                st: s, target: WidgetId,
                d: Delivery n) -> Maybe(s, List n, List (Cmd n)) =
  match narrow(unf, d) with
  # A message in a vocabulary the embedded widget does not speak is not its
  # business. Declined rather than guessed at, so it still reaches the
  # application.
  | Nothing -> Nothing
  | Just inner_d -> remap(f, inner(st, target, inner_d))

# An event carries no message, so it crosses untouched; only `ToMsg` needs the
# prism's backward half.
fn narrow(unf: n -> Maybe m, d: Delivery n) -> Maybe (Delivery m) =
  match d with
  | ToEvent e -> Just(ToEvent(e))
  | ToMsg nm -> as_delivery(unf(nm))

fn as_delivery(r: Maybe m) -> Maybe (Delivery m) =
  match r with
  | Nothing -> Nothing
  | Just mm -> Just(ToMsg(mm))

fn remap(f: m -> n,
         r: Maybe (s, List m, List (Cmd m))) -> Maybe(s, List n, List (Cmd n)) =
  match r with
  | Nothing -> Nothing
  | Just t -> Just(remap_one(f, t))

# Applied above with `_` holes for the last two arguments, leaving
# `s -> Event -> (s, List n, List (Cmd n))` — the field's type. Sprout is
# n-ary, so the holes
# are how a partial application is spelled; a lambda would say the same thing
# but would be one in argument position, which the style guide rejects.
fn mapped_on_event(f: m -> n,
                   inner: s -> event.Event -> (s, List m, List (Cmd m)),
                   st: s, ev: event.Event) -> (s, List n, List (Cmd n)) =
  remap_one(f, inner(st, ev))

# Both replies have this shape, so both retargetings are this one function. The
# commands are retargeted alongside the messages: an embedded widget's work must
# report in the embedding vocabulary, or the outer app receives a message it
# cannot read.
fn remap_one(f: m -> n,
             r: (s, List m, List (Cmd m))) -> (s, List n, List (Cmd n)) =
  match r with
  | (s2, msgs, cmds) -> (s2, list_map(f, msgs), list_map(cmd_map(f, _), cmds))

# Qualify a widget's ids, so two copies of one widget can sit in one tree
# without answering to each other's address. Separate from `map_msgs` because
# a collision happens between two copies in ONE vocabulary too, where there is
# no message type to retarget. Nests, so a tree can qualify at every level.
#
# Both directions or neither: an incoming address loses the prefix on the way
# down, and an outgoing command's return address gains it on the way up. Half
# of that would deliver an answer to a name nothing outside the wrapper knows.
export fn namespaced(prefix: String, w: Widget m) -> Widget m =
  match w with
  | Widget v -> Widget (View(state = v.state,
                             on_event = namespaced_on_event(prefix, v.on_event, _, _),
                             route = namespaced_route(prefix, v.route, _, _, _),
                             render = v.render,
                             measure = v.measure))

# A prefix is a plain `String`, not a `WidgetId`: nothing is ever delivered to
# "panel", only to "panel.something".
fn namespace_sep() -> String = "."

fn qualify(prefix: String, i: WidgetId) -> WidgetId =
  WidgetId(prefix ++ namespace_sep() ++ id_text(i))

# `Nothing` when the address belongs elsewhere, which the wrapper declines
# rather than forwards — the inner widget must never see an address that was
# not meant for it.
fn unqualify(prefix: String, target: WidgetId) -> Maybe WidgetId =
  map(WidgetId, string.strip_prefix(id_text(target), prefix ++ namespace_sep()))

fn namespaced_on_event(prefix: String,
                       inner: s -> event.Event -> (s, List m, List (Cmd m)),
                       st: s, ev: event.Event) -> (s, List m, List (Cmd m)) =
  requalify(prefix, inner(st, ev))

fn namespaced_route(prefix: String,
                    inner: s -> WidgetId -> Delivery m -> Maybe(s, List m, List (Cmd m)),
                    st: s, target: WidgetId,
                    d: Delivery m) -> Maybe(s, List m, List (Cmd m)) =
  and_then(namespaced_deliver(prefix, inner, st, d, _), unqualify(prefix, target))

# Separate because `and_then` wants the stripped target last, and everything
# else the wrapper needs is already bound when an address arrives.
fn namespaced_deliver(prefix: String,
                      inner: s -> WidgetId -> Delivery m -> Maybe(s, List m, List (Cmd m)),
                      st: s, d: Delivery m,
                      target: WidgetId) -> Maybe(s, List m, List (Cmd m)) =
  map(requalify(prefix, _), inner(st, target, d))

# Only the commands move: a message carries no address, and the state is the
# inner widget's own.
fn requalify(prefix: String,
             r: (s, List m, List (Cmd m))) -> (s, List m, List (Cmd m)) =
  match r with
  | (s2, msgs, cmds) -> (s2, msgs, list_map(cmd_readdress(q, _), cmds))
where
  q = qualify(prefix, _)
