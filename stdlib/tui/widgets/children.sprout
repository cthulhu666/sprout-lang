module stdlib.tui.widgets.children

# The four traversals every container needs, over a bare child list, and
# `respan`, which puts their results back. Exported rather than buried in
# `container` because `scroll_view`, `tabs` and `tree` need the same, and an
# application writing a container with its own layout should not have to write
# another copy. Design: docs/tui-widget-set-v0.md §5.

import stdlib.tui.event as event
import stdlib.tui.geometry as geometry
import stdlib.tui.screen as scr
import stdlib.tui.widget as widget

# ── broadcast ───────────────────────────────────────────────────────────────

# Every child sees the event, in order, and their messages and commands are
# concatenated. A container forwards what its children ask for without knowing
# what any of it means.
export fn broadcast(evt: event.Event,
                    kids: List (widget.Widget m)) -> widget.Handled(List(widget.Widget m)) m =
  broadcast_go(evt, kids, list_builder_empty, list_builder_empty, list_builder_empty)

fn broadcast_go(evt: event.Event, ws: List (widget.Widget m),
                wacc: ListBuilder (widget.Widget m), macc: ListBuilder m,
                cacc: ListBuilder (widget.Cmd m)) -> widget.Handled(List(widget.Widget m)) m =
  match ws with
  | Nil -> (list_builder_build(wacc), list_builder_build(macc), list_builder_build(cacc))
  | [w | rest] -> broadcast_step(widget.on_event(w, evt), evt, rest, wacc, macc, cacc)

fn broadcast_step(r: widget.Handled (widget.Widget m) m,
                  evt: event.Event, rest: List (widget.Widget m),
                  wacc: ListBuilder (widget.Widget m), macc: ListBuilder m,
                  cacc: ListBuilder (widget.Cmd m)) -> widget.Handled(List(widget.Widget m)) m =
  match r with
  | (w2, msgs, cmds) ->
      broadcast_go(evt, rest, list_builder_add(w2, wacc), list_builder_extend(msgs, macc),
                   list_builder_extend(cmds, cacc))

# ── addressed delivery ──────────────────────────────────────────────────────

# An addressed delivery goes DOWN, not to everyone: try each child until one
# claims the address, and answer `Nothing` if none did, so an unclaimed answer
# still reaches `update`. Stopping at the first claimant makes a duplicated id
# resolve by tree order rather than delivering the same answer twice.
export fn deliver_first(target: widget.WidgetId, d: widget.Delivery m,
                        kids: List (widget.Widget m)) -> Maybe(widget.Handled(List(widget.Widget m)) m) =
  deliver_go(target, d, kids, Nil)

fn deliver_go(target: widget.WidgetId, d: widget.Delivery m,
              ws: List (widget.Widget m),
              seen: List (widget.Widget m)) -> Maybe(widget.Handled(List(widget.Widget m)) m) =
  match ws with
  | Nil -> Nothing
  | [w | rest] ->
      match widget.deliver(w, target, d) with
      | Nothing -> deliver_go(target, d, rest, Cons(w, seen))
      | Just claimed -> Just(deliver_hit(claimed, rest, seen))

# A child that declined is unchanged, so only the claimant is spliced back in.
fn deliver_hit(r: widget.Handled (widget.Widget m) m,
               rest: List (widget.Widget m),
               seen: List (widget.Widget m)) -> widget.Handled(List(widget.Widget m)) m =
  match r with
  | (w2, msgs, cmds) -> (list_append(list_reverse(Cons(w2, seen)), rest), msgs, cmds)

# ── putting them back ───────────────────────────────────────────────────────

# A traversal hands back bare children in order; `put` sets each back in the
# holder it came from — a slot, a tab — keeping the rest of the holder. The two
# lists are the same length by construction, since the caller built `ws` from
# `holders`, so a mismatch would be a bug there, not input.
export fn respan(put: a -> widget.Widget m -> a, holders: List a,
                 ws: List (widget.Widget m)) -> List a =
  respan_go(put, holders, ws, list_builder_empty)

fn respan_go(put: a -> widget.Widget m -> a, holders: List a,
             ws: List (widget.Widget m), acc: ListBuilder a) -> List a =
  match holders with
  | Nil -> list_builder_build(acc)
  | [h | hrest] ->
      match ws with
      | Nil -> list_builder_build(acc)
      | [w | wrest] -> respan_go(put, hrest, wrest, list_builder_add(put(h, w), acc))

# ── painting and measuring ──────────────────────────────────────────────────

# Children against their regions, pairwise. A child with no region is not
# painted; a region with no child is left as the frame's clear left it.
export fn render_zip(regions: List geometry.Region, screen: scr.Screen,
                     kids: List (widget.Widget m)) -> Unit !{IO} =
  match kids with
  | Nil -> ()
  | [w | rest] -> render_pair(w, rest, regions, screen)

fn render_pair(w: widget.Widget m, rest: List (widget.Widget m),
               rs: List geometry.Region, s: scr.Screen) -> Unit !{IO} =
  match rs with
  | Nil -> ()
  | [r | rrest] -> render_then(w, r, s, rest, rrest)

# Each child is painted under its own region as the clip, so a child that
# writes outside the region it was given cannot reach a sibling's cells
# (docs/tui-scroll-view-v0.md §4.5).
fn render_then(w: widget.Widget m, r: geometry.Region, s: scr.Screen,
               rest: List (widget.Widget m),
               rrest: List geometry.Region) -> Unit !{IO} = do
  scr.screen_clipped(s, r, render_one(w, r, s, _))
  render_zip(rrest, s, rest)

fn render_one(w: widget.Widget m, r: geometry.Region, s: scr.Screen,
              u: Unit) -> Unit !{IO} =
  widget.render(w, r, s)

# Each child against the container's FULL `avail`, never a running remainder:
# a child's reported size must not depend on its position among its siblings.
export fn measure_all(avail: geometry.Size,
                      kids: List (widget.Widget m)) -> List widget.Measured =
  list_map(widget.measure(_, avail), kids)
