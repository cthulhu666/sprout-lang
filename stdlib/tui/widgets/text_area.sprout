module stdlib.tui.widgets.text_area

# Many lines of editable text. Design: docs/tui-text-area-v0.md.
#
# The document lives in `stdlib.tui.buffer` and leaves only as an `on_change`
# message: `Widget m` erases the state type, so an application cannot read the
# area and must mirror what it hears.

import stdlib.string as string
import stdlib.tui.buffer as buffer
import stdlib.tui.event as event
import stdlib.tui.geometry as geometry
import stdlib.tui.screen as scr
import stdlib.tui.widget as widget
import stdlib.tui.widgets.focus as focus
import stdlib.tui.widgets.viewport as viewport

# Everything optional, in a record: Sprout has no default arguments, and two
# adjacent same-typed parameters swap silently. Start from `text_area_opts()`
# and override with `with`. Enter belongs to the document (§4.3), so unlike
# `input` there is no submit handler to supply.
export type TextAreaOpts m = (initial: String, look: focus.FocusStyle,
                              on_content: Maybe (m -> Maybe(String,
                                                             Maybe buffer.Caret)))

export fn text_area_opts() -> TextAreaOpts m =
  TextAreaOpts(initial = "", look = focus.focus_style_default(),
               on_content = Nothing)

# ── the widget ──────────────────────────────────────────────────────────────

# `has_focus` is the area's own copy of "the keyboard is mine", set by the ring
# (docs/tui-focus-v0.md §4.1).
type Area m = (id: widget.WidgetId, on_change: String -> m,
               opts: TextAreaOpts m, doc: buffer.Buffer, has_focus: Bool)

type alias Reply m = Maybe(Area m, List m, List(widget.Cmd m))

# Everything an area reacts to arrives addressed, so the broadcast is idle.
fn area_on_event(a: Area m,
                 ev: event.Event) -> (Area m, List m, List(widget.Cmd m)) =
  (a, Nil, Nil)

fn area_handler(a: Area m, d: widget.Delivery m) -> Reply m =
  match d with
  # An area asks for no work, and §4.10 leaves the control vocabulary to an
  # opts-supplied prism rather than a `Delivery` arm — except for a decoder
  # that recognises the message as a new document. Declining keeps the rest of
  # its traffic flowing past.
  | widget.ToMsg msg -> refilled(a, widget.decoded(a.opts.on_content, msg))
  | widget.ToFocus x -> Just(((a with (has_focus = x)), Nil, Nil))
  | widget.ToEvent e -> if a.has_focus then area_event(a, e) else Nothing

fn area_event(a: Area m, e: event.Event) -> Reply m =
  match e with
  | event.KeyPress k mods -> area_key(a, k, mods)
  | event.Paste s -> changed(a, buffer.buffer_insert(s, a.doc))
  # A tick, a resize and the mouse are not a text area's, and neither is
  # whatever is added next: declining leaves it to the application.
  | _ -> Nothing

# ctrl-a decodes as `KChar 'a'` with ctrl (keys.sprout:63), so an area that
# read the key alone would type "a" and eat the application's chord with it.
fn area_key(a: Area m, k: event.Key, mods: event.Mods) -> Reply m =
  if event.mods_is_chord(mods) then Nothing else area_plain(a, k)

# Tab, Esc and the function keys fall through, as they do for `input`. So do
# PageUp and PageDown: paging is measured against the viewport, which a pure
# handler is not given (§4.6).
fn area_plain(a: Area m, k: event.Key) -> Reply m =
  match k with
  | event.KChar c -> typed_in(a, string.string_from_char(c))
  # Enter is an edit on the document, not a submission (§4.3).
  | event.KEnter -> typed_in(a, "\n")
  | event.KBackspace -> changed(a, buffer.buffer_backspace(a.doc))
  | event.KDelete -> changed(a, buffer.buffer_delete(a.doc))
  | event.KLeft -> moved(a, buffer.buffer_left(a.doc))
  | event.KRight -> moved(a, buffer.buffer_right(a.doc))
  | event.KUp -> moved(a, buffer.buffer_up(a.doc))
  | event.KDown -> moved(a, buffer.buffer_down(a.doc))
  | event.KHome -> moved(a, buffer.buffer_home(a.doc))
  | event.KEnd -> moved(a, buffer.buffer_end(a.doc))
  | _ -> Nothing

fn typed_in(a: Area m, s: String) -> Reply m =
  changed(a, buffer.buffer_insert(s, a.doc))

# ── content that arrives by message ─────────────────────────────────────────

fn refilled(a: Area m, c: Maybe (String, Maybe buffer.Caret)) -> Reply m =
  match c with
  | Nothing -> Nothing
  | Just (body, place) ->
      opened(a, placed(buffer.buffer_open(body), place), body)

# Announce only what the application cannot already know
# (docs/tui-content-update-v0.md §9.1). Usually that is nothing: it sent the
# text, so echoing it back would loop an `update` that answers `on_change` by
# re-sending. But `buffer_open` NORMALISES — tabs and the other control
# characters become spaces, CRLF and CR fold to LF — and then the document is
# something the application has never seen, which is what `on_change` is for.
fn opened(a: Area m, b: buffer.Buffer, sent: String) -> Reply m =
  Just(((a with (doc = b)), said, Nil))
where
  now = buffer.buffer_text(b)
  said = if now == sent then Nil else [a.on_change(now)]

# No caret named: the end of the document, which is where `buffer_open` leaves
# it. A named one is clamped by `buffer_goto`, since it is the caller's claim
# about a document it has not seen laid out.
fn placed(b: buffer.Buffer, place: Maybe buffer.Caret) -> buffer.Buffer =
  match place with
  | Nothing -> b
  | Just c -> buffer.buffer_goto(c, b)

# The whole document, not a delta: the application cannot read the area, so a
# delta would leave it reassembling the text from keystrokes (§4.8). `Nothing`
# is a claimed key that changed nothing — backspace at the start must not reach
# the application, but there is no new value to announce.
fn changed(a: Area m, b: Maybe buffer.Buffer) -> Reply m =
  match b with
  | Nothing -> Just((a, Nil, Nil))
  | Just b2 ->
      Just(((a with (doc = b2)), [a.on_change(buffer.buffer_text(b2))], Nil))

fn moved(a: Area m, b: buffer.Buffer) -> Reply m =
  Just(((a with (doc = b)), Nil, Nil))

# ── what it paints ──────────────────────────────────────────────────────────

# The window is `widgets.viewport`'s, shared with the IDE's editor pane, which
# paints the same document beside a gutter (docs/ide-v0.md §5).
fn area_render(a: Area m, r: geometry.Region, s: scr.Screen) -> Unit !{IO} =
  if a.has_focus then viewport.paint_at_caret(s, r, a.doc, a.opts.look)
  # An unfocused area has no caret to keep in view, so it shows the start of
  # its document — the window only follows a caret that is there.
  else viewport.paint_at_top(s, r, a.doc, a.opts.look.normal)

# As big as it is given, on BOTH axes: measuring the document instead would
# walk it on every frame, since `measure` runs per frame for a `fit` child
# (§4.6). A document taller or wider than its region scrolls rather than
# demanding room.
fn area_measure(a: Area m, avail: geometry.Size) -> widget.Measured =
  widget.greedy_size(avail)

fn area_widget(a: Area m) -> widget.Widget m =
  widget.Widget(widget.View(state = a, on_event = area_on_event,
                            route = widget.route_when(a.id, area_handler, _, _,
                                                      _),
                            render = area_render, measure = area_measure))

export fn text_area(id: widget.WidgetId,
                    on_change: String -> m) -> widget.Widget m =
  text_area_with(id, on_change, text_area_opts())

# The caret starts at the end of `initial`, where a reader's eye is; the
# initial value is a starting point, not an edit, so nothing is announced.
export fn text_area_with(id: widget.WidgetId, on_change: String -> m,
                         opts: TextAreaOpts m) -> widget.Widget m =
  area_widget(Area(id = id, on_change = on_change, opts = opts,
                   doc = buffer.buffer_open(opts.initial), has_focus = false))
