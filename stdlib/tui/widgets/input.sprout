module stdlib.tui.widgets.input

# One line of editable text. Design: docs/tui-input-v0.md.
#
# The value leaves only as an `on_change` message: `Widget m` erases the state
# type, so an application cannot read the field and must mirror what it hears.

import stdlib.string as string
import stdlib.tui.event as event
import stdlib.tui.geometry as geometry
import stdlib.tui.line_zipper as lz
import stdlib.tui.screen as scr
import stdlib.tui.text as text
import stdlib.tui.widget as widget
import stdlib.tui.widgets.focus as focus
import stdlib.tui.widgets.paint as paint

# Everything optional, in a record: Sprout has no default arguments, and two
# adjacent same-typed parameters swap silently. Start from `input_opts()` and
# override with `with`.
export type InputOpts m = (initial: String, on_submit: Maybe (String -> m),
                           look: focus.FocusStyle,
                           on_content: Maybe (m -> Maybe String))

# No submit handler, so Enter falls through to the application (§4.4).
export fn input_opts() -> InputOpts m =
  InputOpts(initial = "", on_submit = Nothing,
            look = focus.focus_style_default(), on_content = Nothing)

# ── the widget ──────────────────────────────────────────────────────────────

# `has_focus` is the field's own copy of "the keyboard is mine", set by the
# ring (docs/tui-focus-v0.md §4.1).
type Field m = (id: widget.WidgetId, on_change: String -> m, opts: InputOpts m,
                line: lz.Zipper, has_focus: Bool)

type alias Reply m = Maybe(Field m, List m, List(widget.Cmd m))

# Everything a field reacts to arrives addressed, so the broadcast is idle.
fn field_on_event(f: Field m,
                  ev: event.Event) -> (Field m, List m, List(widget.Cmd m)) =
  (f, Nil, Nil)

fn field_handler(f: Field m, d: widget.Delivery m) -> Reply m =
  match d with
  # A field asks for no work, so an answer addressed to it belongs to `update`
  # — unless the application gave a decoder that recognises the message as a
  # new value. Declining keeps the rest of its traffic flowing past.
  | widget.ToMsg msg -> refilled(f, widget.decoded(f.opts.on_content, msg))
  | widget.ToFocus x -> Just(((f with (has_focus = x)), Nil, Nil))
  | widget.ToEvent e -> if f.has_focus then field_event(f, e) else Nothing

fn field_event(f: Field m, e: event.Event) -> Reply m =
  match e with
  | event.KeyPress k mods -> field_key(f, k, mods)
  | event.Paste s -> changed(f, lz.zipper_insert(s, f.line))
  # A tick, a resize and the mouse are not a text field's, and neither is
  # whatever is added next: declining leaves it to the application.
  | _ -> Nothing

# ctrl-a decodes as `KChar 'a'` with ctrl (keys.sprout:63), so a field that
# read the key alone would type "a" and eat the application's chord with it.
fn field_key(f: Field m, k: event.Key, mods: event.Mods) -> Reply m =
  if event.mods_is_chord(mods) then Nothing else field_plain(f, k)

# Tab, the arrows it does not use, Esc and the function keys all fall through
# — a field owns its line, not the keyboard.
fn field_plain(f: Field m, k: event.Key) -> Reply m =
  match k with
  | event.KChar c ->
      changed(f, lz.zipper_insert(string.string_from_char(c), f.line))
  | event.KBackspace -> changed(f, lz.zipper_backspace(f.line))
  | event.KDelete -> changed(f, lz.zipper_delete(f.line))
  | event.KLeft -> moved(f, lz.zipper_left(f.line))
  | event.KRight -> moved(f, lz.zipper_right(f.line))
  | event.KHome -> moved(f, lz.zipper_start(f.line))
  | event.KEnd -> moved(f, lz.zipper_end(f.line))
  | event.KEnter -> submitted(f)
  | _ -> Nothing

# ── content that arrives by message ─────────────────────────────────────────

# Replacing the line says NOTHING. `on_change` carries the text, and after a
# replacement the text is exactly what the application sent, so an announcement
# would echo its own value back — a loop for an `update` that answers
# `on_change` by re-sending. The caret lands at the end, as `zipper_open` puts
# it at construction (docs/tui-content-update-v0.md §9.1-9.2).
fn refilled(f: Field m, s: Maybe String) -> Reply m =
  match s with
  | Nothing -> Nothing
  | Just t -> Just(((f with (line = lz.zipper_open(t))), Nil, Nil))

# The whole value, not a delta: the application cannot read the field, so a
# delta would leave it rebuilding the line from keystrokes.
fn changed(f: Field m, z: Maybe lz.Zipper) -> Reply m =
  match z with
  | Nothing -> Just((f, Nil, Nil))
  | Just z2 -> Just(((f with (line = z2)), [f.on_change(lz.zipper_text(z2))], Nil))

fn moved(f: Field m, z: lz.Zipper) -> Reply m =
  Just(((f with (line = z)), Nil, Nil))

fn submitted(f: Field m) -> Reply m = map(sent_by(f, _), f.opts.on_submit)

fn sent_by(f: Field m,
           say: String -> m) -> (Field m, List m, List(widget.Cmd m)) =
  (f, [say(lz.zipper_text(f.line))], Nil)

# ── what it paints ──────────────────────────────────────────────────────────

fn rest_of(cs: List (List Int)) -> List (List Int) =
  match cs with
  | Nil -> Nil
  | [_ | rest] -> rest

# The caret sits ON the cluster after it, or on a blank cell at the end of the
# line. Painted, because `app.run` hides the terminal's own cursor for the
# session (docs/tui-focus-v0.md §9).
fn caret_cluster(z: lz.Zipper) -> String =
  match z.after with
  | Nil -> " "
  | [c | _] -> text.from_clusters([c])

fn past_caret(z: lz.Zipper) -> String =
  text.from_clusters(rest_of(z.after))

# An unfocused field has no caret to keep in view, so it shows the start of
# its value — the window only follows a caret that is there.
fn field_render(f: Field m, r: geometry.Region, s: scr.Screen) -> Unit !{IO} =
  if f.has_focus then window_render(f, r, shown_before(f, r), s)
  else paint.line(s, r, 0, lz.zipper_text(f.line), f.opts.look.normal)

# The window is a function of the caret, so there is no scroll position to
# drift out of step with it: keep the longest run of clusters before the caret
# that still fits, leaving the caret itself on the last column.
#
# The caret's OWN width is what the window reserves, not one column: on a CJK
# or emoji cluster a single reserved column truncates it away, painting neither
# the character nor the focus (§4.5).
fn shown_before(f: Field m, r: geometry.Region) -> List (List Int) =
  text.truncate_left(budget, list_reverse(f.line.before))
where
  budget = geometry.region_cols(r) - text.width(caret_cluster(f.line))

# The caret is one cell painted in the focused style, between the two halves
# of the line; `paint.at` clips each part at the region's edge.
fn window_render(f: Field m, r: geometry.Region, pre: List (List Int),
                 s: scr.Screen) -> Unit !{IO} = do
  paint.at(s, r, 0, 0, text.from_clusters(pre), f.opts.look.normal)
  paint.at(s, r, 0, text.clusters_width(pre), caret_cluster(f.line),
           f.opts.look.focused)
  paint.at(s, r, 0, text.clusters_width(pre) + text.width(caret_cluster(f.line)),
           past_caret(f.line), f.opts.look.normal)

# One row, and as wide as it is given: a field beside a label must not have to
# be told a width, and a value longer than its region scrolls rather than
# demanding more. The natural width includes the caret's own column.
fn field_measure(f: Field m, avail: geometry.Size) -> widget.Measured =
  widget.Measured(size = geometry.Size(text.width(lz.zipper_text(f.line)) + 1, 1),
                  cols = widget.Greedy, rows = widget.Fixed)

fn field_widget(f: Field m) -> widget.Widget m =
  widget.Widget(widget.View(state = f, on_event = field_on_event,
                            route = widget.route_when(f.id, field_handler, _, _, _),
                            render = field_render, measure = field_measure))

export fn input(id: widget.WidgetId, on_change: String -> m) -> widget.Widget m =
  input_with(id, on_change, input_opts())

# The caret starts at the end of `initial`, where a reader's eye is; the
# initial value is a starting point, not an edit, so nothing is announced.
export fn input_with(id: widget.WidgetId, on_change: String -> m,
                     opts: InputOpts m) -> widget.Widget m =
  field_widget(Field(id = id, on_change = on_change, opts = opts,
                     line = lz.zipper_open(opts.initial), has_focus = false))
