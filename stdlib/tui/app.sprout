module stdlib.tui.app

# The message pump and render loop. Design: docs/tui-widgets-v0.md §3.6.
#
# The loop's decision on every signal is a PURE function — `step` takes a
# widget and an event and returns the next widget, whether to keep going, and
# the IO that was asked for — and `run` is the shell that supplies signals,
# paints the result and performs that IO. That split is why the interesting
# half of this module is unit-testable with no terminal, no channel and no
# scheduler: deciding to read a file is a value, and only running it is not.

import stdlib.bytes as bytes
import stdlib.chan (Chan, Recv, Got, Closed, chan_new, chan_send, chan_recv, chan_close)
import stdlib.task (Scope, with_scope, task_spawn, task_cancelled, scope_cancel)
import stdlib.terminal as terminal
import stdlib.tui.event as event
import stdlib.tui.geometry as geometry
import stdlib.tui.keys as keys
import stdlib.tui.screen as screen
import stdlib.tui.style as style
import stdlib.tui.widget as widget

# Whether the loop keeps going. A value rather than an exception, because
# Sprout has none — the same reasoning as `TimeoutResult`.
export type Flow (..) deriving (Eq, ToString) =
  | Continue
  | Quit

# What the pump multiplexes onto its one channel. `chan_select` is recv-only,
# same-typed and has no `default` arm, so differently-typed sources cannot be
# selected across; one sum-typed channel is the shape that works today. A
# worker task or a finished command posts `SigMsg`, the input task posts
# `SigEvent`, and the loop cannot tell — nor need to — which task a signal
# came from.
export type Signal m (..) =
  | SigEvent event.Event
  | SigMsg m
  # A command's answer with a return address. `Signal` is exported and `boot`
  # workers post into the same channel, so a worker can address a widget
  # directly — supported, not accidental: it is how a background producer feeds
  # one pane without the application having to relay.
  | SigTo widget.WidgetId m

# `update` is the application's half: it receives what widgets said and decides
# the next tree, whether to stop, and what IO to ask for. Widget-local state
# lives inside the widget, so this is for cross-widget concerns only — there is
# deliberately no separate `Ref AppState`, because the loop threads the tree as
# a parameter and nothing is shared between tasks.
export type App m = (
  root: widget.Widget m,
  update: m -> widget.Widget m -> (widget.Widget m, Flow, List(widget.Cmd m)),
  tick_ms: Int,
  boot: Scope -> Chan(Signal m) -> Unit !{IO}
)

# The default `boot` for an application with no worker tasks.
export fn no_boot(scope: Scope, ch: Chan (Signal m)) -> Unit !{IO} = ()

# The common `update` result: a new tree and a verdict, asking for no IO.
# Spelled once here so an application that never issues a command does not
# write an empty list in every arm.
export fn done(w: widget.Widget m,
               flow: Flow) -> (widget.Widget m, Flow, List(widget.Cmd m)) =
  (w, flow, Nil)

# ── The pure core ───────────────────────────────────────────────────────────

# Fold messages through `update`, threading the tree, and STOP at the first
# `Quit`. The quitting message's own update still lands — it is how an app
# paints a farewell frame — but the ones behind it do not, because the tree
# they would act on is already being torn down.
export fn apply(update: m -> widget.Widget m -> (widget.Widget m, Flow, List(widget.Cmd m)),
                msgs: List m,
                w: widget.Widget m) -> (widget.Widget m, Flow, List(widget.Cmd m)) =
  apply_go(update, msgs, w, Nil)

fn apply_go(update: m -> widget.Widget m -> (widget.Widget m, Flow, List(widget.Cmd m)), msgs: List m, w: widget.Widget m,
            acc: List (widget.Cmd m)) -> (widget.Widget m, Flow, List(widget.Cmd m)) =
  match msgs with
  | Nil -> (w, Continue, list_reverse(acc))
  | [msg | rest] -> apply_step(update, update(msg, w), rest, acc)

fn apply_step(update: m -> widget.Widget m -> (widget.Widget m, Flow, List(widget.Cmd m)),
              r: (widget.Widget m, Flow, List(widget.Cmd m)), rest: List m,
              acc: List (widget.Cmd m)) -> (widget.Widget m, Flow, List(widget.Cmd m)) =
  match r with
  # Commands asked for by the quitting message still come back, so a farewell
  # write is not silently dropped along with the messages behind it.
  | (w2, Quit, cs) -> (w2, Quit, list_reverse(push_all(cs, acc)))
  | (w2, Continue, cs) -> apply_go(update, rest, w2, push_all(cs, acc))

fn push_all(xs: List a, acc: List a) -> List a =
  list_fold(\ (seen, x) -> Cons(x, seen), acc, xs)

# One event, end to end: the widget tree sees it, whatever it says goes through
# `update`, and the result is the next tree, the loop's verdict, and every
# command both halves asked for.
export fn step(update: m -> widget.Widget m -> (widget.Widget m, Flow, List(widget.Cmd m)), w: widget.Widget m,
               ev: event.Event) -> (widget.Widget m, Flow, List(widget.Cmd m)) =
  stepped(update, widget.on_event(w, ev))

# What the tree said, absorbed into the loop's verdict. Shared with `step_to`,
# whose claimed reply has exactly this shape.
fn stepped(update: m -> widget.Widget m -> (widget.Widget m, Flow, List(widget.Cmd m)),
           r: (widget.Widget m, List m, List(widget.Cmd m))) -> (widget.Widget m, Flow, List(widget.Cmd m)) =
  match r with
  | (w2, msgs, cmds) -> step_apply(cmds, apply(update, msgs, w2))

# One addressed message, end to end — the same contract as `step`, but to one
# named widget rather than the whole tree.
#
# When nothing claims the address the message goes to `update` instead. A stale
# address is not something the framework can resolve, but the answer is a value
# of the application's own message type, which `update` is already total over;
# dropping it silently would give the choice to no one.
export fn step_to(update: m -> widget.Widget m -> (widget.Widget m, Flow, List(widget.Cmd m)),
                  w: widget.Widget m, target: widget.WidgetId,
                  msg: m) -> (widget.Widget m, Flow, List(widget.Cmd m)) =
  delivered(update, w, msg, widget.deliver(w, target, widget.ToMsg(msg)))

fn delivered(update: m -> widget.Widget m -> (widget.Widget m, Flow, List(widget.Cmd m)),
             w: widget.Widget m, msg: m,
             r: Maybe (widget.Widget m, List m, List(widget.Cmd m))) -> (widget.Widget m, Flow, List(widget.Cmd m)) =
  match r with
  # Nothing claimed it, so nothing happened: the original tree stands, and the
  # message goes where every unaddressed one goes.
  | Nothing -> apply(update, [msg], w)
  | Just t -> stepped(update, t)

# The widget asked first, so its commands lead; `update` may have added more.
fn step_apply(wcmds: List (widget.Cmd m),
              r: (widget.Widget m, Flow, List(widget.Cmd m))) -> (widget.Widget m, Flow, List(widget.Cmd m)) =
  match r with
  | (w2, flow, ucmds) -> (w2, flow, list_append(wcmds, ucmds))

# ── The shell ───────────────────────────────────────────────────────────────

# Take over the terminal, pump signals until the application quits or input
# ends, then put the terminal back exactly as it was found.
export fn run(spec: App m) -> Unit !{IO} =
  with_scope(\scope -> run_in(scope, spec))

fn run_in(scope: Scope, spec: App m) -> Unit !{IO} = do
  terminal.raw_enter()
  terminal.enter_alt_screen()
  terminal.hide_cursor()
  ch <- chan_new(scope, 64)
  task_spawn(scope, \_ -> input_task(ch, spec.tick_ms))
  spec.boot(scope, ch)
  size <- current_size()
  s <- screen.screen_new(size)
  paint(s, spec.root, size)
  pump(scope, ch, s, spec.root, spec.update, size)
  # The input task is parked in `read_avail` or on a send; cancelling the scope
  # drops it, which is what lets `with_scope`'s join return. Without this the
  # join would wait on a loop that never ends.
  scope_cancel(scope)
  terminal.show_cursor()
  terminal.exit_alt_screen()
  terminal.raw_exit()

# `TermSize` is rows-first and `geometry.Size` is columns-first; converting is
# the caller's job by design, so it happens here rather than in `geometry`.
fn current_size() -> geometry.Size !{IO} = do
  ts <- terminal.size()
  geometry.Size(terminal.size_cols(ts), terminal.size_rows(ts))

fn paint(s: screen.Screen, w: widget.Widget m, size: geometry.Size) -> Unit !{IO} = do
  screen.screen_clear(s, style.style_default())
  widget.render(w, geometry.region_at_origin(size), s)
  frame <- screen.diff_to_ansi(s)
  terminal.write(frame)

fn pump(scope: Scope, ch: Chan (Signal m), s: screen.Screen, w: widget.Widget m,
        update: m -> widget.Widget m -> (widget.Widget m, Flow, List(widget.Cmd m)),
        size: geometry.Size) -> Unit !{IO} = do
  r <- chan_recv(ch)
  on_signal(scope, ch, s, w, update, size, r)

# A closed channel means the input task saw EOF or a read error: there is
# nothing left to drive the loop, so it ends the same way a `Quit` does.
fn on_signal(scope: Scope, ch: Chan (Signal m), s: screen.Screen, w: widget.Widget m,
             update: m -> widget.Widget m -> (widget.Widget m, Flow, List(widget.Cmd m)),
             size: geometry.Size, r: Recv (Signal m)) -> Unit !{IO} =
  match r with
  | Closed -> ()
  | Got sig -> on_sig(scope, ch, s, w, update, size, sig)

fn on_sig(scope: Scope, ch: Chan (Signal m), s: screen.Screen, w: widget.Widget m,
          update: m -> widget.Widget m -> (widget.Widget m, Flow, List(widget.Cmd m)),
          size: geometry.Size, sig: Signal m) -> Unit !{IO} =
  match sig with
  | SigEvent ev -> on_event_sig(scope, ch, s, w, update, size, ev)
  # A completed command's result takes the same path as one a widget said.
  | SigMsg msg -> advance(scope, ch, s, update, size, apply(update, [msg], w))
  # An addressed answer goes through `advance` like every other path, so a
  # route-emitted `Quit` paints its farewell frame and drops what follows.
  | SigTo target msg -> advance(scope, ch, s, update, size,
                                step_to(update, w, target, msg))

# A resize is handled here rather than by a widget: the screen itself has to be
# replaced, and no widget can do that.
fn on_event_sig(scope: Scope, ch: Chan (Signal m), s: screen.Screen, w: widget.Widget m,
                update: m -> widget.Widget m -> (widget.Widget m, Flow, List(widget.Cmd m)),
                size: geometry.Size, ev: event.Event) -> Unit !{IO} =
  match ev with
  | event.ResizeEvent ns -> resized(scope, ch, s, w, update, ns)
  | _ -> advance(scope, ch, s, update, size, step(update, w, ev))

# A resized screen is blank in both buffers, so the next paint is a full
# repaint — the terminal's contents after a resize are not knowable.
fn resized(scope: Scope, ch: Chan (Signal m), s: screen.Screen, w: widget.Widget m,
           update: m -> widget.Widget m -> (widget.Widget m, Flow, List(widget.Cmd m)),
           ns: geometry.Size) -> Unit !{IO} = do
  s2 <- screen.screen_resize(s, ns)
  paint(s2, w, ns)
  pump(scope, ch, s2, w, update, ns)

fn advance(scope: Scope, ch: Chan (Signal m), s: screen.Screen,
           update: m -> widget.Widget m -> (widget.Widget m, Flow, List(widget.Cmd m)), size: geometry.Size,
           r: (widget.Widget m, Flow, List(widget.Cmd m))) -> Unit !{IO} =
  match r with
  # The final frame is painted before returning, so a farewell message is seen.
  # Outstanding commands are dropped: the scope is cancelled on the next line
  # of `run_in`, so a task spawned here could not finish anyway.
  | (w2, Quit, _) -> paint(s, w2, size)
  | (w2, Continue, cs) -> dispatched(scope, ch, s, w2, update, size, cs)

# Each command runs in its OWN task, so a slow one — a file read, a compile —
# cannot stall the loop. Its result returns as an ordinary `SigMsg`, which is
# why the pump needs no separate notion of a command having finished.
fn dispatched(scope: Scope, ch: Chan (Signal m), s: screen.Screen, w: widget.Widget m,
              update: m -> widget.Widget m -> (widget.Widget m, Flow, List(widget.Cmd m)), size: geometry.Size,
              cs: List (widget.Cmd m)) -> Unit !{IO} = do
  list_each(spawn_cmd(scope, ch, _), cs)
  repaint(scope, ch, s, w, update, size)

fn spawn_cmd(scope: Scope, ch: Chan (Signal m), c: widget.Cmd m) -> Unit !{IO} =
  task_spawn(scope, run_cmd(ch, c, _))

fn run_cmd(ch: Chan (Signal m), c: widget.Cmd m, u: Unit) -> Unit !{IO} = do
  msg <- widget.cmd_run(c)
  chan_send(ch, addressed(widget.cmd_addr(c), msg))

# Two commands complete in whatever order their tasks finish, addressed or
# not, so a route handler must tolerate answers arriving out of order.
fn addressed(a: Maybe widget.WidgetId, msg: m) -> Signal m =
  match a with
  | Nothing -> SigMsg(msg)
  | Just target -> SigTo(target, msg)

fn repaint(scope: Scope, ch: Chan (Signal m), s: screen.Screen, w: widget.Widget m,
           update: m -> widget.Widget m -> (widget.Widget m, Flow, List(widget.Cmd m)),
           size: geometry.Size) -> Unit !{IO} = do
  paint(s, w, size)
  pump(scope, ch, s, w, update, size)

# ── The input task ──────────────────────────────────────────────────────────

# One task owns the terminal: `read_avail` permits exactly one waiter, and a
# second would wedge the scheduler. Everything else reaches the loop through
# the channel.
fn input_task(ch: Chan (Signal m), tick_ms: Int) -> Unit !{IO} =
  input_loop(ch, tick_ms, bytes.empty())

fn input_loop(ch: Chan (Signal m), tick_ms: Int, held: Bytes) -> Unit !{IO} = do
  stopped <- task_cancelled()
  input_next(ch, tick_ms, held, stopped)

fn input_next(ch: Chan (Signal m), tick_ms: Int, held: Bytes,
              stopped: Bool) -> Unit !{IO} =
  if stopped then ()
  else read_once(ch, tick_ms, held)

fn read_once(ch: Chan (Signal m), tick_ms: Int, held: Bytes) -> Unit !{IO} = do
  inp <- terminal.read_avail(4096, tick_ms)
  on_input(ch, tick_ms, held, inp)

# `held` is the trailing partial sequence the decoder could not resolve — half a
# UTF-8 character, an unterminated CSI — carried into the next read rather than
# guessed at.
fn on_input(ch: Chan (Signal m), tick_ms: Int, held: Bytes,
            inp: terminal.TermInput) -> Unit !{IO} =
  match inp with
  | terminal.TermBytes b -> decoded(ch, tick_ms, bytes.append(held, b))
  # The deadline elapsing IS the frame tick — no separate timer task, because
  # `read_avail` already reports it. It is also the ESCAPE TIMEOUT: see `idled`.
  | terminal.TermIdle -> idled(ch, tick_ms, held)
  | terminal.TermResized -> send_resize(ch, tick_ms, held)
  # Closing is how the loop is told there will be no more signals.
  | terminal.TermEof -> chan_close(ch)
  | terminal.TermFailed _ -> chan_close(ch)

fn decoded(ch: Chan (Signal m), tick_ms: Int, all: Bytes) -> Unit !{IO} =
  match keys.decode(all) with
  | (evs, rest) -> send_events(ch, tick_ms, rest, evs)

fn send_events(ch: Chan (Signal m), tick_ms: Int, held: Bytes,
               evs: List event.Event) -> Unit !{IO} =
  match evs with
  | Nil -> input_loop(ch, tick_ms, held)
  | [e | rest] -> send_then(ch, tick_ms, held, rest, e)

fn send_then(ch: Chan (Signal m), tick_ms: Int, held: Bytes,
             rest: List event.Event, e: event.Event) -> Unit !{IO} = do
  chan_send(ch, SigEvent(e))
  send_events(ch, tick_ms, held, rest)

# `keys.decode` holds a lone ESC rather than guessing, and says the timeout
# that resolves it belongs here (keys.sprout §ESC). This is that timeout: the
# read deadline elapsed with the byte still held, so nothing is coming after it
# and it is the Escape key. Without this Esc never becomes an event at all --
# it stayed in `held` across every later read, and an application whose only
# quit binding is Esc could not be quit.
fn idled(ch: Chan (Signal m), tick_ms: Int, held: Bytes) -> Unit !{IO} =
  if escape_timed_out(held) then send_esc(ch, tick_ms)
  else send_one(ch, tick_ms, held, SigEvent(event.TickEvent))

# Only a BARE ESC. A longer hold is genuinely mid-sequence -- an arrow key is
# `ESC [ A` -- and flushing at the ESC would turn one keypress into three.
export fn escape_timed_out(held: Bytes) -> Bool =
  if bytes.length(held) != 1 then false
  else
    match bytes.get(held, 0) with
    | Just b -> b == 27
    | Nothing -> false

# The hold is cleared with the same send: carrying it would re-emit Escape on
# every subsequent idle.
fn send_esc(ch: Chan (Signal m), tick_ms: Int) -> Unit !{IO} = do
  chan_send(ch, SigEvent(event.KeyPress(event.KEsc, event.mods_none())))
  input_loop(ch, tick_ms, bytes.empty())

fn send_one(ch: Chan (Signal m), tick_ms: Int, held: Bytes,
            sig: Signal m) -> Unit !{IO} = do
  chan_send(ch, sig)
  input_loop(ch, tick_ms, held)

fn send_resize(ch: Chan (Signal m), tick_ms: Int, held: Bytes) -> Unit !{IO} = do
  size <- current_size()
  send_one(ch, tick_ms, held, SigEvent(event.ResizeEvent(size)))
