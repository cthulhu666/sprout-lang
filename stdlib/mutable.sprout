module stdlib.mutable

# Mutable indexed containers. Split out of the implicit prelude so mutation is an
# explicit, opt-in dependency. Prefer the element-level combinators (`mutvec_fold`,
# `mutmatrix_row_zip_fold`, etc.) when iterating: the library generates in-bounds
# indices internally and reads with `vector_get_direct`, so callers avoid the
# user-visible `Maybe` traffic of indexed `get` while staying bounds-safe.
#
# The raw `Vector` backing store and its `vector_*` builtins stay in the prelude
# (shared with the immutable `Vec`), available here implicitly.

# ---------------------------------------------------------------------------
# MutVec — a 1-D mutable array (opaque; use the mutvec_* functions only)
# ---------------------------------------------------------------------------
export type MutVec a = MutVec(Vector a)

fn mutvec_raw(v: MutVec a) -> Vector a =
  match v with | MutVec raw -> raw

export fn mutvec_new(n: Int, val: a) -> MutVec a !{IO} =
  do
    raw <- vec_make_filled(n, val)
    MutVec(raw)

# O(1). The fixed length of the mutable vector.
export fn mutvec_len(v: MutVec a) -> Int =
  vector_length(mutvec_raw(v))

# O(1). Total: Nothing when i is out of range (routes through the bounds-checked
# vector_get).
export fn mutvec_get(v: MutVec a, i: Int) -> Maybe a !{IO} =
  vector_get(mutvec_raw(v), i)

# O(1) unchecked read for fixed-layout callers (e.g. Vec3/Mat4) that know i is
# in range. Routes through the unboxed vector_get_direct fast path, avoiding the
# Maybe of mutvec_get. Panics if i is out of range — callers must guarantee it.
export fn mutvec_at(v: MutVec a, i: Int) -> a !{IO} =
  vector_get_direct(mutvec_raw(v), i)

export fn mutvec_set(v: MutVec a, i: Int, val: a) -> Unit !{IO} =
  vector_mutset(mutvec_raw(v), i, val)

fn mutvec_each_go(f: a -> Unit !{IO}, raw: Vector a, i: Int, total: Int) -> Unit !{IO} =
  if i >= total then ()
  else
    do
      val <- vector_get_direct(raw, i)
      _ <- f(val)
      mutvec_each_go(f, raw, i + 1, total)

# O(n). Visit each element in index order.
export fn mutvec_each(f: a -> Unit !{IO}, v: MutVec a) -> Unit !{IO} =
  mutvec_each_go(f, mutvec_raw(v), 0, mutvec_len(v))

fn mutvec_fold_go(step: b -> a -> b !{IO}, acc: b, raw: Vector a, i: Int, total: Int) -> b !{IO} =
  if i >= total then acc
  else
    do
      val <- vector_get_direct(raw, i)
      next <- step(acc, val)
      mutvec_fold_go(step, next, raw, i + 1, total)

# O(n). Left fold over elements in index order.
export fn mutvec_fold(step: b -> a -> b !{IO}, init: b, v: MutVec a) -> b !{IO} =
  mutvec_fold_go(step, init, mutvec_raw(v), 0, mutvec_len(v))

fn min_int(a: Int, b: Int) -> Int =
  if a < b then a else b

fn mutvec_zip_fold_go(step: b -> a -> c -> b !{IO}, acc: b, raw_a: Vector a, raw_c: Vector c, i: Int, total: Int) -> b !{IO} =
  if i >= total then acc
  else
    do
      left <- vector_get_direct(raw_a, i)
      right <- vector_get_direct(raw_c, i)
      next <- step(acc, left, right)
      mutvec_zip_fold_go(step, next, raw_a, raw_c, i + 1, total)

# O(min(len a, len c)). Fold over corresponding element pairs.
export fn mutvec_zip_fold(step: b -> a -> c -> b !{IO}, init: b, va: MutVec a, vc: MutVec c) -> b !{IO} =
  mutvec_zip_fold_go(step, init, mutvec_raw(va), mutvec_raw(vc), 0, min_int(mutvec_len(va), mutvec_len(vc)))

fn mutvec_map_inplace_go(f: a -> a !{IO}, raw: Vector a, i: Int, total: Int) -> Unit !{IO} =
  if i >= total then ()
  else
    do
      val <- vector_get_direct(raw, i)
      next <- f(val)
      _ <- vector_mutset(raw, i, next)
      mutvec_map_inplace_go(f, raw, i + 1, total)

# O(n). Replace each element in place with f applied to it.
export fn mutvec_map_inplace(f: a -> a !{IO}, v: MutVec a) -> Unit !{IO} =
  mutvec_map_inplace_go(f, mutvec_raw(v), 0, mutvec_len(v))

# ---------------------------------------------------------------------------
# MutMatrix — a 2-D row-major mutable array backed by one MutVec
# ---------------------------------------------------------------------------
# Element (r, c) lives at flat index r * cols + c. get/set bounds-check both
# indices so an out-of-range column cannot silently address the adjacent row.
export type MutMatrix a = MutMatrix Int Int (MutVec a)

# O(rows*cols): allocates one backing MutVec filled with `init`.
export fn mutmatrix_new(rows: Int, cols: Int, init: a) -> MutMatrix a !{IO} =
  do
    data <- mutvec_new(rows * cols, init)
    MutMatrix(rows, cols, data)

export fn mutmatrix_rows(m: MutMatrix a) -> Int =
  match m with | MutMatrix rows _ _ -> rows

export fn mutmatrix_cols(m: MutMatrix a) -> Int =
  match m with | MutMatrix _ cols _ -> cols

# O(1). Nothing when (r, c) is out of range.
export fn mutmatrix_get(m: MutMatrix a, r: Int, c: Int) -> Maybe a !{IO} =
  match m with
  | MutMatrix rows cols data ->
      if r < 0 || r >= rows || c < 0 || c >= cols then Nothing
      else mutvec_get(data, r * cols + c)

# O(1). No-op when (r, c) is out of range.
export fn mutmatrix_set(m: MutMatrix a, r: Int, c: Int, val: a) -> Unit !{IO} =
  match m with
  | MutMatrix rows cols data ->
      if r < 0 || r >= rows || c < 0 || c >= cols then ()
      else mutvec_set(data, r * cols + c, val)

fn mutmatrix_fold_go(step: b -> a -> b !{IO}, acc: b, raw: Vector a, i: Int, total: Int) -> b !{IO} =
  if i >= total then acc
  else
    do
      val <- vector_get_direct(raw, i)
      next <- step(acc, val)
      mutmatrix_fold_go(step, next, raw, i + 1, total)

# O(rows*cols). Fold over every cell in row-major order.
export fn mutmatrix_fold(step: b -> a -> b !{IO}, init: b, m: MutMatrix a) -> b !{IO} =
  match m with
  | MutMatrix rows cols data ->
      if rows <= 0 || cols <= 0 then init
      else mutmatrix_fold_go(step, init, mutvec_raw(data), 0, rows * cols)

fn mutmatrix_fill_go(f: Int -> Int -> a !{IO}, raw: Vector a, cols: Int, i: Int, total: Int) -> Unit !{IO} =
  if i >= total then ()
  else
    do
      let r = i / cols
      let c = i - r * cols
      val <- f(r, c)
      _ <- vector_mutset(raw, i, val)
      mutmatrix_fill_go(f, raw, cols, i + 1, total)

# O(rows*cols). Set every cell (r, c) to f(r, c).
export fn mutmatrix_fill(f: Int -> Int -> a !{IO}, m: MutMatrix a) -> Unit !{IO} =
  match m with
  | MutMatrix rows cols data ->
      if rows <= 0 || cols <= 0 then ()
      else mutmatrix_fill_go(f, mutvec_raw(data), cols, 0, rows * cols)

fn mutmatrix_row_zip_fold_go(step: b -> a -> c -> b !{IO}, acc: b, raw_m: Vector a, raw_v: Vector c, row_start: Int, i: Int, total: Int) -> b !{IO} =
  if i >= total then acc
  else
    do
      cell <- vector_get_direct(raw_m, row_start + i)
      val <- vector_get_direct(raw_v, i)
      next <- step(acc, cell, val)
      mutmatrix_row_zip_fold_go(step, next, raw_m, raw_v, row_start, i + 1, total)

# O(min(cols, len v)). Fold over row r zipped with vector v.
export fn mutmatrix_row_zip_fold(step: b -> a -> c -> b !{IO}, init: b, m: MutMatrix a, r: Int, v: MutVec c) -> b !{IO} =
  match m with
  | MutMatrix rows cols data ->
      if r < 0 || r >= rows then init
      else mutmatrix_row_zip_fold_go(step, init, mutvec_raw(data), mutvec_raw(v), r * cols, 0, min_int(cols, mutvec_len(v)))

fn mutmatrix_row_zip_update_go(f: a -> c -> a !{IO}, raw_m: Vector a, raw_v: Vector c, row_start: Int, i: Int, total: Int) -> Unit !{IO} =
  if i >= total then ()
  else
    do
      cell <- vector_get_direct(raw_m, row_start + i)
      val <- vector_get_direct(raw_v, i)
      next <- f(cell, val)
      _ <- vector_mutset(raw_m, row_start + i, next)
      mutmatrix_row_zip_update_go(f, raw_m, raw_v, row_start, i + 1, total)

# O(min(cols, len v)). Update each cell of row r in place from (cell, v-element).
export fn mutmatrix_row_zip_update(f: a -> c -> a !{IO}, m: MutMatrix a, r: Int, v: MutVec c) -> Unit !{IO} =
  match m with
  | MutMatrix rows cols data ->
      if r < 0 || r >= rows then ()
      else mutmatrix_row_zip_update_go(f, mutvec_raw(data), mutvec_raw(v), r * cols, 0, min_int(cols, mutvec_len(v)))

# ---------------------------------------------------------------------------
# Double numeric kernels
# ---------------------------------------------------------------------------
# Monomorphic Double fused kernels for hot matvec loops. Unlike the generic
# row_zip combinators, these inline the multiply-accumulate, so they allocate no
# callback closure and make no indirect per-element call — the closure/callback
# traffic that dominates dense numeric training loops. Reads still go through the
# bounds-checked vector_get_direct (no new builtins, memory-safe).

fn mutmatrix_row_dot_go(acc: Double, raw_m: Vector Double, raw_v: Vector Double, row_start: Int, i: Int, total: Int) -> Double !{IO} =
  if i >= total then acc
  else
    do
      cell <- vector_get_direct(raw_m, row_start + i)
      val <- vector_get_direct(raw_v, i)
      mutmatrix_row_dot_go(acc + cell * val, raw_m, raw_v, row_start, i + 1, total)

# O(min(cols, len v)). Fused dot of row r with v: seed + Σ m[r][i]*v[i], ascending i.
# Accumulation order is bit-identical to a row_zip_fold seeded with `seed`. Invalid
# row returns `seed`.
export fn mutmatrix_row_dot(m: MutMatrix Double, r: Int, v: MutVec Double, seed: Double) -> Double !{IO} =
  match m with
  | MutMatrix rows cols data ->
      if r < 0 || r >= rows then seed
      else mutmatrix_row_dot_go(seed, mutvec_raw(data), mutvec_raw(v), r * cols, 0, min_int(cols, mutvec_len(v)))

fn mutmatrix_row_sub_scaled_go(raw_m: Vector Double, raw_v: Vector Double, scale: Double, row_start: Int, i: Int, total: Int) -> Unit !{IO} =
  if i >= total then ()
  else
    do
      cell <- vector_get_direct(raw_m, row_start + i)
      val <- vector_get_direct(raw_v, i)
      _ <- vector_mutset(raw_m, row_start + i, cell - scale * val)
      mutmatrix_row_sub_scaled_go(raw_m, raw_v, scale, row_start, i + 1, total)

# O(min(cols, len v)). In place: m[r][i] := m[r][i] - scale * v[i], ascending i — the
# SGD descent step (w -= lr*grad). Bit-identical to a row_zip_update of `cur - scale*x`.
# Invalid row is a no-op.
export fn mutmatrix_row_sub_scaled_inplace(m: MutMatrix Double, r: Int, v: MutVec Double, scale: Double) -> Unit !{IO} =
  match m with
  | MutMatrix rows cols data ->
      if r < 0 || r >= rows then ()
      else mutmatrix_row_sub_scaled_go(mutvec_raw(data), mutvec_raw(v), scale, r * cols, 0, min_int(cols, mutvec_len(v)))

fn mutmatrix_row_add_scaled_into_go(raw_dst: Vector Double, raw_m: Vector Double, scale: Double, row_start: Int, i: Int, total: Int) -> Unit !{IO} =
  if i >= total then ()
  else
    do
      dst_i <- vector_get_direct(raw_dst, i)
      cell <- vector_get_direct(raw_m, row_start + i)
      _ <- vector_mutset(raw_dst, i, dst_i + scale * cell)
      mutmatrix_row_add_scaled_into_go(raw_dst, raw_m, scale, row_start, i + 1, total)

# O(min(cols, len dst)). Into dst: dst[i] := dst[i] + scale * m[r][i], ascending i — the
# fused gradient-accumulate step (dhidden += dout * W_row). Reads a matrix row, writes a
# separate vector, so it complements row_sub_scaled_inplace (which writes the matrix).
# Bit-identical to a per-element `cur + scale*cell` loop. Invalid row is a no-op.
export fn mutmatrix_row_add_scaled_into(dst: MutVec Double, m: MutMatrix Double, r: Int, scale: Double) -> Unit !{IO} =
  match m with
  | MutMatrix rows cols data ->
      if r < 0 || r >= rows then ()
      else mutmatrix_row_add_scaled_into_go(mutvec_raw(dst), mutvec_raw(data), scale, r * cols, 0, min_int(cols, mutvec_len(dst)))
