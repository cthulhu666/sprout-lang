module stdlib.repl
import stdlib.compiler as compiler
import stdlib.terminal (term_is_interactive_once, term_read_key_once, term_read_line_once)
import stdlib.string as string

type SubmissionResult =
  | Continue (Vec String)(compiler.CompilerSession)
  | Exit

type ReadResult =
  | Submission String
  | EndInput
  | ReadError String
  | ReadNotice String

fn term_noop() -> Unit !{IO} =
  term_write("")

fn write_line(prompt: Maybe String, text: String) -> Unit !{IO} =
  match prompt with
  | Just _ -> term_write(text ++ "\r\n")
  | Nothing -> print(text)

fn finish_loop(prompt: Maybe String) -> Unit !{IO} =
  match prompt with
  | Just _ -> term_write("\r\n")
  | Nothing -> term_noop()

fn render_lines(prompt: Maybe String, lines: Vec String, index: Int) -> Unit !{IO} =
  match vec_get(index, lines) with
  | Just line -> after(write_line(prompt, line), render_lines(prompt, lines, index + 1))
  | Nothing -> term_noop()

fn single_line(text: String) -> Vec String =
  vec_append(text, vec_empty())

fn char_at(raw: String, index: Int) -> String =
  string.slice(raw, index, 1)

fn trim(raw: String) -> String =
  string.trim(raw)

fn drop_prefix(raw: String, prefix: String) -> String =
  match string.strip_prefix(raw, prefix) with
  | Just rest -> rest
  | Nothing -> raw

fn drop_last(raw: String) -> String =
  string.take(raw, string.length(raw) - 1)

fn drop_last_count(raw: String, count: Int) -> String =
  if count <= 0 then raw
  else string.take(raw, string.length(raw) - count)

fn slice_left(raw: String, count: Int) -> String =
  string.take(raw, count)

fn slice_right(raw: String, start: Int) -> String =
  string.drop(raw, start)

fn insert_at(raw: String, index: Int, text: String) -> String =
  slice_left(raw, index) ++ text ++ slice_right(raw, index)

fn delete_before(raw: String, index: Int) -> String =
  if index <= 0 then raw
  else slice_left(raw, index - 1) ++ slice_right(raw, index)

fn redraw_input(prompt: String, current: String, cursor: Int) -> Unit !{IO} =
  after(
    term_write("\r" ++ prompt ++ current ++ " "),
    term_write("\r" ++ prompt ++ slice_left(current, cursor))
  )

fn ignore_key(value: String !{IO}) -> Unit !{IO} =
  term_noop()

fn escape_token(second: String, third: String) -> String =
  if second != "["then "escape"
  else if third == "A" then "up"
  else if third == "B" then "down"
  else if third == "C" then "right"
  else if third == "D" then "left"
  else "escape"

fn read_escape_token_second(second: String) -> String !{IO} =
  if second == "["then escape_token(second, term_read_key_once())
  else second

fn read_escape_token() -> String !{IO} =
  read_escape_token_second(term_read_key_once())

fn history_value(index: Int, fallback: String, history: Vec String) -> String =
  vec_get_or(index, fallback, history)

fn history_prev(current: String, history: Vec String, browse_index: Int, draft: String) -> (String, Int, String) =
  if vec_length(history) == 0 then (current, browse_index, draft)
  else if browse_index < 0 then
    (history_value(vec_length(history) - 1, current, history), vec_length(history) - 1, current)
  else if browse_index == 0 then
    (current, browse_index, draft)
  else
    (history_value(browse_index - 1, current, history), browse_index - 1, draft)

fn history_next(current: String, history: Vec String, browse_index: Int, draft: String) -> (String, Int, String) =
  if browse_index < 0 then (current, browse_index, draft)
  else if browse_index + 1 >= vec_length(history) then (draft, -1, draft)
  else (history_value(browse_index + 1, current, history), browse_index + 1, draft)

fn render_interactive_match_lines(matches: Vec String, index: Int) -> Unit !{IO} =
  match vec_get(index, matches) with
  | Just line -> after(term_write(line ++ "\r\n"), render_interactive_match_lines(matches, index + 1))
  | Nothing -> term_noop()

fn contains_char(chars: String, target: String, index: Int) -> Bool =
  if index >= string.length(chars) then false
  else if string.slice(chars, index, 1) == target then true
  else contains_char(chars, target, index + 1)

fn is_completion_start_char(value: String) -> Bool =
  contains_char("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_:", value, 0)

fn is_completion_rest_char(value: String) -> Bool =
  contains_char("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.:", value, 0)

fn completion_prefix_from(line_buffer: String, index: Int) -> String =
  if index < 0 then ""
  else if is_completion_rest_char(char_at(line_buffer, index)) then completion_prefix_from(line_buffer, index - 1) ++ char_at(line_buffer, index)
  else ""

fn completion_prefix(line_buffer: String) -> String =
  if string.length(line_buffer) == 0 then ""
  else
    match completion_prefix_from(line_buffer, string.length(line_buffer) - 1) with
    | "" -> ""
    | raw ->
        if is_completion_start_char(char_at(raw, 0)) then raw else ""

fn append_unique_name(names: Vec String, value: String) -> Vec String =
  if value == "" then names
  else if contains_name(names, value, 0) then names
  else vec_append(value, names)

fn contains_name(names: Vec String, value: String, index: Int) -> Bool =
  match vec_get(index, names) with
  | Just item -> if item == value then true else contains_name(names, value, index + 1)
  | Nothing -> false

fn lower_char(value: String) -> String =
  if string.find("ABCDEFGHIJKLMNOPQRSTUVWXYZ", value) == -1 then value
  else string.slice("abcdefghijklmnopqrstuvwxyz", string.find("ABCDEFGHIJKLMNOPQRSTUVWXYZ", value), 1)

fn lower_ascii_from(raw: String, index: Int, acc: String) -> String =
  if index >= string.length(raw) then acc
  else lower_ascii_from(raw, index + 1, acc ++ lower_char(char_at(raw, index)))

fn lower_ascii(raw: String) -> String =
  lower_ascii_from(raw, 0, "")

fn filter_names_by_prefix(prefix: String, lowered_prefix: String, names: Vec String, index: Int, acc: Vec String) -> Vec String =
  match vec_get(index, names) with
  | Just item ->
      if string.starts_with(lower_ascii(item), lowered_prefix) then filter_names_by_prefix(prefix, lowered_prefix, names, index + 1, vec_append(item, acc))
      else filter_names_by_prefix(prefix, lowered_prefix, names, index + 1, acc)
  | Nothing -> acc

fn append_space_name_pair(acc: Vec String, pair: (String, String)) -> Vec String =
  match pair with
  | (head, tail) -> append_space_names(append_unique_name(acc, trim(head)), trim(tail))

fn append_space_names(acc: Vec String, raw: String) -> Vec String =
  if raw == "" then acc
  else
    match string.split_once(raw, " ") with
    | Nothing -> append_unique_name(acc, trim(raw))
    | Just pair -> append_space_name_pair(acc, pair)

fn repl_command_names() -> Vec String =
  append_space_names(vec_empty(), ":help :quit :q :exit :type :t :instances :i")

fn stdlib_module_completion_names() -> Vec String =
  append_space_names(vec_empty(), "bytes collections crypto http http_client math net string terminal")

fn prelude_completion_names() -> Vec String !{IO} =
  gather_exported_names(string.string_lines(read_file(module_path("stdlib.prelude"))), 0, false, vec_empty())

fn append_names_from_vec(acc: Vec String, names: Vec String, index: Int) -> Vec String =
  match vec_get(index, names) with
  | Just name -> append_names_from_vec(append_unique_name(acc, name), names, index + 1)
  | Nothing -> acc

fn skip_spaces_from(raw: String, index: Int) -> Int =
  if index >= string.length(raw) then index
  else if char_at(raw, index) == " " || char_at(raw, index) == "\t" then skip_spaces_from(raw, index + 1)
  else index

fn skip_to_space_or_delim(raw: String, index: Int) -> Int =
  if index >= string.length(raw) then index
  else if char_at(raw, index) == " " || char_at(raw, index) == "\t" || char_at(raw, index) == "("|| char_at(raw, index) ==":" || char_at(raw, index) == "=" || char_at(raw, index) == "|" then index
  else skip_to_space_or_delim(raw, index + 1)

fn take_name_from(raw: String, index: Int) -> String =
  if index >= string.length(raw) then ""
  else string.slice(raw, index, skip_to_space_or_delim(raw, index) - index)

fn module_leaf_name(raw: String) -> String =
  module_leaf_name_from(raw, 0, 0)

fn module_leaf_name_from(raw: String, index: Int, start: Int) -> String =
  if index >= string.length(raw) then string.slice(raw, start, string.length(raw) - start)
  else if char_at(raw, index) == "." then module_leaf_name_from(raw, index + 1, index + 1)
  else module_leaf_name_from(raw, index + 1, start)

fn first_from_pair(pair: (String, String)) -> String =
  match pair with
  | (before, _) -> before

fn take_before(raw: String, needle: String) -> String =
  match string.split_once(raw, needle) with
  | Just pair -> first_from_pair(pair)
  | Nothing -> raw

fn second_from_pair(pair: (String, String)) -> String =
  match pair with
  | (_, after) -> after

fn take_after(raw: String, needle: String) -> String =
  match string.split_once(raw, needle) with
  | Just pair -> second_from_pair(pair)
  | Nothing -> ""

fn between_from_split(after_left: String, right: String) -> String =
  match string.split_once(after_left, right) with
  | Just pair -> first_from_pair(pair)
  | Nothing -> ""

fn take_between(raw: String, left: String, right: String) -> String =
  match string.split_once(raw, left) with
  | Nothing -> ""
  | Just pair -> between_from_split(second_from_pair(pair), right)

fn append_csv_name_pair(acc: Vec String, pair: (String, String)) -> Vec String =
  match pair with
  | (head, tail) -> append_csv_names(append_unique_name(acc, trim(head)), tail)

fn append_csv_names(acc: Vec String, raw: String) -> Vec String =
  match string.split_once(raw, "," ) with
  | Nothing -> append_unique_name(acc, trim(raw))
  | Just pair -> append_csv_name_pair(acc, pair)

fn append_import_names(names: Vec String, line: String) -> Vec String =
  if string.find(line, " as ") == -1 then
    if string.find(line, "(") == -1 then append_unique_name(names, module_leaf_name(trim(line)))
    else append_csv_names(append_unique_name(names, module_leaf_name(trim(take_before(line, "(")))), take_between(line, "(", ")"))
  else if string.find(line, "(") == -1 then
    append_unique_name(
      append_unique_name(names, trim(take_after(line, " as "))),
      module_leaf_name(trim(string.slice(line, 0, string.find(line, " as "))))
    )
  else
    append_csv_names(
      append_unique_name(
        append_unique_name(names, trim(take_after(line, " as "))),
        module_leaf_name(trim(take_before(string.slice(line, 0, string.find(line, " as ")), "(")))
      ),
      take_between(line, "(", ")")
    )

fn gather_import_names(imports: Vec String, index: Int, acc: Vec String) -> Vec String =
  match vec_get(index, imports) with
  | Just line ->
      if string.starts_with(trim(line), "import ") then gather_import_names(imports, index + 1, append_import_names(acc, trim(drop_prefix(trim(line), "import "))))
      else gather_import_names(imports, index + 1, acc)
  | Nothing -> acc

fn replace_char(raw: String, from: String, to: String, index: Int, acc: String) -> String =
  if index >= string.length(raw) then acc
  else if char_at(raw, index) == from then replace_char(raw, from, to, index + 1, acc ++ to)
  else replace_char(raw, from, to, index + 1, acc ++ char_at(raw, index))

fn module_path(module_name: String) -> String =
  replace_char(module_name, ".", "/", 0, "") ++ ".sprout"

fn append_exported_names(names: Vec String, line: String) -> Vec String =
  append_declaration_names(names, trim(line))

fn gather_exported_names(lines: Vec String, index: Int, in_exported_type: Bool, acc: Vec String) -> Vec String =
  match vec_get(index, lines) with
  | Just line ->
      if string.starts_with(trim(line), "export type ") then
        gather_exported_names(lines, index + 1, true, append_exported_names(acc, trim(line)))
      else if in_exported_type && string.starts_with(trim(line), "| ") then
        gather_exported_names(lines, index + 1, true, append_unique_name(acc, take_name_from(trim(line), 2)))
      else if string.starts_with(trim(line), "export ") then
        gather_exported_names(lines, index + 1, false, append_exported_names(acc, trim(line)))
      else gather_exported_names(lines, index + 1, false, acc)
  | Nothing -> acc

fn qualify_names(namespace: String, names: Vec String, index: Int, acc: Vec String) -> Vec String =
  match vec_get(index, names) with
  | Just name -> qualify_names(namespace, names, index + 1, vec_append(namespace ++ "." ++ name, acc))
  | Nothing -> acc

fn import_target_module(line: String) -> String =
  if string.find(line, " as ") == -1 then
    if string.find(line, "(") == -1 then trim(line)
    else trim(take_before(line, "("))
  else
    if string.find(trim(take_before(line, " as ")), "(") == -1 then trim(take_before(line, " as "))
    else trim(take_before(trim(take_before(line, " as ")), "("))

fn imported_namespace_ref_for_namespace(namespace: String, line: String) -> Maybe String =
  if trim(take_after(line, " as ")) != "" && lower_ascii(trim(take_after(line, " as "))) == lower_ascii(namespace) then
    Just(trim(take_after(line, " as ")) ++ "|" ++ import_target_module(line))
  else if lower_ascii(module_leaf_name(import_target_module(line))) == lower_ascii(namespace) then
    Just(module_leaf_name(import_target_module(line)) ++ "|" ++ import_target_module(line))
  else Nothing

fn find_imported_namespace_ref(namespace: String, imports: Vec String, index: Int) -> Maybe String =
  match vec_get(index, imports) with
  | Just line ->
      if string.starts_with(trim(line), "import ") then
        match imported_namespace_ref_for_namespace(namespace, trim(drop_prefix(trim(line), "import "))) with
        | Just namespace_ref -> Just(namespace_ref)
        | Nothing -> find_imported_namespace_ref(namespace, imports, index + 1)
      else find_imported_namespace_ref(namespace, imports, index + 1)
  | Nothing -> Nothing

fn dotted_completion_candidates(prefix: String, imports: Vec String) -> Vec String !{IO} =
  match find_imported_namespace_ref(take_before(prefix, "."), imports, 0) with
  | Just namespace_ref ->
      qualify_names(
        take_before(namespace_ref, "|"),
        gather_exported_names(string.string_lines(read_file(module_path(take_after(namespace_ref, "|")))), 0, false, vec_empty()),
        0,
        vec_empty()
      )
  | Nothing -> vec_empty()

fn append_declaration_names(names: Vec String, line: String) -> Vec String =
  if string.starts_with(line, "let ") then append_unique_name(names, take_name_from(line, 4))
  else if string.starts_with(line, "fn ") then append_unique_name(names, take_name_from(line, 3))
  else if string.starts_with(line, "type ") then append_unique_name(names, take_name_from(line, 5))
  else if string.starts_with(line, "class ") then append_unique_name(names, take_name_from(line, 6))
  else if string.starts_with(line, "export ") then append_declaration_names(names, trim(drop_prefix(line, "export ")))
  else names

fn gather_declaration_names(declarations: Vec String, index: Int, acc: Vec String) -> Vec String =
  match vec_get(index, declarations) with
  | Just line -> gather_declaration_names(declarations, index + 1, append_declaration_names(acc, trim(line)))
  | Nothing -> acc

fn completion_candidates_local(line_buffer: String, session: compiler.CompilerSession) -> (String, Vec String) !{IO} =
  match completion_prefix(line_buffer) with
  | prefix ->
      if string.find(prefix, ".") == -1 then
        match prelude_completion_names() with
        | prelude_names ->
            (
              prefix,
              filter_names_by_prefix(
                prefix,
                lower_ascii(prefix),
                gather_declaration_names(
                  compiler.session_declarations(session),
                  0,
                  gather_import_names(
                    compiler.session_imports(session),
                    0,
                    append_names_from_vec(
                      append_names_from_vec(
                        append_names_from_vec(vec_empty(), repl_command_names(), 0),
                        stdlib_module_completion_names(),
                        0
                      ),
                      prelude_names,
                      0
                    )
                  )
                ),
                0,
                vec_empty()
              )
            )
      else
        (
          prefix,
          filter_names_by_prefix(
            prefix,
            lower_ascii(prefix),
            dotted_completion_candidates(prefix, compiler.session_imports(session)),
            0,
            vec_empty()
          )
        )

fn apply_completion(current: String, prefix: String, matches: Vec String) -> String =
  if prefix == "" then current
  else if vec_length(matches) != 1 then current
  else drop_last_count(current, string.length(prefix)) ++ vec_get_or(0, prefix, matches)

fn complete_current_line(prompt: String, history: Vec String, session: compiler.CompilerSession, current: String, cursor: Int) -> Maybe String !{IO} =
  match completion_candidates_local(current, session) with
  | (prefix, matches) ->
      if prefix == "" then interactive_read_line_loop(prompt, history, session, current, string.length(current), -1, current)
      else if vec_length(matches) == 0 then interactive_read_line_loop(prompt, history, session, current, cursor, -1, current)
      else if vec_length(matches) == 1 then
        after(
          redraw_input(prompt, apply_completion(current, prefix, matches), string.length(apply_completion(current, prefix, matches))),
          interactive_read_line_loop(prompt, history, session, apply_completion(current, prefix, matches), string.length(apply_completion(current, prefix, matches)), -1, apply_completion(current, prefix, matches))
        )
      else
        after(
          after(term_write("\r\n"), render_interactive_match_lines(matches, 0)),
          after(redraw_input(prompt, current, cursor), interactive_read_line_loop(prompt, history, session, current, cursor, -1, current))
        )

fn interactive_read_line_step(prompt: String, history: Vec String, session: compiler.CompilerSession, current: String, cursor: Int, browse_index: Int, draft: String, key: String) -> Maybe String !{IO} =
  if key == "" then Nothing
  else if key == "ctrl-d" then if current == "" then after(term_write("\r\n"), Nothing) else interactive_read_line_loop(prompt, history, session, current, cursor, browse_index, draft)
  else if key == "enter" then after(term_write("\r\n"), Just(current))
  else if key == "backspace" then
    if cursor <= 0 then interactive_read_line_loop(prompt, history, session, current, cursor, browse_index, draft)
    else after(redraw_input(prompt, delete_before(current, cursor), cursor - 1), interactive_read_line_loop(prompt, history, session, delete_before(current, cursor), cursor - 1, -1, delete_before(current, cursor)))
  else if key == "escape" then
    interactive_read_line_step(prompt, history, session, current, cursor, browse_index, draft, read_escape_token())
  else if key == "tab" then
    complete_current_line(prompt, history, session, current, cursor)
  else if key == "left" || key == "ctrl-b" then
    if cursor <= 0 then interactive_read_line_loop(prompt, history, session, current, cursor, browse_index, draft)
    else after(redraw_input(prompt, current, cursor - 1), interactive_read_line_loop(prompt, history, session, current, cursor - 1, browse_index, draft))
  else if key == "right" || key == "ctrl-f" then
    if cursor >= string.length(current) then interactive_read_line_loop(prompt, history, session, current, cursor, browse_index, draft)
    else after(redraw_input(prompt, current, cursor + 1), interactive_read_line_loop(prompt, history, session, current, cursor + 1, browse_index, draft))
  else if key == "ctrl-a" then
    after(redraw_input(prompt, current, 0), interactive_read_line_loop(prompt, history, session, current, 0, browse_index, draft))
  else if key == "ctrl-e" then
    after(redraw_input(prompt, current, string.length(current)), interactive_read_line_loop(prompt, history, session, current, string.length(current), browse_index, draft))
  else if key == "up" then
    match history_prev(current, history, browse_index, draft) with
    | (next_current, next_index, next_draft) ->
        after(redraw_input(prompt, next_current, string.length(next_current)), interactive_read_line_loop(prompt, history, session, next_current, string.length(next_current), next_index, next_draft))
  else if key == "down" then
    match history_next(current, history, browse_index, draft) with
    | (next_current, next_index, next_draft) ->
        after(redraw_input(prompt, next_current, string.length(next_current)), interactive_read_line_loop(prompt, history, session, next_current, string.length(next_current), next_index, next_draft))
  else
    after(redraw_input(prompt, insert_at(current, cursor, key), cursor + string.length(key)), interactive_read_line_loop(prompt, history, session, insert_at(current, cursor, key), cursor + string.length(key), -1, insert_at(current, cursor, key)))

fn interactive_read_line_loop(prompt: String, history: Vec String, session: compiler.CompilerSession, current: String, cursor: Int, browse_index: Int, draft: String) -> Maybe String !{IO} =
  interactive_read_line_step(prompt, history, session, current, cursor, browse_index, draft, term_read_key_once())

fn interactive_read_line(prompt: String, history: Vec String, session: compiler.CompilerSession) -> Maybe String !{IO} =
  after(redraw_input(prompt, "", 0), interactive_read_line_loop(prompt, history, session, "", 0, -1, ""))

fn read_input_line(prompt: Maybe String, history: Vec String, session: compiler.CompilerSession) -> Maybe String !{IO} =
  match prompt with
  | Just text -> interactive_read_line(text, history, session)
  | Nothing -> term_read_line_once()

fn append_submission_line(acc: String, line: String) -> String =
  if acc == "" then line else acc ++ "\n" ++ line

fn block_prompt(prompt: Maybe String) -> Maybe String =
  match prompt with
  | Just _ -> Just("block| ")
  | Nothing -> Nothing

fn read_block_submission(prompt: Maybe String, history: Vec String, session: compiler.CompilerSession, acc: String) -> ReadResult !{IO} =
  match read_input_line(block_prompt(prompt), history, session) with
  | Just line ->
      if trim(line) == ":}" then Submission(acc)
      else if trim(line) == ":cancel" || trim(line) == ":abort" then ReadNotice("cancelled block")
      else read_block_submission(prompt, history, session, append_submission_line(acc, line))
  | Nothing -> ReadError("unterminated `:{` block; expected `:}` before end of input")

fn read_submission(prompt: Maybe String, history: Vec String, session: compiler.CompilerSession) -> ReadResult !{IO} =
  match read_input_line(prompt, history, session) with
  | Just line ->
      if trim(line) == ":{" then read_block_submission(prompt, history, session, "")
      else Submission(line)
  | Nothing -> EndInput

fn render_error(message: String) -> Vec String =
  single_line("error: " ++ message)

fn render_unit_result(result: Result String Unit) -> Vec String =
  match result with
  | Ok _ -> single_line("ok")
  | Err message -> render_error(message)

fn render_type_result(result: Result String String) -> Vec String =
  match result with
  | Ok inferred -> single_line(inferred)
  | Err message -> render_error(message)

fn render_expr_result(result: Result String (Vec String)) -> Vec String =
  match result with
  | Ok lines -> lines
  | Err message -> render_error(message)

fn help_lines() -> Vec String =
  single_line("Commands: :type EXPR, :t EXPR, :instances TYPE, :i TYPE, :quit, :help, :{ ... :}, and :cancel inside block mode, plus ordinary import lines")

fn is_declaration(raw: String) -> Bool =
  string.starts_with(raw, "fn ")
  || string.starts_with(raw, "let ")
  || string.starts_with(raw, "type ")
  || string.starts_with(raw, "class ")
  || string.starts_with(raw, "instance ")
  || string.starts_with(raw, "export ")

fn block_line_is_continuation(line: String) -> Bool =
  if line == "" then false
  else
    char_at(line, 0) == " "
      || char_at(line, 0) == "\t"
      || char_at(line, 0) == "|"
      || trim(line) =="}"
      || trim(line) == "else"

fn finalize_block_chunk(chunks: Vec String, current: String) -> Vec String =
  if trim(current) == "" then chunks else vec_append(current, chunks)

fn block_chunks_from_lines(lines: Vec String, index: Int, chunks: Vec String, current: String) -> Vec String =
  match vec_get(index, lines) with
  | Just line ->
      if trim(line) == "" then
        if current == "" then block_chunks_from_lines(lines, index + 1, chunks, current)
        else block_chunks_from_lines(lines, index + 1, chunks, append_submission_line(current, line))
      else if current == "" then block_chunks_from_lines(lines, index + 1, chunks, line)
      else if block_line_is_continuation(line) then
        block_chunks_from_lines(lines, index + 1, chunks, append_submission_line(current, line))
      else
        block_chunks_from_lines(lines, index + 1, finalize_block_chunk(chunks, current), line)
  | Nothing -> finalize_block_chunk(chunks, current)

fn block_chunks(raw: String) -> Vec String =
  block_chunks_from_lines(string.string_lines(raw), 0, vec_empty(), "")

fn handle_type_command(line: String, prefix: String, session: compiler.CompilerSession) -> SubmissionResult !{IO} =
  if trim(drop_prefix(line, prefix)) == "" then Continue(render_error(":type expects an expression"), session)
  else Continue(render_type_result(compiler.type_of(session, trim(drop_prefix(line, prefix)))), session)

fn render_compiler_instances_result(result: Result String compiler.InstanceMatches) -> Vec String =
  match result with
  | Err message -> render_error(message)
  | Ok payload ->
      if vec_length(compiler.instance_match_names(payload)) == 0 then
        single_line("No instances for " ++ compiler.instance_query_type(payload))
      else
        single_line("Instances for " ++ compiler.instance_query_type(payload) ++":" ) ++ compiler.instance_match_names(payload)

fn handle_instances_command(line: String, prefix: String, session: compiler.CompilerSession) -> SubmissionResult !{IO} =
  if trim(drop_prefix(line, prefix)) == "" then Continue(render_error(":instances expects a type"), session)
  else Continue(render_compiler_instances_result(compiler.instances(session, trim(drop_prefix(line, prefix)))), session)

fn handle_import_submission(line: String, session: compiler.CompilerSession) -> SubmissionResult !{IO} =
  match compiler.check(compiler.with_import(line, session)) with
  | Ok _ -> Continue(single_line("ok"), compiler.with_import(line, session))
  | Err message -> Continue(render_error(message), session)

fn handle_declaration_submission(line: String, session: compiler.CompilerSession) -> SubmissionResult !{IO} =
  match compiler.check(compiler.with_declaration(line, session)) with
  | Ok _ -> Continue(single_line("ok"), compiler.with_declaration(line, session))
  | Err message -> Continue(render_error(message), session)

fn handle_trimmed_submission(line: String, session: compiler.CompilerSession) -> SubmissionResult !{IO} =
  if line == "" then Continue(vec_empty(), session)
  else if line == ":help" then Continue(help_lines(), session)
  else if line == ":quit" || line == ":q" || line == ":exit" then Exit
  else if line == "module" || string.starts_with(line, "module ") then
    Continue(render_error("repl manages its module header automatically; use `import ...` directly"), session)
  else if string.starts_with(line, ":type ") then
    handle_type_command(line, ":type ", session)
  else if string.starts_with(line, ":t ") then
    handle_type_command(line, ":t ", session)
  else if string.starts_with(line, ":instances ") then
    handle_instances_command(line, ":instances ", session)
  else if string.starts_with(line, ":i ") then
    handle_instances_command(line, ":i ", session)
  else if string.starts_with(line, "import ") then
    handle_import_submission(line, session)
  else if is_declaration(line) then
    handle_declaration_submission(line, session)
  else
    Continue(render_expr_result(compiler.eval_lines(session, line)), session)

fn handle_submission(raw: String, session: compiler.CompilerSession) -> SubmissionResult !{IO} =
  handle_trimmed_submission(trim(raw), session)

fn continue_block_execution(result: SubmissionResult, chunks: Vec String, index: Int, outputs: Vec String) -> SubmissionResult !{IO} =
  match result with
  | Continue lines next_session ->
      execute_block_chunks(chunks, index + 1, outputs ++ lines, next_session)
  | Exit -> Exit

fn execute_block_chunks(chunks: Vec String, index: Int, outputs: Vec String, session: compiler.CompilerSession) -> SubmissionResult !{IO} =
  match vec_get(index, chunks) with
  | Just chunk -> continue_block_execution(handle_submission(chunk, session), chunks, index, outputs)
  | Nothing -> Continue(outputs, session)

fn handle_block_submission(raw: String, session: compiler.CompilerSession) -> SubmissionResult !{IO} =
  execute_block_chunks(block_chunks(raw), 0, vec_empty(), session)

fn push_history(history: Vec String, raw: String) -> Vec String =
  if trim(raw) == "" then history
  else vec_append(raw, history)

fn continue_loop(result: SubmissionResult, prompt: Maybe String, history: Vec String) -> Unit !{IO} =
  match result with
  | Continue lines next_session ->
      after(render_lines(prompt, lines, 0), repl_loop_session(prompt, history, next_session))
  | Exit -> finish_loop(prompt)

fn run_repl(prompt: Maybe String) -> Unit !{IO} =
  repl_loop_session(prompt, vec_empty(), compiler.empty_session())

fn start_repl(prompt: Maybe String, banner: String) -> Unit !{IO} =
  if banner == "" then run_repl(prompt)
  else after(term_write(banner), run_repl(prompt))

fn repl_loop_session(prompt: Maybe String, history: Vec String, session: compiler.CompilerSession) -> Unit !{IO} =
  match read_submission(prompt, history, session) with
  | Submission line ->
      if string.find(line, "\n") == -1 then
        continue_loop(handle_submission(line, session), prompt, push_history(history, line))
      else
        continue_loop(handle_block_submission(line, session), prompt, push_history(history, line))
  | ReadNotice message -> after(render_lines(prompt, single_line(message), 0), repl_loop_session(prompt, history, session))
  | ReadError message -> after(render_lines(prompt, render_error(message), 0), repl_loop_session(prompt, history, session))
  | EndInput -> finish_loop(prompt)

export fn repl_loop(prompt: Maybe String, history: Vec String, imports: Vec String, declarations: Vec String) -> Unit !{IO} =
  repl_loop_session(prompt, history, compiler.CompilerSession(imports, declarations))

export fn main() -> Unit !{IO} =
  if term_is_interactive_once()
  then start_repl(Just("sprout> "), "Sprout REPL. Use :help for commands.\r\n")
  else start_repl(Nothing, "")
