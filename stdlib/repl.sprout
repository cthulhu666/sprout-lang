module stdlib.repl
import stdlib.terminal (term_is_interactive_once, term_read_key_once, term_read_line_once)
import stdlib.string as string

type SubmissionResult =
  | Continue (Vec String) (Vec String) (Vec String)
  | Exit

fn then_io(a: Unit !{IO}, b: Unit !{IO}) -> Unit !{IO} = b

fn term_noop() -> Unit !{IO} =
  term_write("")

fn write_line(prompt: Maybe String, text: String) -> Unit !{IO} =
  match prompt with
  | Just _ -> term_write(text ++ "\r\n")
  | Nothing -> print(text)

fn finish_loop(prompt: Maybe String) -> Unit !{IO} =
  match prompt with
  | Just _ -> term_write("\r\n")
  | Nothing -> term_noop()

fn render_lines(prompt: Maybe String, lines: Vec String, index: Int) -> Unit !{IO} =
  match vec_get(index, lines) with
  | Just line -> then_io(write_line(prompt, line), render_lines(prompt, lines, index + 1))
  | Nothing -> term_noop()

fn single_line(text: String) -> Vec String =
  vec_append(text, vec_empty())

fn char_at(raw: String, index: Int) -> String =
  string.slice(raw, index, 1)

fn trim_left(raw: String) -> String =
  if string.length(raw) == 0 then raw
  else if char_at(raw, 0) == " " then trim_left(string.slice(raw, 1, string.length(raw) - 1))
  else if char_at(raw, 0) == "\t" then trim_left(string.slice(raw, 1, string.length(raw) - 1))
  else raw

fn trim_right(raw: String) -> String =
  if string.length(raw) == 0 then raw
  else if char_at(raw, string.length(raw) - 1) == " " then trim_right(string.slice(raw, 0, string.length(raw) - 1))
  else if char_at(raw, string.length(raw) - 1) == "\t" then trim_right(string.slice(raw, 0, string.length(raw) - 1))
  else raw

fn trim(raw: String) -> String =
  trim_right(trim_left(raw))

fn drop_prefix(raw: String, prefix: String) -> String =
  string.slice(raw, string.length(prefix), string.length(raw) - string.length(prefix))

fn drop_last(raw: String) -> String =
  if string.length(raw) == 0 then raw
  else string.slice(raw, 0, string.length(raw) - 1)

fn drop_last_count(raw: String, count: Int) -> String =
  if count <= 0 then raw
  else if count >= string.length(raw) then ""
  else string.slice(raw, 0, string.length(raw) - count)

fn redraw_input(prompt: String, current: String) -> Unit !{IO} =
  keep_after(
    term_write("\r" ++ prompt ++ current ++ " "),
    term_write("\r" ++ prompt ++ current)
  )

fn ignore_key(value: String !{IO}) -> Unit !{IO} =
  term_noop()

fn escape_token(second: String, third: String) -> String =
  if second != "[" then "escape"
  else if third == "A" then "up"
  else if third == "B" then "down"
  else if third == "C" then "right"
  else if third == "D" then "left"
  else "escape"

fn read_escape_token_second(second: String) -> String !{IO} =
  if second == "[" then escape_token(second, term_read_key_once())
  else second

fn read_escape_token() -> String !{IO} =
  read_escape_token_second(term_read_key_once())

fn history_value(index: Int, fallback: String, history: Vec String) -> String =
  vec_get_or(index, fallback, history)

fn history_prev(current: String, history: Vec String, browse_index: Int, draft: String) -> (String, Int, String) =
  if vec_length(history) == 0 then (current, browse_index, draft)
  else if browse_index < 0 then
    (history_value(vec_length(history) - 1, current, history), vec_length(history) - 1, current)
  else if browse_index == 0 then
    (current, browse_index, draft)
  else
    (history_value(browse_index - 1, current, history), browse_index - 1, draft)

fn history_next(current: String, history: Vec String, browse_index: Int, draft: String) -> (String, Int, String) =
  if browse_index < 0 then (current, browse_index, draft)
  else if browse_index + 1 >= vec_length(history) then (draft, -1, draft)
  else (history_value(browse_index + 1, current, history), browse_index + 1, draft)

fn render_interactive_match_lines(matches: Vec String, index: Int) -> Unit !{IO} =
  match vec_get(index, matches) with
  | Just line -> then_io(term_write(line ++ "\r\n"), render_interactive_match_lines(matches, index + 1))
  | Nothing -> term_noop()

fn apply_completion(current: String, prefix: String, matches: Vec String) -> String =
  if prefix == "" then current
  else if vec_length(matches) != 1 then current
  else drop_last_count(current, string.length(prefix)) ++ vec_get_or(0, prefix, matches)

fn complete_current_line(prompt: String, history: Vec String, current: String) -> Maybe String !{IO} =
  match repl_complete(current) with
  | (prefix, matches) ->
      if prefix == "" then interactive_read_line_loop(prompt, history, current, -1, current)
      else if vec_length(matches) == 0 then interactive_read_line_loop(prompt, history, current, -1, current)
      else if vec_length(matches) == 1 then
        keep_after(
          redraw_input(prompt, apply_completion(current, prefix, matches)),
          interactive_read_line_loop(prompt, history, apply_completion(current, prefix, matches), -1, apply_completion(current, prefix, matches))
        )
      else
        keep_after(
          then_io(term_write("\r\n"), render_interactive_match_lines(matches, 0)),
          keep_after(redraw_input(prompt, current), interactive_read_line_loop(prompt, history, current, -1, current))
        )

fn interactive_read_line_step(prompt: String, history: Vec String, current: String, browse_index: Int, draft: String, key: String) -> Maybe String !{IO} =
  if key == "" then Nothing
  else if key == "ctrl-d" then if current == "" then keep_after(term_write("\r\n"), Nothing) else interactive_read_line_loop(prompt, history, current, browse_index, draft)
  else if key == "enter" then keep_after(term_write("\r\n"), Just(current))
  else if key == "backspace" then
    keep_after(redraw_input(prompt, drop_last(current)), interactive_read_line_loop(prompt, history, drop_last(current), -1, drop_last(current)))
  else if key == "escape" then
    interactive_read_line_step(prompt, history, current, browse_index, draft, read_escape_token())
  else if key == "tab" then
    complete_current_line(prompt, history, current)
  else if key == "up" then
    match history_prev(current, history, browse_index, draft) with
    | (next_current, next_index, next_draft) ->
        keep_after(redraw_input(prompt, next_current), interactive_read_line_loop(prompt, history, next_current, next_index, next_draft))
  else if key == "down" then
    match history_next(current, history, browse_index, draft) with
    | (next_current, next_index, next_draft) ->
        keep_after(redraw_input(prompt, next_current), interactive_read_line_loop(prompt, history, next_current, next_index, next_draft))
  else
    keep_after(redraw_input(prompt, current ++ key), interactive_read_line_loop(prompt, history, current ++ key, -1, current ++ key))

fn interactive_read_line_loop(prompt: String, history: Vec String, current: String, browse_index: Int, draft: String) -> Maybe String !{IO} =
  interactive_read_line_step(prompt, history, current, browse_index, draft, term_read_key_once())

fn interactive_read_line(prompt: String, history: Vec String) -> Maybe String !{IO} =
  keep_after(redraw_input(prompt, ""), interactive_read_line_loop(prompt, history, "", -1, ""))

fn read_submission(prompt: Maybe String, history: Vec String) -> Maybe String !{IO} =
  match prompt with
  | Just text -> interactive_read_line(text, history)
  | Nothing -> term_read_line_once()

fn render_error(message: String) -> Vec String =
  single_line("error: " ++ message)

fn render_unit_result(result: Result String Unit) -> Vec String =
  match result with
  | Ok _ -> single_line("ok")
  | Err message -> render_error(message)

fn render_type_result(result: Result String String) -> Vec String =
  match result with
  | Ok inferred -> single_line(inferred)
  | Err message -> render_error(message)

fn render_expr_result(result: Result String (Vec String)) -> Vec String =
  match result with
  | Ok lines -> lines
  | Err message -> render_error(message)

fn render_instances_result(result: Result String (String, Vec String)) -> Vec String =
  match result with
  | Err message -> render_error(message)
  | Ok pair ->
      match pair with
      | (query_type, matches) ->
          if vec_length(matches) == 0 then single_line("No instances for " ++ query_type)
          else single_line("Instances for " ++ query_type ++ ":") ++ matches

fn help_lines() -> Vec String =
  single_line("Commands: :type EXPR, :t EXPR, :instances TYPE, :i TYPE, :quit, :help, plus ordinary import lines")

fn is_declaration(raw: String) -> Bool =
  string.starts_with(raw, "fn ")
  || string.starts_with(raw, "let ")
  || string.starts_with(raw, "type ")
  || string.starts_with(raw, "class ")
  || string.starts_with(raw, "instance ")
  || string.starts_with(raw, "export ")

fn append_source_block(acc: String, block: String) -> String =
  if block == "" then acc
  else if acc == "" then block
  else acc ++ "\n\n" ++ block

fn append_source_blocks(acc: String, blocks: Vec String, index: Int) -> String =
  match vec_get(index, blocks) with
  | Just block -> append_source_blocks(append_source_block(acc, block), blocks, index + 1)
  | Nothing -> acc

fn session_source(imports: Vec String, declarations: Vec String) -> String =
  append_source_blocks(append_source_blocks("module app.repl", imports, 0), declarations, 0)

fn handle_type_command(line: String, prefix: String, imports: Vec String, declarations: Vec String) -> SubmissionResult !{IO} =
  if trim(drop_prefix(line, prefix)) == "" then Continue(render_error(":type expects an expression"), imports, declarations)
  else Continue(render_type_result(repl_type_of_in_source(session_source(imports, declarations), trim(drop_prefix(line, prefix)))), imports, declarations)

fn handle_instances_command(line: String, prefix: String, imports: Vec String, declarations: Vec String) -> SubmissionResult !{IO} =
  if trim(drop_prefix(line, prefix)) == "" then Continue(render_error(":instances expects a type"), imports, declarations)
  else Continue(render_instances_result(repl_instances_in_source(session_source(imports, declarations), trim(drop_prefix(line, prefix)))), imports, declarations)

fn handle_trimmed_submission(line: String, imports: Vec String, declarations: Vec String) -> SubmissionResult !{IO} =
  if line == "" then Continue(vec_empty(), imports, declarations)
  else if line == ":help" then Continue(help_lines(), imports, declarations)
  else if line == ":quit" || line == ":q" || line == ":exit" then Exit
  else if line == "module" || string.starts_with(line, "module ") then
    Continue(render_error("repl manages its module header automatically; use `import ...` directly"), imports, declarations)
  else if string.starts_with(line, ":type ") then
    handle_type_command(line, ":type ", imports, declarations)
  else if string.starts_with(line, ":t ") then
    handle_type_command(line, ":t ", imports, declarations)
  else if string.starts_with(line, ":instances ") then
    handle_instances_command(line, ":instances ", imports, declarations)
  else if string.starts_with(line, ":i ") then
    handle_instances_command(line, ":i ", imports, declarations)
  else if string.starts_with(line, "import ") then
    match repl_add_import(line) with
    | Ok _ -> Continue(single_line("ok"), vec_append(line, imports), declarations)
    | Err message -> Continue(render_error(message), imports, declarations)
  else if is_declaration(line) then
    match repl_add_declaration(line) with
    | Ok _ -> Continue(single_line("ok"), imports, vec_append(line, declarations))
    | Err message -> Continue(render_error(message), imports, declarations)
  else
    Continue(render_expr_result(repl_eval_expr(line)), imports, declarations)

fn handle_submission(raw: String, imports: Vec String, declarations: Vec String) -> SubmissionResult !{IO} =
  handle_trimmed_submission(trim(raw), imports, declarations)

fn push_history(history: Vec String, raw: String) -> Vec String =
  if trim(raw) == "" then history
  else vec_append(raw, history)

fn continue_loop(result: SubmissionResult, prompt: Maybe String, history: Vec String) -> Unit !{IO} =
  match result with
  | Continue lines next_imports next_declarations ->
      then_io(render_lines(prompt, lines, 0), repl_loop(prompt, history, next_imports, next_declarations))
  | Exit -> finish_loop(prompt)

export fn repl_loop(prompt: Maybe String, history: Vec String, imports: Vec String, declarations: Vec String) -> Unit !{IO} =
  match read_submission(prompt, history) with
  | Just line -> continue_loop(handle_submission(line, imports, declarations), prompt, push_history(history, line))
  | Nothing -> finish_loop(prompt)

export fn main() -> Unit !{IO} =
  then_io(
    repl_reset_session(),
    if term_is_interactive_once()
    then then_io(term_write("Sprout REPL. Use :help for commands.\r\n"), repl_loop(Just("sprout> "), vec_empty(), vec_empty(), vec_empty()))
    else repl_loop(Nothing, vec_empty(), vec_empty(), vec_empty())
  )
