module stdlib.task

# Structured concurrency (EXPERIMENTAL): cooperative green tasks on one OS thread.
# `with_scope` opens a scope, runs the body, then joins: it returns only once every
# task spawned into the scope has finished or been dropped by a cancel.
#
#   task_spawn — fire-and-forget; the task is reclaimed when it finishes.
#   task_fork  — returns a linear `Task a`, consumed by `task_await` (its value) or
#                `detach`. A dropped or twice-awaited handle is a compile error.
#
# task_await returns the task's value as-is: a task producing `Result e b` hands back
# `Result e b`. A failing task does not stop its siblings; the owner calls
# `scope_cancel` (docs/concurrency-cancellation-design-2026-07-15.md).

export type Scope =
  | Scope Int

export type linear Task a =
  | Task Int

# The outcome of `with_timeout`. `Completed a` carries the body's result. `Expired` means the
# deadline fired first and the body was dropped, or `ms <= 0` and the body never ran. A value,
# not an exception: Sprout has none.
export type TimeoutResult a (..) =
  | Completed a
  | Expired

# Why the current task's scope is stopping (Go's ctx.Err(): nil / Canceled / DeadlineExceeded).
export type TaskStatus (..) =
  | Running
  | Cancelled
  | TimedOut

# Runtime primitives (green-thread scheduler; cannot be expressed in Sprout —
# they require stack/context switching). See runtime/APPROVED_BUILTINS.
extern fn __scope_open() -> Int !{IO}
extern fn __scope_join(scope_id: Int) -> Unit !{IO}
# Extern modes are unchecked. `work` is `once`: the scheduler runs a task at most once.
extern fn __scope_spawn(scope_id: Int, work: once Unit -> Unit !{IO}) -> Unit !{IO}
# `work` is `once local`: at most once, as above. `local` is a claim the caller must keep: a
# `local` closure must never run after its owner returns. run_with_deadline does: with_timeout
# parks in __await_deadline until the child finishes or is force-dropped, then joins the scope.
extern fn __task_fork(scope_id: Int, work: once local Unit -> a !{IO}) -> Int !{IO}
extern fn __task_await(task_id: Int) -> a !{IO}
extern fn __scope_cancel(scope_id: Int) -> Unit !{IO}
extern fn __task_sleep(ms: Int) -> Unit !{IO}
# __await_deadline arms a deadline timer on the owner and parks until the already-forked child
# finishes (True) or the deadline fires (False, child dropped). __task_stop_reason returns the
# current scope's stop reason: 0 none, 1 cancelled, 2 timed out.
extern fn __await_deadline(scope_id: Int, task_id: Int, ms: Int) -> Bool !{IO}
extern fn __task_stop_reason() -> Int !{IO}

# Cooperative yield point: suspend the current task and let the scheduler run
# another ready task. (Real I/O parking, in the tcp_* builtins, yields implicitly.)
export extern fn task_yield() -> Unit !{IO}

# Expose a scope's raw scheduler handle for sibling stdlib modules that must pass a scope
# to a scheduler builtin without owning the opaque `Scope` constructor (e.g. stdlib.chan's
# chan_new). This is a READ-ONLY accessor — the returned Int is an opaque, generation-checked
# scheduler handle, and the `Scope` constructor stays module-private (no `(..)`), so a scope
# handle still cannot be forged. Not intended for user code.
export fn scope_handle(scope: Scope) -> Int =
  match scope with
  | Scope id -> id

# Open a scope, run `body`, then block until all tasks spawned into it finish,
# and return the body's result. The join runs whatever `body` returns, so no
# spawned task outlives the scope. The `Scope` and any `Chan` made from it do not outlive
# it either: using one afterwards aborts with a named error.
export fn with_scope(body: once local Scope -> a !{IO}) -> a !{IO} =
  do
    id <- __scope_open()
    let result = body(Scope(id))
    __scope_join(id)
    result

# Spawn `work` as a fire-and-forget task in `scope`. It is queued, and starts once the
# current task yields, parks or joins.
#
# `work` is `once`: the scheduler calls it at most once and user code never holds it, so a
# caller may move a linear value in (http_server moves each accepted connection to its
# handler). That the task runs at all comes from `with_scope`'s join, not the type, and a
# cancel that finds the task parked drops it with what it holds (see `scope_cancel`).
export fn task_spawn(scope: Scope, work: once Unit -> Unit !{IO}) -> Unit !{IO} =
  match scope with
  | Scope id -> __scope_spawn(id, work)

# Fork `work` as an awaitable green task belonging to `scope`, returning a handle
# whose value is retrieved with task_await. The task's result is kept alive until
# it is awaited (or the scope closes, which reclaims any never-awaited forks).
export fn task_fork(scope: Scope, work: once Unit -> a !{IO}) -> Task a !{IO} =
  match scope with
  | Scope id -> Task(__task_fork(id, work))

# Block until `task` has finished, then return its value RAW (no unwrapping).
# `task` is consumed here; awaiting the same handle twice is a compile error
# (linear reuse). To discard a handle without awaiting, use `detach`.
export fn task_await(task: Task a) -> a !{IO} =
  match task with
  | Task id -> __task_await(id)

# Relinquish a task handle without awaiting its result — the linear consume for
# the "I will not await this" path (e.g. a conditional fork). No runtime action:
# a never-awaited fork is already reclaimed when the scope closes, so `detach`
# exists only so the discard is an explicit linear consume rather than a leak.
# Mirrors C++ std::thread::detach / dropping a Rust JoinHandle.
export fn detach(task: Task a) -> Unit =
  match task with
  | Task _ -> ()

# Cancel the tasks in `scope` (EXPERIMENTAL). Only the task that opened it (the `with_scope`
# body) may call this; anyone else aborts the program. A task parked on I/O, `task_sleep`, a
# channel or `select` is dropped. A running or yielding task sees `task_cancelled()` and returns
# on its own; a task not yet started runs normally; one waiting in a nested join or
# `task_await` is left alone.
#
# LEAK: a dropped task never finishes, so a linear value it holds, moved in or created inside,
# is never released, though the program type-checks. Until the scheduler releases on drop, do
# not cancel a scope whose tasks hold a linear resource across a park (spec §5.8).
export fn scope_cancel(scope: Scope) -> Unit !{IO} =
  match scope with
  | Scope id -> __scope_cancel(id)

# True once the current task's scope is cancelled (Go's `ctx.Done()`). A cancellable task
# checks it at its loop or yield points and returns. A `with_timeout` deadline does not set it
# for a body that only yields; see `with_timeout`.
export fn task_cancelled() -> Bool !{IO} =
  __task_stop_reason() != 0

# Why the current task's scope is stopping (Go's `ctx.Err()`): `Running`, or `Cancelled` after
# `scope_cancel`. `TimedOut` is never observed today: the runtime sets it only when it drops
# the timed body, which is the scope's one task.
export fn task_status() -> TaskStatus !{IO} =
  match __task_stop_reason() with
  | 1 -> Cancelled
  | 2 -> TimedOut
  | _ -> Running

# Suspend the current green task for ~`ms` milliseconds, running its siblings meanwhile —
# a cooperative sleep that parks the TASK, not the OS thread (Go `time.Sleep` / Kotlin
# `delay`). Timing is best-effort: at least `ms`, then whenever the scheduler next runs
# this task. `ms <= 0` yields once to siblings without arming a timer (a zero-length timer
# is a backend-divergent no-op/hang). A task sleeping in a cancelled scope is dropped by
# the scheduler, exactly like one parked on I/O
# (docs/concurrency-task-sleep-design-2026-07-15.md).
export fn task_sleep(ms: Int) -> Unit !{IO} =
  if ms <= 0 then
    task_yield()
  else
    __task_sleep(ms)

# Run `body` as a child task. If it is still parked when ~`ms` milliseconds pass, drop it and
# return `Expired`; otherwise `Completed(result)`. `ms <= 0` returns `Expired` without running it.
#
# Only a body that parks (I/O, `task_sleep`, a channel or `select`) can be timed out. One that
# only yields runs to completion past the deadline. One blocked in a nested `with_scope`,
# `task_await` or `with_timeout` aborts the program when the deadline fires. Overshoot past
# `ms` is at most one scheduling step of the body.
#
# `body` is `local`: it may borrow a value the caller holds, and the caller releases it after
# either outcome. Moving a value in is a compile error, since `Expired` would leak it
# (docs/concurrency-deadlines-design-2026-07-15.md).
export fn with_timeout(ms: Int, body: local Unit -> a !{IO}) -> TimeoutResult a !{IO} =
  if ms <= 0 then
    Expired
  else
    with_scope(\s -> run_with_deadline(s, body, ms))

# The child is forked FIRST (so it exists before the deadline is armed), then awaited against the
# deadline. do-binding sequences the two effects explicitly (not argument-evaluation order).
fn run_with_deadline(scope: Scope, body: local Unit -> a !{IO}, ms: Int) -> TimeoutResult a !{IO} =
  match scope with
  | Scope sid ->
    do
      handle <- fork_local(sid, body)
      await_and_finish(sid, handle, ms)

# task_fork's `work` is a non-local `once` slot, so a `local` body cannot go through it.
fn fork_local(sid: Int, body: local Unit -> a !{IO}) -> Task a !{IO} =
  Task(__task_fork(sid, body))

# `handle` is consumed by the match that extracts its task id (`tid`), which arms the deadline; the
# id — not the linear handle — then drives the finish. Inspecting the handle exactly once (no
# peek-then-forward) keeps this linear-clean: `tid` is a plain Int, so both outcomes below consume
# zero further linear values and branch convergence holds trivially.
fn await_and_finish(sid: Int, handle: Task a, ms: Int) -> TimeoutResult a !{IO} =
  match handle with
  | Task tid ->
    do
      completed <- __await_deadline(sid, tid, ms)
      finish_by_id(tid, completed)

# On `completed`, the child is already done, so `__task_await` returns immediately with its result.
# On the `Expired` path the child was force-dropped, so `__task_await` is NOT called on it (which
# would loud-fail on a dropped task).
fn finish_by_id(tid: Int, completed: Bool) -> TimeoutResult a !{IO} =
  if completed then
    complete_by_id(tid)
  else
    Expired

fn complete_by_id(tid: Int) -> TimeoutResult a !{IO} =
  do
    v <- __task_await(tid)
    Completed(v)
