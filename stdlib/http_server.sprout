module stdlib.http_server

import stdlib.http (HttpStatusError, RequestLine, RequestPathVersion, http_response, parse_request_line, status_line)
import stdlib.net (tcp_listen, tcp_accept, tcp_read_avail, tcp_write_string, tcp_close, tcp_close_listener)
import stdlib.string as string
import stdlib.task (Scope, with_scope, task_spawn)
import stdlib.url (parse_query)

export type HttpRequest =
  | HttpRequest String String HttpRequestMeta

type HttpRequestMeta =
  | HttpRequestMeta String (Dict String) String

export type HttpServerResponse =
  | HttpServerResponse Int (Dict String) String

export type HttpServerError (..) =
  | HttpInvalidRequest String
  | HttpServerUnsupportedStatus Int

type alias ServerResult a = Result HttpServerError a

fn find_headers_end(raw: String) -> Maybe Int =
  string.find(raw, "\r\n\r\n")

fn find_line_end(raw: String) -> Maybe Int =
  string.find(raw, "\r\n")

fn char_at(raw: String, index: Int) -> Char =
  string.char_at_or(raw, index, '?')

fn lower_char(ch: Char) -> Char =
  match string.find("ABCDEFGHIJKLMNOPQRSTUVWXYZ", string.string_from_char(ch)) with
  | Nothing -> ch
  | Just pos -> string.char_at_or("abcdefghijklmnopqrstuvwxyz", pos, '?')

fn lower_ascii_from(raw: String, index: Int, total: Int, acc: String) -> String =
  if index >= total then acc
  else lower_ascii_from(raw, index + 1, total, string.concat(acc, string.string_from_char(lower_char(char_at(raw, index)))))

fn lower_ascii(raw: String) -> String =
  lower_ascii_from(raw, 0, string.length(raw), "")

fn split_lines_from(raw: String, index: Int, total: Int, acc: Vec String, current: String) -> Vec String =
  if index >= total then vec_append(current, acc)
  else if char_at(raw, index) == '\r' then split_lines_from(raw, index + 1, total, acc, current)
  else if char_at(raw, index) == '\n' then split_lines_from(raw, index + 1, total, vec_append(current, acc), "")
  else split_lines_from(raw, index + 1, total, acc, string.concat(current, string.string_from_char(char_at(raw, index))))

fn split_lines(raw: String) -> Vec String =
  split_lines_from(raw, 0, string.length(raw), vec_empty(), "")

fn parse_header_pair(pair: (String, String)) -> Maybe (String, String) =
  match pair with
  | (name, value) ->
      if string.is_empty(name) then Nothing
      else Just((lower_ascii(string.trim(name)), string.trim(value)))

fn parse_header_line(raw: String) -> Maybe (String, String) =
  match string.split_once(raw, ":") with
  | Nothing -> Nothing
  | Just pair -> parse_header_pair(pair)

fn result_from_maybe(err: e, value: Maybe a) -> Result e a =
  match value with
  | Nothing -> Err(err)
  | Just unwrapped -> Ok(unwrapped)

fn parse_header_lines(lines: Vec String, index: Int, total: Int, headers: Dict String) -> ServerResult (Dict String) =
  if index >= total then Ok(headers)
  else
    match vec_get(index, lines) with
    | Nothing -> Ok(headers)
    | Just line ->
        if string.is_empty(line) then parse_header_lines(lines, index + 1, total, headers)
        else
          do
            pair <- result_from_maybe(HttpInvalidRequest("invalid header line"), parse_header_line(line))
            match pair with
            | (name, value) -> parse_header_lines(lines, index + 1, total, dict_set(name, value, headers))

fn parse_headers(raw: String) -> ServerResult (Dict String) =
  parse_header_lines(lines, 0, vec_length(lines), dict_empty())
where
  lines = split_lines(raw)

# W8/P1: parse_int is now total (Maybe Int), so the all_digits predicate is
# redundant. Still reject negatives (the old digits check excluded '-').
fn parse_content_length(headers: Dict String) -> ServerResult Int =
  match dict_get("content-length", headers) with
  | Nothing -> Ok(0)
  | Just raw ->
      if string.is_empty(raw) then Err(HttpInvalidRequest("empty Content-Length"))
      else content_length_result(parse_int(raw))

fn content_length_result(m: Maybe Int) -> ServerResult Int =
  match m with
  | Just n -> if n >= 0 then Ok(n) else Err(HttpInvalidRequest("invalid Content-Length"))
  | Nothing -> Err(HttpInvalidRequest("invalid Content-Length"))

fn request_body_start(raw: String) -> Maybe Int =
  match find_headers_end(raw) with
  | Nothing -> Nothing
  | Just pos -> Just(pos + 4)

# The header block spans from just past the request line to the blank-line
# terminator. A header-less request (HTTP/1.0-style) has the terminator right after
# the request line, so `headers_end <= header_start` — return "" rather than slicing
# a negative length (which aborts in str_slice).
fn header_block(raw: String, line_end: Int, headers_end: Int) -> String =
  if headers_end <= header_start then ""
  else string.slice(raw, header_start, headers_end - header_start)
where
  header_start = line_end + 2

fn parse_request_prefix(raw: String) -> ServerResult (RequestLine, Dict String, Int) =
  match find_headers_end(raw) with
  | Nothing -> Err(HttpInvalidRequest("missing header terminator"))
  | Just headers_end ->
      match find_line_end(raw) with
      | Nothing -> Err(HttpInvalidRequest("missing request line terminator"))
      | Just line_end ->
          do
            req <- result_from_maybe(HttpInvalidRequest("invalid request line"), parse_request_line(string.take(raw, line_end)))
            headers <- parse_headers(header_block(raw, line_end, headers_end))
            content_length <- parse_content_length(headers)
            Ok((req, headers, content_length))

fn build_request(req: RequestLine, headers: Dict String, body: String) -> HttpRequest =
  match req with
  | RequestLine method pv ->
      match pv with
      | RequestPathVersion path version -> HttpRequest(method, path, HttpRequestMeta(version, headers, body))

export fn parse(raw: String) -> ServerResult HttpRequest =
  do
    prefix <- parse_request_prefix(raw)
    parse_from_prefix(raw, prefix)

fn parse_from_prefix(raw: String, prefix: (RequestLine, Dict String, Int)) -> ServerResult HttpRequest =
  err_or_request(req, headers, content_length, raw)
where
  (req, headers, content_length) = prefix

fn err_or_request(req: RequestLine, headers: Dict String, content_length: Int, raw: String) -> ServerResult HttpRequest =
  match request_body_start(raw) with
  | Nothing -> Err(HttpInvalidRequest("missing header terminator"))
  | Just body_start ->
      if string.length(string.drop(raw, body_start)) < content_length then
        Err(HttpInvalidRequest("request body shorter than Content-Length"))
      else
        Ok(build_request(req, headers, string.take(string.drop(raw, body_start), content_length)))

# Reads use tcp_read_avail (recoverable): a socket failure becomes an Err in the
# ServerResult, not an exit(1), so one client's connection reset drops just that
# connection. `Ok("")` (peer closed cleanly) is still the unexpected-end-of-stream case.
fn read_until_headers(conn: Int, acc: String) -> ServerResult String !{IO} =
  match find_headers_end(acc) with
  | Just _ -> Ok(acc)
  | Nothing ->
      match tcp_read_avail(conn) with
      | Err _ -> Err(HttpInvalidRequest("connection error"))
      | Ok chunk ->
          if string.is_empty(chunk) then Err(HttpInvalidRequest("unexpected end of stream"))
          else read_until_headers(conn, string.concat(acc, chunk))

fn read_remaining_body(conn: Int, acc: String, remaining: Int) -> ServerResult String !{IO} =
  if remaining <= 0 then Ok(acc)
  else
    match tcp_read_avail(conn) with
    | Err _ -> Err(HttpInvalidRequest("connection error"))
    | Ok chunk ->
        if string.is_empty(chunk) then Err(HttpInvalidRequest("unexpected end of stream"))
        else read_remaining_body(conn, string.concat(acc, chunk), remaining - string.length(chunk))

fn read_request(conn: Int) -> ServerResult HttpRequest !{IO} =
  do
    raw <- read_until_headers(conn, "")
    read_request_from_prefix(conn, raw)

fn read_request_from_prefix(conn: Int, raw: String) -> ServerResult HttpRequest !{IO} =
  do
    prefix <- parse_request_prefix(raw)
    continue_read_request(conn, raw, prefix)

fn continue_read_request(conn: Int, raw: String, prefix: (RequestLine, Dict String, Int)) -> ServerResult HttpRequest !{IO} =
  if string.length(body) >= content_length then parse(raw)
  else
    do
      full <- read_remaining_body(conn, raw, content_length - string.length(body))
      parse(full)
where
  (_req, _headers, content_length) = prefix
  body_start = match request_body_start(raw) with | Nothing -> 0 | Just pos -> pos
  body = string.drop(raw, body_start)

fn headers_to_lines(keys: Vec String, headers: Dict String, index: Int, total: Int, acc: String) -> String =
  if index >= total then acc
  else
    match vec_get(index, keys) with
    | Nothing -> acc
    | Just key ->
        match dict_get(key, headers) with
        | Nothing -> headers_to_lines(keys, headers, index + 1, total, acc)
        | Just value ->
            headers_to_lines(
              keys,
              headers,
              index + 1,
              total,
              string.concat(acc, string.concat(key, string.concat(": ", string.concat(value, "\r\n"))))
            )

fn render_extra_headers(headers: Dict String) -> String =
  headers_to_lines(keys, headers, 0, vec_length(keys), "")
where
  keys = dict_keys(headers)

# Set `name` to `value` only if the caller has not already provided it. Lets `render`
# supply defaults (content-type, connection) that a handler's `with_header` overrides.
fn with_default_header(name: String, value: String, headers: Dict String) -> Dict String =
  match dict_get(name, headers) with
  | Just _ -> headers
  | Nothing -> dict_set(name, value, headers)

# The final header set written to the wire: caller headers, plus defaulted
# content-type/connection, plus an *always* byte-accurate content-length (framing is
# the server's responsibility, so it overrides any caller-supplied value). Keys are
# lowercase throughout, so each header appears exactly once — no duplicates.
fn response_headers(headers: Dict String, body: String) -> Dict String =
  dict_set(
    "content-length",
    int_to_string(string.byte_length(body)),
    with_default_header("connection", "close", with_default_header("content-type", "text/plain", headers))
  )

fn assemble_response(line: String, headers: Dict String, body: String) -> String =
  string.concat(line, string.concat("\r\n", string.concat(render_extra_headers(headers), string.concat("\r\n", body))))

export fn response(status: Int, body: String) -> HttpServerResponse =
  HttpServerResponse(status, dict_empty(), body)

# The numeric status of a response — the accessor a logging/metrics middleware
# needs, since the HttpServerResponse constructor is not exported for matching.
export fn response_status(resp: HttpServerResponse) -> Int =
  match resp with
  | HttpServerResponse status _ _ -> status

export fn ok(body: String) -> HttpServerResponse =
  response(200, body)

export fn bad_request(body: String) -> HttpServerResponse =
  response(400, body)

export fn not_found(body: String) -> HttpServerResponse =
  response(404, body)

# A 303 See Other redirect to `location`, with an empty body. This is the Post/
# Redirect/Get pattern: a form handler mutates state on POST, then returns this so the
# browser re-GETs `location` — a refresh reloads the result page instead of re-POSTing
# the form. `render` needs `303` in the shared status table (stdlib.http).
export fn see_other(location: String) -> HttpServerResponse =
  with_header("location", location, response(303, ""))

export fn with_header(name: String, value: String, resp: HttpServerResponse) -> HttpServerResponse =
  match resp with
  | HttpServerResponse status headers body -> HttpServerResponse(status, dict_set(header_name, value, headers), body)
where
  header_name = lower_ascii(name)

# --- Routing ---------------------------------------------------------------
# A route pairs an HTTP method and an exact path with a handler. `dispatch` scans
# the table in order and runs the first match, falling through to 404. Matching is
# O(routes) per request; a linear scan is the right shape for the handful of routes a
# small server declares — no Dict indirection.
#
# Handlers carry the `!{IO}` effect, so a handler may read/write shared state (e.g. a
# `Ref`-backed store) or touch the network/disk while building its response — the
# effect propagates through `dispatch`/`serve`. A pure handler still fits: `!{IO}` is
# additive, so `\req -> ok("hi")` subsumes into the effectful slot unchanged.
export type Route (..) =
  | Route String String (HttpRequest -> HttpServerResponse !{IO})

# `request_path` returns the raw target including any `?query`, so match on the path
# up to the first `?` — otherwise `/search?q=foo` would never match a `/search` route.
fn path_before_query(path: String) -> String =
  match string.split_once(path, "?") with
  | Nothing -> path
  | Just parts -> match parts with | (base, _) -> base

fn route_matches(route: Route, method: String, path: String) -> Bool =
  match route with
  | Route route_method route_path _ -> route_method == method && route_path == path

fn run_route(route: Route, req: HttpRequest) -> HttpServerResponse !{IO} =
  match route with
  | Route _ _ handler -> handler(req)

fn dispatch_from(routes: Vec Route, index: Int, total: Int, method: String, path: String, req: HttpRequest) -> HttpServerResponse !{IO} =
  if index >= total then not_found("not found")
  else
    match vec_get(index, routes) with
    | Nothing -> not_found("not found")
    | Just route ->
        if route_matches(route, method, path) then run_route(route, req)
        else dispatch_from(routes, index + 1, total, method, path, req)

# Dispatch a parsed request to its route's handler, or a 404 response when none
# matches. Runs the matched handler, so it carries the handler's `!{IO}` effect — but
# it does no socket I/O of its own, so it still composes with `serve` as
# `serve(port, \req -> dispatch(routes, req))` and is testable without sockets (drive
# it from an already-parsed request and inspect the response).
export fn dispatch(routes: Vec Route, req: HttpRequest) -> HttpServerResponse !{IO} =
  dispatch_from(routes, 0, vec_length(routes), request_method(req), path_before_query(request_path(req)), req)

export fn request_method(req: HttpRequest) -> String =
  match req with
  | HttpRequest method _ _ -> method

export fn request_path(req: HttpRequest) -> String =
  match req with
  | HttpRequest _ path _ -> path

export fn request_version(req: HttpRequest) -> String =
  match req with
  | HttpRequest _ _ meta ->
      match meta with
      | HttpRequestMeta version _ _ -> version

export fn request_body(req: HttpRequest) -> String =
  match req with
  | HttpRequest _ _ meta ->
      match meta with
      | HttpRequestMeta _ _ body -> body

export fn request_header(name: String, req: HttpRequest) -> Maybe String =
  match req with
  | HttpRequest _ _ meta ->
      match meta with
      | HttpRequestMeta _ headers _ -> dict_get(lower_ascii(name), headers)

# --- Request params (low-level, lossless) --------------------------------------
# Params are derived on demand from the already-parsed request (mirroring
# `request_header`), so every accessor is pure and testable without sockets. The
# `_pairs` accessors are the source of truth — an ordered list preserving every
# duplicate key. `_param` returns the FIRST value for a key (the cross-framework
# convention: Go url.Values.Get, Werkzeug MultiDict.get); `_param_all` returns them
# all (Werkzeug getlist). Values are percent/`+`-decoded (see stdlib.url).

# First value for `name` in an ordered pair list, or Nothing.
fn first_value(pairs: Vec (String, String), index: Int, total: Int, name: String) -> Maybe String =
  if index >= total then Nothing
  else
    match vec_get(index, pairs) with
    | Nothing -> Nothing
    | Just pair ->
        match pair with
        | (key, value) -> if key == name then Just(value) else first_value(pairs, index + 1, total, name)

# Every value for `name`, in order.
fn all_values(pairs: Vec (String, String), index: Int, total: Int, name: String, acc: Vec String) -> Vec String =
  if index >= total then acc
  else
    match vec_get(index, pairs) with
    | Nothing -> acc
    | Just pair ->
        match pair with
        | (key, value) ->
            all_values(pairs, index + 1, total, name, if key == name then vec_append(value, acc) else acc)

# The raw query substring after the first `?` in the target, "" if there is none.
export fn query_string(req: HttpRequest) -> String =
  match string.split_once(request_path(req), "?") with
  | Nothing -> ""
  | Just parts -> match parts with | (_, query) -> query

# Every query param as an ordered, decoded (key, value) list — duplicates and
# order preserved (the source of truth; `query_param`/`_all` derive from it).
export fn query_pairs(req: HttpRequest) -> Vec (String, String) =
  parse_query(query_string(req))

# First value for `name` in the query string, or Nothing.
export fn query_param(name: String, req: HttpRequest) -> Maybe String =
  first_value(pairs, 0, vec_length(pairs), name)
where
  pairs = query_pairs(req)

# Every query value for `name`, in order (empty if none).
export fn query_param_all(name: String, req: HttpRequest) -> Vec String =
  all_values(pairs, 0, vec_length(pairs), name, vec_empty())
where
  pairs = query_pairs(req)

# The media type of a Content-Type header, lowercased, without any `;` parameters
# (so "application/x-www-form-urlencoded; charset=utf-8" -> the bare media type).
fn media_type(content_type: String) -> String =
  match string.split_once(content_type, ";") with
  | Nothing -> lower_ascii(string.trim(content_type))
  | Just parts -> match parts with | (media, _) -> lower_ascii(string.trim(media))

fn is_form_urlencoded(req: HttpRequest) -> Bool =
  match request_header("content-type", req) with
  | Nothing -> false
  | Just content_type -> media_type(content_type) == "application/x-www-form-urlencoded"

# Body params as an ordered, decoded (key, value) list — but ONLY when the request
# is application/x-www-form-urlencoded; any other content type yields no params
# rather than misparsing an arbitrary body.
export fn form_pairs(req: HttpRequest) -> Vec (String, String) =
  if is_form_urlencoded(req) then parse_query(request_body(req))
  else vec_empty()

# First value for `name` in the form body, or Nothing.
export fn form_param(name: String, req: HttpRequest) -> Maybe String =
  first_value(pairs, 0, vec_length(pairs), name)
where
  pairs = form_pairs(req)

# Every form value for `name`, in order (empty if none).
export fn form_param_all(name: String, req: HttpRequest) -> Vec String =
  all_values(pairs, 0, vec_length(pairs), name, vec_empty())
where
  pairs = form_pairs(req)

# Render a response to the wire. The header block is assembled from the response's
# header dict (not http_response's fixed base), so the content type is caller-
# controlled and appears once, and every response carries a byte-accurate
# Content-Length. `http_response` remains the shared status-line/body path for other
# callers (http_client, echo helpers).
export fn render(resp: HttpServerResponse) -> ServerResult String =
  match resp with
  | HttpServerResponse status headers body ->
      do
        line <- status_line(status) |> result_map_error(\err ->
          match err with
          | HttpUnsupportedStatus code -> HttpServerUnsupportedStatus(code)
        )
        Ok(assemble_response(line, response_headers(headers, body), body))

# Recoverable write: a send to a peer that has vanished (reset/EPIPE) fails as an Err
# rather than aborting the process. The connection is ALWAYS closed afterwards — on the
# error path too — so a failed write never leaks the fd.
fn write_and_close(conn: Int, payload: String) -> Unit !{IO} =
  match tcp_write_string(conn, payload) with
  | Ok _ -> tcp_close(conn)
  | Err _ -> tcp_close(conn)

fn handle_connection(conn: Int, handler: HttpRequest -> HttpServerResponse !{IO}) -> Unit !{IO} =
  match read_request(conn) with
  | Err _ -> write_and_close(conn, bad_request("bad request") |> render_response_or_fallback)
  | Ok req ->
      do
        resp <- handler(req)
        write_and_close(conn, render_response_or_fallback(resp))

# The 500 fallback (reachable only when a handler returns a status outside the
# supported table) still uses http_response's fixed format — no Content-Length, its own
# Content-Type — rather than the dict-assembled `render`. Acceptable for this rare
# internal-error path; the normal response path goes through `render`.
fn render_response_or_fallback(resp: HttpServerResponse) -> String =
  match render(resp) with
  | Ok raw -> raw
  | Err _ ->
      match http_response(500, "internal server error") with
      | Ok raw -> raw
      | Err _ -> "HTTP/1.1 500 Internal Server Error\r\nConnection: close\r\nContent-Type: text/plain\r\n\r\ninternal server error"

# Each accepted connection is handled in its own fire-and-forget green task, so a
# slow connection (one dribbling its request) cannot block others: `tcp_accept`
# resumes the moment a handler parks on socket I/O. `remaining` counts connections
# ACCEPTED, not fully served — the enclosing scope join is what waits for the last
# spawned handler to finish. Handlers therefore complete in I/O-ready order, not
# accept order.
fn serve_loop(scope: Scope, listener: Int, remaining: Int, handler: HttpRequest -> HttpServerResponse !{IO}) -> Unit !{IO} =
  if remaining == 0 then tcp_close_listener(listener)
  else
    do
      conn <- tcp_accept(listener)
      task_spawn(scope, \_ -> handle_connection(conn, handler))
      serve_loop(scope, listener, remaining - 1, handler)

# `with_scope` does not return until every spawned handler has finished, so no
# connection outlives the call (structured concurrency — no orphaned handlers).
export fn serve_n(port: Int, max_connections: Int, handler: HttpRequest -> HttpServerResponse !{IO}) -> Unit !{IO} =
  with_scope(\s -> serve_loop(s, tcp_listen(port), max_connections, handler))

# Unbounded counterpart of `serve_loop`: the same accept-and-spawn body with no
# terminating branch, so it keeps accepting connections forever. Each handler is
# a fire-and-forget green task reclaimed on completion (see stdlib.task), so the
# server does not accumulate finished handlers even though the enclosing scope
# never joins. The listener is never closed — the loop owns it for the process's
# lifetime.
fn serve_forever_loop(scope: Scope, listener: Int, handler: HttpRequest -> HttpServerResponse !{IO}) -> Unit !{IO} =
  do
    conn <- tcp_accept(listener)
    task_spawn(scope, \_ -> handle_connection(conn, handler))
    serve_forever_loop(scope, listener, handler)

# Serve requests forever. Unlike `serve_n`, this never returns under normal
# operation — the enclosing `with_scope` join is unreachable, which is exactly
# what an always-on server wants. Reach for `serve_n` when a bounded, terminating
# run is needed (e.g. tests/CI).
export fn serve(port: Int, handler: HttpRequest -> HttpServerResponse !{IO}) -> Unit !{IO} =
  with_scope(\s -> serve_forever_loop(s, tcp_listen(port), handler))
