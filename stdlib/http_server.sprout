module stdlib.http_server

import stdlib.http (HttpStatusError, RequestLine, RequestPathVersion, http_response, parse_request_line, status_line)
import stdlib.net (TcpConnection, TcpListener, TcpTimeout, TcpEndOfStream, TcpError, accept, close, close_listener, listen_local, read_avail_timeout, tcp_error_message, write_all_utf8_by)
import stdlib.string as string
import stdlib.bytes as bytes
import stdlib.chan (Chan, Recv, Got, Closed, chan_new, chan_send, chan_recv, chan_close)
import stdlib.task (Scope, with_scope, task_spawn, task_yield)
import stdlib.url (parse_query)

export type HttpRequest =
  | HttpRequest String String HttpRequestMeta

# The body is Bytes, not String. HTTP bodies are byte sequences — a PNG, a protobuf message, a
# multipart part — and a String cannot carry them: str_concat and bytes_from_utf8 were both
# strlen-based, and the body was UTF-8-validated on the way in, so anything containing 0x00 was
# truncated and anything not valid UTF-8 was refused with 400. Text handlers decode explicitly via
# `request_body`, which returns a Result. This follows Go (`Body io.ReadCloser`), ASGI (`body` is a
# byte string) and Jakarta Servlet (`getInputStream` binary / `getReader` character).
#
# NOTE the body is fully BUFFERED, capped by `max_body_bytes`, so this enables binary payloads up to
# that cap — form posts, JSON, protobuf, small images — and NOT large file uploads. Those need
# streaming, which is also the only way to support chunked transfer encoding (no Content-Length to
# buffer against). Filed in BACKLOG; a streaming API would yield `Bytes` chunks, so this type is on
# the path to it rather than in its way.
type HttpRequestMeta =
  | HttpRequestMeta String (Dict String) Bytes

export type HttpServerResponse =
  | HttpServerResponse Int (Dict String) String

export type HttpServerError (..) =
  | HttpInvalidRequest String
  | HttpServerUnsupportedStatus Int
  # The client did not finish sending within its budget. Separate from HttpInvalidRequest because
  # it maps to a different status (408, not 400) and because it is not the client's request being
  # malformed — there simply was not one yet.
  | HttpRequestTimeout
  # The header block exceeded its size cap. Distinct from HttpRequestTimeout because a flooding peer
  # is not slow — it is the opposite — and the two need different statuses (431 vs 408).
  | HttpHeadersTooLarge
  # The request announced a body larger than `max_body_bytes`. Refused on the announcement, before a
  # byte of it is read, so an oversized upload costs one response rather than the whole transfer.
  | HttpBodyTooLarge

type alias ServerResult a = Result HttpServerError a

# Per-connection I/O budgets, in milliseconds. The shape follows nginx's directives rather than a
# single request deadline, INCLUDING which of them are total and which are idle — the three phases
# have genuinely different legitimate profiles, and getting this wrong breaks real clients:
#
#  * `header_ms` is TOTAL for the header phase (nginx `client_header_timeout`: "if a client does not
#    transmit the entire header within this time, the request is terminated"). Total is essential
#    here — a per-read timer is renewed forever by a peer dribbling one byte per interval, which is
#    exactly what a slowloris does, and headers have no legitimate reason to arrive slowly.
#  * `body_ms` and `write_ms` are the GRACE halves of size-scaled TOTAL deadlines: the body gets
#    `body_ms + content_length / min_rate_bps`, the response `write_ms + len / min_rate_bps`. Both
#    were idle bounds, re-armed by any byte that moved — nginx's `client_body_timeout` and
#    `send_timeout` semantics. That bounds a peer which STOPS but not one which merely crawls, and a
#    crawling peer is the worse case: a byte per interval re-arms the bound forever, so a handler's
#    occupancy had no upper limit. A flat total is equally wrong the other way — it rejects any
#    legitimately slow transfer, a 100 MB POST at 3 Mbit/s needing ~280 s.
#
#    Scaling the total by the size satisfies both, and is Apache's `RequestReadTimeout
#    body=20,MinRate=500` ("whenever data is received, the timeout value is increased according to
#    the specified minimum data rate"). Apache accumulates the extension per chunk; here it is closed
#    form, because HTTP states both sizes up front — `Content-Length` for the body, and the response
#    is fully rendered before the first byte goes out.
#
# On read expiry the server answers 408 and closes; an over-large `Content-Length` is refused 413 on
# the announcement, before a byte of the body is read; on write expiry it just closes, there being no
# way left to tell the client anything. Worst-case handler occupancy is therefore
# `header_ms + body_ms + write_ms + (max_body_bytes + response_len) / min_rate_bps` — finite, and
# computable by an operator. That is the property a bounded worker pool needs, since with N workers
# an unbounded occupancy on any one phase lets N peers wedge the whole server
# (docs/green-task-pool-v0.md §5.2).
#
# `max_header_bytes` is the third bound, and it is NOT redundant with the deadline. A deadline only
# bites when the peer goes quiet: a peer that streams bytes continuously without ever sending the
# "\r\n\r\n" terminator keeps every read succeeding, so the header phase would grow the accumulator
# for the whole budget — gigabytes on a fast link, with quadratic copying — without a single timeout.
# Bounding size is what makes the phase bounded against a FLOODING peer rather than only an idle one.
# Analogue: Go's Server.MaxHeaderBytes (DefaultMaxHeaderBytes = 1 << 20, "the maximum permitted size
# of the headers in an HTTP request"); the 431 status is RFC 6585's.
#
# All four size quantities above — `max_header_bytes`, `max_body_bytes`, `Content-Length` and the
# `min_rate_bps` allowances — are BYTES. That has to be said explicitly because `stdlib.string` offers
# two index spaces over the same value (`length` counts codepoints, `byte_length` counts bytes, and
# both are `Int`, so the typechecker cannot tell them apart), and the body path was originally written
# in the wrong one. The body is framed byte-exactly against `Content-Length` and delivered as `Bytes`,
# with no UTF-8 validation on the read path — so a binary payload reaches the handler instead of being
# refused on its behalf. Text handlers call `request_body`, which returns `Result Utf8Error String`;
# a `Content-Length` that cuts a character in half therefore parses (the bytes are what was announced)
# and fails at decode, which is the honest place for it.
# A record, not a four-field constructor: every field is `Int`, so under positional construction a
# caller could transpose any two of them and neither the typechecker nor an assertion on a total
# would notice. Naming the fields at the call site is the only place that distinction is visible —
# `ServerConfig(2000, 300, 65536, 2000)` and `ServerConfig(2000, 2000, 2048, 2000)` say nothing
# about which bound each test is exercising, while the named form says it outright.
#
# `header_ms` bounds reading the request line + headers (total); `body_ms` is the grace half of the
# body's size-scaled total; `max_header_bytes` caps the accumulated header block; `write_ms` is the
# grace half of the response's size-scaled total.
#
# `max_body_bytes` and `min_rate_bps` are what make worker occupancy FINITE rather than merely
# "bounded when the peer stops". A size cap alone does not do it — 1 MiB delivered a byte at a time
# under an idle deadline stays inside the cap and holds a handler forever — and a rate floor alone
# does not either, since without a cap the bound has nothing to multiply. Together they give
# `body_ms + max_body_bytes / min_rate_bps`, a number the operator can compute.
export type ServerConfig = (header_ms: Int, body_ms: Int, max_header_bytes: Int, write_ms: Int,
                            max_body_bytes: Int, min_rate_bps: Int)

# header 10 s total / body 30 s grace / 64 KiB of headers / response writes 30 s grace. Chosen well
# above any legitimate client (headers normally arrive in the first segment) and well below the
# ~forever that the unbounded reads and writes allowed. nginx defaults its three timeouts to 60 s;
# Go's http.Server defaults to none at all, which is the hazard this replaces.
#
# `max_body_bytes` is 1 MiB, nginx's `client_max_body_size` default. `min_rate_bps` is 1024 B/s —
# Apache's `MinRate` default is 500, but 500 against a 1 MiB cap yields a ~35-minute worst case,
# which is finite but useless as a bound; 1024 halves it, and any deployment running a bounded
# worker pool should raise it further. The two defaults are chosen together, because it is their
# quotient, not either one, that an operator has to live with.
export fn default_config() -> ServerConfig =
  ServerConfig(header_ms = 10000, body_ms = 30000, max_header_bytes = 65536, write_ms = 30000,
               max_body_bytes = 1048576, min_rate_bps = 1024)

# Milliseconds it takes to move `bytes` at `rate_bps` bytes/second — the size-scaled half of every
# deadline here. A non-positive rate disables the scaling rather than dividing by zero, leaving the
# flat budget in force, so a misconfigured rate cannot abort the server.
fn rate_ms(bytes: Int, rate_bps: Int) -> Int =
  if rate_bps <= 0 then 0 else bytes * 1000 / rate_bps

# An absolute monotonic-microsecond instant `ms` from now. Monotonic (time_now_micros), so an NTP
# step mid-request cannot make a deadline fire early or never.
fn deadline_in(ms: Int) -> Int !{IO} =
  do
    now <- time_now_micros()
    now + ms * 1000

# Milliseconds left until `deadline`, floored at 0. A budget of 0 makes read_avail_timeout poll once
# and report a timeout, so an already-expired deadline needs no special case at the call site.
fn remaining_ms(deadline: Int) -> Int !{IO} =
  do
    now <- time_now_micros()
    if now >= deadline then 0 else (deadline - now) / 1000

fn find_headers_end(raw: String) -> Maybe Int =
  string.find(raw, "\r\n\r\n")

fn find_line_end(raw: String) -> Maybe Int =
  string.find(raw, "\r\n")

fn char_at(raw: String, index: Int) -> Char =
  string.char_at_or(raw, index, '?')

fn lower_char(ch: Char) -> Char =
  match string.find("ABCDEFGHIJKLMNOPQRSTUVWXYZ", string.string_from_char(ch)) with
  | Nothing -> ch
  | Just pos -> string.char_at_or("abcdefghijklmnopqrstuvwxyz", pos, '?')

fn lower_ascii_from(raw: String, index: Int, total: Int, acc: String) -> String =
  if index >= total then acc
  else lower_ascii_from(raw, index + 1, total, string.concat(acc, string.string_from_char(lower_char(char_at(raw, index)))))

fn lower_ascii(raw: String) -> String =
  lower_ascii_from(raw, 0, string.length(raw), "")

fn split_lines_from(raw: String, index: Int, total: Int, acc: Vec String, current: String) -> Vec String =
  if index >= total then vec_append(current, acc)
  else if char_at(raw, index) == '\r' then split_lines_from(raw, index + 1, total, acc, current)
  else if char_at(raw, index) == '\n' then split_lines_from(raw, index + 1, total, vec_append(current, acc), "")
  else split_lines_from(raw, index + 1, total, acc, string.concat(current, string.string_from_char(char_at(raw, index))))

fn split_lines(raw: String) -> Vec String =
  split_lines_from(raw, 0, string.length(raw), vec_empty(), "")

fn parse_header_pair(pair: (String, String)) -> Maybe (String, String) =
  match pair with
  | (name, value) ->
      if string.is_empty(name) then Nothing
      else Just((lower_ascii(string.trim(name)), string.trim(value)))

fn parse_header_line(raw: String) -> Maybe (String, String) =
  and_then(parse_header_pair, string.split_once(raw, ":"))

fn result_from_maybe(err: e, value: Maybe a) -> Result e a =
  match value with
  | Nothing -> Err(err)
  | Just unwrapped -> Ok(unwrapped)

fn parse_header_lines(lines: Vec String, index: Int, total: Int, headers: Dict String) -> ServerResult (Dict String) =
  if index >= total then Ok(headers)
  else
    match vec_get(index, lines) with
    | Nothing -> Ok(headers)
    | Just line ->
        if string.is_empty(line) then parse_header_lines(lines, index + 1, total, headers)
        else
          do
            pair <- result_from_maybe(HttpInvalidRequest("invalid header line"), parse_header_line(line))
            match pair with
            | (name, value) -> parse_header_lines(lines, index + 1, total, dict_set(name, value, headers))

fn parse_headers(raw: String) -> ServerResult (Dict String) =
  parse_header_lines(lines, 0, vec_length(lines), dict_empty())
where
  lines = split_lines(raw)

# W8/P1: parse_int is now total (Maybe Int), so the all_digits predicate is
# redundant. Still reject negatives (the old digits check excluded '-').
fn parse_content_length(headers: Dict String) -> ServerResult Int =
  match dict_get("content-length", headers) with
  | Nothing -> Ok(0)
  | Just raw ->
      if string.is_empty(raw) then Err(HttpInvalidRequest("empty Content-Length"))
      else content_length_result(parse_int(raw))

fn content_length_result(m: Maybe Int) -> ServerResult Int =
  match m with
  | Just n -> if n >= 0 then Ok(n) else Err(HttpInvalidRequest("invalid Content-Length"))
  | Nothing -> Err(HttpInvalidRequest("invalid Content-Length"))

fn request_body_start(raw: String) -> Maybe Int =
  map(\pos -> pos + 4, find_headers_end(raw))

# The header block spans from just past the request line to the blank-line
# terminator. A header-less request (HTTP/1.0-style) has the terminator right after
# the request line, so `headers_end <= header_start` — return "" rather than slicing
# a negative length (which aborts in str_slice).
fn header_block(raw: String, line_end: Int, headers_end: Int) -> String =
  if headers_end <= header_start then ""
  else string.slice(raw, header_start, headers_end - header_start)
where
  header_start = line_end + 2

fn parse_request_prefix(raw: String) -> ServerResult (RequestLine, Dict String, Int) =
  match find_headers_end(raw) with
  | Nothing -> Err(HttpInvalidRequest("missing header terminator"))
  | Just headers_end ->
      match find_line_end(raw) with
      | Nothing -> Err(HttpInvalidRequest("missing request line terminator"))
      | Just line_end ->
          do
            req <- result_from_maybe(HttpInvalidRequest("invalid request line"), parse_request_line(string.take(raw, line_end)))
            headers <- parse_headers(header_block(raw, line_end, headers_end))
            content_length <- parse_content_length(headers)
            Ok((req, headers, content_length))

fn build_request(req: RequestLine, headers: Dict String, body: Bytes) -> HttpRequest =
  match req with
  | RequestLine method pv ->
      match pv with
      | RequestPathVersion path version -> HttpRequest(method, path, HttpRequestMeta(version, headers, body))

export fn parse(raw: String) -> ServerResult HttpRequest =
  do
    prefix <- parse_request_prefix(raw)
    parse_from_prefix(raw, prefix)

fn parse_from_prefix(raw: String, prefix: (RequestLine, Dict String, Int)) -> ServerResult HttpRequest =
  err_or_request(req, headers, content_length, raw)
where
  (req, headers, content_length) = prefix

# `Content-Length` counts BYTES, so every measurement and every cut in the body region has to be
# byte-denominated. `string.length`/`take`/`drop` are all CODEPOINT-denominated (str_slice seeks
# UTF-8 boundaries), and framing the body with them mis-framed any body containing a multi-byte
# character in both directions: `café` (5 bytes, 4 codepoints) under `Content-Length: 5` was
# declared short, and taking 5 codepoints of `café!` swallowed a trailing byte that on a pipelined
# connection belongs to the NEXT request. ASCII hid it — there the two index spaces coincide, and
# every test predating this used an ASCII body (concurrency review C5).
#
# `body_start` is a codepoint offset (find_headers_end -> str_find), so it cannot index `raw_bytes`
# directly; byte_length of the prefix converts it. Deriving the offset rather than assuming
# header_bytes == body_start is what keeps a non-ASCII HEADER value from shifting the body.
fn err_or_request(req: RequestLine, headers: Dict String, content_length: Int, raw: String) -> ServerResult HttpRequest =
  match request_body_start(raw) with
  | Nothing -> Err(HttpInvalidRequest("missing header terminator"))
  | Just body_start -> framed_body(req, headers, content_length, raw, body_start)

# No UTF-8 validation here any more, and that is the substantive change: the body is Bytes, so a
# payload that is not text is DELIVERED rather than refused. The validation moved to `request_body`,
# which returns a Result — so a text handler still cannot mistake bytes for a decoded String, but a
# binary handler is no longer blocked by a decision made on its behalf during the read.
#
# A Content-Length that cuts a multi-byte character in half therefore parses successfully now (the
# bytes are exactly what the client announced) and surfaces as `Err Utf8Error` from `request_body`,
# which is the honest place for it: the framing was valid, the decoding is not.
fn framed_body(req: RequestLine, headers: Dict String, content_length: Int, raw: String, body_start: Int) -> ServerResult HttpRequest =
  if bytes.length(raw_bytes) - header_bytes < content_length then
    Err(HttpInvalidRequest("request body shorter than Content-Length"))
  else
    Ok(build_request(req, headers, bytes.slice(raw_bytes, header_bytes, content_length)))
where
  raw_bytes = bytes.from_string(raw)
  header_bytes = string.byte_length(string.take(raw, body_start))

# Reads use net.read_avail_timeout (recoverable AND bounded): a socket failure becomes an Err in the
# ServerResult, not an exit(1), so one client's connection reset drops just that connection.
#
# It hands back BYTES. That is the change that made this whole region simpler rather than harder: a
# socket carries bytes, a Sprout String may not hold an arbitrary byte (docs/spec-v0.md:64), and the
# three deleted read builtins papered over the gap by minting Strings that violated the invariant.
# Reading bytes means nothing in the read path needs to pretend, and every byte/codepoint conversion
# that used to be needed here is gone — `str_concat` is strlen-based and `string.length` is
# codepoint-denominated, and neither is now involved in framing a request.
#
# Each round re-derives its budget from the clock, so `deadline` bounds the WHOLE phase however many
# reads it takes. That is what makes it a defence: a client sending one byte per interval renews a
# per-read timer forever, but cannot renew this one.
#
# TcpTimeout is kept distinct from a socket error all the way up, because the two produce different
# statuses (408 vs 400) and only one of them means the client did something wrong. TcpEndOfStream is
# now its own variant too, rather than the empty-read sentinel it used to be — the read returning
# "zero bytes" and the peer having closed were previously the same observation, and telling them
# apart mattered most for a body whose first byte is 0x00.
#
# Three independent bounds, and each closes a hole the others do not:
#
#  * the SIZE cap stops a peer that floods bytes without ever sending the terminator. Such a peer
#    keeps every read succeeding, so it never trips a timeout of any kind;
#  * the budget is checked HERE, before reading, not merely inferred from `Err TcpTimeout`. The read
#    only consults its deadline when the socket would block, so a continuously-readable peer never
#    reaches that check — the phase bound has to be enforced by the loop that owns it. Moving the
#    retry loop into Sprout did not change this: `read_avail_go` returns as soon as a recv delivers
#    data, without looking at the clock;
#  * `Err TcpTimeout` covers the ordinary idle peer.
#
# The size check runs on the ACCUMULATED block before the next read, so the cap can be overshot by
# at most one chunk (64 KiB).
#
# ONE accumulator now (a Builder), where there used to be two. The second existed only because the
# terminator search needed a String, and it is gone: `bytes.find` searches the bytes directly. The
# accumulator is a Builder rather than repeated `bytes.append` because append copies the whole buffer
# per chunk (quadratic in bytes, ~8 MiB for a 1 MiB body in 64 KiB chunks), while a Builder
# concatenates chunk TABLES and flattens once — quadratic only in chunk COUNT.
#
# `overlap` is what keeps the SEARCH linear, and it is the part worth reading twice. Re-scanning the
# accumulated block every round would be quadratic in bytes — and reachable on purpose, because the
# size cap bounds total bytes, not rounds: a peer sending one byte per round under a 64 KiB cap
# forces 65536 scans of up to 64 KiB each. So each round searches only `overlap ++ chunk`, where
# `overlap` is the last 3 bytes already seen. Three is exactly right and not a guess: the terminator
# is 4 bytes, so an occurrence straddling the boundary has between 1 and 3 bytes on the old side.
# A match therefore always extends into the new chunk, which is also why it can never be found twice.
#
# Returns the block read so far together with the BYTE offset just past the terminator. That offset is
# where the body starts, and it is a byte count by construction — the old code derived it from a
# codepoint index via `string.byte_length(string.take(text, body_start))`, which was correct but only
# because that conversion was got right.
fn crlf_crlf() -> Bytes =
  bytes.from_string("\r\n\r\n")

fn read_until_headers(conn: borrowing TcpConnection, acc: Builder, total: Int, overlap: Bytes,
                      deadline: Int, max_bytes: Int) -> ServerResult (Bytes, Int) !{IO} =
  if total > max_bytes then Err(HttpHeadersTooLarge)
  else
    do
      budget <- remaining_ms(deadline)
      if budget <= 0 then
        Err(HttpRequestTimeout)
      else
        match read_avail_timeout(conn, budget) with
        | Err TcpTimeout -> Err(HttpRequestTimeout)
        | Err TcpEndOfStream -> Err(HttpInvalidRequest("unexpected end of stream"))
        | Err _ -> Err(HttpInvalidRequest("connection error"))
        | Ok chunk -> scan_for_terminator(conn, acc, total, overlap, chunk, deadline, max_bytes)

# Split out because the `where` bindings below are shared by both arms of the search, and because a
# `match` inside the `do` above cannot carry them.
fn scan_for_terminator(conn: borrowing TcpConnection, acc: Builder, total: Int, overlap: Bytes,
                       chunk: Bytes, deadline: Int, max_bytes: Int) -> ServerResult (Bytes, Int) !{IO} =
  match bytes.find(probe, crlf_crlf()) with
  # `probe` index 0 sits at absolute byte `total - |overlap|`, so the terminator ends 4 bytes past the
  # match in that frame of reference.
  | Just at -> Ok((bytes.builder_build(grown), total - bytes.length(overlap) + at + 4))
  | Nothing ->
      read_until_headers(conn, grown, total + bytes.length(chunk), next_overlap, deadline, max_bytes)
where
  probe = bytes.append(overlap, chunk)
  grown = bytes.builder_append(acc, bytes.builder_bytes(chunk))
  keep = if bytes.length(probe) < 3 then bytes.length(probe) else 3
  next_overlap = bytes.slice(probe, bytes.length(probe) - keep, keep)

# Every read path BORROWS the connection: a request is read over many syscalls,
# and under strict consume-exactly-once the first read would take the socket and
# every later one would be a reuse. `handle_connection` holds the single consume.
fn read_request(conn: borrowing TcpConnection, config: ServerConfig) -> ServerResult HttpRequest !{IO} =
  do
    header_deadline <- deadline_in(config.header_ms)
    block <- read_until_headers(conn, bytes.builder_empty(), 0, bytes.empty(),
                                header_deadline, config.max_header_bytes)
    read_request_from_block(conn, block, config)

fn read_request_from_block(conn: borrowing TcpConnection, block: (Bytes, Int), config: ServerConfig) -> ServerResult HttpRequest !{IO} =
  do
    header_text <- decode_header_block(bytes.slice(raw, 0, body_start))
    prefix <- parse_request_prefix(header_text)
    continue_read_request(conn, raw, body_start, prefix, config)
where
  (raw, body_start) = block

# The header block is the first thing that has to BE text, and this is where that is decided instead
# of assumed. A request line and header names/values are parsed with codepoint-indexed String
# operations, so the block must be valid UTF-8 and NUL-free before any of them run — which is exactly
# what `bytes.to_string` checks (decision D4's choke point; it rejects a NUL as well as a bad
# sequence). A peer sending a NUL or a broken UTF-8 sequence in its headers now gets a clean 400.
#
# Note what is NOT validated: the body. It stays Bytes and is decoded only if a handler asks for text
# via `request_body`, which returns a Result. Headers must be text to be parsed at all; a body need
# not be text at all.
fn decode_header_block(block: Bytes) -> ServerResult String =
  match bytes.to_string(block) with
  | Ok text -> Ok(text)
  | Err _ -> Err(HttpInvalidRequest("request headers are not valid UTF-8"))

# The body deadline is TOTAL and never re-armed here — `deadline` is computed once by the caller as
# `body_ms + content_length / min_rate_bps`, so it already contains enough time to receive the whole
# promised body at the configured minimum rate.
#
# It was idle before, re-armed by every chunk that delivered bytes (nginx's `client_body_timeout`
# semantics). That bounded a peer which STOPPED, but not one which merely crawls: a byte per interval
# re-arms the bound forever, so a handler's occupancy had no upper limit at all. A plain total
# deadline is the other obvious answer and is equally wrong in the opposite direction — it rejects any
# legitimately slow upload, a 100 MB POST at 3 Mbit/s needing ~280 s.
#
# Scaling the total by the promised size is what satisfies both. It is Apache's `RequestReadTimeout
# body=20,MinRate=500` ("whenever data is received, the timeout value is increased according to the
# specified minimum data rate"), expressed in closed form rather than incrementally: HTTP states the
# body length up front, so the whole extension can be computed before the first read instead of
# accumulated per chunk. Worst-case occupancy becomes `body_ms + max_body_bytes / min_rate_bps` — a
# number an operator can compute, which is the property a bounded worker pool needs and the reason
# this had to land before pooling (docs/green-task-pool-v0.md §5.2).
#
# A flooding peer is bounded by `content_length` — the caller asks only for the bytes the request
# promised — and an over-large `content_length` is refused with 413 before this loop is entered.
#
# Every count here is a byte count, with nothing to convert: `remaining` comes from Content-Length,
# which is denominated in bytes, and `bytes.length` measures the same thing. The previous version had
# to reach for `string.byte_length` on each chunk and carried a comment explaining why neither
# `string.length` nor `is_empty` could be used — both are strlen-based, so a chunk containing 0x00 was
# under-counted and one starting with 0x00 looked like a closed connection. Reading bytes retires the
# whole hazard rather than documenting it.
fn read_remaining_body(conn: borrowing TcpConnection, acc: Builder, remaining: Int, deadline: Int) -> ServerResult Bytes !{IO} =
  if remaining <= 0 then Ok(bytes.builder_build(acc))
  else
    do
      budget <- remaining_ms(deadline)
      if budget <= 0 then
        Err(HttpRequestTimeout)  # enforced here, not only inferred from Err TcpTimeout (see above)
      else
        match read_avail_timeout(conn, budget) with
        | Err TcpTimeout -> Err(HttpRequestTimeout)
        | Err TcpEndOfStream -> Err(HttpInvalidRequest("unexpected end of stream"))
        | Err _ -> Err(HttpInvalidRequest("connection error"))
        | Ok chunk ->
            read_remaining_body(conn, bytes.builder_append(acc, bytes.builder_bytes(chunk)),
                                remaining - bytes.length(chunk), deadline)

# The body gets its OWN budget, starting when the headers are complete — a slow upload must not be
# charged for however long the headers took, and a client that stalls after its headers must still
# be cut off.
fn continue_read_request(conn: borrowing TcpConnection, raw: Bytes, body_start: Int,
                         prefix: (RequestLine, Dict String, Int), config: ServerConfig) -> ServerResult HttpRequest !{IO} =
  if content_length > config.max_body_bytes then Err(HttpBodyTooLarge)
  else if bytes.length(body) >= content_length then
    Ok(build_request(req, headers, bytes.slice(body, 0, content_length)))
  else
    do
      # Total, scaled by the promised size: enough time to receive `content_length` bytes at
      # `min_rate_bps`, plus `body_ms` of grace. Never re-armed, so occupancy is bounded.
      body_deadline <- deadline_in(config.body_ms + rate_ms(content_length, config.min_rate_bps))
      full <- read_remaining_body(conn, bytes.builder_bytes(body), content_length - bytes.length(body), body_deadline)
      # Trim to exactly the promised length: the final chunk can overshoot, and on a pipelined
      # connection those extra bytes are the next request rather than this body.
      Ok(build_request(req, headers, bytes.slice(full, 0, content_length)))
where
  (req, headers, content_length) = prefix
  # `body_start` is already a byte offset — see read_until_headers. No conversion, and so no place
  # for a codepoint index to be mistaken for a byte one.
  body = bytes.slice(raw, body_start, bytes.length(raw) - body_start)

fn headers_to_lines(keys: Vec String, headers: Dict String, index: Int, total: Int, acc: String) -> String =
  if index >= total then acc
  else
    match vec_get(index, keys) with
    | Nothing -> acc
    | Just key ->
        match dict_get(key, headers) with
        | Nothing -> headers_to_lines(keys, headers, index + 1, total, acc)
        | Just value ->
            headers_to_lines(
              keys,
              headers,
              index + 1,
              total,
              string.concat(acc, string.concat(key, string.concat(": ", string.concat(value, "\r\n"))))
            )

fn render_extra_headers(headers: Dict String) -> String =
  headers_to_lines(keys, headers, 0, vec_length(keys), "")
where
  keys = dict_keys(headers)

# Set `name` to `value` only if the caller has not already provided it. Lets `render`
# supply defaults (content-type, connection) that a handler's `with_header` overrides.
fn with_default_header(name: String, value: String, headers: Dict String) -> Dict String =
  match dict_get(name, headers) with
  | Just _ -> headers
  | Nothing -> dict_set(name, value, headers)

# The final header set written to the wire: caller headers, plus defaulted
# content-type/connection, plus an *always* byte-accurate content-length (framing is
# the server's responsibility, so it overrides any caller-supplied value). Keys are
# lowercase throughout, so each header appears exactly once — no duplicates.
fn response_headers(headers: Dict String, body: String) -> Dict String =
  dict_set(
    "content-length",
    int_to_string(string.byte_length(body)),
    with_default_header("connection", "close", with_default_header("content-type", "text/plain", headers))
  )

fn assemble_response(line: String, headers: Dict String, body: String) -> String =
  string.concat(line, string.concat("\r\n", string.concat(render_extra_headers(headers), string.concat("\r\n", body))))

export fn response(status: Int, body: String) -> HttpServerResponse =
  HttpServerResponse(status, dict_empty(), body)

# The numeric status of a response — the accessor a logging/metrics middleware
# needs, since the HttpServerResponse constructor is not exported for matching.
export fn response_status(resp: HttpServerResponse) -> Int =
  match resp with
  | HttpServerResponse status _ _ -> status

export fn ok(body: String) -> HttpServerResponse =
  response(200, body)

export fn bad_request(body: String) -> HttpServerResponse =
  response(400, body)

export fn not_found(body: String) -> HttpServerResponse =
  response(404, body)

# 408, the answer to a client that connected but did not finish its request in time.
export fn request_timeout(body: String) -> HttpServerResponse =
  response(408, body)

# 431 (RFC 6585), the answer to a header block that exceeded `max_header_bytes`.
export fn headers_too_large(body: String) -> HttpServerResponse =
  response(431, body)

# 413, the answer to a `Content-Length` above `max_body_bytes`. RFC 9110 §15.5.14 renamed the reason
# phrase to "Content Too Large"; nginx still reports the RFC 7231 name for the same code.
export fn body_too_large(body: String) -> HttpServerResponse =
  response(413, body)

# A 303 See Other redirect to `location`, with an empty body. This is the Post/
# Redirect/Get pattern: a form handler mutates state on POST, then returns this so the
# browser re-GETs `location` — a refresh reloads the result page instead of re-POSTing
# the form. `render` needs `303` in the shared status table (stdlib.http).
export fn see_other(location: String) -> HttpServerResponse =
  with_header("location", location, response(303, ""))

export fn with_header(name: String, value: String, resp: HttpServerResponse) -> HttpServerResponse =
  match resp with
  | HttpServerResponse status headers body -> HttpServerResponse(status, dict_set(header_name, value, headers), body)
where
  header_name = lower_ascii(name)

# --- Routing ---------------------------------------------------------------
# A route pairs an HTTP method and an exact path with a handler. `dispatch` scans
# the table in order and runs the first match, falling through to 404. Matching is
# O(routes) per request; a linear scan is the right shape for the handful of routes a
# small server declares — no Dict indirection.
#
# Handlers carry the `!{IO}` effect, so a handler may read/write shared state (e.g. a
# `Ref`-backed store) or touch the network/disk while building its response — the
# effect propagates through `dispatch`/`serve`. A pure handler still fits: `!{IO}` is
# additive, so `\req -> ok("hi")` subsumes into the effectful slot unchanged.
export type Route (..) =
  | Route String String (HttpRequest -> HttpServerResponse !{IO})

# `request_path` returns the raw target including any `?query`, so match on the path
# up to the first `?` — otherwise `/search?q=foo` would never match a `/search` route.
fn path_before_query(path: String) -> String =
  match string.split_once(path, "?") with
  | Nothing -> path
  | Just parts -> match parts with | (base, _) -> base

fn route_matches(route: Route, method: String, path: String) -> Bool =
  match route with
  | Route route_method route_path _ -> route_method == method && route_path == path

fn run_route(route: Route, req: HttpRequest) -> HttpServerResponse !{IO} =
  match route with
  | Route _ _ handler -> handler(req)

fn dispatch_from(routes: Vec Route, index: Int, total: Int, method: String, path: String, req: HttpRequest) -> HttpServerResponse !{IO} =
  if index >= total then not_found("not found")
  else
    match vec_get(index, routes) with
    | Nothing -> not_found("not found")
    | Just route ->
        if route_matches(route, method, path) then run_route(route, req)
        else dispatch_from(routes, index + 1, total, method, path, req)

# Dispatch a parsed request to its route's handler, or a 404 response when none
# matches. Runs the matched handler, so it carries the handler's `!{IO}` effect — but
# it does no socket I/O of its own, so it still composes with `serve` as
# `serve(port, \req -> dispatch(routes, req))` and is testable without sockets (drive
# it from an already-parsed request and inspect the response).
export fn dispatch(routes: Vec Route, req: HttpRequest) -> HttpServerResponse !{IO} =
  dispatch_from(routes, 0, vec_length(routes), request_method(req), path_before_query(request_path(req)), req)

export fn request_method(req: HttpRequest) -> String =
  match req with
  | HttpRequest method _ _ -> method

export fn request_path(req: HttpRequest) -> String =
  match req with
  | HttpRequest _ path _ -> path

export fn request_version(req: HttpRequest) -> String =
  match req with
  | HttpRequest _ _ meta ->
      match meta with
      | HttpRequestMeta version _ _ -> version

# The body exactly as it arrived, byte for byte. Total: there is nothing to fail on.
export fn request_body_bytes(req: HttpRequest) -> Bytes =
  match req with
  | HttpRequest _ _ meta ->
      match meta with
      | HttpRequestMeta _ _ body -> body

# The body decoded as UTF-8. Returns a Result because a request body is a byte sequence and nothing
# guarantees it is text — a PNG upload, a protobuf message, or a Content-Length that cuts a character
# in half all reach here legitimately.
#
# This rejects rather than substituting U+FFFD, unlike `term_read_key`: there the value is a keypress
# with no error channel and no possible recovery, while here the caller has both, and silently
# mangling a body a handler may persist or forward is worse than making it decide. Consistent with
# `bytes.to_string` and `read_file`, which also reject.
export fn request_body(req: HttpRequest) -> Result bytes.Utf8Error String =
  bytes.to_string(request_body_bytes(req))

export fn request_header(name: String, req: HttpRequest) -> Maybe String =
  match req with
  | HttpRequest _ _ meta ->
      match meta with
      | HttpRequestMeta _ headers _ -> dict_get(lower_ascii(name), headers)

# --- Request params (low-level, lossless) --------------------------------------
# Params are derived on demand from the already-parsed request (mirroring
# `request_header`), so every accessor is pure and testable without sockets. The
# `_pairs` accessors are the source of truth — an ordered list preserving every
# duplicate key. `_param` returns the FIRST value for a key (the cross-framework
# convention: Go url.Values.Get, Werkzeug MultiDict.get); `_param_all` returns them
# all (Werkzeug getlist). Values are percent/`+`-decoded (see stdlib.url).

# First value for `name` in an ordered pair list, or Nothing.
fn first_value(pairs: Vec (String, String), index: Int, total: Int, name: String) -> Maybe String =
  if index >= total then Nothing
  else
    match vec_get(index, pairs) with
    | Nothing -> Nothing
    | Just pair ->
        match pair with
        | (key, value) -> if key == name then Just(value) else first_value(pairs, index + 1, total, name)

# Every value for `name`, in order.
fn all_values(pairs: Vec (String, String), index: Int, total: Int, name: String, acc: Vec String) -> Vec String =
  if index >= total then acc
  else
    match vec_get(index, pairs) with
    | Nothing -> acc
    | Just pair ->
        match pair with
        | (key, value) ->
            all_values(pairs, index + 1, total, name, if key == name then vec_append(value, acc) else acc)

# The raw query substring after the first `?` in the target, "" if there is none.
export fn query_string(req: HttpRequest) -> String =
  match string.split_once(request_path(req), "?") with
  | Nothing -> ""
  | Just parts -> match parts with | (_, query) -> query

# Every query param as an ordered, decoded (key, value) list — duplicates and
# order preserved (the source of truth; `query_param`/`_all` derive from it).
export fn query_pairs(req: HttpRequest) -> Vec (String, String) =
  parse_query(query_string(req))

# First value for `name` in the query string, or Nothing.
export fn query_param(name: String, req: HttpRequest) -> Maybe String =
  first_value(pairs, 0, vec_length(pairs), name)
where
  pairs = query_pairs(req)

# Every query value for `name`, in order (empty if none).
export fn query_param_all(name: String, req: HttpRequest) -> Vec String =
  all_values(pairs, 0, vec_length(pairs), name, vec_empty())
where
  pairs = query_pairs(req)

# The media type of a Content-Type header, lowercased, without any `;` parameters
# (so "application/x-www-form-urlencoded; charset=utf-8" -> the bare media type).
fn media_type(content_type: String) -> String =
  match string.split_once(content_type, ";") with
  | Nothing -> lower_ascii(string.trim(content_type))
  | Just parts -> match parts with | (media, _) -> lower_ascii(string.trim(media))

fn is_form_urlencoded(req: HttpRequest) -> Bool =
  match request_header("content-type", req) with
  | Nothing -> false
  | Just content_type -> media_type(content_type) == "application/x-www-form-urlencoded"

# Body params as an ordered, decoded (key, value) list — but ONLY when the request
# is application/x-www-form-urlencoded; any other content type yields no params
# rather than misparsing an arbitrary body.
# A body that is not valid UTF-8 yields no pairs rather than an error: `application/x-www-form-
# urlencoded` is percent-encoded ASCII by definition, so a body that fails to decode is not a form,
# and this accessor's contract is already "no pairs if this is not a form".
export fn form_pairs(req: HttpRequest) -> Vec (String, String) =
  if is_form_urlencoded(req) then
    match request_body(req) with
    | Ok text -> parse_query(text)
    | Err _ -> vec_empty()
  else vec_empty()

# First value for `name` in the form body, or Nothing.
export fn form_param(name: String, req: HttpRequest) -> Maybe String =
  first_value(pairs, 0, vec_length(pairs), name)
where
  pairs = form_pairs(req)

# Every form value for `name`, in order (empty if none).
export fn form_param_all(name: String, req: HttpRequest) -> Vec String =
  all_values(pairs, 0, vec_length(pairs), name, vec_empty())
where
  pairs = form_pairs(req)

# Render a response to the wire. The header block is assembled from the response's
# header dict (not http_response's fixed base), so the content type is caller-
# controlled and appears once, and every response carries a byte-accurate
# Content-Length. `http_response` remains the shared status-line/body path for other
# callers (http_client, echo helpers).
export fn render(resp: HttpServerResponse) -> ServerResult String =
  match resp with
  | HttpServerResponse status headers body ->
      do
        line <- status_line(status) |> result_map_error(\err ->
          match err with
          | HttpUnsupportedStatus code -> HttpServerUnsupportedStatus(code)
        )
        Ok(assemble_response(line, response_headers(headers, body), body))

# Recoverable, TOTALLY bounded write: a send to a peer that has vanished (reset/EPIPE) fails as an
# Err rather than aborting the process, and a peer that stops reading — or reads too slowly to count
# — is cut off at a deadline fixed before the first byte goes out. The connection is ALWAYS closed
# afterwards, on both error paths too, so neither a failed nor a timed-out write leaks the fd.
#
# The deadline mirrors the body's: `write_ms` of grace plus the time this response needs at
# `min_rate_bps`. It has to be total for the same reason. `write_all_utf8_timeout`'s bound is idle
# and re-armed inside C on every accepted byte, so a peer taking one byte per interval held the write
# forever — and unlike the read side, no deadline computed here could intervene, because the caller
# never regained control mid-payload. `write_all_utf8_by` loops in Sprout over a non-parking send, so
# the deadline is re-checked on every iteration.
#
# That "always closed" is not a promise in a comment: `conn` is consumed here, and omitting `close`
# on any arm is a compile error (M4.3 branch convergence). The write borrows first, so the
# borrow-then-consume order is what makes the shape expressible at all.
#
# The bound matters most on the paths easiest to overlook: every 408/413/431/500 error response is
# written through here too, so an unbounded write would have made the timeout replies themselves a
# way to wedge a handler.
fn write_and_close(conn: consuming TcpConnection, payload: String, config: ServerConfig) -> Unit !{IO} =
  do
    # byte_length: the rate allowance must be denominated in what actually goes over the socket, or a
    # multi-byte response gets a deadline scaled to a byte count smaller than the write it has to
    # cover — a tighter bound than configured, in the one case where it needed to be looser.
    deadline <- deadline_in(config.write_ms + rate_ms(string.byte_length(payload), config.min_rate_bps))
    match write_all_utf8_by(conn, payload, deadline) with
    | Ok _ -> close(conn)
    | Err _ -> close(conn)

# A read that ran out of budget answers 408 rather than 400: the request was not malformed, it was
# not finished. Either way the connection is consumed exactly once, so no path leaks it.
fn read_error_response(err: HttpServerError) -> HttpServerResponse =
  match err with
  | HttpRequestTimeout -> request_timeout("request timeout")
  | HttpHeadersTooLarge -> headers_too_large("request header fields too large")
  | HttpBodyTooLarge -> body_too_large("request body too large")
  | HttpInvalidRequest _ -> bad_request("bad request")
  | HttpServerUnsupportedStatus _ -> bad_request("bad request")

fn handle_connection(config: ServerConfig, conn: consuming TcpConnection, handler: HttpRequest -> HttpServerResponse !{IO}) -> Unit !{IO} =
  match read_request(conn, config) with
  | Err err -> write_and_close(conn, read_error_response(err) |> render_response_or_fallback, config)
  | Ok req ->
      do
        resp <- handler(req)
        write_and_close(conn, render_response_or_fallback(resp), config)

# The 500 fallback (reachable only when a handler returns a status outside the
# supported table) still uses http_response's fixed format — no Content-Length, its own
# Content-Type — rather than the dict-assembled `render`. Acceptable for this rare
# internal-error path; the normal response path goes through `render`.
fn render_response_or_fallback(resp: HttpServerResponse) -> String =
  match render(resp) with
  | Ok raw -> raw
  | Err _ ->
      match http_response(500, "internal server error") with
      | Ok raw -> raw
      | Err _ -> "HTTP/1.1 500 Internal Server Error\r\nConnection: close\r\nContent-Type: text/plain\r\n\r\ninternal server error"

# Each accepted connection is handled in its own fire-and-forget green task, so a
# slow connection (one dribbling its request) cannot block others: `tcp_accept`
# resumes the moment a handler parks on socket I/O. `remaining` counts connections
# ACCEPTED, not fully served — the enclosing scope join is what waits for the last
# spawned handler to finish. Handlers therefore complete in I/O-ready order, not
# accept order.
#
# `conn` is MOVED into the spawned closure (M4.4a): `task_spawn`'s `work` parameter
# is declared `once`, so ownership transfers at the call and the handler holds the
# sole consume. `listener` is consumed exactly once on every path — by
# `close_listener` on the terminating branch, and by the recursive call itself on
# the looping one.
# Reached only when the listener itself is unusable, so there is nothing left to serve. Loud on
# purpose: `http_server` has no logging of its own, and the alternative — returning quietly — turns an
# unserviceable server into one that looks like a clean shutdown.
#
# There is no retry or back-off loop here, and that is not an omission. Everything transient about an
# accept (EAGAIN, EINTR, ECONNABORTED, the eight pending-network errnos, descriptor exhaustion, a full
# handle table) is absorbed inside `tcp_accept`, because the wait each needs is on the listener fd and
# Sprout has no primitive that registers one. An earlier revision of this file DID back off here with
# `task_sleep`, which is exactly wrong on Linux: task_sleep arms a timerfd, so under descriptor
# exhaustion it cannot be armed, and its arming failure is deliberately process-fatal. CI caught it —
# `runtime error: builtin task_sleep: could not arm a timer (descriptor exhaustion?)` — on a fixture
# that passed locally, because macOS arms kqueue timers on the existing kqueue and needs no descriptor.
fn accept_fatal(err: TcpError) -> a !{IO} =
  panic(`http_server: accept failed on the listener: ${tcp_error_message(err)}`)

fn serve_loop(scope: Scope, listener: consuming TcpListener, remaining: Int, config: ServerConfig, handler: HttpRequest -> HttpServerResponse !{IO}) -> Unit !{IO} =
  if remaining == 0 then close_listener(listener)
  else
    match accept(listener) with
    # `remaining` decrements only here. A failed accept served no connection, so counting it would let
    # a burst of accept failures end a bounded run early — and this is the path CI's serve_n uses.
    | Ok conn ->
        do
          task_spawn(scope, \_ -> handle_connection(config, conn, handler))
          serve_loop(scope, listener, remaining - 1, config, handler)
    | Err err ->
        do
          close_listener(listener)
          accept_fatal(err)

# `with_scope` does not return until every spawned handler has finished, so no
# connection outlives the call (structured concurrency — no orphaned handlers).
export fn serve_n(port: Int, max_connections: Int, handler: HttpRequest -> HttpServerResponse !{IO}) -> Unit !{IO} =
  serve_n_with(default_config(), port, max_connections, handler)

# `serve_n` with explicit read budgets. Exported mainly so the timeouts are testable at all — a
# hard-coded 10 s header budget would make a regression test either slow or impossible — but it is
# also the knob a deployment behind a slow link needs.
export fn serve_n_with(config: ServerConfig, port: Int, max_connections: Int, handler: HttpRequest -> HttpServerResponse !{IO}) -> Unit !{IO} =
  with_scope(\s -> serve_loop(s, listen_local(port), max_connections, config, handler))

# Unbounded counterpart of `serve_loop`: the same accept-and-spawn body with no
# terminating branch, so it keeps accepting connections forever. Each handler is
# a fire-and-forget green task reclaimed on completion (see stdlib.task), so the
# server does not accumulate finished handlers even though the enclosing scope
# never joins. The listener is never closed — the loop owns it for the process's
# lifetime — and yet this is NOT a linear leak: the tail call consumes it, which
# is the accurate reading, since the next iteration really does own it.
fn serve_forever_loop(scope: Scope, listener: consuming TcpListener, config: ServerConfig, handler: HttpRequest -> HttpServerResponse !{IO}) -> Unit !{IO} =
  match accept(listener) with
  | Ok conn ->
      do
        task_spawn(scope, \_ -> handle_connection(config, conn, handler))
        serve_forever_loop(scope, listener, config, handler)
  | Err err ->
      do
        close_listener(listener)
        accept_fatal(err)

# Serve requests forever. Unlike `serve_n`, this never returns under normal
# operation — the enclosing `with_scope` join is unreachable, which is exactly
# what an always-on server wants. Reach for `serve_n` when a bounded, terminating
# run is needed (e.g. tests/CI).
export fn serve(port: Int, handler: HttpRequest -> HttpServerResponse !{IO}) -> Unit !{IO} =
  serve_with(default_config(), port, handler)

# `serve` with explicit read budgets (see serve_n_with).
export fn serve_with(config: ServerConfig, port: Int, handler: HttpRequest -> HttpServerResponse !{IO}) -> Unit !{IO} =
  with_scope(\s -> serve_forever_loop(s, listen_local(port), config, handler))

# ---------------------------------------------------------------------------
# Pooled serving (opt-in)
# ---------------------------------------------------------------------------
#
# A FIXED set of long-lived workers pulling owned connections off a channel, instead of one
# fire-and-forget task per connection. `serve`/`serve_n` are untouched: this is additive, and the
# caller opts in.
#
# Why it is worth a second entry point: a spawned task costs ~1.5 MiB — a 1 MiB green stack plus a
# 512 KiB root pool — and `makecontext` ZEROES the whole stack, so every page of every per-request
# task becomes resident. Task setup measured 75% of this server's CPU. A worker pays that once
# instead of once per request, and touches only the few KB its handler uses. Measured on two servers
# with byte-identical request handling (bench/http_worker_pool): 3.5-5.4x throughput, 202 MB -> 8 MB
# RSS, p50 1.41 ms -> 297 us. Full design and the 17-hazard analysis of the rejected runtime-level
# alternative: docs/green-task-pool-v0.md.
#
# The handoff is expressed THROUGH linearity rather than around it: `chan_send` consumes the
# connection, a received `Got conn` carries the sole obligation to consume it, and dropping or
# double-sending one is a compile error. That is why the pool lives here and not in the scheduler —
# a C-level pool moves lifetime correctness one layer below where the checker can see it.
#
# WHAT YOU GIVE UP: at most `workers` requests are in flight at once, against `serve`'s promise that
# a slow connection cannot block others. That cost is now small and bounded, because handler
# occupancy is finite by construction (see ServerConfig): a peer can hold a worker for at most
# `header_ms + body_ms + write_ms + (max_body_bytes + response) / min_rate_bps`, not forever. It was
# NOT safe to pool before those bounds existed — `workers` crawling peers would have wedged the
# server permanently. Throughput barely notices the bound: measured w=2, 8, 64 and 256 all land at
# 23k-32k req/s, because each request is ~4 us of work and the server is accept-bound.

# The worker loop. Returns to `chan_recv` after every connection, which is the whole optimisation —
# a worker that fell out of this loop would silently reduce pool capacity until the server had no
# workers left and stopped answering, with nothing logged and no error anywhere.
#
# `handle_connection` consumes the connection on every path including its error paths, so ordinary
# client misbehaviour — malformed requests, timeouts, resets — cannot end a worker. A `panic` inside
# a user handler still kills its worker, and Sprout has no way to catch it; with spawn-per-connection
# that killed one connection instead. That asymmetry is real and is filed in BACKLOG rather than
# papered over, since the honest mitigations (a supervisor that respawns, or catchable failures) are
# both language-level work.
fn pool_worker(ch: Chan TcpConnection, config: ServerConfig, handler: HttpRequest -> HttpServerResponse !{IO}) -> Unit !{IO} =
  match chan_recv(ch) with
  | Got conn ->
      do
        handle_connection(config, conn, handler)
        pool_worker(ch, config, handler)
  # The channel closed: the accept loop is done, so the worker exits cleanly. This arm binds no
  # connection, so it discharges no obligation — which is what makes shutdown expressible at all.
  | Closed -> task_yield()

fn spawn_pool(scope: Scope, ch: Chan TcpConnection, config: ServerConfig, handler: HttpRequest -> HttpServerResponse !{IO}, remaining: Int) -> Unit !{IO} =
  if remaining <= 0 then task_yield()
  else
    do
      task_spawn(scope, \_ -> pool_worker(ch, config, handler))
      spawn_pool(scope, ch, config, handler, remaining - 1)

# The accept loop owns the listener and MOVES each connection into the channel. A bounded channel is
# what turns "more load than the pool can serve" into backpressure rather than unbounded growth:
# `chan_send` parks this loop once the queue is full, so the server stops accepting instead of
# accumulating connections it has no worker for.
#
# `remaining < 0` means "forever" — the same body serves both the bounded and unbounded entry points,
# since the only difference is whether the counter is ever allowed to reach zero.
fn pooled_accept_loop(ch: Chan TcpConnection, listener: consuming TcpListener, remaining: Int) -> Unit !{IO} =
  if remaining == 0 then
    do
      # Closing the channel is what lets the workers exit, and it must happen BEFORE the scope join:
      # a worker parked in `chan_recv` on a channel nobody will close is a task that never finishes,
      # and `with_scope` would wait for it forever.
      chan_close(ch)
      close_listener(listener)
  else
    match accept(listener) with
    | Ok conn ->
        do
          chan_send(ch, conn)
          pooled_accept_loop(ch, listener, remaining - 1)
    | Err err ->
        do
          # Same ordering constraint as the clean-shutdown path above: the channel must be closed
          # before the scope join, or every worker parked in `chan_recv` is a task that never finishes.
          chan_close(ch)
          close_listener(listener)
          accept_fatal(err)

# The channel is threaded as a PARAMETER rather than bound with `ch <- chan_new(scope, depth)`.
# That is not a style choice: a do-bind of a container holding a linear payload is rejected by the
# known over-strict edge at BACKLOG:1059, so the bind form does not compile. Do not "simplify" this
# into a bind until that edge is fixed.
#
# The listener arrives as an ALREADY-BOUND argument rather than being created in the body, and that
# ordering is load-bearing: `spawn_pool` runs first, so binding inside the body would leave the
# socket unbound across every worker spawn, and a client connecting in that window is refused. The
# unpooled `serve_n_with` gets this for free by passing `listen_local(port)` as an argument, where
# strict evaluation binds it before the loop begins; the pooled path has to do it deliberately.
fn pooled_run(scope: Scope, ch: Chan TcpConnection, config: ServerConfig, listener: consuming TcpListener, workers: Int, remaining: Int, handler: HttpRequest -> HttpServerResponse !{IO}) -> Unit !{IO} =
  do
    spawn_pool(scope, ch, config, handler, workers)
    pooled_accept_loop(ch, listener, remaining)

# 8 workers and a queue 64 deep. Worker count is a CAPACITY decision the deployment owns: throughput
# is flat from 2 to 256 (the server is accept-bound), so 8 is chosen for headroom against handlers
# doing real work rather than for throughput, and a deployment whose handlers block on a database
# should raise it. The queue depth bounds how many accepted-but-unserved connections may be held.
export fn serve_pooled(port: Int, handler: HttpRequest -> HttpServerResponse !{IO}) -> Unit !{IO} =
  serve_pooled_with(default_config(), port, 8, 64, handler)

# `serve_pooled` with explicit budgets, worker count and queue depth.
export fn serve_pooled_with(config: ServerConfig, port: Int, workers: Int, queue_depth: Int, handler: HttpRequest -> HttpServerResponse !{IO}) -> Unit !{IO} =
  with_scope(\s -> pooled_run(s, chan_new(s, queue_depth), config, listen_local(port), workers, -1, handler))

# Bounded counterpart, for tests and bounded runs: serves exactly `max_connections` and returns.
# `max_connections` counts connections ACCEPTED, not fully served; the scope join waits for the
# workers, which the channel close releases.
export fn serve_pooled_n_with(config: ServerConfig, port: Int, workers: Int, queue_depth: Int, max_connections: Int, handler: HttpRequest -> HttpServerResponse !{IO}) -> Unit !{IO} =
  with_scope(\s -> pooled_run(s, chan_new(s, queue_depth), config, listen_local(port), workers, max_connections, handler))
