module stdlib.http_server

import stdlib.http (HttpStatusError, RequestLine, RequestPathVersion, http_response, parse_request_line)
import stdlib.string as string

export type HttpRequest =
  | HttpRequest String String HttpRequestMeta

type HttpRequestMeta =
  | HttpRequestMeta String (Dict String) String

export type HttpServerResponse =
  | HttpServerResponse Int (Dict String) String

export type HttpServerError(..) =
  | HttpInvalidRequest String
  | HttpServerUnsupportedStatus Int

fn find_headers_end(raw: String) -> Int =
  string.find(raw, "\r\n\r\n")

fn find_line_end(raw: String) -> Int =
  string.find(raw, "\r\n")

fn char_at(raw: String, index: Int) -> String =
  string.slice(raw, index, 1)

fn lower_char(ch: String) -> String =
  if string.find("ABCDEFGHIJKLMNOPQRSTUVWXYZ", ch) < 0 then ch
  else string.slice("abcdefghijklmnopqrstuvwxyz", string.find("ABCDEFGHIJKLMNOPQRSTUVWXYZ", ch), 1)

fn lower_ascii_from(raw: String, index: Int, total: Int, acc: String) -> String =
  if index >= total then acc
  else lower_ascii_from(raw, index + 1, total, string.concat(acc, lower_char(char_at(raw, index))))

fn lower_ascii(raw: String) -> String =
  lower_ascii_from(raw, 0, string.length(raw), "")

fn split_lines_from(raw: String, index: Int, total: Int, acc: Vec String, current: String) -> Vec String =
  if index >= total then vec_append(current, acc)
  else if char_at(raw, index) == "\r" then split_lines_from(raw, index + 1, total, acc, current)
  else if char_at(raw, index) == "\n" then split_lines_from(raw, index + 1, total, vec_append(current, acc), "")
  else split_lines_from(raw, index + 1, total, acc, string.concat(current, char_at(raw, index)))

fn split_lines(raw: String) -> Vec String =
  split_lines_from(raw, 0, string.length(raw), vec_empty(), "")

fn parse_header_pair(pair: (String, String)) -> Maybe (String, String) =
  match pair with
  | (name, value) ->
      if string.is_empty(name) then Nothing
      else Just((lower_ascii(string.trim(name)), string.trim(value)))

fn parse_header_line(raw: String) -> Maybe (String, String) =
  match string.split_once(raw, ":") with
  | Nothing -> Nothing
  | Just pair -> parse_header_pair(pair)

fn parse_header_lines(lines: Vec String, index: Int, total: Int, headers: Dict String) -> Result HttpServerError (Dict String) =
  if index >= total then Ok(headers)
  else
    match vec_get(index, lines) with
    | Nothing -> Ok(headers)
    | Just line ->
        if string.is_empty(line) then parse_header_lines(lines, index + 1, total, headers)
        else
          match parse_header_line(line) with
          | Nothing -> Err(HttpInvalidRequest("invalid header line"))
          | Just pair ->
              match pair with
              | (name, value) -> parse_header_lines(lines, index + 1, total, dict_set(name, value, headers))

fn parse_headers(raw: String) -> Result HttpServerError (Dict String) =
  parse_header_lines(lines, 0, vec_length(lines), dict_empty())
where
  lines = split_lines(raw)

fn all_digits(raw: String, index: Int, total: Int) -> Bool =
  if index >= total then true
  else if string.find("0123456789", char_at(raw, index)) < 0 then false
  else all_digits(raw, index + 1, total)

fn parse_content_length(headers: Dict String) -> Result HttpServerError Int =
  match dict_get("content-length", headers) with
  | Nothing -> Ok(0)
  | Just raw ->
      if string.is_empty(raw) then Err(HttpInvalidRequest("empty Content-Length"))
      else if all_digits(raw, 0, string.length(raw)) then Ok(parse_int(raw))
      else Err(HttpInvalidRequest("invalid Content-Length"))

fn request_body_start(raw: String) -> Int =
  find_headers_end(raw) + 4

fn parse_request_prefix(raw: String) -> Result HttpServerError (RequestLine, Dict String, Int) =
  if headers_end < 0 then Err(HttpInvalidRequest("missing header terminator"))
  else if line_end < 0 then Err(HttpInvalidRequest("missing request line terminator"))
  else
    match parse_request_line(string.take(raw, line_end)) with
    | Nothing -> Err(HttpInvalidRequest("invalid request line"))
    | Just req ->
        match parse_headers(header_block) with
        | Err err -> Err(err)
        | Ok headers ->
            match parse_content_length(headers) with
            | Err err -> Err(err)
            | Ok content_length -> Ok((req, headers, content_length))
where
  headers_end = find_headers_end(raw)
  line_end = find_line_end(raw)
  header_block = string.slice(raw, line_end + 2, headers_end - (line_end + 2))

fn build_request(req: RequestLine, headers: Dict String, body: String) -> HttpRequest =
  match req with
  | RequestLine method pv ->
      match pv with
      | RequestPathVersion path version -> HttpRequest(method, path, HttpRequestMeta(version, headers, body))

export fn parse(raw: String) -> Result HttpServerError HttpRequest =
  match parse_request_prefix(raw) with
  | Err err -> Err(err)
  | Ok prefix -> parse_from_prefix(raw, prefix)

fn parse_from_prefix(raw: String, prefix: (RequestLine, Dict String, Int)) -> Result HttpServerError HttpRequest =
  err_or_request(req, headers, content_length, raw)
where
  (req, headers, content_length) = prefix

fn err_or_request(req: RequestLine, headers: Dict String, content_length: Int, raw: String) -> Result HttpServerError HttpRequest =
  if string.length(string.drop(raw, request_body_start(raw))) < content_length then
    Err(HttpInvalidRequest("request body shorter than Content-Length"))
  else
    Ok(build_request(req, headers, string.take(string.drop(raw, request_body_start(raw)), content_length)))

fn read_until_headers(conn: Int, acc: String) -> Result HttpServerError String !{IO} =
  if find_headers_end(acc) >= 0 then Ok(acc)
  else
    match tcp_read(conn) with
    | chunk ->
        if string.is_empty(chunk) then Err(HttpInvalidRequest("unexpected end of stream"))
        else read_until_headers(conn, string.concat(acc, chunk))

fn read_remaining_body(conn: Int, acc: String, remaining: Int) -> Result HttpServerError String !{IO} =
  if remaining <= 0 then Ok(acc)
  else
    match tcp_read(conn) with
    | chunk ->
        if string.is_empty(chunk) then Err(HttpInvalidRequest("unexpected end of stream"))
        else read_remaining_body(conn, string.concat(acc, chunk), remaining - string.length(chunk))

fn read_request(conn: Int) -> Result HttpServerError HttpRequest !{IO} =
  match read_until_headers(conn, "") with
  | Err err -> Err(err)
  | Ok raw -> read_request_from_prefix(conn, raw)

fn read_request_from_prefix(conn: Int, raw: String) -> Result HttpServerError HttpRequest !{IO} =
  match parse_request_prefix(raw) with
  | Err err -> Err(err)
  | Ok prefix -> continue_read_request(conn, raw, prefix)

fn continue_read_request(conn: Int, raw: String, prefix: (RequestLine, Dict String, Int)) -> Result HttpServerError HttpRequest !{IO} =
  if string.length(body) >= content_length then parse(raw)
  else
    match read_remaining_body(conn, raw, content_length - string.length(body)) with
    | Err err -> Err(err)
    | Ok full -> parse(full)
where
  (_req, _headers, content_length) = prefix
  body = string.drop(raw, request_body_start(raw))

fn headers_to_lines(keys: Vec String, headers: Dict String, index: Int, total: Int, acc: String) -> String =
  if index >= total then acc
  else
    match vec_get(index, keys) with
    | Nothing -> acc
    | Just key ->
        match dict_get(key, headers) with
        | Nothing -> headers_to_lines(keys, headers, index + 1, total, acc)
        | Just value ->
            headers_to_lines(
              keys,
              headers,
              index + 1,
              total,
              string.concat(acc, string.concat(key, string.concat(": ", string.concat(value, "\r\n"))))
            )

fn render_extra_headers(headers: Dict String) -> String =
  headers_to_lines(keys, headers, 0, vec_length(keys), "")
where
  keys = dict_keys(headers)

fn inject_headers(base: String, extra: String) -> String =
  if string.is_empty(extra) then base
  else if string.find(base, "\r\n\r\n") < 0 then base
  else
    string.concat(
      string.take(base, string.find(base, "\r\n\r\n") + 2),
      string.concat(extra, string.drop(base, string.find(base, "\r\n\r\n")))
    )

export fn response(status: Int, body: String) -> HttpServerResponse =
  HttpServerResponse(status, dict_empty(), body)

export fn ok(body: String) -> HttpServerResponse =
  response(200, body)

export fn bad_request(body: String) -> HttpServerResponse =
  response(400, body)

export fn not_found(body: String) -> HttpServerResponse =
  response(404, body)

export fn with_header(name: String, value: String, resp: HttpServerResponse) -> HttpServerResponse =
  match resp with
  | HttpServerResponse status headers body -> HttpServerResponse(status, dict_set(header_name, value, headers), body)
where
  header_name = lower_ascii(name)

export fn request_method(req: HttpRequest) -> String =
  match req with
  | HttpRequest method _ _ -> method

export fn request_path(req: HttpRequest) -> String =
  match req with
  | HttpRequest _ path _ -> path

export fn request_version(req: HttpRequest) -> String =
  match req with
  | HttpRequest _ _ meta ->
      match meta with
      | HttpRequestMeta version _ _ -> version

export fn request_body(req: HttpRequest) -> String =
  match req with
  | HttpRequest _ _ meta ->
      match meta with
      | HttpRequestMeta _ _ body -> body

export fn request_header(name: String, req: HttpRequest) -> Maybe String =
  match req with
  | HttpRequest _ _ meta ->
      match meta with
      | HttpRequestMeta _ headers _ -> dict_get(lower_ascii(name), headers)

export fn render(resp: HttpServerResponse) -> Result HttpServerError String =
  match resp with
  | HttpServerResponse status headers body ->
      match http_response(status, body) with
      | Ok raw -> Ok(inject_headers(raw, render_extra_headers(headers)))
      | Err err ->
          match err with
          | HttpUnsupportedStatus code -> Err(HttpServerUnsupportedStatus(code))

fn write_and_close(conn: Int, payload: String) -> Unit !{IO} =
  after(tcp_write(conn, payload), tcp_close(conn))

fn handle_connection(conn: Int, handler: HttpRequest -> HttpServerResponse) -> Unit !{IO} =
  match read_request(conn) with
  | Err _ -> write_and_close(conn, bad_request("bad request") |> render_response_or_fallback)
  | Ok req ->
      write_and_close(conn, handler(req) |> render_response_or_fallback)

fn render_response_or_fallback(resp: HttpServerResponse) -> String =
  match render(resp) with
  | Ok raw -> raw
  | Err _ ->
      match http_response(500, "internal server error") with
      | Ok raw -> raw
      | Err _ -> "HTTP/1.1 500 Internal Server Error\r\nConnection: close\r\nContent-Type: text/plain\r\n\r\ninternal server error"

fn serve_loop(listener: Int, remaining: Int, handler: HttpRequest -> HttpServerResponse) -> Unit !{IO} =
  if remaining == 0 then tcp_close_listener(listener)
  else after(handle_connection(tcp_accept(listener), handler), serve_loop(listener, remaining - 1, handler))

export fn serve_n(port: Int, max_connections: Int, handler: HttpRequest -> HttpServerResponse) -> Unit !{IO} =
  serve_loop(tcp_listen(port), max_connections, handler)
