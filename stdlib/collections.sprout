module stdlib.collections

export type Maybe a =
  | Just a
  | Nothing

export type Vec a =
  | Vec (Vector a)

export type Dict v =
  | Dict (Map v)

export fn vec_empty() -> Vec a =
  Vec(vector_empty())

export fn vec_prepend(value: a, vec: Vec a) -> Vec a =
  match vec with
  | Vec raw ->
      Vec(vec_prepend_into(vector_empty(), value, raw, 0, vector_length(raw)))

fn vec_prepend_into(acc: Vector a, first: a, source: Vector a, index: Int, total: Int) -> Vector a =
  if index == 0 then
    vec_prepend_into(vector_append(acc, first), first, source, 1, total)
  else if index > total then acc
  else
    match vector_get(source, index - 1) with
    | Nothing -> acc
    | Just item -> vec_prepend_into(vector_append(acc, item), first, source, index + 1, total)

export fn vec_append(vec: Vec a, value: a) -> Vec a =
  match vec with
  | Vec raw -> Vec(vector_append(raw, value))

export fn vec_length(vec: Vec a) -> Int =
  match vec with
  | Vec raw -> vector_length(raw)

export fn vec_get(vec: Vec a, index: Int) -> Maybe a =
  match vec with
  | Vec raw -> vector_get(raw, index)

export fn vec_get_or(vec: Vec a, index: Int, fallback: a) -> a =
  match vec_get(vec, index) with
  | Just value -> value
  | Nothing -> fallback

export fn vec_set(vec: Vec a, index: Int, value: a) -> Vec a =
  match vec with
  | Vec raw -> Vec(vector_set(raw, index, value))

export fn vec_map(vec: Vec a, f: a -> b) -> Vec b =
  vec_map_indexed(vec, f, 0, vec_length(vec), vec_empty())

fn vec_map_indexed(vec: Vec a, f: a -> b, index: Int, total: Int, acc: Vec b) -> Vec b =
  if index >= total then acc
  else
    match vec_get(vec, index) with
    | Nothing -> acc
    | Just value -> vec_map_indexed(vec, f, index + 1, total, vec_append(acc, f(value)))

export fn vec_fold(vec: Vec a, init: b, f: b -> a -> b) -> b =
  vec_fold_indexed(vec, init, f, 0, vec_length(vec))

fn vec_fold_indexed(vec: Vec a, acc: b, f: b -> a -> b, index: Int, total: Int) -> b =
  if index >= total then acc
  else
    match vec_get(vec, index) with
    | Nothing -> acc
    | Just value -> vec_fold_indexed(vec, f(acc, value), f, index + 1, total)

export fn vec_slice(vec: Vec a, start: Int, count: Int) -> Vec a =
  if count <= 0 then vec_empty()
  else
    vec_slice_from(vec, if start < 0 then 0 else start, count, 0, vec_length(vec), vec_empty())

fn vec_slice_from(vec: Vec a, start: Int, count: Int, index: Int, total: Int, acc: Vec a) -> Vec a =
  if index >= total then acc
  else if index < start then
    vec_slice_from(vec, start, count, index + 1, total, acc)
  else if index >= start + count then acc
  else
    match vec_get(vec, index) with
    | Nothing -> acc
    | Just value -> vec_slice_from(vec, start, count, index + 1, total, vec_append(acc, value))

export fn vec_reverse(vec: Vec a) -> Vec a =
  vec_reverse_from(vec, vec_length(vec) - 1, vec_empty())

fn vec_reverse_from(vec: Vec a, index: Int, acc: Vec a) -> Vec a =
  if index < 0 then acc
  else
    match vec_get(vec, index) with
    | Nothing -> acc
    | Just value -> vec_reverse_from(vec, index - 1, vec_append(acc, value))

fn add_ints(left: Int, right: Int) -> Int = left + right

export fn vec_sum(vec: Vec Int) -> Int =
  vec_fold(vec, 0, add_ints)

export fn vec_sum_by(vec: Vec a, f: a -> Int) -> Int =
  vec_sum(vec_map(vec, f))

export class Foldable f {
  fn fold_values(xs: f a, init: b, step: b -> a -> b) -> b
}

instance Foldable Vec {
  fn fold_values(xs: Vec a, init: b, step: b -> a -> b) -> b =
    vec_fold(xs, init, step)
}

fn vec_append_flip(acc: Vec a, item: a) -> Vec a =
  vec_append(acc, item)

export fn foldable_to_vec(xs: f a) -> Vec a where Foldable f =
  fold_values(xs, vec_empty(), vec_append_flip)

export fn dict_empty() -> Dict v =
  Dict(map_empty())

export fn dict_get(dict: Dict v, key: String) -> Maybe v =
  match dict with
  | Dict raw -> map_get(raw, key)

export fn dict_set(dict: Dict v, key: String, value: v) -> Dict v =
  match dict with
  | Dict raw -> Dict(map_set(raw, key, value))

export fn dict_remove(dict: Dict v, key: String) -> Dict v =
  match dict with
  | Dict raw -> Dict(map_remove(raw, key))

export fn dict_keys(dict: Dict v) -> Vec String =
  match dict with
  | Dict raw -> dict_keys_from(raw, 0, map_size(raw), vec_empty())

fn dict_keys_from(raw: Map v, index: Int, total: Int, acc: Vec String) -> Vec String =
  if index >= total then acc
  else
    match map_nth_key(raw, index) with
    | Nothing -> acc
    | Just key -> dict_keys_from(raw, index + 1, total, vec_append(acc, key))

export fn dict_values(dict: Dict v) -> Vec v =
  match dict with
  | Dict raw -> dict_values_from(raw, 0, map_size(raw), vec_empty())

fn dict_values_from(raw: Map v, index: Int, total: Int, acc: Vec v) -> Vec v =
  if index >= total then acc
  else
    match map_nth_value(raw, index) with
    | Nothing -> acc
    | Just value -> dict_values_from(raw, index + 1, total, vec_append(acc, value))
