module stdlib.compiler.infer
import stdlib.compiler.ast as ast
import stdlib.compiler.types as types
import stdlib.compiler.unifier as unifier
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.source as source
import stdlib.compiler.linear_check as linear_check
import stdlib.string as string
import stdlib.env as env

# ---------------------------------------------------------------------------
# Env wraps — GlobalEnv vs raw body-scope Dict types.Scheme
# ---------------------------------------------------------------------------
#
# GlobalEnv is the environment that flows BETWEEN declarations: it accumulates
# scheme entries for declared values, plus @eta_fwd:* markers folded in at
# the end of each constrained FnDecl (see fold_fwd_markers).
#
# A raw Dict types.Scheme is used for body-scope environments that may also
# carry @fwd:* markers (added by seed_forward_markers inside check_fn_body).
# These markers are scoped to a single function body — they MUST NEVER flow
# back into the GlobalEnv. The wrap encodes this invariant at the type
# level: any value typed GlobalEnv is guaranteed to be a between-decl env,
# and converting a body-scope Dict into a GlobalEnv requires an explicit
# constructor call.
#
# Background: retros/2026-05-30-0037.md documents a bug caused by folding
# @fwd: entries directly into the global env. With GlobalEnv distinct from
# raw Dict, the same code pattern requires an explicit `GlobalEnv(body_dict)`
# conversion, which is loud and reviewable.

wrap GlobalEnv = Dict types.Scheme

# Unwrap GlobalEnv to its underlying Dict.  Used at the boundary to call
# raw-Dict helpers (dict_get / dict_set / etc.); the result must be wrapped
# back as GlobalEnv if it flows between decls.
fn global_env_dict(env: GlobalEnv) -> Dict types.Scheme =
  match env with | GlobalEnv d -> d

# ---------------------------------------------------------------------------
# Type-variable name wraps — ProgVarName vs FreshTVarName
# ---------------------------------------------------------------------------
#
# Two semantically distinct kinds of type-variable identifier share the
# underlying String representation, and confusing them is a documented
# bug class (retros/2026-05-29-constrained-dict-injection-cascade.md).
#
# ProgVarName is the type variable name the programmer wrote in source —
# for example "a" in `fn foo(x: a) -> a where MyShow a`. These names appear
# in `ast.TypeName` nodes and as the keys of `prog_to_fresh` (the
# instantiation mapping from programmer vars to fresh TVars). Functions
# that resolve typeclass obligations look up by ProgVarName because that
# is the name visible in the source constraint.
#
# FreshTVarName is the compiler-generated unique name produced by
# `unifier.fresh` during type instantiation — for example "a42". These
# names appear inside `types.TVar` and are used as the key prefix in
# @fwd:* and @eta_fwd:* env markers (e.g. "@fwd:a42:MyShow"). They are
# globally unique within a single InferState.
#
# The translation between the two kinds goes through `prog_to_fresh`:
# `dict_get(prog_var, prog_to_fresh)` returns the `TVar(fresh_name)` that
# the programmer's `a` was instantiated to.
#
# Mixing the two kinds is a silent failure mode: a lookup keyed by
# ProgVarName against a marker stored under FreshTVarName misses, falling
# through to a fallback that may inject the wrong dict. The wrap makes
# the swap a compile error at the function-signature boundary.

wrap ProgVarName = String
wrap FreshTVarName = String

# Unwrap helpers — used at the boundary to compose marker keys via string
# concatenation, or to look up by name in raw Dicts.
fn prog_var_str(p: ProgVarName) -> String =
  match p with | ProgVarName s -> s

fn fresh_tvar_str(f: FreshTVarName) -> String =
  match f with | FreshTVarName s -> s

# ---------------------------------------------------------------------------
# Inference result types
# ---------------------------------------------------------------------------

export type InferResult (..) =
  | InferOk typed_ast.TypedExpr (Dict types.Type) (Dict types.Effect) types.Effect
  | InferErr source.SourcePos String

type InferArgsResult =
  | ArgsOk (List typed_ast.TypedExpr) (Dict types.Type) (Dict types.Effect) types.Effect
  | ArgsErr source.SourcePos String

# One call argument during two-pass argument inference (see infer_call_args).
# A lambda is held back with the fresh variable standing in for its parameter
# slot, so the slot can be resolved before its body is inferred.
type ArgSlot =
  | ArgDone typed_ast.TypedExpr types.Effect
  | ArgLambda (List ast.Param) ast.Expr types.Type source.SourcePos

type ArgSlotsResult =
  | SlotsOk (List ArgSlot) (Dict types.Type) (Dict types.Effect)
  | SlotsErr source.SourcePos String

type CallResult =
  | CallOk types.Type (Dict types.Type) (Dict types.Effect) types.Effect
  | CallErr source.SourcePos String

# Internal per-decl result (not exported; callers see TypedResult).
# The env field is GlobalEnv because each typecheck_decl produces the
# between-decl environment that the next decl will see.
# The fourth field of TypedDeclOk is the substitution the declaration ENDS with,
# handed to the next one. Before binding-group inference this was thrown away at
# every declaration boundary, so a declaration that pinned an unannotated
# neighbour's placeholder had nowhere to record it and the pin never bound
# anything. Declarations that learn nothing pass their input through unchanged.
type TypedDeclResult =
  | TypedDeclOk typed_ast.TypedDecl GlobalEnv (List String) (Dict types.Type)
  | TypedDeclErr source.SourcePos String

# What one group member's body inference produced, held until the group's
# boundary. Split out of typecheck_decl's FnDecl arm so a MULTI-member group can
# infer every member before committing any of them: a member rebound to its
# generalized type mid-group would stop being the shared monomorphic assumption
# its siblings are still being checked against, which is the one thing
# binding-group inference exists to preserve.
# See docs/binding-group-inference-v0.md §6.
type FnInferred =
  | FnInferred ast.Decl typed_ast.TypedExpr types.Type (Dict types.Scheme) (List (String, String)) (List String)
  # FnInferred decl  typed_body  inferred_type  fwd_markers  decl_constraints  group_env_ftv

type FnInferResult =
  | FnInferOk FnInferred
  | FnInferErr source.SourcePos String

# The five things a group hands to the next group, or the error that stopped it.
# The two `Dict types.Type` fields are NOT interchangeable: the first is the
# inference substitution, the second the alias environment.
type GroupResult =
  | GroupOk (Dict typed_ast.TypedDecl) GlobalEnv (Dict types.Type) (Dict types.Type) (List String)
  # GroupOk  out_by_index  env  subst  alias_env  env_ftv
  | GroupErr source.SourcePos String

# Internal single-method result.
type InstanceMethodResult =
  | InstanceMethodOk typed_ast.TypedInstanceMethod
  | InstanceMethodErr source.SourcePos String

# ---------------------------------------------------------------------------
# Type-expression → Type
# ---------------------------------------------------------------------------

export fn type_from_ast(te: ast.TypeExpr, local_vars: Dict types.Type) -> types.Type =
  match te with
  | ast.TypeName name -> lookup_type_var(name, local_vars)
  | ast.TypeApply base arg ->
      types.TApp(type_from_ast(base, local_vars), type_from_ast(arg, local_vars))
  | ast.TypeArrow param ret effs ->
      # An ANNOTATED arrow type means consuming: arrow-type syntax cannot yet
      # spell `borrowing` (deferred — see BACKLOG "modifiers in arrow types"), so
      # there is nothing here to read. Passing a borrowing function to such an
      # annotation is therefore a mode mismatch, and its message says so.
      #
      # `effs` was discarded here until 2026-08-16, which is why a parameter
      # written `f: a -> Unit !{e}` typed as a plain `a -> Unit`: the parser has
      # always recorded the effect (parser.make_type_arrow hoists a trailing
      # annotation onto the arrow it is building, so `a -> b -> C !{IO}` puts it
      # on the INNERMOST arrow), and inference threw it away one step later.
      types.TFunc(type_from_ast(param, local_vars), type_from_ast(ret, local_vars),
        effect_from_maybe_labels(effs), types.OwnConsume)
  # A bare effect suffix on a NON-arrow type. `Type` has no effect slot outside
  # TFunc, so there is nowhere to put it — but nothing is lost: the two positions
  # where a trailing annotation is meaningful are both intercepted earlier. On an
  # arrow, parser.make_type_arrow hoists it into the TypeArrow above; on a
  # declaration's return type, the decl parser splits it out into the FnDecl's own
  # `effects` field (parser.sprout:1760), which is how `fn main() -> Unit !{IO}`
  # carries an effect with no arrow to hang it on.
  | ast.TypeEffect inner _ -> type_from_ast(inner, local_vars)
  | ast.TupleType parts -> types.TTuple(type_list_from_ast(parts, local_vars))

fn lookup_type_var(name: String, local_vars: Dict types.Type) -> types.Type =
  match dict_get(name, local_vars) with
  | Just t -> t
  # Module-qualified type identity (T7): return the bundler's already-canonical
  # name verbatim. Stripping here collapsed `main.Foo` and a prelude `Foo` to one
  # identity. The prelude's canonical form is unqualified (empty module header), so
  # this is a no-op on dotless names and only preserves genuine module prefixes.
  #
  # On the bundling path the name IS already canonical, because the bundler
  # rewrote it. On the env path nothing has, and the two sides of an annotation
  # disagree: an imported module is checked with its header stripped, so its
  # schemes carry SHORT type names (`bytes.to_string :: … Result Utf8Error …`),
  # while the annotation still spells the importer's alias (`bytes.Utf8Error`).
  # Dropping a KNOWN alias prefix makes the two meet on the short name the env
  # path uses everywhere — including in the `@linear:` and `@inst:` marker keys,
  # which are keyed by short type name and would MISS if types were qualified
  # here instead. A prefix that is not an import alias (`main.Foo`) is returned
  # verbatim, so T7's distinction survives untouched.
  | Nothing -> resolve_qualified_type_name(name, local_vars)

# The alias part of `alias.Type` — the FIRST segment, which is what an import
# binds. An already-canonical `stdlib.bytes.Utf8Error` yields `stdlib`, which is
# never an alias, so it falls through and is returned verbatim.
fn before_first_dot(name: String) -> String =
  if i == -1 then name else str_slice(name, 0, i)
  where i = str_find(name, ".")

# `@qualalias:` keys carry ':' and '@', neither legal in a type name, so the
# sentinels cannot collide with a real type parameter sharing the dict.
fn resolve_qualified_type_name(name: String, local_vars: Dict types.Type) -> types.Type =
  if str_find(name, ".") == -1 then types.TConst(types.type_id(name))
  else
    match dict_get(str_concat("@qualalias:", before_first_dot(name)), local_vars) with
    | Just _ -> types.TConst(types.type_id(string.after_last_dot(name)))
    | Nothing -> types.TConst(types.type_id(name))

fn type_list_from_ast(parts: List ast.TypeExpr, local_vars: Dict types.Type) -> List types.Type =
  match parts with
  | Nil -> Nil
  | Cons h t -> Cons(type_from_ast(h, local_vars), type_list_from_ast(t, local_vars))

export fn effect_from_maybe_labels(labels: Maybe (List String)) -> types.Effect =
  types.effect_from_labels(labels)

# ---------------------------------------------------------------------------
# Build a Scheme from a FnDecl
# ---------------------------------------------------------------------------

# `owner` names the declaration the scheme belongs to, and exists only to make
# the UNANNOTATED-slot placeholder unique to it. A single global "_unann" made
# every unannotated function in the program share one variable; a name derived
# from the declaration makes it one variable per declaration, which is the shared
# monomorphic assumption HM wants and nothing more. See
# docs/binding-group-inference-v0.md.
fn scheme_from_fn_parts(
  owner: String,
  params: List ast.Param,
  ret_type_maybe: Maybe ast.TypeExpr,
  effects_maybe: Maybe (List String),
  alias_env: Dict types.Type
) -> types.Scheme =
  scheme_from_fn_parts_inner(
    collect_ret_type_vars(ret_type_maybe, collect_param_type_vars(params, Nil)),
    owner,
    params,
    ret_type_maybe,
    effects_maybe,
    alias_env
  )

# The placeholder standing in for a slot the programmer did not annotate. It is
# an ordinary type variable with a name no source program can write, and — the
# part that matters — it is NOT added to the scheme's quantified list, so
# `instantiate` leaves it alone and every use of the declaration sees the SAME
# variable. Pinning it is therefore a commitment, not a per-call guess.
fn unann_ret_var(owner: String) -> String = "_unann@" ++ owner

fn unann_param_var(owner: String, param: String) -> String =
  "_unann@" ++ owner ++ "/" ++ param

# A declaration's OWN placeholders, subtracted from env_ftv at its generalization
# boundary.
#
# Leaving the placeholders out of the binder list makes them FREE variables of the
# scheme pre_scan publishes, so `ftv_env` — which is where env_ftv comes from —
# now sees them. For every OTHER declaration that is exactly right: a placeholder
# another declaration pinned is a commitment this one must not quantify away, and
# quantifying it would re-open the forward-reference hole from the other side.
# For the declaration that OWNS it the same rule is backwards, because that
# variable is precisely what generalization exists to quantify. Without this
# subtraction `fn id(x) = x` infers the monomorphic `_unann@id/x -> _unann@id/x`
# instead of `forall a. a -> a`. Regression: tests/stdlib/compiler/test_compiler.spr.
fn own_unann_vars(owner: String, params: List ast.Param, ret_type_maybe: Maybe ast.TypeExpr) -> List String =
  own_unann_ret(owner, ret_type_maybe, own_unann_params(owner, params, Nil))

fn own_unann_params(owner: String, params: List ast.Param, acc: List String) -> List String =
  match params with
  | Nil -> acc
  | Cons p rest ->
      match p with
      | ast.Param pname maybe_type _ ->
          match maybe_type with
          | Nothing -> own_unann_params(owner, rest, Cons(unann_param_var(owner, pname), acc))
          | Just _ -> own_unann_params(owner, rest, acc)

fn own_unann_ret(owner: String, ret_type_maybe: Maybe ast.TypeExpr, acc: List String) -> List String =
  match ret_type_maybe with
  | Nothing -> Cons(unann_ret_var(owner), acc)
  | Just _ -> acc

# Nil is the overwhelmingly common case (a fully annotated declaration), and it
# is also the case where list_diff would walk env_ftv to no purpose.
fn env_ftv_for_decl(env_ftv: List String, own: List String) -> List String =
  match own with
  | Nil -> env_ftv
  | [_ | _] -> types.list_diff(env_ftv, own)

fn list_add_unique(x: String, xs: List String) -> List String =
  if types.list_member(x, xs) then xs else append(xs, Cons(x, Nil))

fn collect_param_type_vars(params: List ast.Param, acc: List String) -> List String =
  match params with
  | Nil -> acc
  | Cons p rest ->
      match p with
      | ast.Param name maybe_type _ ->
          match maybe_type with
          # An unannotated parameter contributes NOTHING here. Its placeholder is
          # minted by param_types_from_decl and deliberately left unquantified.
          | Nothing -> collect_param_type_vars(rest, acc)
          | Just te -> collect_param_type_vars(rest, collect_te_vars(te, acc))

fn collect_te_vars(te: ast.TypeExpr, acc: List String) -> List String =
  match te with
  | ast.TypeName name ->
      if is_lowercase_name(name) then list_add_unique(name, acc) else acc
  | ast.TypeApply base arg ->
      collect_te_vars(arg, collect_te_vars(base, acc))
  | ast.TypeArrow param ret _ ->
      collect_te_vars(ret, collect_te_vars(param, acc))
  | ast.TypeEffect inner _ -> collect_te_vars(inner, acc)
  | ast.TupleType parts -> collect_te_vars_list(parts, acc)

fn collect_te_vars_list(parts: List ast.TypeExpr, acc: List String) -> List String =
  match parts with
  | Nil -> acc
  | Cons h t -> collect_te_vars_list(t, collect_te_vars(h, acc))

fn is_lowercase_name(name: String) -> Bool =
  str_find(name, ".") == -1 &&
  (c == "a" || c == "b" || c == "c" || c == "d" || c == "e" ||
   c == "f" || c == "g" || c == "h" || c == "i" || c == "j" ||
   c == "k" || c == "l" || c == "m" || c == "n" || c == "o" ||
   c == "p" || c == "q" || c == "r" || c == "s" || c == "t" ||
   c == "u" || c == "v" || c == "w" || c == "x" || c == "y" || c == "z")
  where c = str_slice(name, 0, 1)

# A call whose callee is a data constructor (uppercase head), not a function.
# Constructor applications of values are syntactic values; function calls are not.
fn is_constructor_ref(name: String) -> Bool =
  is_lowercase_name(string.after_last_dot(name)) == false

# Syntactic value restriction (W3/F-VALRESTR): only generalize a top-level `let`
# whose initializer is a syntactic value — a literal, variable, lambda, tuple of
# values, or constructor applied to values. A function/if/match/do/... initializer
# is monomorphic. Without this, `let cell = mutvec_new(1, Nil)` generalized to
# `forall a. MutVec (List a)` and could be written at Int and read at String.
fn is_syntactic_value(expr: ast.Expr) -> Bool =
  match expr with
  | ast.IntExpr _ _ -> true
  | ast.FloatExpr _ _ -> true
  | ast.BoolExpr _ _ -> true
  | ast.StringExpr _ _ -> true
  | ast.CharExpr _ _ -> true
  | ast.UnitExpr _ -> true
  | ast.VarExpr _ _ -> true
  | ast.LambdaExpr _ _ _ -> true
  | ast.TupleExpr items _ -> all_syntactic_values(items)
  | ast.CallExpr callee args _ ->
      match callee with
      | ast.VarExpr name _ -> is_constructor_ref(name) && all_syntactic_values(args)
      | _ -> false
  | _ -> false

fn all_syntactic_values(exprs: List ast.Expr) -> Bool =
  match exprs with
  | Nil -> true
  | Cons h t -> if is_syntactic_value(h) then all_syntactic_values(t) else false

fn collect_ret_type_vars(ret_type_maybe: Maybe ast.TypeExpr, acc: List String) -> List String =
  match ret_type_maybe with
  # As with an unannotated parameter: the placeholder exists in the TYPE but not
  # in the binder list, which is what makes it monomorphic across uses.
  | Nothing -> acc
  | Just te -> collect_te_vars(te, acc)

fn build_type_var_dict(vars: List String, acc: Dict types.Type) -> Dict types.Type =
  match vars with
  | Nil -> acc
  | Cons name rest -> build_type_var_dict(rest, dict_set(name, types.TVar(types.tyvar_id(name)), acc))

# Check a top-level `let x : T = e` annotation against the inferred RHS type.
# Nothing -> pass the substitution through unchanged. Just te -> resolve te
# (seeding its free lowercase tyvars as TVars, as fn signatures do) and unify it
# against the inferred RHS type, so the annotation narrows the binding's scheme
# before generalization. A mismatch is a loud, located error.
fn apply_let_annotation(anno: Maybe ast.TypeExpr, s1: Dict types.Type, es1: Dict types.Effect, rhs_type: types.Type, alias_env: Dict types.Type, name: String) -> unifier.Unified =
  match anno with
  | Nothing -> unifier.UnifyOk(s1, es1)
  | Just te ->
      match unifier.unify_types(s1, es1, unifier.apply_subst(s1, rhs_type), let_annotation_type(te, alias_env)) with
      | unifier.UnifyOk s2 es2 -> unifier.UnifyOk(s2, es2)
      | unifier.UnifyErr e -> unifier.UnifyErr("type annotation mismatch for `" ++ name ++ "`: " ++ e)

# The annotation as a type, with its free lowercase variables seeded as TVars the way a `fn`
# signature's are. Shared by the check above and the push-down below so the two cannot resolve
# the same written type differently.
fn let_annotation_type(te: ast.TypeExpr, alias_env: Dict types.Type) -> types.Type =
  type_from_ast(te, build_type_var_dict(collect_te_vars(te, Nil), alias_env))

# `let x: T = e` where `e` is a lambda: CHECK the lambda against T instead of inferring it and
# unifying afterwards. Haskell 2010 §4.4.1 states the rule this restores — "each use of f is
# treated as having the declared type. It is a static error if the same type cannot also be
# inferred for the defining occurrence" — a signature is checked against the definition.
#
# It matters here because a dictionary is chosen DURING the body's inference. `apply_let_annotation`
# runs after, so `let labeller: Int -> String = label` used to type-check clean while the eta-lambda
# inside it had already resolved `ToString String` off `label`'s own return type — the annotation
# arrived too late to be evidence. The parameter has to be `Int` before the constrained call in the
# body is looked at, which is what `infer_lambda_expected`'s `expected` seeds.
#
# The test is "is a lambda after the eta rewrite", not "was eta-rewritten": a hand-written
# `\n -> label(n)` reaches the same dead end and gets the same fix. `eta_expand_constrained_arg`
# leaves every other expression alone, so a non-lambda right-hand side takes the ordinary path and
# `apply_let_annotation` remains its only annotation check.
#
# A local `let` has no annotation to push (its surface form binds a pattern and carries no
# TypeExpr), so this is a top-level-declaration concern only.
fn typecheck_let_rhs(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expr: ast.Expr,
  anno: Maybe ast.TypeExpr,
  alias_env: Dict types.Type
) -> InferResult !{IO} =
  match anno with
  | Nothing -> typecheck_expr(state, env, subst, eff_subst, expr)
  | Just te ->
      match eta_expand_constrained_arg(expr, env) with
      | ast.LambdaExpr params body lpos ->
          infer_lambda_expected(state, env, subst, eff_subst, params, body,
            Just(let_annotation_type(te, alias_env)), lpos)
      | _ -> typecheck_expr(state, env, subst, eff_subst, expr)

# `fn f(…) -> T = e` where `e` is a lambda: CHECK it against the declared return type
# rather than inferring it and unifying at the declaration boundary afterwards. Same
# correction `typecheck_let_rhs` makes for an annotated `let`, at the other position that
# has a declared type to push down. A dictionary is chosen DURING the body's inference, so
# a check that runs after cannot be the evidence: `fn pick() -> Int -> String = label`
# resolved `ToString String` off `label`'s own return type.
#
# The expected type is read off `inst_type` rather than the return `TypeExpr`. That is the
# whole reason this is safe: `inst_type` is the signature instantiated ONCE, so a return
# type naming a parameter's variable — `fn wrap(x: a) -> a -> String where ToString a` —
# already shares that variable with the parameter, where resolving the TypeExpr separately
# would mint a second `a`.
#
# Only when a return type was written. With none, `fn_return_type` yields the metavar the
# signature was seeded with, which is not evidence about anything.
fn typecheck_fn_body(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  body: ast.Expr,
  ret_type_maybe: Maybe ast.TypeExpr,
  expected_ret: types.Type
) -> InferResult !{IO} =
  match ret_type_maybe with
  | Nothing -> typecheck_expr(state, env, subst, eff_subst, body)
  | Just _ ->
      match eta_expand_constrained_arg(body, env) with
      | ast.LambdaExpr lparams lbody lpos ->
          infer_lambda_expected(state, env, subst, eff_subst, lparams, lbody,
            Just(expected_ret), lpos)
      | _ -> typecheck_expr(state, env, subst, eff_subst, body)

fn scheme_from_fn_parts_inner(
  type_params: List String,
  owner: String,
  params: List ast.Param,
  ret_type_maybe: Maybe ast.TypeExpr,
  effects_maybe: Maybe (List String),
  alias_env: Dict types.Type
) -> types.Scheme =
  types.scheme_quantified(
    type_params,
    build_fn_type_modes(param_types_from_decl(owner, params, local_vars), param_modes(params),
      ret_from_maybe_with_vars(owner, ret_type_maybe, local_vars),
      effect_from_maybe_labels(effects_maybe)),
    effect_from_maybe_labels(effects_maybe),
    Nil
  )
  where local_vars = build_type_var_dict(type_params, alias_env)

fn param_types_from_decl(owner: String, params: List ast.Param, local_vars: Dict types.Type) -> List types.Type =
  match params with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.Param name maybe_type _ ->
          match maybe_type with
          | Nothing -> Cons(types.TVar(types.tyvar_id(unann_param_var(owner, name))), param_types_from_decl(owner, rest, local_vars))
          | Just te -> Cons(type_from_ast(te, local_vars), param_types_from_decl(owner, rest, local_vars))

fn ret_from_maybe_with_vars(owner: String, maybe_te: Maybe ast.TypeExpr, local_vars: Dict types.Type) -> types.Type =
  match maybe_te with
  | Nothing -> types.TVar(types.tyvar_id(unann_ret_var(owner)))
  | Just te -> type_from_ast(te, local_vars)

# An arrow chain whose every parameter CONSUMES. Used where no declaration is in
# reach to say otherwise.
fn build_fn_type(params: List types.Type, ret: types.Type) -> types.Type =
  match params with
  | Nil -> ret
  | Cons p rest -> types.TFunc(p, build_fn_type(rest, ret), types.EffectPure, types.OwnConsume)

# DECLARATION side (M4.6): one ownership per declared parameter. This one call is
# what puts `borrowing` (and, since M4.4a, `once`) into the type of every
# top-level fn, extern fn, class method and instance method — they all reach
# TFunc through here.
#
# `eff` lands on the INNERMOST arrow, which is not an arbitrary pick: it is the
# placement parser.make_type_arrow already gives a hand-written `a -> b -> C !{IO}`,
# so a declared and a written signature produce the same type. It is also the only
# placement consistent with §5.3, where a call is always saturated and never a
# partial application — every arrow is consumed at once, so an outer-arrow effect
# would describe an application that cannot be written.
#
# A ZERO-parameter function has no arrow to carry anything, which is why the
# declared effect also stays on the Scheme: `fn main() -> Unit !{IO}` types as
# plain `Unit`, and Scheme's effect field is the only place its !{IO} can live.
# types.scheme_to_string knows this and prints whichever one is load-bearing.
fn build_fn_type_modes(params: List types.Type, modes: List ast.ParamMode, ret: types.Type,
                       eff: types.Effect) -> types.Type =
  match params with
  | Nil -> ret
  | Cons p rest ->
      types.TFunc(p, build_fn_type_modes(rest, mode_list_tail(modes), ret, eff),
        arrow_effect_at(rest, eff), own_of_mode(mode_list_head(modes)))

# The effect belongs to the last arrow only; every earlier one is a pure step
# toward it.
fn arrow_effect_at(rest: List types.Type, eff: types.Effect) -> types.Effect =
  match rest with
  | Nil -> eff
  | _ -> types.EffectPure

fn own_of_mode(m: ast.ParamMode) -> types.Ownership =
  linear_check.ownership_of_param_mode(m)

fn mode_list_head(modes: List ast.ParamMode) -> ast.ParamMode =
  match modes with
  | [] -> ast.ModeDefault
  | [m | _] -> m

fn mode_list_tail(modes: List ast.ParamMode) -> List ast.ParamMode =
  match modes with
  | Nil -> Nil
  | Cons _ rest -> rest

export fn param_modes(params: List ast.Param) -> List ast.ParamMode =
  match params with
  | Nil -> Nil
  | Cons p rest -> Cons(ast.param_mode_of(p), param_modes(rest))

# CALL side (M4.6): the arrow synthesized from the argument types, to unify
# against the callee. Its ownership must be COPIED from the callee's own spine —
# a fixed OwnConsume here would make every call to a borrowing function a
# mismatch, and invariant unification would then reject the feature's own tests.
# When the callee type is not (yet) an arrow — an unannotated higher-order
# parameter, say — there is nothing to copy and OwnConsume is the conservative
# reading: the tyvar binds to a consuming arrow, so a caller later supplying a
# borrowing function gets a mismatch at ITS call site rather than a silent leak.
fn build_fn_type_like(params: List types.Type, template: types.Type, ret: types.Type) -> types.Type =
  match params with
  | Nil -> ret
  | Cons p rest ->
      types.TFunc(p, build_fn_type_like(rest, template_ret(template), ret),
        template_eff(template), template_own(template))

fn template_own(t: types.Type) -> types.Ownership =
  match t with
  | types.TFunc _ _ _ own -> own
  | _ -> types.OwnConsume

# Inherit the arrow's effect from the callee, exactly as template_own inherits
# its ownership, and for the same reason: this function builds "the callee's type
# as this call site sees it", and the call site knows the argument and result
# types but nothing whatsoever about the effect.
#
# This slot was `EffectPure` while arrow effects were ignored by unification.
# Once they are not, a hardcoded Pure is an assertion the call site is in no
# position to make: unifying `list_each`'s innermost `!{e}` against it would bind
# e := Pure and manufacture a pure reading for a call that may well do IO. Note
# it would not be caught by the obvious test — `unify_tfunc` unifies the
# PARAMETER before the return, so an IO argument binds e first and the bogus
# (IO, Pure) meeting is then absorbed by the conservative arm. The bug would only
# appear for a callee whose effect variable is not also reachable from a
# parameter, which is the case no canary would have covered.
fn template_eff(t: types.Type) -> types.Effect =
  match t with
  | types.TFunc _ _ eff _ -> eff
  | _ -> types.EffectPure

fn template_ret(t: types.Type) -> types.Type =
  match t with
  | types.TFunc _ ret _ _ -> ret
  | _ -> t

# ---------------------------------------------------------------------------
# Constructor registration
# ---------------------------------------------------------------------------

export fn register_type_decl(decl: ast.Decl, env: GlobalEnv) -> GlobalEnv =
  GlobalEnv(register_type_decl_raw(decl, global_env_dict(env)))

# Raw variant operating on Dict, used internally where the env is still
# unwrapped (e.g. inside check_fn_body for body-scope auxiliaries).
fn register_type_decl_raw(decl: ast.Decl, env: Dict types.Scheme) -> Dict types.Scheme =
  match decl with
  | ast.TypeDecl name params ctors _ mult _ ->
      mark_type_multiplicity(name, mult,
        register_ctors_for_type(name, params, build_local_params(params, dict_empty()), ctors, env))
  # WrapDecl: synthesize a single-constructor type with the same name as the
  # wrap. The constructor's argument type is the wrap's inner type. This gives
  # the typechecker a scheme `inner -> Foo` for Foo(x), and a destructor entry
  # for `match | Foo x ->`.  Zero type parameters by design (the inner type
  # may itself be polymorphic, but Foo always has the same representation).
  | ast.WrapDecl name inner _ ->
      register_ctors_for_type(name, Nil, dict_empty(),
        [ast.TypeConstructor(name, [inner], Nil, Nil)], env)
  | _ -> env

fn build_local_params(params: List String, acc: Dict types.Type) -> Dict types.Type =
  match params with
  | Nil -> acc
  | Cons p rest -> build_local_params(rest, dict_set(p, types.TVar(types.tyvar_id(p)), acc))

fn build_result_type(name: String, params: List String) -> types.Type =
  apply_type_params(types.TConst(types.type_id(name)), params)

fn apply_type_params(base: types.Type, params: List String) -> types.Type =
  match params with
  | Nil -> base
  | Cons p rest -> apply_type_params(types.TApp(base, types.TVar(types.tyvar_id(p))), rest)

fn register_ctors_for_type(
  type_name: String,
  type_params: List String,
  local_vars: Dict types.Type,
  ctors: List ast.TypeConstructor,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  match ctors with
  | Nil -> env
  | Cons ctor rest ->
      register_ctors_for_type(
        type_name, type_params, local_vars, rest,
        register_one_ctor(ctor, type_params, local_vars, build_result_type(type_name, type_params), env)
      )

fn register_one_ctor(
  ctor: ast.TypeConstructor,
  type_params: List String,
  local_vars: Dict types.Type,
  result_type: types.Type,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  match ctor with
  # exist_vars: existentially-bound vars (docs/gadts-v0.md §6). They are quantified
  # in the scheme (so each use instantiates them fresh) and resolvable in the field
  # types (local_vars), but ABSENT from result_type (built from type_params only) —
  # which is exactly what makes `Boxed(x)` hide x's type. On the pattern (unpack)
  # path they are re-instantiated to rigid skolems; see instantiate_ctor_pattern.
  #
  # exist_constraints (Stage 0b): a constrained existential like `Shown (any
  # ToString)` records `ToString existv0` here. Threading them into the scheme's
  # constraint field (as (head_token, class) pairs keyed by the exist var name)
  # routes construction through the SAME §13.3(B) dict-injection path a `where C a`
  # function uses: `constrained_fn_field(name)` reads these back, so `Shown(42)`
  # requires `ToString Int`, resolves the witness, and rejects a missing instance
  # at the construction site — no constructor-specific obligation code needed.
  | ast.TypeConstructor name fields exist_vars exist_constraints ->
      dict_set(
        name,
        types.scheme_quantified(
          list_append(type_params, exist_vars),
          ctor_fn_type(fields, build_local_params(exist_vars, local_vars), result_type),
          types.EffectPure,
          exist_constraint_pairs(exist_constraints)
        ),
        env
      )

# Convert a constructor's existential constraints to the scheme constraint field's
# (head_token, class) shape. The head_token is the exist var's own name: a ctor
# scheme registers `exist_vars` verbatim as its scheme binders (no generalize
# renaming), so instantiate_with_vars keys prog_to_fresh by that exact name and
# resolve_obligation's precise lookup hits. Mirrors the concrete-ctor-head case of
# canonicalize_constrained_constraints (a stable source name, not a #pos token).
fn exist_constraint_pairs(cs: List ast.TypeConstraint) -> List (String, String) =
  match cs with
  | Nil -> Nil
  | Cons c rest ->
      match c with
      | ast.TypeConstraint class_name [ast.TypeName v | _] ->
          Cons((v, class_name), exist_constraint_pairs(rest))
      | ast.TypeConstraint class_name _ ->
          Cons(("#none", class_name), exist_constraint_pairs(rest))

fn ctor_fn_type(fields: List ast.TypeExpr, local_vars: Dict types.Type, result: types.Type) -> types.Type =
  match fields with
  | Nil -> result
  | Cons f rest ->
      types.TFunc(type_from_ast(f, local_vars), ctor_fn_type(rest, local_vars, result),
        types.EffectPure, types.OwnConsume)

fn build_ctor_map(decls: List ast.Decl, acc: Dict (List String)) -> Dict (List String) =
  match decls with
  | Nil -> acc
  | Cons decl rest ->
      match decl with
      # Key by the bare type name: scrutinee types resolve to bare names via
      # lookup_type_var (TConst(after_last_dot(...))), so the ctor map must agree
      # or lookups for own-module ADTs (keyed `main.C`, looked up as `C`) miss.
      | ast.TypeDecl name _ ctors _ _ _ ->
          build_ctor_map(rest, dict_set(name, collect_ctor_names(ctors, Nil), acc))
      # WrapDecl: a single synthetic constructor with the same name as the type.
      | ast.WrapDecl name _ _ ->
          build_ctor_map(rest, dict_set(name, Cons(name, Nil), acc))
      | _ -> build_ctor_map(rest, acc)

fn collect_ctor_names(ctors: List ast.TypeConstructor, acc: List String) -> List String =
  match ctors with
  | Nil -> acc
  | Cons ctor rest ->
      match ctor with
      | ast.TypeConstructor name _ _ _ -> collect_ctor_names(rest, Cons(name, acc))

# ---------------------------------------------------------------------------
# Effect merging
# ---------------------------------------------------------------------------

# The effect of doing `a` and then `b`. IO absorbs everything; purity is the
# identity. Two DIFFERENT variables cannot be reduced to one — a body that calls
# an `!{e}` callee and an `!{f}` callee performs both — so they merge into a row.
#
# That last case used to fall through to `| _ -> a`, silently dropping `b`
# (BACKLOG "merge_effects drops one variable side"). It was unreachable while
# every callee reported pure; wiring the callee effect through infer_call_var
# makes it live, so it is fixed here rather than left as a known-wrong input to
# the numbers this report produces.
fn merge_effects(a: types.Effect, b: types.Effect) -> types.Effect =
  match (a, b) with
  | (types.EffectIO, _) -> types.EffectIO
  | (_, types.EffectIO) -> types.EffectIO
  | (types.EffectPure, other) -> other
  | (other, types.EffectPure) -> other
  | _ -> merge_effect_labels(a, b)

fn merge_effect_labels(a: types.Effect, b: types.Effect) -> types.Effect =
  match list_union_labels(effect_labels(a), effect_labels(b)) with
  | [only] -> types.EffectVar(only)
  | labels -> types.EffectRow(labels)

fn effect_labels(e: types.Effect) -> List String =
  match e with
  | types.EffectVar name -> [name]
  | types.EffectRow labels -> labels
  # Pure and IO are both handled by merge_effects before reaching here.
  | _ -> Nil

fn list_union_labels(xs: List String, ys: List String) -> List String =
  match ys with
  | Nil -> xs
  | Cons y rest ->
      if list_member(y, xs)
      then list_union_labels(xs, rest)
      else list_union_labels(list_append_label(xs, y), rest)

fn list_append_label(xs: List String, y: String) -> List String =
  match xs with
  | Nil -> [y]
  | Cons h t -> Cons(h, list_append_label(t, y))

# ---------------------------------------------------------------------------
# List helpers (type-specific reverse functions)
# ---------------------------------------------------------------------------

fn list_reverse(xs: List types.Type) -> List types.Type =
  list_rev_acc(xs, Nil)

fn list_rev_acc(xs: List types.Type, acc: List types.Type) -> List types.Type =
  match xs with
  | Nil -> acc
  | Cons h t -> list_rev_acc(t, Cons(h, acc))

fn typed_expr_list_reverse(xs: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  typed_expr_rev_acc(xs, Nil)

fn typed_expr_rev_acc(xs: List typed_ast.TypedExpr, acc: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  match xs with
  | Nil -> acc
  | Cons h t -> typed_expr_rev_acc(t, Cons(h, acc))

fn typed_branch_list_reverse(xs: List typed_ast.TypedMatchBranch) -> List typed_ast.TypedMatchBranch =
  typed_branch_rev_acc(xs, Nil)

fn typed_branch_rev_acc(xs: List typed_ast.TypedMatchBranch, acc: List typed_ast.TypedMatchBranch) -> List typed_ast.TypedMatchBranch =
  match xs with
  | Nil -> acc
  | Cons h t -> typed_branch_rev_acc(t, Cons(h, acc))

fn typed_do_step_list_reverse(xs: List typed_ast.TypedDoStep) -> List typed_ast.TypedDoStep =
  typed_do_step_rev_acc(xs, Nil)

fn typed_do_step_rev_acc(xs: List typed_ast.TypedDoStep, acc: List typed_ast.TypedDoStep) -> List typed_ast.TypedDoStep =
  match xs with
  | Nil -> acc
  | Cons h t -> typed_do_step_rev_acc(t, Cons(h, acc))

fn typed_record_field_list_reverse(xs: List typed_ast.TypedRecordField) -> List typed_ast.TypedRecordField =
  typed_record_field_rev_acc(xs, Nil)

fn typed_record_field_rev_acc(xs: List typed_ast.TypedRecordField, acc: List typed_ast.TypedRecordField) -> List typed_ast.TypedRecordField =
  match xs with
  | Nil -> acc
  | Cons h t -> typed_record_field_rev_acc(t, Cons(h, acc))

fn typed_method_list_reverse(xs: List typed_ast.TypedInstanceMethod) -> List typed_ast.TypedInstanceMethod =
  typed_method_rev_acc(xs, Nil)

fn typed_method_rev_acc(xs: List typed_ast.TypedInstanceMethod, acc: List typed_ast.TypedInstanceMethod) -> List typed_ast.TypedInstanceMethod =
  match xs with
  | Nil -> acc
  | Cons h t -> typed_method_rev_acc(t, Cons(h, acc))

# The positionless sentinel. Use ONLY where no source position exists — a
# compiler-synthesized node, or a whole-file/IO error with no single span. Never
# as a shortcut at an error site where a real position is already in scope
# (that is the guideline-#5 regression this campaign fixes).
fn no_pos() -> source.SourcePos = source.SourcePos(index = 0, line = 0, column = 0)

fn dummy_unit() -> typed_ast.TypedExpr =
  typed_ast.TUnit(types.TConst(types.type_id("Unit")), no_pos())

# ---------------------------------------------------------------------------
# Expression inference
# ---------------------------------------------------------------------------

fn infer_expr(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expr: ast.Expr
) -> InferResult !{IO} =
  match expr with
  | ast.IntExpr v pos -> InferOk(typed_ast.TInt(v, types.type_int(), pos), subst, eff_subst, types.EffectPure)
  | ast.FloatExpr text pos -> InferOk(typed_ast.TFloat(text, types.type_double(), pos), subst, eff_subst, types.EffectPure)
  | ast.BoolExpr v pos -> InferOk(typed_ast.TBool(v, types.type_bool(), pos), subst, eff_subst, types.EffectPure)
  | ast.StringExpr v pos -> InferOk(typed_ast.TString(v, types.type_string(), pos), subst, eff_subst, types.EffectPure)
  | ast.CharExpr v pos -> InferOk(typed_ast.TChar(v, types.type_char(), pos), subst, eff_subst, types.EffectPure)
  | ast.UnitExpr pos -> InferOk(typed_ast.TUnit(types.TConst(types.type_id("Unit")), pos), subst, eff_subst, types.EffectPure)
  | ast.VarExpr name pos -> infer_var_or_field(state, env, subst, eff_subst, name, pos)
  | ast.IfExpr cond then_ else_ pos -> infer_if(state, env, subst, eff_subst, cond, then_, else_, pos)
  | ast.CallExpr callee args pos -> infer_call(state, env, subst, eff_subst, callee, args, pos)
  | ast.MatchExpr scrut branches pos -> infer_match(state, env, subst, eff_subst, scrut, branches, pos)
  | ast.TupleExpr elems pos -> infer_tuple(state, env, subst, eff_subst, elems, pos)
  | ast.BinaryExpr op left right pos -> infer_binary(state, env, subst, eff_subst, op, left, right, pos)
  | ast.UnaryExpr op operand pos -> infer_unary(state, env, subst, eff_subst, op, operand, pos)
  | ast.DoExpr steps pos -> infer_do(state, env, subst, eff_subst, steps, pos)
  | ast.LambdaExpr params body pos -> infer_lambda(state, env, subst, eff_subst, params, body, pos)
  | ast.RecordExpr type_name fields pos ->
      infer_record_expr(state, env, subst, eff_subst, type_name, fields, pos)
  | ast.GetFieldExpr rec_expr field_name pos ->
      infer_get_field(state, env, subst, eff_subst, rec_expr, field_name, pos)
  | ast.RecordUpdateExpr base fields pos ->
      infer_record_update(state, env, subst, eff_subst, base, fields, pos)
  | ast.IntRangeExpr lo hi pos -> infer_range(state, env, subst, eff_subst, lo, hi, pos)
  | ast.StringTemplateExpr _ pos ->
      InferErr(pos, "Internal error: StringTemplateExpr reached inference; desugar pass should have eliminated it")
  | ast.ComprehensionExpr elem gens pos ->
      infer_comprehension(state, env, subst, eff_subst, elem, gens, pos)

# Declaration-boundary wrapper: applies s1 to the result so fresh TVars
# never escape into lowering.  Declaration-level callers should use this;
# sub-expression recursion stays on infer_expr.
#
# Field obligations parked by get_field_from_resolved are NOT settled here.
# The body's own substitution is not the declaration's last word: a declared
# return type (`fn f(p) -> P = if p.ready then p else p`) or a `let`
# annotation can be the only thing that determines a receiver, and both unify
# AFTER this returns. Settling here reported "nothing in this declaration
# determines what the value being read is" about a declaration that does — and
# told the user to annotate the parameter, the one annotation that would not
# have helped. Each declaration-level caller therefore settles them itself, via
# finish_field_obligations, once its own unification has run.
#
# On the ERROR path they are dropped here, so a failed body cannot leave
# obligations parked for the next declaration to trip over.
export fn typecheck_expr(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expr: ast.Expr
) -> InferResult !{IO} =
  do
    r <- infer_expr(state, env, subst, eff_subst, expr)
    match r with
    | InferErr _ _ ->
        do
          _ <- unifier.take_field_obligations(state)
          r
    | InferOk _ _ _ _ -> r

# Settle this declaration's parked field accesses against its FINAL
# substitution, then re-apply so the repaired types reach lowering. Every
# declaration-level caller of typecheck_expr must call this after its own
# unification step — obligations left parked would otherwise be settled against
# the next declaration's environment.
fn finish_field_obligations(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  typed_expr: typed_ast.TypedExpr
) -> FinishResult !{IO} =
  do
    pending <- unifier.take_field_obligations(state)
    d <- discharge_field_obligations(state, env, subst, pending)
    match d with
    | DischargeErr dpos dmsg -> FinishErr(dpos, dmsg)
    | DischargeOk s2 -> FinishOk(apply_subst_typed_expr(s2, typed_expr), s2)

type FinishResult =
  | FinishOk typed_ast.TypedExpr (Dict types.Type)
  | FinishErr source.SourcePos String

# --- Deferred field obligations ---

type DischargeResult =
  | DischargeOk (Dict types.Type)
  | DischargeErr source.SourcePos String

# One obligation's outcome. `OneBlocked` is explicit rather than inferred from
# "the substitution did not grow": a settled obligation whose result variable
# was already bound to the right type grows nothing either, and treating that
# as blocked would report a spurious error on the round that follows.
type OneResult =
  | OneSettled (Dict types.Type)
  | OneBlocked
  | OneFailed source.SourcePos String

# Settle every field access that could not be typed where it was written.
#
# One round resolves each receiver through the current substitution and, for
# those that are now record types, unifies the real field type into the
# variable the access was given. A resolution can itself unblock another
# receiver (`let i = o.inner in i.n`, where `.n`'s receiver is `.inner`'s
# result), so rounds repeat while any progress is made. When a round settles
# nothing, the remaining receivers are undetermined for good: Sprout has no row
# polymorphism, so a field name alone names no type and the access has no
# principal typing. That is an error, not a fresh variable — a fresh variable
# is what let the access be read at ANY type while lowering emitted a real
# offset load.
# Restores source order, so a declaration with several undetermined receivers
# reports the FIRST one. Not `list_reverse`: this module shadows the prelude's
# polymorphic one with a `List types.Type` definition (`:517`).
fn reverse_obligations(
  xs: List unifier.FieldObligation,
  acc: List unifier.FieldObligation
) -> List unifier.FieldObligation =
  match xs with
  | Nil -> acc
  | Cons h t -> reverse_obligations(t, Cons(h, acc))

fn discharge_field_obligations(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  pending: List unifier.FieldObligation
) -> DischargeResult !{IO} =
  match pending with
  | Nil -> DischargeOk(subst)
  | [_ | _] -> discharge_round(state, env, subst, pending, Nil, false)

fn discharge_round(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  pending: List unifier.FieldObligation,
  blocked: List unifier.FieldObligation,
  progressed: Bool
) -> DischargeResult !{IO} =
  match pending with
  | Nil ->
      discharge_next_round(state, env, subst, reverse_obligations(blocked, Nil), progressed)
  | Cons o rest ->
      do
        r <- discharge_one(state, env, subst, o)
        match r with
        | OneFailed dpos dmsg -> DischargeErr(dpos, dmsg)
        | OneBlocked -> discharge_round(state, env, subst, rest, Cons(o, blocked), progressed)
        | OneSettled s2 -> discharge_round(state, env, s2, rest, blocked, true)

# A single obligation. The receiver is re-resolved through the CURRENT
# substitution, not the one in force when the access was inferred.
#
# A lookup miss is an ERROR, not a pass. Leaving it alone was the original
# defect: the miss happens when the receiver resolved to a type without that
# field — a non-record like `Int`, or a record lacking it — and dropping the
# obligation leaves its result variable FREE for generalization to quantify.
# That regenerates the `forall a. _ -> a` coercion this whole pass exists to
# remove. `ast_to_ir` does catch it, but only at lowering, so every check-only
# path (`--phase check`, the LSP, sproutd) accepted the unsound scheme.
fn discharge_one(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  o: unifier.FieldObligation
) -> OneResult !{IO} =
  let resolved = unifier.apply_subst(subst, unifier.field_obligation_receiver(o))
  in
    match resolved with
    | types.TConst rec_name ->
        discharge_against_record(state, env, subst, o, types.type_id_name(rec_name), Nil)
    | types.TApp _ _ ->
        discharge_against_record(state, env, subst, o,
          extract_tconst_name(resolved), extract_tapp_args(resolved))
    | _ -> OneBlocked

fn discharge_against_record(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  o: unifier.FieldObligation,
  rec_name: String,
  type_args: List types.Type
) -> OneResult !{IO} =
  let field_name = unifier.field_obligation_field(o)
  in
    let Just field_scheme = dict_get("@rec:" ++ rec_name ++ ":" ++ field_name, env)
          else OneFailed(unifier.field_obligation_pos(o),
                 "Unknown record type or field: " ++ rec_name ++ "." ++ field_name)
    in
      do
        field_t <- record_field_access_type(state, field_scheme, type_args)
        # no_effect_subst: OneResult carries only a type substitution, and the
        # deferred-obligation chain above it is six functions deep.
        match unifier.unify_types(subst, unifier.no_effect_subst(),
                unifier.field_obligation_result(o), field_t) with
        | unifier.UnifyErr e ->
            OneFailed(unifier.field_obligation_pos(o),
              "Record field type mismatch reading `." ++ field_name ++ "`: " ++ e)
        | unifier.UnifyOk s2 _ -> OneSettled(s2)

fn discharge_next_round(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  blocked: List unifier.FieldObligation,
  progressed: Bool
) -> DischargeResult !{IO} =
  match blocked with
  | Nil -> DischargeOk(subst)
  | [o | _] ->
      if progressed
      then discharge_round(state, env, subst, blocked, Nil, false)
      else DischargeErr(unifier.field_obligation_pos(o), unknown_receiver_msg(unifier.field_obligation_field(o)))

fn unknown_receiver_msg(field_name: String) -> String =
  "Cannot infer the record type of `." ++ field_name
    ++ "` — nothing in this declaration determines what the value being read is."
    ++ " Annotate the parameter or binding"

# --- Variable ---

# A value-position reference to a class method (`@class:{name}` marker present)
# becomes a TMethodRef carrying the class name, so lowering can eta-expand it
# against the final substituted type and fill its dictionary from Evidence.
# Callee-position methods never reach here — infer_call_var builds their TVar
# directly.  Detection precision is not load-bearing yet: both the TVar and
# TMethodRef lowering arms run the same eta reconstruction until M3b-4b.
fn value_var_node(name: String, t: types.Type, pos: source.SourcePos, env: Dict types.Scheme) -> typed_ast.TypedExpr =
  match dict_get("@class:" ++ name, env) with
  | Nothing -> typed_ast.TVar(name, t, pos)
  | Just marker ->
      match marker with
      | types.Scheme _ _ class_type _ _ ->
          match class_type with
          | types.TConst class_name ->
              typed_ast.TMethodRef(name, types.type_id_name(class_name), t, pos, typed_ast.EvUnresolved)
          | _ -> typed_ast.TVar(name, t, pos)

# A value-position reference to a user `fn` carrying its own `where` clause, rewritten into the
# eta-lambda the programmer could have written by hand: `label` becomes `\__eta_x0 -> label(__eta_x0)`.
#
# Constrained functions take one hidden parameter per method of each constraint's class (plus its
# transitive superclasses), appended after the user-visible ones. A CALL supplies those — infer
# prepends TDict evidence here, resolve fills it, lowering appends the witnesses — so the arity works
# out. A bare mention has no call to hang that evidence on, so it used to lower to a plain TVar whose
# emitted arity still counted the hidden slots while its type advertised only the visible ones. The
# result linked and died at run time on an arity check, with nothing for the type checker to catch.
#
# Wrapping the mention in a lambda turns it back into a call, which is the one shape all three passes
# already handle. Nothing here resolves a dictionary: that stays resolve's job (lowering.sprout §M3b-5),
# and the tyvar-headed case a `where`-constrained caller needs forwards for free.
#
# Class methods are excluded — the `@class:` marker routes them to TMethodRef, which lowering
# eta-expands from Evidence. Zero-arity functions are excluded too: there is no lambda to build, and
# `\-> make()` is not a shape the language has.
fn constrained_fn_eta(name: String, scheme: types.Scheme, pos: source.SourcePos, env: Dict types.Scheme) -> Maybe ast.Expr =
  match dict_get("@class:" ++ name, env) with
  | Just _ -> Nothing
  | Nothing ->
      match types.scheme_constraints(scheme) with
      | [] -> Nothing
      | [_ | _] -> constrained_fn_eta_lambda(name, pos, env)

# Arity comes from the DECLARED parameter count, not from counting arrows in the type: a zero-parameter
# function returning a function has the same `a -> b` scheme as a one-parameter function, so the type
# cannot tell them apart (the reason fn_declared_arity exists — see call_arity_error_for). A local
# binding that shadows a top-level function drops the marker in bind_local_scheme, so a shadowed name
# returns Nothing here and keeps today's behaviour.
fn constrained_fn_eta_lambda(name: String, pos: source.SourcePos, env: Dict types.Scheme) -> Maybe ast.Expr =
  let Just arity = fn_declared_arity(name, env) else Nothing
  in if arity == 0 then Nothing
     else Just(ast.LambdaExpr(
       eta_fn_params(arity, 0),
       ast.CallExpr(ast.VarExpr(name, pos), eta_fn_args(arity, 0, pos), pos),
       pos))

fn eta_fn_param_name(i: Int) -> String = "__eta_x" ++ int_to_string(i)

fn eta_fn_params(n: Int, i: Int) -> List ast.Param =
  if i >= n then Nil
  else Cons(ast.Param(eta_fn_param_name(i), Nothing, ast.ModeDefault), eta_fn_params(n, i + 1))

fn eta_fn_args(n: Int, i: Int, pos: source.SourcePos) -> List ast.Expr =
  if i >= n then Nil
  else Cons(ast.VarExpr(eta_fn_param_name(i), pos), eta_fn_args(n, i + 1, pos))

# Dot-access resolution rule (docs/records-v0.md §4.3, Scope A variable chains).
# A dotted name `p.x` lexes as a single identifier, ambiguous between record
# field access and module qualification (`stdlib.string.foo`).  Values and
# modules occupy separate namespaces: split on the first `.` and check the head.
# HEAD-FIRST so a local binding wins over any same-named module qualifier — if
# the head is an in-scope value, the whole name is a field-access chain on it;
# otherwise fall through to a plain (possibly module-qualified) lookup.  Field
# access is total, so a wrong field surfaces as a type error downstream, not here.
fn infer_var_or_field(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  name: String,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match string.split_once(name, ".") with
  | Nothing -> infer_var(state, env, subst, eff_subst, name, pos)
  | Just (head, rest) ->
      match dict_get(head, env) with
      | Nothing -> infer_var(state, env, subst, eff_subst, name, pos)
      | Just _ ->
          infer_expr(state, env, subst, eff_subst,
                     build_field_chain(ast.VarExpr(head, pos), rest, pos))

# Fold a dotted remainder `from.x` into nested GetFieldExpr on `base`.
fn build_field_chain(base: ast.Expr, rest: String, pos: source.SourcePos) -> ast.Expr =
  match string.split_once(rest, ".") with
  | Nothing -> ast.GetFieldExpr(base, rest, pos)
  | Just (field, more) -> build_field_chain(ast.GetFieldExpr(base, field, pos), more, pos)

fn infer_var(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  name: String,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match dict_get(name, env) with
  | Nothing -> InferErr(pos, "Unknown variable: " ++ name)
  | Just scheme ->
      match constrained_fn_eta(name, scheme, pos, env) with
      # Re-enter inference on the synthesized lambda, the same way the dotted-name case above
      # re-enters on a field chain.  The call inside it is an ordinary call, so it routes through
      # infer_call_var rather than back to here — the rewrite cannot recur.
      | Just expanded -> infer_expr(state, env, subst, eff_subst, expanded)
      | Nothing ->
          do
            t <- unifier.instantiate(state, scheme)
            InferOk(value_var_node(name, t, pos, env), subst, eff_subst, types.EffectPure)

# --- If ---

fn infer_if(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  cond: ast.Expr,
  then_: ast.Expr,
  else_: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    cr <- infer_expr(state, env, subst, eff_subst, cond)
    match cr with
    | InferErr pos e -> InferErr(pos, e)
    | InferOk typed_cond s1 es1 cond_eff ->
        infer_if_checked(state, env, s1, es1, typed_cond, cond_eff, then_, else_, pos)

fn infer_if_checked(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  typed_cond: typed_ast.TypedExpr,
  cond_eff: types.Effect,
  then_: ast.Expr,
  else_: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match unifier.unify_types(subst, eff_subst, typed_ast.typed_expr_type(typed_cond), types.type_bool()) with
  | unifier.UnifyErr e -> InferErr(pos, "If condition must be Bool: " ++ e)
  | unifier.UnifyOk s2 es2 ->
      do
        tr <- infer_expr(state, env, s2, es2, then_)
        match tr with
        | InferErr pos e -> InferErr(pos, e)
        | InferOk typed_then s3 es3 then_eff ->
            do
              er <- infer_expr(state, env, s3, es3, else_)
              match er with
              | InferErr pos e -> InferErr(pos, e)
              | InferOk typed_else s4 es4 else_eff ->
                  infer_if_merge(s4, es4, typed_cond, typed_then, typed_else,
                                 cond_eff, then_eff, else_eff, pos)

fn infer_if_merge(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  typed_cond: typed_ast.TypedExpr,
  typed_then: typed_ast.TypedExpr,
  typed_else: typed_ast.TypedExpr,
  cond_eff: types.Effect,
  then_eff: types.Effect,
  else_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match unifier.unify_types(subst, eff_subst, typed_ast.typed_expr_type(typed_then), typed_ast.typed_expr_type(typed_else)) with
  | unifier.UnifyErr e -> InferErr(pos, "If branches must have same type: " ++ e)
  | unifier.UnifyOk s5 es5 ->
      InferOk(
        typed_ast.TIf(typed_cond, typed_then, typed_else,
                      unifier.apply_subst(s5, typed_ast.typed_expr_type(typed_then)), pos),
        s5, es5,
        unifier.apply_effect_subst(es5,
          merge_effects(cond_eff, merge_effects(then_eff, else_eff)))
      )

# --- Call ---

# True for tuple types `(a, b, …)`.  Used to route `print` of a tuple through
# its `ToString` instance (see infer_print_call).
fn is_tuple_type(t: types.Type) -> Bool =
  match t with
  | types.TTuple _ -> true
  | _ -> false

fn infer_call(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  callee: ast.Expr,
  args: List ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match callee with
  | ast.VarExpr name cpos ->
      if name == "print" then
        infer_print_call(state, env, subst, eff_subst, callee, cpos, args, pos)
      else
        # A statically-empty range_up/range_down, rejected before the call is
        # otherwise inferred.  Same rule as the `a..b` literal form; see
        # reversed_literal_range.  Fires only on a name that RESOLVES to a range
        # constructor with two literal bounds, so it costs one arity check on
        # every other call.
        match reversed_literal_range_call(name, env, args) with
        | Just message -> InferErr(pos, message)
        | Nothing ->
            # `v.render(x)` — a call whose callee is a record field access on an
            # in-scope value, not a bare/module-qualified function name. Rewrite the
            # dotted callee to a GetFieldExpr chain and infer it as a general (higher-
            # order) callee, mirroring infer_var_or_field's head-first dot rule (a local
            # value wins over a same-named module). A module-qualified callee (head not
            # in scope) falls through to infer_call_var unchanged.
            match dotted_field_callee(name, env, cpos) with
            | Just field_callee -> infer_call_general(state, env, subst, eff_subst, field_callee, args, pos)
            | Nothing -> infer_call_var(state, env, subst, eff_subst, callee, name, cpos, args, pos)
  | _ -> infer_call_general(state, env, subst, eff_subst, callee, args, pos)

# If `name` is a dotted access whose head is an in-scope value (not a module),
# return the GetFieldExpr chain for it; else Nothing (a plain or module-qualified
# call). Same head-first, value-wins rule as infer_var_or_field.
fn dotted_field_callee(name: String, env: Dict types.Scheme, pos: source.SourcePos) -> Maybe ast.Expr =
  match string.split_once(name, ".") with
  | Nothing -> Nothing
  | Just (head, rest) ->
      match dict_get(head, env) with
      | Nothing -> Nothing
      | Just _ -> Just(build_field_chain(ast.VarExpr(head, pos), rest, pos))

# Infer a call whose callee is an arbitrary expression (not a bare function name):
# infer the callee, then apply the arguments.
fn infer_call_general(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  callee: ast.Expr,
  args: List ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    cr <- infer_expr(state, env, subst, eff_subst, callee)
    match cr with
    | InferErr pos e -> InferErr(pos, e)
    | InferOk typed_callee s1 es1 callee_eff ->
        # Two distinct effects meet here and both belong in the call's effect:
        # evaluating the callee EXPRESSION (`callee_eff` — computing which function
        # to call may itself do IO), and INVOKING the resulting function
        # (`arrows_effect`, read off the callee's own arrows). Only the first was
        # counted. `infer_call_var` has always merged both — `call_effect_of` is its
        # equivalent of the second — so this arm was the asymmetric one.
        #
        # It went unnoticed because a callee that is an expression rather than a
        # name is usually a lambda applied on the spot, and `infer_lambda` used to
        # report the lambda body's effect as the lambda expression's, so the effect
        # arrived through `callee_eff` by accident. Correcting that attribution
        # removes the accident. Canary: `apply_now`.
        infer_call_inner(state, env, s1, es1, callee, typed_callee,
          merge_effects(callee_eff,
            arrows_effect(typed_ast.typed_expr_type(typed_callee), list_length(args))),
          dict_empty(), args, pos)

# Package C-b part 2 (n-ary): a top-level function's declared parameter count is
# stored as an "@arity:{name}" env marker (see pre_scan_fn_decls). A call that
# supplies fewer arguments is under-application — rejected here as a clean arity
# error rather than silently building a partial the curried codegen miscompiles.
# `_`-placeholder partials (spec §5.3) are the n-ary way to partially apply.
fn arity_marker(n: Int) -> types.Scheme =
  types.mono(types.TConst(types.type_id(int_to_string(n))))

# "@extern:<name>" present ⇒ that value is an extern, i.e. ast.ScopeGlobal: bare
# everywhere, never module-qualified, never filtered by an import list. Recorded
# here because this is where an extern's signature enters the env, and read by
# module_loader so the env path spells externs the way the bundler does. Like
# every marker family it rides prefix_pairs/select_pairs unprefixed, which is
# exactly the propagation a global name needs.
fn extern_marker() -> types.Scheme =
  types.mono(types.TConst(types.type_id("extern")))

# Per-declaration linearity is recorded as a sentinel env entry, mirroring the
# @arity: marker idiom above: "@linear:<TypeName>" present ⇒ the type constructor
# was declared `type linear`. Keyed by the type name (a type's head TypeId name),
# so linearity is a lookup, never inferred/unified. M4.1 records it here; use-once
# enforcement is M4.2. See docs/linear-types-m4-scoping-2026-08-01.md.
fn mark_type_multiplicity(name: String, mult: ast.Multiplicity, env: Dict types.Scheme) -> Dict types.Scheme =
  match mult with
  # Also set a single @any_linear gate so a linear-free program skips the whole
  # M4.2 check (and its full-body substitution) cheaply. See linear_check.
  | ast.Linear ->
      dict_set("@any_linear", types.mono(types.TConst(types.type_id("linear"))),
        dict_set("@linear:" ++ name, types.mono(types.TConst(types.type_id("linear"))), env))
  | ast.Unrestricted -> env

# Every type this module declares is recorded as a "@type:<TypeName>" env marker,
# the same sentinel idiom as @linear:/@arity: above. Markers are exported to
# importers verbatim: module_loader's is_marker_key keeps them unprefixed through
# an aliased import and retains them through a SELECTIVE one, so the vocabulary
# travels with the module either way. Read back by type_names_from_env, which
# seeds the strict type-name validation pass on the path where imported modules
# arrive as schemes rather than decls. Names are the short (prefix-stripped) form
# collect_declared_type_names produces, matching how validate_te looks them up.
fn mark_declared_types(names: List String, env: Dict types.Scheme) -> Dict types.Scheme =
  match names with
  | Nil -> env
  | Cons name rest ->
      mark_declared_types(rest,
        dict_set("@type:" ++ name, types.mono(types.TConst(types.type_id(name))), env))

# M4.6 removed the "@parammode:<name>" sentinel that used to live here. Parameter
# ownership is now a field on `types.TFunc` (build_fn_type_modes), so it survives
# instantiation, substitution, generalization and the interface codec, and is
# readable at EVERY callee shape rather than only at a literal top-level name.
# The side table was consultable nowhere else, which silently discharged the
# caller's consume obligation at an indirect call. See docs/linear-borrowing-v0.md §18.

# True when the named type constructor was declared linear (see mark_type_multiplicity).
fn type_name_is_linear(name: String, env: Dict types.Scheme) -> Bool =
  match dict_get("@linear:" ++ name, env) with
  | Just _ -> true
  | Nothing -> false

fn fn_declared_arity(name: String, env: Dict types.Scheme) -> Maybe Int =
  match dict_get("@arity:" ++ name, env) with
  | Nothing -> Nothing
  | Just scheme ->
      match scheme with
      | types.Scheme _ _ body _ _ ->
          match body with
          | types.TConst id -> parse_int(types.type_id_name(id))
          | _ -> Nothing

fn call_arity_error(name: String, got: Int, want: Int) -> String =
  "'" ++ name ++ "' expects " ++ int_to_string(want) ++ " arguments, got "
    ++ int_to_string(got) ++ " (Sprout is n-ary; use `_` for partial application)"

# Too MANY arguments. This runs BEFORE unification, so it covers both callees.
#
# A callee returning a function unified happily and then MISCOMPILED: codegen
# emitted a direct call to the declared-arity symbol carrying the surplus
# arguments, LLVM discarded them, and the call returned the closure handle
# reinterpreted as the result type. A callee returning anything else was already
# rejected, but as "Call type mismatch" once the surplus argument would not
# unify; it now reports the arity, which names the actual mistake.
#
# Sprout is n-ary (docs/currying-and-pipe-decision-v1.md §9a.5), so surplus
# arguments are a SEPARATE application of the returned closure. Hence the
# conditional phrasing below: that advice applies only when the result really is
# a function, and this message is shared with the case where it is not.
fn over_application_error(name: String, got: Int, want: Int) -> String =
  "'" ++ name ++ "' expects " ++ int_to_string(want) ++ " arguments, got "
    ++ int_to_string(got) ++ " — if it returns a function, apply the rest in a"
    ++ " separate call: `" ++ name ++ "(…)(…)`"

# A local binding (parameter, pattern var, do-bind) that reuses a top-level
# function's name shadows it, so it must drop that function's `@arity:{name}`
# marker: the name now refers to a value, whose under-application is a value-level
# partial (Approach A's job, deferred), not a saturation error. Without this the
# name-keyed arity leaks onto the local and rejects a valid partial — e.g.
# `let add3 = \a -> \b -> \c -> ... in add3(1)(2)(3)` — with a spurious
# "'add3' expects 3 arguments" error once inference resolves the local's arrow
# type. See under_application_error and tests/stdlib/test_shadow_underapp_compiles.spr.
# M4.6: no ownership mask to drop alongside it any more — the local's own TYPE
# carries its ownership, so a shadowed function's modes cannot leak onto it.
fn bind_local_scheme(name: String, scheme: types.Scheme, env: Dict types.Scheme) -> Dict types.Scheme =
  dict_set(name, scheme, dict_remove("@arity:" ++ name, env))

# Nothing if the call is saturated or the callee has no declared arity — a
# function-typed value (Approach A's job) or a LOCAL binding shadowing a top-level
# function (bind_local_scheme drops the shadowed `@arity` marker, so
# fn_declared_arity returns Nothing here). Just a clean arity error otherwise,
# rather than silently building a partial the curried codegen miscompiles.
fn call_arity_error_for(name: String, got: Int, env: Dict types.Scheme) -> Maybe String =
  match fn_declared_arity(name, env) with
  | Nothing -> Nothing
  | Just want ->
      if got < want then Just(call_arity_error(name, got, want))
      else if got > want then Just(over_application_error(name, got, want))
      else Nothing

# A zero-parameter function whose declared return type is itself a function has a
# scheme indistinguishable from a one-parameter function's — both are `a -> b`. So
# the no-argument branch of infer_call_resolve cannot tell `mk()` (exact arity)
# from `adder()` (missing its argument) by type alone, and used to reject both.
# The declared parameter count is what separates them.
fn callee_has_zero_declared_arity(callee: ast.Expr, env: Dict types.Scheme) -> Bool =
  match callee with
  | ast.VarExpr name _ ->
      match fn_declared_arity(name, env) with
      | Just want -> want == 0
      | Nothing -> false
  | _ -> false

fn type_is_function(t: types.Type) -> Bool =
  match t with
  | types.TFunc _ _ _ _ -> true
  | _ -> false

# Infer a call whose callee is a bare variable `name` (the common case).
fn infer_call_var(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  callee: ast.Expr,
  name: String,
  cpos: source.SourcePos,
  args: List ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match dict_get(name, env) with
  | Nothing -> InferErr(cpos, "Unknown variable: " ++ name)
  | Just scheme ->
      do
        (t, prog_to_fresh) <- unifier.instantiate_with_vars(state, scheme)
        match call_arity_error_for(name, list_length(args), env) with
        | Just msg -> InferErr(cpos, msg)
        | Nothing ->
            # This slot was a hardcoded `types.EffectPure` until 2026-08-16, and it
            # is the single reason effect inference produced no signal: every named
            # call is routed through here, so every callee looked pure and
            # merge_effects only ever merged pure with pure.
            infer_call_inner(state, env, subst, eff_subst, callee,
              typed_ast.TVar(name, t, cpos), call_effect_of(scheme, t, list_length(args)),
              prog_to_fresh, args, pos)

# The effect a SATURATED call performs: the merge of every arrow the call
# consumes. Calls are always saturated (§5.3 — never a partial application), so
# every arrow goes at once and only their merge is observable. Normally exactly
# one of them is non-pure, since build_fn_type_modes puts the declared effect on
# the innermost arrow; merging rather than indexing keeps this correct for a
# hand-written type that places it somewhere else.
#
# A zero-argument call consumes no arrow, so its effect has to come off the
# Scheme — that is where `fn main() -> Unit !{IO}` keeps its !{IO}, there being
# no arrow in a nullary signature to hold one.
fn call_effect_of(scheme: types.Scheme, t: types.Type, argc: Int) -> types.Effect =
  if argc <= 0 then types.scheme_effects(scheme) else arrows_effect(t, argc)

fn arrows_effect(t: types.Type, argc: Int) -> types.Effect =
  if argc <= 0 then types.EffectPure
  else
    match t with
    | types.TFunc _ ret eff _ -> merge_effects(eff, arrows_effect(ret, argc - 1))
    # Fewer arrows than arguments: an over-application the arity check has
    # already rejected, or a type variable standing in for a callee whose shape
    # is not yet known. Nothing to read either way.
    | _ -> types.EffectPure

# `print` is a type-erased runtime renderer, so it cannot recover per-element
# types of a tuple (a Bool prints as 1, a static-String element as its raw
# pointer).  When the single argument is a tuple, rewrite `print(t)` to
# `print(to_string(t))` so the tuple's `ToString` instance renders each element
# via its own instance.  Inference then resolves the (possibly nested) element
# dictionaries for free.  Non-tuple arguments keep the intrinsic `print` path
# (so `print(Int)`/`print(String)` need no prelude — importless-safe).
#
# The argument is inferred once here only to read its type; that result is
# discarded (InferState accumulates no constraints — evidence lives in the
# returned AST), and the rewritten call re-infers it normally.
fn infer_print_call(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  callee: ast.Expr,
  cpos: source.SourcePos,
  args: List ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match args with
  | [single] ->
      do
        pr <- infer_expr(state, env, subst, eff_subst, single)
        match pr with
        | InferErr _ _ ->
            infer_call_var(state, env, subst, eff_subst, callee, "print", cpos, args, pos)
        | InferOk targ s_peek _ _ ->
            if is_tuple_type(unifier.apply_subst(s_peek, typed_ast.typed_expr_type(targ))) then
              infer_call_var(state, env, subst, eff_subst, callee, "print", cpos,
                [ast.CallExpr(ast.VarExpr("to_string", cpos), [single], pos)], pos)
            else
              infer_call_var(state, env, subst, eff_subst, callee, "print", cpos, args, pos)
  | _ ->
      infer_call_var(state, env, subst, eff_subst, callee, "print", cpos, args, pos)

fn infer_call_inner(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  callee: ast.Expr,
  typed_callee: typed_ast.TypedExpr,
  callee_eff: types.Effect,
  prog_to_fresh: Dict types.Type,
  args: List ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    ar <- infer_call_args(state, env, subst, eff_subst,
            typed_ast.typed_expr_type(typed_callee), args)
    match ar with
    | ArgsErr pos e -> InferErr(pos, e)
    | ArgsOk typed_args s2 es2 args_eff ->
        do
          v <- unifier.fresh(state)
          r <- infer_call_resolve(
            s2, es2,
            typed_ast.typed_expr_type(typed_callee),
            list_map(\e -> typed_ast.typed_expr_type(e), typed_args),
            types.TVar(types.tyvar_id(v)),
            merge_effects(callee_eff, args_eff),
            callee_display_name(callee),
            callee_has_zero_declared_arity(callee, env),
            pos)
          match r with
          | CallErr pos e -> InferErr(pos, e)
          | CallOk ret_t s3 es3 call_eff ->
              check_call_constraint(callee, typed_callee, typed_args, subst, env, ret_t, s3, es3, call_eff, pos, prog_to_fresh)

# A call with no arguments. A function-typed result is only an error when the
# callee is NOT a known zero-parameter function: `mk()` where `fn mk() -> Int ->
# Int` is exact arity and legal, while `adder()` where `fn adder(n: Int) -> …` is
# missing its argument. Both have the same resolved type, so `zero_arity_ok`
# carries the declared parameter count the type cannot express.
fn resolve_zero_arg_call(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  resolved: types.Type,
  ret_type: types.Type,
  eff: types.Effect,
  callee_display: String,
  zero_arity_ok: Bool,
  pos: source.SourcePos
) -> CallResult =
  if type_is_function(resolved) && ! zero_arity_ok
  then CallErr(pos, callee_display ++ " requires arguments but was called with none")
  else
    match unifier.unify_types(subst, eff_subst, resolved, ret_type) with
    | unifier.UnifyErr e -> CallErr(pos, "Call type mismatch: " ++ e)
    | unifier.UnifyOk s3 es3 ->
        CallOk(unifier.apply_subst(s3, ret_type), s3, es3, unifier.apply_effect_subst(es3, eff))

fn callee_display_name(callee: ast.Expr) -> String =
  match callee with
  | ast.VarExpr name _ -> "'" ++ name ++ "'"
  | _ -> "expression"

fn infer_call_resolve(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  callee_type: types.Type,
  arg_types: List types.Type,
  ret_type: types.Type,
  eff: types.Effect,
  callee_display: String,
  zero_arity_ok: Bool,
  pos: source.SourcePos
) -> CallResult !{IO} =
  match arg_types with
  | Nil ->
      resolve_zero_arg_call(subst, eff_subst, unifier.apply_subst(subst, callee_type),
                            ret_type, eff, callee_display, zero_arity_ok, pos)
  | _ ->
      # THE site effect unification exists for. Unifying the callee's declared
      # type against the shape this call demands is what meets a parameter's
      # `!{e}` with the argument's actual arrow effect, so `list_each(print, xs)`
      # binds e := IO here — and `apply_effect_subst` below is what turns that
      # binding into the call's reported effect. Passing `eff` through unresolved
      # (as this did) makes the whole channel a silent no-op.
      match unifier.unify_types(subst, eff_subst, callee_type,
              build_fn_type_like(arg_types, unifier.apply_subst(subst, callee_type), ret_type)) with
      | unifier.UnifyErr e -> CallErr(pos, "Call type mismatch: " ++ e)
      | unifier.UnifyOk s3 es3 ->
          CallOk(unifier.apply_subst(s3, ret_type), s3, es3, unifier.apply_effect_subst(es3, eff))

# --- Constraint checking ---
#
# Class methods are registered under "@class:{method_name}" and instances
# under "@inst:{class_name}:{head_type_str}".  At concrete call sites a
# TDict evidence node is prepended to the argument list.
#
# At polymorphic call sites (first arg is a type variable) the typechecker
# uses forward markers seeded into the env by check_fn_body /
# check_instance_method.  A marker has key "@fwd:{fresh_var}:{class_name}"
# and stores the programmer's type-variable name as TConst in the scheme.
# When the marker is found, a TDict with the programmer-name constraint is
# emitted so the lowering pass can forward the appropriate hidden parameter.

fn check_call_constraint(
  callee: ast.Expr,
  typed_callee: typed_ast.TypedExpr,
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  env: Dict types.Scheme,
  ret_t: types.Type,
  s3: Dict types.Type,
  es3: Dict types.Effect,
  call_eff: types.Effect,
  pos: source.SourcePos,
  prog_to_fresh: Dict types.Type
) -> InferResult !{IO} =
  match callee with
  | ast.VarExpr method_name _ ->
      match dict_get("@class:" ++ method_name, env) with
      | Nothing ->
          # §13.3(B): the callee's Scheme carries the COMPLETE (head_token, class)
          # constraint list — the single source of truth for its hidden dicts.
          # S4 populates it for every constrained binding (generalized external
          # calls, the recursion self-binding, and the pre-scan forward-ref entry),
          # so an empty list means the callee is genuinely unconstrained → no dicts.
          match constrained_fn_field(method_name, env) with
          | Nil ->
              InferOk(typed_ast.TCall(typed_callee, typed_args, ret_t, pos), s3, es3, call_eff)
          | cs ->
              inject_constrained_fn_dicts_via_field(method_name, cs, prog_to_fresh, env, typed_callee, typed_args, subst, ret_t, s3, es3, call_eff, pos)
      | Just class_marker ->
          check_instance_for_marker(class_marker, method_name, typed_callee, typed_args, subst, env, ret_t, s3, es3, call_eff, pos)
  | _ -> InferOk(typed_ast.TCall(typed_callee, typed_args, ret_t, pos), s3, es3, call_eff)

# The callee's Scheme constraint list, or Nil when it has no scheme (unknown /
# non-fn) — the §13.3(B) S3 discriminator between the field and marker paths.
fn constrained_fn_field(name: String, env: Dict types.Scheme) -> List (String, String) =
  match dict_get(name, env) with
  | Just s -> types.scheme_constraints(s)
  | Nothing -> Nil

# Returns true if any class type var appears in any argument of method_type.
# When false, dispatch is by return type — the first-concrete-arg heuristic
# is meaningless (it would pick an irrelevant arg's type) and we must instead
# either resolve from ret_t directly or fall through to @fwd markers.
fn method_dispatch_is_input(method_name: String, class_vars: List String, env: Dict types.Scheme) -> Bool =
  match class_vars with
  | Nil -> true
  | _ ->
      match dict_get(method_name, env) with
      | Nothing -> true
      | Just method_scheme ->
          match method_scheme with
          | types.Scheme _ _ method_type _ _ -> class_var_in_args(method_type, class_vars)

fn check_instance_for_marker(
  class_marker: types.Scheme,
  method_name: String,
  typed_callee: typed_ast.TypedExpr,
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  env: Dict types.Scheme,
  ret_t: types.Type,
  s3: Dict types.Type,
  es3: Dict types.Effect,
  call_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match class_marker with
  | types.Scheme class_vars _ class_type _ _ ->
      match class_type with
      | types.TConst class_name ->
          if method_dispatch_is_input(method_name, class_vars, env) then
            # Input-position dispatch. Select the instance by the class-var
            # PARAMETER POSITION (the arg whose declared type mentions a class
            # variable), not by "first concrete arg" — otherwise a leading
            # concrete arg of an unrelated type (e.g. a String `tag`) hijacks the
            # dict (fundamentals review W4 / probe sr_dispatch). head_str and the
            # TDict TypeExpr are both derived from that one arg so they agree.
            # Resolve the dispatch arg's type with s3 — the substitution AFTER
            # argument inference and callee-param unification — not the stale
            # pre-argument `subst`. An inline parametric-record arg (`Box(val=5)`)
            # has node type `Box $a` whose `$a -> Int` binding lives only in s3;
            # resolving with the stale `subst` leaves it `Box $free`, so the
            # instance's `where` constraint dict is left unresolved (a runtime
            # null-dict crash). Input-position dispatch resolves eagerly here and
            # the post-pass only rewrites return-position calls, so s3 is the last
            # chance to see the concrete type. (ADTs dodge this: a constructor
            # application node is already concretely typed.)
            # No class-var arg found at all: the constraint var is not at the head
            # of any argument (it may be hidden inside a container), so there is no
            # dispatch type to gate on — Nothing keeps the ungated scan.
            let Just cv_arg = class_var_arg_or_fallback(method_name, class_vars, typed_args, s3, env)
                  else check_instance_fwd(types.type_id_name(class_name), typed_callee, typed_args, env, ret_t, s3, es3, call_eff, pos, Nothing)
                # The arg was found but its type is not concrete — that type IS the
                # dispatch type, so the scan can be gated on it.
                Just head_str = concrete_type_str(unifier.apply_subst(s3, typed_ast.typed_expr_type(cv_arg)))
                  else check_instance_fwd(types.type_id_name(class_name), typed_callee, typed_args, env, ret_t, s3, es3, call_eff, pos,
                         Just(unifier.apply_subst(s3, typed_ast.typed_expr_type(cv_arg))))
            in
              if types.is_skolem_name(head_str) then
                # Stage 0b: the dispatch value is an unpacked existential (a rigid
                # skolem, docs/gadts-v0.md §7). Its dictionary is the pattern-provided
                # given, keyed PRECISELY by the skolem name — never a class-only scan,
                # which could grab an ambient same-class dict (a silent miscompile:
                # advisor Crack 1). extend_env_with_existential_givens seeded it.
                resolve_skolem_given(types.type_id_name(class_name), head_str, typed_callee, typed_args, env, ret_t, s3, es3, call_eff, pos)
              else
                let Just _ = dict_get("@inst:" ++ types.type_id_name(class_name) ++ ":" ++ head_str, env)
                      else InferErr(pos, "No instance of " ++ types.type_id_name(class_name) ++ " for " ++ head_str)
                in
                  InferOk(
                    typed_ast.TCall(typed_callee,
                      Cons(typed_ast.TDict(
                        ast.TypeConstraint(types.type_id_name(class_name), Cons(type_to_typeexpr_with_prog_vars(unifier.apply_subst(s3, typed_ast.typed_expr_type(cv_arg)), types.type_id_name(class_name), env), Nil)),
                        types.TConst(class_name), pos, typed_ast.EvUnresolved),
                        typed_args),
                      ret_t, pos),
                    s3, es3, call_eff)
          else
            # Return-position dispatch — first_concrete_typed_arg_str would pick
            # an irrelevant arg type (e.g. the String input of `deserialize`).
            # Route directly to fwd markers; the post-pass walker
            # (resolve_dispatch_typed_expr) rewrites the TDict once the outer
            # unification has made ret_t concrete. The instance is selected by the
            # return type, so that is what gates the fallback scan.
            check_instance_fwd(types.type_id_name(class_name), typed_callee, typed_args, env, ret_t, s3, es3, call_eff, pos, Just(ret_t))
      | _ -> InferOk(typed_ast.TCall(typed_callee, typed_args, ret_t, pos), s3, es3, call_eff)

# Resolve a polymorphic class-method call by scanning args for a @fwd marker.
# First tries direct @fwd:tvar:class lookup for each TVar-headed arg; if none
# match, falls back to scanning env for any @fwd:*:class entry.  This handles
# cases where the constraint's type variable is not the first TVar-headed arg
# (e.g., `fold_values(step: b->a->b, init: b, xs: f a)` — `f` has the @fwd
# marker but `init`'s TVar `b` is found first by the scanner).
#
# `dispatch_t` is the type the instance is selected BY, when the caller knows it:
# the resolved argument type for input-position dispatch, `ret_t` for
# return-position. It gates the class-only fallback scan — see gated_fwd_scan.
# `Nothing` means the caller genuinely has no dispatch type in hand (the
# constraint var is hidden inside a container arg), which is the case the
# ungated scan exists to serve.

fn check_instance_fwd(
  class_name: String,
  typed_callee: typed_ast.TypedExpr,
  typed_args: List typed_ast.TypedExpr,
  env: Dict types.Scheme,
  ret_t: types.Type,
  s3: Dict types.Type,
  es3: Dict types.Effect,
  call_eff: types.Effect,
  pos: source.SourcePos,
  dispatch_t: Maybe types.Type
) -> InferResult =
  match find_fwd_tdict_in_args(class_name, typed_args, env, pos) with
  | Just tdict ->
      InferOk(typed_ast.TCall(typed_callee, Cons(tdict, typed_args), ret_t, pos), s3, es3, call_eff)
  | Nothing ->
      match gated_fwd_scan(class_name, env, s3, pos, dispatch_t) with
      | Just tdict ->
          InferOk(typed_ast.TCall(typed_callee, Cons(tdict, typed_args), ret_t, pos), s3, es3, call_eff)
      | Nothing ->
          # No @fwd marker resolved this class method, so it is not a legitimate
          # polymorphic forward. If a dispatch argument is function-typed, the
          # obligation is `C (a -> b)` — unsatisfiable (no function instance) — so
          # reject rather than emit a dict-less call (`to_string(f)` would lower to an
          # undefined `@to_string`). A genuine tyvar-headed forward found its marker
          # above; only a rigid function head reaches here unresolved.
          if any_function_typed_arg(typed_args, s3)
          then InferErr(pos, "No instance of " ++ class_name ++ " for a function type")
          else InferOk(typed_ast.TCall(typed_callee, typed_args, ret_t, pos), s3, es3, call_eff)

# The class-only fallback scan, gated on the type actually being dispatched.
#
# scan_fwd_markers matches `@fwd:<ANY tvar>:<class>` and returns the first hit in
# dict order, with no check that the marker belongs to the variable under
# dispatch. When the dispatch type is a variable that owns no marker — an
# AMBIGUOUS one, mentioned nowhere the call can see — that unrelated marker is
# adopted anyway, and the call silently borrows a dictionary chosen by dict
# ordering. The observable damage is incoherence, not a missing diagnostic: in
# `fn describe(w: b) -> String where Codec b = to_str(from_int(7))` the closed
# subexpression `to_str(from_int(7))` mentions neither `w` nor `b`, yet
# `describe(1)` printed `int:7` and `describe(true)` printed `bool`.
#
# The marker key is built from the constraint var's fresh-instantiation identity
# (seed_fwd_with_supers), so a dispatch variable that owns a marker is found by
# exact lookup. A miss means the variable is tied to no declared constraint:
# resolve nothing, and let the call reach verify_dispatch dict-less, where it is
# reported with a source position.
#
# A dispatch type that is not a variable, or that the caller does not have in
# hand at all (`Nothing`), keeps the ungated scan. That is the case the scan was
# written for — a constraint var not visible at the head of any argument, e.g.
# `Ord k` where `k` appears inside a tuple.
fn gated_fwd_scan(
  class_name: String,
  env: Dict types.Scheme,
  s3: Dict types.Type,
  pos: source.SourcePos,
  dispatch_t: Maybe types.Type
) -> Maybe typed_ast.TypedExpr =
  # Resolve through s3 first: the dispatch type reaching here may still be an
  # alias for the constraint var rather than the var itself, and the marker is
  # keyed by the var's own identity. A dispatch type the caller does not have, or
  # one that is not a bare variable, keeps the ungated scan.
  let Just t = dispatch_t else scan_fwd_markers(class_name, env, pos)
      types.TVar v = unifier.apply_subst(s3, t) else scan_fwd_markers(class_name, env, pos)
      # A variable owning no marker for this class is tied to no declared
      # constraint: resolve nothing rather than adopting an unrelated marker.
      Just fwd_scheme = dict_get("@fwd:" ++ types.tyvar_identity(v) ++ ":" ++ class_name, env) else Nothing
  in fwd_scheme_to_tdict(fwd_scheme, class_name, pos)

# Stage 0b: resolve a class-method call whose dispatch value is an unpacked
# existential skolem. The witness was packed into the box and seeded as
# `@fwd:{skolem}:{class}` by extend_env_with_existential_givens; look it up
# PRECISELY (never scan_fwd_markers, which is class-only and would risk grabbing
# an ambient same-class dict). A skolem with no given is unsatisfiable — a loud
# error, not a silently missing dict. The emitted TDict carries the skolem as its
# constraint head so lowering forwards the packed ctor field (see lowering's
# EvForward path); its evidence is left EvUnresolved for that pass to fill.
fn resolve_skolem_given(
  class_name: String,
  skolem_name: String,
  typed_callee: typed_ast.TypedExpr,
  typed_args: List typed_ast.TypedExpr,
  env: Dict types.Scheme,
  ret_t: types.Type,
  s3: Dict types.Type,
  es3: Dict types.Effect,
  call_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult =
  match dict_get("@fwd:" ++ skolem_name ++ ":" ++ class_name, env) with
  | Just fwd_scheme ->
      match fwd_scheme_to_tdict(fwd_scheme, class_name, pos) with
      | Just tdict ->
          InferOk(typed_ast.TCall(typed_callee, Cons(tdict, typed_args), ret_t, pos), s3, es3, call_eff)
      | Nothing ->
          InferErr(pos, "internal: existential dict marker malformed for " ++ class_name)
  | Nothing ->
      InferErr(pos, "No instance of " ++ class_name ++ " for the unpacked existential value")

# True when some argument's type resolves (under s3) to a function type. A
# function-typed argument can never host a typeclass instance, so its presence at
# the unresolved dispatch sink means the obligation is unsatisfiable.
fn any_function_typed_arg(args: List typed_ast.TypedExpr, subst: Dict types.Type) -> Bool =
  match args with
  | Nil -> false
  | Cons a rest ->
      match unifier.apply_subst(subst, typed_ast.typed_expr_type(a)) with
      | types.TFunc _ _ _ _ -> true
      | _ -> any_function_typed_arg(rest, subst)

# Walk each arg looking for one whose raw TVar head maps to a @fwd marker.
fn find_fwd_tdict_in_args(class_name: String, args: List typed_ast.TypedExpr, env: Dict types.Scheme, pos: source.SourcePos) -> Maybe typed_ast.TypedExpr =
  match args with
  | Nil -> Nothing
  | Cons arg rest ->
      match tvar_head_of_type(typed_ast.typed_expr_type(arg)) with
      | Nothing -> find_fwd_tdict_in_args(class_name, rest, env, pos)
      | Just tvar_name ->
          match dict_get("@fwd:" ++ tvar_name ++ ":" ++ class_name, env) with
          | Just fwd_scheme -> fwd_scheme_to_tdict(fwd_scheme, class_name, pos)
          | Nothing -> find_fwd_tdict_in_args(class_name, rest, env, pos)

# Scan all args for the first whose head type is a concrete constructor (TConst).
# Skips function-typed args (TFunc) and type-variable-headed containers, which
# cannot host a typeclass instance.  This allows class methods whose concrete
# container argument is not the first parameter (e.g. fmap(fn, container)) to
# resolve correctly.
fn first_concrete_typed_arg_str(typed_args: List typed_ast.TypedExpr, subst: Dict types.Type) -> Maybe String =
  match typed_args with
  | Nil -> Nothing
  | Cons first_arg rest ->
      match concrete_type_str(unifier.apply_subst(subst, typed_ast.typed_expr_type(first_arg))) with
      | Nothing -> first_concrete_typed_arg_str(rest, subst)
      | Just s -> Just(s)

# W4 (F-DISPATCH): pick the argument that determines the instance dict by
# CONSTRAINT POSITION. Walk the method's declared parameter chain alongside the
# actual args and return the first arg whose declared parameter type mentions a
# class variable AND has a concrete head. This makes `describe(tag: String,
# x: a)` dispatch on `x` (the class-var parameter), not on the leading `tag`.
# Returning Nothing (no class-var arg is concrete) routes to the @fwd
# polymorphic path, matching the old first-concrete behaviour on that boundary.
fn class_var_arg(
  method_type: types.Type,
  class_vars: List String,
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type
) -> Maybe typed_ast.TypedExpr =
  match method_type with
  | types.TFunc param ret _ _ ->
      match typed_args with
      | Nil -> Nothing
      | Cons arg rest ->
          if type_contains_var(param, class_vars) then
            match concrete_type_str(unifier.apply_subst(subst, typed_ast.typed_expr_type(arg))) with
            | Just _ -> Just(arg)
            | Nothing -> class_var_arg(ret, class_vars, rest, subst)
          else
            class_var_arg(ret, class_vars, rest, subst)
  | _ -> Nothing

# Position-aware instance-arg selection with a safe fallback: when the method's
# declared type is not in env (cannot locate the class-var position), fall back
# to the historical first-concrete-arg heuristic rather than mis-dispatching.
fn class_var_arg_or_fallback(
  method_name: String,
  class_vars: List String,
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  env: Dict types.Scheme
) -> Maybe typed_ast.TypedExpr =
  match dict_get(method_name, env) with
  | Just method_scheme ->
      match method_scheme with
      | types.Scheme _ _ method_type _ _ -> class_var_arg(method_type, class_vars, typed_args, subst)
  | Nothing -> first_concrete_typed_arg(typed_args, subst)

# Like first_concrete_typed_arg_str, but returns the arg itself (used as the W4
# fallback so head_str and TypeExpr derive from the same TypedExpr).
fn first_concrete_typed_arg(typed_args: List typed_ast.TypedExpr, subst: Dict types.Type) -> Maybe typed_ast.TypedExpr =
  match typed_args with
  | Nil -> Nothing
  | Cons first_arg rest ->
      match concrete_type_str(unifier.apply_subst(subst, typed_ast.typed_expr_type(first_arg))) with
      | Nothing -> first_concrete_typed_arg(rest, subst)
      | Just _ -> Just(first_arg)

# Like first_concrete_typed_arg_str but skips heads in the excluded list.
# Used when multiple constraints share a class: subsequent constraints skip
# heads already committed to earlier TDict injections.
# The head-directed counterparts of first_concrete_typed_arg_*: take the first
# argument whose resolved type is headed by `want`, rather than the first
# concrete argument of any type. Returning Nothing when no argument matches is
# the point — the caller then forwards the obligation instead of substituting a
# dictionary for an unrelated type.
fn headed_typed_arg_str(
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  want: String
) -> Maybe String =
  match typed_args with
  | Nil -> Nothing
  | Cons first_arg rest ->
      match concrete_type_str(unifier.apply_subst(subst, typed_ast.typed_expr_type(first_arg))) with
      | Just s ->
          if head_name_matches(s, want) then Just(s) else headed_typed_arg_str(rest, subst, want)
      | Nothing -> headed_typed_arg_str(rest, subst, want)

fn headed_typed_arg_typeexpr(
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  want: String
) -> Maybe ast.TypeExpr =
  match typed_args with
  | Nil -> Nothing
  | Cons first_arg rest ->
      let arg_t = unifier.apply_subst(subst, typed_ast.typed_expr_type(first_arg))
      in
        match concrete_type_str(arg_t) with
        | Just s ->
            if head_name_matches(s, want)
            then concrete_typeexpr(arg_t)
            else headed_typed_arg_typeexpr(rest, subst, want)
        | Nothing -> headed_typed_arg_typeexpr(rest, subst, want)

fn first_concrete_typed_arg_str_excluding(
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  excluded: List String
) -> Maybe String =
  match typed_args with
  | Nil -> Nothing
  | Cons first_arg rest ->
      match concrete_type_str(unifier.apply_subst(subst, typed_ast.typed_expr_type(first_arg))) with
      | Nothing -> first_concrete_typed_arg_str_excluding(rest, subst, excluded)
      | Just s ->
          if str_list_contains(excluded, s) then
            first_concrete_typed_arg_str_excluding(rest, subst, excluded)
          else
            Just(s)

fn str_list_contains(xs: List String, target: String) -> Bool =
  match xs with
  | Nil -> false
  | Cons h rest -> if h == target then true else str_list_contains(rest, target)

# Convert a concrete types.Type to an ast.TypeExpr.
# Only TConst, TApp, and TTuple are meaningful here; anything else falls back to "_".
fn type_to_typeexpr(t: types.Type) -> ast.TypeExpr =
  match t with
  # Dispatch TDict head — keep the full canonical name (matches
  # type_to_typeexpr_with_prog_vars), so the head can't desync from full-name @inst /
  # ctx_inst keys for a module-qualified type. (code-review finding 1, 2026-07-10)
  | types.TConst name -> ast.TypeName(types.type_id_name(name))
  | types.TApp base arg -> ast.TypeApply(type_to_typeexpr(base), type_to_typeexpr(arg))
  | types.TTuple items -> ast.TupleType(list_map(\item -> type_to_typeexpr(item), items))
  | _ -> ast.TypeName("_")

# Returns Just(te) if t has a concrete (TConst) head; Nothing if the head is a TVar.
# TTuple is always concrete (its head is a known arity, never a variable).
fn concrete_typeexpr(t: types.Type) -> Maybe ast.TypeExpr =
  match t with
  | types.TConst name -> Just(ast.TypeName(types.type_id_name(name)))
  | types.TApp base _ ->
      match concrete_typeexpr(base) with
      | Nothing -> Nothing
      | Just _ -> Just(type_to_typeexpr(t))
  | types.TTuple items -> Just(ast.TupleType(list_map(\item -> type_to_typeexpr(item), items)))
  | _ -> Nothing

# Returns the full concrete ast.TypeExpr for the first concrete arg, or Nothing.
fn first_concrete_typed_arg_typeexpr(
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type
) -> Maybe ast.TypeExpr =
  match typed_args with
  | Nil -> Nothing
  | Cons first_arg rest ->
      match concrete_typeexpr(unifier.apply_subst(subst, typed_ast.typed_expr_type(first_arg))) with
      | Nothing -> first_concrete_typed_arg_typeexpr(rest, subst)
      | Just te -> Just(te)

# Return the full concrete typeexpr for the first typed arg, falling back to TypeName(head_str).
fn first_concrete_arg_typeexpr_or_name(
  head_str: String,
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type
) -> ast.TypeExpr =
  match first_concrete_typed_arg_typeexpr(typed_args, subst) with
  | Just te -> te
  | Nothing -> ast.TypeName(head_str)

# Like first_concrete_arg_typeexpr_or_name but skips args whose head is in excluded.
# Needed so that the TypeConstraint in a TDict records the correct instance type
# when multiple constraints share the same class.
fn first_concrete_arg_typeexpr_or_name_excluding(
  head_str: String,
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  excluded: List String
) -> ast.TypeExpr =
  match first_concrete_typed_arg_typeexpr_excluding(typed_args, subst, excluded) with
  | Just te -> te
  | Nothing -> ast.TypeName(head_str)

fn first_concrete_typed_arg_typeexpr_excluding(
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  excluded: List String
) -> Maybe ast.TypeExpr =
  match typed_args with
  | Nil -> Nothing
  | Cons first_arg rest ->
      match concrete_typeexpr(unifier.apply_subst(subst, typed_ast.typed_expr_type(first_arg))) with
      | Nothing -> first_concrete_typed_arg_typeexpr_excluding(rest, subst, excluded)
      | Just te ->
          if str_list_contains(excluded, te_outermost_name(te)) then
            first_concrete_typed_arg_typeexpr_excluding(rest, subst, excluded)
          else
            Just(te)

# Like first_concrete_arg_typeexpr_or_name, but substitutes programmer type-variable
# names recovered from @fwd markers when the type contains TVars.  This is needed when
# calling a class method on a polymorphic container (e.g. eq(x, y) where x: Maybe a):
# without it, TVar args become TypeName("_") and the lowering's fwd-dict lookup fails.
# Like type_to_typeexpr, but for each TVar looks up @fwd:name:class_name in env
# to recover the programmer-visible variable name (e.g. "a") rather than emitting "_".
fn type_to_typeexpr_with_prog_vars(t: types.Type, class_name: String, env: Dict types.Scheme) -> ast.TypeExpr =
  match t with
  # Module-qualified type identity (T7): keep the canonical (dotted) name. This
  # TypeExpr becomes the injected TDict's constraint head, which resolve.sprout turns
  # into the instance-dispatch Evidence key — stripping here made the key bare
  # ("ToString_Maybe") and mis-resolved a shadowed type to the prelude instance.
  | types.TConst name -> ast.TypeName(types.type_id_name(name))
  | types.TApp base arg ->
      ast.TypeApply(type_to_typeexpr_with_prog_vars(base, class_name, env),
                    type_to_typeexpr_with_prog_vars(arg, class_name, env))
  | types.TVar name ->
      match dict_get("@fwd:" ++ types.tyvar_identity(name) ++ ":" ++ class_name, env) with
      | Just scheme ->
          match scheme with
          | types.Scheme _ _ (types.TConst prog_var) _ _ -> ast.TypeName(types.type_id_name(prog_var))
          | _ -> ast.TypeName("_")
      | Nothing -> ast.TypeName("_")
  | types.TTuple items ->
      ast.TupleType(list_map(\item -> type_to_typeexpr_with_prog_vars(item, class_name, env), items))
  | _ -> ast.TypeName("_")

# Returns the outermost TVar name from the first arg whose head is a TVar after
# substitution.  Scans all args so that function-typed leading arguments (e.g.
# the fn-arg in fmap(fn, xs)) do not shadow the actual container argument.
#
# NOTE: we use the RAW typed-expr type (no subst application) rather than the
# fully-substituted type.  Pattern inference in infer_tuple_pattern binds the
# original @fwd key (e.g. "t360") to a fresh element variable (e.g. TVar "t364")
# in the subst.  Fully applying the subst would follow that chain and return
# "t364", which has no @fwd marker — the marker was registered for "t360".
# Using the raw type preserves the original TVar name so the @fwd lookup works.
fn first_tvar_head_after_subst(typed_args: List typed_ast.TypedExpr, subst: Dict types.Type) -> Maybe String =
  match typed_args with
  | Nil -> Nothing
  | Cons first_arg rest ->
      match tvar_head_of_type(typed_ast.typed_expr_type(first_arg)) with
      | Just name -> Just(name)
      | Nothing -> first_tvar_head_after_subst(rest, subst)

fn tvar_head_of_type(t: types.Type) -> Maybe String =
  match t with
  | types.TVar name -> Just(types.tyvar_identity(name))
  | types.TApp base _ -> tvar_head_of_type(base)
  | _ -> Nothing

fn type_head_str(t: types.Type) -> String =
  match t with
  | types.TConst name -> types.type_id_name(name)
  | types.TApp base _ -> type_head_str(base)
  | types.TVar name -> types.tyvar_identity(name)
  | types.TTuple items -> "Tuple" ++ int_to_string(list_length(items))
  | _ -> types.type_to_string(t)

# Returns the concrete constructor name (TConst head) of a type, or Nothing if
# the outermost head is a type variable, a function type, or any non-concrete
# form.  Used to look up @inst:{Class}:{head} instance markers.
#
# The full module-qualified name is returned (T7): instance lookups key
# @inst:{Class}:{head} on the canonical identity, matching register_instance_marker
# which derives its head via type_head_str (no strip) over a resolved type. Read and
# write must agree — de-stripping one without the other is a silent dispatch miss.
fn concrete_type_str(t: types.Type) -> Maybe String =
  match t with
  | types.TConst name -> Just(types.type_id_name(name))
  | types.TApp base _ -> concrete_type_str(base)
  | types.TTuple items -> Just("Tuple" ++ int_to_string(list_length(items)))
  | _ -> Nothing

# Walk a class-method's original scheme type alongside the call-site's
# instantiated type, looking for where the class type variable `class_var`
# lives, and return the substituted concrete type at that position.
# Used by resolve_dispatch_typed_expr (post-pass) to correct dispatch for
# methods whose class type variable appears only in the return type.
fn find_class_var_in_type(orig: types.Type, inst: types.Type, class_var: String) -> Maybe types.Type =
  match orig with
  | types.TVar n ->
      if types.tyvar_identity(n) == class_var then Just(inst) else Nothing
  | types.TConst _ -> Nothing
  | types.TApp ob oa ->
      match inst with
      | types.TApp ib ia ->
          match find_class_var_in_type(ob, ib, class_var) with
          | Just r -> Just(r)
          | Nothing -> find_class_var_in_type(oa, ia, class_var)
      | _ -> Nothing
  | types.TFunc op orr _ _ ->
      match inst with
      | types.TFunc ip ir _ _ ->
          match find_class_var_in_type(op, ip, class_var) with
          | Just r -> Just(r)
          | Nothing -> find_class_var_in_type(orr, ir, class_var)
      | _ -> Nothing
  | types.TTuple oitems ->
      match inst with
      | types.TTuple iitems -> find_class_var_in_tuple_lists(oitems, iitems, class_var)
      | _ -> Nothing

fn find_class_var_in_tuple_lists(os: List types.Type, is: List types.Type, class_var: String) -> Maybe types.Type =
  match os with
  | Nil -> Nothing
  | Cons oh orest ->
      match is with
      | Nil -> Nothing
      | Cons ih irest ->
          match find_class_var_in_type(oh, ih, class_var) with
          | Just r -> Just(r)
          | Nothing -> find_class_var_in_tuple_lists(orest, irest, class_var)

# Walk method scheme's TFunc chain alongside typed args + return, returning
# the substituted concrete type at the position of the class type variable.
fn dispatch_type_walk(
  scheme_type: types.Type,
  typed_args: List typed_ast.TypedExpr,
  ret_t: types.Type,
  subst: Dict types.Type,
  class_var: String
) -> Maybe types.Type =
  match scheme_type with
  | types.TFunc param ret _ _ ->
      match typed_args with
      | Cons first_arg rest_args ->
          match find_class_var_in_type(param, unifier.apply_subst(subst, typed_ast.typed_expr_type(first_arg)), class_var) with
          | Just t -> Just(t)
          | Nothing -> dispatch_type_walk(ret, rest_args, ret_t, subst, class_var)
      | Nil ->
          find_class_var_in_type(scheme_type, unifier.apply_subst(subst, ret_t), class_var)
  | _ ->
      find_class_var_in_type(scheme_type, unifier.apply_subst(subst, ret_t), class_var)

fn dispatch_type_for_vars(
  scheme_type: types.Type,
  typed_args: List typed_ast.TypedExpr,
  ret_t: types.Type,
  subst: Dict types.Type,
  class_vars: List String
) -> Maybe types.Type =
  match class_vars with
  | Nil -> Nothing
  | Cons v rest ->
      match dispatch_type_walk(scheme_type, typed_args, ret_t, subst, v) with
      | Just t -> Just(t)
      | Nothing -> dispatch_type_for_vars(scheme_type, typed_args, ret_t, subst, rest)

fn contains_str(xs: List String, target: String) -> Bool =
  match xs with
  | Nil -> false
  | Cons h t -> if h == target then true else contains_str(t, target)

fn type_contains_var(t: types.Type, names: List String) -> Bool =
  match t with
  | types.TVar n -> contains_str(names, types.tyvar_identity(n))
  | types.TConst _ -> false
  | types.TApp a b -> if type_contains_var(a, names) then true else type_contains_var(b, names)
  | types.TFunc p r _ _ -> if type_contains_var(p, names) then true else type_contains_var(r, names)
  | types.TTuple items -> tuple_contains_var(items, names)

fn tuple_contains_var(items: List types.Type, names: List String) -> Bool =
  match items with
  | Nil -> false
  | Cons h t -> if type_contains_var(h, names) then true else tuple_contains_var(t, names)

# Returns true if any of `class_vars` appears in any ARG position of method type.
# Used to skip rewriting input-position dispatch (already correct at inference time).
fn class_var_in_args(method_type: types.Type, class_vars: List String) -> Bool =
  match method_type with
  | types.TFunc param ret _ _ ->
      if type_contains_var(param, class_vars) then true
      else class_var_in_args(ret, class_vars)
  | _ -> false

# --- Constrained-function TDict injection ---
#
# inject_constrained_fn_dicts_via_field: when calling a constrained regular
# function (not a class method), iterate its Scheme constraint field and inject
# TDict evidence for each constraint, so that lowering.sprout can forward the
# appropriate dict args at the call site.
#
# user_typed_args strips TDict nodes already prepended in earlier iterations so
# that first_concrete_typed_arg_str and first_tvar_head_after_subst only see
# the real user arguments when resolving each constraint.
# Also strips TVar nodes whose names start with "__tc_" — these are materialized
# hidden dict params inserted by the lowering pass (check2 path). Without this
# filter the constraint field causes double-injection in check2.

fn user_typed_args(args: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  match args with
  | Nil -> Nil
  | Cons (typed_ast.TDict _ _ _ _) rest -> user_typed_args(rest)
  | Cons (typed_ast.TVar name t p) rest ->
      if str_starts_with(name, "__tc_") then user_typed_args(rest)
      else Cons(typed_ast.TVar(name, t, p), user_typed_args(rest))
  | Cons e rest -> Cons(e, user_typed_args(rest))

# Collect the head-type strings of already-injected TDict nodes for a given class.
# Used to exclude already-committed heads when resolving subsequent constraints of
# the same class (e.g., both Eq a and Eq b must inject distinct dicts).
fn collect_injected_heads_for_class(class_name: String, typed_args: List typed_ast.TypedExpr) -> List String =
  collect_injected_heads_acc(class_name, typed_args, Nil)

fn collect_injected_heads_acc(class_name: String, typed_args: List typed_ast.TypedExpr, acc: List String) -> List String =
  match typed_args with
  | Nil -> acc
  | Cons arg rest ->
      match arg with
      | typed_ast.TDict (ast.TypeConstraint cn type_args) _ _ _ ->
          if cn == class_name then
            collect_injected_heads_acc(class_name, rest, list_append(acc, Cons(te_head_str(type_args), Nil)))
          else
            collect_injected_heads_acc(class_name, rest, acc)
      | _ -> collect_injected_heads_acc(class_name, rest, acc)

fn te_head_str(type_args: List ast.TypeExpr) -> String =
  match type_args with
  | Nil -> ""
  | [te | _] -> te_outermost_name(te)

fn te_outermost_name(te: ast.TypeExpr) -> String =
  match te with
  | ast.TypeName n -> n
  | ast.TypeApply base _ -> te_outermost_name(base)
  | _ -> ""

# Check if a TVar node in `t` has an @fwd marker whose stored prog_var equals `prog_var`.
fn tvar_for_prog_var_in_type(t: types.Type, class_name: String, prog_var: String, env: Dict types.Scheme) -> Bool =
  match t with
  | types.TVar name ->
      match dict_get("@fwd:" ++ types.tyvar_identity(name) ++ ":" ++ class_name, env) with
      | Just scheme ->
          match scheme with
          | types.Scheme _ _ (types.TConst pv) _ _ -> types.type_id_name(pv) == prog_var
          | _ -> false
      | Nothing -> false
  | types.TApp base arg ->
      tvar_for_prog_var_in_type(base, class_name, prog_var, env) ||
      tvar_for_prog_var_in_type(arg, class_name, prog_var, env)
  | _ -> false

# Returns true if `t` has at least one inner TVar (i.e., not at the head) that
# anchors to prog_var via a @fwd marker. Used to distinguish "Maybe a" (include)
# from "List String" (skip) when scanning prog_to_fresh for instance lookup.
fn has_inner_tvar_for_prog_var(t: types.Type, class_name: String, prog_var: String, env: Dict types.Scheme) -> Bool =
  match t with
  | types.TApp base arg ->
      tvar_for_prog_var_in_type(arg, class_name, prog_var, env) ||
      has_inner_tvar_for_prog_var(base, class_name, prog_var, env)
  | _ -> false

fn scan_ptf_for_prog_var(
  class_name: String,
  prog_var: String,
  prog_to_fresh: Dict types.Type,
  s3: Dict types.Type,
  env: Dict types.Scheme,
  pos: source.SourcePos,
  excluded: List String
) -> Maybe typed_ast.TypedExpr =
  scan_ptf_prog_var_entries(class_name, prog_var, vec_to_list(dict_entries(prog_to_fresh)), s3, env, pos, excluded)

fn scan_ptf_prog_var_entries(
  class_name: String,
  prog_var: String,
  entries: List (String, types.Type),
  s3: Dict types.Type,
  env: Dict types.Scheme,
  pos: source.SourcePos,
  excluded: List String
) -> Maybe typed_ast.TypedExpr =
  match entries with
  | Nil -> Nothing
  | Cons entry rest ->
      match entry with
      | (_, fresh_t) ->
          match concrete_type_str(unifier.apply_subst(s3, fresh_t)) with
          | Nothing -> scan_ptf_prog_var_entries(class_name, prog_var, rest, s3, env, pos, excluded)
          | Just head_str ->
              if str_list_contains(excluded, head_str) then
                scan_ptf_prog_var_entries(class_name, prog_var, rest, s3, env, pos, excluded)
              else if has_inner_tvar_for_prog_var(unifier.apply_subst(s3, fresh_t), class_name, prog_var, env) then
                match dict_get("@inst:" ++ class_name ++ ":" ++ head_str, env) with
                | Just _ ->
                    Just(typed_ast.TDict(
                      ast.TypeConstraint(class_name, Cons(type_to_typeexpr_with_prog_vars(unifier.apply_subst(s3, fresh_t), class_name, env), Nil)),
                      types.TConst(types.type_id(class_name)), pos, typed_ast.EvUnresolved))
                | Nothing ->
                    scan_ptf_prog_var_entries(class_name, prog_var, rest, s3, env, pos, excluded)
              else
                scan_ptf_prog_var_entries(class_name, prog_var, rest, s3, env, pos, excluded)

# --- Compound-head constraint tokens ---
#
# `where Sh (Box a)` has no head variable to canonicalize, so its entry used to
# be the same "#none" as a genuinely headless constraint. These three keep the
# head constructor instead. The token is the SOURCE name (`Box`); resolved types
# carry the module-qualified one (`main.Box`), which is why head_name_matches
# compares on the final dotted segment rather than by equality.

fn compound_head_token(base: ast.TypeExpr) -> String =
  match type_expr_head_name(base) with
  | Just h -> "#app:" ++ h
  | Nothing -> "#none"

fn type_expr_head_name(te: ast.TypeExpr) -> Maybe String =
  match te with
  | ast.TypeName n -> Just(n)
  | ast.TypeApply base _ -> type_expr_head_name(base)
  | _ -> Nothing

# Both token forms are discharged by scanning the ARGUMENTS, as opposed to a
# variable head (decoded via scheme_vars) or a concrete-ctor head (looked up
# directly). Sites that branch on "is this argument-scanned" must use this, not
# a bare `== "#none"` test, or a "#app:" token falls into the head-variable path
# and is decoded as a type variable name.
fn is_arg_scanned_token(head_token: String) -> Bool =
  head_token == "#none" || str_starts_with(head_token, "#app:")

# Just the head constructor for a compound head, Nothing for a truly headless
# constraint — i.e. "may I direct the argument scan?".
fn arg_scan_head(head_token: String) -> Maybe String =
  if str_starts_with(head_token, "#app:")
  then Just(str_slice(head_token, 5, str_len(head_token)))
  else Nothing

fn head_name_matches(resolved_head: String, want: String) -> Bool =
  resolved_head == want || str_ends_with_suffix(resolved_head, "." ++ want)

# Discharge an argument-scanned constraint. With a known head (`where Sh (Box
# a)`) the argument is chosen BY that head; a genuinely headless constraint
# keeps the positional scan. When the head matches no argument the obligation is
# forwarded rather than filled from an unrelated type — filling it was the bug.
fn resolve_arg_scanned_tdict(
  class_name: String,
  head: Maybe String,
  user_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  env: Dict types.Scheme,
  pos: source.SourcePos,
  excluded: List String
) -> Maybe typed_ast.TypedExpr =
  let Just want = head else resolve_one_constraint_tdict(class_name, user_args, subst, env, pos, excluded)
  in
    let Just head_str = headed_typed_arg_str(user_args, subst, want) else resolve_via_fwd_or_scan(class_name, user_args, subst, env, pos)
    in
      let Just _ = dict_get("@inst:" ++ class_name ++ ":" ++ head_str, env) else resolve_via_fwd_or_scan(class_name, user_args, subst, env, pos)
      in
        Just(typed_ast.TDict(
          ast.TypeConstraint(class_name,
            Cons(headed_arg_typeexpr_or_name(head_str, user_args, subst, want), Nil)),
          types.TConst(types.type_id(class_name)), pos, typed_ast.EvUnresolved))

fn headed_arg_typeexpr_or_name(
  head_str: String,
  user_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  want: String
) -> ast.TypeExpr =
  match headed_typed_arg_typeexpr(user_args, subst, want) with
  | Just te -> te
  | Nothing -> ast.TypeName(head_str)

fn resolve_one_constraint_tdict(
  class_name: String,
  user_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  env: Dict types.Scheme,
  pos: source.SourcePos,
  excluded: List String
) -> Maybe typed_ast.TypedExpr =
  match first_concrete_typed_arg_str_excluding(user_args, subst, excluded) with
  | Just head_str ->
      match dict_get("@inst:" ++ class_name ++ ":" ++ head_str, env) with
      | Just _ ->
          Just(typed_ast.TDict(
            ast.TypeConstraint(class_name, Cons(first_concrete_arg_typeexpr_or_name_excluding(head_str, user_args, subst, excluded), Nil)),
            types.TConst(types.type_id(class_name)), pos, typed_ast.EvUnresolved))
      | Nothing ->
          resolve_via_fwd_or_scan(class_name, user_args, subst, env, pos)
  | Nothing ->
      # No non-excluded concrete arg found. This happens when all concrete args have the
      # same type as a prior constraint of the same class (e.g. `where Eq a, Eq b` called
      # with a = b = AlwaysEqual). Fall back without exclusion: the second constraint
      # legitimately needs the same dict as the first.
      match first_concrete_typed_arg_str(user_args, subst) with
      | Just head_str ->
          match dict_get("@inst:" ++ class_name ++ ":" ++ head_str, env) with
          | Just _ ->
              Just(typed_ast.TDict(
                ast.TypeConstraint(class_name, Cons(first_concrete_arg_typeexpr_or_name(head_str, user_args, subst), Nil)),
                types.TConst(types.type_id(class_name)), pos, typed_ast.EvUnresolved))
          | Nothing ->
              resolve_via_fwd_or_scan(class_name, user_args, subst, env, pos)
      | Nothing ->
          resolve_via_fwd_or_scan(class_name, user_args, subst, env, pos)

# Try @fwd marker lookup first (direct TVar arg), then fall back to env scan.
# Used when the first concrete-type lookup finds no instance (or no concrete type).
fn resolve_via_fwd_or_scan(
  class_name: String,
  user_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  env: Dict types.Scheme,
  pos: source.SourcePos
) -> Maybe typed_ast.TypedExpr =
  match first_tvar_head_after_subst(user_args, subst) with
  | Just tvar_name ->
      match dict_get("@fwd:" ++ tvar_name ++ ":" ++ class_name, env) with
      | Just fwd_scheme ->
          fwd_scheme_to_tdict(fwd_scheme, class_name, pos)
      | Nothing ->
          # tvar_name not directly in @fwd; fall through to env scan
          scan_fwd_markers(class_name, env, pos)
  | Nothing ->
      # Arg head is not a TVar (e.g., constraint type embedded inside a tuple or
      # container arg). Fall back to scanning env for any @fwd:*:class_name marker
      # seeded for this function's constraints.
      scan_fwd_markers(class_name, env, pos)

# Convert a stored @fwd scheme value to a TDict evidence node.
fn fwd_scheme_to_tdict(fwd_scheme: types.Scheme, class_name: String, pos: source.SourcePos) -> Maybe typed_ast.TypedExpr =
  match fwd_scheme with
  | types.Scheme _ _ (types.TConst prog_var) _ _ ->
      Just(typed_ast.TDict(
        ast.TypeConstraint(class_name, Cons(ast.TypeName(types.type_id_name(prog_var)), Nil)),
        types.TConst(types.type_id(class_name)), pos, typed_ast.EvUnresolved))
  | _ -> Nothing

# Scan all env entries for the first "@fwd:*:class_name" marker.
# Used as a fallback when the constraint type is not visible at the head of any
# argument (e.g., Ord k where k appears inside a tuple argument).
fn scan_fwd_markers(class_name: String, env: Dict types.Scheme, pos: source.SourcePos) -> Maybe typed_ast.TypedExpr =
  scan_fwd_marker_entries(class_name, vec_to_list(dict_entries(env)), pos)

fn scan_fwd_marker_entries(
  class_name: String,
  entries: List (String, types.Scheme),
  pos: source.SourcePos
) -> Maybe typed_ast.TypedExpr =
  match entries with
  | Nil -> Nothing
  | Cons entry rest ->
      match entry with
      | (key, val) ->
          if is_fwd_key_for_class(key, class_name)
          then fwd_scheme_to_tdict(val, class_name, pos)
          else scan_fwd_marker_entries(class_name, rest, pos)

# Check whether an env key is an @fwd marker for the given class.
# Key format: "@fwd:" ++ tvar_name ++ ":" ++ class_name
fn is_fwd_key_for_class(key: String, class_name: String) -> Bool =
  str_starts_with(key, "@fwd:") && str_ends_with_suffix(key, ":" ++ class_name)

fn str_ends_with_suffix(s: String, suffix: String) -> Bool =
  if str_len(s) < str_len(suffix) then false
  else str_slice(s, str_len(s) - str_len(suffix), str_len(s)) == suffix

# When a function has multiple constraints for the same class (e.g. Eq a, Eq b), there are
# two @fwd:*:Eq markers in env — one per prog_var.  resolve_via_fwd_or_scan picks the first
# TVar-headed arg, which is always the same arg, so both obligations resolve to the same dict.
# This function scans markers by prog_var so each constraint gets its own dict.
fn resolve_via_fwd_for_prog_var(
  class_name: String,
  prog_var: String,
  env: Dict types.Scheme,
  pos: source.SourcePos
) -> Maybe typed_ast.TypedExpr =
  scan_fwd_markers_for_prog_var(class_name, prog_var, vec_to_list(dict_entries(env)), pos)

fn scan_fwd_markers_for_prog_var(
  class_name: String,
  prog_var: String,
  entries: List (String, types.Scheme),
  pos: source.SourcePos
) -> Maybe typed_ast.TypedExpr =
  match entries with
  | Nil -> Nothing
  | Cons entry rest ->
      match entry with
      | (key, val) ->
          if is_fwd_key_for_class(key, class_name)
          then
            match val with
            | types.Scheme _ _ (types.TConst stored_prog_var) _ _ ->
                if types.type_id_name(stored_prog_var) == prog_var
                then Just(typed_ast.TDict(
                       ast.TypeConstraint(class_name, Cons(ast.TypeName(prog_var), Nil)),
                       types.TConst(types.type_id(class_name)), pos, typed_ast.EvUnresolved))
                else scan_fwd_markers_for_prog_var(class_name, prog_var, rest, pos)
            | _ -> scan_fwd_markers_for_prog_var(class_name, prog_var, rest, pos)
          else scan_fwd_markers_for_prog_var(class_name, prog_var, rest, pos)

# --- SPROUT_TRACE_DISPATCH diagnostic ---------------------------------------
#
# resolve_obligation returns, alongside the chosen dict, a *path tag* naming which
# cascade branch resolved it. When the SPROUT_TRACE_DISPATCH env var is set,
# inject_constrained_fn_dicts_via_field (already !{IO}) emits one line per
# constrained call site so a dispatch mis-resolution (the vec_sort_by projection
# crash, #141, the `++`/mconcat null-fill) can be diagnosed in one compile instead
# of two stage-2 rebuilds with hand-rolled panics. The trace lives at the IO
# boundary, NOT inside the pure resolver, keeping IO out of the inference core
# (observability guard-rail #3). The two `(guess)` tags mark the order-dependent
# heuristics that grab a plausible-but-wrong dict — motivation for backlog item 3.

# Head name of a TypeExpr, mirroring concrete_type_str's head extraction for Types.
fn dispatch_head_str(te: ast.TypeExpr) -> String =
  match te with
  | ast.TypeName n -> n
  | ast.TypeApply base _ -> dispatch_head_str(base)
  | ast.TupleType items -> "Tuple" ++ int_to_string(list_length(items))
  | _ -> "?"

# The resolved dict's head type, read out of the TDict's constraint TypeExpr
# (evidence is still EvUnresolved at this stage, so the TypeConstraint is the source).
fn tdict_head_str(td: typed_ast.TypedExpr) -> String =
  match td with
  | typed_ast.TDict (ast.TypeConstraint _ [head_te | _]) _ _ _ -> dispatch_head_str(head_te)
  | _ -> "?"

fn resolved_head_str(class_name: String, resolved: Maybe typed_ast.TypedExpr) -> String =
  match resolved with
  | Nothing -> "UNRESOLVED"
  | Just td -> class_name ++ " " ++ tdict_head_str(td)

# Render each prog_var->resolved-head pair (via s3), so `k->Int a->(Int,Int)` next to
# `-> Ord (Int,Int)` makes an element-vs-key mismatch self-evident.
fn render_ptf_entry(k: String, t: types.Type, s3: Dict types.Type) -> String =
  match concrete_type_str(unifier.apply_subst(s3, t)) with
  | Just h -> k ++ "->" ++ h
  | Nothing -> k ++ "->?"

fn render_ptf_go(entries: List (String, types.Type), s3: Dict types.Type) -> String =
  match entries with
  | Nil -> ""
  | Cons e rest ->
      match e with
      | (k, t) ->
          match rest with
          | Nil -> render_ptf_entry(k, t, s3)
          | _ -> render_ptf_entry(k, t, s3) ++ " " ++ render_ptf_go(rest, s3)

fn render_ptf_resolved(prog_to_fresh: Dict types.Type, s3: Dict types.Type) -> String =
  render_ptf_go(vec_to_list(dict_entries(prog_to_fresh)), s3)

# Emit one dispatch line when SPROUT_TRACE_DISPATCH is set. The env read happens per
# constrained call site (cheap getenv); the string-building — which walks prog_to_fresh
# — is fully inside the Just branch, so it is zero-cost when the flag is off.
fn trace_dispatch(callee: String, class_name: String, prog_var: String,
                  prog_to_fresh: Dict types.Type, s3: Dict types.Type,
                  resolved: Maybe typed_ast.TypedExpr, path: String) -> Unit !{IO} =
  match env.get("SPROUT_TRACE_DISPATCH") with
  | Nothing -> ()
  | Just _ ->
      eprint("[dispatch] callee=" ++ callee ++ " class=" ++ class_name
             ++ " var=" ++ prog_var ++ " " ++ render_ptf_resolved(prog_to_fresh, s3)
             ++ " path=" ++ path ++ " -> " ++ resolved_head_str(class_name, resolved))

# resolve_obligation: the principled path for constrained regular-function dict injection.
# Uses prog_to_fresh (the instantiation mapping from programmer vars to fresh TVars) to
# find the concrete type for the constraint variable, then looks up the instance.
# Falls back to heuristic resolution if prog_var is not in prog_to_fresh (check2 path,
# or non-VarExpr callee) or if the constraint is still polymorphic after s3 is applied.
#
# When prog_var is absent from prog_to_fresh (mono-scheme call — recursive self-call
# inside a constrained fn body), resolve_via_fwd_for_prog_var is called so that the
# correct @fwd marker is found by prog_var rather than by first-TVar-arg heuristic.
# This matters when multiple constraints share a class (e.g. Eq a, Eq b): scanning by
# prog_var finds the right marker for each obligation independently.
#
# Returns (chosen dict, path tag). The path tag names the resolving branch for the
# SPROUT_TRACE_DISPATCH trace; `first_concrete_arg(guess)` marks the sole remaining
# order-dependent heuristic (the legitimate concrete-constructor case).
fn resolve_obligation(
  class_name: String,
  prog_var: ProgVarName,
  prog_to_fresh: Dict types.Type,
  s3: Dict types.Type,
  user_args: List typed_ast.TypedExpr,
  env: Dict types.Scheme,
  pos: source.SourcePos,
  excluded: List String
) -> (Maybe typed_ast.TypedExpr, String) =
  # Unwrap once at the entry — internal helpers (scan_ptf_for_prog_var,
  # resolve_via_fwd_for_prog_var) operate on raw String, both as dict keys
  # and as content compared against stored prog_var entries.
  match dict_get(prog_var_str(prog_var), prog_to_fresh) with
  | Nothing ->
      match scan_ptf_for_prog_var(class_name, prog_var_str(prog_var), prog_to_fresh, s3, env, pos, excluded) with
      | Just tdict -> (Just(tdict), "scan_ptf")
      | Nothing ->
          match resolve_via_fwd_for_prog_var(class_name, prog_var_str(prog_var), env, pos) with
          | Nothing ->
              # The constraint variable resolved to a type variable, not a concrete
              # head. It MUST forward the in-scope dict, never fall to
              # resolve_one_constraint_tdict's first-concrete-arg heuristic for a
              # forwardable var — that grabs an unrelated argument's instance (e.g.
              # vec_sort's `Ord a` mis-resolving to `Ord (Vec a)` off the `vec: Vec a`
              # argument, a soundness hole). The @fwd marker is keyed by the caller's
              # fresh var, not the callee's constraint var name, so scan the class's
              # forward marker directly. (Stage 3 positional identity makes the precise
              # Just-branch always hit for a well-formed @constrained marker, so the
              # order-dependent scan_prog_to_fresh_for_instance guess that used to sit
              # ahead of this scan was provably dead — 0 corpus events — and removed.)
              match scan_fwd_markers(class_name, env, pos) with
              | Just fwd_tdict -> (Just(fwd_tdict), "scan_fwd_markers")
              | Nothing -> (resolve_one_constraint_tdict(class_name, user_args, s3, env, pos, excluded), "first_concrete_arg(guess)")
          | fwd -> (fwd, "fwd_for_prog_var")
  | Just fresh_t -> resolve_precise_head(class_name, fresh_t, s3, user_args, env, pos)

# The `Just fresh_t` arm of resolve_obligation, extracted so resolve_obligation's
# top match stays a flat 2-branch dispatch rather than a nested staircase.
# prog_to_fresh maps this prog_var precisely to fresh_t: if it resolves to a
# concrete head with a bundled @inst, emit that dict; otherwise forward/scan.
fn resolve_precise_head(
  class_name: String,
  fresh_t: types.Type,
  s3: Dict types.Type,
  user_args: List typed_ast.TypedExpr,
  env: Dict types.Scheme,
  pos: source.SourcePos
) -> (Maybe typed_ast.TypedExpr, String) =
  match concrete_type_str(unifier.apply_subst(s3, fresh_t)) with
  | Just head_str ->
      # Trust the precise mapping even if head_str is in excluded — two distinct
      # prog_vars can legitimately map to the same concrete type; same dict.
      match dict_get("@inst:" ++ class_name ++ ":" ++ head_str, env) with
      | Just _ ->
          (Just(typed_ast.TDict(
            ast.TypeConstraint(class_name, Cons(type_to_typeexpr_with_prog_vars(unifier.apply_subst(s3, fresh_t), class_name, env), Nil)),
            types.TConst(types.type_id(class_name)), pos, typed_ast.EvUnresolved)), "precise-just")
      | Nothing ->
          (resolve_via_fwd_or_scan(class_name, user_args, s3, env, pos), "precise_no_inst->fwd_or_scan")
  | Nothing ->
      # Resolved to a bare type variable, not a concrete head — forward/scan
      # instead of a bogus @inst lookup.
      (resolve_via_fwd_or_scan(class_name, user_args, s3, env, pos), "precise_tyvar->fwd_or_scan")

# Decode a positional constraint-var token ("#pos:<k>", written by
# canonicalize_constrained_constraints) back to the callee's live generalized-scheme
# binder name, so resolve_obligation's precise prog_to_fresh lookup hits. The
# callee scheme in env is the generalized one at an external call site; its
# scheme_vars is exactly the binder list the position was computed against.
# Legacy (non-positional) name tokens pass through unchanged.
fn decode_constraint_var(token: String, callee: String, env: Dict types.Scheme) -> String =
  if str_starts_with(token, "#pos:")
  then
    match parse_int(str_slice(token, 5, str_len(token))) with
    | Just k ->
        match dict_get(callee, env) with
        | Just sch -> list_nth_or(types.scheme_vars(sch), k, token)
        | Nothing -> token
    | Nothing -> token
  else token

# §13.3(B): inject a constrained fn's hidden dicts from its Scheme constraint
# field — the single source of truth. Iterates the COMPLETE (head_token, class)
# list in where-clause order, so it injects one dict per constraint in order with
# no gap-truncation or positional-mapping-of-partial-dicts (the root of the mixed
# tyvar+concrete miscompile, BACKLOG #148). Each head_token resolves as: "#none" →
# a headless (class-only) obligation scanning the args; "#app:<Name>" → the same
# scan DIRECTED by the compound head; any other token → resolve_obligation with
# the decoded head var ("#pos:<k>" → the callee's scheme_vars binder; a plain name
# → itself, routing to the @fwd forwarding path for a recursion/forward-ref var).
fn inject_constrained_fn_dicts_via_field(
  name: String,
  constraints: List (String, String),
  prog_to_fresh: Dict types.Type,
  env: Dict types.Scheme,
  typed_callee: typed_ast.TypedExpr,
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  ret_t: types.Type,
  s3: Dict types.Type,
  es3: Dict types.Effect,
  call_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match constraints with
  | Nil ->
      InferOk(typed_ast.TCall(typed_callee, typed_args, ret_t, pos), s3, es3, call_eff)
  | Cons entry rest ->
      match entry with
      | (head_token, class_name) ->
          if is_arg_scanned_token(head_token) then
            # Resolve with s3 (post-argument-inference), not the stale pre-argument
            # `subst`. A compound-head constraint like `where ToString (Box a)`
            # finds its dict among the args; an inline parametric-record arg
            # carries its `a -> Int` binding only in s3, so the stale subst would
            # leave it `Box $free` and poison the dict (unresolved-thunk crash).
            # Mirrors the check_instance_for_marker fix. arg_scan_head supplies
            # the head when there is one, so the scan is directed rather than
            # positional.
            match resolve_arg_scanned_tdict(class_name, arg_scan_head(head_token), user_typed_args(typed_args), s3, env, pos, collect_injected_heads_for_class(class_name, typed_args)) with
            | Nothing ->
                inject_constrained_fn_dicts_via_field(name, rest, prog_to_fresh, env, typed_callee, typed_args, subst, ret_t, s3, es3, call_eff, pos)
            | Just tdict ->
                inject_constrained_fn_dicts_via_field(name, rest, prog_to_fresh, env, typed_callee, list_append(typed_args, Cons(tdict, Nil)), subst, ret_t, s3, es3, call_eff, pos)
          else
            match resolve_field_constraint(class_name, head_token, name, prog_to_fresh, s3, typed_args, env, pos) with
            | (resolved, path) ->
                do
                  _ <- trace_dispatch(name, class_name, head_token, prog_to_fresh, s3, resolved, path)
                  match resolved with
                  | Nothing ->
                      # An unresolved constraint whose head is a CONCRETE, non-skolem
                      # type with no instance is unsatisfiable — reject loudly at the
                      # call/construction site (spec §8; mirrors the class-method path's
                      # "No instance" error). Without this a constrained-existential
                      # `Shown(NoShow)` would drop its witness and surface only as a
                      # downstream codegen arity mismatch. A tyvar head (polymorphic,
                      # forwarded) or a skolem (re-pack, forwarded) still skips — that
                      # is the legitimate no-dict-here case, unchanged.
                      match concrete_unsatisfiable_head(class_name, head_token, name, prog_to_fresh, s3, env) with
                      | Just head_str -> InferErr(pos, "No instance of " ++ class_name ++ " for " ++ head_str)
                      | Nothing ->
                          inject_constrained_fn_dicts_via_field(name, rest, prog_to_fresh, env, typed_callee, typed_args, subst, ret_t, s3, es3, call_eff, pos)
                  | Just tdict ->
                      inject_constrained_fn_dicts_via_field(name, rest, prog_to_fresh, env, typed_callee, list_append(typed_args, Cons(tdict, Nil)), subst, ret_t, s3, es3, call_eff, pos)

# Returns Just(head) when the constraint's head resolves to a CONCRETE, non-skolem
# type that has no instance — an unsatisfiable obligation to reject. Returns Nothing
# for a type-variable head (polymorphic/forwarded) or a skolem (existential re-pack,
# forwarded): those are the legitimate "no dict injected here" cases. Only consulted
# on the resolve-Nothing path, so a Just here is a genuine hard miss.
fn concrete_unsatisfiable_head(class_name: String, head_token: String, name: String, prog_to_fresh: Dict types.Type, s3: Dict types.Type, env: Dict types.Scheme) -> Maybe String =
  match dict_get(decode_constraint_var(head_token, name, env), prog_to_fresh) with
  | Just fresh_t -> concrete_missing_inst(class_name, unifier.apply_subst(s3, fresh_t), env)
  | Nothing -> Nothing

fn concrete_missing_inst(class_name: String, t: types.Type, env: Dict types.Scheme) -> Maybe String =
  match concrete_type_str(t) with
  | Just head_str ->
      if types.is_skolem_name(head_str) then Nothing
      else match dict_get("@inst:" ++ class_name ++ ":" ++ head_str, env) with
           | Just _ -> Nothing
           | Nothing -> Just(head_str)
  | Nothing ->
      # `concrete_type_str` returns Nothing for BOTH a bare type variable
      # (forwardable — the legitimate no-dict-here case) AND a function type. A
      # function type can never satisfy a class: instance heads key on a type
      # constructor, so no `instance C (a -> b)` is representable or lookupable.
      # Split them here — a function-typed head is a hard, rigid miss, so report it
      # as unsatisfiable and reject loudly at the call site rather than dropping the
      # dict (→ codegen under-application) or letting a later pass mint a wrong
      # default dict (→ silent miscompile: a closure read via the wrong instance).
      match t with
      | types.TFunc _ _ _ _ -> Just("a function type")
      | _ -> Nothing

# Resolve one field constraint's dict from its head_token. A CONCRETE-ctor head
# (a plain type name with an `@inst:{class}:{head}` instance) resolves DIRECTLY by
# name — order-independent, fixing the first_concrete_arg misfire that dropped the
# dict when a non-container arg preceded the container (BACKLOG #148). Any other
# head (a "#pos:<k>" tyvar, or a name with no instance) decodes and falls to
# resolve_obligation exactly as the marker path did.
fn resolve_field_constraint(
  class_name: String,
  head_token: String,
  name: String,
  prog_to_fresh: Dict types.Type,
  s3: Dict types.Type,
  typed_args: List typed_ast.TypedExpr,
  env: Dict types.Scheme,
  pos: source.SourcePos
) -> (Maybe typed_ast.TypedExpr, String) =
  match resolve_concrete_head_tdict(class_name, head_token, env, pos) with
  | Just tdict -> (Just(tdict), "concrete_head")
  | Nothing ->
      resolve_obligation(class_name, ProgVarName(decode_constraint_var(head_token, name, env)), prog_to_fresh, s3, user_typed_args(typed_args), env, pos, collect_injected_heads_for_class(class_name, typed_args))

# A concrete-ctor constraint head resolves to its instance dict directly: the head
# name IS the instance key, so no argument-type guessing is needed. Returns Nothing
# when there is no such instance (the head is a tyvar or forwardable).
fn resolve_concrete_head_tdict(class_name: String, head_name: String, env: Dict types.Scheme, pos: source.SourcePos) -> Maybe typed_ast.TypedExpr =
  match dict_get("@inst:" ++ class_name ++ ":" ++ head_name, env) with
  | Just _ ->
      Just(typed_ast.TDict(
        ast.TypeConstraint(class_name, Cons(ast.TypeName(head_name), Nil)),
        types.TConst(types.type_id(class_name)), pos, typed_ast.EvUnresolved))
  | Nothing -> Nothing

# --- Forward marker helpers ---
#
# seed_forward_markers adds "@fwd:{fresh_var}:{class_name}" entries to env
# for each constraint, enabling polymorphic dispatch in check_instance_for_marker.
# prog_to_fresh maps programmer type-var names (e.g., "a") to their fresh
# instantiation TVars (e.g., TVar("a42")).
# These per-function @fwd: entries are NOT folded into the global env directly.
# Instead, extract_fwd_from_entries rewrites them to "@eta_fwd:" keys so lowering
# can locate the correct forwarded dict slot for value-position eta-expansion
# without colliding with resolve_via_fwd_for_prog_var's @fwd: scans.

fn seed_forward_markers(constraints: List ast.TypeConstraint, prog_to_fresh: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match constraints with
  | Nil -> env
  | Cons c rest ->
      seed_forward_markers(rest, prog_to_fresh, seed_one_constraint_marker(c, prog_to_fresh, env))

fn seed_one_constraint_marker(c: ast.TypeConstraint, prog_to_fresh: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match c with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> env
      | [head_te | _] ->
          let ast.TypeName prog_var = head_te else env
              Just fresh_t = dict_get(prog_var, prog_to_fresh) else env
              types.TVar fresh_name = fresh_t else env
          in
            # Wrap at the extraction site: prog_var is the user's
            # constraint-head name (e.g. "a") while fresh_name is the
            # compiler-generated instantiation name (e.g. "a42").
            # Store prog_var name in the scheme value for retrieval in check_instance_for_marker.
            # Also seed @fwd markers for any superclasses registered under @super:class_name:*.
            seed_fwd_with_supers(class_name, FreshTVarName(types.tyvar_identity(fresh_name)), ProgVarName(prog_var), env)

# Seed the direct @fwd marker and then transitively seed all superclass markers.
# fresh_name and prog_var are wrapped at the boundary: the @fwd:* key is built
# from FreshTVarName (compiler-generated, e.g. "a42") and the scheme value
# stores ProgVarName (user-written, e.g. "a") for later retrieval by
# scan_fwd_markers_for_prog_var.  Confusing the two would silently break
# cascade resolution — the wrap makes the swap a compile error here.
fn seed_fwd_with_supers(class_name: String, fresh_name: FreshTVarName, prog_var: ProgVarName, env: Dict types.Scheme) -> Dict types.Scheme =
  seed_superclass_fwd_markers(class_name, fresh_tvar_str(fresh_name), prog_var_str(prog_var),
    dict_set("@fwd:" ++ fresh_tvar_str(fresh_name) ++ ":" ++ class_name,
             types.mono(types.TConst(types.type_id(prog_var_str(prog_var)))), env))

# Seed @fwd markers for all superclasses of class_name.
# Scans env for "@super:{class_name}:{super_name}" entries and adds
# "@fwd:{fresh_name}:{super_name}" for each.
fn seed_superclass_fwd_markers(class_name: String, fresh_name: String, prog_var: String, env: Dict types.Scheme) -> Dict types.Scheme =
  seed_super_from_entries(class_name, fresh_name, prog_var, vec_to_list(dict_entries(env)), env)

fn seed_super_from_entries(class_name: String, fresh_name: String, prog_var: String, entries: List (String, types.Scheme), env: Dict types.Scheme) -> Dict types.Scheme =
  match entries with
  | Nil -> env
  | Cons entry rest ->
      match entry with
      | (key, _) ->
          if str_starts_with(key, "@super:" ++ class_name ++ ":")
          then seed_super_from_entries(class_name, fresh_name, prog_var, rest,
                 dict_set("@fwd:" ++ fresh_name ++ ":" ++ str_slice(key, str_len("@super:" ++ class_name ++ ":"), str_len(key)),
                          types.mono(types.TConst(types.type_id(prog_var))), env))
          else seed_super_from_entries(class_name, fresh_name, prog_var, rest, env)

# Computes the @eta_fwd:* markers that correspond to the @fwd:* entries
# seed_forward_markers seeds. Used by check_fn_body to thread markers to
# lowering without the old extract_fwd_markers(fwd_env) walk, which scanned
# the entire typecheck env per FnDecl regardless of constraint count — the
# dominant cost in self-compile (~32% of total time per `sample` profile).
# Constraint-free decls (~98% of stdlib) now pay zero cost here.
fn compute_eta_fwd_markers(constraints: List ast.TypeConstraint, prog_to_fresh: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  compute_eta_fwd_markers_acc(constraints, prog_to_fresh, env, dict_empty())

fn compute_eta_fwd_markers_acc(constraints: List ast.TypeConstraint, prog_to_fresh: Dict types.Type, env: Dict types.Scheme, markers: Dict types.Scheme) -> Dict types.Scheme =
  match constraints with
  | Nil -> markers
  | Cons c rest ->
      compute_eta_fwd_markers_acc(rest, prog_to_fresh, env, add_eta_for_constraint(c, prog_to_fresh, env, markers))

fn add_eta_for_constraint(c: ast.TypeConstraint, prog_to_fresh: Dict types.Type, env: Dict types.Scheme, markers: Dict types.Scheme) -> Dict types.Scheme =
  match c with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> markers
      | [head_te | _] ->
          let ast.TypeName prog_var = head_te else markers
              Just fresh_t = dict_get(prog_var, prog_to_fresh) else markers
              types.TVar fresh_name = fresh_t else markers
          in
            # Wrap at the extraction site (mirror of seed_one_constraint_marker):
            # the @eta_fwd:* key is built from FreshTVarName, and the scheme
            # value stores ProgVarName for lowering to retrieve.
            add_eta_with_supers(class_name, FreshTVarName(types.tyvar_identity(fresh_name)), ProgVarName(prog_var), env,
              dict_set("@eta_fwd:" ++ types.tyvar_identity(fresh_name) ++ ":" ++ class_name,
                       types.mono(types.TConst(types.type_id(prog_var))), markers))

# Boundary protection mirrors seed_fwd_with_supers — fresh_name and prog_var
# arrive wrapped, unwrap once for string concat used in the @eta_fwd:* key
# prefix and the scheme-value content.  See the wrap declarations above.
fn add_eta_with_supers(class_name: String, fresh_name: FreshTVarName, prog_var: ProgVarName, env: Dict types.Scheme, markers: Dict types.Scheme) -> Dict types.Scheme =
  add_eta_supers_from_entries(class_name, fresh_tvar_str(fresh_name), prog_var_str(prog_var), vec_to_list(dict_entries(env)), markers)

fn add_eta_supers_from_entries(class_name: String, fresh_name: String, prog_var: String, entries: List (String, types.Scheme), markers: Dict types.Scheme) -> Dict types.Scheme =
  match entries with
  | Nil -> markers
  | Cons entry rest ->
      match entry with
      | (key, _) ->
          if str_starts_with(key, "@super:" ++ class_name ++ ":")
          then add_eta_supers_from_entries(class_name, fresh_name, prog_var, rest,
                 dict_set("@eta_fwd:" ++ fresh_name ++ ":" ++ str_slice(key, str_len("@super:" ++ class_name ++ ":"), str_len(key)),
                          types.mono(types.TConst(types.type_id(prog_var))), markers))
          else add_eta_supers_from_entries(class_name, fresh_name, prog_var, rest, markers)

# --- Args accumulator ---

fn infer_args_acc(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  args: List ast.Expr,
  acc: List typed_ast.TypedExpr,
  acc_eff: types.Effect
) -> InferArgsResult !{IO} =
  match args with
  | Nil -> ArgsOk(typed_expr_list_reverse(acc), subst, eff_subst, acc_eff)
  | Cons arg rest ->
      do
        r <- infer_expr(state, env, subst, eff_subst, arg)
        match r with
        | InferErr pos e -> ArgsErr(pos, e)
        | InferOk typed_arg s1 es1 arg_eff ->
            infer_args_acc(state, env, s1, es1, rest, Cons(typed_arg, acc), merge_effects(acc_eff, arg_eff))

# Two-pass argument inference, for CALL arguments only (infer_tuple keeps the
# single-pass infer_args_acc: a tuple has no callee to resolve slots against).
#
# A lambda argument's parameter types are pinned by the callee's parameter slot,
# and that slot is usually fixed by a LATER argument -- `list_fold(step, seed, xs)`
# fixes the accumulator from `seed` and the element from `xs`.  Inferring every
# argument in source order left a lambda's parameters as unconstrained variables
# while its body was inferred, so a field access on one had no record type to
# resolve against (get_field_from_resolved falls back to a fresh variable, which
# check_arith then defaults to Int) and a class method on one had no instance to
# dispatch to (leaving an undefined direct call in the IR).
#
# Pass 1 infers the non-lambda arguments and unifies the resulting call shape
# against the callee's type; pass 2 infers each lambda with its parameter types
# read off the substituted slot.  Rust (`check_argument_types` loops
# `for check_closures in [false, true]`), C# (second-phase output type inference)
# and Kotlin (lambda bodies analysed only after the other arguments' constraints
# are in the constraint system) all order argument checking this way.
fn infer_call_args(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  callee_type: types.Type,
  args: List ast.Expr
) -> InferArgsResult !{IO} =
  do
    p1 <- infer_arg_slots(state, env, subst, eff_subst, args, Nil)
    match p1 with
    | SlotsErr pos e -> ArgsErr(pos, e)
    | SlotsOk slots s1 es1 ->
        # With no lambda argument there is no slot to resolve, and the push-down
        # would unify exactly what infer_call_resolve unifies moments later.  Skip
        # it, so such a call threads the same substitution and the same typed
        # arguments it did before two-pass inference.
        if ! has_lambda_slot (slots) then
          infer_lambda_slots(state, env, s1, es1, slots, Nil, types.EffectPure)
        else
          do
            ret <- unifier.fresh(state)
            infer_lambda_slots(state, env,
              push_down_arg_slots(s1, es1, callee_type, slots, types.TVar(types.tyvar_id(ret))),
              es1, slots, Nil, types.EffectPure)

# A bare `VarExpr` naming a constrained function, as its eta-lambda; anything else unchanged.
fn eta_expand_constrained_arg(e: ast.Expr, env: Dict types.Scheme) -> ast.Expr =
  let ast.VarExpr name pos = e else e
      Just scheme = dict_get(name, env) else e
      Just expanded = constrained_fn_eta(name, scheme, pos, env) else e
  in expanded

fn has_lambda_slot(slots: List ArgSlot) -> Bool =
  match slots with
  | Nil -> false
  | Cons slot rest ->
      match slot with
      | ArgLambda _ _ _ _ -> true
      | ArgDone _ _ -> has_lambda_slot(rest)

# Pass 1: infer every non-lambda argument in source order, holding each lambda
# back behind a fresh slot variable.
fn infer_arg_slots(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  args: List ast.Expr,
  acc: List ArgSlot
) -> ArgSlotsResult !{IO} =
  match args with
  | Nil -> SlotsOk(arg_slot_list_reverse(acc), subst, eff_subst)
  | Cons arg0 rest ->
      # Rewrite a bare mention of a constrained function into its eta-lambda HERE rather than in
      # infer_var, because this match is where an argument's fate is decided: a lambda is held back
      # and later typed against the callee's declared parameter, while everything else is inferred
      # eagerly with no expected type.  A dictionary resolved eagerly has only the constrained
      # function's own signature to go on, so it guesses from the return type — `apply1(label, 3)`
      # picked `ToString String`.  Arriving as a LambdaExpr instead puts it on the push-down path,
      # where `Int -> String` fixes the parameter before any dictionary is chosen.
      match eta_expand_constrained_arg(arg0, env) with
      | ast.LambdaExpr params body lpos ->
          do
            v <- unifier.fresh(state)
            infer_arg_slots(state, env, subst, eff_subst, rest,
              Cons(ArgLambda(params, body, types.TVar(types.tyvar_id(v)), lpos), acc))
      | arg ->
          do
            r <- infer_expr(state, env, subst, eff_subst, arg)
            match r with
            | InferErr pos e -> SlotsErr(pos, e)
            | InferOk typed_arg s1 es1 arg_eff ->
                infer_arg_slots(state, env, s1, es1, rest, Cons (ArgDone(typed_arg, arg_eff), acc))

# Resolve the lambda slots against the callee's type.  A genuine argument/callee
# mismatch is left for infer_call_resolve to report, so this keeps the existing
# "Call type mismatch" wording rather than surfacing a speculative failure.
fn push_down_arg_slots(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  callee_type: types.Type,
  slots: List ArgSlot,
  ret: types.Type
) -> Dict types.Type =
  # The effect substitution is deliberately NOT taken from here. This pass runs
  # BEFORE the held-back lambdas are inferred, so their slots are still bare type
  # variables with nothing but a pure placeholder arrow; any effect bound now
  # would be read off a lambda whose body has not been looked at. The real
  # binding happens in infer_call_resolve, after infer_lambda_slots has given
  # each lambda its actual arrow. Feeding the input still matters — it is what
  # lets an already-bound variable resolve during this unification.
  unifier.unified_subst(
    unifier.unify_types(subst, eff_subst, callee_type,
      build_fn_type_like(arg_slot_types(slots), unifier.apply_subst(subst, callee_type), ret)),
    subst)

fn arg_slot_types(slots: List ArgSlot) -> List types.Type =
  match slots with
  | Nil -> Nil
  | Cons slot rest ->
      match slot with
      | ArgDone typed_arg _ -> Cons(typed_ast.typed_expr_type(typed_arg), arg_slot_types(rest))
      | ArgLambda _ _ v _ -> Cons(v, arg_slot_types(rest))

# Pass 2: walk the slots in SOURCE order, inferring each held-back lambda against
# its now-resolved slot.  Source order matters for the effect merge -- merge_effects
# keeps its left operand when neither side is EffectPure or EffectIO.
fn infer_lambda_slots(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  slots: List ArgSlot,
  acc: List typed_ast.TypedExpr,
  acc_eff: types.Effect
) -> InferArgsResult !{IO} =
  match slots with
  | Nil -> ArgsOk(typed_expr_list_reverse(acc), subst, eff_subst, acc_eff)
  | Cons slot rest ->
      match slot with
      | ArgDone typed_arg arg_eff ->
          infer_lambda_slots(state, env, subst, eff_subst, rest,
            Cons(typed_arg, acc), merge_effects(acc_eff, arg_eff))
      | ArgLambda params body v lpos ->
          do
            r <- infer_lambda_expected(state, env, subst, eff_subst, params, body,
                   Just(unifier.apply_subst(subst, v)), lpos)
            match r with
            | InferErr pos e -> ArgsErr(pos, e)
            | InferOk typed_lam s1 es1 lam_eff ->
                infer_lambda_slots(state, env, s1, es1, rest,
                  Cons(typed_lam, acc), merge_effects(acc_eff, lam_eff))

fn arg_slot_list_reverse(xs: List ArgSlot) -> List ArgSlot = arg_slot_rev_acc(xs, Nil)

fn arg_slot_rev_acc(xs: List ArgSlot, acc: List ArgSlot) -> List ArgSlot =
  match xs with
  | Nil -> acc
  | Cons h t -> arg_slot_rev_acc(t, Cons(h, acc))

# --- Tuple ---

fn infer_tuple(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  elems: List ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    r <- infer_args_acc(state, env, subst, eff_subst, elems, Nil, types.EffectPure)
    match r with
    | ArgsErr pos e -> InferErr(pos, e)
    | ArgsOk typed_elems s1 es1 eff ->
        InferOk(
          typed_ast.TTuple(typed_elems,
            types.TTuple(list_map(\e -> typed_ast.typed_expr_type(e), typed_elems)), pos),
          s1, es1, eff)

# --- Binary ---

fn infer_binary(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  left: ast.Expr,
  right: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    lr <- infer_expr(state, env, subst, eff_subst, left)
    match lr with
    | InferErr pos e -> InferErr(pos, e)
    | InferOk typed_left s1 es1 l_eff ->
        do
          rr <- infer_expr(state, env, s1, es1, right)
          match rr with
          | InferErr pos e -> InferErr(pos, e)
          | InferOk typed_right s2 es2 r_eff ->
              infer_binary_op(state, env, s2, es2, op, typed_left, typed_right, merge_effects(l_eff, r_eff), pos)

fn infer_binary_op(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  if op == "+" || op == "-" || op == "*" || op == "/" then
    check_arith(subst, eff_subst, op, typed_left, typed_right, eff, pos)
  else if op == "<" || op == "<=" || op == ">" || op == ">=" then
    check_compare(subst, eff_subst, op, typed_left, typed_right, eff, pos)
  else if op == "==" || op == "!=" then
    check_eq(state, env, subst, eff_subst, op, typed_left, typed_right, eff, pos)
  else if op == "&&" || op == "||" then
    check_bool(subst, eff_subst, op, typed_left, typed_right, eff, pos)
  else if op == "++" then
    append_via_semigroup(env, typed_left, typed_right, subst, eff_subst, eff, pos)
  else
    InferOk(typed_ast.TBinary(op, typed_left, typed_right,
                              typed_ast.typed_expr_type(typed_left), pos),
            subst, eff_subst, eff)

# `++` dispatches to the Semigroup class method by IDENTITY, never through the
# value-namespace name `append` (which a user `fn append` shadows / evicts the
# `@class:append` marker — BACKLOG item 5b). Operands must share one Semigroup type
# `t`; the instance is selected by `t` directly (`@inst:Semigroup:{head}`), a key no
# user binding can clobber. Emits the same `TCall(append, [TDict, l, r])` node the old
# `a ++ b` -> `append(a, b)` desugar produced post-check, so codegen
# (translate_append_call: String/List peephole + Semigroup witness) is unchanged.
fn append_via_semigroup(
  env: Dict types.Scheme,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult =
  match unifier.unify_types(subst, eff_subst, typed_ast.typed_expr_type(typed_left), typed_ast.typed_expr_type(typed_right)) with
  | unifier.UnifyErr e -> InferErr(pos, "`++` needs matching Semigroup operands: " ++ e)
  | unifier.UnifyOk s1 es1 ->
      append_via_semigroup_at(unifier.apply_subst(s1, typed_ast.typed_expr_type(typed_left)),
                              env, typed_left, typed_right, s1, es1, eff, pos)

fn append_via_semigroup_at(
  t: types.Type,
  env: Dict types.Scheme,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  s1: Dict types.Type,
  eff_subst: Dict types.Effect,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult =
  match concrete_type_str(t) with
  | Just head_str ->
      match dict_get("@inst:Semigroup:" ++ head_str, env) with
      | Nothing -> InferErr(pos, "No Semigroup instance for " ++ head_str)
      | Just _ ->
          InferOk(
            typed_ast.TCall(typed_ast.TVar("append", t, pos),
              Cons(typed_ast.TDict(
                     ast.TypeConstraint("Semigroup", Cons(type_to_typeexpr_with_prog_vars(t, "Semigroup", env), Nil)),
                     types.TConst(types.type_id("Semigroup")), pos, typed_ast.EvUnresolved),
                   [typed_left, typed_right]),
              t, pos),
            s1, eff_subst, eff)
  | Nothing ->
      # Polymorphic operand (inside a generic fn with `where Semigroup t`): forward
      # the in-scope Semigroup witness, mirroring check_instance_for_marker's fwd path.
      #
      # Gated on the operand type, like the class-method sites. Ungated, a scan
      # that found ANY `@fwd:*:Semigroup` marker resolved `++` by dict order: with
      # two `Semigroup` constraints in scope, one fold ran with the other's
      # dictionary and String's `append` was applied to a `List` — a silent
      # miscompile, not a crash. Gating is only safe because
      # maybe_forward_input_dispatch repairs the lambda-parameter forwards that
      # the gate would otherwise leave dictionary-less.
      check_instance_fwd("Semigroup", typed_ast.TVar("append", t, pos),
                         [typed_left, typed_right], env, t, s1, eff_subst, eff, pos, Just(t))

fn check_arith(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  # Concrete-only, same-type numeric rule (docs/nn-gap-analysis.md §7.1):
  # unify the operands with each other first, then require the shared type be
  # Int or Double.  Int op Int -> Int; Double op Double -> Double; a mixed
  # Int/Double pair fails the operand unify (no implicit promotion).  `/` stays
  # in this set for Int (truncating) — the deliberate §7.3 divergence.
  match unifier.unify_types(subst, eff_subst, typed_ast.typed_expr_type(typed_left), typed_ast.typed_expr_type(typed_right)) with
  | unifier.UnifyErr e -> InferErr(pos, op ++ " needs matching numeric operands: " ++ e)
  | unifier.UnifyOk s1 es1 ->
      match unifier.unify_types(s1, es1, typed_ast.typed_expr_type(typed_left), types.type_int()) with
      | unifier.UnifyOk s2 es2 ->
          InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_int(), pos),
                  s2, es2, eff)
      | unifier.UnifyErr _ ->
          match unifier.unify_types(s1, es1, typed_ast.typed_expr_type(typed_left), types.type_double()) with
          | unifier.UnifyErr e -> InferErr(pos, op ++ " needs Int or Double operands: " ++ e)
          | unifier.UnifyOk s2 es2 ->
              InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_double(), pos),
                      s2, es2, eff)

fn check_compare(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  # Unify left and right with each other first, then check the result is
  # Int, Char, or Double.  Double comparison (e.g. `x < 0.0`) lowers to an
  # ordered fcmp in the IR (docs/nn-gap-analysis.md §7.1).
  match unifier.unify_types(subst, eff_subst, typed_ast.typed_expr_type(typed_left), typed_ast.typed_expr_type(typed_right)) with
  | unifier.UnifyErr e -> InferErr(pos, op ++ " needs matching types: " ++ e)
  | unifier.UnifyOk s1 es1 ->
      match unifier.unify_types(s1, es1, typed_ast.typed_expr_type(typed_left), types.type_int()) with
      | unifier.UnifyOk s2 es2 ->
          InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_bool(), pos),
                  s2, es2, eff)
      | unifier.UnifyErr _ ->
          match unifier.unify_types(s1, es1, typed_ast.typed_expr_type(typed_left), types.type_char()) with
          | unifier.UnifyOk s2 es2 ->
              InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_bool(), pos),
                      s2, es2, eff)
          | unifier.UnifyErr _ ->
              match unifier.unify_types(s1, es1, typed_ast.typed_expr_type(typed_left), types.type_double()) with
              | unifier.UnifyErr e -> InferErr(pos, op ++ " needs Int, Char, or Double: " ++ e)
              | unifier.UnifyOk s2 es2 ->
                  InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_bool(), pos),
                          s2, es2, eff)

fn is_primitive_eq_type(t: types.Type) -> Bool =
  match t with
  | types.TConst name ->
      # Double joins the direct-fcmp short-circuit: == -> oeq, != -> one (via
      # float_cmp_predicate), matching its already-wired ordering comparisons.
      types.type_id_name(name) == "Int" || types.type_id_name(name) == "Bool" || types.type_id_name(name) == "Char" || types.type_id_name(name) == "String" || types.type_id_name(name) == "Double"
  | _ -> false

fn eq_via_class_method(
  state: unifier.InferState,
  env: Dict types.Scheme,
  op: String,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match dict_get("eq", env) with
  | Nothing -> InferErr(pos, "internal: Eq.eq not in scope for " ++ op ++ " dispatch")
  | Just eq_scheme ->
      do
        callee_t <- unifier.instantiate(state, eq_scheme)
        let typed_callee = typed_ast.TVar("eq", callee_t, pos)
        v <- unifier.fresh(state)
        r <- infer_call_resolve(
          subst, eff_subst,
          callee_t,
          Cons(typed_ast.typed_expr_type(typed_left),
               Cons(typed_ast.typed_expr_type(typed_right), Nil)),
          types.TVar(types.tyvar_id(v)),
          eff,
          "'eq'",
          # Always two arguments, so the no-argument branch is unreachable here.
          false,
          pos)
        match r with
        | CallErr pos e -> InferErr(pos, op ++ " via Eq.eq: " ++ e)
        | CallOk ret_t s3 es3 call_eff ->
            do
              # prog_to_fresh = dict_empty(): the resolve_dispatch_typed_expr
              # post-pass concretizes the TDict evidence node after s2 makes the
              # type var concrete (PR #18 mechanism).
              call_result <- check_call_constraint(
                ast.VarExpr("eq", pos),
                typed_callee,
                [typed_left, typed_right],
                subst, env, ret_t, s3, es3, call_eff, pos,
                dict_empty())
              if op == "!=" then
                match call_result with
                | InferOk e s4 es4 e_eff ->
                    InferOk(typed_ast.TUnary("!", e, types.type_bool(), pos),
                            s4, es4, e_eff)
                | InferErr pos e -> InferErr(pos, e)
              else
                call_result

# Inference for ==/!=. Primitive operands (Int, Bool, Char, String) lower to
# direct TBinary so codegen emits icmp / str_eq; non-primitive types desugar
# to Eq.eq class-method calls so typeclass dispatch fires (!= wraps the
# resulting call in TUnary "!"). See BACKLOG line 184.
fn check_eq(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match unifier.unify_types(subst, eff_subst, typed_ast.typed_expr_type(typed_left), typed_ast.typed_expr_type(typed_right)) with
  | unifier.UnifyErr e -> InferErr(pos, op ++ " needs same types: " ++ e)
  | unifier.UnifyOk s1 es1 ->
      if is_primitive_eq_type(unifier.apply_subst(s1, typed_ast.typed_expr_type(typed_left))) then
        InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_bool(), pos),
                s1, es1, eff)
      else
        eq_via_class_method(state, env, op, typed_left, typed_right, s1, es1, eff, pos)

fn check_bool(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match unifier.unify_types(subst, eff_subst, typed_ast.typed_expr_type(typed_left), types.type_bool()) with
  | unifier.UnifyErr e -> InferErr(pos, op ++ " needs Bool: " ++ e)
  | unifier.UnifyOk s1 es1 ->
      match unifier.unify_types(s1, es1, typed_ast.typed_expr_type(typed_right), types.type_bool()) with
      | unifier.UnifyErr e -> InferErr(pos, op ++ " needs Bool: " ++ e)
      | unifier.UnifyOk s2 es2 ->
          InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_bool(), pos),
                  s2, es2, eff)

# --- Unary ---

fn infer_unary(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  operand: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    r <- infer_expr(state, env, subst, eff_subst, operand)
    match r with
    | InferErr pos e -> InferErr(pos, e)
    | InferOk typed_operand s1 es1 eff ->
        # `!` : Bool -> Bool and unary `-` : Int -> Int / Double -> Double are
        # compiler primitives with fixed operand types.  Constrain the operand
        # here; without it the operand type flows through unchecked and codegen
        # miscompiles — `! 3` lowers `xor i64, 1` over raw Int bits, yielding 2.
        if op == "!" then
          match unifier.unify_types(s1, es1, typed_ast.typed_expr_type(typed_operand), types.type_bool()) with
          | unifier.UnifyErr e -> InferErr(pos, "! (logical not) needs a Bool operand: " ++ e)
          | unifier.UnifyOk s2 es2 ->
              InferOk(typed_ast.TUnary(op, typed_operand, types.type_bool(), pos), s2, es2, eff)
        else if op == "-" then
          match unifier.unify_types(s1, es1, typed_ast.typed_expr_type(typed_operand), types.type_int()) with
          | unifier.UnifyOk s2 es2 ->
              InferOk(typed_ast.TUnary(op, typed_operand, types.type_int(), pos), s2, es2, eff)
          | unifier.UnifyErr _ ->
              match unifier.unify_types(s1, es1, typed_ast.typed_expr_type(typed_operand), types.type_double()) with
              | unifier.UnifyErr e -> InferErr(pos, "- (negation) needs an Int or Double operand: " ++ e)
              | unifier.UnifyOk s2 es2 ->
                  InferOk(typed_ast.TUnary(op, typed_operand, types.type_double(), pos), s2, es2, eff)
        else
          InferErr(pos, "unknown unary operator: " ++ op)

# --- Exhaustiveness checking ---

fn extract_adt_name(t: types.Type) -> Maybe String =
  match t with
  | types.TConst name -> Just(types.type_id_name(name))
  | types.TApp base _ -> extract_adt_name(base)
  | _ -> Nothing

fn is_catchall_pattern(pat: ast.Pattern) -> Bool =
  match pat with
  | ast.WildcardPattern _ -> true
  | ast.VarPattern _ _ -> true
  | _ -> false

# --- Exhaustiveness (W5): per-column value-space coverage ---------------------
#
# `covers(ty, column)` asks whether the patterns in one position ("column")
# exhaust the values of type `ty`.  A match is exhaustive iff its top-level
# branch patterns cover the scrutinee type.  The check is SOUND: it flags only
# genuine holes (a missing column value is a value no branch matches), never a
# valid match.  It over-accepts product gaps like `(true,true)|(false,false)`
# — deep nested-pattern subsumption is explicitly outside the v0 contract
# (spec §10.11); a full usefulness matrix is the deferred v1 end-state.

fn pats_have_catchall(pats: List ast.Pattern) -> Bool =
  match pats with
  | Nil -> false
  | Cons p rest -> if is_catchall_pattern(p) then true else pats_have_catchall(rest)

fn pats_have_bool(pats: List ast.Pattern, want: Bool) -> Bool =
  match pats with
  | Nil -> false
  | Cons p rest ->
      match p with
      | ast.BoolPattern b _ -> if b == want then true else pats_have_bool(rest, want)
      | _ -> pats_have_bool(rest, want)

fn pats_have_unit(pats: List ast.Pattern) -> Bool =
  match pats with
  | Nil -> false
  | Cons p rest ->
      match p with
      | ast.UnitPattern _ -> true
      | _ -> pats_have_unit(rest)

# Bool is a two-value domain; covered iff both true and false appear.
fn bool_gap(pats: List ast.Pattern) -> Maybe String =
  if pats_have_bool(pats, true) == false then Just("true")
  else if pats_have_bool(pats, false) == false then Just("false")
  else Nothing

fn ctor_display(name: String) -> String = string.after_last_dot(name)

# Subpattern-lists of every branch whose head constructor is `name`.
fn ctor_branch_subpats(name: String, pats: List ast.Pattern) -> List (List ast.Pattern) =
  match pats with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.ConstructorPattern n subs _ ->
          if string.after_last_dot(n) == string.after_last_dot(name)
          then Cons(subs, ctor_branch_subpats(name, rest))
          else ctor_branch_subpats(name, rest)
      | _ -> ctor_branch_subpats(name, rest)

fn tuple_branch_subpats(pats: List ast.Pattern) -> List (List ast.Pattern) =
  match pats with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.TuplePattern subs _ -> Cons(subs, tuple_branch_subpats(rest))
      | _ -> tuple_branch_subpats(rest)

# Column i across a set of equal-arity rows: the head of each row, and the tails.
fn column_heads(rows: List (List ast.Pattern)) -> List ast.Pattern =
  match rows with
  | Nil -> Nil
  | Cons row rest ->
      match row with
      | Nil -> column_heads(rest)
      | [h | _] -> Cons(h, column_heads(rest))

fn column_tails(rows: List (List ast.Pattern)) -> List (List ast.Pattern) =
  match rows with
  | Nil -> Nil
  | Cons row rest ->
      match row with
      | Nil -> column_tails(rest)
      | Cons _ t -> Cons(t, column_tails(rest))


# Field types of constructor `name` when its result is `adt_type`.  Mirrors
# infer_ctor_pattern_typed: instantiate the ctor scheme, unify its result with
# the scrutinee type to bind the type arguments, read the parameter types.
fn ctor_field_types(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  name: String,
  adt_type: types.Type
) -> Maybe (List types.Type) !{IO} =
  match dict_get(name, env) with
  | Nothing -> Nothing
  | Just scheme ->
      do
        ctor_type <- unifier.instantiate(state, scheme)
        # no_effect_subst: exhaustiveness column expansion, which asks only what
        # the constructor's field types are. Its result never reaches an effect.
        match unifier.unify_types(subst, unifier.no_effect_subst(), adt_type, ctor_result_type(ctor_type)) with
        | unifier.UnifyErr _ -> Nothing
        | unifier.UnifyOk s1 _ -> Just(unifier.apply_subst_list(s1, ctor_param_types(ctor_type)))

# Are all field columns of a constructor covered?  Returns the first gap, if any.
fn columns_covered(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  ctor_map: Dict (List String),
  field_types: List types.Type,
  rows: List (List ast.Pattern)
) -> Maybe String !{IO} =
  match field_types with
  | Nil -> Nothing
  | Cons ft ft_rest ->
      # Match the Maybe-!{IO} result directly: a do-block `<-` bind would strip
      # the Maybe layer (project_do_block_result_io_quirk) and misparse below.
      match coverage_gap(state, env, subst, ctor_map, ft, column_heads(rows)) with
      | Just w -> Just(w)
      | Nothing -> columns_covered(state, env, subst, ctor_map, ft_rest, column_tails(rows))

# Nothing = the patterns cover `ty`; Just witness = a value none of them match.
fn coverage_gap(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  ctor_map: Dict (List String),
  ty: types.Type,
  pats: List ast.Pattern
) -> Maybe String !{IO} =
  if pats_have_catchall(pats) then Nothing
  else coverage_gap_resolved(state, env, subst, ctor_map, unifier.apply_subst(subst, ty), pats)

fn coverage_gap_resolved(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  ctor_map: Dict (List String),
  rty: types.Type,
  pats: List ast.Pattern
) -> Maybe String !{IO} =
  match rty with
  | types.TConst name -> coverage_gap_const(state, env, subst, ctor_map, types.type_id_name(name), rty, pats)
  | types.TApp _ _ -> coverage_gap_adt(state, env, subst, ctor_map, rty, pats)
  | types.TTuple elems -> tuple_gap(state, env, subst, ctor_map, elems, pats)
  # TVar / TFunc / records / anything unresolved: accept (never reject the
  # unanticipated — preserves the historical Nothing-means-exhaustive bias).
  | _ -> Nothing

fn coverage_gap_const(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  ctor_map: Dict (List String),
  name: String,
  rty: types.Type,
  pats: List ast.Pattern
) -> Maybe String !{IO} =
  if name == "Bool" then bool_gap(pats)
  else if name == "Unit" then (if pats_have_unit(pats) then Nothing else Just("()"))
  # Infinite literal domains are exhaustive only via a catch-all (handled above).
  else if name == "Int" then Just("an Int not matched by the listed literals (add a catch-all)")
  else if name == "String" then Just("a String not matched by the listed literals (add a catch-all)")
  else if name == "Char" then Just("a Char not matched by the listed literals (add a catch-all)")
  else coverage_gap_adt(state, env, subst, ctor_map, rty, pats)

fn coverage_gap_adt(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  ctor_map: Dict (List String),
  rty: types.Type,
  pats: List ast.Pattern
) -> Maybe String !{IO} =
  match extract_adt_name(rty) with
  | Nothing -> Nothing
  | Just adt_name ->
      # ctor_map is keyed by bare type name (build_ctor_map), matching the bare
      # names extract_adt_name yields, so a direct lookup resolves every ADT.
      match dict_get(adt_name, ctor_map) with
      | Nothing -> Nothing
      | Just all_ctors -> adt_gap(state, env, subst, ctor_map, all_ctors, rty, pats)

fn adt_gap(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  ctor_map: Dict (List String),
  all_ctors: List String,
  rty: types.Type,
  pats: List ast.Pattern
) -> Maybe String !{IO} =
  match all_ctors with
  | Nil -> Nothing
  | Cons c rest ->
      match ctor_branch_subpats(c, pats) with
      # Constructor never mentioned -> not covered.
      | Nil -> Just(ctor_display(c))
      | Cons row0 rows_rest ->
          # Match Maybe-!{IO} results directly (do-bind would strip the Maybe).
          match ctor_field_types(state, env, subst, c, rty) with
          # Field types unresolvable (e.g. missing scheme): conservatively treat
          # this constructor as covered and move on.
          | Nothing -> adt_gap(state, env, subst, ctor_map, rest, rty, pats)
          | Just fts ->
              match columns_covered(state, env, subst, ctor_map, fts, Cons(row0, rows_rest)) with
              | Just w -> Just(ctor_display(c) ++ "(" ++ w ++ ")")
              | Nothing -> adt_gap(state, env, subst, ctor_map, rest, rty, pats)

fn tuple_gap(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  ctor_map: Dict (List String),
  elem_types: List types.Type,
  pats: List ast.Pattern
) -> Maybe String !{IO} =
  match tuple_branch_subpats(pats) with
  | Nil -> Just("a tuple value not matched")
  | Cons row0 rows_rest ->
      match columns_covered(state, env, subst, ctor_map, elem_types, Cons(row0, rows_rest)) with
      | Just w -> Just("(" ++ w ++ ")")
      | Nothing -> Nothing

fn branch_pats(branches: List typed_ast.TypedMatchBranch) -> List ast.Pattern =
  match branches with
  | Nil -> Nil
  | Cons b rest ->
      match b with
      | typed_ast.TypedMatchBranch pat _ -> Cons(pat, branch_pats(rest))

fn exhaustiveness_check(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  ctor_map: Dict (List String),
  scrut_type: types.Type,
  branches: List typed_ast.TypedMatchBranch
) -> Maybe String !{IO} =
  match coverage_gap(state, env, subst, ctor_map, rty, branch_pats(branches)) with
  | Nothing -> Nothing
  | Just w ->
      Just("Non-exhaustive match on " ++ types.type_to_string(rty) ++
           " — no branch matches " ++ w)
  where rty = unifier.apply_subst(subst, scrut_type)

# --- Unreachable branches (W5): spec §10.12 top-level contract ----------------
#
# A branch is unreachable when the branches BEFORE it already handle every value
# it could match.  Per the v0 contract (spec lines 176-181) this covers exactly:
# shadowed by an earlier catch-all, a repeated top-level literal, a repeat of a
# constructor already fully covered, or any branch after all constructors are
# covered.  Deeper nested subsumption is out of scope.

fn all_catchall(subs: List ast.Pattern) -> Bool =
  match subs with
  | Nil -> true
  | Cons s rest -> if is_catchall_pattern(s) then all_catchall(rest) else false

fn is_literal_pattern(p: ast.Pattern) -> Bool =
  match p with
  | ast.IntPattern _ _ -> true
  | ast.BoolPattern _ _ -> true
  | ast.StringPattern _ _ -> true
  | ast.CharPattern _ _ -> true
  | ast.UnitPattern _ -> true
  | _ -> false

fn same_literal(a: ast.Pattern, b: ast.Pattern) -> Bool =
  match a with
  | ast.IntPattern x _ -> (match b with | ast.IntPattern y _ -> x == y | _ -> false)
  | ast.BoolPattern x _ -> (match b with | ast.BoolPattern y _ -> x == y | _ -> false)
  | ast.StringPattern x _ -> (match b with | ast.StringPattern y _ -> x == y | _ -> false)
  | ast.CharPattern x _ -> (match b with | ast.CharPattern y _ -> x == y | _ -> false)
  | ast.UnitPattern _ -> (match b with | ast.UnitPattern _ -> true | _ -> false)
  | _ -> false

fn literal_in(prefix: List ast.Pattern, pat: ast.Pattern) -> Bool =
  match prefix with
  | Nil -> false
  | Cons p rest -> if same_literal(p, pat) then true else literal_in(rest, pat)

fn prefix_has_full_ctor(prefix: List ast.Pattern, name: String) -> Bool =
  match prefix with
  | Nil -> false
  | Cons p rest ->
      match p with
      | ast.ConstructorPattern n subs _ ->
          if string.after_last_dot(n) == string.after_last_dot(name) then
            (if all_catchall(subs) then true else prefix_has_full_ctor(rest, name))
          else prefix_has_full_ctor(rest, name)
      | _ -> prefix_has_full_ctor(rest, name)

fn ctor_fully_covered_in(prefix: List ast.Pattern, pat: ast.Pattern) -> Bool =
  match pat with
  | ast.ConstructorPattern name _ _ -> prefix_has_full_ctor(prefix, name)
  | _ -> false

fn pat_pos(p: ast.Pattern) -> source.SourcePos =
  match p with
  | ast.WildcardPattern pos -> pos
  | ast.VarPattern _ pos -> pos
  | ast.IntPattern _ pos -> pos
  | ast.BoolPattern _ pos -> pos
  | ast.StringPattern _ pos -> pos
  | ast.CharPattern _ pos -> pos
  | ast.UnitPattern pos -> pos
  | ast.TuplePattern _ pos -> pos
  | ast.ConstructorPattern _ _ pos -> pos

# Sound TOP-LEVEL coverage for the unreachability check.  Unlike exhaustiveness
# (which may over-accept product gaps like `(true,true)|(false,false)`), this
# must never OVER-claim coverage — an over-claim would flag a reachable branch
# as dead (e.g. unify_applied's final `_` after per-column-"covered" tuple
# patterns).  So it uses only sound top-level signals, with NO per-column
# recursion: Bool by both literals, Unit by a unit pattern, an ADT by an
# all-catch-all branch per constructor, a tuple by an all-wildcard tuple
# pattern.  Nested/product unreachability is intentionally out of scope — spec
# v0 §10.12 restricts the unreachable-branch contract to the top level.

fn prefix_has_full_tuple(prefix: List ast.Pattern) -> Bool =
  match prefix with
  | Nil -> false
  | Cons p rest ->
      match p with
      | ast.TuplePattern subs _ -> if all_catchall(subs) then true else prefix_has_full_tuple(rest)
      | _ -> prefix_has_full_tuple(rest)

fn all_ctors_covered(ctors: List String, prefix: List ast.Pattern) -> Bool =
  match ctors with
  | Nil -> true
  | Cons c rest -> if prefix_has_full_ctor(prefix, c) then all_ctors_covered(rest, prefix) else false

fn adt_all_ctors_covered(ctor_map: Dict (List String), adt_name: String, prefix: List ast.Pattern) -> Bool =
  match dict_get(adt_name, ctor_map) with
  | Nothing -> false
  | Just ctors -> all_ctors_covered(ctors, prefix)

fn prefix_covers_toplevel(ctor_map: Dict (List String), scrut_type: types.Type, prefix: List ast.Pattern) -> Bool =
  match scrut_type with
  | types.TConst name ->
      if types.type_id_name(name) == "Bool" then
        (if pats_have_bool(prefix, true) then pats_have_bool(prefix, false) else false)
      else if types.type_id_name(name) == "Unit" then pats_have_unit(prefix)
      else adt_all_ctors_covered(ctor_map, types.type_id_name(name), prefix)
  | types.TApp _ _ ->
      match extract_adt_name(scrut_type) with
      | Nothing -> false
      | Just nm -> adt_all_ctors_covered(ctor_map, nm, prefix)
  | types.TTuple _ -> prefix_has_full_tuple(prefix)
  | _ -> false

# A branch is dead if its own shape is already handled: a repeated top-level
# literal, or a constructor an earlier branch already fully covers.
fn structurally_shadowed(prefix: List ast.Pattern, pat: ast.Pattern) -> Bool =
  if is_literal_pattern(pat) then literal_in(prefix, pat)
  else ctor_fully_covered_in(prefix, pat)

fn branch_is_unreachable(ctor_map: Dict (List String), scrut_type: types.Type, prefix: List ast.Pattern, pat: ast.Pattern) -> Bool =
  # (1) shadowed by an earlier catch-all; (2) repeated literal / fully-covered
  # constructor; (3) after the scrutinee is already fully covered (top-level).
  if pats_have_catchall(prefix) then true
  else if structurally_shadowed(prefix, pat) then true
  else prefix_covers_toplevel(ctor_map, scrut_type, prefix)

fn unreachable_walk(ctor_map: Dict (List String), scrut_type: types.Type, prefix: List ast.Pattern, remaining: List typed_ast.TypedMatchBranch) -> Maybe (String, source.SourcePos) =
  match remaining with
  | Nil -> Nothing
  | Cons b rest ->
      match b with
      | typed_ast.TypedMatchBranch pat _ ->
          if branch_is_unreachable(ctor_map, scrut_type, prefix, pat)
          then Just(("Unreachable match branch", pat_pos(pat)))
          # Prepend, not append: every prefix consumer is an order-independent
          # membership scan, so O(1) Cons beats O(n) list_append per branch.
          else unreachable_walk(ctor_map, scrut_type, Cons(pat, prefix), rest)

fn unreachable_check(subst: Dict types.Type, ctor_map: Dict (List String), scrut_type: types.Type, branches: List typed_ast.TypedMatchBranch) -> Maybe (String, source.SourcePos) =
  unreachable_walk(ctor_map, unifier.apply_subst(subst, scrut_type), Nil, branches)

# --- Match ---

fn infer_match(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  scrutinee: ast.Expr,
  branches: List ast.MatchBranch,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    sr <- infer_expr(state, env, subst, eff_subst, scrutinee)
    match sr with
    | InferErr pos e -> InferErr(pos, e)
    | InferOk typed_scrut s1 es1 scrut_eff ->
        do
          v <- unifier.fresh(state)
          infer_branches(state, env, s1, es1, typed_scrut, types.TVar(types.tyvar_id(v)), branches, Nil, scrut_eff, pos)

fn infer_branches(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  typed_scrut: typed_ast.TypedExpr,
  ret_type: types.Type,
  branches: List ast.MatchBranch,
  acc_branches: List typed_ast.TypedMatchBranch,
  acc_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match branches with
  | Nil ->
      do
        let reversed = typed_branch_list_reverse(acc_branches)
        ctor_map <- unifier.get_ctor_map(state)
        let scrut_ty = typed_ast.typed_expr_type(typed_scrut)
        # Match these Maybe-!{IO} checks directly: a `<-` bind would strip the
        # Maybe layer (project_do_block_result_io_quirk).
        match exhaustiveness_check(state, env, subst, ctor_map, scrut_ty, reversed) with
        | Just err -> InferErr(pos, err)
        | Nothing ->
            match unreachable_check(subst, ctor_map, scrut_ty, reversed) with
            | Just (msg, upos) -> InferErr(upos, msg)
            | Nothing ->
                InferOk(
                  typed_ast.TMatch(typed_scrut, reversed, unifier.apply_subst(subst, ret_type), pos),
                  subst, eff_subst, acc_eff)
  | Cons branch rest ->
      match branch with
      | ast.MatchBranch pat _ ->
          do
            br <- infer_branch(state, env, subst, eff_subst,
                               typed_ast.typed_expr_type(typed_scrut), ret_type, branch)
            match br with
            | InferErr pos e -> InferErr(pos, e)
            | InferOk typed_body s1 es1 branch_eff ->
                infer_branches(state, env, s1, es1, typed_scrut,
                               unifier.apply_subst(s1, ret_type),
                               rest,
                               Cons(typed_ast.TypedMatchBranch(pat, typed_body), acc_branches),
                               merge_effects(acc_eff, branch_eff), pos)

fn infer_branch(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  scrut_type: types.Type,
  ret_type: types.Type,
  branch: ast.MatchBranch
) -> InferResult !{IO} =
  match branch with
  | ast.MatchBranch pat body ->
      do
        pr <- infer_pattern(state, env, subst, eff_subst, scrut_type, pat)
        match pr with
        | InferErr pos e -> InferErr(pos, e)
        | InferOk _ s1 es1 _ ->
            # extend_env_with_existential_givens seeds @fwd markers for any packed
            # existential dict the pattern unpacks (Stage 0b), keyed by the skolem so
            # a class method on the unpacked value forwards the packed witness rather
            # than searching global instances (which have none for a skolem).
            infer_branch_body(state,
              extend_env_with_existential_givens(pat, s1, extend_env_from_pattern(pat, s1, env)),
              s1, es1, ret_type, body)

fn infer_branch_body(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  ret_type: types.Type,
  body: ast.Expr
) -> InferResult !{IO} =
  do
    br <- infer_expr(state, env, subst, eff_subst, body)
    match br with
    | InferErr pos e -> InferErr(pos, e)
    | InferOk typed_body s2 es2 body_eff ->
        infer_branch_unify(s2, es2, typed_body, ret_type, body_eff)

fn infer_branch_unify(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  typed_body: typed_ast.TypedExpr,
  ret_type: types.Type,
  body_eff: types.Effect
) -> InferResult !{IO} =
  match unifier.unify_types(subst, eff_subst, typed_ast.typed_expr_type(typed_body), ret_type) with
  | unifier.UnifyErr e -> InferErr(typed_ast.typed_expr_pos(typed_body), "Match branch type mismatch: " ++ e)
  | unifier.UnifyOk s3 es3 ->
      InferOk(typed_body, s3, es3, unifier.apply_effect_subst(es3, body_eff))

# --- Pattern inference ---
#
# Patterns do not produce meaningful TypedExprs; callers always discard the
# first field of InferOk.  We return a dummy TUnit carrying the pattern type.

export fn infer_pattern(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  pat: ast.Pattern
) -> InferResult !{IO} =
  match pat with
  | ast.WildcardPattern _ ->
      InferOk(typed_ast.TUnit(expected, no_pos()), subst, eff_subst, types.EffectPure)
  | ast.VarPattern name _ ->
      InferOk(typed_ast.TUnit(expected, no_pos()), dict_set(name, expected, subst), eff_subst, types.EffectPure)
  | ast.IntPattern _ pos ->
      check_pattern_type(pos, subst, eff_subst, expected, types.type_int(), "Int")
  | ast.BoolPattern _ pos ->
      check_pattern_type(pos, subst, eff_subst, expected, types.type_bool(), "Bool")
  | ast.StringPattern _ pos ->
      check_pattern_type(pos, subst, eff_subst, expected, types.type_string(), "String")
  | ast.CharPattern _ pos ->
      check_pattern_type(pos, subst, eff_subst, expected, types.type_char(), "Char")
  | ast.UnitPattern pos ->
      check_pattern_type(pos, subst, eff_subst, expected, types.TConst(types.type_id("Unit")), "Unit")
  | ast.TuplePattern pats pos ->
      infer_tuple_pattern(pos, state, env, subst, eff_subst, expected, pats)
  | ast.ConstructorPattern name fields pos ->
      infer_ctor_pattern(pos, state, env, subst, eff_subst, expected, name, fields)

fn check_pattern_type(
  pos: source.SourcePos,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  expected_type: types.Type,
  label: String
) -> InferResult !{IO} =
  match unifier.unify_types(subst, eff_subst, expected, expected_type) with
  | unifier.UnifyErr e -> InferErr(pos, label ++ " pattern: " ++ e)
  | unifier.UnifyOk s1 es1 ->
      InferOk(typed_ast.TUnit(expected_type, no_pos()), s1, es1, types.EffectPure)

fn infer_tuple_pattern(
  pos: source.SourcePos,
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  pats: List ast.Pattern
) -> InferResult !{IO} =
  do
    elem_vars <- make_fresh_var_list(state, pats)
    infer_tuple_pattern_unified(pos, state, env, subst, eff_subst, expected, elem_vars, pats)

fn infer_tuple_pattern_unified(
  pos: source.SourcePos,
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  elem_vars: List types.Type,
  pats: List ast.Pattern
) -> InferResult !{IO} =
  match unifier.unify_types(subst, eff_subst, expected, types.TTuple(elem_vars)) with
  | unifier.UnifyErr e -> InferErr(pos, "Tuple pattern: " ++ e)
  | unifier.UnifyOk s1 es1 ->
      check_pattern_list(pos, state, env, s1, es1, elem_vars, pats)

fn make_fresh_var_list(state: unifier.InferState, pats: List ast.Pattern) -> List types.Type !{IO} =
  match pats with
  | Nil -> Nil
  | Cons _ rest ->
      do
        v <- unifier.fresh(state)
        rest_vars <- make_fresh_var_list(state, rest)
        Cons(types.TVar(types.tyvar_id(v)), rest_vars)

fn check_pattern_list(
  pos: source.SourcePos,
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected_list: List types.Type,
  pats: List ast.Pattern
) -> InferResult !{IO} =
  match (expected_list, pats) with
  | (Nil, Nil) ->
      InferOk(typed_ast.TUnit(types.TConst(types.type_id("Unit")), no_pos()), subst, eff_subst, types.EffectPure)
  | (Cons exp_h exp_rest, Cons pat_h pat_rest) ->
      do
        r <- infer_pattern(state, env, subst, eff_subst, exp_h, pat_h)
        match r with
        | InferErr epos e -> InferErr(epos, e)
        | InferOk _ s1 es1 _ ->
            check_pattern_list(pos, state, env, s1, es1, exp_rest, pat_rest)
  | _ -> InferErr(pos, "Tuple pattern arity mismatch")

fn infer_ctor_pattern(
  pos: source.SourcePos,
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  name: String,
  fields: List ast.Pattern
) -> InferResult !{IO} =
  match dict_get(name, env) with
  | Nothing -> InferErr(pos, "Unknown constructor: " ++ name)
  | Just scheme ->
      do
        # Pattern position: existential vars in the ctor scheme become rigid
        # skolems (see instantiate_ctor_pattern), unlike the expression/pack path
        # which hides them as flexible unknowns. docs/gadts-v0.md §6/§7.
        ctor_type <- unifier.instantiate_ctor_pattern(state, scheme)
        infer_ctor_pattern_typed(pos, state, env, subst, eff_subst, expected, name, fields, ctor_type)

fn infer_ctor_pattern_typed(
  pos: source.SourcePos,
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  name: String,
  fields: List ast.Pattern,
  ctor_type: types.Type
) -> InferResult !{IO} =
  match unifier.unify_types(subst, eff_subst, expected, ctor_result_type(ctor_type)) with
  | unifier.UnifyErr e -> InferErr(pos, "Constructor " ++ name ++ ": " ++ e)
  | unifier.UnifyOk s1 es1 ->
      check_pattern_list(pos, state, env, s1, es1, ctor_param_types(ctor_type), fields)

fn ctor_result_type(t: types.Type) -> types.Type =
  match t with
  | types.TFunc _ ret _ _ -> ctor_result_type(ret)
  | _ -> t

# Declared return type of a function with `n_params` parameters: strip exactly
# `n_params` leading arrows. Preserves a function-typed return (e.g. -> Int -> Int),
# unlike ctor_result_type which strips all arrows (correct only for constructors).
fn fn_return_type(t: types.Type, n_params: Int) -> types.Type =
  if n_params <= 0 then t
  else match t with
    | types.TFunc _ ret _ _ -> fn_return_type(ret, n_params - 1)
    | _ -> t

fn ctor_param_types(t: types.Type) -> List types.Type =
  match t with
  | types.TFunc p rest _ _ -> Cons(p, ctor_param_types(rest))
  | _ -> Nil

# ---------------------------------------------------------------------------
# Extend environment from a pattern's bound variables
# ---------------------------------------------------------------------------

export fn extend_env_from_pattern(pat: ast.Pattern, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match pat with
  | ast.VarPattern name _ ->
      bind_local_scheme(name, types.mono(unifier.apply_subst(subst, types.TVar(types.tyvar_id(name)))), env)
  | ast.TuplePattern pats _ -> extend_env_from_pattern_list(pats, subst, env)
  | ast.ConstructorPattern _ fields _ -> extend_env_from_pattern_list(fields, subst, env)
  | _ -> env

fn extend_env_from_pattern_list(pats: List ast.Pattern, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match pats with
  | Nil -> env
  | Cons h t -> extend_env_from_pattern_list(t, subst, extend_env_from_pattern(h, subst, env))

# Stage 0b: seed the pattern-provided "given" dictionaries for a constrained
# existential (docs/gadts-v0.md §5b/§7). Unpacking `Shown x` (from `Shown (any
# ToString)`) binds `x` at a rigid skolem `$sk<n>` that has no global ToString
# instance; the witness travels INSIDE the box. We recover the skolem off `subst`
# (the same `s1` that binds `x`, so both ends agree by construction) and seed
# `@fwd:{skolem}:{class}` — the identical marker a `where C a` function seeds via
# seed_forward_markers — so `to_string(x)` in the branch resolves the packed
# witness through the standard forward path. Recurses into tuple/ctor sub-patterns
# so `(Shown x, ...)` is handled; nested existentials use the same s1.
fn extend_env_with_existential_givens(pat: ast.Pattern, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match pat with
  | ast.ConstructorPattern name fields _ ->
      extend_env_givens_list(fields, subst, seed_ctor_givens(name, fields, subst, env))
  | ast.TuplePattern pats _ -> extend_env_givens_list(pats, subst, env)
  | _ -> env

fn extend_env_givens_list(pats: List ast.Pattern, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match pats with
  | Nil -> env
  | Cons h t -> extend_env_givens_list(t, subst, extend_env_with_existential_givens(h, subst, env))

fn seed_ctor_givens(name: String, fields: List ast.Pattern, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match dict_get(name, env) with
  | Just scheme ->
      seed_existential_givens(types.scheme_constraints(scheme),
                              ctor_param_types(types.scheme_type(scheme)), fields, subst, env)
  | Nothing -> env

# For each existential constraint (var, class) of the matched constructor, find the
# field whose type is that var, read the skolem bound to the corresponding pattern
# variable, and seed `@fwd:{skolem}:{class}`. A wildcard/non-var field or a
# non-skolem binding (defensive) is skipped — nothing can call a method on it.
fn seed_existential_givens(
  constraints: List (String, String),
  param_types: List types.Type,
  fields: List ast.Pattern,
  subst: Dict types.Type,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  match constraints with
  | Nil -> env
  | Cons entry rest ->
      match entry with
      | (var, class_name) ->
          seed_existential_givens(rest, param_types, fields, subst,
            seed_one_given(var, class_name, param_types, fields, subst, env))

fn seed_one_given(var: String, class_name: String, param_types: List types.Type, fields: List ast.Pattern, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match field_and_declared_for_var(param_types, fields, var) with
  | Just (ast.VarPattern vname _, declared_pt) ->
      match skolem_for_var_in(declared_pt, unifier.apply_subst(subst, types.TVar(types.tyvar_id(vname))), var) with
      | Just sk -> seed_given_for_skolem(class_name, vname, sk, env)
      | Nothing -> env
  | _ -> env

# Key the given marker by the SKOLEM (so a method call on the unpacked value, whose
# arg type IS the skolem, finds it) but store the STABLE forwarding identity
# `$ex_<var>` as the value — that becomes the emitted TDict's head, and lowering
# re-derives the identical name from the pattern var to seed ctx_fwd. See
# types.existential_fwd_head.
fn seed_given_for_skolem(class_name: String, vname: String, sk: String, env: Dict types.Scheme) -> Dict types.Scheme =
  # Seed the direct `@fwd:sk:class` given, then layer superclass givens
  # (`@fwd:sk:super` for each `@super:class:*`) — a multi-method/superclass
  # existential must forward its inherited methods too, exactly as a
  # `where C a` function does via seed_fwd_with_supers. The stable
  # `$ex_<var>` head is passed as the marker value so lowering's ctx_fwd,
  # keyed by the same head, agrees for every effective class. class_name is
  # already qualified (bundler.qualify_ctor_args qualifies exist_constraints),
  # so it matches resolve_skolem_given's lookup off the class marker.
  seed_superclass_fwd_markers(class_name, sk, types.existential_fwd_head(vname),
    dict_set("@fwd:" ++ sk ++ ":" ++ class_name,
             types.mono(types.TConst(types.type_id(types.existential_fwd_head(vname)))), env))

# Find the first field whose DECLARED type MENTIONS the existential var, returning
# its pattern together with that declared type. Uses the shared `types.ftv`
# predicate so this and lowering's field_var_for_constraint select the identical
# field — the `$ex_<vname>` forwarding head must agree across the two passes. A
# constrained var may sit bare (`Shown a`), in a function (`s -> String`), or
# nested in a compound field (`Bag (List a)`); all three mention the var.
fn field_and_declared_for_var(param_types: List types.Type, fields: List ast.Pattern, var: String) -> Maybe(ast.Pattern, types.Type) =
  match (param_types, fields) with
  | (Cons pt pts, Cons f fs) ->
      if list_member(var, types.ftv(pt)) then Just((f, pt))
      else field_and_declared_for_var(pts, fs, var)
  | _ -> Nothing

# Locate the skolem the existential var `var` was instantiated to, by co-walking
# the DECLARED field type (which mentions `var`) against the field's ACTUAL type
# after unpack (the skolem sits in the same structural position). The bare case
# (declared `TVar var`, actual `$sk`) is the leaf; `List a`/`List $sk`,
# `a -> T`/`$sk -> T`, and tuples recurse. Co-walking by var name disambiguates a
# field mentioning several vars (`Pair a b` → `$ska`/`$skb`).
fn skolem_for_var_in(declared: types.Type, actual: types.Type, var: String) -> Maybe String =
  match (declared, actual) with
  | (types.TVar n, _) ->
      if types.tyvar_identity(n) == var then skolem_name_of_type(actual) else Nothing
  | (types.TApp d1 d2, types.TApp a1 a2) ->
      match skolem_for_var_in(d1, a1, var) with
      | Just sk -> Just(sk)
      | Nothing -> skolem_for_var_in(d2, a2, var)
  | (types.TFunc d1 dr _ _, types.TFunc a1 ar _ _) ->
      match skolem_for_var_in(d1, a1, var) with
      | Just sk -> Just(sk)
      | Nothing -> skolem_for_var_in(dr, ar, var)
  | (types.TTuple d_items, types.TTuple a_items) -> skolem_for_var_in_list(d_items, a_items, var)
  | _ -> Nothing

fn skolem_for_var_in_list(d_items: List types.Type, a_items: List types.Type, var: String) -> Maybe String =
  match (d_items, a_items) with
  | (Cons d dt, Cons a at) ->
      match skolem_for_var_in(d, a, var) with
      | Just sk -> Just(sk)
      | Nothing -> skolem_for_var_in_list(dt, at, var)
  | _ -> Nothing

fn skolem_name_of_type(t: types.Type) -> Maybe String =
  match t with
  | types.TConst name -> skolem_name_if_skolem(types.type_id_name(name))
  | _ -> Nothing

fn skolem_name_if_skolem(s: String) -> Maybe String =
  if types.is_skolem_name(s) then Just(s) else Nothing

# ---------------------------------------------------------------------------
# Do expression
# ---------------------------------------------------------------------------

# Short-circuit family ("Maybe" / "Result") of a do-step's inferred type, or
# Nothing for any other type (IO actions, pure values).  Mirrors the shape
# recognized by do_unwrap_type: `Maybe a` = TApp (TConst Maybe) a;
# `Result e a` = TApp (TApp (TConst Result) e) a.
fn short_circuit_family(t: types.Type) -> Maybe String =
  match t with
  | types.TApp outer _ ->
      match outer with
      | types.TConst name -> if types.type_id_name(name) == "Maybe" then Just("Maybe") else Nothing
      | types.TApp outer2 _ ->
          match outer2 with
          | types.TConst name -> if types.type_id_name(name) == "Result" then Just("Result") else Nothing
          | _ -> Nothing
      | _ -> Nothing
  | _ -> Nothing

# What a `<-` bind fixed about its block: the family name, the bind's right-hand-side
# TYPE (so `Result`'s error slot can be unified, not merely matched by name), and the
# bind's position (so the diagnostic points at the bind rather than the block).
type DoFamily = DoFamily String types.Type source.SourcePos

fn do_family_name(f: DoFamily) -> String = match f with | DoFamily n _ _ -> n
fn do_family_type(f: DoFamily) -> types.Type = match f with | DoFamily _ t _ -> t
fn do_family_pos(f: DoFamily) -> source.SourcePos = match f with | DoFamily _ _ p -> p

# A do block may sequence exactly one short-circuit family.  A `<-` bind fixes
# the family; a later bind or the final expression in a different family is an
# error.  Returns Ok(updated-family) or Err(diagnostic).  IO/pure steps and
# `let` steps leave the family unchanged.
fn do_family_update(
  step: ast.DoStep,
  is_last: Bool,
  step_type: types.Type,
  step_pos: source.SourcePos,
  subst: Dict types.Type,
  family: Maybe DoFamily
) -> Result String (Maybe DoFamily) =
  match short_circuit_family(unifier.apply_subst(subst, step_type)) with
  | Nothing -> Ok(family)
  | Just cur ->
      match step with
      | ast.DoBindStep _ _ ->
          match family with
          | Nothing -> Ok(Just (DoFamily(cur, unifier.apply_subst(subst, step_type), step_pos)))
          | Just est ->
              if do_family_name(est) == cur then Ok(family)
              else Err(string_concat_many(["This do block started with ", do_family_name(est), " bindings, but this step returns ", cur, ". Keep one short-circuit family per do block."]))
      | ast.DoExprStep _ ->
          if is_last then
            match family with
            | Nothing -> Ok(family)
            | Just est ->
                if do_family_name(est) == cur then Ok(family)
                else Err(string_concat_many(["do block started with ", do_family_name(est), " bindings, but its final expression returns ", cur]))
          else Ok(family)
      | ast.DoLetStep _ _ -> Ok(family)

# THE FALLIBLE-BIND RULE (spec-v0.md §5.9).
#
# `x <- e` with `e : Result E A` does not merely end the block on `Err` — it RETURNS
# from the enclosing function carrying the failure. So the failure has to be a value
# that function can return, and until this check existed nothing said so: a do block
# is typed as its LAST step (see infer_do_steps' Nil arm) and `check_fn_body` unifies
# exactly that against the declared return type, so the TAIL was checked and the
# short-circuit path was not. A `-> Int` function binding a failing `Result` returned
# a heap `Err` box read as an `Int`.
#
# The check is one unification against a CONSTRUCTED `Result E ?a` / `Maybe ?a`, not a
# head-name comparison, and that matters in both directions:
#
#   - it unifies `Result`'s ERROR slot, which is the facet a name check would miss
#     (`-> Result Int Int` binding a `Result String Int` compiled, and the String
#     arrived as an `Int`);
#   - it handles a block type that is still an unresolved TYPE VARIABLE, which is the
#     only way the wrong-FAMILY case is reachable at all. With any concrete tail one
#     of two pre-existing checks already fires, but a tyvar tail (`panic : a`) slips
#     past both and then unifies with whatever the signature says — measured: a
#     `Maybe` bind in a `-> Result String Int` compiled, and the `Nothing` box matched
#     neither `Ok` nor `Err` at runtime. Unifying with `Maybe ?a` binds the tyvar
#     instead, and `check_fn_body` then rejects `Maybe ?a` vs `Result String Int`.
#
# Because the block's type flows to the signature through that existing unification,
# nothing has to be threaded down from the enclosing declaration.
# Its own result type rather than a `Result`, for the reason this whole rule exists:
# `carried <- do_block_carries(…)` on a `Result`-returning callee would be a FALLIBLE
# BIND and would unwrap it, so the `match` below could never see an `Err`. (Written
# with `Result` first, and the compiler — carrying the fix — rejected it.) The
# codebase already uses this shape for the same reason: `InferResult`, `LinRes`.
type BlockCarry = CarryOk(Dict types.Type) | CarryErr String source.SourcePos

fn do_block_carries(
  state: unifier.InferState,
  family: Maybe DoFamily,
  block_ty: types.Type,
  subst: Dict types.Type
) -> BlockCarry !{IO} =
  match family with
  | Nothing -> CarryOk(subst)
  | Just fam ->
      do
        tv <- unifier.fresh(state)
        let want =
          if do_family_name(fam) == "Maybe" then types.type_maybe(types.TVar(types.tyvar_id(tv)))
          else types.type_result(result_error_slot(do_family_type(fam)), types.TVar(types.tyvar_id(tv)))
        # no_effect_subst: BlockCarry carries only a type substitution, and this
        # unification is against `Maybe a` / `Result e a` — neither is an arrow.
        match unifier.unify_types(subst, unifier.no_effect_subst(), block_ty, want) with
        | unifier.UnifyOk s _ -> CarryOk(s)
        | unifier.UnifyErr _ ->
            CarryErr(fallible_bind_msg(do_family_name(fam), do_family_type(fam),
                                       "the block", unifier.apply_subst(subst, block_ty)),
                     do_family_pos(fam))

# The `E` of a `Result E A`. Falls back to the whole type for anything else, which
# cannot happen: the caller only reaches this having classified it as `Result`.
fn result_error_slot(t: types.Type) -> types.Type =
  match t with
  | types.TApp outer _ ->
      match outer with
      | types.TApp _ e -> e
      | _ -> t
  | _ -> t

# One tailored message per mismatch shape, as Rust does for `?`, rather than one
# generic message: which of the three went wrong determines what the author should do.
# `target_desc` names WHAT the failure has to fit into: "the block" when the mismatch
# is caught inside infer_do_steps, or "`<fn>`" when it only surfaces later, against the
# declared return type (see return_mismatch_msg).
fn fallible_bind_msg(fam: String, sc_ty: types.Type, target_desc: String, target_ty: types.Type) -> String =
  match short_circuit_family(target_ty) with
  | Nothing ->
      string_concat_many([
        "this `<-` bind propagates a ", fam, " failure (", types.type_to_string(sc_ty),
        "), but ", target_desc, " returns ", types.type_to_string(target_ty),
        ", which cannot carry it. Handle the failure here instead — use the value as a bare statement to discard it, or `with_default`/a total accessor to supply one — or make this function return ",
        fam, "."])
  | Just other ->
      if other == fam then
        string_concat_many([
          "this `<-` bind fails with ", types.type_to_string(result_error_slot(sc_ty)),
          ", but ", target_desc, " returns ", types.type_to_string(target_ty),
          ". Convert the error at the bind with `map_error`."])
      else
        string_concat_many([
          "a `", fam, "` bind needs a `", fam, "`-returning block, but ", target_desc, " returns ",
          types.type_to_string(target_ty),
          ". The two do not share a failure representation, so the short-circuit would return a ",
          fam, " value as a ", other, "."])

# ---------------------------------------------------------------------------
# Re-blaming a return-type mismatch on the fallible bind that caused it
# ---------------------------------------------------------------------------
#
# `do_block_carries` constrains the block against `Result E ?a` / `Maybe ?a`, which is
# enough for SOUNDNESS but not always enough to REPORT well: two shapes satisfy that
# constraint and only conflict once `check_fn_body` unifies the block against the
# DECLARED return type —
#
#   * same family, different error type (`Result String Int` bound in `-> Result Int Int`),
#     because the block's error slot was free and the bind filled it in;
#   * wrong family reached through a type-VARIABLE tail (`panic : a`), where the tyvar
#     absorbs the block constraint and the signature is what disagrees.
#
# Both produced "Return type mismatch in <fn>: Type mismatch: String vs Int", which names
# the function and neither the bind nor the fix. So when that unification fails and the
# body is a `do` block containing a fallible bind, blame the bind. Strictly a diagnostic
# improvement — the same programs were already rejected, at the same phase.
fn first_fallible_bind(body: typed_ast.TypedExpr, subst: Dict types.Type) -> Maybe DoFamily =
  match body with
  | typed_ast.TDo steps _ _ -> first_fallible_step(steps, subst)
  | _ -> Nothing

fn first_fallible_step(steps: List typed_ast.TypedDoStep, subst: Dict types.Type) -> Maybe DoFamily =
  match steps with
  | Nil -> Nothing
  | Cons step rest ->
      match step with
      | typed_ast.TDoBindStep _ e ->
          match short_circuit_family(unifier.apply_subst(subst, typed_ast.typed_expr_type(e))) with
          | Just fam ->
              Just(DoFamily(fam, unifier.apply_subst(subst, typed_ast.typed_expr_type(e)),
                            typed_ast.typed_expr_pos(e)))
          | Nothing -> first_fallible_step(rest, subst)
      | _ -> first_fallible_step(rest, subst)

# The message + position for a return-type mismatch, re-blamed on the fallible bind when
# there is one. Falls back to the original generic wording otherwise, so every other cause
# of a return-type mismatch reads exactly as it did before.
fn return_mismatch_body_err(name: String, body: typed_ast.TypedExpr, ret_ty: types.Type,
                            subst: Dict types.Type, generic: String) -> typed_ast.BodyResult =
  match first_fallible_bind(body, subst) with
  | Nothing -> typed_ast.BodyErr(typed_ast.typed_expr_pos(body), generic)
  | Just fam ->
      typed_ast.BodyErr(
        do_family_pos(fam),
        fallible_bind_msg(do_family_name(fam), do_family_type(fam),
                          "`" ++ name ++ "`", unifier.apply_subst(subst, ret_ty)))

fn infer_do(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  steps: List ast.DoStep,
  pos: source.SourcePos
) -> InferResult !{IO} =
  infer_do_steps(state, env, subst, eff_subst, steps, dummy_unit(), Nil, types.EffectPure, Nothing, pos)

fn infer_do_steps(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  steps: List ast.DoStep,
  last_typed: typed_ast.TypedExpr,
  acc_steps: List typed_ast.TypedDoStep,
  acc_eff: types.Effect,
  family: Maybe DoFamily,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match steps with
  | Nil ->
      # The block is complete, so its type is known and the fallible-bind rule can be
      # discharged against it (see do_block_carries).
      do
        carried <- do_block_carries(state, family, typed_ast.typed_expr_type(last_typed), subst)
        match carried with
        | CarryErr msg bind_pos -> InferErr(bind_pos, msg)
        | CarryOk s ->
            InferOk(
              typed_ast.TDo(typed_do_step_list_reverse(acc_steps),
                            unifier.apply_subst(s, typed_ast.typed_expr_type(last_typed)), pos),
              s, eff_subst, acc_eff)
  | Cons step rest ->
      do
        sr <- infer_do_step(state, env, subst, eff_subst, step)
        match sr with
        | InferErr pos e -> InferErr(pos, e)
        | InferOk typed_step_expr s1 es1 step_eff ->
            match do_family_update(step, is_nil_steps(rest), typed_ast.typed_expr_type(typed_step_expr),
                                   typed_ast.typed_expr_pos(typed_step_expr), s1, family) with
            | Err msg -> InferErr(pos, msg)
            | Ok new_family ->
                infer_do_steps(
                  state,
                  extend_env_from_do_step(step, typed_ast.typed_expr_type(typed_step_expr), s1, env),
                  s1, es1, rest, typed_step_expr,
                  Cons(do_step_to_typed(step, typed_step_expr), acc_steps),
                  merge_effects(acc_eff, step_eff), new_family, pos)

fn is_nil_steps(steps: List ast.DoStep) -> Bool =
  match steps with
  | Nil -> true
  | [_ | _] -> false

fn infer_do_step(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  step: ast.DoStep
) -> InferResult !{IO} =
  match step with
  | ast.DoExprStep e -> infer_expr(state, env, subst, eff_subst, e)
  | ast.DoBindStep _ e -> infer_expr(state, env, subst, eff_subst, e)
  | ast.DoLetStep _ e -> infer_expr(state, env, subst, eff_subst, e)

fn do_step_to_typed(step: ast.DoStep, typed_expr: typed_ast.TypedExpr) -> typed_ast.TypedDoStep =
  match step with
  | ast.DoExprStep _ -> typed_ast.TDoExprStep(typed_expr)
  | ast.DoBindStep pat _ -> typed_ast.TDoBindStep(pat, typed_expr)
  | ast.DoLetStep name _ -> typed_ast.TDoLetStep(name, typed_expr)

fn do_unwrap_type(t: types.Type) -> types.Type =
  match t with
  | types.TApp outer inner ->
      match outer with
      | types.TConst name ->
          if types.type_id_name(name) == "Maybe" then inner else t
      | types.TApp outer2 _ ->
          match outer2 with
          | types.TConst name ->
              if types.type_id_name(name) == "Result" then inner else t
          | _ -> t
      | _ -> t
  | _ -> t

fn extend_env_from_do_step(step: ast.DoStep, step_type: types.Type, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match step with
  | ast.DoBindStep pat _ ->
      extend_env_from_pattern_typed(pat, do_unwrap_type(unifier.apply_subst(subst, step_type)), subst, env)
  | ast.DoLetStep name _ ->
      bind_local_scheme(name, types.mono(unifier.apply_subst(subst, step_type)), env)
  | ast.DoExprStep _ -> env

fn extend_env_from_pattern_typed(pat: ast.Pattern, t: types.Type, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match pat with
  | ast.VarPattern name _ -> bind_local_scheme(name, types.mono(t), env)
  | ast.TuplePattern pats _ ->
      match t with
      | types.TTuple elem_types -> extend_env_from_typed_tuple_pats(pats, elem_types, subst, env)
      | _ -> extend_env_from_pattern(pat, subst, env)
  | _ -> extend_env_from_pattern(pat, subst, env)

# Zip TuplePattern variable patterns against their resolved element types so
# do-bind steps like `(a, b) <- f(x)` bind `a` and `b` to concrete types
# rather than bare TVar(name) stubs that can never be resolved by the unifier.
fn extend_env_from_typed_tuple_pats(pats: List ast.Pattern, elem_types: List types.Type, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match (pats, elem_types) with
  | (Nil, _) -> env
  | (_, Nil) -> env
  | (Cons p rest_pats, Cons elem_t rest_types) ->
      extend_env_from_typed_tuple_pats(rest_pats, rest_types, subst,
        extend_env_from_pattern_typed(p, elem_t, subst, env))

# ---------------------------------------------------------------------------
# Lambda expression
# ---------------------------------------------------------------------------

fn infer_lambda(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  params: List ast.Param,
  body: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  infer_lambda_expected(state, env, subst, eff_subst, params, body, Nothing, pos)

# `expected` is the callee parameter slot this lambda fills, when there is one
# (infer_call_args supplies it; a lambda in any other position passes Nothing).
# Seeding the parameters from it lets the body see their types -- and seeding
# them with the slot's own variables, not copies, keeps the two linked when the
# slot is only resolved later.
fn infer_lambda_expected(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  params: List ast.Param,
  body: ast.Expr,
  expected: Maybe types.Type,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    fresh_params <- make_fresh_param_types(state, params)
    let param_types = seed_param_types(fresh_params, expected)
    let env2 = extend_env_with_params(params, param_types, env)
    br <- infer_expr(state, env2, subst, eff_subst, body)
    match br with
    | InferErr pos e -> InferErr(pos, e)
    | InferOk typed_body s1 es1 body_eff ->
        # The lambda's TYPE gets the body's effect on its innermost arrow, matching
        # what a written `a -> Unit !{IO}` produces. The EXPRESSION's effect is
        # `EffectPure`, because constructing a closure performs no effect: the
        # effect belongs to the arrow and fires when something CALLS it.
        #
        # This returned `body_eff` until 2026-08-16, deliberately and wrongly. The
        # arrow was a dead end — `unify_applied` discarded TFunc's effect field, so
        # instantiating a callee's `!{e}` made a variable nothing bound — and
        # over-approximating here was therefore the ONLY path by which an effect
        # crossed a higher-order boundary. Reporting the truth would have made
        # `list_each`/`list_fold`, the repo's recommended effectful idiom, report
        # clean. Now that arrows unify, the arrow carries it and the lie is
        # redundant as well as wrong.
        #
        # The lie was not free: it made every function that BUILDS an effectful
        # closure report as effectful. All six real gaps in the corpus census were
        # that and nothing else (`log.stderr_logger`, `http_middleware.with_logging`,
        # `http_web_server.routes`, …), which is what blocked enforcement — flipping
        # the report to an error would have rejected six correct programs.
        #
        # Removing it requires `infer_call_general` to read the callee's arrow
        # effect, which it did not: for a callee that is an expression rather than a
        # name, the only effect it contributed was the cost of EVALUATING the callee.
        # A directly-applied lambda `(\x -> print(x))(s)` was caught solely by the
        # over-approximation. Canaries: `apply_now` and `via_local`.
        InferOk(
          typed_ast.TLambda(params, typed_body,
            build_fn_type_modes(param_types, param_modes(params),
              typed_ast.typed_expr_type(typed_body), body_eff), pos),
          s1, es1, types.EffectPure)

fn seed_param_types(fresh: List types.Type, expected: Maybe types.Type) -> List types.Type =
  match expected with
  | Nothing -> fresh
  | Just t -> seed_from_arrow(fresh, t)

# Walk the expected arrow spine alongside the parameters.  If it runs out early
# -- a parameter-count mismatch, or a slot still unresolved -- the remaining
# parameters keep their fresh variables, which is exactly the old behaviour.
fn seed_from_arrow(fresh: List types.Type, expected: types.Type) -> List types.Type =
  match fresh with
  | Nil -> Nil
  | Cons f rest ->
      match expected with
      | types.TFunc p r _ _ -> Cons(p, seed_from_arrow(rest, r))
      | _ -> Cons(f, rest)

fn make_fresh_param_types(state: unifier.InferState, params: List ast.Param) -> List types.Type !{IO} =
  match params with
  | Nil -> Nil
  | Cons _ rest ->
      do
        v <- unifier.fresh(state)
        rest_types <- make_fresh_param_types(state, rest)
        Cons(types.TVar(types.tyvar_id(v)), rest_types)

fn extend_env_with_params(params: List ast.Param, param_types: List types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match (params, param_types) with
  | (Nil, _) -> env
  | (_, Nil) -> env
  | (Cons p rest_p, Cons t rest_t) ->
      match p with
      | ast.Param name _ _ -> extend_env_with_params(rest_p, rest_t, bind_local_scheme(name, types.mono(t), env))

# ---------------------------------------------------------------------------
# Record inference
# ---------------------------------------------------------------------------

fn register_record_fields(
  rec_name: String,
  type_params: List String,
  fields: List ast.RecordFieldDecl,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  register_record_fields_loop(rec_name, type_params, fields,
    build_record_local_vars(rec_name, type_params, dict_empty()), env)

fn build_record_local_vars(rec_name: String, type_params: List String, acc: Dict types.Type) -> Dict types.Type =
  match type_params with
  | Nil -> acc
  | Cons p rest ->
      build_record_local_vars(rec_name, rest,
        dict_set(p, types.TVar(types.tyvar_id(str_concat(rec_name, str_concat(".", p)))), acc))

fn register_record_fields_loop(
  rec_name: String,
  type_params: List String,
  fields: List ast.RecordFieldDecl,
  local_vars: Dict types.Type,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  match fields with
  | Nil -> env
  | Cons field rest ->
      match field with
      | ast.RecordFieldDecl fname ftype ->
          register_record_fields_loop(rec_name, type_params, rest, local_vars,
            dict_set(
              str_concat("@rec:", str_concat(rec_name, str_concat(":", fname))),
              make_record_field_scheme(rec_name, type_params, type_from_ast(ftype, local_vars)),
              env))

fn make_record_field_scheme(rec_name: String, type_params: List String, field_t: types.Type) -> types.Scheme =
  types.scheme_quantified(
    list_map(\p -> str_concat(rec_name, str_concat(".", p)), type_params),
    field_t, types.EffectPure, Nil)

fn infer_record_expr(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  type_name: String,
  fields: List ast.RecordField,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match first_dup_field(fields) with
  | Just dup -> InferErr(pos, "field `" ++ dup ++ "` supplied twice for record " ++ type_name)
  | Nothing ->
      do
        # Instantiate the record's type params ONCE so every field's declared type
        # AND the result type share the same fresh vars. Construction then yields a
        # `Box Int` (a TApp), not a bare `Box` — which is what field access/update
        # (`record_field_access_type`, `concrete_field_type`) already expect. A
        # monomorphic record has no qvars, so param_subst is empty and the result is
        # a bare TConst exactly as before (byte-identical).
        (param_subst, param_vars) <- instantiate_record_params(state, type_name, fields, env)
        infer_record_fields(state, env, subst, eff_subst, type_name, fields, Nil, types.EffectPure,
                            pos, param_subst,
                            apply_type_args(types.TConst(types.type_id(type_name)), param_vars))

# Recover the record's declared type params (every field scheme is generalized
# over the full ordered param list, so any field's qvars give them) and mint one
# fresh var per param. Returns (qvar->fresh subst, ordered fresh param vars).
fn instantiate_record_params(state: unifier.InferState, type_name: String, fields: List ast.RecordField, env: Dict types.Scheme) -> (Dict types.Type, List types.Type) !{IO} =
  match record_type_qvars(type_name, fields, env) with
  | Nil -> (dict_empty(), Nil)
  | qvars ->
      do
        param_vars <- mint_fresh_tvars(state, list_length(qvars))
        (build_tvar_subst(qvars, param_vars, dict_empty()), param_vars)

fn record_type_qvars(type_name: String, fields: List ast.RecordField, env: Dict types.Scheme) -> List String =
  match fields with
  | Nil -> Nil
  | [ast.RecordField fname _ | _] ->
      match dict_get(str_concat("@rec:", str_concat(type_name, str_concat(":", fname))), env) with
      | Just scheme -> types.scheme_vars(scheme)
      | Nothing -> Nil

fn mint_fresh_tvars(state: unifier.InferState, n: Int) -> List types.Type !{IO} =
  if n <= 0 then Nil
  else do
    v <- unifier.fresh(state)
    rest <- mint_fresh_tvars(state, n - 1)
    Cons(types.TVar(types.tyvar_id(v)), rest)

fn apply_type_args(base: types.Type, args: List types.Type) -> types.Type =
  match args with
  | Nil -> base
  | Cons a rest -> apply_type_args(types.TApp(base, a), rest)

fn infer_record_fields(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  type_name: String,
  fields: List ast.RecordField,
  acc_fields: List typed_ast.TypedRecordField,
  acc_eff: types.Effect,
  pos: source.SourcePos,
  param_subst: Dict types.Type,
  result_type: types.Type
) -> InferResult !{IO} =
  match fields with
  | Nil ->
      InferOk(
        typed_ast.TRecord(type_name,
                          typed_record_field_list_reverse(acc_fields),
                          result_type, pos),
        subst, eff_subst, acc_eff)
  | Cons field rest_fields ->
      match field with
      | ast.RecordField fname fexpr ->
          do
            r <- infer_expr(state, env, subst, eff_subst, fexpr)
            match r with
            | InferErr pos e -> InferErr(pos, e)
            | InferOk typed_val s1 es1 val_eff ->
                match dict_get(str_concat("@rec:", str_concat(type_name, str_concat(":", fname))), env) with
                | Nothing -> InferErr(pos, "Unknown record type or field: " ++ type_name ++ "." ++ fname)
                | Just field_scheme ->
                    # Substitute the SHARED param vars into the field's declared type
                    # (not a per-field fresh instantiate) so all fields and the result
                    # agree on each param. Field schemes carry no effect/constraint
                    # vars, so a plain subst suffices.
                    let field_t = unifier.apply_subst(param_subst, types.scheme_type(field_scheme))
                    in match unifier.unify_types(s1, es1, typed_ast.typed_expr_type(typed_val), field_t) with
                       | unifier.UnifyErr e -> InferErr(pos, "Record field type mismatch: " ++ e)
                       | unifier.UnifyOk s2 es2 ->
                           infer_record_fields(state, env, s2, es2, type_name, rest_fields,
                             Cons(typed_ast.TypedRecordField(fname, typed_val), acc_fields),
                             merge_effects(acc_eff, val_eff), pos, param_subst, result_type)

fn infer_get_field(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  rec_expr: ast.Expr,
  field_name: String,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    r <- infer_expr(state, env, subst, eff_subst, rec_expr)
    match r with
    | InferErr pos e -> InferErr(pos, e)
    | InferOk typed_rec s1 es1 rec_eff ->
        get_field_from_resolved(state, env, s1, es1,
          unifier.apply_subst(s1, typed_ast.typed_expr_type(typed_rec)),
          typed_rec, field_name, rec_eff, pos)

fn get_field_from_resolved(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  resolved: types.Type,
  typed_rec: typed_ast.TypedExpr,
  field_name: String,
  rec_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match resolved with
  | types.TConst rec_name ->
      lookup_record_field_typed(state, env, subst, eff_subst, types.type_id_name(rec_name), Nil, typed_rec, field_name, rec_eff, pos)
  | types.TApp _ _ ->
      lookup_record_field_typed(state, env, subst, eff_subst,
        extract_tconst_name(resolved), extract_tapp_args(resolved),
        typed_rec, field_name, rec_eff, pos)
  | _ ->
      # The receiver is not a record type YET. Inference runs left to right, so
      # a later call in the same body may still pin it down. Give the access a
      # fresh result variable to carry the value, and park the obligation to
      # type it — discharge_field_obligations settles it at the declaration
      # boundary. Leaving the variable unconstrained instead is what let
      # `fn coerce(p) = p.x` generalize to `forall a b. a -> b`.
      do
        v <- unifier.fresh(state)
        let result_var = types.TVar(types.tyvar_id(v))
        unifier.park_field_obligation(state,
          unifier.FieldObligation(resolved, field_name, result_var, pos))
        InferOk(typed_ast.TGetField(typed_rec, field_name, result_var, pos), subst, eff_subst, rec_eff)

fn extract_tconst_name(t: types.Type) -> String =
  match t with
  | types.TConst name -> types.type_id_name(name)
  | types.TApp base _ -> extract_tconst_name(base)
  | _ -> "Unknown"

fn extract_tapp_args(t: types.Type) -> List types.Type =
  list_reverse(collect_tapp_args(t, Nil))

fn collect_tapp_args(t: types.Type, acc: List types.Type) -> List types.Type =
  match t with
  | types.TApp base arg -> collect_tapp_args(base, Cons(arg, acc))
  | _ -> acc

fn lookup_record_field_typed(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  rec_name: String,
  type_args: List types.Type,
  typed_rec: typed_ast.TypedExpr,
  field_name: String,
  rec_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match dict_get(str_concat("@rec:", str_concat(rec_name, str_concat(":", field_name))), env) with
  | Nothing ->
      do
        v <- unifier.fresh(state)
        InferOk(typed_ast.TGetField(typed_rec, field_name, types.TVar(types.tyvar_id(v)), pos), subst, eff_subst, rec_eff)
  | Just field_scheme ->
      do
        field_t <- record_field_access_type(state, field_scheme, type_args)
        InferOk(typed_ast.TGetField(typed_rec, field_name, field_t, pos),
          subst, eff_subst, rec_eff)

# Type of an accessed field with the record's type params bound to the accessed
# value's ACTUAL type args. When the args line up with the record's params, bind
# them DIRECTLY (as concrete_field_type / record-update do) so a field of type
# `a` on `Box a` stays identified with the caller's `a`. This identity is
# load-bearing inside a parametric instance (`instance Eq (Box a) where Eq a`):
# losing it decouples `left.val` from `a`, so `eq(left.val, ..)` dispatches
# through a null `Eq a` dict at runtime. `instantiate` (the old path) renamed the
# params to fresh vars the arg substitution could no longer reach — the exact
# trap concrete_field_type documents. Fall back to `instantiate` only when the
# args don't match the params (an as-yet-unapplied record type), so unbound
# params become fresh vars instead of leaking their `Rec.param` names — the
# length guard matters because build_tvar_subst truncates on mismatch rather than
# failing. Monomorphic records have no params, so this is byte-identical to the
# old path for them.
fn record_field_access_type(state: unifier.InferState, field_scheme: types.Scheme, type_args: List types.Type) -> types.Type !{IO} =
  match field_scheme with
  | types.Scheme qvars _ _ _ _ ->
      if list_length(qvars) == list_length(type_args) then
        concrete_field_type(field_scheme, type_args)
      else
        unifier.instantiate(state, field_scheme)

fn build_tvar_subst(vars: List String, args: List types.Type, acc: Dict types.Type) -> Dict types.Type =
  match (vars, args) with
  | (Nil, _) -> acc
  | (_, Nil) -> acc
  | (Cons v rest_v, Cons a rest_a) ->
      build_tvar_subst(rest_v, rest_a, dict_set(v, a, acc))

# --- Record functional update (docs/records-v0.md §4.4) ---

# `base with (field = value, ...)`: the base must have a record type; each named
# field must belong to that record and its new value must unify with the declared
# field type; the result type equals the base type.
fn infer_record_update(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  base: ast.Expr,
  fields: List ast.RecordField,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    br <- infer_expr(state, env, subst, eff_subst, base)
    match br with
    | InferErr pos e -> InferErr(pos, e)
    | InferOk typed_base s1 es1 base_eff ->
        infer_update_resolved(state, env, s1, es1,
          unifier.apply_subst(s1, typed_ast.typed_expr_type(typed_base)),
          typed_base, fields, base_eff, pos)

# Dispatch once the base type is resolved: it must be a record, no field may be
# named twice, and each field's new value is type-checked against the declared
# field type (with the base record's type arguments applied).
fn infer_update_resolved(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  resolved: types.Type,
  typed_base: typed_ast.TypedExpr,
  fields: List ast.RecordField,
  base_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match record_head_name(resolved) with
  | Nothing -> InferErr(pos, "record update `with` requires a record value on the left")
  | Just rec_name ->
      match first_dup_field(fields) with
      | Just dup -> InferErr(pos, "field `" ++ dup ++ "` supplied twice for record " ++ rec_name)
      | Nothing ->
          infer_update_fields(state, env, subst, eff_subst, rec_name,
            extract_record_type_args(resolved), resolved,
            typed_base, fields, Nil, base_eff, pos)

# Head record type name of a resolved type (peels TApp for parametric records).
fn record_head_name(t: types.Type) -> Maybe String =
  match t with
  | types.TConst _ -> Just(extract_tconst_name(t))
  | types.TApp _ _ -> Just(extract_tconst_name(t))
  | _ -> Nothing

# Type arguments of a resolved record type: [] for a monomorphic record.
fn extract_record_type_args(t: types.Type) -> List types.Type =
  match t with
  | types.TApp _ _ -> extract_tapp_args(t)
  | _ -> Nil

# Declared type of a record field with the base record's type arguments applied:
# substitute the record's type parameters (the scheme's quantified vars) by the
# base's type args directly in the field scheme body.  For a monomorphic record
# (no quantified vars) this is the field body unchanged.  Binds the params
# directly rather than via `instantiate`, which would rename them to fresh vars
# the arg substitution can no longer reach (see record_field_access_type, which
# shares this direct-bind approach for field access).
fn concrete_field_type(field_scheme: types.Scheme, type_args: List types.Type) -> types.Type =
  match field_scheme with
  | types.Scheme qvars _ body _ _ ->
      unifier.apply_subst(build_tvar_subst(qvars, type_args, dict_empty()), body)

# First field name appearing more than once in a record literal / update list.
fn first_dup_field(fields: List ast.RecordField) -> Maybe String =
  first_dup_field_go(fields, Nil)

fn first_dup_field_go(fields: List ast.RecordField, seen: List String) -> Maybe String =
  match fields with
  | Nil -> Nothing
  | Cons f rest ->
      match f with
      | ast.RecordField fname _ ->
          if str_list_contains(seen, fname) then Just(fname)
          else first_dup_field_go(rest, Cons(fname, seen))

fn infer_update_fields(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  rec_name: String,
  type_args: List types.Type,
  base_type: types.Type,
  typed_base: typed_ast.TypedExpr,
  fields: List ast.RecordField,
  acc: List typed_ast.TypedRecordField,
  acc_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match fields with
  | Nil ->
      InferOk(
        typed_ast.TRecordUpdate(typed_base, typed_record_field_list_reverse(acc), base_type, pos),
        subst, eff_subst, acc_eff)
  | Cons field rest ->
      match field with
      | ast.RecordField fname fexpr ->
          match dict_get(str_concat("@rec:", str_concat(rec_name, str_concat(":", fname))), env) with
          | Nothing -> InferErr(pos, "`with` update: no field `" ++ fname ++ "` on `" ++ rec_name ++ "` (left operand must be a record with that field)")
          | Just field_scheme ->
              do
                vr <- infer_expr(state, env, subst, eff_subst, fexpr)
                match vr with
                | InferErr pos e -> InferErr(pos, e)
                | InferOk typed_val s1 es1 val_eff ->
                      match unifier.unify_types(s1, es1, typed_ast.typed_expr_type(typed_val),
                                                concrete_field_type(field_scheme, type_args)) with
                      | unifier.UnifyErr e -> InferErr(pos, "record update field type mismatch: " ++ e)
                      | unifier.UnifyOk s2 es2 ->
                          infer_update_fields(state, env, s2, es2, rec_name, type_args, base_type, typed_base, rest,
                            Cons(typed_ast.TypedRecordField(fname, typed_val), acc),
                            merge_effects(acc_eff, val_eff), pos)

# ---------------------------------------------------------------------------
# Range expression (new)
# ---------------------------------------------------------------------------

# The value of an expression that is a statically-known integer, or Nothing if it
# is anything else.  Handles a negated literal, because `0..-1` is written with a
# unary minus rather than lexed as one negative token.
fn static_int_value(e: ast.Expr) -> Maybe Int =
  match e with
  | ast.IntExpr n _ -> Just(n)
  | ast.UnaryExpr op operand _ ->
      if op == "-" then
        match static_int_value(operand) with
        | Just n -> Just(0 - n)
        | Nothing -> Nothing
      else Nothing
  | _ -> Nothing

# A range whose bounds are both statically known and crossed FOR ITS DIRECTION names
# a specific empty interval.  No caller writes that on purpose, so it is rejected
# rather than left to yield nothing — the same rule the spec already applies to a
# negative literal shift count (§8.1.2): the dynamic case gets the total answer, a
# statically known one is a program that cannot be right.
#
# Bounds that are COMPUTED are never diagnosed.  `range_up(0, n - 1)` at n == 0 is
# legal and empty, and is the ordinary spelling of a half-open [0, n) walk — warning
# on it would make the fixed idiom unusable.
#
# `shown` is how the offending range was spelled, so the message quotes the source
# form the author actually wrote rather than a normalized one.
fn static_empty_range(lo: ast.Expr, hi: ast.Expr, step: Int, shown: String) -> Maybe String =
  match (static_int_value(lo), static_int_value(hi)) with
  | (Just l, Just h) ->
      if step > 0 && h < l then Just(empty_range_text(shown, l, h, true))
      else if step < 0 && h > l then Just(empty_range_text(shown, l, h, false))
      else Nothing
  | _ -> Nothing

fn empty_range_text(shown: String, l: Int, h: Int, ascending: Bool) -> String =
  "range `" ++ shown ++ "` is empty, so it yields no values: the start bound "
    ++ int_to_string(l)
    ++ (if ascending then " is above the end bound " else " is below the end bound ")
    ++ int_to_string(h)
    ++ (if ascending then ", and it counts upward only. To count downward write `range_down("
        else ", and it counts downward only. To count upward write `range_up(")
    ++ int_to_string(l) ++ ", " ++ int_to_string(h) ++ ")`"

fn reversed_literal_range(lo: ast.Expr, hi: ast.Expr) -> Maybe String =
  match (static_int_value(lo), static_int_value(hi)) with
  | (Just l, Just h) ->
      static_empty_range(lo, hi, 1, int_to_string(l) ++ ".." ++ int_to_string(h))
  | _ -> Nothing

# The constructor spelling of the same mistake.  Matched on the BARE name only:
# prelude functions are not module-qualified, so a user's own `range_up` inside a
# module reads as `mymod.range_up` here and is correctly left alone.
fn reversed_literal_range_call(name: String, env: Dict types.Scheme, args: List ast.Expr) -> Maybe String =
  match args with
  | [lo, hi] ->
      if ! yields_int_range (name, env) then Nothing
      else if name == "range_up" then
        static_empty_range(lo, hi, 1, call_form("range_up", lo, hi))
      else if name == "range_down" then
        static_empty_range(lo, hi, -1, call_form("range_down", lo, hi))
      else Nothing
  | _ -> Nothing

# Does `name` resolve to something that actually builds an IntRange?
#
# The name alone cannot answer this. A module's own top-level declarations are
# qualified (`main.range_up`), so those never collide — but PARAMETERS, `let`
# bindings and lambda parameters stay bare, and shadow the prelude's constructor
# under an identical spelling. Keying the diagnostic on the spelling therefore
# rejected `fn go(range_up: Int -> Int -> Int) -> Int = range_up(5, 1)`, a program
# with no range in it at all (tests/stdlib/test_range_name_shadowing.spr).
#
# The scheme settles it: the constructors return IntRange and a shadowing binding
# almost never does. Checked on the FINAL result so partial application is treated
# the same as a saturated call.
fn yields_int_range(name: String, env: Dict types.Scheme) -> Bool =
  match dict_get(name, env) with
  | Nothing -> false
  | Just s -> is_int_range(final_result_type(types.scheme_type(s)))

fn final_result_type(t: types.Type) -> types.Type =
  match t with
  | types.TFunc _ ret _ _ -> final_result_type(ret)
  | _ -> t

fn is_int_range(t: types.Type) -> Bool =
  match t with
  | types.TConst id -> types.type_id_eq(id, types.type_id("IntRange"))
  | _ -> false

fn call_form(fn_name: String, lo: ast.Expr, hi: ast.Expr) -> String =
  match (static_int_value(lo), static_int_value(hi)) with
  | (Just l, Just h) ->
      fn_name ++ "(" ++ int_to_string(l) ++ ", " ++ int_to_string(h) ++ ")"
  | _ -> fn_name

fn infer_range(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  lo: ast.Expr,
  hi: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    InferOk typed_lo s1 es1 lo_eff <- infer_expr(state, env, subst, eff_subst, lo) else InferErr p e -> InferErr(p, e)
    InferOk typed_hi s2 es2 hi_eff <- infer_expr(state, env, s1, es1, hi) else InferErr p e -> InferErr(p, e)
    let unifier.UnifyOk s3 es3 = unifier.unify_types(s2, es2, typed_ast.typed_expr_type(typed_lo), types.type_int()) else unifier.UnifyErr e -> InferErr(pos, "Range needs Int: " ++ e)
    let unifier.UnifyOk s4 es4 = unifier.unify_types(s3, es3, typed_ast.typed_expr_type(typed_hi), types.type_int()) else unifier.UnifyErr e -> InferErr(pos, "Range needs Int: " ++ e)
    match reversed_literal_range(lo, hi) with
    | Just message -> InferErr(pos, message)
    | Nothing ->
        InferOk(
          typed_ast.TRange(typed_lo, typed_hi,
            types.TConst(types.type_id("IntRange")), pos),
          s4, es4, merge_effects(lo_eff, hi_eff))

# ---------------------------------------------------------------------------
# List comprehensions (docs/list-comprehensions-v0.md D2-D4, §6)
# ---------------------------------------------------------------------------
#
# Elaborated here: inference rewrites a comprehension into the fold form of
# design §5 as ordinary untyped ast.Expr and infers that, so no typed
# comprehension node ever exists at any point.

# --- List comprehensions (docs/list-comprehensions-v0.md) --------------------
#
# Two phases, both here, because BOTH need types that only inference has:
#
#   1. CHECK — walk the generators left to right to (a) resolve each source
#      against the closed set, which is what selects the fold, and (b) raise the
#      design's diagnostics (§7) while the user's own expressions are still in
#      hand, so errors point at what they wrote.
#   2. ELABORATE — build the §5 fold form as ordinary UNTYPED ast.Expr and infer
#      THAT. The synthesized code goes through the same typechecker as
#      hand-written code, so a mistake here is a type error rather than a
#      miscompile, and no comprehension node ever exists downstream.
#
# Phase 2 must stay inside inference, not a later pass: `fn_linear_gate`
# (:8069, called from typecheck_decl) runs linear_check on each declaration's
# typed body DURING inference. Elaborating here means the synthesized fold
# lambdas are present when that gate runs, so a linear value bound or consumed
# by a comprehension is judged by the existing lambda rules (lin_lambda) rather
# than slipping past an unreachable stub.
#
# The check phase's typed output is discarded; only the source kinds and the
# substitution carry forward. Sources are therefore inferred twice, which costs
# compile time only — the synthesized tree embeds each source expression ONCE,
# so runtime evaluation multiplicity is D4's.
fn infer_comprehension(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  elem: ast.Expr,
  gens: List ast.ComprehensionGen,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    cr <- check_comprehension_gens(state, env, subst, eff_subst, gens, Nil)
    match cr with
    | CompErr cpos m -> InferErr(cpos, m)
    | CompOk kinds s1 es1 ->
        infer_expr(state, env, s1, es1, build_comprehension(elem, gens, kinds, pos))

# Result of the check phase: the per-generator source kinds, in source order,
# plus the substitution the checks solved.
type CompCheck =
  | CompOk (List CompKind) (Dict types.Type) (Dict types.Effect)
  | CompErr source.SourcePos String

type CompKind =
  | KindList
  | KindIntRange

# A generator's binder does not scope over its own source
# (docs/list-comprehensions-v0.md D2, §6) — `src` is checked in the CURRENT
# `env`, before this generator's pattern is bound into it.
fn check_comprehension_gens(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  gens: List ast.ComprehensionGen,
  acc_kinds: List CompKind
) -> CompCheck !{IO} =
  match gens with
  | Nil -> CompOk(comp_kind_list_reverse(acc_kinds), subst, eff_subst)
  | Cons g rest ->
      match g with
      | ast.ComprehensionGen pat src guards ->
          do
            sr <- infer_expr(state, env, subst, eff_subst, src)
            match sr with
            | InferErr spos e -> CompErr(spos, e)
            | InferOk typed_src s1 es1 _ ->
                match resolve_comprehension_source(unifier.apply_subst(s1, typed_ast.typed_expr_type(typed_src)), src) with
                | Err msg -> CompErr(typed_ast.typed_expr_pos(typed_src), msg)
                | Ok elem_and_kind ->
                    check_comprehension_gen_body(state, env, s1, es1, pat, elem_and_kind, guards, rest, acc_kinds)

fn check_comprehension_gen_body(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  pat: ast.Pattern,
  elem_and_kind: (types.Type, CompKind),
  guards: List ast.Expr,
  rest: List ast.ComprehensionGen,
  acc_kinds: List CompKind
) -> CompCheck !{IO} =
  match elem_and_kind with
  | (elem_type, kind) ->
      do
        ctor_map <- unifier.get_ctor_map(state)
        # D3: a refutable generator pattern is rejected, not filtered. Reuses
        # W5's exhaustiveness judgement rather than a bespoke refutability
        # predicate — the same routing parser.build_do_total uses for a
        # no-`else` do-bind. Match this Maybe-!{IO} check DIRECTLY: a `<-` bind
        # would strip the Maybe layer (see infer_branches's identical caveat
        # above, around :3960).
        match exhaustiveness_check(state, env, subst, ctor_map, elem_type,
                                    Cons(typed_ast.TypedMatchBranch(pat, typed_ast.TUnit(elem_type, no_pos())), Nil)) with
        | Just w -> CompErr(pat_pos(pat), refutable_generator_message(w))
        | Nothing ->
            do
              pr <- infer_pattern(state, env, subst, eff_subst, elem_type, pat)
              match pr with
              | InferErr ppos e -> CompErr(ppos, e)
              | InferOk _ s2 es2 _ ->
                  do
                    let env2 = extend_env_with_existential_givens(pat, s2, extend_env_from_pattern(pat, s2, env))
                    gr <- check_comprehension_guards(state, env2, s2, es2, guards)
                    match gr with
                    | CompErr gpos e -> CompErr(gpos, e)
                    | CompOk _ s3 es3 ->
                        check_comprehension_gens(state, env2, s3, es3, rest, Cons(kind, acc_kinds))

fn comp_kind_list_reverse(xs: List CompKind) -> List CompKind =
  comp_kind_list_reverse_go(xs, Nil)

fn comp_kind_list_reverse_go(xs: List CompKind, acc: List CompKind) -> List CompKind =
  match xs with
  | Nil -> acc
  | Cons h t -> comp_kind_list_reverse_go(t, Cons(h, acc))

# --- Elaboration (docs/list-comprehensions-v0.md §5) -------------------------
#
#   [e for p1 in s1 if g1, p2 in s2 if g2]
#
# becomes
#
#   list_reverse(
#     FOLD1(\ (a1, v1) -> match v1 with | p1 ->
#             if g1 then
#               FOLD2(\ (a2, v2) -> match v2 with | p2 ->
#                       if g2 then Cons(e, a2) else a2,
#                     a1, s2)
#             else a1,
#           Nil, s1))
#
# ONE accumulator is threaded through every level, so exactly one list_reverse
# runs however many generators there are. A guard yields the accumulator
# unchanged, which is what makes an outer guard skip the entire inner fold.
#
# The user's own sub-expressions (element, guards, sources) are spliced in
# unchanged, carrying their original positions — so a type error inside them
# still points at what the user wrote. Each source appears exactly ONCE, giving
# D4's evaluation multiplicity: the first is an argument of the outermost fold
# (evaluated once); a later one sits inside the enclosing step lambda
# (evaluated once per outer element).
fn build_comprehension(elem: ast.Expr, gens: List ast.ComprehensionGen, kinds: List CompKind, pos: source.SourcePos) -> ast.Expr =
  ast.CallExpr(
    ast.VarExpr("list_reverse", pos),
    Cons(build_comp_level(elem, gens, kinds, ast.VarExpr(ast.list_ctor_nil, pos), 0, pos), Nil),
    pos)

# `init` is the accumulator this level's fold starts from: `Nil` outermost, the
# enclosing level's accumulator variable further in.
fn build_comp_level(elem: ast.Expr, gens: List ast.ComprehensionGen, kinds: List CompKind,
                    init: ast.Expr, depth: Int, pos: source.SourcePos) -> ast.Expr =
  match gens with
  | Nil -> init
  | Cons g rest ->
      match g with
      | ast.ComprehensionGen pat src guards ->
          build_comp_fold(elem, pat, src, guards, rest, kinds, init, depth, pos)

fn build_comp_fold(elem: ast.Expr, pat: ast.Pattern, src: ast.Expr, guards: List ast.Expr,
                   rest: List ast.ComprehensionGen, kinds: List CompKind, init: ast.Expr,
                   depth: Int, pos: source.SourcePos) -> ast.Expr =
  let acc_name = comp_tmp_name("acc", depth, pos)
      val_name = comp_tmp_name("val", depth, pos)
      inner = build_comp_inner(elem, rest, comp_kinds_tail(kinds), acc_name, depth, pos)
      guarded = build_comp_guards(guards, inner, acc_name, pos)
      body = build_comp_destructure(pat, val_name, guarded, pos)
      step = ast.LambdaExpr(
        Cons(ast.Param(acc_name, Nothing, ast.ModeDefault),
          Cons(ast.Param(comp_param_name(pat, val_name), Nothing, ast.ModeDefault), Nil)),
        body, pos)
  in ast.CallExpr(ast.VarExpr(comp_fold_name(kinds), pos),
       Cons(step, Cons(init, Cons(src, Nil))), pos)

# The innermost level contributes an element; every other level opens the next
# fold, starting it from THIS level's accumulator.
fn build_comp_inner(elem: ast.Expr, rest: List ast.ComprehensionGen, kinds_tail: List CompKind,
                    acc_name: String, depth: Int, pos: source.SourcePos) -> ast.Expr =
  match rest with
  | Nil ->
      ast.CallExpr(ast.VarExpr(ast.list_ctor_cons, pos),
        Cons(elem, Cons(ast.VarExpr(acc_name, pos), Nil)), pos)
  | _ -> build_comp_level(elem, rest, kinds_tail, ast.VarExpr(acc_name, pos), depth + 1, pos)

# Guards nest outside-in; a failing guard yields the accumulator untouched.
fn build_comp_guards(guards: List ast.Expr, inner: ast.Expr, acc_name: String, pos: source.SourcePos) -> ast.Expr =
  match guards with
  | Nil -> inner
  | Cons g rest ->
      ast.IfExpr(g, build_comp_guards(rest, inner, acc_name, pos), ast.VarExpr(acc_name, pos), pos)

# A lambda parameter must be an identifier (parser.sprout:1414), so any pattern
# that is not a plain variable is destructured by a one-arm `match` — the same
# shape parser.build_do_total uses. The pattern is already known irrefutable
# (checked above), so this match cannot fail at runtime and W5 accepts it.
fn build_comp_destructure(pat: ast.Pattern, val_name: String, inner: ast.Expr, pos: source.SourcePos) -> ast.Expr =
  match pat with
  | ast.VarPattern _ _ -> inner
  | _ -> ast.MatchExpr(ast.VarExpr(val_name, pos), Cons(ast.MatchBranch(pat, inner), Nil), pos)

# A plain variable pattern becomes the fold parameter directly, so the common
# case emits no match at all.
fn comp_param_name(pat: ast.Pattern, val_name: String) -> String =
  match pat with
  | ast.VarPattern n _ -> n
  | _ -> val_name

fn comp_fold_name(kinds: List CompKind) -> String =
  match kinds with
  | [KindIntRange | _] -> "range_fold"
  | _ -> "list_fold"

fn comp_kinds_tail(kinds: List CompKind) -> List CompKind =
  match kinds with
  | Nil -> Nil
  | Cons _ t -> t

# Position-derived, like parser.do_tmp_name, and additionally indexed by nesting
# depth so two generators of the same comprehension cannot collide. The prefix
# keeps these out of the user's namespace, and linear_check matches on it to
# recognize a synthesized fold.
fn comp_tmp_name(tag: String, depth: Int, pos: source.SourcePos) -> String =
  ast.comp_binder_prefix ++ tag ++ int_to_string(pos.line) ++ "_" ++ int_to_string(pos.column)
    ++ "_" ++ int_to_string(depth)

# A guard must be Bool. The synthesized `if` would enforce this anyway, but
# checking here reports it at the guard's own position instead of inside code
# the user never wrote.
fn check_comprehension_guards(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  guards: List ast.Expr
) -> CompCheck !{IO} =
  match guards with
  | Nil -> CompOk(Nil, subst, eff_subst)
  | Cons g rest ->
      do
        gr <- infer_expr(state, env, subst, eff_subst, g)
        match gr with
        | InferErr pos e -> CompErr(pos, e)
        | InferOk typed_g s1 es1 _ ->
            match unifier.unify_types(s1, es1, typed_ast.typed_expr_type(typed_g), types.type_bool()) with
            | unifier.UnifyErr e -> CompErr(typed_ast.typed_expr_pos(typed_g), e)
            | unifier.UnifyOk s2 es2 ->
                check_comprehension_guards(state, env, s2, es2, rest)

# §7 diagnostic 3/4: the rejection plus the actionable half (W5's witness),
# plus the escape hatch. Both diagnostic variants in the design share this
# wording; only the witness `w` differs by source shape.
fn refutable_generator_message(w: String) -> String =
  "generator pattern must be irrefutable; " ++ w ++
  ". To drop non-matching elements, use list_filter_map to filter before the comprehension."

# The closed generator set (docs/list-comprehensions-v0.md D2): List and
# IntRange only. Anything else — including a still-unresolved type
# variable — is an error, never a default.
fn resolve_comprehension_source(src_ty: types.Type, src_expr: ast.Expr) -> Result String (types.Type, CompKind) =
  match src_ty with
  | types.TApp base arg ->
      match base with
      | types.TConst id ->
          if types.type_id_name(id) == "List" then Ok((arg, KindList))
          else Err(unsupported_source_message(src_ty, src_expr))
      | _ -> Err(unsupported_source_message(src_ty, src_expr))
  | types.TConst id ->
      if types.type_id_name(id) == "IntRange" then Ok((types.type_int(), KindIntRange))
      else Err(unsupported_source_message(src_ty, src_expr))
  | types.TVar _ -> Err(undetermined_source_message(src_expr))
  | _ -> Err(unsupported_source_message(src_ty, src_expr))

fn comprehension_source_display(src_expr: ast.Expr) -> String =
  match src_expr with
  | ast.VarExpr name _ -> "`" ++ name ++ "`"
  | _ -> "the source"

fn comprehension_source_arg_text(src_expr: ast.Expr) -> String =
  match src_expr with
  | ast.VarExpr name _ -> name
  | _ -> "…"

fn vec_conversion_hint(src_ty: types.Type, src_expr: ast.Expr) -> String =
  match src_ty with
  | types.TApp base _ ->
      match base with
      | types.TConst id ->
          if types.type_id_name(id) == "Vec"
          then " — convert with `vec_to_list(" ++ comprehension_source_arg_text(src_expr) ++ ")`"
          else ""
      | _ -> ""
  | _ -> ""

fn unsupported_source_message(src_ty: types.Type, src_expr: ast.Expr) -> String =
  "a comprehension generator ranges over a `List` or an `IntRange`; " ++
  comprehension_source_display(src_expr) ++ " is a `" ++ types.type_to_string(src_ty) ++ "`" ++
  vec_conversion_hint(src_ty, src_expr)

fn undetermined_source_message(src_expr: ast.Expr) -> String =
  "cannot tell what " ++ comprehension_source_display(src_expr) ++
  " ranges over; a comprehension generator needs a known `List` or `IntRange` type — annotate the parameter"

# ---------------------------------------------------------------------------
# Program-level typechecking
# ---------------------------------------------------------------------------

export fn typecheck_decls(
  state: unifier.InferState,
  decls: List ast.Decl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect
) -> typed_ast.TypedResult !{IO} =
  do
    # Pre-scan: register all FnDecl signatures (constraint field included) in env
    # before processing bodies.  This enables forward references and
    # mutual recursion (e.g., decorated_sort_split calling decorated_sort which
    # is defined later in the same file).
    # The importer's type-name spellings, lifted out of the env's @qual* markers
    # into the alias_env — which is the base every local_vars dict is built on
    # (build_type_var_dict), so lookup_type_var sees them at every annotation
    # position without threading a new parameter through inference.
    let qual_env = import_aliases_from_env(env)
    let scanned_env = pre_scan_fn_decls(decls, env, qual_env)
    unifier.set_ctor_map(state, build_ctor_map(decls, dict_empty()))
    # Strict type-name validation: walk every TypeExpr in every type/alias/record
    # declaration and error immediately if a referenced type name is not declared.
    # Runs after pre_scan so mutually recursive ADTs are always in the declared set.
    #
    # The vocabulary is this module's own declarations PLUS the imported names the
    # env carries as @type: markers. Both halves are needed: the file-bundling path
    # inlines the prelude so its types are ordinary decls, while the REPL / LSP /
    # analysis-service path supplies them as env schemes and nothing else would put
    # `Vec` or an imported `Utf8Error` in scope. Mirrors the class-name seed below.
    let own_type_names = collect_declared_type_names(decls, Nil)
    let declared_types = own_type_names ++ type_names_from_env(env, builtin_type_names())
    # Export this module's own type names so its importers get the same treatment.
    let scanned_env_with_types = mark_declared_types(own_type_names, scanned_env)
    match validate_all_decls(decls, declared_types) with
    | Just (pos, err_msg) -> typed_ast.TypedErr(pos, err_msg)
    | Nothing ->
      match validate_constraints_all(decls, collect_declared_class_names(decls, class_names_from_env(env, Nil))) with
      | Just (pos, err_msg) -> typed_ast.TypedErr(pos, err_msg)
      | Nothing ->
        match check_duplicate_fn_decls(decls, dict_empty()) with
        | Just (pos, err_msg) -> typed_ast.TypedErr(pos, err_msg)
        | Nothing ->
          match check_tyvar_instance_heads(decls) with
          | Just (pos, err_msg) -> typed_ast.TypedErr(pos, err_msg)
          | Nothing ->
            match check_overlapping_instances(decls, dict_empty()) with
            | Just (pos, err_msg) -> typed_ast.TypedErr(pos, err_msg)
            | Nothing ->
              match check_missing_superclass_instances(decls) with
              | Just (pos, err_msg) -> typed_ast.TypedErr(pos, err_msg)
              | Nothing ->
                match check_existential_constraints(decls) with
                | Just (pos, err_msg) -> typed_ast.TypedErr(pos, err_msg)
                | Nothing ->
                # Wrap scanned_env_with_types as GlobalEnv at this seam — it is the
                # output of pre_scan_fn_decls (Dict, raw pre-pass) plus this module's
                # @type: markers. From here on the env flows between decls as the
                # wrap-protected GlobalEnv, and out to importers as the checked env.
                # ftv is unaffected: a marker's body is a TConst, never a free var.
                match typecheck_decls_inner(state, decls, GlobalEnv(scanned_env_with_types), subst, eff_subst, qual_env, Nil, unifier.ftv_env(scanned_env_with_types)) with
                | typed_ast.TypedErr p m -> typed_ast.TypedErr(p, m)
                | typed_ast.TypedOk prog schemes ->
                    # Final gate: a DEFINED `main` must be a well-formed entrypoint.
                    # Runs only on an otherwise-valid program, so a broken main body
                    # reports its own error first (this never masks it).
                    match validate_entrypoint(decls) with
                    | Just (pos, msg) -> typed_ast.TypedErr(pos, msg)
                    | Nothing -> typed_ast.TypedOk(prog, schemes)

# ---------------------------------------------------------------------------
# Strict type-name validation pass
# ---------------------------------------------------------------------------
#
# After pre_scan_fn_decls registers all type constructors, this pass walks
# every TypeExpr in TypeDecl constructor fields, RecordDecl field types, and
# AliasDecl RHS expressions.  An uppercase TypeName that does not appear in
# the declared-type set is reported as a hard error before unification runs.
#
# Forward references are safe: this pass runs after pre_scan_fn_decls has
# already collected all type names for the entire module.
#
# Positions covered: TypeDecl constructor fields, RecordDecl fields, AliasDecl RHS.
# ClassDecl/InstanceDecl/FnDecl signature positions are not yet covered (follow-up).
#
# Type parameters (always lowercase in Sprout, e.g. `a`, `b`) are detected by
# is_lowercase_name and skipped without consulting the declared set.
# Qualified names (e.g. `stdlib.compiler.ast.TypeExpr`) are stripped to their
# short form before lookup, matching the after_last_dot convention used
# throughout lookup_type_var.

# O(1): built-in primitive type names always valid without a declaration.
# primitive_type_names covers language-level primitives;
# c_runtime_type_names covers opaque C-runtime types used in stdlib TypeDecl/AliasDecl:
#   Vector   — backing store for Vec a and MutVec a (prelude.sprout)
#   Map      — backing store for Dict v (prelude.sprout)
#   NativeSet — backing store for Set (prelude.sprout)
#   Ref      — mutable reference cell (test.sprout TestState, unifier.sprout InferState,
#               lsp_driver.sprout LspState, analysis_service_driver.sprout StartupState,
#               module_loader.sprout ModuleCache alias)
fn builtin_type_names() -> List String =
  append(primitive_type_names(), c_runtime_type_names())

fn primitive_type_names() -> List String =
  ["Int", "Double", "Bool", "String", "Char", "Unit", "Bytes"]

fn c_runtime_type_names() -> List String =
  ["Vector", "Map", "NativeSet", "Ref"]

# O(n decls): collect short names (prefix-stripped) of all declared types.
fn collect_declared_type_names(decls: List ast.Decl, acc: List String) -> List String =
  match decls with
  | Nil -> acc
  | Cons decl rest ->
      match decl with
      | ast.TypeDecl name _ _ _ _ _ ->
          collect_declared_type_names(rest, Cons(string.after_last_dot(name), acc))
      | ast.RecordDecl name _ _ _ _ _ ->
          collect_declared_type_names(rest, Cons(string.after_last_dot(name), acc))
      | ast.AliasDecl name _ _ _ ->
          collect_declared_type_names(rest, Cons(string.after_last_dot(name), acc))
      | ast.WrapDecl name _ _ ->
          collect_declared_type_names(rest, Cons(string.after_last_dot(name), acc))
      | _ -> collect_declared_type_names(rest, acc)

# O(depth): validate a single TypeExpr, returning the first error found.
fn validate_te(te: ast.TypeExpr, decl_name: String, declared: List String) -> Maybe String =
  match te with
  | ast.TypeName name ->
      if is_lowercase_name(name) then Nothing
      else
        if types.list_member(string.after_last_dot(name), declared) then Nothing
        else Just("type-validation: unknown type name `" ++ string.after_last_dot(name) ++
                  "` in declaration `" ++ string.after_last_dot(decl_name) ++ "`")
  | ast.TypeApply left right ->
      match validate_te(left, decl_name, declared) with
      | Just e -> Just(e)
      | Nothing -> validate_te(right, decl_name, declared)
  | ast.TypeArrow param ret _ ->
      match validate_te(param, decl_name, declared) with
      | Just e -> Just(e)
      | Nothing -> validate_te(ret, decl_name, declared)
  | ast.TypeEffect inner _ -> validate_te(inner, decl_name, declared)
  | ast.TupleType parts -> validate_te_list(parts, decl_name, declared)

fn validate_te_list(parts: List ast.TypeExpr, decl_name: String, declared: List String) -> Maybe String =
  match parts with
  | Nil -> Nothing
  | Cons h rest ->
      match validate_te(h, decl_name, declared) with
      | Just e -> Just(e)
      | Nothing -> validate_te_list(rest, decl_name, declared)

fn validate_ctors(
  ctors: List ast.TypeConstructor,
  decl_name: String,
  declared: List String
) -> Maybe String =
  match ctors with
  | Nil -> Nothing
  | Cons ctor rest ->
      match ctor with
      | ast.TypeConstructor _ fields _ _ ->
          match validate_te_list(fields, decl_name, declared) with
          | Just e -> Just(e)
          | Nothing -> validate_ctors(rest, decl_name, declared)

fn validate_record_fields(
  fields: List ast.RecordFieldDecl,
  decl_name: String,
  declared: List String
) -> Maybe String =
  match fields with
  | Nil -> Nothing
  | Cons field rest ->
      match field with
      | ast.RecordFieldDecl _ ftype ->
          match validate_te(ftype, decl_name, declared) with
          | Just e -> Just(e)
          | Nothing -> validate_record_fields(rest, decl_name, declared)

fn validate_decl(decl: ast.Decl, declared: List String) -> Maybe String =
  match decl with
  | ast.TypeDecl name _ ctors _ _ _ ->
      validate_ctors(ctors, name, declared)
  | ast.RecordDecl name _ fields _ _ _ ->
      validate_record_fields(fields, name, declared)
  | ast.AliasDecl name _ rhs _ ->
      validate_te(rhs, name, declared)
  | ast.WrapDecl name inner _ ->
      validate_te(inner, name, declared)
  | _ -> Nothing

fn validate_all_decls(decls: List ast.Decl, declared: List String) -> Maybe(source.SourcePos, String) =
  match decls with
  | Nil -> Nothing
  | Cons decl rest ->
      match validate_decl(decl, declared) with
      | Just e -> Just((ast.decl_pos(decl), e))
      | Nothing -> validate_all_decls(rest, declared)

# ---------------------------------------------------------------------------
# Constraint class-name validation
# ---------------------------------------------------------------------------
#
# A `where` clause names the CLASS first, then the constrained type variable(s):
# `where ToString a`. A variable-first swap (`where a ToString`) parses as a
# constraint on a class literally named `a`, silently constrains nothing, and
# lowers to an undefined class-method call that only fails at link time. Reject
# it here: every FnDecl constraint head must be a declared class. Mirrors the
# type-name pass above, closing the FnDecl follow-up it notes.
#
# Class parameters are always lowercase and are never constraint heads, so the
# declared-class set (short names, prefix-stripped) is the whole vocabulary.

# Short names (prefix-stripped) of every declared class.
fn collect_declared_class_names(decls: List ast.Decl, acc: List String) -> List String =
  match decls with
  | Nil -> acc
  | Cons decl rest ->
      match decl with
      | ast.ClassDecl name _ _ _ _ ->
          collect_declared_class_names(rest, Cons(string.after_last_dot(name), acc))
      | _ -> collect_declared_class_names(rest, acc)

# Class names recoverable from the type environment's `@class:{method}` markers.
# Each marker's scheme body is `TConst(class_name)` (register_class_method_markers).
# The analysis-service / REPL path (check_program_with_env) supplies imported and
# prelude classes as env schemes rather than ClassDecl nodes, so scanning decls
# alone leaves the class set empty and every `where ToString a` reads as unknown.
fn class_names_from_env(env: Dict types.Scheme, acc: List String) -> List String =
  class_names_from_entries(vec_to_list(dict_entries(env)), acc)

fn class_names_from_entries(entries: List (String, types.Scheme), acc: List String) -> List String =
  match entries with
  | [] -> acc
  | [(key, scheme) | rest] ->
      if str_starts_with(key, "@class:") then
        match scheme with
        | types.Scheme _ _ (types.TConst id) _ _ ->
            class_names_from_entries(rest, list_add_unique(string.after_last_dot(types.type_id_name(id)), acc))
        | _ -> class_names_from_entries(rest, acc)
      else class_names_from_entries(rest, acc)

# Type names recoverable from the type environment's `@type:{TypeName}` markers,
# the exact counterpart of class_names_from_env above (mark_declared_types writes
# them; each marker's scheme body is `TConst(type_name)`). Same motivation: the
# analysis-service / REPL path supplies the prelude and every imported module as
# env schemes rather than decl nodes, so seeding the type vocabulary from decls
# alone leaves `Vec`, `Dict`, `Result` and every cross-module type name unknown.
# Lift module_loader's @qualalias: markers into an alias_env seed, keyed
# identically so lookup_type_var reads them back. alias_env is the base every
# local_vars dict is built on (build_type_var_dict), so the sentinels reach
# every annotation position without threading a parameter through inference.
fn import_aliases_from_env(env: Dict types.Scheme) -> Dict types.Type =
  import_aliases_go(vec_to_list(dict_entries(env)), dict_empty())

fn import_aliases_go(entries: List (String, types.Scheme), acc: Dict types.Type) -> Dict types.Type =
  match entries with
  | [] -> acc
  | [(key, scheme) | rest] ->
      if str_starts_with(key, "@qualalias:") then
        match scheme with
        | types.Scheme _ _ (types.TConst id) _ _ ->
            import_aliases_go(rest, dict_set(key, types.TConst(id), acc))
        | _ -> import_aliases_go(rest, acc)
      else import_aliases_go(rest, acc)

fn type_names_from_env(env: Dict types.Scheme, acc: List String) -> List String =
  type_names_from_entries(vec_to_list(dict_entries(env)), acc)

fn type_names_from_entries(entries: List (String, types.Scheme), acc: List String) -> List String =
  match entries with
  | [] -> acc
  | [(key, scheme) | rest] ->
      if str_starts_with(key, "@type:") then
        match scheme with
        | types.Scheme _ _ (types.TConst id) _ _ ->
            type_names_from_entries(rest, list_add_unique(string.after_last_dot(types.type_id_name(id)), acc))
        | _ -> type_names_from_entries(rest, acc)
      else type_names_from_entries(rest, acc)

# The first constraint argument that is itself a known class name — the tell of a
# variable-first swap like `where a ToString` (arg `ToString` is the real class),
# used to offer a precise "did you mean" hint.
fn first_known_class_arg(args: List ast.TypeExpr, classes: List String) -> Maybe String =
  match args with
  | Nil -> Nothing
  | Cons te rest ->
      match te with
      | ast.TypeName name ->
          if types.list_member(string.after_last_dot(name), classes)
          then Just(string.after_last_dot(name))
          else first_known_class_arg(rest, classes)
      | _ -> first_known_class_arg(rest, classes)

# Real type variables that appear in a function's parameter annotations and
# return type — the variables a `where` constraint may legitimately mention.
# Unannotated parameters contribute none (their type is an unnamed fresh var).
fn fn_sig_tyvars(params: List ast.Param, ret_maybe: Maybe ast.TypeExpr) -> List String =
  fn_sig_tyvars_ret(ret_maybe, fn_sig_tyvars_params(params, Nil))

fn fn_sig_tyvars_params(params: List ast.Param, acc: List String) -> List String =
  match params with
  | Nil -> acc
  | Cons p rest ->
      match p with
      | ast.Param _ (Just te) _ -> fn_sig_tyvars_params(rest, collect_te_vars(te, acc))
      | ast.Param _ Nothing _ -> fn_sig_tyvars_params(rest, acc)

fn fn_sig_tyvars_ret(ret_maybe: Maybe ast.TypeExpr, acc: List String) -> List String =
  match ret_maybe with
  | Just te -> collect_te_vars(te, acc)
  | Nothing -> acc

# The "did you mean" tail for a swapped `where`. A constraint only binds when its
# type variable appears in the signature, so suggest one that actually does; when
# none does (an unannotated parameter), point to annotating one — `where <Class>
# <head>` on a value parameter would be a vacuous constraint that still fails at
# link time (the exact trap this whole pass exists to catch).
fn order_hint_tail(cls: String, decl_name: String, head: String, sig_tyvars: List String) -> String =
  if types.list_member(head, sig_tyvars) then
    "did you mean `where " ++ cls ++ " " ++ head ++ "`? (the class name comes first, the type variable second)"
  else
    match sig_tyvars with
    | [v | _] -> "did you mean `where " ++ cls ++ " " ++ v ++ "`? (the class name comes first, then a type variable from the signature)"
    | [] -> "a constraint applies a class to a type variable — annotate a parameter and constrain it, e.g. `fn " ++
            string.after_last_dot(decl_name) ++ "(x: a) ... where " ++ cls ++ " a`"

fn swapped_order_hint(head: String, decl_name: String, cls: String, sig_tyvars: List String) -> String =
  "constraint-validation: `" ++ head ++ "` is not a class in the `where` clause of `" ++
  string.after_last_dot(decl_name) ++ "`; " ++ order_hint_tail(cls, decl_name, head, sig_tyvars)

# The first type variable in `vs` that is not among the signature's type
# variables, or Nothing when all are present.
fn first_absent_tyvar(vs: List String, sig_tyvars: List String) -> Maybe String =
  match vs with
  | [] -> Nothing
  | [v | rest] ->
      if types.list_member(v, sig_tyvars) then first_absent_tyvar(rest, sig_tyvars)
      else Just(v)

# A well-ordered constraint (`where <Class> <var>`) still binds nothing when its
# type variable is not one the signature introduces — e.g. `where ToString x`
# where `x` is a value parameter, or `where Eq b` where only `a` is annotated.
# Such a constraint lowers to an undefined class-method call that fails at link
# time, so reject it here and point to annotating the parameter.
fn check_constraint_tyvars_in_sig(cls: String, args: List ast.TypeExpr, decl_name: String, sig_tyvars: List String) -> Maybe String =
  match first_absent_tyvar(collect_te_vars_list(args, Nil), sig_tyvars) with
  | Nothing -> Nothing
  | Just v ->
      Just("constraint-validation: constraint `" ++ string.after_last_dot(cls) ++ " " ++ v ++
           "` mentions type variable `" ++ v ++ "`, which does not appear in the signature of `" ++
           string.after_last_dot(decl_name) ++
           "`; a `where` constraint applies a class to a type variable from the signature — annotate a parameter, e.g. `fn " ++
           string.after_last_dot(decl_name) ++ "(x: a) ... where " ++ string.after_last_dot(cls) ++ " a`")

fn validate_fn_constraint(c: ast.TypeConstraint, decl_name: String, classes: List String, sig_tyvars: List String) -> Maybe String =
  match c with
  | ast.TypeConstraint head args ->
      if types.list_member(string.after_last_dot(head), classes)
      then check_constraint_tyvars_in_sig(head, args, decl_name, sig_tyvars)
      else
        match first_known_class_arg(args, classes) with
        | Just cls -> Just(swapped_order_hint(head, decl_name, cls, sig_tyvars))
        | Nothing ->
            Just("constraint-validation: `" ++ string.after_last_dot(head) ++
                 "` is not a class in the `where` clause of `" ++ string.after_last_dot(decl_name) ++ "`")

fn validate_fn_constraints(cs: List ast.TypeConstraint, decl_name: String, classes: List String, sig_tyvars: List String) -> Maybe String =
  match cs with
  | Nil -> Nothing
  | Cons c rest ->
      match validate_fn_constraint(c, decl_name, classes, sig_tyvars) with
      | Just e -> Just(e)
      | Nothing -> validate_fn_constraints(rest, decl_name, classes, sig_tyvars)

fn validate_constraints_all(decls: List ast.Decl, classes: List String) -> Maybe(source.SourcePos, String) =
  match decls with
  | Nil -> Nothing
  | Cons decl rest ->
      match decl with
      | ast.FnDecl name params ret _ constraints _ _ ->
          match validate_fn_constraints(constraints, name, classes, fn_sig_tyvars(params, ret)) with
          | Just e -> Just((ast.decl_pos(decl), e))
          | Nothing -> validate_constraints_all(rest, classes)
      | _ -> validate_constraints_all(rest, classes)

# ---------------------------------------------------------------------------
# Executable entrypoint validation
# ---------------------------------------------------------------------------
#
# A function named `main` (bare, or the entry module's qualified `<mod>.main`)
# is only ever an intended process entrypoint, so if one is DEFINED it must be
# well-formed: zero parameters, a `Unit` or `Int` return type, and a concrete
# `!{IO}` effect (not pure, not effect-polymorphic). An `Int` return is the
# process exit code (see ast_to_ir.user_main_fn_name); any other return type
# would be forced through the Unit wrapper and miscompile.
#
# Runs as a FINAL gate on an otherwise-valid program (only when the body
# typechecks), so a broken `main` body reports its own error first and this
# check never masks it. A MISSING `main` is NOT an error here: a library
# legitimately defines none, and typecheck cannot distinguish a library check
# from an executable build. "missing main" is enforced only on the executable
# codegen path.
#
# The gate reads the DECLARED signature off the parse tree, never the inferred
# type, so an unannotated `fn main() = ...` fails it. That is its own diagnostic
# (`must declare its return type and effect`) rather than the wrong-return-type
# one: "no annotation" and "annotated with the wrong type" are different
# mistakes and reporting the second for the first sends the author to read a
# body that is fine. Every diagnostic here also carries main_signature_hint, so
# one edit fixes the signature outright instead of each rejected field
# surfacing the next one.
#
# is_main_decl_name mirrors ast_to_ir.is_entry_fn_name / codegen.is_entry_fn_name.
fn is_main_decl_name(name: String) -> Bool =
  name == "main" || (n >= 5 && str_slice(name, n - 5, 5) == ".main")
  where n = str_len(name)

fn main_return_ok(ret: Maybe ast.TypeExpr) -> Bool =
  match ret with
  | Just (ast.TypeName "Unit") -> true
  | Just (ast.TypeName "Int") -> true
  | _ -> false

# An effect name is a variable (polymorphic) iff it is lowercase; concrete
# effects like `IO` are capitalized.
fn any_effect_var(effs: List String) -> Bool =
  match effs with
  | Nil -> false
  | Cons e rest -> if is_lowercase_name(e) then true else any_effect_var(rest)

# Every entrypoint diagnostic ends with the full accepted signature, so the
# author writes one correct annotation rather than fixing the return type only
# to be told about the effect next.
fn main_signature_hint() -> String =
  "; write `fn main() -> Unit !{IO}`, or `fn main() -> Int !{IO}` to set the process exit code"

fn main_error(what: String) -> Maybe String =
  Just("Executable entrypoint `main` " ++ what ++ main_signature_hint())

fn main_effect_error(effects: Maybe (List String)) -> Maybe String =
  match effects with
  | Nothing -> main_error("must declare the {IO} effect")
  | Just effs ->
      if any_effect_var(effs) then main_error("must not be effect-polymorphic")
      else if str_list_contains(effs, "IO") == false then main_error("must declare the {IO} effect")
      else Nothing

fn check_main_signature(params: List ast.Param, ret: Maybe ast.TypeExpr, effects: Maybe (List String)) -> Maybe String =
  match params with
  | [] ->
      # A return type is syntactically required before an effect row, so an
      # absent return type means the signature is unannotated outright.
      match ret with
      | Nothing -> main_error("must declare its return type and effect")
      | Just _ ->
          if main_return_ok(ret) == false then main_error("must return Unit or Int")
          else main_effect_error(effects)
  | _ -> main_error("must take zero arguments")

# Returns the first entrypoint diagnostic among the decls, or Nothing.
fn validate_entrypoint(decls: List ast.Decl) -> Maybe(source.SourcePos, String) =
  match decls with
  | Nil -> Nothing
  | Cons decl rest ->
      match decl with
      | ast.FnDecl name params ret effects _ _ _ ->
          if is_main_decl_name(name) then
            match check_main_signature(params, ret, effects) with
            | Just e -> Just((ast.decl_pos(decl), e))
            | Nothing -> validate_entrypoint(rest)
          else validate_entrypoint(rest)
      | _ -> validate_entrypoint(rest)

# ---------------------------------------------------------------------------
# Overlapping-instance validation pass
# ---------------------------------------------------------------------------
#
# Two instances whose head constructors coincide would register the same
# `@inst:{Class}:{Head}` marker, so the second silently shadows the first at
# dispatch.  Sprout has no orphan/overlap resolution, so this is always an
# error.  The key mirrors register_instance_marker exactly (head-constructor
# only), so `instance Bar (List a)` and `instance Bar (List b)` collide on
# `@inst:Bar:List` just like a literal duplicate does.  Scans the program's own
# decls (not the seeded prelude env), so prelude instances — each a distinct
# head — never false-positive.
#
# Since check_tyvar_instance_heads now restricts a head to a constructor applied
# to DISTINCT type variables, any two heads reaching here with the same
# constructor are alpha-equivalent — this pass no longer has a
# `List Int` vs `List Bool` case to over-approximate, because neither head is
# legal in the first place.
fn instance_key_and_class(c: ast.TypeConstraint) -> Maybe (String, String) =
  match c with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> Nothing
      | [head_te | _] ->
          Just((str_concat("@inst:", str_concat(class_name, str_concat(":", type_head_str(type_from_ast(head_te, dict_empty()))))),
                string.after_last_dot(class_name)))

# ---------------------------------------------------------------------------
# Duplicate top-level definition validation
# ---------------------------------------------------------------------------
#
# Two top-level `fn`s sharing a name lower to two `define` blocks for one mangled
# symbol, and the front end accepted that outright: `--phase check` reported OK
# and `--emit-ir` exited 0. The only thing that ever objected was
# `opt --passes=verify`, with a mangled name and no source position — and on the
# ordinary compile path the invalid IR goes straight to clang instead.
#
# Keyed on the NAME ALONE, not on (name, arity). Sprout has no overloading
# (docs/currying-and-pipe-decision-v1.md §9a.5), so a same-name/different-arity
# pair is two definitions of one symbol just the same. That case did fail before
# this check, but at the CALL site with an arity error — the second definition
# had shadowed the first in the env, so the caller was blamed for a defect in the
# module.
#
# Reports the SECOND occurrence, which is the line to delete.
#
# No false positive from bundling: `decls` here is post-bundler, where every
# imported module's definitions carry their module prefix, so a local `map` and
# the prelude's `map` are distinct keys. Only FnDecl participates — instance and
# class methods are InstanceMethodImpl/ClassMethodSig, not top-level decls, so
# the many `fn eq` implementations across instances never collide here.
fn check_duplicate_fn_decls(decls: List ast.Decl, seen: Dict Bool) -> Maybe(source.SourcePos, String) =
  match decls with
  | Nil -> Nothing
  | Cons decl rest ->
      match decl with
      | ast.FnDecl name _ _ _ _ _ pos ->
          match dict_get(name, seen) with
          | Just _ -> Just((pos, "`" ++ name ++ "` is defined more than once in this module"))
          | Nothing -> check_duplicate_fn_decls(rest, dict_set(name, true, seen))
      | _ -> check_duplicate_fn_decls(rest, seen)

# ---------------------------------------------------------------------------
# Type-variable instance-head validation
# ---------------------------------------------------------------------------
#
# `instance Boxer a` parses, and register_instance_marker registers it under
# `@inst:Boxer:a` — a key no dispatch site ever looks up, because dispatch
# resolves through concrete_type_str, which returns Nothing for a variable head,
# and no real type is spelled with a lowercase name. So the declaration looked
# accepted while EVERY use failed with "No instance of Boxer for T" at the CALL
# site, blaming the caller for a defect in the instance. Sprout has no
# catch-all/overlapping-instance resolution (see check_overlapping_instances), so
# a variable head can never become meaningful: reject it where it is written.
#
# Discriminates on the AST head, NOT on type_from_ast: that is called here with
# an empty local_vars, so an unbound `a` resolves to TConst("a") — indistinguishable
# from a genuine nullary constructor by the time types.Type is reached. The
# lowercase-initial convention (is_lowercase_name) is the same discriminator
# lowering.is_type_var_name and bundler.type_name_starts_lower use.
#
# The walk must mirror what type_from_ast does to the SAME TypeExpr, because the
# marker key is derived from that type. Getting this wrong is how the first cut
# of this check leaked (code review, 2026-08-15):
#   - TypeEffect: type_from_ast DROPS the annotation and recurses into `inner`,
#     so `a !{IO}` has exactly the head of `a`. Stopping here let an effect
#     annotation smuggle a bare variable head past the check.
#   - TypeArrow: becomes TFunc, which has no constructor head at all. Function
#     types have no instances (spec §8.5), and the pre-existing diagnostic for
#     that fires at the CALL site — the same misblame this pass exists to remove
#     — so reject the declaration instead.
#   - TupleType: becomes TTuple, whose type_head_str is `TupleN`. That IS a
#     legitimate concrete head; the prelude's `instance Eq (a, b)` depends on it,
#     so tuples must pass even though their elements are variables.
fn instance_head_problem(te: ast.TypeExpr) -> Maybe String =
  match te with
  | ast.TypeName n ->
      if is_lowercase_name(n) then Just("the type variable `" ++ n ++ "`") else Nothing
  | ast.TypeApply base _ -> instance_head_problem(base)
  | ast.TypeEffect inner _ -> instance_head_problem(inner)
  | ast.TypeArrow _ _ _ -> Just("a function type")
  | ast.TupleType _ -> Nothing

# The ARGUMENTS of the head, in source order.
#
# `ast.TypeApply` is BINARY (ast.sprout:10), so `Pair a b` is
# `TypeApply(TypeApply(TypeName "Pair", TypeName "a"), TypeName "b")` — the spine
# has to be walked or only the last argument is seen. Two forms are not spines:
# a tuple's arguments are its elements (its head is the TupleN constructor), and
# TypeEffect is transparent, because type_from_ast drops the annotation and the
# marker key is derived from the type it produces.
fn instance_head_args(te: ast.TypeExpr) -> List ast.TypeExpr =
  match te with
  | ast.TupleType items -> items
  | ast.TypeEffect inner _ -> instance_head_args(inner)
  | _ -> type_apply_spine_args(te, Nil)

fn type_apply_spine_args(te: ast.TypeExpr, acc: List ast.TypeExpr) -> List ast.TypeExpr =
  match te with
  | ast.TypeApply base arg -> type_apply_spine_args(base, Cons(arg, acc))
  | _ -> acc

# Haskell 2010 §4.3.2: the head is "a type constructor T applied to simple type
# variables u1, … uk … the ui must all be distinct". Sprout needs the same rule
# for a sharper reason than Haskell does — the `@inst:` key is derived by
# type_head_str, whose `TApp base _` arm DISCARDS every argument, so `List Int`
# and `List String` are one key. An instance that names a concrete argument
# therefore answers for types it was never written for, and its body runs on
# them: `instance Describe (List Int)` summing its elements accepted a
# `List String` and added the String pointers as machine integers (check OK,
# clean IR, no diagnostic anywhere). Rejecting the head is what makes the coarse
# key honest — every head it can represent is now a head it represents exactly.
#
# `seen` accumulates the variables already bound by this head, which is what
# distinctness is checked against; `Pair a a` is built only from variables and
# would otherwise pass, while still keying the same `@inst:C:Pair` that answers
# for `Pair Int Bool`.
#
# Lifting this restriction later is the GHC FlexibleInstances position, and it
# requires the key to carry the full head plus most-specific-wins matching — see
# the widening item in BACKLOG.md. Until then a nested argument is rejected too.
#
# The raw name is the right thing to test here, NOT string.after_last_dot(name)
# as is_constructor_ref does: is_lowercase_name already answers false for any
# dotted name, so a module-qualified type can never be taken for a type variable
# even though it may START lowercase. Verified — an aliased `instance Holder
# (List json.Json)` arrives here as `stdlib.json.Json` and is correctly reported
# as a concrete argument. Adding after_last_dot would BREAK that: it would reduce
# the name to `Json`, still uppercase and still rejected, but it would also
# reduce a hypothetical `mod.a` to a bare `a` and admit it.
fn head_arg_problem(args: List ast.TypeExpr, seen: List String) -> Maybe String =
  match args with
  | Nil -> Nothing
  | Cons a rest ->
      match a with
      | ast.TypeName n ->
          if is_lowercase_name(n) == false then Just("`" ++ n ++ "` is a concrete type")
          else if list_member(n, seen) then Just("`" ++ n ++ "` appears more than once")
          else head_arg_problem(rest, Cons(n, seen))
      | _ -> Just("one argument is not a type variable")

# Returns (class, rule) where `rule` completes "Instance head for {class} …".
# The head-shape rule is checked first: a variable or function head is a defect
# in the head ITSELF, and reporting it as an argument problem would misdescribe it.
fn instance_head_tyvar(c: ast.TypeConstraint) -> Maybe (String, String) =
  match c with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> Nothing
      | [head_te | _] ->
          match instance_head_problem(head_te) with
          | Just problem ->
              Just((string.after_last_dot(class_name),
                    "must be a concrete type, not " ++ problem))
          | Nothing ->
              match head_arg_problem(instance_head_args(head_te), Nil) with
              | Nothing -> Nothing
              | Just detail ->
                  Just((string.after_last_dot(class_name),
                        "must be a type constructor applied to distinct type variables, but " ++ detail))

fn check_tyvar_instance_heads(decls: List ast.Decl) -> Maybe(source.SourcePos, String) =
  match decls with
  | Nil -> Nothing
  | Cons decl rest ->
      match decl with
      | ast.InstanceDecl constraint _ _ _ ->
          match instance_head_tyvar(constraint) with
          | Nothing -> check_tyvar_instance_heads(rest)
          | Just (cls, rule) ->
              Just((ast.decl_pos(decl), "Instance head for " ++ cls ++ " " ++ rule))
      | _ -> check_tyvar_instance_heads(rest)

fn check_overlapping_instances(decls: List ast.Decl, seen: Dict Bool) -> Maybe(source.SourcePos, String) =
  match decls with
  | Nil -> Nothing
  | Cons decl rest ->
      match decl with
      | ast.InstanceDecl constraint _ _ _ ->
          match instance_key_and_class(constraint) with
          | Nothing -> check_overlapping_instances(rest, seen)
          | Just (key, cls) ->
              match dict_get(key, seen) with
              | Just _ -> Just((ast.decl_pos(decl), str_concat("Overlapping instances for ", cls)))
              | Nothing -> check_overlapping_instances(rest, dict_set(key, true, seen))
      | _ -> check_overlapping_instances(rest, seen)

# ---------------------------------------------------------------------------
# Superclass-instance completeness
# ---------------------------------------------------------------------------
#
# `class Sub a where Sup a` makes Sup a superclass of Sub, so an `instance Sub T`
# requires an `instance Sup T`. A forwarded Sub dict is super-expanded to also carry
# Sup's methods; a missing Sup instance leaves that slot unresolvable and lowering
# null-fills it → SIGSEGV at the call site (BACKLOG Dispatch Soundness). Reject it at
# the instance site, mirroring GHC's "arising from the superclasses of an instance
# declaration". Decl-scoped: the bundled prelude's classes/instances are in `decls`,
# so this covers prelude and user instances alike.
#
# Assumes SINGLE-PARAMETER classes (the only kind Sprout has): the check keys on
# one type head, matching an instance's superclass against `Sup:<head>` and taking
# the instance's first type argument (`[head_te | _]`). A multi-parameter class
# (`class Sub a b where Sup a`) would need per-superclass-variable mapping — a
# superclass may constrain a SUBSET of the class variables, so the required instance
# is `Sup A`, not `Sup A B`. Do NOT generalize this to "all type args": that would
# encode the wrong assumption. When multi-parameter classes land, revisit here.
# Stage 0b generalization (docs/gadts-v0.md §5b): multi-method and superclass
# constrained existentials are now supported. The witness-slot enumerator
# (types.witness_slots_for_class) sizes the packed dictionary to one field per
# method across each constraint's class AND its transitive superclasses, and
# lowering forwards a ctx_fwd block per effective class — so the former
# single-method / superclass-free restriction is lifted. No existential-specific
# declaration rejection remains; this hook is retained (always Nothing) as the
# home for any future existential validation.
fn check_existential_constraints(_decls: List ast.Decl) -> Maybe(source.SourcePos, String) =
  Nothing

fn check_missing_superclass_instances(decls: List ast.Decl) -> Maybe(source.SourcePos, String) =
  check_inst_supers_go(decls, build_class_super_map(decls, dict_empty()), build_inst_key_set(decls, dict_empty()))

fn check_inst_supers_go(decls: List ast.Decl, super_map: Dict (List String), inst_set: Dict Bool) -> Maybe(source.SourcePos, String) =
  match decls with
  | Nil -> Nothing
  | Cons decl rest ->
      match decl with
      | ast.InstanceDecl constraint _ _ _ ->
          match superclass_check_one(constraint, super_map, inst_set) with
          | Just err -> Just((ast.decl_pos(decl), err))
          | Nothing -> check_inst_supers_go(rest, super_map, inst_set)
      | _ -> check_inst_supers_go(rest, super_map, inst_set)

fn superclass_check_one(constraint: ast.TypeConstraint, super_map: Dict (List String), inst_set: Dict Bool) -> Maybe String =
  match constraint with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> Nothing
      | [head_te | _] ->
          check_super_list(
            super_list_of(string.after_last_dot(class_name), super_map),
            string.after_last_dot(class_name),
            type_head_str(type_from_ast(head_te, dict_empty())),
            inst_set)

fn check_super_list(supers: List String, cls: String, head: String, inst_set: Dict Bool) -> Maybe String =
  match supers with
  | Nil -> Nothing
  | Cons super_name rest ->
      match dict_get(super_name ++ ":" ++ head, inst_set) with
      | Just _ -> check_super_list(rest, cls, head, inst_set)
      | Nothing -> Just("No instance of " ++ super_name ++ " for " ++ string.after_last_dot(head)
                        ++ ", required as a superclass of " ++ cls)

fn super_list_of(cls: String, super_map: Dict (List String)) -> List String =
  match dict_get(cls, super_map) with
  | Just supers -> supers
  | Nothing -> Nil

# class (bare name) -> its superclass class names (bare), from decl ClassDecls.
fn build_class_super_map(decls: List ast.Decl, acc: Dict (List String)) -> Dict (List String) =
  match decls with
  | Nil -> acc
  | Cons decl rest ->
      match decl with
      | ast.ClassDecl name _ _ superclasses _ ->
          build_class_super_map(rest,
            dict_set(string.after_last_dot(name), super_names(superclasses), acc))
      | _ -> build_class_super_map(rest, acc)

fn super_names(supers: List ast.TypeConstraint) -> List String =
  match supers with
  | Nil -> Nil
  | Cons c rest ->
      match c with
      | ast.TypeConstraint sname _ -> Cons(string.after_last_dot(sname), super_names(rest))

# set of "{bare_class}:{head}" for every instance declared.
fn build_inst_key_set(decls: List ast.Decl, acc: Dict Bool) -> Dict Bool =
  match decls with
  | Nil -> acc
  | Cons decl rest ->
      match decl with
      | ast.InstanceDecl constraint _ _ _ ->
          match constraint with
          | ast.TypeConstraint class_name type_args ->
              match type_args with
              | Nil -> build_inst_key_set(rest, acc)
              | [head_te | _] ->
                  build_inst_key_set(rest,
                    dict_set(string.after_last_dot(class_name) ++ ":"
                             ++ type_head_str(type_from_ast(head_te, dict_empty())), true, acc))
      | _ -> build_inst_key_set(rest, acc)

# Pre-scan pass: register FnDecl signatures (with their constraint field) and
# TypeDecl constructors for all declarations without typechecking bodies.
# Also tracks AliasDecl entries so that type aliases in signatures are resolved.
# TypeDecl pre-scanning is required to allow forward references to type
# constructors (e.g. a fn defined before the type it uses in the same module).
# For a single-parameter type alias `F a = G H a`, store `G H` in alias_env so that
# TypeApply (TypeName "F") X is resolved by type_from_ast's TApp branch to `G H X`.
# Only handles the structural form TApp T (TVar sentinel); silently skips other forms.
fn register_single_param_alias(
  name: String, param: String, rhs_te: ast.TypeExpr, alias_env: Dict types.Type
) -> Dict types.Type =
  match type_from_ast(rhs_te, dict_set(param, types.TVar(types.tyvar_id(sentinel)), dict_empty())) with
  | types.TApp inner_ty (types.TVar tname) ->
      if types.tyvar_identity(tname) == sentinel then dict_set(name, inner_ty, alias_env)
      else alias_env
  | _ -> alias_env
  where sentinel = str_concat("__aliasparam__", param)

# An extern is always marked global, but its signature is bound only when the name
# is free: a module re-declaring an extern already in scope must not shadow the
# scheme that is there, and the marker must not be lost to that skip either.
fn pre_scan_extern(
  name: String,
  params: List ast.Param,
  ret_type_maybe: Maybe ast.TypeExpr,
  effects_maybe: Maybe (List String),
  alias_env: Dict types.Type,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  match dict_get(name, env) with
  | Just _ -> dict_set("@extern:" ++ name, extern_marker(), env)
  | Nothing ->
      dict_set("@extern:" ++ name, extern_marker(),
        dict_set("@arity:" ++ name, arity_marker(list_length(params)),
          dict_set(name, scheme_from_fn_parts(name, params, ret_type_maybe, effects_maybe, alias_env), env)))

fn pre_scan_fn_decls(decls: List ast.Decl, env: Dict types.Scheme, alias_env: Dict types.Type) -> Dict types.Scheme =
  match decls with
  | Nil -> env
  | Cons decl rest ->
      match decl with
      | ast.FnDecl name params ret_type_maybe effects_maybe constraints _ _ ->
          pre_scan_fn_decls(rest,
            dict_set("@arity:" ++ name, arity_marker(list_length(params)),
              register_fn_decl_scheme(name, params, ret_type_maybe, effects_maybe, constraints, alias_env, env)),
            alias_env)
      | ast.ExternFnDecl name params ret_type_maybe effects_maybe _ ->
          pre_scan_fn_decls(rest,
            pre_scan_extern(name, params, ret_type_maybe, effects_maybe, alias_env, env),
            alias_env)
      | ast.AliasDecl name [] rhs_te _ ->
          pre_scan_fn_decls(rest, env,
            dict_set(name, type_from_ast(rhs_te, dict_empty()), alias_env))
      | ast.AliasDecl name [param] rhs_te _ ->
          pre_scan_fn_decls(rest, env, register_single_param_alias(name, param, rhs_te, alias_env))
      | ast.TypeDecl _ _ _ _ _ _ ->
          pre_scan_fn_decls(rest, register_type_decl_raw(decl, env), alias_env)
      | ast.WrapDecl _ _ _ ->
          pre_scan_fn_decls(rest, register_type_decl_raw(decl, env), alias_env)
      | _ -> pre_scan_fn_decls(rest, env, alias_env)

# ---------------------------------------------------------------------------
# The dependency graph over top-level declarations
# ---------------------------------------------------------------------------
#
# Every top-level name a body references, restricted to `index` — the FnDecl names
# this program declares. A name outside the index (a builtin, a constructor, an
# imported value) contributes no edge, so the graph stays inside the declaration
# set and needs no separate filtering pass.
#
# `bound` carries the value names shadowed at this point: lambda parameters, match
# and do-bind pattern binders, and `do let` names. A shadowed name is not an edge —
# `\ map -> map(x)` does not depend on the top-level `map`. Note `where` and
# `let … in` need no case of their own: the parser desugars both to a single-arm
# MatchExpr (parser.desugar_where), so their binders arrive as ordinary patterns.
#
# **The two ways to be wrong here are not symmetric.** Over-approximating — an edge
# that is not real — merges two groups, so their members are inferred monomorphically
# with respect to each other. That is less general but never unsound, and for the
# annotated declarations that dominate any program it costs nothing at all, since
# their types come from their signatures either way. UNDER-approximating puts a
# declaration before its dependency, which is exactly the forward-reference hole
# binding groups exist to close. When in doubt, include the name.
#
# Which is why the walk lists **every** ast.Expr constructor and has no `| _ ->`
# catch-all. A catch-all would make a newly added expression form contribute no
# edges — silently, and in the dangerous direction.
fn referenced_names(e: ast.Expr, bound: Set, index: Set, acc: Set) -> Set =
  match e with
  | ast.VarExpr name _ ->
      if set_member(name, bound) then acc
      else if set_member(name, index) then set_insert(name, acc)
      else acc
  | ast.IntExpr _ _ -> acc
  | ast.FloatExpr _ _ -> acc
  | ast.BoolExpr _ _ -> acc
  | ast.StringExpr _ _ -> acc
  | ast.CharExpr _ _ -> acc
  | ast.UnitExpr _ -> acc
  | ast.StringTemplateExpr parts _ -> referenced_names_template(parts, bound, index, acc)
  | ast.TupleExpr items _ -> referenced_names_list(items, bound, index, acc)
  | ast.IfExpr cond th el _ ->
      referenced_names(el, bound, index,
        referenced_names(th, bound, index,
          referenced_names(cond, bound, index, acc)))
  | ast.MatchExpr scrutinee branches _ ->
      referenced_names_branches(branches, bound, index,
        referenced_names(scrutinee, bound, index, acc))
  | ast.CallExpr callee args _ ->
      referenced_names_list(args, bound, index,
        referenced_names(callee, bound, index, acc))
  | ast.LambdaExpr params body _ ->
      referenced_names(body, bind_params(params, bound), index, acc)
  | ast.BinaryExpr _ left right _ ->
      # The operator is a token, not a name a FnDecl can carry, so it is no edge.
      referenced_names(right, bound, index, referenced_names(left, bound, index, acc))
  | ast.UnaryExpr _ operand _ -> referenced_names(operand, bound, index, acc)
  | ast.IntRangeExpr lo hi _ ->
      referenced_names(hi, bound, index, referenced_names(lo, bound, index, acc))
  | ast.DoExpr steps _ -> referenced_names_do(steps, bound, index, acc)
  | ast.RecordExpr _ fields _ -> referenced_names_fields(fields, bound, index, acc)
  | ast.GetFieldExpr record _ _ -> referenced_names(record, bound, index, acc)
  | ast.RecordUpdateExpr base fields _ ->
      referenced_names_fields(fields, bound, index, referenced_names(base, bound, index, acc))
  | ast.ComprehensionExpr elem gens _ ->
      referenced_names_comprehension(elem, gens, bound, index, acc)

# A generator's pattern binders scope over its own guards, every later
# generator's source and guards, and (once the walk reaches Nil) the element.
fn referenced_names_comprehension(elem: ast.Expr, gens: List ast.ComprehensionGen, bound: Set, index: Set, acc: Set) -> Set =
  match gens with
  | Nil -> referenced_names(elem, bound, index, acc)
  | Cons g rest ->
      match g with
      | ast.ComprehensionGen pat src guards ->
          referenced_names_comprehension(elem, rest, bind_pattern(pat, bound), index,
            referenced_names_list(guards, bind_pattern(pat, bound), index,
              referenced_names(src, bound, index, acc)))

fn referenced_names_list(es: List ast.Expr, bound: Set, index: Set, acc: Set) -> Set =
  match es with
  | Nil -> acc
  | Cons e rest -> referenced_names_list(rest, bound, index, referenced_names(e, bound, index, acc))

fn referenced_names_template(parts: List ast.TemplateExprPart, bound: Set, index: Set, acc: Set) -> Set =
  match parts with
  | Nil -> acc
  | Cons part rest ->
      match part with
      | ast.LitPart _ -> referenced_names_template(rest, bound, index, acc)
      | ast.InterpPart e ->
          referenced_names_template(rest, bound, index, referenced_names(e, bound, index, acc))

# A branch's pattern binders scope over its own body and nothing else.
fn referenced_names_branches(bs: List ast.MatchBranch, bound: Set, index: Set, acc: Set) -> Set =
  match bs with
  | Nil -> acc
  | Cons b rest ->
      match b with
      | ast.MatchBranch pat body ->
          referenced_names_branches(rest, bound, index,
            referenced_names(body, bind_pattern(pat, bound), index, acc))

# A do step's binder scopes over the steps AFTER it, so `bound` grows as the walk
# advances — and the step's own right-hand side is walked with the OLD `bound`,
# since `x <- f(x)` refers to the outer x.
fn referenced_names_do(steps: List ast.DoStep, bound: Set, index: Set, acc: Set) -> Set =
  match steps with
  | Nil -> acc
  | Cons step rest ->
      match step with
      | ast.DoBindStep pat e ->
          referenced_names_do(rest, bind_pattern(pat, bound), index,
            referenced_names(e, bound, index, acc))
      | ast.DoLetStep name e ->
          referenced_names_do(rest, set_insert(name, bound), index,
            referenced_names(e, bound, index, acc))
      | ast.DoExprStep e ->
          referenced_names_do(rest, bound, index, referenced_names(e, bound, index, acc))

fn referenced_names_fields(fields: List ast.RecordField, bound: Set, index: Set, acc: Set) -> Set =
  match fields with
  | Nil -> acc
  | Cons f rest ->
      match f with
      | ast.RecordField _ e ->
          referenced_names_fields(rest, bound, index, referenced_names(e, bound, index, acc))

# A constructor pattern's NAME is not a binder — only its sub-patterns bind.
fn bind_pattern(p: ast.Pattern, bound: Set) -> Set =
  match p with
  | ast.WildcardPattern _ -> bound
  | ast.VarPattern name _ -> set_insert(name, bound)
  | ast.IntPattern _ _ -> bound
  | ast.BoolPattern _ _ -> bound
  | ast.StringPattern _ _ -> bound
  | ast.CharPattern _ _ -> bound
  | ast.UnitPattern _ -> bound
  | ast.TuplePattern parts _ -> bind_patterns(parts, bound)
  | ast.ConstructorPattern _ args _ -> bind_patterns(args, bound)

fn bind_patterns(ps: List ast.Pattern, bound: Set) -> Set =
  match ps with
  | Nil -> bound
  | Cons p rest -> bind_patterns(rest, bind_pattern(p, bound))

fn bind_params(params: List ast.Param, bound: Set) -> Set =
  match params with
  | Nil -> bound
  | Cons p rest ->
      match p with
      | ast.Param name _ _ -> bind_params(rest, set_insert(name, bound))

# ---------------------------------------------------------------------------
# Strongly connected components — Kosaraju, iteratively
# ---------------------------------------------------------------------------
#
# Two reasons this is not the SCC walk that already exists in ast_to_ir.
#
# `pb_scc_of` computes a component by calling `mutual_reaches(f,g) && reaches(g,f)`
# PAIRWISE over every candidate — 2n graph searches per node. That is fine for the
# mutual-TCO pre-pass, whose node set is a handful of tail-callers. Here the largest
# reorderable run in this repo is 551 functions (measured 2026-08-25: infer.sprout
# itself), where pairwise reachability is O(n²(V+E)) — around a billion operations
# on the compiler's own hottest file, every build. This is O(V+E).
#
# And it is ITERATIVE. Textbook Kosaraju is two recursive depth-first searches; at
# 551 frames that is a stack the `stack-overflow-smoke` gate exists to police, and
# the depth is set by user code, not by us. Both passes carry an explicit worklist.
#
# Pass 1 walks G recording nodes by DECREASING finish time; pass 2 walks Gᵀ in that
# order and each tree it reaches is one component.
fn neighbors_of(n: String, graph: Dict Set) -> List String =
  match dict_get(n, graph) with
  | Just s -> set_to_list(s)
  | Nothing -> Nil

fn set_or_empty(k: String, d: Dict Set) -> Set =
  match dict_get(k, d) with
  | Just s -> s
  | Nothing -> set_empty()

fn reverse_graph(nodes: List String, graph: Dict Set, acc: Dict Set) -> Dict Set =
  match nodes with
  | Nil -> acc
  | Cons n rest -> reverse_graph(rest, graph, add_reverse_edges(n, neighbors_of(n, graph), acc))

fn add_reverse_edges(from: String, tos: List String, acc: Dict Set) -> Dict Set =
  match tos with
  | Nil -> acc
  | Cons t rest -> add_reverse_edges(from, rest, dict_set(t, set_insert(from, set_or_empty(t, acc)), acc))

# Pass 1. The worklist holds (node, is_exit): an `is_exit` item means every
# descendant of that node has been finished, so this is where post-order is
# recorded. `order` is built by consing on finish, which leaves the LAST-finished
# node at the head — decreasing finish time, exactly what pass 2 consumes.
fn scc_finish_order(nodes: List String, graph: Dict Set) -> List String =
  scc_finish_order_go(nodes, graph, set_empty(), Nil)

fn scc_finish_order_go(nodes: List String, graph: Dict Set, visited: Set, order: List String) -> List String =
  match nodes with
  | Nil -> order
  | Cons n rest ->
      if set_member(n, visited) then scc_finish_order_go(rest, graph, visited, order)
      else
        let (v2, o2) = scc_dfs1(Cons((n, false), Nil), graph, visited, order)
        in scc_finish_order_go(rest, graph, v2, o2)

fn scc_dfs1(work: List (String, Bool), graph: Dict Set, visited: Set, order: List String) -> (Set, List String) =
  match work with
  | Nil -> (visited, order)
  | Cons item rest ->
      match item with
      | (n, true) -> scc_dfs1(rest, graph, visited, Cons(n, order))
      | (n, false) ->
          # A node can be pushed as an ENTER more than once (two parents reach it
          # before either finishes); the visited test here is what makes that
          # harmless. Its EXIT marker is pushed exactly once, on first entry.
          if set_member(n, visited) then scc_dfs1(rest, graph, visited, order)
          else
            scc_dfs1(push_enters(neighbors_of(n, graph), Cons((n, true), rest)),
                     graph, set_insert(n, visited), order)

fn push_enters(ns: List String, work: List (String, Bool)) -> List (String, Bool) =
  match ns with
  | Nil -> work
  | Cons n rest -> Cons((n, false), push_enters(rest, work))

# Pass 2. Each tree reached in Gᵀ is one component.
#
# Kosaraju discovers components in topological order of G's condensation, and G's
# edges point caller -> callee, so it finds CALLERS first. `acc` is built by
# consing, which reverses that — leaving callees first, which is the order a
# dependency-ordered check needs. The reversal is load-bearing, not incidental.
fn scc_components(order: List String, rgraph: Dict Set, visited: Set, acc: List (List String)) -> List (List String) =
  match order with
  | Nil -> acc
  | Cons n rest ->
      if set_member(n, visited) then scc_components(rest, rgraph, visited, acc)
      else
        let (v2, members) = scc_dfs2(Cons(n, Nil), rgraph, visited, Nil)
        in scc_components(rest, rgraph, v2, Cons(members, acc))

fn scc_dfs2(work: List String, rgraph: Dict Set, visited: Set, members: List String) -> (Set, List String) =
  match work with
  | Nil -> (visited, members)
  | Cons n rest ->
      if set_member(n, visited) then scc_dfs2(rest, rgraph, visited, members)
      else scc_dfs2(append(neighbors_of(n, rgraph), rest), rgraph, set_insert(n, visited), Cons(n, members))

# Components of `nodes` under `graph`, dependencies first.
fn sccs_in_dependency_order(nodes: List String, graph: Dict Set) -> List (List String) =
  scc_components(scc_finish_order(nodes, graph), reverse_graph(nodes, graph, dict_empty()),
                 set_empty(), Nil)

# ---------------------------------------------------------------------------
# group_plan — the §4.5.1 seam
# ---------------------------------------------------------------------------
#
# A binding group is a list of indices into the declaration vector, in the order
# its members must be CHECKED; group_plan returns the groups themselves in check
# order. The typed output is re-keyed to SOURCE order afterwards
# (typed_decls_in_source_order), so no plan this function can return is able to
# move emitted code — which is what makes swapping its body a contained change.
#
# FnDecls are partitioned into strongly connected components and ordered so a
# group's dependencies are checked before it; every other declaration is its own
# group, in place, and acts as a BARRIER that no FnDecl may cross.
#
# The barrier rule is not conservatism, it is what the environments allow.
# RecordDecl, ClassDecl and InstanceDecl are registered by typecheck_decl as it
# walks, not by pre_scan_fn_decls, so a FnDecl hoisted above one loses the fields,
# methods or instance it needs. A top-level `let` is not pre-scanned either — a
# forward reference to one is `Unknown variable` today, which this must not change.
# And AliasDecl, despite BEING pre-scanned, is still a barrier: pre_scan's
# alias_env is used only to build schemes inside pre_scan, while typecheck_decls
# starts the body walk from `qual_env` and re-registers aliases as it goes, so a
# FnDecl checked above an AliasDecl would rebuild its own decl_scheme against an
# alias_env that has not seen it. (This corrects the note that stood here when the
# seam landed, which said AliasDecl could be crossed.)
#
# The invariant every plan owes typecheck_groups: the groups partition 0..n-1
# EXACTLY once. A missing index silently drops a declaration from the emitted
# program; a duplicated one emits it twice. It holds by construction here — each
# declaration is either a barrier singleton or in exactly one segment, and an SCC
# partition covers its node set — with one dependency: names must be unique, which
# check_duplicate_fn_decls has already guaranteed by the time this runs. The
# verification below is not a substitute for that argument; it is there because a
# silently vanishing declaration is the one failure mode worth paying to rule out.
fn group_plan(decls: List ast.Decl) -> List (List Int) =
  checked_plan(plan_walk(index_decls(decls, 0), Nil, Nil), list_length(decls))

# A plan that does not partition 0..n-1 falls back to source order. Reordering is
# an optimisation of COMPLETENESS — it makes more correct programs typable — so
# losing it degrades diagnostics; dropping a declaration corrupts the output. Trade
# the first for certainty about the second.
fn checked_plan(plan: List (List Int), n: Int) -> List (List Int) =
  if plan_covers_exactly(plan, n) then plan else group_plan_singletons(0, n)

fn plan_covers_exactly(plan: List (List Int), n: Int) -> Bool =
  set_size(plan_indices(plan, set_empty())) == n

fn plan_indices(plan: List (List Int), acc: Set) -> Set =
  match plan with
  | Nil -> acc
  | Cons g rest -> plan_indices(rest, plan_group_indices(g, acc))

fn plan_group_indices(g: List Int, acc: Set) -> Set =
  match g with
  | Nil -> acc
  | Cons i rest -> plan_group_indices(rest, set_insert(int_to_string(i), acc))

fn group_plan_singletons(i: Int, n: Int) -> List (List Int) =
  if i >= n then Nil else Cons(Cons(i, Nil), group_plan_singletons(i + 1, n))

fn index_decls(decls: List ast.Decl, i: Int) -> List (Int, ast.Decl) =
  match decls with
  | Nil -> Nil
  | Cons d rest -> Cons((i, d), index_decls(rest, i + 1))

# `seg` is the current run of FnDecls and `acc` the finished groups, both held in
# REVERSE so the walk stays a cons. Hitting a barrier flushes the run, then emits
# the barrier itself as a singleton in its original position.
fn plan_walk(items: List (Int, ast.Decl), seg: List (Int, ast.Decl), acc: List (List Int)) -> List (List Int) =
  match items with
  | Nil -> reverse_groups(flush_segment(seg, acc), Nil)
  | Cons item rest ->
      match item with
      | (i, decl) ->
          match decl with
          | ast.FnDecl _ _ _ _ _ _ _ -> plan_walk(rest, Cons(item, seg), acc)
          | _ -> plan_walk(rest, Nil, Cons (Cons(i, Nil), flush_segment(seg, acc)))

fn flush_segment(seg: List (Int, ast.Decl), acc: List (List Int)) -> List (List Int) =
  prepend_groups(partition_segment(reverse_items(seg, Nil)), acc)

fn prepend_groups(gs: List (List Int), acc: List (List Int)) -> List (List Int) =
  match gs with
  | Nil -> acc
  | Cons g rest -> prepend_groups(rest, Cons(g, acc))

fn reverse_groups(gs: List (List Int), acc: List (List Int)) -> List (List Int) =
  match gs with
  | Nil -> acc
  | Cons g rest -> reverse_groups(rest, Cons(g, acc))

fn reverse_items(xs: List (Int, ast.Decl), acc: List (Int, ast.Decl)) -> List (Int, ast.Decl) =
  match xs with
  | Nil -> acc
  | Cons x rest -> reverse_items(rest, Cons(x, acc))

# The edge set is restricted to the SEGMENT, not the whole program, and that is
# exact rather than an approximation: a reference to an earlier segment names a
# declaration already checked, and a reference to a later one names something the
# barrier makes unreachable anyway. Neither can inform this segment's order.
fn partition_segment(seg: List (Int, ast.Decl)) -> List (List Int) =
  match seg with
  | Nil -> Nil
  | [_ | _] ->
      let names = segment_names(seg)
          index = set_of_list(names, set_empty())
      in groups_to_indices(
           sccs_in_dependency_order(names, segment_graph(seg, index, dict_empty())),
           segment_index_map(seg, dict_empty()))

fn segment_names(seg: List (Int, ast.Decl)) -> List String =
  match seg with
  | Nil -> Nil
  | Cons m rest ->
      match m with
      | (_, ast.FnDecl name _ _ _ _ _ _) -> Cons(name, segment_names(rest))
      | _ -> segment_names(rest)

fn segment_graph(seg: List (Int, ast.Decl), index: Set, acc: Dict Set) -> Dict Set =
  match seg with
  | Nil -> acc
  | Cons m rest ->
      match m with
      | (_, ast.FnDecl name params _ _ _ body _) ->
          segment_graph(rest, index,
            dict_set(name, referenced_names(body, bind_params(params, set_empty()), index, set_empty()), acc))
      | _ -> segment_graph(rest, index, acc)

fn segment_index_map(seg: List (Int, ast.Decl), acc: Dict Int) -> Dict Int =
  match seg with
  | Nil -> acc
  | Cons m rest ->
      match m with
      | (_, ast.FnDecl name _ _ _ _ _ _) -> segment_index_map(rest, dict_set(name, i_of(m), acc))
      | _ -> segment_index_map(rest, acc)

fn i_of(m: (Int, ast.Decl)) -> Int =
  match m with
  | (i, _) -> i

fn set_of_list(xs: List String, acc: Set) -> Set =
  match xs with
  | Nil -> acc
  | Cons x rest -> set_of_list(rest, set_insert(x, acc))

# A group's members are checked in SOURCE order. Nothing requires that — they are
# mutually dependent, so no order among them is more correct — but a deterministic
# one keeps the plan reproducible, and source order is the one a reader expects.
fn groups_to_indices(comps: List (List String), idx_of: Dict Int) -> List (List Int) =
  match comps with
  | Nil -> Nil
  | Cons c rest -> Cons(sorted_indices(c, idx_of, Nil), groups_to_indices(rest, idx_of))

fn sorted_indices(names: List String, idx_of: Dict Int, acc: List Int) -> List Int =
  match names with
  | Nil -> acc
  | Cons n rest ->
      match dict_get(n, idx_of) with
      | Just i -> sorted_indices(rest, idx_of, insert_int_sorted(i, acc))
      | Nothing -> sorted_indices(rest, idx_of, acc)

fn insert_int_sorted(x: Int, xs: List Int) -> List Int =
  match xs with
  | Nil -> Cons(x, Nil)
  | Cons h t -> if x <= h then Cons(x, xs) else Cons(h, insert_int_sorted(x, t))

# The typed program, re-keyed from check order back to SOURCE order. A gap is
# skipped rather than trapped: group_plan is internal and its partition invariant
# is stated above, so a hole here would be a compiler bug, not a user error, and
# erroring out would replace a working build with a diagnostic no user can act on.
fn typed_decls_in_source_order(out: Dict typed_ast.TypedDecl, i: Int, total: Int) -> List typed_ast.TypedDecl =
  if i >= total then Nil
  else
    match dict_get(int_to_string(i), out) with
    | Just td -> Cons(td, typed_decls_in_source_order(out, i + 1, total))
    | Nothing -> typed_decls_in_source_order(out, i + 1, total)

fn decl_at(decl_vec: Vec ast.Decl, i: Int) -> Maybe ast.Decl = vec_get(i, decl_vec)

fn typecheck_decls_inner(
  state: unifier.InferState,
  decls: List ast.Decl,
  env: GlobalEnv,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  alias_env: Dict types.Type,
  acc: List typed_ast.TypedDecl,
  env_ftv: List String
) -> typed_ast.TypedResult !{IO} =
  typecheck_groups(state, vec_from_list(decls), group_plan(decls), env, subst, eff_subst,
                   alias_env, dict_empty(), env_ftv, list_length(decls))

fn typecheck_groups(
  state: unifier.InferState,
  decl_vec: Vec ast.Decl,
  groups: List (List Int),
  env: GlobalEnv,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  alias_env: Dict types.Type,
  out: Dict typed_ast.TypedDecl,
  env_ftv: List String,
  total: Int
) -> typed_ast.TypedResult !{IO} =
  match groups with
  | Nil ->
      # Unwrap GlobalEnv for the public TypedResult API, which still uses
      # raw Dict types.Scheme.  The wrap discipline is internal to infer.
      typed_ast.TypedOk(
        typed_ast.TypedProgram(typed_decls_in_source_order(out, 0, total)),
        global_env_dict(env))
  | Cons g rest ->
      do
        r <- typecheck_group(state, decl_vec, g, env, subst, eff_subst, alias_env, out, env_ftv)
        match r with
        | GroupErr pos e -> typed_ast.TypedErr(pos, e)
        | GroupOk new_out new_env new_subst new_alias_env new_env_ftv ->
            # new_subst, not subst: this is the whole of what makes an
            # unannotated declaration's placeholder mean anything. The pin a
            # caller puts on it has to survive to the declaration that owns
            # it, or the two are inferred as if they were unrelated.
            typecheck_groups(state, decl_vec, rest, new_env, new_subst, eff_subst,
                             new_alias_env, new_out, new_env_ftv, total)

# Dispatch is by DECL KIND, not by group size, and that is deliberate: a group of
# one FnDecl takes the same path as a group of five. It means the group machinery
# — shared assumptions, threaded substitution, generalization at the boundary — is
# executed for every function in the tree while group_plan still returns
# singletons, so "byte-identical IR" actually exercises it instead of stepping
# around it. Only the N>=2 fold is left for the day group_plan changes.
fn typecheck_group(
  state: unifier.InferState,
  decl_vec: Vec ast.Decl,
  g: List Int,
  env: GlobalEnv,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  alias_env: Dict types.Type,
  out: Dict typed_ast.TypedDecl,
  env_ftv: List String
) -> GroupResult !{IO} =
  do
    let members = group_members(decl_vec, g)
    match members with
    | Nil -> GroupOk(out, env, subst, alias_env, env_ftv)
    | Cons m rest ->
        if all_fn_decls(members)
        then typecheck_fn_group(state, members, env, subst, eff_subst, alias_env, out, env_ftv)
        else
          match rest with
          | Nil ->
              match m with
              | (i, decl) -> typecheck_singleton(state, i, decl, env, subst, eff_subst, alias_env, out, env_ftv)
          | [_ | _] ->
              GroupErr(no_pos(), "internal: a multi-member binding group must contain only FnDecls")

fn all_fn_decls(members: List (Int, ast.Decl)) -> Bool =
  match members with
  | Nil -> true
  | Cons m rest ->
      match m with
      | (_, ast.FnDecl _ _ _ _ _ _ _) -> all_fn_decls(rest)
      | _ -> false

# A group of one. Alias declarations are handled here rather than in
# typecheck_decl because they update the ALIAS environment, which typecheck_decl
# neither takes nor returns; group_plan never puts one in a multi-member group.
fn typecheck_singleton(
  state: unifier.InferState,
  i: Int,
  decl: ast.Decl,
  env: GlobalEnv,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  alias_env: Dict types.Type,
  out: Dict typed_ast.TypedDecl,
  env_ftv: List String
) -> GroupResult !{IO} =
  match decl with
  | ast.AliasDecl name [] rhs_te _ ->
      GroupOk(dict_set(int_to_string(i), typed_ast.TPassThrough(decl), out), env, subst,
              dict_set(name, type_from_ast(rhs_te, dict_empty()), alias_env), env_ftv)
  | ast.AliasDecl name [param] rhs_te _ ->
      GroupOk(dict_set(int_to_string(i), typed_ast.TPassThrough(decl), out), env, subst,
              register_single_param_alias(name, param, rhs_te, alias_env), env_ftv)
  | _ ->
      do
        r <- typecheck_decl(state, decl, env, subst, eff_subst, alias_env, env_ftv)
        match r with
        | TypedDeclErr pos e -> GroupErr(pos, e)
        | TypedDeclOk typed_decl new_env new_env_ftv new_subst ->
            GroupOk(dict_set(int_to_string(i), typed_decl, out), new_env, new_subst,
                    alias_env, new_env_ftv)

# A group of two or more mutually dependent FnDecls. Every member is inferred
# against the SAME env — pre_scan's shared monomorphic assumptions — with the
# substitution threaded between them, and only then does the group generalize.
# Committing a member early would rebind it to a generalized scheme its siblings
# would then instantiate freshly, which is precisely the forward-reference hole
# binding groups exist to close.
fn typecheck_fn_group(
  state: unifier.InferState,
  members: List (Int, ast.Decl),
  env: GlobalEnv,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  alias_env: Dict types.Type,
  out: Dict typed_ast.TypedDecl,
  env_ftv: List String
) -> GroupResult !{IO} =
  do
    # The group's own placeholders, released together at its boundary. Per member
    # would leave the first member quantifying over a sibling's still-unresolved
    # variable — or, worse, not quantifying its own.
    let group_env_ftv = env_ftv_for_decl(env_ftv, group_unann_vars(members, Nil))
    (err, inferred, final_subst) <- infer_group_members(state, members, global_env_dict(env), subst,
                                                        eff_subst, alias_env, group_env_ftv)
    match err with
    | Just (pos, msg) -> GroupErr(pos, msg)
    | Nothing ->
        let (new_out, new_env, new_env_ftv) = commit_group_members(inferred, final_subst, env, env_ftv, out)
        in GroupOk(new_out, new_env, final_subst, alias_env, new_env_ftv)

fn group_members(decl_vec: Vec ast.Decl, g: List Int) -> List (Int, ast.Decl) =
  match g with
  | Nil -> Nil
  | Cons i rest ->
      match decl_at(decl_vec, i) with
      | Just d -> Cons((i, d), group_members(decl_vec, rest))
      | Nothing -> group_members(decl_vec, rest)

fn group_unann_vars(members: List (Int, ast.Decl), acc: List String) -> List String =
  match members with
  | Nil -> acc
  | Cons m rest ->
      match m with
      | (_, decl) ->
          match decl with
          | ast.FnDecl name params ret_type_maybe _ _ _ _ ->
              group_unann_vars(rest, types.list_union(own_unann_vars(name, params, ret_type_maybe), acc))
          | _ -> group_unann_vars(rest, acc)

# Built on the RETURN path (recurse-then-cons) so the result stays in CHECK order.
# commit_group_members depends on that: the LAST element is the member whose body
# produced the group's final substitution, and it is the one that skips the
# re-resolve pass.
fn infer_group_members(
  state: unifier.InferState,
  members: List (Int, ast.Decl),
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  alias_env: Dict types.Type,
  group_env_ftv: List String
) -> (Maybe(source.SourcePos, String), List (Int, FnInferred), Dict types.Type) !{IO} =
  match members with
  | Nil -> (Nothing, Nil, subst)
  | Cons m rest ->
      match m with
      | (i, decl) ->
          do
            # env is passed through UNCHANGED — that is the point of a group.
            (r, body_subst) <- infer_fn_decl(state, decl, env, subst, eff_subst, alias_env, group_env_ftv)
            match r with
            | FnInferErr pos msg -> (Just((pos, msg)), Nil, body_subst)
            | FnInferOk inf ->
                do
                  (err, rest_inferred, final_subst) <- infer_group_members(state, rest, env, body_subst,
                                                                           eff_subst, alias_env, group_env_ftv)
                  (err, Cons((i, inf), rest_inferred), final_subst)

fn commit_group_members(
  inferred: List (Int, FnInferred),
  final_subst: Dict types.Type,
  env: GlobalEnv,
  env_ftv: List String,
  out: Dict typed_ast.TypedDecl
) -> (Dict typed_ast.TypedDecl, GlobalEnv, List String) =
  match inferred with
  | Nil -> (out, env, env_ftv)
  | Cons m rest ->
      match m with
      | (i, inf) ->
          # `rest` empty means this member produced final_subst, so its typed body
          # already carries it and the re-resolve walk is skipped.
          let (td, new_env, new_env_ftv) = commit_fn_decl(inf, final_subst, is_nonempty_inferred(rest), env, env_ftv)
          in commit_group_members(rest, final_subst, new_env, new_env_ftv,
                                  dict_set(int_to_string(i), td, out))

fn is_nonempty_inferred(xs: List (Int, FnInferred)) -> Bool =
  match xs with
  | Nil -> false
  | [_ | _] -> true

# Phrased as the same "escapes its scope" family as the unifier's mismatch
# rewording, so the two ends of the rule read alike. The advice is deliberately
# NOT "annotate the return type" — writing one moves the error to the rigidity
# scan (tests/conformance/type_error/existential_escape) without helping.
fn skolem_escape_prefix(name: String) -> String =
  "existential type escapes its scope in " ++ name
    ++ ": a type hidden by an `exists` pattern cannot "

fn skolem_escape_msg(name: String) -> String =
  skolem_escape_prefix(name) ++ "appear in the function's own type"
    ++ " — use the unpacked value inside its match branch instead of returning it"

fn skolem_escape_let_msg(name: String) -> String =
  skolem_escape_prefix(name) ++ "be the type of a top-level binding"
    ++ " — consume the unpacked value inside its match branch"

# ---------------------------------------------------------------------------
# Binding-group inference: infer a member, commit a member
# ---------------------------------------------------------------------------
#
# The two halves of what typecheck_decl's FnDecl arm used to do in one piece.
# Keeping them apart is what lets a group of N mutually dependent declarations be
# inferred against ONE shared set of monomorphic assumptions and then generalized
# together, per Haskell 2010 §4.5.2. A group of one runs both halves back to back
# and is indistinguishable from the old code.

# `group_env_ftv` is the SAME value that must later reach generalize:
# canonicalize_constrained_constraints (inside check_fn_body) computes a
# constraint's binder position with the identical ftv-difference, and the two
# disagreeing would misindex every hidden dictionary. For a group it excludes
# EVERY member's own placeholders, not just this member's.
fn infer_fn_decl(
  state: unifier.InferState,
  decl: ast.Decl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  alias_env: Dict types.Type,
  group_env_ftv: List String
) -> (FnInferResult, Dict types.Type) !{IO} =
  match decl with
  | ast.FnDecl name _ _ _ _ _ decl_pos ->
      do
        (r, fwd_markers, decl_constraints, body_subst) <- check_fn_body(state, decl, env, subst, eff_subst, alias_env, group_env_ftv)
        match r with
        | typed_ast.BodyErr pos e -> (FnInferErr(pos, e), body_subst)
        | typed_ast.BodyLenient ->
            # BodyLenient is no longer produced (fn_body_err always returns BodyErr).
            # Retained as a constructor only to avoid breaking the typed_ast public API.
            (FnInferErr(no_pos(), "internal: unexpected BodyLenient in " ++ name), body_subst)
        | typed_ast.BodyOk typed_body inferred_fn_type ->
            # A skolem reaching the decl's own type escaped a match branch, and
            # generalize cannot notice: a skolem is a rigid TConst, so it has no
            # free type variables for the ftv-difference to quantify. Being
            # unquantified it is then NOT refreshed at instantiation, so it would
            # become one rigid type shared by every call site — which is how an
            # unannotated one-line unboxer both printed a String as a raw address
            # and silently merged two unpacks that `existential_merge` rejects
            # directly. The annotated form errors earlier (the rigidity scan sees
            # the skolem as a TConst); only the unannotated-return path reaches here.
            if types.type_mentions_skolem(inferred_fn_type)
            then (FnInferErr(decl_pos, skolem_escape_msg(name)), body_subst)
            else (FnInferOk (FnInferred(decl, typed_body, inferred_fn_type, fwd_markers, decl_constraints, group_env_ftv)),
                  body_subst)
  | _ -> (FnInferErr(no_pos(), "internal: infer_fn_decl on a non-FnDecl"), subst)

# Bind one member into the env at its group's boundary.
#
# `needs_resolve` is true for every member EXCEPT the one that produced
# `final_subst` — the last checked. Earlier members were typed against a prefix of
# the group's substitution, so their bodies still carry variables a later sibling
# resolved. Re-resolving them here is cheaper and safer than re-inferring: a
# second inference pass would record every member's effect report twice.
# It is skipped for the last member because apply_subst is idempotent against a
# fixed substitution, so the walk would be pure cost — which on a 3000-declaration
# bundle is not a rounding error.
fn commit_fn_decl(
  inf: FnInferred,
  final_subst: Dict types.Type,
  needs_resolve: Bool,
  env: GlobalEnv,
  env_ftv: List String
) -> (typed_ast.TypedDecl, GlobalEnv, List String) =
  match inf with
  | FnInferred decl typed_body0 inferred0 fwd_markers decl_constraints group_env_ftv ->
      match decl with
      | ast.FnDecl name params ret_type_maybe effects_maybe constraints _ _ ->
          let typed_body = if needs_resolve then apply_subst_typed_expr(final_subst, typed_body0) else typed_body0
              inferred_fn_type = if needs_resolve then unifier.apply_subst(final_subst, inferred0) else inferred0
          in
            (typed_ast.TFnDecl(name, params, ret_type_maybe, effects_maybe, constraints, typed_body),
             # WHY: fold @eta_fwd markers into the global env so lowering can map fresh
             # TVar names back to programmer constraint var names when eta-expanding
             # class methods in value position. Keys use @eta_fwd: prefix (not @fwd:)
             # to avoid polluting the per-function @fwd: namespace scanned by
             # resolve_via_fwd_for_prog_var. Keys are globally unique (one InferState).
             fold_fwd_markers(fwd_markers,
               GlobalEnv(dict_set(name,
                 types.scheme_with_constraints(
                   unifier.generalize(group_env_ftv, dict_empty(), dict_empty(),
                     inferred_fn_type, effect_from_maybe_labels(effects_maybe)),
                   decl_constraints),
                 global_env_dict(env)))),
             # WHY: @eta_fwd markers have free type variables that must be included
             # in env_ftv so subsequent declarations don't incorrectly generalize
             # over them. Computed once per declaration → stays O(n).
             types.list_union(unifier.ftv_env(fwd_markers), env_ftv))
      | _ -> (typed_ast.TPassThrough(decl), env, env_ftv)

fn typecheck_decl(
  state: unifier.InferState,
  decl: ast.Decl,
  env: GlobalEnv,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  alias_env: Dict types.Type,
  env_ftv: List String
) -> TypedDeclResult !{IO} =
  # Unwrap once at the top — internal helpers (check_fn_body, register_*,
  # dict_get/set) all work on raw Dict.  GlobalEnv is reconstructed at the
  # TypedDeclOk boundary.
  match decl with
  | ast.TypeDecl _ _ _ _ _ _ ->
      TypedDeclOk(typed_ast.TPassThrough(decl), register_type_decl(decl, env), env_ftv, subst)
  | ast.WrapDecl _ _ _ ->
      # WrapDecl uses the same single-ctor-synthesizing path as TypeDecl.
      TypedDeclOk(typed_ast.TPassThrough(decl), register_type_decl(decl, env), env_ftv, subst)
  | ast.RecordDecl rec_name type_params fields _ mult _ ->
      TypedDeclOk(typed_ast.TPassThrough(decl),
        GlobalEnv(mark_type_multiplicity(rec_name, mult,
          register_record_fields(rec_name, type_params, fields, global_env_dict(env)))),
        env_ftv, subst)
  | ast.FnDecl name _ _ _ _ _ decl_pos ->
      # Unreachable. typecheck_group routes EVERY FnDecl through typecheck_fn_group,
      # which is the single implementation of infer-then-commit. This arm exists
      # because the match must stay exhaustive, and it fails loudly rather than
      # re-implementing the path: two implementations of group inference is exactly
      # how the group and non-group cases would drift apart unnoticed.
      TypedDeclErr(decl_pos,
        "internal: FnDecl reached typecheck_decl, so binding-group routing is broken (" ++ name ++ ")")
  | ast.ExternFnDecl name params ret_type_maybe effects_maybe ext_pos ->
      # An extern has no BODY, so `fn_linear_gate` (and with it the
      # "modifier only on a linear parameter" guard) never ran on one: an FFI
      # author could write `borrowing` on a non-linear extern parameter, see it
      # compile, and read it as an ownership guarantee the compiler was not
      # making. Validate the modifiers here, where the param types resolve.
      # Regression: tests/conformance/type_error/borrow_extern_non_linear.
      extern_decl_result(name, params, ret_type_maybe, effects_maybe, ext_pos, alias_env, env, env_ftv, subst)
  | ast.LetDecl name expr anno let_pos ->
      do
        r <- typecheck_let_rhs(state, global_env_dict(env), subst, eff_subst, expr, anno, alias_env)
        match r with
        | InferErr pos e -> TypedDeclErr(pos, e)
        | InferOk typed_expr0 s1raw es1raw _ ->
            # An optional `let x : T = e` annotation is checked against the
            # inferred RHS type before generalization, narrowing the scheme.
            match apply_let_annotation(anno, s1raw, es1raw, typed_ast.typed_expr_type(typed_expr0), alias_env, name) with
            | unifier.UnifyErr msg -> TypedDeclErr(let_pos, msg)
            | unifier.UnifyOk s1a es1a ->
                # AFTER the annotation unify, which may be the only thing that
                # determines a deferred field access's receiver.
                do
                  f <- finish_field_obligations(state, global_env_dict(env), s1a, typed_expr0)
                  match f with
                  | FinishErr fpos fmsg -> TypedDeclErr(fpos, fmsg)
                  | FinishOk typed_expr s1 ->
                      # The dispatch post-pass, which every `fn` body and instance method already
                      # gets (check_fn_body, check_instance_methods) and a top-level `let` did not.
                      # It fills a dictionary slot that inference-time injection left open — the
                      # return-position case, where only the concrete return type names the
                      # instance. Run with s1, i.e. AFTER apply_let_annotation, because for a `let`
                      # the annotation is the only thing that makes that return type concrete:
                      # `let d: Int = make()` has nothing else to say which `Def` instance it means.
                      # Without this the slot stayed open and the call reached codegen an argument
                      # short of the arity its dictionary parameters imply.
                      finish_let_decl(name, expr,
                        resolve_dispatch_typed_expr(global_env_dict(env), s1, set_empty(), typed_expr),
                        s1, let_pos, env, env_ftv, es1a)
  | ast.AliasDecl _ _ _ _ ->
      TypedDeclOk(typed_ast.TPassThrough(decl), env, env_ftv, subst)
  | ast.ClassDecl class_name type_params methods superclasses _ ->
      TypedDeclOk(typed_ast.TPassThrough(decl),
        GlobalEnv(register_class_methods(type_params, methods,
          register_class_method_markers(class_name, type_params, methods,
            register_superclass_markers(class_name, superclasses, global_env_dict(env))))),
        env_ftv, subst)
  | ast.InstanceDecl constraint inst_constraints methods _ ->
      do
        r <- check_instance_methods(state, inst_constraints, methods, global_env_dict(env), subst, eff_subst, env_ftv)
        match r with
        | typed_ast.InstanceMethodsErr pos e -> TypedDeclErr(pos, e)
        | typed_ast.InstanceMethodsOk typed_methods ->
            # `subst` unchanged: an instance method's inference is NOT merged
            # into the thread. Two instances of one class implement the same
            # method name, so their placeholders would otherwise be forced equal.
            # scheme_from_fn_parts gives them a "#inst/" namespace for the same
            # reason — the two guards are a pair.
            TypedDeclOk(
              typed_ast.TInstanceDecl(constraint, inst_constraints, typed_methods),
              GlobalEnv(register_instance_marker(constraint, global_env_dict(env))),
              env_ftv, subst)

# ---------------------------------------------------------------------------
# apply_subst_typed_expr — walk a typed AST applying a type substitution
# ---------------------------------------------------------------------------

fn apply_subst_typed_expr_list(subst: Dict types.Type, exprs: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  match exprs with
  | Nil -> Nil
  | Cons h t -> Cons(apply_subst_typed_expr(subst, h), apply_subst_typed_expr_list(subst, t))

fn apply_subst_typed_match_branches(subst: Dict types.Type, branches: List typed_ast.TypedMatchBranch) -> List typed_ast.TypedMatchBranch =
  match branches with
  | Nil -> Nil
  | Cons h t ->
      match h with
      | typed_ast.TypedMatchBranch pat body ->
          Cons(typed_ast.TypedMatchBranch(pat, apply_subst_typed_expr(subst, body)), apply_subst_typed_match_branches(subst, t))

fn apply_subst_typed_do_steps(subst: Dict types.Type, steps: List typed_ast.TypedDoStep) -> List typed_ast.TypedDoStep =
  match steps with
  | Nil -> Nil
  | Cons h t ->
      match h with
      | typed_ast.TDoBindStep pat expr ->
          Cons(typed_ast.TDoBindStep(pat, apply_subst_typed_expr(subst, expr)), apply_subst_typed_do_steps(subst, t))
      | typed_ast.TDoLetStep name expr ->
          Cons(typed_ast.TDoLetStep(name, apply_subst_typed_expr(subst, expr)), apply_subst_typed_do_steps(subst, t))
      | typed_ast.TDoExprStep expr ->
          Cons(typed_ast.TDoExprStep(apply_subst_typed_expr(subst, expr)), apply_subst_typed_do_steps(subst, t))

fn apply_subst_typed_record_fields(subst: Dict types.Type, fields: List typed_ast.TypedRecordField) -> List typed_ast.TypedRecordField =
  match fields with
  | Nil -> Nil
  | Cons h t ->
      match h with
      | typed_ast.TypedRecordField name expr ->
          Cons(typed_ast.TypedRecordField(name, apply_subst_typed_expr(subst, expr)), apply_subst_typed_record_fields(subst, t))

fn apply_subst_typed_expr(subst: Dict types.Type, e: typed_ast.TypedExpr) -> typed_ast.TypedExpr =
  match e with
  | typed_ast.TVar name t pos ->
      typed_ast.TVar(name, unifier.apply_subst(subst, t), pos)
  | typed_ast.TInt val t pos ->
      typed_ast.TInt(val, unifier.apply_subst(subst, t), pos)
  | typed_ast.TFloat text t pos ->
      typed_ast.TFloat(text, unifier.apply_subst(subst, t), pos)
  | typed_ast.TBool val t pos ->
      typed_ast.TBool(val, unifier.apply_subst(subst, t), pos)
  | typed_ast.TString val t pos ->
      typed_ast.TString(val, unifier.apply_subst(subst, t), pos)
  | typed_ast.TChar val t pos ->
      typed_ast.TChar(val, unifier.apply_subst(subst, t), pos)
  | typed_ast.TUnit t pos ->
      typed_ast.TUnit(unifier.apply_subst(subst, t), pos)
  | typed_ast.TTuple items t pos ->
      typed_ast.TTuple(apply_subst_typed_expr_list(subst, items), unifier.apply_subst(subst, t), pos)
  | typed_ast.TIf cond then_ else_ t pos ->
      typed_ast.TIf(apply_subst_typed_expr(subst, cond), apply_subst_typed_expr(subst, then_), apply_subst_typed_expr(subst, else_), unifier.apply_subst(subst, t), pos)
  | typed_ast.TMatch scrutinee branches t pos ->
      typed_ast.TMatch(apply_subst_typed_expr(subst, scrutinee), apply_subst_typed_match_branches(subst, branches), unifier.apply_subst(subst, t), pos)
  | typed_ast.TCall fn_ args t pos ->
      typed_ast.TCall(apply_subst_typed_expr(subst, fn_), apply_subst_typed_expr_list(subst, args), unifier.apply_subst(subst, t), pos)
  | typed_ast.TDict constraint t pos ev ->
      typed_ast.TDict(constraint, unifier.apply_subst(subst, t), pos, ev)
  | typed_ast.TMethodRef method class_name t pos ev ->
      typed_ast.TMethodRef(method, class_name, unifier.apply_subst(subst, t), pos, ev)
  | typed_ast.TLambda params body t pos ->
      typed_ast.TLambda(params, apply_subst_typed_expr(subst, body), unifier.apply_subst(subst, t), pos)
  | typed_ast.TBinary op left right t pos ->
      typed_ast.TBinary(op, apply_subst_typed_expr(subst, left), apply_subst_typed_expr(subst, right), unifier.apply_subst(subst, t), pos)
  | typed_ast.TUnary op operand t pos ->
      typed_ast.TUnary(op, apply_subst_typed_expr(subst, operand), unifier.apply_subst(subst, t), pos)
  | typed_ast.TRange from_ to_ t pos ->
      typed_ast.TRange(apply_subst_typed_expr(subst, from_), apply_subst_typed_expr(subst, to_), unifier.apply_subst(subst, t), pos)
  | typed_ast.TDo steps t pos ->
      typed_ast.TDo(apply_subst_typed_do_steps(subst, steps), unifier.apply_subst(subst, t), pos)
  | typed_ast.TRecord name fields t pos ->
      typed_ast.TRecord(name, apply_subst_typed_record_fields(subst, fields), unifier.apply_subst(subst, t), pos)
  | typed_ast.TGetField expr field t pos ->
      typed_ast.TGetField(apply_subst_typed_expr(subst, expr), field, unifier.apply_subst(subst, t), pos)
  | typed_ast.TRecordUpdate base fields t pos ->
      typed_ast.TRecordUpdate(apply_subst_typed_expr(subst, base), apply_subst_typed_record_fields(subst, fields), unifier.apply_subst(subst, t), pos)

# ---------------------------------------------------------------------------
# Post-inference dispatch resolution for return-type-driven typeclass methods
# ---------------------------------------------------------------------------
#
# At inference time, check_call_constraint dispatches class methods based on
# the first concrete argument's type. For methods whose class type variable is
# in an argument position (e.g. `Eq.eq : a -> a -> Bool`), this works correctly.
# For methods whose class type variable is ONLY in the return position
# (e.g. a hypothetical `Read.read : String -> a`), the return type's
# substitution comes from the OUTER context (a function's declared return type)
# which isn't unified until AFTER inference completes — so the inference-time
# dispatch picks the wrong instance.
#
# This post-pass walker runs AFTER check_fn_body's body-vs-return-type
# unification (s2). It re-examines class method calls, computes the correct
# dispatch using s2 + the method's scheme, and rewrites only the TDict in
# cases where the dispatch was wrong. Original TCall.t values are preserved
# — only the TDict's TypeConstraint changes.
#
# Constrained-function calls (non-class-method calls to `fn f … where C a`)
# are handled by maybe_rewrite_constrained_fn_call, which mirrors the same
# post-pass pattern for the case where `a` appears only in the return type:
# inference-time field injection runs before s2 (while `a` is still a free TVar),
# so it may fail to find the dict.  The post-pass re-resolves using the now-
# concrete return type `t`.

fn strip_leading_tdicts(args: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  match args with
  | Nil -> Nil
  | Cons (typed_ast.TDict _ _ _ _) rest -> strip_leading_tdicts(rest)
  | _ -> args

# Collect ALL TDict nodes from an arg list, in the order they appear.
# Used to preserve inference-time fwd-marker dicts at still-polymorphic call
# sites (inside a constrained fn body) when the post-pass cannot improve them.
fn collect_all_tdicts(args: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  match args with
  | Nil -> Nil
  | Cons (typed_ast.TDict c t2 p ev) rest -> Cons(typed_ast.TDict(c, t2, p, ev), collect_all_tdicts(rest))
  | Cons _ rest -> collect_all_tdicts(rest)

# Post-pass rewrite for constrained regular-function calls.
# Mirrors maybe_rewrite_class_method_call for functions declared with
# `where C a` constraints.
#
# For each @constrained_N:fn_name marker:
#   - If the inference-time pass already injected a dict, keep it unchanged.
#     This covers input-position constraints (correct at inference time) and
#     return-position constraints inside constrained fn bodies (@fwd forwarding).
#   - If no dict was injected (missing), scan the concrete return type `t`
#     (post-s2) for a matching @inst entry and inject the correct dict.
#
# Only called when @class:fn_name is absent (fn_ is not a class method).
fn maybe_rewrite_constrained_fn_call(
  env: Dict types.Scheme,
  subst: Dict types.Type,
  fn_: typed_ast.TypedExpr,
  fn_name: String,
  args: List typed_ast.TypedExpr,
  t: types.Type,
  pos: source.SourcePos
) -> typed_ast.TypedExpr =
  # §13.3(B) S4: gate on the callee's Scheme constraint field (single source of
  # truth), not the parallel @constrained_N markers. An empty field means the
  # callee is unconstrained → no dicts to correct.
  match constrained_fn_field(fn_name, env) with
  | Nil -> typed_ast.TCall(fn_, args, t, pos)
  | cs ->
      typed_ast.TCall(fn_,
        list_append(
          user_typed_args(args),
          build_constrained_fn_dicts_via_field(cs, env, fn_name,
            unifier.apply_subst(subst, typed_ast.typed_expr_type(fn_)),
            unifier.apply_subst(subst, t),
            pos, collect_all_tdicts(args))),
        t, pos)

# The class a TDict provides evidence for — its TypeConstraint's class, on the
# SHORT name so a qualified injected dict (`main.Tag`) still matches an unqualified
# field entry (`Tag`) after bundling. Nothing for a non-TDict node (defensive;
# existing_dicts is collect_all_tdicts output, so all elements are TDicts).
fn tdict_class_short(d: typed_ast.TypedExpr) -> Maybe String =
  match d with
  | typed_ast.TDict (ast.TypeConstraint cn _) _ _ _ -> Just(string.after_last_dot(cn))
  | _ -> Nothing

# Remove and return the first dict in `dicts` whose class matches `class_name`
# (short name), preserving the order of the remaining dicts. Nothing if none match.
fn take_dict_for_class(class_name: String, dicts: List typed_ast.TypedExpr) -> Maybe(typed_ast.TypedExpr, List typed_ast.TypedExpr) =
  match dicts with
  | Nil -> Nothing
  | Cons d rest ->
      if maybe_str_eq(tdict_class_short(d), string.after_last_dot(class_name))
      then Just((d, rest))
      else
        match take_dict_for_class(class_name, rest) with
        | Just (found, remaining) -> Just((found, Cons(d, remaining)))
        | Nothing -> Nothing

fn maybe_str_eq(m: Maybe String, s: String) -> Bool =
  match m with
  | Just x -> x == s
  | Nothing -> false

# Build the corrected dict list for a constrained function call (post-pass).
# Iterates the callee's Scheme constraint list (the single source of truth) in
# where-clause order. Per constraint:
#   - reuse the inference-time dict of the SAME CLASS if one was injected (matched
#     by class, not position — a return-position constraint that was unresolved at
#     inference leaves existing_dicts sparse, so positional indexing would hand a
#     later constraint's dict to the wrong slot);
#   - otherwise a HEADED constraint (a head VARIABLE or concrete ctor) locates its
#     variable in the callee's declared type and takes the instance for whatever
#     this call instantiated it to, falling back to scanning the concrete return
#     type; an argument-scanned one ("#none" or "#app:<Name>") emits nothing here.
# (A residual corner remains: two constraints of the SAME class where one is an
# unresolved return-position gap cannot be told apart by class alone.)
fn build_constrained_fn_dicts_via_field(
  constraints: List (String, String),
  env: Dict types.Scheme,
  fn_name: String,
  callee_ty: types.Type,
  concrete_ret: types.Type,
  pos: source.SourcePos,
  existing_dicts: List typed_ast.TypedExpr
) -> List typed_ast.TypedExpr =
  match constraints with
  | Nil -> Nil
  | Cons entry rest ->
      match entry with
      | (head_token, class_name) ->
          match take_dict_for_class(class_name, existing_dicts) with
          | Just (existing_d, remaining) ->
              Cons(existing_d,
                   build_constrained_fn_dicts_via_field(rest, env, fn_name, callee_ty, concrete_ret, pos, remaining))
          | Nothing ->
              # An argument-scanned token (headless OR compound-head) emits
              # nothing here: this site scans the RETURN type, and a `where
              # ToString (Box a)` obligation is not discharged by the return type
              # merely because the return type happens to have an instance.
              if is_arg_scanned_token(head_token)
              then build_constrained_fn_dicts_via_field(rest, env, fn_name, callee_ty, concrete_ret, pos, existing_dicts)
              else
                match constraint_var_dict(class_name, head_token, fn_name, env, callee_ty, pos) with
                | Just new_dict ->
                    Cons(new_dict,
                         build_constrained_fn_dicts_via_field(rest, env, fn_name, callee_ty, concrete_ret, pos, existing_dicts))
                | Nothing ->
                    match find_inst_in_return_type(class_name, concrete_ret, env, pos) with
                    | Just new_dict ->
                        Cons(new_dict,
                             build_constrained_fn_dicts_via_field(rest, env, fn_name, callee_ty, concrete_ret, pos, existing_dicts))
                    | Nothing ->
                        build_constrained_fn_dicts_via_field(rest, env, fn_name, callee_ty, concrete_ret, pos, existing_dicts)

# Locate the constraint's own variable in the callee's DECLARED type, walked alongside the type
# this call instantiated it to, and take the instance for what it was instantiated to.
#
# Preferred over scanning the return type because a scan takes the first component carrying an
# instance and cannot tell the constrained variable from the one beside it. `pick() -> a -> String
# where ToString a` returns `Int -> String` at the call, and BOTH halves have a `ToString`
# instance; a scan picking `String` reproduces the mis-resolution that reading a constrained
# function's own return type used to cause. The structural walk asks where `a` actually sits.
#
# This is the route class-method dispatch already takes for a class variable that appears only in
# return position (find_class_var_in_type); constrained functions kept the older scan, which also
# never descended into a FUNCTION-typed return at all, so `pick()(5)` resolved to no dictionary and
# was reported as a missing instance that in fact existed.
#
# Nothing when the callee has no scheme, the variable cannot be located, the type it was
# instantiated to is still polymorphic, or no instance is registered for it — each leaves the
# caller's existing return-type scan to try, so no resolution that worked before changes.
fn constraint_var_dict(class_name: String, head_token: String, fn_name: String,
                       env: Dict types.Scheme, callee_ty: types.Type,
                       pos: source.SourcePos) -> Maybe typed_ast.TypedExpr =
  let Just sch = dict_get(fn_name, env) else Nothing
      Just concrete = find_class_var_in_type(types.scheme_type(sch), callee_ty,
                        decode_constraint_var(head_token, fn_name, env)) else Nothing
      Just head_str = concrete_type_str(concrete) else Nothing
      Just _ = dict_get("@inst:" ++ class_name ++ ":" ++ head_str, env) else Nothing
  in
    Just(typed_ast.TDict(
      ast.TypeConstraint(class_name, Cons(type_to_typeexpr(concrete), Nil)),
      types.TConst(types.type_id(class_name)), pos, typed_ast.EvUnresolved))

# Scan a concrete return type for an inner component that has an @inst marker
# for the given class.  Tries the type itself first (handles `a` in return
# position directly), then recurses into TApp arguments and TTuple elements.
# Returns the first matching TDict, or Nothing if the return type is still
# polymorphic (contains only TVars with no matching @inst entry).
fn find_inst_in_return_type(class_name: String, t: types.Type, env: Dict types.Scheme, pos: source.SourcePos) -> Maybe typed_ast.TypedExpr =
  match concrete_type_str(t) with
  | Just head_str ->
      match dict_get("@inst:" ++ class_name ++ ":" ++ head_str, env) with
      | Just _ ->
          Just(typed_ast.TDict(
            ast.TypeConstraint(class_name, Cons(type_to_typeexpr(t), Nil)),
            types.TConst(types.type_id(class_name)), pos, typed_ast.EvUnresolved))
      | Nothing ->
          find_inst_in_return_type_children(class_name, t, env, pos)
  | Nothing ->
      Nothing

fn find_inst_in_return_type_children(class_name: String, t: types.Type, env: Dict types.Scheme, pos: source.SourcePos) -> Maybe typed_ast.TypedExpr =
  match t with
  | types.TApp base arg ->
      # Recurse into BOTH children: a multi-parameter application like
      # `Pair e a` = `TApp (TApp Pair e) a` carries the inner type argument
      # `e` in `base`, so scanning only `arg` misses an instance needed on an
      # inner type parameter (return-type dispatch would then fall back to
      # @fwd and fail late — see test_constrained_fn_return_type_nested_tapp).
      match find_inst_in_return_type(class_name, arg, env, pos) with
      | Just d -> Just(d)
      | Nothing -> find_inst_in_return_type(class_name, base, env, pos)
  | types.TTuple items -> find_inst_in_return_type_list(class_name, items, env, pos)
  | _ -> Nothing

fn find_inst_in_return_type_list(class_name: String, items: List types.Type, env: Dict types.Scheme, pos: source.SourcePos) -> Maybe typed_ast.TypedExpr =
  match items with
  | Nil -> Nothing
  | Cons h rest ->
      match find_inst_in_return_type(class_name, h, env, pos) with
      | Just d -> Just(d)
      | Nothing -> find_inst_in_return_type_list(class_name, rest, env, pos)

# Prepend the instance dict for a dispatch head the final substitution has made
# concrete. Shared by the return- and input-position paths: once the head is
# concrete both want the same node, and having one spelling of it keeps them from
# drifting. Evidence stays `EvUnresolved` — resolve.sprout owns the instance
# table and reports a missing instance against this position.
fn concrete_dispatch_call(
  env: Dict types.Scheme,
  fn_: typed_ast.TypedExpr,
  args: List typed_ast.TypedExpr,
  t: types.Type,
  pos: source.SourcePos,
  class_name: String,
  resolved_t: types.Type
) -> typed_ast.TypedExpr =
  typed_ast.TCall(fn_,
    Cons(typed_ast.TDict(
      ast.TypeConstraint(class_name, Cons(type_to_typeexpr_with_prog_vars(resolved_t, class_name, env), Nil)),
      types.TConst(types.type_id(class_name)), pos, typed_ast.EvUnresolved),
      strip_leading_tdicts(args)),
    t, pos)

fn try_rewrite_for_return_dispatch(
  env: Dict types.Scheme,
  subst: Dict types.Type,
  fn_: typed_ast.TypedExpr,
  args: List typed_ast.TypedExpr,
  t: types.Type,
  pos: source.SourcePos,
  class_name: String,
  class_vars: List String,
  method_type: types.Type
) -> typed_ast.TypedExpr =
  match dispatch_type_for_vars(method_type, strip_leading_tdicts(args), t, subst, class_vars) with
  | Nothing -> typed_ast.TCall(fn_, args, t, pos)
  | Just resolved_t ->
      # A concrete head resolves to its instance dict directly. A head that is
      # still a type variable is a FORWARD, and this is the only place it can be
      # decided: gated_fwd_scan deliberately declines to adopt a marker at
      # inference time, because there the call's fresh return variable and the
      # enclosing constraint's variable are not yet identified. `subst` here is
      # the declaration's final substitution, so the two are now comparable —
      # see forwarded_tdict_for_tyvar. Emitting nothing leaves the call
      # dictionary-less, which verify_dispatch reports against its source
      # position rather than letting it reach the linker.
      match concrete_type_str(resolved_t) with
      | Nothing -> keep_or_forward_dispatch(env, subst, fn_, args, t, pos, class_name, resolved_t)
      | Just _ -> concrete_dispatch_call(env, fn_, args, t, pos, class_name, resolved_t)

# Input-position dispatch resolves eagerly during inference, so a call that
# already carries a dict is left exactly as it is — re-deriving it here could only
# disagree with a decision made on better information.
#
# What arrives here dict-less resolves one of two ways, and BOTH are repaired
# here rather than only the first.
#
# A FORWARD is a variable that was not yet identified with its constraint's
# variable when check_instance_fwd ran. `find_fwd_tdict_in_args` reads each
# argument's RAW node type, so a lambda parameter — whose type is a fresh
# variable until the lambda unifies with the higher-order function's parameter —
# misses its own marker. That is the `acc ++ x` inside a fold. This is what makes
# gating the `++` site safe: without the repair, gating turns every such fold
# into a dictionary-less call.
#
# A CONCRETE head reaches here when eager inference could not resolve it and only
# the final substitution can — a lambda parameter pinned by a later application,
# as in `let g = \x -> to_string(x) in g(1)`. This path used to bail out on a
# concrete head, reasoning that inference resolves input positions eagerly so a
# concrete head with no dict could only mean a missing instance. That holds only
# when the type WAS known during inference; when the application is what pins it,
# bailing out left the call dictionary-less and verify_dispatch reported
# `No instance of ToString for Int` with the instance sitting in the prelude.
# Injecting here does not assume the instance exists: the dict carries
# `EvUnresolved`, and resolve.sprout still rejects a genuinely missing one
# (docs/deferred-dispatch-v0.md).
fn maybe_forward_input_dispatch(
  env: Dict types.Scheme,
  subst: Dict types.Type,
  fn_: typed_ast.TypedExpr,
  args: List typed_ast.TypedExpr,
  t: types.Type,
  pos: source.SourcePos,
  class_name: String,
  class_vars: List String,
  method_type: types.Type
) -> typed_ast.TypedExpr =
  let Nil = collect_all_tdicts(args) else typed_ast.TCall(fn_, args, t, pos)
      Just resolved_t = dispatch_type_for_vars(method_type, args, t, subst, class_vars)
        else typed_ast.TCall(fn_, args, t, pos)
  in
    match concrete_type_str(resolved_t) with
    | Nothing -> keep_or_forward_dispatch(env, subst, fn_, args, t, pos, class_name, resolved_t)
    | Just _ -> concrete_dispatch_call(env, fn_, args, t, pos, class_name, resolved_t)

# Inject a forwarded dict when the still-polymorphic dispatch variable is one the
# enclosing declaration declared a constraint for; otherwise leave the call alone.
fn keep_or_forward_dispatch(
  env: Dict types.Scheme,
  subst: Dict types.Type,
  fn_: typed_ast.TypedExpr,
  args: List typed_ast.TypedExpr,
  t: types.Type,
  pos: source.SourcePos,
  class_name: String,
  resolved_t: types.Type
) -> typed_ast.TypedExpr =
  match forwarded_tdict_for_tyvar(env, subst, class_name, resolved_t, pos) with
  | Nothing -> typed_ast.TCall(fn_, args, t, pos)
  | Just tdict -> typed_ast.TCall(fn_, Cons(tdict, strip_leading_tdicts(args)), t, pos)

# Find the @fwd marker whose type variable is THE SAME as the dispatch variable
# under the final substitution.
#
# The equality is deliberately not a raw key lookup on the dispatch variable's
# identity. Unification is free to orient a binding either way — it may record
# `a42 -> t7` rather than `t7 -> a42` — so the marker's own key (seeded from the
# constraint variable's fresh instantiation) can name the variable that got
# substituted AWAY. Substituting both sides before comparing is orientation-proof:
# two variables that unified in either direction share a representative. Getting
# this wrong reintroduces the mis-forwarding class of PR #176/#141, so the direct
# key hit is only a fast path, never the whole test.
fn forwarded_tdict_for_tyvar(
  env: Dict types.Scheme,
  subst: Dict types.Type,
  class_name: String,
  resolved_t: types.Type,
  pos: source.SourcePos
) -> Maybe typed_ast.TypedExpr =
  let types.TVar v = resolved_t else Nothing
  in
    match dict_get("@fwd:" ++ types.tyvar_identity(v) ++ ":" ++ class_name, env) with
    | Just fwd_scheme -> fwd_scheme_to_tdict(fwd_scheme, class_name, pos)
    | Nothing -> match_fwd_marker_by_subst(class_name, v, subst, vec_to_list(dict_entries(env)), pos)

fn match_fwd_marker_by_subst(
  class_name: String,
  v: types.TyVarId,
  subst: Dict types.Type,
  entries: List (String, types.Scheme),
  pos: source.SourcePos
) -> Maybe typed_ast.TypedExpr =
  match entries with
  | Nil -> Nothing
  | Cons entry rest ->
      match entry with
      | (key, val) ->
          if is_fwd_key_for_class(key, class_name) && fwd_key_tyvar_matches(key, class_name, v, subst)
          then fwd_scheme_to_tdict(val, class_name, pos)
          else match_fwd_marker_by_subst(class_name, v, subst, rest, pos)

# The type-variable name embedded in an "@fwd:{tvar}:{class}" key.
# NB str_slice's third argument is a LENGTH, not an end index.
fn fwd_key_tyvar_name(key: String, class_name: String) -> String =
  str_slice(key, str_len("@fwd:"), str_len(key) - str_len("@fwd:") - str_len(":" ++ class_name))

# Does this "@fwd:{tvar}:{class}" key name a variable that the substitution has
# identified with `v`? Both sides are substituted before comparison.
fn fwd_key_tyvar_matches(key: String, class_name: String, v: types.TyVarId, subst: Dict types.Type) -> Bool =
  let types.TVar mv = unifier.apply_subst(subst, types.TVar(types.tyvar_id(fwd_key_tyvar_name(key, class_name)))) else false
      types.TVar rv = unifier.apply_subst(subst, types.TVar(v)) else false
  in types.tyvar_eq(mv, rv)

fn maybe_rewrite_class_method_call(
  env: Dict types.Scheme,
  subst: Dict types.Type,
  bound: Set,
  fn_: typed_ast.TypedExpr,
  args: List typed_ast.TypedExpr,
  t: types.Type,
  pos: source.SourcePos
) -> typed_ast.TypedExpr =
  match fn_ with
  # A LOCAL binding may share a class method's or a constrained fn's name — a
  # parameter, lambda parameter, `let`, do-bind or match binding. `@class:<name>`
  # and the env entry are GLOBAL registrations and cannot see the shadow, so the
  # name must be checked against the local scope first: a shadow is not the
  # method, and rewriting it injects a dict for a class the code never mentioned
  # (`fn via_param(append: Int -> Int -> Int, x: Int) = append(x, x)` →
  # `No instance of Semigroup for Int`). verify_dispatch has always skipped these
  # via its own `locals`; the rewriter reached the same calls but was blind to
  # scope, and only never mis-rewrote them because it used to decline every
  # concrete head. tests/stdlib/test_local_shadows_class_method.spr covers this.
  | typed_ast.TVar method_name _ _ ->
      if set_member(method_name, bound) then typed_ast.TCall(fn_, args, t, pos)
      else
      match dict_get("@class:" ++ method_name, env) with
      | Nothing -> maybe_rewrite_constrained_fn_call(env, subst, fn_, method_name, args, t, pos)
      | Just class_marker ->
          match class_marker with
          | types.Scheme class_vars _ class_type _ _ ->
              match class_type with
              | types.TConst class_name ->
                  match class_vars with
                  | Nil -> typed_ast.TCall(fn_, args, t, pos)
                  | _ ->
                      match dict_get(method_name, env) with
                      | Nothing -> typed_ast.TCall(fn_, args, t, pos)
                      | Just method_scheme ->
                          match method_scheme with
                          | types.Scheme _ _ method_type _ _ ->
                              if class_var_in_args(method_type, class_vars)
                              then maybe_forward_input_dispatch(env, subst, fn_, args, t, pos, types.type_id_name(class_name), class_vars, method_type)
                              else try_rewrite_for_return_dispatch(env, subst, fn_, args, t, pos, types.type_id_name(class_name), class_vars, method_type)
              | _ -> typed_ast.TCall(fn_, args, t, pos)
  | _ -> typed_ast.TCall(fn_, args, t, pos)

# `bound` carries the names bound LOCALLY at each point, and grows at every
# binding form exactly as verify_dispatch's `locals` does. A callee that names a
# local shadow is not the class method, so it must not be rewritten — see
# maybe_rewrite_class_method_call. The rewriter needs this for the same reason
# the verifier did: `@class:<name>` is a global registration and says nothing
# about what the name means at this point in the body.
fn resolve_dispatch_typed_expr(env: Dict types.Scheme, subst: Dict types.Type, bound: Set, e: typed_ast.TypedExpr) -> typed_ast.TypedExpr =
  match e with
  | typed_ast.TVar _ _ _ -> e
  | typed_ast.TInt _ _ _ -> e
  | typed_ast.TFloat _ _ _ -> e
  | typed_ast.TBool _ _ _ -> e
  | typed_ast.TString _ _ _ -> e
  | typed_ast.TChar _ _ _ -> e
  | typed_ast.TUnit _ _ -> e
  | typed_ast.TTuple items t pos ->
      typed_ast.TTuple(resolve_dispatch_typed_list(env, subst, bound, items), t, pos)
  | typed_ast.TIf cond then_ else_ t pos ->
      typed_ast.TIf(resolve_dispatch_typed_expr(env, subst, bound, cond),
                    resolve_dispatch_typed_expr(env, subst, bound, then_),
                    resolve_dispatch_typed_expr(env, subst, bound, else_),
                    t, pos)
  | typed_ast.TMatch scrutinee branches t pos ->
      typed_ast.TMatch(resolve_dispatch_typed_expr(env, subst, bound, scrutinee),
                       resolve_dispatch_typed_branches(env, subst, bound, branches),
                       t, pos)
  | typed_ast.TCall fn_ args t pos ->
      maybe_rewrite_class_method_call(env, subst, bound,
        resolve_dispatch_typed_expr(env, subst, bound, fn_),
        resolve_dispatch_typed_list(env, subst, bound, args),
        t, pos)
  | typed_ast.TDict _ _ _ _ -> e
  | typed_ast.TMethodRef _ _ _ _ _ -> e
  | typed_ast.TLambda params body t pos ->
      typed_ast.TLambda(params, resolve_dispatch_typed_expr(env, subst, bind_params(params, bound), body), t, pos)
  | typed_ast.TBinary op left right t pos ->
      typed_ast.TBinary(op, resolve_dispatch_typed_expr(env, subst, bound, left), resolve_dispatch_typed_expr(env, subst, bound, right), t, pos)
  | typed_ast.TUnary op operand t pos ->
      typed_ast.TUnary(op, resolve_dispatch_typed_expr(env, subst, bound, operand), t, pos)
  | typed_ast.TRange from_ to_ t pos ->
      typed_ast.TRange(resolve_dispatch_typed_expr(env, subst, bound, from_), resolve_dispatch_typed_expr(env, subst, bound, to_), t, pos)
  | typed_ast.TDo steps t pos ->
      typed_ast.TDo(resolve_dispatch_typed_do_steps_local(env, subst, bound, steps), t, pos)
  | typed_ast.TRecord name fields t pos ->
      typed_ast.TRecord(name, resolve_dispatch_typed_record_fields_local(env, subst, bound, fields), t, pos)
  | typed_ast.TGetField expr field t pos ->
      typed_ast.TGetField(resolve_dispatch_typed_expr(env, subst, bound, expr), field, t, pos)
  | typed_ast.TRecordUpdate base fields t pos ->
      typed_ast.TRecordUpdate(resolve_dispatch_typed_expr(env, subst, bound, base), resolve_dispatch_typed_record_fields_local(env, subst, bound, fields), t, pos)

fn resolve_dispatch_typed_list(env: Dict types.Scheme, subst: Dict types.Type, bound: Set, xs: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  match xs with
  | Nil -> Nil
  | Cons h t -> Cons(resolve_dispatch_typed_expr(env, subst, bound, h), resolve_dispatch_typed_list(env, subst, bound, t))

# A branch's pattern binds only within that branch, so each arm extends `bound`
# from the incoming set rather than from its predecessor.
fn resolve_dispatch_typed_branches(env: Dict types.Scheme, subst: Dict types.Type, bound: Set, branches: List typed_ast.TypedMatchBranch) -> List typed_ast.TypedMatchBranch =
  match branches with
  | Nil -> Nil
  | Cons h t ->
      match h with
      | typed_ast.TypedMatchBranch pat body ->
          Cons(typed_ast.TypedMatchBranch(pat, resolve_dispatch_typed_expr(env, subst, bind_pattern(pat, bound), body)),
               resolve_dispatch_typed_branches(env, subst, bound, t))

# Do steps bind SEQUENTIALLY: a name is in scope for the steps below it, but not
# for its own right-hand side.
fn resolve_dispatch_typed_do_steps_local(env: Dict types.Scheme, subst: Dict types.Type, bound: Set, steps: List typed_ast.TypedDoStep) -> List typed_ast.TypedDoStep =
  match steps with
  | Nil -> Nil
  | Cons h t ->
      match h with
      | typed_ast.TDoBindStep pat expr ->
          Cons(typed_ast.TDoBindStep(pat, resolve_dispatch_typed_expr(env, subst, bound, expr)),
               resolve_dispatch_typed_do_steps_local(env, subst, bind_pattern(pat, bound), t))
      | typed_ast.TDoLetStep name expr ->
          Cons(typed_ast.TDoLetStep(name, resolve_dispatch_typed_expr(env, subst, bound, expr)),
               resolve_dispatch_typed_do_steps_local(env, subst, set_insert(name, bound), t))
      | typed_ast.TDoExprStep expr ->
          Cons(typed_ast.TDoExprStep(resolve_dispatch_typed_expr(env, subst, bound, expr)),
               resolve_dispatch_typed_do_steps_local(env, subst, bound, t))

fn resolve_dispatch_typed_record_fields_local(env: Dict types.Scheme, subst: Dict types.Type, bound: Set, fields: List typed_ast.TypedRecordField) -> List typed_ast.TypedRecordField =
  match fields with
  | Nil -> Nil
  | Cons h t ->
      match h with
      | typed_ast.TypedRecordField name expr ->
          Cons(typed_ast.TypedRecordField(name, resolve_dispatch_typed_expr(env, subst, bound, expr)), resolve_dispatch_typed_record_fields_local(env, subst, bound, t))

# ---------------------------------------------------------------------------
# Soundness validator — detect unresolved TVars in typed AST
# ---------------------------------------------------------------------------

fn has_unresolved_tvar_in_type(t: types.Type) -> Bool =
  match t with
  | types.TVar _ -> true
  | types.TConst _ -> false
  | types.TApp base arg -> has_unresolved_tvar_in_type(base) || has_unresolved_tvar_in_type(arg)
  | types.TFunc param ret _ _ -> has_unresolved_tvar_in_type(param) || has_unresolved_tvar_in_type(ret)
  | types.TTuple items -> has_unresolved_tvar_in_type_list(items)

fn has_unresolved_tvar_in_type_list(items: List types.Type) -> Bool =
  match items with
  | Nil -> false
  | Cons h t -> has_unresolved_tvar_in_type(h) || has_unresolved_tvar_in_type_list(t)

fn assert_resolved_typed_expr(fn_name: String, expr: typed_ast.TypedExpr) -> Unit !{IO} =
  do
    _ <- if has_unresolved_tvar_in_type(typed_ast.typed_expr_type(expr))
         then print("[WARN] unresolved TVar in typed AST of " ++ fn_name)
         else ()
    match expr with
    | typed_ast.TVar _ _ _ -> ()
    | typed_ast.TInt _ _ _ -> ()
    | typed_ast.TFloat _ _ _ -> ()
    | typed_ast.TBool _ _ _ -> ()
    | typed_ast.TString _ _ _ -> ()
    | typed_ast.TChar _ _ _ -> ()
    | typed_ast.TUnit _ _ -> ()
    | typed_ast.TTuple items _ _ -> assert_resolved_typed_expr_list(fn_name, items)
    | typed_ast.TIf cond then_ else_ _ _ ->
        do
          assert_resolved_typed_expr(fn_name, cond)
          assert_resolved_typed_expr(fn_name, then_)
          assert_resolved_typed_expr(fn_name, else_)
    | typed_ast.TMatch scrutinee branches _ _ ->
        do
          assert_resolved_typed_expr(fn_name, scrutinee)
          assert_resolved_typed_match_branches(fn_name, branches)
    | typed_ast.TCall fn_ args _ _ ->
        do
          assert_resolved_typed_expr(fn_name, fn_)
          assert_resolved_typed_expr_list(fn_name, args)
    | typed_ast.TDict _ _ _ _ -> ()
    | typed_ast.TMethodRef _ _ _ _ _ -> ()
    | typed_ast.TLambda _ body _ _ -> assert_resolved_typed_expr(fn_name, body)
    | typed_ast.TBinary _ left right _ _ ->
        do
          assert_resolved_typed_expr(fn_name, left)
          assert_resolved_typed_expr(fn_name, right)
    | typed_ast.TUnary _ operand _ _ -> assert_resolved_typed_expr(fn_name, operand)
    | typed_ast.TRange from_ to_ _ _ ->
        do
          assert_resolved_typed_expr(fn_name, from_)
          assert_resolved_typed_expr(fn_name, to_)
    | typed_ast.TDo steps _ _ -> assert_resolved_typed_do_steps(fn_name, steps)
    | typed_ast.TRecord _ fields _ _ -> assert_resolved_typed_record_fields(fn_name, fields)
    | typed_ast.TGetField expr _ _ _ -> assert_resolved_typed_expr(fn_name, expr)
    | typed_ast.TRecordUpdate base fields _ _ ->
        do
          assert_resolved_typed_expr(fn_name, base)
          assert_resolved_typed_record_fields(fn_name, fields)

fn assert_resolved_typed_expr_list(fn_name: String, exprs: List typed_ast.TypedExpr) -> Unit !{IO} =
  match exprs with
  | Nil -> ()
  | Cons h t ->
      do
        assert_resolved_typed_expr(fn_name, h)
        assert_resolved_typed_expr_list(fn_name, t)

fn assert_resolved_typed_match_branches(fn_name: String, branches: List typed_ast.TypedMatchBranch) -> Unit !{IO} =
  match branches with
  | Nil -> ()
  | Cons h t ->
      do
        match h with
        | typed_ast.TypedMatchBranch _ body -> assert_resolved_typed_expr(fn_name, body)
        assert_resolved_typed_match_branches(fn_name, t)

fn assert_resolved_typed_do_steps(fn_name: String, steps: List typed_ast.TypedDoStep) -> Unit !{IO} =
  match steps with
  | Nil -> ()
  | Cons h t ->
      do
        match h with
        | typed_ast.TDoBindStep _ expr -> assert_resolved_typed_expr(fn_name, expr)
        | typed_ast.TDoLetStep _ expr -> assert_resolved_typed_expr(fn_name, expr)
        | typed_ast.TDoExprStep expr -> assert_resolved_typed_expr(fn_name, expr)
        assert_resolved_typed_do_steps(fn_name, t)

fn assert_resolved_typed_record_fields(fn_name: String, fields: List typed_ast.TypedRecordField) -> Unit !{IO} =
  match fields with
  | Nil -> ()
  | Cons h t ->
      do
        match h with
        | typed_ast.TypedRecordField _ expr -> assert_resolved_typed_expr(fn_name, expr)
        assert_resolved_typed_record_fields(fn_name, t)

# ---------------------------------------------------------------------------
# FnDecl body inference
# ---------------------------------------------------------------------------

# fold_fwd_markers takes the @eta_fwd:* markers computed for a constrained
# FnDecl's body and folds them into the GlobalEnv that will flow to the
# next decl.  The env parameter is typed GlobalEnv (not raw Dict) so the
# caller must explicitly construct a global env at the call site — preventing
# the retro bug where a body-scope env (containing @fwd:* markers) was
# accidentally fed in.
fn fold_fwd_markers(markers: Dict types.Scheme, env: GlobalEnv) -> GlobalEnv =
  GlobalEnv(fold_fwd_entries(vec_to_list(dict_entries(markers)), global_env_dict(env)))

fn fold_fwd_entries(entries: List (String, types.Scheme), env: Dict types.Scheme) -> Dict types.Scheme =
  match entries with
  | Nil -> env
  | Cons (key, scheme) rest ->
      fold_fwd_entries(rest, dict_set(key, scheme, env))

# Signature rigidity check (W3/F-RIGID): a WRITTEN type variable must stay
# abstract in the body. Each declared tyvar was instantiated to a fresh TVar
# (recorded in prog_to_fresh keyed by the written name); after checking the body,
# each is re-derived from the final substitution. Runs post-unification so it
# never perturbs dict forwarding (constraints leave the tyvar a TVar), unlike
# skolemization — which is why the rule lives here and not in unify.
#
# A written variable survives only when it resolves to a bare variable that no
# OTHER written variable also resolves to. Two ways to break it:
#   - a compound resolution pins it to a structure the signature left open;
#   - two written variables reaching the same variable is the undeclared
#     constraint `a = b`.
# Both were once accepted. The guard tested only whether the resolution
# mentioned a TConst, so `fn snd(x: a, y: b) -> a = y` (merge) and
# `fn f(x: a, g: b -> c) -> a = g` (const-free compound) passed, silently
# narrowing the scheme while a forward caller committed against the un-narrowed
# one — a SIGSEGV rather than a diagnostic. Fixtures:
# tests/conformance/type_error/rigid_signature{,_var_merge,_compound}.spr.
#
# `names` are the scheme's quantified vars, i.e. exactly the variables the
# PROGRAMMER wrote. An unannotated return or parameter contributes no name here:
# its placeholder is minted straight into the type and left out of the binder
# list (see unann_ret_var), so inference stays free to specialize it — which is
# what keeps `rcompose(f: a->b, g: b->c) = \x -> g(f(x))` accepted with its
# inferred `a -> c` return. This used to need an explicit `_unann` skip inside
# the walk; leaving the placeholders unquantified removes the thing to skip.
fn rigidity_violation(prog_to_fresh: Dict types.Type, s2: Dict types.Type, names: List String) -> Maybe String =
  rigidity_violation_go(prog_to_fresh, s2, names, dict_empty(), fresh_to_written(prog_to_fresh))

# `claimed` maps a resolved variable's identity to the written name that reached
# it first, which is what turns a second arrival into a merge report.
# `written` is the reverse of prog_to_fresh, used only to render.
fn rigidity_violation_go(
  prog_to_fresh: Dict types.Type,
  s2: Dict types.Type,
  names: List String,
  claimed: Dict String,
  written: Dict String
) -> Maybe String =
  match names with
  | Nil -> Nothing
  | Cons n rest ->
      let Just fresh_v = dict_get(n, prog_to_fresh) else rigidity_violation_go(prog_to_fresh, s2, rest, claimed, written)
      in
        match unifier.apply_subst(s2, fresh_v) with
        | types.TVar id ->
            # Intact only if no earlier written variable resolved here too.
            # Two written variables sharing one resolution is the constraint
            # `a = b`, which the signature never declared.
            match dict_get(types.tyvar_identity(id), claimed) with
            | Just earlier -> Just(n ++ " merged with declared variable " ++ earlier)
            | Nothing ->
                rigidity_violation_go(prog_to_fresh, s2, rest,
                  dict_set(types.tyvar_identity(id), n, claimed), written)
        | other ->
            # Any compound resolution pins the variable to a structure the
            # signature promised to leave open. This holds for a const-free
            # one (`b -> c`) exactly as for `Int` or `List c`: a caller may
            # still instantiate the variable at anything else.
            Just(n ++ " forced to " ++ types.type_to_string(render_written(written, other)))

# prog_to_fresh reversed: fresh-variable identity -> the name the programmer
# wrote. Rendering a resolution through it keeps the internal "$t41" out of the
# diagnostic, which for a merge is the whole message ("merged with a").
fn fresh_to_written(prog_to_fresh: Dict types.Type) -> Dict String =
  fresh_to_written_go(vec_to_list(dict_entries(prog_to_fresh)), dict_empty())

fn fresh_to_written_go(entries: List (String, types.Type), acc: Dict String) -> Dict String =
  match entries with
  | Nil -> acc
  | Cons entry rest ->
      match entry with
      | (written, t) ->
          match t with
          | types.TVar id -> fresh_to_written_go(rest, dict_set(types.tyvar_identity(id), written, acc))
          | _ -> fresh_to_written_go(rest, acc)

# Structural sibling of `types.apply_rename_type`, kept local because this
# renames INTO the programmer's names for one diagnostic rather than into the
# canonical a/b/c display names a scheme is printed with.
fn render_written(written: Dict String, t: types.Type) -> types.Type =
  match t with
  | types.TVar id ->
      match dict_get(types.tyvar_identity(id), written) with
      | Just name -> types.TVar(types.tyvar_id(name))
      | Nothing -> t
  | types.TConst _ -> t
  | types.TApp base arg -> types.TApp(render_written(written, base), render_written(written, arg))
  | types.TFunc p r eff own -> types.TFunc(render_written(written, p), render_written(written, r), eff, own)
  | types.TTuple items -> types.TTuple(render_written_list(written, items))

fn render_written_list(written: Dict String, items: List types.Type) -> List types.Type =
  match items with
  | Nil -> Nil
  | Cons h t -> Cons(render_written(written, h), render_written_list(written, t))

# M4.2 linear check, gated on the program declaring any linear type. When it does
# not, skip the check AND the full-body substitution copy (evaluated only inside
# the `if`), so linear-free compilation pays nothing.
#
# M4.5 widens the gate by one cheap disjunct: a program with NO linear type must
# still REJECT `borrowing`/`consuming` written on a non-linear parameter, and such
# a program never trips program_has_linear. The extra test walks a handful of
# params and is only reached when the first disjunct already failed.
# An extern's declared parameter types, built the same way its scheme is, so the
# modifier guard sees exactly the types callers will see.
fn extern_decl_result(name: String, params: List ast.Param, ret_type_maybe: Maybe ast.TypeExpr,
                      effects_maybe: Maybe (List String), ext_pos: source.SourcePos,
                      alias_env: Dict types.Type, env: GlobalEnv,
                      env_ftv: List String, subst: Dict types.Type) -> TypedDeclResult =
  match linear_check.check_signature_modes(params,
          types.scheme_type(scheme_from_fn_parts(name, params, ret_type_maybe, effects_maybe, alias_env)),
          ext_pos, global_env_dict(env)) with
  | linear_check.LinFail lp lm -> TypedDeclErr(lp, lm)
  | linear_check.LinPass -> extern_decl_ok(name, params, ret_type_maybe, effects_maybe, alias_env, env, env_ftv, subst)

fn extern_decl_ok(name: String, params: List ast.Param, ret_type_maybe: Maybe ast.TypeExpr,
                  effects_maybe: Maybe (List String), alias_env: Dict types.Type,
                  env: GlobalEnv, env_ftv: List String, subst: Dict types.Type) -> TypedDeclResult =
  match dict_get(name, global_env_dict(env)) with
  | Just _ ->
      TypedDeclOk(typed_ast.TExternFnDecl(name, params, ret_type_maybe, effects_maybe), env, env_ftv, subst)
  | Nothing ->
      TypedDeclOk(
        typed_ast.TExternFnDecl(name, params, ret_type_maybe, effects_maybe),
        GlobalEnv(dict_set(name, scheme_from_fn_parts(name, params, ret_type_maybe, effects_maybe, alias_env), global_env_dict(env))),
        env_ftv, subst)

fn fn_linear_gate(params: List ast.Param, s2: Dict types.Type, inst_type: types.Type,
                  typed_body: typed_ast.TypedExpr, fn_pos: source.SourcePos,
                  env: Dict types.Scheme) -> linear_check.LinCheck =
  if linear_check.program_has_linear(env) || linear_check.any_param_mode_written(params) then
    linear_check.check_fn_linear(params, unifier.apply_subst(s2, inst_type),
      apply_subst_typed_expr(s2, typed_body), fn_pos, env)
  else linear_check.LinPass

# Same gate for a top-level `let` body (no params to leak-check).
fn letdecl_linear_gate(s1: Dict types.Type, typed_expr: typed_ast.TypedExpr,
                       env: GlobalEnv) -> linear_check.LinCheck =
  if linear_check.program_has_linear(global_env_dict(env)) then
    linear_check.check_body_linear(apply_subst_typed_expr(s1, typed_expr), global_env_dict(env))
  else linear_check.LinPass

# The class of the first typeclass dictionary in an expression whose choice depends on one of
# `quantified` — the variables the binding is about to generalize over.
#
# The question cannot be put to the TDict node: its head was committed when the node was built, so
# a guessed `ToString String` and a determined one are the same three words. Put it to the CALL
# instead. A dictionary is determined by the constraint variable's instantiation there, so if
# neither the call's arguments nor its result mentions a variable the binding generalizes over,
# the choice is already made and generalizing cannot unmake it:
#
#   let tag = \x -> (x, to_string(7))    # quantifies `a`; the dict is ToString Int, from the 7
#
# is legitimate, and stays legitimate. Only a dictionary hanging on `a` itself is ambiguous.
#
# The test is per-BINDING, not per-variable: it asks whether a dictionary is ambiguous given
# everything this binding generalizes, and attributes it to no particular variable. Asking it
# about one variable in isolation reads false — `merge_runs`'s `where Ord k` over
# `List (k, Int, a)` mentions the payload `a` too. A caller that needs per-variable attribution
# wants uncovered_dict_subject, which derives the subject from the callee's own constraint.
fn first_ambiguous_dict_class(e: typed_ast.TypedExpr, subst: Dict types.Type,
                              quantified: List String) -> Maybe String =
  match e with
  | typed_ast.TMethodRef _ class_name t _ _ ->
      if type_mentions_quantified(t, subst, quantified) then Just(class_name) else Nothing
  | typed_ast.TCall callee args t _ ->
      match dict_class_of_args(args) with
      | Just class_name ->
          if call_mentions_quantified(args, t, subst, quantified) then Just(class_name)
          else ambiguous_dict_in_list(Cons(callee, args), subst, quantified)
      | Nothing -> ambiguous_dict_in_list(Cons(callee, args), subst, quantified)
  | typed_ast.TLambda _ body _ _ -> first_ambiguous_dict_class(body, subst, quantified)
  | typed_ast.TIf cond thn els _ _ -> ambiguous_dict_in_list([cond, thn, els], subst, quantified)
  | typed_ast.TMatch scrut arms _ _ ->
      match first_ambiguous_dict_class(scrut, subst, quantified) with
      | Just c -> Just(c)
      | Nothing -> ambiguous_dict_in_arms(arms, subst, quantified)
  | typed_ast.TDo steps _ _ -> ambiguous_dict_in_steps(steps, subst, quantified)
  | typed_ast.TTuple items _ _ -> ambiguous_dict_in_list(items, subst, quantified)
  | typed_ast.TBinary _ l r _ _ -> ambiguous_dict_in_list([l, r], subst, quantified)
  | typed_ast.TUnary _ operand _ _ -> first_ambiguous_dict_class(operand, subst, quantified)
  | typed_ast.TRange l r _ _ -> ambiguous_dict_in_list([l, r], subst, quantified)
  | typed_ast.TRecord _ fields _ _ -> ambiguous_dict_in_fields(fields, subst, quantified)
  | typed_ast.TRecordUpdate base fields _ _ ->
      match first_ambiguous_dict_class(base, subst, quantified) with
      | Just c -> Just(c)
      | Nothing -> ambiguous_dict_in_fields(fields, subst, quantified)
  | typed_ast.TGetField obj _ _ _ -> first_ambiguous_dict_class(obj, subst, quantified)
  # A TDict reached other than as a call argument has no call to read an instantiation off.
  | typed_ast.TDict _ _ _ _ -> Nothing
  # Leaves, listed rather than left to a wildcard: a new TypedExpr constructor should fail to
  # compile here instead of silently bypassing the guard, since what it guards against is silent.
  | typed_ast.TVar _ _ _ -> Nothing
  | typed_ast.TInt _ _ _ -> Nothing
  | typed_ast.TFloat _ _ _ -> Nothing
  | typed_ast.TBool _ _ _ -> Nothing
  | typed_ast.TString _ _ _ -> Nothing
  | typed_ast.TChar _ _ _ -> Nothing
  | typed_ast.TUnit _ _ -> Nothing

# The class of the first TDict among a call's arguments — where inference puts the witnesses it
# injects. Nothing means the call needs no dictionary.
fn dict_class_of_args(args: List typed_ast.TypedExpr) -> Maybe String =
  match args with
  | [] -> Nothing
  | [arg | rest] ->
      match arg with
      | typed_ast.TDict constraint _ _ _ ->
          match constraint with
          | ast.TypeConstraint class_name _ -> Just(class_name)
      | _ -> dict_class_of_args(rest)

fn call_mentions_quantified(args: List typed_ast.TypedExpr, ret: types.Type,
                            subst: Dict types.Type, quantified: List String) -> Bool =
  type_mentions_quantified(ret, subst, quantified) ||
    args_mention_quantified(args, subst, quantified)

fn args_mention_quantified(args: List typed_ast.TypedExpr, subst: Dict types.Type,
                           quantified: List String) -> Bool =
  match args with
  | [] -> false
  | [arg | rest] ->
      type_mentions_quantified(typed_ast.typed_expr_type(arg), subst, quantified) ||
        args_mention_quantified(rest, subst, quantified)

fn type_mentions_quantified(t: types.Type, subst: Dict types.Type, quantified: List String) -> Bool =
  any_var_quantified(types.ftv(unifier.apply_subst(subst, t)), quantified)

fn any_var_quantified(vars: List String, quantified: List String) -> Bool =
  match vars with
  | [] -> false
  | [v | rest] -> list_member(v, quantified) || any_var_quantified(rest, quantified)

fn ambiguous_dict_in_list(es: List typed_ast.TypedExpr, subst: Dict types.Type,
                          quantified: List String) -> Maybe String =
  match es with
  | [] -> Nothing
  | [e | rest] ->
      match first_ambiguous_dict_class(e, subst, quantified) with
      | Just c -> Just(c)
      | Nothing -> ambiguous_dict_in_list(rest, subst, quantified)

fn ambiguous_dict_in_arms(arms: List typed_ast.TypedMatchBranch, subst: Dict types.Type,
                          quantified: List String) -> Maybe String =
  match arms with
  | [] -> Nothing
  | [arm | rest] ->
      match arm with
      | typed_ast.TypedMatchBranch _ body ->
          match first_ambiguous_dict_class(body, subst, quantified) with
          | Just c -> Just(c)
          | Nothing -> ambiguous_dict_in_arms(rest, subst, quantified)

fn ambiguous_dict_in_fields(fields: List typed_ast.TypedRecordField, subst: Dict types.Type,
                            quantified: List String) -> Maybe String =
  match fields with
  | [] -> Nothing
  | [f | rest] ->
      match f with
      | typed_ast.TypedRecordField _ v ->
          match first_ambiguous_dict_class(v, subst, quantified) with
          | Just c -> Just(c)
          | Nothing -> ambiguous_dict_in_fields(rest, subst, quantified)

fn ambiguous_dict_in_steps(steps: List typed_ast.TypedDoStep, subst: Dict types.Type,
                           quantified: List String) -> Maybe String =
  match steps with
  | [] -> Nothing
  | [step | rest] ->
      match ambiguous_dict_in_step(step, subst, quantified) with
      | Just c -> Just(c)
      | Nothing -> ambiguous_dict_in_steps(rest, subst, quantified)

fn ambiguous_dict_in_step(step: typed_ast.TypedDoStep, subst: Dict types.Type,
                          quantified: List String) -> Maybe String =
  match step with
  | typed_ast.TDoBindStep _ e -> first_ambiguous_dict_class(e, subst, quantified)
  | typed_ast.TDoLetStep _ e -> first_ambiguous_dict_class(e, subst, quantified)
  | typed_ast.TDoExprStep e -> first_ambiguous_dict_class(e, subst, quantified)

# A top-level `let` that generalizes over a type variable its initializer needs a DICTIONARY for
# is ambiguous, and rejecting it is the only sound answer: the binding is one global slot holding
# one closure, so whatever instance was chosen at definition is the instance every use gets.
# Nothing later can fix it, unlike a `fn`, which takes its dictionary as a parameter.
#
# Without this, `let labeller = label` (for `label … where ToString a`) compiled to a closure
# carrying `ToString String` — the guess read off `label`'s own return type — and applying it to an
# Int read that Int as a string pointer. A SIGSEGV, silent up to the moment it ran.
#
# Haskell reaches the same place from the other side: §4.5.5's monomorphism restriction refuses to
# generalize a constrained binding's variables, then §4.3.4 defaulting picks a type. Sprout has no
# defaulting, so an undetermined variable has to be an error rather than a silent choice.
#
# Two things keep this from over-reaching, and both are pinned by tests. The variables tested are
# the binding's OWN quantified ones, so `let empty = list_map(label, [])` — type `List String`,
# quantifying nothing — keeps its never-invoked dictionary and stays inert. And the dictionary must
# actually depend on one of them (first_ambiguous_dict_class), so a determined dictionary inside a
# polymorphic binding, `let tag = \x -> (x, to_string(7))`, is left alone.
fn let_dict_ambiguity_msg(name: String, quantified: List String, t: types.Type,
                          subst: Dict types.Type, typed_expr: typed_ast.TypedExpr) -> Maybe String =
  let [_ | _] = quantified else Nothing
      Just class_name = first_ambiguous_dict_class(typed_expr, subst, quantified) else Nothing
  in Just("ambiguous typeclass binding: `" ++ name ++ "` needs a " ++ class_name
            ++ " instance, but its type " ++ types.type_to_string_renamed(quantified, t)
            ++ " leaves that choice open; a top-level binding holds a single value, so the instance"
            ++ " cannot be picked per use — add a type annotation that fixes it")

# The `fn` sibling of let_dict_ambiguity_msg: the same unsoundness at the other generalization
# site. A function generalizes a type variable, its body needs a class dictionary for that
# variable, and its own `where` clause declares no constraint that would supply one per call. The
# resolver has already guessed — one dictionary, read off whatever the body happened to mention,
# baked into a function whose emitted arity now carries a hidden dict slot its declared type does
# not mention.
#
# `fn relabel(x: a) = label(x)` compiled at exit 0 and then died: `relabel(5)` put the 5 in that
# slot and dereferenced it as a dictionary pointer.
#
# The variable must be one this declaration GENERALIZES. A free variable it does not — the element
# type of `vec_sort(vec_empty())`, whose dictionary is never invoked because the vector is empty —
# keeps its inert dead dictionary, since `main` generalizes nothing. Same exemption
# let_dict_ambiguity_msg makes, and three tests in the corpus depend on it.
#
# Coverage is subtracted by VARIABLE rather than by (class, variable) pair. That is sound only
# because verify_dispatch already rejects the residual a pairwise test would add: a covered
# variable whose body needs a DIFFERENT class (`fn f(x: a) -> Int where ToString a = ordinal(x)`)
# is reported there, at the declaration. A pairwise test here would additionally have to
# reimplement superclass closure to keep `where MyOrd a` forwarding a `MyEq a` obligation.
# tests/conformance/type_error/uncovered_dict_wrong_class.spr pins that division of labour so
# neither pass can quietly stop covering it.
# The generalized variables no `where` clause covers. Shared by the `fn` and instance-method
# gates, which agree on what is uncovered and differ only in the remedy they can offer.
fn uncovered_generalized_vars(constraints: List ast.TypeConstraint,
                              prog_to_fresh: Dict types.Type, s2: Dict types.Type,
                              inst_type: types.Type, env_ftv: List String) -> List String =
  types.list_diff(
    types.list_diff(types.ftv(unifier.apply_subst(s2, inst_type)), env_ftv),
    constraints_covered_ftv(constraints, prog_to_fresh, s2))

fn fn_dict_coverage_msg(name: String, params: List ast.Param,
                        constraints: List ast.TypeConstraint, prog_to_fresh: Dict types.Type,
                        s2: Dict types.Type, inst_type: types.Type, env_ftv: List String,
                        typed_body: typed_ast.TypedExpr,
                        env: Dict types.Scheme) -> Maybe String =
  let uncovered = uncovered_generalized_vars(constraints, prog_to_fresh, s2, inst_type, env_ftv)
      [_ | _] = uncovered else Nothing
  in
    match named_uncovered_dict(collect_param_type_vars(params, Nil), prog_to_fresh, s2,
                               uncovered, typed_body, env) with
    | Just (v, cls) ->
        Just("`" ++ name ++ "` needs a " ++ cls ++ " instance for type variable `" ++ v
               ++ "`, but declares no `where` constraint for it, so one instance was chosen at"
               ++ " definition instead of per call — add `where " ++ cls ++ " " ++ v
               ++ "` to its signature")
    | Nothing ->
        match uncovered_dict_subject(typed_body, s2, uncovered, env) with
        | Just cls ->
            Just("`" ++ name ++ "` needs a " ++ string.after_last_dot(cls) ++ " instance for a"
                   ++ " type variable it generalizes, and that variable appears in no parameter,"
                   ++ " so no call site can supply the instance — declare a return type naming the"
                   ++ " variable and constrain it with a `where` clause, or annotate with the"
                   ++ " concrete type you mean")
        | Nothing -> Nothing

# The instance-method twin of fn_dict_coverage_msg. The detection is identical — a variable the
# body needs a dictionary for, that the method generalizes and nothing covers — but the remedy
# is not: a method carries no `where` clause on either the class signature or the instance, so
# the only place a constraint can go is the instance head. The instance's own constraints are
# what `constraints` supplies here, which is why a parameterized head like
# `instance Renderer (Pair a) where ToString a` stays accepted.
fn instance_method_dict_coverage_msg(name: String, params: List ast.Param,
                                     constraints: List ast.TypeConstraint,
                                     prog_to_fresh: Dict types.Type, s2: Dict types.Type,
                                     inst_type: types.Type, env_ftv: List String,
                                     typed_body: typed_ast.TypedExpr,
                                     env: Dict types.Scheme) -> Maybe String =
  let uncovered = uncovered_generalized_vars(constraints, prog_to_fresh, s2, inst_type, env_ftv)
      [_ | _] = uncovered else Nothing
  in
    match named_uncovered_dict(collect_param_type_vars(params, Nil), prog_to_fresh, s2,
                               uncovered, typed_body, env) with
    | Just (v, cls) ->
        Just("`" ++ name ++ "` needs a " ++ cls ++ " instance for type variable `" ++ v
               ++ "`, which this method generalizes and the instance head does not constrain"
               ++ " — an instance method cannot carry its own `where` clause, so nothing can"
               ++ " supply the instance per call; constrain the variable in the instance head,"
               ++ " or give the method a concrete type")
    | Nothing ->
        match uncovered_dict_subject(typed_body, s2, uncovered, env) with
        | Just cls ->
            Just("`" ++ name ++ "` needs a " ++ string.after_last_dot(cls) ++ " instance for a"
                   ++ " type variable it generalizes, which appears in no parameter and which the"
                   ++ " instance head does not constrain — an instance method cannot carry its own"
                   ++ " `where` clause, so nothing can supply the instance per call; constrain the"
                   ++ " variable in the instance head, or give the method a concrete type")
        | Nothing -> Nothing

# The internal type variables the declared `where` clause already supplies a dictionary for.
fn constraints_covered_ftv(constraints: List ast.TypeConstraint, prog_to_fresh: Dict types.Type,
                           s2: Dict types.Type) -> List String =
  match constraints with
  | Nil -> Nil
  | Cons c rest ->
      list_append(constraint_covered_ftv(c, prog_to_fresh, s2),
                  constraints_covered_ftv(rest, prog_to_fresh, s2))

# Every source variable the constraint's head mentions, not just a bare-variable head: a compound
# head covers the variables inside it, so `where ToString (Box a)` covers `a`. That is coarser
# than the obligation it actually discharges — it does not supply `ToString a` — and coarse in the
# safe direction, matching the by-variable subtraction this whole check is built on.
fn constraint_covered_ftv(c: ast.TypeConstraint, prog_to_fresh: Dict types.Type,
                          s2: Dict types.Type) -> List String =
  match c with
  | ast.TypeConstraint _ args ->
      source_vars_ftv(collect_te_vars_list(args, Nil), prog_to_fresh, s2)

fn source_vars_ftv(vs: List String, prog_to_fresh: Dict types.Type,
                   s2: Dict types.Type) -> List String =
  match vs with
  | Nil -> Nil
  | Cons v rest ->
      list_append(source_var_ftv(v, prog_to_fresh, s2), source_vars_ftv(rest, prog_to_fresh, s2))

# The internal variables a source-level type-variable name stands for after inference.
fn source_var_ftv(v: String, prog_to_fresh: Dict types.Type, s2: Dict types.Type) -> List String =
  let Just t = dict_get(v, prog_to_fresh) else Nil
  in types.ftv(unifier.apply_subst(s2, t))

# The first parameter-mentioned source variable whose dictionary is uncovered, with the class that
# needs it. Reported separately from the unnamed case because a source name is what makes
# `where C a` printable advice; a variable inference introduced with no source name
# (`fn pick() = label`) has no name to offer and takes the other message.
fn named_uncovered_dict(param_vars: List String, prog_to_fresh: Dict types.Type,
                        s2: Dict types.Type, uncovered: List String,
                        body: typed_ast.TypedExpr,
                        env: Dict types.Scheme) -> Maybe (String, String) =
  match param_vars with
  | Nil -> Nothing
  | Cons v rest ->
      let ivs = list_common(source_var_ftv(v, prog_to_fresh, s2), uncovered)
      in
        match uncovered_dict_subject(body, s2, ivs, env) with
        | Just cls -> Just((v, string.after_last_dot(cls)))
        | Nothing -> named_uncovered_dict(rest, prog_to_fresh, s2, uncovered, body, env)

fn list_common(xs: List String, ys: List String) -> List String =
  match xs with
  | Nil -> Nil
  | Cons x rest ->
      if list_member(x, ys) then Cons(x, list_common(rest, ys)) else list_common(rest, ys)

# ---------------------------------------------------------------------------
# Per-variable dictionary attribution
# ---------------------------------------------------------------------------
#
# The class of the first call in `e` whose dictionary is being selected for one of `uncovered`.
#
# Distinct from first_ambiguous_dict_class, which asks whether a dictionary is ambiguous given
# everything a binding generalizes and attributes it to no particular variable. Here the variable
# IS the question, so the subject has to be derived rather than guessed at from the call's shape:
# `merge_runs`'s `where Ord k` over `List (k, Int, a)` mentions the payload `a`, and `fold`'s
# `where Foldable f` sits behind an `init: b` that is the first variable-typed argument. Both read
# as uncovered under any positional rule and neither is.
#
# The subject comes from the callee's own constraint instead: the §13.3(B) Scheme constraint field
# names the variable each constraint is on, and the callee reference carries that scheme already
# instantiated for this call, so matching the two recovers what the constraint was instantiated
# TO. Only class-constrained user functions are reachable this way; a class METHOD is
# verify_dispatch's jurisdiction and is already rejected there.
fn uncovered_dict_subject(e: typed_ast.TypedExpr, subst: Dict types.Type,
                          uncovered: List String, env: Dict types.Scheme) -> Maybe String =
  let [_ | _] = uncovered else Nothing
  in
    match e with
    | typed_ast.TCall callee args _ _ ->
        match call_uncovered_class(callee, subst, uncovered, env) with
        | Just cls -> Just(cls)
        | Nothing -> uncovered_dict_in_list(Cons(callee, args), subst, uncovered, env)
    | typed_ast.TLambda _ body _ _ -> uncovered_dict_subject(body, subst, uncovered, env)
    | typed_ast.TIf c th el _ _ -> uncovered_dict_in_list([c, th, el], subst, uncovered, env)
    | typed_ast.TMatch scrut arms _ _ ->
        match uncovered_dict_subject(scrut, subst, uncovered, env) with
        | Just cls -> Just(cls)
        | Nothing -> uncovered_dict_in_arms(arms, subst, uncovered, env)
    | typed_ast.TDo steps _ _ -> uncovered_dict_in_steps(steps, subst, uncovered, env)
    | typed_ast.TTuple items _ _ -> uncovered_dict_in_list(items, subst, uncovered, env)
    | typed_ast.TBinary _ l r _ _ -> uncovered_dict_in_list([l, r], subst, uncovered, env)
    | typed_ast.TUnary _ operand _ _ -> uncovered_dict_subject(operand, subst, uncovered, env)
    | typed_ast.TRange l r _ _ -> uncovered_dict_in_list([l, r], subst, uncovered, env)
    | typed_ast.TRecord _ fields _ _ -> uncovered_dict_in_fields(fields, subst, uncovered, env)
    | typed_ast.TRecordUpdate base fields _ _ ->
        match uncovered_dict_subject(base, subst, uncovered, env) with
        | Just cls -> Just(cls)
        | Nothing -> uncovered_dict_in_fields(fields, subst, uncovered, env)
    | typed_ast.TGetField obj _ _ _ -> uncovered_dict_subject(obj, subst, uncovered, env)
    # Leaves, listed rather than left to a wildcard: a new TypedExpr constructor should fail to
    # compile here instead of silently bypassing a guard against a silent miscompile.
    | typed_ast.TDict _ _ _ _ -> Nothing
    | typed_ast.TMethodRef _ _ _ _ _ -> Nothing
    | typed_ast.TVar _ _ _ -> Nothing
    | typed_ast.TInt _ _ _ -> Nothing
    | typed_ast.TFloat _ _ _ -> Nothing
    | typed_ast.TBool _ _ _ -> Nothing
    | typed_ast.TString _ _ _ -> Nothing
    | typed_ast.TChar _ _ _ -> Nothing
    | typed_ast.TUnit _ _ -> Nothing

# The class of the callee's first constraint whose subject falls in `uncovered`.
fn call_uncovered_class(callee: typed_ast.TypedExpr, subst: Dict types.Type,
                        uncovered: List String, env: Dict types.Scheme) -> Maybe String =
  let typed_ast.TVar name _ _ = callee else Nothing
      Just sch = dict_get(name, env) else Nothing
      theta = match_scheme_body(types.scheme_type(sch), types.scheme_vars(sch),
                                unifier.apply_subst(subst, typed_ast.typed_expr_type(callee)),
                                dict_empty())
  in constraint_subject_in(types.scheme_constraints(sch), name, env, theta, subst, uncovered)

fn constraint_subject_in(constraints: List (String, String), callee: String,
                         env: Dict types.Scheme, theta: Dict types.Type,
                         subst: Dict types.Type, uncovered: List String) -> Maybe String =
  match constraints with
  | Nil -> Nothing
  | Cons (token, cls) rest ->
      let Just subject = dict_get(decode_constraint_var(token, callee, env), theta)
            else constraint_subject_in(rest, callee, env, theta, subst, uncovered)
      in
        match list_common(types.ftv(unifier.apply_subst(subst, subject)), uncovered) with
        | [] -> constraint_subject_in(rest, callee, env, theta, subst, uncovered)
        | [_ | _] -> Just(cls)

# Bind a scheme's own type variables to what this occurrence instantiated them to. Only names the
# scheme quantifies are bound; a structural mismatch simply stops descending, leaving the affected
# variable unbound, which reads downstream as "not attributable" rather than as a false subject.
fn match_scheme_body(pattern: types.Type, vars: List String, actual: types.Type,
                     theta: Dict types.Type) -> Dict types.Type =
  match pattern with
  | types.TVar name ->
      if list_member(types.tyvar_identity(name), vars)
      then dict_set(types.tyvar_identity(name), actual, theta)
      else theta
  | types.TConst _ -> theta
  | types.TApp pb pa ->
      match actual with
      | types.TApp ab aa -> match_scheme_body(pb, vars, ab, match_scheme_body(pa, vars, aa, theta))
      | _ -> theta
  | types.TFunc pp pr _ _ ->
      match actual with
      | types.TFunc ap ar _ _ -> match_scheme_body(pp, vars, ap, match_scheme_body(pr, vars, ar, theta))
      | _ -> theta
  | types.TTuple pitems ->
      match actual with
      | types.TTuple aitems -> match_scheme_body_list(pitems, vars, aitems, theta)
      | _ -> theta

fn match_scheme_body_list(ps: List types.Type, vars: List String, as_: List types.Type,
                          theta: Dict types.Type) -> Dict types.Type =
  match ps with
  | Nil -> theta
  | Cons p prest ->
      match as_ with
      | Nil -> theta
      | Cons a arest -> match_scheme_body_list(prest, vars, arest, match_scheme_body(p, vars, a, theta))

fn uncovered_dict_in_list(es: List typed_ast.TypedExpr, subst: Dict types.Type,
                          uncovered: List String, env: Dict types.Scheme) -> Maybe String =
  match es with
  | Nil -> Nothing
  | Cons e rest ->
      match uncovered_dict_subject(e, subst, uncovered, env) with
      | Just cls -> Just(cls)
      | Nothing -> uncovered_dict_in_list(rest, subst, uncovered, env)

fn uncovered_dict_in_arms(arms: List typed_ast.TypedMatchBranch, subst: Dict types.Type,
                          uncovered: List String, env: Dict types.Scheme) -> Maybe String =
  match arms with
  | Nil -> Nothing
  | Cons arm rest ->
      match arm with
      | typed_ast.TypedMatchBranch _ body ->
          match uncovered_dict_subject(body, subst, uncovered, env) with
          | Just cls -> Just(cls)
          | Nothing -> uncovered_dict_in_arms(rest, subst, uncovered, env)

fn uncovered_dict_in_fields(fields: List typed_ast.TypedRecordField, subst: Dict types.Type,
                            uncovered: List String, env: Dict types.Scheme) -> Maybe String =
  match fields with
  | Nil -> Nothing
  | Cons f rest ->
      match f with
      | typed_ast.TypedRecordField _ v ->
          match uncovered_dict_subject(v, subst, uncovered, env) with
          | Just cls -> Just(cls)
          | Nothing -> uncovered_dict_in_fields(rest, subst, uncovered, env)

fn uncovered_dict_in_steps(steps: List typed_ast.TypedDoStep, subst: Dict types.Type,
                           uncovered: List String, env: Dict types.Scheme) -> Maybe String =
  match steps with
  | Nil -> Nothing
  | Cons step rest ->
      match uncovered_dict_in_step(step, subst, uncovered, env) with
      | Just cls -> Just(cls)
      | Nothing -> uncovered_dict_in_steps(rest, subst, uncovered, env)

fn uncovered_dict_in_step(step: typed_ast.TypedDoStep, subst: Dict types.Type,
                          uncovered: List String, env: Dict types.Scheme) -> Maybe String =
  match step with
  | typed_ast.TDoBindStep _ e -> uncovered_dict_subject(e, subst, uncovered, env)
  | typed_ast.TDoLetStep _ e -> uncovered_dict_subject(e, subst, uncovered, env)
  | typed_ast.TDoExprStep e -> uncovered_dict_subject(e, subst, uncovered, env)

# The M4.2 linear gate + value-restriction generalization for a top-level `let`,
# extracted so the LetDecl arm body is a plain call (keeps its match chain shallow).
fn finish_let_decl(name: String, expr: ast.Expr, typed_expr: typed_ast.TypedExpr,
                   s1: Dict types.Type, let_pos: source.SourcePos, env: GlobalEnv,
                   env_ftv: List String, eff_subst: Dict types.Effect) -> TypedDeclResult =
  match letdecl_linear_gate(s1, typed_expr, env) with
  | linear_check.LinFail lp lm -> TypedDeclErr(lp, lm)
  | linear_check.LinPass ->
      # Sibling of the FnDecl escape check: a skolem is a TConst, so it has no
      # free type variables and the value restriction's ftv test below reads it
      # as "fully resolved, nothing to generalize" and binds it monomorphically.
      # `let leaked = match Boxed("hi") with | Boxed x -> x` was accepted as
      # `main.leaked : $sk<n>` on exactly that route.
      if types.type_mentions_skolem(unifier.apply_subst(s1, typed_ast.typed_expr_type(typed_expr)))
      then TypedDeclErr(let_pos, skolem_escape_let_msg(name))
      else
      # Value restriction (W3/F-VALRESTR): a syntactic value generalizes; a
      # non-value (function call, if/match/do, ...) does not. A non-value whose
      # type still has free type variables is ambiguous — neither generalizable
      # (unsound: `mutvec_new(1, Nil)` written at Int and read at String) nor
      # pinnable to one type — so it is rejected, as SML rejects ungeneralizable
      # top-level type variables.
      if is_syntactic_value(expr) then
        let resolved = unifier.apply_subst(s1, typed_ast.typed_expr_type(typed_expr))
        in match let_dict_ambiguity_msg(name, types.list_diff(types.ftv(resolved), env_ftv),
                                        resolved, s1, typed_expr) with
           | Just msg -> TypedDeclErr(let_pos, msg)
           | Nothing ->
               TypedDeclOk(
                 typed_ast.TLetDecl(name, typed_expr),
                 GlobalEnv(dict_set(name,
                   unifier.generalize(env_ftv, s1, eff_subst,
                     typed_ast.typed_expr_type(typed_expr), types.EffectPure),
                   global_env_dict(env))),
                 env_ftv, s1)
      else
        match types.list_diff(types.ftv(unifier.apply_subst(s1, typed_ast.typed_expr_type(typed_expr))), env_ftv) with
        | [_ | _] ->
            TypedDeclErr(let_pos, "value restriction: non-value binding '" ++ name ++ "' has an ambiguous polymorphic type " ++ types.type_to_string(unifier.apply_subst(s1, typed_ast.typed_expr_type(typed_expr))) ++ "; bind a value or add a concrete type annotation")
        | Nil ->
            TypedDeclOk(
              typed_ast.TLetDecl(name, typed_expr),
              GlobalEnv(dict_set(name,
                types.mono(unifier.apply_subst(s1, typed_ast.typed_expr_type(typed_expr))),
                global_env_dict(env))),
              env_ftv, s1)

fn check_fn_body(
  state: unifier.InferState,
  decl: ast.Decl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  alias_env: Dict types.Type,
  env_ftv: List String
) -> (typed_ast.BodyResult, Dict types.Scheme, List (String, String), Dict types.Type) !{IO} =
  match decl with
  | ast.FnDecl name params ret_type_maybe effects_maybe constraints body fn_pos ->
      do
        let decl_scheme = scheme_from_fn_parts(name, params, ret_type_maybe, effects_maybe, alias_env)
        (inst_type, prog_to_fresh) <- unifier.instantiate_with_vars(state, decl_scheme)
        let fwd_env = seed_forward_markers(constraints, prog_to_fresh, env)
        # Compute @eta_fwd:* markers in parallel without walking fwd_env post-hoc.
        # Constraint-free decls return dict_empty() instantly.
        let fwd_markers = compute_eta_fwd_markers(constraints, prog_to_fresh, env)
        # §13.3(B) S4: the recursion self-binding carries the constraint field
        # (fn_body_env), so recursive self-calls inject dicts from the Scheme —
        # no @constrained_N self markers to seed. fwd_env holds only @fwd/@eta_fwd.
        let body_env = fn_body_env(name, params, inst_type,
          self_binding_scheme(name, params, ret_type_maybe, decl_scheme, inst_type, constraint_source_tokens(constraints)),
          fwd_env)
        InferOk typed_body0 s1 es1 body_eff <- typecheck_fn_body(state, body_env, subst, eff_subst, body, ret_type_maybe, fn_return_type(inst_type, list_length(params))) else InferErr pos msg -> (fn_body_err(name, pos, msg), dict_empty(), Nil, subst)
        let unifier.UnifyOk s2a es2a = unifier.unify_types(s1, es1, typed_ast.typed_expr_type(typed_body0), fn_return_type(inst_type, list_length(params))) else unifier.UnifyErr e -> (return_mismatch_body_err(name, typed_body0, fn_return_type(inst_type, list_length(params)), s1, "Return type mismatch in " ++ name ++ ": " ++ e), dict_empty(), Nil, subst)
        # The declaration boundary: the one place that holds both the declared
        # effect and the effect the body was inferred to perform. Recorded for
        # every declaration whether or not they agree; `checker.typecheck_typed`
        # turns a disagreement into an error as a post-pass over the whole list,
        # and `--phase effects` prints the same list without rejecting anything.
        #
        # Recorded AFTER the return-type unify, and resolved with THAT unify's
        # effect substitution (es2a, not es1), for two reasons. A return type can
        # bind an effect variable the body's own inference left open — a body
        # returning a closure meets the declared arrow here and nowhere earlier —
        # so resolving with es1 leaves a class of effects reported as raw
        # variables. And a declaration with both a type error and an effect gap
        # should report the type error: this arm exits before recording.
        _ <- unifier.record_effect_report(state,
               unifier.EffectReport(name, types.scheme_effects(decl_scheme),
                 unifier.apply_effect_subst(es2a, body_eff), fn_pos, decl_scheme))
        # AFTER the return-type unify: the declared return type may be the only
        # thing that determines a deferred field access's receiver.
        FinishOk typed_body s2 <- finish_field_obligations(state, body_env, s2a, typed_body0) else FinishErr fpos fmsg -> (fn_body_err(name, fpos, fmsg), dict_empty(), Nil, subst)
        match rigidity_violation(prog_to_fresh, s2, types.scheme_vars(decl_scheme)) with
        | Just bad ->
            (typed_ast.BodyErr(fn_pos, "Signature too general for its body in " ++ name ++ ": type variable " ++ bad), dict_empty(), Nil, subst)
        | Nothing ->
          # A generalized type variable whose dictionary nothing supplies per call. Checked
          # before the linear gate only because it reports a signature defect, and a signature
          # the caller must change first makes any later complaint about the body premature.
          # body_env, not env: a parameter or self-binding that shadows a global constrained
          # function resolves here to its own constraint-free scheme, so the walk attributes
          # nothing to it. `fn pass_through(f: a -> String, x: a) = f(x)` calls a parameter.
          match fn_dict_coverage_msg(name, params, constraints, prog_to_fresh, s2, inst_type,
                                     env_ftv, typed_body, body_env) with
          | Just msg -> (typed_ast.BodyErr(fn_pos, msg), dict_empty(), Nil, subst)
          | Nothing ->
            # M4.2: enforce consume-exactly-once for linear-typed bindings, on the
            # fully-substituted body/type. A violation becomes a BodyErr, surfacing
            # through the same path as any type error. Gated so a linear-free
            # program skips the check and its substitution copy. See linear_check.
            match fn_linear_gate(params, s2, inst_type, typed_body, fn_pos, env) with
            | linear_check.LinFail lp lm -> (typed_ast.BodyErr(lp, lm), dict_empty(), Nil, subst)
            | linear_check.LinPass ->
                (typed_ast.BodyOk(resolve_dispatch_typed_expr(fwd_env, s2, bind_params(params, set_empty()), typed_body), unifier.apply_subst(s2, inst_type)),
                 fwd_markers, canonicalize_constrained_constraints(constraints, prog_to_fresh, s2, inst_type, env_ftv),
                 s2)
  | _ -> (typed_ast.BodyOk(dummy_unit(), types.TConst(types.type_id("Unit"))), dict_empty(), Nil, subst)

# --- Positional constraint-var identity helpers (canonical-identity Stage 3) ---
#
# Position of x's first occurrence in xs, or -1 if absent.
fn list_index_of(x: String, xs: List String) -> Int =
  list_index_of_acc(x, xs, 0)
fn list_index_of_acc(x: String, xs: List String, i: Int) -> Int =
  match xs with
  | Nil -> -1
  | Cons y rest -> if y == x then i else list_index_of_acc(x, rest, i + 1)

# The n-th element of xs, or dflt when out of range.
fn list_nth_or(xs: List String, n: Int, dflt: String) -> String =
  match xs with
  | Nil -> dflt
  | Cons y rest -> if n <= 0 then y else list_nth_or(rest, n - 1, dflt)

# Encode a constraint var as its POSITION in the fn's generalized scheme binder
# list ("#pos:<k>") when present, else fall back to the canonical name (a
# monomorphic / env-captured var that isn't generalized). Position is invariant
# under the generalize/instantiate renaming that defeats name-keying, so the
# call-site resolver decodes it back to the live binder name — the precise lookup
# then cannot miss. Decoded by decode_constraint_var at the call site.
fn constraint_var_token(canon_name: String, binders: List String) -> String =
  constraint_var_token_at(canon_name, list_index_of(canon_name, binders))
fn constraint_var_token_at(canon_name: String, pos: Int) -> String =
  if pos < 0 then canon_name else "#pos:" ++ int_to_string(pos)

# After body inference, computes the COMPLETE (head_token, class) constraint list
# folded into the generalized callee Scheme as the single source of truth for its
# hidden dicts (§13.3(B)) — one entry per constraint, in where-clause order,
# including concrete-ctor and headless constraints (which take hidden dicts too),
# not only generalized tyvars.
#
# A generalized tyvar's head_token records its POSITION in the generalized binder
# list (list_diff(ftv(apply_subst(s2, inst_type)), env_ftv) — the exact expression
# typecheck_decl's generalize uses, so the position indexes scheme_vars(<callee
# scheme>) at the call site). Position survives the renaming that source names do
# not, so resolve_obligation's precise Just branch always hits. A constraint whose
# var was pinned to a concrete type in the body is monomorphic (not a TVar after
# s2) and recorded by source name. head_token is
# "#pos:<k>" for a generalized var (decoded via scheme_vars), "<Name>" for a
# concrete-ctor head or non-generalized var, or "#none" for a headless constraint.
fn canonicalize_constrained_constraints(
  constraints: List ast.TypeConstraint,
  prog_to_fresh: Dict types.Type,
  s2: Dict types.Type,
  inst_type: types.Type,
  env_ftv: List String
) -> List (String, String) =
  canonicalize_constrained_constraints_acc(constraints, prog_to_fresh, s2,
    types.list_diff(types.ftv(unifier.apply_subst(s2, inst_type)), env_ftv))

# The list is built on the RETURN path (recurse-then-cons) so it stays in
# where-clause order, and every constraint contributes exactly one entry.
fn canonicalize_constrained_constraints_acc(
  constraints: List ast.TypeConstraint,
  prog_to_fresh: Dict types.Type,
  s2: Dict types.Type,
  binders: List String
) -> List (String, String) =
  match constraints with
  | Nil -> Nil
  | Cons c rest ->
      match c with
      | ast.TypeConstraint class_name type_args ->
          match type_args with
          | [ast.TypeName prog_var | _] ->
              match dict_get(prog_var, prog_to_fresh) with
              | Just fresh_t ->
                  match unifier.apply_subst(s2, fresh_t) with
                  | types.TVar canon ->
                      Cons((constraint_var_token(types.tyvar_identity(canon), binders), class_name),
                           canonicalize_constrained_constraints_acc(rest, prog_to_fresh, s2, binders))
                  | _ ->
                      # Pinned to a concrete type (rigidity-rejected for a top-level
                      # constrained fn — defensive): record by source name.
                      Cons((prog_var, class_name),
                           canonicalize_constrained_constraints_acc(rest, prog_to_fresh, s2, binders))
              | Nothing ->
                  # Concrete-ctor head (e.g. "List"): stable source name.
                  Cons((prog_var, class_name),
                       canonicalize_constrained_constraints_acc(rest, prog_to_fresh, s2, binders))
          | [ast.TypeApply base _ | _] ->
              # Compound head (`where Sh (Box a)`). There is no head VARIABLE, but
              # there is a head CONSTRUCTOR, and it is the only thing that says
              # which argument carries the dictionary. Collapsing it into "#none"
              # left the injection site scanning arguments left to right and
              # committing to the first concrete one, so the same constraint
              # picked a different instance depending on parameter order.
              Cons((compound_head_token(base), class_name),
                   canonicalize_constrained_constraints_acc(rest, prog_to_fresh, s2, binders))
          | _ ->
              # Headless constraint (non-TypeName head): resolved without a head var.
              Cons(("#none", class_name),
                   canonicalize_constrained_constraints_acc(rest, prog_to_fresh, s2, binders))

# §13.3(B) S4: the self-binding carries the fn's own constraints (source-name
# tokens) so a recursive self-call injects its forwarded dicts from the Scheme
# field, via the same resolve_field_constraint → @fwd path a generalized external
# call uses — retiring the body-local @constrained_N self markers.
fn fn_body_env(name: String, params: List ast.Param, inst_type: types.Type, self_scheme: types.Scheme, env: Dict types.Scheme) -> Dict types.Scheme =
  extend_env_with_params(
    params,
    ctor_param_types(inst_type),
    dict_set(name, self_scheme, env)
  )

# What a declaration's own name means INSIDE its own body — the single decision
# that separates monomorphic from polymorphic recursion.
#
# A COMPLETE signature (every parameter annotated AND the return annotated) binds
# the declared, quantified scheme, so each self-call instantiates fresh and the
# function may call itself at an INSTANCE of its declared type. That is
# polymorphic recursion, and it is the only way to type a non-uniform datatype:
#
#   type Nest a = | NestNil | NestCons a (Nest (a, a))
#   fn nest_size(n: Nest a) -> Int = ...  nest_size(rest)   # rest : Nest (a, a)
#
# Anything less than a complete signature keeps the monomorphic binding, and the
# boundary is not caution — it is forced. An omitted slot is a `_unann@`
# placeholder: ONE variable shared by every use of the declaration, deliberately
# left out of the binder list so that pinning it is a commitment rather than a
# per-call guess. Quantifying a scheme that still contains one would hand each
# use its own copy again and re-open the forward-reference soundness hole the
# placeholder exists to close. `own_unann_vars` returning Nil is exactly the
# "no placeholders left" test, and it is the same predicate the generalization
# boundary already uses.
#
# Why a signature is REQUIRED rather than merely sufficient: inference for
# polymorphic recursion is equivalent to semi-unification, which is undecidable
# (Henglein, TOPLAS 15(2) 253-289, 1993; Kfoury-Tiuryn-Urzyczyn, ibid. 290-311).
# Every language that permits it demands the annotation for this reason —
# Haskell 2010 §4.4.1, and OCaml via the explicitly quantified `let rec f : 'a. …`.
# Standard ML declines instead: the Definition's rule 26 Comment requires that
# "each use of a recursive function in its own body must be assigned the same
# type", which is precisely the branch below.
# The declaration must also be CONSTRAINT-FREE, and that second condition is a
# real limit on the feature rather than caution about the implementation.
#
# A `#pos:<k>` constraint token means "this constraint's variable is generalized
# at type_vars position k". Under the monomorphic binding type_vars is Nil, so
# `#pos:k` decodes to nothing and the self-call falls through to the enclosing
# @fwd markers — i.e. it FORWARDS the caller's dictionaries, which is exactly
# right for a same-type recursive call. Bind the declared scheme and type_vars
# becomes the declared list, so `#pos:0` now decodes — to a freshly instantiated
# variable, which resolves against the wrong instance and returns a wrong ANSWER
# rather than an error. Regression that caught it:
# tests/stdlib/compiler/test_typeclass_recursive_forwarding.spr, "recursive call
# forwards distinct Eq a and Eq b dictionaries".
#
# Lifting this needs more than a different binding. A self-call at `Nest (a, a)`
# under `where Eq a` requires `Eq (a, a)` — a dictionary that does not exist at
# the call site and cannot be built without resolving the instantiated constraint
# against the instance environment (what GHC does, and what it reports as "Could
# not deduce" when it fails). That is a constraint-solver feature; it is tracked
# in BACKLOG.md rather than approximated here.
fn self_binding_scheme(
  name: String,
  params: List ast.Param,
  ret_type_maybe: Maybe ast.TypeExpr,
  decl_scheme: types.Scheme,
  inst_type: types.Type,
  constraints: List (String, String)
) -> types.Scheme =
  match constraints with
  | [_ | _] -> types.scheme_with_constraints(types.mono(inst_type), constraints)
  | Nil ->
      match own_unann_vars(name, params, ret_type_maybe) with
      | Nil -> decl_scheme
      | [_ | _] -> types.mono(inst_type)

fn fn_body_err(name: String, pos: source.SourcePos, msg: String) -> typed_ast.BodyResult =
  # Previously: if `is_unknown_ref(msg)` returned BodyLenient, which caused
  # `typecheck_decl` to silently substitute a `dummy_unit()` body and continue.
  # That masked real bugs (e.g. unresolved class-method references like
  # `__unresolved_Semigroup_a`) and produced misleading downstream errors.
  # All Unknown-variable / Unknown-constructor errors are now hard errors.
  if str_starts_with(name, "stdlib.compiler.")
  then typed_ast.BodyErr(pos, "[DIAG] " ++ msg ++ " in function " ++ name)
  else typed_ast.BodyErr(pos, msg ++ " in function " ++ name)

fn is_unknown_ref(msg: String) -> Bool =
  str_starts_with(msg, "Unknown variable: ") ||
  str_starts_with(msg, "Unknown constructor: ")

# ---------------------------------------------------------------------------
# ClassDecl: method registration + constraint markers
# ---------------------------------------------------------------------------

fn register_class_methods(type_params: List String, methods: List ast.ClassMethodSig, env: Dict types.Scheme) -> Dict types.Scheme =
  match methods with
  | Nil -> env
  | Cons sig rest ->
      register_class_methods(type_params, rest, register_class_method(type_params, sig, env))

fn register_class_method(type_params: List String, sig: ast.ClassMethodSig, env: Dict types.Scheme) -> Dict types.Scheme =
  match sig with
  | ast.ClassMethodSig name params ret_type effects_maybe ->
      # Extend the class type params with any additional lowercase type variables
      # appearing in the method signature (e.g. `a` and `b` in
      # `fmap(f: a -> b, xs: f a) -> f b`).  Without this, method-specific
      # vars become TConst instead of TVar, corrupting the inferred substitution
      # at call sites and producing spurious "No instance of X for Y" errors.
      dict_set(name, scheme_from_fn_parts_inner(
        collect_ret_type_vars(Just(ret_type), collect_param_type_vars(params, type_params)),
        name, params, Just(ret_type), effects_maybe, dict_empty()), env)

fn register_class_method_markers(class_name: String, type_params: List String, methods: List ast.ClassMethodSig, env: Dict types.Scheme) -> Dict types.Scheme =
  match methods with
  | Nil -> env
  | Cons sig rest ->
      match sig with
      | ast.ClassMethodSig name _ _ _ ->
          register_class_method_markers(class_name, type_params, rest,
            dict_set("@class:" ++ name,
                     types.Scheme(type_params, Nil, types.TConst(types.type_id(class_name)), types.EffectPure, Nil),
                     env))

# Register "@super:{class_name}:{super_name}" entries for each superclass in the
# ClassDecl's where-clause.  These are later consumed by seed_superclass_fwd_markers
# to propagate @fwd markers to superclass methods at call sites.
fn register_superclass_markers(class_name: String, superclasses: List ast.TypeConstraint, env: Dict types.Scheme) -> Dict types.Scheme =
  match superclasses with
  | Nil -> env
  | Cons sc rest ->
      match sc with
      | ast.TypeConstraint super_name _ ->
          register_superclass_markers(class_name, rest,
            dict_set("@super:" ++ class_name ++ ":" ++ super_name,
                     types.mono(types.TConst(types.type_id(super_name))), env))

# ---------------------------------------------------------------------------
# FnDecl: constrained-function markers
# ---------------------------------------------------------------------------
#
# §13.3(B) S4: the non-positional constraint tokens for a fn's PROVISIONAL
# scheme — the pre-scan forward-ref entry and the recursion self-binding. Both
# are ungeneralized (no scheme_vars), so a "#pos:k" token could not decode; the
# head is instead the raw source var name, which decode_constraint_var passes
# through unchanged and resolve_field_constraint routes to the @fwd forwarding
# path — exactly as the retired @constrained_N marker did. A concrete-ctor head
# keeps its name (resolves via @inst directly); a compound head keeps its head
# constructor ("#app:<Name>") so a self-recursive call directs its argument scan
# the same way an external call does; any other head is headless ("#none").
fn constraint_source_tokens(constraints: List ast.TypeConstraint) -> List (String, String) =
  match constraints with
  | Nil -> Nil
  | Cons c rest ->
      match c with
      | ast.TypeConstraint class_name type_args ->
          match type_args with
          | [ast.TypeName prog_var | _] -> Cons((prog_var, class_name), constraint_source_tokens(rest))
          | [ast.TypeApply base _ | _] ->
              Cons((compound_head_token(base), class_name), constraint_source_tokens(rest))
          | _ -> Cons(("#none", class_name), constraint_source_tokens(rest))

# §13.3(B): pre-scan registration of a FnDecl's signature. A constrained fn's
# scheme carries its constraint field directly (source-name tokens) — the single
# source of truth a forward-ref caller reads — so there are no parallel
# @constrained_N env markers to seed.
fn register_fn_decl_scheme(
  name: String,
  params: List ast.Param,
  ret_type_maybe: Maybe ast.TypeExpr,
  effects_maybe: Maybe (List String),
  constraints: List ast.TypeConstraint,
  alias_env: Dict types.Type,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  match constraints with
  | Nil ->
      dict_remove("@class:" ++ name,
        dict_set(name, scheme_from_fn_parts(name, params, ret_type_maybe, effects_maybe, alias_env), env))
  | _ ->
      dict_remove("@class:" ++ name,
        dict_set(name, types.scheme_with_constraints(scheme_from_fn_parts(name, params, ret_type_maybe, effects_maybe, alias_env), constraint_source_tokens(constraints)), env))

# ---------------------------------------------------------------------------
# InstanceDecl: instance marker registration
# ---------------------------------------------------------------------------

fn register_instance_marker(constraint: ast.TypeConstraint, env: Dict types.Scheme) -> Dict types.Scheme =
  match constraint with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> env
      | [head_te | _] ->
          dict_set(
            "@inst:" ++ class_name ++ ":" ++ type_head_str(type_from_ast(head_te, dict_empty())),
            types.mono(types.TConst(types.type_id("Unit"))),
            env
          )

# ---------------------------------------------------------------------------
# InstanceDecl: instance method body checking
# ---------------------------------------------------------------------------

fn check_instance_methods(
  state: unifier.InferState,
  inst_constraints: List ast.TypeConstraint,
  methods: List ast.InstanceMethodImpl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  env_ftv: List String
) -> typed_ast.InstanceMethodsResult !{IO} =
  check_instance_methods_acc(state, inst_constraints, methods, env, subst, eff_subst, env_ftv, Nil)

fn check_instance_methods_acc(
  state: unifier.InferState,
  inst_constraints: List ast.TypeConstraint,
  methods: List ast.InstanceMethodImpl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  env_ftv: List String,
  acc: List typed_ast.TypedInstanceMethod
) -> typed_ast.InstanceMethodsResult !{IO} =
  match methods with
  | Nil -> typed_ast.InstanceMethodsOk(typed_method_list_reverse(acc))
  | Cons method rest ->
      do
        r <- check_instance_method(state, inst_constraints, method, env, subst, eff_subst, env_ftv)
        match r with
        | InstanceMethodErr pos e -> typed_ast.InstanceMethodsErr(pos, e)
        | InstanceMethodOk typed_method ->
            check_instance_methods_acc(state, inst_constraints, rest, env, subst, eff_subst, env_ftv, Cons(typed_method, acc))

fn check_instance_method(
  state: unifier.InferState,
  inst_constraints: List ast.TypeConstraint,
  method: ast.InstanceMethodImpl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  env_ftv: List String
) -> InstanceMethodResult !{IO} =
  match method with
  | ast.InstanceMethodImpl name params ret_maybe eff_maybe body ->
      do
        # Let-bound rather than inlined into instantiate_with_vars: rule 9 asks
        # about the DECLARATION, so the report needs the pre-instantiation scheme
        # (source names `e`, `d`) and not `inst_type`'s freshened `$e0`.
        # "#inst/" keeps an instance method's placeholder out of the top-level
        # namespace: two instances of one class implement the same method NAME,
        # and the substitution threaded across top-level declarations must never
        # be able to reach either of them. Nothing merges an instance method's
        # substitution into that thread, so within one method the name is unique.
        let decl_scheme = scheme_from_fn_parts("#inst/" ++ name, params, ret_maybe, eff_maybe, dict_empty())
        (inst_type, prog_to_fresh) <- unifier.instantiate_with_vars(state, decl_scheme)
        let fwd_env = seed_forward_markers(inst_constraints, prog_to_fresh, env)
        let body_env = extend_env_with_params(params, ctor_param_types(inst_type), fwd_env)
        br <- typecheck_expr(state, body_env, subst, eff_subst, body)
        match br with
        | InferErr pos msg -> instance_method_err(name, pos, msg)
        | InferOk typed_body0 s1 es1 body_eff ->
            # The instance-method twin of the record in check_fn_body. Both sites
            # discard a body effect, and instrumenting only the `fn` one would
            # leave every `instance` method out of the census — silently, and in
            # the direction that reads as good news, which is the failure mode
            # this phase exists to catch. Enforcement inherits the same hazard:
            # a flip applied at one boundary and not the other passes every `fn`
            # test while quietly exempting every instance method in the program.
            # Regression: tests/conformance/type_error/
            # effect_pure_instance_method_does_io.spr.
            #
            # The record happens inside instance_method_checked, after the
            # return-type unify — same ordering and same reasons as check_fn_body.
            instance_method_checked(state, name, params, ret_maybe, eff_maybe,
              body_env, s1, es1, inst_type, typed_body0, body_eff, env, decl_scheme,
              inst_constraints, prog_to_fresh, env_ftv)

# Two instances of one class define the same method name, so the bare name would
# collapse them into a single census entry. The instance HEAD is not in scope here
# — check_instance_method receives only the constraints — but the method's first
# parameter is the head for every instance method that takes one, and inst_type is
# already built. A nullary method (e.g. Applicative.pure) falls back to the bare
# name, which is a report label, not an identity the compiler relies on.
fn instance_report_name(name: String, inst_type: types.Type) -> String =
  match inst_type with
  | types.TFunc param _ _ _ -> "instance " ++ name ++ "(" ++ types.type_to_string(param) ++ ")"
  | _ -> "instance " ++ name

fn instance_method_checked(
  state: unifier.InferState,
  name: String,
  params: List ast.Param,
  ret_maybe: Maybe ast.TypeExpr,
  eff_maybe: Maybe (List String),
  body_env: Dict types.Scheme,
  s1: Dict types.Type,
  es1: Dict types.Effect,
  inst_type: types.Type,
  typed_body0: typed_ast.TypedExpr,
  body_eff: types.Effect,
  env: Dict types.Scheme,
  decl_scheme: types.Scheme,
  inst_constraints: List ast.TypeConstraint,
  prog_to_fresh: Dict types.Type,
  env_ftv: List String
) -> InstanceMethodResult !{IO} =
  match unifier.unify_types(s1, es1, typed_ast.typed_expr_type(typed_body0), fn_return_type(inst_type, list_length(params))) with
  | unifier.UnifyErr e -> InstanceMethodErr(typed_ast.typed_expr_pos(typed_body0), "Return type mismatch in instance method " ++ name ++ ": " ++ e)
  | unifier.UnifyOk s2a es2a ->
      # AFTER the return-type unify — see finish_field_obligations.
      do
        _ <- unifier.record_effect_report(state,
               unifier.EffectReport(instance_report_name(name, inst_type),
                 effect_from_maybe_labels(eff_maybe),
                 unifier.apply_effect_subst(es2a, body_eff),
                 typed_ast.typed_expr_pos(typed_body0),
                 decl_scheme))
        f <- finish_field_obligations(state, body_env, s2a, typed_body0)
        match f with
        | FinishErr fpos fmsg -> InstanceMethodErr(fpos, fmsg ++ " in instance method " ++ name)
        | FinishOk typed_body s2 ->
            finish_instance_method(name, params, ret_maybe, eff_maybe, body_env, s2, inst_type,
              typed_body, env, inst_constraints, prog_to_fresh, env_ftv)

fn instance_method_err(name: String, pos: source.SourcePos, msg: String) -> InstanceMethodResult =
  # Previously: lenient short-circuit that returned a `dummy_unit()`-bodied
  # method on Unknown-variable / Unknown-constructor errors. Now hard error,
  # matching the change to `fn_body_err`.
  InstanceMethodErr(pos, msg ++ " in instance method " ++ name)

# M4.2 gate + result construction for an instance method, extracted so the arm
# body is a plain call (keeps the enclosing match chain shallow).
fn finish_instance_method(name: String, params: List ast.Param, ret_maybe: Maybe ast.TypeExpr,
                          eff_maybe: Maybe (List String), body_env: Dict types.Scheme,
                          s2: Dict types.Type, inst_type: types.Type,
                          typed_body: typed_ast.TypedExpr, env: Dict types.Scheme,
                          inst_constraints: List ast.TypeConstraint,
                          prog_to_fresh: Dict types.Type,
                          env_ftv: List String) -> InstanceMethodResult =
  match class_method_mode_error(name, params, env) with
  | Just bad ->
      InstanceMethodErr(typed_ast.typed_expr_pos(typed_body), bad)
  | Nothing ->
      # body_env, not env: a parameter shadowing a global constrained function resolves to its
      # own constraint-free scheme, so the walk attributes nothing to it.
      match instance_method_dict_coverage_msg(name, params, inst_constraints, prog_to_fresh, s2,
                                              inst_type, env_ftv, typed_body, body_env) with
      | Just msg -> InstanceMethodErr(typed_ast.typed_expr_pos(typed_body), msg)
      | Nothing ->
          finish_instance_method_checked(name, params, ret_maybe, eff_maybe, body_env, s2, inst_type, typed_body, env)

# M4.6: an instance method's ownership modifiers must agree with the class
# declaration's, because a call dispatches through the CLASS signature — the
# instance's own modifiers are invisible there. Gated on the `@class:` marker so
# a plain top-level function that happens to share the name is never the
# comparison target; only `register_class_method` binds a class method under its
# bare name, so the scheme fetched here is the class's.
fn class_method_mode_error(name: String, params: List ast.Param,
                           env: Dict types.Scheme) -> Maybe String =
  match dict_get("@class:" ++ name, env) with
  | Nothing -> Nothing
  | Just _ -> class_method_mode_error_at(name, params, env)

fn class_method_mode_error_at(name: String, params: List ast.Param,
                              env: Dict types.Scheme) -> Maybe String =
  match dict_get(name, env) with
  | Nothing -> Nothing
  | Just scheme ->
      match scheme with
      | types.Scheme _ _ body _ _ -> linear_check.method_mode_mismatch(params, body)

fn finish_instance_method_checked(name: String, params: List ast.Param, ret_maybe: Maybe ast.TypeExpr,
                                  eff_maybe: Maybe (List String), body_env: Dict types.Scheme,
                                  s2: Dict types.Type, inst_type: types.Type,
                                  typed_body: typed_ast.TypedExpr, env: Dict types.Scheme) -> InstanceMethodResult =
  match fn_linear_gate(params, s2, inst_type, typed_body, typed_ast.typed_expr_pos(typed_body), env) with
  | linear_check.LinFail lp lm -> InstanceMethodErr(lp, lm)
  | linear_check.LinPass ->
      InstanceMethodOk(
        typed_ast.TypedInstanceMethod(name, params, ret_maybe, eff_maybe, resolve_dispatch_typed_expr(body_env, s2, bind_params(params, set_empty()), typed_body)))
