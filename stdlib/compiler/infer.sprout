module stdlib.compiler.infer
import stdlib.compiler.ast as ast
import stdlib.compiler.types as types
import stdlib.compiler.unifier as unifier

# ---------------------------------------------------------------------------
# Inference result
# ---------------------------------------------------------------------------
#
# infer_expr returns:
#   type       — the inferred type
#   subst      — the extended substitution
#   eff_subst  — the extended effect substitution
#   effect     — the effect of evaluating this expression
#
# We use a custom ADT rather than Result to avoid do-notation classifier
# confusion when mixing IO and Result monad in the same do block.

export type InferResult (..) =
  | InferOk types.Type (Dict types.Type) (Dict types.Effect) types.Effect
  | InferErr String

# ---------------------------------------------------------------------------
# Type-expression → Type
# ---------------------------------------------------------------------------
#
# Converts a parsed AST TypeExpr into a runtime types.Type.
# local_vars maps named type parameters in scope to their TVar.
#
# AST constructors (from ast.sprout):
#   TypeName String
#   TypeApply TypeExpr TypeExpr
#   TypeArrow TypeExpr TypeExpr (Maybe (List String))   -- param -> ret !{eff}
#   TypeEffect TypeExpr (List String)                   -- type !{eff}
#   TupleType (List TypeExpr)

export fn type_from_ast(te: ast.TypeExpr, local_vars: Dict types.Type) -> types.Type =
  match te with
  | ast.TypeName name -> lookup_type_var(name, local_vars)
  | ast.TypeApply base arg ->
      types.TApp(type_from_ast(base, local_vars), type_from_ast(arg, local_vars))
  | ast.TypeArrow param ret _ ->
      types.TFunc(type_from_ast(param, local_vars), type_from_ast(ret, local_vars), types.EffectPure)
  | ast.TypeEffect inner _ -> type_from_ast(inner, local_vars)
  | ast.TupleType parts -> types.TTuple(type_list_from_ast(parts, local_vars))

fn lookup_type_var(name: String, local_vars: Dict types.Type) -> types.Type =
  match dict_get(name, local_vars) with
  | Just t -> t
  | Nothing -> types.TConst(name)

fn type_list_from_ast(parts: List ast.TypeExpr, local_vars: Dict types.Type) -> List types.Type =
  match parts with
  | Nil -> Nil
  | Cons h t -> Cons(type_from_ast(h, local_vars), type_list_from_ast(t, local_vars))

export fn effect_from_maybe_labels(labels: Maybe (List String)) -> types.Effect =
  match labels with
  | Nothing -> types.EffectPure
  | Just ls ->
      match ls with
      | Nil -> types.EffectPure
      | Cons label rest ->
          match rest with
          | Nil ->
              if label == "IO" then types.EffectIO
              else types.EffectVar(label)
          | _ -> types.EffectRow(ls)

# ---------------------------------------------------------------------------
# Build a Scheme from a FnDecl
# ---------------------------------------------------------------------------
#
# FnDecl String (List Param) (Maybe TypeExpr) (Maybe (List String)) (List TypeConstraint) Expr SourcePos
#         name   params       ret_type          effects               constraints            body  pos

export fn scheme_from_fn_decl(decl: ast.Decl) -> types.Scheme =
  match decl with
  | ast.FnDecl _ params ret_type_maybe effects_maybe _ _ _ ->
      scheme_from_fn_parts(params, ret_type_maybe, effects_maybe)
  | _ -> types.mono(types.TConst("Unit"))

fn scheme_from_fn_parts(
  params: List ast.Param,
  ret_type_maybe: Maybe ast.TypeExpr,
  effects_maybe: Maybe (List String)
) -> types.Scheme =
  scheme_from_fn_parts_inner(
    collect_ret_type_vars(ret_type_maybe, collect_param_type_vars(params, Nil)),
    params,
    ret_type_maybe,
    effects_maybe
  )

fn collect_param_type_vars(params: List ast.Param, acc: List String) -> List String =
  match params with
  | Nil -> acc
  | Cons p rest ->
      collect_param_type_vars(rest, collect_type_expr_vars(ast_param_type(p), acc))

fn ast_param_type(p: ast.Param) -> Maybe ast.TypeExpr =
  match p with
  | ast.Param _ maybe_type -> maybe_type

fn collect_type_expr_vars(maybe_te: Maybe ast.TypeExpr, acc: List String) -> List String =
  match maybe_te with
  | Nothing -> acc
  | Just te -> collect_te_vars(te, acc)

fn collect_te_vars(te: ast.TypeExpr, acc: List String) -> List String =
  match te with
  | ast.TypeName name ->
      if is_lowercase_name(name) then list_add_unique(name, acc) else acc
  | ast.TypeApply base arg ->
      collect_te_vars(base, collect_te_vars(arg, acc))
  | ast.TypeArrow param ret _ ->
      collect_te_vars(param, collect_te_vars(ret, acc))
  | ast.TypeEffect inner _ -> collect_te_vars(inner, acc)
  | ast.TupleType parts -> collect_te_vars_list(parts, acc)

fn collect_te_vars_list(parts: List ast.TypeExpr, acc: List String) -> List String =
  match parts with
  | Nil -> acc
  | Cons h t -> collect_te_vars_list(t, collect_te_vars(h, acc))

fn is_lowercase_name(name: String) -> Bool =
  c == "a" || c == "b" || c == "c" || c == "d" || c == "e" ||
  c == "f" || c == "g" || c == "h" || c == "i" || c == "j" ||
  c == "k" || c == "l" || c == "m" || c == "n" || c == "o" ||
  c == "p" || c == "q" || c == "r" || c == "s" || c == "t" ||
  c == "u" || c == "v" || c == "w" || c == "x" || c == "y" || c == "z"
  where c = str_slice(name, 0, 1)

fn list_add_unique(x: String, xs: List String) -> List String =
  if types.list_member(x, xs) then xs else Cons(x, xs)

fn collect_ret_type_vars(ret_type_maybe: Maybe ast.TypeExpr, acc: List String) -> List String =
  match ret_type_maybe with
  | Nothing -> acc
  | Just te -> collect_te_vars(te, acc)

fn build_type_var_dict(vars: List String, acc: Dict types.Type) -> Dict types.Type =
  match vars with
  | Nil -> acc
  | Cons name rest -> build_type_var_dict(rest, dict_set(name, types.TVar(name), acc))

fn scheme_from_fn_parts_inner(
  type_params: List String,
  params: List ast.Param,
  ret_type_maybe: Maybe ast.TypeExpr,
  effects_maybe: Maybe (List String)
) -> types.Scheme =
  types.Scheme(
    type_params,
    Nil,
    build_fn_type(param_types_from_decl(params, local_vars), ret_from_maybe_with_vars(ret_type_maybe, local_vars)),
    effect_from_maybe_labels(effects_maybe)
  )
  where local_vars = build_type_var_dict(type_params, dict_empty())

fn param_types_from_decl(params: List ast.Param, local_vars: Dict types.Type) -> List types.Type =
  match params with
  | Nil -> Nil
  | Cons p rest ->
      match ast_param_type(p) with
      | Nothing -> Cons(types.TVar("_unann"), param_types_from_decl(rest, local_vars))
      | Just te -> Cons(type_from_ast(te, local_vars), param_types_from_decl(rest, local_vars))

fn ret_from_maybe_with_vars(maybe_te: Maybe ast.TypeExpr, local_vars: Dict types.Type) -> types.Type =
  match maybe_te with
  | Nothing -> types.TConst("Unit")
  | Just te -> type_from_ast(te, local_vars)

fn build_fn_type(params: List types.Type, ret: types.Type) -> types.Type =
  match params with
  | Nil -> ret
  | Cons p rest -> types.TFunc(p, build_fn_type(rest, ret), types.EffectPure)

# ---------------------------------------------------------------------------
# Constructor registration from TypeDecl / TypeConstructor
# ---------------------------------------------------------------------------
#
# TypeDecl String (List String) (List TypeConstructor) SourcePos
# TypeConstructor String (List TypeExpr)   -- name, field types

export fn register_type_decl(decl: ast.Decl, env: Dict types.Scheme) -> Dict types.Scheme =
  match decl with
  | ast.TypeDecl name params ctors _ ->
      register_ctors_for_type(name, params, build_local_params(params, dict_empty()), ctors, env)
  | _ -> env

fn build_local_params(params: List String, acc: Dict types.Type) -> Dict types.Type =
  match params with
  | Nil -> acc
  | Cons p rest -> build_local_params(rest, dict_set(p, types.TVar(p), acc))

fn build_result_type(name: String, params: List String) -> types.Type =
  apply_type_params(types.TConst(name), params)

fn apply_type_params(base: types.Type, params: List String) -> types.Type =
  match params with
  | Nil -> base
  | Cons p rest -> apply_type_params(types.TApp(base, types.TVar(p)), rest)

fn register_ctors_for_type(
  type_name: String,
  type_params: List String,
  local_vars: Dict types.Type,
  ctors: List ast.TypeConstructor,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  match ctors with
  | Nil -> env
  | Cons ctor rest ->
      register_ctors_for_type(
        type_name, type_params, local_vars, rest,
        register_one_ctor(ctor, type_params, local_vars, build_result_type(type_name, type_params), env)
      )

fn register_one_ctor(
  ctor: ast.TypeConstructor,
  type_params: List String,
  local_vars: Dict types.Type,
  result_type: types.Type,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  match ctor with
  | ast.TypeConstructor name fields ->
      dict_set(
        name,
        types.Scheme(type_params, Nil, ctor_fn_type(fields, local_vars, result_type), types.EffectPure),
        env
      )

fn ctor_fn_type(fields: List ast.TypeExpr, local_vars: Dict types.Type, result: types.Type) -> types.Type =
  match fields with
  | Nil -> result
  | Cons f rest ->
      types.TFunc(type_from_ast(f, local_vars), ctor_fn_type(rest, local_vars, result), types.EffectPure)

# ---------------------------------------------------------------------------
# Effect merging
# ---------------------------------------------------------------------------

fn merge_effects(a: types.Effect, b: types.Effect) -> types.Effect =
  match (a, b) with
  | (types.EffectIO, _) -> types.EffectIO
  | (_, types.EffectIO) -> types.EffectIO
  | (types.EffectPure, other) -> other
  | (other, types.EffectPure) -> other
  | _ -> a

# ---------------------------------------------------------------------------
# Expression inference
# ---------------------------------------------------------------------------

export fn infer_expr(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expr: ast.Expr
) -> InferResult !{IO} =
  match expr with
  | ast.IntExpr _ _ -> InferOk(types.type_int(), subst, eff_subst, types.EffectPure)
  | ast.BoolExpr _ _ -> InferOk(types.type_bool(), subst, eff_subst, types.EffectPure)
  | ast.StringExpr _ _ -> InferOk(types.type_string(), subst, eff_subst, types.EffectPure)
  | ast.CharExpr _ _ -> InferOk(types.type_char(), subst, eff_subst, types.EffectPure)
  | ast.UnitExpr _ -> InferOk(types.TConst("Unit"), subst, eff_subst, types.EffectPure)
  | ast.VarExpr name _ -> infer_var(state, env, subst, eff_subst, name)
  | ast.IfExpr cond then_ else_ _ -> infer_if(state, env, subst, eff_subst, cond, then_, else_)
  | ast.CallExpr callee args _ ->
      infer_call(state, env, subst, eff_subst, callee, args)
  | ast.MatchExpr scrut branches _ -> infer_match(state, env, subst, eff_subst, scrut, branches)
  | ast.TupleExpr elems _ -> infer_tuple(state, env, subst, eff_subst, elems)
  | ast.BinaryExpr op left right _ -> infer_binary(state, env, subst, eff_subst, op, left, right)
  | ast.DoExpr steps _ -> infer_do(state, env, subst, eff_subst, steps)
  | ast.LambdaExpr params body _ -> infer_lambda(state, env, subst, eff_subst, params, body)
  | ast.RecordExpr type_name fields _ ->
      infer_record_expr(state, env, subst, eff_subst, type_name, fields)
  | ast.GetFieldExpr rec_expr field_name _ ->
      infer_get_field(state, env, subst, eff_subst, rec_expr, field_name)
  | _ ->
      do
        v <- unifier.fresh(state)
        InferOk(types.TVar(v), subst, eff_subst, types.EffectPure)

# --- Variable ---

fn infer_var(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  name: String
) -> InferResult !{IO} =
  match dict_get(name, env) with
  | Nothing -> InferErr("Unknown variable: " ++ name)
  | Just scheme ->
      do
        t <- unifier.instantiate(state, scheme)
        InferOk(t, subst, eff_subst, types.EffectPure)

# --- If ---

fn infer_if(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  cond: ast.Expr,
  then_: ast.Expr,
  else_: ast.Expr
) -> InferResult !{IO} =
  do
    cr <- infer_expr(state, env, subst, eff_subst, cond)
    match cr with
    | InferErr e -> InferErr(e)
    | InferOk cond_type s1 es1 cond_eff ->
        infer_if_checked(state, env, s1, es1, cond_type, cond_eff, then_, else_)

fn infer_if_checked(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  cond_type: types.Type,
  cond_eff: types.Effect,
  then_: ast.Expr,
  else_: ast.Expr
) -> InferResult !{IO} =
  match unifier.unify_types(subst, cond_type, types.type_bool()) with
  | Err e -> InferErr("If condition must be Bool: " ++ e)
  | Ok s2 ->
      do
        tr <- infer_expr(state, env, s2, eff_subst, then_)
        match tr with
        | InferErr e -> InferErr(e)
        | InferOk then_type s3 es3 then_eff ->
            do
              er <- infer_expr(state, env, s3, es3, else_)
              match er with
              | InferErr e -> InferErr(e)
              | InferOk else_type s4 es4 else_eff ->
                  infer_if_merge(s4, es4, then_type, else_type, cond_eff, then_eff, else_eff)

fn infer_if_merge(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  then_type: types.Type,
  else_type: types.Type,
  cond_eff: types.Effect,
  then_eff: types.Effect,
  else_eff: types.Effect
) -> InferResult !{IO} =
  match unifier.unify_types(subst, then_type, else_type) with
  | Err e -> InferErr("If branches must have same type: " ++ e)
  | Ok s5 ->
      InferOk(
        unifier.apply_subst(s5, then_type),
        s5, eff_subst,
        merge_effects(cond_eff, merge_effects(then_eff, else_eff))
      )

# --- Call ---

fn infer_call(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  callee: ast.Expr,
  args: List ast.Expr
) -> InferResult !{IO} =
  do
    cr <- infer_expr(state, env, subst, eff_subst, callee)
    match cr with
    | InferErr e -> InferErr(e)
    | InferOk callee_type s1 es1 callee_eff ->
        do
          ar <- infer_args_acc(state, env, s1, es1, args, Nil, types.EffectPure)
          match ar with
          | InferErr e -> InferErr(e)
          | InferOk arg_types s2 es2 args_eff ->
              do
                v <- unifier.fresh(state)
                r <- infer_call_resolve(s2, es2, callee_type, arg_types, types.TVar(v), merge_effects(callee_eff, args_eff))
                match r with
                | InferErr e -> InferErr(e)
                | InferOk ret_t s3 es3 call_eff ->
                    check_call_constraint(callee, arg_types, s3, env, ret_t, s3, es3, call_eff)

fn infer_call_resolve(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  callee_type: types.Type,
  arg_types: types.Type,
  ret_type: types.Type,
  eff: types.Effect
) -> InferResult !{IO} =
  match unifier.unify_types(subst, callee_type, build_fn_type(extract_ttuple(arg_types), ret_type)) with
  | Err e -> InferErr("Call type mismatch: " ++ e)
  | Ok s3 -> InferOk(unifier.apply_subst(s3, ret_type), s3, eff_subst, eff)

# --- Constraint checking ---
#
# Class methods are registered in the env under "@class:{method_name}" →
# mono(TConst(class_name)).  Instance head types are registered under
# "@inst:{class_name}:{head_type_str}" → mono(TConst("Unit")).
# Both are stored in the ordinary env, avoiding a separate ClassEnv parameter.
#
# At call sites: if the callee is a named class method AND the first argument
# type is concrete (not a TVar), we verify that a matching instance exists.
# Polymorphic call sites (TVar first argument) are not checked — constraint
# resolution for those is deferred to dictionary-passing lowering.

fn check_call_constraint(
  callee: ast.Expr,
  arg_types: types.Type,
  subst: Dict types.Type,
  env: Dict types.Scheme,
  ret_t: types.Type,
  s3: Dict types.Type,
  es3: Dict types.Effect,
  call_eff: types.Effect
) -> InferResult !{IO} =
  match callee with
  | ast.VarExpr method_name _ ->
      match dict_get("@class:" ++ method_name, env) with
      | Nothing -> InferOk(ret_t, s3, es3, call_eff)
      | Just class_marker ->
          check_instance_for_marker(class_marker, arg_types, subst, env, ret_t, s3, es3, call_eff)
  | _ -> InferOk(ret_t, s3, es3, call_eff)

fn check_instance_for_marker(
  class_marker: types.Scheme,
  arg_types: types.Type,
  subst: Dict types.Type,
  env: Dict types.Scheme,
  ret_t: types.Type,
  s3: Dict types.Type,
  es3: Dict types.Effect,
  call_eff: types.Effect
) -> InferResult !{IO} =
  match class_marker with
  | types.Scheme _ _ class_type _ ->
      match class_type with
      | types.TConst class_name ->
          match first_concrete_arg_str(arg_types, subst) with
          | Nothing -> InferOk(ret_t, s3, es3, call_eff)
          | Just head_str ->
              match dict_get("@inst:" ++ class_name ++ ":" ++ head_str, env) with
              | Nothing -> InferErr("No instance of " ++ class_name ++ " for " ++ head_str)
              | Just _ -> InferOk(ret_t, s3, es3, call_eff)
      | _ -> InferOk(ret_t, s3, es3, call_eff)

fn first_concrete_arg_str(arg_types: types.Type, subst: Dict types.Type) -> Maybe String =
  match arg_types with
  | types.TTuple items ->
      match items with
      | Nil -> Nothing
      | Cons first_t _ ->
          concrete_type_str(unifier.apply_subst(subst, first_t))
  | _ -> concrete_type_str(unifier.apply_subst(subst, arg_types))

fn type_head_str(t: types.Type) -> String =
  match t with
  | types.TConst name -> name
  | types.TApp base _ -> type_head_str(base)
  | types.TVar name -> name
  | _ -> types.type_to_string(t)

fn concrete_type_str(t: types.Type) -> Maybe String =
  match t with
  | types.TVar _ -> Nothing
  | _ -> Just(type_head_str(t))

fn extract_ttuple(ts: types.Type) -> List types.Type =
  match ts with
  | types.TTuple items -> items
  | _ -> Cons(ts, Nil)

fn infer_args_acc(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  args: List ast.Expr,
  acc: List types.Type,
  acc_eff: types.Effect
) -> InferResult !{IO} =
  match args with
  | Nil -> InferOk(types.TTuple(list_reverse(acc)), subst, eff_subst, acc_eff)
  | Cons arg rest ->
      do
        r <- infer_expr(state, env, subst, eff_subst, arg)
        match r with
        | InferErr e -> InferErr(e)
        | InferOk t s1 es1 arg_eff ->
            infer_args_acc(state, env, s1, es1, rest, Cons(t, acc), merge_effects(acc_eff, arg_eff))

fn list_reverse(xs: List types.Type) -> List types.Type =
  list_rev_acc(xs, Nil)

fn list_rev_acc(xs: List types.Type, acc: List types.Type) -> List types.Type =
  match xs with
  | Nil -> acc
  | Cons h t -> list_rev_acc(t, Cons(h, acc))

# --- Tuple ---

fn infer_tuple(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  elems: List ast.Expr
) -> InferResult !{IO} =
  do
    r <- infer_args_acc(state, env, subst, eff_subst, elems, Nil, types.EffectPure)
    match r with
    | InferErr e -> InferErr(e)
    | InferOk ts s1 es1 eff ->
        match ts with
        | types.TTuple items -> InferOk(types.TTuple(items), s1, es1, eff)
        | _ -> InferOk(ts, s1, es1, eff)

# --- Binary ---

fn infer_binary(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  left: ast.Expr,
  right: ast.Expr
) -> InferResult !{IO} =
  do
    lr <- infer_expr(state, env, subst, eff_subst, left)
    match lr with
    | InferErr e -> InferErr(e)
    | InferOk lt s1 es1 l_eff ->
        do
          rr <- infer_expr(state, env, s1, es1, right)
          match rr with
          | InferErr e -> InferErr(e)
          | InferOk rt s2 es2 r_eff ->
              infer_binary_op(s2, es2, op, lt, rt, merge_effects(l_eff, r_eff))

fn infer_binary_op(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  lt: types.Type,
  rt: types.Type,
  eff: types.Effect
) -> InferResult !{IO} =
  if op == "+" || op == "-" || op == "*" || op == "/" then
    check_arith(subst, eff_subst, op, lt, rt, eff)
  else if op == "<" || op == "<=" || op == ">" || op == ">=" then
    check_compare(subst, eff_subst, op, lt, rt, eff)
  else if op == "==" || op == "!=" then
    check_eq(subst, eff_subst, op, lt, rt, eff)
  else if op == "&&" || op == "||" then
    check_bool(subst, eff_subst, op, lt, rt, eff)
  else
    InferOk(lt, subst, eff_subst, eff)

fn check_arith(subst: Dict types.Type, eff_subst: Dict types.Effect, op: String, lt: types.Type, rt: types.Type, eff: types.Effect) -> InferResult !{IO} =
  match unifier.unify_types(subst, lt, types.type_int()) with
  | Err e -> InferErr(op ++ " needs Int: " ++ e)
  | Ok s1 ->
      match unifier.unify_types(s1, rt, types.type_int()) with
      | Err e -> InferErr(op ++ " needs Int: " ++ e)
      | Ok s2 -> InferOk(types.type_int(), s2, eff_subst, eff)

fn check_compare(subst: Dict types.Type, eff_subst: Dict types.Effect, op: String, lt: types.Type, rt: types.Type, eff: types.Effect) -> InferResult !{IO} =
  match unifier.unify_types(subst, lt, types.type_int()) with
  | Err e -> InferErr(op ++ " needs Int: " ++ e)
  | Ok s1 ->
      match unifier.unify_types(s1, rt, types.type_int()) with
      | Err e -> InferErr(op ++ " needs Int: " ++ e)
      | Ok s2 -> InferOk(types.type_bool(), s2, eff_subst, eff)

fn check_eq(subst: Dict types.Type, eff_subst: Dict types.Effect, op: String, lt: types.Type, rt: types.Type, eff: types.Effect) -> InferResult !{IO} =
  match unifier.unify_types(subst, lt, rt) with
  | Err e -> InferErr(op ++ " needs same types: " ++ e)
  | Ok s1 -> InferOk(types.type_bool(), s1, eff_subst, eff)

fn check_bool(subst: Dict types.Type, eff_subst: Dict types.Effect, op: String, lt: types.Type, rt: types.Type, eff: types.Effect) -> InferResult !{IO} =
  match unifier.unify_types(subst, lt, types.type_bool()) with
  | Err e -> InferErr(op ++ " needs Bool: " ++ e)
  | Ok s1 ->
      match unifier.unify_types(s1, rt, types.type_bool()) with
      | Err e -> InferErr(op ++ " needs Bool: " ++ e)
      | Ok s2 -> InferOk(types.type_bool(), s2, eff_subst, eff)

# --- Match ---

fn infer_match(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  scrutinee: ast.Expr,
  branches: List ast.MatchBranch
) -> InferResult !{IO} =
  do
    sr <- infer_expr(state, env, subst, eff_subst, scrutinee)
    match sr with
    | InferErr e -> InferErr(e)
    | InferOk scrut_type s1 es1 scrut_eff ->
        do
          v <- unifier.fresh(state)
          infer_branches(state, env, s1, es1, scrut_type, types.TVar(v), branches, scrut_eff)

fn infer_branches(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  scrut_type: types.Type,
  ret_type: types.Type,
  branches: List ast.MatchBranch,
  acc_eff: types.Effect
) -> InferResult !{IO} =
  match branches with
  | Nil -> InferOk(unifier.apply_subst(subst, ret_type), subst, eff_subst, acc_eff)
  | Cons branch rest ->
      do
        br <- infer_branch(state, env, subst, eff_subst, scrut_type, ret_type, branch)
        match br with
        | InferErr e -> InferErr(e)
        | InferOk new_ret s1 es1 branch_eff ->
            infer_branches(state, env, s1, es1, scrut_type, new_ret, rest, merge_effects(acc_eff, branch_eff))

fn infer_branch(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  scrut_type: types.Type,
  ret_type: types.Type,
  branch: ast.MatchBranch
) -> InferResult !{IO} =
  match branch with
  | ast.MatchBranch pat body ->
      do
        pr <- infer_pattern(state, env, subst, eff_subst, scrut_type, pat)
        match pr with
        | InferErr e -> InferErr(e)
        | InferOk _ s1 es1 _ ->
            infer_branch_body(state, extend_env_from_pattern(pat, s1, env), s1, es1, ret_type, body)

fn infer_branch_body(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  ret_type: types.Type,
  body: ast.Expr
) -> InferResult !{IO} =
  do
    br <- infer_expr(state, env, subst, eff_subst, body)
    match br with
    | InferErr e -> InferErr(e)
    | InferOk body_type s2 es2 body_eff ->
        infer_branch_unify(s2, es2, body_type, ret_type, body_eff)

fn infer_branch_unify(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  body_type: types.Type,
  ret_type: types.Type,
  body_eff: types.Effect
) -> InferResult !{IO} =
  match unifier.unify_types(subst, body_type, ret_type) with
  | Err e -> InferErr("Match branch type mismatch: " ++ e)
  | Ok s3 -> InferOk(unifier.apply_subst(s3, ret_type), s3, eff_subst, body_eff)

# --- Pattern inference ---
#
# DoStep constructors (from ast.sprout):
#   DoBindStep Pattern Expr
#   DoLetStep String Expr
#   DoExprStep Expr
#
# Pattern constructors:
#   WildcardPattern SourcePos
#   VarPattern String SourcePos
#   IntPattern Int SourcePos
#   BoolPattern Bool SourcePos
#   StringPattern String SourcePos
#   CharPattern Char SourcePos
#   UnitPattern SourcePos
#   TuplePattern (List Pattern) SourcePos
#   ConstructorPattern String (List Pattern) SourcePos

export fn infer_pattern(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  pat: ast.Pattern
) -> InferResult !{IO} =
  match pat with
  | ast.WildcardPattern _ -> InferOk(expected, subst, eff_subst, types.EffectPure)
  | ast.VarPattern _ _ -> InferOk(expected, subst, eff_subst, types.EffectPure)
  | ast.IntPattern _ _ ->
      check_pattern_type(subst, eff_subst, expected, types.type_int(), "Int")
  | ast.BoolPattern _ _ ->
      check_pattern_type(subst, eff_subst, expected, types.type_bool(), "Bool")
  | ast.StringPattern _ _ ->
      check_pattern_type(subst, eff_subst, expected, types.type_string(), "String")
  | ast.CharPattern _ _ ->
      check_pattern_type(subst, eff_subst, expected, types.type_char(), "Char")
  | ast.UnitPattern _ ->
      check_pattern_type(subst, eff_subst, expected, types.TConst("Unit"), "Unit")
  | ast.TuplePattern pats _ ->
      infer_tuple_pattern(state, env, subst, eff_subst, expected, pats)
  | ast.ConstructorPattern name fields _ ->
      infer_ctor_pattern(state, env, subst, eff_subst, expected, name, fields)

fn check_pattern_type(subst: Dict types.Type, eff_subst: Dict types.Effect, expected: types.Type, expected_type: types.Type, label: String) -> InferResult !{IO} =
  match unifier.unify_types(subst, expected, expected_type) with
  | Err e -> InferErr(label ++ " pattern: " ++ e)
  | Ok s1 -> InferOk(expected_type, s1, eff_subst, types.EffectPure)

fn infer_tuple_pattern(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  pats: List ast.Pattern
) -> InferResult !{IO} =
  do
    elem_vars <- make_fresh_var_list(state, pats)
    infer_tuple_pattern_unified(state, env, subst, eff_subst, expected, elem_vars, pats)

fn infer_tuple_pattern_unified(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  elem_vars: List types.Type,
  pats: List ast.Pattern
) -> InferResult !{IO} =
  match unifier.unify_types(subst, expected, types.TTuple(elem_vars)) with
  | Err e -> InferErr("Tuple pattern: " ++ e)
  | Ok s1 ->
      check_pattern_list(state, env, s1, eff_subst, elem_vars, pats)

fn make_fresh_var_list(state: unifier.InferState, pats: List ast.Pattern) -> List types.Type !{IO} =
  match pats with
  | Nil -> Nil
  | Cons _ rest ->
      do
        v <- unifier.fresh(state)
        rest_vars <- make_fresh_var_list(state, rest)
        Cons(types.TVar(v), rest_vars)

fn check_pattern_list(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected_list: List types.Type,
  pats: List ast.Pattern
) -> InferResult !{IO} =
  match (expected_list, pats) with
  | (Nil, Nil) -> InferOk(types.TConst("Unit"), subst, eff_subst, types.EffectPure)
  | (Cons exp_h exp_rest, Cons pat_h pat_rest) ->
      do
        r <- infer_pattern(state, env, subst, eff_subst, exp_h, pat_h)
        match r with
        | InferErr e -> InferErr(e)
        | InferOk _ s1 es1 _ ->
            check_pattern_list(state, env, s1, es1, exp_rest, pat_rest)
  | _ -> InferErr("Tuple pattern arity mismatch")

fn infer_ctor_pattern(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  name: String,
  fields: List ast.Pattern
) -> InferResult !{IO} =
  match dict_get(name, env) with
  | Nothing -> InferErr("Unknown constructor: " ++ name)
  | Just scheme ->
      do
        ctor_type <- unifier.instantiate(state, scheme)
        infer_ctor_pattern_typed(state, env, subst, eff_subst, expected, name, fields, ctor_type)

fn infer_ctor_pattern_typed(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  name: String,
  fields: List ast.Pattern,
  ctor_type: types.Type
) -> InferResult !{IO} =
  match unifier.unify_types(subst, expected, ctor_result_type(ctor_type)) with
  | Err e -> InferErr("Constructor " ++ name ++ ": " ++ e)
  | Ok s1 ->
      check_pattern_list(state, env, s1, eff_subst, ctor_param_types(ctor_type), fields)

fn ctor_result_type(t: types.Type) -> types.Type =
  match t with
  | types.TFunc _ ret _ -> ctor_result_type(ret)
  | _ -> t

fn ctor_param_types(t: types.Type) -> List types.Type =
  match t with
  | types.TFunc p rest _ -> Cons(p, ctor_param_types(rest))
  | _ -> Nil

# ---------------------------------------------------------------------------
# Extend environment from a pattern's bound variables
# ---------------------------------------------------------------------------

export fn extend_env_from_pattern(pat: ast.Pattern, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match pat with
  | ast.VarPattern name _ ->
      dict_set(name, types.mono(unifier.apply_subst(subst, types.TVar(name))), env)
  | ast.TuplePattern pats _ -> extend_env_from_pattern_list(pats, subst, env)
  | ast.ConstructorPattern _ fields _ -> extend_env_from_pattern_list(fields, subst, env)
  | _ -> env

fn extend_env_from_pattern_list(pats: List ast.Pattern, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match pats with
  | Nil -> env
  | Cons h t -> extend_env_from_pattern_list(t, subst, extend_env_from_pattern(h, subst, env))

# ---------------------------------------------------------------------------
# Do expression
# ---------------------------------------------------------------------------
#
# DoStep constructors: DoBindStep Pattern Expr | DoLetStep String Expr | DoExprStep Expr

fn infer_do(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  steps: List ast.DoStep
) -> InferResult !{IO} =
  infer_do_steps(state, env, subst, eff_subst, steps, types.TConst("Unit"), types.EffectPure)

fn infer_do_steps(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  steps: List ast.DoStep,
  last_type: types.Type,
  acc_eff: types.Effect
) -> InferResult !{IO} =
  match steps with
  | Nil -> InferOk(last_type, subst, eff_subst, acc_eff)
  | Cons step rest ->
      do
        sr <- infer_do_step(state, env, subst, eff_subst, step)
        match sr with
        | InferErr e -> InferErr(e)
        | InferOk step_type s1 es1 step_eff ->
            infer_do_steps(
              state,
              extend_env_from_do_step(step, step_type, s1, env),
              s1, es1, rest, step_type,
              merge_effects(acc_eff, step_eff)
            )

fn infer_do_step(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  step: ast.DoStep
) -> InferResult !{IO} =
  match step with
  | ast.DoExprStep e -> infer_expr(state, env, subst, eff_subst, e)
  | ast.DoBindStep _ e -> infer_expr(state, env, subst, eff_subst, e)
  | ast.DoLetStep _ e -> infer_expr(state, env, subst, eff_subst, e)

# Unwrap the monadic payload type for do-bind:
#   Maybe a      → a
#   Result e a   → a
#   anything else → as-is (IO expressions: bound var gets the full expression type)
fn do_unwrap_type(t: types.Type) -> types.Type =
  match t with
  | types.TApp outer inner ->
      match outer with
      | types.TConst name ->
          if name == "Maybe" then inner else t
      | types.TApp outer2 _ ->
          match outer2 with
          | types.TConst name ->
              if name == "Result" then inner else t
          | _ -> t
      | _ -> t
  | _ -> t

fn extend_env_from_do_step(step: ast.DoStep, step_type: types.Type, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match step with
  | ast.DoBindStep pat _ ->
      extend_env_from_pattern_typed(pat, do_unwrap_type(unifier.apply_subst(subst, step_type)), subst, env)
  | ast.DoLetStep name _ ->
      dict_set(name, types.mono(unifier.apply_subst(subst, step_type)), env)
  | ast.DoExprStep _ -> env

# Bind pattern variables to a known type (used for do-bind).
# VarPattern: bind the name directly to the given type.
# Other patterns: fall back to subst-lookup (best-effort).
fn extend_env_from_pattern_typed(pat: ast.Pattern, t: types.Type, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match pat with
  | ast.VarPattern name _ -> dict_set(name, types.mono(t), env)
  | _ -> extend_env_from_pattern(pat, subst, env)

# ---------------------------------------------------------------------------
# Lambda expression
# ---------------------------------------------------------------------------

fn infer_lambda(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  params: List ast.Param,
  body: ast.Expr
) -> InferResult !{IO} =
  do
    fresh_params <- make_fresh_param_types(state, params)
    br <- infer_expr(state, extend_env_with_params(params, fresh_params, env), subst, eff_subst, body)
    match br with
    | InferErr e -> InferErr(e)
    | InferOk body_type s1 es1 body_eff ->
        InferOk(build_fn_type(fresh_params, body_type), s1, es1, body_eff)

fn make_fresh_param_types(state: unifier.InferState, params: List ast.Param) -> List types.Type !{IO} =
  match params with
  | Nil -> Nil
  | Cons _ rest ->
      do
        v <- unifier.fresh(state)
        rest_types <- make_fresh_param_types(state, rest)
        Cons(types.TVar(v), rest_types)

fn extend_env_with_params(params: List ast.Param, param_types: List types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match (params, param_types) with
  | (Nil, _) -> env
  | (_, Nil) -> env
  | (Cons p rest_p, Cons t rest_t) ->
      match p with
      | ast.Param name _ -> extend_env_with_params(rest_p, rest_t, dict_set(name, types.mono(t), env))

# ---------------------------------------------------------------------------
# Record inference
# ---------------------------------------------------------------------------
#
# Records are registered in env using @rec:<RecordName>:<FieldName> keys so
# that field types are accessible without threading a separate rec_env parameter.
#
# Polymorphic records (with type params) store their field types using TVar
# names prefixed with "<RecordName>." to match the naming convention in the
# Python typechecker.

fn register_record_fields(
  rec_name: String,
  type_params: List String,
  fields: List ast.RecordFieldDecl,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  register_record_fields_loop(rec_name, type_params, fields,
    build_record_local_vars(rec_name, type_params, dict_empty()), env)

fn build_record_local_vars(rec_name: String, type_params: List String, acc: Dict types.Type) -> Dict types.Type =
  match type_params with
  | Nil -> acc
  | Cons p rest ->
      build_record_local_vars(rec_name, rest,
        dict_set(p, types.TVar(str_concat(rec_name, str_concat(".", p))), acc))

fn register_record_fields_loop(
  rec_name: String,
  type_params: List String,
  fields: List ast.RecordFieldDecl,
  local_vars: Dict types.Type,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  match fields with
  | Nil -> env
  | Cons field rest ->
      match field with
      | ast.RecordFieldDecl fname ftype ->
          register_record_fields_loop(rec_name, type_params, rest, local_vars,
            dict_set(
              str_concat("@rec:", str_concat(rec_name, str_concat(":", fname))),
              make_record_field_scheme(rec_name, type_params, type_from_ast(ftype, local_vars)),
              env))

fn make_record_field_scheme(rec_name: String, type_params: List String, field_t: types.Type) -> types.Scheme =
  types.Scheme(
    list_map(\p -> str_concat(rec_name, str_concat(".", p)), type_params),
    Nil, field_t, types.EffectPure)

fn infer_record_expr(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  type_name: String,
  fields: List ast.RecordField
) -> InferResult !{IO} =
  infer_record_fields(state, env, subst, eff_subst, type_name, fields, types.EffectPure)

fn infer_record_fields(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  type_name: String,
  fields: List ast.RecordField,
  acc_eff: types.Effect
) -> InferResult !{IO} =
  match fields with
  | Nil -> InferOk(types.TConst(type_name), subst, eff_subst, acc_eff)
  | Cons field rest_fields ->
      match field with
      | ast.RecordField fname fexpr ->
          do
            r <- infer_expr(state, env, subst, eff_subst, fexpr)
            match r with
            | InferErr e -> InferErr(e)
            | InferOk val_type s1 es1 val_eff ->
                match dict_get(str_concat("@rec:", str_concat(type_name, str_concat(":", fname))), env) with
                | Nothing -> InferErr("Unknown record type or field: " ++ type_name ++ "." ++ fname)
                | Just field_scheme ->
                    do
                      field_t <- unifier.instantiate(state, field_scheme)
                      match unifier.unify_types(s1, val_type, field_t) with
                      | Err e -> InferErr("Record field type mismatch: " ++ e)
                      | Ok s2 ->
                          infer_record_fields(state, env, s2, es1, type_name, rest_fields, merge_effects(acc_eff, val_eff))

fn infer_get_field(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  rec_expr: ast.Expr,
  field_name: String
) -> InferResult !{IO} =
  do
    r <- infer_expr(state, env, subst, eff_subst, rec_expr)
    match r with
    | InferErr e -> InferErr(e)
    | InferOk rec_type s1 es1 rec_eff ->
        get_field_from_resolved(state, env, s1, es1, unifier.apply_subst(s1, rec_type), field_name, rec_eff)

fn get_field_from_resolved(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  resolved: types.Type,
  field_name: String,
  rec_eff: types.Effect
) -> InferResult !{IO} =
  match resolved with
  | types.TConst rec_name ->
      lookup_record_field(state, env, subst, eff_subst, rec_name, Nil, field_name, rec_eff)
  | types.TApp _ _ ->
      lookup_record_field(state, env, subst, eff_subst, extract_tconst_name(resolved), extract_tapp_args(resolved), field_name, rec_eff)
  | _ ->
      do
        v <- unifier.fresh(state)
        InferOk(types.TVar(v), subst, eff_subst, rec_eff)

fn extract_tconst_name(t: types.Type) -> String =
  match t with
  | types.TConst name -> name
  | types.TApp base _ -> extract_tconst_name(base)
  | _ -> "Unknown"

fn extract_tapp_args(t: types.Type) -> List types.Type =
  list_reverse(collect_tapp_args(t, Nil))

fn collect_tapp_args(t: types.Type, acc: List types.Type) -> List types.Type =
  match t with
  | types.TApp base arg -> collect_tapp_args(base, Cons(arg, acc))
  | _ -> acc

fn lookup_record_field(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  rec_name: String,
  type_args: List types.Type,
  field_name: String,
  rec_eff: types.Effect
) -> InferResult !{IO} =
  match dict_get(str_concat("@rec:", str_concat(rec_name, str_concat(":", field_name))), env) with
  | Nothing ->
      do
        v <- unifier.fresh(state)
        InferOk(types.TVar(v), subst, eff_subst, rec_eff)
  | Just field_scheme ->
      do
        field_t <- unifier.instantiate(state, field_scheme)
        InferOk(apply_type_args_to_field(field_t, field_scheme, rec_name, type_args), subst, eff_subst, rec_eff)

fn apply_type_args_to_field(
  field_t: types.Type,
  field_scheme: types.Scheme,
  rec_name: String,
  type_args: List types.Type
) -> types.Type =
  match field_scheme with
  | types.Scheme qvars _ _ _ ->
      unifier.apply_subst(build_tvar_subst(qvars, type_args, dict_empty()), field_t)

fn build_tvar_subst(vars: List String, args: List types.Type, acc: Dict types.Type) -> Dict types.Type =
  match (vars, args) with
  | (Nil, _) -> acc
  | (_, Nil) -> acc
  | (Cons v rest_v, Cons a rest_a) ->
      build_tvar_subst(rest_v, rest_a, dict_set(v, a, acc))

# ---------------------------------------------------------------------------
# Program-level typechecking
# ---------------------------------------------------------------------------
#
# DeclResult is a custom ADT rather than Result so that the Python
# typechecker does not misclassify do-blocks that bind it with <- as
# "Result-sequencing" do-blocks.  The same pattern is used for InferResult.

export type DeclResult (..) =
  | DeclOk (Dict types.Scheme)
  | DeclErr String

export fn typecheck_decls(
  state: unifier.InferState,
  decls: List ast.Decl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect
) -> DeclResult !{IO} =
  match decls with
  | Nil -> DeclOk(env)
  | Cons decl rest ->
      do
        r <- typecheck_decl(state, decl, env, subst, eff_subst)
        match r with
        | DeclErr e -> DeclErr(e)
        | DeclOk new_env -> typecheck_decls(state, rest, new_env, subst, eff_subst)

fn typecheck_decl(
  state: unifier.InferState,
  decl: ast.Decl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect
) -> DeclResult !{IO} =
  match decl with
  | ast.TypeDecl _ _ _ _ -> DeclOk(register_type_decl(decl, env))
  | ast.RecordDecl rec_name type_params fields _ ->
      DeclOk(register_record_fields(rec_name, type_params, fields, env))
  | ast.FnDecl name _ _ _ _ _ _ ->
      do
        r <- check_fn_body(state, decl, env, subst, eff_subst)
        match r with
        | DeclErr e -> DeclErr(e)
        | DeclOk _ -> DeclOk(dict_set(name, scheme_from_fn_decl(decl), env))
  | ast.LetDecl name expr _ ->
      do
        r <- infer_expr(state, env, subst, eff_subst, expr)
        match r with
        | InferErr e -> DeclErr(e)
        | InferOk t s1 _ _ ->
            DeclOk(dict_set(name, unifier.generalize(unifier.ftv_env(env), s1, eff_subst, t, types.EffectPure), env))
  | ast.AliasDecl _ _ _ _ -> DeclOk(env)
  | ast.ClassDecl class_name type_params methods _ ->
      DeclOk(register_class_methods(type_params, methods,
             register_class_method_markers(class_name, methods, env)))
  | ast.InstanceDecl constraint methods _ ->
      do
        r <- check_instance_methods(state, methods, env, subst, eff_subst)
        match r with
        | DeclErr e -> DeclErr(e)
        | DeclOk _ -> DeclOk(register_instance_marker(constraint, env))

# ---------------------------------------------------------------------------
# FnDecl body inference
# ---------------------------------------------------------------------------
#
# check_fn_body infers the body of a function declaration and checks it
# against the annotation-derived type.  The public scheme (for callers) is
# still determined by scheme_from_fn_decl; body inference is an additional
# consistency check that does not change the exported type.
#
# Leniency rule: "Unknown variable" / "Unknown constructor" errors are
# silently accepted.  These arise when a function calls a builtin that is
# not in the bootstrap env (print, read_file, dict_get, ...).  We cannot
# enumerate all builtins without pre-seeding the env, so we tolerate the
# gap and still catch real type mismatches in the parts we can check.

fn check_fn_body(
  state: unifier.InferState,
  decl: ast.Decl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect
) -> DeclResult !{IO} =
  match decl with
  | ast.FnDecl name params _ _ _ body _ ->
      do
        inst_type <- unifier.instantiate(state, scheme_from_fn_decl(decl))
        br <- infer_expr(state, fn_body_env(name, params, inst_type, env), subst, eff_subst, body)
        match br with
        | InferErr msg -> fn_body_err(name, msg)
        | InferOk body_type s1 _ _ ->
            match unifier.unify_types(s1, body_type, ctor_result_type(inst_type)) with
            | Err e -> DeclErr("Return type mismatch in " ++ name ++ ": " ++ e)
            | Ok _ -> DeclOk(env)
  | _ -> DeclOk(env)

# Build the local env for body inference: add the function itself (for
# recursion) and its params (from the instantiated annotation type).
fn fn_body_env(name: String, params: List ast.Param, inst_type: types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  extend_env_with_params(
    params,
    ctor_param_types(inst_type),
    dict_set(name, types.mono(inst_type), env)
  )

# Classify an inference error: if it is due to an unknown name (a builtin
# not in the bootstrap env), treat as success.  Otherwise propagate.
fn fn_body_err(name: String, msg: String) -> DeclResult =
  if is_unknown_ref(msg)
  then DeclOk(dict_empty())
  else DeclErr(msg ++ " in function " ++ name)

fn is_unknown_ref(msg: String) -> Bool =
  str_starts_with(msg, "Unknown variable: ") ||
  str_starts_with(msg, "Unknown constructor: ")

# ---------------------------------------------------------------------------
# ClassDecl: method registration + constraint markers
# ---------------------------------------------------------------------------
#
# Each class method is added to the global env as a polymorphic scheme whose
# quantified type variables are the class's type parameters.  This lets body
# inference resolve calls like eq(a, b) without the leniency fallback.
#
# Additionally, a marker entry "@class:{method_name}" → mono(TConst(class_name))
# is stored so that infer_call can look up the class name for a method call and
# verify that a matching instance exists for the first argument's concrete type.

fn register_class_methods(type_params: List String, methods: List ast.ClassMethodSig, env: Dict types.Scheme) -> Dict types.Scheme =
  match methods with
  | Nil -> env
  | Cons sig rest ->
      register_class_methods(type_params, rest, register_class_method(type_params, sig, env))

fn register_class_method(type_params: List String, sig: ast.ClassMethodSig, env: Dict types.Scheme) -> Dict types.Scheme =
  match sig with
  | ast.ClassMethodSig name params ret_type effects_maybe ->
      dict_set(name, scheme_from_fn_parts_inner(type_params, params, Just(ret_type), effects_maybe), env)

fn register_class_method_markers(class_name: String, methods: List ast.ClassMethodSig, env: Dict types.Scheme) -> Dict types.Scheme =
  match methods with
  | Nil -> env
  | Cons sig rest ->
      match sig with
      | ast.ClassMethodSig name _ _ _ ->
          register_class_method_markers(class_name, rest,
            dict_set("@class:" ++ name, types.mono(types.TConst(class_name)), env))

# ---------------------------------------------------------------------------
# InstanceDecl: instance registration marker
# ---------------------------------------------------------------------------
#
# For each instance declaration, register "@inst:{class_name}:{head_type}"
# in the env so infer_call can verify that a matching instance exists.

fn register_instance_marker(constraint: ast.TypeConstraint, env: Dict types.Scheme) -> Dict types.Scheme =
  match constraint with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> env
      | Cons head_te _ ->
          dict_set(
            "@inst:" ++ class_name ++ ":" ++ type_head_str(type_from_ast(head_te, dict_empty())),
            types.mono(types.TConst("Unit")),
            env
          )

# ---------------------------------------------------------------------------
# InstanceDecl: instance method body checking
# ---------------------------------------------------------------------------
#
# Each instance method is treated like a FnDecl body: build a (potentially
# monomorphic) scheme from the method's own annotations, instantiate it,
# build a body env from the params, infer the body, and unify against the
# annotation return type.  The same leniency rule applies: unknown-ref errors
# are silently accepted; real type mismatches propagate.

fn check_instance_methods(
  state: unifier.InferState,
  methods: List ast.InstanceMethodImpl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect
) -> DeclResult !{IO} =
  match methods with
  | Nil -> DeclOk(env)
  | Cons method rest ->
      do
        r <- check_instance_method(state, method, env, subst, eff_subst)
        match r with
        | DeclErr e -> DeclErr(e)
        | DeclOk _ -> check_instance_methods(state, rest, env, subst, eff_subst)

fn check_instance_method(
  state: unifier.InferState,
  method: ast.InstanceMethodImpl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect
) -> DeclResult !{IO} =
  match method with
  | ast.InstanceMethodImpl name params ret_maybe eff_maybe body ->
      do
        inst_type <- unifier.instantiate(state, scheme_from_fn_parts(params, ret_maybe, eff_maybe))
        br <- infer_expr(state, extend_env_with_params(params, ctor_param_types(inst_type), env), subst, eff_subst, body)
        match br with
        | InferErr msg -> instance_method_err(name, msg)
        | InferOk body_type s1 _ _ ->
            match unifier.unify_types(s1, body_type, ctor_result_type(inst_type)) with
            | Err e -> DeclErr("Return type mismatch in instance method " ++ name ++ ": " ++ e)
            | Ok _ -> DeclOk(env)

fn instance_method_err(name: String, msg: String) -> DeclResult =
  if is_unknown_ref(msg)
  then DeclOk(dict_empty())
  else DeclErr(msg ++ " in instance method " ++ name)
