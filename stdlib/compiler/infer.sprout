module stdlib.compiler.infer
import stdlib.compiler.ast as ast
import stdlib.compiler.types as types
import stdlib.compiler.unifier as unifier
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.source as source

# ---------------------------------------------------------------------------
# Inference result types
# ---------------------------------------------------------------------------

export type InferResult (..) =
  | InferOk typed_ast.TypedExpr (Dict types.Type) (Dict types.Effect) types.Effect
  | InferErr String

type InferArgsResult =
  | ArgsOk (List typed_ast.TypedExpr) (Dict types.Type) (Dict types.Effect) types.Effect
  | ArgsErr String

type CallResult =
  | CallOk types.Type (Dict types.Type) (Dict types.Effect) types.Effect
  | CallErr String

# Internal per-decl result (not exported; callers see TypedResult).
type TypedDeclResult =
  | TypedDeclOk typed_ast.TypedDecl (Dict types.Scheme)
  | TypedDeclErr String

# Internal single-method result.
type InstanceMethodResult =
  | InstanceMethodOk typed_ast.TypedInstanceMethod
  | InstanceMethodErr String

# ---------------------------------------------------------------------------
# Type-expression → Type
# ---------------------------------------------------------------------------

export fn type_from_ast(te: ast.TypeExpr, local_vars: Dict types.Type) -> types.Type =
  match te with
  | ast.TypeName name -> lookup_type_var(name, local_vars)
  | ast.TypeApply base arg ->
      types.TApp(type_from_ast(base, local_vars), type_from_ast(arg, local_vars))
  | ast.TypeArrow param ret _ ->
      types.TFunc(type_from_ast(param, local_vars), type_from_ast(ret, local_vars), types.EffectPure)
  | ast.TypeEffect inner _ -> type_from_ast(inner, local_vars)
  | ast.TupleType parts -> types.TTuple(type_list_from_ast(parts, local_vars))

fn strip_module_prefix(name: String) -> String =
  if dot == -1 then name
  else strip_module_prefix(str_slice(name, dot + 1, str_len(name)))
  where dot = str_find(name, ".")

fn lookup_type_var(name: String, local_vars: Dict types.Type) -> types.Type =
  match dict_get(name, local_vars) with
  | Just t -> t
  | Nothing -> types.TConst(strip_module_prefix(name))

fn type_list_from_ast(parts: List ast.TypeExpr, local_vars: Dict types.Type) -> List types.Type =
  match parts with
  | Nil -> Nil
  | Cons h t -> Cons(type_from_ast(h, local_vars), type_list_from_ast(t, local_vars))

export fn effect_from_maybe_labels(labels: Maybe (List String)) -> types.Effect =
  match labels with
  | Nothing -> types.EffectPure
  | Just ls ->
      match ls with
      | Nil -> types.EffectPure
      | Cons label rest ->
          match rest with
          | Nil ->
              if label == "IO" then types.EffectIO
              else types.EffectVar(label)
          | _ -> types.EffectRow(ls)

# ---------------------------------------------------------------------------
# Build a Scheme from a FnDecl
# ---------------------------------------------------------------------------

export fn scheme_from_fn_decl(decl: ast.Decl) -> types.Scheme =
  match decl with
  | ast.FnDecl _ params ret_type_maybe effects_maybe _ _ _ ->
      scheme_from_fn_parts(params, ret_type_maybe, effects_maybe, dict_empty())
  | _ -> types.mono(types.TConst("Unit"))

fn scheme_from_fn_parts(
  params: List ast.Param,
  ret_type_maybe: Maybe ast.TypeExpr,
  effects_maybe: Maybe (List String),
  alias_env: Dict types.Type
) -> types.Scheme =
  scheme_from_fn_parts_inner(
    collect_ret_type_vars(ret_type_maybe, collect_param_type_vars(params, Nil)),
    params,
    ret_type_maybe,
    effects_maybe,
    alias_env
  )

fn collect_param_type_vars(params: List ast.Param, acc: List String) -> List String =
  match params with
  | Nil -> acc
  | Cons p rest ->
      collect_param_type_vars(rest, collect_type_expr_vars(ast_param_type(p), acc))

fn ast_param_type(p: ast.Param) -> Maybe ast.TypeExpr =
  match p with
  | ast.Param _ maybe_type -> maybe_type

fn collect_type_expr_vars(maybe_te: Maybe ast.TypeExpr, acc: List String) -> List String =
  match maybe_te with
  | Nothing -> acc
  | Just te -> collect_te_vars(te, acc)

fn collect_te_vars(te: ast.TypeExpr, acc: List String) -> List String =
  match te with
  | ast.TypeName name ->
      if is_lowercase_name(name) then list_add_unique(name, acc) else acc
  | ast.TypeApply base arg ->
      collect_te_vars(arg, collect_te_vars(base, acc))
  | ast.TypeArrow param ret _ ->
      collect_te_vars(ret, collect_te_vars(param, acc))
  | ast.TypeEffect inner _ -> collect_te_vars(inner, acc)
  | ast.TupleType parts -> collect_te_vars_list(parts, acc)

fn collect_te_vars_list(parts: List ast.TypeExpr, acc: List String) -> List String =
  match parts with
  | Nil -> acc
  | Cons h t -> collect_te_vars_list(t, collect_te_vars(h, acc))

fn is_lowercase_name(name: String) -> Bool =
  str_find(name, ".") == -1 &&
  (c == "a" || c == "b" || c == "c" || c == "d" || c == "e" ||
   c == "f" || c == "g" || c == "h" || c == "i" || c == "j" ||
   c == "k" || c == "l" || c == "m" || c == "n" || c == "o" ||
   c == "p" || c == "q" || c == "r" || c == "s" || c == "t" ||
   c == "u" || c == "v" || c == "w" || c == "x" || c == "y" || c == "z")
  where c = str_slice(name, 0, 1)

fn list_add_unique(x: String, xs: List String) -> List String =
  if types.list_member(x, xs) then xs else append(xs, Cons(x, Nil))

fn collect_ret_type_vars(ret_type_maybe: Maybe ast.TypeExpr, acc: List String) -> List String =
  match ret_type_maybe with
  | Nothing -> acc
  | Just te -> collect_te_vars(te, acc)

fn build_type_var_dict(vars: List String, acc: Dict types.Type) -> Dict types.Type =
  match vars with
  | Nil -> acc
  | Cons name rest -> build_type_var_dict(rest, dict_set(name, types.TVar(name), acc))

fn scheme_from_fn_parts_inner(
  type_params: List String,
  params: List ast.Param,
  ret_type_maybe: Maybe ast.TypeExpr,
  effects_maybe: Maybe (List String),
  alias_env: Dict types.Type
) -> types.Scheme =
  types.Scheme(
    type_params,
    Nil,
    build_fn_type(param_types_from_decl(params, local_vars), ret_from_maybe_with_vars(ret_type_maybe, local_vars)),
    effect_from_maybe_labels(effects_maybe)
  )
  where local_vars = build_type_var_dict(type_params, alias_env)

fn param_types_from_decl(params: List ast.Param, local_vars: Dict types.Type) -> List types.Type =
  match params with
  | Nil -> Nil
  | Cons p rest ->
      match ast_param_type(p) with
      | Nothing -> Cons(types.TVar("_unann"), param_types_from_decl(rest, local_vars))
      | Just te -> Cons(type_from_ast(te, local_vars), param_types_from_decl(rest, local_vars))

fn ret_from_maybe_with_vars(maybe_te: Maybe ast.TypeExpr, local_vars: Dict types.Type) -> types.Type =
  match maybe_te with
  | Nothing -> types.TConst("Unit")
  | Just te -> type_from_ast(te, local_vars)

fn build_fn_type(params: List types.Type, ret: types.Type) -> types.Type =
  match params with
  | Nil -> ret
  | Cons p rest -> types.TFunc(p, build_fn_type(rest, ret), types.EffectPure)

# ---------------------------------------------------------------------------
# Constructor registration
# ---------------------------------------------------------------------------

export fn register_type_decl(decl: ast.Decl, env: Dict types.Scheme) -> Dict types.Scheme =
  match decl with
  | ast.TypeDecl name params ctors _ ->
      register_ctors_for_type(name, params, build_local_params(params, dict_empty()), ctors, env)
  | _ -> env

fn build_local_params(params: List String, acc: Dict types.Type) -> Dict types.Type =
  match params with
  | Nil -> acc
  | Cons p rest -> build_local_params(rest, dict_set(p, types.TVar(p), acc))

fn build_result_type(name: String, params: List String) -> types.Type =
  apply_type_params(types.TConst(name), params)

fn apply_type_params(base: types.Type, params: List String) -> types.Type =
  match params with
  | Nil -> base
  | Cons p rest -> apply_type_params(types.TApp(base, types.TVar(p)), rest)

fn register_ctors_for_type(
  type_name: String,
  type_params: List String,
  local_vars: Dict types.Type,
  ctors: List ast.TypeConstructor,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  match ctors with
  | Nil -> env
  | Cons ctor rest ->
      register_ctors_for_type(
        type_name, type_params, local_vars, rest,
        register_one_ctor(ctor, type_params, local_vars, build_result_type(type_name, type_params), env)
      )

fn register_one_ctor(
  ctor: ast.TypeConstructor,
  type_params: List String,
  local_vars: Dict types.Type,
  result_type: types.Type,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  match ctor with
  | ast.TypeConstructor name fields ->
      dict_set(
        name,
        types.Scheme(type_params, Nil, ctor_fn_type(fields, local_vars, result_type), types.EffectPure),
        env
      )

fn ctor_fn_type(fields: List ast.TypeExpr, local_vars: Dict types.Type, result: types.Type) -> types.Type =
  match fields with
  | Nil -> result
  | Cons f rest ->
      types.TFunc(type_from_ast(f, local_vars), ctor_fn_type(rest, local_vars, result), types.EffectPure)

# ---------------------------------------------------------------------------
# Effect merging
# ---------------------------------------------------------------------------

fn merge_effects(a: types.Effect, b: types.Effect) -> types.Effect =
  match (a, b) with
  | (types.EffectIO, _) -> types.EffectIO
  | (_, types.EffectIO) -> types.EffectIO
  | (types.EffectPure, other) -> other
  | (other, types.EffectPure) -> other
  | _ -> a

# ---------------------------------------------------------------------------
# List helpers (type-specific reverse functions)
# ---------------------------------------------------------------------------

fn list_reverse(xs: List types.Type) -> List types.Type =
  list_rev_acc(xs, Nil)

fn list_rev_acc(xs: List types.Type, acc: List types.Type) -> List types.Type =
  match xs with
  | Nil -> acc
  | Cons h t -> list_rev_acc(t, Cons(h, acc))

fn typed_expr_list_reverse(xs: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  typed_expr_rev_acc(xs, Nil)

fn typed_expr_rev_acc(xs: List typed_ast.TypedExpr, acc: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  match xs with
  | Nil -> acc
  | Cons h t -> typed_expr_rev_acc(t, Cons(h, acc))

fn typed_branch_list_reverse(xs: List typed_ast.TypedMatchBranch) -> List typed_ast.TypedMatchBranch =
  typed_branch_rev_acc(xs, Nil)

fn typed_branch_rev_acc(xs: List typed_ast.TypedMatchBranch, acc: List typed_ast.TypedMatchBranch) -> List typed_ast.TypedMatchBranch =
  match xs with
  | Nil -> acc
  | Cons h t -> typed_branch_rev_acc(t, Cons(h, acc))

fn typed_do_step_list_reverse(xs: List typed_ast.TypedDoStep) -> List typed_ast.TypedDoStep =
  typed_do_step_rev_acc(xs, Nil)

fn typed_do_step_rev_acc(xs: List typed_ast.TypedDoStep, acc: List typed_ast.TypedDoStep) -> List typed_ast.TypedDoStep =
  match xs with
  | Nil -> acc
  | Cons h t -> typed_do_step_rev_acc(t, Cons(h, acc))

fn typed_record_field_list_reverse(xs: List typed_ast.TypedRecordField) -> List typed_ast.TypedRecordField =
  typed_record_field_rev_acc(xs, Nil)

fn typed_record_field_rev_acc(xs: List typed_ast.TypedRecordField, acc: List typed_ast.TypedRecordField) -> List typed_ast.TypedRecordField =
  match xs with
  | Nil -> acc
  | Cons h t -> typed_record_field_rev_acc(t, Cons(h, acc))

fn typed_decl_list_reverse(xs: List typed_ast.TypedDecl) -> List typed_ast.TypedDecl =
  typed_decl_rev_acc(xs, Nil)

fn typed_decl_rev_acc(xs: List typed_ast.TypedDecl, acc: List typed_ast.TypedDecl) -> List typed_ast.TypedDecl =
  match xs with
  | Nil -> acc
  | Cons h t -> typed_decl_rev_acc(t, Cons(h, acc))

fn typed_method_list_reverse(xs: List typed_ast.TypedInstanceMethod) -> List typed_ast.TypedInstanceMethod =
  typed_method_rev_acc(xs, Nil)

fn typed_method_rev_acc(xs: List typed_ast.TypedInstanceMethod, acc: List typed_ast.TypedInstanceMethod) -> List typed_ast.TypedInstanceMethod =
  match xs with
  | Nil -> acc
  | Cons h t -> typed_method_rev_acc(t, Cons(h, acc))

fn dummy_pos() -> source.SourcePos = source.SourcePos(0, 0, 0)

fn dummy_unit() -> typed_ast.TypedExpr =
  typed_ast.TUnit(types.TConst("Unit"), dummy_pos())

# ---------------------------------------------------------------------------
# Expression inference
# ---------------------------------------------------------------------------

export fn infer_expr(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expr: ast.Expr
) -> InferResult !{IO} =
  match expr with
  | ast.IntExpr v pos -> InferOk(typed_ast.TInt(v, types.type_int(), pos), subst, eff_subst, types.EffectPure)
  | ast.BoolExpr v pos -> InferOk(typed_ast.TBool(v, types.type_bool(), pos), subst, eff_subst, types.EffectPure)
  | ast.StringExpr v pos -> InferOk(typed_ast.TString(v, types.type_string(), pos), subst, eff_subst, types.EffectPure)
  | ast.CharExpr v pos -> InferOk(typed_ast.TChar(v, types.type_char(), pos), subst, eff_subst, types.EffectPure)
  | ast.UnitExpr pos -> InferOk(typed_ast.TUnit(types.TConst("Unit"), pos), subst, eff_subst, types.EffectPure)
  | ast.VarExpr name pos -> infer_var(state, env, subst, eff_subst, name, pos)
  | ast.IfExpr cond then_ else_ pos -> infer_if(state, env, subst, eff_subst, cond, then_, else_, pos)
  | ast.CallExpr callee args pos -> infer_call(state, env, subst, eff_subst, callee, args, pos)
  | ast.MatchExpr scrut branches pos -> infer_match(state, env, subst, eff_subst, scrut, branches, pos)
  | ast.TupleExpr elems pos -> infer_tuple(state, env, subst, eff_subst, elems, pos)
  | ast.BinaryExpr op left right pos -> infer_binary(state, env, subst, eff_subst, op, left, right, pos)
  | ast.UnaryExpr op operand pos -> infer_unary(state, env, subst, eff_subst, op, operand, pos)
  | ast.DoExpr steps pos -> infer_do(state, env, subst, eff_subst, steps, pos)
  | ast.LambdaExpr params body pos -> infer_lambda(state, env, subst, eff_subst, params, body, pos)
  | ast.RecordExpr type_name fields pos ->
      infer_record_expr(state, env, subst, eff_subst, type_name, fields, pos)
  | ast.GetFieldExpr rec_expr field_name pos ->
      infer_get_field(state, env, subst, eff_subst, rec_expr, field_name, pos)
  | ast.IntRangeExpr lo hi pos -> infer_range(state, env, subst, eff_subst, lo, hi, pos)

# --- Variable ---

fn infer_var(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  name: String,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match dict_get(name, env) with
  | Nothing -> InferErr("Unknown variable: " ++ name)
  | Just scheme ->
      do
        t <- unifier.instantiate(state, scheme)
        InferOk(typed_ast.TVar(name, t, pos), subst, eff_subst, types.EffectPure)

# --- If ---

fn infer_if(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  cond: ast.Expr,
  then_: ast.Expr,
  else_: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    cr <- infer_expr(state, env, subst, eff_subst, cond)
    match cr with
    | InferErr e -> InferErr(e)
    | InferOk typed_cond s1 es1 cond_eff ->
        infer_if_checked(state, env, s1, es1, typed_cond, cond_eff, then_, else_, pos)

fn infer_if_checked(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  typed_cond: typed_ast.TypedExpr,
  cond_eff: types.Effect,
  then_: ast.Expr,
  else_: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match unifier.unify_types(subst, typed_ast.typed_expr_type(typed_cond), types.type_bool()) with
  | Err e -> InferErr("If condition must be Bool: " ++ e)
  | Ok s2 ->
      do
        tr <- infer_expr(state, env, s2, eff_subst, then_)
        match tr with
        | InferErr e -> InferErr(e)
        | InferOk typed_then s3 es3 then_eff ->
            do
              er <- infer_expr(state, env, s3, es3, else_)
              match er with
              | InferErr e -> InferErr(e)
              | InferOk typed_else s4 es4 else_eff ->
                  infer_if_merge(s4, es4, typed_cond, typed_then, typed_else,
                                 cond_eff, then_eff, else_eff, pos)

fn infer_if_merge(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  typed_cond: typed_ast.TypedExpr,
  typed_then: typed_ast.TypedExpr,
  typed_else: typed_ast.TypedExpr,
  cond_eff: types.Effect,
  then_eff: types.Effect,
  else_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match unifier.unify_types(subst, typed_ast.typed_expr_type(typed_then), typed_ast.typed_expr_type(typed_else)) with
  | Err e -> InferErr("If branches must have same type: " ++ e)
  | Ok s5 ->
      InferOk(
        typed_ast.TIf(typed_cond, typed_then, typed_else,
                      unifier.apply_subst(s5, typed_ast.typed_expr_type(typed_then)), pos),
        s5, eff_subst,
        merge_effects(cond_eff, merge_effects(then_eff, else_eff))
      )

# --- Call ---

fn infer_call(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  callee: ast.Expr,
  args: List ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    cr <- infer_expr(state, env, subst, eff_subst, callee)
    match cr with
    | InferErr e -> InferErr(e)
    | InferOk typed_callee s1 es1 callee_eff ->
        do
          ar <- infer_args_acc(state, env, s1, es1, args, Nil, types.EffectPure)
          match ar with
          | ArgsErr e -> InferErr(e)
          | ArgsOk typed_args s2 es2 args_eff ->
              do
                v <- unifier.fresh(state)
                r <- infer_call_resolve(
                  s2, es2,
                  typed_ast.typed_expr_type(typed_callee),
                  list_map(\e -> typed_ast.typed_expr_type(e), typed_args),
                  types.TVar(v),
                  merge_effects(callee_eff, args_eff))
                match r with
                | CallErr e -> InferErr(e)
                | CallOk ret_t s3 es3 call_eff ->
                    check_call_constraint(callee, typed_callee, typed_args, s3, env, ret_t, s3, es3, call_eff, pos)

fn infer_call_resolve(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  callee_type: types.Type,
  arg_types: List types.Type,
  ret_type: types.Type,
  eff: types.Effect
) -> CallResult !{IO} =
  match unifier.unify_types(subst, callee_type, build_fn_type(arg_types, ret_type)) with
  | Err e -> CallErr("Call type mismatch: " ++ e)
  | Ok s3 -> CallOk(unifier.apply_subst(s3, ret_type), s3, eff_subst, eff)

# --- Constraint checking ---
#
# Class methods are registered under "@class:{method_name}" and instances
# under "@inst:{class_name}:{head_type_str}".  At concrete call sites a
# TDict evidence node is prepended to the argument list.
#
# At polymorphic call sites (first arg is a type variable) the typechecker
# uses forward markers seeded into the env by check_fn_body /
# check_instance_method.  A marker has key "@fwd:{fresh_var}:{class_name}"
# and stores the programmer's type-variable name as TConst in the scheme.
# When the marker is found, a TDict with the programmer-name constraint is
# emitted so the lowering pass can forward the appropriate hidden parameter.

fn check_call_constraint(
  callee: ast.Expr,
  typed_callee: typed_ast.TypedExpr,
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  env: Dict types.Scheme,
  ret_t: types.Type,
  s3: Dict types.Type,
  es3: Dict types.Effect,
  call_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match callee with
  | ast.VarExpr method_name _ ->
      match dict_get("@class:" ++ method_name, env) with
      | Nothing -> InferOk(typed_ast.TCall(typed_callee, typed_args, ret_t, pos), s3, es3, call_eff)
      | Just class_marker ->
          check_instance_for_marker(class_marker, typed_callee, typed_args, subst, env, ret_t, s3, es3, call_eff, pos)
  | _ -> InferOk(typed_ast.TCall(typed_callee, typed_args, ret_t, pos), s3, es3, call_eff)

fn check_instance_for_marker(
  class_marker: types.Scheme,
  typed_callee: typed_ast.TypedExpr,
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  env: Dict types.Scheme,
  ret_t: types.Type,
  s3: Dict types.Type,
  es3: Dict types.Effect,
  call_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match class_marker with
  | types.Scheme _ _ class_type _ ->
      match class_type with
      | types.TConst class_name ->
          match first_concrete_typed_arg_str(typed_args, subst) with
          | Just head_str ->
              match dict_get("@inst:" ++ class_name ++ ":" ++ head_str, env) with
              | Nothing -> InferErr("No instance of " ++ class_name ++ " for " ++ head_str)
              | Just _ ->
                  InferOk(
                    typed_ast.TCall(typed_callee,
                      Cons(typed_ast.TDict(
                        ast.TypeConstraint(class_name, Cons(ast.TypeName(head_str), Nil)),
                        types.TConst(class_name), pos),
                        typed_args),
                      ret_t, pos),
                    s3, es3, call_eff)
          | Nothing ->
              # Polymorphic call — try to forward from a @fwd marker in env.
              match first_tvar_head_after_subst(typed_args, subst) with
              | Nothing -> InferOk(typed_ast.TCall(typed_callee, typed_args, ret_t, pos), s3, es3, call_eff)
              | Just tvar_name ->
                  match dict_get("@fwd:" ++ tvar_name ++ ":" ++ class_name, env) with
                  | Nothing -> InferOk(typed_ast.TCall(typed_callee, typed_args, ret_t, pos), s3, es3, call_eff)
                  | Just fwd_scheme ->
                      match fwd_scheme with
                      | types.Scheme _ _ (types.TConst prog_var) _ ->
                          InferOk(
                            typed_ast.TCall(typed_callee,
                              Cons(typed_ast.TDict(
                                ast.TypeConstraint(class_name, Cons(ast.TypeName(prog_var), Nil)),
                                types.TConst(class_name), pos),
                                typed_args),
                              ret_t, pos),
                            s3, es3, call_eff)
                      | _ -> InferOk(typed_ast.TCall(typed_callee, typed_args, ret_t, pos), s3, es3, call_eff)
      | _ -> InferOk(typed_ast.TCall(typed_callee, typed_args, ret_t, pos), s3, es3, call_eff)

fn first_concrete_typed_arg_str(typed_args: List typed_ast.TypedExpr, subst: Dict types.Type) -> Maybe String =
  match typed_args with
  | Nil -> Nothing
  | Cons first_arg _ ->
      concrete_type_str(unifier.apply_subst(subst, typed_ast.typed_expr_type(first_arg)))

# Returns the outermost TVar name of the first arg after substitution.
# Used to look up @fwd:{tvar}:{class} forward markers for polymorphic dispatch.
fn first_tvar_head_after_subst(typed_args: List typed_ast.TypedExpr, subst: Dict types.Type) -> Maybe String =
  match typed_args with
  | Nil -> Nothing
  | Cons first_arg _ ->
      tvar_head_of_type(unifier.apply_subst(subst, typed_ast.typed_expr_type(first_arg)))

fn tvar_head_of_type(t: types.Type) -> Maybe String =
  match t with
  | types.TVar name -> Just(name)
  | types.TApp base _ -> tvar_head_of_type(base)
  | _ -> Nothing

fn type_head_str(t: types.Type) -> String =
  match t with
  | types.TConst name -> name
  | types.TApp base _ -> type_head_str(base)
  | types.TVar name -> name
  | _ -> types.type_to_string(t)

fn concrete_type_str(t: types.Type) -> Maybe String =
  match t with
  | types.TVar _ -> Nothing
  | _ -> Just(type_head_str(t))

# --- Forward marker helpers ---
#
# seed_forward_markers adds "@fwd:{fresh_var}:{class_name}" entries to env
# for each constraint, enabling polymorphic dispatch in check_instance_for_marker.
# prog_to_fresh maps programmer type-var names (e.g., "a") to their fresh
# instantiation TVars (e.g., TVar("a42")).

fn seed_forward_markers(constraints: List ast.TypeConstraint, prog_to_fresh: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match constraints with
  | Nil -> env
  | Cons c rest ->
      seed_forward_markers(rest, prog_to_fresh, seed_one_constraint_marker(c, prog_to_fresh, env))

fn seed_one_constraint_marker(c: ast.TypeConstraint, prog_to_fresh: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match c with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> env
      | Cons head_te _ ->
          match head_te with
          | ast.TypeName prog_var ->
              match dict_get(prog_var, prog_to_fresh) with
              | Nothing -> env
              | Just fresh_t ->
                  match fresh_t with
                  | types.TVar fresh_name ->
                      # Store prog_var name in the scheme value for retrieval in check_instance_for_marker.
                      dict_set("@fwd:" ++ fresh_name ++ ":" ++ class_name,
                               types.mono(types.TConst(prog_var)), env)
                  | _ -> env
          | _ -> env

# --- Args accumulator ---

fn infer_args_acc(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  args: List ast.Expr,
  acc: List typed_ast.TypedExpr,
  acc_eff: types.Effect
) -> InferArgsResult !{IO} =
  match args with
  | Nil -> ArgsOk(typed_expr_list_reverse(acc), subst, eff_subst, acc_eff)
  | Cons arg rest ->
      do
        r <- infer_expr(state, env, subst, eff_subst, arg)
        match r with
        | InferErr e -> ArgsErr(e)
        | InferOk typed_arg s1 es1 arg_eff ->
            infer_args_acc(state, env, s1, es1, rest, Cons(typed_arg, acc), merge_effects(acc_eff, arg_eff))

# --- Tuple ---

fn infer_tuple(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  elems: List ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    r <- infer_args_acc(state, env, subst, eff_subst, elems, Nil, types.EffectPure)
    match r with
    | ArgsErr e -> InferErr(e)
    | ArgsOk typed_elems s1 es1 eff ->
        InferOk(
          typed_ast.TTuple(typed_elems,
            types.TTuple(list_map(\e -> typed_ast.typed_expr_type(e), typed_elems)), pos),
          s1, es1, eff)

# --- Binary ---

fn infer_binary(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  left: ast.Expr,
  right: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    lr <- infer_expr(state, env, subst, eff_subst, left)
    match lr with
    | InferErr e -> InferErr(e)
    | InferOk typed_left s1 es1 l_eff ->
        do
          rr <- infer_expr(state, env, s1, es1, right)
          match rr with
          | InferErr e -> InferErr(e)
          | InferOk typed_right s2 es2 r_eff ->
              infer_binary_op(s2, es2, op, typed_left, typed_right, merge_effects(l_eff, r_eff), pos)

fn infer_binary_op(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  if op == "+" || op == "-" || op == "*" || op == "/" then
    check_arith(subst, eff_subst, op, typed_left, typed_right, eff, pos)
  else if op == "<" || op == "<=" || op == ">" || op == ">=" then
    check_compare(subst, eff_subst, op, typed_left, typed_right, eff, pos)
  else if op == "==" || op == "!=" then
    check_eq(subst, eff_subst, op, typed_left, typed_right, eff, pos)
  else if op == "&&" || op == "||" then
    check_bool(subst, eff_subst, op, typed_left, typed_right, eff, pos)
  else
    InferOk(typed_ast.TBinary(op, typed_left, typed_right,
                              typed_ast.typed_expr_type(typed_left), pos),
            subst, eff_subst, eff)

fn check_arith(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match unifier.unify_types(subst, typed_ast.typed_expr_type(typed_left), types.type_int()) with
  | Err e -> InferErr(op ++ " needs Int: " ++ e)
  | Ok s1 ->
      match unifier.unify_types(s1, typed_ast.typed_expr_type(typed_right), types.type_int()) with
      | Err e -> InferErr(op ++ " needs Int: " ++ e)
      | Ok s2 ->
          InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_int(), pos),
                  s2, eff_subst, eff)

fn check_compare(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match unifier.unify_types(subst, typed_ast.typed_expr_type(typed_left), types.type_int()) with
  | Err e -> InferErr(op ++ " needs Int: " ++ e)
  | Ok s1 ->
      match unifier.unify_types(s1, typed_ast.typed_expr_type(typed_right), types.type_int()) with
      | Err e -> InferErr(op ++ " needs Int: " ++ e)
      | Ok s2 ->
          InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_bool(), pos),
                  s2, eff_subst, eff)

fn check_eq(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match unifier.unify_types(subst, typed_ast.typed_expr_type(typed_left), typed_ast.typed_expr_type(typed_right)) with
  | Err e -> InferErr(op ++ " needs same types: " ++ e)
  | Ok s1 ->
      InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_bool(), pos),
              s1, eff_subst, eff)

fn check_bool(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match unifier.unify_types(subst, typed_ast.typed_expr_type(typed_left), types.type_bool()) with
  | Err e -> InferErr(op ++ " needs Bool: " ++ e)
  | Ok s1 ->
      match unifier.unify_types(s1, typed_ast.typed_expr_type(typed_right), types.type_bool()) with
      | Err e -> InferErr(op ++ " needs Bool: " ++ e)
      | Ok s2 ->
          InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_bool(), pos),
                  s2, eff_subst, eff)

# --- Unary ---

fn infer_unary(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  operand: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    r <- infer_expr(state, env, subst, eff_subst, operand)
    match r with
    | InferErr e -> InferErr(e)
    | InferOk typed_operand s1 es1 eff ->
        InferOk(
          typed_ast.TUnary(op, typed_operand, typed_ast.typed_expr_type(typed_operand), pos),
          s1, es1, eff)

# --- Match ---

fn infer_match(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  scrutinee: ast.Expr,
  branches: List ast.MatchBranch,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    sr <- infer_expr(state, env, subst, eff_subst, scrutinee)
    match sr with
    | InferErr e -> InferErr(e)
    | InferOk typed_scrut s1 es1 scrut_eff ->
        do
          v <- unifier.fresh(state)
          infer_branches(state, env, s1, es1, typed_scrut, types.TVar(v), branches, Nil, scrut_eff, pos)

fn infer_branches(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  typed_scrut: typed_ast.TypedExpr,
  ret_type: types.Type,
  branches: List ast.MatchBranch,
  acc_branches: List typed_ast.TypedMatchBranch,
  acc_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match branches with
  | Nil ->
      InferOk(
        typed_ast.TMatch(typed_scrut,
                         typed_branch_list_reverse(acc_branches),
                         unifier.apply_subst(subst, ret_type), pos),
        subst, eff_subst, acc_eff)
  | Cons branch rest ->
      match branch with
      | ast.MatchBranch pat _ ->
          do
            br <- infer_branch(state, env, subst, eff_subst,
                               typed_ast.typed_expr_type(typed_scrut), ret_type, branch)
            match br with
            | InferErr e -> InferErr(e)
            | InferOk typed_body s1 es1 branch_eff ->
                infer_branches(state, env, s1, es1, typed_scrut,
                               unifier.apply_subst(s1, ret_type),
                               rest,
                               Cons(typed_ast.TypedMatchBranch(pat, typed_body), acc_branches),
                               merge_effects(acc_eff, branch_eff), pos)

fn infer_branch(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  scrut_type: types.Type,
  ret_type: types.Type,
  branch: ast.MatchBranch
) -> InferResult !{IO} =
  match branch with
  | ast.MatchBranch pat body ->
      do
        pr <- infer_pattern(state, env, subst, eff_subst, scrut_type, pat)
        match pr with
        | InferErr e -> InferErr(e)
        | InferOk _ s1 es1 _ ->
            infer_branch_body(state, extend_env_from_pattern(pat, s1, env), s1, es1, ret_type, body)

fn infer_branch_body(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  ret_type: types.Type,
  body: ast.Expr
) -> InferResult !{IO} =
  do
    br <- infer_expr(state, env, subst, eff_subst, body)
    match br with
    | InferErr e -> InferErr(e)
    | InferOk typed_body s2 es2 body_eff ->
        infer_branch_unify(s2, es2, typed_body, ret_type, body_eff)

fn infer_branch_unify(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  typed_body: typed_ast.TypedExpr,
  ret_type: types.Type,
  body_eff: types.Effect
) -> InferResult !{IO} =
  match unifier.unify_types(subst, typed_ast.typed_expr_type(typed_body), ret_type) with
  | Err e -> InferErr("Match branch type mismatch: " ++ e)
  | Ok s3 -> InferOk(typed_body, s3, eff_subst, body_eff)

# --- Pattern inference ---
#
# Patterns do not produce meaningful TypedExprs; callers always discard the
# first field of InferOk.  We return a dummy TUnit carrying the pattern type.

export fn infer_pattern(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  pat: ast.Pattern
) -> InferResult !{IO} =
  match pat with
  | ast.WildcardPattern _ ->
      InferOk(typed_ast.TUnit(expected, dummy_pos()), subst, eff_subst, types.EffectPure)
  | ast.VarPattern name _ ->
      InferOk(typed_ast.TUnit(expected, dummy_pos()), dict_set(name, expected, subst), eff_subst, types.EffectPure)
  | ast.IntPattern _ _ ->
      check_pattern_type(subst, eff_subst, expected, types.type_int(), "Int")
  | ast.BoolPattern _ _ ->
      check_pattern_type(subst, eff_subst, expected, types.type_bool(), "Bool")
  | ast.StringPattern _ _ ->
      check_pattern_type(subst, eff_subst, expected, types.type_string(), "String")
  | ast.CharPattern _ _ ->
      check_pattern_type(subst, eff_subst, expected, types.type_char(), "Char")
  | ast.UnitPattern _ ->
      check_pattern_type(subst, eff_subst, expected, types.TConst("Unit"), "Unit")
  | ast.TuplePattern pats _ ->
      infer_tuple_pattern(state, env, subst, eff_subst, expected, pats)
  | ast.ConstructorPattern name fields _ ->
      infer_ctor_pattern(state, env, subst, eff_subst, expected, name, fields)

fn check_pattern_type(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  expected_type: types.Type,
  label: String
) -> InferResult !{IO} =
  match unifier.unify_types(subst, expected, expected_type) with
  | Err e -> InferErr(label ++ " pattern: " ++ e)
  | Ok s1 ->
      InferOk(typed_ast.TUnit(expected_type, dummy_pos()), s1, eff_subst, types.EffectPure)

fn infer_tuple_pattern(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  pats: List ast.Pattern
) -> InferResult !{IO} =
  do
    elem_vars <- make_fresh_var_list(state, pats)
    infer_tuple_pattern_unified(state, env, subst, eff_subst, expected, elem_vars, pats)

fn infer_tuple_pattern_unified(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  elem_vars: List types.Type,
  pats: List ast.Pattern
) -> InferResult !{IO} =
  match unifier.unify_types(subst, expected, types.TTuple(elem_vars)) with
  | Err e -> InferErr("Tuple pattern: " ++ e)
  | Ok s1 ->
      check_pattern_list(state, env, s1, eff_subst, elem_vars, pats)

fn make_fresh_var_list(state: unifier.InferState, pats: List ast.Pattern) -> List types.Type !{IO} =
  match pats with
  | Nil -> Nil
  | Cons _ rest ->
      do
        v <- unifier.fresh(state)
        rest_vars <- make_fresh_var_list(state, rest)
        Cons(types.TVar(v), rest_vars)

fn check_pattern_list(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected_list: List types.Type,
  pats: List ast.Pattern
) -> InferResult !{IO} =
  match (expected_list, pats) with
  | (Nil, Nil) ->
      InferOk(typed_ast.TUnit(types.TConst("Unit"), dummy_pos()), subst, eff_subst, types.EffectPure)
  | (Cons exp_h exp_rest, Cons pat_h pat_rest) ->
      do
        r <- infer_pattern(state, env, subst, eff_subst, exp_h, pat_h)
        match r with
        | InferErr e -> InferErr(e)
        | InferOk _ s1 es1 _ ->
            check_pattern_list(state, env, s1, es1, exp_rest, pat_rest)
  | _ -> InferErr("Tuple pattern arity mismatch")

fn infer_ctor_pattern(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  name: String,
  fields: List ast.Pattern
) -> InferResult !{IO} =
  match dict_get(name, env) with
  | Nothing -> InferErr("Unknown constructor: " ++ name)
  | Just scheme ->
      do
        ctor_type <- unifier.instantiate(state, scheme)
        infer_ctor_pattern_typed(state, env, subst, eff_subst, expected, name, fields, ctor_type)

fn infer_ctor_pattern_typed(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  name: String,
  fields: List ast.Pattern,
  ctor_type: types.Type
) -> InferResult !{IO} =
  match unifier.unify_types(subst, expected, ctor_result_type(ctor_type)) with
  | Err e -> InferErr("Constructor " ++ name ++ ": " ++ e)
  | Ok s1 ->
      check_pattern_list(state, env, s1, eff_subst, ctor_param_types(ctor_type), fields)

fn ctor_result_type(t: types.Type) -> types.Type =
  match t with
  | types.TFunc _ ret _ -> ctor_result_type(ret)
  | _ -> t

fn ctor_param_types(t: types.Type) -> List types.Type =
  match t with
  | types.TFunc p rest _ -> Cons(p, ctor_param_types(rest))
  | _ -> Nil

# ---------------------------------------------------------------------------
# Extend environment from a pattern's bound variables
# ---------------------------------------------------------------------------

export fn extend_env_from_pattern(pat: ast.Pattern, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match pat with
  | ast.VarPattern name _ ->
      dict_set(name, types.mono(unifier.apply_subst(subst, types.TVar(name))), env)
  | ast.TuplePattern pats _ -> extend_env_from_pattern_list(pats, subst, env)
  | ast.ConstructorPattern _ fields _ -> extend_env_from_pattern_list(fields, subst, env)
  | _ -> env

fn extend_env_from_pattern_list(pats: List ast.Pattern, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match pats with
  | Nil -> env
  | Cons h t -> extend_env_from_pattern_list(t, subst, extend_env_from_pattern(h, subst, env))

# ---------------------------------------------------------------------------
# Do expression
# ---------------------------------------------------------------------------

fn infer_do(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  steps: List ast.DoStep,
  pos: source.SourcePos
) -> InferResult !{IO} =
  infer_do_steps(state, env, subst, eff_subst, steps, dummy_unit(), Nil, types.EffectPure, pos)

fn infer_do_steps(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  steps: List ast.DoStep,
  last_typed: typed_ast.TypedExpr,
  acc_steps: List typed_ast.TypedDoStep,
  acc_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match steps with
  | Nil ->
      InferOk(
        typed_ast.TDo(typed_do_step_list_reverse(acc_steps),
                      typed_ast.typed_expr_type(last_typed), pos),
        subst, eff_subst, acc_eff)
  | Cons step rest ->
      do
        sr <- infer_do_step(state, env, subst, eff_subst, step)
        match sr with
        | InferErr e -> InferErr(e)
        | InferOk typed_step_expr s1 es1 step_eff ->
            infer_do_steps(
              state,
              extend_env_from_do_step(step, typed_ast.typed_expr_type(typed_step_expr), s1, env),
              s1, es1, rest, typed_step_expr,
              Cons(do_step_to_typed(step, typed_step_expr), acc_steps),
              merge_effects(acc_eff, step_eff), pos)

fn infer_do_step(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  step: ast.DoStep
) -> InferResult !{IO} =
  match step with
  | ast.DoExprStep e -> infer_expr(state, env, subst, eff_subst, e)
  | ast.DoBindStep _ e -> infer_expr(state, env, subst, eff_subst, e)
  | ast.DoLetStep _ e -> infer_expr(state, env, subst, eff_subst, e)

fn do_step_to_typed(step: ast.DoStep, typed_expr: typed_ast.TypedExpr) -> typed_ast.TypedDoStep =
  match step with
  | ast.DoExprStep _ -> typed_ast.TDoExprStep(typed_expr)
  | ast.DoBindStep pat _ -> typed_ast.TDoBindStep(pat, typed_expr)
  | ast.DoLetStep name _ -> typed_ast.TDoLetStep(name, typed_expr)

fn do_unwrap_type(t: types.Type) -> types.Type =
  match t with
  | types.TApp outer inner ->
      match outer with
      | types.TConst name ->
          if name == "Maybe" then inner else t
      | types.TApp outer2 _ ->
          match outer2 with
          | types.TConst name ->
              if name == "Result" then inner else t
          | _ -> t
      | _ -> t
  | _ -> t

fn extend_env_from_do_step(step: ast.DoStep, step_type: types.Type, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match step with
  | ast.DoBindStep pat _ ->
      extend_env_from_pattern_typed(pat, do_unwrap_type(unifier.apply_subst(subst, step_type)), subst, env)
  | ast.DoLetStep name _ ->
      dict_set(name, types.mono(unifier.apply_subst(subst, step_type)), env)
  | ast.DoExprStep _ -> env

fn extend_env_from_pattern_typed(pat: ast.Pattern, t: types.Type, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match pat with
  | ast.VarPattern name _ -> dict_set(name, types.mono(t), env)
  | _ -> extend_env_from_pattern(pat, subst, env)

# ---------------------------------------------------------------------------
# Lambda expression
# ---------------------------------------------------------------------------

fn infer_lambda(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  params: List ast.Param,
  body: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    fresh_params <- make_fresh_param_types(state, params)
    br <- infer_expr(state, extend_env_with_params(params, fresh_params, env), subst, eff_subst, body)
    match br with
    | InferErr e -> InferErr(e)
    | InferOk typed_body s1 es1 body_eff ->
        InferOk(
          typed_ast.TLambda(params, typed_body,
            build_fn_type(fresh_params, typed_ast.typed_expr_type(typed_body)), pos),
          s1, es1, body_eff)

fn make_fresh_param_types(state: unifier.InferState, params: List ast.Param) -> List types.Type !{IO} =
  match params with
  | Nil -> Nil
  | Cons _ rest ->
      do
        v <- unifier.fresh(state)
        rest_types <- make_fresh_param_types(state, rest)
        Cons(types.TVar(v), rest_types)

fn extend_env_with_params(params: List ast.Param, param_types: List types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match (params, param_types) with
  | (Nil, _) -> env
  | (_, Nil) -> env
  | (Cons p rest_p, Cons t rest_t) ->
      match p with
      | ast.Param name _ -> extend_env_with_params(rest_p, rest_t, dict_set(name, types.mono(t), env))

# ---------------------------------------------------------------------------
# Record inference
# ---------------------------------------------------------------------------

fn register_record_fields(
  rec_name: String,
  type_params: List String,
  fields: List ast.RecordFieldDecl,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  register_record_fields_loop(rec_name, type_params, fields,
    build_record_local_vars(rec_name, type_params, dict_empty()), env)

fn build_record_local_vars(rec_name: String, type_params: List String, acc: Dict types.Type) -> Dict types.Type =
  match type_params with
  | Nil -> acc
  | Cons p rest ->
      build_record_local_vars(rec_name, rest,
        dict_set(p, types.TVar(str_concat(rec_name, str_concat(".", p))), acc))

fn register_record_fields_loop(
  rec_name: String,
  type_params: List String,
  fields: List ast.RecordFieldDecl,
  local_vars: Dict types.Type,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  match fields with
  | Nil -> env
  | Cons field rest ->
      match field with
      | ast.RecordFieldDecl fname ftype ->
          register_record_fields_loop(rec_name, type_params, rest, local_vars,
            dict_set(
              str_concat("@rec:", str_concat(rec_name, str_concat(":", fname))),
              make_record_field_scheme(rec_name, type_params, type_from_ast(ftype, local_vars)),
              env))

fn make_record_field_scheme(rec_name: String, type_params: List String, field_t: types.Type) -> types.Scheme =
  types.Scheme(
    list_map(\p -> str_concat(rec_name, str_concat(".", p)), type_params),
    Nil, field_t, types.EffectPure)

fn infer_record_expr(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  type_name: String,
  fields: List ast.RecordField,
  pos: source.SourcePos
) -> InferResult !{IO} =
  infer_record_fields(state, env, subst, eff_subst, type_name, fields, Nil, types.EffectPure, pos)

fn infer_record_fields(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  type_name: String,
  fields: List ast.RecordField,
  acc_fields: List typed_ast.TypedRecordField,
  acc_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match fields with
  | Nil ->
      InferOk(
        typed_ast.TRecord(type_name,
                          typed_record_field_list_reverse(acc_fields),
                          types.TConst(type_name), pos),
        subst, eff_subst, acc_eff)
  | Cons field rest_fields ->
      match field with
      | ast.RecordField fname fexpr ->
          do
            r <- infer_expr(state, env, subst, eff_subst, fexpr)
            match r with
            | InferErr e -> InferErr(e)
            | InferOk typed_val s1 es1 val_eff ->
                match dict_get(str_concat("@rec:", str_concat(type_name, str_concat(":", fname))), env) with
                | Nothing -> InferErr("Unknown record type or field: " ++ type_name ++ "." ++ fname)
                | Just field_scheme ->
                    do
                      field_t <- unifier.instantiate(state, field_scheme)
                      match unifier.unify_types(s1, typed_ast.typed_expr_type(typed_val), field_t) with
                      | Err e -> InferErr("Record field type mismatch: " ++ e)
                      | Ok s2 ->
                          infer_record_fields(state, env, s2, es1, type_name, rest_fields,
                            Cons(typed_ast.TypedRecordField(fname, typed_val), acc_fields),
                            merge_effects(acc_eff, val_eff), pos)

fn infer_get_field(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  rec_expr: ast.Expr,
  field_name: String,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    r <- infer_expr(state, env, subst, eff_subst, rec_expr)
    match r with
    | InferErr e -> InferErr(e)
    | InferOk typed_rec s1 es1 rec_eff ->
        get_field_from_resolved(state, env, s1, es1,
          unifier.apply_subst(s1, typed_ast.typed_expr_type(typed_rec)),
          typed_rec, field_name, rec_eff, pos)

fn get_field_from_resolved(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  resolved: types.Type,
  typed_rec: typed_ast.TypedExpr,
  field_name: String,
  rec_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match resolved with
  | types.TConst rec_name ->
      lookup_record_field_typed(state, env, subst, eff_subst, rec_name, Nil, typed_rec, field_name, rec_eff, pos)
  | types.TApp _ _ ->
      lookup_record_field_typed(state, env, subst, eff_subst,
        extract_tconst_name(resolved), extract_tapp_args(resolved),
        typed_rec, field_name, rec_eff, pos)
  | _ ->
      do
        v <- unifier.fresh(state)
        InferOk(typed_ast.TGetField(typed_rec, field_name, types.TVar(v), pos), subst, eff_subst, rec_eff)

fn extract_tconst_name(t: types.Type) -> String =
  match t with
  | types.TConst name -> name
  | types.TApp base _ -> extract_tconst_name(base)
  | _ -> "Unknown"

fn extract_tapp_args(t: types.Type) -> List types.Type =
  list_reverse(collect_tapp_args(t, Nil))

fn collect_tapp_args(t: types.Type, acc: List types.Type) -> List types.Type =
  match t with
  | types.TApp base arg -> collect_tapp_args(base, Cons(arg, acc))
  | _ -> acc

fn lookup_record_field_typed(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  rec_name: String,
  type_args: List types.Type,
  typed_rec: typed_ast.TypedExpr,
  field_name: String,
  rec_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match dict_get(str_concat("@rec:", str_concat(rec_name, str_concat(":", field_name))), env) with
  | Nothing ->
      do
        v <- unifier.fresh(state)
        InferOk(typed_ast.TGetField(typed_rec, field_name, types.TVar(v), pos), subst, eff_subst, rec_eff)
  | Just field_scheme ->
      do
        field_t <- unifier.instantiate(state, field_scheme)
        InferOk(
          typed_ast.TGetField(typed_rec, field_name,
            apply_type_args_to_field(field_t, field_scheme, rec_name, type_args), pos),
          subst, eff_subst, rec_eff)

fn apply_type_args_to_field(
  field_t: types.Type,
  field_scheme: types.Scheme,
  rec_name: String,
  type_args: List types.Type
) -> types.Type =
  match field_scheme with
  | types.Scheme qvars _ _ _ ->
      unifier.apply_subst(build_tvar_subst(qvars, type_args, dict_empty()), field_t)

fn build_tvar_subst(vars: List String, args: List types.Type, acc: Dict types.Type) -> Dict types.Type =
  match (vars, args) with
  | (Nil, _) -> acc
  | (_, Nil) -> acc
  | (Cons v rest_v, Cons a rest_a) ->
      build_tvar_subst(rest_v, rest_a, dict_set(v, a, acc))

# ---------------------------------------------------------------------------
# Range expression (new)
# ---------------------------------------------------------------------------

fn infer_range(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  lo: ast.Expr,
  hi: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    lr <- infer_expr(state, env, subst, eff_subst, lo)
    match lr with
    | InferErr e -> InferErr(e)
    | InferOk typed_lo s1 es1 lo_eff ->
        do
          hr <- infer_expr(state, env, s1, es1, hi)
          match hr with
          | InferErr e -> InferErr(e)
          | InferOk typed_hi s2 es2 hi_eff ->
              match unifier.unify_types(s2, typed_ast.typed_expr_type(typed_lo), types.type_int()) with
              | Err e -> InferErr("Range needs Int: " ++ e)
              | Ok s3 ->
                  match unifier.unify_types(s3, typed_ast.typed_expr_type(typed_hi), types.type_int()) with
                  | Err e -> InferErr("Range needs Int: " ++ e)
                  | Ok s4 ->
                      InferOk(
                        typed_ast.TRange(typed_lo, typed_hi,
                          types.TApp(types.TConst("List"), types.type_int()), pos),
                        s4, es2, merge_effects(lo_eff, hi_eff))

# ---------------------------------------------------------------------------
# Program-level typechecking
# ---------------------------------------------------------------------------

export fn typecheck_decls(
  state: unifier.InferState,
  decls: List ast.Decl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect
) -> typed_ast.TypedResult !{IO} =
  typecheck_decls_inner(state, decls, env, subst, eff_subst, dict_empty(), Nil)

fn typecheck_decls_inner(
  state: unifier.InferState,
  decls: List ast.Decl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  alias_env: Dict types.Type,
  acc: List typed_ast.TypedDecl
) -> typed_ast.TypedResult !{IO} =
  match decls with
  | Nil ->
      typed_ast.TypedOk(
        typed_ast.TypedProgram(typed_decl_list_reverse(acc)),
        env)
  | Cons decl rest ->
      match decl with
      | ast.AliasDecl name Nil rhs_te _ ->
          typecheck_decls_inner(state, rest, env, subst, eff_subst,
            dict_set(name, type_from_ast(rhs_te, dict_empty()), alias_env),
            Cons(typed_ast.TPassThrough(decl), acc))
      | _ ->
          do
            r <- typecheck_decl(state, decl, env, subst, eff_subst, alias_env)
            match r with
            | TypedDeclErr e -> typed_ast.TypedErr(e)
            | TypedDeclOk typed_decl new_env ->
                typecheck_decls_inner(state, rest, new_env, subst, eff_subst, alias_env,
                  Cons(typed_decl, acc))

fn typecheck_decl(
  state: unifier.InferState,
  decl: ast.Decl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  alias_env: Dict types.Type
) -> TypedDeclResult !{IO} =
  match decl with
  | ast.TypeDecl _ _ _ _ ->
      TypedDeclOk(typed_ast.TPassThrough(decl), register_type_decl(decl, env))
  | ast.RecordDecl rec_name type_params fields _ ->
      TypedDeclOk(typed_ast.TPassThrough(decl), register_record_fields(rec_name, type_params, fields, env))
  | ast.FnDecl name params ret_type_maybe effects_maybe constraints _ _ ->
      do
        r <- check_fn_body(state, decl, env, subst, eff_subst, alias_env)
        match r with
        | typed_ast.BodyErr e -> TypedDeclErr(e)
        | typed_ast.BodyLenient ->
            TypedDeclOk(
              typed_ast.TFnDecl(name, params, ret_type_maybe, effects_maybe, constraints,
                                dummy_unit()),
              dict_set(name, scheme_from_fn_parts(params, ret_type_maybe, effects_maybe, alias_env), env))
        | typed_ast.BodyOk typed_body ->
            TypedDeclOk(
              typed_ast.TFnDecl(name, params, ret_type_maybe, effects_maybe, constraints, typed_body),
              dict_set(name, scheme_from_fn_parts(params, ret_type_maybe, effects_maybe, alias_env), env))
  | ast.LetDecl name expr _ ->
      do
        r <- infer_expr(state, env, subst, eff_subst, expr)
        match r with
        | InferErr e -> TypedDeclErr(e)
        | InferOk typed_expr s1 _ _ ->
            TypedDeclOk(
              typed_ast.TLetDecl(name, typed_expr),
              dict_set(name,
                unifier.generalize(unifier.ftv_env(env), s1, eff_subst,
                  typed_ast.typed_expr_type(typed_expr), types.EffectPure),
                env))
  | ast.AliasDecl _ _ _ _ ->
      TypedDeclOk(typed_ast.TPassThrough(decl), env)
  | ast.ClassDecl class_name type_params methods _ ->
      TypedDeclOk(typed_ast.TPassThrough(decl),
        register_class_methods(type_params, methods,
          register_class_method_markers(class_name, methods, env)))
  | ast.InstanceDecl constraint inst_constraints methods _ ->
      do
        r <- check_instance_methods(state, inst_constraints, methods, env, subst, eff_subst)
        match r with
        | typed_ast.InstanceMethodsErr e -> TypedDeclErr(e)
        | typed_ast.InstanceMethodsOk typed_methods ->
            TypedDeclOk(
              typed_ast.TInstanceDecl(constraint, inst_constraints, typed_methods),
              register_instance_marker(constraint, env))

# ---------------------------------------------------------------------------
# FnDecl body inference
# ---------------------------------------------------------------------------

fn check_fn_body(
  state: unifier.InferState,
  decl: ast.Decl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  alias_env: Dict types.Type
) -> typed_ast.BodyResult !{IO} =
  match decl with
  | ast.FnDecl name params ret_type_maybe effects_maybe constraints body _ ->
      do
        (inst_type, prog_to_fresh) <- unifier.instantiate_with_vars(state, scheme_from_fn_parts(params, ret_type_maybe, effects_maybe, alias_env))
        let fwd_env = seed_forward_markers(constraints, prog_to_fresh, env)
        br <- infer_expr(state, fn_body_env(name, params, inst_type, fwd_env), subst, eff_subst, body)
        match br with
        | InferErr msg -> fn_body_err(name, msg)
        | InferOk typed_body s1 _ _ ->
            match unifier.unify_types(s1, typed_ast.typed_expr_type(typed_body), ctor_result_type(inst_type)) with
            | Err e -> typed_ast.BodyErr("Return type mismatch in " ++ name ++ ": " ++ e)
            | Ok _ -> typed_ast.BodyOk(typed_body)
  | _ -> typed_ast.BodyOk(dummy_unit())

fn fn_body_env(name: String, params: List ast.Param, inst_type: types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  extend_env_with_params(
    params,
    ctor_param_types(inst_type),
    dict_set(name, types.mono(inst_type), env)
  )

fn fn_body_err(name: String, msg: String) -> typed_ast.BodyResult =
  if is_unknown_ref(msg)
  then typed_ast.BodyLenient
  else typed_ast.BodyErr(msg ++ " in function " ++ name)

fn is_unknown_ref(msg: String) -> Bool =
  str_starts_with(msg, "Unknown variable: ") ||
  str_starts_with(msg, "Unknown constructor: ")

# ---------------------------------------------------------------------------
# ClassDecl: method registration + constraint markers
# ---------------------------------------------------------------------------

fn register_class_methods(type_params: List String, methods: List ast.ClassMethodSig, env: Dict types.Scheme) -> Dict types.Scheme =
  match methods with
  | Nil -> env
  | Cons sig rest ->
      register_class_methods(type_params, rest, register_class_method(type_params, sig, env))

fn register_class_method(type_params: List String, sig: ast.ClassMethodSig, env: Dict types.Scheme) -> Dict types.Scheme =
  match sig with
  | ast.ClassMethodSig name params ret_type effects_maybe ->
      dict_set(name, scheme_from_fn_parts_inner(type_params, params, Just(ret_type), effects_maybe, dict_empty()), env)

fn register_class_method_markers(class_name: String, methods: List ast.ClassMethodSig, env: Dict types.Scheme) -> Dict types.Scheme =
  match methods with
  | Nil -> env
  | Cons sig rest ->
      match sig with
      | ast.ClassMethodSig name _ _ _ ->
          register_class_method_markers(class_name, rest,
            dict_set("@class:" ++ name, types.mono(types.TConst(class_name)), env))

# ---------------------------------------------------------------------------
# InstanceDecl: instance marker registration
# ---------------------------------------------------------------------------

fn register_instance_marker(constraint: ast.TypeConstraint, env: Dict types.Scheme) -> Dict types.Scheme =
  match constraint with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> env
      | Cons head_te _ ->
          dict_set(
            "@inst:" ++ class_name ++ ":" ++ type_head_str(type_from_ast(head_te, dict_empty())),
            types.mono(types.TConst("Unit")),
            env
          )

# ---------------------------------------------------------------------------
# InstanceDecl: instance method body checking
# ---------------------------------------------------------------------------

fn check_instance_methods(
  state: unifier.InferState,
  inst_constraints: List ast.TypeConstraint,
  methods: List ast.InstanceMethodImpl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect
) -> typed_ast.InstanceMethodsResult !{IO} =
  check_instance_methods_acc(state, inst_constraints, methods, env, subst, eff_subst, Nil)

fn check_instance_methods_acc(
  state: unifier.InferState,
  inst_constraints: List ast.TypeConstraint,
  methods: List ast.InstanceMethodImpl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  acc: List typed_ast.TypedInstanceMethod
) -> typed_ast.InstanceMethodsResult !{IO} =
  match methods with
  | Nil -> typed_ast.InstanceMethodsOk(typed_method_list_reverse(acc))
  | Cons method rest ->
      do
        r <- check_instance_method(state, inst_constraints, method, env, subst, eff_subst)
        match r with
        | InstanceMethodErr e -> typed_ast.InstanceMethodsErr(e)
        | InstanceMethodOk typed_method ->
            check_instance_methods_acc(state, inst_constraints, rest, env, subst, eff_subst, Cons(typed_method, acc))

fn check_instance_method(
  state: unifier.InferState,
  inst_constraints: List ast.TypeConstraint,
  method: ast.InstanceMethodImpl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect
) -> InstanceMethodResult !{IO} =
  match method with
  | ast.InstanceMethodImpl name params ret_maybe eff_maybe body ->
      do
        (inst_type, prog_to_fresh) <- unifier.instantiate_with_vars(state, scheme_from_fn_parts(params, ret_maybe, eff_maybe, dict_empty()))
        let fwd_env = seed_forward_markers(inst_constraints, prog_to_fresh, env)
        br <- infer_expr(state, extend_env_with_params(params, ctor_param_types(inst_type), fwd_env), subst, eff_subst, body)
        match br with
        | InferErr msg -> instance_method_err(name, msg)
        | InferOk typed_body s1 _ _ ->
            match unifier.unify_types(s1, typed_ast.typed_expr_type(typed_body), ctor_result_type(inst_type)) with
            | Err e -> InstanceMethodErr("Return type mismatch in instance method " ++ name ++ ": " ++ e)
            | Ok _ ->
                InstanceMethodOk(
                  typed_ast.TypedInstanceMethod(name, params, ret_maybe, eff_maybe, typed_body))

fn instance_method_err(name: String, msg: String) -> InstanceMethodResult =
  if is_unknown_ref(msg)
  then InstanceMethodOk(
    typed_ast.TypedInstanceMethod(name, Nil, Nothing, Nothing, dummy_unit()))
  else InstanceMethodErr(msg ++ " in instance method " ++ name)
