module stdlib.compiler.infer
import stdlib.compiler.ast as ast
import stdlib.compiler.types as types
import stdlib.compiler.unifier as unifier
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.source as source
import stdlib.string as string

# ---------------------------------------------------------------------------
# Env wraps — GlobalEnv vs raw body-scope Dict types.Scheme
# ---------------------------------------------------------------------------
#
# GlobalEnv is the environment that flows BETWEEN declarations: it accumulates
# scheme entries for declared values, plus @eta_fwd:* markers folded in at
# the end of each constrained FnDecl (see fold_fwd_markers).
#
# A raw Dict types.Scheme is used for body-scope environments that may also
# carry @fwd:* markers (added by seed_forward_markers inside check_fn_body).
# These markers are scoped to a single function body — they MUST NEVER flow
# back into the GlobalEnv. The wrap encodes this invariant at the type
# level: any value typed GlobalEnv is guaranteed to be a between-decl env,
# and converting a body-scope Dict into a GlobalEnv requires an explicit
# constructor call.
#
# Background: retros/2026-05-30-0037.md documents a bug caused by folding
# @fwd: entries directly into the global env. With GlobalEnv distinct from
# raw Dict, the same code pattern requires an explicit `GlobalEnv(body_dict)`
# conversion, which is loud and reviewable.

wrap GlobalEnv = Dict types.Scheme

# Unwrap GlobalEnv to its underlying Dict.  Used at the boundary to call
# raw-Dict helpers (dict_get / dict_set / etc.); the result must be wrapped
# back as GlobalEnv if it flows between decls.
fn global_env_dict(env: GlobalEnv) -> Dict types.Scheme =
  match env with | GlobalEnv d -> d

# ---------------------------------------------------------------------------
# Type-variable name wraps — ProgVarName vs FreshTVarName
# ---------------------------------------------------------------------------
#
# Two semantically distinct kinds of type-variable identifier share the
# underlying String representation, and confusing them is a documented
# bug class (retros/2026-05-29-constrained-dict-injection-cascade.md).
#
# ProgVarName is the type variable name the programmer wrote in source —
# for example "a" in `fn foo(x: a) -> a where MyShow a`. These names appear
# in `ast.TypeName` nodes and as the keys of `prog_to_fresh` (the
# instantiation mapping from programmer vars to fresh TVars). Functions
# that resolve typeclass obligations look up by ProgVarName because that
# is the name visible in the source constraint.
#
# FreshTVarName is the compiler-generated unique name produced by
# `unifier.fresh` during type instantiation — for example "a42". These
# names appear inside `types.TVar` and are used as the key prefix in
# @fwd:* and @eta_fwd:* env markers (e.g. "@fwd:a42:MyShow"). They are
# globally unique within a single InferState.
#
# The translation between the two kinds goes through `prog_to_fresh`:
# `dict_get(prog_var, prog_to_fresh)` returns the `TVar(fresh_name)` that
# the programmer's `a` was instantiated to.
#
# Mixing the two kinds is a silent failure mode: a lookup keyed by
# ProgVarName against a marker stored under FreshTVarName misses, falling
# through to a fallback that may inject the wrong dict. The wrap makes
# the swap a compile error at the function-signature boundary.

wrap ProgVarName = String
wrap FreshTVarName = String

# Unwrap helpers — used at the boundary to compose marker keys via string
# concatenation, or to look up by name in raw Dicts.
fn prog_var_str(p: ProgVarName) -> String =
  match p with | ProgVarName s -> s

fn fresh_tvar_str(f: FreshTVarName) -> String =
  match f with | FreshTVarName s -> s

# ---------------------------------------------------------------------------
# Inference result types
# ---------------------------------------------------------------------------

export type InferResult (..) =
  | InferOk typed_ast.TypedExpr (Dict types.Type) (Dict types.Effect) types.Effect
  | InferErr source.SourcePos String

type InferArgsResult =
  | ArgsOk (List typed_ast.TypedExpr) (Dict types.Type) (Dict types.Effect) types.Effect
  | ArgsErr source.SourcePos String

type CallResult =
  | CallOk types.Type (Dict types.Type) (Dict types.Effect) types.Effect
  | CallErr source.SourcePos String

# Internal per-decl result (not exported; callers see TypedResult).
# The env field is GlobalEnv because each typecheck_decl produces the
# between-decl environment that the next decl will see.
type TypedDeclResult =
  | TypedDeclOk typed_ast.TypedDecl GlobalEnv (List String)
  | TypedDeclErr source.SourcePos String

# Internal single-method result.
type InstanceMethodResult =
  | InstanceMethodOk typed_ast.TypedInstanceMethod
  | InstanceMethodErr source.SourcePos String

# ---------------------------------------------------------------------------
# Type-expression → Type
# ---------------------------------------------------------------------------

export fn type_from_ast(te: ast.TypeExpr, local_vars: Dict types.Type) -> types.Type =
  match te with
  | ast.TypeName name -> lookup_type_var(name, local_vars)
  | ast.TypeApply base arg ->
      types.TApp(type_from_ast(base, local_vars), type_from_ast(arg, local_vars))
  | ast.TypeArrow param ret _ ->
      types.TFunc(type_from_ast(param, local_vars), type_from_ast(ret, local_vars), types.EffectPure)
  | ast.TypeEffect inner _ -> type_from_ast(inner, local_vars)
  | ast.TupleType parts -> types.TTuple(type_list_from_ast(parts, local_vars))

fn lookup_type_var(name: String, local_vars: Dict types.Type) -> types.Type =
  match dict_get(name, local_vars) with
  | Just t -> t
  # Module-qualified type identity (T7): return the bundler's already-canonical
  # name verbatim. Stripping here collapsed `main.Foo` and a prelude `Foo` to one
  # identity. The prelude's canonical form is unqualified (empty module header), so
  # this is a no-op on dotless names and only preserves genuine module prefixes.
  | Nothing -> types.TConst(name)

fn type_list_from_ast(parts: List ast.TypeExpr, local_vars: Dict types.Type) -> List types.Type =
  match parts with
  | Nil -> Nil
  | Cons h t -> Cons(type_from_ast(h, local_vars), type_list_from_ast(t, local_vars))

export fn effect_from_maybe_labels(labels: Maybe (List String)) -> types.Effect =
  match labels with
  | Nothing -> types.EffectPure
  | Just ls ->
      match ls with
      | Nil -> types.EffectPure
      | Cons label rest ->
          match rest with
          | Nil ->
              if label == "IO" then types.EffectIO
              else types.EffectVar(label)
          | _ -> types.EffectRow(ls)

# ---------------------------------------------------------------------------
# Build a Scheme from a FnDecl
# ---------------------------------------------------------------------------

fn scheme_from_fn_parts(
  params: List ast.Param,
  ret_type_maybe: Maybe ast.TypeExpr,
  effects_maybe: Maybe (List String),
  alias_env: Dict types.Type
) -> types.Scheme =
  scheme_from_fn_parts_inner(
    collect_ret_type_vars(ret_type_maybe, collect_param_type_vars(params, Nil)),
    params,
    ret_type_maybe,
    effects_maybe,
    alias_env
  )

fn list_add_unique(x: String, xs: List String) -> List String =
  if types.list_member(x, xs) then xs else append(xs, Cons(x, Nil))

fn collect_param_type_vars(params: List ast.Param, acc: List String) -> List String =
  match params with
  | Nil -> acc
  | Cons p rest ->
      match p with
      | ast.Param name maybe_type ->
          match maybe_type with
          | Nothing -> collect_param_type_vars(rest, list_add_unique("_unann_" ++ name, acc))
          | Just te -> collect_param_type_vars(rest, collect_te_vars(te, acc))

fn collect_te_vars(te: ast.TypeExpr, acc: List String) -> List String =
  match te with
  | ast.TypeName name ->
      if is_lowercase_name(name) then list_add_unique(name, acc) else acc
  | ast.TypeApply base arg ->
      collect_te_vars(arg, collect_te_vars(base, acc))
  | ast.TypeArrow param ret _ ->
      collect_te_vars(ret, collect_te_vars(param, acc))
  | ast.TypeEffect inner _ -> collect_te_vars(inner, acc)
  | ast.TupleType parts -> collect_te_vars_list(parts, acc)

fn collect_te_vars_list(parts: List ast.TypeExpr, acc: List String) -> List String =
  match parts with
  | Nil -> acc
  | Cons h t -> collect_te_vars_list(t, collect_te_vars(h, acc))

fn is_lowercase_name(name: String) -> Bool =
  str_find(name, ".") == -1 &&
  (c == "a" || c == "b" || c == "c" || c == "d" || c == "e" ||
   c == "f" || c == "g" || c == "h" || c == "i" || c == "j" ||
   c == "k" || c == "l" || c == "m" || c == "n" || c == "o" ||
   c == "p" || c == "q" || c == "r" || c == "s" || c == "t" ||
   c == "u" || c == "v" || c == "w" || c == "x" || c == "y" || c == "z")
  where c = str_slice(name, 0, 1)

# A call whose callee is a data constructor (uppercase head), not a function.
# Constructor applications of values are syntactic values; function calls are not.
fn is_constructor_ref(name: String) -> Bool =
  is_lowercase_name(string.after_last_dot(name)) == false

# Syntactic value restriction (W3/F-VALRESTR): only generalize a top-level `let`
# whose initializer is a syntactic value — a literal, variable, lambda, tuple of
# values, or constructor applied to values. A function/if/match/do/... initializer
# is monomorphic. Without this, `let cell = mutvec_new(1, Nil)` generalized to
# `forall a. MutVec (List a)` and could be written at Int and read at String.
fn is_syntactic_value(expr: ast.Expr) -> Bool =
  match expr with
  | ast.IntExpr _ _ -> true
  | ast.FloatExpr _ _ -> true
  | ast.BoolExpr _ _ -> true
  | ast.StringExpr _ _ -> true
  | ast.CharExpr _ _ -> true
  | ast.UnitExpr _ -> true
  | ast.VarExpr _ _ -> true
  | ast.LambdaExpr _ _ _ -> true
  | ast.TupleExpr items _ -> all_syntactic_values(items)
  | ast.CallExpr callee args _ ->
      match callee with
      | ast.VarExpr name _ -> is_constructor_ref(name) && all_syntactic_values(args)
      | _ -> false
  | _ -> false

fn all_syntactic_values(exprs: List ast.Expr) -> Bool =
  match exprs with
  | Nil -> true
  | Cons h t -> if is_syntactic_value(h) then all_syntactic_values(t) else false

fn collect_ret_type_vars(ret_type_maybe: Maybe ast.TypeExpr, acc: List String) -> List String =
  match ret_type_maybe with
  | Nothing -> list_add_unique("_unann", acc)
  | Just te -> collect_te_vars(te, acc)

fn build_type_var_dict(vars: List String, acc: Dict types.Type) -> Dict types.Type =
  match vars with
  | Nil -> acc
  | Cons name rest -> build_type_var_dict(rest, dict_set(name, types.TVar(name), acc))

fn scheme_from_fn_parts_inner(
  type_params: List String,
  params: List ast.Param,
  ret_type_maybe: Maybe ast.TypeExpr,
  effects_maybe: Maybe (List String),
  alias_env: Dict types.Type
) -> types.Scheme =
  types.Scheme(
    type_params,
    Nil,
    build_fn_type(param_types_from_decl(params, local_vars), ret_from_maybe_with_vars(ret_type_maybe, local_vars)),
    effect_from_maybe_labels(effects_maybe)
  )
  where local_vars = build_type_var_dict(type_params, alias_env)

fn param_types_from_decl(params: List ast.Param, local_vars: Dict types.Type) -> List types.Type =
  match params with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.Param name maybe_type ->
          match maybe_type with
          | Nothing -> Cons(types.TVar("_unann_" ++ name), param_types_from_decl(rest, local_vars))
          | Just te -> Cons(type_from_ast(te, local_vars), param_types_from_decl(rest, local_vars))

fn ret_from_maybe_with_vars(maybe_te: Maybe ast.TypeExpr, local_vars: Dict types.Type) -> types.Type =
  match maybe_te with
  | Nothing -> types.TVar("_unann")
  | Just te -> type_from_ast(te, local_vars)

fn build_fn_type(params: List types.Type, ret: types.Type) -> types.Type =
  match params with
  | Nil -> ret
  | Cons p rest -> types.TFunc(p, build_fn_type(rest, ret), types.EffectPure)

# ---------------------------------------------------------------------------
# Constructor registration
# ---------------------------------------------------------------------------

export fn register_type_decl(decl: ast.Decl, env: GlobalEnv) -> GlobalEnv =
  GlobalEnv(register_type_decl_raw(decl, global_env_dict(env)))

# Raw variant operating on Dict, used internally where the env is still
# unwrapped (e.g. inside check_fn_body for body-scope auxiliaries).
fn register_type_decl_raw(decl: ast.Decl, env: Dict types.Scheme) -> Dict types.Scheme =
  match decl with
  | ast.TypeDecl name params ctors _ _ ->
      register_ctors_for_type(name, params, build_local_params(params, dict_empty()), ctors, env)
  # WrapDecl: synthesize a single-constructor type with the same name as the
  # wrap. The constructor's argument type is the wrap's inner type. This gives
  # the typechecker a scheme `inner -> Foo` for Foo(x), and a destructor entry
  # for `match | Foo x ->`.  Zero type parameters by design (the inner type
  # may itself be polymorphic, but Foo always has the same representation).
  | ast.WrapDecl name inner _ ->
      register_ctors_for_type(name, Nil, dict_empty(),
        Cons(ast.TypeConstructor(name, Cons(inner, Nil)), Nil), env)
  | _ -> env

fn build_local_params(params: List String, acc: Dict types.Type) -> Dict types.Type =
  match params with
  | Nil -> acc
  | Cons p rest -> build_local_params(rest, dict_set(p, types.TVar(p), acc))

fn build_result_type(name: String, params: List String) -> types.Type =
  apply_type_params(types.TConst(name), params)

fn apply_type_params(base: types.Type, params: List String) -> types.Type =
  match params with
  | Nil -> base
  | Cons p rest -> apply_type_params(types.TApp(base, types.TVar(p)), rest)

fn register_ctors_for_type(
  type_name: String,
  type_params: List String,
  local_vars: Dict types.Type,
  ctors: List ast.TypeConstructor,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  match ctors with
  | Nil -> env
  | Cons ctor rest ->
      register_ctors_for_type(
        type_name, type_params, local_vars, rest,
        register_one_ctor(ctor, type_params, local_vars, build_result_type(type_name, type_params), env)
      )

fn register_one_ctor(
  ctor: ast.TypeConstructor,
  type_params: List String,
  local_vars: Dict types.Type,
  result_type: types.Type,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  match ctor with
  | ast.TypeConstructor name fields ->
      dict_set(
        name,
        types.Scheme(type_params, Nil, ctor_fn_type(fields, local_vars, result_type), types.EffectPure),
        env
      )

fn ctor_fn_type(fields: List ast.TypeExpr, local_vars: Dict types.Type, result: types.Type) -> types.Type =
  match fields with
  | Nil -> result
  | Cons f rest ->
      types.TFunc(type_from_ast(f, local_vars), ctor_fn_type(rest, local_vars, result), types.EffectPure)

fn build_ctor_map(decls: List ast.Decl, acc: Dict (List String)) -> Dict (List String) =
  match decls with
  | Nil -> acc
  | Cons decl rest ->
      match decl with
      # Key by the bare type name: scrutinee types resolve to bare names via
      # lookup_type_var (TConst(after_last_dot(...))), so the ctor map must agree
      # or lookups for own-module ADTs (keyed `main.C`, looked up as `C`) miss.
      | ast.TypeDecl name _ ctors _ _ ->
          build_ctor_map(rest, dict_set(name, collect_ctor_names(ctors, Nil), acc))
      # WrapDecl: a single synthetic constructor with the same name as the type.
      | ast.WrapDecl name _ _ ->
          build_ctor_map(rest, dict_set(name, Cons(name, Nil), acc))
      | _ -> build_ctor_map(rest, acc)

fn collect_ctor_names(ctors: List ast.TypeConstructor, acc: List String) -> List String =
  match ctors with
  | Nil -> acc
  | Cons ctor rest ->
      match ctor with
      | ast.TypeConstructor name _ -> collect_ctor_names(rest, Cons(name, acc))

# ---------------------------------------------------------------------------
# Effect merging
# ---------------------------------------------------------------------------

fn merge_effects(a: types.Effect, b: types.Effect) -> types.Effect =
  match (a, b) with
  | (types.EffectIO, _) -> types.EffectIO
  | (_, types.EffectIO) -> types.EffectIO
  | (types.EffectPure, other) -> other
  | (other, types.EffectPure) -> other
  | _ -> a

# ---------------------------------------------------------------------------
# List helpers (type-specific reverse functions)
# ---------------------------------------------------------------------------

fn list_reverse(xs: List types.Type) -> List types.Type =
  list_rev_acc(xs, Nil)

fn list_rev_acc(xs: List types.Type, acc: List types.Type) -> List types.Type =
  match xs with
  | Nil -> acc
  | Cons h t -> list_rev_acc(t, Cons(h, acc))

fn typed_expr_list_reverse(xs: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  typed_expr_rev_acc(xs, Nil)

fn typed_expr_rev_acc(xs: List typed_ast.TypedExpr, acc: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  match xs with
  | Nil -> acc
  | Cons h t -> typed_expr_rev_acc(t, Cons(h, acc))

fn typed_branch_list_reverse(xs: List typed_ast.TypedMatchBranch) -> List typed_ast.TypedMatchBranch =
  typed_branch_rev_acc(xs, Nil)

fn typed_branch_rev_acc(xs: List typed_ast.TypedMatchBranch, acc: List typed_ast.TypedMatchBranch) -> List typed_ast.TypedMatchBranch =
  match xs with
  | Nil -> acc
  | Cons h t -> typed_branch_rev_acc(t, Cons(h, acc))

fn typed_do_step_list_reverse(xs: List typed_ast.TypedDoStep) -> List typed_ast.TypedDoStep =
  typed_do_step_rev_acc(xs, Nil)

fn typed_do_step_rev_acc(xs: List typed_ast.TypedDoStep, acc: List typed_ast.TypedDoStep) -> List typed_ast.TypedDoStep =
  match xs with
  | Nil -> acc
  | Cons h t -> typed_do_step_rev_acc(t, Cons(h, acc))

fn typed_record_field_list_reverse(xs: List typed_ast.TypedRecordField) -> List typed_ast.TypedRecordField =
  typed_record_field_rev_acc(xs, Nil)

fn typed_record_field_rev_acc(xs: List typed_ast.TypedRecordField, acc: List typed_ast.TypedRecordField) -> List typed_ast.TypedRecordField =
  match xs with
  | Nil -> acc
  | Cons h t -> typed_record_field_rev_acc(t, Cons(h, acc))

fn typed_decl_list_reverse(xs: List typed_ast.TypedDecl) -> List typed_ast.TypedDecl =
  typed_decl_rev_acc(xs, Nil)

fn typed_decl_rev_acc(xs: List typed_ast.TypedDecl, acc: List typed_ast.TypedDecl) -> List typed_ast.TypedDecl =
  match xs with
  | Nil -> acc
  | Cons h t -> typed_decl_rev_acc(t, Cons(h, acc))

fn typed_method_list_reverse(xs: List typed_ast.TypedInstanceMethod) -> List typed_ast.TypedInstanceMethod =
  typed_method_rev_acc(xs, Nil)

fn typed_method_rev_acc(xs: List typed_ast.TypedInstanceMethod, acc: List typed_ast.TypedInstanceMethod) -> List typed_ast.TypedInstanceMethod =
  match xs with
  | Nil -> acc
  | Cons h t -> typed_method_rev_acc(t, Cons(h, acc))

fn dummy_pos() -> source.SourcePos = source.SourcePos(0, 0, 0)

fn dummy_unit() -> typed_ast.TypedExpr =
  typed_ast.TUnit(types.TConst("Unit"), dummy_pos())

# ---------------------------------------------------------------------------
# Expression inference
# ---------------------------------------------------------------------------

fn infer_expr(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expr: ast.Expr
) -> InferResult !{IO} =
  match expr with
  | ast.IntExpr v pos -> InferOk(typed_ast.TInt(v, types.type_int(), pos), subst, eff_subst, types.EffectPure)
  | ast.FloatExpr text pos -> InferOk(typed_ast.TFloat(text, types.type_double(), pos), subst, eff_subst, types.EffectPure)
  | ast.BoolExpr v pos -> InferOk(typed_ast.TBool(v, types.type_bool(), pos), subst, eff_subst, types.EffectPure)
  | ast.StringExpr v pos -> InferOk(typed_ast.TString(v, types.type_string(), pos), subst, eff_subst, types.EffectPure)
  | ast.CharExpr v pos -> InferOk(typed_ast.TChar(v, types.type_char(), pos), subst, eff_subst, types.EffectPure)
  | ast.UnitExpr pos -> InferOk(typed_ast.TUnit(types.TConst("Unit"), pos), subst, eff_subst, types.EffectPure)
  | ast.VarExpr name pos -> infer_var(state, env, subst, eff_subst, name, pos)
  | ast.IfExpr cond then_ else_ pos -> infer_if(state, env, subst, eff_subst, cond, then_, else_, pos)
  | ast.CallExpr callee args pos -> infer_call(state, env, subst, eff_subst, callee, args, pos)
  | ast.MatchExpr scrut branches pos -> infer_match(state, env, subst, eff_subst, scrut, branches, pos)
  | ast.TupleExpr elems pos -> infer_tuple(state, env, subst, eff_subst, elems, pos)
  | ast.BinaryExpr op left right pos -> infer_binary(state, env, subst, eff_subst, op, left, right, pos)
  | ast.UnaryExpr op operand pos -> infer_unary(state, env, subst, eff_subst, op, operand, pos)
  | ast.DoExpr steps pos -> infer_do(state, env, subst, eff_subst, steps, pos)
  | ast.LambdaExpr params body pos -> infer_lambda(state, env, subst, eff_subst, params, body, pos)
  | ast.RecordExpr type_name fields pos ->
      infer_record_expr(state, env, subst, eff_subst, type_name, fields, pos)
  | ast.GetFieldExpr rec_expr field_name pos ->
      infer_get_field(state, env, subst, eff_subst, rec_expr, field_name, pos)
  | ast.IntRangeExpr lo hi pos -> infer_range(state, env, subst, eff_subst, lo, hi, pos)
  | ast.StringTemplateExpr _ pos ->
      InferErr(pos, "Internal error: StringTemplateExpr reached inference; desugar pass should have eliminated it")

# Declaration-boundary wrapper: applies s1 to the result so fresh TVars
# never escape into lowering.  Declaration-level callers should use this;
# sub-expression recursion stays on infer_expr.
export fn typecheck_expr(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expr: ast.Expr
) -> InferResult !{IO} =
  do
    r <- infer_expr(state, env, subst, eff_subst, expr)
    match r with
    | InferErr _ _ -> r
    | InferOk typed_expr s1 eff_subst2 eff ->
        InferOk(apply_subst_typed_expr(s1, typed_expr), s1, eff_subst2, eff)

# --- Variable ---

# A value-position reference to a class method (`@class:{name}` marker present)
# becomes a TMethodRef carrying the class name, so lowering can eta-expand it
# against the final substituted type and fill its dictionary from Evidence.
# Callee-position methods never reach here — infer_call_var builds their TVar
# directly.  Detection precision is not load-bearing yet: both the TVar and
# TMethodRef lowering arms run the same eta reconstruction until M3b-4b.
fn value_var_node(name: String, t: types.Type, pos: source.SourcePos, env: Dict types.Scheme) -> typed_ast.TypedExpr =
  match dict_get("@class:" ++ name, env) with
  | Nothing -> typed_ast.TVar(name, t, pos)
  | Just marker ->
      match marker with
      | types.Scheme _ _ class_type _ ->
          match class_type with
          | types.TConst class_name ->
              typed_ast.TMethodRef(name, class_name, t, pos, typed_ast.EvUnresolved)
          | _ -> typed_ast.TVar(name, t, pos)

fn infer_var(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  name: String,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match dict_get(name, env) with
  | Nothing -> InferErr(pos, "Unknown variable: " ++ name)
  | Just scheme ->
      do
        t <- unifier.instantiate(state, scheme)
        InferOk(value_var_node(name, t, pos, env), subst, eff_subst, types.EffectPure)

# --- If ---

fn infer_if(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  cond: ast.Expr,
  then_: ast.Expr,
  else_: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    cr <- infer_expr(state, env, subst, eff_subst, cond)
    match cr with
    | InferErr pos e -> InferErr(pos, e)
    | InferOk typed_cond s1 es1 cond_eff ->
        infer_if_checked(state, env, s1, es1, typed_cond, cond_eff, then_, else_, pos)

fn infer_if_checked(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  typed_cond: typed_ast.TypedExpr,
  cond_eff: types.Effect,
  then_: ast.Expr,
  else_: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match unifier.unify_types(subst, typed_ast.typed_expr_type(typed_cond), types.type_bool()) with
  | Err e -> InferErr(pos, "If condition must be Bool: " ++ e)
  | Ok s2 ->
      do
        tr <- infer_expr(state, env, s2, eff_subst, then_)
        match tr with
        | InferErr pos e -> InferErr(pos, e)
        | InferOk typed_then s3 es3 then_eff ->
            do
              er <- infer_expr(state, env, s3, es3, else_)
              match er with
              | InferErr pos e -> InferErr(pos, e)
              | InferOk typed_else s4 es4 else_eff ->
                  infer_if_merge(s4, es4, typed_cond, typed_then, typed_else,
                                 cond_eff, then_eff, else_eff, pos)

fn infer_if_merge(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  typed_cond: typed_ast.TypedExpr,
  typed_then: typed_ast.TypedExpr,
  typed_else: typed_ast.TypedExpr,
  cond_eff: types.Effect,
  then_eff: types.Effect,
  else_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match unifier.unify_types(subst, typed_ast.typed_expr_type(typed_then), typed_ast.typed_expr_type(typed_else)) with
  | Err e -> InferErr(pos, "If branches must have same type: " ++ e)
  | Ok s5 ->
      InferOk(
        typed_ast.TIf(typed_cond, typed_then, typed_else,
                      unifier.apply_subst(s5, typed_ast.typed_expr_type(typed_then)), pos),
        s5, eff_subst,
        merge_effects(cond_eff, merge_effects(then_eff, else_eff))
      )

# --- Call ---

# True for tuple types `(a, b, …)`.  Used to route `print` of a tuple through
# its `ToString` instance (see infer_print_call).
fn is_tuple_type(t: types.Type) -> Bool =
  match t with
  | types.TTuple _ -> true
  | _ -> false

fn infer_call(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  callee: ast.Expr,
  args: List ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match callee with
  | ast.VarExpr name cpos ->
      if name == "print" then
        infer_print_call(state, env, subst, eff_subst, callee, cpos, args, pos)
      else
        infer_call_var(state, env, subst, eff_subst, callee, name, cpos, args, pos)
  | _ ->
      do
        cr <- infer_expr(state, env, subst, eff_subst, callee)
        match cr with
        | InferErr pos e -> InferErr(pos, e)
        | InferOk typed_callee s1 es1 callee_eff ->
            infer_call_inner(state, env, s1, es1, callee, typed_callee, callee_eff, dict_empty(), args, pos)

# Infer a call whose callee is a bare variable `name` (the common case).
fn infer_call_var(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  callee: ast.Expr,
  name: String,
  cpos: source.SourcePos,
  args: List ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match dict_get(name, env) with
  | Nothing -> InferErr(cpos, "Unknown variable: " ++ name)
  | Just scheme ->
      do
        (t, prog_to_fresh) <- unifier.instantiate_with_vars(state, scheme)
        infer_call_inner(state, env, subst, eff_subst, callee,
          typed_ast.TVar(name, t, cpos), types.EffectPure, prog_to_fresh, args, pos)

# `print` is a type-erased runtime renderer, so it cannot recover per-element
# types of a tuple (a Bool prints as 1, a static-String element as its raw
# pointer).  When the single argument is a tuple, rewrite `print(t)` to
# `print(to_string(t))` so the tuple's `ToString` instance renders each element
# via its own instance.  Inference then resolves the (possibly nested) element
# dictionaries for free.  Non-tuple arguments keep the intrinsic `print` path
# (so `print(Int)`/`print(String)` need no prelude — importless-safe).
#
# The argument is inferred once here only to read its type; that result is
# discarded (InferState accumulates no constraints — evidence lives in the
# returned AST), and the rewritten call re-infers it normally.
fn infer_print_call(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  callee: ast.Expr,
  cpos: source.SourcePos,
  args: List ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match args with
  | Cons single Nil ->
      do
        pr <- infer_expr(state, env, subst, eff_subst, single)
        match pr with
        | InferErr _ _ ->
            infer_call_var(state, env, subst, eff_subst, callee, "print", cpos, args, pos)
        | InferOk targ s_peek _ _ ->
            if is_tuple_type(unifier.apply_subst(s_peek, typed_ast.typed_expr_type(targ))) then
              infer_call_var(state, env, subst, eff_subst, callee, "print", cpos,
                Cons(ast.CallExpr(ast.VarExpr("to_string", cpos), Cons(single, Nil), pos), Nil), pos)
            else
              infer_call_var(state, env, subst, eff_subst, callee, "print", cpos, args, pos)
  | _ ->
      infer_call_var(state, env, subst, eff_subst, callee, "print", cpos, args, pos)

fn infer_call_inner(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  callee: ast.Expr,
  typed_callee: typed_ast.TypedExpr,
  callee_eff: types.Effect,
  prog_to_fresh: Dict types.Type,
  args: List ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    ar <- infer_args_acc(state, env, subst, eff_subst, args, Nil, types.EffectPure)
    match ar with
    | ArgsErr pos e -> InferErr(pos, e)
    | ArgsOk typed_args s2 es2 args_eff ->
        do
          v <- unifier.fresh(state)
          r <- infer_call_resolve(
            s2, es2,
            typed_ast.typed_expr_type(typed_callee),
            list_map(\e -> typed_ast.typed_expr_type(e), typed_args),
            types.TVar(v),
            merge_effects(callee_eff, args_eff),
            callee_display_name(callee))
          match r with
          | CallErr pos e -> InferErr(pos, e)
          | CallOk ret_t s3 es3 call_eff ->
              check_call_constraint(callee, typed_callee, typed_args, subst, env, ret_t, s3, es3, call_eff, pos, prog_to_fresh)

fn callee_display_name(callee: ast.Expr) -> String =
  match callee with
  | ast.VarExpr name _ -> "'" ++ name ++ "'"
  | _ -> "expression"

fn infer_call_resolve(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  callee_type: types.Type,
  arg_types: List types.Type,
  ret_type: types.Type,
  eff: types.Effect,
  callee_display: String
) -> CallResult !{IO} =
  match arg_types with
  | Nil ->
      match unifier.apply_subst(subst, callee_type) with
      | types.TFunc _ _ _ -> CallErr(dummy_pos(), callee_display ++ " requires arguments but was called with none")
      | resolved ->
          match unifier.unify_types(subst, resolved, ret_type) with
          | Err e -> CallErr(dummy_pos(), "Call type mismatch: " ++ e)
          | Ok s3 -> CallOk(unifier.apply_subst(s3, ret_type), s3, eff_subst, eff)
  | _ ->
      match unifier.unify_types(subst, callee_type, build_fn_type(arg_types, ret_type)) with
      | Err e -> CallErr(dummy_pos(), "Call type mismatch: " ++ e)
      | Ok s3 -> CallOk(unifier.apply_subst(s3, ret_type), s3, eff_subst, eff)

# --- Constraint checking ---
#
# Class methods are registered under "@class:{method_name}" and instances
# under "@inst:{class_name}:{head_type_str}".  At concrete call sites a
# TDict evidence node is prepended to the argument list.
#
# At polymorphic call sites (first arg is a type variable) the typechecker
# uses forward markers seeded into the env by check_fn_body /
# check_instance_method.  A marker has key "@fwd:{fresh_var}:{class_name}"
# and stores the programmer's type-variable name as TConst in the scheme.
# When the marker is found, a TDict with the programmer-name constraint is
# emitted so the lowering pass can forward the appropriate hidden parameter.

fn check_call_constraint(
  callee: ast.Expr,
  typed_callee: typed_ast.TypedExpr,
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  env: Dict types.Scheme,
  ret_t: types.Type,
  s3: Dict types.Type,
  es3: Dict types.Effect,
  call_eff: types.Effect,
  pos: source.SourcePos,
  prog_to_fresh: Dict types.Type
) -> InferResult !{IO} =
  match callee with
  | ast.VarExpr method_name _ ->
      match dict_get("@class:" ++ method_name, env) with
      | Nothing ->
          inject_constrained_fn_dicts(method_name, 0, prog_to_fresh, env, typed_callee, typed_args, subst, ret_t, s3, es3, call_eff, pos)
      | Just class_marker ->
          check_instance_for_marker(class_marker, method_name, typed_callee, typed_args, subst, env, ret_t, s3, es3, call_eff, pos)
  | _ -> InferOk(typed_ast.TCall(typed_callee, typed_args, ret_t, pos), s3, es3, call_eff)

# Returns true if any class type var appears in any argument of method_type.
# When false, dispatch is by return type — the first-concrete-arg heuristic
# is meaningless (it would pick an irrelevant arg's type) and we must instead
# either resolve from ret_t directly or fall through to @fwd markers.
fn method_dispatch_is_input(method_name: String, class_vars: List String, env: Dict types.Scheme) -> Bool =
  match class_vars with
  | Nil -> true
  | _ ->
      match dict_get(method_name, env) with
      | Nothing -> true
      | Just method_scheme ->
          match method_scheme with
          | types.Scheme _ _ method_type _ -> class_var_in_args(method_type, class_vars)

fn check_instance_for_marker(
  class_marker: types.Scheme,
  method_name: String,
  typed_callee: typed_ast.TypedExpr,
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  env: Dict types.Scheme,
  ret_t: types.Type,
  s3: Dict types.Type,
  es3: Dict types.Effect,
  call_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match class_marker with
  | types.Scheme class_vars _ class_type _ ->
      match class_type with
      | types.TConst class_name ->
          if method_dispatch_is_input(method_name, class_vars, env) then
            # Input-position dispatch. Select the instance by the class-var
            # PARAMETER POSITION (the arg whose declared type mentions a class
            # variable), not by "first concrete arg" — otherwise a leading
            # concrete arg of an unrelated type (e.g. a String `tag`) hijacks the
            # dict (fundamentals review W4 / probe sr_dispatch). head_str and the
            # TDict TypeExpr are both derived from that one arg so they agree.
            match class_var_arg_or_fallback(method_name, class_vars, typed_args, subst, env) with
            | Just cv_arg ->
                match concrete_type_str(unifier.apply_subst(subst, typed_ast.typed_expr_type(cv_arg))) with
                | Nothing ->
                    check_instance_fwd(class_name, typed_callee, typed_args, env, ret_t, s3, es3, call_eff, pos)
                | Just head_str ->
                    match dict_get("@inst:" ++ class_name ++ ":" ++ head_str, env) with
                    | Nothing -> InferErr(pos, "No instance of " ++ class_name ++ " for " ++ head_str)
                    | Just _ ->
                        InferOk(
                          typed_ast.TCall(typed_callee,
                            Cons(typed_ast.TDict(
                              ast.TypeConstraint(class_name, Cons(type_to_typeexpr_with_prog_vars(unifier.apply_subst(subst, typed_ast.typed_expr_type(cv_arg)), class_name, env), Nil)),
                              types.TConst(class_name), pos, typed_ast.EvUnresolved),
                              typed_args),
                            ret_t, pos),
                          s3, es3, call_eff)
            | Nothing ->
                check_instance_fwd(class_name, typed_callee, typed_args, env, ret_t, s3, es3, call_eff, pos)
          else
            # Return-position dispatch — first_concrete_typed_arg_str would pick
            # an irrelevant arg type (e.g. the String input of `deserialize`).
            # Route directly to fwd markers; the post-pass walker
            # (resolve_dispatch_typed_expr) rewrites the TDict once the outer
            # unification has made ret_t concrete.
            check_instance_fwd(class_name, typed_callee, typed_args, env, ret_t, s3, es3, call_eff, pos)
      | _ -> InferOk(typed_ast.TCall(typed_callee, typed_args, ret_t, pos), s3, es3, call_eff)

# Resolve a polymorphic class-method call by scanning args for a @fwd marker.
# First tries direct @fwd:tvar:class lookup for each TVar-headed arg; if none
# match, falls back to scanning env for any @fwd:*:class entry.  This handles
# cases where the constraint's type variable is not the first TVar-headed arg
# (e.g., `fold_values(step: b->a->b, init: b, xs: f a)` — `f` has the @fwd
# marker but `init`'s TVar `b` is found first by the scanner).

fn check_instance_fwd(
  class_name: String,
  typed_callee: typed_ast.TypedExpr,
  typed_args: List typed_ast.TypedExpr,
  env: Dict types.Scheme,
  ret_t: types.Type,
  s3: Dict types.Type,
  es3: Dict types.Effect,
  call_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult =
  match find_fwd_tdict_in_args(class_name, typed_args, env, pos) with
  | Just tdict ->
      InferOk(typed_ast.TCall(typed_callee, Cons(tdict, typed_args), ret_t, pos), s3, es3, call_eff)
  | Nothing ->
      match scan_fwd_markers(class_name, env, pos) with
      | Just tdict ->
          InferOk(typed_ast.TCall(typed_callee, Cons(tdict, typed_args), ret_t, pos), s3, es3, call_eff)
      | Nothing ->
          InferOk(typed_ast.TCall(typed_callee, typed_args, ret_t, pos), s3, es3, call_eff)

# Walk each arg looking for one whose raw TVar head maps to a @fwd marker.
fn find_fwd_tdict_in_args(class_name: String, args: List typed_ast.TypedExpr, env: Dict types.Scheme, pos: source.SourcePos) -> Maybe typed_ast.TypedExpr =
  match args with
  | Nil -> Nothing
  | Cons arg rest ->
      match tvar_head_of_type(typed_ast.typed_expr_type(arg)) with
      | Nothing -> find_fwd_tdict_in_args(class_name, rest, env, pos)
      | Just tvar_name ->
          match dict_get("@fwd:" ++ tvar_name ++ ":" ++ class_name, env) with
          | Just fwd_scheme -> fwd_scheme_to_tdict(fwd_scheme, class_name, pos)
          | Nothing -> find_fwd_tdict_in_args(class_name, rest, env, pos)

# Scan all args for the first whose head type is a concrete constructor (TConst).
# Skips function-typed args (TFunc) and type-variable-headed containers, which
# cannot host a typeclass instance.  This allows class methods whose concrete
# container argument is not the first parameter (e.g. fmap(fn, container)) to
# resolve correctly.
fn first_concrete_typed_arg_str(typed_args: List typed_ast.TypedExpr, subst: Dict types.Type) -> Maybe String =
  match typed_args with
  | Nil -> Nothing
  | Cons first_arg rest ->
      match concrete_type_str(unifier.apply_subst(subst, typed_ast.typed_expr_type(first_arg))) with
      | Nothing -> first_concrete_typed_arg_str(rest, subst)
      | Just s -> Just(s)

# W4 (F-DISPATCH): pick the argument that determines the instance dict by
# CONSTRAINT POSITION. Walk the method's declared parameter chain alongside the
# actual args and return the first arg whose declared parameter type mentions a
# class variable AND has a concrete head. This makes `describe(tag: String,
# x: a)` dispatch on `x` (the class-var parameter), not on the leading `tag`.
# Returning Nothing (no class-var arg is concrete) routes to the @fwd
# polymorphic path, matching the old first-concrete behaviour on that boundary.
fn class_var_arg(
  method_type: types.Type,
  class_vars: List String,
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type
) -> Maybe typed_ast.TypedExpr =
  match method_type with
  | types.TFunc param ret _ ->
      match typed_args with
      | Nil -> Nothing
      | Cons arg rest ->
          if type_contains_var(param, class_vars) then
            match concrete_type_str(unifier.apply_subst(subst, typed_ast.typed_expr_type(arg))) with
            | Just _ -> Just(arg)
            | Nothing -> class_var_arg(ret, class_vars, rest, subst)
          else
            class_var_arg(ret, class_vars, rest, subst)
  | _ -> Nothing

# Position-aware instance-arg selection with a safe fallback: when the method's
# declared type is not in env (cannot locate the class-var position), fall back
# to the historical first-concrete-arg heuristic rather than mis-dispatching.
fn class_var_arg_or_fallback(
  method_name: String,
  class_vars: List String,
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  env: Dict types.Scheme
) -> Maybe typed_ast.TypedExpr =
  match dict_get(method_name, env) with
  | Just method_scheme ->
      match method_scheme with
      | types.Scheme _ _ method_type _ -> class_var_arg(method_type, class_vars, typed_args, subst)
  | Nothing -> first_concrete_typed_arg(typed_args, subst)

# Like first_concrete_typed_arg_str, but returns the arg itself (used as the W4
# fallback so head_str and TypeExpr derive from the same TypedExpr).
fn first_concrete_typed_arg(typed_args: List typed_ast.TypedExpr, subst: Dict types.Type) -> Maybe typed_ast.TypedExpr =
  match typed_args with
  | Nil -> Nothing
  | Cons first_arg rest ->
      match concrete_type_str(unifier.apply_subst(subst, typed_ast.typed_expr_type(first_arg))) with
      | Nothing -> first_concrete_typed_arg(rest, subst)
      | Just _ -> Just(first_arg)

# Like first_concrete_typed_arg_str but skips heads in the excluded list.
# Used when multiple constraints share a class: subsequent constraints skip
# heads already committed to earlier TDict injections.
fn first_concrete_typed_arg_str_excluding(
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  excluded: List String
) -> Maybe String =
  match typed_args with
  | Nil -> Nothing
  | Cons first_arg rest ->
      match concrete_type_str(unifier.apply_subst(subst, typed_ast.typed_expr_type(first_arg))) with
      | Nothing -> first_concrete_typed_arg_str_excluding(rest, subst, excluded)
      | Just s ->
          if str_list_contains(excluded, s) then
            first_concrete_typed_arg_str_excluding(rest, subst, excluded)
          else
            Just(s)

fn str_list_contains(xs: List String, target: String) -> Bool =
  match xs with
  | Nil -> false
  | Cons h rest -> if h == target then true else str_list_contains(rest, target)

# Convert a concrete types.Type to an ast.TypeExpr.
# Only TConst, TApp, and TTuple are meaningful here; anything else falls back to "_".
fn type_to_typeexpr(t: types.Type) -> ast.TypeExpr =
  match t with
  | types.TConst name -> ast.TypeName(string.after_last_dot(name))
  | types.TApp base arg -> ast.TypeApply(type_to_typeexpr(base), type_to_typeexpr(arg))
  | types.TTuple items -> ast.TupleType(list_map(\item -> type_to_typeexpr(item), items))
  | _ -> ast.TypeName("_")

# Returns Just(te) if t has a concrete (TConst) head; Nothing if the head is a TVar.
# TTuple is always concrete (its head is a known arity, never a variable).
fn concrete_typeexpr(t: types.Type) -> Maybe ast.TypeExpr =
  match t with
  | types.TConst name -> Just(ast.TypeName(string.after_last_dot(name)))
  | types.TApp base _ ->
      match concrete_typeexpr(base) with
      | Nothing -> Nothing
      | Just _ -> Just(type_to_typeexpr(t))
  | types.TTuple items -> Just(ast.TupleType(list_map(\item -> type_to_typeexpr(item), items)))
  | _ -> Nothing

# Returns the full concrete ast.TypeExpr for the first concrete arg, or Nothing.
fn first_concrete_typed_arg_typeexpr(
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type
) -> Maybe ast.TypeExpr =
  match typed_args with
  | Nil -> Nothing
  | Cons first_arg rest ->
      match concrete_typeexpr(unifier.apply_subst(subst, typed_ast.typed_expr_type(first_arg))) with
      | Nothing -> first_concrete_typed_arg_typeexpr(rest, subst)
      | Just te -> Just(te)

# Return the full concrete typeexpr for the first typed arg, falling back to TypeName(head_str).
fn first_concrete_arg_typeexpr_or_name(
  head_str: String,
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type
) -> ast.TypeExpr =
  match first_concrete_typed_arg_typeexpr(typed_args, subst) with
  | Just te -> te
  | Nothing -> ast.TypeName(head_str)

# Like first_concrete_arg_typeexpr_or_name but skips args whose head is in excluded.
# Needed so that the TypeConstraint in a TDict records the correct instance type
# when multiple constraints share the same class.
fn first_concrete_arg_typeexpr_or_name_excluding(
  head_str: String,
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  excluded: List String
) -> ast.TypeExpr =
  match first_concrete_typed_arg_typeexpr_excluding(typed_args, subst, excluded) with
  | Just te -> te
  | Nothing -> ast.TypeName(head_str)

fn first_concrete_typed_arg_typeexpr_excluding(
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  excluded: List String
) -> Maybe ast.TypeExpr =
  match typed_args with
  | Nil -> Nothing
  | Cons first_arg rest ->
      match concrete_typeexpr(unifier.apply_subst(subst, typed_ast.typed_expr_type(first_arg))) with
      | Nothing -> first_concrete_typed_arg_typeexpr_excluding(rest, subst, excluded)
      | Just te ->
          if str_list_contains(excluded, te_outermost_name(te)) then
            first_concrete_typed_arg_typeexpr_excluding(rest, subst, excluded)
          else
            Just(te)

# Like first_concrete_arg_typeexpr_or_name, but substitutes programmer type-variable
# names recovered from @fwd markers when the type contains TVars.  This is needed when
# calling a class method on a polymorphic container (e.g. eq(x, y) where x: Maybe a):
# without it, TVar args become TypeName("_") and the lowering's fwd-dict lookup fails.
# Like type_to_typeexpr, but for each TVar looks up @fwd:name:class_name in env
# to recover the programmer-visible variable name (e.g. "a") rather than emitting "_".
fn type_to_typeexpr_with_prog_vars(t: types.Type, class_name: String, env: Dict types.Scheme) -> ast.TypeExpr =
  match t with
  # Module-qualified type identity (T7): keep the canonical (dotted) name. This
  # TypeExpr becomes the injected TDict's constraint head, which resolve.sprout turns
  # into the instance-dispatch Evidence key — stripping here made the key bare
  # ("ToString_Maybe") and mis-resolved a shadowed type to the prelude instance.
  | types.TConst name -> ast.TypeName(name)
  | types.TApp base arg ->
      ast.TypeApply(type_to_typeexpr_with_prog_vars(base, class_name, env),
                    type_to_typeexpr_with_prog_vars(arg, class_name, env))
  | types.TVar name ->
      match dict_get("@fwd:" ++ name ++ ":" ++ class_name, env) with
      | Just scheme ->
          match scheme with
          | types.Scheme _ _ (types.TConst prog_var) _ -> ast.TypeName(prog_var)
          | _ -> ast.TypeName("_")
      | Nothing -> ast.TypeName("_")
  | types.TTuple items ->
      ast.TupleType(list_map(\item -> type_to_typeexpr_with_prog_vars(item, class_name, env), items))
  | _ -> ast.TypeName("_")

# Returns the outermost TVar name from the first arg whose head is a TVar after
# substitution.  Scans all args so that function-typed leading arguments (e.g.
# the fn-arg in fmap(fn, xs)) do not shadow the actual container argument.
#
# NOTE: we use the RAW typed-expr type (no subst application) rather than the
# fully-substituted type.  Pattern inference in infer_tuple_pattern binds the
# original @fwd key (e.g. "t360") to a fresh element variable (e.g. TVar "t364")
# in the subst.  Fully applying the subst would follow that chain and return
# "t364", which has no @fwd marker — the marker was registered for "t360".
# Using the raw type preserves the original TVar name so the @fwd lookup works.
fn first_tvar_head_after_subst(typed_args: List typed_ast.TypedExpr, subst: Dict types.Type) -> Maybe String =
  match typed_args with
  | Nil -> Nothing
  | Cons first_arg rest ->
      match tvar_head_of_type(typed_ast.typed_expr_type(first_arg)) with
      | Just name -> Just(name)
      | Nothing -> first_tvar_head_after_subst(rest, subst)

fn tvar_head_of_type(t: types.Type) -> Maybe String =
  match t with
  | types.TVar name -> Just(name)
  | types.TApp base _ -> tvar_head_of_type(base)
  | _ -> Nothing

fn type_head_str(t: types.Type) -> String =
  match t with
  | types.TConst name -> name
  | types.TApp base _ -> type_head_str(base)
  | types.TVar name -> name
  | types.TTuple items -> "Tuple" ++ int_to_string(list_length(items))
  | _ -> types.type_to_string(t)

# Returns the concrete constructor name (TConst head) of a type, or Nothing if
# the outermost head is a type variable, a function type, or any non-concrete
# form.  Used to look up @inst:{Class}:{head} instance markers.
#
# The full module-qualified name is returned (T7): instance lookups key
# @inst:{Class}:{head} on the canonical identity, matching register_instance_marker
# which derives its head via type_head_str (no strip) over a resolved type. Read and
# write must agree — de-stripping one without the other is a silent dispatch miss.
fn concrete_type_str(t: types.Type) -> Maybe String =
  match t with
  | types.TConst name -> Just(name)
  | types.TApp base _ -> concrete_type_str(base)
  | types.TTuple items -> Just("Tuple" ++ int_to_string(list_length(items)))
  | _ -> Nothing

# Walk a class-method's original scheme type alongside the call-site's
# instantiated type, looking for where the class type variable `class_var`
# lives, and return the substituted concrete type at that position.
# Used by resolve_dispatch_typed_expr (post-pass) to correct dispatch for
# methods whose class type variable appears only in the return type.
fn find_class_var_in_type(orig: types.Type, inst: types.Type, class_var: String) -> Maybe types.Type =
  match orig with
  | types.TVar n ->
      if n == class_var then Just(inst) else Nothing
  | types.TConst _ -> Nothing
  | types.TApp ob oa ->
      match inst with
      | types.TApp ib ia ->
          match find_class_var_in_type(ob, ib, class_var) with
          | Just r -> Just(r)
          | Nothing -> find_class_var_in_type(oa, ia, class_var)
      | _ -> Nothing
  | types.TFunc op orr _ ->
      match inst with
      | types.TFunc ip ir _ ->
          match find_class_var_in_type(op, ip, class_var) with
          | Just r -> Just(r)
          | Nothing -> find_class_var_in_type(orr, ir, class_var)
      | _ -> Nothing
  | types.TTuple oitems ->
      match inst with
      | types.TTuple iitems -> find_class_var_in_tuple_lists(oitems, iitems, class_var)
      | _ -> Nothing

fn find_class_var_in_tuple_lists(os: List types.Type, is: List types.Type, class_var: String) -> Maybe types.Type =
  match os with
  | Nil -> Nothing
  | Cons oh orest ->
      match is with
      | Nil -> Nothing
      | Cons ih irest ->
          match find_class_var_in_type(oh, ih, class_var) with
          | Just r -> Just(r)
          | Nothing -> find_class_var_in_tuple_lists(orest, irest, class_var)

# Walk method scheme's TFunc chain alongside typed args + return, returning
# the substituted concrete type at the position of the class type variable.
fn dispatch_type_walk(
  scheme_type: types.Type,
  typed_args: List typed_ast.TypedExpr,
  ret_t: types.Type,
  subst: Dict types.Type,
  class_var: String
) -> Maybe types.Type =
  match scheme_type with
  | types.TFunc param ret _ ->
      match typed_args with
      | Cons first_arg rest_args ->
          match find_class_var_in_type(param, unifier.apply_subst(subst, typed_ast.typed_expr_type(first_arg)), class_var) with
          | Just t -> Just(t)
          | Nothing -> dispatch_type_walk(ret, rest_args, ret_t, subst, class_var)
      | Nil ->
          find_class_var_in_type(scheme_type, unifier.apply_subst(subst, ret_t), class_var)
  | _ ->
      find_class_var_in_type(scheme_type, unifier.apply_subst(subst, ret_t), class_var)

fn dispatch_type_for_vars(
  scheme_type: types.Type,
  typed_args: List typed_ast.TypedExpr,
  ret_t: types.Type,
  subst: Dict types.Type,
  class_vars: List String
) -> Maybe types.Type =
  match class_vars with
  | Nil -> Nothing
  | Cons v rest ->
      match dispatch_type_walk(scheme_type, typed_args, ret_t, subst, v) with
      | Just t -> Just(t)
      | Nothing -> dispatch_type_for_vars(scheme_type, typed_args, ret_t, subst, rest)

fn contains_str(xs: List String, target: String) -> Bool =
  match xs with
  | Nil -> false
  | Cons h t -> if h == target then true else contains_str(t, target)

fn type_contains_var(t: types.Type, names: List String) -> Bool =
  match t with
  | types.TVar n -> contains_str(names, n)
  | types.TConst _ -> false
  | types.TApp a b -> if type_contains_var(a, names) then true else type_contains_var(b, names)
  | types.TFunc p r _ -> if type_contains_var(p, names) then true else type_contains_var(r, names)
  | types.TTuple items -> tuple_contains_var(items, names)

fn tuple_contains_var(items: List types.Type, names: List String) -> Bool =
  match items with
  | Nil -> false
  | Cons h t -> if type_contains_var(h, names) then true else tuple_contains_var(t, names)

# Returns true if any of `class_vars` appears in any ARG position of method type.
# Used to skip rewriting input-position dispatch (already correct at inference time).
fn class_var_in_args(method_type: types.Type, class_vars: List String) -> Bool =
  match method_type with
  | types.TFunc param ret _ ->
      if type_contains_var(param, class_vars) then true
      else class_var_in_args(ret, class_vars)
  | _ -> false

# --- Constrained-function TDict injection ---
#
# inject_constrained_fn_dicts: when calling a constrained regular function
# (not a class method), look up "@constrained_N:fn_name" markers and inject
# TDict evidence for each constraint, so that lowering.sprout can forward the
# appropriate dict args at the call site.
#
# user_typed_args strips TDict nodes already prepended in earlier iterations so
# that first_concrete_typed_arg_str and first_tvar_head_after_subst only see
# the real user arguments when resolving each constraint.
# Also strips TVar nodes whose names start with "__tc_" — these are materialized
# hidden dict params inserted by the lowering pass (check2 path). Without this
# filter the pre-scan @constrained_N markers cause double-injection in check2.

fn user_typed_args(args: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  match args with
  | Nil -> Nil
  | Cons (typed_ast.TDict _ _ _ _) rest -> user_typed_args(rest)
  | Cons (typed_ast.TVar name t p) rest ->
      if str_starts_with(name, "__tc_") then user_typed_args(rest)
      else Cons(typed_ast.TVar(name, t, p), user_typed_args(rest))
  | Cons e rest -> Cons(e, user_typed_args(rest))

# Collect the head-type strings of already-injected TDict nodes for a given class.
# Used to exclude already-committed heads when resolving subsequent constraints of
# the same class (e.g., both Eq a and Eq b must inject distinct dicts).
fn collect_injected_heads_for_class(class_name: String, typed_args: List typed_ast.TypedExpr) -> List String =
  collect_injected_heads_acc(class_name, typed_args, Nil)

fn collect_injected_heads_acc(class_name: String, typed_args: List typed_ast.TypedExpr, acc: List String) -> List String =
  match typed_args with
  | Nil -> acc
  | Cons arg rest ->
      match arg with
      | typed_ast.TDict (ast.TypeConstraint cn type_args) _ _ _ ->
          if cn == class_name then
            collect_injected_heads_acc(class_name, rest, list_append(acc, Cons(te_head_str(type_args), Nil)))
          else
            collect_injected_heads_acc(class_name, rest, acc)
      | _ -> collect_injected_heads_acc(class_name, rest, acc)

fn te_head_str(type_args: List ast.TypeExpr) -> String =
  match type_args with
  | Nil -> ""
  | Cons te _ -> te_outermost_name(te)

fn te_outermost_name(te: ast.TypeExpr) -> String =
  match te with
  | ast.TypeName n -> n
  | ast.TypeApply base _ -> te_outermost_name(base)
  | _ -> ""

# Iterate over prog_to_fresh VALUES (fresh TVars from instantiation), apply s3 to
# each to get the caller's concrete type, then check for @inst:class:head.
# This finds the right instance for constrained regular functions (e.g., Foldable t
# in join(sep, xs) where xs resolves to Vec) without scanning user_args in order —
# which would pick the wrong dict when non-constrained args have matching instances.
fn scan_prog_to_fresh_for_instance(
  class_name: String,
  prog_to_fresh: Dict types.Type,
  s3: Dict types.Type,
  env: Dict types.Scheme,
  pos: source.SourcePos,
  excluded: List String
) -> Maybe typed_ast.TypedExpr =
  scan_ptf_entries(class_name, vec_to_list(dict_entries(prog_to_fresh)), s3, env, pos, excluded)

fn scan_ptf_entries(
  class_name: String,
  entries: List (String, types.Type),
  s3: Dict types.Type,
  env: Dict types.Scheme,
  pos: source.SourcePos,
  excluded: List String
) -> Maybe typed_ast.TypedExpr =
  match entries with
  | Nil -> Nothing
  | Cons entry rest ->
      match entry with
      | (_, fresh_t) ->
          match concrete_type_str(unifier.apply_subst(s3, fresh_t)) with
          | Nothing -> scan_ptf_entries(class_name, rest, s3, env, pos, excluded)
          | Just head_str ->
              if str_list_contains(excluded, head_str) then
                scan_ptf_entries(class_name, rest, s3, env, pos, excluded)
              else
                match dict_get("@inst:" ++ class_name ++ ":" ++ head_str, env) with
                | Just _ ->
                    Just(typed_ast.TDict(
                      ast.TypeConstraint(class_name, Cons(type_to_typeexpr_with_prog_vars(unifier.apply_subst(s3, fresh_t), class_name, env), Nil)),
                      types.TConst(class_name), pos, typed_ast.EvUnresolved))
                | Nothing ->
                    scan_ptf_entries(class_name, rest, s3, env, pos, excluded)

# Check if a TVar node in `t` has an @fwd marker whose stored prog_var equals `prog_var`.
fn tvar_for_prog_var_in_type(t: types.Type, class_name: String, prog_var: String, env: Dict types.Scheme) -> Bool =
  match t with
  | types.TVar name ->
      match dict_get("@fwd:" ++ name ++ ":" ++ class_name, env) with
      | Just scheme ->
          match scheme with
          | types.Scheme _ _ (types.TConst pv) _ -> pv == prog_var
          | _ -> false
      | Nothing -> false
  | types.TApp base arg ->
      tvar_for_prog_var_in_type(base, class_name, prog_var, env) ||
      tvar_for_prog_var_in_type(arg, class_name, prog_var, env)
  | _ -> false

# Returns true if `t` has at least one inner TVar (i.e., not at the head) that
# anchors to prog_var via a @fwd marker. Used to distinguish "Maybe a" (include)
# from "List String" (skip) when scanning prog_to_fresh for instance lookup.
fn has_inner_tvar_for_prog_var(t: types.Type, class_name: String, prog_var: String, env: Dict types.Scheme) -> Bool =
  match t with
  | types.TApp base arg ->
      tvar_for_prog_var_in_type(arg, class_name, prog_var, env) ||
      has_inner_tvar_for_prog_var(base, class_name, prog_var, env)
  | _ -> false

fn scan_ptf_for_prog_var(
  class_name: String,
  prog_var: String,
  prog_to_fresh: Dict types.Type,
  s3: Dict types.Type,
  env: Dict types.Scheme,
  pos: source.SourcePos,
  excluded: List String
) -> Maybe typed_ast.TypedExpr =
  scan_ptf_prog_var_entries(class_name, prog_var, vec_to_list(dict_entries(prog_to_fresh)), s3, env, pos, excluded)

fn scan_ptf_prog_var_entries(
  class_name: String,
  prog_var: String,
  entries: List (String, types.Type),
  s3: Dict types.Type,
  env: Dict types.Scheme,
  pos: source.SourcePos,
  excluded: List String
) -> Maybe typed_ast.TypedExpr =
  match entries with
  | Nil -> Nothing
  | Cons entry rest ->
      match entry with
      | (_, fresh_t) ->
          match concrete_type_str(unifier.apply_subst(s3, fresh_t)) with
          | Nothing -> scan_ptf_prog_var_entries(class_name, prog_var, rest, s3, env, pos, excluded)
          | Just head_str ->
              if str_list_contains(excluded, head_str) then
                scan_ptf_prog_var_entries(class_name, prog_var, rest, s3, env, pos, excluded)
              else if has_inner_tvar_for_prog_var(unifier.apply_subst(s3, fresh_t), class_name, prog_var, env) then
                match dict_get("@inst:" ++ class_name ++ ":" ++ head_str, env) with
                | Just _ ->
                    Just(typed_ast.TDict(
                      ast.TypeConstraint(class_name, Cons(type_to_typeexpr_with_prog_vars(unifier.apply_subst(s3, fresh_t), class_name, env), Nil)),
                      types.TConst(class_name), pos, typed_ast.EvUnresolved))
                | Nothing ->
                    scan_ptf_prog_var_entries(class_name, prog_var, rest, s3, env, pos, excluded)
              else
                scan_ptf_prog_var_entries(class_name, prog_var, rest, s3, env, pos, excluded)

fn resolve_one_constraint_tdict(
  class_name: String,
  user_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  env: Dict types.Scheme,
  pos: source.SourcePos,
  excluded: List String
) -> Maybe typed_ast.TypedExpr =
  match first_concrete_typed_arg_str_excluding(user_args, subst, excluded) with
  | Just head_str ->
      match dict_get("@inst:" ++ class_name ++ ":" ++ head_str, env) with
      | Just _ ->
          Just(typed_ast.TDict(
            ast.TypeConstraint(class_name, Cons(first_concrete_arg_typeexpr_or_name_excluding(head_str, user_args, subst, excluded), Nil)),
            types.TConst(class_name), pos, typed_ast.EvUnresolved))
      | Nothing ->
          resolve_via_fwd_or_scan(class_name, user_args, subst, env, pos)
  | Nothing ->
      # No non-excluded concrete arg found. This happens when all concrete args have the
      # same type as a prior constraint of the same class (e.g. `where Eq a, Eq b` called
      # with a = b = AlwaysEqual). Fall back without exclusion: the second constraint
      # legitimately needs the same dict as the first.
      match first_concrete_typed_arg_str(user_args, subst) with
      | Just head_str ->
          match dict_get("@inst:" ++ class_name ++ ":" ++ head_str, env) with
          | Just _ ->
              Just(typed_ast.TDict(
                ast.TypeConstraint(class_name, Cons(first_concrete_arg_typeexpr_or_name(head_str, user_args, subst), Nil)),
                types.TConst(class_name), pos, typed_ast.EvUnresolved))
          | Nothing ->
              resolve_via_fwd_or_scan(class_name, user_args, subst, env, pos)
      | Nothing ->
          resolve_via_fwd_or_scan(class_name, user_args, subst, env, pos)

# Try @fwd marker lookup first (direct TVar arg), then fall back to env scan.
# Used when the first concrete-type lookup finds no instance (or no concrete type).
fn resolve_via_fwd_or_scan(
  class_name: String,
  user_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  env: Dict types.Scheme,
  pos: source.SourcePos
) -> Maybe typed_ast.TypedExpr =
  match first_tvar_head_after_subst(user_args, subst) with
  | Just tvar_name ->
      match dict_get("@fwd:" ++ tvar_name ++ ":" ++ class_name, env) with
      | Just fwd_scheme ->
          fwd_scheme_to_tdict(fwd_scheme, class_name, pos)
      | Nothing ->
          # tvar_name not directly in @fwd; fall through to env scan
          scan_fwd_markers(class_name, env, pos)
  | Nothing ->
      # Arg head is not a TVar (e.g., constraint type embedded inside a tuple or
      # container arg). Fall back to scanning env for any @fwd:*:class_name marker
      # seeded for this function's constraints.
      scan_fwd_markers(class_name, env, pos)

# Convert a stored @fwd scheme value to a TDict evidence node.
fn fwd_scheme_to_tdict(fwd_scheme: types.Scheme, class_name: String, pos: source.SourcePos) -> Maybe typed_ast.TypedExpr =
  match fwd_scheme with
  | types.Scheme _ _ (types.TConst prog_var) _ ->
      Just(typed_ast.TDict(
        ast.TypeConstraint(class_name, Cons(ast.TypeName(prog_var), Nil)),
        types.TConst(class_name), pos, typed_ast.EvUnresolved))
  | _ -> Nothing

# Scan all env entries for the first "@fwd:*:class_name" marker.
# Used as a fallback when the constraint type is not visible at the head of any
# argument (e.g., Ord k where k appears inside a tuple argument).
fn scan_fwd_markers(class_name: String, env: Dict types.Scheme, pos: source.SourcePos) -> Maybe typed_ast.TypedExpr =
  scan_fwd_marker_entries(class_name, vec_to_list(dict_entries(env)), pos)

fn scan_fwd_marker_entries(
  class_name: String,
  entries: List (String, types.Scheme),
  pos: source.SourcePos
) -> Maybe typed_ast.TypedExpr =
  match entries with
  | Nil -> Nothing
  | Cons entry rest ->
      match entry with
      | (key, val) ->
          if is_fwd_key_for_class(key, class_name)
          then fwd_scheme_to_tdict(val, class_name, pos)
          else scan_fwd_marker_entries(class_name, rest, pos)

# Check whether an env key is an @fwd marker for the given class.
# Key format: "@fwd:" ++ tvar_name ++ ":" ++ class_name
fn is_fwd_key_for_class(key: String, class_name: String) -> Bool =
  str_starts_with(key, "@fwd:") && str_ends_with_suffix(key, ":" ++ class_name)

fn str_ends_with_suffix(s: String, suffix: String) -> Bool =
  if str_len(s) < str_len(suffix) then false
  else str_slice(s, str_len(s) - str_len(suffix), str_len(s)) == suffix

# When a function has multiple constraints for the same class (e.g. Eq a, Eq b), there are
# two @fwd:*:Eq markers in env — one per prog_var.  resolve_via_fwd_or_scan picks the first
# TVar-headed arg, which is always the same arg, so both obligations resolve to the same dict.
# This function scans markers by prog_var so each constraint gets its own dict.
fn resolve_via_fwd_for_prog_var(
  class_name: String,
  prog_var: String,
  env: Dict types.Scheme,
  pos: source.SourcePos
) -> Maybe typed_ast.TypedExpr =
  scan_fwd_markers_for_prog_var(class_name, prog_var, vec_to_list(dict_entries(env)), pos)

fn scan_fwd_markers_for_prog_var(
  class_name: String,
  prog_var: String,
  entries: List (String, types.Scheme),
  pos: source.SourcePos
) -> Maybe typed_ast.TypedExpr =
  match entries with
  | Nil -> Nothing
  | Cons entry rest ->
      match entry with
      | (key, val) ->
          if is_fwd_key_for_class(key, class_name)
          then
            match val with
            | types.Scheme _ _ (types.TConst stored_prog_var) _ ->
                if stored_prog_var == prog_var
                then Just(typed_ast.TDict(
                       ast.TypeConstraint(class_name, Cons(ast.TypeName(prog_var), Nil)),
                       types.TConst(class_name), pos, typed_ast.EvUnresolved))
                else scan_fwd_markers_for_prog_var(class_name, prog_var, rest, pos)
            | _ -> scan_fwd_markers_for_prog_var(class_name, prog_var, rest, pos)
          else scan_fwd_markers_for_prog_var(class_name, prog_var, rest, pos)

# resolve_obligation: the principled path for constrained regular-function dict injection.
# Uses prog_to_fresh (the instantiation mapping from programmer vars to fresh TVars) to
# find the concrete type for the constraint variable, then looks up the instance.
# Falls back to heuristic resolution if prog_var is not in prog_to_fresh (check2 path,
# or non-VarExpr callee) or if the constraint is still polymorphic after s3 is applied.
#
# When prog_var is absent from prog_to_fresh (mono-scheme call — recursive self-call
# inside a constrained fn body), resolve_via_fwd_for_prog_var is called so that the
# correct @fwd marker is found by prog_var rather than by first-TVar-arg heuristic.
# This matters when multiple constraints share a class (e.g. Eq a, Eq b): scanning by
# prog_var finds the right marker for each obligation independently.
fn resolve_obligation(
  class_name: String,
  prog_var: ProgVarName,
  prog_to_fresh: Dict types.Type,
  s3: Dict types.Type,
  user_args: List typed_ast.TypedExpr,
  env: Dict types.Scheme,
  pos: source.SourcePos,
  excluded: List String
) -> Maybe typed_ast.TypedExpr =
  # Unwrap once at the entry — internal helpers (scan_ptf_for_prog_var,
  # resolve_via_fwd_for_prog_var) operate on raw String, both as dict keys
  # and as content compared against stored prog_var entries.
  match dict_get(prog_var_str(prog_var), prog_to_fresh) with
  | Nothing ->
      match scan_ptf_for_prog_var(class_name, prog_var_str(prog_var), prog_to_fresh, s3, env, pos, excluded) with
      | Just tdict -> Just(tdict)
      | Nothing ->
          match resolve_via_fwd_for_prog_var(class_name, prog_var_str(prog_var), env, pos) with
          | Nothing ->
              match scan_prog_to_fresh_for_instance(class_name, prog_to_fresh, s3, env, pos, excluded) with
              | Just tdict2 -> Just(tdict2)
              | Nothing ->
                  # The constraint variable resolved to a type variable, not a
                  # concrete head (scan_prog_to_fresh_for_instance found no @inst).
                  # A constraint on a forwardable type variable MUST forward the
                  # in-scope dict, never fall to resolve_one_constraint_tdict's
                  # first-concrete-arg heuristic — that grabs an unrelated argument's
                  # instance (e.g. vec_sort's `Ord a` mis-resolving to `Ord (Vec a)`
                  # off the `vec: Vec a` argument, a soundness hole). The @fwd marker
                  # is keyed by the caller's fresh var, not the callee's constraint
                  # var name, so scan for the class's forward marker directly.
                  match scan_fwd_markers(class_name, env, pos) with
                  | Just fwd_tdict -> Just(fwd_tdict)
                  | Nothing -> resolve_one_constraint_tdict(class_name, user_args, s3, env, pos, excluded)
          | fwd -> fwd
  | Just fresh_t ->
      match concrete_type_str(unifier.apply_subst(s3, fresh_t)) with
      | Just head_str ->
          # prog_to_fresh maps this prog_var precisely — trust it even if head_str is
          # in excluded (that means two distinct prog_vars legitimately map to the same
          # concrete type; they need the same dict, not a different one).
          match dict_get("@inst:" ++ class_name ++ ":" ++ head_str, env) with
          | Just _ ->
              Just(typed_ast.TDict(
                ast.TypeConstraint(class_name, Cons(type_to_typeexpr_with_prog_vars(unifier.apply_subst(s3, fresh_t), class_name, env), Nil)),
                types.TConst(class_name), pos, typed_ast.EvUnresolved))
          | Nothing ->
              resolve_via_fwd_or_scan(class_name, user_args, s3, env, pos)
      | Nothing ->
          resolve_via_fwd_or_scan(class_name, user_args, s3, env, pos)

fn inject_constrained_fn_dicts(
  name: String,
  idx: Int,
  prog_to_fresh: Dict types.Type,
  env: Dict types.Scheme,
  typed_callee: typed_ast.TypedExpr,
  typed_args: List typed_ast.TypedExpr,
  subst: Dict types.Type,
  ret_t: types.Type,
  s3: Dict types.Type,
  es3: Dict types.Effect,
  call_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match dict_get("@constrained_" ++ int_to_string(idx) ++ ":" ++ name, env) with
  | Nothing ->
      InferOk(typed_ast.TCall(typed_callee, typed_args, ret_t, pos), s3, es3, call_eff)
  | Just class_marker ->
      match class_marker with
      | types.Scheme _ _ (types.TApp(types.TConst class_name)(types.TConst prog_var)) _ ->
          # Wrap as ProgVarName at the extraction site: this is the programmer's
          # type variable name (from the constraint head), not a compiler-generated
          # fresh TVar name. Confusing these would silently break cascade resolution.
          match resolve_obligation(class_name, ProgVarName(prog_var), prog_to_fresh, s3, user_typed_args(typed_args), env, pos, collect_injected_heads_for_class(class_name, typed_args)) with
          | Nothing ->
              inject_constrained_fn_dicts(name, idx + 1, prog_to_fresh, env, typed_callee, typed_args, subst, ret_t, s3, es3, call_eff, pos)
          | Just tdict ->
              inject_constrained_fn_dicts(name, idx + 1, prog_to_fresh, env, typed_callee, list_append(typed_args, Cons(tdict, Nil)), subst, ret_t, s3, es3, call_eff, pos)
      | types.Scheme _ _ (types.TConst class_name) _ ->
          match resolve_one_constraint_tdict(class_name, user_typed_args(typed_args), subst, env, pos, collect_injected_heads_for_class(class_name, typed_args)) with
          | Nothing ->
              inject_constrained_fn_dicts(name, idx + 1, prog_to_fresh, env, typed_callee, typed_args, subst, ret_t, s3, es3, call_eff, pos)
          | Just tdict ->
              inject_constrained_fn_dicts(name, idx + 1, prog_to_fresh, env, typed_callee, list_append(typed_args, Cons(tdict, Nil)), subst, ret_t, s3, es3, call_eff, pos)
      | _ ->
          inject_constrained_fn_dicts(name, idx + 1, prog_to_fresh, env, typed_callee, typed_args, subst, ret_t, s3, es3, call_eff, pos)

# --- Forward marker helpers ---
#
# seed_forward_markers adds "@fwd:{fresh_var}:{class_name}" entries to env
# for each constraint, enabling polymorphic dispatch in check_instance_for_marker.
# prog_to_fresh maps programmer type-var names (e.g., "a") to their fresh
# instantiation TVars (e.g., TVar("a42")).
# These per-function @fwd: entries are NOT folded into the global env directly.
# Instead, extract_fwd_from_entries rewrites them to "@eta_fwd:" keys so lowering
# can locate the correct forwarded dict slot for value-position eta-expansion
# without colliding with resolve_via_fwd_for_prog_var's @fwd: scans.

fn seed_forward_markers(constraints: List ast.TypeConstraint, prog_to_fresh: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match constraints with
  | Nil -> env
  | Cons c rest ->
      seed_forward_markers(rest, prog_to_fresh, seed_one_constraint_marker(c, prog_to_fresh, env))

fn seed_one_constraint_marker(c: ast.TypeConstraint, prog_to_fresh: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match c with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> env
      | Cons head_te _ ->
          match head_te with
          | ast.TypeName prog_var ->
              match dict_get(prog_var, prog_to_fresh) with
              | Nothing -> env
              | Just fresh_t ->
                  match fresh_t with
                  | types.TVar fresh_name ->
                      # Wrap at the extraction site: prog_var is the user's
                      # constraint-head name (e.g. "a") while fresh_name is the
                      # compiler-generated instantiation name (e.g. "a42").
                      # Store prog_var name in the scheme value for retrieval in check_instance_for_marker.
                      # Also seed @fwd markers for any superclasses registered under @super:class_name:*.
                      seed_fwd_with_supers(class_name, FreshTVarName(fresh_name), ProgVarName(prog_var), env)
                  | _ -> env
          | _ -> env

# Seed the direct @fwd marker and then transitively seed all superclass markers.
# fresh_name and prog_var are wrapped at the boundary: the @fwd:* key is built
# from FreshTVarName (compiler-generated, e.g. "a42") and the scheme value
# stores ProgVarName (user-written, e.g. "a") for later retrieval by
# scan_fwd_markers_for_prog_var.  Confusing the two would silently break
# cascade resolution — the wrap makes the swap a compile error here.
fn seed_fwd_with_supers(class_name: String, fresh_name: FreshTVarName, prog_var: ProgVarName, env: Dict types.Scheme) -> Dict types.Scheme =
  seed_superclass_fwd_markers(class_name, fresh_tvar_str(fresh_name), prog_var_str(prog_var),
    dict_set("@fwd:" ++ fresh_tvar_str(fresh_name) ++ ":" ++ class_name,
             types.mono(types.TConst(prog_var_str(prog_var))), env))

# Seed @fwd markers for all superclasses of class_name.
# Scans env for "@super:{class_name}:{super_name}" entries and adds
# "@fwd:{fresh_name}:{super_name}" for each.
fn seed_superclass_fwd_markers(class_name: String, fresh_name: String, prog_var: String, env: Dict types.Scheme) -> Dict types.Scheme =
  seed_super_from_entries(class_name, fresh_name, prog_var, vec_to_list(dict_entries(env)), env)

fn seed_super_from_entries(class_name: String, fresh_name: String, prog_var: String, entries: List (String, types.Scheme), env: Dict types.Scheme) -> Dict types.Scheme =
  match entries with
  | Nil -> env
  | Cons entry rest ->
      match entry with
      | (key, _) ->
          if str_starts_with(key, "@super:" ++ class_name ++ ":")
          then seed_super_from_entries(class_name, fresh_name, prog_var, rest,
                 dict_set("@fwd:" ++ fresh_name ++ ":" ++ str_slice(key, str_len("@super:" ++ class_name ++ ":"), str_len(key)),
                          types.mono(types.TConst(prog_var)), env))
          else seed_super_from_entries(class_name, fresh_name, prog_var, rest, env)

# Computes the @eta_fwd:* markers that correspond to the @fwd:* entries
# seed_forward_markers seeds. Used by check_fn_body to thread markers to
# lowering without the old extract_fwd_markers(fwd_env) walk, which scanned
# the entire typecheck env per FnDecl regardless of constraint count — the
# dominant cost in self-compile (~32% of total time per `sample` profile).
# Constraint-free decls (~98% of stdlib) now pay zero cost here.
fn compute_eta_fwd_markers(constraints: List ast.TypeConstraint, prog_to_fresh: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  compute_eta_fwd_markers_acc(constraints, prog_to_fresh, env, dict_empty())

fn compute_eta_fwd_markers_acc(constraints: List ast.TypeConstraint, prog_to_fresh: Dict types.Type, env: Dict types.Scheme, markers: Dict types.Scheme) -> Dict types.Scheme =
  match constraints with
  | Nil -> markers
  | Cons c rest ->
      compute_eta_fwd_markers_acc(rest, prog_to_fresh, env, add_eta_for_constraint(c, prog_to_fresh, env, markers))

fn add_eta_for_constraint(c: ast.TypeConstraint, prog_to_fresh: Dict types.Type, env: Dict types.Scheme, markers: Dict types.Scheme) -> Dict types.Scheme =
  match c with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> markers
      | Cons head_te _ ->
          match head_te with
          | ast.TypeName prog_var ->
              match dict_get(prog_var, prog_to_fresh) with
              | Nothing -> markers
              | Just fresh_t ->
                  match fresh_t with
                  | types.TVar fresh_name ->
                      # Wrap at the extraction site (mirror of seed_one_constraint_marker):
                      # the @eta_fwd:* key is built from FreshTVarName, and the scheme
                      # value stores ProgVarName for lowering to retrieve.
                      add_eta_with_supers(class_name, FreshTVarName(fresh_name), ProgVarName(prog_var), env,
                        dict_set("@eta_fwd:" ++ fresh_name ++ ":" ++ class_name,
                                 types.mono(types.TConst(prog_var)), markers))
                  | _ -> markers
          | _ -> markers

# Boundary protection mirrors seed_fwd_with_supers — fresh_name and prog_var
# arrive wrapped, unwrap once for string concat used in the @eta_fwd:* key
# prefix and the scheme-value content.  See the wrap declarations above.
fn add_eta_with_supers(class_name: String, fresh_name: FreshTVarName, prog_var: ProgVarName, env: Dict types.Scheme, markers: Dict types.Scheme) -> Dict types.Scheme =
  add_eta_supers_from_entries(class_name, fresh_tvar_str(fresh_name), prog_var_str(prog_var), vec_to_list(dict_entries(env)), markers)

fn add_eta_supers_from_entries(class_name: String, fresh_name: String, prog_var: String, entries: List (String, types.Scheme), markers: Dict types.Scheme) -> Dict types.Scheme =
  match entries with
  | Nil -> markers
  | Cons entry rest ->
      match entry with
      | (key, _) ->
          if str_starts_with(key, "@super:" ++ class_name ++ ":")
          then add_eta_supers_from_entries(class_name, fresh_name, prog_var, rest,
                 dict_set("@eta_fwd:" ++ fresh_name ++ ":" ++ str_slice(key, str_len("@super:" ++ class_name ++ ":"), str_len(key)),
                          types.mono(types.TConst(prog_var)), markers))
          else add_eta_supers_from_entries(class_name, fresh_name, prog_var, rest, markers)

# --- Args accumulator ---

fn infer_args_acc(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  args: List ast.Expr,
  acc: List typed_ast.TypedExpr,
  acc_eff: types.Effect
) -> InferArgsResult !{IO} =
  match args with
  | Nil -> ArgsOk(typed_expr_list_reverse(acc), subst, eff_subst, acc_eff)
  | Cons arg rest ->
      do
        r <- infer_expr(state, env, subst, eff_subst, arg)
        match r with
        | InferErr pos e -> ArgsErr(pos, e)
        | InferOk typed_arg s1 es1 arg_eff ->
            infer_args_acc(state, env, s1, es1, rest, Cons(typed_arg, acc), merge_effects(acc_eff, arg_eff))

# --- Tuple ---

fn infer_tuple(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  elems: List ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    r <- infer_args_acc(state, env, subst, eff_subst, elems, Nil, types.EffectPure)
    match r with
    | ArgsErr pos e -> InferErr(pos, e)
    | ArgsOk typed_elems s1 es1 eff ->
        InferOk(
          typed_ast.TTuple(typed_elems,
            types.TTuple(list_map(\e -> typed_ast.typed_expr_type(e), typed_elems)), pos),
          s1, es1, eff)

# --- Binary ---

fn infer_binary(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  left: ast.Expr,
  right: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    lr <- infer_expr(state, env, subst, eff_subst, left)
    match lr with
    | InferErr pos e -> InferErr(pos, e)
    | InferOk typed_left s1 es1 l_eff ->
        do
          rr <- infer_expr(state, env, s1, es1, right)
          match rr with
          | InferErr pos e -> InferErr(pos, e)
          | InferOk typed_right s2 es2 r_eff ->
              infer_binary_op(state, env, s2, es2, op, typed_left, typed_right, merge_effects(l_eff, r_eff), pos)

fn infer_binary_op(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  if op == "+" || op == "-" || op == "*" || op == "/" then
    check_arith(subst, eff_subst, op, typed_left, typed_right, eff, pos)
  else if op == "<" || op == "<=" || op == ">" || op == ">=" then
    check_compare(subst, eff_subst, op, typed_left, typed_right, eff, pos)
  else if op == "==" || op == "!=" then
    check_eq(state, env, subst, eff_subst, op, typed_left, typed_right, eff, pos)
  else if op == "&&" || op == "||" then
    check_bool(subst, eff_subst, op, typed_left, typed_right, eff, pos)
  else
    InferOk(typed_ast.TBinary(op, typed_left, typed_right,
                              typed_ast.typed_expr_type(typed_left), pos),
            subst, eff_subst, eff)

fn check_arith(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  # Concrete-only, same-type numeric rule (docs/nn-gap-analysis.md §7.1):
  # unify the operands with each other first, then require the shared type be
  # Int or Double.  Int op Int -> Int; Double op Double -> Double; a mixed
  # Int/Double pair fails the operand unify (no implicit promotion).  `/` stays
  # in this set for Int (truncating) — the deliberate §7.3 divergence.
  match unifier.unify_types(subst, typed_ast.typed_expr_type(typed_left), typed_ast.typed_expr_type(typed_right)) with
  | Err e -> InferErr(pos, op ++ " needs matching numeric operands: " ++ e)
  | Ok s1 ->
      match unifier.unify_types(s1, typed_ast.typed_expr_type(typed_left), types.type_int()) with
      | Ok s2 ->
          InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_int(), pos),
                  s2, eff_subst, eff)
      | Err _ ->
          match unifier.unify_types(s1, typed_ast.typed_expr_type(typed_left), types.type_double()) with
          | Err e -> InferErr(pos, op ++ " needs Int or Double operands: " ++ e)
          | Ok s2 ->
              InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_double(), pos),
                      s2, eff_subst, eff)

fn check_compare(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  # Unify left and right with each other first, then check the result is
  # Int, Char, or Double.  Double comparison (e.g. `x < 0.0`) lowers to an
  # ordered fcmp in the IR (docs/nn-gap-analysis.md §7.1).
  match unifier.unify_types(subst, typed_ast.typed_expr_type(typed_left), typed_ast.typed_expr_type(typed_right)) with
  | Err e -> InferErr(pos, op ++ " needs matching types: " ++ e)
  | Ok s1 ->
      match unifier.unify_types(s1, typed_ast.typed_expr_type(typed_left), types.type_int()) with
      | Ok s2 ->
          InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_bool(), pos),
                  s2, eff_subst, eff)
      | Err _ ->
          match unifier.unify_types(s1, typed_ast.typed_expr_type(typed_left), types.type_char()) with
          | Ok s2 ->
              InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_bool(), pos),
                      s2, eff_subst, eff)
          | Err _ ->
              match unifier.unify_types(s1, typed_ast.typed_expr_type(typed_left), types.type_double()) with
              | Err e -> InferErr(pos, op ++ " needs Int, Char, or Double: " ++ e)
              | Ok s2 ->
                  InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_bool(), pos),
                          s2, eff_subst, eff)

fn is_primitive_eq_type(t: types.Type) -> Bool =
  match t with
  | types.TConst name ->
      # Double joins the direct-fcmp short-circuit: == -> oeq, != -> one (via
      # float_cmp_predicate), matching its already-wired ordering comparisons.
      name == "Int" || name == "Bool" || name == "Char" || name == "String" || name == "Double"
  | _ -> false

fn eq_via_class_method(
  state: unifier.InferState,
  env: Dict types.Scheme,
  op: String,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match dict_get("eq", env) with
  | Nothing -> InferErr(pos, "internal: Eq.eq not in scope for " ++ op ++ " dispatch")
  | Just eq_scheme ->
      do
        callee_t <- unifier.instantiate(state, eq_scheme)
        let typed_callee = typed_ast.TVar("eq", callee_t, pos)
        v <- unifier.fresh(state)
        r <- infer_call_resolve(
          subst, eff_subst,
          callee_t,
          Cons(typed_ast.typed_expr_type(typed_left),
               Cons(typed_ast.typed_expr_type(typed_right), Nil)),
          types.TVar(v),
          eff,
          "'eq'")
        match r with
        | CallErr pos e -> InferErr(pos, op ++ " via Eq.eq: " ++ e)
        | CallOk ret_t s3 es3 call_eff ->
            do
              # prog_to_fresh = dict_empty(): the resolve_dispatch_typed_expr
              # post-pass concretizes the TDict evidence node after s2 makes the
              # type var concrete (PR #18 mechanism).
              call_result <- check_call_constraint(
                ast.VarExpr("eq", pos),
                typed_callee,
                Cons(typed_left, Cons(typed_right, Nil)),
                subst, env, ret_t, s3, es3, call_eff, pos,
                dict_empty())
              if op == "!=" then
                match call_result with
                | InferOk e s4 es4 e_eff ->
                    InferOk(typed_ast.TUnary("!", e, types.type_bool(), pos),
                            s4, es4, e_eff)
                | InferErr pos e -> InferErr(pos, e)
              else
                call_result

# Inference for ==/!=. Primitive operands (Int, Bool, Char, String) lower to
# direct TBinary so codegen emits icmp / str_eq; non-primitive types desugar
# to Eq.eq class-method calls so typeclass dispatch fires (!= wraps the
# resulting call in TUnary "!"). See BACKLOG line 184.
fn check_eq(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match unifier.unify_types(subst, typed_ast.typed_expr_type(typed_left), typed_ast.typed_expr_type(typed_right)) with
  | Err e -> InferErr(pos, op ++ " needs same types: " ++ e)
  | Ok s1 ->
      if is_primitive_eq_type(unifier.apply_subst(s1, typed_ast.typed_expr_type(typed_left))) then
        InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_bool(), pos),
                s1, eff_subst, eff)
      else
        eq_via_class_method(state, env, op, typed_left, typed_right, s1, eff_subst, eff, pos)

fn check_bool(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  typed_left: typed_ast.TypedExpr,
  typed_right: typed_ast.TypedExpr,
  eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match unifier.unify_types(subst, typed_ast.typed_expr_type(typed_left), types.type_bool()) with
  | Err e -> InferErr(pos, op ++ " needs Bool: " ++ e)
  | Ok s1 ->
      match unifier.unify_types(s1, typed_ast.typed_expr_type(typed_right), types.type_bool()) with
      | Err e -> InferErr(pos, op ++ " needs Bool: " ++ e)
      | Ok s2 ->
          InferOk(typed_ast.TBinary(op, typed_left, typed_right, types.type_bool(), pos),
                  s2, eff_subst, eff)

# --- Unary ---

fn infer_unary(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  op: String,
  operand: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    r <- infer_expr(state, env, subst, eff_subst, operand)
    match r with
    | InferErr pos e -> InferErr(pos, e)
    | InferOk typed_operand s1 es1 eff ->
        InferOk(
          typed_ast.TUnary(op, typed_operand, typed_ast.typed_expr_type(typed_operand), pos),
          s1, es1, eff)

# --- Exhaustiveness checking ---

fn extract_adt_name(t: types.Type) -> Maybe String =
  match t with
  | types.TConst name -> Just(name)
  | types.TApp base _ -> extract_adt_name(base)
  | _ -> Nothing

fn is_catchall_pattern(pat: ast.Pattern) -> Bool =
  match pat with
  | ast.WildcardPattern _ -> true
  | ast.VarPattern _ _ -> true
  | _ -> false

# --- Exhaustiveness (W5): per-column value-space coverage ---------------------
#
# `covers(ty, column)` asks whether the patterns in one position ("column")
# exhaust the values of type `ty`.  A match is exhaustive iff its top-level
# branch patterns cover the scrutinee type.  The check is SOUND: it flags only
# genuine holes (a missing column value is a value no branch matches), never a
# valid match.  It over-accepts product gaps like `(true,true)|(false,false)`
# — deep nested-pattern subsumption is explicitly outside the v0 contract
# (spec §10.11); a full usefulness matrix is the deferred v1 end-state.

fn pats_have_catchall(pats: List ast.Pattern) -> Bool =
  match pats with
  | Nil -> false
  | Cons p rest -> if is_catchall_pattern(p) then true else pats_have_catchall(rest)

fn pats_have_bool(pats: List ast.Pattern, want: Bool) -> Bool =
  match pats with
  | Nil -> false
  | Cons p rest ->
      match p with
      | ast.BoolPattern b _ -> if b == want then true else pats_have_bool(rest, want)
      | _ -> pats_have_bool(rest, want)

fn pats_have_unit(pats: List ast.Pattern) -> Bool =
  match pats with
  | Nil -> false
  | Cons p rest ->
      match p with
      | ast.UnitPattern _ -> true
      | _ -> pats_have_unit(rest)

# Bool is a two-value domain; covered iff both true and false appear.
fn bool_gap(pats: List ast.Pattern) -> Maybe String =
  if pats_have_bool(pats, true) == false then Just("true")
  else if pats_have_bool(pats, false) == false then Just("false")
  else Nothing

fn ctor_display(name: String) -> String = string.after_last_dot(name)

# Subpattern-lists of every branch whose head constructor is `name`.
fn ctor_branch_subpats(name: String, pats: List ast.Pattern) -> List (List ast.Pattern) =
  match pats with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.ConstructorPattern n subs _ ->
          if string.after_last_dot(n) == string.after_last_dot(name)
          then Cons(subs, ctor_branch_subpats(name, rest))
          else ctor_branch_subpats(name, rest)
      | _ -> ctor_branch_subpats(name, rest)

fn tuple_branch_subpats(pats: List ast.Pattern) -> List (List ast.Pattern) =
  match pats with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.TuplePattern subs _ -> Cons(subs, tuple_branch_subpats(rest))
      | _ -> tuple_branch_subpats(rest)

# Column i across a set of equal-arity rows: the head of each row, and the tails.
fn column_heads(rows: List (List ast.Pattern)) -> List ast.Pattern =
  match rows with
  | Nil -> Nil
  | Cons row rest ->
      match row with
      | Nil -> column_heads(rest)
      | Cons h _ -> Cons(h, column_heads(rest))

fn column_tails(rows: List (List ast.Pattern)) -> List (List ast.Pattern) =
  match rows with
  | Nil -> Nil
  | Cons row rest ->
      match row with
      | Nil -> column_tails(rest)
      | Cons _ t -> Cons(t, column_tails(rest))


# Field types of constructor `name` when its result is `adt_type`.  Mirrors
# infer_ctor_pattern_typed: instantiate the ctor scheme, unify its result with
# the scrutinee type to bind the type arguments, read the parameter types.
fn ctor_field_types(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  name: String,
  adt_type: types.Type
) -> Maybe (List types.Type) !{IO} =
  match dict_get(name, env) with
  | Nothing -> Nothing
  | Just scheme ->
      do
        ctor_type <- unifier.instantiate(state, scheme)
        match unifier.unify_types(subst, adt_type, ctor_result_type(ctor_type)) with
        | Err _ -> Nothing
        | Ok s1 -> Just(unifier.apply_subst_list(s1, ctor_param_types(ctor_type)))

# Are all field columns of a constructor covered?  Returns the first gap, if any.
fn columns_covered(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  ctor_map: Dict (List String),
  field_types: List types.Type,
  rows: List (List ast.Pattern)
) -> Maybe String !{IO} =
  match field_types with
  | Nil -> Nothing
  | Cons ft ft_rest ->
      # Match the Maybe-!{IO} result directly: a do-block `<-` bind would strip
      # the Maybe layer (project_do_block_result_io_quirk) and misparse below.
      match coverage_gap(state, env, subst, ctor_map, ft, column_heads(rows)) with
      | Just w -> Just(w)
      | Nothing -> columns_covered(state, env, subst, ctor_map, ft_rest, column_tails(rows))

# Nothing = the patterns cover `ty`; Just witness = a value none of them match.
fn coverage_gap(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  ctor_map: Dict (List String),
  ty: types.Type,
  pats: List ast.Pattern
) -> Maybe String !{IO} =
  if pats_have_catchall(pats) then Nothing
  else coverage_gap_resolved(state, env, subst, ctor_map, unifier.apply_subst(subst, ty), pats)

fn coverage_gap_resolved(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  ctor_map: Dict (List String),
  rty: types.Type,
  pats: List ast.Pattern
) -> Maybe String !{IO} =
  match rty with
  | types.TConst name -> coverage_gap_const(state, env, subst, ctor_map, name, rty, pats)
  | types.TApp _ _ -> coverage_gap_adt(state, env, subst, ctor_map, rty, pats)
  | types.TTuple elems -> tuple_gap(state, env, subst, ctor_map, elems, pats)
  # TVar / TFunc / records / anything unresolved: accept (never reject the
  # unanticipated — preserves the historical Nothing-means-exhaustive bias).
  | _ -> Nothing

fn coverage_gap_const(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  ctor_map: Dict (List String),
  name: String,
  rty: types.Type,
  pats: List ast.Pattern
) -> Maybe String !{IO} =
  if name == "Bool" then bool_gap(pats)
  else if name == "Unit" then (if pats_have_unit(pats) then Nothing else Just("()"))
  # Infinite literal domains are exhaustive only via a catch-all (handled above).
  else if name == "Int" then Just("an Int not matched by the listed literals (add a catch-all)")
  else if name == "String" then Just("a String not matched by the listed literals (add a catch-all)")
  else if name == "Char" then Just("a Char not matched by the listed literals (add a catch-all)")
  else coverage_gap_adt(state, env, subst, ctor_map, rty, pats)

fn coverage_gap_adt(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  ctor_map: Dict (List String),
  rty: types.Type,
  pats: List ast.Pattern
) -> Maybe String !{IO} =
  match extract_adt_name(rty) with
  | Nothing -> Nothing
  | Just adt_name ->
      # ctor_map is keyed by bare type name (build_ctor_map), matching the bare
      # names extract_adt_name yields, so a direct lookup resolves every ADT.
      match dict_get(adt_name, ctor_map) with
      | Nothing -> Nothing
      | Just all_ctors -> adt_gap(state, env, subst, ctor_map, all_ctors, rty, pats)

fn adt_gap(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  ctor_map: Dict (List String),
  all_ctors: List String,
  rty: types.Type,
  pats: List ast.Pattern
) -> Maybe String !{IO} =
  match all_ctors with
  | Nil -> Nothing
  | Cons c rest ->
      match ctor_branch_subpats(c, pats) with
      # Constructor never mentioned -> not covered.
      | Nil -> Just(ctor_display(c))
      | Cons row0 rows_rest ->
          # Match Maybe-!{IO} results directly (do-bind would strip the Maybe).
          match ctor_field_types(state, env, subst, c, rty) with
          # Field types unresolvable (e.g. missing scheme): conservatively treat
          # this constructor as covered and move on.
          | Nothing -> adt_gap(state, env, subst, ctor_map, rest, rty, pats)
          | Just fts ->
              match columns_covered(state, env, subst, ctor_map, fts, Cons(row0, rows_rest)) with
              | Just w -> Just(ctor_display(c) ++ "(" ++ w ++ ")")
              | Nothing -> adt_gap(state, env, subst, ctor_map, rest, rty, pats)

fn tuple_gap(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  ctor_map: Dict (List String),
  elem_types: List types.Type,
  pats: List ast.Pattern
) -> Maybe String !{IO} =
  match tuple_branch_subpats(pats) with
  | Nil -> Just("a tuple value not matched")
  | Cons row0 rows_rest ->
      match columns_covered(state, env, subst, ctor_map, elem_types, Cons(row0, rows_rest)) with
      | Just w -> Just("(" ++ w ++ ")")
      | Nothing -> Nothing

fn branch_pats(branches: List typed_ast.TypedMatchBranch) -> List ast.Pattern =
  match branches with
  | Nil -> Nil
  | Cons b rest ->
      match b with
      | typed_ast.TypedMatchBranch pat _ -> Cons(pat, branch_pats(rest))

fn exhaustiveness_check(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  ctor_map: Dict (List String),
  scrut_type: types.Type,
  branches: List typed_ast.TypedMatchBranch
) -> Maybe String !{IO} =
  match coverage_gap(state, env, subst, ctor_map, rty, branch_pats(branches)) with
  | Nothing -> Nothing
  | Just w ->
      Just("Non-exhaustive match on " ++ types.type_to_string(rty) ++
           " — no branch matches " ++ w)
  where rty = unifier.apply_subst(subst, scrut_type)

# --- Unreachable branches (W5): spec §10.12 top-level contract ----------------
#
# A branch is unreachable when the branches BEFORE it already handle every value
# it could match.  Per the v0 contract (spec lines 176-181) this covers exactly:
# shadowed by an earlier catch-all, a repeated top-level literal, a repeat of a
# constructor already fully covered, or any branch after all constructors are
# covered.  Deeper nested subsumption is out of scope.

fn all_catchall(subs: List ast.Pattern) -> Bool =
  match subs with
  | Nil -> true
  | Cons s rest -> if is_catchall_pattern(s) then all_catchall(rest) else false

fn is_literal_pattern(p: ast.Pattern) -> Bool =
  match p with
  | ast.IntPattern _ _ -> true
  | ast.BoolPattern _ _ -> true
  | ast.StringPattern _ _ -> true
  | ast.CharPattern _ _ -> true
  | ast.UnitPattern _ -> true
  | _ -> false

fn same_literal(a: ast.Pattern, b: ast.Pattern) -> Bool =
  match a with
  | ast.IntPattern x _ -> (match b with | ast.IntPattern y _ -> x == y | _ -> false)
  | ast.BoolPattern x _ -> (match b with | ast.BoolPattern y _ -> x == y | _ -> false)
  | ast.StringPattern x _ -> (match b with | ast.StringPattern y _ -> x == y | _ -> false)
  | ast.CharPattern x _ -> (match b with | ast.CharPattern y _ -> x == y | _ -> false)
  | ast.UnitPattern _ -> (match b with | ast.UnitPattern _ -> true | _ -> false)
  | _ -> false

fn literal_in(prefix: List ast.Pattern, pat: ast.Pattern) -> Bool =
  match prefix with
  | Nil -> false
  | Cons p rest -> if same_literal(p, pat) then true else literal_in(rest, pat)

fn prefix_has_full_ctor(prefix: List ast.Pattern, name: String) -> Bool =
  match prefix with
  | Nil -> false
  | Cons p rest ->
      match p with
      | ast.ConstructorPattern n subs _ ->
          if string.after_last_dot(n) == string.after_last_dot(name) then
            (if all_catchall(subs) then true else prefix_has_full_ctor(rest, name))
          else prefix_has_full_ctor(rest, name)
      | _ -> prefix_has_full_ctor(rest, name)

fn ctor_fully_covered_in(prefix: List ast.Pattern, pat: ast.Pattern) -> Bool =
  match pat with
  | ast.ConstructorPattern name _ _ -> prefix_has_full_ctor(prefix, name)
  | _ -> false

fn pat_pos(p: ast.Pattern) -> source.SourcePos =
  match p with
  | ast.WildcardPattern pos -> pos
  | ast.VarPattern _ pos -> pos
  | ast.IntPattern _ pos -> pos
  | ast.BoolPattern _ pos -> pos
  | ast.StringPattern _ pos -> pos
  | ast.CharPattern _ pos -> pos
  | ast.UnitPattern pos -> pos
  | ast.TuplePattern _ pos -> pos
  | ast.ConstructorPattern _ _ pos -> pos

# Sound TOP-LEVEL coverage for the unreachability check.  Unlike exhaustiveness
# (which may over-accept product gaps like `(true,true)|(false,false)`), this
# must never OVER-claim coverage — an over-claim would flag a reachable branch
# as dead (e.g. unify_applied's final `_` after per-column-"covered" tuple
# patterns).  So it uses only sound top-level signals, with NO per-column
# recursion: Bool by both literals, Unit by a unit pattern, an ADT by an
# all-catch-all branch per constructor, a tuple by an all-wildcard tuple
# pattern.  Nested/product unreachability is intentionally out of scope — spec
# v0 §10.12 restricts the unreachable-branch contract to the top level.

fn prefix_has_full_tuple(prefix: List ast.Pattern) -> Bool =
  match prefix with
  | Nil -> false
  | Cons p rest ->
      match p with
      | ast.TuplePattern subs _ -> if all_catchall(subs) then true else prefix_has_full_tuple(rest)
      | _ -> prefix_has_full_tuple(rest)

fn all_ctors_covered(ctors: List String, prefix: List ast.Pattern) -> Bool =
  match ctors with
  | Nil -> true
  | Cons c rest -> if prefix_has_full_ctor(prefix, c) then all_ctors_covered(rest, prefix) else false

fn adt_all_ctors_covered(ctor_map: Dict (List String), adt_name: String, prefix: List ast.Pattern) -> Bool =
  match dict_get(adt_name, ctor_map) with
  | Nothing -> false
  | Just ctors -> all_ctors_covered(ctors, prefix)

fn prefix_covers_toplevel(ctor_map: Dict (List String), scrut_type: types.Type, prefix: List ast.Pattern) -> Bool =
  match scrut_type with
  | types.TConst name ->
      if name == "Bool" then
        (if pats_have_bool(prefix, true) then pats_have_bool(prefix, false) else false)
      else if name == "Unit" then pats_have_unit(prefix)
      else adt_all_ctors_covered(ctor_map, name, prefix)
  | types.TApp _ _ ->
      match extract_adt_name(scrut_type) with
      | Nothing -> false
      | Just nm -> adt_all_ctors_covered(ctor_map, nm, prefix)
  | types.TTuple _ -> prefix_has_full_tuple(prefix)
  | _ -> false

# A branch is dead if its own shape is already handled: a repeated top-level
# literal, or a constructor an earlier branch already fully covers.
fn structurally_shadowed(prefix: List ast.Pattern, pat: ast.Pattern) -> Bool =
  if is_literal_pattern(pat) then literal_in(prefix, pat)
  else ctor_fully_covered_in(prefix, pat)

fn branch_is_unreachable(ctor_map: Dict (List String), scrut_type: types.Type, prefix: List ast.Pattern, pat: ast.Pattern) -> Bool =
  # (1) shadowed by an earlier catch-all; (2) repeated literal / fully-covered
  # constructor; (3) after the scrutinee is already fully covered (top-level).
  if pats_have_catchall(prefix) then true
  else if structurally_shadowed(prefix, pat) then true
  else prefix_covers_toplevel(ctor_map, scrut_type, prefix)

fn unreachable_walk(ctor_map: Dict (List String), scrut_type: types.Type, prefix: List ast.Pattern, remaining: List typed_ast.TypedMatchBranch) -> Maybe (String, source.SourcePos) =
  match remaining with
  | Nil -> Nothing
  | Cons b rest ->
      match b with
      | typed_ast.TypedMatchBranch pat _ ->
          if branch_is_unreachable(ctor_map, scrut_type, prefix, pat)
          then Just(("Unreachable match branch", pat_pos(pat)))
          # Prepend, not append: every prefix consumer is an order-independent
          # membership scan, so O(1) Cons beats O(n) list_append per branch.
          else unreachable_walk(ctor_map, scrut_type, Cons(pat, prefix), rest)

fn unreachable_check(subst: Dict types.Type, ctor_map: Dict (List String), scrut_type: types.Type, branches: List typed_ast.TypedMatchBranch) -> Maybe (String, source.SourcePos) =
  unreachable_walk(ctor_map, unifier.apply_subst(subst, scrut_type), Nil, branches)

# --- Match ---

fn infer_match(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  scrutinee: ast.Expr,
  branches: List ast.MatchBranch,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    sr <- infer_expr(state, env, subst, eff_subst, scrutinee)
    match sr with
    | InferErr pos e -> InferErr(pos, e)
    | InferOk typed_scrut s1 es1 scrut_eff ->
        do
          v <- unifier.fresh(state)
          infer_branches(state, env, s1, es1, typed_scrut, types.TVar(v), branches, Nil, scrut_eff, pos)

fn infer_branches(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  typed_scrut: typed_ast.TypedExpr,
  ret_type: types.Type,
  branches: List ast.MatchBranch,
  acc_branches: List typed_ast.TypedMatchBranch,
  acc_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match branches with
  | Nil ->
      do
        let reversed = typed_branch_list_reverse(acc_branches)
        ctor_map <- unifier.get_ctor_map(state)
        let scrut_ty = typed_ast.typed_expr_type(typed_scrut)
        # Match these Maybe-!{IO} checks directly: a `<-` bind would strip the
        # Maybe layer (project_do_block_result_io_quirk).
        match exhaustiveness_check(state, env, subst, ctor_map, scrut_ty, reversed) with
        | Just err -> InferErr(pos, err)
        | Nothing ->
            match unreachable_check(subst, ctor_map, scrut_ty, reversed) with
            | Just (msg, upos) -> InferErr(upos, msg)
            | Nothing ->
                InferOk(
                  typed_ast.TMatch(typed_scrut, reversed, unifier.apply_subst(subst, ret_type), pos),
                  subst, eff_subst, acc_eff)
  | Cons branch rest ->
      match branch with
      | ast.MatchBranch pat _ ->
          do
            br <- infer_branch(state, env, subst, eff_subst,
                               typed_ast.typed_expr_type(typed_scrut), ret_type, branch)
            match br with
            | InferErr pos e -> InferErr(pos, e)
            | InferOk typed_body s1 es1 branch_eff ->
                infer_branches(state, env, s1, es1, typed_scrut,
                               unifier.apply_subst(s1, ret_type),
                               rest,
                               Cons(typed_ast.TypedMatchBranch(pat, typed_body), acc_branches),
                               merge_effects(acc_eff, branch_eff), pos)

fn infer_branch(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  scrut_type: types.Type,
  ret_type: types.Type,
  branch: ast.MatchBranch
) -> InferResult !{IO} =
  match branch with
  | ast.MatchBranch pat body ->
      do
        pr <- infer_pattern(state, env, subst, eff_subst, scrut_type, pat)
        match pr with
        | InferErr pos e -> InferErr(pos, e)
        | InferOk _ s1 es1 _ ->
            infer_branch_body(state, extend_env_from_pattern(pat, s1, env), s1, es1, ret_type, body)

fn infer_branch_body(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  ret_type: types.Type,
  body: ast.Expr
) -> InferResult !{IO} =
  do
    br <- infer_expr(state, env, subst, eff_subst, body)
    match br with
    | InferErr pos e -> InferErr(pos, e)
    | InferOk typed_body s2 es2 body_eff ->
        infer_branch_unify(s2, es2, typed_body, ret_type, body_eff)

fn infer_branch_unify(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  typed_body: typed_ast.TypedExpr,
  ret_type: types.Type,
  body_eff: types.Effect
) -> InferResult !{IO} =
  match unifier.unify_types(subst, typed_ast.typed_expr_type(typed_body), ret_type) with
  | Err e -> InferErr(dummy_pos(), "Match branch type mismatch: " ++ e)
  | Ok s3 -> InferOk(typed_body, s3, eff_subst, body_eff)

# --- Pattern inference ---
#
# Patterns do not produce meaningful TypedExprs; callers always discard the
# first field of InferOk.  We return a dummy TUnit carrying the pattern type.

export fn infer_pattern(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  pat: ast.Pattern
) -> InferResult !{IO} =
  match pat with
  | ast.WildcardPattern _ ->
      InferOk(typed_ast.TUnit(expected, dummy_pos()), subst, eff_subst, types.EffectPure)
  | ast.VarPattern name _ ->
      InferOk(typed_ast.TUnit(expected, dummy_pos()), dict_set(name, expected, subst), eff_subst, types.EffectPure)
  | ast.IntPattern _ _ ->
      check_pattern_type(subst, eff_subst, expected, types.type_int(), "Int")
  | ast.BoolPattern _ _ ->
      check_pattern_type(subst, eff_subst, expected, types.type_bool(), "Bool")
  | ast.StringPattern _ _ ->
      check_pattern_type(subst, eff_subst, expected, types.type_string(), "String")
  | ast.CharPattern _ _ ->
      check_pattern_type(subst, eff_subst, expected, types.type_char(), "Char")
  | ast.UnitPattern _ ->
      check_pattern_type(subst, eff_subst, expected, types.TConst("Unit"), "Unit")
  | ast.TuplePattern pats _ ->
      infer_tuple_pattern(state, env, subst, eff_subst, expected, pats)
  | ast.ConstructorPattern name fields _ ->
      infer_ctor_pattern(state, env, subst, eff_subst, expected, name, fields)

fn check_pattern_type(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  expected_type: types.Type,
  label: String
) -> InferResult !{IO} =
  match unifier.unify_types(subst, expected, expected_type) with
  | Err e -> InferErr(dummy_pos(), label ++ " pattern: " ++ e)
  | Ok s1 ->
      InferOk(typed_ast.TUnit(expected_type, dummy_pos()), s1, eff_subst, types.EffectPure)

fn infer_tuple_pattern(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  pats: List ast.Pattern
) -> InferResult !{IO} =
  do
    elem_vars <- make_fresh_var_list(state, pats)
    infer_tuple_pattern_unified(state, env, subst, eff_subst, expected, elem_vars, pats)

fn infer_tuple_pattern_unified(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  elem_vars: List types.Type,
  pats: List ast.Pattern
) -> InferResult !{IO} =
  match unifier.unify_types(subst, expected, types.TTuple(elem_vars)) with
  | Err e -> InferErr(dummy_pos(), "Tuple pattern: " ++ e)
  | Ok s1 ->
      check_pattern_list(state, env, s1, eff_subst, elem_vars, pats)

fn make_fresh_var_list(state: unifier.InferState, pats: List ast.Pattern) -> List types.Type !{IO} =
  match pats with
  | Nil -> Nil
  | Cons _ rest ->
      do
        v <- unifier.fresh(state)
        rest_vars <- make_fresh_var_list(state, rest)
        Cons(types.TVar(v), rest_vars)

fn check_pattern_list(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected_list: List types.Type,
  pats: List ast.Pattern
) -> InferResult !{IO} =
  match (expected_list, pats) with
  | (Nil, Nil) ->
      InferOk(typed_ast.TUnit(types.TConst("Unit"), dummy_pos()), subst, eff_subst, types.EffectPure)
  | (Cons exp_h exp_rest, Cons pat_h pat_rest) ->
      do
        r <- infer_pattern(state, env, subst, eff_subst, exp_h, pat_h)
        match r with
        | InferErr pos e -> InferErr(pos, e)
        | InferOk _ s1 es1 _ ->
            check_pattern_list(state, env, s1, es1, exp_rest, pat_rest)
  | _ -> InferErr(dummy_pos(), "Tuple pattern arity mismatch")

fn infer_ctor_pattern(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  name: String,
  fields: List ast.Pattern
) -> InferResult !{IO} =
  match dict_get(name, env) with
  | Nothing -> InferErr(dummy_pos(), "Unknown constructor: " ++ name)
  | Just scheme ->
      do
        ctor_type <- unifier.instantiate(state, scheme)
        infer_ctor_pattern_typed(state, env, subst, eff_subst, expected, name, fields, ctor_type)

fn infer_ctor_pattern_typed(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  name: String,
  fields: List ast.Pattern,
  ctor_type: types.Type
) -> InferResult !{IO} =
  match unifier.unify_types(subst, expected, ctor_result_type(ctor_type)) with
  | Err e -> InferErr(dummy_pos(), "Constructor " ++ name ++ ": " ++ e)
  | Ok s1 ->
      check_pattern_list(state, env, s1, eff_subst, ctor_param_types(ctor_type), fields)

fn ctor_result_type(t: types.Type) -> types.Type =
  match t with
  | types.TFunc _ ret _ -> ctor_result_type(ret)
  | _ -> t

# Declared return type of a function with `n_params` parameters: strip exactly
# `n_params` leading arrows. Preserves a function-typed return (e.g. -> Int -> Int),
# unlike ctor_result_type which strips all arrows (correct only for constructors).
fn fn_return_type(t: types.Type, n_params: Int) -> types.Type =
  if n_params <= 0 then t
  else match t with
    | types.TFunc _ ret _ -> fn_return_type(ret, n_params - 1)
    | _ -> t

fn ctor_param_types(t: types.Type) -> List types.Type =
  match t with
  | types.TFunc p rest _ -> Cons(p, ctor_param_types(rest))
  | _ -> Nil

# ---------------------------------------------------------------------------
# Extend environment from a pattern's bound variables
# ---------------------------------------------------------------------------

export fn extend_env_from_pattern(pat: ast.Pattern, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match pat with
  | ast.VarPattern name _ ->
      dict_set(name, types.mono(unifier.apply_subst(subst, types.TVar(name))), env)
  | ast.TuplePattern pats _ -> extend_env_from_pattern_list(pats, subst, env)
  | ast.ConstructorPattern _ fields _ -> extend_env_from_pattern_list(fields, subst, env)
  | _ -> env

fn extend_env_from_pattern_list(pats: List ast.Pattern, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match pats with
  | Nil -> env
  | Cons h t -> extend_env_from_pattern_list(t, subst, extend_env_from_pattern(h, subst, env))

# ---------------------------------------------------------------------------
# Do expression
# ---------------------------------------------------------------------------

# Short-circuit family ("Maybe" / "Result") of a do-step's inferred type, or
# Nothing for any other type (IO actions, pure values).  Mirrors the shape
# recognized by do_unwrap_type: `Maybe a` = TApp (TConst Maybe) a;
# `Result e a` = TApp (TApp (TConst Result) e) a.
fn short_circuit_family(t: types.Type) -> Maybe String =
  match t with
  | types.TApp outer _ ->
      match outer with
      | types.TConst name -> if name == "Maybe" then Just("Maybe") else Nothing
      | types.TApp outer2 _ ->
          match outer2 with
          | types.TConst name -> if name == "Result" then Just("Result") else Nothing
          | _ -> Nothing
      | _ -> Nothing
  | _ -> Nothing

# A do block may sequence exactly one short-circuit family.  A `<-` bind fixes
# the family; a later bind or the final expression in a different family is an
# error.  Returns Ok(updated-family) or Err(diagnostic).  IO/pure steps and
# `let` steps leave the family unchanged.
fn do_family_update(
  step: ast.DoStep,
  is_last: Bool,
  step_type: types.Type,
  subst: Dict types.Type,
  family: Maybe String
) -> Result String (Maybe String) =
  match short_circuit_family(unifier.apply_subst(subst, step_type)) with
  | Nothing -> Ok(family)
  | Just cur ->
      match step with
      | ast.DoBindStep _ _ ->
          match family with
          | Nothing -> Ok(Just(cur))
          | Just est ->
              if est == cur then Ok(family)
              else Err(string_concat_many(["This do block started with ", est, " bindings, but this step returns ", cur, ". Keep one short-circuit family per do block."]))
      | ast.DoExprStep _ ->
          if is_last then
            match family with
            | Nothing -> Ok(family)
            | Just est ->
                if est == cur then Ok(family)
                else Err(string_concat_many(["do block started with ", est, " bindings, but its final expression returns ", cur]))
          else Ok(family)
      | ast.DoLetStep _ _ -> Ok(family)

fn infer_do(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  steps: List ast.DoStep,
  pos: source.SourcePos
) -> InferResult !{IO} =
  infer_do_steps(state, env, subst, eff_subst, steps, dummy_unit(), Nil, types.EffectPure, Nothing, pos)

fn infer_do_steps(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  steps: List ast.DoStep,
  last_typed: typed_ast.TypedExpr,
  acc_steps: List typed_ast.TypedDoStep,
  acc_eff: types.Effect,
  family: Maybe String,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match steps with
  | Nil ->
      InferOk(
        typed_ast.TDo(typed_do_step_list_reverse(acc_steps),
                      typed_ast.typed_expr_type(last_typed), pos),
        subst, eff_subst, acc_eff)
  | Cons step rest ->
      do
        sr <- infer_do_step(state, env, subst, eff_subst, step)
        match sr with
        | InferErr pos e -> InferErr(pos, e)
        | InferOk typed_step_expr s1 es1 step_eff ->
            match do_family_update(step, is_nil_steps(rest), typed_ast.typed_expr_type(typed_step_expr), s1, family) with
            | Err msg -> InferErr(pos, msg)
            | Ok new_family ->
                infer_do_steps(
                  state,
                  extend_env_from_do_step(step, typed_ast.typed_expr_type(typed_step_expr), s1, env),
                  s1, es1, rest, typed_step_expr,
                  Cons(do_step_to_typed(step, typed_step_expr), acc_steps),
                  merge_effects(acc_eff, step_eff), new_family, pos)

fn is_nil_steps(steps: List ast.DoStep) -> Bool =
  match steps with
  | Nil -> true
  | Cons _ _ -> false

fn infer_do_step(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  step: ast.DoStep
) -> InferResult !{IO} =
  match step with
  | ast.DoExprStep e -> infer_expr(state, env, subst, eff_subst, e)
  | ast.DoBindStep _ e -> infer_expr(state, env, subst, eff_subst, e)
  | ast.DoLetStep _ e -> infer_expr(state, env, subst, eff_subst, e)

fn do_step_to_typed(step: ast.DoStep, typed_expr: typed_ast.TypedExpr) -> typed_ast.TypedDoStep =
  match step with
  | ast.DoExprStep _ -> typed_ast.TDoExprStep(typed_expr)
  | ast.DoBindStep pat _ -> typed_ast.TDoBindStep(pat, typed_expr)
  | ast.DoLetStep name _ -> typed_ast.TDoLetStep(name, typed_expr)

fn do_unwrap_type(t: types.Type) -> types.Type =
  match t with
  | types.TApp outer inner ->
      match outer with
      | types.TConst name ->
          if name == "Maybe" then inner else t
      | types.TApp outer2 _ ->
          match outer2 with
          | types.TConst name ->
              if name == "Result" then inner else t
          | _ -> t
      | _ -> t
  | _ -> t

fn extend_env_from_do_step(step: ast.DoStep, step_type: types.Type, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match step with
  | ast.DoBindStep pat _ ->
      extend_env_from_pattern_typed(pat, do_unwrap_type(unifier.apply_subst(subst, step_type)), subst, env)
  | ast.DoLetStep name _ ->
      dict_set(name, types.mono(unifier.apply_subst(subst, step_type)), env)
  | ast.DoExprStep _ -> env

fn extend_env_from_pattern_typed(pat: ast.Pattern, t: types.Type, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match pat with
  | ast.VarPattern name _ -> dict_set(name, types.mono(t), env)
  | ast.TuplePattern pats _ ->
      match t with
      | types.TTuple elem_types -> extend_env_from_typed_tuple_pats(pats, elem_types, subst, env)
      | _ -> extend_env_from_pattern(pat, subst, env)
  | _ -> extend_env_from_pattern(pat, subst, env)

# Zip TuplePattern variable patterns against their resolved element types so
# do-bind steps like `(a, b) <- f(x)` bind `a` and `b` to concrete types
# rather than bare TVar(name) stubs that can never be resolved by the unifier.
fn extend_env_from_typed_tuple_pats(pats: List ast.Pattern, elem_types: List types.Type, subst: Dict types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match (pats, elem_types) with
  | (Nil, _) -> env
  | (_, Nil) -> env
  | (Cons p rest_pats, Cons elem_t rest_types) ->
      extend_env_from_typed_tuple_pats(rest_pats, rest_types, subst,
        extend_env_from_pattern_typed(p, elem_t, subst, env))

# ---------------------------------------------------------------------------
# Lambda expression
# ---------------------------------------------------------------------------

fn infer_lambda(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  params: List ast.Param,
  body: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    fresh_params <- make_fresh_param_types(state, params)
    let env2 = extend_env_with_params(params, fresh_params, env)
    br <- infer_expr(state, env2, subst, eff_subst, body)
    match br with
    | InferErr pos e -> InferErr(pos, e)
    | InferOk typed_body s1 es1 body_eff ->
        InferOk(
          typed_ast.TLambda(params, typed_body,
            build_fn_type(fresh_params, typed_ast.typed_expr_type(typed_body)), pos),
          s1, es1, body_eff)

fn make_fresh_param_types(state: unifier.InferState, params: List ast.Param) -> List types.Type !{IO} =
  match params with
  | Nil -> Nil
  | Cons _ rest ->
      do
        v <- unifier.fresh(state)
        rest_types <- make_fresh_param_types(state, rest)
        Cons(types.TVar(v), rest_types)

fn extend_env_with_params(params: List ast.Param, param_types: List types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  match (params, param_types) with
  | (Nil, _) -> env
  | (_, Nil) -> env
  | (Cons p rest_p, Cons t rest_t) ->
      match p with
      | ast.Param name _ -> extend_env_with_params(rest_p, rest_t, dict_set(name, types.mono(t), env))

# ---------------------------------------------------------------------------
# Record inference
# ---------------------------------------------------------------------------

fn register_record_fields(
  rec_name: String,
  type_params: List String,
  fields: List ast.RecordFieldDecl,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  register_record_fields_loop(rec_name, type_params, fields,
    build_record_local_vars(rec_name, type_params, dict_empty()), env)

fn build_record_local_vars(rec_name: String, type_params: List String, acc: Dict types.Type) -> Dict types.Type =
  match type_params with
  | Nil -> acc
  | Cons p rest ->
      build_record_local_vars(rec_name, rest,
        dict_set(p, types.TVar(str_concat(rec_name, str_concat(".", p))), acc))

fn register_record_fields_loop(
  rec_name: String,
  type_params: List String,
  fields: List ast.RecordFieldDecl,
  local_vars: Dict types.Type,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  match fields with
  | Nil -> env
  | Cons field rest ->
      match field with
      | ast.RecordFieldDecl fname ftype ->
          register_record_fields_loop(rec_name, type_params, rest, local_vars,
            dict_set(
              str_concat("@rec:", str_concat(rec_name, str_concat(":", fname))),
              make_record_field_scheme(rec_name, type_params, type_from_ast(ftype, local_vars)),
              env))

fn make_record_field_scheme(rec_name: String, type_params: List String, field_t: types.Type) -> types.Scheme =
  types.Scheme(
    list_map(\p -> str_concat(rec_name, str_concat(".", p)), type_params),
    Nil, field_t, types.EffectPure)

fn infer_record_expr(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  type_name: String,
  fields: List ast.RecordField,
  pos: source.SourcePos
) -> InferResult !{IO} =
  infer_record_fields(state, env, subst, eff_subst, type_name, fields, Nil, types.EffectPure, pos)

fn infer_record_fields(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  type_name: String,
  fields: List ast.RecordField,
  acc_fields: List typed_ast.TypedRecordField,
  acc_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match fields with
  | Nil ->
      InferOk(
        typed_ast.TRecord(type_name,
                          typed_record_field_list_reverse(acc_fields),
                          types.TConst(type_name), pos),
        subst, eff_subst, acc_eff)
  | Cons field rest_fields ->
      match field with
      | ast.RecordField fname fexpr ->
          do
            r <- infer_expr(state, env, subst, eff_subst, fexpr)
            match r with
            | InferErr pos e -> InferErr(pos, e)
            | InferOk typed_val s1 es1 val_eff ->
                match dict_get(str_concat("@rec:", str_concat(type_name, str_concat(":", fname))), env) with
                | Nothing -> InferErr(pos, "Unknown record type or field: " ++ type_name ++ "." ++ fname)
                | Just field_scheme ->
                    do
                      field_t <- unifier.instantiate(state, field_scheme)
                      match unifier.unify_types(s1, typed_ast.typed_expr_type(typed_val), field_t) with
                      | Err e -> InferErr(pos, "Record field type mismatch: " ++ e)
                      | Ok s2 ->
                          infer_record_fields(state, env, s2, es1, type_name, rest_fields,
                            Cons(typed_ast.TypedRecordField(fname, typed_val), acc_fields),
                            merge_effects(acc_eff, val_eff), pos)

fn infer_get_field(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  rec_expr: ast.Expr,
  field_name: String,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    r <- infer_expr(state, env, subst, eff_subst, rec_expr)
    match r with
    | InferErr pos e -> InferErr(pos, e)
    | InferOk typed_rec s1 es1 rec_eff ->
        get_field_from_resolved(state, env, s1, es1,
          unifier.apply_subst(s1, typed_ast.typed_expr_type(typed_rec)),
          typed_rec, field_name, rec_eff, pos)

fn get_field_from_resolved(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  resolved: types.Type,
  typed_rec: typed_ast.TypedExpr,
  field_name: String,
  rec_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match resolved with
  | types.TConst rec_name ->
      lookup_record_field_typed(state, env, subst, eff_subst, rec_name, Nil, typed_rec, field_name, rec_eff, pos)
  | types.TApp _ _ ->
      lookup_record_field_typed(state, env, subst, eff_subst,
        extract_tconst_name(resolved), extract_tapp_args(resolved),
        typed_rec, field_name, rec_eff, pos)
  | _ ->
      do
        v <- unifier.fresh(state)
        InferOk(typed_ast.TGetField(typed_rec, field_name, types.TVar(v), pos), subst, eff_subst, rec_eff)

fn extract_tconst_name(t: types.Type) -> String =
  match t with
  | types.TConst name -> name
  | types.TApp base _ -> extract_tconst_name(base)
  | _ -> "Unknown"

fn extract_tapp_args(t: types.Type) -> List types.Type =
  list_reverse(collect_tapp_args(t, Nil))

fn collect_tapp_args(t: types.Type, acc: List types.Type) -> List types.Type =
  match t with
  | types.TApp base arg -> collect_tapp_args(base, Cons(arg, acc))
  | _ -> acc

fn lookup_record_field_typed(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  rec_name: String,
  type_args: List types.Type,
  typed_rec: typed_ast.TypedExpr,
  field_name: String,
  rec_eff: types.Effect,
  pos: source.SourcePos
) -> InferResult !{IO} =
  match dict_get(str_concat("@rec:", str_concat(rec_name, str_concat(":", field_name))), env) with
  | Nothing ->
      do
        v <- unifier.fresh(state)
        InferOk(typed_ast.TGetField(typed_rec, field_name, types.TVar(v), pos), subst, eff_subst, rec_eff)
  | Just field_scheme ->
      do
        field_t <- unifier.instantiate(state, field_scheme)
        InferOk(
          typed_ast.TGetField(typed_rec, field_name,
            apply_type_args_to_field(field_t, field_scheme, rec_name, type_args), pos),
          subst, eff_subst, rec_eff)

fn apply_type_args_to_field(
  field_t: types.Type,
  field_scheme: types.Scheme,
  rec_name: String,
  type_args: List types.Type
) -> types.Type =
  match field_scheme with
  | types.Scheme qvars _ _ _ ->
      unifier.apply_subst(build_tvar_subst(qvars, type_args, dict_empty()), field_t)

fn build_tvar_subst(vars: List String, args: List types.Type, acc: Dict types.Type) -> Dict types.Type =
  match (vars, args) with
  | (Nil, _) -> acc
  | (_, Nil) -> acc
  | (Cons v rest_v, Cons a rest_a) ->
      build_tvar_subst(rest_v, rest_a, dict_set(v, a, acc))

# ---------------------------------------------------------------------------
# Range expression (new)
# ---------------------------------------------------------------------------

fn infer_range(
  state: unifier.InferState,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  lo: ast.Expr,
  hi: ast.Expr,
  pos: source.SourcePos
) -> InferResult !{IO} =
  do
    lr <- infer_expr(state, env, subst, eff_subst, lo)
    match lr with
    | InferErr pos e -> InferErr(pos, e)
    | InferOk typed_lo s1 es1 lo_eff ->
        do
          hr <- infer_expr(state, env, s1, es1, hi)
          match hr with
          | InferErr pos e -> InferErr(pos, e)
          | InferOk typed_hi s2 es2 hi_eff ->
              match unifier.unify_types(s2, typed_ast.typed_expr_type(typed_lo), types.type_int()) with
              | Err e -> InferErr(pos, "Range needs Int: " ++ e)
              | Ok s3 ->
                  match unifier.unify_types(s3, typed_ast.typed_expr_type(typed_hi), types.type_int()) with
                  | Err e -> InferErr(pos, "Range needs Int: " ++ e)
                  | Ok s4 ->
                      InferOk(
                        typed_ast.TRange(typed_lo, typed_hi,
                          types.TConst("IntRange"), pos),
                        s4, es2, merge_effects(lo_eff, hi_eff))

# ---------------------------------------------------------------------------
# Program-level typechecking
# ---------------------------------------------------------------------------

export fn typecheck_decls(
  state: unifier.InferState,
  decls: List ast.Decl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect
) -> typed_ast.TypedResult !{IO} =
  do
    # Pre-scan: register all FnDecl signatures and their @constrained_N markers
    # in env before processing bodies.  This enables forward references and
    # mutual recursion (e.g., decorated_sort_split calling decorated_sort which
    # is defined later in the same file).
    let scanned_env = pre_scan_fn_decls(decls, env, dict_empty())
    unifier.set_ctor_map(state, build_ctor_map(decls, dict_empty()))
    # Strict type-name validation: walk every TypeExpr in every type/alias/record
    # declaration and error immediately if a referenced type name is not declared.
    # Runs after pre_scan so mutually recursive ADTs are always in the declared set.
    let declared_types = collect_declared_type_names(decls, builtin_type_names())
    match validate_all_decls(decls, declared_types) with
    | Just err_msg -> typed_ast.TypedErr(dummy_pos(), err_msg)
    | Nothing ->
        match check_overlapping_instances(decls, dict_empty()) with
        | Just err_msg -> typed_ast.TypedErr(dummy_pos(), err_msg)
        | Nothing ->
            # Wrap scanned_env as GlobalEnv at this seam — scanned_env is the
            # output of pre_scan_fn_decls (Dict, raw pre-pass). From here on
            # the env flows between decls as the wrap-protected GlobalEnv.
            typecheck_decls_inner(state, decls, GlobalEnv(scanned_env), subst, eff_subst, dict_empty(), Nil, unifier.ftv_env(scanned_env))

# ---------------------------------------------------------------------------
# Strict type-name validation pass
# ---------------------------------------------------------------------------
#
# After pre_scan_fn_decls registers all type constructors, this pass walks
# every TypeExpr in TypeDecl constructor fields, RecordDecl field types, and
# AliasDecl RHS expressions.  An uppercase TypeName that does not appear in
# the declared-type set is reported as a hard error before unification runs.
#
# Forward references are safe: this pass runs after pre_scan_fn_decls has
# already collected all type names for the entire module.
#
# Positions covered: TypeDecl constructor fields, RecordDecl fields, AliasDecl RHS.
# ClassDecl/InstanceDecl/FnDecl signature positions are not yet covered (follow-up).
#
# Type parameters (always lowercase in Sprout, e.g. `a`, `b`) are detected by
# is_lowercase_name and skipped without consulting the declared set.
# Qualified names (e.g. `stdlib.compiler.ast.TypeExpr`) are stripped to their
# short form before lookup, matching the after_last_dot convention used
# throughout lookup_type_var.

# O(1): built-in primitive type names always valid without a declaration.
# primitive_type_names covers language-level primitives;
# c_runtime_type_names covers opaque C-runtime types used in stdlib TypeDecl/AliasDecl:
#   Vector   — backing store for Vec a and MutVec a (prelude.sprout)
#   Map      — backing store for Dict v (prelude.sprout)
#   NativeSet — backing store for Set (prelude.sprout)
#   Ref      — mutable reference cell (test.sprout TestState, unifier.sprout InferState,
#               lsp_driver.sprout LspState, analysis_service_driver.sprout StartupState,
#               module_loader.sprout ModuleCache alias)
fn builtin_type_names() -> List String =
  append(primitive_type_names(), c_runtime_type_names())

fn primitive_type_names() -> List String =
  Cons("Int", Cons("Double", Cons("Bool", Cons("String", Cons("Char",
    Cons("Unit", Cons("Bytes", Cons("IntRange", Nil))))))))

fn c_runtime_type_names() -> List String =
  Cons("Vector", Cons("Map", Cons("NativeSet", Cons("Ref", Nil))))

# O(n decls): collect short names (prefix-stripped) of all declared types.
fn collect_declared_type_names(decls: List ast.Decl, acc: List String) -> List String =
  match decls with
  | Nil -> acc
  | Cons decl rest ->
      match decl with
      | ast.TypeDecl name _ _ _ _ ->
          collect_declared_type_names(rest, Cons(string.after_last_dot(name), acc))
      | ast.RecordDecl name _ _ _ ->
          collect_declared_type_names(rest, Cons(string.after_last_dot(name), acc))
      | ast.AliasDecl name _ _ _ ->
          collect_declared_type_names(rest, Cons(string.after_last_dot(name), acc))
      | ast.WrapDecl name _ _ ->
          collect_declared_type_names(rest, Cons(string.after_last_dot(name), acc))
      | _ -> collect_declared_type_names(rest, acc)

# O(depth): validate a single TypeExpr, returning the first error found.
fn validate_te(te: ast.TypeExpr, decl_name: String, declared: List String) -> Maybe String =
  match te with
  | ast.TypeName name ->
      if is_lowercase_name(name) then Nothing
      else
        if types.list_member(string.after_last_dot(name), declared) then Nothing
        else Just("type-validation: unknown type name `" ++ string.after_last_dot(name) ++
                  "` in declaration `" ++ string.after_last_dot(decl_name) ++ "`")
  | ast.TypeApply left right ->
      match validate_te(left, decl_name, declared) with
      | Just e -> Just(e)
      | Nothing -> validate_te(right, decl_name, declared)
  | ast.TypeArrow param ret _ ->
      match validate_te(param, decl_name, declared) with
      | Just e -> Just(e)
      | Nothing -> validate_te(ret, decl_name, declared)
  | ast.TypeEffect inner _ -> validate_te(inner, decl_name, declared)
  | ast.TupleType parts -> validate_te_list(parts, decl_name, declared)

fn validate_te_list(parts: List ast.TypeExpr, decl_name: String, declared: List String) -> Maybe String =
  match parts with
  | Nil -> Nothing
  | Cons h rest ->
      match validate_te(h, decl_name, declared) with
      | Just e -> Just(e)
      | Nothing -> validate_te_list(rest, decl_name, declared)

fn validate_ctors(
  ctors: List ast.TypeConstructor,
  decl_name: String,
  declared: List String
) -> Maybe String =
  match ctors with
  | Nil -> Nothing
  | Cons ctor rest ->
      match ctor with
      | ast.TypeConstructor _ fields ->
          match validate_te_list(fields, decl_name, declared) with
          | Just e -> Just(e)
          | Nothing -> validate_ctors(rest, decl_name, declared)

fn validate_record_fields(
  fields: List ast.RecordFieldDecl,
  decl_name: String,
  declared: List String
) -> Maybe String =
  match fields with
  | Nil -> Nothing
  | Cons field rest ->
      match field with
      | ast.RecordFieldDecl _ ftype ->
          match validate_te(ftype, decl_name, declared) with
          | Just e -> Just(e)
          | Nothing -> validate_record_fields(rest, decl_name, declared)

fn validate_decl(decl: ast.Decl, declared: List String) -> Maybe String =
  match decl with
  | ast.TypeDecl name _ ctors _ _ ->
      validate_ctors(ctors, name, declared)
  | ast.RecordDecl name _ fields _ ->
      validate_record_fields(fields, name, declared)
  | ast.AliasDecl name _ rhs _ ->
      validate_te(rhs, name, declared)
  | ast.WrapDecl name inner _ ->
      validate_te(inner, name, declared)
  | _ -> Nothing

fn validate_all_decls(decls: List ast.Decl, declared: List String) -> Maybe String =
  match decls with
  | Nil -> Nothing
  | Cons decl rest ->
      match validate_decl(decl, declared) with
      | Just e -> Just(e)
      | Nothing -> validate_all_decls(rest, declared)

# ---------------------------------------------------------------------------
# Overlapping-instance validation pass
# ---------------------------------------------------------------------------
#
# Two instances whose head constructors coincide would register the same
# `@inst:{Class}:{Head}` marker, so the second silently shadows the first at
# dispatch.  Sprout has no orphan/overlap resolution, so this is always an
# error.  The key mirrors register_instance_marker exactly (head-constructor
# only), so `instance Bar (List a)` and `instance Bar (List Int)` collide on
# `@inst:Bar:List` just like a literal duplicate does.  Scans the program's own
# decls (not the seeded prelude env), so prelude instances — each a distinct
# head — never false-positive.
fn instance_key_and_class(c: ast.TypeConstraint) -> Maybe (String, String) =
  match c with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> Nothing
      | Cons head_te _ ->
          Just((str_concat("@inst:", str_concat(class_name, str_concat(":", type_head_str(type_from_ast(head_te, dict_empty()))))),
                string.after_last_dot(class_name)))

fn check_overlapping_instances(decls: List ast.Decl, seen: Dict Bool) -> Maybe String =
  match decls with
  | Nil -> Nothing
  | Cons decl rest ->
      match decl with
      | ast.InstanceDecl constraint _ _ _ ->
          match instance_key_and_class(constraint) with
          | Nothing -> check_overlapping_instances(rest, seen)
          | Just (key, cls) ->
              match dict_get(key, seen) with
              | Just _ -> Just(str_concat("Overlapping instances for ", cls))
              | Nothing -> check_overlapping_instances(rest, dict_set(key, true, seen))
      | _ -> check_overlapping_instances(rest, seen)

# Pre-scan pass: register FnDecl signatures, @constrained_N markers, and
# TypeDecl constructors for all declarations without typechecking bodies.
# Also tracks AliasDecl entries so that type aliases in signatures are resolved.
# TypeDecl pre-scanning is required to allow forward references to type
# constructors (e.g. a fn defined before the type it uses in the same module).
# For a single-parameter type alias `F a = G H a`, store `G H` in alias_env so that
# TypeApply (TypeName "F") X is resolved by type_from_ast's TApp branch to `G H X`.
# Only handles the structural form TApp T (TVar sentinel); silently skips other forms.
fn register_single_param_alias(
  name: String, param: String, rhs_te: ast.TypeExpr, alias_env: Dict types.Type
) -> Dict types.Type =
  match type_from_ast(rhs_te, dict_set(param, types.TVar(sentinel), dict_empty())) with
  | types.TApp inner_ty (types.TVar tname) ->
      if tname == sentinel then dict_set(name, inner_ty, alias_env)
      else alias_env
  | _ -> alias_env
  where sentinel = str_concat("__aliasparam__", param)

fn pre_scan_fn_decls(decls: List ast.Decl, env: Dict types.Scheme, alias_env: Dict types.Type) -> Dict types.Scheme =
  match decls with
  | Nil -> env
  | Cons decl rest ->
      match decl with
      | ast.FnDecl name params ret_type_maybe effects_maybe constraints _ _ ->
          pre_scan_fn_decls(rest,
            register_fn_decl_scheme(name, params, ret_type_maybe, effects_maybe, constraints, alias_env, env),
            alias_env)
      | ast.ExternFnDecl name params ret_type_maybe effects_maybe _ ->
          match dict_get(name, env) with
          | Just _ -> pre_scan_fn_decls(rest, env, alias_env)
          | Nothing ->
              pre_scan_fn_decls(rest,
                dict_set(name, scheme_from_fn_parts(params, ret_type_maybe, effects_maybe, alias_env), env),
                alias_env)
      | ast.AliasDecl name Nil rhs_te _ ->
          pre_scan_fn_decls(rest, env,
            dict_set(name, type_from_ast(rhs_te, dict_empty()), alias_env))
      | ast.AliasDecl name (Cons param Nil) rhs_te _ ->
          pre_scan_fn_decls(rest, env, register_single_param_alias(name, param, rhs_te, alias_env))
      | ast.TypeDecl _ _ _ _ _ ->
          pre_scan_fn_decls(rest, register_type_decl_raw(decl, env), alias_env)
      | ast.WrapDecl _ _ _ ->
          pre_scan_fn_decls(rest, register_type_decl_raw(decl, env), alias_env)
      | _ -> pre_scan_fn_decls(rest, env, alias_env)

fn typecheck_decls_inner(
  state: unifier.InferState,
  decls: List ast.Decl,
  env: GlobalEnv,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  alias_env: Dict types.Type,
  acc: List typed_ast.TypedDecl,
  env_ftv: List String
) -> typed_ast.TypedResult !{IO} =
  match decls with
  | Nil ->
      # Unwrap GlobalEnv for the public TypedResult API, which still uses
      # raw Dict types.Scheme.  The wrap discipline is internal to infer.
      typed_ast.TypedOk(
        typed_ast.TypedProgram(typed_decl_list_reverse(acc)),
        global_env_dict(env))
  | Cons decl rest ->
      match decl with
      | ast.AliasDecl name Nil rhs_te _ ->
          typecheck_decls_inner(state, rest, env, subst, eff_subst,
            dict_set(name, type_from_ast(rhs_te, dict_empty()), alias_env),
            Cons(typed_ast.TPassThrough(decl), acc), env_ftv)
      | ast.AliasDecl name (Cons param Nil) rhs_te _ ->
          typecheck_decls_inner(state, rest, env, subst, eff_subst,
            register_single_param_alias(name, param, rhs_te, alias_env),
            Cons(typed_ast.TPassThrough(decl), acc), env_ftv)
      | _ ->
          do
            r <- typecheck_decl(state, decl, env, subst, eff_subst, alias_env, env_ftv)
            match r with
            | TypedDeclErr pos e -> typed_ast.TypedErr(pos, e)
            | TypedDeclOk typed_decl new_env new_env_ftv ->
                typecheck_decls_inner(state, rest, new_env, subst, eff_subst, alias_env,
                  Cons(typed_decl, acc), new_env_ftv)

fn typecheck_decl(
  state: unifier.InferState,
  decl: ast.Decl,
  env: GlobalEnv,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  alias_env: Dict types.Type,
  env_ftv: List String
) -> TypedDeclResult !{IO} =
  # Unwrap once at the top — internal helpers (check_fn_body, register_*,
  # dict_get/set) all work on raw Dict.  GlobalEnv is reconstructed at the
  # TypedDeclOk boundary.
  match decl with
  | ast.TypeDecl _ _ _ _ _ ->
      TypedDeclOk(typed_ast.TPassThrough(decl), register_type_decl(decl, env), env_ftv)
  | ast.WrapDecl _ _ _ ->
      # WrapDecl uses the same single-ctor-synthesizing path as TypeDecl.
      TypedDeclOk(typed_ast.TPassThrough(decl), register_type_decl(decl, env), env_ftv)
  | ast.RecordDecl rec_name type_params fields _ ->
      TypedDeclOk(typed_ast.TPassThrough(decl),
        GlobalEnv(register_record_fields(rec_name, type_params, fields, global_env_dict(env))),
        env_ftv)
  | ast.FnDecl name params ret_type_maybe effects_maybe constraints _ _ ->
      do
        (r, fwd_markers) <- check_fn_body(state, decl, global_env_dict(env), subst, eff_subst, alias_env)
        # WHY: @eta_fwd markers added here have free type variables that must be
        # included in env_ftv so subsequent declarations don't incorrectly generalize
        # over them.  Computed once per declaration (not per env entry) → stays O(n).
        let new_env_ftv = types.list_union(unifier.ftv_env(fwd_markers), env_ftv)
        match r with
        | typed_ast.BodyErr pos e -> TypedDeclErr(pos, e)
        | typed_ast.BodyLenient ->
            # BodyLenient is no longer produced (fn_body_err always returns BodyErr).
            # Retained as a constructor only to avoid breaking the typed_ast public API.
            TypedDeclErr(dummy_pos(), "internal: unexpected BodyLenient in " ++ name)
        | typed_ast.BodyOk typed_body inferred_fn_type ->
            TypedDeclOk(
              typed_ast.TFnDecl(name, params, ret_type_maybe, effects_maybe, constraints, typed_body),
              # WHY: fold @eta_fwd markers into the global env so lowering can map fresh
              # TVar names back to programmer constraint var names when eta-expanding
              # class methods in value position. Keys use @eta_fwd: prefix (not @fwd:)
              # to avoid polluting the per-function @fwd: namespace scanned by
              # resolve_via_fwd_for_prog_var. Keys are globally unique (one InferState).
              fold_fwd_markers(fwd_markers,
                GlobalEnv(dict_set(name,
                  unifier.generalize(env_ftv, dict_empty(), dict_empty(),
                    inferred_fn_type, effect_from_maybe_labels(effects_maybe)),
                  global_env_dict(env)))),
              new_env_ftv)
  | ast.ExternFnDecl name params ret_type_maybe effects_maybe _ ->
      match dict_get(name, global_env_dict(env)) with
      | Just _ ->
          TypedDeclOk(typed_ast.TExternFnDecl(name, params, ret_type_maybe, effects_maybe), env, env_ftv)
      | Nothing ->
          TypedDeclOk(
            typed_ast.TExternFnDecl(name, params, ret_type_maybe, effects_maybe),
            GlobalEnv(dict_set(name, scheme_from_fn_parts(params, ret_type_maybe, effects_maybe, alias_env), global_env_dict(env))),
            env_ftv)
  | ast.LetDecl name expr let_pos ->
      do
        r <- typecheck_expr(state, global_env_dict(env), subst, eff_subst, expr)
        match r with
        | InferErr pos e -> TypedDeclErr(pos, e)
        | InferOk typed_expr s1 _ _ ->
            # Value restriction (W3/F-VALRESTR): a syntactic value generalizes;
            # a non-value (function call, if/match/do, ...) does not. A non-value
            # whose type still has free type variables is ambiguous — it can be
            # neither generalized (unsound: `mutvec_new(1, Nil)` written at Int and
            # read at String) nor pinned to one type (no whole-program substitution
            # threads across decls) — so it is rejected, as SML rejects
            # ungeneralizable top-level type variables.
            if is_syntactic_value(expr) then
              TypedDeclOk(
                typed_ast.TLetDecl(name, typed_expr),
                GlobalEnv(dict_set(name,
                  unifier.generalize(env_ftv, s1, eff_subst,
                    typed_ast.typed_expr_type(typed_expr), types.EffectPure),
                  global_env_dict(env))),
                env_ftv)
            else
              match types.list_diff(types.ftv(unifier.apply_subst(s1, typed_ast.typed_expr_type(typed_expr))), env_ftv) with
              | Cons _ _ ->
                  TypedDeclErr(let_pos, "value restriction: non-value binding '" ++ name ++ "' has an ambiguous polymorphic type " ++ types.type_to_string(unifier.apply_subst(s1, typed_ast.typed_expr_type(typed_expr))) ++ "; bind a value or add a concrete type annotation")
              | Nil ->
                  TypedDeclOk(
                    typed_ast.TLetDecl(name, typed_expr),
                    GlobalEnv(dict_set(name,
                      types.mono(unifier.apply_subst(s1, typed_ast.typed_expr_type(typed_expr))),
                      global_env_dict(env))),
                    env_ftv)
  | ast.AliasDecl _ _ _ _ ->
      TypedDeclOk(typed_ast.TPassThrough(decl), env, env_ftv)
  | ast.ClassDecl class_name type_params methods superclasses _ ->
      TypedDeclOk(typed_ast.TPassThrough(decl),
        GlobalEnv(register_class_methods(type_params, methods,
          register_class_method_markers(class_name, type_params, methods,
            register_superclass_markers(class_name, superclasses, global_env_dict(env))))),
        env_ftv)
  | ast.InstanceDecl constraint inst_constraints methods _ ->
      do
        r <- check_instance_methods(state, inst_constraints, methods, global_env_dict(env), subst, eff_subst)
        match r with
        | typed_ast.InstanceMethodsErr pos e -> TypedDeclErr(pos, e)
        | typed_ast.InstanceMethodsOk typed_methods ->
            TypedDeclOk(
              typed_ast.TInstanceDecl(constraint, inst_constraints, typed_methods),
              GlobalEnv(register_instance_marker(constraint, global_env_dict(env))),
              env_ftv)

# ---------------------------------------------------------------------------
# apply_subst_typed_expr — walk a typed AST applying a type substitution
# ---------------------------------------------------------------------------

fn apply_subst_typed_expr_list(subst: Dict types.Type, exprs: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  match exprs with
  | Nil -> Nil
  | Cons h t -> Cons(apply_subst_typed_expr(subst, h), apply_subst_typed_expr_list(subst, t))

fn apply_subst_typed_match_branches(subst: Dict types.Type, branches: List typed_ast.TypedMatchBranch) -> List typed_ast.TypedMatchBranch =
  match branches with
  | Nil -> Nil
  | Cons h t ->
      match h with
      | typed_ast.TypedMatchBranch pat body ->
          Cons(typed_ast.TypedMatchBranch(pat, apply_subst_typed_expr(subst, body)), apply_subst_typed_match_branches(subst, t))

fn apply_subst_typed_do_steps(subst: Dict types.Type, steps: List typed_ast.TypedDoStep) -> List typed_ast.TypedDoStep =
  match steps with
  | Nil -> Nil
  | Cons h t ->
      match h with
      | typed_ast.TDoBindStep pat expr ->
          Cons(typed_ast.TDoBindStep(pat, apply_subst_typed_expr(subst, expr)), apply_subst_typed_do_steps(subst, t))
      | typed_ast.TDoLetStep name expr ->
          Cons(typed_ast.TDoLetStep(name, apply_subst_typed_expr(subst, expr)), apply_subst_typed_do_steps(subst, t))
      | typed_ast.TDoExprStep expr ->
          Cons(typed_ast.TDoExprStep(apply_subst_typed_expr(subst, expr)), apply_subst_typed_do_steps(subst, t))

fn apply_subst_typed_record_fields(subst: Dict types.Type, fields: List typed_ast.TypedRecordField) -> List typed_ast.TypedRecordField =
  match fields with
  | Nil -> Nil
  | Cons h t ->
      match h with
      | typed_ast.TypedRecordField name expr ->
          Cons(typed_ast.TypedRecordField(name, apply_subst_typed_expr(subst, expr)), apply_subst_typed_record_fields(subst, t))

fn apply_subst_typed_expr(subst: Dict types.Type, e: typed_ast.TypedExpr) -> typed_ast.TypedExpr =
  match e with
  | typed_ast.TVar name t pos ->
      typed_ast.TVar(name, unifier.apply_subst(subst, t), pos)
  | typed_ast.TInt val t pos ->
      typed_ast.TInt(val, unifier.apply_subst(subst, t), pos)
  | typed_ast.TFloat text t pos ->
      typed_ast.TFloat(text, unifier.apply_subst(subst, t), pos)
  | typed_ast.TBool val t pos ->
      typed_ast.TBool(val, unifier.apply_subst(subst, t), pos)
  | typed_ast.TString val t pos ->
      typed_ast.TString(val, unifier.apply_subst(subst, t), pos)
  | typed_ast.TChar val t pos ->
      typed_ast.TChar(val, unifier.apply_subst(subst, t), pos)
  | typed_ast.TUnit t pos ->
      typed_ast.TUnit(unifier.apply_subst(subst, t), pos)
  | typed_ast.TTuple items t pos ->
      typed_ast.TTuple(apply_subst_typed_expr_list(subst, items), unifier.apply_subst(subst, t), pos)
  | typed_ast.TIf cond then_ else_ t pos ->
      typed_ast.TIf(apply_subst_typed_expr(subst, cond), apply_subst_typed_expr(subst, then_), apply_subst_typed_expr(subst, else_), unifier.apply_subst(subst, t), pos)
  | typed_ast.TMatch scrutinee branches t pos ->
      typed_ast.TMatch(apply_subst_typed_expr(subst, scrutinee), apply_subst_typed_match_branches(subst, branches), unifier.apply_subst(subst, t), pos)
  | typed_ast.TCall fn_ args t pos ->
      typed_ast.TCall(apply_subst_typed_expr(subst, fn_), apply_subst_typed_expr_list(subst, args), unifier.apply_subst(subst, t), pos)
  | typed_ast.TDict constraint t pos ev ->
      typed_ast.TDict(constraint, unifier.apply_subst(subst, t), pos, ev)
  | typed_ast.TMethodRef method class_name t pos ev ->
      typed_ast.TMethodRef(method, class_name, unifier.apply_subst(subst, t), pos, ev)
  | typed_ast.TLambda params body t pos ->
      typed_ast.TLambda(params, apply_subst_typed_expr(subst, body), unifier.apply_subst(subst, t), pos)
  | typed_ast.TBinary op left right t pos ->
      typed_ast.TBinary(op, apply_subst_typed_expr(subst, left), apply_subst_typed_expr(subst, right), unifier.apply_subst(subst, t), pos)
  | typed_ast.TUnary op operand t pos ->
      typed_ast.TUnary(op, apply_subst_typed_expr(subst, operand), unifier.apply_subst(subst, t), pos)
  | typed_ast.TRange from_ to_ t pos ->
      typed_ast.TRange(apply_subst_typed_expr(subst, from_), apply_subst_typed_expr(subst, to_), unifier.apply_subst(subst, t), pos)
  | typed_ast.TDo steps t pos ->
      typed_ast.TDo(apply_subst_typed_do_steps(subst, steps), unifier.apply_subst(subst, t), pos)
  | typed_ast.TRecord name fields t pos ->
      typed_ast.TRecord(name, apply_subst_typed_record_fields(subst, fields), unifier.apply_subst(subst, t), pos)
  | typed_ast.TGetField expr field t pos ->
      typed_ast.TGetField(apply_subst_typed_expr(subst, expr), field, unifier.apply_subst(subst, t), pos)

# ---------------------------------------------------------------------------
# Post-inference dispatch resolution for return-type-driven typeclass methods
# ---------------------------------------------------------------------------
#
# At inference time, check_call_constraint dispatches class methods based on
# the first concrete argument's type. For methods whose class type variable is
# in an argument position (e.g. `Eq.eq : a -> a -> Bool`), this works correctly.
# For methods whose class type variable is ONLY in the return position
# (e.g. a hypothetical `Read.read : String -> a`), the return type's
# substitution comes from the OUTER context (a function's declared return type)
# which isn't unified until AFTER inference completes — so the inference-time
# dispatch picks the wrong instance.
#
# This post-pass walker runs AFTER check_fn_body's body-vs-return-type
# unification (s2). It re-examines class method calls, computes the correct
# dispatch using s2 + the method's scheme, and rewrites only the TDict in
# cases where the dispatch was wrong. Original TCall.t values are preserved
# — only the TDict's TypeConstraint changes.
#
# Constrained-function calls (non-class-method calls to `fn f … where C a`)
# are handled by maybe_rewrite_constrained_fn_call, which mirrors the same
# post-pass pattern for the case where `a` appears only in the return type:
# inject_constrained_fn_dicts runs before s2 (while `a` is still a free TVar),
# so it may fail to find the dict.  The post-pass re-resolves using the now-
# concrete return type `t`.

fn strip_leading_tdicts(args: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  match args with
  | Nil -> Nil
  | Cons (typed_ast.TDict _ _ _ _) rest -> strip_leading_tdicts(rest)
  | _ -> args

# Collect ALL TDict nodes from an arg list, in the order they appear.
# Used to preserve inference-time fwd-marker dicts at still-polymorphic call
# sites (inside a constrained fn body) when the post-pass cannot improve them.
fn collect_all_tdicts(args: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  match args with
  | Nil -> Nil
  | Cons (typed_ast.TDict c t2 p ev) rest -> Cons(typed_ast.TDict(c, t2, p, ev), collect_all_tdicts(rest))
  | Cons _ rest -> collect_all_tdicts(rest)

# Return the element at zero-based index `idx`, or Nothing.
fn list_nth_maybe_tdict(xs: List typed_ast.TypedExpr, idx: Int) -> Maybe typed_ast.TypedExpr =
  match xs with
  | Nil -> Nothing
  | Cons h rest -> if idx == 0 then Just(h) else list_nth_maybe_tdict(rest, idx - 1)

# Post-pass rewrite for constrained regular-function calls.
# Mirrors maybe_rewrite_class_method_call for functions declared with
# `where C a` constraints.
#
# For each @constrained_N:fn_name marker:
#   - If the inference-time pass already injected a dict, keep it unchanged.
#     This covers input-position constraints (correct at inference time) and
#     return-position constraints inside constrained fn bodies (@fwd forwarding).
#   - If no dict was injected (missing), scan the concrete return type `t`
#     (post-s2) for a matching @inst entry and inject the correct dict.
#
# Only called when @class:fn_name is absent (fn_ is not a class method).
fn maybe_rewrite_constrained_fn_call(
  env: Dict types.Scheme,
  subst: Dict types.Type,
  fn_: typed_ast.TypedExpr,
  fn_name: String,
  args: List typed_ast.TypedExpr,
  t: types.Type,
  pos: source.SourcePos
) -> typed_ast.TypedExpr =
  match dict_get("@constrained_0:" ++ fn_name, env) with
  | Nothing -> typed_ast.TCall(fn_, args, t, pos)
  | Just _ ->
      typed_ast.TCall(fn_,
        list_append(
          user_typed_args(args),
          build_constrained_fn_dicts(fn_name, 0, env,
            unifier.apply_subst(subst, t),
            pos, collect_all_tdicts(args))),
        t, pos)

# Build the corrected dict list for a constrained function call (post-pass).
# Iterates @constrained_N markers in order.  For each marker:
#
#   - If the inference-time pass already injected a dict at this index
#     (list_nth_maybe_tdict succeeds), keep it unchanged.  This covers both:
#       • Input-position constraints correctly resolved at inference time.
#       • Return-position constraints inside a constrained fn body where the
#         @fwd marker dict was already correctly injected.
#
#   - If no dict was injected (index ≥ len(existing_dicts)):
#     try to add one by scanning concrete_ret for a @inst:class_name:X match
#     (find_inst_in_return_type).  If the return type is still polymorphic
#     (no matching instance found), NO dict is emitted for this constraint —
#     the call is still-polymorphic and the lowering @fwd path must handle it.
#
# WHY skip dispatch_type_walk: after typecheck_decl's generalize(), the scheme
# in env uses fresh TVar names (e.g. "t42"), while the @constrained_N marker
# stores the ORIGINAL prog-var name (e.g. "a").  dispatch_type_walk compares
# against the original prog var but finds only the fresh name → returns Nothing.
# Scanning concrete_ret directly bypasses this name-mismatch entirely.
fn build_constrained_fn_dicts(
  fn_name: String,
  idx: Int,
  env: Dict types.Scheme,
  concrete_ret: types.Type,
  pos: source.SourcePos,
  existing_dicts: List typed_ast.TypedExpr
) -> List typed_ast.TypedExpr =
  match dict_get("@constrained_" ++ int_to_string(idx) ++ ":" ++ fn_name, env) with
  | Nothing -> Nil
  | Just class_marker ->
      match class_marker with
      | types.Scheme _ _ (types.TApp(types.TConst class_name)(types.TConst _)) _ ->
          match list_nth_maybe_tdict(existing_dicts, idx) with
          | Just existing_d ->
              # Inference-time dict already present — keep it
              Cons(existing_d,
                   build_constrained_fn_dicts(fn_name, idx + 1, env, concrete_ret, pos, existing_dicts))
          | Nothing ->
              # No existing dict — try to add one from the concrete return type
              match find_inst_in_return_type(class_name, concrete_ret, env, pos) with
              | Just new_dict ->
                  Cons(new_dict,
                       build_constrained_fn_dicts(fn_name, idx + 1, env, concrete_ret, pos, existing_dicts))
              | Nothing ->
                  # Still polymorphic — no dict for this constraint
                  build_constrained_fn_dicts(fn_name, idx + 1, env, concrete_ret, pos, existing_dicts)
      | types.Scheme _ _ (types.TConst _) _ ->
          # Marker without prog_var — keep existing dict or emit nothing
          match list_nth_maybe_tdict(existing_dicts, idx) with
          | Just existing_d ->
              Cons(existing_d,
                   build_constrained_fn_dicts(fn_name, idx + 1, env, concrete_ret, pos, existing_dicts))
          | Nothing ->
              build_constrained_fn_dicts(fn_name, idx + 1, env, concrete_ret, pos, existing_dicts)
      | _ ->
          build_constrained_fn_dicts(fn_name, idx + 1, env, concrete_ret, pos, existing_dicts)

# Scan a concrete return type for an inner component that has an @inst marker
# for the given class.  Tries the type itself first (handles `a` in return
# position directly), then recurses into TApp arguments and TTuple elements.
# Returns the first matching TDict, or Nothing if the return type is still
# polymorphic (contains only TVars with no matching @inst entry).
fn find_inst_in_return_type(class_name: String, t: types.Type, env: Dict types.Scheme, pos: source.SourcePos) -> Maybe typed_ast.TypedExpr =
  match concrete_type_str(t) with
  | Just head_str ->
      match dict_get("@inst:" ++ class_name ++ ":" ++ head_str, env) with
      | Just _ ->
          Just(typed_ast.TDict(
            ast.TypeConstraint(class_name, Cons(type_to_typeexpr(t), Nil)),
            types.TConst(class_name), pos, typed_ast.EvUnresolved))
      | Nothing ->
          find_inst_in_return_type_children(class_name, t, env, pos)
  | Nothing ->
      Nothing

fn find_inst_in_return_type_children(class_name: String, t: types.Type, env: Dict types.Scheme, pos: source.SourcePos) -> Maybe typed_ast.TypedExpr =
  match t with
  | types.TApp base arg ->
      # Recurse into BOTH children: a multi-parameter application like
      # `Pair e a` = `TApp (TApp Pair e) a` carries the inner type argument
      # `e` in `base`, so scanning only `arg` misses an instance needed on an
      # inner type parameter (return-type dispatch would then fall back to
      # @fwd and fail late — see test_constrained_fn_return_type_nested_tapp).
      match find_inst_in_return_type(class_name, arg, env, pos) with
      | Just d -> Just(d)
      | Nothing -> find_inst_in_return_type(class_name, base, env, pos)
  | types.TTuple items -> find_inst_in_return_type_list(class_name, items, env, pos)
  | _ -> Nothing

fn find_inst_in_return_type_list(class_name: String, items: List types.Type, env: Dict types.Scheme, pos: source.SourcePos) -> Maybe typed_ast.TypedExpr =
  match items with
  | Nil -> Nothing
  | Cons h rest ->
      match find_inst_in_return_type(class_name, h, env, pos) with
      | Just d -> Just(d)
      | Nothing -> find_inst_in_return_type_list(class_name, rest, env, pos)

fn try_rewrite_for_return_dispatch(
  env: Dict types.Scheme,
  subst: Dict types.Type,
  fn_: typed_ast.TypedExpr,
  args: List typed_ast.TypedExpr,
  t: types.Type,
  pos: source.SourcePos,
  class_name: String,
  class_vars: List String,
  method_type: types.Type
) -> typed_ast.TypedExpr =
  match dispatch_type_for_vars(method_type, strip_leading_tdicts(args), t, subst, class_vars) with
  | Nothing -> typed_ast.TCall(fn_, args, t, pos)
  | Just resolved_t ->
      # Only rewrite when the resolved type has a concrete head.
      # If still polymorphic (TVar), the existing inference-time dispatch via
      # @fwd markers handles forwarding correctly; rewriting here would emit
      # a TypeName("_") that breaks instance lookup.
      match concrete_type_str(resolved_t) with
      | Nothing -> typed_ast.TCall(fn_, args, t, pos)
      | Just _ ->
          typed_ast.TCall(fn_,
            Cons(typed_ast.TDict(
              ast.TypeConstraint(class_name, Cons(type_to_typeexpr_with_prog_vars(resolved_t, class_name, env), Nil)),
              types.TConst(class_name), pos, typed_ast.EvUnresolved),
              strip_leading_tdicts(args)),
            t, pos)

fn maybe_rewrite_class_method_call(
  env: Dict types.Scheme,
  subst: Dict types.Type,
  fn_: typed_ast.TypedExpr,
  args: List typed_ast.TypedExpr,
  t: types.Type,
  pos: source.SourcePos
) -> typed_ast.TypedExpr =
  match fn_ with
  | typed_ast.TVar method_name _ _ ->
      match dict_get("@class:" ++ method_name, env) with
      | Nothing -> maybe_rewrite_constrained_fn_call(env, subst, fn_, method_name, args, t, pos)
      | Just class_marker ->
          match class_marker with
          | types.Scheme class_vars _ class_type _ ->
              match class_type with
              | types.TConst class_name ->
                  match class_vars with
                  | Nil -> typed_ast.TCall(fn_, args, t, pos)
                  | _ ->
                      match dict_get(method_name, env) with
                      | Nothing -> typed_ast.TCall(fn_, args, t, pos)
                      | Just method_scheme ->
                          match method_scheme with
                          | types.Scheme _ _ method_type _ ->
                              if class_var_in_args(method_type, class_vars) then typed_ast.TCall(fn_, args, t, pos)
                              else try_rewrite_for_return_dispatch(env, subst, fn_, args, t, pos, class_name, class_vars, method_type)
              | _ -> typed_ast.TCall(fn_, args, t, pos)
  | _ -> typed_ast.TCall(fn_, args, t, pos)

fn resolve_dispatch_typed_expr(env: Dict types.Scheme, subst: Dict types.Type, e: typed_ast.TypedExpr) -> typed_ast.TypedExpr =
  match e with
  | typed_ast.TVar _ _ _ -> e
  | typed_ast.TInt _ _ _ -> e
  | typed_ast.TFloat _ _ _ -> e
  | typed_ast.TBool _ _ _ -> e
  | typed_ast.TString _ _ _ -> e
  | typed_ast.TChar _ _ _ -> e
  | typed_ast.TUnit _ _ -> e
  | typed_ast.TTuple items t pos ->
      typed_ast.TTuple(resolve_dispatch_typed_list(env, subst, items), t, pos)
  | typed_ast.TIf cond then_ else_ t pos ->
      typed_ast.TIf(resolve_dispatch_typed_expr(env, subst, cond),
                    resolve_dispatch_typed_expr(env, subst, then_),
                    resolve_dispatch_typed_expr(env, subst, else_),
                    t, pos)
  | typed_ast.TMatch scrutinee branches t pos ->
      typed_ast.TMatch(resolve_dispatch_typed_expr(env, subst, scrutinee),
                       resolve_dispatch_typed_branches(env, subst, branches),
                       t, pos)
  | typed_ast.TCall fn_ args t pos ->
      maybe_rewrite_class_method_call(env, subst,
        resolve_dispatch_typed_expr(env, subst, fn_),
        resolve_dispatch_typed_list(env, subst, args),
        t, pos)
  | typed_ast.TDict _ _ _ _ -> e
  | typed_ast.TMethodRef _ _ _ _ _ -> e
  | typed_ast.TLambda params body t pos ->
      typed_ast.TLambda(params, resolve_dispatch_typed_expr(env, subst, body), t, pos)
  | typed_ast.TBinary op left right t pos ->
      typed_ast.TBinary(op, resolve_dispatch_typed_expr(env, subst, left), resolve_dispatch_typed_expr(env, subst, right), t, pos)
  | typed_ast.TUnary op operand t pos ->
      typed_ast.TUnary(op, resolve_dispatch_typed_expr(env, subst, operand), t, pos)
  | typed_ast.TRange from_ to_ t pos ->
      typed_ast.TRange(resolve_dispatch_typed_expr(env, subst, from_), resolve_dispatch_typed_expr(env, subst, to_), t, pos)
  | typed_ast.TDo steps t pos ->
      typed_ast.TDo(resolve_dispatch_typed_do_steps_local(env, subst, steps), t, pos)
  | typed_ast.TRecord name fields t pos ->
      typed_ast.TRecord(name, resolve_dispatch_typed_record_fields_local(env, subst, fields), t, pos)
  | typed_ast.TGetField expr field t pos ->
      typed_ast.TGetField(resolve_dispatch_typed_expr(env, subst, expr), field, t, pos)

fn resolve_dispatch_typed_list(env: Dict types.Scheme, subst: Dict types.Type, xs: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  match xs with
  | Nil -> Nil
  | Cons h t -> Cons(resolve_dispatch_typed_expr(env, subst, h), resolve_dispatch_typed_list(env, subst, t))

fn resolve_dispatch_typed_branches(env: Dict types.Scheme, subst: Dict types.Type, branches: List typed_ast.TypedMatchBranch) -> List typed_ast.TypedMatchBranch =
  match branches with
  | Nil -> Nil
  | Cons h t ->
      match h with
      | typed_ast.TypedMatchBranch pat body ->
          Cons(typed_ast.TypedMatchBranch(pat, resolve_dispatch_typed_expr(env, subst, body)), resolve_dispatch_typed_branches(env, subst, t))

fn resolve_dispatch_typed_do_steps_local(env: Dict types.Scheme, subst: Dict types.Type, steps: List typed_ast.TypedDoStep) -> List typed_ast.TypedDoStep =
  match steps with
  | Nil -> Nil
  | Cons h t ->
      match h with
      | typed_ast.TDoBindStep pat expr ->
          Cons(typed_ast.TDoBindStep(pat, resolve_dispatch_typed_expr(env, subst, expr)), resolve_dispatch_typed_do_steps_local(env, subst, t))
      | typed_ast.TDoLetStep name expr ->
          Cons(typed_ast.TDoLetStep(name, resolve_dispatch_typed_expr(env, subst, expr)), resolve_dispatch_typed_do_steps_local(env, subst, t))
      | typed_ast.TDoExprStep expr ->
          Cons(typed_ast.TDoExprStep(resolve_dispatch_typed_expr(env, subst, expr)), resolve_dispatch_typed_do_steps_local(env, subst, t))

fn resolve_dispatch_typed_record_fields_local(env: Dict types.Scheme, subst: Dict types.Type, fields: List typed_ast.TypedRecordField) -> List typed_ast.TypedRecordField =
  match fields with
  | Nil -> Nil
  | Cons h t ->
      match h with
      | typed_ast.TypedRecordField name expr ->
          Cons(typed_ast.TypedRecordField(name, resolve_dispatch_typed_expr(env, subst, expr)), resolve_dispatch_typed_record_fields_local(env, subst, t))

# ---------------------------------------------------------------------------
# Soundness validator — detect unresolved TVars in typed AST
# ---------------------------------------------------------------------------

fn has_unresolved_tvar_in_type(t: types.Type) -> Bool =
  match t with
  | types.TVar _ -> true
  | types.TConst _ -> false
  | types.TApp base arg -> has_unresolved_tvar_in_type(base) || has_unresolved_tvar_in_type(arg)
  | types.TFunc param ret _ -> has_unresolved_tvar_in_type(param) || has_unresolved_tvar_in_type(ret)
  | types.TTuple items -> has_unresolved_tvar_in_type_list(items)

fn has_unresolved_tvar_in_type_list(items: List types.Type) -> Bool =
  match items with
  | Nil -> false
  | Cons h t -> has_unresolved_tvar_in_type(h) || has_unresolved_tvar_in_type_list(t)

fn assert_resolved_typed_expr(fn_name: String, expr: typed_ast.TypedExpr) -> Unit !{IO} =
  do
    _ <- if has_unresolved_tvar_in_type(typed_ast.typed_expr_type(expr))
         then print("[WARN] unresolved TVar in typed AST of " ++ fn_name)
         else ()
    match expr with
    | typed_ast.TVar _ _ _ -> ()
    | typed_ast.TInt _ _ _ -> ()
    | typed_ast.TFloat _ _ _ -> ()
    | typed_ast.TBool _ _ _ -> ()
    | typed_ast.TString _ _ _ -> ()
    | typed_ast.TChar _ _ _ -> ()
    | typed_ast.TUnit _ _ -> ()
    | typed_ast.TTuple items _ _ -> assert_resolved_typed_expr_list(fn_name, items)
    | typed_ast.TIf cond then_ else_ _ _ ->
        do
          assert_resolved_typed_expr(fn_name, cond)
          assert_resolved_typed_expr(fn_name, then_)
          assert_resolved_typed_expr(fn_name, else_)
    | typed_ast.TMatch scrutinee branches _ _ ->
        do
          assert_resolved_typed_expr(fn_name, scrutinee)
          assert_resolved_typed_match_branches(fn_name, branches)
    | typed_ast.TCall fn_ args _ _ ->
        do
          assert_resolved_typed_expr(fn_name, fn_)
          assert_resolved_typed_expr_list(fn_name, args)
    | typed_ast.TDict _ _ _ _ -> ()
    | typed_ast.TMethodRef _ _ _ _ _ -> ()
    | typed_ast.TLambda _ body _ _ -> assert_resolved_typed_expr(fn_name, body)
    | typed_ast.TBinary _ left right _ _ ->
        do
          assert_resolved_typed_expr(fn_name, left)
          assert_resolved_typed_expr(fn_name, right)
    | typed_ast.TUnary _ operand _ _ -> assert_resolved_typed_expr(fn_name, operand)
    | typed_ast.TRange from_ to_ _ _ ->
        do
          assert_resolved_typed_expr(fn_name, from_)
          assert_resolved_typed_expr(fn_name, to_)
    | typed_ast.TDo steps _ _ -> assert_resolved_typed_do_steps(fn_name, steps)
    | typed_ast.TRecord _ fields _ _ -> assert_resolved_typed_record_fields(fn_name, fields)
    | typed_ast.TGetField expr _ _ _ -> assert_resolved_typed_expr(fn_name, expr)

fn assert_resolved_typed_expr_list(fn_name: String, exprs: List typed_ast.TypedExpr) -> Unit !{IO} =
  match exprs with
  | Nil -> ()
  | Cons h t ->
      do
        assert_resolved_typed_expr(fn_name, h)
        assert_resolved_typed_expr_list(fn_name, t)

fn assert_resolved_typed_match_branches(fn_name: String, branches: List typed_ast.TypedMatchBranch) -> Unit !{IO} =
  match branches with
  | Nil -> ()
  | Cons h t ->
      do
        match h with
        | typed_ast.TypedMatchBranch _ body -> assert_resolved_typed_expr(fn_name, body)
        assert_resolved_typed_match_branches(fn_name, t)

fn assert_resolved_typed_do_steps(fn_name: String, steps: List typed_ast.TypedDoStep) -> Unit !{IO} =
  match steps with
  | Nil -> ()
  | Cons h t ->
      do
        match h with
        | typed_ast.TDoBindStep _ expr -> assert_resolved_typed_expr(fn_name, expr)
        | typed_ast.TDoLetStep _ expr -> assert_resolved_typed_expr(fn_name, expr)
        | typed_ast.TDoExprStep expr -> assert_resolved_typed_expr(fn_name, expr)
        assert_resolved_typed_do_steps(fn_name, t)

fn assert_resolved_typed_record_fields(fn_name: String, fields: List typed_ast.TypedRecordField) -> Unit !{IO} =
  match fields with
  | Nil -> ()
  | Cons h t ->
      do
        match h with
        | typed_ast.TypedRecordField _ expr -> assert_resolved_typed_expr(fn_name, expr)
        assert_resolved_typed_record_fields(fn_name, t)

# ---------------------------------------------------------------------------
# FnDecl body inference
# ---------------------------------------------------------------------------

# fold_fwd_markers takes the @eta_fwd:* markers computed for a constrained
# FnDecl's body and folds them into the GlobalEnv that will flow to the
# next decl.  The env parameter is typed GlobalEnv (not raw Dict) so the
# caller must explicitly construct a global env at the call site — preventing
# the retro bug where a body-scope env (containing @fwd:* markers) was
# accidentally fed in.
fn fold_fwd_markers(markers: Dict types.Scheme, env: GlobalEnv) -> GlobalEnv =
  GlobalEnv(fold_fwd_entries(vec_to_list(dict_entries(markers)), global_env_dict(env)))

fn fold_fwd_entries(entries: List (String, types.Scheme), env: Dict types.Scheme) -> Dict types.Scheme =
  match entries with
  | Nil -> env
  | Cons (key, scheme) rest ->
      fold_fwd_entries(rest, dict_set(key, scheme, env))

# Signature rigidity check (W3/F-RIGID): a WRITTEN type variable must stay
# abstract in the body. Each declared tyvar was instantiated to a fresh TVar
# (recorded in prog_to_fresh keyed by the written name); after checking the body,
# if one resolves through the final substitution to a NON-variable type, the body
# constrained it and the declared signature is too general. A fresh var that
# resolves to another variable is still polymorphic and fine. Runs
# post-unification so it never perturbs dict forwarding (constraints leave the
# tyvar a TVar), unlike skolemization.
#
# `names` are the scheme's quantified vars; `_unann`/`_unann_<param>` are
# synthesized placeholders for UNANNOTATED returns/params (not written by the
# programmer) and are excluded — inference is free to specialize those (e.g.
# `rcompose(f: a->b, g: b->c) = \x -> g(f(x))`, whose inferred return is a->c).
fn rigidity_violation(prog_to_fresh: Dict types.Type, s2: Dict types.Type, names: List String) -> Maybe String =
  match names with
  | Nil -> Nothing
  | Cons n rest ->
      if str_starts_with(n, "_unann") then rigidity_violation(prog_to_fresh, s2, rest)
      else
        match dict_get(n, prog_to_fresh) with
        | Nothing -> rigidity_violation(prog_to_fresh, s2, rest)
        | Just fresh_v ->
            match unifier.apply_subst(s2, fresh_v) with
            | types.TVar _ -> rigidity_violation(prog_to_fresh, s2, rest)
            | other ->
                # A variable bound to a purely-variable structure (e.g. an
                # identity's `t -> t`, or a tuple of vars) is still fully
                # polymorphic — not a violation. Only a binding that pins the
                # variable to a concrete constructor (Int, List c, ...) means the
                # declared signature was too general for its body.
                if type_has_const(other)
                then Just(n ++ " forced to " ++ types.type_to_string(other))
                else rigidity_violation(prog_to_fresh, s2, rest)

# True if the type mentions any concrete type constructor (TConst) — as opposed
# to being built purely from type variables via arrows and tuples.
fn type_has_const(t: types.Type) -> Bool =
  match t with
  | types.TVar _ -> false
  | types.TConst _ -> true
  | types.TApp a b -> if type_has_const(a) then true else type_has_const(b)
  | types.TFunc p r _ -> if type_has_const(p) then true else type_has_const(r)
  | types.TTuple items -> tuple_has_const(items)

fn tuple_has_const(items: List types.Type) -> Bool =
  match items with
  | Nil -> false
  | Cons h t -> if type_has_const(h) then true else tuple_has_const(t)

fn check_fn_body(
  state: unifier.InferState,
  decl: ast.Decl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  alias_env: Dict types.Type
) -> (typed_ast.BodyResult, Dict types.Scheme) !{IO} =
  match decl with
  | ast.FnDecl name params ret_type_maybe effects_maybe constraints body fn_pos ->
      do
        let decl_scheme = scheme_from_fn_parts(params, ret_type_maybe, effects_maybe, alias_env)
        (inst_type, prog_to_fresh) <- unifier.instantiate_with_vars(state, decl_scheme)
        let fwd_env = seed_forward_markers(constraints, prog_to_fresh, env)
        # Compute @eta_fwd:* markers in parallel without walking fwd_env post-hoc.
        # Constraint-free decls return dict_empty() instantly.
        let fwd_markers = compute_eta_fwd_markers(constraints, prog_to_fresh, env)
        # Seed @constrained_N:name markers into the body env so that recursive
        # constrained calls (e.g., decorated_merge_sorted calling itself) can
        # find the markers and have dict args injected by inject_constrained_fn_dicts.
        let self_env = register_constrained_fn_markers(name, constraints, fwd_env)
        br <- typecheck_expr(state, fn_body_env(name, params, inst_type, self_env), subst, eff_subst, body)
        match br with
        | InferErr pos msg -> (fn_body_err(name, pos, msg), dict_empty())
        | InferOk typed_body s1 _ _ ->
            match unifier.unify_types(s1, typed_ast.typed_expr_type(typed_body), fn_return_type(inst_type, list_length(params))) with
            | Err e -> (typed_ast.BodyErr(dummy_pos(), "Return type mismatch in " ++ name ++ ": " ++ e), dict_empty())
            | Ok s2 ->
                match rigidity_violation(prog_to_fresh, s2, types.scheme_vars(decl_scheme)) with
                | Just bad ->
                    (typed_ast.BodyErr(fn_pos, "Signature too general for its body in " ++ name ++ ": type variable " ++ bad), dict_empty())
                | Nothing ->
                    (typed_ast.BodyOk(resolve_dispatch_typed_expr(self_env, s2, typed_body), unifier.apply_subst(s2, inst_type)), fwd_markers)
  | _ -> (typed_ast.BodyOk(dummy_unit(), types.TConst("Unit")), dict_empty())

fn fn_body_env(name: String, params: List ast.Param, inst_type: types.Type, env: Dict types.Scheme) -> Dict types.Scheme =
  extend_env_with_params(
    params,
    ctor_param_types(inst_type),
    dict_set(name, types.mono(inst_type), env)
  )

fn fn_body_err(name: String, pos: source.SourcePos, msg: String) -> typed_ast.BodyResult =
  # Previously: if `is_unknown_ref(msg)` returned BodyLenient, which caused
  # `typecheck_decl` to silently substitute a `dummy_unit()` body and continue.
  # That masked real bugs (e.g. unresolved class-method references like
  # `__unresolved_Semigroup_a`) and produced misleading downstream errors.
  # All Unknown-variable / Unknown-constructor errors are now hard errors.
  if str_starts_with(name, "stdlib.compiler.")
  then typed_ast.BodyErr(pos, "[DIAG] " ++ msg ++ " in function " ++ name)
  else typed_ast.BodyErr(pos, msg ++ " in function " ++ name)

fn is_unknown_ref(msg: String) -> Bool =
  str_starts_with(msg, "Unknown variable: ") ||
  str_starts_with(msg, "Unknown constructor: ")

# ---------------------------------------------------------------------------
# ClassDecl: method registration + constraint markers
# ---------------------------------------------------------------------------

fn register_class_methods(type_params: List String, methods: List ast.ClassMethodSig, env: Dict types.Scheme) -> Dict types.Scheme =
  match methods with
  | Nil -> env
  | Cons sig rest ->
      register_class_methods(type_params, rest, register_class_method(type_params, sig, env))

fn register_class_method(type_params: List String, sig: ast.ClassMethodSig, env: Dict types.Scheme) -> Dict types.Scheme =
  match sig with
  | ast.ClassMethodSig name params ret_type effects_maybe ->
      # Extend the class type params with any additional lowercase type variables
      # appearing in the method signature (e.g. `a` and `b` in
      # `fmap(f: a -> b, xs: f a) -> f b`).  Without this, method-specific
      # vars become TConst instead of TVar, corrupting the inferred substitution
      # at call sites and producing spurious "No instance of X for Y" errors.
      dict_set(name, scheme_from_fn_parts_inner(
        collect_ret_type_vars(Just(ret_type), collect_param_type_vars(params, type_params)),
        params, Just(ret_type), effects_maybe, dict_empty()), env)

fn register_class_method_markers(class_name: String, type_params: List String, methods: List ast.ClassMethodSig, env: Dict types.Scheme) -> Dict types.Scheme =
  match methods with
  | Nil -> env
  | Cons sig rest ->
      match sig with
      | ast.ClassMethodSig name _ _ _ ->
          register_class_method_markers(class_name, type_params, rest,
            dict_set("@class:" ++ name,
                     types.Scheme(type_params, Nil, types.TConst(class_name), types.EffectPure),
                     env))

# Register "@super:{class_name}:{super_name}" entries for each superclass in the
# ClassDecl's where-clause.  These are later consumed by seed_superclass_fwd_markers
# to propagate @fwd markers to superclass methods at call sites.
fn register_superclass_markers(class_name: String, superclasses: List ast.TypeConstraint, env: Dict types.Scheme) -> Dict types.Scheme =
  match superclasses with
  | Nil -> env
  | Cons sc rest ->
      match sc with
      | ast.TypeConstraint super_name _ ->
          register_superclass_markers(class_name, rest,
            dict_set("@super:" ++ class_name ++ ":" ++ super_name,
                     types.mono(types.TConst(super_name)), env))

# ---------------------------------------------------------------------------
# FnDecl: constrained-function markers
# ---------------------------------------------------------------------------
#
# register_constrained_fn_markers seeds "@constrained_N:fn_name" entries so
# that check_call_constraint can inject TDict evidence when calling regular
# constrained functions (not class methods).  Each constraint gets its own
# numbered key to support functions with multiple constraints.

fn register_constrained_fn_markers(name: String, constraints: List ast.TypeConstraint, env: Dict types.Scheme) -> Dict types.Scheme =
  register_constrained_fn_markers_acc(name, constraints, 0, env)

fn register_fn_decl_scheme(
  name: String,
  params: List ast.Param,
  ret_type_maybe: Maybe ast.TypeExpr,
  effects_maybe: Maybe (List String),
  constraints: List ast.TypeConstraint,
  alias_env: Dict types.Type,
  env: Dict types.Scheme
) -> Dict types.Scheme =
  match constraints with
  | Nil ->
      remove_constrained_fn_markers(name, 0,
        dict_remove("@class:" ++ name,
          dict_set(name, scheme_from_fn_parts(params, ret_type_maybe, effects_maybe, alias_env), env)))
  | _ ->
      register_constrained_fn_markers(name, constraints,
        dict_remove("@class:" ++ name,
          dict_set(name, scheme_from_fn_parts(params, ret_type_maybe, effects_maybe, alias_env), env)))

fn remove_constrained_fn_markers(name: String, idx: Int, env: Dict types.Scheme) -> Dict types.Scheme =
  match dict_get(key, env) with
  | Nothing -> env
  | Just _ -> remove_constrained_fn_markers(name, idx + 1, dict_remove(key, env))
  where key = "@constrained_" ++ int_to_string(idx) ++ ":" ++ name

fn register_constrained_fn_markers_acc(name: String, constraints: List ast.TypeConstraint, idx: Int, env: Dict types.Scheme) -> Dict types.Scheme =
  match constraints with
  | Nil -> env
  | Cons c rest ->
      match c with
      | ast.TypeConstraint class_name type_args ->
          match type_args with
          | Cons (ast.TypeName prog_var) _ ->
              register_constrained_fn_markers_acc(name, rest, idx + 1,
                dict_set("@constrained_" ++ int_to_string(idx) ++ ":" ++ name,
                         types.mono(types.TApp(types.TConst(class_name), types.TConst(prog_var))), env))
          | _ ->
              register_constrained_fn_markers_acc(name, rest, idx + 1,
                dict_set("@constrained_" ++ int_to_string(idx) ++ ":" ++ name,
                         types.mono(types.TConst(class_name)), env))

# ---------------------------------------------------------------------------
# InstanceDecl: instance marker registration
# ---------------------------------------------------------------------------

fn register_instance_marker(constraint: ast.TypeConstraint, env: Dict types.Scheme) -> Dict types.Scheme =
  match constraint with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> env
      | Cons head_te _ ->
          dict_set(
            "@inst:" ++ class_name ++ ":" ++ type_head_str(type_from_ast(head_te, dict_empty())),
            types.mono(types.TConst("Unit")),
            env
          )

# ---------------------------------------------------------------------------
# InstanceDecl: instance method body checking
# ---------------------------------------------------------------------------

fn check_instance_methods(
  state: unifier.InferState,
  inst_constraints: List ast.TypeConstraint,
  methods: List ast.InstanceMethodImpl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect
) -> typed_ast.InstanceMethodsResult !{IO} =
  check_instance_methods_acc(state, inst_constraints, methods, env, subst, eff_subst, Nil)

fn check_instance_methods_acc(
  state: unifier.InferState,
  inst_constraints: List ast.TypeConstraint,
  methods: List ast.InstanceMethodImpl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  acc: List typed_ast.TypedInstanceMethod
) -> typed_ast.InstanceMethodsResult !{IO} =
  match methods with
  | Nil -> typed_ast.InstanceMethodsOk(typed_method_list_reverse(acc))
  | Cons method rest ->
      do
        r <- check_instance_method(state, inst_constraints, method, env, subst, eff_subst)
        match r with
        | InstanceMethodErr pos e -> typed_ast.InstanceMethodsErr(pos, e)
        | InstanceMethodOk typed_method ->
            check_instance_methods_acc(state, inst_constraints, rest, env, subst, eff_subst, Cons(typed_method, acc))

fn check_instance_method(
  state: unifier.InferState,
  inst_constraints: List ast.TypeConstraint,
  method: ast.InstanceMethodImpl,
  env: Dict types.Scheme,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect
) -> InstanceMethodResult !{IO} =
  match method with
  | ast.InstanceMethodImpl name params ret_maybe eff_maybe body ->
      do
        (inst_type, prog_to_fresh) <- unifier.instantiate_with_vars(state, scheme_from_fn_parts(params, ret_maybe, eff_maybe, dict_empty()))
        let fwd_env = seed_forward_markers(inst_constraints, prog_to_fresh, env)
        let body_env = extend_env_with_params(params, ctor_param_types(inst_type), fwd_env)
        br <- typecheck_expr(state, body_env, subst, eff_subst, body)
        match br with
        | InferErr pos msg -> instance_method_err(name, pos, msg)
        | InferOk typed_body s1 _ _ ->
            match unifier.unify_types(s1, typed_ast.typed_expr_type(typed_body), fn_return_type(inst_type, list_length(params))) with
            | Err e -> InstanceMethodErr(dummy_pos(), "Return type mismatch in instance method " ++ name ++ ": " ++ e)
            | Ok s2 ->
                InstanceMethodOk(
                  typed_ast.TypedInstanceMethod(name, params, ret_maybe, eff_maybe, resolve_dispatch_typed_expr(body_env, s2, typed_body)))

fn instance_method_err(name: String, pos: source.SourcePos, msg: String) -> InstanceMethodResult =
  # Previously: lenient short-circuit that returned a `dummy_unit()`-bodied
  # method on Unknown-variable / Unknown-constructor errors. Now hard error,
  # matching the change to `fn_body_err`.
  InstanceMethodErr(pos, msg ++ " in instance method " ++ name)
