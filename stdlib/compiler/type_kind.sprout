module stdlib.compiler.type_kind

# Single source of truth for "is this source-level type a known non-heap
# scalar?".  Int, Bool, Char and Double qualify.  A Char is an immediate i64 Unicode
# codepoint (not a heap string), so it is never a managed pointer and never needs
# GC rooting — exactly like Int.  (char_to_string encodes a codepoint to a heap
# String on demand; that String is rooted, but the Char itself is not.)
# Used by both backend paths to decide whether a value needs GC rooting:
#   - stdlib.compiler.codegen (direct AST→LLVM): elides push_temp_root_typed
#     for scalar-typed values.
#   - stdlib.compiler.ast_to_ir (Sprout-IR path): tags IRFunction params,
#     IRLoadEnvSlot, and IRGetField with kind=IRTScalar so ir_rooting's
#     params_heap_origin / op_produces_simple_heap skip them.
#
# This module is also the only place a `ScalarWhy` can be built, and
# `sprout_ir.IRTScalar` needs one.  A heap value tagged IRTScalar is never rooted
# (use-after-free), so every scalar claim names its reason here.
#
# Prior to centralisation the predicate lived only in codegen.sprout; the
# IR path conservatively over-rooted every param.  See BACKLOG.md:367 for
# the bug this module exists to fix structurally.

import stdlib.compiler.ast as ast
import stdlib.compiler.types as types

# --- Scalar witness ---

# Why an IR value is a non-heap scalar.  Exported without `(..)`: the constructors
# are private, so the minting functions below are the only way to get one.
export type ScalarWhy =
  | ByType
  | FieldCode
  | LiteralTested
  | TupleSlot
  | UnitResult
  | CtorTag

# Just a witness when `p` is an Int or Bool literal pattern: the element it tests is
# compared as an i64, so it is a scalar. Nothing for any other pattern.
export fn scalar_of_literal_pattern(p: ast.Pattern) -> Maybe ScalarWhy =
  match p with
  | ast.IntPattern _ _ -> Just(LiteralTested)
  | ast.BoolPattern _ _ -> Just(LiteralTested)
  | _ -> Nothing

# A slot of an unboxed tuple worker result: scalar_tuple_width admits only
# tuples whose every field passes type_is_non_heap_scalar.
export let tuple_slot: ScalarWhy = TupleSlot

# The result of a call that returns Unit (print_value).
export let unit_result: ScalarWhy = UnitResult

# A constructor tag word (the `_argw` wrapper's tag parameter).
export let ctor_tag: ScalarWhy = CtorTag

# --- Private helper ---

# Exact match on the canonical name. A module's own `type Int` canonicalises to
# `<module>.Int`, a heap ADT; only the bare prelude primitive is a scalar.
fn is_scalar_name(name: String) -> Bool =
  name == "Int" || name == "Bool" || name == "Char" || name == "Double"

# --- Public predicates ---

# Just a witness when an ast.TypeExpr annotation declares a known non-heap
# scalar (Int, Bool, Char, Double).  Everything else — String, ADTs, tuples, closures,
# Unit, and TVars/polymorphic positions, which may resolve to heap objects at
# runtime — is Nothing and is rooted conservatively.
export fn scalar_of_type_expr(te: ast.TypeExpr) -> Maybe ScalarWhy =
  match te with
  | ast.TypeName name -> if is_scalar_name(name) then Just(ByType) else Nothing
  | _ -> Nothing

# Same predicate over an inferred `types.Type` (used by ast_to_ir to classify a
# call's return type for IRCall rooting).  The concrete scalar constants
# Int/Bool/Char/Double are non-heap; everything else — String, ADTs, tuples,
# closures, Unit, and TVars/polymorphic positions — is treated as heap and rooted
# conservatively, matching the TypeExpr predicate.
export fn scalar_of_type(t: types.Type) -> Maybe ScalarWhy =
  match t with
  | types.TConst name -> if is_scalar_name(types.type_id_name(name)) then Just(ByType) else Nothing
  | _ -> Nothing

export fn type_expr_is_non_heap_scalar(te: ast.TypeExpr) -> Bool =
  is_just(scalar_of_type_expr(te))

export fn type_is_non_heap_scalar(t: types.Type) -> Bool =
  is_just(scalar_of_type(t))

# --- Constructor field codes ---

# The ctor-field-kinds byte for a scalar field type: "i" for Int and Char (a Char
# is an immediate codepoint), "b" for Bool, Nothing otherwise.  Double is a scalar
# too but has no code yet: its field encodes "p" and is rooted needlessly, which is
# safe because the GC ignores a root that is not a heap address.  Encoder:
# field_kinds.ctor_field_kind; decoder: scalar_of_field_code.
export fn scalar_field_code(te: ast.TypeExpr) -> Maybe String =
  match te with
  | ast.TypeName name ->
      if name == "Int" || name == "Char" then Just("i")
      else if name == "Bool" then Just("b")
      else Nothing
  | _ -> Nothing

# Inverse of scalar_field_code: Just a witness for the scalar codes 'i' and 'b'.
export fn scalar_of_field_code(ch: Char) -> Maybe ScalarWhy =
  if ch == 'i' || ch == 'b' then Just(FieldCode) else Nothing
