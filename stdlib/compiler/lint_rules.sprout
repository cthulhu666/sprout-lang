module stdlib.compiler.lint_rules

import stdlib.compiler.ast as ast
import stdlib.compiler.parser as parser
import stdlib.compiler.lexer as lexer
import stdlib.compiler.token as token
import stdlib.compiler.source as source
import stdlib.string as string
import stdlib.compiler.desugar_ctx as desugar_ctx
import stdlib.compiler.lint_pattern as lint_pattern

# AST-based lint findings — line, col, rule id, message. A sibling to
# formatter.LintIssue's line-based Style checks; this is the "Lint" category,
# built on the real parser AST instead of raw text/tokens.
export type LintFinding (..) =
  | LintFinding Int Int String String

fn mk_finding(pos: source.SourcePos, rule_id: String, message: String) -> LintFinding =
  LintFinding(pos.line, pos.column, rule_id, message)

# ---------------------------------------------------------------------------
# Rule: staircase-of-doom
#
# A chain of nested 2-branch matches, each peeling one constructor off a
# Maybe/Result-like value, of the exact shape docs/idiomatic-sprout.md calls
# out to flatten with `let..else`. Purely syntactic — no type info needed.

fn is_var_pattern(pat: ast.Pattern) -> Bool =
  match pat with
  | ast.VarPattern _ _ -> true
  | _ -> false

fn has_binding_subpattern(subpats: List ast.Pattern) -> Bool =
  match subpats with
  | Nil -> false
  | Cons p rest -> is_var_pattern(p) || has_binding_subpattern(rest)

# A pattern let..else could bind: a constructor pattern with at least one
# variable subpattern (Just te, Ok x, TypedOk prog env) — not Nothing, not True.
fn is_binding_pattern(pat: ast.Pattern) -> Bool =
  match pat with
  | ast.ConstructorPattern _ subpats _ -> has_binding_subpattern(subpats)
  | _ -> false

# List's own Cons — self-recursive list-walk shape (`match xs with | Nil -> ..
# | Cons h t -> match t with ...`), not a Maybe/Result unwrap. Flattening this
# with let..else would point at the wrong fix; idiomatic-sprout.md's own
# combinator section is what applies here instead, so this rule stays scoped
# to Maybe/Result-shaped chains and leaves list recursion alone.
fn is_list_cons_pattern(pat: ast.Pattern) -> Bool =
  match pat with
  | ast.ConstructorPattern name _ _ -> name == ast.list_ctor_cons
  | _ -> false

fn is_two_branch_match(e: ast.Expr) -> Bool =
  match e with
  | ast.MatchExpr _ [_, _] _ -> true
  | _ -> false

# A branch "continues" the staircase when its pattern binds a variable
# (excluding list-walk recursion via Cons) AND its body is itself a 2-branch
# match — the shape a `let <pat> = e else fb` guard line could replace.
fn continues(pat: ast.Pattern, body: ast.Expr) -> Bool =
  is_binding_pattern(pat) && ! is_list_cons_pattern (pat) && is_two_branch_match(body)

# classify: given a match's two branches, decide whether exactly one of them
# continues the staircase. Returns both patterns and both bodies — the terminal
# pattern so callers can tell whether its body needs its own failing binding
# (terminal_needs_own_payload), the continuing one because it binds the name the
# nested match's scrutinee reads.
fn classify(b1: ast.MatchBranch,
            b2: ast.MatchBranch) -> Maybe(ast.Pattern, ast.Expr, ast.Pattern, ast.Expr) =
  match b1 with
  | ast.MatchBranch p1 body1 ->
      match b2 with
      | ast.MatchBranch p2 body2 ->
          let c1 = continues(p1, body1)
              c2 = continues(p2, body2)
          in if c1 && ! c2 then Just((p2, body2, p1, body1))
             else if c2 && ! c1 then Just((p1, body1, p2, body2))
             else Nothing

fn param_names(params: List ast.Param) -> List String =
  list_map(param_name, params)

fn name_in_list(name: String, names: List String) -> Bool =
  match names with
  | Nil -> false
  | Cons n rest -> n == name || name_in_list(name, rest)

# True when `e` references any of `names` as a plain variable — a simple,
# shadowing-unaware syntactic check (adequate here: this only ever picks
# which lint message to show, never rewrites anything).
fn expr_uses_any(names: List String, e: ast.Expr) -> Bool =
  match e with
  | ast.VarExpr name _ -> name_in_list(name, names)
  | ast.MatchExpr scrut branches _ ->
      expr_uses_any(names, scrut) || branches_use_any(names, branches)
  | ast.IfExpr cond then_ else_ _ ->
      expr_uses_any(names, cond) || expr_uses_any(names, then_) || expr_uses_any(names, else_)
  | ast.CallExpr callee args _ ->
      expr_uses_any(names, callee) || exprs_use_any(names, args)
  | ast.TupleExpr elems _ -> exprs_use_any(names, elems)
  | ast.BinaryExpr _ left right _ ->
      expr_uses_any(names, left) || expr_uses_any(names, right)
  | ast.UnaryExpr _ operand _ -> expr_uses_any(names, operand)
  | ast.LambdaExpr _ body _ -> expr_uses_any(names, body)
  | ast.DoExpr steps _ -> do_steps_use_any(names, steps)
  | ast.RecordExpr _ fields _ -> record_fields_use_any(names, fields)
  | ast.GetFieldExpr rec_expr _ _ -> expr_uses_any(names, rec_expr)
  | ast.RecordUpdateExpr base fields _ -> expr_uses_any(names, base) || record_fields_use_any(names, fields)
  | ast.IntRangeExpr lo hi _ -> expr_uses_any(names, lo) || expr_uses_any(names, hi)
  | ast.StringTemplateExpr parts _ -> template_parts_use_any(names, parts)
  | ast.ComprehensionExpr elem gens _ -> expr_uses_any(names, elem) || comprehension_gens_use_any(names, gens)
  | ast.LetBindExpr pat value els body pos -> expr_uses_any(names, ast.let_bind_match(pat, value, els, body, pos))
  | ast.TryExpr operand _ -> expr_uses_any(names, operand)
  | _ -> false  # leaves: Int/Float/Bool/String/Char/Unit — no sub-expressions

fn comprehension_gens_use_any(names: List String, gens: List ast.ComprehensionGen) -> Bool =
  match gens with
  | Nil -> false
  | Cons g rest ->
      (match g with
       | ast.ComprehensionGen _ src guards -> expr_uses_any(names, src) || exprs_use_any(names, guards))
      || comprehension_gens_use_any(names, rest)

fn exprs_use_any(names: List String, exprs: List ast.Expr) -> Bool =
  match exprs with
  | Nil -> false
  | Cons e rest -> expr_uses_any(names, e) || exprs_use_any(names, rest)

fn branches_use_any(names: List String, branches: List ast.MatchBranch) -> Bool =
  match branches with
  | Nil -> false
  | Cons b rest ->
      match b with
      | ast.MatchBranch _ body -> expr_uses_any(names, body) || branches_use_any(names, rest)

fn do_steps_use_any(names: List String, steps: List ast.DoStep) -> Bool =
  match steps with
  | Nil -> false
  | [ast.DoPatStep kind pat value els pos | rest] ->
      do_steps_use_any(names, ast.do_pat_steps(kind, pat, value, els, rest, pos))
  | [ast.DoBindStep _ value | rest] -> expr_uses_any(names, value) || do_steps_use_any(names, rest)
  | [ast.DoLetStep _ value | rest] -> expr_uses_any(names, value) || do_steps_use_any(names, rest)
  | [ast.DoExprStep value | rest] -> expr_uses_any(names, value) || do_steps_use_any(names, rest)

fn record_fields_use_any(names: List String, fields: List ast.RecordField) -> Bool =
  match fields with
  | Nil -> false
  | Cons f rest ->
      match f with
      | ast.RecordField _ value -> expr_uses_any(names, value) || record_fields_use_any(names, rest)

fn template_parts_use_any(names: List String, parts: List ast.TemplateExprPart) -> Bool =
  match parts with
  | Nil -> false
  | Cons p rest ->
      (match p with
       | ast.LitPart _ -> false
       | ast.InterpPart e -> expr_uses_any(names, e))
      || template_parts_use_any(names, rest)

# Does a terminal branch's body depend on its own (failing) match? `let <pat> = e
# else fb` cannot express that: `fb` is matched against a bare wildcard
# (ast.let_bind_match), so it has no access to whatever the
# failing pattern would have bound (e.g. the `msg` in `Err msg -> ...`).
fn terminal_needs_own_payload(pat: ast.Pattern, body: ast.Expr) -> Bool =
  expr_uses_any(ast.pattern_names(pat), body)

# ---------------------------------------------------------------------------
# Generic ast.Expr traversal — every variant, modeled on checker.sprout's
# desugar_expr_no_ctx_i so no shape is silently skipped (a missed variant here
# is a silent false negative, the worst failure mode for a coverage tool).

fn walk_expr(bound: List String, e: ast.Expr) -> List LintFinding =
  match e with
  | ast.MatchExpr scrut branches pos ->
      list_append(combinator_findings(bound, e, pos), walk_match(bound, scrut, branches, pos))
  | ast.IfExpr cond then_ else_ pos ->
      list_append(combinator_findings(bound, e, pos),
        list_append(walk_expr(bound, cond),
                    list_append(walk_expr(bound, then_), walk_expr(bound, else_))))
  | ast.CallExpr callee args _ ->
      list_append(multi_line_lambda_findings(args),
                  list_append(walk_expr(bound, callee), walk_exprs(bound, args)))
  | ast.TupleExpr elems _ -> walk_exprs(bound, elems)
  | ast.BinaryExpr _ left right _ ->
      list_append(walk_expr(bound, left), walk_expr(bound, right))
  | ast.UnaryExpr _ operand _ -> walk_expr(bound, operand)
  | ast.LambdaExpr params body _ -> walk_expr(list_append(param_names(params), bound), body)
  | ast.DoExpr steps _ -> walk_do_steps(bound, steps)
  | ast.RecordExpr _ fields _ -> walk_record_fields(bound, fields)
  | ast.GetFieldExpr rec_expr _ _ -> walk_expr(bound, rec_expr)
  | ast.RecordUpdateExpr base fields _ ->
      list_append(walk_expr(bound, base), walk_record_fields(bound, fields))
  | ast.IntRangeExpr lo hi _ ->
      list_append(walk_expr(bound, lo), walk_expr(bound, hi))
  | ast.StringTemplateExpr parts _ -> walk_template_parts(bound, parts)
  | ast.ComprehensionExpr elem gens _ -> walk_comprehension(bound, elem, gens)
  | ast.LetBindExpr pat value els body pos -> walk_expr(bound, ast.let_bind_match(pat, value, els, body, pos))
  | ast.TryExpr operand _ -> walk_expr(bound, operand)
  | _ -> Nil  # leaves: Var/Int/Float/Bool/String/Char/Unit — no sub-expressions

# A generator's pattern scopes over its own guards, the generators after it and
# the element expression, so the environment grows left to right.
fn walk_comprehension(bound: List String, elem: ast.Expr,
                      gens: List ast.ComprehensionGen) -> List LintFinding =
  match gens with
  | Nil -> walk_expr(bound, elem)
  | Cons g rest ->
      match g with
      | ast.ComprehensionGen pat src guards ->
          let inner = list_append(ast.pattern_names(pat), bound)
          in list_append(walk_expr(bound, src),
               list_append(walk_exprs(inner, guards), walk_comprehension(inner, elem, rest)))

fn walk_exprs(bound: List String, exprs: List ast.Expr) -> List LintFinding =
  match exprs with
  | Nil -> Nil
  | Cons e rest -> list_append(walk_expr(bound, e), walk_exprs(bound, rest))

# A step's binder scopes over the steps after it, never over its own value.
fn walk_do_steps(bound: List String, steps: List ast.DoStep) -> List LintFinding =
  match steps with
  | Nil -> Nil
  | Cons s rest ->
      match s with
      | ast.DoBindStep pat value ->
          list_append(walk_expr(bound, value),
                      walk_do_steps(list_append(ast.pattern_names(pat), bound), rest))
      | ast.DoLetStep n value ->
          list_append(walk_expr(bound, value), walk_do_steps(Cons(n, bound), rest))
      | ast.DoExprStep value ->
          list_append(walk_expr(bound, value), walk_do_steps(bound, rest))
      | ast.DoPatStep kind pat value els pos ->
          walk_do_steps(bound, ast.do_pat_steps(kind, pat, value, els, rest, pos))

fn walk_record_fields(bound: List String, fields: List ast.RecordField) -> List LintFinding =
  match fields with
  | Nil -> Nil
  | Cons f rest ->
      match f with
      | ast.RecordField _ value ->
          list_append(walk_expr(bound, value), walk_record_fields(bound, rest))

fn walk_template_parts(bound: List String,
                       parts: List ast.TemplateExprPart) -> List LintFinding =
  match parts with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.LitPart _ -> walk_template_parts(bound, rest)
      | ast.InterpPart e ->
          list_append(walk_expr(bound, e), walk_template_parts(bound, rest))

fn walk_branch(bound: List String, b: ast.MatchBranch) -> List LintFinding =
  match b with
  | ast.MatchBranch pat body -> walk_expr(list_append(ast.pattern_names(pat), bound), body)

fn walk_branches(bound: List String, branches: List ast.MatchBranch) -> List LintFinding =
  match branches with
  | Nil -> Nil
  | Cons b rest -> list_append(walk_branch(bound, b), walk_branches(bound, rest))

# Minimum chain length (number of nested matches, including the root) before
# a chain is reported. The docs/idiomatic-sprout.md example is itself only
# 2 deep; raising this filters out simple two-level unwraps and flags only
# genuinely deep cascades.
let min_staircase_depth = 3

# walk_chain: the chain starting at this 2-branch match. Returns (depth,
# blocked, findings) — depth is 1 + however deep the continuing branch's own
# chain goes; blocked is true when ANY link's terminal branch needs its own
# (failing-pattern) payload, meaning the flat form needs a binding-else
# (`else <pat> -> <h>`, Tier 1b) rather than a constant else; findings covers every
# non-chain subexpression along the way (the scrutinee at each link, each
# link's terminal body) but never a finding for THIS node — the caller
# decides that once it knows the total depth and blocked status.
fn walk_chain(bound: List String, branches: List ast.MatchBranch,
              scrut: ast.Expr) -> (Int, Bool, List LintFinding) =
  match branches with
  | [b1, b2] ->
      (match classify(b1, b2) with
       | Just (terminal_pat, terminal_body, continuing_pat, continuing_match) ->
           (match walk_chain_expr(list_append(ast.pattern_names(continuing_pat), bound),
                                  continuing_match) with
            | (inner_depth, inner_blocked, inner_findings) ->
                (1 + inner_depth,
                  inner_blocked || terminal_needs_own_payload(terminal_pat, terminal_body),
                  list_append(walk_expr(bound, scrut),
                    list_append(walk_expr(list_append(ast.pattern_names(terminal_pat), bound),
                                          terminal_body),
                                inner_findings))))
       | Nothing ->
           # Neither branch continues, so this match is the chain's own
           # trailing leaf, not a link that gets rewritten into an else-
           # fallback. Its arms stay ordinary match arms either way, free to
           # use their own bindings — hence `blocked = false` here even if
           # b1/b2 reference their own payload.
           (1, false, list_append(walk_expr(bound, scrut),
                        list_append(walk_branch(bound, b1), walk_branch(bound, b2)))))
  | _ -> (1, false, list_append(walk_expr(bound, scrut), walk_branches(bound, branches)))

# walk_chain_expr: like walk_chain, but for an expression that may or may not
# itself be a match. It is also where a chain link's OWN combinator finding is
# collected: `walk_chain` recurses through here rather than `walk_expr`, so until
# this arm offered the node to the rule, no combinator nested in a 2-branch chain
# was ever checked.
fn walk_chain_expr(bound: List String, e: ast.Expr) -> (Int, Bool, List LintFinding) =
  match e with
  | ast.MatchExpr scrut branches pos ->
      (match walk_chain(bound, branches, scrut) with
       | (depth, blocked, findings) ->
           (depth, blocked, list_append(combinator_findings(bound, e, pos), findings)))
  | _ -> (1, false, walk_expr(bound, e))

# Both shapes have a concrete fix in let..else, so both name it. A chain whose
# terminal recovers using the *failing* pattern's payload needs the binding-else
# form (`else <pat> -> <handler>`, Tier 1b) so the payload is in scope; a chain
# that bails to a constant uses the plain constant else. The message says which.
fn staircase_message(blocked: Bool) -> String =
  if blocked
  then "nested match can be flattened with let..else — the failing case carries a payload, so use a binding-else `else <pat> -> ...` (docs/idiomatic-sprout.md)"
  else "nested match can be flattened with let..else (docs/idiomatic-sprout.md)"

fn walk_match(bound: List String, scrut: ast.Expr, branches: List ast.MatchBranch,
              pos: source.SourcePos) -> List LintFinding =
  match walk_chain(bound, branches, scrut) with
  | (depth, blocked, findings) ->
      if depth >= min_staircase_depth
      then Cons(mk_finding(pos, "staircase-of-doom", staircase_message(blocked)), findings)
      else findings

# ---------------------------------------------------------------------------
# Rule: redundant-vec-from-list
#
# Flags a hand-written `vec_from_list(<bare list literal>)` sitting in a
# position the checker's own desugar pass already recognizes as Vec-typed
# (stdlib/compiler/desugar_ctx.sprout) — the checker would wrap a bare
# literal there on its own, so an explicit wrap around one is a no-op the
# reader has to see past. Detection reuses desugar_ctx's exact Vec-context
# computation (same fn_idx, same if/match threading) so this rule can never
# disagree with what the checker actually does.

let redundant_vec_wrap_message: String =
  "vec_from_list(...) here is redundant — this argument is already in Vec context and gets wrapped automatically"

fn redundant_vec_wrap_findings(prog: ast.Program) -> List LintFinding =
  positions_to_findings(desugar_ctx.find_redundant_vec_wraps(prog))

fn positions_to_findings(positions: List source.SourcePos) -> List LintFinding =
  match positions with
  | Nil -> Nil
  | Cons pos rest ->
      Cons(mk_finding(pos, "redundant-vec-from-list", redundant_vec_wrap_message), positions_to_findings(rest))

# ---------------------------------------------------------------------------
# Rule: list-shape-pattern
#
# Flags a hand-written Cons/Nil chain that matches an EXACT fixed length —
# e.g. `Cons a (Cons b Nil)` — which reads more clearly as `[a, b]`
# (docs/idiomatic-sprout.md "Match lists by shape with […] patterns"). Scoped
# to fixed-length chains only: a chain whose tail is a bound variable
# (`Cons h t`, ordinary head/tail recursion) or a wildcard (`Cons h _`,
# discard the rest) is NOT flagged — a corpus scan showed those two shapes
# together are ~99% of all hand-written Cons/Nil patterns in this codebase,
# and `[h | t]`/`[h | _]` convey nothing `Cons h t`/`Cons h _` don't already
# say. Only a chain that terminates in a literal Nil — every position pinned
# to an exact length — gets the sugar win.
#
# `[…]` pattern sugar desugars to the SAME ConstructorPattern nodes with no
# distinguishing AST marker (parser.sprout: parse_list_pattern/
# build_cons_pattern) — but the WHOLE desugared literal shares ONE SourcePos,
# the position of the `[` token, while a hand-written Cons/Nil node carries
# the position of its own token. So the same source-text-sniffing trick as
# is_written_as_match (below) tells them apart, applied as a post-filter.

let list_shape_message: String =
  "list matched with a fixed length via raw Cons/Nil constructors — [...] list-pattern sugar reads the length at a glance (docs/idiomatic-sprout.md)"

# True when a Cons/Nil pattern chain terminates in a literal Nil — i.e. every
# link is pinned to an exact position, never a bound tail variable or
# wildcard that would keep matching arbitrarily longer lists.
fn chain_terminates_in_nil(pat: ast.Pattern) -> Bool =
  match pat with
  | ast.ConstructorPattern name subpats _ ->
      if name == ast.list_ctor_nil then true
      else if name == ast.list_ctor_cons then
        match subpats with
        | [_, tail] -> chain_terminates_in_nil(tail)
        | _ -> false  # malformed arity guard
      else false
  | _ -> false  # bound variable or wildcard: not a fixed length

# Entry point for any pattern position: a Cons chain that terminates in Nil
# is a fixed-length ROOT — one finding at the outermost Cons, and further
# search continues only into the head (an independently-reportable nested
# list, e.g. a list-of-lists' element). A chain that does NOT terminate in
# Nil (ordinary head/tail recursion, or a discarded wildcard tail) is left
# alone itself, but its head and tail are still searched generically for
# fixed-length patterns nested elsewhere inside them.
fn find_list_shape_in_pattern(pat: ast.Pattern) -> List source.SourcePos =
  match pat with
  | ast.ConstructorPattern name subpats pos ->
      if name == ast.list_ctor_cons then
        match subpats with
        | [head, tail] ->
            if chain_terminates_in_nil(tail)
            then Cons(pos, find_list_shape_in_pattern(head))
            else find_list_shape_in_pattern(head) ++ find_list_shape_in_pattern(tail)
        | _ -> find_list_shape_in_patterns(subpats)  # malformed arity guard
      else
        find_list_shape_in_patterns(subpats)  # bare Nil: no subpatterns, no finding
  | ast.TuplePattern subpats _ -> find_list_shape_in_patterns(subpats)
  | _ -> Nil  # Wildcard/Var/Int/Bool/String/Char/Unit: leaves, no subpatterns

fn find_list_shape_in_patterns(pats: List ast.Pattern) -> List source.SourcePos =
  concat_map(find_list_shape_in_pattern, pats)

fn is_written_as_ctor(src: String, line: Int, col: Int) -> Bool =
  string.starts_with(rest_of_line(src, line, col), ast.list_ctor_cons)
  || string.starts_with(rest_of_line(src, line, col), ast.list_ctor_nil)

fn rest_of_line(src: String, line: Int, col: Int) -> String =
  str_slice(text, col - 1, str_len(text) - (col - 1))
  where text = nth_line(str_split_lines(src), line, 1)

fn drop_desugared_list_patterns(src: String, positions: List source.SourcePos) -> List source.SourcePos =
  filter(\pos -> is_written_as_ctor(src, pos.line, pos.column), positions)

fn list_shape_findings(src: String, prog: ast.Program) -> List LintFinding =
  match prog with
  | ast.Program decls _ ->
      map(\pos -> mk_finding(pos, "list-shape-pattern", list_shape_message),
        drop_desugared_list_patterns(src, find_list_shape_in_decls(decls)))

fn find_list_shape_in_decls(decls: List ast.Decl) -> List source.SourcePos =
  concat_map(find_list_shape_in_decl, decls)

fn find_list_shape_in_decl(d: ast.Decl) -> List source.SourcePos =
  match d with
  | ast.FnDecl _ _ _ _ _ body _ -> find_list_shape_in_expr(body)
  | ast.LetDecl _ body _ _ -> find_list_shape_in_expr(body)
  | ast.InstanceDecl _ _ methods _ -> find_list_shape_in_instance_methods(methods)
  | _ -> Nil

fn find_list_shape_in_instance_methods(methods: List ast.InstanceMethodImpl) -> List source.SourcePos =
  concat_map(\m -> match m with | ast.InstanceMethodImpl _ _ _ _ _ body -> find_list_shape_in_expr(body), methods)

# Reuses the SAME generic expr traversal shape as walk_expr above (a
# separate, parallel walk — see walk_expr's own header comment on why every
# variant is covered explicitly). Pattern positions only exist at match
# branches and do-binds (ast.MatchBranch/ast.DoBindStep) — function/lambda
# params are bare names (ast.Param String (Maybe TypeExpr) ParamMode), no patterns.
fn find_list_shape_in_expr(e: ast.Expr) -> List source.SourcePos =
  match e with
  | ast.MatchExpr scrut branches _ ->
      find_list_shape_in_expr(scrut) ++ find_list_shape_in_branches(branches)
  | ast.IfExpr cond then_ else_ _ ->
      find_list_shape_in_expr(cond) ++ find_list_shape_in_expr(then_) ++ find_list_shape_in_expr(else_)
  | ast.CallExpr callee args _ ->
      find_list_shape_in_expr(callee) ++ find_list_shape_in_exprs(args)
  | ast.TupleExpr elems _ -> find_list_shape_in_exprs(elems)
  | ast.BinaryExpr _ left right _ ->
      find_list_shape_in_expr(left) ++ find_list_shape_in_expr(right)
  | ast.UnaryExpr _ operand _ -> find_list_shape_in_expr(operand)
  | ast.LambdaExpr _ body _ -> find_list_shape_in_expr(body)
  | ast.DoExpr steps _ -> find_list_shape_in_do_steps(steps)
  | ast.RecordExpr _ fields _ -> find_list_shape_in_record_fields(fields)
  | ast.GetFieldExpr rec_expr _ _ -> find_list_shape_in_expr(rec_expr)
  | ast.RecordUpdateExpr base fields _ -> find_list_shape_in_expr(base) ++ find_list_shape_in_record_fields(fields)
  | ast.IntRangeExpr lo hi _ ->
      find_list_shape_in_expr(lo) ++ find_list_shape_in_expr(hi)
  | ast.StringTemplateExpr parts _ -> find_list_shape_in_template_parts(parts)
  | ast.ComprehensionExpr elem gens _ -> find_list_shape_in_expr(elem) ++ find_list_shape_in_comprehension_gens(gens)
  | ast.LetBindExpr pat value els body pos -> find_list_shape_in_expr(ast.let_bind_match(pat, value, els, body, pos))
  | ast.TryExpr operand _ -> find_list_shape_in_expr(operand)
  | _ -> Nil

fn find_list_shape_in_comprehension_gens(gens: List ast.ComprehensionGen) -> List source.SourcePos =
  concat_map(find_list_shape_in_comprehension_gen, gens)

fn find_list_shape_in_comprehension_gen(g: ast.ComprehensionGen) -> List source.SourcePos =
  match g with
  | ast.ComprehensionGen pat src guards ->
      find_list_shape_in_pattern(pat) ++ find_list_shape_in_expr(src) ++ find_list_shape_in_exprs(guards)

fn find_list_shape_in_exprs(exprs: List ast.Expr) -> List source.SourcePos =
  concat_map(find_list_shape_in_expr, exprs)

fn find_list_shape_in_branches(branches: List ast.MatchBranch) -> List source.SourcePos =
  concat_map(find_list_shape_in_branch, branches)

fn find_list_shape_in_branch(b: ast.MatchBranch) -> List source.SourcePos =
  match b with
  | ast.MatchBranch pat body -> find_list_shape_in_pattern(pat) ++ find_list_shape_in_expr(body)

fn find_list_shape_in_do_steps(steps: List ast.DoStep) -> List source.SourcePos =
  match steps with
  | [] -> Nil
  | [ast.DoPatStep kind pat value els pos | rest] ->
      find_list_shape_in_do_steps(ast.do_pat_steps(kind, pat, value, els, rest, pos))
  | [ast.DoBindStep pat value | rest] ->
      find_list_shape_in_pattern(pat) ++ find_list_shape_in_expr(value) ++ find_list_shape_in_do_steps(rest)
  | [ast.DoLetStep _ value | rest] -> find_list_shape_in_expr(value) ++ find_list_shape_in_do_steps(rest)
  | [ast.DoExprStep value | rest] -> find_list_shape_in_expr(value) ++ find_list_shape_in_do_steps(rest)

fn find_list_shape_in_record_fields(fields: List ast.RecordField) -> List source.SourcePos =
  concat_map(\f -> match f with | ast.RecordField _ value -> find_list_shape_in_expr(value), fields)

fn find_list_shape_in_template_parts(parts: List ast.TemplateExprPart) -> List source.SourcePos =
  concat_map(find_list_shape_in_template_part, parts)

fn find_list_shape_in_template_part(p: ast.TemplateExprPart) -> List source.SourcePos =
  match p with
  | ast.LitPart _ -> Nil
  | ast.InterpPart e -> find_list_shape_in_expr(e)

# ---------------------------------------------------------------------------
# Rule: list-prefix-pattern
#
# Sibling to list-shape-pattern: flags a hand-written Cons chain whose tail
# is a discarded wildcard (`Cons h _`), matchable with `[h | _]` sugar. This
# is the `Cons h _` case list-shape-pattern deliberately deferred out of its
# own scope (BACKLOG.md) — a materially different signal from fixed-length:
# no exact-length claim, just "match a prefix, discard the rest." Unlike a
# bound tail variable (`Cons h t`, used to keep recursing — NOT flagged,
# same as list-shape-pattern), a wildcard tail can never be inspected
# further, so naming the shape with `[…]` loses nothing.
#
# Same SourcePos-granularity discriminator as list-shape-pattern (`[…]`
# sugar shares one position, the `[` token's; hand-written carries its own
# token's position) — reuses list-shape-pattern's is_written_as_ctor filter.

let list_prefix_message: String =
  "list matched with a discarded tail via raw Cons/Nil constructors — [...] list-pattern sugar reads the shape at a glance (docs/idiomatic-sprout.md)"

# True when a Cons pattern chain's tail resolves to a literal wildcard —
# i.e. the chain matches a fixed PREFIX and explicitly discards whatever
# follows, never binding it. A tail that resolves to Nil (exact length,
# list-shape-pattern's territory) or a bound variable (ordinary head/tail
# recursion) is NOT a wildcard tail.
fn chain_terminates_in_wildcard(pat: ast.Pattern) -> Bool =
  match pat with
  | ast.WildcardPattern _ -> true
  | ast.ConstructorPattern name subpats _ ->
      if name == ast.list_ctor_cons then
        match subpats with
        | [_, tail] -> chain_terminates_in_wildcard(tail)
        | _ -> false  # malformed arity guard
      else false  # Nil terminal: list-shape-pattern's territory, not this rule
  | _ -> false  # bound variable: ordinary recursion, not flagged

# Mirrors find_list_shape_in_pattern's structure exactly, swapping the
# terminal check from chain_terminates_in_nil to chain_terminates_in_wildcard.
fn find_prefix_pattern_in_pattern(pat: ast.Pattern) -> List source.SourcePos =
  match pat with
  | ast.ConstructorPattern name subpats pos ->
      if name == ast.list_ctor_cons then
        match subpats with
        | [head, tail] ->
            if chain_terminates_in_wildcard(tail)
            then Cons(pos, find_prefix_pattern_in_pattern(head))
            else find_prefix_pattern_in_pattern(head) ++ find_prefix_pattern_in_pattern(tail)
        | _ -> find_prefix_pattern_in_patterns(subpats)  # malformed arity guard
      else
        find_prefix_pattern_in_patterns(subpats)  # bare Nil: no subpatterns, no finding
  | ast.TuplePattern subpats _ -> find_prefix_pattern_in_patterns(subpats)
  | _ -> Nil  # Wildcard/Var/Int/Bool/String/Char/Unit: leaves, no subpatterns

fn find_prefix_pattern_in_patterns(pats: List ast.Pattern) -> List source.SourcePos =
  concat_map(find_prefix_pattern_in_pattern, pats)

fn list_prefix_findings(src: String, prog: ast.Program) -> List LintFinding =
  match prog with
  | ast.Program decls _ ->
      map(\pos -> mk_finding(pos, "list-prefix-pattern", list_prefix_message),
        drop_desugared_list_patterns(src, find_prefix_pattern_in_decls(decls)))

fn find_prefix_pattern_in_decls(decls: List ast.Decl) -> List source.SourcePos =
  concat_map(find_prefix_pattern_in_decl, decls)

fn find_prefix_pattern_in_decl(d: ast.Decl) -> List source.SourcePos =
  match d with
  | ast.FnDecl _ _ _ _ _ body _ -> find_prefix_pattern_in_expr(body)
  | ast.LetDecl _ body _ _ -> find_prefix_pattern_in_expr(body)
  | ast.InstanceDecl _ _ methods _ -> find_prefix_pattern_in_instance_methods(methods)
  | _ -> Nil

fn find_prefix_pattern_in_instance_methods(methods: List ast.InstanceMethodImpl) -> List source.SourcePos =
  concat_map(\m -> match m with | ast.InstanceMethodImpl _ _ _ _ _ body -> find_prefix_pattern_in_expr(body), methods)

fn find_prefix_pattern_in_expr(e: ast.Expr) -> List source.SourcePos =
  match e with
  | ast.MatchExpr scrut branches _ ->
      find_prefix_pattern_in_expr(scrut) ++ find_prefix_pattern_in_branches(branches)
  | ast.IfExpr cond then_ else_ _ ->
      find_prefix_pattern_in_expr(cond) ++ find_prefix_pattern_in_expr(then_) ++ find_prefix_pattern_in_expr(else_)
  | ast.CallExpr callee args _ ->
      find_prefix_pattern_in_expr(callee) ++ find_prefix_pattern_in_exprs(args)
  | ast.TupleExpr elems _ -> find_prefix_pattern_in_exprs(elems)
  | ast.BinaryExpr _ left right _ ->
      find_prefix_pattern_in_expr(left) ++ find_prefix_pattern_in_expr(right)
  | ast.UnaryExpr _ operand _ -> find_prefix_pattern_in_expr(operand)
  | ast.LambdaExpr _ body _ -> find_prefix_pattern_in_expr(body)
  | ast.DoExpr steps _ -> find_prefix_pattern_in_do_steps(steps)
  | ast.RecordExpr _ fields _ -> find_prefix_pattern_in_record_fields(fields)
  | ast.GetFieldExpr rec_expr _ _ -> find_prefix_pattern_in_expr(rec_expr)
  | ast.RecordUpdateExpr base fields _ -> find_prefix_pattern_in_expr(base) ++ find_prefix_pattern_in_record_fields(fields)
  | ast.IntRangeExpr lo hi _ ->
      find_prefix_pattern_in_expr(lo) ++ find_prefix_pattern_in_expr(hi)
  | ast.StringTemplateExpr parts _ -> find_prefix_pattern_in_template_parts(parts)
  | ast.ComprehensionExpr elem gens _ -> find_prefix_pattern_in_expr(elem) ++ find_prefix_pattern_in_comprehension_gens(gens)
  | ast.LetBindExpr pat value els body pos -> find_prefix_pattern_in_expr(ast.let_bind_match(pat, value, els, body, pos))
  | ast.TryExpr operand _ -> find_prefix_pattern_in_expr(operand)
  | _ -> Nil

fn find_prefix_pattern_in_comprehension_gens(gens: List ast.ComprehensionGen) -> List source.SourcePos =
  concat_map(find_prefix_pattern_in_comprehension_gen, gens)

fn find_prefix_pattern_in_comprehension_gen(g: ast.ComprehensionGen) -> List source.SourcePos =
  match g with
  | ast.ComprehensionGen pat src guards ->
      find_prefix_pattern_in_pattern(pat) ++ find_prefix_pattern_in_expr(src) ++ find_prefix_pattern_in_exprs(guards)

fn find_prefix_pattern_in_exprs(exprs: List ast.Expr) -> List source.SourcePos =
  concat_map(find_prefix_pattern_in_expr, exprs)

fn find_prefix_pattern_in_branches(branches: List ast.MatchBranch) -> List source.SourcePos =
  concat_map(find_prefix_pattern_in_branch, branches)

fn find_prefix_pattern_in_branch(b: ast.MatchBranch) -> List source.SourcePos =
  match b with
  | ast.MatchBranch pat body -> find_prefix_pattern_in_pattern(pat) ++ find_prefix_pattern_in_expr(body)

fn find_prefix_pattern_in_do_steps(steps: List ast.DoStep) -> List source.SourcePos =
  match steps with
  | [] -> Nil
  | [ast.DoPatStep kind pat value els pos | rest] ->
      find_prefix_pattern_in_do_steps(ast.do_pat_steps(kind, pat, value, els, rest, pos))
  | [ast.DoBindStep pat value | rest] ->
      find_prefix_pattern_in_pattern(pat) ++ find_prefix_pattern_in_expr(value) ++ find_prefix_pattern_in_do_steps(rest)
  | [ast.DoLetStep _ value | rest] -> find_prefix_pattern_in_expr(value) ++ find_prefix_pattern_in_do_steps(rest)
  | [ast.DoExprStep value | rest] -> find_prefix_pattern_in_expr(value) ++ find_prefix_pattern_in_do_steps(rest)

fn find_prefix_pattern_in_record_fields(fields: List ast.RecordField) -> List source.SourcePos =
  concat_map(\f -> match f with | ast.RecordField _ value -> find_prefix_pattern_in_expr(value), fields)

fn find_prefix_pattern_in_template_parts(parts: List ast.TemplateExprPart) -> List source.SourcePos =
  concat_map(find_prefix_pattern_in_template_part, parts)

fn find_prefix_pattern_in_template_part(p: ast.TemplateExprPart) -> List source.SourcePos =
  match p with
  | ast.LitPart _ -> Nil
  | ast.InterpPart e -> find_prefix_pattern_in_expr(e)

# ---------------------------------------------------------------------------
# Rule: multi-line-lambda-arg
#
# Flags a lambda passed as a call argument whose body is control flow — a
# `match`, an `if`, a `do`, or a `let .. in` (the same MatchExpr node, §5.1) —
# and runs past the line the lambda opens on. The call's own shape is then
# something the reader has to reassemble around a body that is not the call's
# subject; a named function with a signature says it once and reads at the
# call site as a name.
#
# Scoped to ARGUMENT position on purpose. A lambda bound in a `where` or a
# `let` already has the name this rule asks for.
#
# A body that merely wraps for width — a wide record literal or call — is not
# reported. That is a line-length question, and giving it a name buys nothing.
#
# `_` placeholders desugar to lambdas at parse time (§5.3), so they arrive here
# as LambdaExpr. They cannot trip the rule: a hole binds to its innermost
# enclosing CALL, so a synthesized lambda's body is that call, never control
# flow.

let multi_line_lambda_message: String =
  "multi-line lambda argument — lift the body into a named fn and pass the name, closing over locals with a `_` placeholder (docs/idiomatic-sprout.md)"

# Control flow, as opposed to one expression wrapped for width.
fn is_block_body(e: ast.Expr) -> Bool =
  match e with
  | ast.MatchExpr _ _ _ -> true
  | ast.IfExpr _ _ _ _ -> true
  | ast.DoExpr _ _ -> true
  | _ -> false

fn larger(a: Int, b: Int) -> Int = if a > b then a else b

# The last line any node in the subtree starts on. Every Expr carries its own
# SourcePos, so this answers "does this body run past its opening line" without
# re-reading the source. Exhaustive by intent: a new Expr variant should fail
# the build here rather than silently under-report its extent.
fn max_line(e: ast.Expr) -> Int =
  match e with
  | ast.MatchExpr scrut branches pos ->
      larger(pos.line, larger(max_line(scrut), max_line_branches(branches)))
  | ast.IfExpr cond then_ else_ pos ->
      larger(pos.line, larger(max_line(cond), larger(max_line(then_), max_line(else_))))
  | ast.CallExpr callee args pos ->
      larger(pos.line, larger(max_line(callee), max_line_exprs(args)))
  | ast.TupleExpr elems pos -> larger(pos.line, max_line_exprs(elems))
  | ast.BinaryExpr _ left right pos ->
      larger(pos.line, larger(max_line(left), max_line(right)))
  | ast.UnaryExpr _ operand pos -> larger(pos.line, max_line(operand))
  | ast.LambdaExpr _ body pos -> larger(pos.line, max_line(body))
  | ast.DoExpr steps pos -> larger(pos.line, max_line_do_steps(steps))
  | ast.RecordExpr _ fields pos -> larger(pos.line, max_line_record_fields(fields))
  | ast.GetFieldExpr rec_expr _ pos -> larger(pos.line, max_line(rec_expr))
  | ast.RecordUpdateExpr base fields pos ->
      larger(pos.line, larger(max_line(base), max_line_record_fields(fields)))
  | ast.IntRangeExpr lo hi pos -> larger(pos.line, larger(max_line(lo), max_line(hi)))
  | ast.StringTemplateExpr parts pos -> larger(pos.line, max_line_template_parts(parts))
  | ast.ComprehensionExpr elem gens pos ->
      larger(pos.line, larger(max_line(elem), max_line_comprehension_gens(gens)))
  | ast.LetBindExpr pat value els body pos -> max_line(ast.let_bind_match(pat, value, els, body, pos))
  | ast.TryExpr operand pos -> larger(pos.line, max_line(operand))
  | ast.VarExpr _ pos -> pos.line
  | ast.IntExpr _ pos -> pos.line
  | ast.FloatExpr _ pos -> pos.line
  | ast.BoolExpr _ pos -> pos.line
  | ast.StringExpr _ pos -> pos.line
  | ast.CharExpr _ pos -> pos.line
  | ast.UnitExpr pos -> pos.line

fn max_line_exprs(exprs: List ast.Expr) -> Int =
  match exprs with
  | Nil -> 0
  | Cons e rest -> larger(max_line(e), max_line_exprs(rest))

fn max_line_branches(branches: List ast.MatchBranch) -> Int =
  match branches with
  | Nil -> 0
  | Cons b rest ->
      match b with
      | ast.MatchBranch _ body -> larger(max_line(body), max_line_branches(rest))

fn max_line_do_steps(steps: List ast.DoStep) -> Int =
  match steps with
  | Nil -> 0
  | [ast.DoPatStep kind pat value els pos | rest] ->
      max_line_do_steps(ast.do_pat_steps(kind, pat, value, els, rest, pos))
  | [ast.DoBindStep _ value | rest] -> larger(max_line(value), max_line_do_steps(rest))
  | [ast.DoLetStep _ value | rest] -> larger(max_line(value), max_line_do_steps(rest))
  | [ast.DoExprStep value | rest] -> larger(max_line(value), max_line_do_steps(rest))

fn max_line_record_fields(fields: List ast.RecordField) -> Int =
  match fields with
  | Nil -> 0
  | Cons f rest ->
      match f with
      | ast.RecordField _ value -> larger(max_line(value), max_line_record_fields(rest))

fn max_line_template_parts(parts: List ast.TemplateExprPart) -> Int =
  match parts with
  | Nil -> 0
  | Cons p rest -> larger(max_line_template_part(p), max_line_template_parts(rest))

fn max_line_template_part(p: ast.TemplateExprPart) -> Int =
  match p with
  | ast.LitPart _ -> 0
  | ast.InterpPart e -> max_line(e)

fn max_line_comprehension_gens(gens: List ast.ComprehensionGen) -> Int =
  match gens with
  | Nil -> 0
  | Cons g rest -> larger(max_line_comprehension_gen(g), max_line_comprehension_gens(rest))

fn max_line_comprehension_gen(g: ast.ComprehensionGen) -> Int =
  match g with
  | ast.ComprehensionGen _ src guards -> larger(max_line(src), max_line_exprs(guards))

# One finding per offending argument, so a call passing two multi-line lambdas
# reports both — each is a separate lift.
fn multi_line_lambda_findings(args: List ast.Expr) -> List LintFinding =
  match args with
  | Nil -> Nil
  | Cons a rest -> multi_line_lambda_finding(a) ++ multi_line_lambda_findings(rest)

fn multi_line_lambda_finding(arg: ast.Expr) -> List LintFinding =
  match arg with
  | ast.LambdaExpr _ body pos ->
      if is_block_body(body) && max_line(body) > pos.line
      then Cons(mk_finding(pos, "multi-line-lambda-arg", multi_line_lambda_message), Nil)
      else Nil
  | _ -> Nil

# ---------------------------------------------------------------------------
# Rule: nullary-const-fn
#
# `fn bulk_size() -> Int = 65600` is a constant wearing a function's clothes: a
# parameter is a function's reason to exist, and with none the body re-runs per
# call. Every gate below is correctness, not taste — each one has a shape that
# compiles after the rewrite and means something different.
#
#   PURE — a top-level `let` initializer must be pure (§5.2) and that is NOT
#   enforced, so an effectful one would silently move its effect to startup.
#   It also settles sharing: every allocator of a mutable value is `!{IO}`.
#   NOT `main` — `let main` is not a program.
#   NO `where` CONSTRAINT — a `fn` takes its dictionary per call, a binding
#   makes the choice once, and an open one is rejected outright (§5.2).
#   NOT LINEAR — a `fn` mints a fresh value per call, so its consume-once
#   obligation is real; one shared binding makes it vanish, and nothing
#   downstream reports the second consume (`letdecl_linear_gate` checks the
#   INITIALIZER, not the uses). Read from this file's own declarations, so a
#   linear type imported from elsewhere is still missed.
#   A SYNTACTIC VALUE, and not one typed by CONTEXT (see the two predicates
#   below). Outside that set a `let` is monomorphic and can narrow a
#   polymorphic helper, and a computed body would move its cost — and its
#   trap — into startup, even when nothing reads the binding.
#
# The message names the ANNOTATION because dropping it changes the type:
# `fn lengths() -> Vec Int = [1, 2, 3]` is a `Vec` only because the return type
# says so (§5.5.1), and a bare `let lengths = [1, 2, 3]` is a `List`.

# The entry point is a function by definition — `let main` is not a program, so
# the rewrite is never right here however constant the body is. A real `main`
# is `!{IO}` and the purity gate would catch it, but a pure one is legal and
# three in-tree fixtures have exactly that shape.
let entry_point_name: String = "main"

fn nullary_const_message(name: String) -> String =
  "`" ++ name ++ "` takes no parameters and its body is a constant — bind it with a top-level "
  ++ "`let <name>: <type> = <body>`, which is evaluated once (docs/idiomatic-sprout.md). "
  ++ "Carry the return type across: it selects the type, so dropping it turns `Vec` into `List`. "
  ++ "The annotation resolves only prelude types today, so for any other one leave it off and "
  ++ "check the inferred type."

# Prefix `-` is an operator, so `-1` arrives as a UnaryExpr and the checker's
# predicate rejects it — to that predicate `-1` and `negate(x)` are one shape.
# They are not one shape here, so the rule widens by exactly this much. The
# widening stays local: putting it in `ast.is_syntactic_value` would change
# what the compiler generalizes.
fn is_negated_literal(e: ast.Expr) -> Bool =
  match e with
  | ast.UnaryExpr op operand _ -> op == "-" && is_numeric_literal(operand)
  | _ -> false

fn is_numeric_literal(e: ast.Expr) -> Bool =
  match e with
  | ast.IntExpr _ _ -> true
  | ast.FloatExpr _ _ -> true
  | _ -> false

# A body that takes its type from CONTEXT rather than from itself. The declared
# return type is evidence (§5.2), and only a carried annotation preserves it —
# which is not always writable. `fn pick_color() -> Color -> String = label` is
# the live case: that return type is what selects `ToString Color`.
#
# A bare CONSTRUCTOR is not one of these. `Nothing` and `Nil` carry their own
# type and need no dictionary; it is the lowercase head, a reference to a
# function, that the return type was standing behind.
#
# RECURSES for the same reason `all_syntactic_values` does: `Just(label)` and
# `(label, 1)` hide the context-typed part one level down, and checking only the
# top node reported them with no rewrite that compiles — the annotated form hits
# the prelude-only limitation, the bare one an ambiguous typeclass binding.
fn takes_type_from_context(e: ast.Expr) -> Bool =
  match e with
  | ast.VarExpr name _ -> ! ast.is_constructor_ref (name)
  | ast.LambdaExpr _ _ _ -> true
  | ast.TupleExpr items _ -> any_takes_type_from_context(items)
  | ast.CallExpr _ args _ -> any_takes_type_from_context(args)
  | _ -> false

fn any_takes_type_from_context(exprs: List ast.Expr) -> Bool =
  match exprs with
  | [] -> false
  | [h | t] -> takes_type_from_context(h) || any_takes_type_from_context(t)

# The constructors of every LINEAR type declared in this file. A record's
# constructor is its own name; a `type linear` lists its arms.
fn linear_ctor_names(decls: List ast.Decl) -> List String =
  match decls with
  | [] -> Nil
  | [d | rest] -> list_append(linear_ctors_of(d), linear_ctor_names(rest))

fn linear_ctors_of(d: ast.Decl) -> List String =
  match d with
  | ast.TypeDecl _ _ ctors _ ast.Linear _ -> ctor_arm_names(ctors)
  | ast.RecordDecl name _ _ _ ast.Linear _ _ -> [name]
  | _ -> Nil

fn ctor_arm_names(ctors: List ast.TypeConstructor) -> List String =
  match ctors with
  | [] -> Nil
  | [c | rest] -> Cons(ctor_name(c), ctor_arm_names(rest))

fn ctor_name(c: ast.TypeConstructor) -> String =
  match c with
  | ast.TypeConstructor name _ _ _ -> name

# True when the body names one of them anywhere — a linear payload nested in an
# unrestricted wrapper carries the same obligation as a bare one. Matching on the
# last segment means another module's same-named constructor also matches, which
# only ever withholds the suggestion.
fn mentions_linear_ctor(names: List String, e: ast.Expr) -> Bool =
  match e with
  | ast.VarExpr name _ -> name_in_list(string.after_last_dot(name), names)
  | ast.TupleExpr items _ -> any_mentions_linear_ctor(names, items)
  | ast.CallExpr callee args _ ->
      mentions_linear_ctor(names, callee) || any_mentions_linear_ctor(names, args)
  | ast.LambdaExpr _ body _ -> mentions_linear_ctor(names, body)
  | _ -> false

fn any_mentions_linear_ctor(names: List String, exprs: List ast.Expr) -> Bool =
  match exprs with
  | [] -> false
  | [h | t] -> mentions_linear_ctor(names, h) || any_mentions_linear_ctor(names, t)

fn is_const_body(e: ast.Expr) -> Bool =
  (ast.is_syntactic_value(e) || is_negated_literal(e)) && ! takes_type_from_context (e)

# `Nothing` is an absent effect row, which the checker proves means pure.
fn declared_pure(effects: Maybe (List String)) -> Bool =
  match effects with
  | Nothing -> true
  | Just _ -> false

fn nullary_const_findings(decls: List ast.Decl) -> List LintFinding =
  nullary_const_go(decls, linear_ctor_names(decls))

fn nullary_const_go(decls: List ast.Decl, linear: List String) -> List LintFinding =
  match decls with
  | [] -> Nil
  | [d | rest] ->
      list_append(nullary_const_finding(d, linear), nullary_const_go(rest, linear))

fn nullary_const_finding(d: ast.Decl, linear: List String) -> List LintFinding =
  match d with
  | ast.FnDecl name params _ effects constraints body pos ->
      if name != entry_point_name && list_is_empty(params) && declared_pure(effects)
         && list_is_empty(constraints) && is_const_body(body)
         && ! mentions_linear_ctor (linear, body)
      then [mk_finding(pos, "nullary-const-fn", nullary_const_message(name))]
      else Nil
  | _ -> Nil

fn list_is_empty(xs: List a) -> Bool =
  match xs with
  | Nil -> true
  | _ -> false

# ---------------------------------------------------------------------------
# Program-level entry points

fn walk_instance_methods(methods: List ast.InstanceMethodImpl) -> List LintFinding =
  match methods with
  | Nil -> Nil
  | Cons m rest ->
      match m with
      | ast.InstanceMethodImpl _ params _ _ _ body ->
          list_append(walk_expr(param_names(params), body), walk_instance_methods(rest))

fn walk_decl(d: ast.Decl) -> List LintFinding =
  match d with
  | ast.FnDecl _ params _ _ _ body _ -> walk_expr(param_names(params), body)
  | ast.LetDecl _ body _ _ -> walk_expr(Nil, body)
  | ast.InstanceDecl _ _ methods _ -> walk_instance_methods(methods)
  | _ -> Nil  # ExternFnDecl/TypeDecl/RecordDecl/ClassDecl/AliasDecl/WrapDecl: no expr body

fn walk_decls(decls: List ast.Decl) -> List LintFinding =
  match decls with
  | Nil -> Nil
  | Cons d rest -> list_append(walk_decl(d), walk_decls(rest))

fn lint_program(prog: ast.Program) -> List LintFinding =
  match prog with
  | ast.Program decls _ ->
      list_append(walk_decls(decls),
        list_append(nullary_const_findings(decls), redundant_vec_wrap_findings(prog)))

# `let <pat> = e else fb` is pure sugar (ast.let_bind_match), and lint reads it
# elaborated: the SAME MatchExpr shape a hand-written nested match has, with no
# distinguishing AST node. So a MatchExpr's own position is the only
# way to tell them apart: a hand-written match's pos is the `match` keyword
# itself; a let-else's pos is wherever that binding's pattern starts (there is
# no `match` token in the source at all). Without this check, every already-
# idiomatic let-else chain gets told to become the thing it already is. Scoped
# to staircase-of-doom findings only — other rules' positions never point at
# a `match` keyword in the first place, so this check doesn't apply to them.
fn nth_line(lines: List String, target: Int, cur: Int) -> String =
  match lines with
  | Nil -> ""
  | Cons l rest -> if cur == target then l else nth_line(rest, target, cur + 1)

fn is_written_as_match(src: String, line: Int, col: Int) -> Bool =
  string.starts_with(str_slice(text, col - 1, str_len(text) - (col - 1)), "match")
  where text = nth_line(str_split_lines(src), line, 1)

fn drop_desugared_matches(src: String, findings: List LintFinding) -> List LintFinding =
  match findings with
  | Nil -> Nil
  | Cons f rest ->
      match f with
      | LintFinding ln col rule_id _ ->
          if rule_id == "staircase-of-doom" && ! is_written_as_match (src, ln, col)
          then drop_desugared_matches(src, rest)
          else Cons(f, drop_desugared_matches(src, rest))

# ---------------------------------------------------------------------------
# Rule: deprecated-brace-body
#
# `class C a { … }` / `instance C T { … }`. Both body forms parse — the brace
# form is kept so old sources still compile — so this rule is what makes the
# deprecated one visible. See docs/spec-v0.md §8.5 "Declaration syntax".
#
# Token-based, not AST-based: ClassDecl/InstanceDecl record the members, not
# which delimiter produced them, so the AST cannot tell the two forms apart.
# The token stream can, and lint_ast already has it in hand.

fn brace_tok_at(tokens: Vec token.Token, i: Int) -> token.Token =
  match vec_get(i, tokens) with
  | Just t -> t
  | Nothing -> token.eof_token(source.SourcePos(index = 0, line = 0, column = 0))

fn brace_is_keyword(t: token.Token, kw: String) -> Bool =
  match token.token_kind(t) with
  | token.TokenKeywordKind -> token.token_text(t) == kw
  | _ -> false

fn brace_is_symbol(t: token.Token, sym: String) -> Bool =
  match token.token_kind(t) with
  | token.TokenSymbolKind -> token.token_text(t) == sym
  | _ -> false

fn brace_is_decl_keyword(t: token.Token) -> Bool =
  match token.token_kind(t) with
  | token.TokenKeywordKind -> parser.is_decl_keyword(token.token_text(t))
  | _ -> false

# From just past a `class`/`instance` keyword, find the `{` that opens its body.
#
# Two things end the search without a finding: a declaration keyword (`fn` for
# the layout form's first member, or the next top-level declaration after an
# empty body) and end of input. `parser.is_decl_keyword` is the single source of
# truth for that set, so a new declaration form cannot silently widen the scan.
#
# The one `{` that must NOT be mistaken for a body is the one in an effect
# annotation — `instance Boxer (a !{IO})` puts one in the declaration head. The
# lexer emits `!` and `{` as separate symbol tokens, so the preceding token
# identifies it.
fn find_body_brace(tokens: Vec token.Token, i: Int, n: Int) -> Maybe source.SourcePos =
  if i >= n then Nothing
  else if brace_is_decl_keyword(brace_tok_at(tokens, i)) then Nothing
  else if brace_is_symbol(brace_tok_at(tokens, i), "{")
       && ! (brace_is_symbol(brace_tok_at(tokens, i - 1), "!")) then
    Just(token.token_position(brace_tok_at(tokens, i)))
  else find_body_brace(tokens, i + 1, n)

fn brace_body_scan(tokens: Vec token.Token, i: Int, n: Int, acc: List LintFinding) -> List LintFinding =
  if i >= n then list_reverse(acc)
  else if brace_is_keyword(brace_tok_at(tokens, i), "class")
       || brace_is_keyword(brace_tok_at(tokens, i), "instance") then
    match find_body_brace(tokens, i + 1, n) with
    | Nothing -> brace_body_scan(tokens, i + 1, n, acc)
    | Just pos ->
        brace_body_scan(tokens, i + 1, n,
          Cons(mk_finding(pos, "deprecated-brace-body",
            "brace-delimited class/instance body is deprecated — drop the braces and indent the members past the keyword"), acc))
  else brace_body_scan(tokens, i + 1, n, acc)

fn brace_body_findings(tokens: Vec token.Token) -> List LintFinding =
  brace_body_scan(tokens, 0, vec_length(tokens), Nil)

# ---------------------------------------------------------------------------
# Combinator patterns
#
# A rule whose pattern is a real definition cannot suggest a shape the function
# no longer has (docs/lint-rules-v0.md §5). The definitions are carried here as
# TEXT rather than read from `stdlib/prelude.sprout`, because the linter has to
# work in repos that have no prelude on disk; reading it would make this rule
# fire only inside sprout-lang.
#
# That is a second copy, so the property §5 got from having one copy is now a
# test's job: `tests/stdlib/compiler/test_lint_combinators.spr` derives from the
# real prelude and requires the two to be alpha-equal. Keep them in sync there,
# not by eye.

# Name, holes, pattern. The holes are in DECLARATION order and a reconstructed
# call fills its arguments from them positionally, so permuting them still
# matches and still typechecks while swapping the caller's arguments. Do not
# reorder without changing what reads `combinator_holes`.
export type Combinator (..) =
  | Combinator String (List String) ast.Expr

export fn combinator_name(c: Combinator) -> String =
  match c with
  | Combinator n _ _ -> n

export fn combinator_holes(c: Combinator) -> List String =
  match c with
  | Combinator _ hs _ -> hs

export fn combinator_pattern(c: Combinator) -> ast.Expr =
  match c with
  | Combinator _ _ e -> e

export let combinator_names: List String =
  ["result_with_default", "result_from_maybe", "guard", "maybe_with_default"]

# Verbatim from `stdlib/prelude.sprout`. Bodies only — the doc comments are left
# off because nothing derives from them.
let combinator_source: String = `export fn result_with_default(fallback: a, r: Result e a) -> a =
  match r with
  | Ok x -> x
  | Err _ -> fallback

export fn result_from_maybe(err: e, value: Maybe a) -> Result e a =
  match value with
  | Nothing -> Err(err)
  | Just unwrapped -> Ok(unwrapped)

export fn guard(condition: Bool, err: e) -> Result e Unit =
  if condition then Ok(()) else Err(err)

export fn maybe_with_default(fallback: a, m: Maybe a) -> a =
  match m with
  | Just x -> x
  | Nothing -> fallback
`

fn param_name(p: ast.Param) -> String =
  match p with
  | ast.Param n _ _ -> n

fn decl_is_fn_named(name: String, d: ast.Decl) -> Bool =
  match d with
  | ast.FnDecl n _ _ _ _ _ _ -> n == name
  | _ -> false

# §5.3: "one expression" is vacuous, since every body is one. `where` and
# `let..in` desugar to a MatchExpr too (ast.let_bind_match),
# so the branch patterns are what tells them apart — a let body binds with a
# variable pattern where a real combinator dispatches on a constructor.
fn constructor_headed(branches: List ast.MatchBranch) -> Bool =
  match branches with
  | [] -> false
  | [ast.MatchBranch pat _ | rest] ->
      match pat with
      | ast.ConstructorPattern _ _ _ -> if list_is_empty(rest) then true else constructor_headed(rest)
      | _ -> false

# Binders the branch patterns introduce. Patterns are small and closed, so this
# walk is complete over them — unlike the branch BODIES, which v0 does not
# inspect (§5.3): a hole shadowed by a lambda inside a body is not reported here.
# The matcher still treats such an occurrence as the binder's, not the hole's
# (`lint_pattern.is_hole`), so the gap costs a missed authoring warning and not
# a wrong match.
# Every variant is named rather than defaulted: a pattern variant added later
# would silently report no binders, and a missed binder is a missed authoring
# warning, not a compile error (guidelines.md §2a).
fn pattern_binders(pat: ast.Pattern) -> List String =
  match pat with
  | ast.VarPattern n _ -> [n]
  | ast.TuplePattern subs _ -> pattern_binders_all(subs)
  | ast.ConstructorPattern _ subs _ -> pattern_binders_all(subs)
  | ast.WildcardPattern _ -> []
  | ast.IntPattern _ _ -> []
  | ast.BoolPattern _ _ -> []
  | ast.StringPattern _ _ -> []
  | ast.CharPattern _ _ -> []
  | ast.UnitPattern _ -> []

fn pattern_binders_all(pats: List ast.Pattern) -> List String =
  list_flat_map(pattern_binders, pats)

fn branch_binders(branches: List ast.MatchBranch) -> List String =
  list_flat_map(branch_binders_one, branches)

fn branch_binders_one(b: ast.MatchBranch) -> List String =
  match b with
  | ast.MatchBranch pat _ -> pattern_binders(pat)

fn admissible_body(name: String, body: ast.Expr) -> Result String (List String) =
  match body with
  | ast.IfExpr _ _ _ _ -> Ok([])
  | ast.MatchExpr _ branches _ ->
      if constructor_headed(branches) then Ok(branch_binders(branches))
      else Err(name ++ ": every match branch must be constructor-headed; a `let`, `where` or "
               ++ "single-arm body derives to a pattern that matches only itself")
  | _ -> Err(name ++ ": body must be one `match` or one `if` — a `do` block is not derivable")

# A hole shadowed by a branch binder would name two different subterms.
fn shadowed_hole(holes: List String, binders: List String) -> Maybe String =
  find(\ (h: String) -> name_in_list(h, binders), holes)

fn derive_one(name: String, decls: List ast.Decl) -> Result String Combinator =
  match find(\ (d: ast.Decl) -> decl_is_fn_named(name, d), decls) with
  | Nothing -> Err(name ++ ": not defined in the combinator source")
  | Just (ast.FnDecl _ params _ _ _ body _) ->
      let holes = list_map(param_name, params)
          Ok binders = admissible_body(name, body) else Err msg -> Err(msg)
      in match shadowed_hole(holes, binders) with
         | Just h -> Err(name ++ ": parameter `" ++ h ++ "` is rebound by a branch pattern, "
                         ++ "so the hole names two different subterms")
         | Nothing -> Ok(Combinator(name, holes, body))
  | Just _ -> Err(name ++ ": is not a function declaration")

fn derive_each(names: List String, decls: List ast.Decl) -> Result String (List Combinator) =
  match names with
  | [] -> Ok([])
  | [n | rest] ->
      let Ok c = derive_one(n, decls) else Err msg -> Err(msg)
          Ok cs = derive_each(rest, decls) else Err msg -> Err(msg)
      in Ok(Cons(c, cs))

# Total, so a caller can test a rejection without taking the process down; the
# startup binding below is what turns a rejection into a panic.
export fn derive_combinators(names: List String, src: String)
    -> Result String (List Combinator) =
  let Ok toks = lexer.tokenize(src)
        else Err(token.TokenizeError msg _) -> Err("combinator source does not lex: " ++ msg)
      Ok parsed = parser.parse_program(toks)
        else Err(parser.ParseError msg _) -> Err("combinator source does not parse: " ++ msg)
      ast.Program decls _ = ast.elaborate_bindings(parsed)
  in derive_each(names, decls)

# `List Combinator`, derived once per process at module init — the reason
# `just lint` can batch paths instead of paying this per file (§10). It becomes
# a permanent GC root, and unlike this file's other globals it is an object
# graph rather than a flat string, so collection marks it whole.
# Unannotated because a top-level `let` annotation resolves only prelude types;
# docs/idiomatic-sprout.md says to leave it off and check the inferred type,
# which the test does by consuming it as `List Combinator`.
# The `panic` reports an authoring bug in the text above and nothing else — and
# is itself the shape §6 refuses to rewrite: hoisted, it would fire always.
export let combinator_patterns =
  match derive_combinators(combinator_names, combinator_source) with
  | Ok cs -> cs
  | Err msg -> panic("lint_rules: " ++ msg)

# ---------------------------------------------------------------------------
# Rule: hand-rolled-combinator
#
# A `match` that reimplements one of the combinators above. `let..else` desugars
# to the same MatchExpr (ast.let_bind_match), so one rule
# covers both spellings — and for THIS rule the desugared form is a true
# positive, which is why `drop_desugared_matches` must stay keyed on
# `staircase-of-doom` and not be generalised over rule ids.

let combinator_rule_id: String = "hand-rolled-combinator"

fn captured_exprs(holes: List String, caps: List lint_pattern.Capture) -> List ast.Expr =
  list_filter_map(\ (h: String) -> lint_pattern.capture_of(h, caps), holes)

# A match evaluates its scrutinee and an `if` its condition in BOTH spellings, so
# a hole there cannot make the rewrite eager however expensive it is; only a hole
# in a branch body can. Holding a scrutinee to the same test as a fallback once
# mis-scored 139 of 165 corpus findings (docs/lint-rules-v0.md §12).
fn conditional_holes(pattern: ast.Expr, holes: List String) -> List String =
  list_filter(\ (h: String) -> ! name_in_list (h, unconditional_holes(pattern, holes)), holes)

# Only the two shapes `admissible_body` lets through can arrive. A third would
# otherwise default to "nothing is unconditional" and quietly put the note back
# on every scrutinee, so it fails loudly instead (guidelines.md §2a).
fn unconditional_holes(pattern: ast.Expr, holes: List String) -> List String =
  match pattern with
  | ast.MatchExpr scrut _ _ -> holes_used_in(scrut, holes)
  | ast.IfExpr cond _ _ _ -> holes_used_in(cond, holes)
  | _ -> panic("lint_rules: derived a pattern that is neither a match nor an if (internal error)")

fn holes_used_in(e: ast.Expr, holes: List String) -> List String =
  list_filter(\ (h: String) -> expr_uses_any([h], e), holes)

# §6 and §7.4 as one test: report only a rewrite that costs nothing. Sprout is
# strict, so a call builds every argument while the match builds only the branch
# it takes; and a wrapper handed to a call is boxed, while a match on the call
# that produced it takes an unboxed worker. A rewrite failing either is not a
# tidier equivalent, so it is not advice.
fn rewrite_is_free(bound: List String, c: Combinator, subject: ast.Expr,
                   caps: List lint_pattern.Capture) -> Bool =
  all(\ (e: ast.Expr) -> free_to_hoist(bound, e),
      captured_exprs(conditional_holes(combinator_pattern(c), combinator_holes(c)), caps))
  && scrutinee_is_in_hand(bound, combinator_pattern(c), subject)

# Cost-free to evaluate early: no work and no allocation. A `VarExpr` is free only
# when it names a LOCAL binding — a top-level function read as a value costs a
# closure and a nullary constructor an interned-ctor call, both spelled like a
# variable. Every variant is named so a new one cannot silently join the list.
fn free_to_hoist(bound: List String, e: ast.Expr) -> Bool =
  match e with
  | ast.VarExpr n _ -> name_in_list(root_segment(n), bound)
  | ast.IntExpr _ _ -> true
  | ast.FloatExpr _ _ -> true
  | ast.BoolExpr _ _ -> true
  | ast.StringExpr _ _ -> true
  | ast.CharExpr _ _ -> true
  | ast.UnitExpr _ -> true
  | ast.StringTemplateExpr _ _ -> false
  | ast.TupleExpr _ _ -> false
  | ast.IfExpr _ _ _ _ -> false
  | ast.MatchExpr _ _ _ -> false
  | ast.CallExpr _ _ _ -> false
  | ast.LambdaExpr _ _ _ -> false
  | ast.BinaryExpr _ _ _ _ -> false
  | ast.UnaryExpr _ _ _ -> false
  | ast.IntRangeExpr _ _ _ -> false
  | ast.DoExpr _ _ -> false
  | ast.RecordExpr _ _ _ -> false
  | ast.GetFieldExpr _ _ _ -> false
  | ast.RecordUpdateExpr _ _ _ -> false
  | ast.ComprehensionExpr _ _ _ -> false
  | ast.LetBindExpr _ _ _ _ _ -> false
  | ast.TryExpr _ _ -> false

# A `guard`-shaped pattern consumes a Bool, which is an immediate — passing it to
# the call boxes nothing, so a computed condition is free (checked in IR). Only a
# `match` consumes a wrapper, and there the subject's scrutinee must already hold
# one: a call scrutinee would lose the callee's worker.
fn scrutinee_is_in_hand(bound: List String, pattern: ast.Expr, subject: ast.Expr) -> Bool =
  match pattern with
  | ast.IfExpr _ _ _ _ -> true
  | ast.MatchExpr _ _ _ ->
      let ast.MatchExpr scrut _ _ = subject else false
      in free_to_hoist(bound, scrut)
  | _ -> panic("lint_rules: derived a pattern that is neither a match nor an if (internal error)")

# `cfg.cached` and `string.trim` are both one dotted `VarExpr` (§4A). The root
# segment separates them: a field read on a local binding is free, a module-
# qualified function is a closure the rewrite would build on every call.
fn root_segment(name: String) -> String =
  let Just(root, _) = string.split_once(name, ".") else name
  in root

# A combinator name bound locally — a parameter, a `let`, a lambda argument —
# resolves to the shadow rather than the prelude, so the rewrite would not
# typecheck. The file-level guards cannot see this; only the walk's scope can.
fn combinator_finding(bound: List String, c: Combinator, e: ast.Expr,
                      pos: source.SourcePos) -> Maybe LintFinding =
  if name_in_list(combinator_name(c), bound) then Nothing
  else
    let Just caps = lint_pattern.match_expr(combinator_pattern(c), e, combinator_holes(c))
          else Nothing
    in if rewrite_is_free(bound, c, e, caps)
       then Just(mk_finding(pos, combinator_rule_id,
                            "this is `" ++ combinator_name(c) ++ "(...)`"))
       else Nothing

# At most one combinator can match a given node — they are structurally
# distinct — but nothing depends on that, so two would simply both report.
fn combinator_findings(bound: List String, e: ast.Expr,
                       pos: source.SourcePos) -> List LintFinding =
  list_filter_map(\ (c: Combinator) -> combinator_finding(bound, c, e, pos), combinator_patterns)

# §7 guards 2 and 3, both file-level and neither visible from the AST:
# `ast_findings` parses `source.strip_headers(src)`, so the imports and the
# `no_prelude` directive are gone before the AST exists.
#
# A file that shadows ANY combinator loses the whole rule, not just that one.
# Conservative on purpose, and it subsumes guard 1 for free: `prelude.sprout`
# defines all four, so the rule never fires on the definitions themselves.
fn combinator_rule_applies(src: String, decls: List ast.Decl) -> Bool =
  if opts_out_of_prelude(src) then false
  else if defines_a_combinator(decls) then false
  else if defines_a_wrapper_type(decls) then false
  else if redefines_a_matched_ctor(decls) then false
  else ! imports_a_combinator (src)

# Shadowing the combinator is not the only way to break the suggestion: a file
# redefining `Maybe` or `Result` shadows the type the combinators are declared
# over, so the rewrite does not typecheck ("Maybe vs Maybe"). 10 corpus files do
# this, and `test_ir_codegen_unary_arith.spr` carries a matching shape too.
# The types the four combinators in `combinator_source` are declared over. NOT
# derived from it, so a fifth combinator over a new wrapper needs an entry here as
# well as in `combinator_names` — the one place this rule's "one list entry" goal
# leaks (docs/lint-rules-v0.md §14 Q4).
let wrapper_type_names: List String = ["Maybe", "Result"]

fn defines_a_wrapper_type(decls: List ast.Decl) -> Bool =
  any(\ (d: ast.Decl) -> name_in_list(decl_declared_type_name(d), wrapper_type_names), decls)

fn all_pattern_ctor_names(cs: List Combinator) -> List String =
  match cs with
  | Nil -> Nil
  | Cons c rest -> list_append(pattern_ctor_names(c), all_pattern_ctor_names(rest))

fn pattern_ctor_names(c: Combinator) -> List String =
  match combinator_pattern(c) with
  | ast.MatchExpr _ branches _ -> list_filter_map(branch_ctor_name, branches)
  | _ -> Nil  # the `guard` shape is an `if`: it dispatches on no constructor

fn branch_ctor_name(b: ast.MatchBranch) -> Maybe String =
  match b with
  | ast.MatchBranch p _ -> pattern_ctor_name(p)

# Every variant is named (guidelines.md §2a): a catch-all here answers "names no
# constructor", which a future pattern form that DOES name one would need to
# override — and getting it wrong drops a name from the guard silently.
fn pattern_ctor_name(p: ast.Pattern) -> Maybe String =
  match p with
  | ast.ConstructorPattern n _ _ -> Just(n)
  | ast.WildcardPattern _ -> Nothing
  | ast.VarPattern _ _ -> Nothing
  | ast.IntPattern _ _ -> Nothing
  | ast.BoolPattern _ _ -> Nothing
  | ast.StringPattern _ _ -> Nothing
  | ast.CharPattern _ _ -> Nothing
  | ast.UnitPattern _ -> Nothing
  | ast.TuplePattern _ _ -> Nothing

# The constructor names the derived patterns dispatch on. Derived rather than
# listed again, so a fifth combinator over a new wrapper needs no entry here —
# half of the coupling §14 Q4 records.
let matched_ctor_names: List String = all_pattern_ctor_names(combinator_patterns)

# The other half of the wrapper guard, and the one that matters: `lint_pattern`
# dispatches on CONSTRUCTOR names, so a type reusing `Just`/`Ok` is matched
# however its own name is spelled, and `defines_a_wrapper_type` never sees it.
fn redefines_a_matched_ctor(decls: List ast.Decl) -> Bool =
  any(\ (d: ast.Decl) -> any_name_in(decl_value_names(d), matched_ctor_names), decls)

fn decl_value_names(d: ast.Decl) -> List String =
  list_map(scope_name, ast.decl_value_scopes(d))

fn scope_name(ns: (String, ast.NameScope)) -> String =
  match ns with
  | (n, _) -> n

fn any_name_in(names: List String, allowed: List String) -> Bool =
  any(\ (n: String) -> name_in_list(n, allowed), names)

# Four of the nine declaration forms introduce a type name. Every variant is named
# rather than defaulted: here the default runs the WRONG way — an unrecognised
# declaration would report no type, leaving the rule enabled and free to suggest a
# rewrite that does not typecheck, which is the bug this guard exists to stop.
fn decl_declared_type_name(d: ast.Decl) -> String =
  match d with
  | ast.TypeDecl n _ _ _ _ _ -> n
  | ast.RecordDecl n _ _ _ _ _ _ -> n
  | ast.AliasDecl n _ _ _ -> n
  | ast.WrapDecl n _ _ _ _ -> n
  | ast.FnDecl _ _ _ _ _ _ _ -> ""
  | ast.ExternFnDecl _ _ _ _ _ -> ""
  | ast.LetDecl _ _ _ _ -> ""
  | ast.ClassDecl _ _ _ _ _ -> ""
  | ast.InstanceDecl _ _ _ _ -> ""

fn header_line_text(numbered: (Int, String)) -> String =
  match numbered with
  | (_, line) -> line

fn opts_out_of_prelude(src: String) -> Bool =
  any(\ (l: (Int, String)) -> string.trim(header_line_text(l)) == source.no_prelude_directive,
      header_lines(src))

# Every value name a declaration binds, not just `fn` and `let`: a class method
# and a constructor shadow just as well, and `ast.decl_value_scopes` is the
# enumeration that already knows all of them.
fn defines_a_combinator(decls: List ast.Decl) -> Bool =
  any(\ (d: ast.Decl) -> any_name_in(decl_value_names(d), combinator_names), decls)

# A selective import shadows as effectively as a local definition. Names are
# compared as whole words, so a `guard_rail` import does not disable the rule, and
# the header is read as words rather than parsed, so a wrapped list, a comment
# inside one and a `T(..)` group all read alike (docs/lint-rules-v0.md §7 guard 2).
fn imports_a_combinator(src: String) -> Bool =
  any(\ (l: (Int, String)) -> any_name_is_combinator(header_names(header_line_text(l))),
      header_lines(src))

fn header_names(line: String) -> List String =
  source.strip_line_comment(line)
  |> string.replace_all("(", " ")
  |> string.replace_all(")", " ")
  |> string.replace_all(",", " ")
  |> string.words

fn any_name_is_combinator(names: List String) -> Bool =
  any(\ (n: String) -> name_in_list(string.trim(n), combinator_names), names)

# ---------------------------------------------------------------------------
# Suppression directives
#
# `# sprout-ignore-all lint/<rule>: <reason>` turns one rule off for the whole
# file. Transliterated from Biome's `// biome-ignore-all <category>:
# <explanation>` (biomejs.dev/analyzer/suppressions), which is the closest prior
# art that ports: every Biome suppression form is a LINE comment, and Sprout has
# no block comments. ESLint's file-level form is `/* eslint-disable */` with no
# line equivalent, so it could not be followed here.
#
# Both the rule name and the explanation are required, as Biome requires them.
# An unexplained suppression is the one that accumulates unreviewed.
#
# The directive is honoured only in the leading header block. That is not
# stylistic: the header is read as text before `tokenize` runs, which is what
# lets a file that never lexes suppress `unparsed` at all.

let ignore_all_directive: String = "sprout-ignore-all"
let ignore_all_category: String = "lint"

type IgnoreDirective (..) =
  | IgnoreRule String
  | IgnoreMalformed String

# The leading header block, numbered from 1, taken FROM `strip_headers` rather
# than by re-deriving where the header ends: every line it removes it replaces
# with a blank one, so the header block is exactly the prefix of `src` whose
# stripped counterpart is blank. Deriving it leaves source.sprout the single
# authority for that boundary — a second predicate here would drift from it, and
# a wrapped `import (a,\n b)` list is the case that would break first.
fn header_lines(src: String) -> List (Int, String) =
  header_lines_go(str_split_lines(src), str_split_lines(source.strip_headers(src)), 1, Nil)

fn header_lines_go(orig: List String, stripped: List String, n: Int, acc: List (Int, String)) -> List (Int, String) =
  match (orig, stripped) with
  | (Cons o os, Cons s ss) ->
      if string.trim(s) == "" then header_lines_go(os, ss, n + 1, Cons((n, o), acc))
      else list_reverse(acc)
  | _ -> list_reverse(acc)

# The text after `#`, for a line whose first non-space character is one.
fn comment_body(line: String) -> Maybe String =
  match string.split_once(string.trim(line), "#") with
  | Just (before, after) -> if before == "" then Just(string.trim(after)) else Nothing
  | Nothing -> Nothing

# `lint/<rule>` -> the rule id. Nothing when the category is missing or wrong:
# the prefix is what leaves room for `fmt/` and `assist/` categories later,
# which is why Biome namespaces its own.
fn directive_rule_id(category: String) -> Maybe String =
  match string.split_once(string.trim(category), "/") with
  | Just (head, rule) ->
      if head == ignore_all_category && string.trim(rule) != "" then Just(string.trim(rule))
      else Nothing
  | Nothing -> Nothing

let needs_rule_msg: String =
  "names no rule — write `" ++ ignore_all_directive ++ " " ++ ignore_all_category ++ "/<rule>: <reason>`"

let needs_reason_msg: String =
  "needs `: <reason>` — a suppression with no explanation cannot be reviewed"

# Nothing for a comment that is not a directive at all — an ordinary comment
# must stay ordinary. A comment that opens with the directive word but does not
# complete it IS reported, or a typo in the tail would silently do nothing.
fn parse_ignore_all(body: String) -> Maybe IgnoreDirective =
  if body == ignore_all_directive then Just(IgnoreMalformed(needs_rule_msg))
  else
    match string.split_once(body, " ") with
    | Nothing -> Nothing
    | Just (word, tail) ->
        if word != ignore_all_directive then Nothing
        else
          match string.split_once(tail, ":") with
          | Nothing -> Just(IgnoreMalformed(needs_reason_msg))
          | Just (category, reason) ->
              if string.trim(reason) == "" then Just(IgnoreMalformed(needs_reason_msg))
              else
                match directive_rule_id(category) with
                | Nothing -> Just(IgnoreMalformed(needs_rule_msg))
                | Just rule -> Just(IgnoreRule(rule))

fn line_directive(numbered: (Int, String)) -> Maybe (Int, IgnoreDirective) =
  match numbered with
  | (n, line) ->
      match comment_body(line) with
      | Nothing -> Nothing
      | Just body ->
          match parse_ignore_all(body) with
          | Nothing -> Nothing
          | Just d -> Just((n, d))

fn file_directives(src: String) -> List (Int, IgnoreDirective) =
  list_filter_map(line_directive, header_lines(src))

fn directive_rule(d: (Int, IgnoreDirective)) -> Maybe String =
  match d with
  | (_, IgnoreRule rule) -> Just(rule)
  | _ -> Nothing

# A malformed directive is never itself suppressible: it is the diagnostic that
# keeps a typo from reading as a working suppression.
fn directive_malformed(d: (Int, IgnoreDirective)) -> Maybe LintFinding =
  match d with
  | (n, IgnoreMalformed why) ->
      Just(LintFinding(n, 1, "malformed-suppression",
        "`" ++ ignore_all_directive ++ "` " ++ why))
  | _ -> Nothing

fn finding_rule_id(f: LintFinding) -> String =
  match f with
  | LintFinding _ _ rule_id _ -> rule_id

# ---------------------------------------------------------------------------
# A file that does not lex or parse cannot have a single AST rule run against
# it. Reporting it as clean would make an unchecked file indistinguishable from
# a checked one, so the failure is itself a finding: it prints through the same
# path and the driver exits non-zero. `strip_headers` pads each header line it
# removes with a newline, so the position here is the position in the file.
fn unparsed_finding(pos: source.SourcePos, reason: String) -> LintFinding =
  mk_finding(pos, "unparsed", reason ++ " — no lint rule could be checked")

# Every AST-based rule over a source file, before suppression is applied.
fn ast_findings(src: String) -> List LintFinding =
  match lexer.tokenize(source.strip_headers(src)) with
  | Err (token.TokenizeError msg pos) -> [unparsed_finding(pos, msg)]
  | Ok toks ->
      match parser.parse_program(toks) with
      | Err (parser.ParseError msg pos) -> [unparsed_finding(pos, msg)]
      | Ok parsed ->
          # The rules match the matches bindings mean, as inference sees them.
          let prog = ast.elaborate_bindings(parsed)
          in list_append(drop_desugared_matches(src, guarded_program_findings(src, prog)),
               list_append(list_shape_findings(src, prog),
                 list_append(list_prefix_findings(src, prog), brace_body_findings(toks))))

# The combinator rule is collected during the walk and dropped here, because its
# §7 guards are facts about the FILE that the walk cannot see. Filtering by rule
# id keeps that decision out of the shared walkers, which three other rules use.
fn guarded_program_findings(src: String, prog: ast.Program) -> List LintFinding =
  match prog with
  | ast.Program decls _ ->
      let found = lint_program(prog)
      in if combinator_rule_applies(src, decls) then found
         else list_filter(\ (f: LintFinding) -> finding_rule_id(f) != combinator_rule_id, found)

export fn lint_ast(src: String) -> List LintFinding =
  list_append(list_filter_map(directive_malformed, ds), list_filter(kept, ast_findings(src)))
where
  ds = file_directives(src)
  suppressed = list_filter_map(directive_rule, ds)
  kept = \ (f: LintFinding) -> ! name_in_list (finding_rule_id(f), suppressed)
