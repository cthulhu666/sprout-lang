module stdlib.compiler.lint_rules

import stdlib.compiler.ast as ast
import stdlib.compiler.parser as parser
import stdlib.compiler.lexer as lexer
import stdlib.compiler.token as token
import stdlib.compiler.source as source
import stdlib.string as string
import stdlib.compiler.desugar_ctx as desugar_ctx

# AST-based lint findings — line, col, rule id, message. A sibling to
# formatter.LintIssue's line-based Style checks; this is the "Lint" category,
# built on the real parser AST instead of raw text/tokens.
export type LintFinding (..) =
  | LintFinding Int Int String String

fn mk_finding(pos: source.SourcePos, rule_id: String, message: String) -> LintFinding =
  LintFinding(pos.line, pos.column, rule_id, message)

# ---------------------------------------------------------------------------
# Rule: staircase-of-doom
#
# A chain of nested 2-branch matches, each peeling one constructor off a
# Maybe/Result-like value, of the exact shape docs/idiomatic-sprout.md calls
# out to flatten with `let..else`. Purely syntactic — no type info needed.

fn is_var_pattern(pat: ast.Pattern) -> Bool =
  match pat with
  | ast.VarPattern _ _ -> true
  | _ -> false

fn has_binding_subpattern(subpats: List ast.Pattern) -> Bool =
  match subpats with
  | Nil -> false
  | Cons p rest -> is_var_pattern(p) || has_binding_subpattern(rest)

# A pattern let..else could bind: a constructor pattern with at least one
# variable subpattern (Just te, Ok x, TypedOk prog env) — not Nothing, not True.
fn is_binding_pattern(pat: ast.Pattern) -> Bool =
  match pat with
  | ast.ConstructorPattern _ subpats _ -> has_binding_subpattern(subpats)
  | _ -> false

# List's own Cons — self-recursive list-walk shape (`match xs with | Nil -> ..
# | Cons h t -> match t with ...`), not a Maybe/Result unwrap. Flattening this
# with let..else would point at the wrong fix; idiomatic-sprout.md's own
# combinator section is what applies here instead, so this rule stays scoped
# to Maybe/Result-shaped chains and leaves list recursion alone.
fn is_list_cons_pattern(pat: ast.Pattern) -> Bool =
  match pat with
  | ast.ConstructorPattern name _ _ -> name == ast.list_ctor_cons
  | _ -> false

fn is_two_branch_match(e: ast.Expr) -> Bool =
  match e with
  | ast.MatchExpr _ [_, _] _ -> true
  | _ -> false

# A branch "continues" the staircase when its pattern binds a variable
# (excluding list-walk recursion via Cons) AND its body is itself a 2-branch
# match — the shape a `let <pat> = e else fb` guard line could replace.
fn continues(pat: ast.Pattern, body: ast.Expr) -> Bool =
  is_binding_pattern(pat) && ! is_list_cons_pattern (pat) && is_two_branch_match(body)

# classify: given a match's two branches, decide whether exactly one of them
# continues the staircase. Returns (terminal_pattern, terminal_body,
# continuing_body) — the other's body is guaranteed to itself be a 2-branch
# MatchExpr by `continues`. The terminal pattern is returned too so callers
# can tell whether that branch's body depends on its own (failing) binding —
# `let..else` can't express that (see terminal_needs_own_payload below).
fn classify(b1: ast.MatchBranch, b2: ast.MatchBranch) -> Maybe(ast.Pattern, ast.Expr, ast.Expr) =
  match b1 with
  | ast.MatchBranch p1 body1 ->
      match b2 with
      | ast.MatchBranch p2 body2 ->
          let c1 = continues(p1, body1)
              c2 = continues(p2, body2)
          in if c1 && ! c2 then Just((p2, body2, body1))
             else if c2 && ! c1 then Just((p1, body1, body2))
             else Nothing

# The variable names a pattern binds — used to check whether a terminal
# branch's body depends on its own (failing) match, which `let <pat> = e
# else fb` cannot express: `fb` is matched against a bare wildcard
# (parser.sprout: build_let_binding_match), so it has no access to whatever
# the failing pattern would have bound (e.g. the `msg` in `Err msg -> ...`).
fn pattern_bound_names(pat: ast.Pattern) -> List String =
  match pat with
  | ast.VarPattern name _ -> Cons(name, Nil)
  | ast.ConstructorPattern _ subpats _ -> pattern_list_bound_names(subpats)
  | ast.TuplePattern subpats _ -> pattern_list_bound_names(subpats)
  | _ -> Nil

fn pattern_list_bound_names(pats: List ast.Pattern) -> List String =
  match pats with
  | Nil -> Nil
  | Cons p rest -> list_append(pattern_bound_names(p), pattern_list_bound_names(rest))

fn name_in_list(name: String, names: List String) -> Bool =
  match names with
  | Nil -> false
  | Cons n rest -> n == name || name_in_list(name, rest)

# True when `e` references any of `names` as a plain variable — a simple,
# shadowing-unaware syntactic check (adequate here: this only ever picks
# which lint message to show, never rewrites anything).
fn expr_uses_any(names: List String, e: ast.Expr) -> Bool =
  match e with
  | ast.VarExpr name _ -> name_in_list(name, names)
  | ast.MatchExpr scrut branches _ ->
      expr_uses_any(names, scrut) || branches_use_any(names, branches)
  | ast.IfExpr cond then_ else_ _ ->
      expr_uses_any(names, cond) || expr_uses_any(names, then_) || expr_uses_any(names, else_)
  | ast.CallExpr callee args _ ->
      expr_uses_any(names, callee) || exprs_use_any(names, args)
  | ast.TupleExpr elems _ -> exprs_use_any(names, elems)
  | ast.BinaryExpr _ left right _ ->
      expr_uses_any(names, left) || expr_uses_any(names, right)
  | ast.UnaryExpr _ operand _ -> expr_uses_any(names, operand)
  | ast.LambdaExpr _ body _ -> expr_uses_any(names, body)
  | ast.DoExpr steps _ -> do_steps_use_any(names, steps)
  | ast.RecordExpr _ fields _ -> record_fields_use_any(names, fields)
  | ast.GetFieldExpr rec_expr _ _ -> expr_uses_any(names, rec_expr)
  | ast.RecordUpdateExpr base fields _ -> expr_uses_any(names, base) || record_fields_use_any(names, fields)
  | ast.IntRangeExpr lo hi _ -> expr_uses_any(names, lo) || expr_uses_any(names, hi)
  | ast.StringTemplateExpr parts _ -> template_parts_use_any(names, parts)
  | ast.ComprehensionExpr elem gens _ -> expr_uses_any(names, elem) || comprehension_gens_use_any(names, gens)
  | _ -> false  # leaves: Int/Float/Bool/String/Char/Unit — no sub-expressions

fn comprehension_gens_use_any(names: List String, gens: List ast.ComprehensionGen) -> Bool =
  match gens with
  | Nil -> false
  | Cons g rest ->
      (match g with
       | ast.ComprehensionGen _ src guards -> expr_uses_any(names, src) || exprs_use_any(names, guards))
      || comprehension_gens_use_any(names, rest)

fn exprs_use_any(names: List String, exprs: List ast.Expr) -> Bool =
  match exprs with
  | Nil -> false
  | Cons e rest -> expr_uses_any(names, e) || exprs_use_any(names, rest)

fn branches_use_any(names: List String, branches: List ast.MatchBranch) -> Bool =
  match branches with
  | Nil -> false
  | Cons b rest ->
      match b with
      | ast.MatchBranch _ body -> expr_uses_any(names, body) || branches_use_any(names, rest)

fn do_steps_use_any(names: List String, steps: List ast.DoStep) -> Bool =
  match steps with
  | Nil -> false
  | Cons s rest ->
      (match s with
       | ast.DoBindStep _ value -> expr_uses_any(names, value)
       | ast.DoLetStep _ value -> expr_uses_any(names, value)
       | ast.DoExprStep value -> expr_uses_any(names, value))
      || do_steps_use_any(names, rest)

fn record_fields_use_any(names: List String, fields: List ast.RecordField) -> Bool =
  match fields with
  | Nil -> false
  | Cons f rest ->
      match f with
      | ast.RecordField _ value -> expr_uses_any(names, value) || record_fields_use_any(names, rest)

fn template_parts_use_any(names: List String, parts: List ast.TemplateExprPart) -> Bool =
  match parts with
  | Nil -> false
  | Cons p rest ->
      (match p with
       | ast.LitPart _ -> false
       | ast.InterpPart e -> expr_uses_any(names, e))
      || template_parts_use_any(names, rest)

fn terminal_needs_own_payload(pat: ast.Pattern, body: ast.Expr) -> Bool =
  expr_uses_any(pattern_bound_names(pat), body)

# ---------------------------------------------------------------------------
# Generic ast.Expr traversal — every variant, modeled on checker.sprout's
# desugar_expr_no_ctx_i so no shape is silently skipped (a missed variant here
# is a silent false negative, the worst failure mode for a coverage tool).

fn walk_expr(e: ast.Expr) -> List LintFinding =
  match e with
  | ast.MatchExpr scrut branches pos -> walk_match(scrut, branches, pos)
  | ast.IfExpr cond then_ else_ _ ->
      list_append(walk_expr(cond), list_append(walk_expr(then_), walk_expr(else_)))
  | ast.CallExpr callee args _ ->
      list_append(multi_line_lambda_findings(args),
                  list_append(walk_expr(callee), walk_exprs(args)))
  | ast.TupleExpr elems _ -> walk_exprs(elems)
  | ast.BinaryExpr _ left right _ ->
      list_append(walk_expr(left), walk_expr(right))
  | ast.UnaryExpr _ operand _ -> walk_expr(operand)
  | ast.LambdaExpr _ body _ -> walk_expr(body)
  | ast.DoExpr steps _ -> walk_do_steps(steps)
  | ast.RecordExpr _ fields _ -> walk_record_fields(fields)
  | ast.GetFieldExpr rec_expr _ _ -> walk_expr(rec_expr)
  | ast.RecordUpdateExpr base fields _ -> list_append(walk_expr(base), walk_record_fields(fields))
  | ast.IntRangeExpr lo hi _ ->
      list_append(walk_expr(lo), walk_expr(hi))
  | ast.StringTemplateExpr parts _ -> walk_template_parts(parts)
  | ast.ComprehensionExpr elem gens _ -> list_append(walk_expr(elem), walk_comprehension_gens(gens))
  | _ -> Nil  # leaves: Var/Int/Float/Bool/String/Char/Unit — no sub-expressions

fn walk_comprehension_gens(gens: List ast.ComprehensionGen) -> List LintFinding =
  match gens with
  | Nil -> Nil
  | Cons g rest -> list_append(walk_comprehension_gen(g), walk_comprehension_gens(rest))

fn walk_comprehension_gen(g: ast.ComprehensionGen) -> List LintFinding =
  match g with
  | ast.ComprehensionGen _ src guards -> list_append(walk_expr(src), walk_exprs(guards))

fn walk_exprs(exprs: List ast.Expr) -> List LintFinding =
  match exprs with
  | Nil -> Nil
  | Cons e rest -> list_append(walk_expr(e), walk_exprs(rest))

fn walk_do_step(s: ast.DoStep) -> List LintFinding =
  match s with
  | ast.DoBindStep _ value -> walk_expr(value)
  | ast.DoLetStep _ value -> walk_expr(value)
  | ast.DoExprStep value -> walk_expr(value)

fn walk_do_steps(steps: List ast.DoStep) -> List LintFinding =
  match steps with
  | Nil -> Nil
  | Cons s rest -> list_append(walk_do_step(s), walk_do_steps(rest))

fn walk_record_fields(fields: List ast.RecordField) -> List LintFinding =
  match fields with
  | Nil -> Nil
  | Cons f rest ->
      match f with
      | ast.RecordField _ value -> list_append(walk_expr(value), walk_record_fields(rest))

fn walk_template_parts(parts: List ast.TemplateExprPart) -> List LintFinding =
  match parts with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.LitPart _ -> walk_template_parts(rest)
      | ast.InterpPart e -> list_append(walk_expr(e), walk_template_parts(rest))

fn walk_branch(b: ast.MatchBranch) -> List LintFinding =
  match b with
  | ast.MatchBranch _ body -> walk_expr(body)

fn walk_branches(branches: List ast.MatchBranch) -> List LintFinding =
  match branches with
  | Nil -> Nil
  | Cons b rest -> list_append(walk_branch(b), walk_branches(rest))

# Minimum chain length (number of nested matches, including the root) before
# a chain is reported. The docs/idiomatic-sprout.md example is itself only
# 2 deep; raising this filters out simple two-level unwraps and flags only
# genuinely deep cascades.
let min_staircase_depth = 3

# walk_chain: the chain starting at this 2-branch match. Returns (depth,
# blocked, findings) — depth is 1 + however deep the continuing branch's own
# chain goes; blocked is true when ANY link's terminal branch needs its own
# (failing-pattern) payload, meaning the flat form needs a binding-else
# (`else <pat> -> <h>`, Tier 1b) rather than a constant else; findings covers every
# non-chain subexpression along the way (the scrutinee at each link, each
# link's terminal body) but never a finding for THIS node — the caller
# decides that once it knows the total depth and blocked status.
fn walk_chain(branches: List ast.MatchBranch, scrut: ast.Expr) -> (Int, Bool, List LintFinding) =
  match branches with
  | [b1, b2] ->
      (match classify(b1, b2) with
       | Just (terminal_pat, terminal_body, continuing_match) ->
           (match walk_chain_expr(continuing_match) with
            | (inner_depth, inner_blocked, inner_findings) ->
                (1 + inner_depth,
                  inner_blocked || terminal_needs_own_payload(terminal_pat, terminal_body),
                  list_append(walk_expr(scrut), list_append(walk_expr(terminal_body), inner_findings))))
       | Nothing ->
           # Neither branch continues, so this match is the chain's own
           # trailing leaf, not a link that gets rewritten into an else-
           # fallback. Its arms stay ordinary match arms either way, free to
           # use their own bindings — hence `blocked = false` here even if
           # b1/b2 reference their own payload.
           (1, false, list_append(walk_expr(scrut), list_append(walk_branch(b1), walk_branch(b2)))))
  | _ -> (1, false, list_append(walk_expr(scrut), walk_branches(branches)))

# walk_chain_expr: like walk_chain, but for an expression that may or may not
# itself be a match — a chain link's continuing body is always a MatchExpr
# (guaranteed by `continues`), but this is also the fallback used when the
# generic walker isn't already inside a chain.
fn walk_chain_expr(e: ast.Expr) -> (Int, Bool, List LintFinding) =
  match e with
  | ast.MatchExpr scrut branches _ -> walk_chain(branches, scrut)
  | _ -> (1, false, walk_expr(e))

# Both shapes have a concrete fix in let..else, so both name it. A chain whose
# terminal recovers using the *failing* pattern's payload needs the binding-else
# form (`else <pat> -> <handler>`, Tier 1b) so the payload is in scope; a chain
# that bails to a constant uses the plain constant else. The message says which.
fn staircase_message(blocked: Bool) -> String =
  if blocked
  then "nested match can be flattened with let..else — the failing case carries a payload, so use a binding-else `else <pat> -> ...` (docs/idiomatic-sprout.md)"
  else "nested match can be flattened with let..else (docs/idiomatic-sprout.md)"

fn walk_match(scrut: ast.Expr, branches: List ast.MatchBranch, pos: source.SourcePos) -> List LintFinding =
  match walk_chain(branches, scrut) with
  | (depth, blocked, findings) ->
      if depth >= min_staircase_depth
      then Cons(mk_finding(pos, "staircase-of-doom", staircase_message(blocked)), findings)
      else findings

# ---------------------------------------------------------------------------
# Rule: redundant-vec-from-list
#
# Flags a hand-written `vec_from_list(<bare list literal>)` sitting in a
# position the checker's own desugar pass already recognizes as Vec-typed
# (stdlib/compiler/desugar_ctx.sprout) — the checker would wrap a bare
# literal there on its own, so an explicit wrap around one is a no-op the
# reader has to see past. Detection reuses desugar_ctx's exact Vec-context
# computation (same fn_idx, same if/match threading) so this rule can never
# disagree with what the checker actually does.

fn redundant_vec_wrap_message() -> String =
  "vec_from_list(...) here is redundant — this argument is already in Vec context and gets wrapped automatically"

fn redundant_vec_wrap_findings(prog: ast.Program) -> List LintFinding =
  positions_to_findings(desugar_ctx.find_redundant_vec_wraps(prog))

fn positions_to_findings(positions: List source.SourcePos) -> List LintFinding =
  match positions with
  | Nil -> Nil
  | Cons pos rest ->
      Cons(mk_finding(pos, "redundant-vec-from-list", redundant_vec_wrap_message()), positions_to_findings(rest))

# ---------------------------------------------------------------------------
# Rule: list-shape-pattern
#
# Flags a hand-written Cons/Nil chain that matches an EXACT fixed length —
# e.g. `Cons a (Cons b Nil)` — which reads more clearly as `[a, b]`
# (docs/idiomatic-sprout.md "Match lists by shape with […] patterns"). Scoped
# to fixed-length chains only: a chain whose tail is a bound variable
# (`Cons h t`, ordinary head/tail recursion) or a wildcard (`Cons h _`,
# discard the rest) is NOT flagged — a corpus scan showed those two shapes
# together are ~99% of all hand-written Cons/Nil patterns in this codebase,
# and `[h | t]`/`[h | _]` convey nothing `Cons h t`/`Cons h _` don't already
# say. Only a chain that terminates in a literal Nil — every position pinned
# to an exact length — gets the sugar win.
#
# `[…]` pattern sugar desugars to the SAME ConstructorPattern nodes with no
# distinguishing AST marker (parser.sprout: parse_list_pattern/
# build_cons_pattern) — but the WHOLE desugared literal shares ONE SourcePos,
# the position of the `[` token, while a hand-written Cons/Nil node carries
# the position of its own token. So the same source-text-sniffing trick as
# is_written_as_match (below) tells them apart, applied as a post-filter.

fn list_shape_message() -> String =
  "list matched with a fixed length via raw Cons/Nil constructors — [...] list-pattern sugar reads the length at a glance (docs/idiomatic-sprout.md)"

# True when a Cons/Nil pattern chain terminates in a literal Nil — i.e. every
# link is pinned to an exact position, never a bound tail variable or
# wildcard that would keep matching arbitrarily longer lists.
fn chain_terminates_in_nil(pat: ast.Pattern) -> Bool =
  match pat with
  | ast.ConstructorPattern name subpats _ ->
      if name == ast.list_ctor_nil then true
      else if name == ast.list_ctor_cons then
        match subpats with
        | [_, tail] -> chain_terminates_in_nil(tail)
        | _ -> false  # malformed arity guard
      else false
  | _ -> false  # bound variable or wildcard: not a fixed length

# Entry point for any pattern position: a Cons chain that terminates in Nil
# is a fixed-length ROOT — one finding at the outermost Cons, and further
# search continues only into the head (an independently-reportable nested
# list, e.g. a list-of-lists' element). A chain that does NOT terminate in
# Nil (ordinary head/tail recursion, or a discarded wildcard tail) is left
# alone itself, but its head and tail are still searched generically for
# fixed-length patterns nested elsewhere inside them.
fn find_list_shape_in_pattern(pat: ast.Pattern) -> List source.SourcePos =
  match pat with
  | ast.ConstructorPattern name subpats pos ->
      if name == ast.list_ctor_cons then
        match subpats with
        | [head, tail] ->
            if chain_terminates_in_nil(tail)
            then Cons(pos, find_list_shape_in_pattern(head))
            else find_list_shape_in_pattern(head) ++ find_list_shape_in_pattern(tail)
        | _ -> find_list_shape_in_patterns(subpats)  # malformed arity guard
      else
        find_list_shape_in_patterns(subpats)  # bare Nil: no subpatterns, no finding
  | ast.TuplePattern subpats _ -> find_list_shape_in_patterns(subpats)
  | _ -> Nil  # Wildcard/Var/Int/Bool/String/Char/Unit: leaves, no subpatterns

fn find_list_shape_in_patterns(pats: List ast.Pattern) -> List source.SourcePos =
  concat_map(find_list_shape_in_pattern, pats)

fn is_written_as_ctor(src: String, line: Int, col: Int) -> Bool =
  string.starts_with(rest_of_line(src, line, col), ast.list_ctor_cons)
  || string.starts_with(rest_of_line(src, line, col), ast.list_ctor_nil)

fn rest_of_line(src: String, line: Int, col: Int) -> String =
  str_slice(text, col - 1, str_len(text) - (col - 1))
  where text = nth_line(str_split_lines(src), line, 1)

fn drop_desugared_list_patterns(src: String, positions: List source.SourcePos) -> List source.SourcePos =
  filter(\pos -> is_written_as_ctor(src, pos.line, pos.column), positions)

fn list_shape_findings(src: String, prog: ast.Program) -> List LintFinding =
  match prog with
  | ast.Program decls _ ->
      map(\pos -> mk_finding(pos, "list-shape-pattern", list_shape_message()),
        drop_desugared_list_patterns(src, find_list_shape_in_decls(decls)))

fn find_list_shape_in_decls(decls: List ast.Decl) -> List source.SourcePos =
  concat_map(find_list_shape_in_decl, decls)

fn find_list_shape_in_decl(d: ast.Decl) -> List source.SourcePos =
  match d with
  | ast.FnDecl _ _ _ _ _ body _ -> find_list_shape_in_expr(body)
  | ast.LetDecl _ body _ _ -> find_list_shape_in_expr(body)
  | ast.InstanceDecl _ _ methods _ -> find_list_shape_in_instance_methods(methods)
  | _ -> Nil

fn find_list_shape_in_instance_methods(methods: List ast.InstanceMethodImpl) -> List source.SourcePos =
  concat_map(\m -> match m with | ast.InstanceMethodImpl _ _ _ _ body -> find_list_shape_in_expr(body), methods)

# Reuses the SAME generic expr traversal shape as walk_expr above (a
# separate, parallel walk — see walk_expr's own header comment on why every
# variant is covered explicitly). Pattern positions only exist at match
# branches and do-binds (ast.MatchBranch/ast.DoBindStep) — function/lambda
# params are bare names (ast.Param String (Maybe TypeExpr) ParamMode), no patterns.
fn find_list_shape_in_expr(e: ast.Expr) -> List source.SourcePos =
  match e with
  | ast.MatchExpr scrut branches _ ->
      find_list_shape_in_expr(scrut) ++ find_list_shape_in_branches(branches)
  | ast.IfExpr cond then_ else_ _ ->
      find_list_shape_in_expr(cond) ++ find_list_shape_in_expr(then_) ++ find_list_shape_in_expr(else_)
  | ast.CallExpr callee args _ ->
      find_list_shape_in_expr(callee) ++ find_list_shape_in_exprs(args)
  | ast.TupleExpr elems _ -> find_list_shape_in_exprs(elems)
  | ast.BinaryExpr _ left right _ ->
      find_list_shape_in_expr(left) ++ find_list_shape_in_expr(right)
  | ast.UnaryExpr _ operand _ -> find_list_shape_in_expr(operand)
  | ast.LambdaExpr _ body _ -> find_list_shape_in_expr(body)
  | ast.DoExpr steps _ -> find_list_shape_in_do_steps(steps)
  | ast.RecordExpr _ fields _ -> find_list_shape_in_record_fields(fields)
  | ast.GetFieldExpr rec_expr _ _ -> find_list_shape_in_expr(rec_expr)
  | ast.RecordUpdateExpr base fields _ -> find_list_shape_in_expr(base) ++ find_list_shape_in_record_fields(fields)
  | ast.IntRangeExpr lo hi _ ->
      find_list_shape_in_expr(lo) ++ find_list_shape_in_expr(hi)
  | ast.StringTemplateExpr parts _ -> find_list_shape_in_template_parts(parts)
  | ast.ComprehensionExpr elem gens _ -> find_list_shape_in_expr(elem) ++ find_list_shape_in_comprehension_gens(gens)
  | _ -> Nil

fn find_list_shape_in_comprehension_gens(gens: List ast.ComprehensionGen) -> List source.SourcePos =
  concat_map(find_list_shape_in_comprehension_gen, gens)

fn find_list_shape_in_comprehension_gen(g: ast.ComprehensionGen) -> List source.SourcePos =
  match g with
  | ast.ComprehensionGen pat src guards ->
      find_list_shape_in_pattern(pat) ++ find_list_shape_in_expr(src) ++ find_list_shape_in_exprs(guards)

fn find_list_shape_in_exprs(exprs: List ast.Expr) -> List source.SourcePos =
  concat_map(find_list_shape_in_expr, exprs)

fn find_list_shape_in_branches(branches: List ast.MatchBranch) -> List source.SourcePos =
  concat_map(find_list_shape_in_branch, branches)

fn find_list_shape_in_branch(b: ast.MatchBranch) -> List source.SourcePos =
  match b with
  | ast.MatchBranch pat body -> find_list_shape_in_pattern(pat) ++ find_list_shape_in_expr(body)

fn find_list_shape_in_do_steps(steps: List ast.DoStep) -> List source.SourcePos =
  concat_map(find_list_shape_in_do_step, steps)

fn find_list_shape_in_do_step(s: ast.DoStep) -> List source.SourcePos =
  match s with
  | ast.DoBindStep pat value -> find_list_shape_in_pattern(pat) ++ find_list_shape_in_expr(value)
  | ast.DoLetStep _ value -> find_list_shape_in_expr(value)
  | ast.DoExprStep value -> find_list_shape_in_expr(value)

fn find_list_shape_in_record_fields(fields: List ast.RecordField) -> List source.SourcePos =
  concat_map(\f -> match f with | ast.RecordField _ value -> find_list_shape_in_expr(value), fields)

fn find_list_shape_in_template_parts(parts: List ast.TemplateExprPart) -> List source.SourcePos =
  concat_map(find_list_shape_in_template_part, parts)

fn find_list_shape_in_template_part(p: ast.TemplateExprPart) -> List source.SourcePos =
  match p with
  | ast.LitPart _ -> Nil
  | ast.InterpPart e -> find_list_shape_in_expr(e)

# ---------------------------------------------------------------------------
# Rule: list-prefix-pattern
#
# Sibling to list-shape-pattern: flags a hand-written Cons chain whose tail
# is a discarded wildcard (`Cons h _`), matchable with `[h | _]` sugar. This
# is the `Cons h _` case list-shape-pattern deliberately deferred out of its
# own scope (BACKLOG.md) — a materially different signal from fixed-length:
# no exact-length claim, just "match a prefix, discard the rest." Unlike a
# bound tail variable (`Cons h t`, used to keep recursing — NOT flagged,
# same as list-shape-pattern), a wildcard tail can never be inspected
# further, so naming the shape with `[…]` loses nothing.
#
# Same SourcePos-granularity discriminator as list-shape-pattern (`[…]`
# sugar shares one position, the `[` token's; hand-written carries its own
# token's position) — reuses list-shape-pattern's is_written_as_ctor filter.

fn list_prefix_message() -> String =
  "list matched with a discarded tail via raw Cons/Nil constructors — [...] list-pattern sugar reads the shape at a glance (docs/idiomatic-sprout.md)"

# True when a Cons pattern chain's tail resolves to a literal wildcard —
# i.e. the chain matches a fixed PREFIX and explicitly discards whatever
# follows, never binding it. A tail that resolves to Nil (exact length,
# list-shape-pattern's territory) or a bound variable (ordinary head/tail
# recursion) is NOT a wildcard tail.
fn chain_terminates_in_wildcard(pat: ast.Pattern) -> Bool =
  match pat with
  | ast.WildcardPattern _ -> true
  | ast.ConstructorPattern name subpats _ ->
      if name == ast.list_ctor_cons then
        match subpats with
        | [_, tail] -> chain_terminates_in_wildcard(tail)
        | _ -> false  # malformed arity guard
      else false  # Nil terminal: list-shape-pattern's territory, not this rule
  | _ -> false  # bound variable: ordinary recursion, not flagged

# Mirrors find_list_shape_in_pattern's structure exactly, swapping the
# terminal check from chain_terminates_in_nil to chain_terminates_in_wildcard.
fn find_prefix_pattern_in_pattern(pat: ast.Pattern) -> List source.SourcePos =
  match pat with
  | ast.ConstructorPattern name subpats pos ->
      if name == ast.list_ctor_cons then
        match subpats with
        | [head, tail] ->
            if chain_terminates_in_wildcard(tail)
            then Cons(pos, find_prefix_pattern_in_pattern(head))
            else find_prefix_pattern_in_pattern(head) ++ find_prefix_pattern_in_pattern(tail)
        | _ -> find_prefix_pattern_in_patterns(subpats)  # malformed arity guard
      else
        find_prefix_pattern_in_patterns(subpats)  # bare Nil: no subpatterns, no finding
  | ast.TuplePattern subpats _ -> find_prefix_pattern_in_patterns(subpats)
  | _ -> Nil  # Wildcard/Var/Int/Bool/String/Char/Unit: leaves, no subpatterns

fn find_prefix_pattern_in_patterns(pats: List ast.Pattern) -> List source.SourcePos =
  concat_map(find_prefix_pattern_in_pattern, pats)

fn list_prefix_findings(src: String, prog: ast.Program) -> List LintFinding =
  match prog with
  | ast.Program decls _ ->
      map(\pos -> mk_finding(pos, "list-prefix-pattern", list_prefix_message()),
        drop_desugared_list_patterns(src, find_prefix_pattern_in_decls(decls)))

fn find_prefix_pattern_in_decls(decls: List ast.Decl) -> List source.SourcePos =
  concat_map(find_prefix_pattern_in_decl, decls)

fn find_prefix_pattern_in_decl(d: ast.Decl) -> List source.SourcePos =
  match d with
  | ast.FnDecl _ _ _ _ _ body _ -> find_prefix_pattern_in_expr(body)
  | ast.LetDecl _ body _ _ -> find_prefix_pattern_in_expr(body)
  | ast.InstanceDecl _ _ methods _ -> find_prefix_pattern_in_instance_methods(methods)
  | _ -> Nil

fn find_prefix_pattern_in_instance_methods(methods: List ast.InstanceMethodImpl) -> List source.SourcePos =
  concat_map(\m -> match m with | ast.InstanceMethodImpl _ _ _ _ body -> find_prefix_pattern_in_expr(body), methods)

fn find_prefix_pattern_in_expr(e: ast.Expr) -> List source.SourcePos =
  match e with
  | ast.MatchExpr scrut branches _ ->
      find_prefix_pattern_in_expr(scrut) ++ find_prefix_pattern_in_branches(branches)
  | ast.IfExpr cond then_ else_ _ ->
      find_prefix_pattern_in_expr(cond) ++ find_prefix_pattern_in_expr(then_) ++ find_prefix_pattern_in_expr(else_)
  | ast.CallExpr callee args _ ->
      find_prefix_pattern_in_expr(callee) ++ find_prefix_pattern_in_exprs(args)
  | ast.TupleExpr elems _ -> find_prefix_pattern_in_exprs(elems)
  | ast.BinaryExpr _ left right _ ->
      find_prefix_pattern_in_expr(left) ++ find_prefix_pattern_in_expr(right)
  | ast.UnaryExpr _ operand _ -> find_prefix_pattern_in_expr(operand)
  | ast.LambdaExpr _ body _ -> find_prefix_pattern_in_expr(body)
  | ast.DoExpr steps _ -> find_prefix_pattern_in_do_steps(steps)
  | ast.RecordExpr _ fields _ -> find_prefix_pattern_in_record_fields(fields)
  | ast.GetFieldExpr rec_expr _ _ -> find_prefix_pattern_in_expr(rec_expr)
  | ast.RecordUpdateExpr base fields _ -> find_prefix_pattern_in_expr(base) ++ find_prefix_pattern_in_record_fields(fields)
  | ast.IntRangeExpr lo hi _ ->
      find_prefix_pattern_in_expr(lo) ++ find_prefix_pattern_in_expr(hi)
  | ast.StringTemplateExpr parts _ -> find_prefix_pattern_in_template_parts(parts)
  | ast.ComprehensionExpr elem gens _ -> find_prefix_pattern_in_expr(elem) ++ find_prefix_pattern_in_comprehension_gens(gens)
  | _ -> Nil

fn find_prefix_pattern_in_comprehension_gens(gens: List ast.ComprehensionGen) -> List source.SourcePos =
  concat_map(find_prefix_pattern_in_comprehension_gen, gens)

fn find_prefix_pattern_in_comprehension_gen(g: ast.ComprehensionGen) -> List source.SourcePos =
  match g with
  | ast.ComprehensionGen pat src guards ->
      find_prefix_pattern_in_pattern(pat) ++ find_prefix_pattern_in_expr(src) ++ find_prefix_pattern_in_exprs(guards)

fn find_prefix_pattern_in_exprs(exprs: List ast.Expr) -> List source.SourcePos =
  concat_map(find_prefix_pattern_in_expr, exprs)

fn find_prefix_pattern_in_branches(branches: List ast.MatchBranch) -> List source.SourcePos =
  concat_map(find_prefix_pattern_in_branch, branches)

fn find_prefix_pattern_in_branch(b: ast.MatchBranch) -> List source.SourcePos =
  match b with
  | ast.MatchBranch pat body -> find_prefix_pattern_in_pattern(pat) ++ find_prefix_pattern_in_expr(body)

fn find_prefix_pattern_in_do_steps(steps: List ast.DoStep) -> List source.SourcePos =
  concat_map(find_prefix_pattern_in_do_step, steps)

fn find_prefix_pattern_in_do_step(s: ast.DoStep) -> List source.SourcePos =
  match s with
  | ast.DoBindStep pat value -> find_prefix_pattern_in_pattern(pat) ++ find_prefix_pattern_in_expr(value)
  | ast.DoLetStep _ value -> find_prefix_pattern_in_expr(value)
  | ast.DoExprStep value -> find_prefix_pattern_in_expr(value)

fn find_prefix_pattern_in_record_fields(fields: List ast.RecordField) -> List source.SourcePos =
  concat_map(\f -> match f with | ast.RecordField _ value -> find_prefix_pattern_in_expr(value), fields)

fn find_prefix_pattern_in_template_parts(parts: List ast.TemplateExprPart) -> List source.SourcePos =
  concat_map(find_prefix_pattern_in_template_part, parts)

fn find_prefix_pattern_in_template_part(p: ast.TemplateExprPart) -> List source.SourcePos =
  match p with
  | ast.LitPart _ -> Nil
  | ast.InterpPart e -> find_prefix_pattern_in_expr(e)

# ---------------------------------------------------------------------------
# Rule: multi-line-lambda-arg
#
# Flags a lambda passed as a call argument whose body is control flow — a
# `match`, an `if`, a `do`, or a `let .. in` (the same MatchExpr node, §5.1) —
# and runs past the line the lambda opens on. The call's own shape is then
# something the reader has to reassemble around a body that is not the call's
# subject; a named function with a signature says it once and reads at the
# call site as a name.
#
# Scoped to ARGUMENT position on purpose. A lambda bound in a `where` or a
# `let` already has the name this rule asks for.
#
# A body that merely wraps for width — a wide record literal or call — is not
# reported. That is a line-length question, and giving it a name buys nothing.
#
# `_` placeholders desugar to lambdas at parse time (§5.3), so they arrive here
# as LambdaExpr. They cannot trip the rule: a hole binds to its innermost
# enclosing CALL, so a synthesized lambda's body is that call, never control
# flow.

fn multi_line_lambda_message() -> String =
  "multi-line lambda argument — lift the body into a named fn and pass the name, closing over locals with a `_` placeholder (docs/idiomatic-sprout.md)"

# Control flow, as opposed to one expression wrapped for width.
fn is_block_body(e: ast.Expr) -> Bool =
  match e with
  | ast.MatchExpr _ _ _ -> true
  | ast.IfExpr _ _ _ _ -> true
  | ast.DoExpr _ _ -> true
  | _ -> false

fn larger(a: Int, b: Int) -> Int = if a > b then a else b

# The last line any node in the subtree starts on. Every Expr carries its own
# SourcePos, so this answers "does this body run past its opening line" without
# re-reading the source. Exhaustive by intent: a new Expr variant should fail
# the build here rather than silently under-report its extent.
fn max_line(e: ast.Expr) -> Int =
  match e with
  | ast.MatchExpr scrut branches pos ->
      larger(pos.line, larger(max_line(scrut), max_line_branches(branches)))
  | ast.IfExpr cond then_ else_ pos ->
      larger(pos.line, larger(max_line(cond), larger(max_line(then_), max_line(else_))))
  | ast.CallExpr callee args pos ->
      larger(pos.line, larger(max_line(callee), max_line_exprs(args)))
  | ast.TupleExpr elems pos -> larger(pos.line, max_line_exprs(elems))
  | ast.BinaryExpr _ left right pos ->
      larger(pos.line, larger(max_line(left), max_line(right)))
  | ast.UnaryExpr _ operand pos -> larger(pos.line, max_line(operand))
  | ast.LambdaExpr _ body pos -> larger(pos.line, max_line(body))
  | ast.DoExpr steps pos -> larger(pos.line, max_line_do_steps(steps))
  | ast.RecordExpr _ fields pos -> larger(pos.line, max_line_record_fields(fields))
  | ast.GetFieldExpr rec_expr _ pos -> larger(pos.line, max_line(rec_expr))
  | ast.RecordUpdateExpr base fields pos ->
      larger(pos.line, larger(max_line(base), max_line_record_fields(fields)))
  | ast.IntRangeExpr lo hi pos -> larger(pos.line, larger(max_line(lo), max_line(hi)))
  | ast.StringTemplateExpr parts pos -> larger(pos.line, max_line_template_parts(parts))
  | ast.ComprehensionExpr elem gens pos ->
      larger(pos.line, larger(max_line(elem), max_line_comprehension_gens(gens)))
  | ast.VarExpr _ pos -> pos.line
  | ast.IntExpr _ pos -> pos.line
  | ast.FloatExpr _ pos -> pos.line
  | ast.BoolExpr _ pos -> pos.line
  | ast.StringExpr _ pos -> pos.line
  | ast.CharExpr _ pos -> pos.line
  | ast.UnitExpr pos -> pos.line

fn max_line_exprs(exprs: List ast.Expr) -> Int =
  match exprs with
  | Nil -> 0
  | Cons e rest -> larger(max_line(e), max_line_exprs(rest))

fn max_line_branches(branches: List ast.MatchBranch) -> Int =
  match branches with
  | Nil -> 0
  | Cons b rest ->
      match b with
      | ast.MatchBranch _ body -> larger(max_line(body), max_line_branches(rest))

fn max_line_do_steps(steps: List ast.DoStep) -> Int =
  match steps with
  | Nil -> 0
  | Cons s rest -> larger(max_line_do_step(s), max_line_do_steps(rest))

fn max_line_do_step(s: ast.DoStep) -> Int =
  match s with
  | ast.DoBindStep _ value -> max_line(value)
  | ast.DoLetStep _ value -> max_line(value)
  | ast.DoExprStep value -> max_line(value)

fn max_line_record_fields(fields: List ast.RecordField) -> Int =
  match fields with
  | Nil -> 0
  | Cons f rest ->
      match f with
      | ast.RecordField _ value -> larger(max_line(value), max_line_record_fields(rest))

fn max_line_template_parts(parts: List ast.TemplateExprPart) -> Int =
  match parts with
  | Nil -> 0
  | Cons p rest -> larger(max_line_template_part(p), max_line_template_parts(rest))

fn max_line_template_part(p: ast.TemplateExprPart) -> Int =
  match p with
  | ast.LitPart _ -> 0
  | ast.InterpPart e -> max_line(e)

fn max_line_comprehension_gens(gens: List ast.ComprehensionGen) -> Int =
  match gens with
  | Nil -> 0
  | Cons g rest -> larger(max_line_comprehension_gen(g), max_line_comprehension_gens(rest))

fn max_line_comprehension_gen(g: ast.ComprehensionGen) -> Int =
  match g with
  | ast.ComprehensionGen _ src guards -> larger(max_line(src), max_line_exprs(guards))

# One finding per offending argument, so a call passing two multi-line lambdas
# reports both — each is a separate lift.
fn multi_line_lambda_findings(args: List ast.Expr) -> List LintFinding =
  match args with
  | Nil -> Nil
  | Cons a rest -> multi_line_lambda_finding(a) ++ multi_line_lambda_findings(rest)

fn multi_line_lambda_finding(arg: ast.Expr) -> List LintFinding =
  match arg with
  | ast.LambdaExpr _ body pos ->
      if is_block_body(body) && max_line(body) > pos.line
      then Cons(mk_finding(pos, "multi-line-lambda-arg", multi_line_lambda_message()), Nil)
      else Nil
  | _ -> Nil

# ---------------------------------------------------------------------------
# Program-level entry points

fn walk_instance_methods(methods: List ast.InstanceMethodImpl) -> List LintFinding =
  match methods with
  | Nil -> Nil
  | Cons m rest ->
      match m with
      | ast.InstanceMethodImpl _ _ _ _ body -> list_append(walk_expr(body), walk_instance_methods(rest))

fn walk_decl(d: ast.Decl) -> List LintFinding =
  match d with
  | ast.FnDecl _ _ _ _ _ body _ -> walk_expr(body)
  | ast.LetDecl _ body _ _ -> walk_expr(body)
  | ast.InstanceDecl _ _ methods _ -> walk_instance_methods(methods)
  | _ -> Nil  # ExternFnDecl/TypeDecl/RecordDecl/ClassDecl/AliasDecl/WrapDecl: no expr body

fn walk_decls(decls: List ast.Decl) -> List LintFinding =
  match decls with
  | Nil -> Nil
  | Cons d rest -> list_append(walk_decl(d), walk_decls(rest))

fn lint_program(prog: ast.Program) -> List LintFinding =
  match prog with
  | ast.Program decls _ -> list_append(walk_decls(decls), redundant_vec_wrap_findings(prog))

# `let <pat> = e else fb` is pure sugar (parser.sprout: build_let_binding_match)
# — it desugars to the SAME MatchExpr shape a hand-written nested match would,
# with no distinguishing AST node. So a MatchExpr's own position is the only
# way to tell them apart: a hand-written match's pos is the `match` keyword
# itself; a let-else's pos is wherever that binding's pattern starts (there is
# no `match` token in the source at all). Without this check, every already-
# idiomatic let-else chain gets told to become the thing it already is. Scoped
# to staircase-of-doom findings only — other rules' positions never point at
# a `match` keyword in the first place, so this check doesn't apply to them.
fn nth_line(lines: List String, target: Int, cur: Int) -> String =
  match lines with
  | Nil -> ""
  | Cons l rest -> if cur == target then l else nth_line(rest, target, cur + 1)

fn is_written_as_match(src: String, line: Int, col: Int) -> Bool =
  string.starts_with(str_slice(text, col - 1, str_len(text) - (col - 1)), "match")
  where text = nth_line(str_split_lines(src), line, 1)

fn drop_desugared_matches(src: String, findings: List LintFinding) -> List LintFinding =
  match findings with
  | Nil -> Nil
  | Cons f rest ->
      match f with
      | LintFinding ln col rule_id _ ->
          if rule_id == "staircase-of-doom" && ! is_written_as_match (src, ln, col)
          then drop_desugared_matches(src, rest)
          else Cons(f, drop_desugared_matches(src, rest))

# ---------------------------------------------------------------------------
# Rule: deprecated-brace-body
#
# `class C a { … }` / `instance C T { … }`. Both body forms parse — the brace
# form is kept so old sources still compile — so this rule is what makes the
# deprecated one visible. See docs/spec-v0.md §8.5 "Declaration syntax".
#
# Token-based, not AST-based: ClassDecl/InstanceDecl record the members, not
# which delimiter produced them, so the AST cannot tell the two forms apart.
# The token stream can, and lint_ast already has it in hand.

fn brace_tok_at(tokens: Vec token.Token, i: Int) -> token.Token =
  match vec_get(i, tokens) with
  | Just t -> t
  | Nothing -> token.eof_token(source.SourcePos(index = 0, line = 0, column = 0))

fn brace_is_keyword(t: token.Token, kw: String) -> Bool =
  match token.token_kind(t) with
  | token.TokenKeywordKind -> token.token_text(t) == kw
  | _ -> false

fn brace_is_symbol(t: token.Token, sym: String) -> Bool =
  match token.token_kind(t) with
  | token.TokenSymbolKind -> token.token_text(t) == sym
  | _ -> false

fn brace_is_decl_keyword(t: token.Token) -> Bool =
  match token.token_kind(t) with
  | token.TokenKeywordKind -> parser.is_decl_keyword(token.token_text(t))
  | _ -> false

# From just past a `class`/`instance` keyword, find the `{` that opens its body.
#
# Two things end the search without a finding: a declaration keyword (`fn` for
# the layout form's first member, or the next top-level declaration after an
# empty body) and end of input. `parser.is_decl_keyword` is the single source of
# truth for that set, so a new declaration form cannot silently widen the scan.
#
# The one `{` that must NOT be mistaken for a body is the one in an effect
# annotation — `instance Boxer (a !{IO})` puts one in the declaration head. The
# lexer emits `!` and `{` as separate symbol tokens, so the preceding token
# identifies it.
fn find_body_brace(tokens: Vec token.Token, i: Int, n: Int) -> Maybe source.SourcePos =
  if i >= n then Nothing
  else if brace_is_decl_keyword(brace_tok_at(tokens, i)) then Nothing
  else if brace_is_symbol(brace_tok_at(tokens, i), "{")
       && ! (brace_is_symbol(brace_tok_at(tokens, i - 1), "!")) then
    Just(token.token_position(brace_tok_at(tokens, i)))
  else find_body_brace(tokens, i + 1, n)

fn brace_body_scan(tokens: Vec token.Token, i: Int, n: Int, acc: List LintFinding) -> List LintFinding =
  if i >= n then list_reverse(acc)
  else if brace_is_keyword(brace_tok_at(tokens, i), "class")
       || brace_is_keyword(brace_tok_at(tokens, i), "instance") then
    match find_body_brace(tokens, i + 1, n) with
    | Nothing -> brace_body_scan(tokens, i + 1, n, acc)
    | Just pos ->
        brace_body_scan(tokens, i + 1, n,
          Cons(mk_finding(pos, "deprecated-brace-body",
            "brace-delimited class/instance body is deprecated — drop the braces and indent the members past the keyword"), acc))
  else brace_body_scan(tokens, i + 1, n, acc)

fn brace_body_findings(tokens: Vec token.Token) -> List LintFinding =
  brace_body_scan(tokens, 0, vec_length(tokens), Nil)

# lint_ast: run every AST-based rule over a source file. Parse failures yield
# no findings (formatter.lint_source's text-based checks already cover files
# that don't even parse; this rule set only has something to say once the
# file is syntactically valid).
# A file that does not lex or parse cannot have a single AST rule run against
# it. Reporting it as clean would make an unchecked file indistinguishable from
# a checked one, so the failure is itself a finding: it prints through the same
# path and the driver exits non-zero. `strip_headers` pads each header line it
# removes with a newline, so the position here is the position in the file.
fn unparsed_finding(pos: source.SourcePos, reason: String) -> LintFinding =
  mk_finding(pos, "unparsed", reason ++ " — no lint rule could be checked")

export fn lint_ast(src: String) -> List LintFinding =
  match lexer.tokenize(source.strip_headers(src)) with
  | Err (token.TokenizeError msg pos) -> [unparsed_finding(pos, msg)]
  | Ok toks ->
      match parser.parse_program(toks) with
      | Err (parser.ParseError msg pos) -> [unparsed_finding(pos, msg)]
      | Ok prog ->
          list_append(drop_desugared_matches(src, lint_program(prog)),
            list_append(list_shape_findings(src, prog),
              list_append(list_prefix_findings(src, prog), brace_body_findings(toks))))
