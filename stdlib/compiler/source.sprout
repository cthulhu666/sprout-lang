module stdlib.compiler.source
import stdlib.string as string

export type SourcePos (..) =
  | SourcePos Int Int Int

export type SourceCursor (..) =
  | SourceCursor String Int SourcePos

# FilePath is the path to a single source file (e.g. "main.sprout").
# StdlibRoot is the directory from which `stdlib.*` imports resolve.
# Distinct types so they can't be swapped at the (path, stdlib_root)
# call-site pattern threaded through every compiler entry point.

export wrap FilePath = String
export wrap StdlibRoot = String

export fn filepath_str(p: FilePath) -> String =
  match p with | FilePath s -> s

export fn stdlib_root_str(r: StdlibRoot) -> String =
  match r with | StdlibRoot s -> s

# ModuleName is a dotted module identifier (e.g. "stdlib.compiler.ast").
# RawName is a single unqualified identifier as written in source (e.g. "FnDecl").
# QualifiedName is the result of joining a ModuleName and a RawName with "."
# (e.g. "stdlib.compiler.ast.FnDecl"); env dicts are keyed by QualifiedName.
# Mixing the three is a dict-miss bug — wraps make the swap a compile error.

export wrap ModuleName = String
export wrap RawName = String
export wrap QualifiedName = String

export fn module_name_str(m: ModuleName) -> String =
  match m with | ModuleName s -> s

export fn raw_name_str(r: RawName) -> String =
  match r with | RawName s -> s

export fn qualified_name_str(q: QualifiedName) -> String =
  match q with | QualifiedName s -> s

export fn cursor_from_string(raw: String) -> SourceCursor =
  SourceCursor(raw, 0, SourcePos(0, 1, 1))

export fn source_position(cursor: SourceCursor) -> SourcePos =
  match cursor with
  | SourceCursor _ _ pos -> pos

export fn position_index(pos: SourcePos) -> Int =
  match pos with
  | SourcePos index _ _ -> index

export fn position_line(pos: SourcePos) -> Int =
  match pos with
  | SourcePos _ line _ -> line

export fn position_column(pos: SourcePos) -> Int =
  match pos with
  | SourcePos _ _ column -> column

fn cursor_source(cursor: SourceCursor) -> String =
  match cursor with
  | SourceCursor raw _ _ -> raw

# cursor_byte_offset: the SourceCursor's Int field is now a BYTE offset into the
# raw source string.  SourcePos.index still tracks the codepoint index for
# diagnostics (line/column info) — these two indices are intentionally separate.
export fn cursor_byte_offset(cursor: SourceCursor) -> Int =
  match cursor with
  | SourceCursor _ byte_offset _ -> byte_offset

# peek_char: O(1) — reads one UTF-8 codepoint from the byte position.
export fn peek_char(cursor: SourceCursor) -> Maybe Char =
  str_char_at_byte(cursor_source(cursor), cursor_byte_offset(cursor))

fn advance_position(pos: SourcePos, ch: Char) -> SourcePos =
  match pos with
  | SourcePos index line column ->
      if ch == '\n' || ch == '\r' then
        SourcePos(index + 1, line + 1, 1)
      else
        SourcePos(index + 1, line, column + 1)

# advance_char: O(1) — advances by the UTF-8 character width at the current byte offset.
export fn advance_char(cursor: SourceCursor) -> SourceCursor =
  match cursor with
  | SourceCursor raw byte_offset pos ->
      match str_char_at_byte(raw, byte_offset) with
      | Nothing -> cursor
      | Just ch ->
          SourceCursor(raw, byte_offset + str_char_width_at_byte(raw, byte_offset), advance_position(pos, ch))


fn advance_expected(cursor: SourceCursor, expected: String, index: Int, total: Int) -> SourceCursor =
  if index >= total then
    cursor
  else
    match string.char_at(expected, index) with
    | Just _ -> advance_expected(advance_char(cursor), expected, index + 1, total)
    | Nothing -> cursor

# match_string: O(|expected|) — uses str_starts_with_at_byte to avoid the
# old O(N) remaining_text allocation that caused O(N^2) behaviour in the lexer.
export fn match_string(expected: String, cursor: SourceCursor) -> Maybe SourceCursor =
  if str_starts_with_at_byte(cursor_source(cursor), cursor_byte_offset(cursor), expected) then
    Just(advance_expected(cursor, expected, 0, string.length(expected)))
  else
    Nothing
