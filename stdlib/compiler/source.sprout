module stdlib.compiler.source
import stdlib.string as string
# Load-bearing despite the alias never being written: `bytes_from_utf8` / `bytes_get` below are
# `extern fn`s owned by stdlib.bytes, and externs resolve by bare name only once their module is
# in the bundle (bundler.sprout:597 drops ExternFnDecl, so they are never module-qualified).
# Removing this import does not produce a scoping error — it produces a link failure.
import stdlib.bytes as bytes

# A position in a source file: the codepoint INDEX (0-based), and the LINE and
# COLUMN a human reads in an editor (both 1-based).
#
# A record rather than `SourcePos Int Int Int` because the fields are not
# interchangeable and were indistinguishable while anonymous: `SourcePos(0, 0, 0)`
# said nothing about which Int was which, and one field is 0-based while two are
# 1-based, so transposing any pair produced a plausible position pointing at the
# wrong character rather than an error.
#
# `index` is a CODEPOINT index, deliberately not a byte offset — `SourceCursor`
# below carries the byte offset in its own slot, and the two are intentionally
# separate (see `cursor_byte_offset`). That distinction had no way to be stated
# at a construction site before the field carried a name.
#
# Costs nothing over the ADT it replaced, and slightly less: a record allocates
# the identical boxed object (same tag, same arity — `ast_to_ir.build_ctor_table_acc`
# enters a record into the same ctor table as an ADT ctor) while field access
# skips the tag load, tag compare, and unreachable-arm branch that a
# single-constructor `match` still emits.
export type SourcePos = (index: Int, line: Int, column: Int)

# SourceCursor carries the raw source String (for byte slicing and prefix
# matching), its UTF-8 Bytes (for safe, bounds-checked codepoint decoding), the
# current BYTE offset, and the SourcePos (codepoint index + line/column for
# diagnostics).  The byte offset indexes both the String and the Bytes — they
# share byte positions since the Bytes are the String's UTF-8 encoding.
export type SourceCursor (..) =
  | SourceCursor String Bytes Int SourcePos

# FilePath is the path to a single source file (e.g. "main.sprout").
# StdlibRoot is the directory from which `stdlib.*` imports resolve.
# Distinct types so they can't be swapped at the (path, stdlib_root)
# call-site pattern threaded through every compiler entry point.

export wrap FilePath = String
export wrap StdlibRoot = String

export fn filepath_str(p: FilePath) -> String =
  match p with | FilePath s -> s

export fn stdlib_root_str(r: StdlibRoot) -> String =
  match r with | StdlibRoot s -> s

# ModuleName is a dotted module identifier (e.g. "stdlib.compiler.ast").
# RawName is a single unqualified identifier as written in source (e.g. "FnDecl").
# QualifiedName is the result of joining a ModuleName and a RawName with "."
# (e.g. "stdlib.compiler.ast.FnDecl"); env dicts are keyed by QualifiedName.
# Mixing the three is a dict-miss bug — wraps make the swap a compile error.

export wrap ModuleName = String
export wrap RawName = String
export wrap QualifiedName = String

export fn module_name_str(m: ModuleName) -> String =
  match m with | ModuleName s -> s

export fn raw_name_str(r: RawName) -> String =
  match r with | RawName s -> s

export fn qualified_name_str(q: QualifiedName) -> String =
  match q with | QualifiedName s -> s

# GlobalName is the name of a top-level `let` global (an IR store target, @name).
# Distinguishes it from function names, ctor names, and arbitrary strings so a
# swap is a compile error rather than a silent wrong-slot store.
export wrap GlobalName = String

export fn global_name_str(g: GlobalName) -> String =
  match g with | GlobalName s -> s

export fn cursor_from_string(raw: String) -> SourceCursor =
  SourceCursor(raw, bytes_from_utf8(raw), 0, SourcePos(index = 0, line = 1, column = 1))

export fn source_position(cursor: SourceCursor) -> SourcePos =
  match cursor with
  | SourceCursor _ _ _ pos -> pos

# No position_index / position_line / position_column accessors: read the fields
# directly (`pos.index`, `pos.line`, `pos.column`). They existed to name the slots
# of a positional ADT, which the record's field labels now do at the declaration.
# A wrapper that only forwards to a same-named field is one more name to keep in
# sync for no added meaning.

fn cursor_source(cursor: SourceCursor) -> String =
  match cursor with
  | SourceCursor raw _ _ _ -> raw

fn cursor_bytes(cursor: SourceCursor) -> Bytes =
  match cursor with
  | SourceCursor _ bytes _ _ -> bytes

# cursor_byte_offset: the current BYTE offset into the raw source.  SourcePos.index
# still tracks the codepoint index for diagnostics — these two are intentionally
# separate.
export fn cursor_byte_offset(cursor: SourceCursor) -> Int =
  match cursor with
  | SourceCursor _ _ byte_offset _ -> byte_offset

# ── Safe UTF-8 decode over Bytes ─────────────────────────────────────────────
# Every byte read goes through bytes_get, which is bounds-checked (Nothing past
# the end), so no offset — however large or fabricated — can read out of bounds.

fn is_cont(byte: Int) -> Bool =
  byte >= 128 && byte < 192

# decode_codepoint_at: total UTF-8 decode at a byte offset.  Returns the raw
# Unicode codepoint as an Int plus the next byte offset, or Nothing at
# end-of-input, out-of-range, truncated, or invalid input.  Codepoint assembly is
# plain arithmetic (no bitwise ops needed): the low bits of a lead byte are
# (byte - range_base), and each continuation contributes 6 bits == one base-64
# digit.  Representation-stable: this is pure byte arithmetic, independent of how
# Char is represented at runtime, so the parser can use it to record char-literal
# codepoints in the AST without depending on the Char representation.
export fn decode_codepoint_at(b: Bytes, i: Int) -> Maybe (Int, Int) =
  match bytes_get(b, i) with
  | Nothing -> Nothing
  | Just b0 ->
      if b0 < 128 then Just((b0, i + 1))
      else if b0 < 192 then Nothing
      else if b0 < 224 then decode2(b, i, b0)
      else if b0 < 240 then decode3(b, i, b0)
      else if b0 < 248 then decode4(b, i, b0)
      else Nothing

fn decode2(b: Bytes, i: Int, b0: Int) -> Maybe (Int, Int) =
  match bytes_get(b, i + 1) with
  | Nothing -> Nothing
  | Just b1 ->
      if is_cont(b1) then
        Just(((b0 - 192) * 64 + (b1 - 128), i + 2))
      else Nothing

fn decode3(b: Bytes, i: Int, b0: Int) -> Maybe (Int, Int) =
  match bytes_get(b, i + 1) with
  | Nothing -> Nothing
  | Just b1 ->
      match bytes_get(b, i + 2) with
      | Nothing -> Nothing
      | Just b2 ->
          if is_cont(b1) && is_cont(b2) then
            Just(((b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128), i + 3))
          else Nothing

fn decode4(b: Bytes, i: Int, b0: Int) -> Maybe (Int, Int) =
  let Just b1 = bytes_get(b, i + 1) else Nothing
      Just b2 = bytes_get(b, i + 2) else Nothing
      Just b3 = bytes_get(b, i + 3) else Nothing
  in
    if is_cont(b1) && is_cont(b2) && is_cont(b3) then
      Just(((b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128), i + 4))
    else Nothing

# decode_char_at: total UTF-8 decode at a byte offset.  Returns the codepoint as
# a Char plus the next byte offset.  Thin wrapper over decode_codepoint_at.
export fn decode_char_at(b: Bytes, i: Int) -> Maybe (Char, Int) =
  match decode_codepoint_at(b, i) with
  | Nothing -> Nothing
  | Just (cp, next) -> Just((char_from_codepoint(cp), next))

# first_codepoint: the Unicode codepoint of the first character of s, or Nothing
# if s is empty.  Representation-stable; the parser uses this to store char-literal
# codepoints in the AST without going through str_char_at (whose result type flips
# with the Char representation).
export fn first_codepoint(s: String) -> Maybe Int =
  match decode_codepoint_at(bytes_from_utf8(s), 0) with
  | Nothing -> Nothing
  | Just (cp, _) -> Just(cp)

# ── The synthetic module name for a headerless entry file ────────────────────
#
# A file with no `module` header still needs a namespace of its own, or its
# declarations share the prelude's and collide (docs/prelude-scope-v0.md §4.1).
# `bundler.name_entry_module` assigns this name; it lives HERE so the string has
# one authority shared with the strip below and with the runtime's
# `SPROUT_ENTRY_PREFIX`.
#
# `$` makes it unforgeable — Sprout identifiers are `[A-Za-z_][A-Za-z0-9_]*`
# (`string.is_ident_start`), so no source file can declare a module that collides
# with it — while LLVM's identifier charset accepts `$` unmangled.
export let entry_module_name: String = "$entry"

export let entry_module_prefix: String = "$entry."

# Remove the synthetic prefix from text about to be shown to a user.
#
# Applied at the RENDER boundary — where compiler-internal message text becomes
# user-facing output — rather than at each site that builds a message. Those
# sites are unbounded and grow with every new diagnostic: a name appears in
# `is defined more than once`, in `unknown type X in Y`, in `in function Y`, in
# an exhaustiveness list, in a type printed by a mismatch. A boundary strip is
# closed under adding new ones; a per-site strip has to be re-remembered forever.
#
# A whole-message REPLACE, not a prefix strip: names sit mid-message inside
# backticks, and one message can carry several (an exhaustiveness list names
# every missing constructor). Idempotent, so layering it at more than one
# boundary is harmless.
#
# Deliberately NOT applied to `--phase qualify`'s debug dump: a debug surface
# should show the real qualified names, which is the whole reason to look at it.
export fn strip_entry_names(msg: String) -> String =
  string.replace_all(entry_module_prefix, "", msg)

# The display name of a constructor: the name the user wrote, with the bundler's
# module qualification dropped. `main.Apple` -> `Apple`, `$entry.Box` -> `Box`,
# and a prelude ctor (bundled under the empty module name) is already bare, so
# `Just` -> `Just`.
#
# EXACT, not a heuristic: `bundler.qualified_name` builds `<module> ++ "." ++
# <ctor>` and a ctor name is an identifier, so it can never contain a dot itself.
# The last segment is therefore the source-form name, recovered losslessly.
#
# ── This is NOT a variant of strip_entry_names, and the two must not merge ──
# They differ in what they are applied TO, which is what makes them look alike
# and behave differently:
#
#   strip_entry_names  takes a whole MESSAGE and removes one unspeakable prefix.
#                      Real module prefixes survive on purpose — a diagnostic
#                      reading "in demo.f" tells the reader which module.
#   display_ctor_name  takes a single NAME and keeps only its last segment.
#
# Apply this one to a message and it shreds every qualified name in it, keeping
# only the text after the final dot in the whole string. Both directions are
# pinned by tests/stdlib/compiler/test_ctor_display.spr.
#
# The runtime has the same rule in C for values it renders itself
# (`display_ctor_name`, sprout_runtime.c); this copy exists for the one place the
# name becomes a string LITERAL in generated code (deriving.sprout).
export fn display_ctor_name(name: String) -> String =
  string.after_last_dot(name)

# ── Header stripping ─────────────────────────────────────────────────────────
#
# strip_headers removes the leading block of `module` / `import` / comment /
# blank lines before the source is tokenized (the tokenizer + parser do not
# accept module/import declarations). It REPLACES each stripped line with a
# blank line so every retained line keeps its ORIGINAL line number — a plain
# deletion shifted all reported diagnostic positions up by the stripped count.
# Single authority shared by every compile entry point (bundler, LSP, analysis,
# drivers) so their diagnostics agree.
# An import's parenthesised name list may span lines, so a header line is not
# always recognisable on its own: the continuation of a wrapped list looks like
# ordinary code. Stripping therefore carries the open-parenthesis depth and keeps
# consuming while it is positive.
export fn strip_headers(s: String) -> String =
  strip_headers_go(s, bytes_from_utf8(s), 0, 0, 0)

fn is_header_line_byte(s: String, pos: Int) -> Bool =
  str_starts_with_at_byte(s, pos, "module ") ||
  str_starts_with_at_byte(s, pos, "import ") ||
  str_starts_with_at_byte(s, pos, "#") ||
  str_starts_with_at_byte(s, pos, "\n") ||
  is_no_prelude_line_byte(s, pos)

# ── The `no_prelude` opt-out ─────────────────────────────────────────────────
#
# A header line that suppresses the prelude for this file
# (docs/prelude-scope-v0.md §4.2 step 5). Because the directive is a HEADER line
# it is stripped before `tokenize` runs, so it needs no grammar and no parser
# change — which is also why it must be recognised by `is_header_line_byte`
# above, or the stripper would leave it for the parser as a bare identifier.
#
# The WHOLE line must be the directive: `no_prelude_thing` is an ordinary
# identifier and must not be mistaken for it. Rust's `#![no_implicit_prelude]`
# could not be borrowed literally — `#` opens a comment in Sprout, so the
# directive would be invisible.
export let no_prelude_directive: String = "no_prelude"

fn is_no_prelude_line_byte(s: String, pos: Int) -> Bool =
  str_starts_with_at_byte(s, pos, no_prelude_directive) &&
    is_line_end_at_byte(s, pos + str_byte_len(no_prelude_directive))

fn is_line_end_at_byte(s: String, pos: Int) -> Bool =
  pos >= str_byte_len(s) ||
    str_starts_with_at_byte(s, pos, "\n") ||
    str_starts_with_at_byte(s, pos, "\r")

# Does this source opt out of the prelude?
#
# Scans only the LEADING header block, stopping at the first line that is not a
# header — the same boundary `strip_headers` uses, and for the same reason: a
# whole-file scan (as `scan_module_name` does) could find the word inside a
# multi-line string literal and suppress the prelude for text the parser still
# sees as code.
export fn has_no_prelude(s: String) -> Bool =
  has_no_prelude_go(s, bytes_from_utf8(s), 0, 0)

fn has_no_prelude_go(s: String, bytes: Bytes, pos: Int, depth: Int) -> Bool =
  if pos >= str_byte_len(s) then false
  else if depth == 0 && is_no_prelude_line_byte(s, pos) then true
  # Mirrors strip_headers_go: `depth > 0` means an import's parenthesised list is
  # still open, so this line is a continuation whatever it looks like.
  else if depth > 0 || is_header_line_byte(s, pos) then
    has_no_prelude_go(s, bytes, eol, floor_zero(depth + paren_delta_bytes(bytes, pos, eol, 0)))
  else false
  where eol = next_line_byte(bytes, pos)

# Net parenthesis depth contributed by the bytes in [i, limit).
#
# THE SINGLE AUTHORITY on where a wrapped import ends. `module_loader` decides
# the same question when it joins the lines of one import, and the two must not
# drift: if stripping consumed a different number of lines than collection read,
# a file would either lose imports or hand the parser a fragment.
#
# Scanning stops at `#` so a trailing comment cannot miscount — `import x (a, b) # (`
# is balanced. An import header contains no string literals, so no quoting rule
# is needed here.
fn paren_delta_bytes(b: Bytes, i: Int, limit: Int, depth: Int) -> Int =
  if i >= limit then depth
  else
    match decode_char_at(b, i) with
    | Nothing -> depth
    | Just (ch, next) ->
        if ch == '#' then depth
        else if ch == '(' then paren_delta_bytes(b, next, limit, depth + 1)
        else if ch == ')' then paren_delta_bytes(b, next, limit, depth - 1)
        else paren_delta_bytes(b, next, limit, depth)

# The String entry point to the same scan, for callers that already hold a line.
export fn line_paren_delta(line: String) -> Int =
  paren_delta_bytes(b, 0, str_byte_len(line), 0)
  where b = bytes_from_utf8(line)

# A line with any comment removed, applying the SAME `#` rule the scan above uses
# to stop counting.
#
# The pair matters. `line_paren_delta` already looks past a comment, so a caller
# that keeps the commented text while trusting that depth ends up with a string
# the depth says is an import list and whose tail is in fact a comment. That is
# how a comment inside a wrapped list came to swallow every name after it: the
# lines were spliced verbatim, and the name scan stopped at the `#`.
#
# `str_slice`'s third argument is a LENGTH, not an end index — equal here only
# because the slice starts at 0.
export fn strip_line_comment(line: String) -> String =
  if i < 0 then line else str_slice(line, 0, i)
  where i = str_find(line, "#")

# Byte index just past the next '\n' from byte offset i (or end of input).
fn next_line_byte(b: Bytes, i: Int) -> Int =
  match decode_char_at(b, i) with
  | Nothing -> i
  | Just (ch, next) -> if ch == '\n' then next else next_line_byte(b, next)

# Count codepoints in bytes [0, limit) — converts a byte offset to a str_slice
# codepoint index.
fn byte_to_cp(b: Bytes, i: Int, cp: Int, limit: Int) -> Int =
  if i >= limit then cp
  else
    match decode_char_at(b, i) with
    | Nothing -> cp
    | Just (_, next) -> byte_to_cp(b, next, cp + 1, limit)

# `depth > 0` means the previous line left an import's list open, so this line is
# a continuation and is consumed whatever it looks like. Depth is floored at zero
# so a stray `)` cannot drive it negative and silently disable the check.
fn strip_headers_go(s: String, bytes: Bytes, pos: Int, stripped: Int, depth: Int) -> String =
  if pos >= str_byte_len(s) then string.repeat("\n", stripped)
  else if depth > 0 || is_header_line_byte(s, pos) then
    strip_headers_go(s, bytes, eol, stripped + 1, floor_zero(depth + paren_delta_bytes(bytes, pos, eol, 0)))
  else str_concat(string.repeat("\n", stripped), str_slice(s, cp, str_len(s) - cp))
  where cp = byte_to_cp(bytes, 0, 0, pos)
        eol = next_line_byte(bytes, pos)

fn floor_zero(n: Int) -> Int = if n < 0 then 0 else n

# ── Cursor scanning ──────────────────────────────────────────────────────────

# peek: the codepoint at the cursor, or Nothing at end. O(1).
export fn peek(cursor: SourceCursor) -> Maybe Char =
  match decode_char_at(cursor_bytes(cursor), cursor_byte_offset(cursor)) with
  | Nothing -> Nothing
  | Just (ch, _) -> Just(ch)

fn advance_position(pos: SourcePos, ch: Char) -> SourcePos =
  if ch == '\n' || ch == '\r' then
    SourcePos(index = pos.index + 1, line = pos.line + 1, column = 1)
  else
    SourcePos(index = pos.index + 1, line = pos.line, column = pos.column + 1)

# next: consume one codepoint — returns the char and the advanced cursor, or
# Nothing at end.  Total: end-of-input is a value the caller must handle, so a
# scan can't silently spin past the end the way a cursor->cursor advance could.
export fn next(cursor: SourceCursor) -> Maybe (Char, SourceCursor) =
  match cursor with
  | SourceCursor raw bytes byte_offset pos ->
      match decode_char_at(bytes, byte_offset) with
      | Nothing -> Nothing
      | Just (ch, next_off) ->
          Just((ch, SourceCursor(raw, bytes, next_off, advance_position(pos, ch))))

# take_while: advance past every codepoint satisfying pred; returns the advanced
# cursor.  Text extraction is slice-based and the caller's job (record the start
# cursor, then slice between byte offsets) — O(run), no per-char concatenation.
export fn take_while(cursor: SourceCursor, pred: Char -> Bool) -> SourceCursor =
  match next(cursor) with
  | Nothing -> cursor
  | Just (ch, c2) -> if pred(ch) then take_while(c2, pred) else cursor

# advance_one: advance past one codepoint (no-op at end).  Internal helper for
# match_string's character-by-character walk over a known-present prefix.
fn advance_one(cursor: SourceCursor) -> SourceCursor =
  match next(cursor) with
  | Nothing -> cursor
  | Just (_, c2) -> c2

fn advance_expected(cursor: SourceCursor, expected: String, index: Int, total: Int) -> SourceCursor =
  if index >= total then
    cursor
  else
    match string.char_at(expected, index) with
    | Just _ -> advance_expected(advance_one(cursor), expected, index + 1, total)
    | Nothing -> cursor

# match_string: O(|expected|) — uses the safe, bounds-checked str_starts_with_at_byte
# to avoid the old O(N) remaining_text allocation that caused O(N^2) lexing.
export fn match_string(expected: String, cursor: SourceCursor) -> Maybe SourceCursor =
  if str_starts_with_at_byte(cursor_source(cursor), cursor_byte_offset(cursor), expected) then
    Just(advance_expected(cursor, expected, 0, string.length(expected)))
  else
    Nothing
