module stdlib.compiler.token
import stdlib.compiler.source as source

export type TokenKind (..) =
  | TokenIdentKind
  | TokenKeywordKind
  | TokenIntKind
  | TokenFloatKind
  | TokenCharKind
  | TokenStringKind
  | TokenSymbolKind
  | TokenEofKind
  | TokenTemplateStart
  | TokenTemplateLit
  | TokenTemplateInterpStart
  | TokenTemplateInterpEnd
  | TokenTemplateEnd
  # Virtual block tokens from the layout pass; the lexer never emits them.
  | TokenLayoutOpen
  | TokenLayoutSep
  | TokenLayoutClose

export type Token (..) =
  | Token TokenKind String source.SourcePos

export type TokenizeError (..) =
  | TokenizeError String source.SourcePos

export fn token_kind(token: Token) -> TokenKind =
  match token with
  | Token kind _ _ -> kind

export fn token_text(token: Token) -> String =
  match token with
  | Token _ text _ -> text

export fn token_position(token: Token) -> source.SourcePos =
  match token with
  | Token _ _ position -> position

export fn error_message(value: TokenizeError) -> String =
  match value with
  | TokenizeError message _ -> message

# The keywords that begin a top-level declaration. The parser and the layout
# pass both read this list, so they cannot drift.
export fn is_decl_keyword(text: String) -> Bool =
  text == "extern"
  || text == "fn"
  || text == "let"
  || text == "class"
  || text == "instance"
  || text == "type"
  || text == "wrap"

export fn eof_token(position: source.SourcePos) -> Token =
  Token(TokenEofKind, "", position)

export fn is_eof_token(token: Token) -> Bool =
  match token_kind(token) with
  | TokenEofKind -> true
  | _ -> false
