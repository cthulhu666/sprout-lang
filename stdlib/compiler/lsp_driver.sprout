module stdlib.compiler.lsp_driver

import stdlib.json as json
import stdlib.compiler.compiler as compiler
import stdlib.compiler.source as source
import stdlib.compiler.module_loader as module_loader
import stdlib.compiler.bundler as bundler
import stdlib.string as string
import stdlib.fs as fs
import stdlib.terminal as terminal

extern fn stdin_read_bytes(n: Int) -> Maybe String !{IO}

# ---------------------------------------------------------------------------
# LspState

type LspState = LspState String (List String) (Ref (Dict String)) (Ref Bool) bundler.LoadEnv
  # stdlib_root, package_roots, open_documents (uri -> source), shutdown_requested,
  # load_env (parsed-module + prelude-scheme memo, held for the whole session)

fn lsp_stdlib_root(state: LspState) -> String =
  match state with | LspState r _ _ _ _ -> r

# Package roots for dotted non-stdlib imports. Without them a multi-root project gets no
# import error and then `Unknown variable` for every name from those modules — the whole
# project underlined in the editor.
fn lsp_package_roots(state: LspState) -> List String =
  match state with | LspState _ p _ _ _ -> p

fn lsp_documents(state: LspState) -> Ref (Dict String) =
  match state with | LspState _ _ d _ _ -> d

fn lsp_shutdown_flag(state: LspState) -> Ref Bool =
  match state with | LspState _ _ _ s _ -> s

# One memo for the session. A check re-parses the edited buffer and reuses every import,
# which is what makes typechecking the way the batch compiler does affordable per
# keystroke: without it the prelude alone is re-read, re-parsed and re-typechecked on
# every diagnostic and every hover.
fn lsp_load_env(state: LspState) -> bundler.LoadEnv =
  match state with | LspState _ _ _ _ e -> e

fn build_lsp_state(stdlib_root: String, package_roots: List String) -> LspState !{IO} =
  do
    docs <- ref_new(dict_empty())
    shutdown <- ref_new(false)
    load_env <- bundler.new_load_env()
    LspState(stdlib_root, package_roots, docs, shutdown, load_env)

# ---------------------------------------------------------------------------
# LSP framing
#
# Write: compose "Content-Length: N\r\n\r\n<body>" via term_write (fflushes).
# Read headers: term_read_line_once (strips \r\n).
# Read body: stdin_read_bytes(n) — BYTES, matching the byte count the header declares
# and the byte count `lsp_send` writes. Reading the body as a line would desync on any
# document containing a multi-byte character, because Content-Length counts bytes.

fn lsp_send(body: String) -> Unit !{IO} =
  terminal.write("Content-Length: " ++ int_to_string(string.byte_length(body)) ++ "\r\n\r\n" ++ body)

# W8/P1: parse_int is total (Maybe Int); a malformed header yields Nothing
# instead of Just(0).
export fn parse_content_length(line: String) -> Maybe Int =
  and_then(parse_int, string.strip_prefix(line, "Content-Length: "))

fn read_headers_loop(cl: Maybe Int) -> Maybe Int !{IO} =
  match terminal.term_read_line_once() with
  | Nothing -> Nothing
  | Just line ->
      if string.is_empty(line) then cl
      else
        match parse_content_length(line) with
        | Just n -> read_headers_loop(Just(n))
        | Nothing -> read_headers_loop(cl)

fn read_lsp_message() -> Maybe String !{IO} =
  match read_headers_loop(Nothing) with
  | Nothing -> Nothing
  | Just n -> stdin_read_bytes(n)

# ---------------------------------------------------------------------------
# JSON-RPC 2.0 helpers

fn make_result(id: json.Json, result: json.Json) -> json.Json =
  json.JsonObject(
    json.JsonObjectCons("jsonrpc", json.JsonString("2.0"),
    json.JsonObjectCons("id", id,
    json.JsonObjectCons("result", result,
    json.JsonObjectNil))))

fn make_error(id: json.Json, code: Int, msg: String) -> json.Json =
  json.JsonObject(
    json.JsonObjectCons("jsonrpc", json.JsonString("2.0"),
    json.JsonObjectCons("id", id,
    json.JsonObjectCons("error",
      json.JsonObject(
        json.JsonObjectCons("code", json.JsonInt(code),
        json.JsonObjectCons("message", json.JsonString(msg),
        json.JsonObjectNil))),
    json.JsonObjectNil))))

fn make_notification(method: String, params: json.Json) -> json.Json =
  json.JsonObject(
    json.JsonObjectCons("jsonrpc", json.JsonString("2.0"),
    json.JsonObjectCons("method", json.JsonString(method),
    json.JsonObjectCons("params", params,
    json.JsonObjectNil))))

fn get_id(req: json.Json) -> json.Json =
  match json.json_get_field(req, "id") with
  | Just id -> id
  | Nothing -> json.JsonNull

fn get_method(req: json.Json) -> Maybe String =
  match json.json_get_field(req, "method") with
  | Nothing -> Nothing
  | Just v -> json.json_get_string(v)

fn get_params(req: json.Json) -> json.Json =
  match json.json_get_field(req, "params") with
  | Just p -> p
  | Nothing -> json.JsonNull

fn json_get_str(obj: json.Json, key: String) -> Maybe String =
  and_then(json.json_get_string, json.json_get_field(obj, key))

fn json_get_int_fld(obj: json.Json, key: String) -> Maybe Int =
  and_then(json.json_get_int, json.json_get_field(obj, key))

# Every message this driver builds is made of strings, ints and bools, so `stringify` cannot
# refuse one. The fallback still sends well-formed JSON-RPC rather than nothing: dropping a
# response leaves the client blocked on a reply that never arrives.
# A fixed literal, not the error text: this string is hand-built JSON, so interpolating anything
# into it would rest on that text never containing a quote or a backslash.
fn unencodable_notice() -> String =
  "{\"jsonrpc\":\"2.0\",\"method\":\"window/logMessage\",\"params\":{\"type\":1,\"message\":\"lsp: response held a value that cannot be encoded as JSON\"}}"

fn send_message(msg: json.Json) -> Unit !{IO} =
  match json.stringify(msg) with
  | Ok text -> lsp_send(text)
  | Err _ -> lsp_send(unencodable_notice())

# ---------------------------------------------------------------------------
# Diagnostics — public compiler.Diagnostic has (message, line, col)

fn diag_range(line: Int, col: Int) -> json.Json =
  json.JsonObject(
    json.JsonObjectCons("start",
      json.JsonObject(
        json.JsonObjectCons("line", json.JsonInt(line),
        json.JsonObjectCons("character", json.JsonInt(col),
        json.JsonObjectNil))),
    json.JsonObjectCons("end",
      json.JsonObject(
        json.JsonObjectCons("line", json.JsonInt(line),
        json.JsonObjectCons("character", json.JsonInt(col),
        json.JsonObjectNil))),
    json.JsonObjectNil)))

fn diag_severity(d: compiler.Diagnostic) -> Int =
  match d with
  | compiler.DiagError _ _ -> 1
  | compiler.DiagWarning _ _ -> 2

fn diag_to_lsp(d: compiler.Diagnostic) -> json.Json =
  match d with
  # LSP positions are 0-based; SourcePos line/column are 1-based.
  | compiler.DiagError pos msg ->
      json.JsonObject(
        json.JsonObjectCons("range", diag_range(pos.line - 1, pos.column - 1),
        json.JsonObjectCons("severity", json.JsonInt(1),
        json.JsonObjectCons("message", json.JsonString(msg),
        json.JsonObjectNil))))
  | compiler.DiagWarning pos msg ->
      json.JsonObject(
        json.JsonObjectCons("range", diag_range(pos.line - 1, pos.column - 1),
        json.JsonObjectCons("severity", json.JsonInt(2),
        json.JsonObjectCons("message", json.JsonString(msg),
        json.JsonObjectNil))))

fn push_diagnostics(uri: String, diags: List compiler.Diagnostic, state: LspState) -> Unit !{IO} =
  send_message(make_notification("textDocument/publishDiagnostics",
    json.JsonObject(
      json.JsonObjectCons("uri", json.JsonString(uri),
      json.JsonObjectCons("diagnostics",
        json.array_from_list(list_map(diag_to_lsp, diags)),
      json.JsonObjectNil)))))

fn check_and_push_diagnostics(uri: String, src: String, state: LspState) -> Unit !{IO} =
  do
    result <- compiler.compile_source_at_with_cache_roots(
      src, path_for_uri(uri), source.StdlibRoot(lsp_stdlib_root(state)),
      lsp_package_roots(state), lsp_load_env(state))
    match result with
    | compiler.CompileOk _ -> push_diagnostics(uri, Nil, state)
    | compiler.CompileFail diags -> push_diagnostics(uri, diags, state)

# ---------------------------------------------------------------------------
# Hover — word extraction + type_of_expr_in_source

fn is_hover_ident_ch(ch: Char) -> Bool =
  string.is_ident_continue(ch) || ch == '.'

fn is_dot_at(line: String, i: Int) -> Bool =
  match string.char_at(line, i) with
  | Nothing -> false
  | Just ch -> ch == '.'

# A dot that belongs to a `..`, i.e. the range operator rather than a qualified
# name or a field path. The lexer stops an identifier run there
# (lexer.sprout scan_ident_end), so hover must too: without this, hovering
# either endpoint of `lo..hi` extracts the whole `lo..hi` and resolves nothing.
# A lone dot still joins, so `string.trim` and `p.x` stay single hover words.
fn is_range_dot(line: String, i: Int) -> Bool =
  is_dot_at(line, i) && (is_dot_at(line, i - 1) || is_dot_at(line, i + 1))

# True when the character at [i] continues the hover word. Off the end of the
# line it is false, which stops both scans at the boundary.
fn hover_word_continues(line: String, i: Int) -> Bool =
  match string.char_at(line, i) with
  | Nothing -> false
  | Just ch -> if is_range_dot(line, i) then false else is_hover_ident_ch(ch)

fn word_start(line: String, col: Int) -> Int =
  if col <= 0 then 0
  else if hover_word_continues(line, col - 1) then word_start(line, col - 1)
  else col

fn word_end_loop(line: String, col: Int, total: Int) -> Int =
  if col >= total then total
  else if hover_word_continues(line, col) then word_end_loop(line, col + 1, total)
  else col

fn extract_word_impl(line: String, col: Int, len: Int) -> String =
  string.slice(line, wstart, word_end_loop(line, col, len) - wstart)
  where wstart = word_start(line, col)

export fn extract_word(line: String, col: Int) -> String =
  if col >= len then ""
  else
    match string.char_at(line, col) with
    | Nothing -> ""
    | Just ch ->
        if is_hover_ident_ch(ch) then extract_word_impl(line, col, len)
        else ""
  where len = string.length(line)

fn make_hover_result(id: json.Json, type_str: String) -> json.Json =
  make_result(id,
    json.JsonObject(
      json.JsonObjectCons("contents",
        json.JsonObject(
          json.JsonObjectCons("kind", json.JsonString("plaintext"),
          json.JsonObjectCons("value", json.JsonString(type_str),
          json.JsonObjectNil))),
      json.JsonObjectNil)))

# Hover types the word under the cursor by asking for its type IN THIS SOURCE, so a
# name means what it means here — including names from package-root modules.
#
# Deliberately NOT `compiler.type_of_in_source`, despite the name: that one is a builtin
# that talks to a co-process launched as `sproutd --analysis-service <stdlib_root>`, a
# command line with no package roots. Hover through it would fail on exactly the projects
# whose diagnostics work, so the in-process, roots-aware call is used instead.
#
# A failure answers null. There is nothing useful to say to an editor about an
# expression whose type could not be determined, and the type checker is already
# reporting the reason as a diagnostic on the same document.
fn do_hover(id: json.Json, src: String, word: String, state: LspState) -> Unit !{IO} =
  do
    match compiler.type_of_expr_in_source(src, word,
        source.StdlibRoot(lsp_stdlib_root(state)), lsp_package_roots(state), lsp_load_env(state)) with
    | Nothing -> send_message(make_result(id, json.JsonNull))
    | Just type_str -> send_message(make_hover_result(id, type_str))

export type HoverParams (..) deriving (Eq, ToString) = HoverParams String Int Int

export fn extract_hover_params(params: json.Json) -> Maybe HoverParams =
  let Just td = json.json_get_field(params, "textDocument") else Nothing
      Just uri = json_get_str(td, "uri") else Nothing
      Just pos = json.json_get_field(params, "position") else Nothing
      Just line_num = json_get_int_fld(pos, "line") else Nothing
      Just char_num = json_get_int_fld(pos, "character") else Nothing
  in Just(HoverParams(uri, line_num, char_num))

# ---------------------------------------------------------------------------
# Initialize capabilities
#
# Advertise only what answers. `hoverProvider` and `completionProvider` were both listed
# here while `do_hover` returned null unconditionally and completion returned an empty
# list — which gives an editor a broken feature rather than an absent one. Hover is wired
# now, so it is advertised again; completion is not, so it stays absent until it is.
# scripts/lsp_smoke.sh asserts the implication, so an advertisement without an answer
# fails the gate.

fn server_capabilities() -> json.Json =
  json.JsonObject(
    json.JsonObjectCons("textDocumentSync", json.JsonInt(1),
    json.JsonObjectCons("definitionProvider", json.JsonBool(true),
    json.JsonObjectCons("hoverProvider", json.JsonBool(true),
    json.JsonObjectNil))))

fn initialize_result() -> json.Json =
  json.JsonObject(
    json.JsonObjectCons("capabilities", server_capabilities(),
    json.JsonObjectCons("serverInfo",
      json.JsonObject(
        json.JsonObjectCons("name", json.JsonString("sproutd"),
        json.JsonObjectCons("version", json.JsonString("0.1.0"),
        json.JsonObjectNil))),
    json.JsonObjectNil)))

# ---------------------------------------------------------------------------
# Request / notification handlers

# Say hello, in the one channel a client is guaranteed to surface.
#
# Motivated by a real debugging session: go-to-definition "did not work", and answering
# whether the server was even RUNNING took a process listing, because nothing the server
# did reached the IDE's log. A `window/logMessage` is the standard way for a server to be
# visible there — every other language server in the IDE shows up this way — and it
# reports the roots it was actually given, which is the other thing that is easy to get
# wrong and impossible to see from outside.
fn log_message(text: String) -> Unit !{IO} =
  send_message(
    json.JsonObject(
      json.JsonObjectCons("jsonrpc", json.JsonString("2.0"),
      json.JsonObjectCons("method", json.JsonString("window/logMessage"),
      json.JsonObjectCons("params",
        json.JsonObject(
          json.JsonObjectCons("type", json.JsonInt(3),
          json.JsonObjectCons("message", json.JsonString(text),
          json.JsonObjectNil))),
      json.JsonObjectNil)))))

fn roots_summary(roots: List String) -> String =
  match roots with
  | Nil -> "none"
  | _ -> string.join(", ", roots)

fn handle_initialize(id: json.Json, state: LspState) -> Unit !{IO} =
  do
    send_message(make_result(id, initialize_result()))
    log_message("sproutd LSP ready — stdlib: " ++ lsp_stdlib_root(state)
      ++ "; package roots: " ++ roots_summary(lsp_package_roots(state)))

fn handle_shutdown(id: json.Json, state: LspState) -> Unit !{IO} =
  do
    ref_write(lsp_shutdown_flag(state), true)
    send_message(make_result(id, json.JsonNull))

fn handle_did_open(params: json.Json, state: LspState) -> Unit !{IO} =
  let Just td = json.json_get_field(params, "textDocument") else ()
      Just uri = json_get_str(td, "uri") else ()
      Just src = json_get_str(td, "text") else ()
  in
    do
      docs <- ref_read(lsp_documents(state))
      ref_write(lsp_documents(state), dict_set(uri, src, docs))
      check_and_push_diagnostics(uri, src, state)

fn handle_did_change(params: json.Json, state: LspState) -> Unit !{IO} =
  let Just td = json.json_get_field(params, "textDocument") else ()
      Just uri = json_get_str(td, "uri") else ()
      Just changes_val = json.json_get_field(params, "contentChanges") else ()
      Just arr = json.json_get_array(changes_val) else ()
      Just step = json.json_array_next(arr) else ()
  in
    match step with
    | json.JsonArrayStep head _ ->
        match json_get_str(head, "text") with
        | Nothing -> ()
        | Just src ->
            do
              docs <- ref_read(lsp_documents(state))
              ref_write(lsp_documents(state), dict_set(uri, src, docs))
              check_and_push_diagnostics(uri, src, state)

fn handle_did_close(params: json.Json, state: LspState) -> Unit !{IO} =
  match json.json_get_field(params, "textDocument") with
  | Nothing -> ()
  | Just td ->
      match json_get_str(td, "uri") with
      | Nothing -> ()
      | Just uri ->
          do
            docs <- ref_read(lsp_documents(state))
            ref_write(lsp_documents(state), dict_remove(uri, docs))
            push_diagnostics(uri, Nil, state)

fn hover_for_line(id: json.Json, src: String, line_str: String, char_num: Int, state: LspState) -> Unit !{IO} =
  if string.is_empty(word) then send_message(make_result(id, json.JsonNull))
  else do_hover(id, src, word, state)
  where word = extract_word(line_str, char_num)

fn handle_hover_with_source(id: json.Json, src: String, line_num: Int, char_num: Int, state: LspState) -> Unit !{IO} =
  match vec_get(line_num, string.string_lines(src)) with
  | Nothing -> send_message(make_result(id, json.JsonNull))
  | Just line_str -> hover_for_line(id, src, line_str, char_num, state)

fn handle_hover(id: json.Json, params: json.Json, state: LspState) -> Unit !{IO} =
  match extract_hover_params(params) with
  | Nothing -> send_message(make_result(id, json.JsonNull))
  | Just hp ->
      match hp with
      | HoverParams uri line_num char_num ->
          do
            docs <- ref_read(lsp_documents(state))
            match dict_get(uri, docs) with
            | Nothing -> send_message(make_result(id, json.JsonNull))
            | Just src -> handle_hover_with_source(id, src, line_num, char_num, state)

# ---------------------------------------------------------------------------
# Go to definition
#
# The word under the cursor is resolved to a declaring module, that module's source is
# read, and `compiler.declaration_position` finds the declaration. Three cases:
#
#   gfx.draw_frame  — qualified. The part before the last dot is an import alias (or a
#                     module name imported without one); the rest is the member.
#   greeting        — bare, declared in another module by a selective import.
#   top_fn          — bare, declared in this document.
#
# Locals, parameters and pattern bindings are OUT OF SCOPE: nothing records their
# positions, and inventing an answer would send the cursor somewhere wrong, which is
# worse than declining. `null` is a valid response and the editor says so plainly.

# The editor needs an absolute URI. Paths come from resolve_module_path, which joins the
# roots it was given — and an editor passes absolute roots, so these are absolute. A
# relative root (a hand-launched server) yields a relative path, which the client cannot
# open; it is left as-is rather than guessed at against the server's cwd, which is not
# necessarily the editor's.
fn uri_for_path(path: String) -> String = "file://" ++ path

# The inverse, for naming the file a load error came from. A client that sends some other
# URI scheme (an untitled buffer, say) gets the URI back unchanged — it is only ever used
# as a label and as the overlay key, so an unusual one costs nothing.
export fn path_for_uri(uri: String) -> String =
  match string.strip_prefix(uri, "file://") with
  | Just path -> path
  | Nothing -> uri

fn location_json(uri: String, line: Int, col: Int) -> json.Json =
  json.JsonObject(
    json.JsonObjectCons("uri", json.JsonString(uri),
    json.JsonObjectCons("range", diag_range(line - 1, col - 1),
    json.JsonObjectNil)))

# The module a qualified name's prefix refers to: an alias if one was bound, otherwise
# the module's own name when it was imported without one.
fn module_for_qualifier(specs: List module_loader.ImportSpec, qualifier: String) -> Maybe String =
  match specs with
  | Nil -> Nothing
  | Cons spec rest ->
      match spec with
      | module_loader.ImportAlias module_name alias ->
          if alias == qualifier || module_name == qualifier then Just(module_name)
          else module_for_qualifier(rest, qualifier)
      | module_loader.ImportSelective module_name _ ->
          if module_name == qualifier then Just(module_name)
          else module_for_qualifier(rest, qualifier)

# The module a BARE name came from, when a selective import named it.
fn module_for_selected_name(specs: List module_loader.ImportSpec, name: String) -> Maybe String =
  match specs with
  | Nil -> Nothing
  | Cons spec rest ->
      match spec with
      | module_loader.ImportSelective module_name names ->
          if list_member(name, names) then Just(module_name)
          else module_for_selected_name(rest, name)
      | module_loader.ImportAlias _ _ -> module_for_selected_name(rest, name)

fn definition_in_module(module_name: String, member: String, state: LspState) -> Maybe json.Json !{IO} =
  let Just path = module_loader.resolve_module_path(
        source.ModuleName(module_name), lsp_stdlib_root(state), lsp_package_roots(state)) else Nothing
      Ok module_src = fs.read_text(path) else Nothing
      Just pos = compiler.declaration_position(module_src, member) else Nothing
  in Just(location_json(uri_for_path(path),
       pos.line, pos.column))

# A qualified name, resolved through the importing document's own import list.
# Split at the LAST dot: the qualifier may itself be dotted when a module is imported
# without an alias (`stdlib.string.trim`), while the member never is.
fn definition_qualified(word: String, src: String, state: LspState) -> Maybe json.Json !{IO} =
  let Just(qualifier, member) = string.rsplit_once(word, ".") else Nothing
      Just module_name = module_for_qualifier(module_loader.collect_imports(src), qualifier) else Nothing
  in definition_in_module(module_name, member, state)

fn definition_bare(word: String, src: String, uri: String, state: LspState) -> Maybe json.Json !{IO} =
  match compiler.declaration_position(src, word) with
  | Just pos ->
      Just(location_json(uri, pos.line, pos.column))
  | Nothing ->
      match module_for_selected_name(module_loader.collect_imports(src), word) with
      | Nothing -> Nothing
      | Just module_name -> definition_in_module(module_name, word, state)

fn definition_for_word(word: String, src: String, uri: String, state: LspState) -> Maybe json.Json !{IO} =
  if string.contains(word, ".") then definition_qualified(word, src, state)
  else definition_bare(word, src, uri, state)

# The result is matched at the call rather than bound with `<-`: a do-bind unwraps a
# Maybe returned from an effectful function, so `target <- definition_for_word(...)`
# would hand back a bare Json and lose the not-found case.
fn send_definition_for(id: json.Json, word: String, src: String, uri: String, state: LspState) -> Unit !{IO} =
  match definition_for_word(word, src, uri, state) with
  | Nothing -> send_message(make_result(id, json.JsonNull))
  | Just loc -> send_message(make_result(id, loc))

fn handle_definition_at(id: json.Json, uri: String, src: String, line_num: Int, char_num: Int, state: LspState) -> Unit !{IO} =
  match vec_get(line_num, string.string_lines(src)) with
  | Nothing -> send_message(make_result(id, json.JsonNull))
  | Just line_str ->
      let word = extract_word(line_str, char_num)
      in if string.is_empty(word) then send_message(make_result(id, json.JsonNull))
         else send_definition_for(id, word, src, uri, state)

fn handle_definition(id: json.Json, params: json.Json, state: LspState) -> Unit !{IO} =
  # Same TextDocumentPositionParams shape as hover, so the same extractor serves both.
  match extract_hover_params(params) with
  | Nothing -> send_message(make_result(id, json.JsonNull))
  | Just hp ->
      match hp with
      | HoverParams uri line_num char_num ->
          do
            docs <- ref_read(lsp_documents(state))
            match dict_get(uri, docs) with
            | Nothing -> send_message(make_result(id, json.JsonNull))
            | Just src -> handle_definition_at(id, uri, src, line_num, char_num, state)

# ---------------------------------------------------------------------------
# Dispatch

# JSON-RPC 2.0: every REQUEST gets a response, only notifications may be dropped. The
# distinction is the `id` field — present on requests, absent on notifications — so a
# missing `id` is the reason to stay silent, not an excuse to.
#
# This matters because a real client sends methods this server does not implement on the
# very first file it opens: documentSymbol, semanticTokens, codeAction, foldingRange,
# and $/cancelRequest. Dropping the requests among them leaves the client waiting for a
# reply that never arrives. Pure and exported so the decision is unit-testable; the
# caller performs the IO.
export fn unknown_method_response(method: String, req: json.Json) -> Maybe json.Json =
  match json.json_get_field(req, "id") with
  | Nothing -> Nothing
  | Just id -> Just(make_error(id, -32601, "method not implemented: " ++ method))

fn dispatch_lsp(method: String, req: json.Json, state: LspState) -> Unit !{IO} =
  if method == "initialize" then handle_initialize(get_id(req), state)
  else if method == "initialized" then ()
  else if method == "shutdown" then handle_shutdown(get_id(req), state)
  else if method == "textDocument/didOpen" then handle_did_open(get_params(req), state)
  else if method == "textDocument/didChange" then handle_did_change(get_params(req), state)
  else if method == "textDocument/didClose" then handle_did_close(get_params(req), state)
  else if method == "textDocument/hover" then handle_hover(get_id(req), get_params(req), state)
  else if method == "textDocument/definition" then handle_definition(get_id(req), get_params(req), state)
  else if method == "textDocument/completion" then
    send_message(make_result(get_id(req), json.array_from_list(Nil)))
  else
    match unknown_method_response(method, req) with
    | Nothing -> ()
    | Just reply -> send_message(reply)

fn handle_after_shutdown_check(method: String, req: json.Json, shutdown: Bool, state: LspState) -> Unit !{IO} =
  if method == "exit" then ()
  else if shutdown then
    match json.json_get_field(req, "id") with
    | Nothing -> lsp_loop(state)
    | Just id ->
        do
          send_message(make_error(id, -32600, "server is shutting down"))
          lsp_loop(state)
  else
    do
      dispatch_lsp(method, req, state)
      lsp_loop(state)

# ---------------------------------------------------------------------------
# Main loop

fn lsp_loop(state: LspState) -> Unit !{IO} =
  let Just body = read_lsp_message() else ()
      Ok req = json.parse(body) else lsp_loop(state)
      Just method = get_method(req) else lsp_loop(state)
  in
    do
      shutdown <- ref_read(lsp_shutdown_flag(state))
      handle_after_shutdown_check(method, req, shutdown, state)

export fn run_lsp(stdlib_root: String) -> Unit !{IO} =
  run_lsp_with_roots(stdlib_root, Nil)

export fn run_lsp_with_roots(stdlib_root: String, package_roots: List String) -> Unit !{IO} =
  do
    state <- build_lsp_state(stdlib_root, package_roots)
    lsp_loop(state)
