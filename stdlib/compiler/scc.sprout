module stdlib.compiler.scc

# Strongly connected components of a call graph — Kosaraju, iteratively.
#
# `graph` maps a node to the nodes it calls; a node with no entry has no
# out-edges. Edges to names outside `nodes` must not occur. O((V+E) log V):
# each node and edge is visited once per pass, and Dict/Set are AVL trees.
#
# Two callers. infer's group_plan needs the dependency order, stable in source
# order (sccs_in_source_order), so an instance is checked where it is written.
# ast_to_ir's mutual-TCO Phase B needs only the partition, and puts it in
# declaration order itself. Phase B once asked "does f reach g, and g reach f?" for every pair
# instead, which was 55% of the compiler's self-compile allocation
# (scripts/scc_cost_gate.sh).
#
# It is ITERATIVE. Textbook Kosaraju is two recursive depth-first searches, and
# the depth is set by user code, not by us: 551 frames for infer.sprout's largest
# run of functions (2026-08-25), a stack the `stack-overflow-smoke` gate exists to
# police. Both passes carry an explicit worklist.
#
# Pass 1 walks G recording nodes by DECREASING finish time; pass 2 walks Gᵀ in that
# order and each tree it reaches is one component.
fn neighbors_of(n: String, graph: Dict Set) -> List String =
  match dict_get(n, graph) with
  | Just s -> set_to_list(s)
  | Nothing -> Nil

fn set_or_empty(k: String, d: Dict Set) -> Set =
  match dict_get(k, d) with
  | Just s -> s
  | Nothing -> set_empty()

fn reverse_graph(nodes: List String, graph: Dict Set, acc: Dict Set) -> Dict Set =
  match nodes with
  | Nil -> acc
  | Cons n rest -> reverse_graph(rest, graph, add_reverse_edges(n, neighbors_of(n, graph), acc))

fn add_reverse_edges(from: String, tos: List String, acc: Dict Set) -> Dict Set =
  match tos with
  | Nil -> acc
  | Cons t rest -> add_reverse_edges(from, rest, dict_set(t, set_insert(from, set_or_empty(t, acc)), acc))

# Pass 1. The worklist holds (node, is_exit): an `is_exit` item means every
# descendant of that node has been finished, so this is where post-order is
# recorded. `order` is built by consing on finish, which leaves the LAST-finished
# node at the head — decreasing finish time, exactly what pass 2 consumes.
fn scc_finish_order(nodes: List String, graph: Dict Set) -> List String =
  scc_finish_order_go(nodes, graph, set_empty(), Nil)

fn scc_finish_order_go(nodes: List String, graph: Dict Set, visited: Set, order: List String) -> List String =
  match nodes with
  | Nil -> order
  | Cons n rest ->
      if set_member(n, visited) then scc_finish_order_go(rest, graph, visited, order)
      else
        let (v2, o2) = scc_dfs1(Cons((n, false), Nil), graph, visited, order)
        in scc_finish_order_go(rest, graph, v2, o2)

fn scc_dfs1(work: List (String, Bool), graph: Dict Set, visited: Set, order: List String) -> (Set, List String) =
  match work with
  | Nil -> (visited, order)
  | Cons item rest ->
      match item with
      | (n, true) -> scc_dfs1(rest, graph, visited, Cons(n, order))
      | (n, false) ->
          # A node can be pushed as an ENTER more than once (two parents reach it
          # before either finishes); the visited test here is what makes that
          # harmless. Its EXIT marker is pushed exactly once, on first entry.
          if set_member(n, visited) then scc_dfs1(rest, graph, visited, order)
          else
            scc_dfs1(push_enters(neighbors_of(n, graph), Cons((n, true), rest)),
                     graph, set_insert(n, visited), order)

fn push_enters(ns: List String, work: List (String, Bool)) -> List (String, Bool) =
  match ns with
  | Nil -> work
  | Cons n rest -> Cons((n, false), push_enters(rest, work))

# Pass 2. Each tree reached in Gᵀ is one component.
#
# Kosaraju discovers components in topological order of G's condensation, and G's
# edges point caller -> callee, so it finds CALLERS first. `acc` is built by
# consing, which reverses that — leaving callees first, which is the order a
# dependency-ordered check needs. The reversal is load-bearing, not incidental.
fn scc_components(order: List String, rgraph: Dict Set, visited: Set, acc: List (List String)) -> List (List String) =
  match order with
  | Nil -> acc
  | Cons n rest ->
      if set_member(n, visited) then scc_components(rest, rgraph, visited, acc)
      else
        let (v2, members) = scc_dfs2(Cons(n, Nil), rgraph, visited, Nil)
        in scc_components(rest, rgraph, v2, Cons(members, acc))

fn scc_dfs2(work: List String, rgraph: Dict Set, visited: Set, members: List String) -> (Set, List String) =
  match work with
  | Nil -> (visited, members)
  | Cons n rest ->
      if set_member(n, visited) then scc_dfs2(rest, rgraph, visited, members)
      else scc_dfs2(list_append(neighbors_of(n, rgraph), rest), rgraph, set_insert(n, visited), Cons(n, members))

# Components of `nodes` under `graph`, dependencies first: if a member of one
# component calls a member of another, the callee's component comes earlier.
# Members within a component are in no promised order. Every node is in exactly
# one component, given unique names in `nodes`.
export fn sccs_in_dependency_order(nodes: List String, graph: Dict Set) -> List (List String) =
  scc_components(scc_finish_order(nodes, graph), reverse_graph(nodes, graph, dict_empty()),
                 set_empty(), Nil)

# The same components, dependencies first and otherwise in the order `nodes` lists
# them: next is always the earliest-listed component whose dependencies are all
# placed (Kahn's algorithm, smallest position first). The order above breaks ties
# by finish time, which can put a node after unrelated ones listed later.
#
# A component is named by one of its members, its representative.
export fn sccs_in_source_order(nodes: List String, graph: Dict Set) -> List (List String) =
  let comps = sccs_in_dependency_order(nodes, graph)
      rep_of = list_fold(add_representative, dict_empty(), comps)
      first = first_positions(nodes, rep_of, 0, dict_empty())
      start = list_fold(add_component(graph, rep_of, _, _),
                        Placing(members = dict_empty(), waiting = dict_empty(), dependents = dict_empty(), placed = []),
                        comps)
      ready = list_fold(add_if_ready(start, first, _, _), Leaf, vec_to_list(dict_keys(start.members)))
  in list_reverse(drain(ready, first, start).placed)

# Keyed by representative: `waiting` counts the components each still waits for.
# `placed` is built reversed.
type Placing = (members: Dict (List String), waiting: Dict Int, dependents: Dict Set, placed: List (List String))

fn add_representative(acc: Dict String, members: List String) -> Dict String =
  match members with
  | [] -> acc
  | [rep | _] -> list_fold(\ (a, m) -> dict_set(m, rep, a), acc, members)

fn add_component(graph: Dict Set, rep_of: Dict String, st: Placing, members: List String) -> Placing =
  match members with
  | [] -> st
  | [rep | _] ->
      let callees = list_flat_map(\m -> neighbors_of(m, graph), members)
          deps = set_to_list(set_remove(rep, set_from_list(list_filter_map(\c -> dict_get(c, rep_of), callees))))
      in st with (members = dict_set(rep, members, st.members),
                  waiting = dict_set(rep, list_length(deps), st.waiting),
                  dependents = list_fold(\ (acc, d) -> dict_set(d, set_insert(rep, set_or_empty(d, acc)), acc),
                                         st.dependents, deps))

# Each representative's earliest position in `nodes`.
fn first_positions(nodes: List String, rep_of: Dict String, i: Int, first: Dict Int) -> Dict Int =
  match nodes with
  | [] -> first
  | [n | rest] ->
      match dict_get(n, rep_of) with
      | Just rep ->
          if dict_member(rep, first) then first_positions(rest, rep_of, i + 1, first)
          else first_positions(rest, rep_of, i + 1, dict_set(rep, i, first))
      | Nothing -> first_positions(rest, rep_of, i + 1, first)

# Every representative has a position, a count and members: add_component and
# first_positions record one for each component.
fn position_of(rep: String, first: Dict Int) -> Int =
  match dict_get(rep, first) with
  | Just i -> i
  | Nothing -> panic("scc.position_of: no position for " ++ rep ++ " (internal error)")

fn waiting_on(rep: String, st: Placing) -> Int =
  match dict_get(rep, st.waiting) with
  | Just n -> n
  | Nothing -> panic("scc.waiting_on: no count for " ++ rep ++ " (internal error)")

fn add_if_ready(st: Placing, first: Dict Int, ready: Heap, rep: String) -> Heap =
  if waiting_on(rep, st) == 0 then heap_insert(position_of(rep, first), rep, ready) else ready

fn drain(ready: Heap, first: Dict Int, st: Placing) -> Placing =
  match heap_pop(ready) with
  | Nothing -> st
  | Just (rep, rest) ->
      let placed = st with (placed = Cons(members_of(rep, st), st.placed))
          (freed, ready2) = list_fold(release(first, _, _), (placed, rest),
                                      set_to_list(set_or_empty(rep, st.dependents)))
      in drain(ready2, first, freed)

# One dependency of `d` is placed; once none are left, `d` is ready.
fn release(first: Dict Int, acc: (Placing, Heap), d: String) -> (Placing, Heap) =
  let (st, ready) = acc
      left = waiting_on(d, st) - 1
      st2 = st with (waiting = dict_set(d, left, st.waiting))
  in if left == 0 then (st2, heap_insert(position_of(d, first), d, ready)) else (st2, ready)

fn members_of(rep: String, st: Placing) -> List String =
  match dict_get(rep, st.members) with
  | Just ms -> ms
  | Nothing -> panic("scc.members_of: no members for " ++ rep ++ " (internal error)")

# A leftist heap of representatives keyed by position: O(log n) insert and pop.
type Heap =
  | Leaf
  | Branch Int Int String Heap Heap  # rank, position, representative, left, right

fn heap_rank(h: Heap) -> Int =
  match h with
  | Leaf -> 0
  | Branch rank _ _ _ _ -> rank

# The higher-ranked child goes left, so the right spine stays O(log n).
fn heap_branch(position: Int, rep: String, a: Heap, b: Heap) -> Heap =
  if heap_rank(a) >= heap_rank(b) then Branch(heap_rank(b) + 1, position, rep, a, b)
  else Branch(heap_rank(a) + 1, position, rep, b, a)

fn heap_merge(a: Heap, b: Heap) -> Heap =
  match (a, b) with
  | (Leaf, _) -> b
  | (_, Leaf) -> a
  | (Branch _ pa ra la xa, Branch _ pb _ _ _) ->
      if pa <= pb then heap_branch(pa, ra, la, heap_merge(xa, b)) else heap_merge(b, a)

fn heap_insert(position: Int, rep: String, h: Heap) -> Heap =
  heap_merge(Branch(1, position, rep, Leaf, Leaf), h)

fn heap_pop(h: Heap) -> Maybe (String, Heap) =
  match h with
  | Leaf -> Nothing
  | Branch _ _ rep left right -> Just((rep, heap_merge(left, right)))
