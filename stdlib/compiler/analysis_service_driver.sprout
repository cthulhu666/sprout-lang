module stdlib.compiler.analysis_service_driver
import stdlib.json as json
import stdlib.compiler.compiler as compiler
import stdlib.compiler.bundler as bundler
import stdlib.compiler.module_loader as module_loader
import stdlib.compiler.lexer as lexer
import stdlib.compiler.parser as parser
import stdlib.compiler.ast as ast
import stdlib.compiler.source as source
import stdlib.compiler.types as types
import stdlib.compiler.infer as infer
import stdlib.compiler.unifier as unifier
import stdlib.sort (sort)
import stdlib.string as string
import stdlib.process as process
import stdlib.terminal as terminal
import stdlib.fs as fs
import stdlib.fs.path as fspath
import stdlib.env as env
import stdlib.crypto as crypto

# ---------------------------------------------------------------------------
# Header stripping is source.strip_headers (line-preserving): stripped lines
# become blank lines, so parsed positions keep original line numbers and no
# header-line offset needs adding back.

# ---------------------------------------------------------------------------
# SessionState — server-side per-session state (M2)

export type SessionState (..) = SessionState(Vec String) (Vec String)
  # imports, declarations

export fn session_add_line(sess: SessionState, kind: String, line: String) -> SessionState =
  match sess with
  | SessionState imports declarations ->
      if kind == "import" then SessionState(vec_append(line, imports), declarations)
      else
        # Redefining a top-level name REPLACES the prior declaration instead of
        # appending a duplicate: two declarations of the same name would emit two
        # `define @app.session.<name>` blocks and fail to link at eval time. Drop
        # any stored declaration whose names overlap the incoming line's, then
        # append. An unparseable line yields no names → nothing dropped (append).
        let new_names = parse_decl_names(line)
        in SessionState(imports,
             vec_append(line,
               vec_filter(\d -> decl_names_disjoint(parse_decl_names(d), new_names), declarations)))

# True when two declaration-name lists share no name.
fn decl_names_disjoint(a: List String, b: List String) -> Bool =
  match a with
  | Nil -> true
  | Cons x rest -> if list_member(x, b) then false else decl_names_disjoint(rest, b)

fn build_source_parts(header: String, imports: Vec String, declarations: Vec String) -> String =
  if vec_length(declarations) == 0 then with_imports
  else with_imports ++ "\n\n" ++ string.join("\n\n", declarations)
  where with_imports =
    if vec_length(imports) == 0 then header
    else header ++ "\n\n" ++ string.join("\n\n", imports)

export fn rebuild_session_source(sess: SessionState) -> String =
  match sess with
  | SessionState imports declarations ->
      build_source_parts("module app.session", imports, declarations)

# ---------------------------------------------------------------------------
# JSON response construction

fn ok_response(value: json.Json) -> json.Json =
  json.object_from_pairs([("ok", json.JsonBool(true)),
                          ("value", value)])

fn error_response(msg: String) -> json.Json =
  json.object_from_pairs([("ok", json.JsonBool(false)),
                          ("error", json.JsonString(msg))])

fn string_list_to_json(xs: List String) -> json.Json =
  json.array_from_list(list_map(json.string, xs))

fn int_list_to_json(xs: List Int) -> json.Json =
  json.array_from_list(list_map(json.int, xs))

fn not_implemented(op_name: String) -> json.Json =
  error_response(string.concat("not yet implemented in self-hosted analysis service: ", op_name))

fn empty_diags_response() -> json.Json =
  ok_response(json.object_from_pairs([("messages", json.array_from_list(Nil)),
                                      ("lines", json.array_from_list(Nil)),
                                      ("columns", json.array_from_list(Nil))]))

fn require_string_field(req: json.Json, field: String) -> Result String String =
  match json.json_get_field(req, field) with
  | Nothing -> Err(string.concat("missing field: ", field))
  | Just v ->
      match json.json_get_string(v) with
      | Nothing -> Err(string.concat("field must be a string: ", field))
      | Just s -> Ok(s)

fn require_int_field(req: json.Json, field: String) -> Result String Int =
  match json.json_get_field(req, field) with
  | Nothing -> Err(string.concat("missing field: ", field))
  | Just v ->
      match json.json_get_int(v) with
      | Nothing -> Err(string.concat("field must be an integer: ", field))
      | Just n -> Ok(n)

# ---------------------------------------------------------------------------
# AST name extraction

# Names a session declaration introduces, for redefinition detection. VALUE names
# come from ast.decl_value_scopes — the single authority — so an extern is excluded
# here because it is ScopeGlobal, not because this site says so. Type-level names
# are a separate axis the authority does not cover, and are added alongside.
fn collect_decl_names(decls: List ast.Decl, acc: List String) -> List String =
  match decls with
  | Nil -> list_reverse(acc)
  | Cons d rest ->
      collect_decl_names(rest,
        prepend_names(ast.scope_names_module(ast.decl_value_scopes(d)), decl_type_names(d, acc)))

fn prepend_names(names: List String, acc: List String) -> List String =
  match names with
  | Nil -> acc
  | Cons name rest -> prepend_names(rest, Cons(name, acc))

# The type/class-level name a declaration introduces, if any.
# The type axis moved to ast.decl_type_names, beside decl_value_scopes, once
# go-to-definition needed the same question answered. Two per-constructor matches over
# Decl is precisely how the value axis came to disagree with itself.
fn decl_type_names(d: ast.Decl, acc: List String) -> List String =
  prepend_names(ast.decl_type_names(d), acc)

fn parse_decl_names(src: String) -> List String =
  match lexer.tokenize_source(src) with
  | Err _ -> Nil
  | Ok tokens ->
      match parser.parse_program(tokens) with
      | Err _ -> Nil
      | Ok prog ->
          match prog with
          | ast.Program decls _ -> collect_decl_names(decls, Nil)

# ---------------------------------------------------------------------------
# Symbol location extraction

# (category, name) of a declaration the inventory lists; instances and externs
# are not listed.
fn decl_category(d: ast.Decl) -> Maybe (String, String) =
  match d with
  | ast.FnDecl name _ _ _ _ _ _ _ -> Just(("fn", name))
  | ast.TypeDecl name _ _ _ _ _ _ -> Just(("type", name))
  | ast.RecordDecl name _ _ _ _ _ _ -> Just(("type", name))
  | ast.LetDecl name _ _ _ -> Just(("let", name))
  | ast.ClassDecl name _ _ _ _ -> Just(("class", name))
  | ast.InstanceDecl _ _ _ _ _ -> Nothing
  | ast.AliasDecl name _ _ _ -> Just(("alias", name))
  | ast.WrapDecl name _ _ _ _ _ _ -> Just(("type", name))
  | ast.ExternFnDecl _ _ _ _ _ _ _ -> Nothing

fn collect_decl_locations(
  decls: List ast.Decl,
  line_offset: Int,
  categories: List String,
  names: List String,
  lines: List Int,
  cols: List Int
) -> (List String, List String, List Int, List Int) =
  match decls with
  | Nil ->
      (list_reverse(categories), list_reverse(names), list_reverse(lines), list_reverse(cols))
  | Cons d rest ->
      match decl_category(d) with
      | Nothing -> collect_decl_locations(rest, line_offset, categories, names, lines, cols)
      | Just (category, name) ->
          collect_decl_locations(rest, line_offset,
            Cons(category, categories), Cons(name, names),
            Cons(ast.decl_pos(d).line + line_offset, lines),
            Cons(ast.decl_pos(d).column, cols))

fn empty_locations_json() -> json.Json =
  ok_response(json.object_from_pairs([("categories", json.array_from_list(Nil)),
                                      ("names", json.array_from_list(Nil)),
                                      ("lines", json.array_from_list(Nil)),
                                      ("columns", json.array_from_list(Nil))]))

fn parse_symbol_locations(src: String) -> json.Json =
  match lexer.tokenize_source(src) with
  | Err _ -> empty_locations_json()
  | Ok tokens ->
      match parser.parse_program(tokens) with
      | Err _ -> empty_locations_json()
      | Ok prog ->
          match prog with
          | ast.Program decls _ ->
              match collect_decl_locations(decls, 0, Nil, Nil, Nil, Nil) with
              | (cats, loc_names, loc_lines, loc_cols) ->
                  ok_response(json.object_from_pairs([("categories", string_list_to_json(cats)),
                                                      ("names", string_list_to_json(loc_names)),
                                                      ("lines", int_list_to_json(loc_lines)),
                                                      ("columns", int_list_to_json(loc_cols))]))

# ---------------------------------------------------------------------------
# Import name extraction (for symbol_inventory imported list)

fn import_spec_names(spec: module_loader.ImportSpec) -> List String =
  match spec with
  | module_loader.ImportAlias _ alias _ -> Cons(alias, Nil)
  | module_loader.ImportSelective _ names _ -> names

fn collect_import_names(specs: List module_loader.ImportSpec, acc: List String) -> List String =
  match specs with
  | Nil -> list_reverse(acc)
  | Cons s rest ->
      collect_import_names(rest, list_append(list_reverse(import_spec_names(s)), acc))

fn exported_names_from_src(src: String) -> List String =
  match bundler.scan_source_info(src) with
  | (_, exported, _) -> exported

# ---------------------------------------------------------------------------
# Diagnostic formatting

fn collect_diag_fields(
  diags: List compiler.Diagnostic,
  msgs: List String,
  lines: List Int,
  cols: List Int
) -> (List String, List Int, List Int) =
  match diags with
  | Nil -> (list_reverse(msgs), list_reverse(lines), list_reverse(cols))
  | Cons d rest ->
      match d with
      | compiler.DiagError pos msg ->
          collect_diag_fields(rest, Cons(msg, msgs), Cons(pos.line, lines), Cons(pos.column, cols))
      | compiler.DiagWarning pos msg ->
          collect_diag_fields(rest, Cons(msg, msgs), Cons(pos.line, lines), Cons(pos.column, cols))

fn diags_to_json(diags: List compiler.Diagnostic) -> json.Json =
  match collect_diag_fields(diags, Nil, Nil, Nil) with
  | (msgs, diag_lines, diag_cols) ->
      ok_response(json.object_from_pairs([("messages", string_list_to_json(msgs)),
                                          ("lines", int_list_to_json(diag_lines)),
                                          ("columns", int_list_to_json(diag_cols))]))

# ---------------------------------------------------------------------------
# instances_in_source — list the typeclass instances whose head type matches a
# query type.  The instance universe is the *bundled* program (prelude +
# transitive imports + session), so `:i String` surfaces the prelude's Eq/Ord/…
# instances, not just session-local ones.
#
# Matching reuses the real type machinery — no bespoke subset:
#   - the query and each instance head are elaborated to types via
#     infer.type_from_ast (which expands aliases when given the alias env), and
#   - a match is an *unification* success (unifier.unify_join), with the
#     instance head's type variables made fresh so `Eq (List a)` matches a
#     concrete `List Int` query.
# An applied query (`Maybe a`) additionally tries its outermost constructor
# (`Maybe`), so higher-kinded instances (`Functor Maybe`) also show up.

fn te_var_names(te: ast.TypeExpr, acc: List String) -> List String =
  match te with
  | ast.TypeName name -> if source.is_lowercase_name(name) then Cons(name, acc) else acc
  | ast.TypeApply base arg -> te_var_names(arg, te_var_names(base, acc))
  | ast.TypeArrow l r _ _ -> te_var_names(r, te_var_names(l, acc))
  | ast.TypeThunk r _ -> te_var_names(r, acc)
  | ast.TypeEffect inner _ -> te_var_names(inner, acc)
  | ast.TupleType parts -> te_var_names_list(parts, acc)

fn te_var_names_list(parts: List ast.TypeExpr, acc: List String) -> List String =
  match parts with
  | Nil -> acc
  | Cons h t -> te_var_names_list(t, te_var_names(h, acc))

# Bind each free type-var name to a fresh TVar over the alias env.  The name is
# unique enough: each unify starts from an empty substitution, so cross-instance
# names never collide.
fn bind_fresh_vars(names: List String, env: Dict types.Type) -> Dict types.Type =
  match names with
  | Nil -> env
  | Cons name rest ->
      bind_fresh_vars(rest, dict_set(name, types.TVar(types.tyvar_id(name)), env))

fn te_to_type(te: ast.TypeExpr, alias_env: Dict types.Type) -> types.Type =
  infer.type_from_ast(te, bind_fresh_vars(te_var_names(te, Nil), alias_env))

# --- Type-expression rendering (mirrors the reference: compound args parenthesized) ---

fn te_is_compound(te: ast.TypeExpr) -> Bool =
  match te with
  | ast.TypeApply _ _ -> true
  | ast.TypeArrow _ _ _ _ -> true
  | ast.TypeThunk _ _ -> true
  | ast.TypeEffect _ _ -> true
  | _ -> false

fn effect_suffix(labels: List String) -> String =
  match labels with
  | Nil -> ""
  | _ -> " !{" ++ string.join(", ", labels) ++ "}"

fn arrow_effect_suffix(effs: Maybe (List String)) -> String =
  match effs with
  | Nothing -> ""
  | Just labels -> effect_suffix(labels)

# Display-only renderer: TypeNames print by their last dotted segment, so a
# bundled instance head `app.session.Color` shows as `Color` (matching how the
# user typed the query).  Never feeds matching — that runs on the raw types.
fn te_to_string(te: ast.TypeExpr) -> String =
  match te with
  | ast.TypeName name -> string.after_last_dot(name)
  | ast.TypeApply base arg -> te_to_string(base) ++ " " ++ te_arg_to_string(arg)
  | ast.TypeArrow l r effs mode ->
      te_arrow_param(l, mode) ++ " -> " ++ te_to_string(r) ++ arrow_effect_suffix(effs)
  | ast.TypeThunk r effs -> "() -> " ++ te_to_string(r) ++ arrow_effect_suffix(effs)
  | ast.TypeEffect inner effs -> te_to_string(inner) ++ effect_suffix(effs)
  | ast.TupleType parts -> "(" ++ string.join(", ", te_to_string_list(parts)) ++ ")"

fn te_arg_to_string(te: ast.TypeExpr) -> String =
  if te_is_compound(te) then "(" ++ te_to_string(te) ++ ")" else te_to_string(te)

# A written mode is parenthesised with the type it applies to, which is also the
# syntax that produced it: `(borrowing File) -> Int`.
fn te_arrow_param(l: ast.TypeExpr, mode: ast.ParamMode) -> String =
  match mode with
  | ast.ModeBorrowing -> "(borrowing " ++ te_to_string(l) ++ ")"
  | ast.ModeOnceLocal -> "(once local " ++ te_to_string(l) ++ ")"
  | ast.ModeOnce -> "(once " ++ te_to_string(l) ++ ")"
  | ast.ModeLocal -> "(local " ++ te_to_string(l) ++ ")"
  | ast.ModeDefault -> te_arrow_left(l)
  | ast.ModeConsuming -> te_arrow_left(l)

fn te_arrow_left(l: ast.TypeExpr) -> String =
  match l with
  | ast.TypeArrow _ _ _ _ -> "(" ++ te_to_string(l) ++ ")"
  | ast.TypeThunk _ _ -> "(" ++ te_to_string(l) ++ ")"
  | _ -> te_to_string(l)

fn te_to_string_list(parts: List ast.TypeExpr) -> List String =
  match parts with
  | Nil -> Nil
  | Cons h t -> Cons(te_to_string(h), te_to_string_list(t))

# --- Matching ---

fn te_outermost_base(te: ast.TypeExpr) -> ast.TypeExpr =
  match te with
  | ast.TypeApply base _ -> te_outermost_base(base)
  | _ -> te

fn te_is_apply(te: ast.TypeExpr) -> Bool =
  match te with
  | ast.TypeApply _ _ -> true
  | _ -> false

fn unify_ok(a: types.Type, b: types.Type) -> Bool =
  # no_effect_subst: a yes/no "do these two types unify" probe for type search.
  # Nothing downstream reads a substitution, let alone an effect one.
  #
  # A JOIN, deliberately: search is not a contract check, and adopting the
  # checker's direction would stop a search for `Int -> Int` from finding
  # `Int -> Int !{IO}` — the more useful answer is that it matches either way.
  match unifier.unify_join(dict_empty(), unifier.no_effect_subst(), a, b) with
  | unifier.UnifyOk _ _ -> true
  | unifier.UnifyErr _ -> false

fn te_matches_query(pattern: ast.TypeExpr, query_te: ast.TypeExpr, alias_env: Dict types.Type) -> Bool =
  if unify_ok(te_to_type(pattern, alias_env), te_to_type(query_te, alias_env)) then true
  else if te_is_apply(query_te)
  then unify_ok(te_to_type(pattern, alias_env), te_to_type(te_outermost_base(query_te), alias_env))
  else false

fn render_match(class_name: String, arg: ast.TypeExpr) -> String =
  class_name ++ " " ++ te_arg_to_string(arg)

# Single-parameter instances only (mirrors the reference), matched head-vs-query.
fn collect_matches(decls: List ast.Decl, query_te: ast.TypeExpr, alias_env: Dict types.Type, acc: List String) -> List String =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | ast.InstanceDecl constraint _ _ _ _ ->
          match constraint with
          | ast.TypeConstraint class_name args ->
              match args with
              | [arg] ->
                  if te_matches_query(arg, query_te, alias_env)
                  then collect_matches(rest, query_te, alias_env, Cons(render_match(class_name, arg), acc))
                  else collect_matches(rest, query_te, alias_env, acc)
              | _ -> collect_matches(rest, query_te, alias_env, acc)
      | _ -> collect_matches(rest, query_te, alias_env, acc)

fn sort_strings(xs: List String) -> List String =
  sort(xs)

fn parse_query_type(query: String) -> Result String ast.TypeExpr =
  match lexer.tokenize(query) with
  | Err _ -> Err("could not parse type query: " ++ query)
  | Ok tokens ->
      match parser.parse_type_expr(tokens, 0) with
      | Err _ -> Err("could not parse type query: " ++ query)
      | Ok pair ->
          match pair with
          | (te, _) -> Ok(te)

# Pure core: sorted "<Class> <head>" descriptions for every single-parameter
# instance in `prog` whose head unifies with the (already name-resolved) query.
export fn instance_match_names_for_type(prog: ast.Program, query_te: ast.TypeExpr) -> List String =
  match prog with
  | ast.Program decls _ ->
      sort_strings(collect_matches(decls, query_te, infer.alias_env_or(decls, dict_empty()), Nil))

# String-query convenience: parse the query directly (no session name-resolution)
# and return the rendered query alongside the matches.  Used where the query
# needs no module-qualified resolution (e.g. unit tests over synthetic programs).
export fn instance_matches_in_program(prog: ast.Program, query: String) -> Result String (String, List String) =
  match parse_query_type(query) with
  | Err msg -> Err(msg)
  | Ok query_te -> Ok((te_to_string(query_te), instance_match_names_for_type(prog, query_te)))

# ---------------------------------------------------------------------------
# Op handlers

fn op_check_source(src: String, state: StartupState) -> json.Json !{IO} =
  do
    result <- compiler.compile_source_with_cache(src, source.StdlibRoot(state_stdlib_root(state)), state_cache(state))
    match result with
    | compiler.CompileOk _ -> ok_response(json.JsonNull)
    | compiler.CompileFail diags ->
        match diags with
        | Nil -> error_response("check failed")
        | [d | _] ->
            match d with
            | compiler.DiagError _ msg -> error_response(msg)
            | compiler.DiagWarning _ msg -> error_response(msg)

fn op_diagnostics_in_source(src: String, state: StartupState) -> json.Json !{IO} =
  do
    result <- compiler.compile_source_with_cache(src, source.StdlibRoot(state_stdlib_root(state)), state_cache(state))
    match result with
    | compiler.CompileOk _ -> empty_diags_response()
    | compiler.CompileFail diags -> diags_to_json(diags)

fn op_declared_names_in_source(src: String) -> json.Json =
  ok_response(string_list_to_json(parse_decl_names(src)))

fn op_exported_names_in_source(src: String) -> json.Json =
  ok_response(string_list_to_json(exported_names_from_src(src)))

fn op_symbol_inventory_in_source(src: String) -> json.Json =
  ok_response(json.object_from_pairs([("declared", string_list_to_json(parse_decl_names(src))),
                                      ("imported", string_list_to_json(collect_import_names(module_loader.collect_imports(src), Nil))),
                                      ("exported", string_list_to_json(exported_names_from_src(src)))]))

fn op_symbol_locations_in_source(src: String) -> json.Json =
  parse_symbol_locations(src)

# The query is resolved in the *session's* naming context by appending a probe
# signature `fn <probe>(__x: <query>) -> Int = 0` and reading back its parameter
# type after bundling.  Bundling qualifies the probe's param type exactly as it
# qualifies instance heads (e.g. a session type `Color` → `app.session.Color`),
# so a session-local `:i Color` matches its own instances.  Mirrors the
# pre-self-hosting analysis backend's probe-based resolution.
let probe_name: String = "__sprout_instances_probe"

fn augment_probe_source(src: String, query: String) -> String =
  src ++ "\n\nfn " ++ probe_name ++ "(__x: " ++ query ++ ") -> Int = 0"

fn first_param_type(params: List ast.Param) -> Maybe ast.TypeExpr =
  match params with
  | Nil -> Nothing
  | [p | _] -> match p with | ast.Param _ mty _ -> mty

fn find_probe_query_type(decls: List ast.Decl) -> Maybe ast.TypeExpr =
  match decls with
  | Nil -> Nothing
  | Cons d rest ->
      match d with
      | ast.FnDecl name params _ _ _ _ _ _ ->
          if name == probe_name || string.ends_with(name, "." ++ probe_name)
          then first_param_type(params)
          else find_probe_query_type(rest)
      | _ -> find_probe_query_type(rest)

# Own result ADT (not `Result`): a `Result`/`Maybe` return gets its wrapper
# stripped when bound with `<-` in a caller's do-block, so the driver's IO seams
# use custom ADTs (cf. CompileResult / BundleResult) that bind whole.
export type InstancesResult (..) =
  | InstancesOk String (List String)
  | InstancesErr String

fn resolve_instances_from_bundle(result: bundler.BundleResult, query_display: String) -> InstancesResult =
  match result with
  | bundler.BundleErr _ msg -> InstancesErr(source.strip_entry_names(msg))
  | bundler.BundleOk modules ->
      let prog = bundler.bundle_program(modules)
          ast.Program decls _ = prog
      in match find_probe_query_type(decls) with
         | Nothing -> InstancesErr("instances_in_source: could not resolve query type")
         | Just query_te -> InstancesOk(query_display, instance_match_names_for_type(prog, query_te))

# Reusable end-to-end entry (StartupState-free, so tests and future clients — e.g.
# an LSP hover — can call it directly): resolve the query in the session's naming
# context via a probe signature, bundle, and return the rendered query plus the
# sorted matches.  query_display is the user's original (unqualified) query, so
# the REPL never surfaces the synthetic `app.session.` prefix.  `scratch_dir` is an existing
# directory the caller owns; the probe source is written to `<scratch_dir>/instances.sprout`.
export fn resolve_instances(src: String, query: String, stdlib_root: source.StdlibRoot,
                            scratch_dir: String) -> InstancesResult !{IO} =
  if str_find(src, probe_name) != -1 then
    InstancesErr("source contains reserved name '" ++ probe_name ++ "'; cannot list instances")
  else
    match parse_query_type(query) with
    | Err msg -> InstancesErr(msg)
    | Ok query_display_te ->
        match fs.write_text(probe_source_path, augment_probe_source(src, query)) with
        | Err msg -> InstancesErr("instances_in_source: write_file: " ++ msg)
        | Ok _ ->
            do
              result <- bundler.bundle_file(source.FilePath(probe_source_path), stdlib_root)
              resolve_instances_from_bundle(result, te_to_string(query_display_te))
  where probe_source_path = fspath.join(scratch_dir, "instances.sprout")

fn op_instances_in_source(src: String, query: String, state: StartupState) -> json.Json !{IO} =
  match ensure_scratch_dir(state) with
  | Err msg -> error_response("instances_in_source: " ++ msg)
  | Ok scratch_dir ->
      do
        result <- resolve_instances(src, query, source.StdlibRoot(state_stdlib_root(state)), scratch_dir)
        match result with
        | InstancesErr msg -> error_response(msg)
        | InstancesOk query_type matches ->
            ok_response(json.object_from_pairs([("query_type", json.JsonString(query_type)),
                                                ("matches", string_list_to_json(matches))]))

# ---------------------------------------------------------------------------
# type_of_in_source — infer the type of an expression in a source context
#
# The mechanism lives in compiler.scheme_of_expr_in_source: hover in the LSP needs the
# same answer, and a second copy here is how one question comes to have two answers.
# This function is only the wording of the failures, which is observable — the REPL
# prints these strings.

# First diagnostic's message, or a fallback when the list is empty. Three copies of this
# rendering existed; the fallback string differs per operation, which is why it is a
# parameter rather than a fixed message.
fn first_diag_response(diags: List compiler.Diagnostic, fallback: String) -> json.Json =
  match diags with
  | Nil -> error_response(fallback)
  | [d | _] -> error_response(diag_msg(d))

fn op_type_of_in_source(src: String, expr: String, state: StartupState) -> json.Json !{IO} =
  match compiler.scheme_of_expr_in_source(
      src, expr, source.StdlibRoot(state_stdlib_root(state)), Nil, state_cache(state)) with
  | compiler.ExprCheckFailed diags -> first_diag_response(diags, "type_of_in_source: typecheck failed")
  | compiler.ExprSchemeOk scheme -> ok_response(json.JsonString(types.scheme_to_string(scheme)))

# ---------------------------------------------------------------------------
# eval_expr_in_source — compile and run an expression in a source context
#
# Strategy:
#   1. Infer the expression's type (compiler.scheme_of_expr_in_source).
#   2. Declare a `main` around it in the buffer, chosen by that type:
#      - Pure type T     → main prints its to_string; requires ToString T
#      - Unit !{IO}      → main is the expression (runs the IO action directly)
#      - Other T !{IO}   → error (cannot auto-print effectful non-Unit expressions)
#   3. Compile that program to LLVM IR in memory (compiler.compile_question_ir),
#      reusing the session's LoadEnv (imports edited on disk are re-parsed);
#      `eval_source_path` only names the buffer.
#   4. Write the IR to `<scratch>/eval.ll`.
#   5. Link IR against every runtime object (whole runtime/*.c) with clang, into
#      `<scratch>/eval_bin`.
#   6. Execute the binary, capture stdout, return as a JSON array of lines.
#
# `<scratch>` is the service's private temp dir (`ensure_scratch_dir`), made on the first
# eval or instances request and removed by `shutdown_state`.
# On macOS the -framework flags are added automatically (platform detected via
# `uname`); SPROUT_DARWIN_FRAMEWORKS=1 forces them on regardless of platform.

# Only names the buffer in the bundler's overlay and in diagnostics; nothing is written to it.
let eval_source_path: String = "<repl>"

# Directory holding every runtime .c (sprout_runtime.c, sprout_scheduler.c,
# sprout_poll.c, …).  The whole directory is compiled and linked as a unit:
# object files link wholesale, so a source that references a symbol defined in
# a sibling TU (tcp_* -> scheduler_park_on_fd) only resolves when ALL runtime
# sources are compiled in.  Mirrors the justfile's `runtime/*.c` glob so a
# future runtime split needs zero edits here.
fn runtime_dir(stdlib_root: String) -> String =
  stdlib_root ++ "/../runtime"

# ---------------------------------------------------------------------------
# StartupState — stdlib_root, scratch dir with its compiled runtime objects, and persistent module cache

export type StartupState = StartupState String (Ref Bool) bundler.LoadEnv(Ref (Dict SessionState)) (Ref Int) (Ref (String, String))
  # stdlib_root, runtime objects compiled into the scratch dir, cache, sessions, next_session_id,
  # scratch dir and the token in its `owner` file (both "" = not yet made)

fn state_stdlib_root(state: StartupState) -> String =
  match state with
  | StartupState root _ _ _ _ _ -> root

fn state_compiled_ref(state: StartupState) -> Ref Bool =
  match state with
  | StartupState _ ref _ _ _ _ -> ref

fn state_cache(state: StartupState) -> bundler.LoadEnv =
  match state with
  | StartupState _ _ cache _ _ _ -> cache

fn state_sessions(state: StartupState) -> Ref (Dict SessionState) =
  match state with
  | StartupState _ _ _ sessions _ _ -> sessions

fn state_next_id(state: StartupState) -> Ref Int =
  match state with
  | StartupState _ _ _ _ next_id _ -> next_id

fn state_scratch_ref(state: StartupState) -> Ref (String, String) =
  match state with
  | StartupState _ _ _ _ _ scratch -> scratch

# Create the persistent service state. Runtime object compilation is deferred to
# first eval so the service starts (and answers diagnostics/type-of/hover) even
# when clang is not on PATH.
export fn build_startup_state(stdlib_root: String) -> StartupState !{IO} =
  do
    compiled_ref <- ref_new(false)
    load_env <- bundler.new_load_env()
    sessions <- ref_new(dict_empty())
    next_id <- ref_new(1)
    scratch_ref <- ref_new(("", ""))
    StartupState(stdlib_root, compiled_ref, load_env, sessions, next_id, scratch_ref)

# The scratch dir's path, "" while none has been made.
export fn scratch_dir_of(state: StartupState) -> String !{IO} =
  do
    (dir, _) <- ref_read(state_scratch_ref(state))
    dir

# The file in the scratch dir that holds the token this service wrote there.
fn owner_file(dir: String) -> String =
  fspath.join(dir, "owner")

# Is `dir` the one this service made? Only a dir whose owner file holds `token` is: a dir (or a
# file) put at the same path since is not, nor is one whose owner file cannot be read.
fn owns_scratch_dir(dir: String, token: String) -> Bool !{IO} =
  match fs.read_text(owner_file(dir)) with
  | Ok text -> text == token
  | Err _ -> false

# The service's private temp dir, made on first use so a service that only answers
# diagnostics and type-of never touches the filesystem. The cached dir is checked on each call:
# if it is gone, or is not the one this service made, a new one is made and the other is left
# alone. A failure is that request's error.
fn ensure_scratch_dir(state: StartupState) -> Result String String !{IO} =
  do
    (dir, token) <- ref_read(state_scratch_ref(state))
    if dir != "" && owns_scratch_dir(dir, token) then Ok(dir) else make_scratch_dir(state)

# Writes the token into the new dir; on failure the dir is removed again.
fn write_owner_file(dir: String, token: String) -> Result String Unit !{IO} =
  match fs.write_text(owner_file(dir), token) with
  | Ok _ -> Ok(())
  | Err msg ->
      do
        let _ = fs.remove_dir_all(dir)
        Err("could not make the scratch dir: " ++ msg)

# A new dir holds no runtime objects, so the compiled flag is cleared with it.
fn make_scratch_dir(state: StartupState) -> Result String String !{IO} =
  let dir = try fs_failure("could not make the scratch dir", fs.make_temp_dir("sprout-analysis-"))
      raw = try result_map_error(\_ -> "could not make the scratch dir: no random bytes available",
                                 crypto.random_bytes(16))
      token = crypto.base64url_encode(raw)
      _ = try write_owner_file(dir, token)
  in do
       ref_write(state_scratch_ref(state), (dir, token))
       ref_write(state_compiled_ref(state), false)
       Ok(dir)

# Remove the scratch dir if this service made one, and forget it and the runtime objects inside
# it. A dir at that path that is not ours is left alone. Called when the request stream ends; a
# crash leaves the dir behind.
export fn shutdown_state(state: StartupState) -> Unit !{IO} =
  do
    (dir, token) <- ref_read(state_scratch_ref(state))
    ref_write(state_scratch_ref(state), ("", ""))
    ref_write(state_compiled_ref(state), false)
    if dir != "" && owns_scratch_dir(dir, token) then
      match fs.remove_dir_all(dir) with
      | Ok _ -> ()
      | Err e -> eprint("analysis service: could not remove " ++ dir ++ ": " ++ fs.fs_error_message(e))
    else ()

# Set the flag on the first successful compile so subsequent evals skip the clang -c step.
# A failed compile leaves the objects dir behind, so the flag, not the dir, says it is done.
fn mark_compiled(compiled_ref: Ref Bool) -> Result String Unit !{IO} =
  do
    ref_write(compiled_ref, true)
    Ok(())

# Runs `argv`: `Ok` on exit 0, else `Err` with `prefix` and the reason (the error, or the stderr).
fn run_checked(prefix: String, argv: List String) -> Result String Unit !{IO} =
  match process.proc_run(argv) with
  | Err e -> Err(prefix ++ ": " ++ process.proc_error_message(e))
  | Ok result ->
      if process.proc_ok(result) then Ok(())
      else Err(prefix ++ ": " ++ process.proc_stderr_or(result, "<stderr was not valid UTF-8>"))

fn fs_failure(prefix: String, r: Result fs.FsError a) -> Result String a =
  result_map_error(\e -> prefix ++ ": " ++ fs.fs_error_message(e), r)

# Names in `dir` that end in `suffix`, sorted, so the compile and link order does not depend on
# the filesystem's listing order. Names starting with '.' are dropped: they are editor and OS
# droppings (`._foo.c`, `.#foo.c`), not part of the runtime.
fn sorted_names_ending(dir: String, suffix: String) -> Result fs.FsError (List String) !{IO} =
  result_map(\names -> sort_strings(list_filter(\n -> !string.starts_with(n, ".") && string.ends_with(n, suffix), names)),
             fs.list_dir(dir))

# `foo.c` -> `foo.o`; the caller has already kept only names that end in `.c`.
fn object_name(c_name: String) -> String =
  string.drop_last(c_name, 2) ++ ".o"

fn compile_runtime_sources(rt_dir: String, objs_dir: String, c_names: List String) -> Result String Unit !{IO} =
  match c_names with
  | Nil -> Ok(())
  | Cons name rest ->
      let _ = try run_checked("runtime compile failed",
                ["clang", "-c", fspath.join(rt_dir, name), "-O2", "-o", fspath.join(objs_dir, object_name(name))])
      in compile_runtime_sources(rt_dir, objs_dir, rest)

# Compile every runtime .c in `rt_dir` into its own object under `objs_dir`. There is no `cd`:
# `rt_dir` may be relative, and then resolves against the service's working directory.
fn compile_runtime_objs(rt_dir: String, objs_dir: String, compiled_ref: Ref Bool) -> Result String Unit !{IO} =
  let c_names = try fs_failure("runtime compile failed", sorted_names_ending(rt_dir, ".c"))
      _ = try fs_failure("runtime compile failed", fs.make_dir_all(objs_dir))
      _ = try compile_runtime_sources(rt_dir, objs_dir, c_names)
  in mark_compiled(compiled_ref)

fn ensure_runtime_objs(rt_dir: String, objs_dir: String, compiled_ref: Ref Bool) -> Result String Unit !{IO} =
  do
    compiled <- ref_read(compiled_ref)
    if compiled then Ok(()) else compile_runtime_objs(rt_dir, objs_dir, compiled_ref)

# Link the eval IR against every runtime object in `objs_dir`.
fn link_eval(ir_path: String, objs_dir: String, bin_path: String, use_darwin: Bool) -> Result String Unit !{IO} =
  let o_names = try fs_failure("clang link failed", sorted_names_ending(objs_dir, ".o"))
      frameworks = if use_darwin then ["-framework", "Security", "-framework", "CoreFoundation"] else []
  in run_checked("clang link failed",
       concat_all([["clang", ir_path], list_map(\n -> fspath.join(objs_dir, n), o_names),
                   ["-O2"], frameworks, ["-o", bin_path]]))

# Compile the full runtime into `objs_dir` (once: `compiled_ref` says it is done) and
# link `ir_path` against every runtime object into `bin_path`.  Exported so a
# regression test can drive the real link path: linking only sprout_runtime.o
# leaves scheduler_park_on_fd (defined in sprout_scheduler.c) undefined.
export fn compile_runtime_and_link_eval(
    rt_dir: String, ir_path: String, bin_path: String, objs_dir: String,
    compiled_ref: Ref Bool, use_darwin: Bool) -> Result String Unit !{IO} =
  let _ = try ensure_runtime_objs(rt_dir, objs_dir, compiled_ref)
  in match link_eval(ir_path, objs_dir, bin_path, use_darwin) with
     | Ok _ -> Ok(())
     | Err msg ->
         # The objects may be the cause (removed or aged out of the temp dir), so the next call
         # compiles them again.
         do
           ref_write(compiled_ref, false)
           Err(msg)

fn eval_main_for(type_str: String) -> Maybe compiler.EvalMain =
  if string.ends_with(type_str, " !{IO}") then
    if type_str == "Unit !{IO}" then Just(compiler.RunAction) else Nothing
  else Just(compiler.PrintValue)

fn string_to_json(s: String) -> json.Json = json.JsonString(s)

fn vec_strings_to_json_array(lines: Vec String) -> json.Json =
  json.array_from_list(vec_to_list(vec_map(string_to_json, lines)))

fn eval_output_lines(output: String) -> Vec String =
  if output == "" then vec_empty() else string.string_lines(output)

fn exit_text(e: process.ProcExit) -> String =
  match e with
  | process.Exited code -> "exit " ++ int_to_string(code)
  | process.Signaled sig -> "signal " ++ int_to_string(sig)

fn collect_eval_output(run_result: process.ProcResult) -> json.Json !{IO} =
  if process.proc_ok(run_result) == false then
    error_response("eval_expr_in_source: runtime error (" ++ exit_text(process.proc_exit(run_result)) ++ "): " ++ process.proc_stderr_or(run_result, "<stderr was not valid UTF-8>"))
  else
    # The evaluated program's stdout is USER-CONTROLLED, so it can legitimately not be text. It used
    # to be minted as a String, which took the whole analysis service down when a walker touched it;
    # now a non-text result is REPORTED as output instead of being fatal.
    ok_response(vec_strings_to_json_array(eval_output_lines(string.trim_right(process.proc_stdout_or(run_result, "<eval output was not valid UTF-8>")))))

fn run_eval_binary(bin_path: String) -> json.Json !{IO} =
  match process.proc_run([bin_path]) with
  | Ok run_result -> collect_eval_output(run_result)
  | Err e -> error_response("eval_expr_in_source: could not run the eval binary: " ++ process.proc_error_message(e))

# SPROUT_DARWIN_FRAMEWORKS changes the link line, and so what eval can do, so an invalid value is
# an error for the request rather than something to ignore.
fn env_forces_frameworks() -> Result String Bool !{IO} =
  result_map_error(\_ -> "SPROUT_DARWIN_FRAMEWORKS is not valid UTF-8",
                   result_map(is_just, env.get("SPROUT_DARWIN_FRAMEWORKS")))

fn uname_is_darwin() -> Bool !{IO} =
  match process.proc_run(["uname"]) with
  | Ok r ->
      # `uname` output is ASCII; a child that somehow emitted non-UTF-8 is simply not Darwin.
      string.trim(process.proc_stdout_or(r, "")) == "Darwin"
  | Err _ -> false

# True when the eval binary must link the macOS Security/CoreFoundation
# frameworks (the runtime's TLS/net code needs them).  Detect the platform at
# runtime via `uname` so a fresh macOS checkout works with no env var, mirroring
# the justfile's `os() == "macos"` gate; SPROUT_DARWIN_FRAMEWORKS forces it on.
fn use_darwin_frameworks() -> Result String Bool !{IO} =
  match env_forces_frameworks() with
  | Ok false -> Ok(uname_is_darwin())
  | forced -> forced

fn diag_msg(d: compiler.Diagnostic) -> String =
  match d with
  | compiler.DiagError _ msg -> msg
  | compiler.DiagWarning _ msg -> msg

fn link_and_run_eval(ir_result: compiler.IrFullResult, state: StartupState) -> json.Json !{IO} =
  let compiler.IrFullOk ir_text = ir_result
        else compiler.IrFullFail diags -> first_diag_response(diags, "eval_expr_in_source: codegen failed")
      Ok scratch_dir = ensure_scratch_dir(state)
        else Err msg -> error_response("eval_expr_in_source: " ++ msg)
      ir_path = fspath.join(scratch_dir, "eval.ll")
      bin_path = fspath.join(scratch_dir, "eval_bin")
      Ok _ = fs.write_text(ir_path, ir_text)
        else Err msg -> error_response("eval_expr_in_source: write_file: eval.ll: " ++ msg)
      Ok use_darwin = use_darwin_frameworks()
        else Err msg -> error_response("eval_expr_in_source: " ++ msg)
      Ok _ = compile_runtime_and_link_eval(
               runtime_dir(state_stdlib_root(state)), ir_path, bin_path,
               fspath.join(scratch_dir, "objs"), state_compiled_ref(state), use_darwin)
        else Err msg -> error_response("eval_expr_in_source: " ++ msg)
  in run_eval_binary(bin_path)

fn compile_and_run_eval(src: String, expr: String, how: compiler.EvalMain, state: StartupState) -> json.Json !{IO} =
  do
    ir_result <- compiler.compile_question_ir(src, eval_source_path, expr, how,
      source.StdlibRoot(state_stdlib_root(state)), Nil, state_cache(state))
    link_and_run_eval(ir_result, state)

export fn is_function_scheme(s: types.Scheme) -> Bool =
  match types.scheme_type(s) with
  | types.TFunc _ _ _ _ -> true
  | types.TThunk _ _ -> true
  | _ -> false

export fn is_polymorphic_scheme(s: types.Scheme) -> Bool =
  match types.scheme_vars(s) with
  | Nil -> false
  | _ -> true

export fn fn_display_type_str(type_str: String) -> String =
  if str_starts_with(type_str, "forall ") && dot != -1
  then str_slice(type_str, dot + 2, str_len(type_str))
  else type_str
  where dot = str_find(type_str, ". ")

fn eval_with_scheme(src: String, expr: String, state: StartupState, scheme: types.Scheme) -> json.Json !{IO} =
  if is_function_scheme(scheme) then
    ok_response(vec_strings_to_json_array(vec_singleton("<fn: " ++ fn_display_type_str(type_str) ++ ">")))
  else if is_polymorphic_scheme(scheme) then
    ok_response(vec_strings_to_json_array(vec_singleton("<value: " ++ fn_display_type_str(type_str) ++ ">")))
  else
    match eval_main_for(type_str) with
    | Nothing -> error_response("eval_expr_in_source: cannot auto-print effectful non-Unit expression of type: " ++ type_str)
    | Just how -> compile_and_run_eval(src, expr, how, state)
  where type_str = types.scheme_to_string(scheme)

# Evaluation needs the Scheme itself, not its rendering: it branches on function /
# polymorphic / effectful to decide how to print the value. That is why the shared core
# returns a Scheme and the string form is a wrapper over it.
fn op_eval_expr_in_source(src: String, expr: String, state: StartupState) -> json.Json !{IO} =
  match compiler.scheme_of_expr_in_source(
      src, expr, source.StdlibRoot(state_stdlib_root(state)), Nil, state_cache(state)) with
  | compiler.ExprCheckFailed diags -> first_diag_response(diags, "eval_expr_in_source: typecheck failed")
  | compiler.ExprSchemeOk scheme -> eval_with_scheme(src, expr, state, scheme)

# ---------------------------------------------------------------------------
# Session ops (M2)

fn compile_fail_response(diags: List compiler.Diagnostic) -> json.Json =
  first_diag_response(diags, "type check failed")

fn op_session_create(state: StartupState) -> json.Json !{IO} =
  do
    sessions <- ref_read(state_sessions(state))
    next_id <- ref_read(state_next_id(state))
    ref_write(state_sessions(state), dict_set(int_to_string(next_id), SessionState(vec_empty(), vec_empty()), sessions))
    ref_write(state_next_id(state), next_id + 1)
    ok_response(json.JsonInt(next_id))

fn op_session_destroy(req: json.Json, state: StartupState) -> json.Json !{IO} =
  match require_int_field(req, "session_id") with
  | Err msg -> error_response(msg)
  | Ok session_id ->
      do
        sessions <- ref_read(state_sessions(state))
        ref_write(state_sessions(state), dict_remove(int_to_string(session_id), sessions))
        ok_response(json.JsonBool(true))

fn op_session_update(req: json.Json, state: StartupState) -> json.Json !{IO} =
  do
    let Ok session_id = require_int_field(req, "session_id") else Err msg -> error_response(msg)
    let Ok kind = require_string_field(req, "kind") else Err msg -> error_response(msg)
    let Ok line = require_string_field(req, "line") else Err msg -> error_response(msg)
    sessions <- ref_read(state_sessions(state))
    match dict_get(int_to_string(session_id), sessions) with
    | Nothing -> error_response("unknown session: " ++ int_to_string(session_id))
    | Just sess ->
        do
          let new_sess = session_add_line(sess, kind, line)
          let check_src = rebuild_session_source(new_sess)
          check_result <- compiler.compile_source_with_cache(check_src, source.StdlibRoot(state_stdlib_root(state)), state_cache(state))
          match check_result with
          | compiler.CompileFail diags -> compile_fail_response(diags)
          | compiler.CompileOk _ ->
              do
                ref_write(state_sessions(state), dict_set(int_to_string(session_id), new_sess, sessions))
                ok_response(json.JsonBool(true))

fn session_or_error(session_id: Int, sessions: Dict SessionState) -> Result json.Json SessionState =
  match dict_get(int_to_string(session_id), sessions) with
  | Nothing -> Err(error_response("unknown session: " ++ int_to_string(session_id)))
  | Just sess -> Ok(sess)

fn op_session_eval(req: json.Json, state: StartupState) -> json.Json !{IO} =
  do
    let Ok session_id = require_int_field(req, "session_id") else Err msg -> error_response(msg)
    let Ok expr = require_string_field(req, "expr") else Err msg -> error_response(msg)
    sessions <- ref_read(state_sessions(state))
    let Ok sess = session_or_error(session_id, sessions) else Err resp -> resp
    op_eval_expr_in_source(rebuild_session_source(sess), expr, state)

fn op_session_type_of(req: json.Json, state: StartupState) -> json.Json !{IO} =
  do
    let Ok session_id = require_int_field(req, "session_id") else Err msg -> error_response(msg)
    let Ok expr = require_string_field(req, "expr") else Err msg -> error_response(msg)
    sessions <- ref_read(state_sessions(state))
    let Ok sess = session_or_error(session_id, sessions) else Err resp -> resp
    op_type_of_in_source(rebuild_session_source(sess), expr, state)

fn op_session_diagnostics(req: json.Json, state: StartupState) -> json.Json !{IO} =
  do
    let Ok session_id = require_int_field(req, "session_id") else Err msg -> error_response(msg)
    sessions <- ref_read(state_sessions(state))
    let Ok sess = session_or_error(session_id, sessions) else Err resp -> resp
    op_diagnostics_in_source(rebuild_session_source(sess), state)

# ---------------------------------------------------------------------------
# Request dispatch

# The error for a semantic op when the service runs without a stdlib root.
fn missing_stdlib_root(state: StartupState) -> Maybe json.Json =
  if state_stdlib_root(state) == ""
  then Just(error_response("stdlib-root not configured for semantic ops"))
  else Nothing

# The handler for an op that reads `module_source`, given that source; Nothing for
# any other op. One chain, so an op cannot be listed here and handled nowhere.
fn source_op(op: String, req: json.Json,
             state: StartupState) -> Maybe (String -> json.Json !{IO}) =
  if op == "check_source" then Just(checked_source(state, _))
  else if op == "diagnostics_in_source" then Just(source_diagnostics(state, _))
  else if op == "declared_names_in_source" then Just(op_declared_names_in_source)
  else if op == "exported_names_in_source" then Just(op_exported_names_in_source)
  else if op == "symbol_inventory_in_source" then Just(op_symbol_inventory_in_source)
  else if op == "symbol_locations_in_source" then Just(op_symbol_locations_in_source)
  else if op == "type_of_in_source" then Just(semantic_with_field("expr", op_type_of_in_source, req, state, _))
  else if op == "instances_in_source" then Just(semantic_with_field("query", op_instances_in_source, req, state, _))
  else if op == "eval_expr_in_source" then Just(semantic_with_field("expr", op_eval_expr_in_source, req, state, _))
  else Nothing

fn checked_source(state: StartupState, src: String) -> json.Json !{IO} =
  do
    let Nothing = missing_stdlib_root(state) else Just resp -> resp
    op_check_source(src, state)

fn source_diagnostics(state: StartupState, src: String) -> json.Json !{IO} =
  if state_stdlib_root(state) == "" then empty_diags_response()
  else op_diagnostics_in_source(src, state)

# A semantic op over `src` that also reads string field `field`: a missing
# field is reported before a missing stdlib root.
fn semantic_with_field(field: String, run: String -> String -> StartupState -> json.Json !{IO},
                       req: json.Json, state: StartupState, src: String) -> json.Json !{IO} =
  do
    let Ok value = require_string_field(req, field) else Err msg -> error_response(msg)
    let Nothing = missing_stdlib_root(state) else Just resp -> resp
    run(src, value, state)

fn dispatch_op(op: String, req: json.Json, state: StartupState) -> json.Json !{IO} =
  match source_op(op, req, state) with
  | Just handle ->
      do
        let Ok src = require_string_field(req, "module_source") else Err msg -> error_response(msg)
        handle(src)
  | Nothing -> dispatch_session_op(op, req, state)

fn dispatch_session_op(op: String, req: json.Json, state: StartupState) -> json.Json !{IO} =
  if op == "complete_in_state" then not_implemented(op)
  else if op == "session_create" then op_session_create(state)
  else if op == "session_update" then op_session_update(req, state)
  else if op == "session_eval" then op_session_eval(req, state)
  else if op == "session_type_of" then op_session_type_of(req, state)
  else if op == "session_diagnostics" then op_session_diagnostics(req, state)
  else if op == "session_destroy" then op_session_destroy(req, state)
  else error_response(string.concat("unknown op: ", op))

fn dispatch(req: json.Json, state: StartupState) -> json.Json !{IO} =
  match json.json_get_field(req, "op") with
  | Nothing -> error_response("missing 'op' field")
  | Just op_val ->
      match json.json_get_string(op_val) with
      | Nothing -> error_response("'op' must be a string")
      | Just op -> dispatch_op(op, req, state)

export fn dispatch_line(line: String, state: StartupState) -> json.Json !{IO} =
  match json.parse(line) with
  | Err err -> error_response("invalid JSON: " ++ json.json_error_message(err))
  | Ok req -> dispatch(req, state)

# Responses are built from strings, ints and bools, so `stringify` cannot refuse one. The
# fallback answers with the same error shape rather than nothing, so a client reading one line
# per request stays in step.
# The fallback is a fixed literal, not the error text: it is hand-built JSON, so interpolating
# anything into it would rest on that text never containing a quote or a backslash.
fn response_text(response: json.Json) -> String =
  match json.stringify(response) with
  | Ok text -> text
  | Err _ -> "{\"ok\":false,\"error\":\"internal: response held a value that cannot be encoded as JSON\"}"

# ---------------------------------------------------------------------------
# Service loop

fn service_loop(state: StartupState) -> Unit !{IO} =
  match terminal.term_read_line() with
  | Ok Nothing -> shutdown_state(state)
  | Ok (Just line) ->
      if string.is_empty(line) then service_loop(state)
      else
        do
          response <- dispatch_line(line, state)
          terminal.write(response_text(response) ++ "\n")
          service_loop(state)
  # A request line that is not valid UTF-8 is a malformed request like invalid JSON: it is
  # answered with an error and the next line is read, so a client reading one reply per request
  # stays in step.
  | Err _ ->
      do
        terminal.write(response_text(error_response("invalid request: not valid UTF-8")) ++ "\n")
        service_loop(state)

export fn run_service(stdlib_root: String) -> Unit !{IO} =
  do
    state <- build_startup_state(stdlib_root)
    service_loop(state)

