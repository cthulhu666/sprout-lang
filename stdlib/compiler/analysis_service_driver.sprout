module stdlib.compiler.analysis_service_driver
import stdlib.json as json
import stdlib.compiler.compiler as compiler
import stdlib.compiler.bundler as bundler
import stdlib.compiler.module_loader as module_loader
import stdlib.compiler.lexer as lexer
import stdlib.compiler.parser as parser
import stdlib.compiler.ast as ast
import stdlib.compiler.source as source
import stdlib.compiler.types as types
import stdlib.compiler.infer as infer
import stdlib.compiler.unifier as unifier
import stdlib.string as string
import stdlib.process as process
import stdlib.terminal as terminal
import stdlib.fs as fs
import stdlib.env as env

# ---------------------------------------------------------------------------
# Header stripping is source.strip_headers (line-preserving): stripped lines
# become blank lines, so parsed positions keep original line numbers and no
# header-line offset needs adding back.

# ---------------------------------------------------------------------------
# SessionState — server-side per-session state (M2)

export type SessionState (..) = SessionState(Vec String) (Vec String)
  # imports, declarations

export fn session_add_line(sess: SessionState, kind: String, line: String) -> SessionState =
  match sess with
  | SessionState imports declarations ->
      if kind == "import" then SessionState(vec_append(line, imports), declarations)
      else
        # Redefining a top-level name REPLACES the prior declaration instead of
        # appending a duplicate: two declarations of the same name would emit two
        # `define @app.session.<name>` blocks and fail to link at eval time. Drop
        # any stored declaration whose names overlap the incoming line's, then
        # append. An unparseable line yields no names → nothing dropped (append).
        let new_names = parse_decl_names(line)
        in SessionState(imports,
             vec_append(line,
               vec_filter(\d -> decl_names_disjoint(parse_decl_names(d), new_names), declarations)))

# True when two declaration-name lists share no name.
fn decl_names_disjoint(a: List String, b: List String) -> Bool =
  match a with
  | Nil -> true
  | Cons x rest -> if list_member(x, b) then false else decl_names_disjoint(rest, b)

fn build_source_parts(header: String, imports: Vec String, declarations: Vec String) -> String =
  if vec_length(declarations) == 0 then with_imports
  else with_imports ++ "\n\n" ++ string.join("\n\n", declarations)
  where with_imports =
    if vec_length(imports) == 0 then header
    else header ++ "\n\n" ++ string.join("\n\n", imports)

export fn rebuild_session_source(sess: SessionState) -> String =
  match sess with
  | SessionState imports declarations ->
      build_source_parts("module app.session", imports, declarations)

# ---------------------------------------------------------------------------
# JSON response construction

fn ok_response(value: json.Json) -> json.Json =
  json.JsonObject(
    json.JsonObjectCons("ok", json.JsonBool(true),
    json.JsonObjectCons("value", value,
    json.JsonObjectNil)))

fn error_response(msg: String) -> json.Json =
  json.JsonObject(
    json.JsonObjectCons("ok", json.JsonBool(false),
    json.JsonObjectCons("error", json.JsonString(msg),
    json.JsonObjectNil)))

fn string_list_to_json(xs: List String) -> json.Json =
  json.array_from_list(list_map(json.string, xs))

fn int_list_to_json(xs: List Int) -> json.Json =
  json.array_from_list(list_map(json.int, xs))

fn not_implemented(op_name: String) -> json.Json =
  error_response(string.concat("not yet implemented in self-hosted analysis service: ", op_name))

fn empty_diags_response() -> json.Json =
  ok_response(json.JsonObject(
    json.JsonObjectCons("messages", json.array_from_list(Nil),
    json.JsonObjectCons("lines", json.array_from_list(Nil),
    json.JsonObjectCons("columns", json.array_from_list(Nil),
    json.JsonObjectNil)))))

fn require_string_field(req: json.Json, field: String) -> Result String String =
  match json.json_get_field(req, field) with
  | Nothing -> Err(string.concat("missing field: ", field))
  | Just v ->
      match json.json_get_string(v) with
      | Nothing -> Err(string.concat("field must be a string: ", field))
      | Just s -> Ok(s)

fn require_int_field(req: json.Json, field: String) -> Result String Int =
  match json.json_get_field(req, field) with
  | Nothing -> Err(string.concat("missing field: ", field))
  | Just v ->
      match json.json_get_int(v) with
      | Nothing -> Err(string.concat("field must be an integer: ", field))
      | Just n -> Ok(n)

# ---------------------------------------------------------------------------
# AST name extraction

# Names a session declaration introduces, for redefinition detection. VALUE names
# come from ast.decl_value_scopes — the single authority — so an extern is excluded
# here because it is ScopeGlobal, not because this site says so. Type-level names
# are a separate axis the authority does not cover, and are added alongside.
fn collect_decl_names(decls: List ast.Decl, acc: List String) -> List String =
  match decls with
  | Nil -> list_reverse(acc)
  | Cons d rest ->
      collect_decl_names(rest,
        prepend_names(ast.scope_names_module(ast.decl_value_scopes(d)), decl_type_names(d, acc)))

fn prepend_names(names: List String, acc: List String) -> List String =
  match names with
  | Nil -> acc
  | Cons name rest -> prepend_names(rest, Cons(name, acc))

# The type/class-level name a declaration introduces, if any.
fn decl_type_names(d: ast.Decl, acc: List String) -> List String =
  match d with
  | ast.TypeDecl name _ _ _ _ _ -> Cons(name, acc)
  | ast.RecordDecl name _ _ _ _ _ -> Cons(name, acc)
  | ast.ClassDecl name _ _ _ _ -> Cons(name, acc)
  | ast.AliasDecl name _ _ _ -> Cons(name, acc)
  | ast.WrapDecl name _ _ -> acc  # its name is already a value name (the ctor)
  | _ -> acc

fn parse_decl_names(src: String) -> List String =
  match lexer.tokenize(source.strip_headers(src)) with
  | Err _ -> Nil
  | Ok tokens ->
      match parser.parse_program(tokens) with
      | Err _ -> Nil
      | Ok prog ->
          match prog with
          | ast.Program decls _ -> collect_decl_names(decls, Nil)

# ---------------------------------------------------------------------------
# Symbol location extraction

fn collect_decl_locations(
  decls: List ast.Decl,
  line_offset: Int,
  categories: List String,
  names: List String,
  lines: List Int,
  cols: List Int
) -> (List String, List String, List Int, List Int) =
  match decls with
  | Nil ->
      (list_reverse(categories), list_reverse(names), list_reverse(lines), list_reverse(cols))
  | Cons d rest ->
      match d with
      | ast.FnDecl name _ _ _ _ _ pos ->
          collect_decl_locations(rest, line_offset,
            Cons("fn", categories), Cons(name, names),
            Cons(source.position_line(pos) + line_offset, lines),
            Cons(source.position_column(pos), cols))
      | ast.TypeDecl name _ _ _ _ pos ->
          collect_decl_locations(rest, line_offset,
            Cons("type", categories), Cons(name, names),
            Cons(source.position_line(pos) + line_offset, lines),
            Cons(source.position_column(pos), cols))
      | ast.RecordDecl name _ _ _ _ pos ->
          collect_decl_locations(rest, line_offset,
            Cons("type", categories), Cons(name, names),
            Cons(source.position_line(pos) + line_offset, lines),
            Cons(source.position_column(pos), cols))
      | ast.LetDecl name _ _ pos ->
          collect_decl_locations(rest, line_offset,
            Cons("let", categories), Cons(name, names),
            Cons(source.position_line(pos) + line_offset, lines),
            Cons(source.position_column(pos), cols))
      | ast.ClassDecl name _ _ _ pos ->
          collect_decl_locations(rest, line_offset,
            Cons("class", categories), Cons(name, names),
            Cons(source.position_line(pos) + line_offset, lines),
            Cons(source.position_column(pos), cols))
      | ast.InstanceDecl _ _ _ _ ->
          collect_decl_locations(rest, line_offset, categories, names, lines, cols)
      | ast.AliasDecl name _ _ pos ->
          collect_decl_locations(rest, line_offset,
            Cons("alias", categories), Cons(name, names),
            Cons(source.position_line(pos) + line_offset, lines),
            Cons(source.position_column(pos), cols))
      | ast.WrapDecl name _ pos ->
          collect_decl_locations(rest, line_offset,
            Cons("type", categories), Cons(name, names),
            Cons(source.position_line(pos) + line_offset, lines),
            Cons(source.position_column(pos), cols))
      | ast.ExternFnDecl _ _ _ _ _ ->
          collect_decl_locations(rest, line_offset, categories, names, lines, cols)

fn empty_locations_json() -> json.Json =
  ok_response(json.JsonObject(
    json.JsonObjectCons("categories", json.array_from_list(Nil),
    json.JsonObjectCons("names", json.array_from_list(Nil),
    json.JsonObjectCons("lines", json.array_from_list(Nil),
    json.JsonObjectCons("columns", json.array_from_list(Nil),
    json.JsonObjectNil))))))

fn parse_symbol_locations(src: String) -> json.Json =
  match lexer.tokenize(source.strip_headers(src)) with
  | Err _ -> empty_locations_json()
  | Ok tokens ->
      match parser.parse_program(tokens) with
      | Err _ -> empty_locations_json()
      | Ok prog ->
          match prog with
          | ast.Program decls _ ->
              match collect_decl_locations(decls, 0, Nil, Nil, Nil, Nil) with
              | (cats, loc_names, loc_lines, loc_cols) ->
                  ok_response(json.JsonObject(
                    json.JsonObjectCons("categories", string_list_to_json(cats),
                    json.JsonObjectCons("names", string_list_to_json(loc_names),
                    json.JsonObjectCons("lines", int_list_to_json(loc_lines),
                    json.JsonObjectCons("columns", int_list_to_json(loc_cols),
                    json.JsonObjectNil))))))

# ---------------------------------------------------------------------------
# Import name extraction (for symbol_inventory imported list)

fn import_spec_names(spec: module_loader.ImportSpec) -> List String =
  match spec with
  | module_loader.ImportAlias _ alias -> Cons(alias, Nil)
  | module_loader.ImportSelective _ names -> names

fn collect_import_names(specs: List module_loader.ImportSpec, acc: List String) -> List String =
  match specs with
  | Nil -> list_reverse(acc)
  | Cons s rest ->
      collect_import_names(rest, list_append(list_reverse(import_spec_names(s)), acc))

fn exported_names_from_src(src: String) -> List String =
  match bundler.scan_source_info(src) with
  | (_, exported, _) -> exported

# ---------------------------------------------------------------------------
# Diagnostic formatting

fn collect_diag_fields(
  diags: List compiler.Diagnostic,
  msgs: List String,
  lines: List Int,
  cols: List Int
) -> (List String, List Int, List Int) =
  match diags with
  | Nil -> (list_reverse(msgs), list_reverse(lines), list_reverse(cols))
  | Cons d rest ->
      match d with
      | compiler.DiagError pos msg ->
          match pos with
          | source.SourcePos _ line col ->
              collect_diag_fields(rest, Cons(msg, msgs), Cons(line, lines), Cons(col, cols))
      | compiler.DiagWarning pos msg ->
          match pos with
          | source.SourcePos _ line col ->
              collect_diag_fields(rest, Cons(msg, msgs), Cons(line, lines), Cons(col, cols))

fn diags_to_json(diags: List compiler.Diagnostic) -> json.Json =
  match collect_diag_fields(diags, Nil, Nil, Nil) with
  | (msgs, diag_lines, diag_cols) ->
      ok_response(json.JsonObject(
        json.JsonObjectCons("messages", string_list_to_json(msgs),
        json.JsonObjectCons("lines", int_list_to_json(diag_lines),
        json.JsonObjectCons("columns", int_list_to_json(diag_cols),
        json.JsonObjectNil)))))

# ---------------------------------------------------------------------------
# instances_in_source — list the typeclass instances whose head type matches a
# query type.  The instance universe is the *bundled* program (prelude +
# transitive imports + session), so `:i String` surfaces the prelude's Eq/Ord/…
# instances, not just session-local ones.
#
# Matching reuses the real type machinery — no bespoke subset:
#   - the query and each instance head are elaborated to types via
#     infer.type_from_ast (which expands aliases when given the alias env), and
#   - a match is an *unification* success (unifier.unify_types), with the
#     instance head's type variables made fresh so `Eq (List a)` matches a
#     concrete `List Int` query.
# An applied query (`Maybe a`) additionally tries its outermost constructor
# (`Maybe`), so higher-kinded instances (`Functor Maybe`) also show up.

# A TypeName is a type *variable* iff it is unqualified (no module dot) and
# starts lowercase.  Bundled user constructors carry a dotted module prefix and
# prelude constructors start uppercase, so both stay rigid.
fn name_starts_lower(name: String) -> Bool =
  match str_char_at(name, 0) with
  | Nothing -> false
  | Just c -> c >= 'a' && c <= 'z'

fn is_tyvar_name(name: String) -> Bool =
  str_find(name, ".") == -1 && name_starts_lower(name)

fn te_var_names(te: ast.TypeExpr, acc: List String) -> List String =
  match te with
  | ast.TypeName name -> if is_tyvar_name(name) then Cons(name, acc) else acc
  | ast.TypeApply base arg -> te_var_names(arg, te_var_names(base, acc))
  | ast.TypeArrow l r _ -> te_var_names(r, te_var_names(l, acc))
  | ast.TypeEffect inner _ -> te_var_names(inner, acc)
  | ast.TupleType parts -> te_var_names_list(parts, acc)

fn te_var_names_list(parts: List ast.TypeExpr, acc: List String) -> List String =
  match parts with
  | Nil -> acc
  | Cons h t -> te_var_names_list(t, te_var_names(h, acc))

# Bind each free type-var name to a fresh TVar over the alias env.  The name is
# unique enough: each unify starts from an empty substitution, so cross-instance
# names never collide.
fn bind_fresh_vars(names: List String, env: Dict types.Type) -> Dict types.Type =
  match names with
  | Nil -> env
  | Cons name rest ->
      bind_fresh_vars(rest, dict_set(name, types.TVar(types.tyvar_id(name)), env))

fn te_to_type(te: ast.TypeExpr, alias_env: Dict types.Type) -> types.Type =
  infer.type_from_ast(te, bind_fresh_vars(te_var_names(te, Nil), alias_env))

# Nullary type aliases → their expansion, mirroring infer.pre_scan_fn_decls so
# `:i SomeAlias` resolves through the alias.  Parametric aliases are rare in REPL
# queries and are left unexpanded.
fn collect_alias_env(decls: List ast.Decl, acc: Dict types.Type) -> Dict types.Type =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | ast.AliasDecl name Nil rhs _ ->
          collect_alias_env(rest, dict_set(name, infer.type_from_ast(rhs, dict_empty()), acc))
      | _ -> collect_alias_env(rest, acc)

# --- Type-expression rendering (mirrors the reference: compound args parenthesized) ---

fn te_is_compound(te: ast.TypeExpr) -> Bool =
  match te with
  | ast.TypeApply _ _ -> true
  | ast.TypeArrow _ _ _ -> true
  | ast.TypeEffect _ _ -> true
  | _ -> false

fn effect_suffix(labels: List String) -> String =
  match labels with
  | Nil -> ""
  | _ -> " !{" ++ string.join(", ", labels) ++ "}"

fn arrow_effect_suffix(effs: Maybe (List String)) -> String =
  match effs with
  | Nothing -> ""
  | Just labels -> effect_suffix(labels)

# Display-only renderer: TypeNames print by their last dotted segment, so a
# bundled instance head `app.session.Color` shows as `Color` (matching how the
# user typed the query).  Never feeds matching — that runs on the raw types.
fn te_to_string(te: ast.TypeExpr) -> String =
  match te with
  | ast.TypeName name -> string.after_last_dot(name)
  | ast.TypeApply base arg -> te_to_string(base) ++ " " ++ te_arg_to_string(arg)
  | ast.TypeArrow l r effs -> te_arrow_left(l) ++ " -> " ++ te_to_string(r) ++ arrow_effect_suffix(effs)
  | ast.TypeEffect inner effs -> te_to_string(inner) ++ effect_suffix(effs)
  | ast.TupleType parts -> "(" ++ string.join(", ", te_to_string_list(parts)) ++ ")"

fn te_arg_to_string(te: ast.TypeExpr) -> String =
  if te_is_compound(te) then "(" ++ te_to_string(te) ++ ")" else te_to_string(te)

fn te_arrow_left(l: ast.TypeExpr) -> String =
  match l with
  | ast.TypeArrow _ _ _ -> "(" ++ te_to_string(l) ++ ")"
  | _ -> te_to_string(l)

fn te_to_string_list(parts: List ast.TypeExpr) -> List String =
  match parts with
  | Nil -> Nil
  | Cons h t -> Cons(te_to_string(h), te_to_string_list(t))

# --- Matching ---

fn te_outermost_base(te: ast.TypeExpr) -> ast.TypeExpr =
  match te with
  | ast.TypeApply base _ -> te_outermost_base(base)
  | _ -> te

fn te_is_apply(te: ast.TypeExpr) -> Bool =
  match te with
  | ast.TypeApply _ _ -> true
  | _ -> false

fn unify_ok(a: types.Type, b: types.Type) -> Bool =
  # no_effect_subst: a yes/no "do these two types unify" probe for type search.
  # Nothing downstream reads a substitution, let alone an effect one.
  match unifier.unify_types(dict_empty(), unifier.no_effect_subst(), a, b) with
  | unifier.UnifyOk _ _ -> true
  | unifier.UnifyErr _ -> false

fn te_matches_query(pattern: ast.TypeExpr, query_te: ast.TypeExpr, alias_env: Dict types.Type) -> Bool =
  if unify_ok(te_to_type(pattern, alias_env), te_to_type(query_te, alias_env)) then true
  else if te_is_apply(query_te)
  then unify_ok(te_to_type(pattern, alias_env), te_to_type(te_outermost_base(query_te), alias_env))
  else false

fn render_match(class_name: String, arg: ast.TypeExpr) -> String =
  class_name ++ " " ++ te_arg_to_string(arg)

# Single-parameter instances only (mirrors the reference), matched head-vs-query.
fn collect_matches(decls: List ast.Decl, query_te: ast.TypeExpr, alias_env: Dict types.Type, acc: List String) -> List String =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | ast.InstanceDecl constraint _ _ _ ->
          match constraint with
          | ast.TypeConstraint class_name args ->
              match args with
              | [arg] ->
                  if te_matches_query(arg, query_te, alias_env)
                  then collect_matches(rest, query_te, alias_env, Cons(render_match(class_name, arg), acc))
                  else collect_matches(rest, query_te, alias_env, acc)
              | _ -> collect_matches(rest, query_te, alias_env, acc)
      | _ -> collect_matches(rest, query_te, alias_env, acc)

fn insert_sorted(x: String, sorted: List String) -> List String =
  match sorted with
  | Nil -> Cons(x, Nil)
  | Cons h t ->
      if str_compare(x, h) <= 0 then Cons(x, Cons(h, t))
      else Cons(h, insert_sorted(x, t))

fn sort_strings(xs: List String) -> List String =
  match xs with
  | Nil -> Nil
  | Cons h t -> insert_sorted(h, sort_strings(t))

fn parse_query_type(query: String) -> Result String ast.TypeExpr =
  match lexer.tokenize(query) with
  | Err _ -> Err("could not parse type query: " ++ query)
  | Ok tokens ->
      match parser.parse_type_expr(tokens, 0) with
      | Err _ -> Err("could not parse type query: " ++ query)
      | Ok pair ->
          match pair with
          | (te, _) -> Ok(te)

# Pure core: sorted "<Class> <head>" descriptions for every single-parameter
# instance in `prog` whose head unifies with the (already name-resolved) query.
export fn instance_match_names_for_type(prog: ast.Program, query_te: ast.TypeExpr) -> List String =
  match prog with
  | ast.Program decls _ ->
      sort_strings(collect_matches(decls, query_te, collect_alias_env(decls, dict_empty()), Nil))

# String-query convenience: parse the query directly (no session name-resolution)
# and return the rendered query alongside the matches.  Used where the query
# needs no module-qualified resolution (e.g. unit tests over synthetic programs).
export fn instance_matches_in_program(prog: ast.Program, query: String) -> Result String (String, List String) =
  match parse_query_type(query) with
  | Err msg -> Err(msg)
  | Ok query_te -> Ok((te_to_string(query_te), instance_match_names_for_type(prog, query_te)))

# ---------------------------------------------------------------------------
# Op handlers

fn op_check_source(src: String, state: StartupState) -> json.Json !{IO} =
  do
    result <- compiler.compile_source_with_cache(src, source.StdlibRoot(state_stdlib_root(state)), state_cache(state))
    match result with
    | compiler.CompileOk _ -> ok_response(json.JsonNull)
    | compiler.CompileFail diags ->
        match diags with
        | Nil -> error_response("check failed")
        | [d | _] ->
            match d with
            | compiler.DiagError _ msg -> error_response(msg)
            | compiler.DiagWarning _ msg -> error_response(msg)

fn op_diagnostics_in_source(src: String, state: StartupState) -> json.Json !{IO} =
  do
    result <- compiler.compile_source_with_cache(src, source.StdlibRoot(state_stdlib_root(state)), state_cache(state))
    match result with
    | compiler.CompileOk _ -> empty_diags_response()
    | compiler.CompileFail diags -> diags_to_json(diags)

fn op_declared_names_in_source(src: String) -> json.Json =
  ok_response(string_list_to_json(parse_decl_names(src)))

fn op_exported_names_in_source(src: String) -> json.Json =
  ok_response(string_list_to_json(exported_names_from_src(src)))

fn op_symbol_inventory_in_source(src: String) -> json.Json =
  ok_response(json.JsonObject(
    json.JsonObjectCons("declared", string_list_to_json(parse_decl_names(src)),
    json.JsonObjectCons("imported", string_list_to_json(collect_import_names(module_loader.collect_imports(src), Nil)),
    json.JsonObjectCons("exported", string_list_to_json(exported_names_from_src(src)),
    json.JsonObjectNil)))))

fn op_symbol_locations_in_source(src: String) -> json.Json =
  parse_symbol_locations(src)

# Bundle the session source (inlining prelude + transitive imports) so every
# instance is in scope, then match against the query.  A fixed /tmp path is fine:
# the REPL is interactive, one request at a time (same rationale as the eval path).
fn instances_source_path() -> String = "/tmp/sprout_instances_repl.sprout"

# The query is resolved in the *session's* naming context by appending a probe
# signature `fn <probe>(__x: <query>) -> Int = 0` and reading back its parameter
# type after bundling.  Bundling qualifies the probe's param type exactly as it
# qualifies instance heads (e.g. a session type `Color` → `app.session.Color`),
# so a session-local `:i Color` matches its own instances.  Mirrors the
# pre-self-hosting analysis backend's probe-based resolution.
fn probe_name() -> String = "__sprout_instances_probe"

fn augment_probe_source(src: String, query: String) -> String =
  src ++ "\n\nfn " ++ probe_name() ++ "(__x: " ++ query ++ ") -> Int = 0"

fn first_param_type(params: List ast.Param) -> Maybe ast.TypeExpr =
  match params with
  | Nil -> Nothing
  | [p | _] -> match p with | ast.Param _ mty _ -> mty

fn find_probe_query_type(decls: List ast.Decl) -> Maybe ast.TypeExpr =
  match decls with
  | Nil -> Nothing
  | Cons d rest ->
      match d with
      | ast.FnDecl name params _ _ _ _ _ ->
          if name == probe_name() || string.ends_with(name, "." ++ probe_name())
          then first_param_type(params)
          else find_probe_query_type(rest)
      | _ -> find_probe_query_type(rest)

# Own result ADT (not `Result`): a `Result`/`Maybe` return gets its wrapper
# stripped when bound with `<-` in a caller's do-block, so the driver's IO seams
# use custom ADTs (cf. CompileResult / BundleResult) that bind whole.
export type InstancesResult (..) =
  | InstancesOk String (List String)
  | InstancesErr String

fn resolve_instances_from_bundle(result: bundler.BundleResult, query_display: String) -> InstancesResult =
  match result with
  | bundler.BundleErr _ msg -> InstancesErr(msg)
  | bundler.BundleOk prog ->
      match prog with
      | ast.Program decls _ ->
          match find_probe_query_type(decls) with
          | Nothing -> InstancesErr("instances_in_source: could not resolve query type")
          | Just query_te -> InstancesOk(query_display, instance_match_names_for_type(prog, query_te))

# Reusable end-to-end entry (StartupState-free, so tests and future clients — e.g.
# an LSP hover — can call it directly): resolve the query in the session's naming
# context via a probe signature, bundle, and return the rendered query plus the
# sorted matches.  query_display is the user's original (unqualified) query, so
# the REPL never surfaces the synthetic `app.session.` prefix.
export fn resolve_instances(src: String, query: String, stdlib_root: source.StdlibRoot) -> InstancesResult !{IO} =
  if str_find(src, probe_name()) != -1 then
    InstancesErr("source contains reserved name '" ++ probe_name() ++ "'; cannot list instances")
  else
    match parse_query_type(query) with
    | Err msg -> InstancesErr(msg)
    | Ok query_display_te ->
        match fs.write_text(instances_source_path(), augment_probe_source(src, query)) with
        | Err msg -> InstancesErr("instances_in_source: write_file: " ++ msg)
        | Ok _ ->
            do
              result <- bundler.bundle_file(source.FilePath(instances_source_path()), stdlib_root)
              resolve_instances_from_bundle(result, te_to_string(query_display_te))

fn op_instances_in_source(src: String, query: String, state: StartupState) -> json.Json !{IO} =
  do
    result <- resolve_instances(src, query, source.StdlibRoot(state_stdlib_root(state)))
    match result with
    | InstancesErr msg -> error_response(msg)
    | InstancesOk query_type matches ->
        ok_response(json.JsonObject(
          json.JsonObjectCons("query_type", json.JsonString(query_type),
          json.JsonObjectCons("matches", string_list_to_json(matches),
          json.JsonObjectNil))))

# ---------------------------------------------------------------------------
# type_of_in_source — infer the type of an expression in a source context
#
# Strategy (mirrors Python's infer_type_in_source):
#   1. Append a sentinel let-binding to the source:
#        let __repl_source_value = <expr>
#   2. Run compile_source_with_root on the augmented source.
#   3. Look up "__repl_source_value" in the resulting env.
#   4. Render the Scheme with types.scheme_to_string.
#
# The sentinel name is unlikely to collide with user code, but double-underscore
# names ARE valid Sprout identifiers (the lexer accepts _ as identifier-start).
# augment_source guards against the collision explicitly.

fn sentinel_name() -> String = "__repl_source_value"

fn augment_source(src: String, expr: String) -> String =
  src ++ "\nlet " ++ sentinel_name() ++ " = " ++ expr

fn op_type_of_in_source(src: String, expr: String, state: StartupState) -> json.Json !{IO} =
  if str_find(src, "let " ++ sentinel_name()) != -1 then
    error_response("source contains reserved name '" ++ sentinel_name() ++ "'; cannot infer type")
  else do
    result <- compiler.compile_source_with_cache(augment_source(src, expr), source.StdlibRoot(state_stdlib_root(state)), state_cache(state))
    match result with
    | compiler.CompileFail diags ->
        match diags with
        | Nil -> error_response("type_of_in_source: typecheck failed")
        | [d | _] ->
            match d with
            | compiler.DiagError _ msg -> error_response(msg)
            | compiler.DiagWarning _ msg -> error_response(msg)
    | compiler.CompileOk env ->
        match dict_get(sentinel_name(), env) with
        | Nothing -> error_response("type_of_in_source: could not infer type of expression")
        | Just scheme -> ok_response(json.JsonString(types.scheme_to_string(scheme)))

# ---------------------------------------------------------------------------
# eval_expr_in_source — compile and run an expression in a source context
#
# Strategy (mirrors Python's eval_expression_lines_in_source):
#   1. Augment source with sentinel let-binding; compile to infer its type.
#   2. Based on the inferred type:
#      - Pure type T     → add fn main = print(sentinel); requires ToString T
#      - Unit !{IO}      → add fn main = sentinel (runs the IO action directly)
#      - Other T !{IO}   → error (cannot auto-print effectful non-Unit expressions)
#   3. Write the full augmented source to a fixed /tmp path.
#   4. Compile to LLVM IR via the internal compiler pipeline (compile_full_ir).
#   5. Link IR against every runtime object (whole runtime/*.c) with clang.
#   6. Execute the binary, capture stdout, return as a JSON array of lines.
#
# Fixed /tmp paths work because the REPL is interactive: one expression at a time.
# On macOS the -framework flags are added automatically (platform detected via
# `uname`); SPROUT_DARWIN_FRAMEWORKS=1 forces them on regardless of platform.

fn eval_source_path() -> String = "/tmp/sprout_eval_repl.sprout"
fn eval_ir_path() -> String = "/tmp/sprout_eval_repl.ll"
fn eval_bin_path() -> String = "/tmp/sprout_eval_repl_bin"

# Directory holding every runtime .c (sprout_runtime.c, sprout_scheduler.c,
# sprout_poll.c, …).  The whole directory is compiled and linked as a unit:
# object files link wholesale, so a source that references a symbol defined in
# a sibling TU (tcp_* -> scheduler_park_on_fd) only resolves when ALL runtime
# sources are compiled in.  Mirrors the justfile's `runtime/*.c` glob so a
# future runtime split needs zero edits here.
fn runtime_dir(stdlib_root: String) -> String =
  stdlib_root ++ "/../runtime"

# Cache dir for the compiled runtime objects (one .o per runtime .c).
fn runtime_objs_dir() -> String = "/tmp/sprout_runtime_daemon_objs"

# ---------------------------------------------------------------------------
# StartupState — pre-compiled runtime objects dir, stdlib_root, and persistent module cache

type StartupState = StartupState String (Ref String) (Ref (Dict (List (String, types.Scheme)))) (Ref (Dict SessionState)) (Ref Int)
  # stdlib_root, runtime_objs_dir ("" = not yet compiled), cache, sessions, next_session_id

fn state_stdlib_root(state: StartupState) -> String =
  match state with
  | StartupState root _ _ _ _ -> root

fn state_runtime_obj_ref(state: StartupState) -> Ref String =
  match state with
  | StartupState _ ref _ _ _ -> ref

fn state_cache(state: StartupState) -> Ref (Dict (List (String, types.Scheme))) =
  match state with
  | StartupState _ _ cache _ _ -> cache

fn state_sessions(state: StartupState) -> Ref (Dict SessionState) =
  match state with
  | StartupState _ _ _ sessions _ -> sessions

fn state_next_id(state: StartupState) -> Ref Int =
  match state with
  | StartupState _ _ _ _ next_id -> next_id

# Create the persistent service state and pre-warm the module cache with the
# prelude.  Runtime object compilation is deferred to first eval so the service
# starts (and answers diagnostics/type-of/hover) even when clang is not on PATH.
fn build_startup_state(stdlib_root: String) -> StartupState !{IO} =
  do
    runtime_obj_ref <- ref_new("")
    cache <- module_loader.new_cache()
    prelude_pairs <- module_loader.load_prelude_pairs(stdlib_root, cache)
    sessions <- ref_new(dict_empty())
    next_id <- ref_new(1)
    StartupState(stdlib_root, runtime_obj_ref, cache, sessions, next_id)

# Shell command that compiles every runtime .c into fresh objects under
# `objs_dir`.  proc_run is argv-based (no glob expansion), so the `*.c` glob is
# expanded by `sh -c`.  `-c` with multiple sources and no `-o` writes one
# `<base>.o` per source into the cwd, hence the `cd` into `objs_dir`.  `rt_dir`
# is resolved to an absolute path first so the source glob still points at the
# runtime dir after the `cd` (it may be relative to the caller's cwd).
fn runtime_compile_cmd(rt_dir: String, objs_dir: String) -> String =
  "RT=\"$(cd \"" ++ rt_dir ++ "\" && pwd)\" && mkdir -p \"" ++ objs_dir
    ++ "\" && rm -f \"" ++ objs_dir ++ "\"/*.o && cd \"" ++ objs_dir
    ++ "\" && clang -c \"$RT\"/*.c -O2"

# Shell command that links the eval IR against every runtime object.
fn eval_link_cmd(ir_path: String, objs_dir: String, bin_path: String, use_darwin: Bool) -> String =
  "clang \"" ++ ir_path ++ "\" \"" ++ objs_dir ++ "\"/*.o -O2 "
    ++ (if use_darwin then "-framework Security -framework CoreFoundation " else "")
    ++ "-o \"" ++ bin_path ++ "\""

# Cache the objects dir on first successful compile so subsequent evals skip
# the clang -c step.
fn write_objs_and_ok(objs_dir: String, objs_ref: Ref String) -> Result String String !{IO} =
  do
    ref_write(objs_ref, objs_dir)
    Ok(objs_dir)

fn compile_runtime_objs(rt_dir: String, objs_ref: Ref String) -> Result String String !{IO} =
  do
    let objs_dir = runtime_objs_dir()
    result <- process.proc_run(["sh", "-c", runtime_compile_cmd(rt_dir, objs_dir)])
    if process.proc_ok(result)
    then write_objs_and_ok(objs_dir, objs_ref)
    else Err("runtime compile failed: " ++ process.proc_stderr_or(result, "<stderr was not valid UTF-8>"))

fn ensure_runtime_objs(rt_dir: String, objs_ref: Ref String) -> Result String String !{IO} =
  do
    current <- ref_read(objs_ref)
    if current == "" then compile_runtime_objs(rt_dir, objs_ref)
    else Ok(current)

# Compile the full runtime (cached in `objs_ref`, "" = not yet compiled) and
# link `ir_path` against every runtime object into `bin_path`.  Exported so a
# regression test can drive the real link path: linking only sprout_runtime.o
# leaves scheduler_park_on_fd (defined in sprout_scheduler.c) undefined.
export fn compile_runtime_and_link_eval(
    rt_dir: String, ir_path: String, bin_path: String,
    objs_ref: Ref String, use_darwin: Bool) -> Result String String !{IO} =
  match ensure_runtime_objs(rt_dir, objs_ref) with
  | Err msg -> Err(msg)
  | Ok objs_dir ->
      do
        result <- process.proc_run(["sh", "-c", eval_link_cmd(ir_path, objs_dir, bin_path, use_darwin)])
        if process.proc_ok(result)
        then Ok(bin_path)
        else Err("clang link failed: " ++ process.proc_stderr_or(result, "<stderr was not valid UTF-8>"))

fn make_eval_source(src: String, expr: String, type_str: String) -> Maybe String =
  if string.ends_with(type_str, " !{IO}") then
    if type_str == "Unit !{IO}" then
      Just(src ++ "\nlet " ++ sentinel_name() ++ " = " ++ expr ++ "\nfn main() -> Unit !{IO} = " ++ sentinel_name())
    else
      Nothing
  else
    Just(src ++ "\nlet " ++ sentinel_name() ++ " = " ++ expr ++ "\nfn main() -> Unit !{IO} = print(to_string(" ++ sentinel_name() ++ "))")

fn string_to_json(s: String) -> json.Json = json.JsonString(s)

fn vec_strings_to_json_array(lines: Vec String) -> json.Json =
  json.array_from_list(vec_to_list(vec_map(string_to_json, lines)))

fn eval_output_lines(output: String) -> Vec String =
  if output == "" then vec_empty() else string.string_lines(output)

fn collect_eval_output(run_result: process.ProcResult) -> json.Json !{IO} =
  if process.proc_ok(run_result) == false then
    error_response("eval_expr_in_source: runtime error (exit " ++ int_to_string(process.proc_exit(run_result)) ++ "): " ++ process.proc_stderr_or(run_result, "<stderr was not valid UTF-8>"))
  else
    # The evaluated program's stdout is USER-CONTROLLED, so it can legitimately not be text. It used
    # to be minted as a String, which took the whole analysis service down when a walker touched it;
    # now a non-text result is REPORTED as output instead of being fatal.
    ok_response(vec_strings_to_json_array(eval_output_lines(string.trim_right(process.proc_stdout_or(run_result, "<eval output was not valid UTF-8>")))))

fn run_eval_binary() -> json.Json !{IO} =
  do
    run_result <- process.proc_run([eval_bin_path()])
    collect_eval_output(run_result)

fn env_forces_frameworks() -> Bool !{IO} =
  match env.get("SPROUT_DARWIN_FRAMEWORKS") with
  | Just _ -> true
  | Nothing -> false

fn uname_is_darwin() -> Bool !{IO} =
  do
    r <- process.proc_run(["uname"])
    # `uname` output is ASCII; a child that somehow emitted non-UTF-8 is simply not Darwin.
    string.trim(process.proc_stdout_or(r, "")) == "Darwin"

# True when the eval binary must link the macOS Security/CoreFoundation
# frameworks (the runtime's TLS/net code needs them).  Detect the platform at
# runtime via `uname` so a fresh macOS checkout works with no env var, mirroring
# the justfile's `os() == "macos"` gate; SPROUT_DARWIN_FRAMEWORKS forces it on.
fn use_darwin_frameworks() -> Bool !{IO} =
  do
    forced <- env_forces_frameworks()
    darwin <- uname_is_darwin()
    if forced then true else darwin

fn diag_msg(d: compiler.Diagnostic) -> String =
  match d with
  | compiler.DiagError _ msg -> msg
  | compiler.DiagWarning _ msg -> msg

fn link_and_run_eval(ir_result: compiler.IrFullResult, state: StartupState) -> json.Json !{IO} =
  match ir_result with
  | compiler.IrFullFail diags ->
      match diags with
      | Nil -> error_response("eval_expr_in_source: codegen failed")
      | [d | _] -> error_response(diag_msg(d))
  | compiler.IrFullOk ir_text ->
      match fs.write_text(eval_ir_path(), ir_text) with
      | Err msg -> panic("write_file: eval.ir: " ++ msg)
      | Ok _ ->
          do
            use_darwin <- use_darwin_frameworks()
            match compile_runtime_and_link_eval(
              runtime_dir(state_stdlib_root(state)), eval_ir_path(), eval_bin_path(),
              state_runtime_obj_ref(state), use_darwin) with
            | Err msg -> error_response("eval_expr_in_source: " ++ msg)
            | Ok _ -> run_eval_binary()

fn compile_and_run_eval(src: String, state: StartupState) -> json.Json !{IO} =
  match fs.write_text(eval_source_path(), src) with
  | Err msg -> panic("write_file: eval_source: " ++ msg)
  | Ok _ ->
      do
        ir_result <- compiler.compile_full_ir_with_cache(source.FilePath(eval_source_path()), source.StdlibRoot(state_stdlib_root(state)), state_cache(state))
        link_and_run_eval(ir_result, state)

export fn is_function_scheme(s: types.Scheme) -> Bool =
  match types.scheme_type(s) with
  | types.TFunc _ _ _ _ -> true
  | _ -> false

export fn is_polymorphic_scheme(s: types.Scheme) -> Bool =
  match types.scheme_vars(s) with
  | Nil -> false
  | _ -> true

export fn fn_display_type_str(type_str: String) -> String =
  if str_starts_with(type_str, "forall ") && dot != -1
  then str_slice(type_str, dot + 2, str_len(type_str))
  else type_str
  where dot = str_find(type_str, ". ")

fn eval_with_scheme(src: String, expr: String, state: StartupState, scheme: types.Scheme) -> json.Json !{IO} =
  if is_function_scheme(scheme) then
    ok_response(vec_strings_to_json_array(vec_singleton("<fn: " ++ fn_display_type_str(type_str) ++ ">")))
  else if is_polymorphic_scheme(scheme) then
    ok_response(vec_strings_to_json_array(vec_singleton("<value: " ++ fn_display_type_str(type_str) ++ ">")))
  else
    match make_eval_source(src, expr, type_str) with
    | Nothing -> error_response("eval_expr_in_source: cannot auto-print effectful non-Unit expression of type: " ++ type_str)
    | Just full_src -> compile_and_run_eval(full_src, state)
  where type_str = types.scheme_to_string(scheme)

fn eval_with_type_result(src: String, expr: String, state: StartupState, result: compiler.CompileResult) -> json.Json !{IO} =
  match result with
  | compiler.CompileFail diags ->
      match diags with
      | Nil -> error_response("eval_expr_in_source: typecheck failed")
      | [d | _] ->
          match d with
          | compiler.DiagError _ msg -> error_response(msg)
          | compiler.DiagWarning _ msg -> error_response(msg)
  | compiler.CompileOk env ->
      match dict_get(sentinel_name(), env) with
      | Nothing -> error_response("eval_expr_in_source: could not infer type of expression")
      | Just scheme -> eval_with_scheme(src, expr, state, scheme)

fn op_eval_expr_in_source(src: String, expr: String, state: StartupState) -> json.Json !{IO} =
  if str_find(src, "let " ++ sentinel_name()) != -1 then
    error_response("source contains reserved name '" ++ sentinel_name() ++ "'; cannot eval")
  else do
    type_result <- compiler.compile_source_with_cache(augment_source(src, expr), source.StdlibRoot(state_stdlib_root(state)), state_cache(state))
    eval_with_type_result(src, expr, state, type_result)

# ---------------------------------------------------------------------------
# Session ops (M2)

fn compile_fail_response(diags: List compiler.Diagnostic) -> json.Json =
  match diags with
  | Nil -> error_response("type check failed")
  | [d | _] ->
      match d with
      | compiler.DiagError _ msg -> error_response(msg)
      | compiler.DiagWarning _ msg -> error_response(msg)

fn op_session_create(state: StartupState) -> json.Json !{IO} =
  do
    sessions <- ref_read(state_sessions(state))
    next_id <- ref_read(state_next_id(state))
    ref_write(state_sessions(state), dict_set(int_to_string(next_id), SessionState(vec_empty(), vec_empty()), sessions))
    ref_write(state_next_id(state), next_id + 1)
    ok_response(json.JsonInt(next_id))

fn op_session_destroy(req: json.Json, state: StartupState) -> json.Json !{IO} =
  match require_int_field(req, "session_id") with
  | Err msg -> error_response(msg)
  | Ok session_id ->
      do
        sessions <- ref_read(state_sessions(state))
        ref_write(state_sessions(state), dict_remove(int_to_string(session_id), sessions))
        ok_response(json.JsonBool(true))

fn op_session_update(req: json.Json, state: StartupState) -> json.Json !{IO} =
  do
    let Ok session_id = require_int_field(req, "session_id") else Err msg -> error_response(msg)
    let Ok kind = require_string_field(req, "kind") else Err msg -> error_response(msg)
    let Ok line = require_string_field(req, "line") else Err msg -> error_response(msg)
    sessions <- ref_read(state_sessions(state))
    match dict_get(int_to_string(session_id), sessions) with
    | Nothing -> error_response("unknown session: " ++ int_to_string(session_id))
    | Just sess ->
        do
          let new_sess = session_add_line(sess, kind, line)
          let check_src = rebuild_session_source(new_sess)
          check_result <- compiler.compile_source_with_cache(check_src, source.StdlibRoot(state_stdlib_root(state)), state_cache(state))
          match check_result with
          | compiler.CompileFail diags -> compile_fail_response(diags)
          | compiler.CompileOk _ ->
              do
                ref_write(state_sessions(state), dict_set(int_to_string(session_id), new_sess, sessions))
                ok_response(json.JsonBool(true))

fn op_session_eval(req: json.Json, state: StartupState) -> json.Json !{IO} =
  match require_int_field(req, "session_id") with
  | Err msg -> error_response(msg)
  | Ok session_id ->
      match require_string_field(req, "expr") with
      | Err msg -> error_response(msg)
      | Ok expr ->
          do
            sessions <- ref_read(state_sessions(state))
            match dict_get(int_to_string(session_id), sessions) with
            | Nothing -> error_response("unknown session: " ++ int_to_string(session_id))
            | Just sess ->
                op_eval_expr_in_source(rebuild_session_source(sess), expr, state)

fn op_session_type_of(req: json.Json, state: StartupState) -> json.Json !{IO} =
  match require_int_field(req, "session_id") with
  | Err msg -> error_response(msg)
  | Ok session_id ->
      match require_string_field(req, "expr") with
      | Err msg -> error_response(msg)
      | Ok expr ->
          do
            sessions <- ref_read(state_sessions(state))
            match dict_get(int_to_string(session_id), sessions) with
            | Nothing -> error_response("unknown session: " ++ int_to_string(session_id))
            | Just sess ->
                op_type_of_in_source(rebuild_session_source(sess), expr, state)

fn op_session_diagnostics(req: json.Json, state: StartupState) -> json.Json !{IO} =
  match require_int_field(req, "session_id") with
  | Err msg -> error_response(msg)
  | Ok session_id ->
      do
        sessions <- ref_read(state_sessions(state))
        match dict_get(int_to_string(session_id), sessions) with
        | Nothing -> error_response("unknown session: " ++ int_to_string(session_id))
        | Just sess ->
            op_diagnostics_in_source(rebuild_session_source(sess), state)

# ---------------------------------------------------------------------------
# Request dispatch

fn dispatch_op(op: String, req: json.Json, state: StartupState) -> json.Json !{IO} =
  if op == "check_source" then
    match require_string_field(req, "module_source") with
    | Err msg -> error_response(msg)
    | Ok src ->
        if state_stdlib_root(state) == "" then error_response("stdlib-root not configured for semantic ops")
        else op_check_source(src, state)
  else if op == "diagnostics_in_source" then
    match require_string_field(req, "module_source") with
    | Err msg -> error_response(msg)
    | Ok src ->
        if state_stdlib_root(state) == "" then empty_diags_response()
        else op_diagnostics_in_source(src, state)
  else if op == "declared_names_in_source" then
    match require_string_field(req, "module_source") with
    | Err msg -> error_response(msg)
    | Ok src -> op_declared_names_in_source(src)
  else if op == "exported_names_in_source" then
    match require_string_field(req, "module_source") with
    | Err msg -> error_response(msg)
    | Ok src -> op_exported_names_in_source(src)
  else if op == "symbol_inventory_in_source" then
    match require_string_field(req, "module_source") with
    | Err msg -> error_response(msg)
    | Ok src -> op_symbol_inventory_in_source(src)
  else if op == "symbol_locations_in_source" then
    match require_string_field(req, "module_source") with
    | Err msg -> error_response(msg)
    | Ok src -> op_symbol_locations_in_source(src)
  else if op == "type_of_in_source" then
    match require_string_field(req, "module_source") with
    | Err msg -> error_response(msg)
    | Ok src ->
        match require_string_field(req, "expr") with
        | Err msg -> error_response(msg)
        | Ok expr ->
            if state_stdlib_root(state) == "" then error_response("stdlib-root not configured for semantic ops")
            else op_type_of_in_source(src, expr, state)
  else if op == "instances_in_source" then
    match require_string_field(req, "module_source") with
    | Err msg -> error_response(msg)
    | Ok src ->
        match require_string_field(req, "query") with
        | Err msg -> error_response(msg)
        | Ok query ->
            if state_stdlib_root(state) == "" then error_response("stdlib-root not configured for semantic ops")
            else op_instances_in_source(src, query, state)
  else if op == "eval_expr_in_source" then
    match require_string_field(req, "module_source") with
    | Err msg -> error_response(msg)
    | Ok src ->
        match require_string_field(req, "expr") with
        | Err msg -> error_response(msg)
        | Ok expr ->
            if state_stdlib_root(state) == "" then error_response("stdlib-root not configured for semantic ops")
            else op_eval_expr_in_source(src, expr, state)
  else if op == "complete_in_state" then not_implemented(op)
  else if op == "session_create" then op_session_create(state)
  else if op == "session_update" then op_session_update(req, state)
  else if op == "session_eval" then op_session_eval(req, state)
  else if op == "session_type_of" then op_session_type_of(req, state)
  else if op == "session_diagnostics" then op_session_diagnostics(req, state)
  else if op == "session_destroy" then op_session_destroy(req, state)
  else error_response(string.concat("unknown op: ", op))

fn dispatch(req: json.Json, state: StartupState) -> json.Json !{IO} =
  match json.json_get_field(req, "op") with
  | Nothing -> error_response("missing 'op' field")
  | Just op_val ->
      match json.json_get_string(op_val) with
      | Nothing -> error_response("'op' must be a string")
      | Just op -> dispatch_op(op, req, state)

fn dispatch_line(line: String, state: StartupState) -> json.Json !{IO} =
  match json.parse(line) with
  | Err (json.JsonDecode msg) -> error_response(string.concat("invalid JSON: ", msg))
  | Ok req -> dispatch(req, state)

# ---------------------------------------------------------------------------
# Service loop

fn service_loop(state: StartupState) -> Unit !{IO} =
  match terminal.term_read_line_once() with
  | Nothing -> ()
  | Just line ->
      if string.is_empty(line) then service_loop(state)
      else
        do
          response <- dispatch_line(line, state)
          terminal.write(json.stringify(response) ++ "\n")
          service_loop(state)

export fn run_service(stdlib_root: String) -> Unit !{IO} =
  if stdlib_root == "" then do
    runtime_obj_ref <- ref_new("")
    cache <- module_loader.new_cache()
    sessions <- ref_new(dict_empty())
    next_id <- ref_new(1)
    service_loop(StartupState("", runtime_obj_ref, cache, sessions, next_id))
  else do
    state <- build_startup_state(stdlib_root)
    service_loop(state)

