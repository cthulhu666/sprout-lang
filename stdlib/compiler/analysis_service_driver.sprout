module stdlib.compiler.analysis_service_driver
import stdlib.json as json
import stdlib.compiler.compiler as compiler
import stdlib.compiler.bundler as bundler
import stdlib.compiler.module_loader as module_loader
import stdlib.compiler.lexer as lexer
import stdlib.compiler.parser as parser
import stdlib.compiler.ast as ast
import stdlib.compiler.source as source
import stdlib.compiler.types as types
import stdlib.string as string
import stdlib.process as process

# ---------------------------------------------------------------------------
# Header stripping — mirrors compiler.sprout (strip_headers is not exported)

fn is_header_line(s: String, pos: Int) -> Bool =
  str_starts_with(str_slice(s, pos, str_len(s)), "module ") ||
  str_starts_with(str_slice(s, pos, str_len(s)), "import ") ||
  str_starts_with(str_slice(s, pos, str_len(s)), "\n")

fn next_line(s: String, pos: Int) -> Int =
  if nl == -1 then str_len(s)
  else pos + nl + 1
  where nl = str_find(str_slice(s, pos, str_len(s)), "\n")

fn strip_headers(s: String, pos: Int) -> String =
  if pos >= str_len(s) then ""
  else if is_header_line(s, pos) then strip_headers(s, next_line(s, pos))
  else str_slice(s, pos, str_len(s))

fn count_header_lines(s: String, pos: Int, count: Int) -> Int =
  if pos >= str_len(s) then count
  else if is_header_line(s, pos) then count_header_lines(s, next_line(s, pos), count + 1)
  else count

# ---------------------------------------------------------------------------
# SessionState — server-side per-session state (M2)

export type SessionState (..) = SessionState(Vec String) (Vec String)
  # imports, declarations

export fn session_add_line(sess: SessionState, kind: String, line: String) -> SessionState =
  match sess with
  | SessionState imports declarations ->
      if kind == "import" then SessionState(vec_append(line, imports), declarations)
      else SessionState(imports, vec_append(line, declarations))

fn build_source_parts(header: String, imports: Vec String, declarations: Vec String) -> String =
  if vec_length(declarations) == 0 then with_imports
  else with_imports ++ "\n\n" ++ string.join("\n\n", declarations)
  where with_imports =
    if vec_length(imports) == 0 then header
    else header ++ "\n\n" ++ string.join("\n\n", imports)

export fn rebuild_session_source(sess: SessionState) -> String =
  match sess with
  | SessionState imports declarations ->
      build_source_parts("module app.session", imports, declarations)

# ---------------------------------------------------------------------------
# JSON response construction

fn ok_response(value: json.Json) -> json.Json =
  json.JsonObject(
    json.JsonObjectCons("ok", json.JsonBool(true),
    json.JsonObjectCons("value", value,
    json.JsonObjectNil)))

fn error_response(msg: String) -> json.Json =
  json.JsonObject(
    json.JsonObjectCons("ok", json.JsonBool(false),
    json.JsonObjectCons("error", json.JsonString(msg),
    json.JsonObjectNil)))

fn string_list_to_json(xs: List String) -> json.Json =
  json.array_from_list(list_map(json.string, xs))

fn int_list_to_json(xs: List Int) -> json.Json =
  json.array_from_list(list_map(json.int, xs))

fn not_implemented(op_name: String) -> json.Json =
  error_response(string.concat("not yet implemented in self-hosted analysis service: ", op_name))

fn empty_diags_response() -> json.Json =
  ok_response(json.JsonObject(
    json.JsonObjectCons("messages", json.array_from_list(Nil),
    json.JsonObjectCons("lines", json.array_from_list(Nil),
    json.JsonObjectCons("columns", json.array_from_list(Nil),
    json.JsonObjectNil)))))

fn require_string_field(req: json.Json, field: String) -> Result String String =
  match json.json_get_field(req, field) with
  | Nothing -> Err(string.concat("missing field: ", field))
  | Just v ->
      match json.json_get_string(v) with
      | Nothing -> Err(string.concat("field must be a string: ", field))
      | Just s -> Ok(s)

fn require_int_field(req: json.Json, field: String) -> Result String Int =
  match json.json_get_field(req, field) with
  | Nothing -> Err(string.concat("missing field: ", field))
  | Just v ->
      match json.json_get_int(v) with
      | Nothing -> Err(string.concat("field must be an integer: ", field))
      | Just n -> Ok(n)

# ---------------------------------------------------------------------------
# AST name extraction

fn ctor_names(ctors: List ast.TypeConstructor, acc: List String) -> List String =
  match ctors with
  | Nil -> acc
  | Cons ctor rest ->
      match ctor with
      | ast.TypeConstructor name _ -> ctor_names(rest, Cons(name, acc))

fn method_sig_names(methods: List ast.ClassMethodSig, acc: List String) -> List String =
  match methods with
  | Nil -> acc
  | Cons m rest ->
      match m with
      | ast.ClassMethodSig name _ _ _ -> method_sig_names(rest, Cons(name, acc))

fn collect_decl_names(decls: List ast.Decl, acc: List String) -> List String =
  match decls with
  | Nil -> list_reverse(acc)
  | Cons d rest ->
      match d with
      | ast.FnDecl name _ _ _ _ _ _ ->
          collect_decl_names(rest, Cons(name, acc))
      | ast.TypeDecl name _ ctors _ _ ->
          collect_decl_names(rest, ctor_names(ctors, Cons(name, acc)))
      | ast.RecordDecl name _ _ _ ->
          collect_decl_names(rest, Cons(name, acc))
      | ast.LetDecl name _ _ ->
          collect_decl_names(rest, Cons(name, acc))
      | ast.ClassDecl name _ methods _ _ ->
          collect_decl_names(rest, method_sig_names(methods, Cons(name, acc)))
      | ast.InstanceDecl _ _ _ _ ->
          collect_decl_names(rest, acc)
      | ast.AliasDecl name _ _ _ ->
          collect_decl_names(rest, Cons(name, acc))
      | ast.ExternFnDecl _ _ _ _ _ ->
          collect_decl_names(rest, acc)

fn parse_decl_names(src: String) -> List String =
  match lexer.tokenize(strip_headers(src, 0)) with
  | Err _ -> Nil
  | Ok tokens ->
      match parser.parse_program(tokens) with
      | Err _ -> Nil
      | Ok prog ->
          match prog with
          | ast.Program decls _ -> collect_decl_names(decls, Nil)

# ---------------------------------------------------------------------------
# Symbol location extraction

fn collect_decl_locations(
  decls: List ast.Decl,
  line_offset: Int,
  categories: List String,
  names: List String,
  lines: List Int,
  cols: List Int
) -> (List String, List String, List Int, List Int) =
  match decls with
  | Nil ->
      (list_reverse(categories), list_reverse(names), list_reverse(lines), list_reverse(cols))
  | Cons d rest ->
      match d with
      | ast.FnDecl name _ _ _ _ _ pos ->
          collect_decl_locations(rest, line_offset,
            Cons("fn", categories), Cons(name, names),
            Cons(source.position_line(pos) + line_offset, lines),
            Cons(source.position_column(pos), cols))
      | ast.TypeDecl name _ _ _ pos ->
          collect_decl_locations(rest, line_offset,
            Cons("type", categories), Cons(name, names),
            Cons(source.position_line(pos) + line_offset, lines),
            Cons(source.position_column(pos), cols))
      | ast.RecordDecl name _ _ pos ->
          collect_decl_locations(rest, line_offset,
            Cons("type", categories), Cons(name, names),
            Cons(source.position_line(pos) + line_offset, lines),
            Cons(source.position_column(pos), cols))
      | ast.LetDecl name _ pos ->
          collect_decl_locations(rest, line_offset,
            Cons("let", categories), Cons(name, names),
            Cons(source.position_line(pos) + line_offset, lines),
            Cons(source.position_column(pos), cols))
      | ast.ClassDecl name _ _ _ pos ->
          collect_decl_locations(rest, line_offset,
            Cons("class", categories), Cons(name, names),
            Cons(source.position_line(pos) + line_offset, lines),
            Cons(source.position_column(pos), cols))
      | ast.InstanceDecl _ _ _ _ ->
          collect_decl_locations(rest, line_offset, categories, names, lines, cols)
      | ast.AliasDecl name _ _ pos ->
          collect_decl_locations(rest, line_offset,
            Cons("alias", categories), Cons(name, names),
            Cons(source.position_line(pos) + line_offset, lines),
            Cons(source.position_column(pos), cols))
      | ast.ExternFnDecl _ _ _ _ _ ->
          collect_decl_locations(rest, line_offset, categories, names, lines, cols)

fn empty_locations_json() -> json.Json =
  ok_response(json.JsonObject(
    json.JsonObjectCons("categories", json.array_from_list(Nil),
    json.JsonObjectCons("names", json.array_from_list(Nil),
    json.JsonObjectCons("lines", json.array_from_list(Nil),
    json.JsonObjectCons("columns", json.array_from_list(Nil),
    json.JsonObjectNil))))))

fn parse_symbol_locations(src: String) -> json.Json =
  match lexer.tokenize(strip_headers(src, 0)) with
  | Err _ -> empty_locations_json()
  | Ok tokens ->
      match parser.parse_program(tokens) with
      | Err _ -> empty_locations_json()
      | Ok prog ->
          match prog with
          | ast.Program decls _ ->
              match collect_decl_locations(decls, count_header_lines(src, 0, 0), Nil, Nil, Nil, Nil) with
              | (cats, loc_names, loc_lines, loc_cols) ->
                  ok_response(json.JsonObject(
                    json.JsonObjectCons("categories", string_list_to_json(cats),
                    json.JsonObjectCons("names", string_list_to_json(loc_names),
                    json.JsonObjectCons("lines", int_list_to_json(loc_lines),
                    json.JsonObjectCons("columns", int_list_to_json(loc_cols),
                    json.JsonObjectNil))))))

# ---------------------------------------------------------------------------
# Import name extraction (for symbol_inventory imported list)

fn import_spec_names(spec: module_loader.ImportSpec) -> List String =
  match spec with
  | module_loader.ImportAlias _ alias -> Cons(alias, Nil)
  | module_loader.ImportSelective _ names -> names

fn collect_import_names(specs: List module_loader.ImportSpec, acc: List String) -> List String =
  match specs with
  | Nil -> list_reverse(acc)
  | Cons s rest ->
      collect_import_names(rest, list_append(list_reverse(import_spec_names(s)), acc))

fn exported_names_from_src(src: String) -> List String =
  match bundler.scan_source_info(src) with
  | (_, exported, _) -> exported

# ---------------------------------------------------------------------------
# Diagnostic formatting

fn collect_diag_fields(
  diags: List compiler.Diagnostic,
  msgs: List String,
  lines: List Int,
  cols: List Int
) -> (List String, List Int, List Int) =
  match diags with
  | Nil -> (list_reverse(msgs), list_reverse(lines), list_reverse(cols))
  | Cons d rest ->
      match d with
      | compiler.DiagError msg ->
          collect_diag_fields(rest, Cons(msg, msgs), Cons(0, lines), Cons(0, cols))
      | compiler.DiagWarning msg ->
          collect_diag_fields(rest, Cons(msg, msgs), Cons(0, lines), Cons(0, cols))

fn diags_to_json(diags: List compiler.Diagnostic) -> json.Json =
  match collect_diag_fields(diags, Nil, Nil, Nil) with
  | (msgs, diag_lines, diag_cols) ->
      ok_response(json.JsonObject(
        json.JsonObjectCons("messages", string_list_to_json(msgs),
        json.JsonObjectCons("lines", int_list_to_json(diag_lines),
        json.JsonObjectCons("columns", int_list_to_json(diag_cols),
        json.JsonObjectNil)))))

# ---------------------------------------------------------------------------
# Op handlers

fn op_check_source(src: String, state: StartupState) -> json.Json !{IO} =
  do
    result <- compiler.compile_source_with_cache(src, state_stdlib_root(state), state_cache(state))
    match result with
    | compiler.CompileOk _ -> ok_response(json.JsonNull)
    | compiler.CompileFail diags ->
        match diags with
        | Nil -> error_response("check failed")
        | Cons d _ ->
            match d with
            | compiler.DiagError msg -> error_response(msg)
            | compiler.DiagWarning msg -> error_response(msg)

fn op_diagnostics_in_source(src: String, state: StartupState) -> json.Json !{IO} =
  do
    result <- compiler.compile_source_with_cache(src, state_stdlib_root(state), state_cache(state))
    match result with
    | compiler.CompileOk _ -> empty_diags_response()
    | compiler.CompileFail diags -> diags_to_json(diags)

fn op_declared_names_in_source(src: String) -> json.Json =
  ok_response(string_list_to_json(parse_decl_names(src)))

fn op_exported_names_in_source(src: String) -> json.Json =
  ok_response(string_list_to_json(exported_names_from_src(src)))

fn op_symbol_inventory_in_source(src: String) -> json.Json =
  ok_response(json.JsonObject(
    json.JsonObjectCons("declared", string_list_to_json(parse_decl_names(src)),
    json.JsonObjectCons("imported", string_list_to_json(collect_import_names(module_loader.collect_imports(src), Nil)),
    json.JsonObjectCons("exported", string_list_to_json(exported_names_from_src(src)),
    json.JsonObjectNil)))))

fn op_symbol_locations_in_source(src: String) -> json.Json =
  parse_symbol_locations(src)

# ---------------------------------------------------------------------------
# type_of_in_source — infer the type of an expression in a source context
#
# Strategy (mirrors Python's infer_type_in_source):
#   1. Append a sentinel let-binding to the source:
#        let __repl_source_value = <expr>
#   2. Run compile_source_with_root on the augmented source.
#   3. Look up "__repl_source_value" in the resulting env.
#   4. Render the Scheme with types.scheme_to_string.
#
# The sentinel name is unlikely to collide with user code, but double-underscore
# names ARE valid Sprout identifiers (the lexer accepts _ as identifier-start).
# augment_source guards against the collision explicitly.

fn sentinel_name() -> String = "__repl_source_value"

fn augment_source(src: String, expr: String) -> String =
  src ++ "\nlet " ++ sentinel_name() ++ " = " ++ expr

fn op_type_of_in_source(src: String, expr: String, state: StartupState) -> json.Json !{IO} =
  if str_find(src, "let " ++ sentinel_name()) != -1 then
    error_response("source contains reserved name '" ++ sentinel_name() ++ "'; cannot infer type")
  else do
    result <- compiler.compile_source_with_cache(augment_source(src, expr), state_stdlib_root(state), state_cache(state))
    match result with
    | compiler.CompileFail diags ->
        match diags with
        | Nil -> error_response("type_of_in_source: typecheck failed")
        | Cons d _ ->
            match d with
            | compiler.DiagError msg -> error_response(msg)
            | compiler.DiagWarning msg -> error_response(msg)
    | compiler.CompileOk env ->
        match dict_get(sentinel_name(), env) with
        | Nothing -> error_response("type_of_in_source: could not infer type of expression")
        | Just scheme -> ok_response(json.JsonString(types.scheme_to_string(scheme)))

# ---------------------------------------------------------------------------
# eval_expr_in_source — compile and run an expression in a source context
#
# Strategy (mirrors Python's eval_expression_lines_in_source):
#   1. Augment source with sentinel let-binding; compile to infer its type.
#   2. Based on the inferred type:
#      - Pure type T     → add fn main = print(sentinel); requires ToString T
#      - Unit !{IO}      → add fn main = sentinel (runs the IO action directly)
#      - Other T !{IO}   → error (cannot auto-print effectful non-Unit expressions)
#   3. Write the full augmented source to a fixed /tmp path.
#   4. Compile to LLVM IR via the internal compiler pipeline (compile_full_ir).
#   5. Link IR + sprout_runtime.c with clang.
#   6. Execute the binary, capture stdout, return as a JSON array of lines.
#
# Fixed /tmp paths work because the REPL is interactive: one expression at a time.
# SPROUT_DARWIN_FRAMEWORKS=1 env var triggers the -framework flags needed on macOS.

fn eval_source_path() -> String = "/tmp/sprout_eval_repl.sprout"
fn eval_ir_path() -> String = "/tmp/sprout_eval_repl.ll"
fn eval_bin_path() -> String = "/tmp/sprout_eval_repl_bin"

fn runtime_c_path(stdlib_root: String) -> String =
  stdlib_root ++ "/../runtime/sprout_runtime.c"

fn runtime_obj_path() -> String = "/tmp/sprout_runtime_daemon.o"

# ---------------------------------------------------------------------------
# StartupState — pre-compiled runtime.o, stdlib_root, and persistent module cache

type StartupState = StartupState String (Ref String) (Ref (Dict (List (String, types.Scheme)))) (Ref (Dict SessionState)) (Ref Int)
  # stdlib_root, runtime_obj_ref ("" = not yet compiled), cache, sessions, next_session_id

fn state_stdlib_root(state: StartupState) -> String =
  match state with
  | StartupState root _ _ _ _ -> root

fn state_runtime_obj_ref(state: StartupState) -> Ref String =
  match state with
  | StartupState _ ref _ _ _ -> ref

fn state_cache(state: StartupState) -> Ref (Dict (List (String, types.Scheme))) =
  match state with
  | StartupState _ _ cache _ _ -> cache

fn state_sessions(state: StartupState) -> Ref (Dict SessionState) =
  match state with
  | StartupState _ _ _ sessions _ -> sessions

fn state_next_id(state: StartupState) -> Ref Int =
  match state with
  | StartupState _ _ _ _ next_id -> next_id

# Create the persistent service state and pre-warm the module cache with the
# prelude.  Runtime object compilation is deferred to first eval so the service
# starts (and answers diagnostics/type-of/hover) even when clang is not on PATH.
fn build_startup_state(stdlib_root: String) -> StartupState !{IO} =
  do
    runtime_obj_ref <- ref_new("")
    cache <- module_loader.new_cache()
    prelude_pairs <- module_loader.load_prelude_pairs(stdlib_root, cache)
    sessions <- ref_new(dict_empty())
    next_id <- ref_new(1)
    StartupState(stdlib_root, runtime_obj_ref, cache, sessions, next_id)

# Cache the compiled runtime object path on first successful compile so
# subsequent evals skip the clang -c step.
fn write_obj_and_ok(obj: String, obj_ref: Ref String) -> Result String String !{IO} =
  do
    ref_write(obj_ref, obj)
    Ok(obj)

fn try_compile_runtime_obj(stdlib_root: String, obj_ref: Ref String) -> Result String String !{IO} =
  do
    let obj = runtime_obj_path()
    result <- process.proc_run(["clang", "-c", runtime_c_path(stdlib_root), "-O2", "-o", obj])
    if process.proc_ok(result)
    then write_obj_and_ok(obj, obj_ref)
    else Err("eval: clang not available: " ++ process.proc_stderr(result))

fn ensure_runtime_obj(state: StartupState) -> Result String String !{IO} =
  do
    let obj_ref = state_runtime_obj_ref(state)
    current <- ref_read(obj_ref)
    if current == "" then try_compile_runtime_obj(state_stdlib_root(state), obj_ref)
    else Ok(current)

fn clang_base_args(runtime_obj: String) -> List String =
  ["clang", eval_ir_path(), runtime_obj, "-O2", "-o", eval_bin_path()]

fn clang_darwin_extra() -> List String =
  ["-framework", "Security", "-framework", "CoreFoundation"]

fn clang_argv(runtime_obj: String, use_darwin: Bool) -> List String =
  if use_darwin then list_append(clang_base_args(runtime_obj), clang_darwin_extra())
  else clang_base_args(runtime_obj)

fn make_eval_source(src: String, expr: String, type_str: String) -> Maybe String =
  if string.ends_with(type_str, " !{IO}") then
    if type_str == "Unit !{IO}" then
      Just(src ++ "\nlet " ++ sentinel_name() ++ " = " ++ expr ++ "\nfn main() -> Unit !{IO} = " ++ sentinel_name())
    else
      Nothing
  else
    Just(src ++ "\nlet " ++ sentinel_name() ++ " = " ++ expr ++ "\nfn main() -> Unit !{IO} = print(to_string(" ++ sentinel_name() ++ "))")

fn string_to_json(s: String) -> json.Json = json.JsonString(s)

fn vec_strings_to_json_array(lines: Vec String) -> json.Json =
  json.array_from_list(vec_to_list(vec_map(string_to_json, lines)))

fn eval_output_lines(output: String) -> Vec String =
  if output == "" then vec_empty() else string.string_lines(output)

fn collect_eval_output(run_result: process.ProcResult) -> json.Json !{IO} =
  if process.proc_ok(run_result) == false then
    error_response("eval_expr_in_source: runtime error (exit " ++ int_to_string(process.proc_exit(run_result)) ++ "): " ++ process.proc_stderr(run_result))
  else
    ok_response(vec_strings_to_json_array(eval_output_lines(string.trim_right(process.proc_stdout(run_result)))))

fn run_eval_binary(link_result: process.ProcResult) -> json.Json !{IO} =
  if process.proc_ok(link_result) == false then
    error_response("eval_expr_in_source: clang link failed: " ++ process.proc_stderr(link_result))
  else do
    run_result <- process.proc_run([eval_bin_path()])
    collect_eval_output(run_result)

fn darwin_frameworks_set() -> Bool !{IO} =
  match env_get("SPROUT_DARWIN_FRAMEWORKS") with
  | Just _ -> true
  | Nothing -> false

fn diag_msg(d: compiler.Diagnostic) -> String =
  match d with
  | compiler.DiagError msg -> msg
  | compiler.DiagWarning msg -> msg

fn link_and_run_eval(ir_result: compiler.IrFullResult, state: StartupState) -> json.Json !{IO} =
  match ir_result with
  | compiler.IrFullFail diags ->
      match diags with
      | Nil -> error_response("eval_expr_in_source: codegen failed")
      | Cons d _ -> error_response(diag_msg(d))
  | compiler.IrFullOk ir_text ->
      match write_file(eval_ir_path(), ir_text) with
      | Err msg -> panic("write_file: eval.ir: " ++ msg)
      | Ok _ ->
          match ensure_runtime_obj(state) with
          | Err msg -> error_response(msg)
          | Ok runtime_obj ->
              do
                use_darwin <- darwin_frameworks_set()
                link_result <- process.proc_run(clang_argv(runtime_obj, use_darwin))
                run_eval_binary(link_result)

fn compile_and_run_eval(src: String, state: StartupState) -> json.Json !{IO} =
  match write_file(eval_source_path(), src) with
  | Err msg -> panic("write_file: eval_source: " ++ msg)
  | Ok _ ->
      do
        ir_result <- compiler.compile_full_ir_with_cache(eval_source_path(), state_stdlib_root(state), state_cache(state))
        link_and_run_eval(ir_result, state)

export fn is_function_scheme(s: types.Scheme) -> Bool =
  match types.scheme_type(s) with
  | types.TFunc _ _ _ -> true
  | _ -> false

export fn is_polymorphic_scheme(s: types.Scheme) -> Bool =
  match types.scheme_vars(s) with
  | Nil -> false
  | _ -> true

export fn fn_display_type_str(type_str: String) -> String =
  if str_starts_with(type_str, "forall ") && dot != -1
  then str_slice(type_str, dot + 2, str_len(type_str))
  else type_str
  where dot = str_find(type_str, ". ")

fn eval_with_scheme(src: String, expr: String, state: StartupState, scheme: types.Scheme) -> json.Json !{IO} =
  if is_function_scheme(scheme) then
    ok_response(vec_strings_to_json_array(vec_singleton("<fn: " ++ fn_display_type_str(type_str) ++ ">")))
  else if is_polymorphic_scheme(scheme) then
    ok_response(vec_strings_to_json_array(vec_singleton("<value: " ++ fn_display_type_str(type_str) ++ ">")))
  else
    match make_eval_source(src, expr, type_str) with
    | Nothing -> error_response("eval_expr_in_source: cannot auto-print effectful non-Unit expression of type: " ++ type_str)
    | Just full_src -> compile_and_run_eval(full_src, state)
  where type_str = types.scheme_to_string(scheme)

fn eval_with_type_result(src: String, expr: String, state: StartupState, result: compiler.CompileResult) -> json.Json !{IO} =
  match result with
  | compiler.CompileFail diags ->
      match diags with
      | Nil -> error_response("eval_expr_in_source: typecheck failed")
      | Cons d _ ->
          match d with
          | compiler.DiagError msg -> error_response(msg)
          | compiler.DiagWarning msg -> error_response(msg)
  | compiler.CompileOk env ->
      match dict_get(sentinel_name(), env) with
      | Nothing -> error_response("eval_expr_in_source: could not infer type of expression")
      | Just scheme -> eval_with_scheme(src, expr, state, scheme)

fn op_eval_expr_in_source(src: String, expr: String, state: StartupState) -> json.Json !{IO} =
  if str_find(src, "let " ++ sentinel_name()) != -1 then
    error_response("source contains reserved name '" ++ sentinel_name() ++ "'; cannot eval")
  else do
    type_result <- compiler.compile_source_with_cache(augment_source(src, expr), state_stdlib_root(state), state_cache(state))
    eval_with_type_result(src, expr, state, type_result)

# ---------------------------------------------------------------------------
# Session ops (M2)

fn compile_fail_response(diags: List compiler.Diagnostic) -> json.Json =
  match diags with
  | Nil -> error_response("type check failed")
  | Cons d _ ->
      match d with
      | compiler.DiagError msg -> error_response(msg)
      | compiler.DiagWarning msg -> error_response(msg)

fn op_session_create(state: StartupState) -> json.Json !{IO} =
  do
    sessions <- ref_read(state_sessions(state))
    next_id <- ref_read(state_next_id(state))
    ref_write(state_sessions(state), dict_set(int_to_string(next_id), SessionState(vec_empty(), vec_empty()), sessions))
    ref_write(state_next_id(state), next_id + 1)
    ok_response(json.JsonInt(next_id))

fn op_session_destroy(req: json.Json, state: StartupState) -> json.Json !{IO} =
  match require_int_field(req, "session_id") with
  | Err msg -> error_response(msg)
  | Ok session_id ->
      do
        sessions <- ref_read(state_sessions(state))
        ref_write(state_sessions(state), dict_remove(int_to_string(session_id), sessions))
        ok_response(json.JsonBool(true))

fn op_session_update(req: json.Json, state: StartupState) -> json.Json !{IO} =
  match require_int_field(req, "session_id") with
  | Err msg -> error_response(msg)
  | Ok session_id ->
      match require_string_field(req, "kind") with
      | Err msg -> error_response(msg)
      | Ok kind ->
          match require_string_field(req, "line") with
          | Err msg -> error_response(msg)
          | Ok line ->
              do
                sessions <- ref_read(state_sessions(state))
                match dict_get(int_to_string(session_id), sessions) with
                | Nothing -> error_response("unknown session: " ++ int_to_string(session_id))
                | Just sess ->
                    do
                      let new_sess = session_add_line(sess, kind, line)
                      let check_src = rebuild_session_source(new_sess)
                      check_result <- compiler.compile_source_with_cache(check_src, state_stdlib_root(state), state_cache(state))
                      match check_result with
                      | compiler.CompileFail diags -> compile_fail_response(diags)
                      | compiler.CompileOk _ ->
                          do
                            ref_write(state_sessions(state), dict_set(int_to_string(session_id), new_sess, sessions))
                            ok_response(json.JsonBool(true))

fn op_session_eval(req: json.Json, state: StartupState) -> json.Json !{IO} =
  match require_int_field(req, "session_id") with
  | Err msg -> error_response(msg)
  | Ok session_id ->
      match require_string_field(req, "expr") with
      | Err msg -> error_response(msg)
      | Ok expr ->
          do
            sessions <- ref_read(state_sessions(state))
            match dict_get(int_to_string(session_id), sessions) with
            | Nothing -> error_response("unknown session: " ++ int_to_string(session_id))
            | Just sess ->
                op_eval_expr_in_source(rebuild_session_source(sess), expr, state)

fn op_session_type_of(req: json.Json, state: StartupState) -> json.Json !{IO} =
  match require_int_field(req, "session_id") with
  | Err msg -> error_response(msg)
  | Ok session_id ->
      match require_string_field(req, "expr") with
      | Err msg -> error_response(msg)
      | Ok expr ->
          do
            sessions <- ref_read(state_sessions(state))
            match dict_get(int_to_string(session_id), sessions) with
            | Nothing -> error_response("unknown session: " ++ int_to_string(session_id))
            | Just sess ->
                op_type_of_in_source(rebuild_session_source(sess), expr, state)

fn op_session_diagnostics(req: json.Json, state: StartupState) -> json.Json !{IO} =
  match require_int_field(req, "session_id") with
  | Err msg -> error_response(msg)
  | Ok session_id ->
      do
        sessions <- ref_read(state_sessions(state))
        match dict_get(int_to_string(session_id), sessions) with
        | Nothing -> error_response("unknown session: " ++ int_to_string(session_id))
        | Just sess ->
            op_diagnostics_in_source(rebuild_session_source(sess), state)

# ---------------------------------------------------------------------------
# Request dispatch

fn dispatch_op(op: String, req: json.Json, state: StartupState) -> json.Json !{IO} =
  if op == "check_source" then
    match require_string_field(req, "module_source") with
    | Err msg -> error_response(msg)
    | Ok src ->
        if state_stdlib_root(state) == "" then error_response("stdlib-root not configured for semantic ops")
        else op_check_source(src, state)
  else if op == "diagnostics_in_source" then
    match require_string_field(req, "module_source") with
    | Err msg -> error_response(msg)
    | Ok src ->
        if state_stdlib_root(state) == "" then empty_diags_response()
        else op_diagnostics_in_source(src, state)
  else if op == "declared_names_in_source" then
    match require_string_field(req, "module_source") with
    | Err msg -> error_response(msg)
    | Ok src -> op_declared_names_in_source(src)
  else if op == "exported_names_in_source" then
    match require_string_field(req, "module_source") with
    | Err msg -> error_response(msg)
    | Ok src -> op_exported_names_in_source(src)
  else if op == "symbol_inventory_in_source" then
    match require_string_field(req, "module_source") with
    | Err msg -> error_response(msg)
    | Ok src -> op_symbol_inventory_in_source(src)
  else if op == "symbol_locations_in_source" then
    match require_string_field(req, "module_source") with
    | Err msg -> error_response(msg)
    | Ok src -> op_symbol_locations_in_source(src)
  else if op == "type_of_in_source" then
    match require_string_field(req, "module_source") with
    | Err msg -> error_response(msg)
    | Ok src ->
        match require_string_field(req, "expr") with
        | Err msg -> error_response(msg)
        | Ok expr ->
            if state_stdlib_root(state) == "" then error_response("stdlib-root not configured for semantic ops")
            else op_type_of_in_source(src, expr, state)
  else if op == "instances_in_source" then not_implemented(op)
  else if op == "eval_expr_in_source" then
    match require_string_field(req, "module_source") with
    | Err msg -> error_response(msg)
    | Ok src ->
        match require_string_field(req, "expr") with
        | Err msg -> error_response(msg)
        | Ok expr ->
            if state_stdlib_root(state) == "" then error_response("stdlib-root not configured for semantic ops")
            else op_eval_expr_in_source(src, expr, state)
  else if op == "complete_in_state" then not_implemented(op)
  else if op == "session_create" then op_session_create(state)
  else if op == "session_update" then op_session_update(req, state)
  else if op == "session_eval" then op_session_eval(req, state)
  else if op == "session_type_of" then op_session_type_of(req, state)
  else if op == "session_diagnostics" then op_session_diagnostics(req, state)
  else if op == "session_destroy" then op_session_destroy(req, state)
  else error_response(string.concat("unknown op: ", op))

fn dispatch(req: json.Json, state: StartupState) -> json.Json !{IO} =
  match json.json_get_field(req, "op") with
  | Nothing -> error_response("missing 'op' field")
  | Just op_val ->
      match json.json_get_string(op_val) with
      | Nothing -> error_response("'op' must be a string")
      | Just op -> dispatch_op(op, req, state)

fn dispatch_line(line: String, state: StartupState) -> json.Json !{IO} =
  match json.parse(line) with
  | Err (json.JsonDecode msg) -> error_response(string.concat("invalid JSON: ", msg))
  | Ok req -> dispatch(req, state)

# ---------------------------------------------------------------------------
# Service loop

fn service_loop(state: StartupState) -> Unit !{IO} =
  match term_read_line() with
  | Nothing -> ()
  | Just line ->
      if string.is_empty(line) then service_loop(state)
      else
        do
          response <- dispatch_line(line, state)
          term_write(json.stringify(response) ++ "\n")
          service_loop(state)

export fn run_service(stdlib_root: String) -> Unit !{IO} =
  if stdlib_root == "" then do
    runtime_obj_ref <- ref_new("")
    cache <- module_loader.new_cache()
    sessions <- ref_new(dict_empty())
    next_id <- ref_new(1)
    service_loop(StartupState("", runtime_obj_ref, cache, sessions, next_id))
  else do
    state <- build_startup_state(stdlib_root)
    service_loop(state)

