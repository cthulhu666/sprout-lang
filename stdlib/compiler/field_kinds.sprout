module stdlib.compiler.field_kinds

# Single source of truth for the ctor-field-kinds encoding used by both
# native backends (stdlib.compiler.codegen and stdlib.compiler.ast_to_ir).
#
# Encoding (byte per constructor field, in source order):
#   'i' — Int | Char    (scalar, not GC-tracked; a Char is an immediate i64
#         codepoint, identical to Int for rooting purposes)
#   'b' — Bool          (scalar, not GC-tracked)
#   's' — String        (heap; rooted across allocations)
#   'p' — ADT/closure/tuple/function   (heap, GC handle)
#   '_' — type-variable                (heap, conservative)
#
# Prior to /code-review fix #10 this encoder was duplicated across
# codegen.sprout and ast_to_ir.sprout, and the decoder lived only in
# ast_to_ir.sprout — three independent copies of the same character set
# with drift risk. Centralising them here closes the surface.

import stdlib.compiler.ast as ast
import stdlib.compiler.sprout_ir as sprout_ir
import stdlib.compiler.type_kind as type_kind
import stdlib.string as string

# --- Private helpers ---

fn char_is_uppercase(ch: Char) -> Bool =
  str_find("ABCDEFGHIJKLMNOPQRSTUVWXYZ", char_to_string(ch)) >= 0

# --- Encoder ---

# Map a constructor field's source-level TypeExpr to a one-byte kind code.
# O(1) modulo string traversal in helpers. Primitives match their canonical name
# exactly: a module's own `type Bool` is `<module>.Bool`, a heap ADT.
export fn ctor_field_kind(te: ast.TypeExpr) -> String =
  match type_kind.scalar_field_code(te) with
  | Just code -> code
  | Nothing -> ctor_field_kind_heap(te)

# Fields with no scalar code.  A `Double` field encodes "p" here although type_kind
# calls Double a scalar (see type_kind.scalar_field_code).
fn ctor_field_kind_heap(te: ast.TypeExpr) -> String =
  match te with
  | ast.TypeName name ->
      if name == "String" then "s"
      else
        match str_char_at(string.after_last_dot(name), 0) with
        | Nothing -> "_"
        | Just ch -> if char_is_uppercase(ch) then "p" else "_"
  | ast.TypeArrow _ _ _ _ -> "p"
  | ast.TypeThunk _ _ -> "p"
  | ast.TypeApply _ _ -> "p"
  | ast.TypeEffect inner _ -> ctor_field_kind(inner)
  | ast.TupleType _ -> "p"

# Concatenate field-kind bytes for an arg list, in source order.
# O(n) field count.
export fn ctor_field_kinds_string(exprs: List ast.TypeExpr) -> String =
  match exprs with
  | Nil -> ""
  | Cons e rest -> ctor_field_kind(e) ++ ctor_field_kinds_string(rest)

# --- Decoder ---

# Decode a single field-kind byte to the rooting-classification IRType
# expected by ir_rooting's op_produces_simple_heap.
#   'i' / 'b'    → IRTScalar  ('i' covers Int and Char codepoints)
#   's' / 'p'    → IRTHeap
#   '_'          → IRTUnknown (type-variable; treated as heap by rooting)
#   anything else→ IRTUnknown (defensive fallback)
export fn field_kind_char_to_irtype(ch: Char) -> sprout_ir.IRType =
  match type_kind.scalar_of_field_code(ch) with
  | Just why -> sprout_ir.IRTScalar(why)
  | Nothing -> if ch == 's' || ch == 'p' then sprout_ir.IRTHeap else sprout_ir.IRTUnknown

# Look up the field kind IRType at index i in the field-kinds-string.
# In correct compiler operation `i` is always in range (fks length is one
# byte per ctor arg). The Nothing branch is a defensive fallback for
# internal-compiler-bug paths only; callers (ast_to_ir.bind_pattern_fields) guard
# the bounds explicitly so this branch is unreachable when the upstream
# invariant holds. Conservative IRTUnknown is correctness-safe — at worst
# over-roots.
export fn fk_at(fks: String, i: Int) -> sprout_ir.IRType =
  match str_char_at(fks, i) with
  | Nothing -> sprout_ir.IRTUnknown
  | Just ch -> field_kind_char_to_irtype(ch)
