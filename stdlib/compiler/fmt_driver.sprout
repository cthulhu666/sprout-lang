module stdlib.compiler.fmt_driver

import stdlib.compiler.formatter as formatter
import stdlib.compiler.lint_rules as lint_rules
import stdlib.compiler.fmt_cli as fmt_cli
import stdlib.string as string
import stdlib.fs as fs

# What to do with each path. Separate from fmt_cli.Command so the fold below has
# no unreachable usage case.
type Mode =
  | ModeFmtWrite
  | ModeFmtCheck
  | ModeLint

fn print_issues(path: String, issues: List formatter.LintIssue) -> Unit !{IO} =
  match issues with
  | Nil -> ()
  | Cons h t ->
      match h with
      | formatter.LintIssue ln col msg ->
          do
            print(path ++ ":" ++ int_to_string(ln) ++ ":" ++ int_to_string(col) ++ ": " ++ msg)
            print_issues(path, t)

fn print_findings(path: String, findings: List lint_rules.LintFinding) -> Unit !{IO} =
  match findings with
  | Nil -> ()
  | Cons h t ->
      match h with
      | lint_rules.LintFinding ln col rule_id msg ->
          do
            print(path ++ ":" ++ int_to_string(ln) ++ ":" ++ int_to_string(col) ++
              ": [" ++ rule_id ++ "] " ++ msg)
            print_findings(path, t)

# A failure reports on stderr and fails the run, leaving stdout to carry only the
# report (docs/compiler-internals.md §Driver diagnostic contract). One unreadable
# path must not abandon the rest of the batch, so neither of these panics.
fn read_failed(path: String, msg: String) -> Int !{IO} =
  do
    eprint("read_file: " ++ path ++ ": " ++ msg)
    1

fn write_failed(path: String, msg: String) -> Int !{IO} =
  do
    eprint("write_file: " ++ path ++ ": " ++ msg)
    1

fn run_fmt_check(path: String) -> Int !{IO} =
  match fs.read_text(path) with
  | Err msg -> read_failed(path, msg)
  | Ok src ->
      do
        let formatted = formatter.format_source(src)
        let current = if string.ends_with(src, "\n") then src else src ++ "\n"
        if formatted == current
        then do
          print("ok: " ++ path)
          0
        else do
          print("needs formatting: " ++ path)
          1

fn run_fmt_write(path: String) -> Int !{IO} =
  match fs.read_text(path) with
  | Err msg -> read_failed(path, msg)
  | Ok src ->
      do
        let formatted = formatter.format_source(src)
        let current = if string.ends_with(src, "\n") then src else src ++ "\n"
        if formatted == current
        then do
          print("ok: " ++ path)
          0
        else
          match fs.write_text(path, formatted) with
          | Err msg -> write_failed(path, msg)
          | Ok _ ->
              do
                print("formatted " ++ path)
                0

fn run_lint_file(path: String) -> Int !{IO} =
  match fs.read_text(path) with
  | Err msg -> read_failed(path, msg)
  | Ok src ->
      do
        let issues = formatter.lint_source(src)
        let findings = lint_rules.lint_ast(src)
        print_issues(path, issues)
        print_findings(path, findings)
        match (issues, findings) with
        | (Nil, Nil) ->
            do
              print("ok: " ++ path)
              0
        | _ -> 1

fn run_one(mode: Mode, path: String) -> Int !{IO} =
  match mode with
  | ModeFmtWrite -> run_fmt_write(path)
  | ModeFmtCheck -> run_fmt_check(path)
  | ModeLint -> run_lint_file(path)

# Worst exit code wins, so a batch reports every bad file and still fails.
fn keep_worst(mode: Mode, worst: Int, path: String) -> Int !{IO} =
  do
    code <- run_one(mode, path)
    if code > worst then code else worst

fn run_all(mode: Mode, paths: List String) -> Int !{IO} =
  list_fold(\ (worst, path) -> keep_worst(mode, worst, path), 0, paths)

fn main() -> Int !{IO} =
  do
    args <- argv_all()
    match fmt_cli.parse_command(args) with
    | fmt_cli.CmdFmt paths -> run_all(ModeFmtWrite, paths)
    | fmt_cli.CmdFmtCheck paths -> run_all(ModeFmtCheck, paths)
    | fmt_cli.CmdLint paths -> run_all(ModeLint, paths)
    | fmt_cli.CmdUsage msg ->
        do
          eprint(msg)
          1
