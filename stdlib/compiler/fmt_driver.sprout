module stdlib.compiler.fmt_driver

import stdlib.compiler.formatter as formatter
import stdlib.string as string

fn print_issues(path: String, issues: List formatter.LintIssue) -> Unit !{IO} =
  match issues with
  | Nil -> ()
  | Cons h t ->
      match h with
      | formatter.LintIssue ln col msg ->
          do
            print(path ++ ":" ++ int_to_string(ln) ++ ":" ++ int_to_string(col) ++ ": " ++ msg)
            print_issues(path, t)

fn run_fmt_check(path: String) -> Int !{IO} =
  match read_file(path) with
  | Err msg -> panic("read_file: " ++ path ++ ": " ++ msg)
  | Ok src ->
      do
        let formatted = formatter.format_source(src)
        let current = if string.ends_with(src, "\n") then src else src ++ "\n"
        if formatted == current
        then do
          print("ok")
          0
        else do
          print("needs formatting: " ++ path)
          1

fn run_fmt_write(path: String) -> Int !{IO} =
  match read_file(path) with
  | Err msg -> panic("read_file: " ++ path ++ ": " ++ msg)
  | Ok src ->
      do
        let formatted = formatter.format_source(src)
        let current = if string.ends_with(src, "\n") then src else src ++ "\n"
        if formatted == current
        then do
          print("ok: " ++ path)
          0
        else
          match write_file(path, formatted) with
          | Err msg -> panic("write_file: " ++ path ++ ": " ++ msg)
          | Ok _ ->
              do
                print("formatted " ++ path)
                0

fn run_lint_file(path: String) -> Int !{IO} =
  match read_file(path) with
  | Err msg -> panic("read_file: " ++ path ++ ": " ++ msg)
  | Ok src ->
      do
        let issues = formatter.lint_source(src)
        match issues with
        | Nil ->
            do
              print("ok")
              0
        | _ ->
            do
              print_issues(path, issues)
              1

fn main() -> Int !{IO} =
  do
    args <- argv_all()
    match args with
    | ["fmt", "--check", path | _] -> run_fmt_check(path)
    | ["fmt", "--check" | _] ->
        do
          print("fmt --check: missing path")
          1
    | ["fmt", path | _] -> run_fmt_write(path)
    | ["fmt" | _] ->
        do
          print("fmt: missing path")
          1
    | ["lint", path | _] -> run_lint_file(path)
    | ["lint" | _] ->
        do
          print("lint: missing path")
          1
    | [cmd | _] ->
        do
          print("unknown subcommand: " ++ cmd)
          1
    | _ ->
        do
          print("usage: fmt_bin [fmt|lint] <path>")
          1
