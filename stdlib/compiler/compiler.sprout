module stdlib.compiler.compiler
import stdlib.compiler.lexer as lexer
import stdlib.compiler.token as token
import stdlib.compiler.parser as parser
import stdlib.compiler.ast as ast
import stdlib.compiler.checker as checker
import stdlib.compiler.types as types
import stdlib.compiler.unifier as unifier
import stdlib.compiler.module_loader as module_loader
import stdlib.compiler.bundler as bundler
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.resolve as resolve
import stdlib.compiler.verify_dispatch as verify_dispatch
import stdlib.compiler.lowering as lowering
import stdlib.compiler.dce as dce
import stdlib.compiler.ir_pipeline as ir_pipeline
import stdlib.compiler.source as source
import stdlib.fs as fs
import stdlib.env as env
import stdlib.string as string

# ---------------------------------------------------------------------------
# Public API types
# ---------------------------------------------------------------------------

# A request to compile/check a source string
export type CompileRequest (..) =
  | CheckRequest String

# A diagnostic: error or warning with source location.
# pos carries the point of origin set at construction; use source.SourcePos(0,0,0)
# only as a placeholder when the upstream error type does not yet carry a position.
export type Diagnostic (..) =
  | DiagError source.SourcePos String
  | DiagWarning source.SourcePos String

# The result of a compile/check request
export type CompileResult (..) =
  | CompileOk (Dict types.Scheme)
  | CompileFail (List Diagnostic)

# Header stripping is shared: source.strip_headers (line-preserving) is the
# single authority — skips leading module/import/comment/blank lines while
# preserving line numbers for diagnostics.

# ---------------------------------------------------------------------------
# Core pipeline
# ---------------------------------------------------------------------------
#
# LexParseResult is a custom ADT (not Result) so that the Python typechecker
# does not apply Result-sequencing to the Err/Ok match inside an IO function.
# Same pattern as DeclResult / InferResult in infer.sprout.

type LexParseResult =
  | LexParseOk ast.Program
  | LexParseFail (List Diagnostic)

# no_pos: placeholder used when the upstream error type does not yet carry a
# SourcePos.  Every call site is a Phase-2 TODO: fix the upstream type instead.
fn no_pos() -> source.SourcePos = source.SourcePos(0, 0, 0)

fn lex_err_diag(e: token.TokenizeError) -> Diagnostic =
  match e with
  | token.TokenizeError msg pos -> DiagError(pos, "lex: " ++ msg)

fn parse_err_diag(e: parser.ParseError) -> Diagnostic =
  match e with
  | parser.ParseError msg pos -> DiagError(pos, "parse: " ++ msg)

fn lex_parse(src: String) -> LexParseResult =
  match lexer.tokenize(src) with
  | Err e -> LexParseFail(Cons(lex_err_diag(e), Nil))
  | Ok tokens ->
      match parser.parse_program(tokens) with
      | Err e -> LexParseFail(Cons(parse_err_diag(e), Nil))
      | Ok prog -> LexParseOk(prog)

# compile_source: run full lex -> parse -> check pipeline on raw source text.
export fn compile_source(src: String) -> CompileResult !{IO} =
  match lex_parse(src) with
  | LexParseFail diags -> CompileFail(diags)
  | LexParseOk prog ->
      do
        result <- checker.check_program(prog)
        match result with
        | checker.CheckErr pos msg -> CompileFail(Cons (DiagError(pos, "check: " ++ msg), Nil))
        | checker.CheckOk env -> CompileOk(env)

# ---------------------------------------------------------------------------
# Declaration lookup — the query behind go-to-definition.
#
# Lives here rather than in the LSP transport because the protocol layer should stay
# thin (docs/language-server-roadmap.md §4.3), and because the REPL and analysis
# service want the same answer.
#
# A declaration "introduces" a name when it appears in either axis of the shared
# authority: ast.decl_value_scopes (values, including constructors and class methods)
# or ast.decl_type_names (types, classes, aliases). Every Decl carries a SourcePos, so
# the position is ast.decl_pos — no per-constructor match here, which is the point.
#
# Positions are ORIGINAL line numbers: source.strip_headers blanks header lines rather
# than deleting them, precisely so this holds.

fn decl_introduces(d: ast.Decl, name: String) -> Bool =
  list_member(name, ast.scope_names_all(ast.decl_value_scopes(d)))
    || list_member(name, ast.decl_type_names(d))

fn find_decl_pos(decls: List ast.Decl, name: String) -> Maybe source.SourcePos =
  match decls with
  | Nil -> Nothing
  | Cons d rest ->
      if decl_introduces(d, name) then Just(ast.decl_pos(d))
      else find_decl_pos(rest, name)

# Where `name` is declared in `src`, or Nothing when this source does not declare it.
# A constructor or class method resolves to its enclosing declaration — there is no
# finer position recorded, and landing on the type or class is what a reader wants.
export fn declaration_position(src: String, name: String) -> Maybe source.SourcePos =
  match lex_parse(source.strip_headers(src)) with
  | LexParseFail _ -> Nothing
  | LexParseOk prog ->
      match prog with
      | ast.Program decls _ -> find_decl_pos(decls, name)

# compile_source_with_roots: like compile_source but also resolves imports.
# Accepts raw source (with module/import header).
# stdlib_root is the filesystem root for stdlib.* module resolution; extra_roots are
# package roots for dotted non-stdlib imports, matching the batch CLI's --package-root.
export fn compile_source_with_roots(src: String, stdlib_root: source.StdlibRoot, extra_roots: List String) -> CompileResult !{IO} =
  do
    load_env <- bundler.new_load_env()
    compile_source_with_cache_roots(src, stdlib_root, extra_roots, load_env)

# stdlib-only form. Most callers have no package roots; those that do (the LSP, and
# anything else driving a multi-root project) call the roots form above.
export fn compile_source_with_root(src: String, stdlib_root: source.StdlibRoot) -> CompileResult !{IO} =
  compile_source_with_roots(src, stdlib_root, Nil)

# The path an in-memory buffer occupies while it is bundled. It need not exist: the
# source is supplied through the overlay, so it is a key rather than a location. Callers
# that DO have a real path should still prefer it, so load errors name something real.
export fn source_entry_path() -> String = "<source>"

# compile_source_with_cache_roots: typecheck raw source the way the batch compiler
# typechecks a file — by bundling it — reusing a caller-owned LoadEnv so a session that
# checks the same buffer repeatedly re-parses only that buffer.
#
# THIS FUNCTION IS WHY THE TWO FRONT ENDS ARE NOW ONE. It used to build an environment of
# imported SCHEMES (`load_prelude_pairs` + `build_import_pairs_with_roots`) and check
# against that, while the batch compiler bundled imported DECLS and checked those. Same
# question, two implementations, and they disagreed in at least four ways on the example
# corpus alone — a false `Vec vs List`, unknown imported constructors, unresolved
# qualified names, and one file on which the env path did not terminate at all. See
# `scripts/front_end_agreement.sh`, which exists to keep them from drifting apart again.
#
# `cache` keeps its name and position, so the ~30 call sites are unchanged; only the value
# they construct moved from `module_loader.new_cache()` to `bundler.new_load_env()`.
#
# It is now ANNOTATED, where it used to be left bare "because the module_loader callees
# constrain it". They no longer do: the bundler destructures a LoadEnv lazily, so a
# ModuleCache passed here type-checked fine and then died as `runtime error:
# non-exhaustive match` inside an accessor. An annotation makes that a compile error at
# the call site, which is where the mistake is.
export fn compile_source_with_cache_roots(src: String, stdlib_root: source.StdlibRoot, extra_roots: List String,
                                          cache: bundler.LoadEnv) -> CompileResult !{IO} =
  compile_source_at_with_cache_roots(src, source_entry_path(), stdlib_root, extra_roots, cache)

# As above, but for a buffer that HAS a path on disk. Load errors then name the real file
# instead of the placeholder, which is what an editor should report.
export fn compile_source_at_with_cache_roots(src: String, entry_path: String, stdlib_root: source.StdlibRoot,
                                             extra_roots: List String, cache: bundler.LoadEnv) -> CompileResult !{IO} =
  do
    bundled <- bundler.bundle_source_with_roots(src, entry_path, stdlib_root, extra_roots, cache)
    match bundled with
    | bundler.BundleErr pos msg -> CompileFail(Cons (DiagError(pos, "bundle: " ++ msg), Nil))
    | bundler.BundleOk prog ->
        do
          result <- check_bundled(prog, stdlib_root, cache)
          match result with
          | typed_ast.TypedErr pos msg -> CompileFail(Cons (DiagError(pos, msg), Nil))
          | typed_ast.TypedOk _ env -> CompileOk(unqualify_entry_names(bundler.scan_module_name(src), env))

# Bundling qualifies a named module's own top-level names (`examples.foo.bar`), but every
# consumer of this env looks them up as written in the file — the REPL's sentinel, the
# analysis service's ops, `dump_typed_names`. Re-expose the entry module's own names bare
# so the API's contract is unchanged by how it is now implemented. Qualified keys are
# kept as well, since imported names are only reachable that way.
fn unqualify_entry_names(module_name: String, env: Dict types.Scheme) -> Dict types.Scheme =
  if module_name == "" then env
  else add_bare_aliases(vec_to_list(dict_entries(env)), module_name ++ ".", env)

fn add_bare_aliases(entries: List (String, types.Scheme), prefix: String, acc: Dict types.Scheme) -> Dict types.Scheme =
  match entries with
  | Nil -> acc
  | Cons (key, scheme) rest ->
      match string.strip_prefix(key, prefix) with
      | Nothing -> add_bare_aliases(rest, prefix, acc)
      | Just bare -> add_bare_aliases(rest, prefix, dict_set(bare, scheme, acc))

export fn compile_source_with_cache(src: String, stdlib_root: source.StdlibRoot, cache: bundler.LoadEnv) -> CompileResult !{IO} =
  compile_source_with_cache_roots(src, stdlib_root, Nil, cache)

# ---------------------------------------------------------------------------
# The type of an expression in a source context
# ---------------------------------------------------------------------------
#
# Append a sentinel binding to the module, typecheck it, and read the sentinel's Scheme
# back out of the resulting env:
#
#   <src>
#   let __repl_source_value = <expr>
#
# The single authority for that trick. Three callers need it — the analysis service's
# type_of_in_source and eval_expr_in_source, and hover in the LSP — and eval needs the
# Scheme itself (it branches on pure vs !{IO} to decide how to print a value), so the
# core returns the Scheme and rendering to a string is a wrapper over it.
#
# Failures are an ADT rather than a message: the service's error strings and the REPL's
# :type output are observable, so each caller renders its own wording. A custom ADT and
# not Result, for the LexParseResult reason above.

export type ExprSchemeResult (..) =
  | ExprSchemeOk types.Scheme
  | ExprSentinelCollision
  | ExprCheckFailed (List Diagnostic)
  | ExprNotInferable

# Unlikely to collide with user code, but double-underscore names ARE valid Sprout
# identifiers (the lexer accepts _ as identifier-start), so the collision is checked.
# Exported because a caller rendering the collision message needs to name it.
export fn expr_sentinel_name() -> String = "__repl_source_value"

fn augment_with_sentinel(src: String, expr: String) -> String =
  src ++ "\nlet " ++ expr_sentinel_name() ++ " = " ++ expr

export fn scheme_of_expr_in_source(src: String, expr: String, stdlib_root: source.StdlibRoot,
                                   extra_roots: List String, cache: bundler.LoadEnv) -> ExprSchemeResult !{IO} =
  if str_find(src, "let " ++ expr_sentinel_name()) != -1 then ExprSentinelCollision
  else
    do
      result <- compile_source_with_cache_roots(
        augment_with_sentinel(src, expr), stdlib_root, extra_roots, cache)
      match result with
      | CompileFail diags -> ExprCheckFailed(diags)
      | CompileOk env -> scheme_from_env(expr, env)

# A bare name answers with what it was DECLARED as; anything else goes through the
# sentinel.
#
# The sentinel re-infers the type of a *reference* to the name, and referencing a value is
# pure — so a declared effect that lives only on the Scheme is replaced by the sentinel's
# own. That is every zero-parameter function: it has no arrow to carry the effect (see
# `types.scheme_effect_suffix`), so `fn main() -> Unit !{IO}` reported as plain `Unit` in
# hover, the REPL's `:type` and the analysis service alike, while the checked env held
# `Unit !{IO}` under the name's own key the whole time.
#
# Only top-level names can hit, because the sentinel is appended at module scope and sees
# exactly the same bindings — so this changes which Scheme is read, never which name
# resolves.
fn scheme_from_env(expr: String, env: Dict types.Scheme) -> ExprSchemeResult =
  match dict_get(string.trim(expr), env) with
  | Just declared -> ExprSchemeOk(declared)
  | Nothing ->
      match dict_get(expr_sentinel_name(), env) with
      | Nothing -> ExprNotInferable
      | Just scheme -> ExprSchemeOk(scheme)

# Rendered form, for hover and :type. Nothing on any failure — a caller that needs to
# say WHY calls scheme_of_expr_in_source and matches the reason.
export fn type_of_expr_in_source(src: String, expr: String, stdlib_root: source.StdlibRoot,
                                 extra_roots: List String, cache: bundler.LoadEnv) -> Maybe String !{IO} =
  match scheme_of_expr_in_source(src, expr, stdlib_root, extra_roots, cache) with
  | ExprSchemeOk scheme -> Just(types.scheme_to_string(scheme))
  | ExprSentinelCollision -> Nothing
  | ExprCheckFailed _ -> Nothing
  | ExprNotInferable -> Nothing

# compile_file: read a file, strip headers, then call compile_source.
export fn compile_file(path: source.FilePath) -> CompileResult !{IO} =
  match fs.read_text(source.filepath_str(path)) with
  | Err msg -> panic("read_file: " ++ source.filepath_str(path) ++ ": " ++ msg)
  | Ok src -> compile_source(source.strip_headers(src))

# ---------------------------------------------------------------------------
# Full pipeline: bundle → typecheck → lower (M4)
# ---------------------------------------------------------------------------
#
# compile_full is the Sprout-native end-to-end compiler entry point.
# It chains all three passes that M1-M3 individually verified:
#
#   1. bundler.bundle_file    — load entry file + imports, qualify names  (M3)
#   2. checker.typecheck_typed — HM type inference + typed IR production  (M1)
#   3. lowering.lower_program  — dictionary-passing typeclass lowering     (M2)
#
# Returns the lowered ast.Program plus the final type env on success, or a
# diagnostic list on the first failing stage.

export type FullResult (..) =
  | FullOk typed_ast.TypedProgram (Dict types.Scheme)
  | FullFail (List Diagnostic)

export fn compile_full(path: source.FilePath, stdlib_root: source.StdlibRoot) -> FullResult !{IO} =
  do
    bundle_result <- bundler.bundle_file(path, stdlib_root)
    match bundle_result with
    | bundler.BundleErr pos msg -> FullFail(Cons (DiagError(pos, "bundle: " ++ msg), Nil))
    | bundler.BundleOk prog ->
        do
          cache <- module_loader.new_cache()
          prelude_pairs <- module_loader.load_prelude_pairs(source.stdlib_root_str(stdlib_root), cache)
          tc_result <- checker.typecheck_typed(prog, prelude_pairs)
          match tc_result with
          | typed_ast.TypedErr pos msg -> FullFail(Cons (DiagError(pos, "check: " ++ msg), Nil))
          | typed_ast.TypedOk typed_prog env ->
              FullOk(lowering.lower_program(typed_prog, env), env)

# ---------------------------------------------------------------------------
# Full IR pipeline: bundle → typecheck → lower → codegen
# ---------------------------------------------------------------------------
#
# compile_full_ir emits LLVM IR text via the typed IR pipeline (ir_pipeline),
# the sole codegen backend.
#
# Lowering preserves types (lower_program returns TypedProgram), so a second
# typecheck is not needed.

export type IrFullResult (..) =
  | IrFullOk String
  | IrFullFail (List Diagnostic)

# ---------------------------------------------------------------------------
# Phase-isolated pipeline functions
#
# Each function runs the pipeline through a specific phase and returns only
# that phase's result.  Intermediate data (AST nodes from earlier phases) is
# freed when the function returns, because it never escapes into the caller's
# GC root set.  This prevents the simultaneous-live-set problem that caused
# stage-2 self-compile OOMs.
#
#   compile_phase_bundle  → bundler output only
#   compile_phase_check   → bundle + typecheck     (frees bundle on return)
#   compile_phase_lower   → + lower (typed)        (frees typed_prog on return)
#   compile_phase_recheck → alias for compile_phase_lower (no second typecheck)
#
# Lowering now preserves types (lower_program threads the scheme env and returns
# TypedProgram), so compile_phase_recheck is a plain alias.

# Coverage line for the dict-passing verifier, gated on SPROUT_VERIFY_DISPATCH_STATS.
# `verified > 0` on real programs is the evidence that the verifier fires on actual
# calls rather than skipping everything (a clean run vs. a silent no-op).
fn report_verify_stats(prog: typed_ast.TypedProgram) -> Unit !{IO} =
  match env.get("SPROUT_VERIFY_DISPATCH_STATS") with
  | Nothing -> ()
  | Just _ ->
      match verify_dispatch.verify_stats(prog) with
      | (ok, sk, mm) ->
          eprint("[verify-dispatch] stats: verified=" ++ int_to_string(ok)
                 ++ " skipped=" ++ int_to_string(sk) ++ " mismatched=" ++ int_to_string(mm))

export fn compile_phase_bundle(path: source.FilePath, stdlib_root: source.StdlibRoot) -> bundler.BundleResult !{IO} =
  compile_phase_bundle_with_roots(path, stdlib_root, Nil)

# _with_roots variants (docs/packaging-v0.md §10 phase 2): thread extra package
# roots to the bundler so dotted non-stdlib imports resolve across repos. The
# original phase entry points delegate here with no extra roots, so every other
# caller is unchanged.
export fn compile_phase_bundle_with_roots(path: source.FilePath, stdlib_root: source.StdlibRoot, extra_roots: List String) -> bundler.BundleResult !{IO} =
  bundler.bundle_file_with_roots(path, stdlib_root, extra_roots)

export fn compile_phase_check(path: source.FilePath, stdlib_root: source.StdlibRoot) -> typed_ast.TypedResult !{IO} =
  compile_phase_check_with_roots(path, stdlib_root, Nil)

# Phase: effects — typecheck and hand back the declared-vs-inferred effect census.
#
# Deliberately stops after the typecheck rather than reusing
# compile_phase_check_with_roots: resolve/lowering come after, and the reports are
# complete the moment inference finishes. Running the later passes would add time
# and new ways to fail without changing a single line of the report.
export fn compile_phase_effects_with_roots(path: source.FilePath, stdlib_root: source.StdlibRoot, extra_roots: List String)
    -> (typed_ast.TypedResult, List unifier.EffectReport) !{IO} =
  do
    bundle_result <- bundler.bundle_file_with_roots(path, stdlib_root, extra_roots)
    match bundle_result with
    | bundler.BundleErr pos msg -> (typed_ast.TypedErr(pos, "bundle: " ++ msg), Nil)
    | bundler.BundleOk prog ->
        do
          cache <- module_loader.new_cache()
          prelude_pairs <- module_loader.load_prelude_pairs(source.stdlib_root_str(stdlib_root), cache)
          checker.typecheck_typed_with_effects(prog, prelude_pairs)

export fn compile_phase_check_with_roots(path: source.FilePath, stdlib_root: source.StdlibRoot, extra_roots: List String) -> typed_ast.TypedResult !{IO} =
  do
    bundle_result <- bundler.bundle_file_with_roots(path, stdlib_root, extra_roots)
    match bundle_result with
    | bundler.BundleErr pos msg -> typed_ast.TypedErr(pos, "bundle: " ++ msg)
    | bundler.BundleOk prog ->
        do
          load_env <- bundler.new_load_env()
          check_bundled(prog, stdlib_root, load_env)

# Everything after the bundle: typecheck, resolve, verify dispatch. Shared so that
# checking a FILE and checking a BUFFER cannot diverge — the whole point of retiring the
# env path is that this code has exactly one implementation.
fn check_bundled(prog: ast.Program, stdlib_root: source.StdlibRoot, load_env: bundler.LoadEnv) -> typed_ast.TypedResult !{IO} =
  do
    prelude_pairs <- module_loader.load_prelude_pairs(
      source.stdlib_root_str(stdlib_root), bundler.load_env_schemes(load_env))
    result <- checker.typecheck_typed(prog, prelude_pairs)
    match result with
    | typed_ast.TypedErr pos msg -> typed_ast.TypedErr(pos, "check: " ++ msg)
    | typed_ast.TypedOk typed_prog env ->
        match resolve.resolve_program(typed_prog, env) with
        | resolve.ResolveErr pos msg -> typed_ast.TypedErr(pos, "check: " ++ msg)
        | resolve.ResolveOk resolved ->
            # Dictionary-passing verifier (retro item 1, phase 1). A finding is a
            # soundness bug (a dict resolved to the wrong instance) — fatal by
            # default, verified clean across the corpus + compiler source before
            # this flip. SPROUT_VERIFY_DISPATCH_OFF downgrades it to a warning
            # (escape hatch for an uncovered false positive in the wild);
            # SPROUT_VERIFY_DISPATCH_STATS logs coverage (verified/skipped/mismatched).
            do
              _ <- report_verify_stats(resolved)
              match verify_dispatch.verify_program(resolved) with
              | Nothing -> typed_ast.TypedOk(resolved, env)
              | Just (vpos, vmsg) ->
                  match env.get("SPROUT_VERIFY_DISPATCH_OFF") with
                  | Just _ ->
                      do
                        _ <- eprint("[verify-dispatch] (suppressed) " ++ vmsg)
                        typed_ast.TypedOk(resolved, env)
                  | Nothing -> typed_ast.TypedErr(vpos, "check: dispatch-verify: " ++ vmsg)

export fn compile_phase_lower(path: source.FilePath, stdlib_root: source.StdlibRoot) -> typed_ast.TypedResult !{IO} =
  compile_phase_lower_with_roots(path, stdlib_root, Nil)

export fn compile_phase_lower_with_roots(path: source.FilePath, stdlib_root: source.StdlibRoot, extra_roots: List String) -> typed_ast.TypedResult !{IO} =
  do
    check_result <- compile_phase_check_with_roots(path, stdlib_root, extra_roots)
    match check_result with
    | typed_ast.TypedErr pos msg -> typed_ast.TypedErr(pos, msg)
    | typed_ast.TypedOk typed_prog env ->
        typed_ast.TypedOk(dce.elim_program(lowering.lower_program(typed_prog, env)), env)

export fn compile_phase_recheck(path: source.FilePath, stdlib_root: source.StdlibRoot) -> typed_ast.TypedResult !{IO} =
  compile_phase_recheck_with_roots(path, stdlib_root, Nil)

export fn compile_phase_recheck_with_roots(path: source.FilePath, stdlib_root: source.StdlibRoot, extra_roots: List String) -> typed_ast.TypedResult !{IO} =
  compile_phase_lower_with_roots(path, stdlib_root, extra_roots)

export fn compile_full_ir(path: source.FilePath, stdlib_root: source.StdlibRoot) -> IrFullResult !{IO} =
  do
    recheck_result <- compile_phase_recheck(path, stdlib_root)
    match recheck_result with
    | typed_ast.TypedErr pos msg -> IrFullFail(Cons (DiagError(pos, msg), Nil))
    | typed_ast.TypedOk typed_lowered _ ->
        match ir_pipeline.compile_program_streaming(typed_lowered) with
        | Err msg -> IrFullFail(Cons (DiagError(no_pos(), "codegen: " ++ msg), Nil))
        | Ok ir_text -> IrFullOk(ir_text)


# compile_full_ir_with_cache: like compile_full_ir but uses a caller-provided module cache.
# Avoids recreating the cache on every eval when called from the analysis service daemon.
# Emits via the typed IR pipeline (ir_pipeline), the sole codegen backend.
export fn compile_full_ir_with_cache(path: source.FilePath, stdlib_root: source.StdlibRoot, cache) -> IrFullResult !{IO} =
  do
    recheck_result <- compile_phase_recheck_with_cache(path, stdlib_root, cache)
    match recheck_result with
    | typed_ast.TypedErr pos msg -> IrFullFail(Cons (DiagError(pos, msg), Nil))
    | typed_ast.TypedOk typed_lowered _ ->
        match ir_pipeline.compile_program_streaming(typed_lowered) with
        | Err msg -> IrFullFail(Cons (DiagError(no_pos(), "codegen: " ++ msg), Nil))
        | Ok ir_text -> IrFullOk(ir_text)

fn compile_phase_check_with_cache(path: source.FilePath, stdlib_root: source.StdlibRoot, cache) -> typed_ast.TypedResult !{IO} =
  do
    bundle_result <- bundler.bundle_file(path, stdlib_root)
    match bundle_result with
    | bundler.BundleErr pos msg -> typed_ast.TypedErr(pos, "bundle: " ++ msg)
    | bundler.BundleOk prog ->
        do
          prelude_pairs <- module_loader.load_prelude_pairs(source.stdlib_root_str(stdlib_root), cache)
          result <- checker.typecheck_typed(prog, prelude_pairs)
          match result with
          | typed_ast.TypedErr pos msg -> typed_ast.TypedErr(pos, "check: " ++ msg)
          | typed_ast.TypedOk typed_prog env ->
              match resolve.resolve_program(typed_prog, env) with
              | resolve.ResolveErr pos msg -> typed_ast.TypedErr(pos, "check: " ++ msg)
              | resolve.ResolveOk resolved ->
                  # Dictionary-passing verifier (retro item 1, phase 1). A finding is a
                  # soundness bug (a dict resolved to the wrong instance) — fatal by
                  # default, verified clean across the corpus + compiler source before
                  # this flip. SPROUT_VERIFY_DISPATCH_OFF downgrades it to a warning
                  # (escape hatch for an uncovered false positive in the wild);
                  # SPROUT_VERIFY_DISPATCH_STATS logs coverage (verified/skipped/mismatched).
                  do
                    _ <- report_verify_stats(resolved)
                    match verify_dispatch.verify_program(resolved) with
                    | Nothing -> typed_ast.TypedOk(resolved, env)
                    | Just (vpos, vmsg) ->
                        match env.get("SPROUT_VERIFY_DISPATCH_OFF") with
                        | Just _ ->
                            do
                              _ <- eprint("[verify-dispatch] (suppressed) " ++ vmsg)
                              typed_ast.TypedOk(resolved, env)
                        | Nothing -> typed_ast.TypedErr(vpos, "check: dispatch-verify: " ++ vmsg)

fn compile_phase_lower_with_cache(path: source.FilePath, stdlib_root: source.StdlibRoot, cache) -> typed_ast.TypedResult !{IO} =
  do
    check_result <- compile_phase_check_with_cache(path, stdlib_root, cache)
    match check_result with
    | typed_ast.TypedErr pos msg -> typed_ast.TypedErr(pos, msg)
    | typed_ast.TypedOk typed_prog env ->
        typed_ast.TypedOk(dce.elim_program(lowering.lower_program(typed_prog, env)), env)

fn compile_phase_recheck_with_cache(path: source.FilePath, stdlib_root: source.StdlibRoot, cache) -> typed_ast.TypedResult !{IO} =
  compile_phase_lower_with_cache(path, stdlib_root, cache)
