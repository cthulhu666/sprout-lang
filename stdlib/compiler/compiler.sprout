module stdlib.compiler.compiler
import stdlib.compiler.lexer as lexer
import stdlib.compiler.token as token
import stdlib.compiler.parser as parser
import stdlib.compiler.ast as ast
import stdlib.compiler.checker as checker
import stdlib.compiler.types as types
import stdlib.compiler.module_loader as module_loader
import stdlib.compiler.bundler as bundler
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.resolve as resolve
import stdlib.compiler.verify_dispatch as verify_dispatch
import stdlib.compiler.lowering as lowering
import stdlib.compiler.dce as dce
import stdlib.compiler.ir_pipeline as ir_pipeline
import stdlib.compiler.source as source
import stdlib.fs as fs
import stdlib.env as env

# ---------------------------------------------------------------------------
# Public API types
# ---------------------------------------------------------------------------

# A request to compile/check a source string
export type CompileRequest (..) =
  | CheckRequest String

# A diagnostic: error or warning with source location.
# pos carries the point of origin set at construction; use source.SourcePos(0,0,0)
# only as a placeholder when the upstream error type does not yet carry a position.
export type Diagnostic (..) =
  | DiagError source.SourcePos String
  | DiagWarning source.SourcePos String

# The result of a compile/check request
export type CompileResult (..) =
  | CompileOk (Dict types.Scheme)
  | CompileFail (List Diagnostic)

# Header stripping is shared: source.strip_headers (line-preserving) is the
# single authority — skips leading module/import/comment/blank lines while
# preserving line numbers for diagnostics.

# ---------------------------------------------------------------------------
# Core pipeline
# ---------------------------------------------------------------------------
#
# LexParseResult is a custom ADT (not Result) so that the Python typechecker
# does not apply Result-sequencing to the Err/Ok match inside an IO function.
# Same pattern as DeclResult / InferResult in infer.sprout.

type LexParseResult =
  | LexParseOk ast.Program
  | LexParseFail (List Diagnostic)

# no_pos: placeholder used when the upstream error type does not yet carry a
# SourcePos.  Every call site is a Phase-2 TODO: fix the upstream type instead.
fn no_pos() -> source.SourcePos = source.SourcePos(0, 0, 0)

fn lex_err_diag(e: token.TokenizeError) -> Diagnostic =
  match e with
  | token.TokenizeError msg pos -> DiagError(pos, "lex: " ++ msg)

fn parse_err_diag(e: parser.ParseError) -> Diagnostic =
  match e with
  | parser.ParseError msg pos -> DiagError(pos, "parse: " ++ msg)

fn lex_parse(src: String) -> LexParseResult =
  match lexer.tokenize(src) with
  | Err e -> LexParseFail(Cons(lex_err_diag(e), Nil))
  | Ok tokens ->
      match parser.parse_program(tokens) with
      | Err e -> LexParseFail(Cons(parse_err_diag(e), Nil))
      | Ok prog -> LexParseOk(prog)

# compile_source: run full lex -> parse -> check pipeline on raw source text.
export fn compile_source(src: String) -> CompileResult !{IO} =
  match lex_parse(src) with
  | LexParseFail diags -> CompileFail(diags)
  | LexParseOk prog ->
      do
        result <- checker.check_program(prog)
        match result with
        | checker.CheckErr pos msg -> CompileFail(Cons (DiagError(pos, "check: " ++ msg), Nil))
        | checker.CheckOk env -> CompileOk(env)

# compile_source_with_root: like compile_source but also resolves imports.
# Accepts raw source (with module/import header); strips headers internally
# before parsing so the bootstrap parser only sees declaration bodies.
# stdlib_root is the filesystem root for stdlib.* module resolution.
export fn compile_source_with_root(src: String, stdlib_root: source.StdlibRoot) -> CompileResult !{IO} =
  do
    cache <- module_loader.new_cache()
    let sr = source.stdlib_root_str(stdlib_root)
    prelude_pairs <- module_loader.load_prelude_pairs(sr, cache)
    import_pairs <- module_loader.build_import_pairs(module_loader.collect_imports(src), sr, cache)
    match lex_parse(source.strip_headers(src)) with
    | LexParseFail diags -> CompileFail(diags)
    | LexParseOk prog ->
        do
          result <- checker.check_program_with_env(prog, prelude_pairs ++ import_pairs)
          match result with
          | checker.CheckErr pos msg -> CompileFail(Cons (DiagError(pos, "check: " ++ msg), Nil))
          | checker.CheckOk env -> CompileOk(env)

# compile_source_with_cache: like compile_source_with_root but uses a caller-provided cache.
# The cache is NOT recreated — the caller is responsible for its lifecycle.
# cache param is unannotated: its type is constrained by the module_loader callees.
export fn compile_source_with_cache(src: String, stdlib_root: source.StdlibRoot, cache) -> CompileResult !{IO} =
  do
    let sr = source.stdlib_root_str(stdlib_root)
    prelude_pairs <- module_loader.load_prelude_pairs(sr, cache)
    import_pairs <- module_loader.build_import_pairs(module_loader.collect_imports(src), sr, cache)
    match lex_parse(source.strip_headers(src)) with
    | LexParseFail diags -> CompileFail(diags)
    | LexParseOk prog ->
        do
          result <- checker.check_program_with_env(prog, prelude_pairs ++ import_pairs)
          match result with
          | checker.CheckErr pos msg -> CompileFail(Cons (DiagError(pos, "check: " ++ msg), Nil))
          | checker.CheckOk env -> CompileOk(env)

# compile_file: read a file, strip headers, then call compile_source.
export fn compile_file(path: source.FilePath) -> CompileResult !{IO} =
  match fs.read_text(source.filepath_str(path)) with
  | Err msg -> panic("read_file: " ++ source.filepath_str(path) ++ ": " ++ msg)
  | Ok src -> compile_source(source.strip_headers(src))

# ---------------------------------------------------------------------------
# Full pipeline: bundle → typecheck → lower (M4)
# ---------------------------------------------------------------------------
#
# compile_full is the Sprout-native end-to-end compiler entry point.
# It chains all three passes that M1-M3 individually verified:
#
#   1. bundler.bundle_file    — load entry file + imports, qualify names  (M3)
#   2. checker.typecheck_typed — HM type inference + typed IR production  (M1)
#   3. lowering.lower_program  — dictionary-passing typeclass lowering     (M2)
#
# Returns the lowered ast.Program plus the final type env on success, or a
# diagnostic list on the first failing stage.

export type FullResult (..) =
  | FullOk typed_ast.TypedProgram (Dict types.Scheme)
  | FullFail (List Diagnostic)

export fn compile_full(path: source.FilePath, stdlib_root: source.StdlibRoot) -> FullResult !{IO} =
  do
    bundle_result <- bundler.bundle_file(path, stdlib_root)
    match bundle_result with
    | bundler.BundleErr pos msg -> FullFail(Cons (DiagError(pos, "bundle: " ++ msg), Nil))
    | bundler.BundleOk prog ->
        do
          cache <- module_loader.new_cache()
          prelude_pairs <- module_loader.load_prelude_pairs(source.stdlib_root_str(stdlib_root), cache)
          tc_result <- checker.typecheck_typed(prog, prelude_pairs)
          match tc_result with
          | typed_ast.TypedErr pos msg -> FullFail(Cons (DiagError(pos, "check: " ++ msg), Nil))
          | typed_ast.TypedOk typed_prog env ->
              FullOk(lowering.lower_program(typed_prog, env), env)

# ---------------------------------------------------------------------------
# Full IR pipeline: bundle → typecheck → lower → codegen
# ---------------------------------------------------------------------------
#
# compile_full_ir emits LLVM IR text via the typed IR pipeline (ir_pipeline),
# the sole codegen backend.
#
# Lowering preserves types (lower_program returns TypedProgram), so a second
# typecheck is not needed.

export type IrFullResult (..) =
  | IrFullOk String
  | IrFullFail (List Diagnostic)

# ---------------------------------------------------------------------------
# Phase-isolated pipeline functions
#
# Each function runs the pipeline through a specific phase and returns only
# that phase's result.  Intermediate data (AST nodes from earlier phases) is
# freed when the function returns, because it never escapes into the caller's
# GC root set.  This prevents the simultaneous-live-set problem that caused
# stage-2 self-compile OOMs.
#
#   compile_phase_bundle  → bundler output only
#   compile_phase_check   → bundle + typecheck     (frees bundle on return)
#   compile_phase_lower   → + lower (typed)        (frees typed_prog on return)
#   compile_phase_recheck → alias for compile_phase_lower (no second typecheck)
#
# Lowering now preserves types (lower_program threads the scheme env and returns
# TypedProgram), so compile_phase_recheck is a plain alias.

# Coverage line for the dict-passing verifier, gated on SPROUT_VERIFY_DISPATCH_STATS.
# `verified > 0` on real programs is the evidence that the verifier fires on actual
# calls rather than skipping everything (a clean run vs. a silent no-op).
fn report_verify_stats(prog: typed_ast.TypedProgram) -> Unit !{IO} =
  match env.get("SPROUT_VERIFY_DISPATCH_STATS") with
  | Nothing -> ()
  | Just _ ->
      match verify_dispatch.verify_stats(prog) with
      | (ok, sk, mm) ->
          eprint("[verify-dispatch] stats: verified=" ++ int_to_string(ok)
                 ++ " skipped=" ++ int_to_string(sk) ++ " mismatched=" ++ int_to_string(mm))

export fn compile_phase_bundle(path: source.FilePath, stdlib_root: source.StdlibRoot) -> bundler.BundleResult !{IO} =
  compile_phase_bundle_with_roots(path, stdlib_root, Nil)

# _with_roots variants (docs/packaging-v0.md §10 phase 2): thread extra package
# roots to the bundler so dotted non-stdlib imports resolve across repos. The
# original phase entry points delegate here with no extra roots, so every other
# caller is unchanged.
export fn compile_phase_bundle_with_roots(path: source.FilePath, stdlib_root: source.StdlibRoot, extra_roots: List String) -> bundler.BundleResult !{IO} =
  bundler.bundle_file_with_roots(path, stdlib_root, extra_roots)

export fn compile_phase_check(path: source.FilePath, stdlib_root: source.StdlibRoot) -> typed_ast.TypedResult !{IO} =
  compile_phase_check_with_roots(path, stdlib_root, Nil)

export fn compile_phase_check_with_roots(path: source.FilePath, stdlib_root: source.StdlibRoot, extra_roots: List String) -> typed_ast.TypedResult !{IO} =
  do
    bundle_result <- bundler.bundle_file_with_roots(path, stdlib_root, extra_roots)
    match bundle_result with
    | bundler.BundleErr pos msg -> typed_ast.TypedErr(pos, "bundle: " ++ msg)
    | bundler.BundleOk prog ->
        do
          cache <- module_loader.new_cache()
          prelude_pairs <- module_loader.load_prelude_pairs(source.stdlib_root_str(stdlib_root), cache)
          result <- checker.typecheck_typed(prog, prelude_pairs)
          match result with
          | typed_ast.TypedErr pos msg -> typed_ast.TypedErr(pos, "check: " ++ msg)
          | typed_ast.TypedOk typed_prog env ->
              match resolve.resolve_program(typed_prog, env) with
              | resolve.ResolveErr pos msg -> typed_ast.TypedErr(pos, "check: " ++ msg)
              | resolve.ResolveOk resolved ->
                  # Dictionary-passing verifier (retro item 1, phase 1). A finding is a
                  # soundness bug (a dict resolved to the wrong instance) — fatal by
                  # default, verified clean across the corpus + compiler source before
                  # this flip. SPROUT_VERIFY_DISPATCH_OFF downgrades it to a warning
                  # (escape hatch for an uncovered false positive in the wild);
                  # SPROUT_VERIFY_DISPATCH_STATS logs coverage (verified/skipped/mismatched).
                  do
                    _ <- report_verify_stats(resolved)
                    match verify_dispatch.verify_program(resolved) with
                    | Nothing -> typed_ast.TypedOk(resolved, env)
                    | Just (vpos, vmsg) ->
                        match env.get("SPROUT_VERIFY_DISPATCH_OFF") with
                        | Just _ ->
                            do
                              _ <- eprint("[verify-dispatch] (suppressed) " ++ vmsg)
                              typed_ast.TypedOk(resolved, env)
                        | Nothing -> typed_ast.TypedErr(vpos, "check: dispatch-verify: " ++ vmsg)

export fn compile_phase_lower(path: source.FilePath, stdlib_root: source.StdlibRoot) -> typed_ast.TypedResult !{IO} =
  compile_phase_lower_with_roots(path, stdlib_root, Nil)

export fn compile_phase_lower_with_roots(path: source.FilePath, stdlib_root: source.StdlibRoot, extra_roots: List String) -> typed_ast.TypedResult !{IO} =
  do
    check_result <- compile_phase_check_with_roots(path, stdlib_root, extra_roots)
    match check_result with
    | typed_ast.TypedErr pos msg -> typed_ast.TypedErr(pos, msg)
    | typed_ast.TypedOk typed_prog env ->
        typed_ast.TypedOk(dce.elim_program(lowering.lower_program(typed_prog, env)), env)

export fn compile_phase_recheck(path: source.FilePath, stdlib_root: source.StdlibRoot) -> typed_ast.TypedResult !{IO} =
  compile_phase_recheck_with_roots(path, stdlib_root, Nil)

export fn compile_phase_recheck_with_roots(path: source.FilePath, stdlib_root: source.StdlibRoot, extra_roots: List String) -> typed_ast.TypedResult !{IO} =
  compile_phase_lower_with_roots(path, stdlib_root, extra_roots)

export fn compile_full_ir(path: source.FilePath, stdlib_root: source.StdlibRoot) -> IrFullResult !{IO} =
  do
    recheck_result <- compile_phase_recheck(path, stdlib_root)
    match recheck_result with
    | typed_ast.TypedErr pos msg -> IrFullFail(Cons (DiagError(pos, msg), Nil))
    | typed_ast.TypedOk typed_lowered _ ->
        match ir_pipeline.compile_program_streaming(typed_lowered) with
        | Err msg -> IrFullFail(Cons (DiagError(no_pos(), "codegen: " ++ msg), Nil))
        | Ok ir_text -> IrFullOk(ir_text)


# compile_full_ir_with_cache: like compile_full_ir but uses a caller-provided module cache.
# Avoids recreating the cache on every eval when called from the analysis service daemon.
# Emits via the typed IR pipeline (ir_pipeline), the sole codegen backend.
export fn compile_full_ir_with_cache(path: source.FilePath, stdlib_root: source.StdlibRoot, cache) -> IrFullResult !{IO} =
  do
    recheck_result <- compile_phase_recheck_with_cache(path, stdlib_root, cache)
    match recheck_result with
    | typed_ast.TypedErr pos msg -> IrFullFail(Cons (DiagError(pos, msg), Nil))
    | typed_ast.TypedOk typed_lowered _ ->
        match ir_pipeline.compile_program_streaming(typed_lowered) with
        | Err msg -> IrFullFail(Cons (DiagError(no_pos(), "codegen: " ++ msg), Nil))
        | Ok ir_text -> IrFullOk(ir_text)

fn compile_phase_check_with_cache(path: source.FilePath, stdlib_root: source.StdlibRoot, cache) -> typed_ast.TypedResult !{IO} =
  do
    bundle_result <- bundler.bundle_file(path, stdlib_root)
    match bundle_result with
    | bundler.BundleErr pos msg -> typed_ast.TypedErr(pos, "bundle: " ++ msg)
    | bundler.BundleOk prog ->
        do
          prelude_pairs <- module_loader.load_prelude_pairs(source.stdlib_root_str(stdlib_root), cache)
          result <- checker.typecheck_typed(prog, prelude_pairs)
          match result with
          | typed_ast.TypedErr pos msg -> typed_ast.TypedErr(pos, "check: " ++ msg)
          | typed_ast.TypedOk typed_prog env ->
              match resolve.resolve_program(typed_prog, env) with
              | resolve.ResolveErr pos msg -> typed_ast.TypedErr(pos, "check: " ++ msg)
              | resolve.ResolveOk resolved ->
                  # Dictionary-passing verifier (retro item 1, phase 1). A finding is a
                  # soundness bug (a dict resolved to the wrong instance) — fatal by
                  # default, verified clean across the corpus + compiler source before
                  # this flip. SPROUT_VERIFY_DISPATCH_OFF downgrades it to a warning
                  # (escape hatch for an uncovered false positive in the wild);
                  # SPROUT_VERIFY_DISPATCH_STATS logs coverage (verified/skipped/mismatched).
                  do
                    _ <- report_verify_stats(resolved)
                    match verify_dispatch.verify_program(resolved) with
                    | Nothing -> typed_ast.TypedOk(resolved, env)
                    | Just (vpos, vmsg) ->
                        match env.get("SPROUT_VERIFY_DISPATCH_OFF") with
                        | Just _ ->
                            do
                              _ <- eprint("[verify-dispatch] (suppressed) " ++ vmsg)
                              typed_ast.TypedOk(resolved, env)
                        | Nothing -> typed_ast.TypedErr(vpos, "check: dispatch-verify: " ++ vmsg)

fn compile_phase_lower_with_cache(path: source.FilePath, stdlib_root: source.StdlibRoot, cache) -> typed_ast.TypedResult !{IO} =
  do
    check_result <- compile_phase_check_with_cache(path, stdlib_root, cache)
    match check_result with
    | typed_ast.TypedErr pos msg -> typed_ast.TypedErr(pos, msg)
    | typed_ast.TypedOk typed_prog env ->
        typed_ast.TypedOk(dce.elim_program(lowering.lower_program(typed_prog, env)), env)

fn compile_phase_recheck_with_cache(path: source.FilePath, stdlib_root: source.StdlibRoot, cache) -> typed_ast.TypedResult !{IO} =
  compile_phase_lower_with_cache(path, stdlib_root, cache)
