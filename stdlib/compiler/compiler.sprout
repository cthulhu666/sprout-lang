module stdlib.compiler.compiler
import stdlib.compiler.lexer as lexer
import stdlib.compiler.token as token
import stdlib.compiler.parser as parser
import stdlib.compiler.ast as ast
import stdlib.compiler.checker as checker
import stdlib.compiler.types as types
import stdlib.compiler.module_loader as module_loader
import stdlib.compiler.bundler as bundler
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.lowering as lowering
import stdlib.compiler.dce as dce
import stdlib.compiler.codegen as codegen

# ---------------------------------------------------------------------------
# Public API types
# ---------------------------------------------------------------------------

# A request to compile/check a source string
export type CompileRequest (..) =
  | CheckRequest String

# A diagnostic: error or warning with optional location
export type Diagnostic (..) =
  | DiagError String
  | DiagWarning String

# The result of a compile/check request
export type CompileResult (..) =
  | CompileOk (Dict types.Scheme)
  | CompileFail (List Diagnostic)

# ---------------------------------------------------------------------------
# Header stripping (private)
# ---------------------------------------------------------------------------
#
# Skips leading module/import/blank lines so the bootstrap parser receives
# only the declaration body — matching tools/dump_types.py's behaviour.

fn is_header_line(s: String, pos: Int) -> Bool =
  str_starts_with(str_slice(s, pos, str_len(s)), "module ") ||
  str_starts_with(str_slice(s, pos, str_len(s)), "import ") ||
  str_starts_with(str_slice(s, pos, str_len(s)), "\n")

fn next_line(s: String, pos: Int) -> Int =
  if nl == -1 then str_len(s)
  else pos + nl + 1
  where nl = str_find(str_slice(s, pos, str_len(s)), "\n")

fn strip_headers(s: String, pos: Int) -> String =
  if pos >= str_len(s) then ""
  else if is_header_line(s, pos) then strip_headers(s, next_line(s, pos))
  else str_slice(s, pos, str_len(s))

# ---------------------------------------------------------------------------
# Core pipeline
# ---------------------------------------------------------------------------
#
# LexParseResult is a custom ADT (not Result) so that the Python typechecker
# does not apply Result-sequencing to the Err/Ok match inside an IO function.
# Same pattern as DeclResult / InferResult in infer.sprout.

type LexParseResult =
  | LexParseOk ast.Program
  | LexParseFail (List Diagnostic)

fn lex_err_diag(e: token.TokenizeError) -> Diagnostic =
  match e with
  | token.TokenizeError msg _ -> DiagError("lex: " ++ msg)

fn parse_err_diag(e: parser.ParseError) -> Diagnostic =
  match e with
  | parser.ParseError msg _ -> DiagError("parse: " ++ msg)

fn lex_parse(src: String) -> LexParseResult =
  match lexer.tokenize(src) with
  | Err e -> LexParseFail(Cons(lex_err_diag(e), Nil))
  | Ok tokens ->
      match parser.parse_program(tokens) with
      | Err e -> LexParseFail(Cons(parse_err_diag(e), Nil))
      | Ok prog -> LexParseOk(prog)

# compile_source: run full lex -> parse -> check pipeline on raw source text.
export fn compile_source(src: String) -> CompileResult !{IO} =
  match lex_parse(src) with
  | LexParseFail diags -> CompileFail(diags)
  | LexParseOk prog ->
      do
        result <- checker.check_program(prog)
        match result with
        | checker.CheckErr msg -> CompileFail(Cons (DiagError("check: " ++ msg), Nil))
        | checker.CheckOk env -> CompileOk(env)

# compile_source_with_root: like compile_source but also resolves imports.
# Accepts raw source (with module/import header); strips headers internally
# before parsing so the bootstrap parser only sees declaration bodies.
# stdlib_root is the filesystem root for stdlib.* module resolution.
export fn compile_source_with_root(src: String, stdlib_root: String) -> CompileResult !{IO} =
  do
    cache <- module_loader.new_cache()
    prelude_pairs <- module_loader.load_prelude_pairs(stdlib_root, cache)
    import_pairs <- module_loader.build_import_pairs(module_loader.collect_imports(src), stdlib_root, cache)
    match lex_parse(strip_headers(src, 0)) with
    | LexParseFail diags -> CompileFail(diags)
    | LexParseOk prog ->
        do
          result <- checker.check_program_with_env(prog, prelude_pairs ++ import_pairs)
          match result with
          | checker.CheckErr msg -> CompileFail(Cons (DiagError("check: " ++ msg), Nil))
          | checker.CheckOk env -> CompileOk(env)

# compile_source_with_cache: like compile_source_with_root but uses a caller-provided cache.
# The cache is NOT recreated — the caller is responsible for its lifecycle.
# cache param is unannotated: its type is constrained by the module_loader callees.
export fn compile_source_with_cache(src: String, stdlib_root: String, cache) -> CompileResult !{IO} =
  do
    prelude_pairs <- module_loader.load_prelude_pairs(stdlib_root, cache)
    import_pairs <- module_loader.build_import_pairs(module_loader.collect_imports(src), stdlib_root, cache)
    match lex_parse(strip_headers(src, 0)) with
    | LexParseFail diags -> CompileFail(diags)
    | LexParseOk prog ->
        do
          result <- checker.check_program_with_env(prog, prelude_pairs ++ import_pairs)
          match result with
          | checker.CheckErr msg -> CompileFail(Cons (DiagError("check: " ++ msg), Nil))
          | checker.CheckOk env -> CompileOk(env)

# compile_file: read a file, strip headers, then call compile_source.
export fn compile_file(path: String) -> CompileResult !{IO} =
  match read_file(path) with
  | Err msg -> panic("read_file: " ++ path ++ ": " ++ msg)
  | Ok src -> compile_source(strip_headers(src, 0))

# ---------------------------------------------------------------------------
# Full pipeline: bundle → typecheck → lower (M4)
# ---------------------------------------------------------------------------
#
# compile_full is the Sprout-native end-to-end compiler entry point.
# It chains all three passes that M1-M3 individually verified:
#
#   1. bundler.bundle_file    — load entry file + imports, qualify names  (M3)
#   2. checker.typecheck_typed — HM type inference + typed IR production  (M1)
#   3. lowering.lower_program  — dictionary-passing typeclass lowering     (M2)
#
# Returns the lowered ast.Program plus the final type env on success, or a
# diagnostic list on the first failing stage.

export type FullResult (..) =
  | FullOk typed_ast.TypedProgram (Dict types.Scheme)
  | FullFail (List Diagnostic)

export fn compile_full(path: String, stdlib_root: String) -> FullResult !{IO} =
  do
    bundle_result <- bundler.bundle_file(path, stdlib_root)
    match bundle_result with
    | bundler.BundleErr msg -> FullFail(Cons (DiagError("bundle: " ++ msg), Nil))
    | bundler.BundleOk prog ->
        do
          cache <- module_loader.new_cache()
          prelude_pairs <- module_loader.load_prelude_pairs(stdlib_root, cache)
          tc_result <- checker.typecheck_typed(prog, prelude_pairs)
          match tc_result with
          | typed_ast.TypedErr msg -> FullFail(Cons (DiagError("check: " ++ msg), Nil))
          | typed_ast.TypedOk typed_prog env ->
              match lowering.lower_program(typed_prog, env) with
              | lowering.LowerErr msg -> FullFail(Cons (DiagError("lower: " ++ msg), Nil))
              | lowering.LowerOk lowered -> FullOk(lowered, env)

# ---------------------------------------------------------------------------
# Full IR pipeline: bundle → typecheck → lower → codegen
# ---------------------------------------------------------------------------
#
# compile_full_ir is the M6 entry point.  It extends compile_full by:
#   4. codegen.compile_to_ir — emit LLVM IR text (M6)
#
# Lowering now preserves types (lower_program returns TypedProgram), so a
# second typecheck is no longer needed.

export type IrFullResult (..) =
  | IrFullOk String
  | IrFullFail (List Diagnostic)

export type IrFullLinesResult (..) =
  | IrFullLinesOk (List String) (List String) (List String) (List String)
  # header_lines, str_lines, def_lines, dbg_lines
  | IrFullLinesFail (List Diagnostic)

# ---------------------------------------------------------------------------
# Phase-isolated pipeline functions
#
# Each function runs the pipeline through a specific phase and returns only
# that phase's result.  Intermediate data (AST nodes from earlier phases) is
# freed when the function returns, because it never escapes into the caller's
# GC root set.  This prevents the simultaneous-live-set problem that caused
# stage-2 self-compile OOMs.
#
#   compile_phase_bundle  → bundler output only
#   compile_phase_check   → bundle + typecheck     (frees bundle on return)
#   compile_phase_lower   → + lower (typed)        (frees typed_prog on return)
#   compile_phase_recheck → alias for compile_phase_lower (no second typecheck)
#
# Lowering now preserves types (lower_program threads the scheme env and returns
# TypedProgram), so compile_phase_recheck is a plain alias.

export fn compile_phase_bundle(path: String, stdlib_root: String) -> bundler.BundleResult !{IO} =
  bundler.bundle_file(path, stdlib_root)

export fn compile_phase_check(path: String, stdlib_root: String) -> typed_ast.TypedResult !{IO} =
  do
    bundle_result <- bundler.bundle_file(path, stdlib_root)
    match bundle_result with
    | bundler.BundleErr msg -> typed_ast.TypedErr("bundle: " ++ msg)
    | bundler.BundleOk prog ->
        do
          cache <- module_loader.new_cache()
          prelude_pairs <- module_loader.load_prelude_pairs(stdlib_root, cache)
          result <- checker.typecheck_typed(prog, prelude_pairs)
          match result with
          | typed_ast.TypedErr msg -> typed_ast.TypedErr("check: " ++ msg)
          | ok -> ok

export fn compile_phase_lower(path: String, stdlib_root: String) -> typed_ast.TypedResult !{IO} =
  do
    check_result <- compile_phase_check(path, stdlib_root)
    match check_result with
    | typed_ast.TypedErr msg -> typed_ast.TypedErr(msg)
    | typed_ast.TypedOk typed_prog env ->
        match lowering.lower_program(typed_prog, env) with
        | lowering.LowerErr msg -> typed_ast.TypedErr("lower: " ++ msg)
        | lowering.LowerOk lowered -> typed_ast.TypedOk(dce.elim_program(lowered), env)

export fn compile_phase_recheck(path: String, stdlib_root: String) -> typed_ast.TypedResult !{IO} =
  compile_phase_lower(path, stdlib_root)

export fn compile_full_ir(path: String, stdlib_root: String) -> IrFullResult !{IO} =
  do
    lines_result <- compile_full_ir_lines(path, stdlib_root, false)
    match lines_result with
    | IrFullLinesFail diags -> IrFullFail(diags)
    | IrFullLinesOk header_lines str_lines def_lines dbg_lines -> IrFullOk(join_line_sections(header_lines, str_lines, def_lines, dbg_lines))

fn join_line_sections(header_lines: List String, str_lines: List String, def_lines: List String, dbg_lines: List String) -> String =
  string_join_newlines(header_lines) ++ string_join_newlines(str_lines) ++ string_join_newlines(def_lines) ++ string_join_newlines(dbg_lines)

fn print_codegen_warns(warns: List String) -> Unit !{IO} =
  match warns with
  | Nil -> ()
  | Cons w rest ->
      do
        eprint("WARNING: " ++ w)
        print_codegen_warns(rest)

# Gate: SPROUT_TIME_PHASES env var.  When set to anything other than "" or "0",
# compile_full_ir_lines emits a single per-phase timing line to stderr:
#
#   [phase] bundle=Ams prelude=Bms check=Cms lower=Dms codegen=Ems total=Tms path=<P>
#
# Stdout (IR text) is unaffected, so the bootstrap fixed-point invariant holds.
fn timing_enabled() -> Bool !{IO} =
  match env_get("SPROUT_TIME_PHASES") with
  | Nothing -> false
  | Just s -> if s == "" then false else if s == "0" then false else true

fn micros_to_ms_str(us: Int) -> String = int_to_string(us / 1000)

# ---------------------------------------------------------------------------
# PhaseTimes: per-phase microsecond timestamps captured in compile_phase_recheck_timed.
#
# Fields: t0 (pipeline start), t_bundle, t_prelude, t_check, t_lower.
# Unreached phases store the last reached timestamp so their delta is 0 ms.
# This is the single source of truth for pipeline phase boundaries; any
# change to phase order must update compile_phase_recheck_timed only.

type PhaseTimes = PhaseTimes Int Int Int Int Int

fn phase_times_zero() -> PhaseTimes = PhaseTimes(0, 0, 0, 0, 0)

# format_phase_failed: pure helper that builds the FAILED [phase] line for the
# error path.  The err_msg prefix ("bundle: " / "check: " / "lower: ") selects
# which fields to emit, matching the original per-phase format exactly.
fn format_phase_failed(err_msg: String, ts: PhaseTimes, path: String) -> String =
  match ts with
  | PhaseTimes t0 t_bundle t_prelude t_check t_lower ->
      if str_starts_with(err_msg, "bundle: ") then
        "[phase] bundle=" ++ micros_to_ms_str(t_bundle - t0) ++ "ms total=" ++ micros_to_ms_str(t_bundle - t0) ++ "ms FAILED-at-bundle path=" ++ path
      else if str_starts_with(err_msg, "check: ") then
        "[phase] bundle=" ++ micros_to_ms_str(t_bundle - t0) ++ "ms prelude=" ++ micros_to_ms_str(t_prelude - t_bundle) ++ "ms check=" ++ micros_to_ms_str(t_check - t_prelude) ++ "ms total=" ++ micros_to_ms_str(t_check - t0) ++ "ms FAILED-at-check path=" ++ path
      else
        # lower: failure (default: all phases through lower are available)
        "[phase] bundle=" ++ micros_to_ms_str(t_bundle - t0) ++ "ms prelude=" ++ micros_to_ms_str(t_prelude - t_bundle) ++ "ms check=" ++ micros_to_ms_str(t_check - t_prelude) ++ "ms lower=" ++ micros_to_ms_str(t_lower - t_check) ++ "ms total=" ++ micros_to_ms_str(t_lower - t0) ++ "ms FAILED-at-lower path=" ++ path

# format_phase_success: pure helper that builds the full [phase] line on success.
# codegen_us is the codegen wall-clock time in microseconds.
fn format_phase_success(ts: PhaseTimes, codegen_us: Int, path: String) -> String =
  match ts with
  | PhaseTimes t0 t_bundle t_prelude t_check t_lower ->
      "[phase] bundle=" ++ micros_to_ms_str(t_bundle - t0) ++ "ms prelude=" ++ micros_to_ms_str(t_prelude - t_bundle) ++ "ms check=" ++ micros_to_ms_str(t_check - t_prelude) ++ "ms lower=" ++ micros_to_ms_str(t_lower - t_check) ++ "ms codegen=" ++ micros_to_ms_str(codegen_us) ++ "ms total=" ++ micros_to_ms_str(t_lower - t0 + codegen_us) ++ "ms path=" ++ path

# compile_phase_recheck_timed: SINGLE SOURCE OF TRUTH for the full pipeline
# (bundle → load_prelude → typecheck → lower).  Records per-phase timestamps
# into t_ref before returning.
#
# Phase-isolation guarantee: intermediate ASTs (bundle prog, typed_prog) are
# freed when this function returns; only (typed_lowered, env) survive into the
# caller's scope.  This preserves the P0 OOM fix — at codegen time only 2
# roots are live.
#
# Both the fast path (timing_on=false) and the traced path (timing_on=true)
# call this function, so any future change to pipeline order touches one place.
fn compile_phase_recheck_timed(path: String, stdlib_root: String, t_ref: Ref PhaseTimes) -> typed_ast.TypedResult !{IO} =
  do
    t0 <- time_now_micros()
    bundle_result <- bundler.bundle_file(path, stdlib_root)
    t1 <- time_now_micros()
    match bundle_result with
    | bundler.BundleErr msg ->
        do
          ref_write(t_ref, PhaseTimes(t0, t1, t1, t1, t1))
          typed_ast.TypedErr("bundle: " ++ msg)
    | bundler.BundleOk prog ->
        do
          cache <- module_loader.new_cache()
          prelude_pairs <- module_loader.load_prelude_pairs(stdlib_root, cache)
          t2 <- time_now_micros()
          check_result <- checker.typecheck_typed(prog, prelude_pairs)
          t3 <- time_now_micros()
          match check_result with
          | typed_ast.TypedErr msg ->
              do
                ref_write(t_ref, PhaseTimes(t0, t1, t2, t3, t3))
                typed_ast.TypedErr("check: " ++ msg)
          | typed_ast.TypedOk typed_prog env ->
              match lowering.lower_program(typed_prog, env) with
              | lowering.LowerErr msg ->
                  do
                    t4 <- time_now_micros()
                    ref_write(t_ref, PhaseTimes(t0, t1, t2, t3, t4))
                    typed_ast.TypedErr("lower: " ++ msg)
              | lowering.LowerOk typed_lowered ->
                  do
                    t4 <- time_now_micros()
                    ref_write(t_ref, PhaseTimes(t0, t1, t2, t3, t4))
                    typed_ast.TypedOk(typed_lowered, env)

# compile_full_ir_lines: single pipeline entry point.  Calls
# compile_phase_recheck_timed (the canonical pipeline body) then runs codegen.
# When SPROUT_TIME_PHASES is set, emits one [phase] timing line to stderr.
# debug_mode_: when true, emits DWARF metadata in the 4th IR section (--debug flag).
export fn compile_full_ir_lines(path: String, stdlib_root: String, debug_mode_: Bool) -> IrFullLinesResult !{IO} =
  do
    timing_on <- timing_enabled()
    t_ref <- ref_new(phase_times_zero())
    recheck_result <- compile_phase_recheck_timed(path, stdlib_root, t_ref)
    match recheck_result with
    | typed_ast.TypedErr msg ->
        do
          if timing_on then
            do
              ts <- ref_read(t_ref)
              eprint(format_phase_failed(msg, ts, path))
          else ()
          IrFullLinesFail(Cons (DiagError(msg), Nil))
    | typed_ast.TypedOk typed_lowered env ->
        do
          cg_t0 <- time_now_micros()
          ir_result <- codegen.compile_to_ir_lines(typed_lowered, env, debug_mode_, path)
          cg_t1 <- time_now_micros()
          if timing_on then
            do
              ts <- ref_read(t_ref)
              eprint(format_phase_success(ts, cg_t1 - cg_t0, path))
          else ()
          match ir_result with
          | codegen.IrLinesOk header_lines str_lines def_lines dbg_lines warns ->
              do
                print_codegen_warns(warns)
                IrFullLinesOk(header_lines, str_lines, def_lines, dbg_lines)
          | codegen.IrLinesErr msg -> IrFullLinesFail(Cons (DiagError("codegen: " ++ msg), Nil))

# compile_full_ir_with_cache: like compile_full_ir but uses a caller-provided module cache.
# Avoids recreating the cache on every eval when called from the analysis service daemon.
export fn compile_full_ir_with_cache(path: String, stdlib_root: String, cache) -> IrFullResult !{IO} =
  do
    recheck_result <- compile_phase_recheck_with_cache(path, stdlib_root, cache)
    match recheck_result with
    | typed_ast.TypedErr msg -> IrFullFail(Cons (DiagError(msg), Nil))
    | typed_ast.TypedOk typed_lowered env ->
        do
          ir_result <- codegen.compile_to_ir_lines(typed_lowered, env, false, path)
          match ir_result with
          | codegen.IrLinesOk header_lines str_lines def_lines dbg_lines warns ->
              do
                print_codegen_warns(warns)
                IrFullOk(join_line_sections(header_lines, str_lines, def_lines, dbg_lines))
          | codegen.IrLinesErr msg -> IrFullFail(Cons (DiagError("codegen: " ++ msg), Nil))

fn compile_phase_check_with_cache(path: String, stdlib_root: String, cache) -> typed_ast.TypedResult !{IO} =
  do
    bundle_result <- bundler.bundle_file(path, stdlib_root)
    match bundle_result with
    | bundler.BundleErr msg -> typed_ast.TypedErr("bundle: " ++ msg)
    | bundler.BundleOk prog ->
        do
          prelude_pairs <- module_loader.load_prelude_pairs(stdlib_root, cache)
          result <- checker.typecheck_typed(prog, prelude_pairs)
          match result with
          | typed_ast.TypedErr msg -> typed_ast.TypedErr("check: " ++ msg)
          | ok -> ok

fn compile_phase_lower_with_cache(path: String, stdlib_root: String, cache) -> typed_ast.TypedResult !{IO} =
  do
    check_result <- compile_phase_check_with_cache(path, stdlib_root, cache)
    match check_result with
    | typed_ast.TypedErr msg -> typed_ast.TypedErr(msg)
    | typed_ast.TypedOk typed_prog env ->
        match lowering.lower_program(typed_prog, env) with
        | lowering.LowerErr msg -> typed_ast.TypedErr("lower: " ++ msg)
        | lowering.LowerOk lowered -> typed_ast.TypedOk(dce.elim_program(lowered), env)

fn compile_phase_recheck_with_cache(path: String, stdlib_root: String, cache) -> typed_ast.TypedResult !{IO} =
  compile_phase_lower_with_cache(path, stdlib_root, cache)

# compile_one_fn_ir_lines: like compile_full_ir_lines but only emits codegen for
# the function(s) whose qualified name contains fn_name as a substring.
export fn compile_one_fn_ir_lines(fn_name: String, path: String, stdlib_root: String) -> IrFullLinesResult !{IO} =
  do
    recheck_result <- compile_phase_recheck(path, stdlib_root)
    match recheck_result with
    | typed_ast.TypedErr msg -> IrFullLinesFail(Cons (DiagError(msg), Nil))
    | typed_ast.TypedOk typed_lowered env ->
        do
          ir_result <- codegen.compile_to_ir_lines_one_fn(fn_name, typed_lowered, env)
          match ir_result with
          | codegen.IrLinesOk header_lines str_lines def_lines dbg_lines warns ->
              do
                print_codegen_warns(warns)
                IrFullLinesOk(header_lines, str_lines, def_lines, dbg_lines)
          | codegen.IrLinesErr msg -> IrFullLinesFail(Cons (DiagError("codegen: " ++ msg), Nil))
