module stdlib.compiler.compiler
import stdlib.compiler.lexer as lexer
import stdlib.compiler.token as token
import stdlib.compiler.parser as parser
import stdlib.compiler.ast as ast
import stdlib.compiler.checker as checker
import stdlib.compiler.types as types
import stdlib.compiler.module_loader as module_loader
import stdlib.compiler.bundler as bundler
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.lowering as lowering
import stdlib.compiler.codegen as codegen

# ---------------------------------------------------------------------------
# Public API types
# ---------------------------------------------------------------------------

# A request to compile/check a source string
export type CompileRequest (..) =
  | CheckRequest String

# A diagnostic: error or warning with optional location
export type Diagnostic (..) =
  | DiagError String
  | DiagWarning String

# The result of a compile/check request
export type CompileResult (..) =
  | CompileOk (Dict types.Scheme)
  | CompileFail (List Diagnostic)

# ---------------------------------------------------------------------------
# Header stripping (private)
# ---------------------------------------------------------------------------
#
# Skips leading module/import/blank lines so the bootstrap parser receives
# only the declaration body — matching tools/dump_types.py's behaviour.

fn is_header_line(s: String, pos: Int) -> Bool =
  str_starts_with(str_slice(s, pos, str_len(s)), "module ") ||
  str_starts_with(str_slice(s, pos, str_len(s)), "import ") ||
  str_starts_with(str_slice(s, pos, str_len(s)), "\n")

fn next_line(s: String, pos: Int) -> Int =
  if nl == -1 then str_len(s)
  else pos + nl + 1
  where nl = str_find(str_slice(s, pos, str_len(s)), "\n")

fn strip_headers(s: String, pos: Int) -> String =
  if pos >= str_len(s) then ""
  else if is_header_line(s, pos) then strip_headers(s, next_line(s, pos))
  else str_slice(s, pos, str_len(s))

# ---------------------------------------------------------------------------
# Core pipeline
# ---------------------------------------------------------------------------
#
# LexParseResult is a custom ADT (not Result) so that the Python typechecker
# does not apply Result-sequencing to the Err/Ok match inside an IO function.
# Same pattern as DeclResult / InferResult in infer.sprout.

type LexParseResult =
  | LexParseOk ast.Program
  | LexParseFail (List Diagnostic)

fn lex_err_diag(e: token.TokenizeError) -> Diagnostic =
  match e with
  | token.TokenizeError msg _ -> DiagError("lex: " ++ msg)

fn parse_err_diag(e: parser.ParseError) -> Diagnostic =
  match e with
  | parser.ParseError msg _ -> DiagError("parse: " ++ msg)

fn lex_parse(src: String) -> LexParseResult =
  match lexer.tokenize(src) with
  | Err e -> LexParseFail(Cons(lex_err_diag(e), Nil))
  | Ok tokens ->
      match parser.parse_program(tokens) with
      | Err e -> LexParseFail(Cons(parse_err_diag(e), Nil))
      | Ok prog -> LexParseOk(prog)

# compile_source: run full lex -> parse -> check pipeline on raw source text.
export fn compile_source(src: String) -> CompileResult !{IO} =
  match lex_parse(src) with
  | LexParseFail diags -> CompileFail(diags)
  | LexParseOk prog ->
      do
        result <- checker.check_program(prog)
        match result with
        | checker.CheckErr msg -> CompileFail(Cons (DiagError("check: " ++ msg), Nil))
        | checker.CheckOk env -> CompileOk(env)

# compile_source_with_root: like compile_source but also resolves imports.
# Accepts raw source (with module/import header); strips headers internally
# before parsing so the bootstrap parser only sees declaration bodies.
# stdlib_root is the filesystem root for stdlib.* module resolution.
export fn compile_source_with_root(src: String, stdlib_root: String) -> CompileResult !{IO} =
  do
    cache <- module_loader.new_cache()
    import_pairs <- module_loader.build_import_pairs(module_loader.collect_imports(src), stdlib_root, cache)
    match lex_parse(strip_headers(src, 0)) with
    | LexParseFail diags -> CompileFail(diags)
    | LexParseOk prog ->
        do
          result <- checker.check_program_with_env(prog, import_pairs)
          match result with
          | checker.CheckErr msg -> CompileFail(Cons (DiagError("check: " ++ msg), Nil))
          | checker.CheckOk env -> CompileOk(env)

# compile_file: read a file, strip headers, then call compile_source.
export fn compile_file(path: String) -> CompileResult !{IO} =
  compile_source(strip_headers(read_file(path), 0))

# ---------------------------------------------------------------------------
# Full pipeline: bundle → typecheck → lower (M4)
# ---------------------------------------------------------------------------
#
# compile_full is the Sprout-native end-to-end compiler entry point.
# It chains all three passes that M1-M3 individually verified:
#
#   1. bundler.bundle_file    — load entry file + imports, qualify names  (M3)
#   2. checker.typecheck_typed — HM type inference + typed IR production  (M1)
#   3. lowering.lower_program  — dictionary-passing typeclass lowering     (M2)
#
# Returns the lowered ast.Program plus the final type env on success, or a
# diagnostic list on the first failing stage.

export type FullResult (..) =
  | FullOk ast.Program (Dict types.Scheme)
  | FullFail (List Diagnostic)

export fn compile_full(path: String, stdlib_root: String) -> FullResult !{IO} =
  do
    bundle_result <- bundler.bundle_file(path, stdlib_root)
    match bundle_result with
    | bundler.BundleErr msg -> FullFail(Cons (DiagError("bundle: " ++ msg), Nil))
    | bundler.BundleOk prog ->
        do
          tc_result <- checker.typecheck_typed(prog, Nil)
          match tc_result with
          | typed_ast.TypedErr msg -> FullFail(Cons (DiagError("check: " ++ msg), Nil))
          | typed_ast.TypedOk typed_prog env ->
              match lowering.lower_program(typed_prog) with
              | lowering.LowerErr msg -> FullFail(Cons (DiagError("lower: " ++ msg), Nil))
              | lowering.LowerOk lowered -> FullOk(lowered, env)

# ---------------------------------------------------------------------------
# Full IR pipeline: bundle → typecheck → lower → typecheck(lowered) → codegen
# ---------------------------------------------------------------------------
#
# compile_full_ir is the M6 entry point.  It extends compile_full by:
#   4. checker.typecheck_typed(lowered) — re-typecheck the lowered AST so that
#      every TypedExpr node carries a fully-resolved types.Type
#   5. codegen.compile_to_ir           — emit LLVM IR text (M6)
#
# The second typecheck is necessary because lowering rewrites the AST and the
# typed nodes in the lowered tree do not carry the re-inferred types yet.

export type IrFullResult (..) =
  | IrFullOk String
  | IrFullFail (List Diagnostic)

export type IrFullLinesResult (..) =
  | IrFullLinesOk (List String)(List String)(List String)
  | IrFullLinesFail (List Diagnostic)

# ---------------------------------------------------------------------------
# Phase-isolated pipeline functions
#
# Each function runs the pipeline through a specific phase and returns only
# that phase's result.  Intermediate data (AST nodes from earlier phases) is
# freed when the function returns, because it never escapes into the caller's
# GC root set.  This prevents the simultaneous-live-set problem that caused
# stage-2 self-compile OOMs.
#
#   compile_phase_bundle  → bundler output only
#   compile_phase_check   → bundle + typecheck     (frees bundle on return)
#   compile_phase_lower   → + lower                (frees typed_prog on return)
#   compile_phase_recheck → + retypecheck          (frees lowered on return)
#
# The chain compile_phase_recheck → compile_phase_lower → compile_phase_check
# means codegen only ever sees typed_lowered + env, not the four earlier ASTs.

export fn compile_phase_bundle(path: String, stdlib_root: String) -> bundler.BundleResult !{IO} =
  bundler.bundle_file(path, stdlib_root)

export fn compile_phase_check(path: String, stdlib_root: String) -> typed_ast.TypedResult !{IO} =
  do
    bundle_result <- bundler.bundle_file(path, stdlib_root)
    match bundle_result with
    | bundler.BundleErr msg -> typed_ast.TypedErr("bundle: " ++ msg)
    | bundler.BundleOk prog ->
        do
          result <- checker.typecheck_typed(prog, Nil)
          match result with
          | typed_ast.TypedErr msg -> typed_ast.TypedErr("check: " ++ msg)
          | ok -> ok

export fn compile_phase_lower(path: String, stdlib_root: String) -> lowering.LowerResult !{IO} =
  do
    check_result <- compile_phase_check(path, stdlib_root)
    match check_result with
    | typed_ast.TypedErr msg -> lowering.LowerErr(msg)
    | typed_ast.TypedOk typed_prog _ ->
        match lowering.lower_program(typed_prog) with
        | lowering.LowerErr msg -> lowering.LowerErr("lower: " ++ msg)
        | ok -> ok

export fn compile_phase_recheck(path: String, stdlib_root: String) -> typed_ast.TypedResult !{IO} =
  do
    lower_result <- compile_phase_lower(path, stdlib_root)
    match lower_result with
    | lowering.LowerErr msg -> typed_ast.TypedErr(msg)
    | lowering.LowerOk lowered ->
        do
          result <- checker.typecheck_typed(lowered, Nil)
          match result with
          | typed_ast.TypedErr msg -> typed_ast.TypedErr("check2: " ++ msg)
          | ok -> ok

export fn compile_full_ir(path: String, stdlib_root: String) -> IrFullResult !{IO} =
  do
    lines_result <- compile_full_ir_lines(path, stdlib_root)
    match lines_result with
    | IrFullLinesFail diags -> IrFullFail(diags)
    | IrFullLinesOk header_lines str_lines def_lines -> IrFullOk(join_line_sections(header_lines, str_lines, def_lines))

fn join_line_sections(header_lines: List String, str_lines: List String, def_lines: List String) -> String =
  string_join_newlines(header_lines) ++ string_join_newlines(str_lines) ++ string_join_newlines(def_lines)

# compile_full_ir_lines uses compile_phase_recheck so that prog, typed_prog,
# and lowered are freed before codegen runs — only typed_lowered + env survive
# into the caller's scope.
export fn compile_full_ir_lines(path: String, stdlib_root: String) -> IrFullLinesResult !{IO} =
  do
    recheck_result <- compile_phase_recheck(path, stdlib_root)
    match recheck_result with
    | typed_ast.TypedErr msg -> IrFullLinesFail(Cons (DiagError(msg), Nil))
    | typed_ast.TypedOk typed_lowered env ->
        do
          ir_result <- codegen.compile_to_ir_lines(typed_lowered, env)
          match ir_result with
          | codegen.IrLinesOk header_lines str_lines def_lines -> IrFullLinesOk(header_lines, str_lines, def_lines)
          | codegen.IrLinesErr msg -> IrFullLinesFail(Cons (DiagError("codegen: " ++ msg), Nil))

# compile_one_fn_ir_lines: like compile_full_ir_lines but only emits codegen for
# the function(s) whose qualified name contains fn_name as a substring.
export fn compile_one_fn_ir_lines(fn_name: String, path: String, stdlib_root: String) -> IrFullLinesResult !{IO} =
  do
    recheck_result <- compile_phase_recheck(path, stdlib_root)
    match recheck_result with
    | typed_ast.TypedErr msg -> IrFullLinesFail(Cons (DiagError(msg), Nil))
    | typed_ast.TypedOk typed_lowered env ->
        do
          ir_result <- codegen.compile_to_ir_lines_one_fn(fn_name, typed_lowered, env)
          match ir_result with
          | codegen.IrLinesOk header_lines str_lines def_lines -> IrFullLinesOk(header_lines, str_lines, def_lines)
          | codegen.IrLinesErr msg -> IrFullLinesFail(Cons (DiagError("codegen: " ++ msg), Nil))
