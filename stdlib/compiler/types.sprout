module stdlib.compiler.types
import stdlib.string as string

# ---------------------------------------------------------------------------
# Effect rows
# ---------------------------------------------------------------------------
#
# An effect row describes what side-effects a function may perform.
#   EffectPure        — no effects (the function is pure)
#   EffectIO          — concrete !{IO} label
#   EffectRow labels  — closed row with arbitrary named labels (future use)
#   EffectVar name    — open effect variable (e.g. from "fn f !{e}")

export type Effect (..) =
  | EffectPure
  | EffectIO
  | EffectRow (List String)
  | EffectVar String

# ---------------------------------------------------------------------------
# Types
# ---------------------------------------------------------------------------
#
# The five forms mirror the Python typechecker exactly:
#   TVar  — an inference variable, identified by a generated name ("t0", "t1"…)
#   TConst — a type constant ("Int", "Bool", "Maybe", …)
#   TApp  — type application: TApp (TConst "Maybe") (TConst "Int") = Maybe Int
#   TFunc — function type with associated effect row
#   TTuple — tuple type (Int, Bool, …)

export type Type (..) =
  | TVar String
  | TConst String
  | TApp Type Type
  | TFunc Type Type Effect
  | TTuple (List Type)

# ---------------------------------------------------------------------------
# TypeId — opaque canonical type identity (G6)
# ---------------------------------------------------------------------------
#
# Identity is the module-qualified canonical name (e.g. "main.Maybe"; the prelude,
# having no module header, owns the unqualified name). Consumers MUST go through this
# API — never raw string surgery on the name — so module-qualification is touched in
# one place and a future generative identity (functors / path-dependent types) is a
# representation swap here, not a compiler-wide re-migration. (v1: TConst still carries
# a raw String; G6.3 flips it to `TConst TypeId` to make the boundary compiler-enforced.)

export wrap TypeId = String

# Mint a TypeId from a canonical (already-resolved) name. The bundler/resolver is the
# source of canonical names; this is the single construction point.
export fn type_id(name: String) -> TypeId = TypeId(name)

# Raw canonical name. Internal — for serialization and the identity helpers below;
# call sites should prefer type_id_display / _eq / _is_concrete / _symbol.
export fn type_id_name(id: TypeId) -> String =
  match id with | TypeId s -> s

# Identity equality: exact on the canonical name.
export fn type_id_eq(a: TypeId, b: TypeId) -> Bool =
  type_id_name(a) == type_id_name(b)

# Display form: the short (last-segment) name, for diagnostics.
export fn type_id_display(id: TypeId) -> String =
  string.after_last_dot(type_id_name(id))

# Concreteness: a concrete type's NAME is uppercase, a type variable lowercase. Reads
# the LAST segment, since a qualified concrete type starts with a lowercase module
# component (e.g. "main.Maybe" — the '.m' is not the type name).
export fn type_id_is_concrete(id: TypeId) -> Bool =
  type_id_starts_upper(string.after_last_dot(type_id_name(id)))

fn type_id_starts_upper(s: String) -> Bool =
  match str_char_at(s, 0) with
  | Nothing -> false
  | Just c -> c >= 'A' && c <= 'Z'

# LLVM symbol fragment: dot-sanitized canonical name (dots are illegal in symbols).
export fn type_id_symbol(id: TypeId) -> String =
  string.replace_all(".", "_", type_id_name(id))

# ---------------------------------------------------------------------------
# Schemes  (∀ type_vars effect_vars. body_type !body_effects)
# ---------------------------------------------------------------------------
#
# A monomorphic type is Scheme(Nil, Nil, t, EffectPure).
# A polymorphic type binds quantified variables so they can be freshly
# instantiated at each use site.

export type Scheme (..) =
  | Scheme (List String) (List String) Type Effect
  # Scheme type_vars effect_vars body effects

# ---------------------------------------------------------------------------
# Commonly-used type constants
# ---------------------------------------------------------------------------

export fn type_int() -> Type = TConst("Int")
export fn type_double() -> Type = TConst("Double")
export fn type_bool() -> Type = TConst("Bool")
export fn type_string() -> Type = TConst("String")
export fn type_char() -> Type = TConst("Char")
export fn type_list(a: Type) -> Type = TApp(TConst("List"), a)
export fn type_maybe(a: Type) -> Type = TApp(TConst("Maybe"), a)

export fn effect_pure() -> Effect = EffectPure
export fn effect_io() -> Effect = EffectIO

# ---------------------------------------------------------------------------
# Scheme accessors / constructors
# ---------------------------------------------------------------------------

export fn mono(t: Type) -> Scheme =
  Scheme(Nil, Nil, t, EffectPure)

export fn scheme_vars(s: Scheme) -> List String =
  match s with | Scheme vs _ _ _ -> vs

export fn scheme_effect_vars(s: Scheme) -> List String =
  match s with | Scheme _ evs _ _ -> evs

export fn scheme_type(s: Scheme) -> Type =
  match s with | Scheme _ _ t _ -> t

export fn scheme_effects(s: Scheme) -> Effect =
  match s with | Scheme _ _ _ e -> e

# ---------------------------------------------------------------------------
# Free type variables
# ---------------------------------------------------------------------------
#
# ftv collects every TVar name reachable from a type, with duplicates.
# Callers that need a set should pass the result through list_dedup.

fn ftv_acc(t: Type, acc: List String) -> List String =
  match t with
  | TVar name -> Cons(name, acc)
  | TConst _ -> acc
  | TApp base arg -> ftv_acc(base, ftv_acc(arg, acc))
  | TFunc param ret _ -> ftv_acc(param, ftv_acc(ret, acc))
  | TTuple items -> ftv_list_acc(items, acc)

fn ftv_list_acc(items: List Type, acc: List String) -> List String =
  match items with
  | Nil -> acc
  | Cons h t -> ftv_list_acc(t, ftv_acc(h, acc))

# ---------------------------------------------------------------------------
# List-as-set helpers for String (stage-0 compatible: no Eq constraint)
# ---------------------------------------------------------------------------
#
# The generic prelude list_member/union/diff/dedup use `where Eq a`, but the
# self-hosted stage-0 constraint dispatch cannot resolve Eq for element types
# inside container arguments (e.g. List String → looks for @inst:Eq:List, not
# @inst:Eq:String).  These String-specific helpers shadow the prelude generics
# within this module and are exported for use by unifier/infer.

export fn list_member(x: String, xs: List String) -> Bool =
  match xs with
  | Nil -> false
  | Cons h t -> if h == x then true else list_member(x, t)

export fn list_union(xs: List String, ys: List String) -> List String =
  match xs with
  | Nil -> ys
  | Cons h t ->
      if list_member(h, ys) then list_union(t, ys)
      else Cons(h, list_union(t, ys))

export fn list_diff(xs: List String, ys: List String) -> List String =
  match xs with
  | Nil -> Nil
  | Cons h t ->
      if list_member(h, ys) then list_diff(t, ys)
      else Cons(h, list_diff(t, ys))

fn list_dedup_acc(xs: List String, seen: List String) -> List String =
  match xs with
  | Nil -> Nil
  | Cons h t ->
      if list_member(h, seen) then list_dedup_acc(t, seen)
      else Cons(h, list_dedup_acc(t, Cons(h, seen)))

fn list_dedup(xs: List String) -> List String =
  list_dedup_acc(xs, Nil)

export fn ftv(t: Type) -> List String =
  list_dedup(ftv_acc(t, Nil))

export fn ftv_effect(e: Effect) -> List String =
  match e with
  | EffectVar name -> Cons(name, Nil)
  | _ -> Nil

export fn ftv_scheme(s: Scheme) -> List String =
  list_diff(
    list_union(ftv(scheme_type(s)), ftv_effect(scheme_effects(s))),
    list_union(scheme_vars(s), scheme_effect_vars(s))
  )

# ---------------------------------------------------------------------------
# Pretty-printing
# ---------------------------------------------------------------------------

fn join_list(sep: String, xs: List String) -> String =
  match xs with
  | Nil -> ""
  | Cons h t ->
      match t with
      | Nil -> h
      | _ -> h ++ sep ++ join_list(sep, t)

fn effect_suffix(e: Effect) -> String =
  match e with
  | EffectPure -> ""
  | EffectIO -> " !{IO}"
  | EffectVar name -> " !{" ++ name ++ "}"
  | EffectRow labels -> " !{" ++ join_list(", ", labels) ++ "}"

fn wrap_parens(s: String) -> String =
  "(" ++ s ++ ")"

# as_arg = true when this type appears as a constructor or function argument,
# requiring parentheses if it has lower precedence than application.
fn type_to_string_aux(t: Type, as_arg: Bool) -> String =
  match t with
  | TVar name -> name
  | TConst name -> name
  | TApp base arg ->
      type_to_string_aux(base, false) ++ " " ++ type_to_string_aux(arg, true)
  | TFunc param ret eff ->
      if as_arg
      then wrap_parens(type_to_string_aux(param, true) ++ " -> " ++ type_to_string_aux(ret, false) ++ effect_suffix(eff))
      else type_to_string_aux(param, true) ++ " -> " ++ type_to_string_aux(ret, false) ++ effect_suffix(eff)
  | TTuple items -> "(" ++ join_types(items) ++ ")"

fn join_types(items: List Type) -> String =
  match items with
  | Nil -> ""
  | Cons h t ->
      match t with
      | Nil -> type_to_string_aux(h, false)
      | _ -> type_to_string_aux(h, false) ++ ", " ++ join_types(t)

export fn type_to_string(t: Type) -> String =
  type_to_string_aux(t, false)

export fn effect_to_string(e: Effect) -> String =
  match e with
  | EffectPure -> "pure"
  | EffectIO -> "!{IO}"
  | EffectVar name -> "!{" ++ name ++ "}"
  | EffectRow labels -> "!{" ++ join_list(", ", labels) ++ "}"

fn scheme_body(s: Scheme) -> String =
  type_to_string(scheme_type(s)) ++ effect_suffix(scheme_effects(s))

# ---------------------------------------------------------------------------
# GHC-style variable renaming for scheme display
# ---------------------------------------------------------------------------
#
# Rename bound vars to a, b, c, ... in the order they appear in scheme_vars.
# This matches Python typechecker's scheme_to_string renaming convention.

fn nth_var_name(n: Int) -> String =
  if n == 0 then "a" else if n == 1 then "b" else if n == 2 then "c" else
  if n == 3 then "d" else if n == 4 then "e" else if n == 5 then "f" else
  if n == 6 then "g" else if n == 7 then "h" else if n == 8 then "i" else
  if n == 9 then "j" else "t" ++ int_to_string(n)

fn build_var_rename(vars: List String, n: Int, acc: Dict String) -> Dict String =
  match vars with
  | Nil -> acc
  | Cons v rest -> build_var_rename(rest, n + 1, dict_set(v, nth_var_name(n), acc))

fn apply_rename_type(rename: Dict String, t: Type) -> Type =
  match t with
  | TVar name ->
      match dict_get(name, rename) with
      | Just new_name -> TVar(new_name)
      | Nothing -> TVar(name)
  | TConst _ -> t
  | TApp base arg -> TApp(apply_rename_type(rename, base), apply_rename_type(rename, arg))
  | TFunc param ret eff -> TFunc(apply_rename_type(rename, param), apply_rename_type(rename, ret), eff)
  | TTuple items -> TTuple(apply_rename_type_list(rename, items))

fn apply_rename_type_list(rename: Dict String, ts: List Type) -> List Type =
  match ts with
  | Nil -> Nil
  | Cons h t -> Cons(apply_rename_type(rename, h), apply_rename_type_list(rename, t))

fn rename_vars_list(vars: List String, rename: Dict String) -> List String =
  match vars with
  | Nil -> Nil
  | Cons v rest ->
      match dict_get(v, rename) with
      | Just new_name -> Cons(new_name, rename_vars_list(rest, rename))
      | Nothing -> Cons(v, rename_vars_list(rest, rename))

fn scheme_to_string_renamed(vars: List String, t: Type, eff: Effect) -> String =
  "forall " ++ join_list(" ", rename_vars_list(vars, rename)) ++ ". " ++ type_to_string(apply_rename_type(rename, t)) ++ effect_suffix(eff)
  where rename = build_var_rename(vars, 0, dict_empty())

export fn scheme_to_string(s: Scheme) -> String =
  match scheme_vars(s) with
  | Nil -> scheme_body(s)
  | vars -> scheme_to_string_renamed(vars, scheme_type(s), scheme_effects(s))

# ---------------------------------------------------------------------------
# Eq and ToString instances — required by stdlib.test assert_eq
# ---------------------------------------------------------------------------
#
# Stage-0 constraint dispatch cannot resolve Eq inside instance method bodies
# (see comment above on list helpers).  All real logic lives in standalone
# monomorphic helpers; the instance `eq` methods are thin delegators.

fn string_list_eq(xs: List String, ys: List String) -> Bool =
  match xs with
  | Nil -> match ys with | Nil -> true | Cons _ _ -> false
  | Cons x rest_xs -> match ys with
      | Nil -> false
      | Cons y rest_ys -> if x == y then string_list_eq(rest_xs, rest_ys) else false

fn effect_eq(left: Effect, right: Effect) -> Bool =
  match left with
  | EffectPure -> match right with | EffectPure -> true | _ -> false
  | EffectIO -> match right with | EffectIO -> true | _ -> false
  | EffectRow ls -> match right with | EffectRow rs -> string_list_eq(ls, rs) | _ -> false
  | EffectVar s -> match right with | EffectVar t -> s == t | _ -> false

fn type_eq(left: Type, right: Type) -> Bool =
  match left with
  | TVar s -> match right with | TVar t -> s == t | _ -> false
  | TConst s -> match right with | TConst t -> s == t | _ -> false
  | TApp f a -> match right with | TApp g b -> type_eq(f, g) && type_eq(a, b) | _ -> false
  | TFunc p r e -> match right with
      | TFunc q s f -> type_eq(p, q) && type_eq(r, s) && effect_eq(e, f)
      | _ -> false
  | TTuple ts -> match right with | TTuple us -> types_eq(ts, us) | _ -> false

fn types_eq(left: List Type, right: List Type) -> Bool =
  match left with
  | Nil -> match right with | Nil -> true | Cons _ _ -> false
  | Cons x xs -> match right with
      | Nil -> false
      | Cons y ys -> if type_eq(x, y) then types_eq(xs, ys) else false

instance Eq Effect {
  fn eq(left: Effect, right: Effect) -> Bool = effect_eq(left, right)
}

instance Eq Type {
  fn eq(left: Type, right: Type) -> Bool = type_eq(left, right)
}

instance ToString Effect {
  fn to_string(e: Effect) -> String = effect_to_string(e)
}

instance ToString Type {
  fn to_string(t: Type) -> String = type_to_string(t)
}

fn scheme_eq(left: Scheme, right: Scheme) -> Bool =
  match left with
  | Scheme tv1 ev1 t1 e1 -> match right with
      | Scheme tv2 ev2 t2 e2 ->
          if string_list_eq(tv1, tv2) then
            if string_list_eq(ev1, ev2) then
              if type_eq(t1, t2) then effect_eq(e1, e2)
              else false
            else false
          else false

instance Eq Scheme {
  fn eq(left: Scheme, right: Scheme) -> Bool = scheme_eq(left, right)
}

instance ToString Scheme {
  fn to_string(s: Scheme) -> String = scheme_to_string(s)
}
