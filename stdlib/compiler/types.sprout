module stdlib.compiler.types
import stdlib.string as string

# ---------------------------------------------------------------------------
# Effect rows
# ---------------------------------------------------------------------------
#
# An effect row describes what side-effects a function may perform.
#   EffectPure        — no effects (the function is pure)
#   EffectIO          — concrete !{IO} label
#   EffectRow labels  — closed row with arbitrary named labels (future use)
#   EffectVar name    — open effect variable (e.g. from "fn f !{e}")

export type Effect (..) =
  | EffectPure
  | EffectIO
  | EffectRow (List String)
  | EffectVar String

# ---------------------------------------------------------------------------
# Parameter ownership (M4.6)
# ---------------------------------------------------------------------------
#
# Whether a function's parameter CONSUMES its argument (the default) or merely
# BORROWS it. This is a property of the function TYPE, not of the declaration:
# M4.5 kept it in an env sentinel keyed by declaration name (`@parammode:<name>`)
# and it was therefore lost at every callee that was not a literal top-level
# name, silently discharging the caller's consume obligation. See
# docs/linear-borrowing-v0.md §18.
#
# Two-valued, though `ast.ParamMode` has three: at the type level an unmodified
# parameter and a `consuming` one are the same thing. The written `consuming`
# documents the contract at an API boundary and is kept in the AST for
# diagnostics, but making it a distinct TYPE would mean `consuming File -> Int`
# and `File -> Int` failed to unify, which is nonsense.
#
# Prior art: Swift SE-0377 makes the ownership convention part of the function
# type for exactly this reason, and requires it to "match exactly" at a
# noncopyable parameter — invariance, no subtyping (see unifier.unify_applied).
export type Ownership (..) =
  | OwnConsume
  | OwnBorrow

export fn ownership_eq(a: Ownership, b: Ownership) -> Bool =
  match (a, b) with
  | (OwnConsume, OwnConsume) -> true
  | (OwnBorrow, OwnBorrow) -> true
  | _ -> false

export fn ownership_of_borrow(is_borrow: Bool) -> Ownership =
  if is_borrow then OwnBorrow else OwnConsume

export fn ownership_is_borrow(o: Ownership) -> Bool =
  match o with
  | OwnBorrow -> true
  | OwnConsume -> false

# ---------------------------------------------------------------------------
# Types
# ---------------------------------------------------------------------------
#
# The five forms mirror the Python typechecker exactly:
#   TVar  — an inference variable, identified by a generated name ("t0", "t1"…)
#   TConst — a type constant ("Int", "Bool", "Maybe", …)
#   TApp  — type application: TApp (TConst "Maybe") (TConst "Int") = Maybe Int
#   TFunc — function type with associated effect row and parameter ownership
#   TTuple — tuple type (Int, Bool, …)

# ---------------------------------------------------------------------------
# TypeId — opaque canonical type identity (G6)
# ---------------------------------------------------------------------------
#
# Identity is the module-qualified canonical name (e.g. "main.Maybe"; the prelude,
# having no module header, owns the unqualified name). TConst carries a TypeId, so the
# checker forbids raw string surgery on identity — consumers MUST go through the API
# below (type_id_eq / _display / _is_concrete / _symbol). A future generative identity
# (functors / path-dependent types) is a representation swap here, not a compiler-wide
# re-migration. Declared before Type so TConst can reference it.
export wrap TypeId = String

# Type-variable identity (E0). Declared before Type so TVar can reference it.
# Opaque wrapper over the name string today; E1 swaps the payload to an Int id
# (identity) + retained name (display) without touching any consumer, since all
# TVar producers/consumers route through the tyvar_* accessors below.
export wrap TyVarId = String

export type Type (..) =
  | TVar TyVarId
  | TConst TypeId
  | TApp Type Type
  | TFunc Type Type Effect Ownership
  | TTuple (List Type)

# Mint a TypeId from a canonical (already-resolved) name. The bundler/resolver is the
# source of canonical names; this is the single construction point.
export fn type_id(name: String) -> TypeId = TypeId(name)

# Raw canonical name. Internal — for serialization and the identity helpers below;
# call sites should prefer type_id_display / _eq / _is_concrete / _symbol.
export fn type_id_name(id: TypeId) -> String =
  match id with | TypeId s -> s

# Identity equality: exact on the canonical name.
export fn type_id_eq(a: TypeId, b: TypeId) -> Bool =
  type_id_name(a) == type_id_name(b)

# A skolem is a rigid type CONSTANT minted for an unpacked existential var
# (unifier.instantiate_ctor_pattern); its name is "$sk<n>" and "$" cannot open a
# user identifier, so this predicate never fires on a real type. Used to rephrase
# a unification mismatch involving a skolem as an "existential escapes its scope"
# diagnostic rather than leaking the internal "$sk3" name. See docs/gadts-v0.md.
export fn is_skolem_name(name: String) -> Bool =
  string.starts_with(name, "$sk")

# Stage 0b: the STABLE forwarding identity for a constrained existential's packed
# dictionary (docs/gadts-v0.md §5b/§7). The skolem `$sk<n>` that unpacking mints is
# fresh-per-instantiation and unknown to codegen, so it cannot key the dict
# forwarding. This name is instead derived from the pattern-bound variable — which
# BOTH infer (seeds the @fwd marker's value) and lowering (seeds ctx_fwd) can see —
# so the two ends agree by construction. The `$` prefix makes resolve treat it as a
# non-concrete head (→ EvForward), and marks it reserved (no source-name collision).
export fn existential_fwd_head(var_name: String) -> String =
  "$ex_" ++ var_name

export fn type_mentions_skolem(t: Type) -> Bool =
  match t with
  | TVar _ -> false
  | TConst id -> is_skolem_name(type_id_name(id))
  | TApp base arg -> type_mentions_skolem(base) || type_mentions_skolem(arg)
  | TFunc p r _ _ -> type_mentions_skolem(p) || type_mentions_skolem(r)
  | TTuple items -> any_mentions_skolem(items)

fn any_mentions_skolem(items: List Type) -> Bool =
  match items with
  | Nil -> false
  | Cons h t -> if type_mentions_skolem(h) then true else any_mentions_skolem(t)

# ── Class graph traversal + existential witness-slot enumeration ──────────────
# Shared home (this leaf is imported by both lowering and ast_to_ir) for the
# transitive-superclass dictionary layout. The normal dict-passing path
# (lowering), the constrained-existential witness-field COUNT (ast_to_ir), and
# its UNPACK (lowering) all derive slot layout from here, so they cannot drift
# (docs/gadts-v0.md §5b; BACKLOG "Multi-method / superclass existentials").

# The class itself followed by all transitive superclasses in DFS order, deduped.
# Keyed by the bare (post-`after_last_dot`) class name, matching class_order and
# super_map, which collect_class_order/collect_super_map build from ClassDecls.
export fn class_with_transitive_supers(class_name: String, super_map: Dict (List String)) -> List String =
  list_reverse(collect_supers_dfs(Cons(class_name, Nil), super_map, Nil))

fn collect_supers_dfs(stack: List String, super_map: Dict (List String), visited: List String) -> List String =
  match stack with
  | Nil -> visited
  | Cons name rest ->
      if list_member(name, visited)
      then collect_supers_dfs(rest, super_map, visited)
      else collect_supers_dfs(prepend_supers(name, super_map, rest), super_map, Cons(name, visited))

fn prepend_supers(name: String, super_map: Dict (List String), rest: List String) -> List String =
  match dict_get(name, super_map) with
  | Nothing -> rest
  | Just supers -> append_str_list(supers, rest)

fn append_str_list(xs: List String, ys: List String) -> List String =
  match xs with
  | Nil -> ys
  | Cons h t -> Cons(h, append_str_list(t, ys))

export fn class_methods_for(class_name: String, class_order: Dict (List String)) -> List String =
  match dict_get(class_name, class_order) with
  | Nothing -> Nil
  | Just ms -> ms

# Ordered witness slots for ONE existential constraint's class: one (eff_class,
# method) pair per method across the class and its transitive superclasses, in
# the SAME order the dict-lowering path (build_hidden_for_constraints /
# consume_blocks) lays down dictionary arguments. The slot COUNT is the length;
# slot i corresponds to the i-th packed `'p'` witness field, so unpack binds
# field i and dispatches its method through it.
# class_name is used AS-IS to key class_order/super_map: after bundler qualifies
# exist_constraints, all three (constraint, ClassDecl-derived class_order/super_map
# keys, and their transitive-super values) share the same qualified form, so no
# after_last_dot normalization is applied here (that would strip to a bare key the
# maps don't hold for a user class in a module).
export fn witness_slots_for_class(class_name: String, class_order: Dict (List String), super_map: Dict (List String)) -> List (String, String) =
  witness_slots_flatten(class_with_transitive_supers(class_name, super_map), class_order)

fn witness_slots_flatten(classes: List String, class_order: Dict (List String)) -> List (String, String) =
  match classes with
  | Nil -> Nil
  | Cons eff rest ->
      append_eff_methods(eff, class_methods_for(eff, class_order), witness_slots_flatten(rest, class_order))

fn append_eff_methods(eff: String, methods: List String, tail: List (String, String)) -> List (String, String) =
  match methods with
  | Nil -> tail
  | Cons m rest -> Cons((eff, m), append_eff_methods(eff, rest, tail))

# Display form: the short (last-segment) name, for diagnostics.
export fn type_id_display(id: TypeId) -> String =
  string.after_last_dot(type_id_name(id))

# Concreteness: a concrete type's NAME is uppercase, a type variable lowercase. Reads
# the LAST segment, since a qualified concrete type starts with a lowercase module
# component (e.g. "main.Maybe" — the '.m' is not the type name).
export fn type_id_is_concrete(id: TypeId) -> Bool =
  type_id_starts_upper(type_id_display(id))

fn type_id_starts_upper(s: String) -> Bool =
  match str_char_at(s, 0) with
  | Nothing -> false
  | Just c -> c >= 'A' && c <= 'Z'

# LLVM symbol fragment: dot-sanitized canonical name (dots are illegal in symbols).
export fn type_id_symbol(id: TypeId) -> String =
  string.replace_all(".", "_", type_id_name(id))

# ---------------------------------------------------------------------------
# TyVarId — type-variable identity (E0 scaffolding, canonical-identity campaign).
# Mirrors the TypeId block above. In E0 a TVar's identity IS its name string, so
# these are pass-throughs; E1 will make `tyvar_id` mint an Int at binding and
# `tyvar_identity` return it, while `tyvar_name` stays the print name. Routing
# every TVar producer/consumer through these makes the E1 representation swap a
# localized change instead of a 214-site rewrite.
# ---------------------------------------------------------------------------

# Mint a TVar payload from a canonical/fresh name. Single construction point.
export fn tyvar_id(name: String) -> TyVarId = TyVarId(name)

# Display / raw name of a type variable. E0: the identity string; E1: print-only.
# INVARIANT: a `tyvar_name` call site is display-only — the E1 audit may ignore it.
export fn tyvar_name(v: TyVarId) -> String =
  match v with | TyVarId s -> s

# Identity of a type variable — every site that correlates the var by identity
# (subst/dict keys, occurs/unify comparisons, ftv sets, dispatch heads, marker
# keys, serialization). E0: returns the name string (so byte-identical to
# tyvar_name today); E1: returns the Int id. Sites that concatenate this into a
# string or compare it against a String-threaded identity break loudly in E1 —
# by design, that compile-error set IS Stage 3's worklist.
export fn tyvar_identity(v: TyVarId) -> String =
  match v with | TyVarId s -> s

# Identity equality of two type variables (mirrors type_id_eq). E0: name-string
# equality; E1: Int id equality.
export fn tyvar_eq(a: TyVarId, b: TyVarId) -> Bool =
  tyvar_identity(a) == tyvar_identity(b)

# ---------------------------------------------------------------------------
# Schemes  (∀ type_vars effect_vars. body_type !body_effects)
# ---------------------------------------------------------------------------
#
# A monomorphic type is Scheme(Nil, Nil, t, EffectPure).
# A polymorphic type binds quantified variables so they can be freshly
# instantiated at each use site.

export type Scheme (..) =
  | Scheme (List String) (List String) Type Effect (List (String, String))
  # Scheme type_vars effect_vars body effects constraints
  #
  # constraints: the scheme's class constraints as (head_token, class name)
  # pairs, in where-clause order — the single source of truth that the
  # @constrained/@fwd/@eta_fwd env marker families collapse into (§13.3(B)
  # consolidation). One entry per constraint (complete + ordered), so a consumer
  # can reconstruct the exact hidden-dict injection sequence. head_token is the
  # SAME token the @constrained markers encode:
  #   - "#pos:<k>" — the constraint var is generalized at type_vars position k
  #     (stable across generalize/instantiate; decode via list_nth_or scheme_vars);
  #   - "<Name>"   — a concrete constructor head (e.g. "List") or a non-generalized
  #     var, resolved by its stable name;
  #   - ""         — a headless constraint (class-only marker), resolved without a
  #     head var.
  # Empty for a monomorphic or unconstrained scheme.

# ---------------------------------------------------------------------------
# Commonly-used type constants
# ---------------------------------------------------------------------------

export fn type_int() -> Type = TConst(type_id("Int"))
export fn type_double() -> Type = TConst(type_id("Double"))
export fn type_bool() -> Type = TConst(type_id("Bool"))
export fn type_string() -> Type = TConst(type_id("String"))
export fn type_char() -> Type = TConst(type_id("Char"))
export fn type_list(a: Type) -> Type = TApp(TConst(type_id("List")), a)
export fn type_maybe(a: Type) -> Type = TApp(TConst(type_id("Maybe")), a)

export fn effect_pure() -> Effect = EffectPure
export fn effect_io() -> Effect = EffectIO

# ---------------------------------------------------------------------------
# Scheme accessors / constructors
# ---------------------------------------------------------------------------

export fn mono(t: Type) -> Scheme =
  Scheme(Nil, Nil, t, EffectPure, Nil)

export fn scheme_vars(s: Scheme) -> List String =
  match s with | Scheme vs _ _ _ _ -> vs

export fn scheme_effect_vars(s: Scheme) -> List String =
  match s with | Scheme _ evs _ _ _ -> evs

export fn scheme_type(s: Scheme) -> Type =
  match s with | Scheme _ _ t _ _ -> t

export fn scheme_effects(s: Scheme) -> Effect =
  match s with | Scheme _ _ _ e _ -> e

# The scheme's class constraints as (head_token, class name) pairs, in
# where-clause order. Empty for a monomorphic or unconstrained scheme. Single
# source of truth for the @constrained/@fwd/@eta_fwd marker families (§13.3(B)
# consolidation). See the Scheme type declaration for head_token's encoding.
export fn scheme_constraints(s: Scheme) -> List (String, String) =
  match s with | Scheme _ _ _ _ cs -> cs

# Replace a scheme's constraint field, preserving the other four. Used at the
# FnDecl generalize site to attach the (head_token, class) pairs computed during
# body inference (§13.3(B) consolidation).
export fn scheme_with_constraints(s: Scheme, cs: List (String, String)) -> Scheme =
  match s with | Scheme tvs evs t e _ -> Scheme(tvs, evs, t, e, cs)

# ---------------------------------------------------------------------------
# Free type variables
# ---------------------------------------------------------------------------
#
# ftv collects every TVar name reachable from a type, with duplicates.
# Callers that need a set should pass the result through list_dedup.

fn ftv_acc(t: Type, acc: List String) -> List String =
  match t with
  | TVar name -> Cons(tyvar_identity(name), acc)
  | TConst _ -> acc
  | TApp base arg -> ftv_acc(base, ftv_acc(arg, acc))
  | TFunc param ret _ _ -> ftv_acc(param, ftv_acc(ret, acc))
  | TTuple items -> ftv_list_acc(items, acc)

fn ftv_list_acc(items: List Type, acc: List String) -> List String =
  match items with
  | Nil -> acc
  | Cons h t -> ftv_list_acc(t, ftv_acc(h, acc))

# ---------------------------------------------------------------------------
# List-as-set helpers for String (stage-0 compatible: no Eq constraint)
# ---------------------------------------------------------------------------
#
# The generic prelude list_member/union/diff/dedup use `where Eq a`, but the
# self-hosted stage-0 constraint dispatch cannot resolve Eq for element types
# inside container arguments (e.g. List String → looks for @inst:Eq:List, not
# @inst:Eq:String).  These String-specific helpers shadow the prelude generics
# within this module and are exported for use by unifier/infer.

export fn list_member(x: String, xs: List String) -> Bool =
  match xs with
  | Nil -> false
  | Cons h t -> if h == x then true else list_member(x, t)

export fn list_union(xs: List String, ys: List String) -> List String =
  match xs with
  | Nil -> ys
  | Cons h t ->
      if list_member(h, ys) then list_union(t, ys)
      else Cons(h, list_union(t, ys))

export fn list_diff(xs: List String, ys: List String) -> List String =
  match xs with
  | Nil -> Nil
  | Cons h t ->
      if list_member(h, ys) then list_diff(t, ys)
      else Cons(h, list_diff(t, ys))

fn list_dedup_acc(xs: List String, seen: List String) -> List String =
  match xs with
  | Nil -> Nil
  | Cons h t ->
      if list_member(h, seen) then list_dedup_acc(t, seen)
      else Cons(h, list_dedup_acc(t, Cons(h, seen)))

fn list_dedup(xs: List String) -> List String =
  list_dedup_acc(xs, Nil)

export fn ftv(t: Type) -> List String =
  list_dedup(ftv_acc(t, Nil))

export fn ftv_effect(e: Effect) -> List String =
  match e with
  | EffectVar name -> Cons(name, Nil)
  | _ -> Nil

export fn ftv_scheme(s: Scheme) -> List String =
  list_diff(
    list_union(ftv(scheme_type(s)), ftv_effect(scheme_effects(s))),
    list_union(scheme_vars(s), scheme_effect_vars(s))
  )

# ---------------------------------------------------------------------------
# Pretty-printing
# ---------------------------------------------------------------------------

fn join_list(sep: String, xs: List String) -> String =
  match xs with
  | Nil -> ""
  | Cons h t ->
      match t with
      | Nil -> h
      | _ -> h ++ sep ++ join_list(sep, t)

fn effect_suffix(e: Effect) -> String =
  match e with
  | EffectPure -> ""
  | EffectIO -> " !{IO}"
  | EffectVar name -> " !{" ++ name ++ "}"
  | EffectRow labels -> " !{" ++ join_list(", ", labels) ++ "}"

fn wrap_parens(s: String) -> String =
  "(" ++ s ++ ")"

# as_arg = true when this type appears as a constructor or function argument,
# requiring parentheses if it has lower precedence than application.
fn type_to_string_aux(t: Type, as_arg: Bool) -> String =
  match t with
  | TVar name -> tyvar_name(name)
  | TConst name -> type_id_name(name)
  | TApp base arg ->
      type_to_string_aux(base, false) ++ " " ++ type_to_string_aux(arg, true)
  | TFunc param ret eff own ->
      if as_arg
      then wrap_parens(func_to_string(param, ret, eff, own))
      else func_to_string(param, ret, eff, own)
  | TTuple items -> "(" ++ join_types(items) ++ ")"

# The ownership tag is printed as a prefix on the parameter, matching the
# declaration syntax (`fn f(c: borrowing File)`). It is what makes an ownership
# mismatch legible: without it the two sides of the error read identically.
fn func_to_string(param: Type, ret: Type, eff: Effect, own: Ownership) -> String =
  ownership_prefix(own) ++ type_to_string_aux(param, true) ++ " -> "
    ++ type_to_string_aux(ret, false) ++ effect_suffix(eff)

fn ownership_prefix(own: Ownership) -> String =
  match own with
  | OwnBorrow -> "borrowing "
  | OwnConsume -> ""

fn join_types(items: List Type) -> String =
  match items with
  | Nil -> ""
  | Cons h t ->
      match t with
      | Nil -> type_to_string_aux(h, false)
      | _ -> type_to_string_aux(h, false) ++ ", " ++ join_types(t)

export fn type_to_string(t: Type) -> String =
  type_to_string_aux(t, false)

export fn effect_to_string(e: Effect) -> String =
  match e with
  | EffectPure -> "pure"
  | EffectIO -> "!{IO}"
  | EffectVar name -> "!{" ++ name ++ "}"
  | EffectRow labels -> "!{" ++ join_list(", ", labels) ++ "}"

fn scheme_body(s: Scheme) -> String =
  type_to_string(scheme_type(s)) ++ effect_suffix(scheme_effects(s))

# ---------------------------------------------------------------------------
# GHC-style variable renaming for scheme display
# ---------------------------------------------------------------------------
#
# Rename bound vars to a, b, c, ... in the order they appear in scheme_vars.
# This matches Python typechecker's scheme_to_string renaming convention.

fn nth_var_name(n: Int) -> String =
  if n == 0 then "a" else if n == 1 then "b" else if n == 2 then "c" else
  if n == 3 then "d" else if n == 4 then "e" else if n == 5 then "f" else
  if n == 6 then "g" else if n == 7 then "h" else if n == 8 then "i" else
  if n == 9 then "j" else "t" ++ int_to_string(n)

fn build_var_rename(vars: List String, n: Int, acc: Dict String) -> Dict String =
  match vars with
  | Nil -> acc
  | Cons v rest -> build_var_rename(rest, n + 1, dict_set(v, nth_var_name(n), acc))

fn apply_rename_type(rename: Dict String, t: Type) -> Type =
  match t with
  | TVar name ->
      match dict_get(tyvar_identity(name), rename) with
      | Just new_name -> TVar(tyvar_id(new_name))
      | Nothing -> TVar(name)
  | TConst _ -> t
  | TApp base arg -> TApp(apply_rename_type(rename, base), apply_rename_type(rename, arg))
  | TFunc param ret eff own ->
      TFunc(apply_rename_type(rename, param), apply_rename_type(rename, ret), eff, own)
  | TTuple items -> TTuple(apply_rename_type_list(rename, items))

fn apply_rename_type_list(rename: Dict String, ts: List Type) -> List Type =
  match ts with
  | Nil -> Nil
  | Cons h t -> Cons(apply_rename_type(rename, h), apply_rename_type_list(rename, t))

fn rename_vars_list(vars: List String, rename: Dict String) -> List String =
  match vars with
  | Nil -> Nil
  | Cons v rest ->
      match dict_get(v, rename) with
      | Just new_name -> Cons(new_name, rename_vars_list(rest, rename))
      | Nothing -> Cons(v, rename_vars_list(rest, rename))

fn scheme_to_string_renamed(vars: List String, t: Type, eff: Effect) -> String =
  "forall " ++ join_list(" ", rename_vars_list(vars, rename)) ++ ". " ++ type_to_string(apply_rename_type(rename, t)) ++ effect_suffix(eff)
  where rename = build_var_rename(vars, 0, dict_empty())

export fn scheme_to_string(s: Scheme) -> String =
  match scheme_vars(s) with
  | Nil -> scheme_body(s)
  | vars -> scheme_to_string_renamed(vars, scheme_type(s), scheme_effects(s))

# ---------------------------------------------------------------------------
# Eq and ToString instances — required by stdlib.test assert_eq
# ---------------------------------------------------------------------------
#
# Stage-0 constraint dispatch cannot resolve Eq inside instance method bodies
# (see comment above on list helpers).  All real logic lives in standalone
# monomorphic helpers; the instance `eq` methods are thin delegators.

fn string_list_eq(xs: List String, ys: List String) -> Bool =
  match xs with
  | Nil -> match ys with | Nil -> true | [_ | _] -> false
  | Cons x rest_xs -> match ys with
      | Nil -> false
      | Cons y rest_ys -> if x == y then string_list_eq(rest_xs, rest_ys) else false

fn effect_eq(left: Effect, right: Effect) -> Bool =
  match left with
  | EffectPure -> match right with | EffectPure -> true | _ -> false
  | EffectIO -> match right with | EffectIO -> true | _ -> false
  | EffectRow ls -> match right with | EffectRow rs -> string_list_eq(ls, rs) | _ -> false
  | EffectVar s -> match right with | EffectVar t -> s == t | _ -> false

fn type_eq(left: Type, right: Type) -> Bool =
  match left with
  | TVar s -> match right with | TVar t -> tyvar_eq(s, t) | _ -> false
  | TConst s -> match right with | TConst t -> type_id_eq(s, t) | _ -> false
  | TApp f a -> match right with | TApp g b -> type_eq(f, g) && type_eq(a, b) | _ -> false
  | TFunc p r e o -> match right with
      | TFunc q s f w -> type_eq(p, q) && type_eq(r, s) && effect_eq(e, f) && ownership_eq(o, w)
      | _ -> false
  | TTuple ts -> match right with | TTuple us -> types_eq(ts, us) | _ -> false

fn types_eq(left: List Type, right: List Type) -> Bool =
  match left with
  | Nil -> match right with | Nil -> true | [_ | _] -> false
  | Cons x xs -> match right with
      | Nil -> false
      | Cons y ys -> if type_eq(x, y) then types_eq(xs, ys) else false

instance Eq Effect {
  fn eq(left: Effect, right: Effect) -> Bool = effect_eq(left, right)
}

instance Eq Type {
  fn eq(left: Type, right: Type) -> Bool = type_eq(left, right)
}

instance ToString Effect {
  fn to_string(e: Effect) -> String = effect_to_string(e)
}

instance ToString Type {
  fn to_string(t: Type) -> String = type_to_string(t)
}

fn scheme_eq(left: Scheme, right: Scheme) -> Bool =
  match left with
  | Scheme tv1 ev1 t1 e1 c1 -> match right with
      | Scheme tv2 ev2 t2 e2 c2 ->
          if string_list_eq(tv1, tv2) then
            if string_list_eq(ev1, ev2) then
              if type_eq(t1, t2) then
                if effect_eq(e1, e2) then constraints_eq(c1, c2)
                else false
              else false
            else false
          else false

# Element-wise equality of (head_token, class-name) constraint lists.
fn constraints_eq(a: List (String, String), b: List (String, String)) -> Bool =
  match a with
  | Nil -> match b with | Nil -> true | [_ | _] -> false
  | Cons pair1 ra -> match b with
      | Nil -> false
      | Cons pair2 rb ->
          match pair1 with
          | (p1, c1) -> match pair2 with
              | (p2, c2) ->
                  if p1 == p2 then
                    if c1 == c2 then constraints_eq(ra, rb) else false
                  else false

instance Eq Scheme {
  fn eq(left: Scheme, right: Scheme) -> Bool = scheme_eq(left, right)
}

instance ToString Scheme {
  fn to_string(s: Scheme) -> String = scheme_to_string(s)
}
