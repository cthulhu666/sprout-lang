module stdlib.compiler.sprout_ir

# ---------------------------------------------------------------------------
# Sprout-IR — typed intermediate representation.
# ---------------------------------------------------------------------------
#
# This module belongs to Milestone 1 of the "Model C" plan
# (see docs/gc-rooting-model-c-plan-2026-06-02.md).
#
# PR 1.1 introduced the empty shell.  PR 1.2 added the two minimal scalar
# constructors (IRConst, IRRet); PR 1.3 added scalar arithmetic + comparison;
# PR 1.4 added control-flow primitives; PR 1.5 adds direct calls + recursion:
#
#   IRConst  String Int                — bind a fresh result name to an Int literal.
#   IRRet    String                    — return-from-function, referencing a value name.
#   IRIAdd   String String String      — result = lhs + rhs   (i64)
#   IRISub   String String String      — result = lhs - rhs   (i64)
#   IRIMul   String String String      — result = lhs * rhs   (i64)
#   IRICmp   String String String String
#       — result = icmp <pred> lhs, rhs   (i1)
#       — argument order: result-name, predicate, lhs, rhs.
#         Predicate is one of LLVM's i-cmp keywords: "eq", "ne",
#         "slt", "sle", "sgt", "sge".
#   IRBr     String                    — unconditional branch to a block label.
#                                          field: target block label (NO '%' prefix).
#   IRCondBr String String String      — br i1 %<cond>, label %<then>, label %<else>.
#                                          fields: cond value-name (carries '%' prefix
#                                          if it's a temp), then-label, else-label.
#   IRPhi    String String (List (String, String))
#       — result = phi <type> [<value>, %<label>], ...
#       — fields: result-name, LLVM type ("i64"/"i1"), incoming pairs.
#         Convention for the incoming pairs: the first String is the value
#         name with its '%' prefix already present (matching how it arrives
#         from translate_expr — e.g. "%x" for a parameter, "%t3" for a temp);
#         the second String is the block label WITHOUT a '%' prefix (e.g.
#         "then_0").  lower_op adds the '%' before the label at render time.
#   IRCall   String IRType String (List String)
#       — result = call i64 @<fn-name>(i64 %<a0>, ...)
#       — fields: result-name, return-value IRType kind (for ir_rooting),
#         callee function name (NO '@' prefix), list of arg value-names
#         (each carries its '%' prefix already).
#         PR 1.5 implies every arg is i64 (only scalar Int args are
#         supported at this milestone).
#
# Value names are plain Strings: parameters carry the source-level name and
# IRConst/IRIAdd/etc. introduce fresh names chosen by the AST→IR translator
# (typically "%t0", "%t1", …).  Block labels are bare strings — "entry",
# "then_0", "else_0", "join_0", … — and lower_op prepends '%' where LLVM
# syntax requires it.
#
# IRFunction's third String is the LLVM return-type ("i64" or "i1") and the
# fourth field is a List IRBlock.  Future PRs will add calls and heap
# categories.
#
# print_ir_program is a debugging helper used by tests and tooling.  It does
# NOT produce LLVM — that is ir_lowering.lower_program's job.

# ---------------------------------------------------------------------------
# IRType — coarse classification of an SSA value for GC rooting.
# ---------------------------------------------------------------------------
#
# Sprout-IR is a typed IR; this is the minimal-viable type system needed by
# the rooting pass.  Three nullary tags:
#
#   IRTHeap     — known heap pointer (String, ADT handle, closure, tuple).
#                 Must be rooted across GC triggers.
#   IRTScalar   — known non-heap scalar (Int, Bool, Char codepoint).
#                 Never a heap pointer; safe to skip rooting.
#   IRTUnknown  — type unknown to the IR builder (TVar, polymorphic position,
#                 unresolved annotation).  Treated AS IF heap by the rooting
#                 pass (conservative — over-rooting is correctness-safe).
#
# All three tags are nullary so they CPR-unbox to a single i64 in the runtime
# representation; pattern-matching them lowers to a single `icmp` (vs `str_eq`
# for the previous string-based kind convention).  See runtime/sprout_runtime.c
# `sprout_make0` singleton cache for the per-tag pointer reuse.
export type IRType (..) =
  | IRTHeap
  | IRTScalar
  | IRTUnknown

export type IROp (..) =
  | IRConst String Int
  | IRRet String
  # IRRetVoid — `ret void`.  Used by the synthesized `@__sprout_init_globals`
  # function (M3 PR 5) and any future void-returning IRFunction.
  | IRRetVoid
  | IRIAdd String String String
  | IRISub String String String
  | IRIMul String String String
  # IRIDiv <result> <lhs> <rhs>  — signed integer division (lowers to `sdiv i64`).
  # Sprout's `/` operator on Int operands.  The runtime contract for division by
  # zero matches LLVM's: undefined behaviour.  Source-level division-by-zero
  # guards must be inserted by the user (or by a later pass) before the IRIDiv.
  | IRIDiv String String String
  # Float ops (Double).  A Double is carried as its i64 bit-pattern through the
  # uniform ABI; these ops bitcast to `double`, apply the float instruction, and
  # bitcast the result back to i64 — so the operand/result SSA names are i64 like
  # every other scalar (docs/nn-gap-analysis.md §7.1).  fdiv-by-zero is IEEE
  # defined (inf/nan), so unlike IRIDiv there is no div-by-zero guard.
  #   IRFloatConst <result> <decimal-text>   — result = bitcast double <text> to i64
  #   IRFAdd/Sub/Mul/Div <result> <lhs> <rhs> — bitcast dance around fadd/fsub/…
  #   IRFCmp <result> <fpred> <lhs> <rhs>     — ordered fcmp, result is i1
  #   IRFNeg <result> <operand>               — bitcast dance around `fneg double`
  | IRFloatConst String String
  | IRFAdd String String String
  | IRFSub String String String
  | IRFMul String String String
  | IRFDiv String String String
  | IRFCmp String String String String
  # IRFNeg <result> <operand>  — floating-point negation (Sprout's unary `-` on a
  # Double).  Distinct from IRINeg: `sub i64 0, %x` would negate the double's i64
  # bit-pattern, not its IEEE value.  Lowers to a bitcast to double, `fneg`, and a
  # bitcast back (uniform i64 ABI), the same dance as IRFAdd/…
  | IRFNeg String String
  # IRSIToF <result> <operand>  — signed int -> double (`to_double`).  The operand
  # is a genuine i64 integer value; `sitofp` yields a double, then bitcast to i64
  # to carry it as a bit-pattern (uniform ABI).  The bitcast lands AFTER the
  # convert (opposite side from IRFCmp/IRFNeg, whose operands are already bits).
  | IRSIToF String String
  # IRBoolNot <result> <operand>  — boolean negation (lowers to `xor i64 %x, 1`).
  # Sprout's `!` operator.  Both operand and result are the i64-uniform Bool
  # representation (0 = false, 1 = true).  Xor with 1 flips the low bit.
  | IRBoolNot String String
  # IRINeg <result> <operand>  — integer arithmetic negation (lowers to
  # `sub i64 0, %x`).  Sprout's unary `-` operator.  Distinct from IRISub
  # because the LHS is the literal 0, not an SSA name.
  | IRINeg String String
  # IRLoadGlobal <result> <global-name>  — read a top-level let binding.
  # Lowers to `<result> = load i64, ptr @<global-name>`.  Used at every TVar
  # reference that resolves to a top-level let (M3 PR 5).  Loaded type is
  # currently always i64 (Bool/Int/String all use the uniform i64 encoding).
  | IRLoadGlobal String String
  # IRStoreGlobal <global-name> <value-ssa>  — write to a top-level let
  # binding.  Lowers to `store i64 <value-ssa>, ptr @<global-name>`.  Used
  # only in the synthesized `@__sprout_init_globals` function to initialize
  # runtime-computed globals once at program start.
  | IRStoreGlobal String String
  # IRRegisterGlobalRoot <global-name>  — register a top-level let's storage
  # slot as a permanent GC root.  Lowers to
  #   call i64 @sprout_gc_register_i64_root(ptr @<global-name>)
  # Emitted once per global immediately after its IRStoreGlobal in
  # `@__sprout_init_globals`.  Without it the typed path never roots top-level
  # heap globals, so the GC sweeps them on the next collection (silent UAF).
  # Registering a scalar (Int/Bool) slot is harmless: the i64-root marker runs
  # the value through find_managed_ptr, which returns NULL for non-heap values,
  # so every global is registered unconditionally (mirrors direct codegen's
  # emit_global_root_registration).
  | IRRegisterGlobalRoot String
  # IRMakeTuple <result> <element-ssas>  — heap-allocate a tuple blob and
  # store each element.  Lowers to:
  #   <result>      = call i64 @sprout_alloc_tuple_blob(i64 <N*8>)
  #   <result>$ptr  = inttoptr i64 <result> to ptr
  #   <result>$s0   = getelementptr i64, ptr <result>$ptr, i64 0
  #   store i64 <elem0>, ptr <result>$s0
  #   ...
  # Result type is i64 (heap pointer to the blob).  Per-element ABI matches
  # direct codegen's tuple-as-blob mode (codegen.sprout:940-968).
  | IRMakeTuple String (List String)
  # IRGetTupleField <result> <tuple-ssa> <field-idx>  — read element at
  # field-idx from a tuple blob.  Lowers to:
  #   <result>$ptr = inttoptr i64 <tuple-ssa> to ptr
  #   <result>$gep = getelementptr i64, ptr <result>$ptr, i64 <field-idx>
  #   <result>     = load i64, ptr <result>$gep
  | IRGetTupleField String String Int IRType
  | IRICmp String String String String
  | IRBr String
  | IRCondBr String String String
  | IRPhi String String (List (String, String))
  # IRCall <result> <ret-kind> <fn-name> <args>.  <ret-kind> is the IRType of
  # the callee's return value (IRTScalar for Int/Bool/Char returns, else
  # IRTHeap/IRTUnknown), used by ir_rooting to decide whether the result must be
  # rooted across later GC triggers.  Lowering ignores it (uniform i64 ABI).
  | IRCall String IRType String (List String)
  # IRCallUnboxed2 <tag> <val> <val_kind> <fn> <args> — Tier-1 CPR peephole.
  # A `match` whose scrutinee is a direct call to a Maybe-returning C extern with
  # an `_unboxed` { i64, i64 } variant lowers to THIS instead of a boxed IRCall +
  # IRGetTag + IRGetField.  <fn> is the FULL unboxed callee name (e.g.
  # "vector_get_unboxed").  Lowers to:
  #   %<struct> = call { i64, i64 } @<fn>(<args>)
  #   <tag>     = extractvalue { i64, i64 } %<struct>, 0
  #   <val>     = extractvalue { i64, i64 } %<struct>, 1
  # The struct SSA is synthesized at lowering (derived from <tag>); it never
  # appears as an IR-level value, so the rooting pass sees exactly two defs:
  # <tag> (always IRTScalar — a ctor tag) and <val> (the payload, kind <val_kind>).
  # No `Just` heap allocation occurs (the C `_unboxed` variant returns the struct
  # by value), eliminating ~20 ns/get of box+strip overhead.  GC: op_triggers_gc
  # = true (regex/term_read variants allocate their payload before returning);
  # <val> is rooted per <val_kind> exactly as the boxed IRGetField result was.
  | IRCallUnboxed2 String String IRType String (List String)
  # IRRetUnboxed2 <base> <tag> <val> — Tier-2 CPR: a CPR worker's return.  Packs
  # the ctor tag and its single payload (0 for a nullary ctor) into the
  # { i64, i64 } worker ABI and returns by value — no `Just`/ctor heap box.
  # <tag>/<val> may be SSA names OR integer literals ("13", "0"); <base> is a
  # FRESH SSA name (e.g. %t$7) that seeds the two insertvalue temporaries so the
  # emitted names are always valid regardless of literal operands.  Emitted only
  # inside a `define { i64, i64 } @<fn>_worker`.  Lowers to:
  #   <base>$r0 = insertvalue { i64, i64 } undef, i64 <tag>, 0
  #   <base>$r1 = insertvalue { i64, i64 } <base>$r0, i64 <val>, 1
  #   ret { i64, i64 } <base>$r1
  # No GC trigger between materializing <val> and the ret, so <val> needs no
  # extra root here (the callee already rooted it if heap).
  | IRRetUnboxed2 String String String
  | IRStrConst String String String
  | IRStrSlice String String String String
  | IRStrConcat String String String
  # IRStrEq <result> <lhs> <rhs>  — String equality (lowers to @str_eq).
  # Both operands are i64-uniform String handles.  Lowering coerces each
  # to ptr (inttoptr), calls `i1 @str_eq(ptr, ptr)`, then zexts the i1
  # result to i64 so that downstream consumers see the Bool i64 encoding.
  # This op is emitted by translate_binary for `==` / `!=` on String operands;
  # `!=` appends IRBoolNot on the i64 result.
  # Mirrors direct codegen's emit_ptr_comparison (codegen.sprout ~2094).
  | IRStrEq String String String
  # IRStrCompare <result> <pred> <lhs> <rhs>  — String/Char ordering (lowers to @str_compare).
  # Both operands are i64-uniform String/Char handles (the ABI treats Char as a
  # single-codepoint String).  Lowering calls `i64 @str_compare(i64, i64)` (which
  # returns -1/0/1 per the C signature), then `icmp <pred> i64 <result>, 0`, then
  # zexts the i1 to i64 (Bool ABI).
  # pred is one of: "slt" / "sle" / "sgt" / "sge".
  # Emitted by translate_binop for `<` / `<=` / `>` / `>=` on String/Char operands.
  # Note: String literal ordering is additionally gated by infer.sprout's check_compare
  # (which currently accepts only Int/Char); the is_string_type routing arm here is a
  # forward-compatibility hook for when that restriction is lifted.
  | IRStrCompare String String String String
  # IRPrintStr <result> <callee> <arg>  — print a String/Char to stdout/stderr.
  # <callee> is "print_str" (stdout) or "eprint_str" (stderr); both take a
  # `const char*` in the C runtime, so lowering coerces the i64-uniform String
  # handle to ptr (inttoptr) before the call.  Mirrors direct codegen's
  # emit_print_call / emit_eprint_call (codegen.sprout ~2474).  Int/Bool prints
  # do NOT use this op — they route through a plain IRCall to @print_value(i64).
  | IRPrintStr String String String
  # IRStrFromInt's IR-op name diverges from the runtime name; it lowers to @int_to_string.
  | IRStrFromInt String String
  # IRMakeCtor <result> <ctor-name> <tag> <args>
  #   - result: '%t<N>' for the i64 handle returned by sprout_makeN.
  #   - ctor-name: source-level constructor name (for diagnostics only — never
  #     used by the runtime call; tag is baked in at translate-time).
  #   - tag: ctor tag literal, resolved by ast_to_ir from a ctor-table that
  #     mirrors codegen.sprout's `build_ctor_sigs_from_decls` numbering.
  #   - args: list of '%'-prefixed value-names, one per ctor field, in source
  #     order.  Arity = length args; length determines which `@sprout_makeN`
  #     is called.  M3 PR 2: CPR-eligible ctors are ALSO lowered through this
  #     op (boxed allocation, no sret).  PR 2b will introduce IRMakeCprCtor
  #     for the actual CPR optimization (struct return + sret) while keeping
  #     this op for non-CPR ctors only.
  | IRMakeCtor String String Int (List String)
  # IRMkClosure <result> <code-fn-name> <captures>
  #   - result: '%t<N>' for the i64 closure handle.
  #   - code-fn-name: top-level synthetic function name (no '@' prefix); MUST use the
  #     '@__sprout_ir_lambda_' prefix in emission to avoid collisions with user-defined
  #     functions (the '__sprout_' namespace is reserved by the compiler).
  #   - captures: list of '%'-prefixed value-names to store into env slots 1..N
  #     (slot 0 reserved for the code pointer).  Order is observable: lifted
  #     bodies access captures via IRLoadEnvSlot at the same slot index.
  #   Lowering: single call @sprout_alloc_closure_env(i64 sz) + GEP+store per
  #   capture + final ptrtoint pack to i64.
  | IRMkClosure String String (List String)
  # IRApplyClosure <result> <callee> <args>
  #   - result: '%t<N>' for the i64 (or i1) call result.
  #   - callee: '%'-prefixed closure-handle value.
  #   - args: list of '%'-prefixed value-names (excluding env; lowering passes
  #     env as the implicit first arg).
  #   Lowering: load code-ptr from env slot 0 + indirect LLVM call(env, args...).
  #   Result type is i64 in M2 (everything is i64).
  | IRApplyClosure String String (List String)
  # IRLoadEnvSlot <result> <env-val> <slot-idx> <kind>
  #   - result: '%t<N>' for the loaded i64 value.
  #   - env-val: '%'-prefixed env handle (typically a parameter of a lifted lambda).
  #   - slot-idx: 1-based; slot 0 is the code pointer, slots 1..N are captures.
  #   - kind: IRType.  IRTScalar captures (Int, Bool, Char) are not rooted
  #     by ir_rooting; IRTHeap captures (String, ADT, closure) are rooted.
  #     IRTUnknown is treated as heap (conservative).
  #   Lowering: GEP + load i64 (kind is ignored at lowering; always emits load i64).
  #   Pure load — does NOT trigger GC.
  #   FIX R4#7 (kind=String); migrated to IRType in BACKLOG.md:367 follow-up.
  | IRLoadEnvSlot String String Int IRType
  # IRRoot <slot-name> <value-being-rooted> <discard-reg-for-push-call>
  # All names carry their '%' prefix already.
  #
  # Invariant: Sprout's GC is non-moving mark-sweep (see runtime/sprout_runtime.c
  # `sprout_gc_sweep` at ~line 1063).  Marked objects stay at their allocation
  # address — never relocated, never compacted.  This makes IRRoot's "push the
  # alloca holding the i64 heap-address; never reload" pattern correct: the i64
  # value stored at the alloca remains a valid heap pointer for the entire
  # function lifetime.  If GC ever becomes moving, every IRRoot must be paired
  # with a re-load *after* its trigger op, and every heap-typed SSA use after
  # a trigger must source from the reload — a major rewrite.  See AGENTS.md.
  | IRRoot String String String
  # IRUnroot <count-to-pop> <discard-reg-for-pop-call>
  | IRUnroot Int String
  # IRGetTag <result> <scrut-handle>
  # Lowers to: %result = call i64 @sprout_tag(i64 %scrut-handle)
  # @sprout_tag reads ctor metadata; no allocation. NOT a GC trigger.
  | IRGetTag String String
  # IRGetField <result> <scrut-handle> <field-idx> <field-kind>
  # field-kind: IRType (mirrors IRLoadEnvSlot's kind arg).
  # Encoding source: ctors-dict value record
  #   Dict String CtorInfo  # CtorInfo tag arity max_arity field_kinds_string
  # `field_kinds_string` is computed by build_ctor_table and passed to
  # CtorReg; the same value is threaded into the dict. translate_match
  # decodes per-byte via stdlib.compiler.field_kinds.field_kind_char_to_irtype:
  #   'i' (Int)              -> IRTScalar
  #   'b' (Bool)             -> IRTScalar
  #   's' (String AND Char)  -> IRTHeap   (/code-review fix #1: String must
  #                                        be rooted; Char over-rooted)
  #   'p' (ADT|closure|tuple) -> IRTHeap
  #   '_' (type-var)         -> IRTUnknown   (conservative — avoid missed roots)
  # Lowers to: %result = call i64 @sprout_field(i64 %scrut-handle, i64 <idx>)
  # @sprout_field is a pure read; no allocation. NOT a GC trigger.
  # field-kind drives ir_rooting heap-vs-scalar classification of <result>.
  | IRGetField String String Int IRType
  # B1 Vector-Double inline access. These three ops replace `vector_get_direct`
  # / `vector_mutset` CALLS on statically-`Vector Double` sites (Double-gated in
  # ast_to_ir; every other element type stays a plain IRCall, so the compiler's
  # own Vector Int/Token reads — and the bootstrap seed — are byte-identical).
  #
  # They are UNCHECKED straight-line single-block loads/stores: the null + bounds
  # guard is emitted as IRBlocks by ast_to_ir (mirrors finish_checked_div — a
  # checked op must split blocks at the IRBlock layer, not the text layer, or
  # downstream phi predecessors name the wrong block). Layout is VectorVal
  # { i64 len@0, i64 cap@8, i64* data@16 }.
  #
  # IRVecLenD <result> <vec-handle> — load v->len (offset 0). Result is an Int
  # scalar. Used by the ast_to_ir bounds check; non-allocating.
  | IRVecLenD String String
  # IRVecGetD <result> <vec-handle> <idx-value> — load v->data[idx] (unchecked).
  # <result> is the loaded i64 = Double bit-pattern; the uniform-i64 ABI keeps it
  # i64 and the downstream bitcast folds to `ldr d` (the fmov the call ABI forced
  # is gone). The element is scalar (Double), so <result> is NEVER a heap value:
  # ir_rooting classifies it scalar and never roots it. Non-allocating.
  | IRVecGetD String String String
  # IRVecSetD <result> <vec-handle> <idx-value> <val> — store <val> into
  # v->data[idx] (unchecked). <val> is a scalar i64 (Double bits); no GC write
  # barrier is needed for a non-pointer element (pointer-element writes stay at
  # vector_mutset, the Phase-2 barrier chokepoint). <result> mirrors
  # vector_mutset's `return 0` so SSA consumers (bound to `_`) are unaffected.
  # Non-allocating.
  | IRVecSetD String String String String
  # IRAbortMatch
  # Lowers to:
  #   call void @sprout_abort_match()
  #   unreachable
  # @sprout_abort_match is declared `void noreturn` (/code-review fix #15);
  # no result SSA is allocated. Single op so that "this block aborts" is a
  # syntactically visible terminator; equivalent to IRCall + IRUnreachable
  # but avoids growing the IR with a standalone unreachable op. NOT a GC trigger.
  | IRAbortMatch
  # IRPanic <msg>
  # Lowers to:
  #   call i64 @panic(i64 <msg>)
  #   unreachable
  # A noreturn terminator like IRAbortMatch, but with a caller-supplied message
  # String (<msg> is an i64 handle). Reuses the existing `panic` builtin
  # (long long panic(long long)); no runtime addition. Used by the `/`
  # divide-by-zero guard (W7/F-DIV). NOT a GC trigger — panic exits the process.
  | IRPanic String
  # IRZextI1ToI64 <result> <source>
  # Lowers to: %result = zext i1 %source to i64
  # /code-review-v2 fix #3: emitted after every IRICmp so comparison
  # results become i64-typed Bool values. NOT a GC trigger.
  | IRZextI1ToI64 String String
  # IRTruncI64ToI1 <result> <source>
  # Lowers to: %result = trunc i64 %source to i1
  # /code-review-v2 fix #3: emitted before every IRCondBr so the cond
  # operand has the i1 type LLVM's `br i1` requires. NOT a GC trigger.
  | IRTruncI64ToI1 String String
  # /code-review fix #2: IRConstBool and IRICmpBool were removed.
  #
  # ----- Tail-call optimization (self-recursion) -----
  # These three ops turn a self-tail-recursive function into an alloca-slot
  # loop, mirroring direct codegen's emit_fn_tco.  The function's params are
  # renamed to '%<p>$in' (the define signature); each gets a stack slot the body
  # re-loads at the loop header every iteration, and each tail self-call stores
  # new values into the slots and branches back.  Because state flows through the
  # SLOTS (re-loaded per iteration), no SSA value spans the back-edge, so the
  # single-pass ir_rooting liveness analysis stays sound.  See
  # docs/typed-tco-implementation-2026-06-27.md.
  #
  # IRTcoEntry <slots> <sp_save>  — entry block.  slots = (slot, lltype, in_name).
  # Lowers to, for each: `<slot> = alloca <ty>` + `store <ty> <in>, ptr <slot>`;
  # then `<sp_save> = call ptr @llvm.stacksave()`.  Slot allocas MUST precede the
  # stacksave so stackrestore (on the back-edge) frees only per-iteration root
  # allocas, never the slots.  The caller appends `IRBr "tco_loop"`.  No GC root
  # push — rooting is handled by the liveness pass on the loaded values.
  | IRTcoEntry (List (String, String, String)) String
  # IRTcoLoad <loaded> <lltype> <slot> <kind>  — one per param, at the top of the
  # tco_loop block.  Lowers to `<loaded> = load <ty>, ptr <slot>`.  kind drives
  # ir_rooting: IRTHeap/IRTUnknown loaded values enter heap_origin and are rooted
  # where live across GC triggers; IRTScalar values are not.
  | IRTcoLoad String String String IRType
  # IRTcoBack <stores> <sp_save> <loop_label>  — the tail self-call back-edge
  # (a terminator).  stores = (slot, lltype, new_value).  Lowers to, for each:
  # `store <ty> <new>, ptr <slot>`; then `call void @llvm.stackrestore(ptr <sp_save>)`;
  # then `br label %<loop_label>`.  No explicit GC root pop — the per-trigger
  # bracketing in ir_rooting self-balances each iteration.
  | IRTcoBack (List (String, String, String)) String String
  # IRTailCall <result> <callee_ll_name> <arg_values> <sp_save>  — a MUTUAL tail
  # call (a terminator).  arg_values are i64 SSA names (uniform ABI).  Lowers to:
  #   [ `call void @llvm.stackrestore(ptr <sp_save>)`  if sp_save != "" ]
  #   `<result> = musttail call i64 @<callee_ll_name>(i64 <a>, ...)`
  #   `ret i64 <result>`
  # LLVM `musttail` guarantees no stack growth for a cyclic call; it requires the
  # call to immediately precede a `ret` of its value and caller/callee prototypes
  # to match (both i64 here).  Like IRTcoBack it is NOT a GC trigger and does NOT
  # expose operands for rooting: args are passed by value and the callee roots its
  # params on entry, so no root is emitted across it — this is what removes the
  # per-frame accumulating root that exhausts the pool.  sp_save is "" unless the
  # enclosing function is ALSO self-TCO'd, in which case the loop's per-iteration
  # root allocas are freed (stackrestore) before the jump.
  | IRTailCall String String (List String) String

export type IRBlock (..) = IRBlock String (List IROp)

# IRFunction <name> <params> <llvm-return-type> <blocks>
# params is List (String, IRType) — each entry is (param-name, kind).
# kind comes from the source-level type annotation: IRTScalar for known
# scalar params (Int/Bool/Char), IRTHeap for known heap params, IRTUnknown
# for unannotated or polymorphic positions.  The rooting pass seeds only
# IRTHeap params into the root pool; scalars pass through trigger ops
# without an IRRoot.  Closes BACKLOG.md:367.
#
# The return-type field is the LLVM type string ("i64" or "i1").  It is
# determined by the AST→IR translator from the function body's inferred type.
export type IRFunction (..) = IRFunction String (List (String, IRType)) String (List IRBlock)

# CtorReg carries the metadata emitted as @sprout_register_ctor calls in @main.
# Fields: name (source-level, possibly qualified), tag, arity, field_kinds.
# field_kinds encoding: 'i'=Int, 'b'=Bool, 's'=String/Char, 'p'=ADT/closure/tuple,
# '_'=type-var.  Matches codegen.sprout's ctor_field_kinds_string byte-for-byte.
# Every constructor (boxed and CPR-eligible) is registered so the runtime's
# find_ctor(tag) never returns NULL during GC tracing.
export type CtorReg (..) = CtorReg String Int Int String

# CtorInfo is the name-keyed constructor-table value (built by build_ctor_table,
# consumed all over ast_to_ir).  Replaces the former anonymous 4-tuple
# `(Int, Int, Int, String)` so the fields are self-documenting at every site.
# Fields: tag, arity, max_arity, field_kinds, field_names.
#   tag        — runtime constructor tag; -1 is the wrap sentinel (no allocation).
#   arity      — number of fields this constructor carries.
#   max_arity  — largest arity across the enclosing ADT (uniform-layout sizing).
#   field_kinds — per-field boxing encoding, same alphabet as CtorReg above.
#   field_names — comma-separated declaration-order field labels; "" for ADT
#                 constructors (positional).  Populated for records so codegen can
#                 map a literal's source-order fields and a `.field` access to the
#                 fixed declaration offset (docs/records-v0.md §10.6).
# Distinct from CtorReg: CtorReg is the runtime-registration output list and has
# no max_arity; this is the compile-time lookup table.  Kept separate on purpose.
export type CtorInfo (..) = CtorInfo Int Int Int String String

# IR-level top-level let global declaration (M3 PR 5).
#
# - GlobalConst <ir-literal> — emitted as `@name = private constant T <ir-literal>`.
#   The let body was const-eligible (TInt / TBool / TUnit literal).  No
#   init-function entry needed; LLVM places the constant directly.
# - GlobalZeroInit — emitted as `@name = global T zeroinitializer` in the
#   module header.  The runtime body is computed and stored at module-init
#   time via an IRStoreGlobal op inside the synthesized `__sprout_init_globals`
#   IRFunction.  GC-root registration is emitted at init time.
#
# Mirrors codegen.sprout's classify_let_decls + emit_global_decl_keys split.
export type GlobalInit (..) =
  | GlobalConst String
  | GlobalZeroInit

# IRGlobalDecl <name> <lltype> <init-form>
# `lltype` is the LLVM type string ("i64").  Currently always i64 because
# Sprout's value encoding is i64-uniform (Bool/Int/String/heap-ptr all i64).
export type IRGlobalDecl (..) = IRGlobalDecl String String GlobalInit

# IRProgram <functions> <globals> <ctor-registrations> <externs>
# - functions: user fns + any synthesized fns (e.g. __sprout_init_globals).
# - globals: top-level let declarations (PR 5).  Emitted to the module header
#   before any function.  ir_lowering uses this list to decide whether to
#   emit a `call void @__sprout_init_globals()` at the C-main entry.
# - ctor-registrations: consumed by ir_lowering.lower_program to emit
#   @sprout_register_ctor calls at the top of @main, before any user code runs.
# - externs: list of (name, arity) for user `extern fn` decls (PR 14).
#   Emitted as `declare i64 @<name>(i64, …)` in the module header.  Sprout's
#   i64-uniform encoding means we only need the arity.
export type IRProgram (..) = IRProgram(List IRFunction) (List IRGlobalDecl) (List CtorReg) (List (String, Int))

# ---------------------------------------------------------------------------
# Pretty printer (for diagnostics / tests).
# Renders each IROp as a single human-readable line; does NOT produce LLVM.

fn print_phi_pairs(pairs: List (String, String)) -> String =
  match pairs with
  | Nil -> ""
  | [p] ->
      match p with
      | (v, lbl) -> "[" ++ v ++ ", " ++ lbl ++ "]"
  | Cons p rest ->
      match p with
      | (v, lbl) -> "[" ++ v ++ ", " ++ lbl ++ "], " ++ print_phi_pairs(rest)

fn print_call_args(args: List String) -> String =
  match args with
  | Nil -> ""
  | [a] -> a
  | Cons a rest -> a ++ ", " ++ print_call_args(rest)

export fn print_ir_type(t: IRType) -> String =
  match t with
  | IRTHeap -> "heap"
  | IRTScalar -> "scalar"
  | IRTUnknown -> "unknown"

fn print_op(op: IROp) -> String =
  match op with
  | IRConst name n -> "    " ++ name ++ " = const " ++ int_to_string(n)
  | IRRet name -> "    ret " ++ name
  | IRRetVoid -> "    ret void"
  | IRIAdd r a b -> "    " ++ r ++ " = iadd " ++ a ++ ", " ++ b
  | IRISub r a b -> "    " ++ r ++ " = isub " ++ a ++ ", " ++ b
  | IRIMul r a b -> "    " ++ r ++ " = imul " ++ a ++ ", " ++ b
  | IRIDiv r a b -> "    " ++ r ++ " = idiv " ++ a ++ ", " ++ b
  | IRFloatConst r text -> "    " ++ r ++ " = fconst " ++ text
  | IRFAdd r a b -> "    " ++ r ++ " = fadd " ++ a ++ ", " ++ b
  | IRFSub r a b -> "    " ++ r ++ " = fsub " ++ a ++ ", " ++ b
  | IRFMul r a b -> "    " ++ r ++ " = fmul " ++ a ++ ", " ++ b
  | IRFDiv r a b -> "    " ++ r ++ " = fdiv " ++ a ++ ", " ++ b
  | IRFCmp r pred a b -> "    " ++ r ++ " = fcmp " ++ pred ++ " " ++ a ++ ", " ++ b
  | IRFNeg r a -> "    " ++ r ++ " = fneg " ++ a
  | IRSIToF r a -> "    " ++ r ++ " = sitofp " ++ a
  | IRBoolNot r a -> "    " ++ r ++ " = bnot " ++ a
  | IRINeg r a -> "    " ++ r ++ " = ineg " ++ a
  | IRLoadGlobal r name -> "    " ++ r ++ " = load_global @" ++ name
  | IRStoreGlobal name v -> "    store_global @" ++ name ++ ", " ++ v
  | IRRegisterGlobalRoot name -> "    register_global_root @" ++ name
  | IRMakeTuple r args -> "    " ++ r ++ " = make_tuple(" ++ print_call_args(args) ++ ")"
  | IRGetTupleField r t idx _ -> "    " ++ r ++ " = get_tuple_field " ++ t ++ ", " ++ int_to_string(idx)
  | IRICmp r pred a b -> "    " ++ r ++ " = icmp " ++ pred ++ " " ++ a ++ ", " ++ b
  | IRBr lbl -> "    br " ++ lbl
  | IRCondBr cond t e -> "    condbr " ++ cond ++ ", " ++ t ++ ", " ++ e
  | IRPhi r ty pairs -> "    " ++ r ++ " = phi " ++ ty ++ " " ++ print_phi_pairs(pairs)
  | IRCall r _kind fname args ->
      "    " ++ r ++ " = call i64 @" ++ fname ++ "(" ++ print_call_args(args) ++ ")"
  | IRCallUnboxed2 tag val _vk fname args ->
      "    (" ++ tag ++ ", " ++ val ++ ") = call_unboxed2 @" ++ fname ++ "(" ++ print_call_args(args) ++ ")"
  | IRRetUnboxed2 _base tag val ->
      "    ret_unboxed2 (" ++ tag ++ ", " ++ val ++ ")"
  | IRStrConst r raw s ->
      "    " ++ r ++ " = strconst (" ++ raw ++ ") \"" ++ s ++ "\""
  | IRStrSlice r s start len ->
      "    " ++ r ++ " = str_slice " ++ s ++ ", " ++ start ++ ", " ++ len
  | IRStrConcat r a b ->
      "    " ++ r ++ " = str_concat " ++ a ++ ", " ++ b
  | IRStrEq r a b ->
      "    " ++ r ++ " = str_eq " ++ a ++ ", " ++ b
  | IRStrCompare r pred a b ->
      "    " ++ r ++ " = str_compare[" ++ pred ++ "] " ++ a ++ ", " ++ b
  | IRPrintStr r callee arg ->
      "    " ++ r ++ " = " ++ callee ++ " " ++ arg
  | IRStrFromInt r n ->
      "    " ++ r ++ " = int_to_string " ++ n
  | IRMakeCtor r name tag args ->
      "    " ++ r ++ " = make_ctor " ++ name ++ "(tag=" ++ int_to_string(tag) ++ ")(" ++ print_call_args(args) ++ ")"
  | IRMkClosure r code_fn caps ->
      "    " ++ r ++ " = mk_closure " ++ code_fn ++ "(" ++ print_call_args(caps) ++ ")"
  | IRApplyClosure r callee args ->
      "    " ++ r ++ " = apply_closure " ++ callee ++ "(" ++ print_call_args(args) ++ ")"
  | IRLoadEnvSlot r env slot kind ->
      "    " ++ r ++ " = load_env_slot " ++ env ++ "[" ++ int_to_string(slot) ++ "](" ++ print_ir_type(kind) ++ ")"
  | IRRoot slot v discard ->
      "    " ++ discard ++ " = root " ++ slot ++ ", " ++ v
  | IRUnroot n discard ->
      "    " ++ discard ++ " = unroot " ++ int_to_string(n)
  | IRGetTag r s ->
      "    " ++ r ++ " = get_tag " ++ s
  | IRGetField r s i k ->
      "    " ++ r ++ " = get_field " ++ s ++ ", " ++ int_to_string(i) ++ " [" ++ print_ir_type(k) ++ "]"
  | IRVecLenD r v ->
      "    " ++ r ++ " = vec_len_d " ++ v
  | IRVecGetD r v i ->
      "    " ++ r ++ " = vec_get_d " ++ v ++ ", " ++ i
  | IRVecSetD r v i x ->
      "    " ++ r ++ " = vec_set_d " ++ v ++ ", " ++ i ++ ", " ++ x
  | IRAbortMatch ->
      "    abort_match; unreachable"
  | IRPanic msg ->
      "    panic(" ++ msg ++ "); unreachable"
  | IRZextI1ToI64 r s ->
      "    " ++ r ++ " = zext_i1_i64 " ++ s
  | IRTruncI64ToI1 r s ->
      "    " ++ r ++ " = trunc_i64_i1 " ++ s
  | IRTcoEntry _ sp ->
      "    tco_entry; sp=" ++ sp
  | IRTcoLoad loaded ll slot k ->
      "    " ++ loaded ++ " = tco_load " ++ slot ++ " : " ++ ll ++ " [" ++ print_ir_type(k) ++ "]"
  | IRTcoBack _ sp loop_lbl ->
      "    tco_back; sp=" ++ sp ++ " -> " ++ loop_lbl
  | IRTailCall result callee _args sp ->
      "    " ++ result ++ " = musttail " ++ callee ++ "; sp=" ++ sp

fn print_ops(ops: List IROp) -> String =
  match ops with
  | Nil -> ""
  | Cons op rest -> print_op(op) ++ "\n" ++ print_ops(rest)

fn print_block(b: IRBlock) -> String =
  match b with
  | IRBlock label ops -> "  " ++ label ++ ":\n" ++ print_ops(ops)

fn print_blocks(bs: List IRBlock) -> String =
  match bs with
  | Nil -> ""
  | Cons b rest -> print_block(b) ++ print_blocks(rest)

fn print_param_with_kind(p: (String, IRType)) -> String =
  match p with
  | (name, kind) -> name ++ ": " ++ print_ir_type(kind)

fn print_params(ps: List (String, IRType)) -> String =
  match ps with
  | Nil -> ""
  | [p] -> print_param_with_kind(p)
  | Cons p rest -> print_param_with_kind(p) ++ ", " ++ print_params(rest)

fn print_fn(f: IRFunction) -> String =
  match f with
  | IRFunction name params ret_ty blocks ->
      "fn " ++ name ++ "(" ++ print_params(params) ++ ") -> " ++ ret_ty ++ ":\n" ++ print_blocks(blocks)

fn print_fns(fs: List IRFunction) -> String =
  match fs with
  | Nil -> ""
  | Cons f rest -> print_fn(f) ++ print_fns(rest)

export fn print_ir_program(prog: IRProgram) -> String =
  match prog with
  | IRProgram fns _ _ _ ->
      match fns with
      | Nil -> "; sprout-ir: empty"
      | _ -> "; sprout-ir\n" ++ print_fns(fns)
