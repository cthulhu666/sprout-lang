module stdlib.compiler.deriving
import stdlib.compiler.ast as ast
import stdlib.compiler.source as source

# ---------------------------------------------------------------------------
# Codegen for `deriving (...)` clauses on TypeDecls.
#
# v1 scope: synthesize ast.InstanceDecl nodes for each (class, type) pair in
# a TypeDecl's deriving list. Implements Eq, ToString, and Ord for all ADT
# shapes (nullary and field-bearing). Serialize/Deserialize were explored and
# reverted on 2026-06-10; see docs/deriving-v1-draft.md "Scope revision" for why.
#
# Entry point is expand_deriving_decls, called by the bundler after
# qualification: it walks a list of decls, finds TypeDecls with non-empty
# deriving_classes, and appends synthesized InstanceDecls.
#
# Design ref: docs/deriving-v1-draft.md
# ---------------------------------------------------------------------------

# --- Side ADT ----------------------------------------------------------------
#
# Identifies WHICH side of a generated body a synthesized field binding belongs
# to. Eq compares two values so its bodies use both DLeft and DRight; ToString
# renders one value, so it uses DValue. Replacing the previous string
# identifiers ("l", "r", "v") with this ADT makes the set of legal sides
# explicit and turns typos into type errors.
type Side =
  | DLeft
  | DRight
  | DValue

fn side_prefix(side: Side) -> String =
  match side with
  | DLeft -> "l"
  | DRight -> "r"
  | DValue -> "v"

# --- Helpers -----------------------------------------------------------------

# Number of field positions in a constructor, e.g. `Node Int Tree Tree` -> 3.
# O(n).
fn ctor_arity(ctor: ast.TypeConstructor) -> Int =
  match ctor with
  | ast.TypeConstructor _ fields _ _ -> list_length(fields)

# Fresh-ish variable name for the i-th field of one side of an eq comparison.
# Prefix `__d_` keeps these distinct from any user-declared name.
# O(1).
fn deriv_field_name(side: Side, i: Int) -> String =
  "__d_" ++ side_prefix(side) ++ "_" ++ int_to_string(i)

# Build a pattern matching `ctor_name(__d_<side>_0, __d_<side>_1, ...)` with
# `arity` field-binding VarPatterns.
fn build_ctor_var_pattern(ctor_name: String, side: Side, arity: Int, pos: source.SourcePos) -> ast.Pattern =
  ast.ConstructorPattern(ctor_name, build_ctor_var_field_patterns(side, 0, arity, pos), pos)

fn build_ctor_var_field_patterns(side: Side, i: Int, arity: Int, pos: source.SourcePos) -> List ast.Pattern =
  if i >= arity then Nil
  else Cons(ast.VarPattern(deriv_field_name(side, i), pos),
            build_ctor_var_field_patterns(side, i + 1, arity, pos))

# Build a conjunction `eq(l0, r0) && eq(l1, r1) && ... && eq(lN, rN)`.
# For arity 0, returns `true`. For arity 1, returns the single eq call (no &&).
fn build_eq_conjunction(arity: Int, pos: source.SourcePos) -> ast.Expr =
  if arity == 0 then ast.BoolExpr(true, pos)
  else build_eq_conj_acc(1, arity, build_eq_field_call(0, pos), pos)

fn build_eq_conj_acc(i: Int, arity: Int, acc: ast.Expr, pos: source.SourcePos) -> ast.Expr =
  if i >= arity then acc
  else build_eq_conj_acc(i + 1, arity, ast.BinaryExpr("&&", acc, build_eq_field_call(i, pos), pos), pos)

# `eq(__d_l_i, __d_r_i)` — calls the typeclass eq method on the i-th field pair.
fn build_eq_field_call(i: Int, pos: source.SourcePos) -> ast.Expr =
  ast.CallExpr(
    ast.VarExpr("eq", pos),
    [ast.VarExpr(deriv_field_name(DLeft, i), pos),
     ast.VarExpr(deriv_field_name(DRight, i), pos)],
    pos)

# --- Eq emitter --------------------------------------------------------------

# Build one match branch for a single same-ctor case:
#   (Ctor l0 l1 ..., Ctor r0 r1 ...) -> eq(l0, r0) && eq(l1, r1) && ...
fn build_eq_same_ctor_branch(ctor: ast.TypeConstructor, pos: source.SourcePos) -> ast.MatchBranch =
  match ctor with
  | ast.TypeConstructor name _ _ _ ->
      ast.MatchBranch(
        ast.TuplePattern(
          [build_ctor_var_pattern(name, DLeft, ctor_arity(ctor), pos),
           build_ctor_var_pattern(name, DRight, ctor_arity(ctor), pos)],
          pos),
        build_eq_conjunction(ctor_arity(ctor), pos))

fn build_eq_same_ctor_branches(ctors: List ast.TypeConstructor, pos: source.SourcePos) -> List ast.MatchBranch =
  match ctors with
  | Nil -> Nil
  | Cons c rest -> Cons(build_eq_same_ctor_branch(c, pos), build_eq_same_ctor_branches(rest, pos))

# The wildcard fall-through arm: any (Ctor_i, Ctor_j) pair with i != j -> false.
fn eq_fallthrough_branch(pos: source.SourcePos) -> ast.MatchBranch =
  ast.MatchBranch(ast.WildcardPattern(pos), ast.BoolExpr(false, pos))

# Build the match expression body: `match (left, right) with | (C0 ..., C0 ...) -> ... | _ -> false`.
# O(n_ctors) — list_append walks the same-ctor branch list once to append the fallthrough.
fn build_eq_match_body(ctors: List ast.TypeConstructor, pos: source.SourcePos) -> ast.Expr =
  ast.MatchExpr(
    ast.TupleExpr(
      [ast.VarExpr("left", pos), ast.VarExpr("right", pos)],
      pos),
    list_append(
      build_eq_same_ctor_branches(ctors, pos),
      [eq_fallthrough_branch(pos)]),
    pos)

# Build a TypeExpr representing the instance head: TypeName(name) for a
# non-parametric type, or TypeApply(...) for `Maybe a`-style parametric types.
fn instance_head_typeexpr(name: String, type_params: List String) -> ast.TypeExpr =
  match type_params with
  | Nil -> ast.TypeName(name)
  | _ -> apply_type_params(ast.TypeName(name), type_params)

fn apply_type_params(base: ast.TypeExpr, params: List String) -> ast.TypeExpr =
  match params with
  | Nil -> base
  | Cons p rest -> apply_type_params(ast.TypeApply(base, ast.TypeName(p)), rest)

# For each type parameter referenced in any field, emit `Eq <param>` as an
# instance constraint. Conservative: just emits one constraint per type
# parameter (Haskell's StandaloneDeriving with all params constrained).
# A fancier implementation would walk fields to detect used vs. phantom params.
fn instance_constraints_for(class_name: String, type_params: List String) -> List ast.TypeConstraint =
  match type_params with
  | Nil -> Nil
  | Cons p rest ->
      Cons(ast.TypeConstraint(class_name, [ast.TypeName(p)]),
           instance_constraints_for(class_name, rest))

# Emit `instance Eq <T> [where Eq a, ...] { fn eq(left, right) -> Bool = ... }`.
# Returns the InstanceDecl as an ast.Decl (since InstanceDecl is a constructor
# of ast.Decl, not a separate type).
fn emit_eq_instance(name: String, type_params: List String, ctors: List ast.TypeConstructor, pos: source.SourcePos) -> ast.Decl =
  ast.InstanceDecl(
    ast.TypeConstraint("Eq", [instance_head_typeexpr(name, type_params)]),
    instance_constraints_for("Eq", type_params),
    [ast.InstanceMethodImpl(
       "eq",
       [ast.Param("left", Just(instance_head_typeexpr(name, type_params)), ast.ModeDefault),
        ast.Param("right", Just(instance_head_typeexpr(name, type_params)), ast.ModeDefault)],
       Just(ast.TypeName("Bool")),
       Nothing,
       build_eq_match_body(ctors, pos))],
    pos)

# --- ToString emitter --------------------------------------------------------

# Build the to_string body string for one ctor. For nullary ctors, returns
# just the ctor name. For N-field ctors, returns
# "Ctor(" ++ to_string(__d_v_0) ++ ", " ++ to_string(__d_v_1) ++ ", " ++ ... ++ ")".
#
# This runs on QUALIFIED decls (`bundler.make_bundle_or_err` expands deriving
# after qualification), so the name arrives as `main.Box` — or `$entry.Box` for a
# headerless entry file. It is unqualified HERE, and only here, because this is
# the one place the name becomes a string LITERAL — the program's own output, not
# a symbol. The sibling `build_ctor_var_pattern` keeps the qualified name, which
# it must: that is the pattern that has to match the constructor.
#
# The runtime's display path (the C `display_ctor_name`) cannot help with this
# one: a derived `to_string` returns a String the program may never print, so
# there is no render for the runtime to intercept. The two carry the same rule,
# and that duplication is load-bearing: the fixture
# `tests/conformance/run/ctor_display_unqualified.spr` exercises both paths in
# one program so they cannot drift apart.
fn build_to_string_branch_body(ctor_name: String, arity: Int, pos: source.SourcePos) -> ast.Expr =
  if arity == 0 then ast.StringExpr(display, pos)
  else build_to_string_concat_chain(display, arity, pos)
  where display = source.display_ctor_name(ctor_name)

# Constructs the string-concat chain for a multi-field ctor body.
fn build_to_string_concat_chain(ctor_name: String, arity: Int, pos: source.SourcePos) -> ast.Expr =
  ast.BinaryExpr("++",
    ast.BinaryExpr("++",
      ast.StringExpr(ctor_name ++ "(", pos),
      build_to_string_field_args(0, arity, pos),
      pos),
    ast.StringExpr(")", pos),
    pos)

# Build the to_string-of-each-field chain joined by ", ".
fn build_to_string_field_args(i: Int, arity: Int, pos: source.SourcePos) -> ast.Expr =
  if i >= arity - 1 then build_to_string_field_call(i, pos)
  else ast.BinaryExpr("++",
    ast.BinaryExpr("++",
      build_to_string_field_call(i, pos),
      ast.StringExpr(", ", pos),
      pos),
    build_to_string_field_args(i + 1, arity, pos),
    pos)

fn build_to_string_field_call(i: Int, pos: source.SourcePos) -> ast.Expr =
  ast.CallExpr(
    ast.VarExpr("to_string", pos),
    [ast.VarExpr(deriv_field_name(DValue, i), pos)],
    pos)

# Build one match branch: `| Ctor(f0, f1, ...) -> "Ctor(...)"`.
fn build_to_string_ctor_branch(ctor: ast.TypeConstructor, pos: source.SourcePos) -> ast.MatchBranch =
  match ctor with
  | ast.TypeConstructor name _ _ _ ->
      ast.MatchBranch(
        build_ctor_var_pattern(name, DValue, ctor_arity(ctor), pos),
        build_to_string_branch_body(name, ctor_arity(ctor), pos))

fn build_to_string_ctor_branches(ctors: List ast.TypeConstructor, pos: source.SourcePos) -> List ast.MatchBranch =
  match ctors with
  | Nil -> Nil
  | Cons c rest -> Cons(build_to_string_ctor_branch(c, pos), build_to_string_ctor_branches(rest, pos))

fn build_to_string_match_body(ctors: List ast.TypeConstructor, pos: source.SourcePos) -> ast.Expr =
  ast.MatchExpr(
    ast.VarExpr("value", pos),
    build_to_string_ctor_branches(ctors, pos),
    pos)

fn emit_to_string_instance(name: String, type_params: List String, ctors: List ast.TypeConstructor, pos: source.SourcePos) -> ast.Decl =
  ast.InstanceDecl(
    ast.TypeConstraint("ToString", [instance_head_typeexpr(name, type_params)]),
    instance_constraints_for("ToString", type_params),
    [ast.InstanceMethodImpl(
       "to_string",
       [ast.Param("value", Just(instance_head_typeexpr(name, type_params)), ast.ModeDefault)],
       Just(ast.TypeName("String")),
       Nothing,
       build_to_string_match_body(ctors, pos))],
    pos)

# --- Ord emitter (all ADT shapes: nullary and field-bearing) -----------------

# Build `compare(__d_l_i, __d_r_i)` — one field-pair compare call.
# O(1).
fn build_ord_field_compare_call(i: Int, pos: source.SourcePos) -> ast.Expr =
  ast.CallExpr(
    ast.VarExpr("compare", pos),
    [ast.VarExpr(deriv_field_name(DLeft, i), pos),
     ast.VarExpr(deriv_field_name(DRight, i), pos)],
    pos)

# Build the lexicographic chained compare body for a same-constructor branch.
# Arity 0 → `0`. Arity 1 → `compare(l0, r0)`.
# Arity N → `match compare(l0, r0) with | 0 -> <recurse(1)> | c -> c`.
# Uses a fresh synthetic variable `__d_c_i` for the wildcard bind at each level.
# O(arity).
fn build_ord_compare_chain(i: Int, arity: Int, pos: source.SourcePos) -> ast.Expr =
  if i >= arity then ast.IntExpr(0, pos)
  else if i == arity - 1 then build_ord_field_compare_call(i, pos)
  else
    ast.MatchExpr(
      build_ord_field_compare_call(i, pos),
      [ast.MatchBranch(ast.IntPattern(0, pos), build_ord_compare_chain(i + 1, arity, pos)),
       ast.MatchBranch(ast.VarPattern("__d_c_" ++ int_to_string(i), pos),
                       ast.VarExpr("__d_c_" ++ int_to_string(i), pos))],
      pos)

# Body for the same-constructor case: chain compare over all field pairs.
# O(arity).
fn build_ord_same_ctor_body(arity: Int, pos: source.SourcePos) -> ast.Expr =
  build_ord_compare_chain(0, arity, pos)

# Build a wildcard-binding constructor pattern for the inner match (different-ctor
# branches don't need field values; wildcards avoid introducing unused names).
# O(arity).
fn build_ctor_wildcard_pattern(ctor_name: String, arity: Int, pos: source.SourcePos) -> ast.Pattern =
  ast.ConstructorPattern(ctor_name, build_wildcard_field_patterns(0, arity, pos), pos)

fn build_wildcard_field_patterns(i: Int, arity: Int, pos: source.SourcePos) -> List ast.Pattern =
  if i >= arity then Nil
  else Cons(ast.WildcardPattern(pos), build_wildcard_field_patterns(i + 1, arity, pos))

# One inner-match branch: `| Ctor_j(...) -> result`.
# When idx == outer_idx: bind right-side fields and return chained compare.
# When idx < outer_idx: right ctor declared earlier than left → left is greater → 1.
# When idx > outer_idx: right ctor declared later than left → left is smaller → -1.
fn build_ord_inner_branch(c: ast.TypeConstructor, idx: Int, outer_idx: Int, pos: source.SourcePos) -> ast.MatchBranch =
  match c with
  | ast.TypeConstructor name fields _ _ ->
      if idx == outer_idx then
        ast.MatchBranch(
          build_ctor_var_pattern(name, DRight, list_length(fields), pos),
          build_ord_same_ctor_body(list_length(fields), pos))
      else
        ast.MatchBranch(
          build_ctor_wildcard_pattern(name, list_length(fields), pos),
          ast.IntExpr(if idx < outer_idx then 1 else 0 - 1, pos))

fn build_ord_inner_branches(remaining: List ast.TypeConstructor, idx: Int, outer_idx: Int, pos: source.SourcePos) -> List ast.MatchBranch =
  match remaining with
  | Nil -> Nil
  | Cons c rest ->
      Cons(build_ord_inner_branch(c, idx, outer_idx, pos),
           build_ord_inner_branches(rest, idx + 1, outer_idx, pos))

fn build_ord_inner_match(outer_idx: Int, all_ctors: List ast.TypeConstructor, pos: source.SourcePos) -> ast.Expr =
  ast.MatchExpr(
    ast.VarExpr("right", pos),
    build_ord_inner_branches(all_ctors, 0, outer_idx, pos),
    pos)

# Outer branch binds left-side fields for same-ctor comparison.
# O(arity).
fn build_ord_outer_branch(c: ast.TypeConstructor, idx: Int, all_ctors: List ast.TypeConstructor, pos: source.SourcePos) -> ast.MatchBranch =
  match c with
  | ast.TypeConstructor name fields _ _ ->
      ast.MatchBranch(
        build_ctor_var_pattern(name, DLeft, list_length(fields), pos),
        build_ord_inner_match(idx, all_ctors, pos))

fn build_ord_outer_branches(remaining: List ast.TypeConstructor, idx: Int, all_ctors: List ast.TypeConstructor, pos: source.SourcePos) -> List ast.MatchBranch =
  match remaining with
  | Nil -> Nil
  | Cons c rest ->
      Cons(build_ord_outer_branch(c, idx, all_ctors, pos),
           build_ord_outer_branches(rest, idx + 1, all_ctors, pos))

fn build_ord_match_body(ctors: List ast.TypeConstructor, pos: source.SourcePos) -> ast.Expr =
  ast.MatchExpr(
    ast.VarExpr("left", pos),
    build_ord_outer_branches(ctors, 0, ctors, pos),
    pos)

fn emit_ord_instance(name: String, type_params: List String, ctors: List ast.TypeConstructor, pos: source.SourcePos) -> ast.Decl =
  ast.InstanceDecl(
    ast.TypeConstraint("Ord", [instance_head_typeexpr(name, type_params)]),
    instance_constraints_for("Ord", type_params),
    [ast.InstanceMethodImpl(
       "compare",
       [ast.Param("left", Just(instance_head_typeexpr(name, type_params)), ast.ModeDefault),
        ast.Param("right", Just(instance_head_typeexpr(name, type_params)), ast.ModeDefault)],
       Just(ast.TypeName("Int")),
       Nothing,
       build_ord_match_body(ctors, pos))],
    pos)

# --- Enum emitter (nullary-only ADTs) ----------------------------------------
#
# Unlike Eq/Ord/ToString, which only DESTRUCTURE values, Enum also CONSTRUCTS
# them: `from_ordinal` rebuilds a constructor from its ordinal. That is only
# well-defined when every constructor is nullary (a field-bearing variant cannot
# be rebuilt from an Int alone) — validate_one_deriving_class rejects the rest
# up-front, so both emitter bodies below may assume nullary constructors.
#
#   ordinal(v)      = match v with | C0 -> 0 | C1 -> 1 | ...
#   from_ordinal(n) = if n == 0 then Just(C0) else if n == 1 then Just(C1)
#                     else ... else Nothing
#
# Ordinals are the constructors' declaration-order index (0-based), matching the
# runtime tag the codegen already assigns.

# One `| Ci -> i` branch per constructor, numbered in declaration order.
fn build_ordinal_branches(ctors: List ast.TypeConstructor, idx: Int, pos: source.SourcePos) -> List ast.MatchBranch =
  match ctors with
  | Nil -> Nil
  | Cons c rest ->
      match c with
      | ast.TypeConstructor name _ _ _ ->
          Cons(ast.MatchBranch(ast.ConstructorPattern(name, Nil, pos), ast.IntExpr(idx, pos)),
               build_ordinal_branches(rest, idx + 1, pos))

fn build_ordinal_body(ctors: List ast.TypeConstructor, pos: source.SourcePos) -> ast.Expr =
  ast.MatchExpr(ast.VarExpr("v", pos), build_ordinal_branches(ctors, 0, pos), pos)

# `if n == i then Just(Ci) else <recurse>`, terminating in `Nothing` once the
# constructor list is exhausted (the out-of-range case).
fn build_from_ordinal_ladder(ctors: List ast.TypeConstructor, idx: Int, pos: source.SourcePos) -> ast.Expr =
  match ctors with
  | Nil -> ast.VarExpr("Nothing", pos)
  | Cons c rest ->
      match c with
      | ast.TypeConstructor name _ _ _ ->
          ast.IfExpr(
            ast.BinaryExpr("==", ast.VarExpr("n", pos), ast.IntExpr(idx, pos), pos),
            ast.CallExpr(ast.VarExpr("Just", pos), [ast.VarExpr(name, pos)], pos),
            build_from_ordinal_ladder(rest, idx + 1, pos),
            pos)

# `Maybe <head>` return type for from_ordinal.
fn maybe_of(head: ast.TypeExpr) -> ast.TypeExpr =
  ast.TypeApply(ast.TypeName("Maybe"), head)

# Emit `instance Enum <T> { fn ordinal(v) -> Int = ...  fn from_ordinal(n) -> Maybe T = ... }`.
# No per-parameter constraints are emitted: an Enum-derivable type is nullary, so
# any type parameter is necessarily phantom (no field can mention it).
fn emit_enum_instance(name: String, type_params: List String, ctors: List ast.TypeConstructor, pos: source.SourcePos) -> ast.Decl =
  ast.InstanceDecl(
    ast.TypeConstraint("Enum", [instance_head_typeexpr(name, type_params)]),
    Nil,
    [ast.InstanceMethodImpl(
       "ordinal",
       [ast.Param("v", Just(instance_head_typeexpr(name, type_params)), ast.ModeDefault)],
       Just(ast.TypeName("Int")),
       Nothing,
       build_ordinal_body(ctors, pos)),
     ast.InstanceMethodImpl(
       "from_ordinal",
       [ast.Param("n", Just(ast.TypeName("Int")), ast.ModeDefault)],
       Just(maybe_of(instance_head_typeexpr(name, type_params))),
       Nothing,
       build_from_ordinal_ladder(ctors, 0, pos))],
    pos)

# --- DerivableClass ADT + dispatch ------------------------------------------
#
# Models the closed set of v1-derivable classes. Parsing the user-supplied
# class name into this ADT once (parse_derivable_class) and dispatching on it
# replaces a long if-else chain on strings, making the supported set explicit
# and turning "unknown class" into a single Nothing case at parse time.
type DerivableClass =
  | DcEq
  | DcOrd
  | DcToString
  | DcEnum

# Parse a class name as it appeared in the user's `deriving (...)` clause.
# Returns Nothing for class names not supported in v1 (the validation pass
# below turns this into a user-facing error at the deriving site).
fn parse_derivable_class(name: String) -> Maybe DerivableClass =
  if name == "Eq" then Just(DcEq)
  else if name == "Ord" then Just(DcOrd)
  else if name == "ToString" then Just(DcToString)
  else if name == "Enum" then Just(DcEnum)
  else Nothing

# Given a parsed class and TypeDecl fields, synthesize the corresponding
# InstanceDecl. Ord now supports all ADT shapes (nullary and field-bearing)
# via lexicographic chained compare.
fn derive_instance_for(dc: DerivableClass, name: String, type_params: List String, ctors: List ast.TypeConstructor, pos: source.SourcePos) -> Maybe ast.Decl =
  match dc with
  | DcEq -> Just(emit_eq_instance(name, type_params, ctors, pos))
  | DcToString -> Just(emit_to_string_instance(name, type_params, ctors, pos))
  | DcOrd -> Just(emit_ord_instance(name, type_params, ctors, pos))
  | DcEnum -> Just(emit_enum_instance(name, type_params, ctors, pos))

# Bridge from the string class name (as it appears in the source `deriving`
# clause) to the typed dispatch. Returns Nothing only if the class isn't
# derivable (validated up-front by validate_deriving_decls).
fn derive_instance(class_name: String, name: String, type_params: List String, ctors: List ast.TypeConstructor, pos: source.SourcePos) -> Maybe ast.Decl =
  match parse_derivable_class(class_name) with
  | Nothing -> Nothing
  | Just dc -> derive_instance_for(dc, name, type_params, ctors, pos)

fn derive_instances_for_classes(name: String, type_params: List String, ctors: List ast.TypeConstructor, pos: source.SourcePos, classes: List String) -> List ast.Decl =
  match classes with
  | Nil -> Nil
  | Cons class_name rest ->
      match derive_instance(class_name, name, type_params, ctors, pos) with
      | Nothing -> derive_instances_for_classes(name, type_params, ctors, pos, rest)
      | Just inst -> Cons(inst, derive_instances_for_classes(name, type_params, ctors, pos, rest))

# --- Record emitters ---------------------------------------------------------
#
# A record is a single product: no sum, no tag, no constructor to match on. So
# these bodies are the ADT same-constructor logic standalone, reading each field
# by NAME via GetFieldExpr (`value.field`) rather than binding positional
# pattern variables. Eq/Ord fold over the fields in declaration order; ToString
# renders `Name(f0 = v0, f1 = v1, ...)`, mirroring record construction syntax.
# The instance scaffolding (head, per-type-param constraints) is shared with the
# ADT path via instance_head_typeexpr / instance_constraints_for.

fn record_field_name(f: ast.RecordFieldDecl) -> String =
  match f with
  | ast.RecordFieldDecl fname _ -> fname

# `<param>.<field>` — read one field off a named parameter (left/right/value).
fn record_field_get(param: String, fname: String, pos: source.SourcePos) -> ast.Expr =
  ast.GetFieldExpr(ast.VarExpr(param, pos), fname, pos)

# --- Record Eq: `eq(left.f0, right.f0) && ...`, `true` when field-less. --------

fn record_field_eq_call(fname: String, pos: source.SourcePos) -> ast.Expr =
  ast.CallExpr(ast.VarExpr("eq", pos),
    [record_field_get("left", fname, pos), record_field_get("right", fname, pos)], pos)

fn build_record_eq_body(fields: List ast.RecordFieldDecl, pos: source.SourcePos) -> ast.Expr =
  match fields with
  | Nil -> ast.BoolExpr(true, pos)
  | Cons f rest -> build_record_eq_acc(rest, record_field_eq_call(record_field_name(f), pos), pos)

fn build_record_eq_acc(fields: List ast.RecordFieldDecl, acc: ast.Expr, pos: source.SourcePos) -> ast.Expr =
  match fields with
  | Nil -> acc
  | Cons f rest ->
      build_record_eq_acc(rest,
        ast.BinaryExpr("&&", acc, record_field_eq_call(record_field_name(f), pos), pos), pos)

fn emit_record_eq_instance(name: String, type_params: List String, fields: List ast.RecordFieldDecl, pos: source.SourcePos) -> ast.Decl =
  ast.InstanceDecl(
    ast.TypeConstraint("Eq", [instance_head_typeexpr(name, type_params)]),
    instance_constraints_for("Eq", type_params),
    [ast.InstanceMethodImpl(
       "eq",
       [ast.Param("left", Just(instance_head_typeexpr(name, type_params)), ast.ModeDefault),
        ast.Param("right", Just(instance_head_typeexpr(name, type_params)), ast.ModeDefault)],
       Just(ast.TypeName("Bool")),
       Nothing,
       build_record_eq_body(fields, pos))],
    pos)

# --- Record ToString: `"Name(" ++ "f0 = " ++ to_string(value.f0) ++ ", " ...` --

# `"fname = " ++ to_string(value.fname)` for one field.
fn record_field_to_string_part(fname: String, pos: source.SourcePos) -> ast.Expr =
  ast.BinaryExpr("++",
    ast.StringExpr(fname ++ " = ", pos),
    ast.CallExpr(ast.VarExpr("to_string", pos), [record_field_get("value", fname, pos)], pos),
    pos)

fn build_record_to_string_fields(fields: List ast.RecordFieldDecl, pos: source.SourcePos) -> ast.Expr =
  match fields with
  | Nil -> ast.StringExpr("", pos)
  | Cons f rest -> build_record_to_string_acc(rest, record_field_to_string_part(record_field_name(f), pos), pos)

fn build_record_to_string_acc(fields: List ast.RecordFieldDecl, acc: ast.Expr, pos: source.SourcePos) -> ast.Expr =
  match fields with
  | Nil -> acc
  | Cons f rest ->
      build_record_to_string_acc(rest,
        ast.BinaryExpr("++", acc,
          ast.BinaryExpr("++", ast.StringExpr(", ", pos),
            record_field_to_string_part(record_field_name(f), pos), pos), pos), pos)

# The record counterpart of build_to_string_branch_body — same reason to
# unqualify, same restriction to the string LITERAL. `instance_head_typeexpr` next
# door still receives the qualified name, because that one names a type.
fn build_record_to_string_body(name: String, fields: List ast.RecordFieldDecl, pos: source.SourcePos) -> ast.Expr =
  ast.BinaryExpr("++",
    ast.BinaryExpr("++", ast.StringExpr(source.display_ctor_name(name) ++ "(", pos),
      build_record_to_string_fields(fields, pos), pos),
    ast.StringExpr(")", pos),
    pos)

fn emit_record_to_string_instance(name: String, type_params: List String, fields: List ast.RecordFieldDecl, pos: source.SourcePos) -> ast.Decl =
  ast.InstanceDecl(
    ast.TypeConstraint("ToString", [instance_head_typeexpr(name, type_params)]),
    instance_constraints_for("ToString", type_params),
    [ast.InstanceMethodImpl(
       "to_string",
       [ast.Param("value", Just(instance_head_typeexpr(name, type_params)), ast.ModeDefault)],
       Just(ast.TypeName("String")),
       Nothing,
       build_record_to_string_body(name, fields, pos))],
    pos)

# --- Record Ord: lexicographic per-field `compare` (Int), `0` when field-less. -

fn record_field_compare_call(fname: String, pos: source.SourcePos) -> ast.Expr =
  ast.CallExpr(ast.VarExpr("compare", pos),
    [record_field_get("left", fname, pos), record_field_get("right", fname, pos)], pos)

# `match compare(left.f0, right.f0) with | 0 -> <rest> | c -> c`; the final field
# is a bare compare; no fields → `0`. A fresh `__d_c_i` binds each tie level.
fn build_record_ord_chain(fields: List ast.RecordFieldDecl, i: Int, pos: source.SourcePos) -> ast.Expr =
  match fields with
  | Nil -> ast.IntExpr(0, pos)
  | Cons f rest ->
      match rest with
      | Nil -> record_field_compare_call(record_field_name(f), pos)
      | _ ->
          ast.MatchExpr(
            record_field_compare_call(record_field_name(f), pos),
            [ast.MatchBranch(ast.IntPattern(0, pos), build_record_ord_chain(rest, i + 1, pos)),
             ast.MatchBranch(ast.VarPattern("__d_c_" ++ int_to_string(i), pos),
                             ast.VarExpr("__d_c_" ++ int_to_string(i), pos))],
            pos)

fn emit_record_ord_instance(name: String, type_params: List String, fields: List ast.RecordFieldDecl, pos: source.SourcePos) -> ast.Decl =
  ast.InstanceDecl(
    ast.TypeConstraint("Ord", [instance_head_typeexpr(name, type_params)]),
    instance_constraints_for("Ord", type_params),
    [ast.InstanceMethodImpl(
       "compare",
       [ast.Param("left", Just(instance_head_typeexpr(name, type_params)), ast.ModeDefault),
        ast.Param("right", Just(instance_head_typeexpr(name, type_params)), ast.ModeDefault)],
       Just(ast.TypeName("Int")),
       Nothing,
       build_record_ord_chain(fields, 0, pos))],
    pos)

# Dispatch a parsed class to its record emitter. DcEnum yields Nothing: a record
# is a single product, never an enumeration (validate_one_record_deriving_class
# rejects it eagerly up-front, so this arm is defensive only).
fn derive_record_instance_for(dc: DerivableClass, name: String, type_params: List String, fields: List ast.RecordFieldDecl, pos: source.SourcePos) -> Maybe ast.Decl =
  match dc with
  | DcEq -> Just(emit_record_eq_instance(name, type_params, fields, pos))
  | DcToString -> Just(emit_record_to_string_instance(name, type_params, fields, pos))
  | DcOrd -> Just(emit_record_ord_instance(name, type_params, fields, pos))
  | DcEnum -> Nothing

fn derive_record_instance(class_name: String, name: String, type_params: List String, fields: List ast.RecordFieldDecl, pos: source.SourcePos) -> Maybe ast.Decl =
  match parse_derivable_class(class_name) with
  | Nothing -> Nothing
  | Just dc -> derive_record_instance_for(dc, name, type_params, fields, pos)

fn derive_record_instances_for_classes(name: String, type_params: List String, fields: List ast.RecordFieldDecl, pos: source.SourcePos, classes: List String) -> List ast.Decl =
  match classes with
  | Nil -> Nil
  | Cons class_name rest ->
      match derive_record_instance(class_name, name, type_params, fields, pos) with
      | Nothing -> derive_record_instances_for_classes(name, type_params, fields, pos, rest)
      | Just inst -> Cons(inst, derive_record_instances_for_classes(name, type_params, fields, pos, rest))

# --- Top-level expansion -----------------------------------------------------

# Walk a list of program decls. For each TypeDecl/RecordDecl with a non-empty
# deriving list, append synthesized InstanceDecls AFTER the decl. Declaration
# order matters: instance lookup walks the env, and the synthesized instance
# body references the type's fields/constructors that the decl just registered.
export fn expand_deriving_decls(decls: List ast.Decl) -> List ast.Decl =
  match decls with
  | Nil -> Nil
  | Cons d rest ->
      match d with
      | ast.TypeDecl name type_params ctors deriving_classes _ pos ->
          match deriving_classes with
          | Nil -> Cons(d, expand_deriving_decls(rest))
          | _ -> Cons(d, list_append(
                          derive_instances_for_classes(name, type_params, ctors, pos, deriving_classes),
                          expand_deriving_decls(rest)))
      | ast.RecordDecl name type_params fields deriving_classes _ pos ->
          match deriving_classes with
          | Nil -> Cons(d, expand_deriving_decls(rest))
          | _ -> Cons(d, list_append(
                          derive_record_instances_for_classes(name, type_params, fields, pos, deriving_classes),
                          expand_deriving_decls(rest)))
      | _ -> Cons(d, expand_deriving_decls(rest))

# --- Validation pass --------------------------------------------------------
#
# Walks the program decls and checks that every `deriving (...)` clause is
# valid for the type it appears on. Returns Nothing if all clauses pass; Just
# msg describing the first failure otherwise. Run BEFORE expand_deriving_decls
# in the bundler so the user gets an eager error at the deriving site rather
# than a confusing "no instance" error at the use site.
#
# Closes the F1 follow-up from the v1 design doc.

export fn validate_deriving_decls(decls: List ast.Decl) -> Maybe(source.SourcePos, String) =
  match decls with
  | Nil -> Nothing
  | Cons d rest ->
      match validate_one_deriving_decl(d) with
      | Just err -> Just((ast.decl_pos(d), err))
      | Nothing -> validate_deriving_decls(rest)

fn validate_one_deriving_decl(d: ast.Decl) -> Maybe String =
  match d with
  | ast.TypeDecl name _ ctors deriving_classes _ _ ->
      validate_deriving_classes_list(name, ctors, deriving_classes)
  | ast.RecordDecl name _ _ deriving_classes _ _ ->
      validate_record_deriving_classes_list(name, deriving_classes)
  | _ -> Nothing

# Records derive Eq/Ord/ToString only; Enum is ill-defined (a record is one
# product, not an enumeration). Unknown classes are rejected as for ADTs.
fn validate_record_deriving_classes_list(name: String, classes: List String) -> Maybe String =
  match classes with
  | Nil -> Nothing
  | Cons class_name rest ->
      match validate_one_record_deriving_class(name, class_name) with
      | Just err -> Just(err)
      | Nothing -> validate_record_deriving_classes_list(name, rest)

fn validate_one_record_deriving_class(name: String, class_name: String) -> Maybe String =
  match parse_derivable_class(class_name) with
  | Nothing ->
      Just("unknown class in deriving clause for `" ++ name ++ "`: `" ++ class_name ++ "` (v1 supports Eq, Ord, ToString, Enum)")
  | Just DcEnum ->
      Just("cannot derive `Enum` for `" ++ name ++ "`: a record is a single product, not an enumeration; Enum requires an ADT whose constructors are all nullary")
  | Just _ -> Nothing

fn validate_deriving_classes_list(name: String, ctors: List ast.TypeConstructor, classes: List String) -> Maybe String =
  match classes with
  | Nil -> Nothing
  | Cons class_name rest ->
      match validate_one_deriving_class(name, ctors, class_name) with
      | Just err -> Just(err)
      | Nothing -> validate_deriving_classes_list(name, ctors, rest)

# Name of the first constructor carrying fields, if any — the offending ctor for
# an Enum derivation, which requires every constructor to be nullary.
fn first_field_bearing_ctor(ctors: List ast.TypeConstructor) -> Maybe String =
  match ctors with
  | Nil -> Nothing
  | Cons c rest ->
      match c with
      | ast.TypeConstructor cname _ _ _ ->
          if ctor_arity(c) > 0 then Just(cname)
          else first_field_bearing_ctor(rest)

fn validate_one_deriving_class(name: String, ctors: List ast.TypeConstructor, class_name: String) -> Maybe String =
  match parse_derivable_class(class_name) with
  | Nothing ->
      Just("unknown class in deriving clause for `" ++ name ++ "`: `" ++ class_name ++ "` (v1 supports Eq, Ord, ToString, Enum)")
  | Just DcEnum ->
      match first_field_bearing_ctor(ctors) with
      | Just cname ->
          Just("cannot derive `Enum` for `" ++ name ++ "`: constructor `" ++ cname ++ "` has fields; Enum requires all constructors to be nullary")
      | Nothing -> Nothing
  | Just _ -> Nothing
