module stdlib.compiler.scalar_copies
import stdlib.compiler.ast as ast
import stdlib.compiler.infer as infer
import stdlib.compiler.source as source
import stdlib.compiler.spec_keys as spec_keys
import stdlib.compiler.type_kind as type_kind
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types
import stdlib.compiler.verify_dispatch as verify_dispatch
import stdlib.string as string

# Scalar copies (docs/pointer-free-vectors-v0.md §4.3): copies each generic function that a
# vector-creating type variable instantiated at a scalar needs, once per scalar, and retargets
# the calls and references that name it. Runs on the RESOLVED program, before lowering.
#
# A CANDIDATE is a top-level function with no constraints and a written type on every parameter
# and on the result. A node type names a signature variable through an `@eta_fwdvar` marker, so
# only a candidate's own variables can be named; an unannotated or constrained function is opaque.
#
# A variable of candidate `f` is CREATING when `f`'s body calls a creating extern (`vector_empty`,
# `vector_from_list`, `vec_make_filled`) at `Vector a`, or calls or references a candidate whose
# creating variable is instantiated at `a`. Only a bare variable counts: an element of `List a`
# or `Vec a` is a pointer whatever `a` is. A KEY is a candidate with a non-heap scalar for each
# of its creating variables, in signature order.
#
# Instantiation matches a callee's written signature against a node's types by whole-type
# equality (`bind_te`), not `verify_dispatch.match_te`: that one compares heads only, and
# rejects a written variable that meets the same inference variable twice, which is every
# instantiation at an enclosing function's own variable.
#
# Keys are finite (candidates x four scalars per creating variable). A call at a larger type,
# such as a polymorphic self-call at `Vec a`, is no scalar instantiation and makes no key, so
# the worklist needs no growth guard.
#
# One function, `site_key`, decides whether a site has a key. The analysis admits keys by it and
# the rewrite retargets by it, so a call is retargeted exactly when its key was admitted.

# `name` is the copy's IR name (`copy_name`), `site` the call that first produced the key and
# `holder` the function whose body holds it (a key's name when a copy's body holds it).
export type Key (..) = (fn_name: String, scalars: List String, name: String, site: source.SourcePos,
                        holder: String, nodes: Int)

# `creating` maps a function (candidates and the creating externs) to its creating variables in
# signature order. `nodes` is what the copies would add: the callee node count of every key.
export type Analysis (..) = (creating: Dict (List String), keys: List Key, nodes: Int)

# `added` holds the copies, one per key in `analysis.keys` order, which `program` ends with.
export type Output (..) = (program: typed_ast.TypedProgram, added: List typed_ast.TypedDecl,
                           analysis: Analysis, trace: List String)

# `$` cannot appear in a source name and `specialise`'s copies end `$spec_<types>`, so
# `f$Int` collides with neither. No dot may follow the `$`, as `string.after_last_dot` would cut it.
export fn copy_name(fn_name: String, scalars: List String) -> String =
  fn_name ++ "$" ++ string.join("_", scalars)

export fn run(prog: typed_ast.TypedProgram, env: Dict types.Scheme) -> Output =
  match prog with
  | typed_ast.TypedProgram decls -> run_decls(decls, env)

fn run_decls(decls: List typed_ast.TypedDecl, env: Dict types.Scheme) -> Output =
  let s = solve_decls(decls, env)
      a = s.analysis
      rw = Rw(ctx = s.ctx, creating = s.creating, seen = s.seen, sub = spec_keys.subst_empty(), typed = false)
      made = list_map(make_copy(_, rw), a.keys)
  in Output(program = typed_ast.TypedProgram(list_append(rewrite_decls(decls, s.hits, rw, []), made)),
            added = made, analysis = a, trace = list_map(copy_line, a.keys) ++ [summary_line(a)])

# For a diagnostic in the copy `name`: the function it copies, the call that made it, and the
# function that holds the call (a copy's holder is named by what it copies, not by its `$` name).
export fn origin_note(a: Analysis, name: String) -> Maybe String =
  let Just k = key_named(name, a.keys) else Nothing
      holder = maybe_with_default(k.holder, fmap(fn_of, key_named(k.holder, a.keys)))
  in Just(spec_keys.copy_note(k.fn_name, k.site, holder))

fn key_named(name: String, keys: List Key) -> Maybe Key = find(\k -> k.name == name, keys)

fn fn_of(k: Key) -> String = k.fn_name

# One line per key (`SPROUT_TRACE_SCALAR`), then the totals.
fn copy_line(k: Key) -> String =
  `[scalar] copy ${k.name} of ${k.fn_name} for the call at ${k.site.line}:${k.site.column} in ${k.holder} nodes=${k.nodes}`

fn summary_line(a: Analysis) -> String = `[scalar] keys=${list_length(a.keys)} nodes=${a.nodes}`

# ---------------------------------------------------------------------------
# Signatures
# ---------------------------------------------------------------------------

# A callee's written signature, and its type variables in order of first appearance (parameters,
# then the result).
type Sig = (params: List ast.TypeExpr, ret: ast.TypeExpr, vars: List String)

# `decl` is kept for its node count, taken only for a key.
type Cand = (sig: Sig, decl: typed_ast.TypedDecl)

type Ctx = (cands: Dict Cand, creators: Dict Sig, env: Dict types.Scheme)

fn make_sig(params: List ast.TypeExpr, ret: ast.TypeExpr) -> Sig =
  Sig(params = params, ret = ret,
      vars = infer.collect_te_vars(ret, list_fold(\ (acc, te) -> infer.collect_te_vars(te, acc), [], params)))

fn cand_table(decls: List typed_ast.TypedDecl) -> Dict Cand =
  list_fold(\ (table, d) -> add_cand(d, table), dict_empty(), decls)

fn add_cand(d: typed_ast.TypedDecl, table: Dict Cand) -> Dict Cand =
  let typed_ast.TFnDecl name params (Just ret) _ [] _ = d else table
      Just tes = verify_dispatch.all_annotated(params) else table
  in dict_set(name, Cand(sig = make_sig(tes, ret), decl = d), table)

fn creator_table(decls: List typed_ast.TypedDecl) -> Dict Sig =
  list_fold(\ (table, d) -> add_creator(d, table), dict_empty(), decls)

fn add_creator(d: typed_ast.TypedDecl, table: Dict Sig) -> Dict Sig =
  let typed_ast.TExternFnDecl name params (Just ret) _ = d else table
      Just tes = verify_dispatch.all_annotated(params) else table
  in if type_kind.is_vector_creator(name) then dict_set(name, make_sig(tes, ret), table) else table

# A creating extern's creating variable is its result's element: `Vector a`.
fn creator_seed(ctx: Ctx) -> Dict (List String) =
  list_fold(\ (d, kv) -> seed_creator(kv, d), dict_empty(), vec_to_list(dict_entries(ctx.creators)))

fn seed_creator(kv: (String, Sig), d: Dict (List String)) -> Dict (List String) =
  let (name, sig) = kv
      ast.TypeApply(ast.TypeName "Vector")(ast.TypeName elem) = sig.ret else d
  in if source.is_lowercase_name(elem) then dict_set(name, [elem], d) else d

fn callee_sig(name: String, ctx: Ctx) -> Maybe Sig =
  match dict_get(name, ctx.cands) with
  | Just c -> Just(c.sig)
  | Nothing -> dict_get(name, ctx.creators)

# ---------------------------------------------------------------------------
# Instantiation
# ---------------------------------------------------------------------------

# `te` against the type `t` at its place: each written variable of `te` takes the type there.
# Nothing when the shapes differ or a variable meets two different types.
fn bind_te(te: ast.TypeExpr, t: types.Type, acc: Dict types.Type) -> Maybe (Dict types.Type) =
  match te with
  | ast.TypeName n ->
      if source.is_lowercase_name(n) then bind_var(n, t, acc)
      else
        let types.TConst id = t else Nothing
        in if types.type_id_display(id) == string.after_last_dot(n) then Just(acc) else Nothing
  | ast.TypeApply base arg ->
      let types.TApp tbase targ = t else Nothing
          Just acc1 = bind_te(base, tbase, acc) else Nothing
      in bind_te(arg, targ, acc1)
  | ast.TypeArrow param ret _ _ ->
      let types.TFunc tparam tret _ _ = t else Nothing
          Just acc1 = bind_te(param, tparam, acc) else Nothing
      in bind_te(ret, tret, acc1)
  | ast.TypeThunk ret _ ->
      let types.TThunk tret _ = t else Nothing
      in bind_te(ret, tret, acc)
  | ast.TypeEffect inner _ -> bind_te(inner, t, acc)
  | ast.TupleType items ->
      let types.TTuple titems = t else Nothing
      in bind_list(items, titems, acc)

fn bind_list(tes: List ast.TypeExpr, ts: List types.Type, acc: Dict types.Type) -> Maybe (Dict types.Type) =
  match (tes, ts) with
  | ([], []) -> Just(acc)
  | ([te | tes_rest], [t | ts_rest]) ->
      let Just acc1 = bind_te(te, t, acc) else Nothing
      in bind_list(tes_rest, ts_rest, acc1)
  | _ -> Nothing

fn bind_var(n: String, t: types.Type, acc: Dict types.Type) -> Maybe (Dict types.Type) =
  match dict_get(n, acc) with
  | Nothing -> Just(dict_set(n, t, acc))
  | Just prev -> if prev == t then Just(acc) else Nothing

# One position at a time: a position that fails to match binds nothing, and the rest still do.
fn bind_all(tes: List ast.TypeExpr, ts: List types.Type, acc: Dict types.Type) -> Dict types.Type =
  match (tes, ts) with
  | ([te | tes_rest], [t | ts_rest]) -> bind_all(tes_rest, ts_rest, maybe_with_default(acc, bind_te(te, t, acc)))
  | _ -> acc

# What a call or reference fixes: each variable of the callee's signature, by written name, against
# the parameter types and the result. The result counts: `mutvec_empty() -> MutVec a` binds `a` there only.
fn instantiate(sig: Sig, params: List types.Type, ret: types.Type) -> Dict types.Type =
  bind_all([sig.ret], [ret], bind_all(sig.params, params, dict_empty()))

# ---------------------------------------------------------------------------
# Sites
# ---------------------------------------------------------------------------

# A call to, or a reference to, a candidate or a creating extern: the callee's signature
# variables instantiated at the node (`instantiate`, computed once when the site is built).
type Site = (callee: String, theta: Dict types.Type, pos: source.SourcePos)

# A body to sweep. `owner` is the function whose body it is.
type Body = (holder: String, owner: Maybe String, locals: Dict Bool, expr: typed_ast.TypedExpr)

type Swept = (owner: Maybe String, holder: String, sites: List Site)

fn decl_bodies(d: typed_ast.TypedDecl) -> List Body =
  match d with
  | typed_ast.TFnDecl name params _ _ _ body ->
      [Body(holder = name, owner = Just(name), locals = spec_keys.bind_params(params, dict_empty()), expr = body)]
  | typed_ast.TLetDecl name value -> [Body(holder = name, owner = Nothing, locals = dict_empty(), expr = value)]
  | typed_ast.TInstanceDecl _ _ methods -> list_map(method_body, methods)
  | typed_ast.TExternFnDecl _ _ _ _ -> []
  | typed_ast.TPassThrough _ -> []

fn method_body(m: typed_ast.TypedInstanceMethod) -> Body =
  match m with
  | typed_ast.TypedInstanceMethod name params _ _ _ body ->
      Body(holder = name, owner = Nothing, locals = spec_keys.bind_params(params, dict_empty()), expr = body)

# Every site in a body, in source order.
fn sweep(b: Body, ctx: Ctx) -> Swept =
  Swept(owner = b.owner, holder = b.holder, sites = list_reverse(gather(b.expr, b.locals, ctx, [])))

# Tracks the names bound locally as `spec_keys.scan` does, so a local that shares a candidate's
# name is never a site. Every variant is listed, so a new binding form cannot fall through unbound.
fn gather(e: typed_ast.TypedExpr, locals: Dict Bool, ctx: Ctx, acc: List Site) -> List Site =
  match e with
  | typed_ast.TCall callee args t pos -> gather_call(callee, args, t, pos, locals, ctx, acc)
  | typed_ast.TVar name t pos -> note_ref(name, t, pos, locals, ctx, acc)
  | typed_ast.TLambda params body _ _ -> gather(body, spec_keys.bind_params(params, locals), ctx, acc)
  | typed_ast.TMatch scrut branches _ _ ->
      list_fold(\ (a, b) -> gather_branch(b, locals, ctx, a), gather(scrut, locals, ctx, acc), branches)
  | typed_ast.TDo steps _ _ -> gather_steps(steps, locals, ctx, acc)
  | typed_ast.TInt _ _ _ -> acc
  | typed_ast.TFloat _ _ _ -> acc
  | typed_ast.TBool _ _ _ -> acc
  | typed_ast.TString _ _ _ -> acc
  | typed_ast.TChar _ _ _ -> acc
  | typed_ast.TUnit _ _ -> acc
  | typed_ast.TDict _ _ _ _ -> acc
  | typed_ast.TMethodRef _ _ _ _ _ -> acc
  | typed_ast.TTuple _ _ _ -> gather_all(typed_ast.children(e), locals, ctx, acc)
  | typed_ast.TIf _ _ _ _ _ -> gather_all(typed_ast.children(e), locals, ctx, acc)
  | typed_ast.TBinary _ _ _ _ _ -> gather_all(typed_ast.children(e), locals, ctx, acc)
  | typed_ast.TUnary _ _ _ _ -> gather_all(typed_ast.children(e), locals, ctx, acc)
  | typed_ast.TRange _ _ _ _ -> gather_all(typed_ast.children(e), locals, ctx, acc)
  | typed_ast.TRecord _ _ _ _ -> gather_all(typed_ast.children(e), locals, ctx, acc)
  | typed_ast.TGetField _ _ _ _ -> gather_all(typed_ast.children(e), locals, ctx, acc)
  | typed_ast.TRecordUpdate _ _ _ _ -> gather_all(typed_ast.children(e), locals, ctx, acc)

fn gather_all(es: List typed_ast.TypedExpr, locals: Dict Bool, ctx: Ctx, acc: List Site) -> List Site =
  list_fold(\ (a, e) -> gather(e, locals, ctx, a), acc, es)

fn gather_branch(b: typed_ast.TypedMatchBranch, locals: Dict Bool, ctx: Ctx, acc: List Site) -> List Site =
  match b with
  | typed_ast.TypedMatchBranch pat body -> gather(body, spec_keys.bind_names(ast.pattern_names(pat), locals), ctx, acc)

# A step binds for the steps below it, not for its own value.
fn gather_steps(steps: List typed_ast.TypedDoStep, locals: Dict Bool, ctx: Ctx, acc: List Site) -> List Site =
  match steps with
  | Nil -> acc
  | Cons s rest ->
      gather_steps(rest, spec_keys.step_binds(s, locals), ctx, gather(typed_ast.step_value(s), locals, ctx, acc))

# A call to a named callee is a site and its arguments are walked; any other callee is walked.
fn gather_call(callee: typed_ast.TypedExpr, args: List typed_ast.TypedExpr, t: types.Type,
               pos: source.SourcePos, locals: Dict Bool, ctx: Ctx, acc: List Site) -> List Site =
  match callee with
  | typed_ast.TVar name _ _ -> gather_all(args, locals, ctx, note_call(name, args, t, pos, locals, ctx, acc))
  | _ -> gather_all(Cons(callee, args), locals, ctx, acc)

fn note_call(name: String, args: List typed_ast.TypedExpr, t: types.Type, pos: source.SourcePos,
             locals: Dict Bool, ctx: Ctx, acc: List Site) -> List Site =
  let Nothing = dict_get(name, locals) else acc
      Just sig = callee_sig(name, ctx) else acc
      theta = instantiate(sig, list_filter_map(value_arg_type, args), t)
  in Cons(Site(callee = name, theta = theta, pos = pos), acc)

fn value_arg_type(a: typed_ast.TypedExpr) -> Maybe types.Type =
  match a with
  | typed_ast.TDict _ _ _ _ -> Nothing
  | _ -> Just(typed_ast.typed_expr_type(a))

# A candidate named outside a call head. A creating extern named so goes through an eta wrapper
# that carries no element type, so only candidates count.
fn note_ref(name: String, t: types.Type, pos: source.SourcePos, locals: Dict Bool, ctx: Ctx,
            acc: List Site) -> List Site =
  let Just cand = dict_get(name, ctx.cands) else acc
      Nothing = dict_get(name, locals) else acc
      Just(params, ret) = peel(list_length(cand.sig.params), t) else acc
  in Cons(Site(callee = name, theta = instantiate(cand.sig, params, ret), pos = pos), acc)

# The `n` parameter types and the result of a curried function type; a zero-parameter function
# is a thunk.
fn peel(n: Int, t: types.Type) -> Maybe (List types.Type, types.Type) =
  if n == 0 then
    let types.TThunk ret _ = t else Nothing
    in Just(([], ret))
  else peel_params(n, t)

fn peel_params(n: Int, t: types.Type) -> Maybe (List types.Type, types.Type) =
  if n == 0 then Just(([], t))
  else
    let types.TFunc param rest _ _ = t else Nothing
        Just(params, ret) = peel_params(n - 1, rest) else Nothing
    in Just((Cons(param, params), ret))

# ---------------------------------------------------------------------------
# Creating variables
# ---------------------------------------------------------------------------

# A fixpoint over the sites of the candidates' bodies. The sets only grow, so it stops when no
# set does.
fn solve(sweeps: List Swept, ctx: Ctx, creating: Dict (List String)) -> Dict (List String) =
  let next = list_fold(\ (c, s) -> grow(s, ctx, c), creating, sweeps)
  in if total_vars(next) == total_vars(creating) then creating else solve(sweeps, ctx, next)

fn total_vars(creating: Dict (List String)) -> Int =
  list_fold(\ (n, vs) -> n + list_length(vs), 0, vec_to_list(dict_values(creating)))

# `s.owner`'s creating variables, with those its sites add.
fn grow(s: Swept, ctx: Ctx, creating: Dict (List String)) -> Dict (List String) =
  let Just name = s.owner else creating
      Just cand = dict_get(name, ctx.cands) else creating
      found = list_flat_map(site_vars(_, cand.sig, ctx, creating), s.sites)
      have = maybe_with_default([], dict_get(name, creating))
      want = list_filter(\v -> list_member(v, have) || list_member(v, found), cand.sig.vars)
  in if list_length(want) == list_length(have) then creating else dict_set(name, want, creating)

# The variables of `own` that this site's callee creates at: its creating variables whose
# instantiation is a variable of `own`.
fn site_vars(site: Site, own: Sig, ctx: Ctx, creating: Dict (List String)) -> List String =
  let Just vars = dict_get(site.callee, creating) else []
  in list_filter_map(\v -> own_var(dict_get(v, site.theta), own, ctx.env), vars)

# The written name, in `own`, of the type variable `bound` is, through its `@eta_fwdvar` marker.
fn own_var(bound: Maybe types.Type, own: Sig, env: Dict types.Scheme) -> Maybe String =
  let Just(types.TVar v) = bound else Nothing
      Just name = types.eta_written_var(v, env) else Nothing
  in if list_member(name, own.vars) then Just(name) else Nothing

# ---------------------------------------------------------------------------
# Keys
# ---------------------------------------------------------------------------

# A candidate's sites, for the walk of a copy's body.
fn sites_by_fn(sweeps: List Swept, ctx: Ctx) -> Dict (List Site) =
  list_fold(\ (d, s) -> add_sites(s, ctx, d), dict_empty(), sweeps)

fn add_sites(s: Swept, ctx: Ctx, d: Dict (List Site)) -> Dict (List Site) =
  let Just name = s.owner else d
      Just _ = dict_get(name, ctx.cands) else d
  in dict_set(name, s.sites, d)

# The keys found so far, last admitted first, and those whose callee body is yet to be walked.
type Walk = (seen: Dict Key, order: List Key, pending: List Key)

# The scalar each creating variable of the site's callee takes under `sub`, in signature order;
# Nothing unless every one is a non-heap scalar.
fn site_scalars(e: Site, vars: List String, sub: spec_keys.Subst, env: Dict types.Scheme) -> Maybe (List String) =
  let scalars = list_filter_map(scalar_of(_, e.theta, sub, env), vars)
  in if list_length(scalars) == list_length(vars) then Just(scalars) else Nothing

fn scalar_of(v: String, theta: Dict types.Type, sub: spec_keys.Subst, env: Dict types.Scheme) -> Maybe String =
  let Just t = dict_get(v, theta) else Nothing
      resolved = spec_keys.sub_type(t, sub, env)
      types.TConst id = resolved else Nothing
  in if type_kind.type_is_non_heap_scalar(resolved) then Just(types.type_id_name(id)) else Nothing

# Admits the key of each site, walked under `sub`: the program's own sites under none, a copy's
# under the scalars it substitutes.
fn admit_sites(sites: List Site, holder: String, sub: spec_keys.Subst, ctx: Ctx,
               creating: Dict (List String), w: Walk) -> Walk =
  list_fold(\ (acc, e) -> admit(e, holder, site_key(e, sub, ctx, creating), ctx, acc), w, sites)

# The copy a site calls under `sub`: its name and scalars. Nothing unless the callee is a
# candidate (an extern is the emitter's) with creating variables, all at scalars. `admit` and the
# rewrite both ask this, so they cannot disagree.
fn site_key(e: Site, sub: spec_keys.Subst, ctx: Ctx, creating: Dict (List String)) -> Maybe (String, List String) =
  let Just _ = dict_get(e.callee, ctx.cands) else Nothing
      Just vars = dict_get(e.callee, creating) else Nothing
      [_ | _] = vars else Nothing
      Just scalars = site_scalars(e, vars, sub, ctx.env) else Nothing
  in Just((copy_name(e.callee, scalars), scalars))

# `key` is `site_key`'s answer for `e`.
fn admit(e: Site, holder: String, key: Maybe (String, List String), ctx: Ctx, w: Walk) -> Walk =
  let Just cand = dict_get(e.callee, ctx.cands) else w
      Just(name, scalars) = key else w
      Nothing = dict_get(name, w.seen) else w
      k = Key(fn_name = e.callee, scalars = scalars, name = name, site = e.pos, holder = holder,
              nodes = typed_ast.decl_node_count(cand.decl))
  in Walk(seen = dict_set(name, k, w.seen), order = Cons(k, w.order), pending = Cons(k, w.pending))

# `hits` has one entry per declaration, in order: whether any of its own sites has a key.
type Seeded = (walk: Walk, hits: List Bool)

# The program's own sites seed the walk, under no substitution; they are visited in order.
fn seed(per_decl: List (List Swept), ctx: Ctx, creating: Dict (List String)) -> Seeded =
  let s = list_fold(\ (acc, ss) -> seed_decl(ss, ctx, creating, acc),
                    Seeded(walk = Walk(seen = dict_empty(), order = [], pending = []), hits = []), per_decl)
  in Seeded(walk = s.walk with (pending = list_reverse(s.walk.pending)), hits = list_reverse(s.hits))

fn seed_decl(ss: List Swept, ctx: Ctx, creating: Dict (List String), acc: Seeded) -> Seeded =
  let (w, hit) = list_fold(\ (a, s) -> seed_sites(s.sites, s.holder, ctx, creating, a), (acc.walk, false), ss)
  in Seeded(walk = w, hits = Cons(hit, acc.hits))

fn seed_sites(sites: List Site, holder: String, ctx: Ctx, creating: Dict (List String),
              acc: (Walk, Bool)) -> (Walk, Bool) =
  list_fold(\ (a, e) -> seed_site(e, holder, ctx, creating, a), acc, sites)

fn seed_site(e: Site, holder: String, ctx: Ctx, creating: Dict (List String), acc: (Walk, Bool)) -> (Walk, Bool) =
  let (w, hit) = acc
      key = site_key(e, spec_keys.subst_empty(), ctx, creating)
  in (admit(e, holder, key, ctx, w), hit || is_just(key))

# Each key is visited once: its callee's body, walked under the key's scalars, gives the keys it calls.
fn drain(w: Walk, ctx: Ctx, creating: Dict (List String), by_fn: Dict (List Site)) -> Walk =
  match w.pending with
  | [] -> w
  | [k | rest] -> drain(visit(k, w with (pending = rest), ctx, creating, by_fn), ctx, creating, by_fn)

fn visit(k: Key, w: Walk, ctx: Ctx, creating: Dict (List String), by_fn: Dict (List Site)) -> Walk =
  let sites = maybe_with_default([], dict_get(k.fn_name, by_fn))
      vars = maybe_with_default([], dict_get(k.fn_name, creating))
  in admit_sites(sites, k.name, key_subst(vars, k.scalars), ctx, creating, w)

# The key's substitution: each creating variable, by written name, to its scalar. `te` is read
# by a copy's written signature, `ty` by its node types.
fn key_subst(vars: List String, scalars: List String) -> spec_keys.Subst =
  spec_keys.Subst(te = dict_from_list(zip(vars, list_map(\s -> ast.TypeName(s), scalars))),
                  ty = dict_from_list(zip(vars, list_map(\s -> types.TConst(types.type_id(s)), scalars))))

# ---------------------------------------------------------------------------
# The analysis
# ---------------------------------------------------------------------------

export fn analyse(prog: typed_ast.TypedProgram, env: Dict types.Scheme) -> Analysis =
  match prog with
  | typed_ast.TypedProgram decls -> solve_decls(decls, env).analysis

# What the rewrite needs besides the analysis. `hits` has one entry per declaration: whether it
# holds a site that a key stands for, which is the only reason to rebuild it.
type Solved = (analysis: Analysis, ctx: Ctx, creating: Dict (List String), seen: Dict Key, hits: List Bool)

fn solve_decls(decls: List typed_ast.TypedDecl, env: Dict types.Scheme) -> Solved =
  let ctx = Ctx(cands = cand_table(decls), creators = creator_table(decls), env = env)
      per_decl = list_map(\d -> list_map(sweep(_, ctx), decl_bodies(d)), decls)
      sweeps = list_flat_map(\ss -> ss, per_decl)
      creating = solve(list_filter(is_candidate_body(_, ctx), sweeps), ctx, creator_seed(ctx))
      seeded = seed(per_decl, ctx, creating)
      closed = drain(seeded.walk, ctx, creating, sites_by_fn(sweeps, ctx))
      keys = list_reverse(closed.order)
  in Solved(analysis = Analysis(creating = creating, keys = keys,
                                nodes = list_fold(\ (n, k) -> n + k.nodes, 0, keys)),
            ctx = ctx, creating = creating, seen = closed.seen, hits = seeded.hits)

fn is_candidate_body(s: Swept, ctx: Ctx) -> Bool =
  match s.owner with
  | Just name -> dict_member(name, ctx.cands)
  | Nothing -> false

# ---------------------------------------------------------------------------
# The rewrite
# ---------------------------------------------------------------------------

# `sub` is empty and `typed` false for the program, which needs only retargeted sites; for a copy
# `sub` is the key's and every node type goes through it. `seen` holds every admitted key.
type Rw = (ctx: Ctx, creating: Dict (List String), seen: Dict Key, sub: spec_keys.Subst, typed: Bool)

# Only a declaration that holds a key is rebuilt. Tail recursive: the program is a long list.
fn rewrite_decls(decls: List typed_ast.TypedDecl, hits: List Bool, rw: Rw,
                 acc: List typed_ast.TypedDecl) -> List typed_ast.TypedDecl =
  match (decls, hits) with
  | ([d | ds], [h | hs]) -> rewrite_decls(ds, hs, rw, Cons(if h then rewrite_decl(d, rw) else d, acc))
  | _ -> list_reverse(acc)

fn rewrite_decl(d: typed_ast.TypedDecl, rw: Rw) -> typed_ast.TypedDecl =
  match d with
  | typed_ast.TFnDecl name params ret effects cs body ->
      typed_ast.TFnDecl(name, params, ret, effects, cs, rewrite(body, spec_keys.bind_params(params, dict_empty()), rw))
  | typed_ast.TLetDecl name value -> typed_ast.TLetDecl(name, rewrite(value, dict_empty(), rw))
  | typed_ast.TInstanceDecl c ctx methods -> typed_ast.TInstanceDecl(c, ctx, list_map(rewrite_method(_, rw), methods))
  | typed_ast.TExternFnDecl _ _ _ _ -> d
  | typed_ast.TPassThrough _ -> d

fn rewrite_method(m: typed_ast.TypedInstanceMethod, rw: Rw) -> typed_ast.TypedInstanceMethod =
  match m with
  | typed_ast.TypedInstanceMethod name params ret effects cs body ->
      typed_ast.TypedInstanceMethod(name, params, ret, effects, cs,
                                    rewrite(body, spec_keys.bind_params(params, dict_empty()), rw))

# The copy of a key's candidate: no constraints, its written signature and every node type under
# the key's substitution.
fn make_copy(k: Key, rw: Rw) -> typed_ast.TypedDecl =
  match dict_get(k.fn_name, rw.ctx.cands) with
  | Nothing -> panic("scalar_copies.make_copy: a key names no candidate (internal error)")
  | Just cand ->
      match cand.decl with
      | typed_ast.TFnDecl _ params ret effects _ body ->
          let sub = key_subst(maybe_with_default([], dict_get(k.fn_name, rw.creating)), k.scalars)
              crw = rw with (sub = sub, typed = true)
          in typed_ast.TFnDecl(
               k.name,
               list_map(spec_keys.sub_param(_, sub.te), params),
               fmap(ast.subst_type_expr(sub.te, _), ret),
               effects,
               [],
               rewrite(body, spec_keys.bind_params(params, dict_empty()), crw))
      | _ -> panic("scalar_copies.make_copy: a candidate is not a function (internal error)")

fn ty(t: types.Type, rw: Rw) -> types.Type =
  if rw.typed then spec_keys.sub_type(t, rw.sub, rw.ctx.env) else t

fn params_in(params: List ast.Param, rw: Rw) -> List ast.Param =
  if rw.typed then list_map(spec_keys.sub_param(_, rw.sub.te), params) else params

# Rewrites `e`, tracking the names bound locally as `gather` does, so a local that shares a
# candidate's name is never retargeted. Every variant is listed.
fn rewrite(e: typed_ast.TypedExpr, locals: Dict Bool, rw: Rw) -> typed_ast.TypedExpr =
  match e with
  | typed_ast.TCall callee args t pos -> rewrite_call(callee, args, t, pos, locals, rw)
  | typed_ast.TVar name t pos -> rewrite_ref(e, name, t, pos, locals, rw)
  | typed_ast.TLambda params body t pos ->
      typed_ast.TLambda(params_in(params, rw), rewrite(body, spec_keys.bind_params(params, locals), rw), ty(t, rw), pos)
  | typed_ast.TMatch scrut branches t pos ->
      typed_ast.TMatch(rewrite(scrut, locals, rw), list_map(rewrite_branch(_, locals, rw), branches), ty(t, rw), pos)
  | typed_ast.TDo steps t pos -> typed_ast.TDo(rewrite_steps(steps, locals, rw), ty(t, rw), pos)
  # A leaf is rebuilt only for a copy: the original program's keep their node.
  | typed_ast.TDict c t pos ev ->
      if rw.typed then typed_ast.TDict(spec_keys.sub_constraint(c, rw.sub.te), ty(t, rw), pos, ev) else e
  | typed_ast.TMethodRef method cls t pos ev ->
      if rw.typed then typed_ast.TMethodRef(method, cls, ty(t, rw), pos, ev) else e
  | typed_ast.TInt n t pos -> if rw.typed then typed_ast.TInt(n, ty(t, rw), pos) else e
  | typed_ast.TFloat text t pos -> if rw.typed then typed_ast.TFloat(text, ty(t, rw), pos) else e
  | typed_ast.TBool b t pos -> if rw.typed then typed_ast.TBool(b, ty(t, rw), pos) else e
  | typed_ast.TString s t pos -> if rw.typed then typed_ast.TString(s, ty(t, rw), pos) else e
  | typed_ast.TChar c t pos -> if rw.typed then typed_ast.TChar(c, ty(t, rw), pos) else e
  | typed_ast.TUnit t pos -> if rw.typed then typed_ast.TUnit(ty(t, rw), pos) else e
  | typed_ast.TTuple items t pos -> typed_ast.TTuple(list_map(rewrite(_, locals, rw), items), ty(t, rw), pos)
  | typed_ast.TIf c a b t pos ->
      typed_ast.TIf(rewrite(c, locals, rw), rewrite(a, locals, rw), rewrite(b, locals, rw), ty(t, rw), pos)
  | typed_ast.TBinary op l r t pos ->
      typed_ast.TBinary(op, rewrite(l, locals, rw), rewrite(r, locals, rw), ty(t, rw), pos)
  | typed_ast.TUnary op x t pos -> typed_ast.TUnary(op, rewrite(x, locals, rw), ty(t, rw), pos)
  | typed_ast.TRange lo hi t pos -> typed_ast.TRange(rewrite(lo, locals, rw), rewrite(hi, locals, rw), ty(t, rw), pos)
  | typed_ast.TRecord name fields t pos ->
      typed_ast.TRecord(name, list_map(rewrite_field(_, locals, rw), fields), ty(t, rw), pos)
  | typed_ast.TGetField base field t pos -> typed_ast.TGetField(rewrite(base, locals, rw), field, ty(t, rw), pos)
  | typed_ast.TRecordUpdate base fields t pos ->
      typed_ast.TRecordUpdate(rewrite(base, locals, rw), list_map(rewrite_field(_, locals, rw), fields), ty(t, rw), pos)

fn rewrite_field(f: typed_ast.TypedRecordField, locals: Dict Bool, rw: Rw) -> typed_ast.TypedRecordField =
  match f with
  | typed_ast.TypedRecordField name value -> typed_ast.TypedRecordField(name, rewrite(value, locals, rw))

fn rewrite_branch(b: typed_ast.TypedMatchBranch, locals: Dict Bool, rw: Rw) -> typed_ast.TypedMatchBranch =
  match b with
  | typed_ast.TypedMatchBranch pat body ->
      typed_ast.TypedMatchBranch(pat, rewrite(body, spec_keys.bind_names(ast.pattern_names(pat), locals), rw))

# A step binds for the steps below it, not for its own value.
fn rewrite_steps(steps: List typed_ast.TypedDoStep, locals: Dict Bool, rw: Rw) -> List typed_ast.TypedDoStep =
  match steps with
  | Nil -> Nil
  | Cons s rest -> Cons(rewrite_step(s, locals, rw), rewrite_steps(rest, spec_keys.step_binds(s, locals), rw))

fn rewrite_step(s: typed_ast.TypedDoStep, locals: Dict Bool, rw: Rw) -> typed_ast.TypedDoStep =
  match s with
  | typed_ast.TDoBindStep pat value mode -> typed_ast.TDoBindStep(pat, rewrite(value, locals, rw), mode)
  | typed_ast.TDoLetStep name value -> typed_ast.TDoLetStep(name, rewrite(value, locals, rw))
  | typed_ast.TDoExprStep value -> typed_ast.TDoExprStep(rewrite(value, locals, rw))

# A call to a named callee is a site, as in `gather_call`: if it has a key it names the copy.
# Its callee is never rewritten as a reference. Candidates have no constraints, so the
# arguments keep their positions.
fn rewrite_call(callee: typed_ast.TypedExpr, args: List typed_ast.TypedExpr, t: types.Type,
                pos: source.SourcePos, locals: Dict Bool, rw: Rw) -> typed_ast.TypedExpr =
  let new_args = list_map(rewrite(_, locals, rw), args)
  in match callee with
     | typed_ast.TVar name callee_t callee_pos ->
         let head = match retarget(note_call(name, args, t, pos, locals, rw.ctx, []), callee_t, callee_pos, rw) with
                    | Just c -> c
                    | Nothing -> keep_var(callee, name, callee_t, callee_pos, rw)
         in typed_ast.TCall(head, new_args, ty(t, rw), pos)
     | _ -> typed_ast.TCall(rewrite(callee, locals, rw), new_args, ty(t, rw), pos)

# A variable outside a call head: the copy if it is a candidate with a key, else itself.
fn rewrite_ref(e: typed_ast.TypedExpr, name: String, t: types.Type, pos: source.SourcePos,
               locals: Dict Bool, rw: Rw) -> typed_ast.TypedExpr =
  match retarget(note_ref(name, t, pos, locals, rw.ctx, []), t, pos, rw) with
  | Just c -> c
  | Nothing -> keep_var(e, name, t, pos, rw)

# `e` is the variable `name`; rebuilt only for a copy, whose node types go through `sub`.
fn keep_var(e: typed_ast.TypedExpr, name: String, t: types.Type, pos: source.SourcePos, rw: Rw) -> typed_ast.TypedExpr =
  if rw.typed then typed_ast.TVar(name, ty(t, rw), pos) else e

# The callee naming the copy of the one site `note_call` or `note_ref` found, if `site_key`
# gives it a key. Every such key was admitted: the analysis walked the same sites under the same
# substitution.
fn retarget(sites: List Site, callee_t: types.Type, callee_pos: source.SourcePos, rw: Rw) -> Maybe typed_ast.TypedExpr =
  let [site | _] = sites else Nothing
      Just(name, _) = site_key(site, rw.sub, rw.ctx, rw.creating) else Nothing
  in if dict_member(name, rw.seen) then Just(typed_ast.TVar(name, ty(callee_t, rw), callee_pos))
     else panic(`scalar_copies.retarget: ${name} is not an admitted key (internal error)`)
