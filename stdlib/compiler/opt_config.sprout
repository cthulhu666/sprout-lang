module stdlib.compiler.opt_config
import stdlib.compiler.switches as switches
import stdlib.string as string

# Which optimisation passes run, and whether they report what they did
# (docs/opt-passes-v0.md §M0).  Two switches, read once per compile:
#
#   SPROUT_OPT_OFF=dle,cse    comma list of passes to DISABLE; unset means all on
#   SPROUT_OPT_ON=spec        comma list of default-off passes to ENABLE (`default_off`);
#                             OFF wins when both name a pass
#   SPROUT_OPT_STATS=1        per-pass node-count deltas on stderr
#
# The environment carries strings; `parse` turns them into `Pass` values once, so
# a query cannot misspell a pass, and a name matching none is kept in
# `unrecognised` rather than silently disabling nothing.
#
# Environment rather than a CLI flag because compile_driver dispatches on
# positional list patterns, so a flag would thread through every arm;
# SPROUT_VERIFY_DISPATCH_OFF set the precedent.

export type Pass (..) deriving (Eq, ToString) =
  | Dle
  | Cse
  | Licm
  | Bce
  | Spec

export type OptConfig (..) =
  (disabled: List Pass, enabled_on: List Pass, unrecognised: List String, stats: Bool)

export fn pass_name(p: Pass) -> String =
  match p with
  | Dle -> "dle"
  | Cse -> "cse"
  | Licm -> "licm"
  | Bce -> "bce"
  | Spec -> "spec"

export fn pass_from_name(name: String) -> Maybe Pass =
  match name with
  | "dle" -> Just(Dle)
  | "cse" -> Just(Cse)
  | "licm" -> Just(Licm)
  | "bce" -> Just(Bce)
  | "spec" -> Just(Spec)
  | _ -> Nothing

export let all_passes =
  [Dle, Cse, Licm, Bce, Spec]

# Which of those the pipeline actually runs. `Cse`/`Licm` are named before they
# exist because the switch's vocabulary is the roadmap — but disabling one must
# SAY it did nothing, or someone bisecting a miscompile with `SPROUT_OPT_OFF=cse`
# clears CSE of a fault it was never given the chance to have. Flip the arm in
# the same change that lands the pass.
export fn implemented(p: Pass) -> Bool =
  match p with
  | Dle -> true
  | Cse -> false
  | Licm -> false
  | Bce -> true
  | Spec -> true

# A default-off pass runs only when SPROUT_OPT_ON names it.
export fn default_off(p: Pass) -> Bool =
  match p with
  | Dle -> false
  | Cse -> false
  | Licm -> false
  | Bce -> false
  | Spec -> true

export fn parse(off: Maybe String, on: Maybe String, stats: Maybe String) -> OptConfig =
  OptConfig(
    disabled = list_filter_map(pass_from_name, requested_names(off)),
    enabled_on = list_filter_map(pass_from_name, requested_names(on)),
    unrecognised = list_filter(is_unrecognised, requested_names(off) ++ requested_names(on)),
    stats = truthy(stats)
  )

export fn from_env() -> OptConfig !{IO} =
  do
    let off = switches.env_switch("SPROUT_OPT_OFF")
    let on = switches.env_switch("SPROUT_OPT_ON")
    let cfg = parse(off, on, switches.env_switch("SPROUT_OPT_STATS"))
    _ <- warn_unrecognised("SPROUT_OPT_OFF", list_filter(is_unrecognised, requested_names(off)))
    _ <- warn_unrecognised("SPROUT_OPT_ON", list_filter(is_unrecognised, requested_names(on)))
    _ <- warn_unimplemented("SPROUT_OPT_OFF", "disabled", list_filter(is_pending, cfg.disabled))
    _ <- warn_unimplemented("SPROUT_OPT_ON", "enabled", list_filter(is_pending, cfg.enabled_on))
    cfg

export fn enabled(cfg: OptConfig, p: Pass) -> Bool =
  !list_member(p, cfg.disabled) && (!default_off(p) || list_member(p, cfg.enabled_on))

# For a pass that runs below `compiler.run_opt_passes`, which has already reported
# any unknown name: reads the switch without repeating the warnings.
export fn pass_enabled(p: Pass) -> Bool !{IO} =
  enabled(parse(switches.env_switch_quiet("SPROUT_OPT_OFF"), switches.env_switch_quiet("SPROUT_OPT_ON"), Nothing), p)

fn requested_names(off: Maybe String) -> List String =
  match off with
  | Nothing -> []
  | Just raw -> list_filter(is_named, list_map(normalise, string.split(raw, ",")))

fn is_named(name: String) -> Bool =
  !string.is_empty(name)

fn is_unrecognised(name: String) -> Bool =
  match pass_from_name(name) with
  | Nothing -> true
  | Just _ -> false

fn normalise(name: String) -> String =
  string.to_lower_ascii(string.trim(name))

# Follows the runtime's `sprout_debug_alloc_truthy` (sprout_runtime.c): set is not
# enough, "0"/"false"/"off" are off, so SPROUT_OPT_STATS=0 does what it looks like.
fn truthy(v: Maybe String) -> Bool =
  match v with
  | Nothing -> false
  | Just raw -> is_truthy_word(normalise(raw))

fn is_truthy_word(v: String) -> Bool =
  !(string.is_empty(v) || v == "0" || v == "false" || v == "off")

fn is_pending(p: Pass) -> Bool =
  !implemented(p)

fn warn_unimplemented(var: String, verb: String, passes: List Pass) -> Unit !{IO} =
  match passes with
  | [] -> ()
  | _ ->
      eprint("[opt] warning: " ++ var ++ " names a pass that is not implemented yet: "
             ++ string.join(",", list_map(pass_name, passes)) ++ " — nothing was " ++ verb)

fn warn_unrecognised(var: String, names: List String) -> Unit !{IO} =
  match names with
  | [] -> ()
  | _ ->
      eprint("[opt] warning: " ++ var ++ " names no such pass: " ++ string.join(",", names)
             ++ " (known: " ++ string.join(",", list_map(pass_name, all_passes)) ++ ")")
