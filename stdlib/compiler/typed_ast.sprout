module stdlib.compiler.typed_ast
import stdlib.compiler.ast as ast
import stdlib.compiler.types as types
import stdlib.compiler.source as source

# ---------------------------------------------------------------------------
# Typed expression IR
# ---------------------------------------------------------------------------
#
# TypedExpr is the output of the typechecker.  Every node carries its inferred
# type as a `types.Type` field and its source position for LSP queries (hover,
# go-to-definition).
#
# TCall nodes additionally carry explicit TDict constraint-witness arguments
# (analogous to GHC's HsWrapper evidence).  When the typechecker resolves a
# call to a class method it prepends a TDict node representing the required
# dictionary.  The lowering pass replaces TDict nodes with concrete instance
# function references (or hidden parameters for polymorphic call sites).
#
# A class method used in *value* position (passed as a value, not immediately
# applied — e.g. `map(show, xs)`) has no arguments to dispatch on, so inference
# cannot resolve its dictionary at the use site.  Such references are carried by
# TMethodRef (method_name, class_name, type, pos, Evidence); lowering eta-expands
# them against the final substituted type, filling the dictionary from the
# resolved Evidence just as it does for TDict at call sites.
#
# This design follows the "Trees That Grow" principle: the IR carries exactly
# the information each downstream pass needs without ad-hoc attribute mutation.

export type TypedMatchBranch (..) = TypedMatchBranch ast.Pattern TypedExpr

export type TypedDoStep (..) =
  | TDoBindStep ast.Pattern TypedExpr
  | TDoLetStep String TypedExpr
  | TDoExprStep TypedExpr

export type TypedRecordField (..) = TypedRecordField String TypedExpr

# Resolved typeclass-dictionary evidence attached to a TDict node.
# EvClasses: one block per effective class — the constraint's class followed by its
#   transitive superclasses (the witness order lowering's resolve_tdict produces).
# EvUnresolved: not yet rewritten by the resolve pass (lowering resolves it itself).
# EvInstance/EvForward each carry TWO differently-shaped strings:
#   class_name — the ClassDecl name form, UNSTRIPPED (lowering's class_methods_for /
#     class_order key on this form to get the ordered method list); and
#   key — the after_last_dot-stripped constraint_key (lowering's ctx_inst / ctx_fwd
#     key on this form). DO NOT strip class_name, or the method-list lookup breaks.
# EvInstance: bundled instance (class_name, key, evidence for context constraints).
# EvForward: forwarded hidden-param dict at a polymorphic call site (class_name, key).
# EvMissing: unsatisfiable constraint; resolve rejects it with a diagnostic.
export type Evidence (..) =
  | EvUnresolved
  | EvClasses (List Evidence)
  | EvInstance String String (List Evidence)
  | EvForward String String
  | EvMissing ast.TypeConstraint

export type TypedExpr (..) =
  | TVar String types.Type source.SourcePos
  | TInt Int types.Type source.SourcePos
  | TFloat String types.Type source.SourcePos
  | TBool Bool types.Type source.SourcePos
  | TString String types.Type source.SourcePos
  | TChar Int types.Type source.SourcePos
  | TUnit types.Type source.SourcePos
  | TTuple (List TypedExpr) types.Type source.SourcePos
  | TIf TypedExpr TypedExpr TypedExpr types.Type source.SourcePos
  | TMatch TypedExpr (List TypedMatchBranch) types.Type source.SourcePos
  | TCall TypedExpr (List TypedExpr) types.Type source.SourcePos
  | TDict ast.TypeConstraint types.Type source.SourcePos Evidence
  | TMethodRef String String types.Type source.SourcePos Evidence
  | TLambda (List ast.Param) TypedExpr types.Type source.SourcePos
  | TBinary String TypedExpr TypedExpr types.Type source.SourcePos
  | TUnary String TypedExpr types.Type source.SourcePos
  | TRange TypedExpr TypedExpr types.Type source.SourcePos
  | TDo (List TypedDoStep) types.Type source.SourcePos
  | TRecord String (List TypedRecordField) types.Type source.SourcePos
  | TGetField TypedExpr String types.Type source.SourcePos
  # Functional record update: base value, updated fields (source order), result
  # record type (= base type).  docs/records-v0.md §4.4.
  | TRecordUpdate TypedExpr (List TypedRecordField) types.Type source.SourcePos

export fn typed_expr_type(e: TypedExpr) -> types.Type =
  match e with
  | TVar _ t _ -> t
  | TInt _ t _ -> t
  | TFloat _ t _ -> t
  | TBool _ t _ -> t
  | TString _ t _ -> t
  | TChar _ t _ -> t
  | TUnit t _ -> t
  | TTuple _ t _ -> t
  | TIf _ _ _ t _ -> t
  | TMatch _ _ t _ -> t
  | TCall _ _ t _ -> t
  | TDict _ t _ _ -> t
  | TMethodRef _ _ t _ _ -> t
  | TLambda _ _ t _ -> t
  | TBinary _ _ _ t _ -> t
  | TUnary _ _ t _ -> t
  | TRange _ _ t _ -> t
  | TDo _ t _ -> t
  | TRecord _ _ t _ -> t
  | TGetField _ _ t _ -> t
  | TRecordUpdate _ _ t _ -> t

export fn typed_expr_pos(e: TypedExpr) -> source.SourcePos =
  match e with
  | TVar _ _ p -> p
  | TInt _ _ p -> p
  | TFloat _ _ p -> p
  | TBool _ _ p -> p
  | TString _ _ p -> p
  | TChar _ _ p -> p
  | TUnit _ p -> p
  | TTuple _ _ p -> p
  | TIf _ _ _ _ p -> p
  | TMatch _ _ _ p -> p
  | TCall _ _ _ p -> p
  | TDict _ _ p _ -> p
  | TMethodRef _ _ _ p _ -> p
  | TLambda _ _ _ p -> p
  | TBinary _ _ _ _ p -> p
  | TUnary _ _ _ p -> p
  | TRange _ _ _ p -> p
  | TDo _ _ p -> p
  | TRecord _ _ _ p -> p
  | TGetField _ _ _ p -> p
  | TRecordUpdate _ _ _ p -> p

# ---------------------------------------------------------------------------
# Typed declarations
# ---------------------------------------------------------------------------

# A typed instance method: same shape as InstanceMethodImpl but body is TypedExpr.
export type TypedInstanceMethod (..) =
  TypedInstanceMethod String (List ast.Param) (Maybe ast.TypeExpr) (Maybe (List String)) TypedExpr

export type TypedDecl (..) =
  | TFnDecl String (List ast.Param) (Maybe ast.TypeExpr) (Maybe (List String)) (List ast.TypeConstraint) TypedExpr
  | TExternFnDecl String (List ast.Param) (Maybe ast.TypeExpr) (Maybe (List String))
  | TLetDecl String TypedExpr
  | TInstanceDecl ast.TypeConstraint (List ast.TypeConstraint) (List TypedInstanceMethod)
  | TPassThrough ast.Decl

export type TypedProgram (..) = TypedProgram(List TypedDecl)

# ---------------------------------------------------------------------------
# Result types for the typed pipeline
# ---------------------------------------------------------------------------

export type TypedResult (..) =
  | TypedOk TypedProgram (Dict types.Scheme)
  | TypedErr source.SourcePos String

# Result of inferring a single function/method body.
# BodyLenient: an unknown-variable error was silently accepted (builtin gap).
export type BodyResult (..) =
  | BodyOk TypedExpr types.Type
  | BodyLenient
  | BodyErr source.SourcePos String

export type InstanceMethodsResult (..) =
  | InstanceMethodsOk (List TypedInstanceMethod)
  | InstanceMethodsErr source.SourcePos String

# ---------------------------------------------------------------------------
# Type → TypeExpr conversion (used when constructing TDict constraint nodes)
# ---------------------------------------------------------------------------
#
# Converts an inferred types.Type back to a surface ast.TypeExpr.  This is
# used to store the constraint argument in TDict nodes so the lowering pass
# can reconstruct constraint keys without needing the full type-inference state.

export fn type_to_type_expr(t: types.Type) -> ast.TypeExpr =
  match t with
  | types.TVar name -> ast.TypeName(types.tyvar_identity(name))
  | types.TConst name -> ast.TypeName(types.type_id_name(name))
  | types.TApp f x -> ast.TypeApply(type_to_type_expr(f), type_to_type_expr(x))
  | types.TFunc a b _ _ -> ast.TypeArrow(type_to_type_expr(a), type_to_type_expr(b), Nothing)
  | types.TThunk b _ -> ast.TypeThunk(type_to_type_expr(b), Nothing)
  | types.TTuple items -> ast.TupleType(list_map(\i -> type_to_type_expr(i), items))

# ---------------------------------------------------------------------------
# Node census
# ---------------------------------------------------------------------------
#
# Total typed-expression nodes in a program.  An optimisation pass reports what
# it did as count-before minus count-after (docs/opt-passes-v0.md §M0), so one
# generic walker instruments every pass and a new pass needs no new counter.
#
# Declarations are frames, not nodes: only bodies count.  A do-step and a match
# branch DO count, so that deleting one shows a delta larger than the expression
# it carried.

export fn node_count(prog: TypedProgram) -> Int =
  match prog with
  | TypedProgram decls -> count_decls(decls)

fn count_decls(decls: List TypedDecl) -> Int =
  list_fold(\ (acc, d) -> acc + count_decl(d), 0, decls)

fn count_decl(d: TypedDecl) -> Int =
  match d with
  | TFnDecl _ _ _ _ _ body -> count_expr(body)
  | TExternFnDecl _ _ _ _ -> 0
  | TLetDecl _ value -> count_expr(value)
  | TInstanceDecl _ _ methods -> count_methods(methods)
  | TPassThrough _ -> 0

fn count_methods(methods: List TypedInstanceMethod) -> Int =
  list_fold(\ (acc, m) -> acc + count_method(m), 0, methods)

fn count_method(m: TypedInstanceMethod) -> Int =
  match m with
  | TypedInstanceMethod _ _ _ _ body -> count_expr(body)

fn count_exprs(es: List TypedExpr) -> Int =
  list_fold(\ (acc, e) -> acc + count_expr(e), 0, es)

fn count_expr(e: TypedExpr) -> Int =
  1 + count_children(e)

fn count_children(e: TypedExpr) -> Int =
  match e with
  | TVar _ _ _ -> 0
  | TInt _ _ _ -> 0
  | TFloat _ _ _ -> 0
  | TBool _ _ _ -> 0
  | TString _ _ _ -> 0
  | TChar _ _ _ -> 0
  | TUnit _ _ -> 0
  | TTuple items _ _ -> count_exprs(items)
  | TIf cond then_e else_e _ _ -> count_expr(cond) + count_expr(then_e) + count_expr(else_e)
  | TMatch scrut branches _ _ -> count_expr(scrut) + count_branches(branches)
  | TCall callee args _ _ -> count_expr(callee) + count_exprs(args)
  | TDict _ _ _ _ -> 0
  | TMethodRef _ _ _ _ _ -> 0
  | TLambda _ body _ _ -> count_expr(body)
  | TBinary _ left right _ _ -> count_expr(left) + count_expr(right)
  | TUnary _ operand _ _ -> count_expr(operand)
  | TRange lo hi _ _ -> count_expr(lo) + count_expr(hi)
  | TDo steps _ _ -> count_steps(steps)
  | TRecord _ fields _ _ -> count_fields(fields)
  | TGetField base _ _ _ -> count_expr(base)
  | TRecordUpdate base fields _ _ -> count_expr(base) + count_fields(fields)

fn count_branches(branches: List TypedMatchBranch) -> Int =
  list_fold(\ (acc, b) -> acc + count_branch(b), 0, branches)

fn count_branch(b: TypedMatchBranch) -> Int =
  match b with
  | TypedMatchBranch _ body -> 1 + count_expr(body)

fn count_steps(steps: List TypedDoStep) -> Int =
  list_fold(\ (acc, s) -> acc + count_step(s), 0, steps)

fn count_step(s: TypedDoStep) -> Int =
  match s with
  | TDoBindStep _ value -> 1 + count_expr(value)
  | TDoLetStep _ value -> 1 + count_expr(value)
  | TDoExprStep value -> 1 + count_expr(value)

fn count_fields(fields: List TypedRecordField) -> Int =
  list_fold(\ (acc, f) -> acc + count_field(f), 0, fields)

fn count_field(f: TypedRecordField) -> Int =
  match f with
  | TypedRecordField _ value -> 1 + count_expr(value)

