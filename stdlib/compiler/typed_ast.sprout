module stdlib.compiler.typed_ast
import stdlib.compiler.ast as ast
import stdlib.compiler.types as types
import stdlib.compiler.source as source
import stdlib.string as string

# ---------------------------------------------------------------------------
# Typed expression IR
# ---------------------------------------------------------------------------
#
# TypedExpr is the output of the typechecker.  Every node carries its inferred
# type as a `types.Type` field and its source position for LSP queries (hover,
# go-to-definition).
#
# TCall nodes additionally carry explicit TDict constraint-witness arguments
# (analogous to GHC's HsWrapper evidence).  When the typechecker resolves a
# call to a class method it prepends a TDict node representing the required
# dictionary.  The lowering pass replaces TDict nodes with concrete instance
# function references (or hidden parameters for polymorphic call sites).
#
# A class method used in *value* position (passed as a value, not immediately
# applied — e.g. `map(show, xs)`) has no arguments to dispatch on, so inference
# cannot resolve its dictionary at the use site.  Such references are carried by
# TMethodRef (method_name, class_name, type, pos, Evidence); lowering eta-expands
# them against the final substituted type, filling the dictionary from the
# resolved Evidence just as it does for TDict at call sites.
#
# This design follows the "Trees That Grow" principle: the IR carries exactly
# the information each downstream pass needs without ad-hoc attribute mutation.

export type TypedMatchBranch (..) = TypedMatchBranch ast.Pattern TypedExpr

export type TypedDoStep (..) =
  | TDoBindStep ast.Pattern TypedExpr BindMode
  | TDoLetStep String TypedExpr
  | TDoExprStep TypedExpr

# Whether a `<-` unwraps its right-hand side and returns early on failure (spec-v0.md
# §5.9). The checker decides it once, at the bind; every later pass reads it here and
# never re-derives it from the final type, which can differ from the type at the bind.
export type BindMode (..) = PlainBind | MaybeBind | ResultBind

# Short-circuit family ("Maybe" / "Result") of a do-step's inferred type, or
# Nothing for any other type (IO actions, pure values): `Maybe a` =
# TApp (TConst Maybe) a; `Result e a` = TApp (TApp (TConst Result) e) a.
export fn short_circuit_family(t: types.Type) -> Maybe String =
  match t with
  | types.TApp outer _ ->
      match outer with
      | types.TConst name -> if types.type_id_name(name) == "Maybe" then Just("Maybe") else Nothing
      | types.TApp outer2 _ ->
          match outer2 with
          | types.TConst name -> if types.type_id_name(name) == "Result" then Just("Result") else Nothing
          | _ -> Nothing
      | _ -> Nothing
  | _ -> Nothing

export fn bind_mode_propagates(m: BindMode) -> Bool =
  match m with
  | PlainBind -> false
  | MaybeBind -> true
  | ResultBind -> true

export type TypedRecordField (..) = TypedRecordField String TypedExpr

# Resolved typeclass-dictionary evidence attached to a TDict node.
# EvClasses: one block per effective class — the constraint's class followed by its
#   transitive superclasses (the order lowering emits witnesses in).
# EvUnresolved: resolve found no bundled instance; lowering emits __unresolved_
#   sentinels for it.
# EvInstance/EvForward carry the class's ClassDecl name, which lowering's
# class_methods_for / class_order key on, and the key into ctx_inst / ctx_fwd.
# EvInstance: bundled instance (class_name, key, evidence for context constraints).
# EvForward: forwarded hidden-param dict at a polymorphic call site (class_name, key).
# EvMissing: unsatisfiable constraint; resolve rejects it with a diagnostic.
export type Evidence (..) =
  | EvUnresolved
  | EvClasses (List Evidence)
  | EvInstance String InstanceKey (List Evidence)
  | EvForward String SlotKey
  | EvMissing ast.TypeConstraint

export type TypedExpr (..) =
  | TVar String types.Type source.SourcePos
  | TInt Int types.Type source.SourcePos
  | TFloat String types.Type source.SourcePos
  | TBool Bool types.Type source.SourcePos
  | TString String types.Type source.SourcePos
  | TChar Int types.Type source.SourcePos
  | TUnit types.Type source.SourcePos
  | TTuple (List TypedExpr) types.Type source.SourcePos
  | TIf TypedExpr TypedExpr TypedExpr types.Type source.SourcePos
  | TMatch TypedExpr (List TypedMatchBranch) types.Type source.SourcePos
  | TCall TypedExpr (List TypedExpr) types.Type source.SourcePos
  | TDict ast.TypeConstraint types.Type source.SourcePos Evidence
  | TMethodRef String String types.Type source.SourcePos Evidence
  | TLambda (List ast.Param) TypedExpr types.Type source.SourcePos
  | TBinary String TypedExpr TypedExpr types.Type source.SourcePos
  | TUnary String TypedExpr types.Type source.SourcePos
  | TRange TypedExpr TypedExpr types.Type source.SourcePos
  | TDo (List TypedDoStep) types.Type source.SourcePos
  | TRecord String (List TypedRecordField) types.Type source.SourcePos
  | TGetField TypedExpr String types.Type source.SourcePos
  # Functional record update: base value, updated fields (source order), result
  # record type (= base type).  docs/records-v0.md §4.4.
  | TRecordUpdate TypedExpr (List TypedRecordField) types.Type source.SourcePos

export fn typed_expr_type(e: TypedExpr) -> types.Type =
  match e with
  | TVar _ t _ -> t
  | TInt _ t _ -> t
  | TFloat _ t _ -> t
  | TBool _ t _ -> t
  | TString _ t _ -> t
  | TChar _ t _ -> t
  | TUnit t _ -> t
  | TTuple _ t _ -> t
  | TIf _ _ _ t _ -> t
  | TMatch _ _ t _ -> t
  | TCall _ _ t _ -> t
  | TDict _ t _ _ -> t
  | TMethodRef _ _ t _ _ -> t
  | TLambda _ _ t _ -> t
  | TBinary _ _ _ t _ -> t
  | TUnary _ _ t _ -> t
  | TRange _ _ t _ -> t
  | TDo _ t _ -> t
  | TRecord _ _ t _ -> t
  | TGetField _ _ t _ -> t
  | TRecordUpdate _ _ t _ -> t

export fn typed_expr_pos(e: TypedExpr) -> source.SourcePos =
  match e with
  | TVar _ _ p -> p
  | TInt _ _ p -> p
  | TFloat _ _ p -> p
  | TBool _ _ p -> p
  | TString _ _ p -> p
  | TChar _ _ p -> p
  | TUnit _ p -> p
  | TTuple _ _ p -> p
  | TIf _ _ _ _ p -> p
  | TMatch _ _ _ p -> p
  | TCall _ _ _ p -> p
  | TDict _ _ p _ -> p
  | TMethodRef _ _ _ p _ -> p
  | TLambda _ _ _ p -> p
  | TBinary _ _ _ _ p -> p
  | TUnary _ _ _ p -> p
  | TRange _ _ _ p -> p
  | TDo _ _ p -> p
  | TRecord _ _ _ p -> p
  | TGetField _ _ _ p -> p
  | TRecordUpdate _ _ _ p -> p

# ---------------------------------------------------------------------------
# Typed declarations
# ---------------------------------------------------------------------------

# A typed instance method: same shape as InstanceMethodImpl but body is TypedExpr.
# The constraint list is carried through to lowering, which turns it into hidden
# dictionary parameters exactly as it does for a constrained TFnDecl.
export type TypedInstanceMethod (..) =
  TypedInstanceMethod String (List ast.Param) (Maybe ast.TypeExpr) (Maybe (List String)) (List ast.TypeConstraint) TypedExpr

export type TypedDecl (..) =
  | TFnDecl String (List ast.Param) (Maybe ast.TypeExpr) (Maybe (List String)) (List ast.TypeConstraint) TypedExpr
  | TExternFnDecl String (List ast.Param) (Maybe ast.TypeExpr) (Maybe (List String))
  | TLetDecl String TypedExpr
  | TInstanceDecl ast.TypeConstraint (List ast.TypeConstraint) (List TypedInstanceMethod)
  | TPassThrough ast.Decl

export type TypedProgram (..) = TypedProgram(List TypedDecl)

# The direct subexpressions of `e`, left to right: arm bodies but not patterns,
# do-step values, record field values. Exhaustive with no wildcard, so a new
# TypedExpr variant stops the build here, and every walker built on this one
# learns its children in one place.
export fn children(e: TypedExpr) -> List TypedExpr =
  match e with
  | TVar _ _ _ -> []
  | TInt _ _ _ -> []
  | TFloat _ _ _ -> []
  | TBool _ _ _ -> []
  | TString _ _ _ -> []
  | TChar _ _ _ -> []
  | TUnit _ _ -> []
  | TTuple items _ _ -> items
  | TIf cond then_e else_e _ _ -> [cond, then_e, else_e]
  | TMatch scrut branches _ _ -> [scrut] ++ list_map(branch_body, branches)
  | TCall callee args _ _ -> [callee] ++ args
  | TDict _ _ _ _ -> []
  | TMethodRef _ _ _ _ _ -> []
  | TLambda _ body _ _ -> [body]
  | TBinary _ left right _ _ -> [left, right]
  | TUnary _ operand _ _ -> [operand]
  | TRange lo hi _ _ -> [lo, hi]
  | TDo steps _ _ -> list_map(step_value, steps)
  | TRecord _ fields _ _ -> list_map(field_value, fields)
  | TGetField base _ _ _ -> [base]
  | TRecordUpdate base fields _ _ -> [base] ++ list_map(field_value, fields)

# `e` rebuilt with `g` applied to each of children(e), in that order; the first
# Err stops the walk. Exhaustive like children, and beside it so the two change
# together.
export fn traverse_children(g: TypedExpr -> Result err TypedExpr, e: TypedExpr) -> Result err TypedExpr =
  match e with
  | TVar _ _ _ -> Ok(e)
  | TInt _ _ _ -> Ok(e)
  | TFloat _ _ _ -> Ok(e)
  | TBool _ _ _ -> Ok(e)
  | TString _ _ _ -> Ok(e)
  | TChar _ _ _ -> Ok(e)
  | TUnit _ _ -> Ok(e)
  | TTuple items t p ->
      let xs = try traverse_list(g, items)
      in Ok(TTuple(xs, t, p))
  | TIf cond then_e else_e t p ->
      let c = try g(cond)
          a = try g(then_e)
          b = try g(else_e)
      in Ok(TIf(c, a, b, t, p))
  | TMatch scrut branches t p ->
      let s = try g(scrut)
          bs = try traverse_list(traverse_branch(g, _), branches)
      in Ok(TMatch(s, bs, t, p))
  | TCall callee args t p ->
      let f = try g(callee)
          xs = try traverse_list(g, args)
      in Ok(TCall(f, xs, t, p))
  | TDict _ _ _ _ -> Ok(e)
  | TMethodRef _ _ _ _ _ -> Ok(e)
  | TLambda params body t p ->
      let b = try g(body)
      in Ok(TLambda(params, b, t, p))
  | TBinary op left right t p ->
      let l = try g(left)
          r = try g(right)
      in Ok(TBinary(op, l, r, t, p))
  | TUnary op operand t p ->
      let x = try g(operand)
      in Ok(TUnary(op, x, t, p))
  | TRange lo hi t p ->
      let a = try g(lo)
          b = try g(hi)
      in Ok(TRange(a, b, t, p))
  | TDo steps t p ->
      let ss = try traverse_list(traverse_step(g, _), steps)
      in Ok(TDo(ss, t, p))
  | TRecord name fields t p ->
      let fs = try traverse_list(traverse_field(g, _), fields)
      in Ok(TRecord(name, fs, t, p))
  | TGetField base fld t p ->
      let b = try g(base)
      in Ok(TGetField(b, fld, t, p))
  | TRecordUpdate base fields t p ->
      let b = try g(base)
          fs = try traverse_list(traverse_field(g, _), fields)
      in Ok(TRecordUpdate(b, fs, t, p))

# Left to right, stopping at the first Err; tail recursive.
fn traverse_list(g: a -> Result err b, xs: List a) -> Result err (List b) =
  traverse_list_go(g, xs, [])

fn traverse_list_go(g: a -> Result err b, xs: List a, acc: List b) -> Result err (List b) =
  match xs with
  | [] -> Ok(list_reverse(acc))
  | [x | rest] ->
      let y = try g(x)
      in traverse_list_go(g, rest, Cons(y, acc))

fn traverse_branch(g: TypedExpr -> Result err TypedExpr, b: TypedMatchBranch) -> Result err TypedMatchBranch =
  let TypedMatchBranch pat body = b
      x = try g(body)
  in Ok(TypedMatchBranch(pat, x))

fn traverse_step(g: TypedExpr -> Result err TypedExpr, s: TypedDoStep) -> Result err TypedDoStep =
  match s with
  | TDoBindStep pat value mode ->
      let x = try g(value)
      in Ok(TDoBindStep(pat, x, mode))
  | TDoLetStep name value ->
      let x = try g(value)
      in Ok(TDoLetStep(name, x))
  | TDoExprStep value ->
      let x = try g(value)
      in Ok(TDoExprStep(x))

fn traverse_field(g: TypedExpr -> Result err TypedExpr, f: TypedRecordField) -> Result err TypedRecordField =
  let TypedRecordField name value = f
      x = try g(value)
  in Ok(TypedRecordField(name, x))

export fn branch_body(b: TypedMatchBranch) -> TypedExpr =
  match b with
  | TypedMatchBranch _ body -> body

export fn step_value(s: TypedDoStep) -> TypedExpr =
  match s with
  | TDoBindStep _ value _ -> value
  | TDoLetStep _ value -> value
  | TDoExprStep value -> value

export fn field_value(f: TypedRecordField) -> TypedExpr =
  match f with
  | TypedRecordField _ value -> value

# What lowering, resolve and ast_to_ir read off the ClassDecls, keyed by the class
# name as declared: methods and direct superclasses in declaration order, and the
# first type parameter. Witness-slot layout needs all three passes to agree.
export type ClassTables (..) = (order: Dict (List String), supers: Dict (List String),
                                params: Dict String)

export fn class_tables(decls: List TypedDecl) -> ClassTables =
  list_fold(add_class_tables,
            ClassTables(order = dict_empty(), supers = dict_empty(), params = dict_empty()),
            decls)

fn add_class_tables(t: ClassTables, d: TypedDecl) -> ClassTables =
  match d with
  | TPassThrough (ast.ClassDecl name type_params methods supers _) ->
      ClassTables(order = dict_set(name, list_map(class_method_name, methods), t.order),
                  supers = dict_set(name, list_map(constraint_class, supers), t.supers),
                  params = first_param_at(name, type_params, t.params))
  | _ -> t

fn class_method_name(m: ast.ClassMethodSig) -> String =
  match m with
  | ast.ClassMethodSig name _ _ _ _ _ -> name

fn constraint_class(c: ast.TypeConstraint) -> String =
  match c with
  | ast.TypeConstraint name _ -> name

fn first_param_at(key: String, type_params: List String, d: Dict String) -> Dict String =
  match type_params with
  | Nil -> d
  | [p | _] -> dict_set(key, p, d)

# ---------------------------------------------------------------------------
# Result types for the typed pipeline
# ---------------------------------------------------------------------------

export type TypedResult (..) =
  | TypedOk TypedProgram (Dict types.Scheme)
  | TypedErr source.SourcePos String

export type InstanceMethodsResult (..) =
  | InstanceMethodsOk (List TypedInstanceMethod)
  | InstanceMethodsErr source.SourcePos String

# ---------------------------------------------------------------------------
# Type → TypeExpr conversion (used when constructing TDict constraint nodes)
# ---------------------------------------------------------------------------
#
# Converts an inferred types.Type back to a surface ast.TypeExpr.  This is
# used to store the constraint argument in TDict nodes so the lowering pass
# can reconstruct constraint keys without needing the full type-inference state.

export fn type_to_type_expr(t: types.Type) -> ast.TypeExpr =
  match t with
  | types.TVar name -> ast.TypeName(types.tyvar_identity(name))
  | types.TConst name -> ast.TypeName(types.type_id_name(name))
  | types.TApp f x -> ast.TypeApply(type_to_type_expr(f), type_to_type_expr(x))
  | types.TFunc a b _ own ->
      ast.TypeArrow(type_to_type_expr(a), type_to_type_expr(b), Nothing, mode_of_ownership(own))
  | types.TThunk b _ -> ast.TypeThunk(type_to_type_expr(b), Nothing)
  | types.TTuple items -> ast.TupleType(list_map(\i -> type_to_type_expr(i), items))

# A resolved ownership read back as the mode that writes it. OwnConsume is
# ModeConsuming, the spelling that survives a round trip (see `mode_equal` in lint_pattern).
export fn mode_of_ownership(own: types.Ownership) -> ast.ParamMode =
  match own with
  | types.OwnBorrow -> ast.ModeBorrowing
  | types.OwnOnce -> ast.ModeOnce
  | types.OwnLocal -> ast.ModeLocal
  | types.OwnOnceLocal -> ast.ModeOnceLocal
  | types.OwnConsume -> ast.ModeConsuming

# ---------------------------------------------------------------------------
# Node census
# ---------------------------------------------------------------------------
#
# Total typed-expression nodes in a program.  An optimisation pass reports what
# it did as count-before minus count-after (docs/opt-passes-v0.md §M0), so one
# generic walker instruments every pass and a new pass needs no new counter.
#
# Declarations are frames, not nodes: only bodies count.  A do-step and a match
# branch DO count, so that deleting one shows a delta larger than the expression
# it carried.

export fn node_count(prog: TypedProgram) -> Int =
  match prog with
  | TypedProgram decls -> count_decls(decls)

fn count_decls(decls: List TypedDecl) -> Int =
  list_fold(\ (acc, d) -> acc + count_decl(d), 0, decls)

fn count_decl(d: TypedDecl) -> Int =
  match d with
  | TFnDecl _ _ _ _ _ body -> count_expr(body)
  | TExternFnDecl _ _ _ _ -> 0
  | TLetDecl _ value -> count_expr(value)
  | TInstanceDecl _ _ methods -> count_methods(methods)
  | TPassThrough _ -> 0

fn count_methods(methods: List TypedInstanceMethod) -> Int =
  list_fold(\ (acc, m) -> acc + count_method(m), 0, methods)

fn count_method(m: TypedInstanceMethod) -> Int =
  match m with
  | TypedInstanceMethod _ _ _ _ _ body -> count_expr(body)

fn count_exprs(es: List TypedExpr) -> Int =
  list_fold(\ (acc, e) -> acc + count_expr(e), 0, es)

fn count_expr(e: TypedExpr) -> Int =
  1 + count_children(e)

fn count_children(e: TypedExpr) -> Int =
  match e with
  | TVar _ _ _ -> 0
  | TInt _ _ _ -> 0
  | TFloat _ _ _ -> 0
  | TBool _ _ _ -> 0
  | TString _ _ _ -> 0
  | TChar _ _ _ -> 0
  | TUnit _ _ -> 0
  | TTuple items _ _ -> count_exprs(items)
  | TIf cond then_e else_e _ _ -> count_expr(cond) + count_expr(then_e) + count_expr(else_e)
  | TMatch scrut branches _ _ -> count_expr(scrut) + count_branches(branches)
  | TCall callee args _ _ -> count_expr(callee) + count_exprs(args)
  | TDict _ _ _ _ -> 0
  | TMethodRef _ _ _ _ _ -> 0
  | TLambda _ body _ _ -> count_expr(body)
  | TBinary _ left right _ _ -> count_expr(left) + count_expr(right)
  | TUnary _ operand _ _ -> count_expr(operand)
  | TRange lo hi _ _ -> count_expr(lo) + count_expr(hi)
  | TDo steps _ _ -> count_steps(steps)
  | TRecord _ fields _ _ -> count_fields(fields)
  | TGetField base _ _ _ -> count_expr(base)
  | TRecordUpdate base fields _ _ -> count_expr(base) + count_fields(fields)

fn count_branches(branches: List TypedMatchBranch) -> Int =
  list_fold(\ (acc, b) -> acc + count_branch(b), 0, branches)

fn count_branch(b: TypedMatchBranch) -> Int =
  match b with
  | TypedMatchBranch _ body -> 1 + count_expr(body)

fn count_steps(steps: List TypedDoStep) -> Int =
  list_fold(\ (acc, s) -> acc + count_step(s), 0, steps)

fn count_step(s: TypedDoStep) -> Int =
  match s with
  | TDoBindStep _ value _ -> 1 + count_expr(value)
  | TDoLetStep _ value -> 1 + count_expr(value)
  | TDoExprStep value -> 1 + count_expr(value)

fn count_fields(fields: List TypedRecordField) -> Int =
  list_fold(\ (acc, f) -> acc + count_field(f), 0, fields)

fn count_field(f: TypedRecordField) -> Int =
  match f with
  | TypedRecordField _ value -> 1 + count_expr(value)


# ---------------------------------------------------------------------------
# Dispatch keys
# ---------------------------------------------------------------------------
#
# What dispatch tables are found under. Only this module builds a key, so one cannot
# be spelled by hand somewhere that disagrees with the rest. Instance keys and slot
# keys are distinct types, and each has its own table, so neither finds the other's.

# An instance's key: the class, then the outermost constructor of each argument:
# `Show_List`, `main.Eq_Int`. Both keep their full names, so a file's own `Eq` and
# the prelude's do not share a key.
export wrap InstanceKey = String

export fn instance_key_text(key: InstanceKey) -> String =
  match key with
  | InstanceKey s -> s

export fn constraint_key_from_tc(c: ast.TypeConstraint) -> InstanceKey =
  match c with
  | ast.TypeConstraint class_name type_args -> constraint_key_str(class_name, type_args)

export fn constraint_key_str(class_name: String, type_args: List ast.TypeExpr) -> InstanceKey =
  InstanceKey(string.join("_", Cons(class_name, list_map(type_expr_head_name, type_args))))

# The key of `class_name`'s instance for the constructor `head`.
export fn instance_key(class_name: String, head: String) -> InstanceKey =
  InstanceKey(class_name ++ "_" ++ head)

# A table found by instance key.
export wrap InstanceTable v = Dict v

export fn instance_table_empty() -> InstanceTable v = InstanceTable(dict_empty())

export fn instance_get(key: InstanceKey, table: InstanceTable v) -> Maybe v =
  match table with
  | InstanceTable d -> dict_get(instance_key_text(key), d)

export fn instance_set(key: InstanceKey, value: v, table: InstanceTable v) -> InstanceTable v =
  match table with
  | InstanceTable d -> InstanceTable(dict_set(instance_key_text(key), value, d))

export fn instance_member(key: InstanceKey, table: InstanceTable v) -> Bool =
  match table with
  | InstanceTable d -> dict_member(instance_key_text(key), d)

# The key a function's hidden dictionary slot is found under: the class, then each
# argument in full, variables by source name — `ToString_a`, `ToString_List(a)`,
# `ToString_(a,b)`. Instance keys name the head constructor only; a slot key must
# name the variables too, or a `ToString (List String)` request inside a body reads
# the slot declared for `List a`. Held as parts, so nothing reads them back out of text.
export type SlotKey deriving (Eq) =
  | SlotKey String (List String)

export fn dict_slot_key(class_name: String, args: List ast.TypeExpr) -> SlotKey =
  SlotKey(class_name, list_map(slot_key_arg, args))

export fn slot_key_text(key: SlotKey) -> String =
  match key with
  | SlotKey class_name args -> string.join("_", Cons(class_name, args))

# The slot's argument as the key spells it, when it has exactly one: `a` in
# `ToString_a`, `List(a)` in `ToString_List(a)`.
export fn slot_key_sole_arg(key: SlotKey) -> Maybe String =
  match key with
  | SlotKey _ [arg] -> Just(arg)
  | _ -> Nothing

fn slot_key_arg(te: ast.TypeExpr) -> String =
  match te with
  | ast.TypeName n -> n
  | ast.TypeApply _ _ -> slot_key_applied(te, Nil)
  | ast.TupleType items -> "(" ++ string.join(",", list_map(slot_key_arg, items)) ++ ")"
  | ast.TypeArrow _ _ _ _ -> "Fn"
  | ast.TypeThunk _ _ -> "Fn"
  | ast.TypeEffect _ _ -> "Eff"

fn slot_key_applied(te: ast.TypeExpr, args: List ast.TypeExpr) -> String =
  match te with
  | ast.TypeApply base arg -> slot_key_applied(base, Cons(arg, args))
  | ast.TypeName _ -> slot_key_arg(te) ++ "(" ++ string.join(",", list_map(slot_key_arg, args)) ++ ")"
  | ast.TupleType _ -> slot_key_arg(te) ++ "(" ++ string.join(",", list_map(slot_key_arg, args)) ++ ")"
  | ast.TypeArrow _ _ _ _ -> slot_key_arg(te)
  | ast.TypeThunk _ _ -> slot_key_arg(te)
  | ast.TypeEffect _ _ -> slot_key_arg(te)

# A table found by slot key. It keeps each key beside its value, so slot_entries hands
# back the key as built.
export wrap SlotTable v = Dict(SlotKey, v)

export fn slot_table_empty() -> SlotTable v = SlotTable(dict_empty())

export fn slot_get(key: SlotKey, table: SlotTable v) -> Maybe v =
  match table with
  | SlotTable d ->
      let Just(_, value) = dict_get(slot_key_text(key), d) else Nothing
      in Just(value)

export fn slot_set(key: SlotKey, value: v, table: SlotTable v) -> SlotTable v =
  match table with
  | SlotTable d -> SlotTable(dict_set(slot_key_text(key), (key, value), d))

export fn slot_entries(table: SlotTable v) -> List (SlotKey, v) =
  match table with
  | SlotTable d -> list_map(slot_entry, vec_to_list(dict_entries(d)))

fn slot_entry(entry: (String, (SlotKey, v))) -> (SlotKey, v) =
  let (_, kv) = entry
  in kv

# The outermost constructor, with function and effect types named `Fn` and `Eff`.
export fn type_expr_head_name(te: ast.TypeExpr) -> String =
  match applied_base(te) with
  | ast.TypeArrow _ _ _ _ -> "Fn"
  | ast.TypeThunk _ _ -> "Fn"
  | ast.TypeEffect _ _ -> "Eff"
  | base -> maybe_with_default("", type_expr_head(base))

# The outermost constructor, or Nothing for a function or effect type. A tuple
# includes its arity so pairs and triples differ.
export fn type_expr_head(te: ast.TypeExpr) -> Maybe String =
  match applied_base(te) with
  | ast.TypeName name -> Just(name)
  | ast.TupleType items -> Just(types.tuple_head(list_length(items)))
  | ast.TypeApply _ _ -> Nothing
  | ast.TypeArrow _ _ _ _ -> Nothing
  | ast.TypeThunk _ _ -> Nothing
  | ast.TypeEffect _ _ -> Nothing

# The type an application is built on: `Dict k v` is built on `Dict`.
fn applied_base(te: ast.TypeExpr) -> ast.TypeExpr =
  match te with
  | ast.TypeApply base _ -> applied_base(base)
  | _ -> te
