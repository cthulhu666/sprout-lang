module stdlib.compiler.ast
import stdlib.compiler.source as source

# --- Type Expressions ---
# No source positions: type exprs are always sub-components of larger nodes
# whose positions carry the error context.

export type TypeExpr (..) =
  | TypeName String
  | TypeApply TypeExpr TypeExpr
  | TypeArrow TypeExpr TypeExpr (Maybe (List String))
  | TypeEffect TypeExpr (List String)
  | TupleType (List TypeExpr)

# --- Patterns ---

export type Pattern (..) =
  | WildcardPattern source.SourcePos
  | VarPattern String source.SourcePos
  | IntPattern Int source.SourcePos
  | BoolPattern Bool source.SourcePos
  | StringPattern String source.SourcePos
  | CharPattern Int source.SourcePos
  | UnitPattern source.SourcePos
  | TuplePattern (List Pattern) source.SourcePos
  | ConstructorPattern String (List Pattern) source.SourcePos

# Position of a pattern — every Pattern variant carries a SourcePos last. Used so
# pattern-inference type errors report the offending pattern's location (#5).
export fn pattern_pos(p: Pattern) -> source.SourcePos =
  match p with
  | WildcardPattern pos -> pos
  | VarPattern _ pos -> pos
  | IntPattern _ pos -> pos
  | BoolPattern _ pos -> pos
  | StringPattern _ pos -> pos
  | CharPattern _ pos -> pos
  | UnitPattern pos -> pos
  | TuplePattern _ pos -> pos
  | ConstructorPattern _ _ pos -> pos

# --- Function parameters ---

export type Param (..) =
  | Param String (Maybe TypeExpr)

# --- Match branches and do steps (forward-reference Expr defined below) ---

export type MatchBranch (..) =
  | MatchBranch Pattern Expr

export type DoStep (..) =
  | DoBindStep Pattern Expr
  | DoLetStep String Expr
  | DoExprStep Expr

# A name=value field in a record literal: RecordField "x" expr
export type RecordField (..) =
  | RecordField String Expr

# --- Expressions ---

export type Expr (..) =
  | VarExpr String source.SourcePos
  | IntExpr Int source.SourcePos
  | FloatExpr String source.SourcePos
  | BoolExpr Bool source.SourcePos
  | StringExpr String source.SourcePos
  | StringTemplateExpr (List TemplateExprPart) source.SourcePos
  | CharExpr Int source.SourcePos
  | UnitExpr source.SourcePos
  | TupleExpr (List Expr) source.SourcePos
  | IfExpr Expr Expr Expr source.SourcePos
  | MatchExpr Expr (List MatchBranch) source.SourcePos
  | CallExpr Expr (List Expr) source.SourcePos
  | LambdaExpr (List Param) Expr source.SourcePos
  | BinaryExpr String Expr Expr source.SourcePos
  | UnaryExpr String Expr source.SourcePos
  | IntRangeExpr Expr Expr source.SourcePos
  | DoExpr (List DoStep) source.SourcePos
  | RecordExpr String (List RecordField) source.SourcePos
  | GetFieldExpr Expr String source.SourcePos
  # Functional record update `base with (field = value, ...)` (docs/records-v0.md §4.4).
  | RecordUpdateExpr Expr (List RecordField) source.SourcePos

# --- Template literal parts (Experimental — Phase 1 AST stub) ---
# Parser wiring happens in Phase 3; this variant is unreachable until then.

export type TemplateExprPart (..) =
  | LitPart String
  | InterpPart Expr

# --- Shared helpers used in declarations ---

export type TypeConstraint (..) =
  | TypeConstraint String (List TypeExpr)

# TypeConstructor name fields exist_vars exist_constraints
# exist_vars: existentially-bound type variables introduced by an `exists` prefix
# (`| exists a. Boxed a`); they scope over the fields but are ABSENT from the type
# head, so `Boxed(x)` hides x's type. Nil for an ordinary constructor.
# exist_constraints: class constraints on those vars (Stage 0b, `any C` sugar);
# always Nil in Stage 0a. See docs/gadts-v0.md §6.
export type TypeConstructor (..) =
  | TypeConstructor String (List TypeExpr) (List String) (List TypeConstraint)

export type RecordFieldDecl (..) =
  | RecordFieldDecl String TypeExpr

# fn signature inside a class declaration
export type ClassMethodSig (..) =
  | ClassMethodSig String (List Param) TypeExpr (Maybe (List String))

# fn implementation inside an instance declaration
export type InstanceMethodImpl (..) =
  | InstanceMethodImpl String (List Param) (Maybe TypeExpr) (Maybe (List String)) Expr

# --- Top-level declarations ---
#
# FnDecl name params return_type effects constraints body pos
# TypeDecl name type_params constructors deriving_classes pos
# RecordDecl name type_params fields deriving_classes pos
# LetDecl name body type_annotation pos
# ClassDecl name type_params methods superclasses pos
# InstanceDecl constraint instance_constraints methods pos
# AliasDecl name type_params rhs pos
# WrapDecl  name inner_type pos
#
# TypeDecl and RecordDecl both carry deriving_classes: the (possibly empty)
# list of class names from a `deriving (...)` clause; an empty list means no
# clause was present. On records the clause is trailing (after the field list).
# See docs/deriving-v1-draft.md and docs/deriving-records-v0.md.
#
# WrapDecl is a zero-cost distinct type. `wrap Foo = T` declares Foo with a
# single constructor Foo(x: T) -> Foo. Construction Foo(x) and destruction
# `match | Foo x ->` are identity at the LLVM IR level (no alloc, no field
# read).

export type Decl (..) =
  | FnDecl String (List Param) (Maybe TypeExpr) (Maybe (List String)) (List TypeConstraint) Expr source.SourcePos
  | ExternFnDecl String (List Param) (Maybe TypeExpr) (Maybe (List String)) source.SourcePos
  | TypeDecl String (List String) (List TypeConstructor) (List String) source.SourcePos
  | RecordDecl String (List String) (List RecordFieldDecl) (List String) source.SourcePos
  | LetDecl String Expr (Maybe TypeExpr) source.SourcePos
  | ClassDecl String (List String) (List ClassMethodSig) (List TypeConstraint) source.SourcePos
  | InstanceDecl TypeConstraint (List TypeConstraint) (List InstanceMethodImpl) source.SourcePos
  | AliasDecl String (List String) TypeExpr source.SourcePos
  | WrapDecl String TypeExpr source.SourcePos

# Position of a declaration — every Decl variant carries a SourcePos in its last
# field. Used at diagnostic-construction seams so bundle-time errors report the
# offending declaration's location (guideline #5).
export fn decl_pos(d: Decl) -> source.SourcePos =
  match d with
  | FnDecl _ _ _ _ _ _ p -> p
  | ExternFnDecl _ _ _ _ p -> p
  | TypeDecl _ _ _ _ p -> p
  | RecordDecl _ _ _ _ p -> p
  | LetDecl _ _ _ p -> p
  | ClassDecl _ _ _ _ p -> p
  | InstanceDecl _ _ _ p -> p
  | AliasDecl _ _ _ p -> p
  | WrapDecl _ _ p -> p

# --- Program ---

export type Program (..) =
  | Program (List Decl) source.SourcePos

# --- Synthesized identifier names ---
# Source-level names of the List constructors, used when the parser/checker
# build List AST nodes (VarExpr/CallExpr/ConstructorPattern) during desugaring.
export let list_ctor_nil = "Nil"
export let list_ctor_cons = "Cons"

# Source-level names of the TemplatePart constructors, used by checker.sprout
# when lowering a StringTemplateExpr into the StringTemplate ADT.
export let template_ctor_lit = "TemplateLit"
export let template_ctor_interp = "TemplateInterp"
