module stdlib.compiler.ast
import stdlib.compiler.source as source
import stdlib.string as string

# --- Type Expressions ---
# No source positions: type exprs are always sub-components of larger nodes
# whose positions carry the error context.

# TypeThunk is `() -> T`: an arrow with no parameter, NOT `Unit -> T`. The two
# are different types and a `fn f()` declaration means the former.
#
# TypeArrow's ParamMode is how its parameter is taken, written `(borrowing T) -> R`.
# It mirrors types.TFunc's Ownership, so a function-typed parameter over a linear
# value can say whether calling it discharges the caller's obligation. The slot
# is on the arrow rather than on a wrapper variant so a mode is unrepresentable
# anywhere but a parameter position.
export type TypeExpr (..) =
  | TypeName String
  | TypeApply TypeExpr TypeExpr
  | TypeArrow TypeExpr TypeExpr (Maybe (List String)) ParamMode
  | TypeThunk TypeExpr (Maybe (List String))
  | TypeEffect TypeExpr (List String)
  | TupleType (List TypeExpr)

# --- Patterns ---

export type Pattern (..) =
  | WildcardPattern source.SourcePos
  | VarPattern String source.SourcePos
  | IntPattern Int source.SourcePos
  | BoolPattern Bool source.SourcePos
  | StringPattern String source.SourcePos
  | CharPattern Int source.SourcePos
  | UnitPattern source.SourcePos
  | TuplePattern (List Pattern) source.SourcePos
  | ConstructorPattern String (List Pattern) source.SourcePos

# Position of a pattern — every Pattern variant carries a SourcePos last. Used so
# pattern-inference type errors report the offending pattern's location (#5).
export fn pattern_pos(p: Pattern) -> source.SourcePos =
  match p with
  | WildcardPattern pos -> pos
  | VarPattern _ pos -> pos
  | IntPattern _ pos -> pos
  | BoolPattern _ pos -> pos
  | StringPattern _ pos -> pos
  | CharPattern _ pos -> pos
  | UnitPattern pos -> pos
  | TuplePattern _ pos -> pos
  | ConstructorPattern _ _ pos -> pos

# Every variable name a pattern binds, in source order. A constructor's NAME is not
# a binder — only its sub-patterns bind. Exhaustive on every variant so a new one
# surfaces here at compile time instead of being silently dropped.
# O(n) in pattern node count.
export fn pattern_names(pat: Pattern) -> List String =
  list_reverse(pattern_names_go(pat, Nil))

# Prepend-and-reverse-once: `list_append` per node would make this O(n²).
fn pattern_names_go(pat: Pattern, acc: List String) -> List String =
  match pat with
  | VarPattern name _ -> Cons(name, acc)
  | WildcardPattern _ -> acc
  | IntPattern _ _ -> acc
  | BoolPattern _ _ -> acc
  | StringPattern _ _ -> acc
  | CharPattern _ _ -> acc
  | UnitPattern _ -> acc
  | TuplePattern pats _ -> pattern_names_list_go(pats, acc)
  | ConstructorPattern _ pats _ -> pattern_names_list_go(pats, acc)

fn pattern_names_list_go(pats: List Pattern, acc: List String) -> List String =
  match pats with
  | Nil -> acc
  | Cons p rest -> pattern_names_list_go(rest, pattern_names_go(p, acc))

# --- Function parameters ---

# How a parameter takes ownership of a LINEAR argument (M4.5 borrowing). An enum
# rather than a Bool for the same reason as `Multiplicity` below: the concept is
# not binary, and an `inout`/mutable-borrow case is the natural future addition.
#
# ModeDefault and ModeConsuming mean the same thing to the linear checker — passing
# a linear value IS a consume, so an unmodified parameter is already consuming. They
# stay distinct because only ModeConsuming was WRITTEN by the author, and that
# difference is what lets "modifier on a non-linear parameter" be an error without
# firing on every ordinary unmodified parameter in the tree.
# See docs/linear-borrowing-v0.md.
export type ParamMode (..) =
  | ModeDefault  # no modifier written — consuming, and silent on non-linear types
  | ModeBorrowing  # `borrowing` — a non-consuming use; the caller keeps the obligation
  | ModeConsuming  # `consuming` — explicit spelling of the default, documents the API
  | ModeOnce  # `once` — the callee invokes this closure AT MOST ONCE (M4.4a)

export type Param (..) =
  | Param String (Maybe TypeExpr) ParamMode

# The distinctions that survive into the TYPE: `types.Ownership` is three-valued
# (M4.4a), collapsing only ModeDefault and ModeConsuming, which are the same
# ownership. Both predicates return Bool so `ast` need not depend on `types` —
# neither module imports the other — and the consumer pairs them with
# `types.ownership_of_mode`.
export fn mode_is_borrowing(m: ParamMode) -> Bool =
  match m with
  | ModeBorrowing -> true
  | _ -> false

# `once` is orthogonal to borrow-vs-consume: it bounds how often the callee may
# INVOKE the parameter, not how the parameter is taken. It shares the modifier
# slot (and hence `Ownership`) because no parameter needs both — a one-shot
# closure is passed by value like any other consuming argument.
export fn mode_is_once(m: ParamMode) -> Bool =
  match m with
  | ModeOnce -> true
  | _ -> false

# The way back, for a TypeExpr rebuilt from a resolved type (an eta wrapper's
# annotation, a constraint key). Takes the same Bool pair the predicates above
# return — `types.ownership_is_borrow`/`ownership_is_once` supply them — so the
# two modules still need not know each other. ModeConsuming, not ModeDefault:
# the two are the same ownership and only one of them survives a round trip.
export fn mode_of_flags(is_borrow: Bool, is_once: Bool) -> ParamMode =
  if is_borrow then ModeBorrowing
  else if is_once then ModeOnce
  else ModeConsuming

export fn param_mode_of(p: Param) -> ParamMode =
  match p with
  | Param _ _ m -> m

# --- Match branches and do steps (forward-reference Expr defined below) ---

export type MatchBranch (..) =
  | MatchBranch Pattern Expr

export type DoStep (..) =
  | DoBindStep Pattern Expr
  | DoLetStep String Expr
  | DoExprStep Expr

# A name=value field in a record literal: RecordField "x" expr
export type RecordField (..) =
  | RecordField String Expr

# One generator of a list comprehension: `<pat> in <source>` plus the guards
# that trail it. A guard belongs to the generator it follows, so a guard on an
# outer generator skips the inner loops entirely
# (docs/list-comprehensions-v0.md §5). The pattern must be irrefutable; that is
# checked in inference, not here.
export type ComprehensionGen (..) =
  | ComprehensionGen Pattern Expr (List Expr)

# --- Expressions ---

export type Expr (..) =
  | VarExpr String source.SourcePos
  | IntExpr Int source.SourcePos
  | FloatExpr String source.SourcePos
  | BoolExpr Bool source.SourcePos
  | StringExpr String source.SourcePos
  | StringTemplateExpr (List TemplateExprPart) source.SourcePos
  | CharExpr Int source.SourcePos
  | UnitExpr source.SourcePos
  | TupleExpr (List Expr) source.SourcePos
  | IfExpr Expr Expr Expr source.SourcePos
  | MatchExpr Expr (List MatchBranch) source.SourcePos
  | CallExpr Expr (List Expr) source.SourcePos
  | LambdaExpr (List Param) Expr source.SourcePos
  | BinaryExpr String Expr Expr source.SourcePos
  | UnaryExpr String Expr source.SourcePos
  | IntRangeExpr Expr Expr source.SourcePos
  | DoExpr (List DoStep) source.SourcePos
  | RecordExpr String (List RecordField) source.SourcePos
  | GetFieldExpr Expr String source.SourcePos
  # Functional record update `base with (field = value, ...)` (docs/records-v0.md §4.4).
  | RecordUpdateExpr Expr (List RecordField) source.SourcePos
  # List comprehension `[elem for p in src if g, q in src2]`
  # (docs/list-comprehensions-v0.md). Element expression, then one or more
  # generators, leftmost outermost. Typed natively in `infer` and rewritten to
  # folds by a post-inference pass, so this node never reaches lowering.
  | ComprehensionExpr Expr (List ComprehensionGen) source.SourcePos

# --- Template literal parts (Experimental — Phase 1 AST stub) ---
# Parser wiring happens in Phase 3; this variant is unreachable until then.

export type TemplateExprPart (..) =
  | LitPart String
  | InterpPart Expr

# --- Shared helpers used in declarations ---

export type TypeConstraint (..) =
  | TypeConstraint String (List TypeExpr)

# TypeConstructor name fields exist_vars exist_constraints
# exist_vars: existentially-bound type variables introduced by an `exists` prefix
# (`| exists a. Boxed a`); they scope over the fields but are ABSENT from the type
# head, so `Boxed(x)` hides x's type. Nil for an ordinary constructor.
# exist_constraints: class constraints on those vars (Stage 0b, `any C` sugar);
# always Nil in Stage 0a. See docs/gadts-v0.md §6.
export type TypeConstructor (..) =
  | TypeConstructor String (List TypeExpr) (List String) (List TypeConstraint)

export type RecordFieldDecl (..) =
  | RecordFieldDecl String TypeExpr

# ClassMethodSig name params ret effects constraints
# constraints: a `where` on the METHOD, over a variable the method quantifies
# rather than the class variable. Its dictionary is a hidden parameter resolved
# per call site; the class variable's comes from dispatch.
export type ClassMethodSig (..) =
  | ClassMethodSig String (List Param) TypeExpr (Maybe (List String)) (List TypeConstraint)

# InstanceMethodImpl name params ret effects constraints body
# constraints: the method-level `where` restated over THIS implementation's
# variables, which it may name differently from the class declaration.
export type InstanceMethodImpl (..) =
  | InstanceMethodImpl String (List Param) (Maybe TypeExpr) (Maybe (List String)) (List TypeConstraint) Expr

# --- Top-level declarations ---
#
# FnDecl name params return_type effects constraints body pos
# TypeDecl name type_params constructors deriving_classes multiplicity pos
# RecordDecl name type_params fields deriving_classes multiplicity representation pos
# LetDecl name body type_annotation pos
# ClassDecl name type_params methods superclasses pos
# InstanceDecl constraint instance_constraints methods pos
# AliasDecl name type_params rhs pos
# WrapDecl  name type_params inner_type deriving_classes pos
#
# TypeDecl, RecordDecl and WrapDecl all carry deriving_classes: the (possibly
# empty) list of class names from a `deriving (...)` clause; an empty list means
# no clause was present. On records and wraps the clause is trailing (after the
# field list / the RHS type).
# See docs/deriving-v1-draft.md and docs/deriving-records-v0.md.
#
# multiplicity (the Multiplicity before pos): how values of this type must be
# used. `type Name = ...` is Unrestricted; `type linear Name = ...` is Linear
# (per-declaration marker, M4.1). M4.1 parses + records it but does not yet enforce
# use-once (that is M4.2). See docs/linear-types-m4-scoping-2026-08-01.md.
#
# representation (the Representation before pos): whether the declaration wrote
# `(..)`. Recorded on the declaration rather than derived from the export list
# because the export list is a token pre-scan the bundler consumes, while this
# bit has to survive into inference, where field access is resolved.
#
# WrapDecl is a zero-cost distinct type. `wrap Foo = T` declares Foo with a
# single constructor Foo(x: T) -> Foo. Construction Foo(x) and destruction
# `match | Foo x ->` are identity at the LLVM IR level (no alloc, no field
# read).
#
# type_params are erased: `wrap Tagged u = Int` gives every `Tagged u` the same
# representation as Int, so a parameter the RHS never mentions costs nothing.

# Usage discipline for a declared type. A multiplicity, not a boolean: the concept
# is inherently non-binary (cf. Idris 2 QTT 0/1/ω, Linear Haskell One/Many). M4.1
# seeds the two cases it can act on; Affine (at-most-once), Relevant (at-least-once)
# and Erased (compile-time-only) are the natural future additions. Matches that
# ignore the field with `_` are unaffected when a case is added.
export type Multiplicity (..) =
  | Unrestricted  # default — use any number of times (ω)
  | Linear  # must be used exactly once (=1)

# Whether a record declaration published its representation. `(..)` on the
# declaration publishes the constructor AND the fields, so `P(x = 1)`, `p.x` and
# `p with (x = 1)` all work from anywhere; without the marker the type may still
# be exported, but only the declaring module can reach through it — the same
# thing `(..)` means on a sum, applied to the one shape that has fields instead
# of constructors (spec-v0 §5.6.4).
#
# Not a Bool: the reading site asks "is this abstract HERE", and `Abstract`
# answers that in the source where `false` would not.
export type Representation (..) =
  | Published  # `(..)` — constructor and fields are part of the module's surface
  | Abstract  # no marker — representation is private to the declaring module

export type Decl (..) =
  | FnDecl String (List Param) (Maybe TypeExpr) (Maybe (List String)) (List TypeConstraint) Expr source.SourcePos
  | ExternFnDecl String (List Param) (Maybe TypeExpr) (Maybe (List String)) source.SourcePos
  | TypeDecl String (List String) (List TypeConstructor) (List String) Multiplicity source.SourcePos
  | RecordDecl String (List String) (List RecordFieldDecl) (List String) Multiplicity Representation source.SourcePos
  | LetDecl String Expr (Maybe TypeExpr) source.SourcePos
  | ClassDecl String (List String) (List ClassMethodSig) (List TypeConstraint) source.SourcePos
  | InstanceDecl TypeConstraint (List TypeConstraint) (List InstanceMethodImpl) source.SourcePos
  | AliasDecl String (List String) TypeExpr source.SourcePos
  | WrapDecl String (List String) TypeExpr (List String) source.SourcePos

# Position of a declaration — every Decl variant carries a SourcePos in its last
# field. Used at diagnostic-construction seams so bundle-time errors report the
# offending declaration's location (guideline #5).
export fn decl_pos(d: Decl) -> source.SourcePos =
  match d with
  | FnDecl _ _ _ _ _ _ p -> p
  | ExternFnDecl _ _ _ _ p -> p
  | TypeDecl _ _ _ _ _ p -> p
  | RecordDecl _ _ _ _ _ _ p -> p
  | LetDecl _ _ _ p -> p
  | ClassDecl _ _ _ _ p -> p
  | InstanceDecl _ _ _ p -> p
  | AliasDecl _ _ _ p -> p
  | WrapDecl _ _ _ _ p -> p

# --- Name scope: how an importer spells a declared value ---
#
# THE SINGLE AUTHORITY for this question. Sprout typechecks through two front
# ends — `bundler` inlines every module into one program, `module_loader` extracts
# `(name, Scheme)` pairs per module for the REPL/LSP — and both must agree on
# which names an importer sees and under what spelling. When each decided it
# per-constructor on its own they reached opposite answers for `ExternFnDecl`, and
# the REPL accepted code the compiler rejected. Consumers filter this; none
# re-decides it.
#
# `ScopeGlobal` is spec-v0 §"Externs are outside the module system": an extern is
# never qualified, never renamed, never in a module's exported set, and is
# reachable by bare name wherever its declaring module is part of the build —
# including transitively, and regardless of any selective import list.
export type NameScope (..) =
  | ScopeModule  # qualified canonically; visibility follows the import form
  | ScopeGlobal  # bare everywhere the declaring module is in the build

# Every value-level name a declaration introduces, each with its scope. Type and
# class names are a separate axis and are not listed; a `ClassDecl` contributes its
# method names, which are values.
export fn decl_value_scopes(d: Decl) -> List (String, NameScope) =
  match d with
  | FnDecl name _ _ _ _ _ _ -> [(name, ScopeModule)]
  | ExternFnDecl name _ _ _ _ -> [(name, ScopeGlobal)]
  | LetDecl name _ _ _ -> [(name, ScopeModule)]
  | TypeDecl _ _ ctors _ _ _ -> ctor_value_scopes(ctors)
  | ClassDecl _ _ methods _ _ -> method_value_scopes(methods)
  # WrapDecl: the synthetic constructor is a value sharing the type's name.
  | WrapDecl name _ _ _ _ -> [(name, ScopeModule)]
  | _ -> Nil

fn ctor_value_scopes(ctors: List TypeConstructor) -> List (String, NameScope) =
  match ctors with
  | Nil -> Nil
  | Cons (TypeConstructor name _ _ _) rest -> Cons((name, ScopeModule), ctor_value_scopes(rest))

fn method_value_scopes(methods: List ClassMethodSig) -> List (String, NameScope) =
  match methods with
  | Nil -> Nil
  | Cons (ClassMethodSig name _ _ _ _) rest -> Cons((name, ScopeModule), method_value_scopes(rest))

# The TYPE axis the comment above sets aside: every type-level name a declaration
# introduces. Together with decl_value_scopes this covers every name a declaration brings
# into scope, which is what a "where is this name declared" query needs.
#
# WrapDecl is absent on purpose: its name is already a value name (the synthetic
# constructor), so decl_value_scopes reports it and listing it here would duplicate.
export fn decl_type_names(d: Decl) -> List String =
  match d with
  | TypeDecl name _ _ _ _ _ -> [name]
  | RecordDecl name _ _ _ _ _ _ -> [name]
  | ClassDecl name _ _ _ _ -> [name]
  | AliasDecl name _ _ _ -> [name]
  | _ -> Nil

export fn scope_names_all(scoped: List (String, NameScope)) -> List String =
  match scoped with
  | Nil -> Nil
  | Cons (name, _) rest -> Cons(name, scope_names_all(rest))

export fn scope_names_module(scoped: List (String, NameScope)) -> List String =
  match scoped with
  | Nil -> Nil
  | Cons (name, ScopeModule) rest -> Cons(name, scope_names_module(rest))
  | Cons _ rest -> scope_names_module(rest)

export fn scope_names_global(scoped: List (String, NameScope)) -> List String =
  match scoped with
  | Nil -> Nil
  | Cons (name, ScopeGlobal) rest -> Cons(name, scope_names_global(rest))
  | Cons _ rest -> scope_names_global(rest)

# --- What a declaration stores ---
#
# "Does this declaration store a value of type parameter `p`?" — spec §5.8's
# phantom-position test: `p` appears in some field type, OUTSIDE an arrow.
#
# ONE definition, because two consumers must give the same answer. `infer`
# writes the `@phantom:` marker that `linear_check` reads; `deriving` decides
# which parameters an instance context constrains. A parameter that is phantom
# to one and stored to the other is incoherent, and these were separate copies
# held in step by a comment.
#
# The test is SYNTACTIC and one declaration deep: `u` in a field of type
# `Tagged u` counts as stored even where `Tagged` discards it. Following it
# through would mean resolving `Tagged`, which the bundler has no types for, so
# both consumers are conservative rather than exact
# (tests/conformance/type_error/deriving_phantom_nested_still_constrained).

export fn type_exprs_store(p: String, tes: List TypeExpr) -> Bool =
  match tes with
  | [] -> false
  | [te | rest] -> type_expr_stores(p, te) || type_exprs_store(p, rest)

# Every variant spelled out: a future TypeExpr carrying a parameter must not
# default to "not stored", which silently drops a constraint or a marker.
#
# Not `infer.te_type_names`, nor `analysis_service_driver.te_var_names`: both
# descend an arrow, and declining to is the whole point here.
export fn type_expr_stores(p: String, te: TypeExpr) -> Bool =
  match te with
  | TypeName n -> n == p
  | TypeApply f x -> type_expr_stores(p, f) || type_expr_stores(p, x)
  | TypeArrow _ _ _ _ -> false
  | TypeThunk _ _ -> false
  | TypeEffect inner _ -> type_expr_stores(p, inner)
  | TupleType items -> type_exprs_store(p, items)

export fn ctor_field_type_exprs(ctors: List TypeConstructor) -> List TypeExpr =
  match ctors with
  | [] -> []
  | [TypeConstructor _ fields _ _ | rest] ->
      list_append(fields, ctor_field_type_exprs(rest))

export fn record_field_type_exprs(fields: List RecordFieldDecl) -> List TypeExpr =
  match fields with
  | [] -> []
  | [RecordFieldDecl _ te | rest] -> Cons(te, record_field_type_exprs(rest))

# --- Alias expansion in instance heads ---
#
# A `type alias` is transparent (spec §5.6.2), so `instance C Name` where
# `type alias Name = String` is an instance at `String`. Instance keys are built
# from the head by four separate paths — `infer`'s two writers, `resolve`'s
# `type_expr_head_name` and `lowering`'s `constraint_key_from_tc` — and only the
# LOOKUP side starts from an inferred type, where the alias is already gone.
# Expanding the head once, here, is what keeps those four agreeing; fixing each
# path separately leaves four normalizations to keep in step.
#
# `wrap` is deliberately NOT expanded: it declares a distinct nominal type, so
# merging it with its representation would turn two instances into one.

type AliasHead =
  | AliasHead (List String) TypeExpr

# An alias cycle (`type alias A = B` with `type alias B = A`) would loop here.
# `infer.register_all_aliases` reports the cycle with a position; this pass only
# has to stop, leaving the head unexpanded so that diagnostic is the one to fire.
let alias_expand_fuel: Int = 100

export fn expand_alias_instance_heads(decls: List Decl) -> List Decl =
  expand_instance_heads(decls, alias_head_table(decls, dict_empty()))

# A declaration that is not an alias contributes no alias, which stays the right
# answer for a variant that does not exist yet — so the catch-all belongs here.
fn alias_head_table(decls: List Decl, acc: Dict AliasHead) -> Dict AliasHead =
  match decls with
  | [] -> acc
  | [AliasDecl name params rhs _ | rest] ->
      alias_head_table(rest, dict_set(name, AliasHead(params, rhs), acc))
  | [_ | rest] -> alias_head_table(rest, acc)

fn expand_instance_heads(decls: List Decl, table: Dict AliasHead) -> List Decl =
  match decls with
  | [] -> []
  | [InstanceDecl head ctx methods pos | rest] ->
      Cons(InstanceDecl(expand_constraint(table, head),
                        expand_constraints(table, ctx), methods, pos),
           expand_instance_heads(rest, table))
  | [d | rest] -> Cons(d, expand_instance_heads(rest, table))

fn expand_constraints(table: Dict AliasHead, cs: List TypeConstraint) -> List TypeConstraint =
  match cs with
  | [] -> []
  | [c | rest] -> Cons(expand_constraint(table, c), expand_constraints(table, rest))

fn expand_constraint(table: Dict AliasHead, c: TypeConstraint) -> TypeConstraint =
  match c with
  | TypeConstraint name args -> TypeConstraint(name, expand_type_exprs(table, args))

fn expand_type_exprs(table: Dict AliasHead, tes: List TypeExpr) -> List TypeExpr =
  match tes with
  | [] -> []
  | [te | rest] ->
      Cons(expand_head(table, te, alias_expand_fuel), expand_type_exprs(table, rest))

fn expand_head(table: Dict AliasHead, te: TypeExpr, fuel: Int) -> TypeExpr =
  if fuel <= 0 then te
  else
    match alias_expansion(table, te) with
    | Nothing -> te
    | Just next -> expand_head(table, next, fuel - 1)

# Rebuilds the head from the alias RHS with the alias's parameters bound to the
# arguments it was applied to, re-applying any extra arguments outside: under
# `type alias Half a = Tagged a`, the head `Half k` becomes `Tagged k`. An
# UNDER-applied alias yields Nothing — there is nothing to substitute, and the
# existing instance-head arity diagnostic is the right one to fire.
fn alias_expansion(table: Dict AliasHead, te: TypeExpr) -> Maybe TypeExpr =
  match type_expr_spine(te, []) with
  | (TypeName name, args) ->
      match dict_get(name, table) with
      | Nothing -> Nothing
      | Just (AliasHead params rhs) ->
          match bind_alias_params(params, args, dict_empty()) with
          | Nothing -> Nothing
          | Just (sub, extra) ->
              Just(apply_type_exprs(subst_type_expr(sub, rhs), extra))
  | _ -> Nothing

# Nothing when the alias is applied to fewer arguments than it declares.
fn bind_alias_params(params: List String, args: List TypeExpr, acc: Dict TypeExpr)
    -> Maybe (Dict TypeExpr, List TypeExpr) =
  match params with
  | [] -> Just((acc, args))
  | [p | prest] ->
      match args with
      | [] -> Nothing
      | [a | arest] -> bind_alias_params(prest, arest, dict_set(p, a, acc))

fn apply_type_exprs(base: TypeExpr, args: List TypeExpr) -> TypeExpr =
  match args with
  | [] -> base
  | [a | rest] -> apply_type_exprs(TypeApply(base, a), rest)

# Every variant spelled out: a future TypeExpr carrying a nested type must not
# default to "no substitution", which would leave an alias parameter unbound
# inside it.
fn subst_type_expr(sub: Dict TypeExpr, te: TypeExpr) -> TypeExpr =
  match te with
  | TypeName n ->
      match dict_get(n, sub) with
      | Just bound -> bound
      | Nothing -> te
  | TypeApply f x -> TypeApply(subst_type_expr(sub, f), subst_type_expr(sub, x))
  | TypeArrow p r vs mode ->
      TypeArrow(subst_type_expr(sub, p), subst_type_expr(sub, r), vs, mode)
  | TypeThunk r vs -> TypeThunk(subst_type_expr(sub, r), vs)
  | TypeEffect inner es -> TypeEffect(subst_type_expr(sub, inner), es)
  | TupleType items -> TupleType(subst_type_exprs(sub, items))

fn subst_type_exprs(sub: Dict TypeExpr, tes: List TypeExpr) -> List TypeExpr =
  match tes with
  | [] -> []
  | [te | rest] -> Cons(subst_type_expr(sub, te), subst_type_exprs(sub, rest))

# A head's application spine: its base and the arguments applied to it, in source
# order. Only TypeApply continues a spine; anything else IS the base.
fn type_expr_spine(te: TypeExpr, acc: List TypeExpr) -> (TypeExpr, List TypeExpr) =
  match te with
  | TypeApply f x -> type_expr_spine(f, Cons(x, acc))
  | TypeName _ -> (te, acc)
  | TypeArrow _ _ _ _ -> (te, acc)
  | TypeThunk _ _ -> (te, acc)
  | TypeEffect _ _ -> (te, acc)
  | TupleType _ -> (te, acc)

# --- Program ---

export type Program (..) =
  | Program (List Decl) source.SourcePos

# --- Name case, and the syntactic value restriction ---
#
# Both answer questions about the AST alone, and both have two readers: `infer`
# decides what to generalize, `lint_rules` decides what could have been written
# as a top-level `let`. They live here so the two cannot drift — a lint rule
# that disagreed with the type checker about what a value is would recommend
# rewrites the checker then refuses.

export fn is_lowercase_name(name: String) -> Bool =
  str_find(name, ".") == -1 &&
  (c == "a" || c == "b" || c == "c" || c == "d" || c == "e" ||
   c == "f" || c == "g" || c == "h" || c == "i" || c == "j" ||
   c == "k" || c == "l" || c == "m" || c == "n" || c == "o" ||
   c == "p" || c == "q" || c == "r" || c == "s" || c == "t" ||
   c == "u" || c == "v" || c == "w" || c == "x" || c == "y" || c == "z")
  where c = str_slice(name, 0, 1)

# A call whose callee is a data constructor (uppercase head), not a function.
# Constructor applications of values are syntactic values; function calls are not.
export fn is_constructor_ref(name: String) -> Bool =
  is_lowercase_name(string.after_last_dot(name)) == false

# Syntactic value restriction (W3/F-VALRESTR): only generalize a top-level `let`
# whose initializer is a syntactic value — a literal, variable, lambda, tuple of
# values, or constructor applied to values. A function/if/match/do/... initializer
# is monomorphic. Without this, `let cell = mutvec_new(1, Nil)` generalized to
# `forall a. MutVec (List a)` and could be written at Int and read at String.
#
# A list literal needs no arm: `[a, b]` is already `Cons(a, Cons(b, Nil))` by the
# time it arrives (parser.desugar_list_literal).
export fn is_syntactic_value(expr: Expr) -> Bool =
  match expr with
  | IntExpr _ _ -> true
  | FloatExpr _ _ -> true
  | BoolExpr _ _ -> true
  | StringExpr _ _ -> true
  | CharExpr _ _ -> true
  | UnitExpr _ -> true
  | VarExpr _ _ -> true
  | LambdaExpr _ _ _ -> true
  | TupleExpr items _ -> all_syntactic_values(items)
  | CallExpr callee args _ ->
      match callee with
      | VarExpr name _ -> is_constructor_ref(name) && all_syntactic_values(args)
      | _ -> false
  | _ -> false

export fn all_syntactic_values(exprs: List Expr) -> Bool =
  match exprs with
  | Nil -> true
  | Cons h t -> if is_syntactic_value(h) then all_syntactic_values(t) else false

# --- Synthesized identifier names ---
# Source-level names of the List constructors, used when the parser/checker
# build List AST nodes (VarExpr/CallExpr/ConstructorPattern) during desugaring.
export let list_ctor_nil = "Nil"
export let list_ctor_cons = "Cons"

# Prefix of every binder the comprehension elaboration invents (infer.comp_tmp_name).
# Shared because linear_check reads it back: a lambda carrying such a binder is
# code the user never wrote, so its diagnostics must name the generator rather
# than the synthesized lambda, and must never print the binder itself.
export let comp_binder_prefix = "__cmp_"

# Prefix of the parameters the `_`-hole desugaring invents (parser.ph_param_name).
# Shared for the same reason as the above: the user wrote `_`, not this name, so a
# diagnostic about such a parameter must say `_` and never print the binder.
export let placeholder_param_prefix = "__sprout_ph_"

# Source-level names of the TemplatePart constructors, used by checker.sprout
# when lowering a StringTemplateExpr into the StringTemplate ADT.
export let template_ctor_lit = "TemplateLit"
export let template_ctor_interp = "TemplateInterp"

# The key a function's hidden dictionary slot is found under: the class, then each
# argument in full, variables by source name — `ToString_a`, `ToString_List(a)`,
# `ToString_(a,b)`. Instance keys name the head constructor only; a slot key must
# name the variables too, or a `ToString (List String)` request inside a body reads
# the slot declared for `List a`.
export fn dict_slot_key(class_name: String, args: List TypeExpr) -> String =
  string.join("_", Cons(class_name, list_map(slot_key_arg, args)))

fn slot_key_arg(te: TypeExpr) -> String =
  match te with
  | TypeName n -> n
  | TypeApply _ _ -> slot_key_applied(te, Nil)
  | TupleType items -> "(" ++ string.join(",", list_map(slot_key_arg, items)) ++ ")"
  | TypeArrow _ _ _ _ -> "Fn"
  | TypeThunk _ _ -> "Fn"
  | TypeEffect _ _ -> "Eff"

fn slot_key_applied(te: TypeExpr, args: List TypeExpr) -> String =
  match te with
  | TypeApply base arg -> slot_key_applied(base, Cons(arg, args))
  | TypeName _ -> slot_key_arg(te) ++ "(" ++ string.join(",", list_map(slot_key_arg, args)) ++ ")"
  | TupleType _ -> slot_key_arg(te) ++ "(" ++ string.join(",", list_map(slot_key_arg, args)) ++ ")"
  | TypeArrow _ _ _ _ -> slot_key_arg(te)
  | TypeThunk _ _ -> slot_key_arg(te)
  | TypeEffect _ _ -> slot_key_arg(te)
