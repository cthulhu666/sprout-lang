module stdlib.compiler.iface_codec
import stdlib.compiler.types as types
import stdlib.compiler.ast as ast
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.source as source

# ============================================================================
# Iface codec — hand-written serialize/deserialize for types.Scheme and its
# transitive deps (types.Type, types.Effect).
#
# Phase 1 of the iface PR series (docs/iface-precompiled-modules-v1-draft.md
# §"Smallest verifiable Phase 1 unit"): provides round-trip primitives only.
# No bundler integration, no .iface file I/O, no source-hash check, no ctor
# /class/instance metadata yet — those are follow-up phases.
#
# Format (bespoke S-expression, all ASCII):
#   <scheme>  := ( Scheme <strs> <strs> <type> <effect> )
#   <type>    := ( TVar <atom> )
#              | ( TConst <atom> )
#              | ( TApp <type> <type> )
#              | ( TFunc <type> <type> <effect> )
#              | ( TTuple <types> )
#   <effect>  := ( EffectPure )
#              | ( EffectIO )
#              | ( EffectRow <strs> )
#              | ( EffectVar <atom> )
#   <strs>    := ( atom* )
#   <types>   := ( <type>* )
#   <atom>    := ASCII identifier — no whitespace, no parens, no quotes
#
# Atoms are bare identifiers because type-var names, ctor names, and effect
# labels are ASCII identifiers by language spec. No escape handling needed.
# ============================================================================

# ----------------------------------------------------------------------------
# Encoder — Scheme -> String
# ----------------------------------------------------------------------------

# O(n) where n = total atoms in the scheme.
export fn encode_scheme(s: types.Scheme) -> String =
  match s with
  | types.Scheme tvars evars body effect ->
      string_concat_many(Cons("(Scheme ",
        Cons(encode_str_list(tvars),
          Cons(" ",
            Cons(encode_str_list(evars),
              Cons(" ",
                Cons(encode_type(body),
                  Cons(" ",
                    Cons(encode_effect(effect),
                      Cons(")", Nil))))))))))

export fn encode_type(t: types.Type) -> String =
  match t with
  | types.TVar n -> string_concat_many(Cons("(TVar ", Cons(n, Cons(")", Nil))))
  | types.TConst n -> string_concat_many(Cons("(TConst ", Cons(types.type_id_name(n), Cons(")", Nil))))
  | types.TApp a b ->
      string_concat_many(Cons("(TApp ",
        Cons(encode_type(a),
          Cons(" ",
            Cons(encode_type(b),
              Cons(")", Nil))))))
  | types.TFunc a b e ->
      string_concat_many(Cons("(TFunc ",
        Cons(encode_type(a),
          Cons(" ",
            Cons(encode_type(b),
              Cons(" ",
                Cons(encode_effect(e),
                  Cons(")", Nil))))))))
  | types.TTuple ts ->
      string_concat_many(Cons("(TTuple ", Cons(encode_type_list(ts), Cons(")", Nil))))

export fn encode_effect(e: types.Effect) -> String =
  match e with
  | types.EffectPure -> "(EffectPure)"
  | types.EffectIO -> "(EffectIO)"
  | types.EffectRow xs ->
      string_concat_many(Cons("(EffectRow ", Cons(encode_str_list(xs), Cons(")", Nil))))
  | types.EffectVar n -> string_concat_many(Cons("(EffectVar ", Cons(n, Cons(")", Nil))))

fn encode_str_list(xs: List String) -> String =
  string_concat_many(Cons("(", Cons(join_strs(xs), Cons(")", Nil))))

# Join with single-space separator. O(n).
fn join_strs(xs: List String) -> String =
  match xs with
  | Nil -> ""
  | Cons x Nil -> x
  | Cons x rest -> string_concat_many(Cons(x, Cons(" ", Cons(join_strs(rest), Nil))))

fn encode_type_list(ts: List types.Type) -> String =
  string_concat_many(Cons("(", Cons(join_types(ts), Cons(")", Nil))))

fn join_types(ts: List types.Type) -> String =
  match ts with
  | Nil -> ""
  | Cons t Nil -> encode_type(t)
  | Cons t rest -> string_concat_many(Cons(encode_type(t), Cons(" ", Cons(join_types(rest), Nil))))

# ----------------------------------------------------------------------------
# Decoder — String -> Maybe Scheme
# ----------------------------------------------------------------------------
#
# Top-level entry: parses input as a complete Scheme. Returns Nothing on any
# parse failure or if there's leftover non-whitespace after the value.

export fn decode_scheme(input: String) -> Maybe types.Scheme =
  match decode_scheme_at(input, bytes, skip_ws(input, bytes, 0, n), n) with
  | Nothing -> Nothing
  | Just (s, next) ->
      if only_ws_remaining(input, bytes, next, n) then Just(s) else Nothing
  where n = str_byte_len(input)
        bytes = bytes_from_utf8(input)

# ----------------------------------------------------------------------------
# Tokenization primitives
# ----------------------------------------------------------------------------

fn is_ws(ch: Char) -> Bool =
  ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'

# O(leading-ws). Returns the byte position past any leading whitespace.
fn skip_ws(s: String, bytes: Bytes, i: Int, total: Int) -> Int =
  if i >= total then i
  else
    match source.decode_char_at(bytes, i) with
    | Nothing -> i
    | Just (ch, _) -> if is_ws(ch) then skip_ws(s, bytes, i + 1, total) else i

# True iff bytes [i, total) contain only whitespace.
fn only_ws_remaining(s: String, bytes: Bytes, i: Int, total: Int) -> Bool =
  skip_ws(s, bytes, i, total) == total

# Expect a specific ASCII char at byte i. Returns Just(i+1) on match.
fn expect_char(s: String, bytes: Bytes, i: Int, total: Int, ch: Char) -> Maybe Int =
  if i >= total then Nothing
  else
    match source.decode_char_at(bytes, i) with
    | Nothing -> Nothing
    | Just (c, _) -> if c == ch then Just(i + 1) else Nothing

# Atoms are runs of bytes that aren't whitespace or parens.
fn is_atom_char(ch: Char) -> Bool =
  if is_ws(ch) then false
  else if ch == '(' then false
  else if ch == ')' then false
  else true

# Reads one atom starting at byte i. Returns (atom_string, byte_pos_after).
fn read_atom(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (String, Int) =
  if i >= total then Nothing
  else
    match source.decode_char_at(bytes, i) with
    | Nothing -> Nothing
    | Just (c, _) -> if is_atom_char(c) then read_atom_continue(s, bytes, i, total) else Nothing

fn read_atom_continue(s: String, bytes: Bytes, start: Int, total: Int) -> Maybe (String, Int) =
  Just((str_slice(s, start, end_pos - start), end_pos))
  where end_pos = scan_atom_end(s, bytes, start + 1, total)

# Scans forward from i until the next non-atom char or EOF; returns that position.
fn scan_atom_end(s: String, bytes: Bytes, i: Int, total: Int) -> Int =
  if i >= total then i
  else
    match source.decode_char_at(bytes, i) with
    | Nothing -> i
    | Just (c, _) -> if is_atom_char(c) then scan_atom_end(s, bytes, i + 1, total) else i

# ----------------------------------------------------------------------------
# Decoders return Just(value, byte_pos_after) on success.
# All decoders begin by expecting `(`, then the tagged atom, etc.
# ----------------------------------------------------------------------------

fn decode_scheme_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Scheme, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) ->
          if tag == "Scheme" then decode_scheme_body(s, bytes, k, total)
          else Nothing

fn decode_scheme_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Scheme, Int) =
  match decode_str_list_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (tvars, k2) ->
      match decode_str_list_at(s, bytes, skip_ws(s, bytes, k2, total), total) with
      | Nothing -> Nothing
      | Just (evars, k3) ->
          match decode_type_at(s, bytes, skip_ws(s, bytes, k3, total), total) with
          | Nothing -> Nothing
          | Just (body, k4) ->
              match decode_effect_at(s, bytes, skip_ws(s, bytes, k4, total), total) with
              | Nothing -> Nothing
              | Just (effect, k5) ->
                  match expect_char(s, bytes, skip_ws(s, bytes, k5, total), total, ')') with
                  | Nothing -> Nothing
                  | Just end -> Just((types.Scheme(tvars, evars, body, effect), end))

fn decode_type_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Type, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) -> decode_type_by_tag(s, bytes, k, total, tag)

fn decode_type_by_tag(s: String, bytes: Bytes, i: Int, total: Int, tag: String) -> Maybe(types.Type, Int) =
  if tag == "TVar" then decode_tvar_at(s, bytes, i, total)
  else if tag == "TConst" then decode_tconst_at(s, bytes, i, total)
  else if tag == "TApp" then decode_tapp_at(s, bytes, i, total)
  else if tag == "TFunc" then decode_tfunc_at(s, bytes, i, total)
  else if tag == "TTuple" then decode_ttuple_at(s, bytes, i, total)
  else Nothing

# Reads `<atom>)`. Returns the atom + position past the `)`.
fn read_atom_then_close(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (String, Int) =
  match read_atom(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match expect_char(s, bytes, skip_ws(s, bytes, j, total), total, ')') with
      | Nothing -> Nothing
      | Just end -> Just((name, end))

fn decode_tvar_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Type, Int) =
  match read_atom_then_close(s, bytes, i, total) with
  | Nothing -> Nothing
  | Just (name, end) -> Just((types.TVar(name), end))

fn decode_tconst_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Type, Int) =
  match read_atom_then_close(s, bytes, i, total) with
  | Nothing -> Nothing
  | Just (name, end) -> Just((types.TConst(types.type_id(name)), end))

fn decode_tapp_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Type, Int) =
  match decode_type_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (t1, j) ->
      match decode_type_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (t2, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((types.TApp(t1, t2), end))

fn decode_tfunc_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Type, Int) =
  match decode_type_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (t1, j) ->
      match decode_type_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (t2, k) ->
          match decode_effect_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (e, m) ->
              match expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') with
              | Nothing -> Nothing
              | Just end -> Just((types.TFunc(t1, t2, e), end))

fn decode_ttuple_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Type, Int) =
  match decode_type_list_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (ts, j) ->
      match expect_char(s, bytes, skip_ws(s, bytes, j, total), total, ')') with
      | Nothing -> Nothing
      | Just end -> Just((types.TTuple(ts), end))

fn decode_effect_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Effect, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) -> decode_effect_by_tag(s, bytes, k, total, tag)

fn decode_effect_by_tag(s: String, bytes: Bytes, i: Int, total: Int, tag: String) -> Maybe(types.Effect, Int) =
  if tag == "EffectPure" then decode_effect_pure_close(s, bytes, i, total)
  else if tag == "EffectIO" then decode_effect_io_close(s, bytes, i, total)
  else if tag == "EffectRow" then decode_effect_row_at(s, bytes, i, total)
  else if tag == "EffectVar" then decode_effect_var_at(s, bytes, i, total)
  else Nothing

fn decode_effect_pure_close(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Effect, Int) =
  match expect_char(s, bytes, skip_ws(s, bytes, i, total), total, ')') with
  | Nothing -> Nothing
  | Just end -> Just((types.EffectPure, end))

fn decode_effect_io_close(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Effect, Int) =
  match expect_char(s, bytes, skip_ws(s, bytes, i, total), total, ')') with
  | Nothing -> Nothing
  | Just end -> Just((types.EffectIO, end))

fn decode_effect_row_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Effect, Int) =
  match decode_str_list_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (xs, j) ->
      match expect_char(s, bytes, skip_ws(s, bytes, j, total), total, ')') with
      | Nothing -> Nothing
      | Just end -> Just((types.EffectRow(xs), end))

fn decode_effect_var_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Effect, Int) =
  match read_atom_then_close(s, bytes, i, total) with
  | Nothing -> Nothing
  | Just (name, end) -> Just((types.EffectVar(name), end))

# Decodes `( atom* )` as a List String.
fn decode_str_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List String, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j -> collect_strs(s, bytes, skip_ws(s, bytes, j, total), total, Nil)

fn collect_strs(s: String, bytes: Bytes, i: Int, total: Int, acc: List String) -> Maybe (List String, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      match read_atom(s, bytes, i, total) with
      | Nothing -> Nothing
      | Just (atom, j) -> collect_strs(s, bytes, skip_ws(s, bytes, j, total), total, Cons(atom, acc))

# Decodes `( <type>* )` as a List Type.
fn decode_type_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List types.Type, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j -> collect_types(s, bytes, skip_ws(s, bytes, j, total), total, Nil)

fn collect_types(s: String, bytes: Bytes, i: Int, total: Int, acc: List types.Type) -> Maybe (List types.Type, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      match decode_type_at(s, bytes, i, total) with
      | Nothing -> Nothing
      | Just (t, j) -> collect_types(s, bytes, skip_ws(s, bytes, j, total), total, Cons(t, acc))

# ============================================================================
# IfaceFile — the top-level iface artifact for one module
# ============================================================================
#
# Wraps the scheme table with metadata for format versioning and module
# identification. Per docs/iface-precompiled-modules-v1-draft.md §Format.
#
# v1 schema (intentionally minimal):
#   version      : Int — currently always 1; future bumps purge CI cache
#   module_name  : qualified name, e.g. "stdlib.compiler.types"
#   schemes      : list of (qualified_name, Scheme) pairs
#
# Deferred to later phases:
#   - source_hash + compiler_fingerprint (freshness check; needs Phase 2
#     `bundle_file_with_iface` integration to be load-bearing)
#   - ctor / class / instance tables (typeclass resolution metadata)
#   - ast_hash (parser-skipping path)
#   - emit_time (debug only)
#
# Wire format:
#   (IfaceFile 1 stdlib.compiler.types
#     ((NamedScheme stdlib.compiler.types.mono <scheme>)
#      (NamedScheme stdlib.compiler.types.scheme_vars <scheme>)
#      ...))
#
# `version` is encoded as a bare atom and checked by string equality. When
# v2 lands, decoder gets an if-chain or a parsed-int conversion.

export type NamedScheme (..) =
  | NamedScheme String types.Scheme

# Constructor metadata for one ADT constructor. Captures enough to register
# the ctor in the typechecker without re-parsing source: ctor name, owning
# ADT name, and field types (arity is implicit in list_length(field_types)).
#
# Example: `type Maybe a = Just a | Nothing` yields:
#   CtorInfo("Just", "Maybe", [TVar("a")])
#   CtorInfo("Nothing", "Maybe", [])
export type CtorInfo (..) =
  | CtorInfo String String (List types.Type)

# Class declaration metadata. Captures the class name, type parameters,
# superclass-class-names (constraint heads, not full constraint exprs — v1
# limitation; constraint TypeExpr lists are deferred), and method signatures.
#
# Example: `class Eq a where Ord a { fn eq(...); fn neq(...) }` yields:
#   ClassInfo("Eq", ["a"], ["Ord"], [NamedScheme("eq", ...), NamedScheme("neq", ...)])
export type ClassInfo (..) =
  | ClassInfo String (List String) (List String) (List NamedScheme)

# Instance declaration metadata. Captures the class being implemented, the
# head type (e.g. `Int` in `instance Eq Int`), and the dispatch dict name
# the typechecker uses for resolution.
#
# Example: `instance Eq Int { ... }` lowered with dict name `int_eq_inst`:
#   InstanceInfo("Eq", TConst("Int"), "stdlib.prelude.int_eq_inst")
export type InstanceInfo (..) =
  | InstanceInfo String types.Type String

# IfaceFile v2 wire format:
#
#   (IfaceFile 2 <module-name>
#     (NamedScheme ...)*         # exported value/fn schemes
#     (CtorInfo ...)*            # ADT constructor metadata
#     (ClassInfo ...)*           # class declarations
#     (InstanceInfo ...)*)       # instance declarations
#
# Phase 1.x: schemas defined here and round-trip tested with hand-built data.
# Extraction from a typechecked program (so --emit-iface actually populates
# the ctor/class/instance tables) is a follow-up — current --emit-iface
# emits empty Nil lists for these three.
export type IfaceFile (..) =
  | IfaceFile Int String (List NamedScheme) (List CtorInfo) (List ClassInfo) (List InstanceInfo)

# ----------------------------------------------------------------------------
# Encoder
# ----------------------------------------------------------------------------

export fn encode_iface_file(f: IfaceFile) -> String =
  match f with
  | IfaceFile version mod schemes ctors classes instances ->
      string_concat_many([
        "(IfaceFile ", int_to_string(version),
        " ", mod,
        " ", encode_named_scheme_list(schemes),
        " ", encode_ctor_info_list(ctors),
        " ", encode_class_info_list(classes),
        " ", encode_instance_info_list(instances),
        ")"
      ])

fn encode_named_scheme_list(ns: List NamedScheme) -> String =
  string_concat_many(["(", join_named_schemes(ns), ")"])

fn join_named_schemes(ns: List NamedScheme) -> String =
  match ns with
  | Nil -> ""
  | Cons n Nil -> encode_named_scheme(n)
  | Cons n rest -> string_concat_many([encode_named_scheme(n), " ", join_named_schemes(rest)])

fn encode_named_scheme(n: NamedScheme) -> String =
  match n with
  | NamedScheme name s ->
      string_concat_many(["(NamedScheme ", name, " ", encode_scheme(s), ")"])

fn encode_ctor_info_list(cs: List CtorInfo) -> String =
  string_concat_many(["(", join_ctor_infos(cs), ")"])

fn join_ctor_infos(cs: List CtorInfo) -> String =
  match cs with
  | Nil -> ""
  | Cons c Nil -> encode_ctor_info(c)
  | Cons c rest -> string_concat_many([encode_ctor_info(c), " ", join_ctor_infos(rest)])

fn encode_ctor_info(c: CtorInfo) -> String =
  match c with
  | CtorInfo ctor_name adt_name field_types ->
      string_concat_many([
        "(CtorInfo ", ctor_name, " ", adt_name, " ", encode_type_list(field_types), ")"
      ])

fn encode_class_info_list(cs: List ClassInfo) -> String =
  string_concat_many(["(", join_class_infos(cs), ")"])

fn join_class_infos(cs: List ClassInfo) -> String =
  match cs with
  | Nil -> ""
  | Cons c Nil -> encode_class_info(c)
  | Cons c rest -> string_concat_many([encode_class_info(c), " ", join_class_infos(rest)])

fn encode_class_info(c: ClassInfo) -> String =
  match c with
  | ClassInfo name type_params superclasses methods ->
      string_concat_many([
        "(ClassInfo ", name,
        " ", encode_str_list(type_params),
        " ", encode_str_list(superclasses),
        " ", encode_named_scheme_list(methods),
        ")"
      ])

fn encode_instance_info_list(is: List InstanceInfo) -> String =
  string_concat_many(["(", join_instance_infos(is), ")"])

fn join_instance_infos(is: List InstanceInfo) -> String =
  match is with
  | Nil -> ""
  | Cons i Nil -> encode_instance_info(i)
  | Cons i rest -> string_concat_many([encode_instance_info(i), " ", join_instance_infos(rest)])

fn encode_instance_info(i: InstanceInfo) -> String =
  match i with
  | InstanceInfo class_name head_type dict_name ->
      string_concat_many([
        "(InstanceInfo ", class_name, " ", encode_type(head_type), " ", dict_name, ")"
      ])

# ----------------------------------------------------------------------------
# Decoder
# ----------------------------------------------------------------------------

export fn decode_iface_file(input: String) -> Maybe IfaceFile =
  match decode_iface_file_at(input, bytes, skip_ws(input, bytes, 0, n), n) with
  | Nothing -> Nothing
  | Just (f, next) ->
      if only_ws_remaining(input, bytes, next, n) then Just(f) else Nothing
  where n = str_byte_len(input)
        bytes = bytes_from_utf8(input)

fn decode_iface_file_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (IfaceFile, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Just (tag, k) ->
          if tag == "IfaceFile" then decode_iface_file_body(s, bytes, k, total)
          else Nothing
      | Nothing -> Nothing

fn decode_iface_file_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (IfaceFile, Int) =
  match read_atom(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (version_atom, j) ->
      match decode_iface_version(version_atom) with
      | Nothing -> Nothing
      | Just version -> decode_iface_v2_tail(s, bytes, j, total, version)

fn decode_iface_v2_tail(s: String, bytes: Bytes, i: Int, total: Int, version: Int) -> Maybe (IfaceFile, Int) =
  match read_atom(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (mod_name, k) ->
      match decode_named_scheme_list_at(s, bytes, skip_ws(s, bytes, k, total), total) with
      | Nothing -> Nothing
      | Just (schemes, m) ->
          match decode_ctor_info_list_at(s, bytes, skip_ws(s, bytes, m, total), total) with
          | Nothing -> Nothing
          | Just (ctors, n2) ->
              match decode_class_info_list_at(s, bytes, skip_ws(s, bytes, n2, total), total) with
              | Nothing -> Nothing
              | Just (classes, n3) ->
                  match decode_instance_info_list_at(s, bytes, skip_ws(s, bytes, n3, total), total) with
                  | Nothing -> Nothing
                  | Just (instances, n4) ->
                      match expect_char(s, bytes, skip_ws(s, bytes, n4, total), total, ')') with
                      | Nothing -> Nothing
                      | Just end -> Just((IfaceFile(version, mod_name, schemes, ctors, classes, instances), end))

# v2: accept only "2" — future versions add to the if-chain. Using string
# equality (rather than parse_int) avoids parse_int's partial behaviour on
# non-digit input. v1 (schemes-only) was retired when metadata tables
# (ctors/classes/instances) were added; no in-tree consumer relied on it.
fn decode_iface_version(s: String) -> Maybe Int =
  if s == "2" then Just(2) else Nothing

fn decode_named_scheme_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List NamedScheme, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j -> collect_named_schemes(s, bytes, skip_ws(s, bytes, j, total), total, Nil)

fn collect_named_schemes(s: String, bytes: Bytes, i: Int, total: Int, acc: List NamedScheme) -> Maybe (List NamedScheme, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      match decode_named_scheme_at(s, bytes, i, total) with
      | Nothing -> Nothing
      | Just (n, j) -> collect_named_schemes(s, bytes, skip_ws(s, bytes, j, total), total, Cons(n, acc))

fn decode_named_scheme_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (NamedScheme, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) ->
          if tag == "NamedScheme" then decode_named_scheme_body(s, bytes, k, total)
          else Nothing

fn decode_named_scheme_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (NamedScheme, Int) =
  match read_atom(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match decode_scheme_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (scheme, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((NamedScheme(name, scheme), end))

# ============================================================================
# Env filtering — bridge between typecheck output and IfaceFile
# ============================================================================
#
# Given a post-typecheck env (Dict String -> Scheme containing every entry
# visible to the typechecker — module-local exports, imports, prelude, etc.)
# and a target module name, returns the subset of (name, scheme) pairs whose
# qualified name starts with `module_name ++ "."`. Caller wraps the result
# in an IfaceFile via `IfaceFile(version, module_name, schemes)`.
#
# O(n) over env entries (single linear scan via dict_entries).

export fn extract_named_schemes(env: Dict types.Scheme, module_name: String) -> List NamedScheme =
  filter_dict_entries(entries, 0, vec_length(entries), module_name ++ ".", Nil)
  where entries = dict_entries(env)

fn filter_dict_entries(entries: Vec (String, types.Scheme), i: Int, total: Int, prefix: String, acc: List NamedScheme) -> List NamedScheme =
  if i >= total then list_reverse(acc)
  else
    match vec_get(i, entries) with
    | Nothing -> filter_dict_entries(entries, i + 1, total, prefix, acc)
    | Just entry -> match entry with
        | (name, scheme) ->
            if str_starts_with(name, prefix) then
              filter_dict_entries(entries, i + 1, total, prefix, Cons (NamedScheme(name, scheme), acc))
            else filter_dict_entries(entries, i + 1, total, prefix, acc)

# ============================================================================
# Typed-program extraction — bridge between typed AST and IfaceFile metadata
# ============================================================================
#
# Each helper walks typed_prog.decls (a List typed_ast.TypedDecl) and collects
# metadata for decls whose qualified name starts with `module_name ++ "."`.
#
# Design notes:
# - TypeDecl  → TPassThrough (infer preserves as-is, no typecheck needed)
# - ClassDecl → TPassThrough (ditto)
# - InstanceDecl → TInstanceDecl (infer replaces with typed version)
#
# These helpers do NOT import infer.sprout (avoids pulling in the large
# inference engine).  Instead we duplicate two small local helpers:
#   typeexpr_to_type  — ast.TypeExpr → types.Type (same logic as infer.type_from_ast
#                       but without the Dict local_vars for TVar lookup)
#   strip_mod_prefix  — drop everything up to and including the last dot

# ---------------------------------------------------------------------------
# Local helpers (no dependency on infer.sprout)
# ---------------------------------------------------------------------------

# O(n) where n = chars in name; strips all module qualification.
fn strip_mod_prefix(name: String) -> String =
  if dot < 0 then name
  else strip_mod_prefix(str_slice(name, dot + 1, str_len(name)))
  where dot = str_find(name, ".")

# Convert a surface ast.TypeExpr to types.Type. TypeName looks up local_vars
# (type parameters listed in the enclosing decl) and falls back to TConst.
# O(n) in size of the type expression.
fn typeexpr_to_type_with_vars(te: ast.TypeExpr, local_vars: Dict types.Type) -> types.Type =
  match te with
  | ast.TypeName name ->
      match dict_get(name, local_vars) with
      | Just t -> t
      | Nothing -> types.TConst(types.type_id(strip_mod_prefix(name)))
  | ast.TypeApply base arg ->
      types.TApp(typeexpr_to_type_with_vars(base, local_vars),
                 typeexpr_to_type_with_vars(arg, local_vars))
  | ast.TypeArrow param ret _ ->
      types.TFunc(typeexpr_to_type_with_vars(param, local_vars),
                  typeexpr_to_type_with_vars(ret, local_vars),
                  types.EffectPure)
  | ast.TypeEffect inner _ -> typeexpr_to_type_with_vars(inner, local_vars)
  | ast.TupleType parts ->
      types.TTuple(typeexpr_list_to_types(parts, local_vars))

fn typeexpr_list_to_types(parts: List ast.TypeExpr, local_vars: Dict types.Type) -> List types.Type =
  match parts with
  | Nil -> Nil
  | Cons h t -> Cons(typeexpr_to_type_with_vars(h, local_vars),
                     typeexpr_list_to_types(t, local_vars))

# Build a Dict mapping each type-param name to TVar(name).
# O(n) where n = number of type params.
fn make_local_vars(type_params: List String) -> Dict types.Type =
  match type_params with
  | Nil -> dict_empty()
  | Cons p rest -> dict_set(p, types.TVar(p), make_local_vars(rest))

# Extract the outermost type-name from the first type-argument of a constraint.
# Used to compute the canonical instance dispatch key.
fn constraint_head(type_args: List ast.TypeExpr) -> String =
  match type_args with
  | Nil -> "Unknown"
  | Cons te _ -> te_outermost_name(te)

fn te_outermost_name(te: ast.TypeExpr) -> String =
  match te with
  | ast.TypeName n -> strip_mod_prefix(n)
  | ast.TypeApply base _ -> te_outermost_name(base)
  | _ -> "Unknown"

# Build a Scheme for a class method: forall type_params. params -> ret @ effect.
# Effects come from the method's `effects` field (Nothing → EffectPure).
# O(n) in number of params.
fn method_scheme(type_params: List String, params: List ast.Param, ret: ast.TypeExpr, effects: Maybe (List String)) -> types.Scheme =
  types.Scheme(type_params, Nil,
    params_to_func_type(params, typeexpr_to_type_with_vars(ret, make_local_vars(type_params)), make_local_vars(type_params)),
    effect_from_maybe_labels(effects))

fn effect_from_maybe_labels(labels: Maybe (List String)) -> types.Effect =
  match labels with
  | Nothing -> types.EffectPure
  | Just Nil -> types.EffectPure
  | Just xs -> types.EffectRow(xs)

# Build a right-associating TFunc chain from a list of Params.
# Final return type is appended at the end with EffectPure between args;
# the outermost effect comes from the method declaration itself.
fn params_to_func_type(params: List ast.Param, ret: types.Type, local_vars: Dict types.Type) -> types.Type =
  match params with
  | Nil -> ret
  | Cons (ast.Param _ maybe_te) rest ->
      types.TFunc(param_type_from_maybe(maybe_te, local_vars),
                  params_to_func_type(rest, ret, local_vars),
                  types.EffectPure)

fn param_type_from_maybe(maybe_te: Maybe ast.TypeExpr, local_vars: Dict types.Type) -> types.Type =
  match maybe_te with
  | Nothing -> types.TVar("_")
  | Just te -> typeexpr_to_type_with_vars(te, local_vars)

# ---------------------------------------------------------------------------
# CtorInfo extraction
# ---------------------------------------------------------------------------
#
# Walks decls for TPassThrough(TypeDecl name type_params ctors ...) where
# `name` starts with `module_name ++ "."`. Emits one CtorInfo per constructor.
# Field types are converted from ast.TypeExpr using the decl's type_params as
# local type variables.
#
# O(sum of ctor-count across all matching TypeDecls in the program).

export fn extract_ctor_infos(prog: typed_ast.TypedProgram, module_name: String) -> List CtorInfo =
  match prog with
  | typed_ast.TypedProgram decls ->
      collect_ctor_infos_from_decls(decls, module_name ++ ".", Nil)

fn collect_ctor_infos_from_decls(decls: List typed_ast.TypedDecl, prefix: String, acc: List CtorInfo) -> List CtorInfo =
  match decls with
  | Nil -> list_reverse(acc)
  | Cons d rest ->
      match d with
      | typed_ast.TPassThrough inner_decl ->
          match inner_decl with
          | ast.TypeDecl name type_params ctors _ _ ->
              if str_starts_with(name, prefix) then
                collect_ctor_infos_from_decls(rest, prefix,
                  collect_ctors_for_type(ctors, name, make_local_vars(type_params), acc))
              else collect_ctor_infos_from_decls(rest, prefix, acc)
          | _ -> collect_ctor_infos_from_decls(rest, prefix, acc)
      | _ -> collect_ctor_infos_from_decls(rest, prefix, acc)

fn collect_ctors_for_type(ctors: List ast.TypeConstructor, adt_name: String, local_vars: Dict types.Type, acc: List CtorInfo) -> List CtorInfo =
  match ctors with
  | Nil -> acc
  | Cons (ast.TypeConstructor ctor_name field_exprs) rest ->
      collect_ctors_for_type(rest, adt_name, local_vars,
        Cons(CtorInfo(ctor_name, adt_name, typeexpr_list_to_types(field_exprs, local_vars)), acc))

# ---------------------------------------------------------------------------
# ClassInfo extraction
# ---------------------------------------------------------------------------
#
# Walks decls for TPassThrough(ClassDecl name type_params methods superclasses)
# where `name` starts with `module_name ++ "."`. Superclass names are extracted
# from the TypeConstraint class_name field. Method schemes are built with
# method_scheme.
#
# O(sum of method-count across all matching ClassDecls).

export fn extract_class_infos(prog: typed_ast.TypedProgram, module_name: String) -> List ClassInfo =
  match prog with
  | typed_ast.TypedProgram decls ->
      collect_class_infos_from_decls(decls, module_name ++ ".", Nil)

fn collect_class_infos_from_decls(decls: List typed_ast.TypedDecl, prefix: String, acc: List ClassInfo) -> List ClassInfo =
  match decls with
  | Nil -> list_reverse(acc)
  | Cons d rest ->
      match d with
      | typed_ast.TPassThrough inner_decl ->
          match inner_decl with
          | ast.ClassDecl name type_params methods superclasses _ ->
              if str_starts_with(name, prefix) then
                collect_class_infos_from_decls(rest, prefix,
                  Cons(build_class_info(name, type_params, methods, superclasses), acc))
              else collect_class_infos_from_decls(rest, prefix, acc)
          | _ -> collect_class_infos_from_decls(rest, prefix, acc)
      | _ -> collect_class_infos_from_decls(rest, prefix, acc)

fn build_class_info(name: String, type_params: List String, methods: List ast.ClassMethodSig, superclasses: List ast.TypeConstraint) -> ClassInfo =
  ClassInfo(name, type_params,
    extract_superclass_names(superclasses, Nil),
    build_method_named_schemes(methods, type_params, Nil))

fn extract_superclass_names(supers: List ast.TypeConstraint, acc: List String) -> List String =
  match supers with
  | Nil -> list_reverse(acc)
  | Cons (ast.TypeConstraint class_name _) rest ->
      extract_superclass_names(rest, Cons(class_name, acc))

fn build_method_named_schemes(methods: List ast.ClassMethodSig, type_params: List String, acc: List NamedScheme) -> List NamedScheme =
  match methods with
  | Nil -> list_reverse(acc)
  | Cons (ast.ClassMethodSig method_name params ret effects) rest ->
      build_method_named_schemes(rest, type_params,
        Cons(NamedScheme(method_name, method_scheme(type_params, params, ret, effects)), acc))

# ---------------------------------------------------------------------------
# InstanceInfo extraction
# ---------------------------------------------------------------------------
#
# Walks decls for TInstanceDecl(constraint, _, _) where constraint is
# TypeConstraint class_name type_args, and `class_name` starts with
# `module_name ++ "."`.
#
# dict_name encoding: uses the same dispatch-key format as the typechecker
# (infer.sprout:835 — `strip(class_name) ++ "_" ++ head`), which is the only
# string with real provenance in this phase. A synthesised name
# ("class_head") is stored rather than a real function name because there is
# no single per-instance dict function in the current lowering scheme — each
# method gets its own `__tc_{Class}_{mangled}_{method}` function.
#
# Phase-2 TODO: revisit dict_name when the bundler consumes InstanceInfo for
# cross-module instance resolution; at that point the name should either be
# clarified as a dispatch key or replaced with a method-name map.
#
# O(n) over all typed decls.

export fn extract_instance_infos(prog: typed_ast.TypedProgram, module_name: String) -> List InstanceInfo =
  match prog with
  | typed_ast.TypedProgram decls ->
      collect_instance_infos_from_decls(decls, module_name ++ ".", Nil)

fn collect_instance_infos_from_decls(decls: List typed_ast.TypedDecl, prefix: String, acc: List InstanceInfo) -> List InstanceInfo =
  match decls with
  | Nil -> list_reverse(acc)
  | Cons d rest ->
      match d with
      | typed_ast.TInstanceDecl constraint _ _ ->
          match constraint with
          | ast.TypeConstraint class_name type_args ->
              if str_starts_with(class_name, prefix) then
                collect_instance_infos_from_decls(rest, prefix,
                  Cons(build_instance_info(class_name, type_args), acc))
              else collect_instance_infos_from_decls(rest, prefix, acc)
      | _ -> collect_instance_infos_from_decls(rest, prefix, acc)

fn build_instance_info(class_name: String, type_args: List ast.TypeExpr) -> InstanceInfo =
  InstanceInfo(class_name,
    head_type_from_args(type_args),
    strip_mod_prefix(class_name) ++ "_" ++ constraint_head(type_args))

fn head_type_from_args(type_args: List ast.TypeExpr) -> types.Type =
  match type_args with
  | Nil -> types.TConst(types.type_id("Unknown"))
  | Cons te _ -> typeexpr_to_type_with_vars(te, dict_empty())

# ============================================================================
# Decoders for CtorInfo / ClassInfo / InstanceInfo
# ============================================================================

fn decode_ctor_info_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List CtorInfo, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j -> collect_ctor_infos(s, bytes, skip_ws(s, bytes, j, total), total, Nil)

fn collect_ctor_infos(s: String, bytes: Bytes, i: Int, total: Int, acc: List CtorInfo) -> Maybe (List CtorInfo, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      match decode_ctor_info_at(s, bytes, i, total) with
      | Nothing -> Nothing
      | Just (c, j) -> collect_ctor_infos(s, bytes, skip_ws(s, bytes, j, total), total, Cons(c, acc))

fn decode_ctor_info_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (CtorInfo, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) ->
          if tag == "CtorInfo" then decode_ctor_info_body(s, bytes, k, total)
          else Nothing

fn decode_ctor_info_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (CtorInfo, Int) =
  match read_atom(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (ctor_name, j) ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (adt_name, k) ->
          match decode_type_list_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (field_types, m) ->
              match expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') with
              | Nothing -> Nothing
              | Just end -> Just((CtorInfo(ctor_name, adt_name, field_types), end))

fn decode_class_info_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List ClassInfo, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j -> collect_class_infos(s, bytes, skip_ws(s, bytes, j, total), total, Nil)

fn collect_class_infos(s: String, bytes: Bytes, i: Int, total: Int, acc: List ClassInfo) -> Maybe (List ClassInfo, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      match decode_class_info_at(s, bytes, i, total) with
      | Nothing -> Nothing
      | Just (c, j) -> collect_class_infos(s, bytes, skip_ws(s, bytes, j, total), total, Cons(c, acc))

fn decode_class_info_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (ClassInfo, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) ->
          if tag == "ClassInfo" then decode_class_info_body(s, bytes, k, total)
          else Nothing

fn decode_class_info_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (ClassInfo, Int) =
  do
    (name, j) <- read_atom(s, bytes, skip_ws(s, bytes, i, total), total)
    (type_params, k) <- decode_str_list_at(s, bytes, skip_ws(s, bytes, j, total), total)
    (superclasses, m) <- decode_str_list_at(s, bytes, skip_ws(s, bytes, k, total), total)
    (methods, n) <- decode_named_scheme_list_at(s, bytes, skip_ws(s, bytes, m, total), total)
    end <- expect_char(s, bytes, skip_ws(s, bytes, n, total), total, ')')
    Just((ClassInfo(name, type_params, superclasses, methods), end))

fn decode_instance_info_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List InstanceInfo, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j -> collect_instance_infos(s, bytes, skip_ws(s, bytes, j, total), total, Nil)

fn collect_instance_infos(s: String, bytes: Bytes, i: Int, total: Int, acc: List InstanceInfo) -> Maybe (List InstanceInfo, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      match decode_instance_info_at(s, bytes, i, total) with
      | Nothing -> Nothing
      | Just (inst, j) -> collect_instance_infos(s, bytes, skip_ws(s, bytes, j, total), total, Cons(inst, acc))

fn decode_instance_info_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (InstanceInfo, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) ->
          if tag == "InstanceInfo" then decode_instance_info_body(s, bytes, k, total)
          else Nothing

fn decode_instance_info_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (InstanceInfo, Int) =
  match read_atom(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (class_name, j) ->
      match decode_type_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (head_type, k) ->
          match read_atom(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (dict_name, m) ->
              match expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') with
              | Nothing -> Nothing
              | Just end -> Just((InstanceInfo(class_name, head_type, dict_name), end))

# ============================================================================
# AST codec — encode/decode for ast.Program and constituent ADTs
# ============================================================================
#
# Phase 2 of the iface PR series (docs/iface-precompiled-modules-v1-draft.md).
# Provides round-trip primitives for the surface (untyped) AST.
#
# Format: extends the bespoke S-expression grammar of Phase 1.
#   New primitives:
#     <quoted>   := '"' <char>* '"'         — string literal, backslash-escaped
#                   Escape sequences: \\ \" \n \r \t; all other bytes literal.
#     <int>      := ['-'] digit+            — bare decimal atom (signed)
#     <bool>     := 'true' | 'false'        — bare atoms
#     <char>     := '(Char ' <quoted> ')'  — single codepoint as quoted string
#     <pos>      := '(Pos ' <int> ' ' <int> ' ' <int> ')'  — SourcePos fields
#     <maybe X>  := '(Just ' X ')' | '(Nothing)'
#
#   All compound AST nodes use `(<Tag> <field>*)` matching the existing style.
#   Recursive nesting (Expr contains Expr, Pattern contains Pattern) works
#   because encoders are depth-first and decoders consume exactly one node.
#
# Design decisions:
#   - Quoted strings are needed because source literals can contain '"', '\n',
#     '\\', etc.; bare atoms (used in Phase 1) cannot encode these safely.
#   - Char is encoded as a 1-codepoint quoted string for consistency and to
#     avoid needing a char→int builtin (which does not exist in Sprout v1).
#   - parse_int panics on non-digit input; we use a local atom_to_int helper
#     that returns Maybe Int and handles the negative sign prefix.
#   - SourcePos fields (index, line, col) are ints; positions are preserved
#     faithfully for downstream LSP go-to-definition (TASTy precedent).

# ============================================================================
# Encoder — AST → String
# ============================================================================

# ----------------------------------------------------------------------------
# Primitive encoders
# ----------------------------------------------------------------------------

# O(n) where n = chars in value; emits '"' ... '"' with backslash escaping.
fn encode_quoted_str(v: String) -> String =
  string_concat_many(Cons("\"", Cons(escape_str_content(v, bytes, 0, str_byte_len(v), Nil), Cons("\"", Nil))))
  where bytes = bytes_from_utf8(v)

fn escape_str_content(s: String, bytes: Bytes, i: Int, total: Int, acc: List String) -> String =
  if i >= total then
    string_concat_many(list_reverse(acc))
  else
    match source.decode_char_at(bytes, i) with
    | Nothing -> string_concat_many(list_reverse(acc))
    | Just (ch, next_i) ->
        if ch == '\\' then
          escape_str_content(s, bytes, next_i, total, Cons("\\\\", acc))
        else if ch == '"' then
          escape_str_content(s, bytes, next_i, total, Cons("\\\"", acc))
        else if ch == '\n' then
          escape_str_content(s, bytes, next_i, total, Cons("\\n", acc))
        else if ch == '\r' then
          escape_str_content(s, bytes, next_i, total, Cons("\\r", acc))
        else if ch == '\t' then
          escape_str_content(s, bytes, next_i, total, Cons("\\t", acc))
        else
          escape_str_content(s, bytes, next_i, total, Cons(char_to_string(ch), acc))

# O(1). Encodes a single Char as (Char "<c>") using quoted encoding.
fn encode_ast_char(c: Int) -> String =
  string_concat_many(["(Char ", encode_quoted_str(char_to_str(c)), ")"])

# O(1). Encodes a Bool as bare atom.
fn encode_ast_bool(b: Bool) -> String =
  if b then "true" else "false"

# O(1). Encodes a SourcePos as (Pos idx line col).
fn encode_ast_pos(p: source.SourcePos) -> String =
  match p with
  | source.SourcePos idx line col ->
      string_concat_many(["(Pos ", int_to_string(idx), " ", int_to_string(line), " ", int_to_string(col), ")"])

# O(n) where n = length of inner encoding. Encodes Maybe (List String).
fn encode_maybe_str_list(m: Maybe (List String)) -> String =
  match m with
  | Nothing -> "(Nothing)"
  | Just xs -> string_concat_many(["(Just ", encode_str_list(xs), ")"])

# O(n) where n = size of TypeExpr. Encodes Maybe TypeExpr.
fn encode_maybe_typeexpr(m: Maybe ast.TypeExpr) -> String =
  match m with
  | Nothing -> "(Nothing)"
  | Just te -> string_concat_many(["(Just ", encode_ast_typeexpr(te), ")"])

# ----------------------------------------------------------------------------
# TypeExpr encoder
# ----------------------------------------------------------------------------

# O(n) in size of the type expression tree.
export fn encode_ast_typeexpr(te: ast.TypeExpr) -> String =
  match te with
  | ast.TypeName name ->
      string_concat_many(["(TypeName ", encode_quoted_str(name), ")"])
  | ast.TypeApply base arg ->
      string_concat_many(["(TypeApply ", encode_ast_typeexpr(base), " ", encode_ast_typeexpr(arg), ")"])
  | ast.TypeArrow param ret effects ->
      string_concat_many(["(TypeArrow ", encode_ast_typeexpr(param), " ", encode_ast_typeexpr(ret), " ", encode_maybe_str_list(effects), ")"])
  | ast.TypeEffect inner labels ->
      string_concat_many(["(TypeEffect ", encode_ast_typeexpr(inner), " ", encode_str_list(labels), ")"])
  | ast.TupleType parts ->
      string_concat_many(["(TupleType ", encode_ast_typeexpr_list(parts), ")"])

fn encode_ast_typeexpr_list(xs: List ast.TypeExpr) -> String =
  string_concat_many(["(", join_ast_typeexprs(xs), ")"])

fn join_ast_typeexprs(xs: List ast.TypeExpr) -> String =
  match xs with
  | Nil -> ""
  | Cons te Nil -> encode_ast_typeexpr(te)
  | Cons te rest -> string_concat_many([encode_ast_typeexpr(te), " ", join_ast_typeexprs(rest)])

# ----------------------------------------------------------------------------
# Param encoder
# ----------------------------------------------------------------------------

fn encode_ast_param(p: ast.Param) -> String =
  match p with
  | ast.Param name maybe_te ->
      string_concat_many(["(Param ", encode_quoted_str(name), " ", encode_maybe_typeexpr(maybe_te), ")"])

fn encode_ast_param_list(xs: List ast.Param) -> String =
  string_concat_many(["(", join_ast_params(xs), ")"])

fn join_ast_params(xs: List ast.Param) -> String =
  match xs with
  | Nil -> ""
  | Cons p Nil -> encode_ast_param(p)
  | Cons p rest -> string_concat_many([encode_ast_param(p), " ", join_ast_params(rest)])

# ----------------------------------------------------------------------------
# Pattern encoder
# ----------------------------------------------------------------------------

# O(n) in size of the pattern tree.
export fn encode_ast_pattern(pat: ast.Pattern) -> String =
  match pat with
  | ast.WildcardPattern p ->
      string_concat_many(["(WildcardPattern ", encode_ast_pos(p), ")"])
  | ast.VarPattern name p ->
      string_concat_many(["(VarPattern ", encode_quoted_str(name), " ", encode_ast_pos(p), ")"])
  | ast.IntPattern n p ->
      string_concat_many(["(IntPattern ", int_to_string(n), " ", encode_ast_pos(p), ")"])
  | ast.BoolPattern b p ->
      string_concat_many(["(BoolPattern ", encode_ast_bool(b), " ", encode_ast_pos(p), ")"])
  | ast.StringPattern v p ->
      string_concat_many(["(StringPattern ", encode_quoted_str(v), " ", encode_ast_pos(p), ")"])
  | ast.CharPattern c p ->
      string_concat_many(["(CharPattern ", encode_ast_char(c), " ", encode_ast_pos(p), ")"])
  | ast.UnitPattern p ->
      string_concat_many(["(UnitPattern ", encode_ast_pos(p), ")"])
  | ast.TuplePattern pats p ->
      string_concat_many(["(TuplePattern ", encode_ast_pattern_list(pats), " ", encode_ast_pos(p), ")"])
  | ast.ConstructorPattern name pats p ->
      string_concat_many(["(ConstructorPattern ", encode_quoted_str(name), " ", encode_ast_pattern_list(pats), " ", encode_ast_pos(p), ")"])

fn encode_ast_pattern_list(xs: List ast.Pattern) -> String =
  string_concat_many(["(", join_ast_patterns(xs), ")"])

fn join_ast_patterns(xs: List ast.Pattern) -> String =
  match xs with
  | Nil -> ""
  | Cons p Nil -> encode_ast_pattern(p)
  | Cons p rest -> string_concat_many([encode_ast_pattern(p), " ", join_ast_patterns(rest)])

# ----------------------------------------------------------------------------
# Expr encoder
# ----------------------------------------------------------------------------

# O(n) in size of the expression tree.
export fn encode_ast_expr(e: ast.Expr) -> String =
  match e with
  | ast.VarExpr name p ->
      string_concat_many(["(VarExpr ", encode_quoted_str(name), " ", encode_ast_pos(p), ")"])
  | ast.IntExpr n p ->
      string_concat_many(["(IntExpr ", int_to_string(n), " ", encode_ast_pos(p), ")"])
  | ast.FloatExpr text p ->
      string_concat_many(["(FloatExpr ", encode_quoted_str(text), " ", encode_ast_pos(p), ")"])
  | ast.BoolExpr b p ->
      string_concat_many(["(BoolExpr ", encode_ast_bool(b), " ", encode_ast_pos(p), ")"])
  | ast.StringExpr v p ->
      string_concat_many(["(StringExpr ", encode_quoted_str(v), " ", encode_ast_pos(p), ")"])
  | ast.StringTemplateExpr parts p ->
      string_concat_many(["(StringTemplateExpr ", encode_template_part_list(parts), " ", encode_ast_pos(p), ")"])
  | ast.CharExpr c p ->
      string_concat_many(["(CharExpr ", encode_ast_char(c), " ", encode_ast_pos(p), ")"])
  | ast.UnitExpr p ->
      string_concat_many(["(UnitExpr ", encode_ast_pos(p), ")"])
  | ast.TupleExpr es p ->
      string_concat_many(["(TupleExpr ", encode_ast_expr_list(es), " ", encode_ast_pos(p), ")"])
  | ast.IfExpr cond t f p ->
      string_concat_many(["(IfExpr ", encode_ast_expr(cond), " ", encode_ast_expr(t), " ", encode_ast_expr(f), " ", encode_ast_pos(p), ")"])
  | ast.MatchExpr scrut branches p ->
      string_concat_many(["(MatchExpr ", encode_ast_expr(scrut), " ", encode_match_branch_list(branches), " ", encode_ast_pos(p), ")"])
  | ast.CallExpr fn_expr args p ->
      string_concat_many(["(CallExpr ", encode_ast_expr(fn_expr), " ", encode_ast_expr_list(args), " ", encode_ast_pos(p), ")"])
  | ast.LambdaExpr params body p ->
      string_concat_many(["(LambdaExpr ", encode_ast_param_list(params), " ", encode_ast_expr(body), " ", encode_ast_pos(p), ")"])
  | ast.BinaryExpr op lhs rhs p ->
      string_concat_many(["(BinaryExpr ", encode_quoted_str(op), " ", encode_ast_expr(lhs), " ", encode_ast_expr(rhs), " ", encode_ast_pos(p), ")"])
  | ast.UnaryExpr op operand p ->
      string_concat_many(["(UnaryExpr ", encode_quoted_str(op), " ", encode_ast_expr(operand), " ", encode_ast_pos(p), ")"])
  | ast.IntRangeExpr lo hi p ->
      string_concat_many(["(IntRangeExpr ", encode_ast_expr(lo), " ", encode_ast_expr(hi), " ", encode_ast_pos(p), ")"])
  | ast.DoExpr steps p ->
      string_concat_many(["(DoExpr ", encode_do_step_list(steps), " ", encode_ast_pos(p), ")"])
  | ast.RecordExpr name fields p ->
      string_concat_many(["(RecordExpr ", encode_quoted_str(name), " ", encode_record_field_list(fields), " ", encode_ast_pos(p), ")"])
  | ast.GetFieldExpr obj field p ->
      string_concat_many(["(GetFieldExpr ", encode_ast_expr(obj), " ", encode_quoted_str(field), " ", encode_ast_pos(p), ")"])

fn encode_ast_expr_list(xs: List ast.Expr) -> String =
  string_concat_many(["(", join_ast_exprs(xs), ")"])

fn join_ast_exprs(xs: List ast.Expr) -> String =
  match xs with
  | Nil -> ""
  | Cons e Nil -> encode_ast_expr(e)
  | Cons e rest -> string_concat_many([encode_ast_expr(e), " ", join_ast_exprs(rest)])

fn encode_match_branch(b: ast.MatchBranch) -> String =
  match b with
  | ast.MatchBranch pat body ->
      string_concat_many(["(MatchBranch ", encode_ast_pattern(pat), " ", encode_ast_expr(body), ")"])

fn encode_match_branch_list(xs: List ast.MatchBranch) -> String =
  string_concat_many(["(", join_match_branches(xs), ")"])

fn join_match_branches(xs: List ast.MatchBranch) -> String =
  match xs with
  | Nil -> ""
  | Cons b Nil -> encode_match_branch(b)
  | Cons b rest -> string_concat_many([encode_match_branch(b), " ", join_match_branches(rest)])

fn encode_do_step(step: ast.DoStep) -> String =
  match step with
  | ast.DoBindStep pat e ->
      string_concat_many(["(DoBindStep ", encode_ast_pattern(pat), " ", encode_ast_expr(e), ")"])
  | ast.DoLetStep name e ->
      string_concat_many(["(DoLetStep ", encode_quoted_str(name), " ", encode_ast_expr(e), ")"])
  | ast.DoExprStep e ->
      string_concat_many(["(DoExprStep ", encode_ast_expr(e), ")"])

fn encode_do_step_list(xs: List ast.DoStep) -> String =
  string_concat_many(["(", join_do_steps(xs), ")"])

fn join_do_steps(xs: List ast.DoStep) -> String =
  match xs with
  | Nil -> ""
  | Cons s Nil -> encode_do_step(s)
  | Cons s rest -> string_concat_many([encode_do_step(s), " ", join_do_steps(rest)])

fn encode_record_field(f: ast.RecordField) -> String =
  match f with
  | ast.RecordField name e ->
      string_concat_many(["(RecordField ", encode_quoted_str(name), " ", encode_ast_expr(e), ")"])

fn encode_record_field_list(xs: List ast.RecordField) -> String =
  string_concat_many(["(", join_record_fields(xs), ")"])

fn join_record_fields(xs: List ast.RecordField) -> String =
  match xs with
  | Nil -> ""
  | Cons f Nil -> encode_record_field(f)
  | Cons f rest -> string_concat_many([encode_record_field(f), " ", join_record_fields(rest)])

fn encode_template_part(part: ast.TemplateExprPart) -> String =
  match part with
  | ast.LitPart s ->
      string_concat_many(["(LitPart ", encode_quoted_str(s), ")"])
  | ast.InterpPart e ->
      string_concat_many(["(InterpPart ", encode_ast_expr(e), ")"])

fn encode_template_part_list(xs: List ast.TemplateExprPart) -> String =
  string_concat_many(["(", join_template_parts(xs), ")"])

fn join_template_parts(xs: List ast.TemplateExprPart) -> String =
  match xs with
  | Nil -> ""
  | Cons p Nil -> encode_template_part(p)
  | Cons p rest -> string_concat_many([encode_template_part(p), " ", join_template_parts(rest)])

# ----------------------------------------------------------------------------
# Decl encoder
# ----------------------------------------------------------------------------

fn encode_ast_type_constraint(tc: ast.TypeConstraint) -> String =
  match tc with
  | ast.TypeConstraint class_name args ->
      string_concat_many(["(TypeConstraint ", encode_quoted_str(class_name), " ", encode_ast_typeexpr_list(args), ")"])

fn encode_ast_type_constraint_list(xs: List ast.TypeConstraint) -> String =
  string_concat_many(["(", join_type_constraints(xs), ")"])

fn join_type_constraints(xs: List ast.TypeConstraint) -> String =
  match xs with
  | Nil -> ""
  | Cons tc Nil -> encode_ast_type_constraint(tc)
  | Cons tc rest -> string_concat_many([encode_ast_type_constraint(tc), " ", join_type_constraints(rest)])

fn encode_ast_type_constructor(ctor: ast.TypeConstructor) -> String =
  match ctor with
  | ast.TypeConstructor name fields ->
      string_concat_many(["(TypeConstructor ", encode_quoted_str(name), " ", encode_ast_typeexpr_list(fields), ")"])

fn encode_ast_type_constructor_list(xs: List ast.TypeConstructor) -> String =
  string_concat_many(["(", join_type_constructors(xs), ")"])

fn join_type_constructors(xs: List ast.TypeConstructor) -> String =
  match xs with
  | Nil -> ""
  | Cons c Nil -> encode_ast_type_constructor(c)
  | Cons c rest -> string_concat_many([encode_ast_type_constructor(c), " ", join_type_constructors(rest)])

fn encode_ast_record_field_decl(f: ast.RecordFieldDecl) -> String =
  match f with
  | ast.RecordFieldDecl name te ->
      string_concat_many(["(RecordFieldDecl ", encode_quoted_str(name), " ", encode_ast_typeexpr(te), ")"])

fn encode_ast_record_field_decl_list(xs: List ast.RecordFieldDecl) -> String =
  string_concat_many(["(", join_record_field_decls(xs), ")"])

fn join_record_field_decls(xs: List ast.RecordFieldDecl) -> String =
  match xs with
  | Nil -> ""
  | Cons f Nil -> encode_ast_record_field_decl(f)
  | Cons f rest -> string_concat_many([encode_ast_record_field_decl(f), " ", join_record_field_decls(rest)])

fn encode_ast_class_method_sig(m: ast.ClassMethodSig) -> String =
  match m with
  | ast.ClassMethodSig name params ret effects ->
      string_concat_many(["(ClassMethodSig ", encode_quoted_str(name), " ", encode_ast_param_list(params), " ", encode_ast_typeexpr(ret), " ", encode_maybe_str_list(effects), ")"])

fn encode_ast_class_method_sig_list(xs: List ast.ClassMethodSig) -> String =
  string_concat_many(["(", join_class_method_sigs(xs), ")"])

fn join_class_method_sigs(xs: List ast.ClassMethodSig) -> String =
  match xs with
  | Nil -> ""
  | Cons m Nil -> encode_ast_class_method_sig(m)
  | Cons m rest -> string_concat_many([encode_ast_class_method_sig(m), " ", join_class_method_sigs(rest)])

fn encode_ast_instance_method_impl(m: ast.InstanceMethodImpl) -> String =
  match m with
  | ast.InstanceMethodImpl name params ret effects body ->
      string_concat_many(["(InstanceMethodImpl ", encode_quoted_str(name), " ", encode_ast_param_list(params), " ", encode_maybe_typeexpr(ret), " ", encode_maybe_str_list(effects), " ", encode_ast_expr(body), ")"])

fn encode_ast_instance_method_impl_list(xs: List ast.InstanceMethodImpl) -> String =
  string_concat_many(["(", join_instance_method_impls(xs), ")"])

fn join_instance_method_impls(xs: List ast.InstanceMethodImpl) -> String =
  match xs with
  | Nil -> ""
  | Cons m Nil -> encode_ast_instance_method_impl(m)
  | Cons m rest -> string_concat_many([encode_ast_instance_method_impl(m), " ", join_instance_method_impls(rest)])

# O(n) in size of the declaration.
export fn encode_ast_decl(d: ast.Decl) -> String =
  match d with
  | ast.FnDecl name params ret effects constraints body p ->
      string_concat_many(["(FnDecl ", encode_quoted_str(name), " ", encode_ast_param_list(params), " ", encode_maybe_typeexpr(ret), " ", encode_maybe_str_list(effects), " ", encode_ast_type_constraint_list(constraints), " ", encode_ast_expr(body), " ", encode_ast_pos(p), ")"])
  | ast.ExternFnDecl name params ret effects p ->
      string_concat_many(["(ExternFnDecl ", encode_quoted_str(name), " ", encode_ast_param_list(params), " ", encode_maybe_typeexpr(ret), " ", encode_maybe_str_list(effects), " ", encode_ast_pos(p), ")"])
  | ast.TypeDecl name type_params ctors deriving_classes p ->
      string_concat_many(["(TypeDecl ", encode_quoted_str(name), " ", encode_str_list(type_params), " ", encode_ast_type_constructor_list(ctors), " ", encode_str_list(deriving_classes), " ", encode_ast_pos(p), ")"])
  | ast.RecordDecl name type_params fields p ->
      string_concat_many(["(RecordDecl ", encode_quoted_str(name), " ", encode_str_list(type_params), " ", encode_ast_record_field_decl_list(fields), " ", encode_ast_pos(p), ")"])
  | ast.LetDecl name body p ->
      string_concat_many(["(LetDecl ", encode_quoted_str(name), " ", encode_ast_expr(body), " ", encode_ast_pos(p), ")"])
  | ast.ClassDecl name type_params methods superclasses p ->
      string_concat_many(["(ClassDecl ", encode_quoted_str(name), " ", encode_str_list(type_params), " ", encode_ast_class_method_sig_list(methods), " ", encode_ast_type_constraint_list(superclasses), " ", encode_ast_pos(p), ")"])
  | ast.InstanceDecl constraint inst_constraints methods p ->
      string_concat_many(["(InstanceDecl ", encode_ast_type_constraint(constraint), " ", encode_ast_type_constraint_list(inst_constraints), " ", encode_ast_instance_method_impl_list(methods), " ", encode_ast_pos(p), ")"])
  | ast.AliasDecl name type_params rhs p ->
      string_concat_many(["(AliasDecl ", encode_quoted_str(name), " ", encode_str_list(type_params), " ", encode_ast_typeexpr(rhs), " ", encode_ast_pos(p), ")"])
  | ast.WrapDecl name inner p ->
      string_concat_many(["(WrapDecl ", encode_quoted_str(name), " ", encode_ast_typeexpr(inner), " ", encode_ast_pos(p), ")"])

fn encode_ast_decl_list(xs: List ast.Decl) -> String =
  string_concat_many(["(", join_ast_decls(xs), ")"])

fn join_ast_decls(xs: List ast.Decl) -> String =
  match xs with
  | Nil -> ""
  | Cons d Nil -> encode_ast_decl(d)
  | Cons d rest -> string_concat_many([encode_ast_decl(d), " ", join_ast_decls(rest)])

# O(n) in size of the program.
export fn encode_ast_program(prog: ast.Program) -> String =
  match prog with
  | ast.Program decls p ->
      string_concat_many(["(Program ", encode_ast_decl_list(decls), " ", encode_ast_pos(p), ")"])

# ============================================================================
# Decoder — String → Maybe AST
# ============================================================================
#
# All decoders share the existing tokenization primitives (skip_ws, read_atom,
# expect_char, etc.) from Phase 1.  New primitives are added for quoted strings,
# signed integers, booleans, chars, and positions.

# ----------------------------------------------------------------------------
# New primitive decoders
# ----------------------------------------------------------------------------

# Decode a quoted string starting at byte i.  Expects '"', body, '"'.
# Returns (unescaped_string, byte_pos_after_closing_quote).
# O(n) where n = byte length of the quoted literal.
fn decode_quoted_str_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (String, Int) =
  match expect_char(s, bytes, i, total, '"') with
  | Nothing -> Nothing
  | Just j -> collect_quoted_chars(s, bytes, j, total, Nil)

fn collect_quoted_chars(s: String, bytes: Bytes, i: Int, total: Int, acc: List String) -> Maybe (String, Int) =
  if i >= total then Nothing
  else
    match source.decode_char_at(bytes, i) with
    | Nothing -> Nothing
    | Just (ch, next_i) ->
        if ch == '"' then
          Just((string_concat_many(list_reverse(acc)), i + 1))
        else if ch == '\\' then
          decode_escape_seq(s, bytes, i + 1, total, acc)
        else
          collect_quoted_chars(s, bytes, next_i, total, Cons(char_to_string(ch), acc))

fn decode_escape_seq(s: String, bytes: Bytes, i: Int, total: Int, acc: List String) -> Maybe (String, Int) =
  if i >= total then Nothing
  else
    match source.decode_char_at(bytes, i) with
    | Nothing -> Nothing
    | Just (ch, _) ->
        if ch == '\\' then collect_quoted_chars(s, bytes, i + 1, total, Cons("\\", acc))
        else if ch == '"' then collect_quoted_chars(s, bytes, i + 1, total, Cons("\"", acc))
        else if ch == 'n' then collect_quoted_chars(s, bytes, i + 1, total, Cons("\n", acc))
        else if ch == 'r' then collect_quoted_chars(s, bytes, i + 1, total, Cons("\r", acc))
        else if ch == 't' then collect_quoted_chars(s, bytes, i + 1, total, Cons("\t", acc))
        else Nothing

# Decode a signed decimal integer atom.  atom_to_int returns Nothing if the
# atom is not a valid integer (avoiding parse_int's panic-on-invalid behavior).
fn atom_to_int(atom: String) -> Maybe Int =
  if str_byte_len(atom) == 0 then Nothing
  else
    match source.decode_char_at(bytes, 0) with
    | Nothing -> Nothing
    | Just (ch, _) ->
        if ch == '-' then
          if str_byte_len(atom) < 2 then Nothing
          else
            match parse_unsigned_atom(atom, bytes, 1, str_byte_len(atom), 0) with
            | Nothing -> Nothing
            | Just n -> Just(0 - n)
        else parse_unsigned_atom(atom, bytes, 0, str_byte_len(atom), 0)
  where bytes = bytes_from_utf8(atom)

fn parse_unsigned_atom(atom: String, bytes: Bytes, i: Int, total: Int, acc: Int) -> Maybe Int =
  if i >= total then Just(acc)
  else
    match source.decode_char_at(bytes, i) with
    | Nothing -> Nothing
    | Just (ch, _) ->
        if ch >= '0' && ch <= '9' then
          parse_unsigned_atom(atom, bytes, i + 1, total, acc * 10 + (char_digit_value(ch)))
        else Nothing

# Returns the decimal digit value 0-9 for a digit char.
fn char_digit_value(ch: Char) -> Int =
  if ch == '0' then 0
  else if ch == '1' then 1
  else if ch == '2' then 2
  else if ch == '3' then 3
  else if ch == '4' then 4
  else if ch == '5' then 5
  else if ch == '6' then 6
  else if ch == '7' then 7
  else if ch == '8' then 8
  else 9

# Reads one signed-int atom (a run of ['-']digit+).
fn read_int_atom(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (Int, Int) =
  match read_atom(s, bytes, i, total) with
  | Nothing -> Nothing
  | Just (atom, j) ->
      match atom_to_int(atom) with
      | Nothing -> Nothing
      | Just n -> Just((n, j))

# Reads one bool atom: 'true' or 'false'.
fn read_bool_atom(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (Bool, Int) =
  match read_atom(s, bytes, i, total) with
  | Nothing -> Nothing
  | Just (atom, j) ->
      if atom == "true" then Just((true, j))
      else if atom == "false" then Just((false, j))
      else Nothing

# Decodes (Char "<c>") — a single codepoint encoded as a quoted string.  Returns
# the codepoint as an Int (CharExpr/CharPattern carry the codepoint, not a Char).
fn decode_char_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (Int, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) ->
          if tag == "Char" then
            match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, k, total), total) with
            | Nothing -> Nothing
            | Just (cs, m) ->
                match source.decode_codepoint_at(bytes_from_utf8(cs), 0) with
                | Nothing -> Nothing
                | Just (cp, _) ->
                    match expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') with
                    | Nothing -> Nothing
                    | Just end -> Just((cp, end))
          else Nothing

# Decodes (Pos idx line col) into source.SourcePos.
fn decode_pos_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(source.SourcePos, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) ->
          if tag == "Pos" then
            match read_int_atom(s, bytes, skip_ws(s, bytes, k, total), total) with
            | Nothing -> Nothing
            | Just (idx, m1) ->
                match read_int_atom(s, bytes, skip_ws(s, bytes, m1, total), total) with
                | Nothing -> Nothing
                | Just (line, m2) ->
                    match read_int_atom(s, bytes, skip_ws(s, bytes, m2, total), total) with
                    | Nothing -> Nothing
                    | Just (col, m3) ->
                        match expect_char(s, bytes, skip_ws(s, bytes, m3, total), total, ')') with
                        | Nothing -> Nothing
                        | Just end -> Just((source.SourcePos(idx, line, col), end))
          else Nothing

# Decodes (Just <inner>) or (Nothing) for a Maybe (List String).
fn decode_maybe_str_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (Maybe (List String), Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) ->
          if tag == "Nothing" then
            match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
            | Nothing -> Nothing
            | Just end -> Just((Nothing, end))
          else if tag == "Just" then
            match decode_str_list_at(s, bytes, skip_ws(s, bytes, k, total), total) with
            | Nothing -> Nothing
            | Just (xs, m) ->
                match expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') with
                | Nothing -> Nothing
                | Just end -> Just((Just(xs), end))
          else Nothing

# Decodes (Just <typeexpr>) or (Nothing) for a Maybe TypeExpr.
fn decode_maybe_typeexpr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (Maybe ast.TypeExpr, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) ->
          if tag == "Nothing" then
            match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
            | Nothing -> Nothing
            | Just end -> Just((Nothing, end))
          else if tag == "Just" then
            match decode_ast_typeexpr_at(s, bytes, skip_ws(s, bytes, k, total), total) with
            | Nothing -> Nothing
            | Just (te, m) ->
                match expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') with
                | Nothing -> Nothing
                | Just end -> Just((Just(te), end))
          else Nothing

# ----------------------------------------------------------------------------
# TypeExpr decoder
# ----------------------------------------------------------------------------

fn decode_ast_typeexpr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.TypeExpr, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) -> decode_ast_typeexpr_by_tag(s, bytes, k, total, tag)

fn decode_ast_typeexpr_by_tag(s: String, bytes: Bytes, i: Int, total: Int, tag: String) -> Maybe(ast.TypeExpr, Int) =
  if tag == "TypeName" then decode_typename_at(s, bytes, i, total)
  else if tag == "TypeApply" then decode_typeapply_at(s, bytes, i, total)
  else if tag == "TypeArrow" then decode_typearrow_at(s, bytes, i, total)
  else if tag == "TypeEffect" then decode_typeeffect_at(s, bytes, i, total)
  else if tag == "TupleType" then decode_tupletype_at(s, bytes, i, total)
  else Nothing

fn decode_typename_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.TypeExpr, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match expect_char(s, bytes, skip_ws(s, bytes, j, total), total, ')') with
      | Nothing -> Nothing
      | Just end -> Just((ast.TypeName(name), end))

fn decode_typeapply_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.TypeExpr, Int) =
  match decode_ast_typeexpr_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (base, j) ->
      match decode_ast_typeexpr_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (arg, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.TypeApply(base, arg), end))

fn decode_typearrow_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.TypeExpr, Int) =
  match decode_ast_typeexpr_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (param, j) ->
      match decode_ast_typeexpr_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (ret, k) ->
          match decode_maybe_str_list_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (effects, m) ->
              match expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') with
              | Nothing -> Nothing
              | Just end -> Just((ast.TypeArrow(param, ret, effects), end))

fn decode_typeeffect_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.TypeExpr, Int) =
  match decode_ast_typeexpr_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (inner, j) ->
      match decode_str_list_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (labels, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.TypeEffect(inner, labels), end))

fn decode_tupletype_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.TypeExpr, Int) =
  match decode_ast_typeexpr_list_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (parts, j) ->
      match expect_char(s, bytes, skip_ws(s, bytes, j, total), total, ')') with
      | Nothing -> Nothing
      | Just end -> Just((ast.TupleType(parts), end))

fn decode_ast_typeexpr_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List ast.TypeExpr, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j -> collect_ast_typeexprs(s, bytes, skip_ws(s, bytes, j, total), total, Nil)

fn collect_ast_typeexprs(s: String, bytes: Bytes, i: Int, total: Int, acc: List ast.TypeExpr) -> Maybe (List ast.TypeExpr, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      match decode_ast_typeexpr_at(s, bytes, i, total) with
      | Nothing -> Nothing
      | Just (te, j) -> collect_ast_typeexprs(s, bytes, skip_ws(s, bytes, j, total), total, Cons(te, acc))

# ----------------------------------------------------------------------------
# Param decoder
# ----------------------------------------------------------------------------

fn decode_ast_param_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Param, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) ->
          if tag == "Param" then decode_param_body(s, bytes, k, total)
          else Nothing

fn decode_param_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Param, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match decode_maybe_typeexpr_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (maybe_te, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.Param(name, maybe_te), end))

fn decode_ast_param_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List ast.Param, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j -> collect_ast_params(s, bytes, skip_ws(s, bytes, j, total), total, Nil)

fn collect_ast_params(s: String, bytes: Bytes, i: Int, total: Int, acc: List ast.Param) -> Maybe (List ast.Param, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      match decode_ast_param_at(s, bytes, i, total) with
      | Nothing -> Nothing
      | Just (p, j) -> collect_ast_params(s, bytes, skip_ws(s, bytes, j, total), total, Cons(p, acc))

# ----------------------------------------------------------------------------
# Pattern decoder
# ----------------------------------------------------------------------------

fn decode_ast_pattern_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Pattern, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) -> decode_ast_pattern_by_tag(s, bytes, k, total, tag)

fn decode_ast_pattern_by_tag(s: String, bytes: Bytes, i: Int, total: Int, tag: String) -> Maybe(ast.Pattern, Int) =
  if tag == "WildcardPattern" then decode_wildcard_pattern_at(s, bytes, i, total)
  else if tag == "VarPattern" then decode_var_pattern_at(s, bytes, i, total)
  else if tag == "IntPattern" then decode_int_pattern_at(s, bytes, i, total)
  else if tag == "BoolPattern" then decode_bool_pattern_at(s, bytes, i, total)
  else if tag == "StringPattern" then decode_string_pattern_at(s, bytes, i, total)
  else if tag == "CharPattern" then decode_char_pattern_at(s, bytes, i, total)
  else if tag == "UnitPattern" then decode_unit_pattern_at(s, bytes, i, total)
  else if tag == "TuplePattern" then decode_tuple_pattern_at(s, bytes, i, total)
  else if tag == "ConstructorPattern" then decode_ctor_pattern_at(s, bytes, i, total)
  else Nothing

fn decode_wildcard_pattern_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Pattern, Int) =
  match decode_pos_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (p, j) ->
      match expect_char(s, bytes, skip_ws(s, bytes, j, total), total, ')') with
      | Nothing -> Nothing
      | Just end -> Just((ast.WildcardPattern(p), end))

fn decode_var_pattern_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Pattern, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match decode_pos_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (p, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.VarPattern(name, p), end))

fn decode_int_pattern_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Pattern, Int) =
  match read_int_atom(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (n, j) ->
      match decode_pos_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (p, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.IntPattern(n, p), end))

fn decode_bool_pattern_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Pattern, Int) =
  match read_bool_atom(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (b, j) ->
      match decode_pos_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (p, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.BoolPattern(b, p), end))

fn decode_string_pattern_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Pattern, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (v, j) ->
      match decode_pos_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (p, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.StringPattern(v, p), end))

fn decode_char_pattern_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Pattern, Int) =
  match decode_char_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (c, j) ->
      match decode_pos_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (p, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.CharPattern(c, p), end))

fn decode_unit_pattern_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Pattern, Int) =
  match decode_pos_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (p, j) ->
      match expect_char(s, bytes, skip_ws(s, bytes, j, total), total, ')') with
      | Nothing -> Nothing
      | Just end -> Just((ast.UnitPattern(p), end))

fn decode_tuple_pattern_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Pattern, Int) =
  match decode_ast_pattern_list_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (pats, j) ->
      match decode_pos_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (p, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.TuplePattern(pats, p), end))

fn decode_ctor_pattern_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Pattern, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match decode_ast_pattern_list_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (pats, k) ->
          match decode_pos_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (p, m) ->
              match expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') with
              | Nothing -> Nothing
              | Just end -> Just((ast.ConstructorPattern(name, pats, p), end))

fn decode_ast_pattern_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List ast.Pattern, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j -> collect_ast_patterns(s, bytes, skip_ws(s, bytes, j, total), total, Nil)

fn collect_ast_patterns(s: String, bytes: Bytes, i: Int, total: Int, acc: List ast.Pattern) -> Maybe (List ast.Pattern, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      match decode_ast_pattern_at(s, bytes, i, total) with
      | Nothing -> Nothing
      | Just (pat, j) -> collect_ast_patterns(s, bytes, skip_ws(s, bytes, j, total), total, Cons(pat, acc))

# ----------------------------------------------------------------------------
# Expr decoder
# ----------------------------------------------------------------------------

fn decode_ast_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) -> decode_ast_expr_by_tag(s, bytes, k, total, tag)

fn decode_ast_expr_by_tag(s: String, bytes: Bytes, i: Int, total: Int, tag: String) -> Maybe(ast.Expr, Int) =
  if tag == "VarExpr" then decode_var_expr_at(s, bytes, i, total)
  else if tag == "IntExpr" then decode_int_expr_at(s, bytes, i, total)
  else if tag == "FloatExpr" then decode_float_expr_at(s, bytes, i, total)
  else if tag == "BoolExpr" then decode_bool_expr_at(s, bytes, i, total)
  else if tag == "StringExpr" then decode_string_expr_at(s, bytes, i, total)
  else if tag == "StringTemplateExpr" then decode_string_template_expr_at(s, bytes, i, total)
  else if tag == "CharExpr" then decode_char_expr_at(s, bytes, i, total)
  else if tag == "UnitExpr" then decode_unit_expr_at(s, bytes, i, total)
  else if tag == "TupleExpr" then decode_tuple_expr_at(s, bytes, i, total)
  else if tag == "IfExpr" then decode_if_expr_at(s, bytes, i, total)
  else if tag == "MatchExpr" then decode_match_expr_at(s, bytes, i, total)
  else if tag == "CallExpr" then decode_call_expr_at(s, bytes, i, total)
  else if tag == "LambdaExpr" then decode_lambda_expr_at(s, bytes, i, total)
  else if tag == "BinaryExpr" then decode_binary_expr_at(s, bytes, i, total)
  else if tag == "UnaryExpr" then decode_unary_expr_at(s, bytes, i, total)
  else if tag == "IntRangeExpr" then decode_int_range_expr_at(s, bytes, i, total)
  else if tag == "DoExpr" then decode_do_expr_at(s, bytes, i, total)
  else if tag == "RecordExpr" then decode_record_expr_at(s, bytes, i, total)
  else if tag == "GetFieldExpr" then decode_get_field_expr_at(s, bytes, i, total)
  else Nothing

fn decode_var_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match decode_pos_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (p, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.VarExpr(name, p), end))

fn decode_int_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match read_int_atom(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (n, j) ->
      match decode_pos_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (p, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.IntExpr(n, p), end))

fn decode_bool_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match read_bool_atom(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (b, j) ->
      match decode_pos_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (p, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.BoolExpr(b, p), end))

fn decode_string_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (v, j) ->
      match decode_pos_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (p, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.StringExpr(v, p), end))

# FloatExpr carries its literal text (like StringExpr) — the numeric value is
# materialized in codegen, so the iface only round-trips the spelling.
fn decode_float_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (v, j) ->
      match decode_pos_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (p, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.FloatExpr(v, p), end))

fn decode_string_template_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match decode_template_part_list_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (parts, j) ->
      match decode_pos_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (p, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.StringTemplateExpr(parts, p), end))

fn decode_char_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match decode_char_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (c, j) ->
      match decode_pos_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (p, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.CharExpr(c, p), end))

fn decode_unit_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match decode_pos_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (p, j) ->
      match expect_char(s, bytes, skip_ws(s, bytes, j, total), total, ')') with
      | Nothing -> Nothing
      | Just end -> Just((ast.UnitExpr(p), end))

fn decode_tuple_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match decode_ast_expr_list_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (es, j) ->
      match decode_pos_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (p, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.TupleExpr(es, p), end))

fn decode_if_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (cond, j) ->
      match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (t, k) ->
          match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (f, m) ->
              match decode_pos_at(s, bytes, skip_ws(s, bytes, m, total), total) with
              | Nothing -> Nothing
              | Just (p, n) ->
                  match expect_char(s, bytes, skip_ws(s, bytes, n, total), total, ')') with
                  | Nothing -> Nothing
                  | Just end -> Just((ast.IfExpr(cond, t, f, p), end))

fn decode_match_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (scrut, j) ->
      match decode_match_branch_list_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (branches, k) ->
          match decode_pos_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (p, m) ->
              match expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') with
              | Nothing -> Nothing
              | Just end -> Just((ast.MatchExpr(scrut, branches, p), end))

fn decode_call_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (fn_expr, j) ->
      match decode_ast_expr_list_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (args, k) ->
          match decode_pos_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (p, m) ->
              match expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') with
              | Nothing -> Nothing
              | Just end -> Just((ast.CallExpr(fn_expr, args, p), end))

fn decode_lambda_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match decode_ast_param_list_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (params, j) ->
      match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (body, k) ->
          match decode_pos_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (p, m) ->
              match expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') with
              | Nothing -> Nothing
              | Just end -> Just((ast.LambdaExpr(params, body, p), end))

fn decode_binary_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (op, j) ->
      match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (lhs, k) ->
          match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (rhs, m) ->
              match decode_pos_at(s, bytes, skip_ws(s, bytes, m, total), total) with
              | Nothing -> Nothing
              | Just (p, n) ->
                  match expect_char(s, bytes, skip_ws(s, bytes, n, total), total, ')') with
                  | Nothing -> Nothing
                  | Just end -> Just((ast.BinaryExpr(op, lhs, rhs, p), end))

fn decode_unary_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (op, j) ->
      match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (operand, k) ->
          match decode_pos_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (p, m) ->
              match expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') with
              | Nothing -> Nothing
              | Just end -> Just((ast.UnaryExpr(op, operand, p), end))

fn decode_int_range_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (lo, j) ->
      match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (hi, k) ->
          match decode_pos_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (p, m) ->
              match expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') with
              | Nothing -> Nothing
              | Just end -> Just((ast.IntRangeExpr(lo, hi, p), end))

fn decode_do_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match decode_do_step_list_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (steps, j) ->
      match decode_pos_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (p, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.DoExpr(steps, p), end))

fn decode_record_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match decode_record_field_list_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (fields, k) ->
          match decode_pos_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (p, m) ->
              match expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') with
              | Nothing -> Nothing
              | Just end -> Just((ast.RecordExpr(name, fields, p), end))

fn decode_get_field_expr_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Expr, Int) =
  match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (obj, j) ->
      match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (field, k) ->
          match decode_pos_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (p, m) ->
              match expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') with
              | Nothing -> Nothing
              | Just end -> Just((ast.GetFieldExpr(obj, field, p), end))

fn decode_ast_expr_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List ast.Expr, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j -> collect_ast_exprs(s, bytes, skip_ws(s, bytes, j, total), total, Nil)

fn collect_ast_exprs(s: String, bytes: Bytes, i: Int, total: Int, acc: List ast.Expr) -> Maybe (List ast.Expr, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      match decode_ast_expr_at(s, bytes, i, total) with
      | Nothing -> Nothing
      | Just (e, j) -> collect_ast_exprs(s, bytes, skip_ws(s, bytes, j, total), total, Cons(e, acc))

fn decode_match_branch_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.MatchBranch, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) ->
          if tag == "MatchBranch" then decode_match_branch_body(s, bytes, k, total)
          else Nothing

fn decode_match_branch_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.MatchBranch, Int) =
  match decode_ast_pattern_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (pat, j) ->
      match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (body, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.MatchBranch(pat, body), end))

fn decode_match_branch_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List ast.MatchBranch, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j -> collect_match_branches(s, bytes, skip_ws(s, bytes, j, total), total, Nil)

fn collect_match_branches(s: String, bytes: Bytes, i: Int, total: Int, acc: List ast.MatchBranch) -> Maybe (List ast.MatchBranch, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      match decode_match_branch_at(s, bytes, i, total) with
      | Nothing -> Nothing
      | Just (b, j) -> collect_match_branches(s, bytes, skip_ws(s, bytes, j, total), total, Cons(b, acc))

fn decode_do_step_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.DoStep, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) ->
          if tag == "DoBindStep" then decode_do_bind_step_body(s, bytes, k, total)
          else if tag == "DoLetStep" then decode_do_let_step_body(s, bytes, k, total)
          else if tag == "DoExprStep" then decode_do_expr_step_body(s, bytes, k, total)
          else Nothing

fn decode_do_bind_step_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.DoStep, Int) =
