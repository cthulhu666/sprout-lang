fn collect_record_fields(s: String, bytes: Bytes, i: Int, total: Int, acc: List ast.RecordField) -> Maybe (List ast.RecordField, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      match decode_record_field_at(s, bytes, i, total) with
      | Nothing -> Nothing
      | Just (f, j) -> collect_record_fields(s, bytes, skip_ws(s, bytes, j, total), total, Cons(f, acc))

fn decode_template_part_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.TemplateExprPart, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) ->
          if tag == "LitPart" then decode_lit_part_body(s, bytes, k, total)
          else if tag == "InterpPart" then decode_interp_part_body(s, bytes, k, total)
          else Nothing

fn decode_lit_part_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.TemplateExprPart, Int) =
