fn decode_ast_class_method_sig_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.ClassMethodSig, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) ->
          if tag == "ClassMethodSig" then decode_class_method_sig_body(s, bytes, k, total)
          else Nothing

fn decode_class_method_sig_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.ClassMethodSig, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match decode_ast_param_list_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (params, k) ->
          match decode_ast_typeexpr_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (ret, m) ->
              match decode_maybe_str_list_at(s, bytes, skip_ws(s, bytes, m, total), total) with
              | Nothing -> Nothing
              | Just (effects, n) ->
                  match expect_char(s, bytes, skip_ws(s, bytes, n, total), total, ')') with
                  | Nothing -> Nothing
                  | Just end -> Just((ast.ClassMethodSig(name, params, ret, effects), end))

fn decode_ast_class_method_sig_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List ast.ClassMethodSig, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j -> collect_ast_class_method_sigs(s, bytes, skip_ws(s, bytes, j, total), total, Nil)

fn collect_ast_class_method_sigs(s: String, bytes: Bytes, i: Int, total: Int, acc: List ast.ClassMethodSig) -> Maybe (List ast.ClassMethodSig, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      match decode_ast_class_method_sig_at(s, bytes, i, total) with
      | Nothing -> Nothing
      | Just (m, j) -> collect_ast_class_method_sigs(s, bytes, skip_ws(s, bytes, j, total), total, Cons(m, acc))

fn decode_ast_instance_method_impl_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.InstanceMethodImpl, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) ->
          if tag == "InstanceMethodImpl" then decode_instance_method_impl_body(s, bytes, k, total)
          else Nothing

fn decode_instance_method_impl_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.InstanceMethodImpl, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match decode_ast_param_list_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (params, k) ->
          match decode_maybe_typeexpr_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (ret, m) ->
              match decode_maybe_str_list_at(s, bytes, skip_ws(s, bytes, m, total), total) with
              | Nothing -> Nothing
              | Just (effects, n) ->
                  match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, n, total), total) with
                  | Nothing -> Nothing
                  | Just (body, p) ->
                      match expect_char(s, bytes, skip_ws(s, bytes, p, total), total, ')') with
                      | Nothing -> Nothing
                      | Just end -> Just((ast.InstanceMethodImpl(name, params, ret, effects, body), end))

fn decode_ast_instance_method_impl_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List ast.InstanceMethodImpl, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j -> collect_ast_instance_method_impls(s, bytes, skip_ws(s, bytes, j, total), total, Nil)

fn collect_ast_instance_method_impls(s: String, bytes: Bytes, i: Int, total: Int, acc: List ast.InstanceMethodImpl) -> Maybe (List ast.InstanceMethodImpl, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      match decode_ast_instance_method_impl_at(s, bytes, i, total) with
      | Nothing -> Nothing
      | Just (m, j) -> collect_ast_instance_method_impls(s, bytes, skip_ws(s, bytes, j, total), total, Cons(m, acc))

fn decode_ast_decl_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Decl, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) -> decode_ast_decl_by_tag(s, bytes, k, total, tag)

fn decode_ast_decl_by_tag(s: String, bytes: Bytes, i: Int, total: Int, tag: String) -> Maybe(ast.Decl, Int) =
  if tag == "FnDecl" then decode_fn_decl_body(s, bytes, i, total)
  else if tag == "ExternFnDecl" then decode_extern_fn_decl_body(s, bytes, i, total)
  else if tag == "TypeDecl" then decode_type_decl_body(s, bytes, i, total)
  else if tag == "RecordDecl" then decode_record_decl_body(s, bytes, i, total)
  else if tag == "LetDecl" then decode_let_decl_body(s, bytes, i, total)
  else if tag == "ClassDecl" then decode_class_decl_body(s, bytes, i, total)
  else if tag == "InstanceDecl" then decode_instance_decl_body(s, bytes, i, total)
  else if tag == "AliasDecl" then decode_alias_decl_body(s, bytes, i, total)
  else if tag == "WrapDecl" then decode_wrap_decl_body(s, bytes, i, total)
  else Nothing

fn decode_fn_decl_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Decl, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match decode_ast_param_list_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (params, k) ->
          match decode_maybe_typeexpr_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (ret, m) ->
              match decode_maybe_str_list_at(s, bytes, skip_ws(s, bytes, m, total), total) with
              | Nothing -> Nothing
              | Just (effects, n) ->
                  match decode_ast_type_constraint_list_at(s, bytes, skip_ws(s, bytes, n, total), total) with
                  | Nothing -> Nothing
                  | Just (constraints, p) ->
                      match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, p, total), total) with
                      | Nothing -> Nothing
                      | Just (body, q) ->
                          match decode_pos_at(s, bytes, skip_ws(s, bytes, q, total), total) with
                          | Nothing -> Nothing
                          | Just (pos, r) ->
                              match expect_char(s, bytes, skip_ws(s, bytes, r, total), total, ')') with
                              | Nothing -> Nothing
                              | Just end -> Just((ast.FnDecl(name, params, ret, effects, constraints, body, pos), end))

fn decode_extern_fn_decl_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Decl, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match decode_ast_param_list_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (params, k) ->
          match decode_maybe_typeexpr_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (ret, m) ->
              match decode_maybe_str_list_at(s, bytes, skip_ws(s, bytes, m, total), total) with
              | Nothing -> Nothing
              | Just (effects, n) ->
                  match decode_pos_at(s, bytes, skip_ws(s, bytes, n, total), total) with
                  | Nothing -> Nothing
                  | Just (pos, p) ->
                      match expect_char(s, bytes, skip_ws(s, bytes, p, total), total, ')') with
                      | Nothing -> Nothing
                      | Just end -> Just((ast.ExternFnDecl(name, params, ret, effects, pos), end))

fn decode_type_decl_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Decl, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match decode_str_list_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (type_params, k) ->
          match decode_ast_type_constructor_list_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (ctors, m) ->
              match decode_str_list_at(s, bytes, skip_ws(s, bytes, m, total), total) with
              | Nothing -> Nothing
              | Just (deriving_classes, n) ->
                  match decode_pos_at(s, bytes, skip_ws(s, bytes, n, total), total) with
                  | Nothing -> Nothing
                  | Just (pos, p) ->
                      match expect_char(s, bytes, skip_ws(s, bytes, p, total), total, ')') with
                      | Nothing -> Nothing
                      | Just end -> Just((ast.TypeDecl(name, type_params, ctors, deriving_classes, pos), end))

fn decode_record_decl_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Decl, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match decode_str_list_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (type_params, k) ->
          match decode_ast_record_field_decl_list_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (fields, m) ->
              match decode_pos_at(s, bytes, skip_ws(s, bytes, m, total), total) with
              | Nothing -> Nothing
              | Just (pos, n) ->
                  match expect_char(s, bytes, skip_ws(s, bytes, n, total), total, ')') with
                  | Nothing -> Nothing
                  | Just end -> Just((ast.RecordDecl(name, type_params, fields, pos), end))

fn decode_let_decl_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Decl, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (body, k) ->
          match decode_pos_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (pos, m) ->
              match expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') with
              | Nothing -> Nothing
              | Just end -> Just((ast.LetDecl(name, body, pos), end))

fn decode_class_decl_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Decl, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match decode_str_list_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (type_params, k) ->
          match decode_ast_class_method_sig_list_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (methods, m) ->
              match decode_ast_type_constraint_list_at(s, bytes, skip_ws(s, bytes, m, total), total) with
              | Nothing -> Nothing
              | Just (superclasses, n) ->
                  match decode_pos_at(s, bytes, skip_ws(s, bytes, n, total), total) with
                  | Nothing -> Nothing
                  | Just (pos, p) ->
                      match expect_char(s, bytes, skip_ws(s, bytes, p, total), total, ')') with
                      | Nothing -> Nothing
                      | Just end -> Just((ast.ClassDecl(name, type_params, methods, superclasses, pos), end))

fn decode_instance_decl_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Decl, Int) =
  match decode_ast_type_constraint_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (constraint, j) ->
      match decode_ast_type_constraint_list_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (inst_constraints, k) ->
          match decode_ast_instance_method_impl_list_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (methods, m) ->
              match decode_pos_at(s, bytes, skip_ws(s, bytes, m, total), total) with
              | Nothing -> Nothing
              | Just (pos, n) ->
                  match expect_char(s, bytes, skip_ws(s, bytes, n, total), total, ')') with
                  | Nothing -> Nothing
                  | Just end -> Just((ast.InstanceDecl(constraint, inst_constraints, methods, pos), end))

fn decode_alias_decl_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Decl, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match decode_str_list_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (type_params, k) ->
          match decode_ast_typeexpr_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (rhs, m) ->
              match decode_pos_at(s, bytes, skip_ws(s, bytes, m, total), total) with
              | Nothing -> Nothing
              | Just (pos, n) ->
                  match expect_char(s, bytes, skip_ws(s, bytes, n, total), total, ')') with
                  | Nothing -> Nothing
                  | Just end -> Just((ast.AliasDecl(name, type_params, rhs, pos), end))

# WrapDecl body: name (quoted str), inner type-expr, pos.  Mirrors the encoder
# arm in encode_ast_decl.  Added when W5 exhaustiveness surfaced that the codec
# never handled WrapDecl (added with the `wrap` keyword).
fn decode_wrap_decl_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Decl, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match decode_ast_typeexpr_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (inner, k) ->
          match decode_pos_at(s, bytes, skip_ws(s, bytes, k, total), total) with
          | Nothing -> Nothing
          | Just (pos, n) ->
              match expect_char(s, bytes, skip_ws(s, bytes, n, total), total, ')') with
              | Nothing -> Nothing
              | Just end -> Just((ast.WrapDecl(name, inner, pos), end))

fn decode_ast_decl_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List ast.Decl, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j -> collect_ast_decls(s, bytes, skip_ws(s, bytes, j, total), total, Nil)

fn collect_ast_decls(s: String, bytes: Bytes, i: Int, total: Int, acc: List ast.Decl) -> Maybe (List ast.Decl, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      match decode_ast_decl_at(s, bytes, i, total) with
      | Nothing -> Nothing
      | Just (d, j) -> collect_ast_decls(s, bytes, skip_ws(s, bytes, j, total), total, Cons(d, acc))

# ----------------------------------------------------------------------------
# Top-level entry points
# ----------------------------------------------------------------------------

# O(n) in size of the expression.
export fn decode_ast_expr(input: String) -> Maybe ast.Expr =
  match decode_ast_expr_at(input, bytes, skip_ws(input, bytes, 0, n), n) with
  | Nothing -> Nothing
  | Just (e, next) ->
      if only_ws_remaining(input, bytes, next, n) then Just(e) else Nothing
  where n = str_byte_len(input)
        bytes = bytes_from_utf8(input)

# O(n) in size of the pattern.
export fn decode_ast_pattern(input: String) -> Maybe ast.Pattern =
  match decode_ast_pattern_at(input, bytes, skip_ws(input, bytes, 0, n), n) with
  | Nothing -> Nothing
  | Just (p, next) ->
      if only_ws_remaining(input, bytes, next, n) then Just(p) else Nothing
  where n = str_byte_len(input)
        bytes = bytes_from_utf8(input)

# O(n) in size of the declaration.
export fn decode_ast_decl(input: String) -> Maybe ast.Decl =
  match decode_ast_decl_at(input, bytes, skip_ws(input, bytes, 0, n), n) with
  | Nothing -> Nothing
  | Just (d, next) ->
      if only_ws_remaining(input, bytes, next, n) then Just(d) else Nothing
  where n = str_byte_len(input)
        bytes = bytes_from_utf8(input)

# O(n) in size of the program.
export fn decode_ast_program(input: String) -> Maybe ast.Program =
  match decode_ast_program_at(input, bytes, skip_ws(input, bytes, 0, n), n) with
  | Nothing -> Nothing
  | Just (prog, next) ->
      if only_ws_remaining(input, bytes, next, n) then Just(prog) else Nothing
  where n = str_byte_len(input)
        bytes = bytes_from_utf8(input)

fn decode_ast_program_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Program, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j ->
      match read_atom(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (tag, k) ->
          if tag == "Program" then decode_program_body(s, bytes, k, total)
          else Nothing

fn decode_program_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.Program, Int) =
  match decode_ast_decl_list_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (decls, j) ->
      match decode_pos_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (pos, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.Program(decls, pos), end))
