  | Nothing -> Nothing
  | Just (pat, j) ->
      match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (e, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.DoBindStep(pat, e), end))

fn decode_do_let_step_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.DoStep, Int) =
  match decode_quoted_str_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (name, j) ->
      match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, j, total), total) with
      | Nothing -> Nothing
      | Just (e, k) ->
          match expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') with
          | Nothing -> Nothing
          | Just end -> Just((ast.DoLetStep(name, e), end))

fn decode_do_expr_step_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.DoStep, Int) =
  match decode_ast_expr_at(s, bytes, skip_ws(s, bytes, i, total), total) with
  | Nothing -> Nothing
  | Just (e, j) ->
      match expect_char(s, bytes, skip_ws(s, bytes, j, total), total, ')') with
      | Nothing -> Nothing
      | Just end -> Just((ast.DoExprStep(e), end))

fn decode_do_step_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List ast.DoStep, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j -> collect_do_steps(s, bytes, skip_ws(s, bytes, j, total), total, Nil)

fn collect_do_steps(s: String, bytes: Bytes, i: Int, total: Int, acc: List ast.DoStep) -> Maybe (List ast.DoStep, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      match decode_do_step_at(s, bytes, i, total) with
      | Nothing -> Nothing
      | Just (step, j) -> collect_do_steps(s, bytes, skip_ws(s, bytes, j, total), total, Cons(step, acc))

fn decode_record_field_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(ast.RecordField, Int) =
