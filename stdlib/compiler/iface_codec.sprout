      | Nothing -> Nothing
      | Just end -> Just((ast.InterpPart(e), end))

fn decode_template_part_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List ast.TemplateExprPart, Int) =
  match expect_char(s, bytes, i, total, '(') with
  | Nothing -> Nothing
  | Just j -> collect_template_parts(s, bytes, skip_ws(s, bytes, j, total), total, Nil)

fn collect_template_parts(s: String, bytes: Bytes, i: Int, total: Int, acc: List ast.TemplateExprPart) -> Maybe (List ast.TemplateExprPart, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      match decode_template_part_at(s, bytes, i, total) with
      | Nothing -> Nothing
      | Just (p, j) -> collect_template_parts(s, bytes, skip_ws(s, bytes, j, total), total, Cons(p, acc))

