module stdlib.compiler.iface_codec
import stdlib.compiler.types as types
import stdlib.compiler.ast as ast
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.source as source
import stdlib.compiler.linear_check as linear_check
# Load-bearing despite the alias never being written — see the note in source.sprout.
# `bytes_from_utf8` is an extern owned by stdlib.bytes and needs that module bundled.
import stdlib.bytes as bytes
import stdlib.string as string

# ============================================================================
# Iface codec — hand-written serialize/deserialize for types.Scheme and its
# transitive deps (types.Type, types.Effect).
#
# Phase 1 of the iface PR series (docs/iface-precompiled-modules-v1-draft.md
# §"Smallest verifiable Phase 1 unit"): provides round-trip primitives only.
# No bundler integration, no .iface file I/O, no source-hash check, no ctor
# /class/instance metadata yet — those are follow-up phases.
#
# Format (bespoke S-expression, all ASCII):
#   <scheme>  := ( Scheme <strs> <strs> <type> <effect> )
#   <type>    := ( TVar <atom> )
#              | ( TConst <atom> )
#              | ( TApp <type> <type> )
#              | ( TFunc <type> <type> <effect> <own> )
#              | ( TThunk <type> <effect> )      # `() -> T`, no param, no own
#              | ( TTuple <types> )
#   <own>     := borrow | consume        # M4.6 parameter ownership
#   <effect>  := ( EffectPure )
#              | ( EffectIO )
#              | ( EffectRow <strs> )
#              | ( EffectVar <atom> )
#   <strs>    := ( atom* )
#   <types>   := ( <type>* )
#   <atom>    := ASCII identifier — no whitespace, no parens, no quotes
#
# Atoms are bare identifiers because type-var names, ctor names, and effect
# labels are ASCII identifiers by language spec. No escape handling needed.
# ============================================================================

# ----------------------------------------------------------------------------
# Encoder — Scheme -> String
# ----------------------------------------------------------------------------

# O(n) where n = total atoms in the scheme.
export fn encode_scheme(s: types.Scheme) -> String =
  match s with
  | types.Scheme tvars evars body effect constraints ->
      string_concat_many(["(Scheme ", encode_str_list(tvars), " ", encode_str_list(evars), " ", encode_type(body), " ", encode_effect(effect), " ", encode_constraints(constraints), ")"])

# Constraints wire form: `(<pair> <pair> ...)`, each pair `(<head_token> <class>)`.
# Empty = `()`.  head_token is an atom ("#pos:<k>" | "<Name>" | "#app:<Name>" |
# "#none"); all are atom-safe (no whitespace/parens — a ':' is fine, "#pos:" and
# "#app:" both carry one). Mirrors encode_str_list / encode_type_list.
fn encode_constraints(cs: List (String, String)) -> String =
  string_concat_many(["(", join_constraints(cs), ")"])

fn join_constraints(cs: List (String, String)) -> String =
  match cs with
  | [] -> ""
  | [c] -> encode_constraint(c)
  | [c | rest] -> string_concat_many([encode_constraint(c), " ", join_constraints(rest)])

fn encode_constraint(c: (String, String)) -> String =
  match c with
  | (head, cls) -> string_concat_many(["(", head, " ", cls, ")"])

export fn encode_type(t: types.Type) -> String =
  match t with
  | types.TVar n -> string_concat_many(["(TVar ", types.tyvar_identity(n), ")"])
  | types.TConst n -> string_concat_many(["(TConst ", types.type_id_name(n), ")"])
  | types.TApp a b ->
      string_concat_many(["(TApp ", encode_type(a), " ", encode_type(b), ")"])
  | types.TFunc a b e o ->
      string_concat_many(["(TFunc ", encode_type(a), " ", encode_type(b), " ", encode_effect(e),
                          " ", encode_ownership(o), ")"])
  | types.TThunk b e ->
      string_concat_many(["(TThunk ", encode_type(b), " ", encode_effect(e), ")"])
  | types.TTuple ts ->
      string_concat_many(["(TTuple ", encode_type_list(ts), ")"])

export fn encode_effect(e: types.Effect) -> String =
  match e with
  | types.EffectPure -> "(EffectPure)"
  | types.EffectIO -> "(EffectIO)"
  | types.EffectRow xs ->
      string_concat_many(["(EffectRow ", encode_str_list(xs), ")"])
  | types.EffectVar n -> string_concat_many(["(EffectVar ", n, ")"])

fn encode_str_list(xs: List String) -> String =
  string_concat_many(["(", join_strs(xs), ")"])

# Join with single-space separator. O(n).
fn join_strs(xs: List String) -> String =
  match xs with
  | [] -> ""
  | [x] -> x
  | [x | rest] -> string_concat_many([x, " ", join_strs(rest)])

fn encode_type_list(ts: List types.Type) -> String =
  string_concat_many(["(", join_types(ts), ")"])

fn join_types(ts: List types.Type) -> String =
  match ts with
  | [] -> ""
  | [t] -> encode_type(t)
  | [t | rest] -> string_concat_many([encode_type(t), " ", join_types(rest)])

# ----------------------------------------------------------------------------
# Decoder — String -> Maybe Scheme
# ----------------------------------------------------------------------------
#
# Top-level entry: parses input as a complete Scheme. Returns Nothing on any
# parse failure or if there's leftover non-whitespace after the value.

export fn decode_scheme(input: String) -> Maybe types.Scheme =
  decode_whole(decode_scheme_at, input)

# `input` as exactly one value read by `dec`, with only whitespace around it.
fn decode_whole(dec: String -> Bytes -> Int -> Int -> Maybe(a, Int), input: String) -> Maybe a =
  let Just(v, next) = dec(input, bytes, skip_ws(input, bytes, 0, n), n) else Nothing
  in if only_ws_remaining(input, bytes, next, n) then Just(v) else Nothing
  where n = str_byte_len(input)
        bytes = bytes_from_utf8(input)

# ----------------------------------------------------------------------------
# Tokenization primitives
# ----------------------------------------------------------------------------

fn is_ws(ch: Char) -> Bool =
  ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'

# O(leading-ws). Returns the byte position past any leading whitespace.
fn skip_ws(s: String, bytes: Bytes, i: Int, total: Int) -> Int =
  if i >= total then i
  else
    match source.decode_char_at(bytes, i) with
    | Nothing -> i
    | Just (ch, _) -> if is_ws(ch) then skip_ws(s, bytes, i + 1, total) else i

# True iff bytes [i, total) contain only whitespace.
fn only_ws_remaining(s: String, bytes: Bytes, i: Int, total: Int) -> Bool =
  skip_ws(s, bytes, i, total) == total

# Expect a specific ASCII char at byte i. Returns Just(i+1) on match.
fn expect_char(s: String, bytes: Bytes, i: Int, total: Int, ch: Char) -> Maybe Int =
  if i >= total then Nothing
  else
    match source.decode_char_at(bytes, i) with
    | Nothing -> Nothing
    | Just (c, _) -> if c == ch then Just(i + 1) else Nothing

# Atoms are runs of bytes that aren't whitespace or parens.
fn is_atom_char(ch: Char) -> Bool =
  if is_ws(ch) then false
  else if ch == '(' then false
  else if ch == ')' then false
  else true

# Reads one atom starting at byte i. Returns (atom_string, byte_pos_after).
fn read_atom(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (String, Int) =
  if i >= total then Nothing
  else
    match source.decode_char_at(bytes, i) with
    | Nothing -> Nothing
    | Just (c, _) -> if is_atom_char(c) then read_atom_continue(s, bytes, i, total) else Nothing

fn read_atom_continue(s: String, bytes: Bytes, start: Int, total: Int) -> Maybe (String, Int) =
  Just((str_slice(s, start, end_pos - start), end_pos))
  where end_pos = scan_atom_end(s, bytes, start + 1, total)

# Scans forward from i until the next non-atom char or EOF; returns that position.
fn scan_atom_end(s: String, bytes: Bytes, i: Int, total: Int) -> Int =
  if i >= total then i
  else
    match source.decode_char_at(bytes, i) with
    | Nothing -> i
    | Just (c, _) -> if is_atom_char(c) then scan_atom_end(s, bytes, i + 1, total) else i

# ----------------------------------------------------------------------------
# Decoders return Just(value, byte_pos_after) on success.
# All decoders begin by expecting `(`, then the tagged atom, etc.
# ----------------------------------------------------------------------------

# `(<tag> ...)`: the node's tag must be `tag`; `body` reads the rest.
fn decode_tagged(tag: String, body: String -> Bytes -> Int -> Int -> Maybe(a, Int),
                 s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(a, Int) =
  let Just j = expect_char(s, bytes, i, total, '(') else Nothing
      Just(found, k) = read_atom(s, bytes, skip_ws(s, bytes, j, total), total) else Nothing
  in if found == tag then body(s, bytes, k, total) else Nothing

# `( <item>* )`, each item read by `item`.
fn decode_list_at(item: String -> Bytes -> Int -> Int -> Maybe(a, Int),
                  s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List a, Int) =
  let Just j = expect_char(s, bytes, i, total, '(') else Nothing
  in decode_items(item, s, bytes, skip_ws(s, bytes, j, total), total, Nil)

fn decode_items(item: String -> Bytes -> Int -> Int -> Maybe(a, Int),
                s: String, bytes: Bytes, i: Int, total: Int, acc: List a) -> Maybe (List a, Int) =
  match expect_char(s, bytes, i, total, ')') with
  | Just end -> Just((list_reverse(acc), end))
  | Nothing ->
      let Just(x, j) = item(s, bytes, i, total) else Nothing
      in decode_items(item, s, bytes, skip_ws(s, bytes, j, total), total, Cons(x, acc))

fn decode_scheme_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Scheme, Int) =
  decode_tagged("Scheme", decode_scheme_body, s, bytes, i, total)

fn decode_scheme_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Scheme, Int) =
  let Just(tvars, k2) = decode_str_list_at(s, bytes, skip_ws(s, bytes, i, total), total) else Nothing
      Just(evars, k3) = decode_str_list_at(s, bytes, skip_ws(s, bytes, k2, total), total) else Nothing
      Just(body, k4) = decode_type_at(s, bytes, skip_ws(s, bytes, k3, total), total) else Nothing
      Just(effect, k5) = decode_effect_at(s, bytes, skip_ws(s, bytes, k4, total), total) else Nothing
      Just(constraints, k6) = decode_constraints_at(s, bytes, skip_ws(s, bytes, k5, total), total) else Nothing
      Just end = expect_char(s, bytes, skip_ws(s, bytes, k6, total), total, ')') else Nothing
  in Just((types.Scheme(tvars, evars, body, effect, constraints), end))

# Parse `(<pair> <pair> ...)` where each pair is `(<head_token> <class>)`.
fn decode_constraints_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List (String, String), Int) =
  decode_list_at(decode_constraint_at, s, bytes, i, total)

fn decode_constraint_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe((String, String), Int) =
  let Just j = expect_char(s, bytes, i, total, '(') else Nothing
      Just(head, k) = read_atom(s, bytes, skip_ws(s, bytes, j, total), total) else Nothing
      Just(cls, end) = read_atom_then_close(s, bytes, k, total) else Nothing
  in Just(((head, cls), end))

fn decode_type_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Type, Int) =
  let Just j = expect_char(s, bytes, i, total, '(') else Nothing
      Just(tag, k) = read_atom(s, bytes, skip_ws(s, bytes, j, total), total) else Nothing
  in decode_type_by_tag(s, bytes, k, total, tag)

fn decode_type_by_tag(s: String, bytes: Bytes, i: Int, total: Int, tag: String) -> Maybe(types.Type, Int) =
  if tag == "TVar" then decode_tvar_at(s, bytes, i, total)
  else if tag == "TConst" then decode_tconst_at(s, bytes, i, total)
  else if tag == "TApp" then decode_tapp_at(s, bytes, i, total)
  else if tag == "TFunc" then decode_tfunc_at(s, bytes, i, total)
  else if tag == "TThunk" then decode_tthunk_at(s, bytes, i, total)
  else if tag == "TTuple" then decode_ttuple_at(s, bytes, i, total)
  else Nothing

# Reads `<atom>)`. Returns the atom + position past the `)`.
fn read_atom_then_close(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (String, Int) =
  let Just(name, j) = read_atom(s, bytes, skip_ws(s, bytes, i, total), total) else Nothing
      Just end = expect_char(s, bytes, skip_ws(s, bytes, j, total), total, ')') else Nothing
  in Just((name, end))

fn decode_tvar_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Type, Int) =
  decode_named_close(\name -> types.TVar(types.tyvar_id(name)), s, bytes, i, total)

fn decode_tconst_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Type, Int) =
  decode_named_close(\name -> types.TConst(types.type_id(name)), s, bytes, i, total)

# `<atom>)`, the atom turned into a value by `make`.
fn decode_named_close(make: String -> a, s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(a, Int) =
  let Just(name, end) = read_atom_then_close(s, bytes, i, total) else Nothing
  in Just((make(name), end))

fn decode_tapp_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Type, Int) =
  let Just(t1, j) = decode_type_at(s, bytes, skip_ws(s, bytes, i, total), total) else Nothing
      Just(t2, k) = decode_type_at(s, bytes, skip_ws(s, bytes, j, total), total) else Nothing
      Just end = expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') else Nothing
  in Just((types.TApp(t1, t2), end))

fn decode_tfunc_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Type, Int) =
  let Just(t1, j) = decode_type_at(s, bytes, skip_ws(s, bytes, i, total), total) else Nothing
      Just(t2, k) = decode_type_at(s, bytes, skip_ws(s, bytes, j, total), total) else Nothing
      Just(e, m) = decode_effect_at(s, bytes, skip_ws(s, bytes, k, total), total) else Nothing
      Just(own_atom, n) = read_atom(s, bytes, skip_ws(s, bytes, m, total), total) else Nothing
      Just end = expect_char(s, bytes, skip_ws(s, bytes, n, total), total, ')') else Nothing
  in Just((types.TFunc(t1, t2, e, ownership_from_str(own_atom)), end))

fn decode_tthunk_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Type, Int) =
  let Just(t1, j) = decode_type_at(s, bytes, skip_ws(s, bytes, i, total), total) else Nothing
      Just(e, k) = decode_effect_at(s, bytes, skip_ws(s, bytes, j, total), total) else Nothing
      Just end = expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') else Nothing
  in Just((types.TThunk(t1, e), end))

# The ownership tag on the wire. This is what carries `borrowing` ACROSS a module
# boundary for a type that reaches the importer as a Scheme rather than as a
# re-parsed declaration — the other path (ast.Param -> params_to_func_type)
# carries it too, and the two must agree.
fn encode_ownership(o: types.Ownership) -> String =
  if types.ownership_is_borrow(o) then "borrow"
  else if types.ownership_is_once(o) then "once"
  else "consume"

fn ownership_from_str(s: String) -> types.Ownership =
  types.ownership_of_mode(s == "borrow", s == "once")

fn decode_ttuple_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Type, Int) =
  let Just(ts, j) = decode_type_list_at(s, bytes, skip_ws(s, bytes, i, total), total) else Nothing
      Just end = expect_char(s, bytes, skip_ws(s, bytes, j, total), total, ')') else Nothing
  in Just((types.TTuple(ts), end))

fn decode_effect_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Effect, Int) =
  let Just j = expect_char(s, bytes, i, total, '(') else Nothing
      Just(tag, k) = read_atom(s, bytes, skip_ws(s, bytes, j, total), total) else Nothing
  in decode_effect_by_tag(s, bytes, k, total, tag)

fn decode_effect_by_tag(s: String, bytes: Bytes, i: Int, total: Int, tag: String) -> Maybe(types.Effect, Int) =
  if tag == "EffectPure" then decode_effect_pure_close(s, bytes, i, total)
  else if tag == "EffectIO" then decode_effect_io_close(s, bytes, i, total)
  else if tag == "EffectRow" then decode_effect_row_at(s, bytes, i, total)
  else if tag == "EffectVar" then decode_effect_var_at(s, bytes, i, total)
  else Nothing

fn decode_effect_pure_close(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Effect, Int) =
  decode_close(types.EffectPure, s, bytes, i, total)

fn decode_effect_io_close(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Effect, Int) =
  decode_close(types.EffectIO, s, bytes, i, total)

# A bare `)` closing a node that carries no fields: `value` itself.
fn decode_close(value: a, s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(a, Int) =
  let Just end = expect_char(s, bytes, skip_ws(s, bytes, i, total), total, ')') else Nothing
  in Just((value, end))

fn decode_effect_row_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Effect, Int) =
  let Just(xs, j) = decode_str_list_at(s, bytes, skip_ws(s, bytes, i, total), total) else Nothing
      Just end = expect_char(s, bytes, skip_ws(s, bytes, j, total), total, ')') else Nothing
  in Just((types.EffectRow(xs), end))

# An interface is a file on disk, so the source-side rule-9 check is not enough:
# a hand-edited `(EffectVar NOPE)` would otherwise reintroduce the unknown label
# the parser rejects. A malformed effect fails the decode, as every other
# malformed node here does.
#
# The test is well-formed-VARIABLE-NAME, not lowercase: a generalized scheme
# carries `$eN`, so a lowercase-only guard rejected this encoder's own output.
fn decode_effect_var_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe(types.Effect, Int) =
  match read_atom_then_close(s, bytes, i, total) with
  | Nothing -> Nothing
  | Just (name, end) ->
      if types.effect_var_name_is_wellformed(name) then Just((types.EffectVar(name), end))
      else Nothing

# Decodes `( atom* )` as a List String.
fn decode_str_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List String, Int) =
  decode_list_at(read_atom, s, bytes, i, total)

# Decodes `( <type>* )` as a List Type.
fn decode_type_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List types.Type, Int) =
  decode_list_at(decode_type_at, s, bytes, i, total)

# ============================================================================
# IfaceFile — the top-level iface artifact for one module
# ============================================================================
#
# Wraps the scheme table with metadata for format versioning and module
# identification. Per docs/iface-precompiled-modules-v1-draft.md §Format.
#
# v1 schema (intentionally minimal):
#   version      : Int — currently always 1; future bumps purge CI cache
#   module_name  : qualified name, e.g. "stdlib.compiler.types"
#   schemes      : list of (qualified_name, Scheme) pairs
#
# Deferred to later phases:
#   - source_hash + compiler_fingerprint (freshness check; needs Phase 2
#     `bundle_file_with_iface` integration to be load-bearing)
#   - ctor / class / instance tables (typeclass resolution metadata)
#   - ast_hash (parser-skipping path)
#   - emit_time (debug only)
#
# Wire format:
#   (IfaceFile 1 stdlib.compiler.types
#     ((NamedScheme stdlib.compiler.types.mono <scheme>)
#      (NamedScheme stdlib.compiler.types.scheme_vars <scheme>)
#      ...))
#
# `version` is encoded as a bare atom and checked by string equality. When
# v2 lands, decoder gets an if-chain or a parsed-int conversion.
# (Current version is 11 — see decode_iface_version for the change log.)

export type NamedScheme (..) =
  | NamedScheme String types.Scheme

# Constructor metadata for one ADT constructor. Captures enough to register
# the ctor in the typechecker without re-parsing source: ctor name, owning
# ADT name, and field types (arity is implicit in list_length(field_types)).
#
# Example: `type Maybe a = Just a | Nothing` yields:
#   CtorInfo("Just", "Maybe", [TVar("a")])
#   CtorInfo("Nothing", "Maybe", [])
export type CtorInfo (..) =
  | CtorInfo String String (List types.Type)

# Class declaration metadata. Captures the class name, type parameters,
# superclass-class-names (constraint heads, not full constraint exprs — v1
# limitation; constraint TypeExpr lists are deferred), and method signatures.
#
# Example: `class Eq a where Ord a { fn eq(...); fn neq(...) }` yields:
#   ClassInfo("Eq", ["a"], ["Ord"], [NamedScheme("eq", ...), NamedScheme("neq", ...)])
export type ClassInfo (..) =
  | ClassInfo String (List String) (List String) (List NamedScheme)

# Instance declaration metadata. Captures the class being implemented, the
# head type (e.g. `Int` in `instance Eq Int`), and the dispatch dict name
# the typechecker uses for resolution.
#
# Example: `instance Eq Int { ... }` lowered with dict name `int_eq_inst`:
#   InstanceInfo("Eq", TConst("Int"), "stdlib.prelude.int_eq_inst")
export type InstanceInfo (..) =
  | InstanceInfo String types.Type String

# IfaceFile v2 wire format:
#
#   (IfaceFile 2 <module-name>
#     (NamedScheme ...)*         # exported value/fn schemes
#     (CtorInfo ...)*            # ADT constructor metadata
#     (ClassInfo ...)*           # class declarations
#     (InstanceInfo ...)*)       # instance declarations
#
# Phase 1.x: schemas defined here and round-trip tested with hand-built data.
# Extraction from a typechecked program (so --emit-iface actually populates
# the ctor/class/instance tables) is a follow-up — current --emit-iface
# emits empty Nil lists for these three.
export type IfaceFile (..) =
  | IfaceFile Int String (List NamedScheme) (List CtorInfo) (List ClassInfo) (List InstanceInfo)

# ----------------------------------------------------------------------------
# Encoder
# ----------------------------------------------------------------------------

export fn encode_iface_file(f: IfaceFile) -> String =
  match f with
  | IfaceFile version mod schemes ctors classes instances ->
      string_concat_many([
        "(IfaceFile ", int_to_string(version),
        " ", mod,
        " ", encode_named_scheme_list(schemes),
        " ", encode_ctor_info_list(ctors),
        " ", encode_class_info_list(classes),
        " ", encode_instance_info_list(instances),
        ")"
      ])

fn encode_named_scheme_list(ns: List NamedScheme) -> String =
  string_concat_many(["(", join_named_schemes(ns), ")"])

fn join_named_schemes(ns: List NamedScheme) -> String =
  match ns with
  | [] -> ""
  | [n] -> encode_named_scheme(n)
  | [n | rest] -> string_concat_many([encode_named_scheme(n), " ", join_named_schemes(rest)])

fn encode_named_scheme(n: NamedScheme) -> String =
  match n with
  | NamedScheme name s ->
      string_concat_many(["(NamedScheme ", name, " ", encode_scheme(s), ")"])

fn encode_ctor_info_list(cs: List CtorInfo) -> String =
  string_concat_many(["(", join_ctor_infos(cs), ")"])

fn join_ctor_infos(cs: List CtorInfo) -> String =
  match cs with
  | [] -> ""
  | [c] -> encode_ctor_info(c)
  | [c | rest] -> string_concat_many([encode_ctor_info(c), " ", join_ctor_infos(rest)])

fn encode_ctor_info(c: CtorInfo) -> String =
  match c with
  | CtorInfo ctor_name adt_name field_types ->
      string_concat_many([
        "(CtorInfo ", ctor_name, " ", adt_name, " ", encode_type_list(field_types), ")"
      ])

fn encode_class_info_list(cs: List ClassInfo) -> String =
  string_concat_many(["(", join_class_infos(cs), ")"])

fn join_class_infos(cs: List ClassInfo) -> String =
  match cs with
  | [] -> ""
  | [c] -> encode_class_info(c)
  | [c | rest] -> string_concat_many([encode_class_info(c), " ", join_class_infos(rest)])

fn encode_class_info(c: ClassInfo) -> String =
  match c with
  | ClassInfo name type_params superclasses methods ->
      string_concat_many([
        "(ClassInfo ", name,
        " ", encode_str_list(type_params),
        " ", encode_str_list(superclasses),
        " ", encode_named_scheme_list(methods),
        ")"
      ])

fn encode_instance_info_list(is: List InstanceInfo) -> String =
  string_concat_many(["(", join_instance_infos(is), ")"])

fn join_instance_infos(is: List InstanceInfo) -> String =
  match is with
  | [] -> ""
  | [i] -> encode_instance_info(i)
  | [i | rest] -> string_concat_many([encode_instance_info(i), " ", join_instance_infos(rest)])

fn encode_instance_info(i: InstanceInfo) -> String =
  match i with
  | InstanceInfo class_name head_type dict_name ->
      string_concat_many([
        "(InstanceInfo ", class_name, " ", encode_type(head_type), " ", dict_name, ")"
      ])

# ----------------------------------------------------------------------------
# Decoder
# ----------------------------------------------------------------------------

export fn decode_iface_file(input: String) -> Maybe IfaceFile =
  decode_whole(decode_iface_file_at, input)

fn decode_iface_file_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (IfaceFile, Int) =
  decode_tagged("IfaceFile", decode_iface_file_body, s, bytes, i, total)

fn decode_iface_file_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (IfaceFile, Int) =
  let Just(version_atom, j) = read_atom(s, bytes, skip_ws(s, bytes, i, total), total) else Nothing
      Just version = decode_iface_version(version_atom) else Nothing
  in decode_iface_v2_tail(s, bytes, j, total, version)

fn decode_iface_v2_tail(s: String, bytes: Bytes, i: Int, total: Int, version: Int) -> Maybe (IfaceFile, Int) =
  let Just(mod_name, k) = read_atom(s, bytes, skip_ws(s, bytes, i, total), total) else Nothing
      Just(schemes, m) = decode_named_scheme_list_at(s, bytes, skip_ws(s, bytes, k, total), total) else Nothing
      Just(ctors, n2) = decode_ctor_info_list_at(s, bytes, skip_ws(s, bytes, m, total), total) else Nothing
      Just(classes, n3) = decode_class_info_list_at(s, bytes, skip_ws(s, bytes, n2, total), total) else Nothing
      Just(instances, n4) = decode_instance_info_list_at(s, bytes, skip_ws(s, bytes, n3, total), total) else Nothing
      Just end = expect_char(s, bytes, skip_ws(s, bytes, n4, total), total, ')') else Nothing
  in Just((IfaceFile(version, mod_name, schemes, ctors, classes, instances), end))

# Accept only the current version — future bumps add to the if-chain. Using
# string equality (rather than parse_int) avoids parse_int's partial behaviour
# on non-digit input. v1 (schemes-only) retired when metadata tables were added;
# v2→v3 added the Scheme constraint field; v3→v4 changed the constraint pair wire
# form from (position, class) to (head_token, class); v4→v5 added the M4.6
# parameter-ownership tag to TFunc; v5→v6 added the M4.4a `once` case to that tag
# and to ParamMode; v6→v7 added the TypeThunk tag, so a nullary signature is
# `() -> T` rather than bare `T`; v7→v8 gave a class method's scheme a constraint
# list of its own, so a v7 ClassInfo decodes with every method-level `where`
# silently empty; v8→v9 widened a compound-head token from "#app:<Head>" to
# "#app:<Head>:<args>", so a v8 token reads as the head alone and dispatch falls
# back to scanning arguments — the defect the arguments exist to fix. An argument
# position holds a variable's index, a type constructor's own name, or "#any"; the
# name case is what lets a FIXED argument name its parameter instead of leaving the
# choice to the scan.
# Old ifaces are rejected loudly (the Scheme wire format changed)
# — from v5 on that matters doubly, since an older iface decoded leniently would
# silently read every `borrowing`/`once` parameter as consuming, which is the
# exact silent erasure both milestones exist to remove.
# v10: `(TypeArrow …)` gained a ParamMode field, so an arrow TypeExpr on the wire
# now says how its parameter is taken. A v9 iface has no such field and would
# decode every arrow as consuming — the same silent erasure as above, one layer up.
# v11: a tuple constraint subject writes a compound-head token (`#app:Tuple2:…`)
# where v10 wrote `#none`, and a structured argument writes a nested token
# (`[Maybe;b]`) where v10 wrote `#any`. A v10 file read back would dispatch a tuple
# through its first element's dictionary, and a nested argument not at all.
# `WrapDecl` gaining a type-parameter list did NOT bump this: an IfaceFile carries
# schemes, ctors, classes and instances, never decls, so no on-disk iface holds one.
fn decode_iface_version(s: String) -> Maybe Int =
  if s == "11" then Just(11) else Nothing

fn decode_named_scheme_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List NamedScheme, Int) =
  decode_list_at(decode_named_scheme_at, s, bytes, i, total)

fn decode_named_scheme_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (NamedScheme, Int) =
  decode_tagged("NamedScheme", decode_named_scheme_body, s, bytes, i, total)

fn decode_named_scheme_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (NamedScheme, Int) =
  let Just(name, j) = read_atom(s, bytes, skip_ws(s, bytes, i, total), total) else Nothing
      Just(scheme, k) = decode_scheme_at(s, bytes, skip_ws(s, bytes, j, total), total) else Nothing
      Just end = expect_char(s, bytes, skip_ws(s, bytes, k, total), total, ')') else Nothing
  in Just((NamedScheme(name, scheme), end))

# ============================================================================
# Env filtering — bridge between typecheck output and IfaceFile
# ============================================================================
#
# Given a post-typecheck env (Dict String -> Scheme containing every entry
# visible to the typechecker — module-local exports, imports, prelude, etc.)
# and a target module name, returns the subset of (name, scheme) pairs whose
# qualified name starts with `module_name ++ "."`. Caller wraps the result
# in an IfaceFile via `IfaceFile(version, module_name, schemes)`.
#
# O(n) over env entries (single linear scan via dict_entries).

export fn extract_named_schemes(env: Dict types.Scheme, module_name: String) -> List NamedScheme =
  filter_dict_entries(entries, 0, vec_length(entries), module_name ++ ".", Nil)
  where entries = dict_entries(env)

fn filter_dict_entries(entries: Vec (String, types.Scheme), i: Int, total: Int, prefix: String, acc: List NamedScheme) -> List NamedScheme =
  if i >= total then list_reverse(acc)
  else
    match vec_get(i, entries) with
    | Nothing -> filter_dict_entries(entries, i + 1, total, prefix, acc)
    | Just entry -> match entry with
        | (name, scheme) ->
            if str_starts_with(name, prefix) then
              filter_dict_entries(entries, i + 1, total, prefix, Cons (NamedScheme(name, scheme), acc))
            else filter_dict_entries(entries, i + 1, total, prefix, acc)

# ============================================================================
# Typed-program extraction — bridge between typed AST and IfaceFile metadata
# ============================================================================
#
# Each helper walks typed_prog.decls (a List typed_ast.TypedDecl) and collects
# metadata for decls whose qualified name starts with `module_name ++ "."`.
#
# Design notes:
# - TypeDecl  → TPassThrough (infer preserves as-is, no typecheck needed)
# - ClassDecl → TPassThrough (ditto)
# - InstanceDecl → TInstanceDecl (infer replaces with typed version)
#
# These helpers do NOT import infer.sprout (avoids pulling in the large
# inference engine).  Instead we duplicate one small local helper:
#   typeexpr_to_type  — ast.TypeExpr → types.Type (same logic as infer.type_from_ast
#                       but without the Dict local_vars for TVar lookup)

# ---------------------------------------------------------------------------
# Local helpers (no dependency on infer.sprout)
# ---------------------------------------------------------------------------

# Convert a surface ast.TypeExpr to types.Type. TypeName looks up local_vars
# (type parameters listed in the enclosing decl) and falls back to TConst.
# O(n) in size of the type expression.
fn typeexpr_to_type_with_vars(te: ast.TypeExpr, local_vars: Dict types.Type) -> types.Type =
  match te with
  | ast.TypeName name ->
      match dict_get(name, local_vars) with
      | Just t -> t
      | Nothing -> types.TConst(types.type_id(string.after_last_dot(name)))
  | ast.TypeApply base arg ->
      types.TApp(typeexpr_to_type_with_vars(base, local_vars),
                 typeexpr_to_type_with_vars(arg, local_vars))
  # The effect labels were discarded here until effect unification landed, which
  # is the same defect `infer.type_from_ast` had — two walkers over the same AST,
  # one fixed and one not. A class method taking `f: a -> Unit !{IO}` produced a
  # pure arrow in its serialized scheme.
  #
  # Latent, not observed: nothing currently type-checks against a decoded iface
  # (`decode_iface_file`'s only consumer is `--check-iface`, which counts entries
  # for well-formedness), so the wrong arrow was written to disk and read by
  # nobody. Aligned anyway — the day a consumer appears is the worst possible day
  # to discover the two walks disagree. Pinned by `just effect-report-smoke`,
  # which asserts on the ENCODED form, since that is the only place this walk's
  # output is visible.
  | ast.TypeArrow param ret effs mode ->
      types.TFunc(typeexpr_to_type_with_vars(param, local_vars),
                  typeexpr_to_type_with_vars(ret, local_vars),
                  types.effect_from_labels(effs),
                  types.ownership_of_mode(ast.mode_is_borrowing(mode), ast.mode_is_once(mode)))
  | ast.TypeThunk ret effs ->
      types.TThunk(typeexpr_to_type_with_vars(ret, local_vars),
                   types.effect_from_labels(effs))
  | ast.TypeEffect inner effs ->
      types.attach_arrow_effect(typeexpr_to_type_with_vars(inner, local_vars),
                                types.effect_from_labels(Just(effs)))
  | ast.TupleType parts ->
      types.TTuple(typeexpr_list_to_types(parts, local_vars))

fn typeexpr_list_to_types(parts: List ast.TypeExpr, local_vars: Dict types.Type) -> List types.Type =
  match parts with
  | Nil -> Nil
  | Cons h t -> Cons(typeexpr_to_type_with_vars(h, local_vars),
                     typeexpr_list_to_types(t, local_vars))

# Build a Dict mapping each type-param name to TVar(name).
# O(n) where n = number of type params.
fn make_local_vars(type_params: List String) -> Dict types.Type =
  match type_params with
  | Nil -> dict_empty()
  | Cons p rest -> dict_set(p, types.TVar(types.tyvar_id(p)), make_local_vars(rest))

# Extract the outermost type-name from the first type-argument of a constraint.
# Used to compute the canonical instance dispatch key.
fn constraint_head(type_args: List ast.TypeExpr) -> String =
  match type_args with
  | Nil -> "Unknown"
  | [te | _] -> te_outermost_name(te)

fn te_outermost_name(te: ast.TypeExpr) -> String =
  match te with
  | ast.TypeName n -> string.after_last_dot(n)
  | ast.TypeApply base _ -> te_outermost_name(base)
  | _ -> "Unknown"

# Build a Scheme for a class method: forall type_params. params -> ret @ effect.
# Effects come from the method's `effects` field (Nothing → EffectPure).
# O(n) in number of params.
fn method_scheme(type_params: List String, params: List ast.Param, ret: ast.TypeExpr, effects: Maybe (List String),
                 constraints: List ast.TypeConstraint) -> types.Scheme =
  types.scheme_quantified(type_params,
    params_to_func_type(params, typeexpr_to_type_with_vars(ret, make_local_vars(type_params)),
      make_local_vars(type_params), types.effect_from_labels(effects)),
    types.effect_from_labels(effects), method_constraint_tokens(constraints))

# Method-level constraint heads keyed by NAME, not position: this scheme
# quantifies the CLASS params only, so a method's own variable has no index to
# record and the name is the stable key (constraint_var_token's own fallback).
# That differs from infer.constraint_pos_tokens, which does have an index to
# use; BACKLOG.md §7.5 tracks aligning the two binder lists.
fn method_constraint_tokens(constraints: List ast.TypeConstraint) -> List (String, String) =
  match constraints with
  | Nil -> Nil
  | Cons (ast.TypeConstraint class_name type_args) rest ->
      match type_args with
      | [ast.TypeName v | _] -> Cons((v, class_name), method_constraint_tokens(rest))
      | [ast.TypeApply cb ca | _] ->
          Cons((compound_head_token(ast.TypeApply(cb, ca)), class_name),
               method_constraint_tokens(rest))
      | [ast.TupleType items | _] ->
          Cons((compound_head_token(ast.TupleType(items)), class_name),
               method_constraint_tokens(rest))
      | [] -> Cons(("#none", class_name), method_constraint_tokens(rest))
      | [ast.TypeArrow _ _ _ _ | _] -> Cons(("#none", class_name), method_constraint_tokens(rest))
      | [ast.TypeThunk _ _ | _] -> Cons(("#none", class_name), method_constraint_tokens(rest))
      | [ast.TypeEffect _ _ | _] -> Cons(("#none", class_name), method_constraint_tokens(rest))

# A compound head (`where ToString (Box a)`) in the `#app:` form
# infer.compound_head_token writes, qualifier included: the head, then one token
# per written argument. The call-site resolver branches on that prefix; a bare name
# decodes as a type VARIABLE instead and resolves the dictionary by a different
# path entirely. Names, not positions, for the reason the caller above gives.
fn compound_head_token(te: ast.TypeExpr) -> String =
  match te_head_name(te) with
  | Just h -> app_token_with_args(h, compound_head_arg_names(te, Nil))
  | Nothing -> "#none"

fn app_token_with_args(h: String, names: Maybe (List String)) -> String =
  match names with
  | Nothing -> "#app:" ++ h
  | Just ns -> "#app:" ++ h ++ ":" ++ string.join(",", ns)

# The written arguments' names, outermost LAST: a structured one nested, `#any` where
# there is no head to give. The gap is recorded rather than dropped so the COUNT
# survives — that is what lets the recorder place the head at the right depth.
fn compound_head_arg_names(te: ast.TypeExpr, acc: List String) -> Maybe (List String) =
  match te with
  | ast.TypeApply base arg -> compound_head_arg_names(base, Cons(element_name(arg), acc))
  | ast.TupleType items -> arg_names_done(list_append(list_map(element_name, items), acc))
  | ast.TypeName _ -> arg_names_done(acc)
  | ast.TypeArrow _ _ _ _ -> arg_names_done(acc)
  | ast.TypeThunk _ _ -> arg_names_done(acc)
  | ast.TypeEffect _ _ -> arg_names_done(acc)

# A structured argument is written nested (types.nested_arg_token), as infer writes it.
fn element_name(te: ast.TypeExpr) -> String =
  match te with
  | ast.TypeName n -> n
  | ast.TypeApply _ _ -> nested_element(te)
  | ast.TypeArrow _ _ _ _ -> "#any"
  | ast.TypeThunk _ _ -> "#any"
  | ast.TypeEffect _ _ -> "#any"
  | ast.TupleType _ -> nested_element(te)

fn nested_element(te: ast.TypeExpr) -> String =
  let Just h = te_head_name(te) else "#any"
      Just names = compound_head_arg_names(te, Nil) else "#any"
  in types.nested_arg_token(h, names)

fn arg_names_done(acc: List String) -> Maybe (List String) =
  match acc with
  | [] -> Nothing
  | [_ | _] -> Just(acc)

# A tuple is named with its arity, as infer.type_expr_head_name names it.
fn te_head_name(te: ast.TypeExpr) -> Maybe String =
  match te with
  | ast.TypeName n -> Just(n)
  | ast.TypeApply base _ -> te_head_name(base)
  | ast.TupleType items -> Just(types.tuple_head(list_length(items)))
  | ast.TypeArrow _ _ _ _ -> Nothing
  | ast.TypeThunk _ _ -> Nothing
  | ast.TypeEffect _ _ -> Nothing

# Build a right-associating TFunc chain from a list of Params.
#
# The declared effect goes on the INNERMOST arrow and every outer arrow is pure,
# matching `parser.make_type_arrow` and `infer.build_fn_type_modes`. Sprout
# applications are n-ary (spec §5.3), so only the arrow that actually returns the
# result can be the one performing the effect. Every arrow was pure here until
# effect unification landed, which left a method's declared effect recorded in
# the scheme's effect field but absent from the type — and `call_effect_of` reads
# the arrows, not that field, for any call with arguments. Latent for the same
# reason as `typeexpr_to_type_with_vars` above: no consumer reads it back yet.
# No params at all is `() -> ret`; the same `Nil` inside the recursion is only the
# end of the chain. Splitting them apart is what keeps a nullary declaration from
# decoding as its bare return type.
fn params_to_func_type(params: List ast.Param, ret: types.Type, local_vars: Dict types.Type,
                       eff: types.Effect) -> types.Type =
  match params with
  | Nil -> types.TThunk(ret, eff)
  | _ -> params_arrow_chain(params, ret, local_vars, eff)

fn params_arrow_chain(params: List ast.Param, ret: types.Type, local_vars: Dict types.Type,
                      eff: types.Effect) -> types.Type =
  match params with
  | Nil -> ret
  | Cons (ast.Param _ maybe_te mode) rest ->
      types.TFunc(param_type_from_maybe(maybe_te, local_vars),
                  params_arrow_chain(rest, ret, local_vars, eff),
                  params_arrow_effect(rest, eff),
                  linear_check.ownership_of_param_mode(mode))

fn params_arrow_effect(rest: List ast.Param, eff: types.Effect) -> types.Effect =
  match rest with
  | Nil -> eff
  | _ -> types.EffectPure

fn param_type_from_maybe(maybe_te: Maybe ast.TypeExpr, local_vars: Dict types.Type) -> types.Type =
  match maybe_te with
  | Nothing -> types.TVar(types.tyvar_id("_"))
  | Just te -> typeexpr_to_type_with_vars(te, local_vars)

# ---------------------------------------------------------------------------
# CtorInfo extraction
# ---------------------------------------------------------------------------
#
# Walks decls for TPassThrough(TypeDecl name type_params ctors ...) where
# `name` starts with `module_name ++ "."`. Emits one CtorInfo per constructor.
# Field types are converted from ast.TypeExpr using the decl's type_params as
# local type variables.
#
# O(sum of ctor-count across all matching TypeDecls in the program).

export fn extract_ctor_infos(prog: typed_ast.TypedProgram, module_name: String) -> List CtorInfo =
  match prog with
  | typed_ast.TypedProgram decls ->
      collect_ctor_infos_from_decls(decls, module_name ++ ".", Nil)

fn collect_ctor_infos_from_decls(decls: List typed_ast.TypedDecl, prefix: String, acc: List CtorInfo) -> List CtorInfo =
  match decls with
  | Nil -> list_reverse(acc)
  | Cons d rest ->
      match d with
      | typed_ast.TPassThrough inner_decl ->
          match inner_decl with
          | ast.TypeDecl name type_params ctors _ _ _ ->
              if str_starts_with(name, prefix) then
                collect_ctor_infos_from_decls(rest, prefix,
                  collect_ctors_for_type(ctors, name, make_local_vars(type_params), acc))
              else collect_ctor_infos_from_decls(rest, prefix, acc)
          | _ -> collect_ctor_infos_from_decls(rest, prefix, acc)
      | _ -> collect_ctor_infos_from_decls(rest, prefix, acc)

# Extend a type's local-var dict with its constructor's existential vars so their
# field types resolve. Mirrors infer.build_local_params (kept local to avoid a
# cross-module dependency for one small helper).
fn add_exist_iface_locals(vars: List String, acc: Dict types.Type) -> Dict types.Type =
  match vars with
  | Nil -> acc
  | Cons v rest -> add_exist_iface_locals(rest, dict_set(v, types.TVar(types.tyvar_id(v)), acc))

fn collect_ctors_for_type(ctors: List ast.TypeConstructor, adt_name: String, local_vars: Dict types.Type, acc: List CtorInfo) -> List CtorInfo =
  match ctors with
  | Nil -> acc
  # exist_vars must be in scope to resolve existential field types (`a` in
  # `| exists a. Boxed a`). They are quantified into the exported scheme's field
  # types; a downstream importer recovers existential-ness the same way the
  # unpack path does (a ctor scheme var absent from the result). docs/gadts-v0.md.
  | Cons (ast.TypeConstructor ctor_name field_exprs exist_vars _) rest ->
      collect_ctors_for_type(rest, adt_name, local_vars,
        Cons(CtorInfo(ctor_name, adt_name, typeexpr_list_to_types(field_exprs, add_exist_iface_locals(exist_vars, local_vars))), acc))

# ---------------------------------------------------------------------------
# ClassInfo extraction
# ---------------------------------------------------------------------------
#
# Walks decls for TPassThrough(ClassDecl name type_params methods superclasses)
# where `name` starts with `module_name ++ "."`. Superclass names are extracted
# from the TypeConstraint class_name field. Method schemes are built with
# method_scheme.
#
# O(sum of method-count across all matching ClassDecls).

export fn extract_class_infos(prog: typed_ast.TypedProgram, module_name: String) -> List ClassInfo =
  match prog with
  | typed_ast.TypedProgram decls ->
      collect_class_infos_from_decls(decls, module_name ++ ".", Nil)

fn collect_class_infos_from_decls(decls: List typed_ast.TypedDecl, prefix: String, acc: List ClassInfo) -> List ClassInfo =
  match decls with
  | Nil -> list_reverse(acc)
  | Cons d rest ->
      match d with
      | typed_ast.TPassThrough inner_decl ->
          match inner_decl with
          | ast.ClassDecl name type_params methods superclasses _ ->
              if str_starts_with(name, prefix) then
                collect_class_infos_from_decls(rest, prefix,
                  Cons(build_class_info(name, type_params, methods, superclasses), acc))
              else collect_class_infos_from_decls(rest, prefix, acc)
          | _ -> collect_class_infos_from_decls(rest, prefix, acc)
      | _ -> collect_class_infos_from_decls(rest, prefix, acc)

fn build_class_info(name: String, type_params: List String, methods: List ast.ClassMethodSig, superclasses: List ast.TypeConstraint) -> ClassInfo =
  ClassInfo(name, type_params,
    extract_superclass_names(superclasses, Nil),
    build_method_named_schemes(methods, type_params, Nil))

fn extract_superclass_names(supers: List ast.TypeConstraint, acc: List String) -> List String =
  match supers with
  | Nil -> list_reverse(acc)
  | Cons (ast.TypeConstraint class_name _) rest ->
      extract_superclass_names(rest, Cons(class_name, acc))

fn build_method_named_schemes(methods: List ast.ClassMethodSig, type_params: List String, acc: List NamedScheme) -> List NamedScheme =
  match methods with
  | Nil -> list_reverse(acc)
  | Cons (ast.ClassMethodSig method_name params ret effects constraints) rest ->
      build_method_named_schemes(rest, type_params,
        Cons(NamedScheme(method_name, method_scheme(type_params, params, ret, effects, constraints)), acc))

# ---------------------------------------------------------------------------
# InstanceInfo extraction
# ---------------------------------------------------------------------------
#
# Walks decls for TInstanceDecl(constraint, _, _) where constraint is
# TypeConstraint class_name type_args, and `class_name` starts with
# `module_name ++ "."`.
#
# dict_name encoding: uses the same dispatch-key format as the typechecker
# (infer.sprout:835 — `strip(class_name) ++ "_" ++ head`), which is the only
# string with real provenance in this phase. A synthesised name
# ("class_head") is stored rather than a real function name because there is
# no single per-instance dict function in the current lowering scheme — each
# method gets its own `__tc_{Class}_{mangled}_{method}` function.
#
# Phase-2 TODO: revisit dict_name when the bundler consumes InstanceInfo for
# cross-module instance resolution; at that point the name should either be
# clarified as a dispatch key or replaced with a method-name map.
#
# O(n) over all typed decls.

export fn extract_instance_infos(prog: typed_ast.TypedProgram, module_name: String) -> List InstanceInfo =
  match prog with
  | typed_ast.TypedProgram decls ->
      collect_instance_infos_from_decls(decls, module_name ++ ".", Nil)

fn collect_instance_infos_from_decls(decls: List typed_ast.TypedDecl, prefix: String, acc: List InstanceInfo) -> List InstanceInfo =
  match decls with
  | Nil -> list_reverse(acc)
  | Cons d rest ->
      match d with
      | typed_ast.TInstanceDecl constraint _ _ ->
          match constraint with
          | ast.TypeConstraint class_name type_args ->
              if str_starts_with(class_name, prefix) then
                collect_instance_infos_from_decls(rest, prefix,
                  Cons(build_instance_info(class_name, type_args), acc))
              else collect_instance_infos_from_decls(rest, prefix, acc)
      | _ -> collect_instance_infos_from_decls(rest, prefix, acc)

fn build_instance_info(class_name: String, type_args: List ast.TypeExpr) -> InstanceInfo =
  InstanceInfo(class_name,
    head_type_from_args(type_args),
    string.after_last_dot(class_name) ++ "_" ++ constraint_head(type_args))

fn head_type_from_args(type_args: List ast.TypeExpr) -> types.Type =
  match type_args with
  | Nil -> types.TConst(types.type_id("Unknown"))
  | [te | _] -> typeexpr_to_type_with_vars(te, dict_empty())

# ============================================================================
# Decoders for CtorInfo / ClassInfo / InstanceInfo
# ============================================================================

fn decode_ctor_info_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List CtorInfo, Int) =
  decode_list_at(decode_ctor_info_at, s, bytes, i, total)

fn decode_ctor_info_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (CtorInfo, Int) =
  decode_tagged("CtorInfo", decode_ctor_info_body, s, bytes, i, total)

fn decode_ctor_info_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (CtorInfo, Int) =
  let Just(ctor_name, j) = read_atom(s, bytes, skip_ws(s, bytes, i, total), total) else Nothing
      Just(adt_name, k) = read_atom(s, bytes, skip_ws(s, bytes, j, total), total) else Nothing
      Just(field_types, m) = decode_type_list_at(s, bytes, skip_ws(s, bytes, k, total), total) else Nothing
      Just end = expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') else Nothing
  in Just((CtorInfo(ctor_name, adt_name, field_types), end))

fn decode_class_info_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List ClassInfo, Int) =
  decode_list_at(decode_class_info_at, s, bytes, i, total)

fn decode_class_info_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (ClassInfo, Int) =
  decode_tagged("ClassInfo", decode_class_info_body, s, bytes, i, total)

fn decode_class_info_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (ClassInfo, Int) =
  do
    (name, j) <- read_atom(s, bytes, skip_ws(s, bytes, i, total), total)
    (type_params, k) <- decode_str_list_at(s, bytes, skip_ws(s, bytes, j, total), total)
    (superclasses, m) <- decode_str_list_at(s, bytes, skip_ws(s, bytes, k, total), total)
    (methods, n) <- decode_named_scheme_list_at(s, bytes, skip_ws(s, bytes, m, total), total)
    end <- expect_char(s, bytes, skip_ws(s, bytes, n, total), total, ')')
    Just((ClassInfo(name, type_params, superclasses, methods), end))

fn decode_instance_info_list_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (List InstanceInfo, Int) =
  decode_list_at(decode_instance_info_at, s, bytes, i, total)

fn decode_instance_info_at(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (InstanceInfo, Int) =
  decode_tagged("InstanceInfo", decode_instance_info_body, s, bytes, i, total)

fn decode_instance_info_body(s: String, bytes: Bytes, i: Int, total: Int) -> Maybe (InstanceInfo, Int) =
  let Just(class_name, j) = read_atom(s, bytes, skip_ws(s, bytes, i, total), total) else Nothing
      Just(head_type, k) = decode_type_at(s, bytes, skip_ws(s, bytes, j, total), total) else Nothing
      Just(dict_name, m) = read_atom(s, bytes, skip_ws(s, bytes, k, total), total) else Nothing
      Just end = expect_char(s, bytes, skip_ws(s, bytes, m, total), total, ')') else Nothing
  in Just((InstanceInfo(class_name, head_type, dict_name), end))
