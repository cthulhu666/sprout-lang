module stdlib.compiler.ir_rooting
import stdlib.compiler.sprout_ir as sprout_ir

# ---------------------------------------------------------------------------
# IR rooting pass (Milestone 2, PR 2.2 — Model C plan).
#
# Inserts IRRoot/IRUnroot ops around GC-triggering ops to keep heap-typed
# values alive across runtime allocation calls.  Operates as a separate
# post-translation pass over IRProgram; pure-functional (no Refs).
#
# Algorithm summary:
#   For each function:
#     1. Forward-scan blocks to compute heap_origin (Set of heap-typed defs).
#     2. Backward dataflow per function: per-block use/def, live_in/live_out.
#        CFG is a DAG through M2 (no loops); single reverse-topo pass.
#        Phi successors contribute only the operand from the right predecessor.
#     3. Forward rewrite per block:
#        - For each op, compute live_after on-the-fly by walking remaining
#          ops backward from block's live_out.
#        - For trigger ops, compute live_across (heap-typed values defined
#          earlier that remain live), emit IRRoot before / IRUnroot after.
#
# Representation: liveness/heap sets are `Set`; `in_scope_ord` stays a
# `List String` because the order of definitions is observable — IRRoot
# emission order is deterministic in definition order.

# ---------------------------------------------------------------------------
# Trigger / heap predicates

# B2 (leaf-loop GC-root elision).  A verified allow-list of runtime read/store
# externs that CANNOT allocate — they neither call any sprout_make*/
# sprout_alloc_* nor sprout_gc_maybe_collect_threshold, so GC cannot fire at the
# call.  Live pointers therefore need no rooting across them; a value live across
# a REAL trigger elsewhere is still rooted there (root-once, PR #108), so eliding
# here is safe and precise.  Each name is verified non-allocating in
# runtime/sprout_runtime.c — only add a name after reading its body:
#   vector_get_direct — v->data[index] + bounds check (NOT vector_get, which
#                       boxes a Just/Nothing Maybe — that MUST stay a trigger).
#   vector_mutset     — v->data[index] = value (plain store; Phase 2 GC's write
#                       barrier will make this a trigger again — revisit then).
#   vector_length     — returns v->len (pure read).
# Keyed by exact runtime symbol: user functions never reuse a builtin name, and
# polymorphic wrappers (mutvec_get, mutmatrix_get) route through vector_get and
# are absent here, so they correctly stay triggers.
fn is_nonallocating_read(fname: String) -> Bool =
  fname == "vector_get_direct"
  || fname == "vector_mutset"
  || fname == "vector_length"

# B2 reach extension.  The Tier-1 CPR peephole rewrites a matched/do-bound
# Maybe-returning read into an `_unboxed` { i64, i64 } extern (IRCallUnboxed2),
# which returns { tag, value } BY VALUE.  The reads below build no Sprout heap
# object (all verified in runtime/sprout_runtime.c — only add a name after
# reading its body):
#   vector_get_unboxed, map_get_unboxed, map_nth_key_unboxed,
#     map_nth_value_unboxed, bytes_get_unboxed — return data[i] / node->key /
#     node->value directly.
#   str_char_at_unboxed — returns the decoded codepoint (immediate i64).
#   argv_get_unboxed, env_get_unboxed — return an interned string.  These two do
#     reach malloc on an intern-table MISS, but it is a bare malloc with no
#     sprout_gc_maybe_collect_threshold(), and interned strings are permanent and
#     non-arena, so no collection triggers and nothing GC-managed is produced.
#     (See the CPR block header in runtime/sprout_runtime.c, which states the
#     invariant in that precise form.)
#
# Line numbers deliberately omitted.  This block used to cite one per name
# (4342-4437); every one had drifted ~1100 lines out of date by 2026-08-19 while
# still reading as authoritative — the same rot that had test_ir_rooting.spr's
# Test 21 naming a function deleted three commits earlier.  Grep the name.
# This list is now the WHOLE of unboxed_maybe_extern_name — every CPR variant
# the codegen can emit is non-allocating.  It had two exclusions until
# 2026-08-19 (regex_find_match_unboxed, which built its Match via sprout_make2,
# and term_read_line_unboxed, which registered a cstr); both were deleted rather
# than kept as triggers, so there is no allocating variant left to exclude.
# The `else true` fallback below still matters: it is what keeps an unrecognised
# `_unboxed` name a trigger, so a future allocating variant is over-rooted rather
# than silently trusted.
fn is_nonallocating_unboxed_read(fname: String) -> Bool =
  fname == "vector_get_unboxed"
  || fname == "map_get_unboxed"
  || fname == "map_nth_key_unboxed"
  || fname == "map_nth_value_unboxed"
  || fname == "bytes_get_unboxed"
  || fname == "str_char_at_unboxed"
  || fname == "argv_get_unboxed"
  || fname == "env_get_unboxed"

fn op_triggers_gc(op: sprout_ir.IROp) -> Bool =
  match op with
  | sprout_ir.IRStrSlice _ _ _ _ -> true
  | sprout_ir.IRStrConcat _ _ _ -> true
  | sprout_ir.IRStrFromInt _ _ -> true
  # IRStrEq calls @str_eq — a pure comparison; does NOT allocate.  NOT a GC trigger.
  | sprout_ir.IRStrEq _ _ _ -> false
  # IRStrCompare calls @str_compare — a pure comparison; does NOT allocate.  NOT a GC trigger.
  | sprout_ir.IRStrCompare _ _ _ _ -> false
  # IRPrintStr calls @print_str / @eprint_str — write-only I/O; does NOT allocate. NOT a GC trigger.
  | sprout_ir.IRPrintStr _ _ _ -> false
  | sprout_ir.IRStrConst _ _ _ -> false
  # Every user call may transitively allocate — EXCEPT a verified allow-list of
  # non-allocating read/store externs (B2).  Peek the callee name; over-roots any
  # callee not on the list (correctness > optimization).
  | sprout_ir.IRCall _ _ fname _ -> if is_nonallocating_read(fname) then false else true
  # IRCallUnboxed2 calls a C `_unboxed` extern.  Every variant the codegen can
  # currently emit (vector_get, map_get, str_char_at, …) returns { tag, value }
  # by value and does NOT allocate.  Peek the callee name (B2 reach extension):
  # non-trigger for the verified non-allocating variants, trigger otherwise — the
  # fallback is deliberate, so an unrecognised name is over-rooted, not trusted.
  | sprout_ir.IRCallUnboxed2 _ _ _ fname _ ->
      if is_nonallocating_unboxed_read(fname) then false else true
  # IRRetUnboxed2 is a terminator: two insertvalues + ret, pure — no allocation.
  | sprout_ir.IRRetUnboxed2 _ _ _ -> false
  # IRCallUnboxed3 calls a Sprout `@f_worker` (a user fn) — may transitively allocate; trigger.
  | sprout_ir.IRCallUnboxed3 _ _ _ _ _ _ -> true
  # IRRetUnboxed3 is a terminator: three insertvalues + ret, pure — no allocation.
  | sprout_ir.IRRetUnboxed3 _ _ _ _ -> false
  # IRMakeCtor lowers to @sprout_makeN which always allocates; trigger.
  | sprout_ir.IRMakeCtor _ _ _ _ -> true
  # IRMkClosure allocates env via @sprout_alloc_closure; trigger.
  | sprout_ir.IRMkClosure _ _ _ _ -> true
  # IRMakeTuple lowers to @sprout_alloc_tuple_blob which calls
  # sprout_gc_maybe_collect_threshold() before allocating; trigger.
  | sprout_ir.IRMakeTuple _ _ -> true
  # IRApplyClosure does an indirect call to a user-provided code-ptr; conservative trigger.
  | sprout_ir.IRApplyClosure _ _ _ -> true
  # IRLoadEnvSlot is a pure i64 load — does NOT trigger GC.
  | sprout_ir.IRLoadEnvSlot _ _ _ _ -> false
  # PR 2.5: pattern-matching ops — all three are non-trigger by design.
  # IRGetTag / IRGetField lower to @sprout_tag / @sprout_field, pure reads.
  # IRAbortMatch never allocates.
  # See docs/archive/pr-2.5-pattern-matching-plan.md "Rooting" section.
  | sprout_ir.IRGetTag _ _ -> false
  | sprout_ir.IRGetField _ _ _ _ -> false
  # B1: raw i64 loads/store into a Vector's backing data; no allocation.
  | sprout_ir.IRVecLenD _ _ -> false
  | sprout_ir.IRVecGetD _ _ _ -> false
  | sprout_ir.IRVecSetD _ _ _ _ -> false
  | sprout_ir.IRAbortMatch -> false
  # IRPanic calls @panic then `unreachable`; panic exits, so no GC.
  | sprout_ir.IRPanic _ -> false
  # /code-review-v2 fix #3: width-conversion ops are pure casts; NOT triggers.
  | sprout_ir.IRZextI1ToI64 _ _ -> false
  | sprout_ir.IRTruncI64ToI1 _ _ -> false
  # TCO ops: alloca/store/load/stacksave/stackrestore/br — never collect.
  | sprout_ir.IRTcoEntry _ _ -> false
  | sprout_ir.IRTcoLoad _ _ _ _ -> false
  | sprout_ir.IRTcoBack _ _ _ -> false
  # IRTailCall lowers to musttail call + ret; the callee runs in this frame's
  # place (no return here), so it is NOT a GC-safe point in the caller — like the
  # tail back-edge, it must not push a root that would accumulate per frame.
  | sprout_ir.IRTailCall _ _ _ _ -> false
  # Remaining ops are non-allocating (arithmetic, control flow, loads/stores,
  # and the root ops themselves).  EXHAUSTIVE on purpose — no `_` catch-all, so
  # a new IROp is a COMPILE ERROR here until its GC-trigger status is decided
  # (P11-2e: IRMakeTuple silently defaulting to non-trigger caused a UAF).
  | sprout_ir.IRConst _ _ -> false
  | sprout_ir.IRRet _ -> false
  | sprout_ir.IRRetVoid -> false
  | sprout_ir.IRIAdd _ _ _ -> false
  | sprout_ir.IRISub _ _ _ -> false
  | sprout_ir.IRIMul _ _ _ -> false
  | sprout_ir.IRIDiv _ _ _ -> false
  # stdlib.bits: register arithmetic on unboxed i64, allocates nothing.
  | sprout_ir.IRIAnd _ _ _ -> false
  | sprout_ir.IRIOr _ _ _ -> false
  | sprout_ir.IRIXor _ _ _ -> false
  | sprout_ir.IRIShl _ _ _ -> false
  | sprout_ir.IRIAShr _ _ _ -> false
  | sprout_ir.IRILShr _ _ _ -> false
  | sprout_ir.IRFloatConst _ _ -> false
  | sprout_ir.IRFAdd _ _ _ -> false
  | sprout_ir.IRFSub _ _ _ -> false
  | sprout_ir.IRFMul _ _ _ -> false
  | sprout_ir.IRFDiv _ _ _ -> false
  | sprout_ir.IRFCmp _ _ _ _ -> false
  | sprout_ir.IRFNeg _ _ -> false
  | sprout_ir.IRSIToF _ _ -> false
  | sprout_ir.IRBoolNot _ _ -> false
  | sprout_ir.IRINeg _ _ -> false
  | sprout_ir.IRLoadGlobal _ _ -> false
  | sprout_ir.IRStoreGlobal _ _ -> false
  # register_root_slot mallocs a RootNode (C heap), never the Sprout GC heap,
  # and does not call sprout_gc_maybe_collect_threshold — NOT a GC trigger.
  | sprout_ir.IRRegisterGlobalRoot _ -> false
  | sprout_ir.IRGetTupleField _ _ _ _ -> false
  | sprout_ir.IRICmp _ _ _ _ -> false
  | sprout_ir.IRBr _ -> false
  | sprout_ir.IRCondBr _ _ _ -> false
  | sprout_ir.IRPhi _ _ _ -> false
  | sprout_ir.IRRoot _ _ _ -> false
  | sprout_ir.IRUnroot _ _ -> false

# Returns Just <result-name> if op directly produces a heap value (excluding
# IRPhi, whose heap-ness depends on operand membership in heap_origin and is
# handled separately in compute_heap_origin / update_scope).
fn op_produces_simple_heap(op: sprout_ir.IROp) -> Maybe String =
  match op with
  | sprout_ir.IRStrConst r _ _ -> Just(r)
  | sprout_ir.IRStrSlice r _ _ _ -> Just(r)
  | sprout_ir.IRStrConcat r _ _ -> Just(r)
  | sprout_ir.IRStrFromInt r _ -> Just(r)
  # IRStrEq produces an i64-encoded Bool — a scalar, NOT a heap pointer.
  | sprout_ir.IRStrEq _ _ _ -> Nothing
  # IRStrCompare produces an i64-encoded Bool — a scalar, NOT a heap pointer.
  | sprout_ir.IRStrCompare _ _ _ _ -> Nothing
  # IRPrintStr produces the i64 return of @print_str/@eprint_str (0/unit) — a scalar.
  | sprout_ir.IRPrintStr _ _ _ -> Nothing
  | sprout_ir.IRMakeCtor r _ _ _ -> Just(r)
  # Closure value is heap-allocated (an env pointer packed as i64).
  | sprout_ir.IRMkClosure r _ _ _ -> Just(r)
  # Closure-application result is conservatively heap-typed (M2: all results are i64).
  | sprout_ir.IRApplyClosure r _ _ -> Just(r)
  # A direct call's result is heap iff its return-type kind is heap/unknown.
  # IRTScalar returns (Int/Bool/Char) are not heap and are not rooted, so a
  # call result held live across a later GC trigger gets a root only when it can
  # actually be a heap pointer.
  | sprout_ir.IRCall r kind _ _ ->
      match kind with
      | sprout_ir.IRTScalar -> Nothing
      | _ -> Just(r)
  # IRCallUnboxed2 produces two SSA defs: <tag> (always a scalar ctor tag, never
  # rooted) and <val> (the payload).  Report ONLY <val>, keyed by its kind — this
  # is what seeds the rooting scope (update_scope), so <val> is rooted across
  # later triggers exactly as the boxed IRGetField result would have been.
  | sprout_ir.IRCallUnboxed2 _ val vk _ _ ->
      match vk with
      | sprout_ir.IRTScalar -> Nothing
      | _ -> Just(val)
  # IRRetUnboxed2 is a terminator — it produces no SSA def to root.
  | sprout_ir.IRRetUnboxed2 _ _ _ -> Nothing
  # IRCallUnboxed3 produces three scalar defs.  The router only emits it for an
  # all-non-heap-scalar 3-tuple (scalar_tuple_width guard), so none of the three
  # slots is heap → no rooting.  A future heap-field width-3 increment must extend
  # this (op_heap_def returns a single Maybe; three heap slots would need multi-def
  # rooting here AND in update_scope).
  | sprout_ir.IRCallUnboxed3 _ _ _ _ _ _ -> Nothing
  # IRRetUnboxed3 is a terminator — it produces no SSA def to root.
  | sprout_ir.IRRetUnboxed3 _ _ _ _ -> Nothing
  # FIX R4#7: honour the kind field. IRTScalar slots (Int, Bool, Char) are
  # not heap; IRTHeap slots (String, ADT, closure) are; IRTUnknown is
  # treated as heap (conservative). This avoids over-rooting scalar captures
  # in deep-recursive closures with many Int/Char captures.
  | sprout_ir.IRLoadEnvSlot r _ _ kind ->
      match kind with
      | sprout_ir.IRTScalar -> Nothing
      | _ -> Just(r)
  # PR 2.5: IRGetField result is heap-typed iff its kind is IRTHeap or
  # IRTUnknown (the kind is decoded by translate_match from the ctors-dict
  # field_kinds_string via field_kinds.field_kind_char_to_irtype).
  # IRGetTag returns an i64 tag, not a heap handle — never heap.
  | sprout_ir.IRGetField r _ _ kind ->
      match kind with
      | sprout_ir.IRTScalar -> Nothing
      | _ -> Just(r)
  # B1: a Double element / len / mutset-0 are all scalars — NEVER heap pointers,
  # so they are never rooted (a Double bit-pattern must not be mistaken for a
  # heap handle). This is the GC-correctness crux of the Double gate.
  | sprout_ir.IRVecLenD _ _ -> Nothing
  | sprout_ir.IRVecGetD _ _ _ -> Nothing
  | sprout_ir.IRVecSetD _ _ _ _ -> Nothing
  | sprout_ir.IRGetTag _ _ -> Nothing
  # A tuple blob (@sprout_alloc_tuple_blob) is heap; a value held live across a
  # later trigger must be rooted.
  | sprout_ir.IRMakeTuple r _ -> Just(r)
  # IRGetTupleField extracts a tuple field.  When kind is IRTScalar the result
  # is a scalar; otherwise treat as heap (it commonly carries List/ADT values,
  # e.g. the accumulator returned from maybe_wrap's (List IROp, Int) tuple).
  | sprout_ir.IRGetTupleField r _ _ kind ->
      match kind with
      | sprout_ir.IRTScalar -> Nothing
      | _ -> Just(r)
  # IRAbortMatch defines no value (/code-review fix #15: void noreturn).
  | sprout_ir.IRAbortMatch -> Nothing
  # IRPanic defines no value (noreturn terminator).
  | sprout_ir.IRPanic _ -> Nothing
  # Width-conversion ops produce i64/i1 scalars — never heap.
  | sprout_ir.IRZextI1ToI64 _ _ -> Nothing
  | sprout_ir.IRTruncI64ToI1 _ _ -> Nothing
  # A TCO param re-load produces a heap value iff the param's kind is heap; the
  # loaded value then enters heap_origin and is rooted where live across triggers
  # (the slot is NOT a GC root — the liveness pass covers the loaded value).
  | sprout_ir.IRTcoLoad loaded _ _ kind ->
      match kind with
      | sprout_ir.IRTScalar -> Nothing
      | _ -> Just(loaded)
  | sprout_ir.IRTcoEntry _ _ -> Nothing
  | sprout_ir.IRTcoBack _ _ _ -> Nothing
  # IRTailCall's result flows straight into the built-in ret (call;ret); nothing
  # in this frame outlives it, so it produces no trackable heap value.
  | sprout_ir.IRTailCall _ _ _ _ -> Nothing
  # Remaining ops produce no heap value (scalars, control flow, void, the root
  # ops; IRPhi heap-ness is resolved in compute_heap_origin/update_scope, so it
  # is Nothing here).  EXHAUSTIVE on purpose — no `_` catch-all, so a new
  # heap-producing IROp is a COMPILE ERROR until classified (P11-2e: IRMakeTuple
  # /IRGetTupleField silently defaulting to Nothing left tuple values unrooted).
  | sprout_ir.IRConst _ _ -> Nothing
  | sprout_ir.IRRet _ -> Nothing
  | sprout_ir.IRRetVoid -> Nothing
  | sprout_ir.IRIAdd _ _ _ -> Nothing
  | sprout_ir.IRISub _ _ _ -> Nothing
  | sprout_ir.IRIMul _ _ _ -> Nothing
  | sprout_ir.IRIDiv _ _ _ -> Nothing
  # stdlib.bits: the result is an unboxed i64, never a heap pointer.
  | sprout_ir.IRIAnd _ _ _ -> Nothing
  | sprout_ir.IRIOr _ _ _ -> Nothing
  | sprout_ir.IRIXor _ _ _ -> Nothing
  | sprout_ir.IRIShl _ _ _ -> Nothing
  | sprout_ir.IRIAShr _ _ _ -> Nothing
  | sprout_ir.IRILShr _ _ _ -> Nothing
  | sprout_ir.IRFloatConst _ _ -> Nothing
  | sprout_ir.IRFAdd _ _ _ -> Nothing
  | sprout_ir.IRFSub _ _ _ -> Nothing
  | sprout_ir.IRFMul _ _ _ -> Nothing
  | sprout_ir.IRFDiv _ _ _ -> Nothing
  | sprout_ir.IRFCmp _ _ _ _ -> Nothing
  | sprout_ir.IRFNeg _ _ -> Nothing
  | sprout_ir.IRSIToF _ _ -> Nothing
  | sprout_ir.IRBoolNot _ _ -> Nothing
  | sprout_ir.IRINeg _ _ -> Nothing
  # A value loaded from a global needs no temp root: its slot is a permanent GC
  # root (IRRegisterGlobalRoot, emitted per global in @__sprout_init_globals),
  # so the pointed-to object is already reachable across any later trigger.
  | sprout_ir.IRLoadGlobal _ _ -> Nothing
  | sprout_ir.IRStoreGlobal _ _ -> Nothing
  # Produces no SSA value (uncaptured void-style call) — defines nothing heap.
  | sprout_ir.IRRegisterGlobalRoot _ -> Nothing
  | sprout_ir.IRICmp _ _ _ _ -> Nothing
  | sprout_ir.IRBr _ -> Nothing
  | sprout_ir.IRCondBr _ _ _ -> Nothing
  | sprout_ir.IRPhi _ _ _ -> Nothing
  | sprout_ir.IRRoot _ _ _ -> Nothing
  | sprout_ir.IRUnroot _ _ -> Nothing

# ---------------------------------------------------------------------------
# CFG helpers

fn op_successors(op: sprout_ir.IROp) -> List String =
  match op with
  | sprout_ir.IRBr lbl -> Cons(lbl, Nil)
  | sprout_ir.IRCondBr _ t e -> [t, e]
  # PR 2.5: pattern-matching ops are not control-flow terminators.
  # (IRAbortMatch emits `unreachable` at lowering time but is not a
  # successor-bearing branch op — the block simply ends.)
  | sprout_ir.IRGetTag _ _ -> Nil
  | sprout_ir.IRGetField _ _ _ _ -> Nil
  | sprout_ir.IRAbortMatch -> Nil
  | sprout_ir.IRZextI1ToI64 _ _ -> Nil
  | sprout_ir.IRTruncI64ToI1 _ _ -> Nil
  # TCO back-edge: terminator branching to the loop header.
  | sprout_ir.IRTcoBack _ _ loop_lbl -> Cons(loop_lbl, Nil)
  # IRTailCall is a terminator that returns (musttail;ret) — control leaves the
  # function, so no in-function successor.
  | sprout_ir.IRTailCall _ _ _ _ -> Nil
  | _ -> Nil

fn last_op(ops: List sprout_ir.IROp) -> Maybe sprout_ir.IROp =
  match ops with
  | Nil -> Nothing
  | [op] -> Just(op)
  | Cons _ rest -> last_op(rest)

fn block_successors(b: sprout_ir.IRBlock) -> List String =
  match b with
  | sprout_ir.IRBlock _ ops ->
      match last_op(ops) with
      | Nothing -> Nil
      | Just op -> op_successors(op)

fn block_label(b: sprout_ir.IRBlock) -> String =
  match b with
  | sprout_ir.IRBlock lbl _ -> lbl

fn block_ops(b: sprout_ir.IRBlock) -> List sprout_ir.IROp =
  match b with
  | sprout_ir.IRBlock _ ops -> ops

fn find_block(label: String, blocks: List sprout_ir.IRBlock) -> Maybe sprout_ir.IRBlock =
  match blocks with
  | Nil -> Nothing
  | Cons b rest ->
      if block_label(b) == label then Just(b)
      else find_block(label, rest)

# ---------------------------------------------------------------------------
# Per-op use/def

# IRTcoEntry uses each param's incoming value (the third tuple element).
fn tco_entry_uses(slots: List (String, String, String)) -> List String =
  match slots with
  | Nil -> Nil
  | Cons (_, _, in_name) rest -> Cons(in_name, tco_entry_uses(rest))

# IRTcoBack uses each new value (stored) and each slot (store target).
fn tco_back_uses(stores: List (String, String, String)) -> List String =
  match stores with
  | Nil -> Nil
  | Cons (slot, _, newv) rest -> Cons(newv, Cons(slot, tco_back_uses(rest)))

fn op_uses(op: sprout_ir.IROp) -> List String =
  match op with
  | sprout_ir.IRConst _ _ -> Nil
  | sprout_ir.IRRet name -> Cons(name, Nil)
  | sprout_ir.IRRetVoid -> Nil
  | sprout_ir.IRIAdd _ a b -> [a, b]
  | sprout_ir.IRISub _ a b -> [a, b]
  | sprout_ir.IRIMul _ a b -> [a, b]
  | sprout_ir.IRIDiv _ a b -> [a, b]
  | sprout_ir.IRIAnd _ a b -> [a, b]
  | sprout_ir.IRIOr _ a b -> [a, b]
  | sprout_ir.IRIXor _ a b -> [a, b]
  | sprout_ir.IRIShl _ a b -> [a, b]
  | sprout_ir.IRIAShr _ a b -> [a, b]
  | sprout_ir.IRILShr _ a b -> [a, b]
  | sprout_ir.IRFloatConst _ _ -> Nil
  | sprout_ir.IRFAdd _ a b -> [a, b]
  | sprout_ir.IRFSub _ a b -> [a, b]
  | sprout_ir.IRFMul _ a b -> [a, b]
  | sprout_ir.IRFDiv _ a b -> [a, b]
  | sprout_ir.IRFCmp _ _ a b -> [a, b]
  | sprout_ir.IRFNeg _ a -> Cons(a, Nil)
  | sprout_ir.IRSIToF _ a -> Cons(a, Nil)
  | sprout_ir.IRBoolNot _ a -> Cons(a, Nil)
  | sprout_ir.IRINeg _ a -> Cons(a, Nil)
  | sprout_ir.IRLoadGlobal _ _ -> Nil
  | sprout_ir.IRStoreGlobal _ v -> Cons(v, Nil)
  # Its operand is a global name, not an SSA value — no liveness use.
  | sprout_ir.IRRegisterGlobalRoot _ -> Nil
  | sprout_ir.IRMakeTuple _ args -> args
  | sprout_ir.IRGetTupleField _ t _ _ -> Cons(t, Nil)
  | sprout_ir.IRICmp _ _ a b -> [a, b]
  | sprout_ir.IRBr _ -> Nil
  | sprout_ir.IRCondBr cond _ _ -> Cons(cond, Nil)
  # Phi's "uses" are per-predecessor and contribute to the predecessor's
  # live_out — see successor_live_in_for_pred.  Intra-block uses are empty.
  | sprout_ir.IRPhi _ _ _ -> Nil
  | sprout_ir.IRCall _ _ _ args -> args
  # Unboxed call reads its args (the two defs <tag>/<val> are results, not uses).
  | sprout_ir.IRCallUnboxed2 _ _ _ _ args -> args
  # Both the packed tag and payload are live into the ret (base is a fresh def).
  | sprout_ir.IRRetUnboxed2 _ tag val -> [tag, val]
  # Width-3 unboxed call reads its args (the three slot defs are results, not uses).
  | sprout_ir.IRCallUnboxed3 _ _ _ _ _ args -> args
  # All three packed fields are live into the ret (base is a fresh def).
  | sprout_ir.IRRetUnboxed3 _ s0 s1 s2 -> [s0, s1, s2]
  | sprout_ir.IRStrConst _ _ _ -> Nil
  | sprout_ir.IRStrSlice _ s start len -> [s, start, len]
  | sprout_ir.IRStrConcat _ a b -> [a, b]
  | sprout_ir.IRStrEq _ a b -> [a, b]
  | sprout_ir.IRStrCompare _ _ a b -> [a, b]
  | sprout_ir.IRPrintStr _ _ arg -> Cons(arg, Nil)
  | sprout_ir.IRStrFromInt _ n -> Cons(n, Nil)
  | sprout_ir.IRMakeCtor _ _ _ args -> args
  | sprout_ir.IRMkClosure _ _ _ caps -> caps
  | sprout_ir.IRApplyClosure _ callee args -> Cons(callee, args)
  | sprout_ir.IRLoadEnvSlot _ env _ _ -> Cons(env, Nil)
  | sprout_ir.IRRoot _ v _ -> Cons(v, Nil)
  | sprout_ir.IRUnroot _ _ -> Nil
  # PR 2.5: pattern-matching ops — the scrutinee handle MUST appear here
  # for IRGetTag / IRGetField, otherwise liveness drops the scrutinee
  # across nested allocations inside branch bodies (silent GC bug).
  | sprout_ir.IRGetTag _ s -> Cons(s, Nil)
  | sprout_ir.IRGetField _ s _ _ -> Cons(s, Nil)
  # B1: the vec handle MUST appear here (same reason as IRGetField's scrutinee)
  # so liveness keeps the Vector live across the load/store; idx/val are read too.
  | sprout_ir.IRVecLenD _ v -> Cons(v, Nil)
  | sprout_ir.IRVecGetD _ v i -> [v, i]
  | sprout_ir.IRVecSetD _ v i x -> [v, i, x]
  | sprout_ir.IRAbortMatch -> Nil
  # IRPanic reads its message operand (keep it live for the @panic call).
  | sprout_ir.IRPanic msg -> Cons(msg, Nil)
  # /code-review-v2 fix #3: width-conversion ops use their single source.
  | sprout_ir.IRZextI1ToI64 _ s -> Cons(s, Nil)
  | sprout_ir.IRTruncI64ToI1 _ s -> Cons(s, Nil)
  # TCO ops: entry uses the incoming params; load uses its slot; back uses the
  # new values + slots (so liveness keeps them across the iteration).
  | sprout_ir.IRTcoEntry slots _ -> tco_entry_uses(slots)
  | sprout_ir.IRTcoLoad _ _ slot _ -> Cons(slot, Nil)
  | sprout_ir.IRTcoBack stores _ _ -> tco_back_uses(stores)
  # IRTailCall uses its argument values (they must be live TO the call); the
  # callee roots them on entry, so they need no root ACROSS the tail call.
  | sprout_ir.IRTailCall _ _ args _ -> args

fn op_def(op: sprout_ir.IROp) -> Maybe String =
  match op with
  | sprout_ir.IRConst r _ -> Just(r)
  | sprout_ir.IRIAdd r _ _ -> Just(r)
  | sprout_ir.IRISub r _ _ -> Just(r)
  | sprout_ir.IRIMul r _ _ -> Just(r)
  | sprout_ir.IRIDiv r _ _ -> Just(r)
  | sprout_ir.IRIAnd r _ _ -> Just(r)
  | sprout_ir.IRIOr r _ _ -> Just(r)
  | sprout_ir.IRIXor r _ _ -> Just(r)
  | sprout_ir.IRIShl r _ _ -> Just(r)
  | sprout_ir.IRIAShr r _ _ -> Just(r)
  | sprout_ir.IRILShr r _ _ -> Just(r)
  | sprout_ir.IRFloatConst r _ -> Just(r)
  | sprout_ir.IRFAdd r _ _ -> Just(r)
  | sprout_ir.IRFSub r _ _ -> Just(r)
  | sprout_ir.IRFMul r _ _ -> Just(r)
  | sprout_ir.IRFDiv r _ _ -> Just(r)
  | sprout_ir.IRFCmp r _ _ _ -> Just(r)
  | sprout_ir.IRFNeg r _ -> Just(r)
  | sprout_ir.IRSIToF r _ -> Just(r)
  | sprout_ir.IRBoolNot r _ -> Just(r)
  | sprout_ir.IRINeg r _ -> Just(r)
  | sprout_ir.IRLoadGlobal r _ -> Just(r)
  | sprout_ir.IRMakeTuple r _ -> Just(r)
  | sprout_ir.IRGetTupleField r _ _ _ -> Just(r)
  | sprout_ir.IRICmp r _ _ _ -> Just(r)
  | sprout_ir.IRPhi r _ _ -> Just(r)
  | sprout_ir.IRCall r _ _ _ -> Just(r)
  # Two defs; report <val> (the heap-relevant one) so liveness kills it at its
  # definition.  <tag> is scalar and un-killed here — harmless over-approximation,
  # and emission is gated by update_scope's in_scope_ord (op_produces_simple_heap),
  # so <val> is never rooted before it is defined.
  | sprout_ir.IRCallUnboxed2 _ val _ _ _ -> Just(val)
  # Three scalar defs; report <s0> for liveness kill (s1/s2 un-killed here — a
  # harmless over-approximation, exactly as IRCallUnboxed2's <tag>; all scalar, so
  # none is ever rooted).  IRRetUnboxed3 is a terminator and falls to the catch-all.
  | sprout_ir.IRCallUnboxed3 s0 _ _ _ _ _ -> Just(s0)
  | sprout_ir.IRStrConst r _ _ -> Just(r)
  | sprout_ir.IRStrSlice r _ _ _ -> Just(r)
  | sprout_ir.IRStrConcat r _ _ -> Just(r)
  | sprout_ir.IRStrEq r _ _ -> Just(r)
  | sprout_ir.IRStrCompare r _ _ _ -> Just(r)
  | sprout_ir.IRPrintStr r _ _ -> Just(r)
  | sprout_ir.IRStrFromInt r _ -> Just(r)
  | sprout_ir.IRMakeCtor r _ _ _ -> Just(r)
  | sprout_ir.IRMkClosure r _ _ _ -> Just(r)
  | sprout_ir.IRApplyClosure r _ _ -> Just(r)
  | sprout_ir.IRLoadEnvSlot r _ _ _ -> Just(r)
  | sprout_ir.IRRoot _ _ discard -> Just(discard)
  | sprout_ir.IRUnroot _ discard -> Just(discard)
  # PR 2.5: pattern-matching ops register their result name so liveness
  # can reason about field bindings. IRAbortMatch is field-less (void
  # noreturn — /code-review fix #15) and falls through to the catch-all.
  | sprout_ir.IRGetTag r _ -> Just(r)
  | sprout_ir.IRGetField r _ _ _ -> Just(r)
  # B1: each defines its result (explicit — do not lean on the `_` catch-all, or
  # liveness never kills the result at its def).
  | sprout_ir.IRVecLenD r _ -> Just(r)
  | sprout_ir.IRVecGetD r _ _ -> Just(r)
  | sprout_ir.IRVecSetD r _ _ _ -> Just(r)
  # IRAbortMatch no longer defines anything (/code-review fix #15).
  | sprout_ir.IRZextI1ToI64 r _ -> Just(r)
  | sprout_ir.IRTruncI64ToI1 r _ -> Just(r)
  # IRTcoLoad defines the re-loaded param value; IRTcoEntry/IRTcoBack define no
  # single SSA value (slots are not liveness-tracked defs) — they fall through.
  | sprout_ir.IRTcoLoad loaded _ _ _ -> Just(loaded)
  | _ -> Nothing

# ---------------------------------------------------------------------------
# Liveness — backward dataflow per function.

fn add_uses(used: List String, uses: Set, defs: Set) -> Set =
  list_fold(\ (acc, u) -> if set_member(u, defs) then acc else set_insert(u, acc),
            uses, used)

fn add_def_maybe(d: Maybe String, defs: Set) -> Set =
  match d with
  | Nothing -> defs
  | Just name -> set_insert(name, defs)

fn block_use_def_loop(ops: List sprout_ir.IROp, uses: Set, defs: Set) -> (Set, Set) =
  match ops with
  | Nil -> (uses, defs)
  | Cons op rest ->
      block_use_def_loop(rest,
                         add_uses(op_uses(op), uses, defs),
                         add_def_maybe(op_def(op), defs))

fn block_use_def(b: sprout_ir.IRBlock) -> (Set, Set) =
  block_use_def_loop(block_ops(b), set_empty(), set_empty())

# For each IRPhi in S, drop its def-name from the successor's live_in and add
# the operand chosen on the B→S edge.  Names that are not phi-defs pass through.
fn add_phi_operand_for_pred(pred_label: String,
                            pairs: List (String, String),
                            acc: Set) -> Set =
  match pairs with
  | Nil -> acc
  | Cons p rest ->
      match p with
      | (v, lbl) ->
          if lbl == pred_label then set_insert(v, acc)
          else add_phi_operand_for_pred(pred_label, rest, acc)

# A phi operand is live-out of the predecessor it is chosen on — the phi reads
# it on that edge — so it is added UNCONDITIONALLY here.  Earlier this only fired
# when the phi RESULT was in the successor's live_in, but op_def(IRPhi)=Just(r)
# subtracts the result from live_in (it is a def), so a phi result consumed
# locally (e.g. `phi ... -> ret`, the join chain a TCO'd `take_while` ends with)
# left its operand off the predecessor's live-out — unrooted across an earlier
# GC trigger in that predecessor and swept (the SourceCursor UAF).  Removing the
# phi def is still correct: a phi result is never itself live-out of a pred.
fn rewrite_phi_in_set(pred_label: String, r: String,
                      pairs: List (String, String),
                      acc: Set) -> Set =
  add_phi_operand_for_pred(pred_label, pairs, set_remove(r, acc))

fn s_live_in_phi_rewrite(pred_label: String,
                         ops: List sprout_ir.IROp,
                         acc: Set) -> Set =
  match ops with
  | Nil -> acc
  | Cons op rest ->
      match op with
      | sprout_ir.IRPhi r _ pairs ->
          s_live_in_phi_rewrite(pred_label, rest,
                                rewrite_phi_in_set(pred_label, r, pairs, acc))
      | _ -> s_live_in_phi_rewrite(pred_label, rest, acc)

fn successor_live_in_for_pred(pred_label: String,
                              s: sprout_ir.IRBlock,
                              s_live_in: Set) -> Set =
  s_live_in_phi_rewrite(pred_label, block_ops(s), s_live_in)

fn lookup_live(lbl: String, dict: Dict Set) -> Set =
  match dict_get(lbl, dict) with
  | Just xs -> xs
  | Nothing -> set_empty()

fn compute_live_out_loop(pred_label: String, succs: List String,
                         blocks: List sprout_ir.IRBlock,
                         live_in_map: Dict Set,
                         acc: Set) -> Set =
  match succs with
  | Nil -> acc
  | Cons s_lbl rest ->
      match find_block(s_lbl, blocks) with
      | Nothing -> compute_live_out_loop(pred_label, rest, blocks, live_in_map, acc)
      | Just s ->
          compute_live_out_loop(pred_label, rest, blocks, live_in_map,
            set_union(acc, successor_live_in_for_pred(pred_label, s, lookup_live(s_lbl, live_in_map))))

fn compute_live_out(b: sprout_ir.IRBlock,
                    blocks: List sprout_ir.IRBlock,
                    live_in_map: Dict Set) -> Set =
  compute_live_out_loop(block_label(b), block_successors(b), blocks, live_in_map, set_empty())

fn block_live_in(b: sprout_ir.IRBlock,
                 all_blocks: List sprout_ir.IRBlock,
                 live_in_map: Dict Set) -> Set =
  match block_use_def(b) with
  | (uses, defs) ->
      set_union(uses, set_diff(compute_live_out(b, all_blocks, live_in_map), defs))

fn compute_liveness_loop(rev_blocks: List sprout_ir.IRBlock,
                         all_blocks: List sprout_ir.IRBlock,
                         acc: Dict Set) -> Dict Set =
  match rev_blocks with
  | Nil -> acc
  | Cons b rest ->
      compute_liveness_loop(rest, all_blocks,
        dict_set(block_label(b), block_live_in(b, all_blocks, acc), acc))

fn compute_liveness(blocks: List sprout_ir.IRBlock) -> Dict Set =
  compute_liveness_loop(list_reverse(blocks), blocks, dict_empty())

# ---------------------------------------------------------------------------
# Per-op live_after, computed on-the-fly.

fn after_minus_def(d: Maybe String, after_set: Set) -> Set =
  match d with
  | Nothing -> after_set
  | Just name -> set_remove(name, after_set)

fn op_live_before(op: sprout_ir.IROp, live_after_op: Set) -> Set =
  list_fold(\ (acc, u) -> set_insert(u, acc),
            after_minus_def(op_def(op), live_after_op),
            op_uses(op))

# Per-op live_after for a whole block in ONE backward pass.  Returns, in op
# order, the set live immediately AFTER each op.  O(block) total — replaces the
# old per-op recompute that re-walked the suffix each time (O(block^2) per block
# with a Set allocated at every step, the dominant codegen allocation churn).
# `live_after(op_i) = live_before(op_{i+1})`, threaded backward from block_live_out.
# Behaviour-identical to the former live_after_head(ops_suffix, block_live_out).
fn block_live_afters_go(ops: List sprout_ir.IROp, block_live_out: Set) -> (List Set, Set) =
  match ops with
  | Nil -> (Nil, block_live_out)
  | Cons op rest ->
      match block_live_afters_go(rest, block_live_out) with
      | (rest_afters, after_op) ->
          (Cons(after_op, rest_afters), op_live_before(op, after_op))

fn block_live_afters(ops: List sprout_ir.IROp, block_live_out: Set) -> List Set =
  match block_live_afters_go(ops, block_live_out) with
  | (afters, _) -> afters

# ---------------------------------------------------------------------------
# heap_origin propagation
#
# Forward-scan blocks (topological order matches the IR's block-list order).
# Mark every heap-producing op's result, then any phi whose operands include
# a marked value.

fn any_pair_in_heap(pairs: List (String, String), heap: Set) -> Bool =
  match pairs with
  | Nil -> false
  | Cons p rest ->
      match p with
      | (v, _) ->
          if set_member(v, heap) then true
          else any_pair_in_heap(rest, heap)

fn mark_if_heap(op: sprout_ir.IROp, acc: Set) -> Set =
  match op_produces_simple_heap(op) with
  | Just r -> set_insert(r, acc)
  | Nothing ->
      match op with
      | sprout_ir.IRPhi r _ pairs ->
          if any_pair_in_heap(pairs, acc) then set_insert(r, acc) else acc
      | _ -> acc

fn scan_block_for_heap(ops: List sprout_ir.IROp, acc: Set) -> Set =
  match ops with
  | Nil -> acc
  | Cons op rest -> scan_block_for_heap(rest, mark_if_heap(op, acc))

fn compute_heap_origin_loop(blocks: List sprout_ir.IRBlock, acc: Set) -> Set =
  match blocks with
  | Nil -> acc
  | Cons b rest ->
      compute_heap_origin_loop(rest, scan_block_for_heap(block_ops(b), acc))

fn compute_heap_origin(blocks: List sprout_ir.IRBlock) -> Set =
  compute_heap_origin_loop(blocks, set_empty())

# ---------------------------------------------------------------------------
# Forward rewrite — insert IRRoot/IRUnroot around trigger ops.
#
# in_scope_ord is a List String (NOT a Set) because IRRoot emission order is
# observable: roots are emitted in definition order so identical input IR
# produces byte-identical LLVM output.

# Filter in_scope_ord (in reverse-def order) to those still live, returning in
# DEFINITION order so emitted IRRoots are deterministic.
fn live_across_loop(in_scope_ord_rev: List String,
                    live_after_op: Set,
                    acc: List String) -> List String =
  match in_scope_ord_rev with
  | Nil -> acc
  | Cons v rest ->
      if set_member(v, live_after_op)
      then live_across_loop(rest, live_after_op, Cons(v, acc))
      else live_across_loop(rest, live_after_op, acc)

fn live_across(in_scope_ord_rev: List String, live_after_op: Set) -> List String =
  live_across_loop(in_scope_ord_rev, live_after_op, Nil)

# Some allocating triggers store their operand registers only AFTER the
# allocation that can fire GC, and (unlike @str_concat, which SPROUT_HANDLEs
# its inputs first) do NOT protect those operands.  Their heap operands must
# therefore be rooted across the op even when they are dead afterward:
#   IRMakeCtor    -> @sprout_makeN: allocate, then store fields.
#   IRMkClosure   -> @sprout_alloc_closure: allocate env, then store caps.
# IRCall is in the SAME class: a runtime builtin may collect BEFORE consuming
# its operands.  @ref_new calls sprout_gc_maybe_collect_threshold() and
# allocates the RefVal before `r->value = value`, so an unrooted heap operand is
# swept and a dangling pointer is stored (PR 11 item 4 GC-UAF).  The direct
# --emit-ir path roots call operands across the call; the typed path must match.
# We can't cheaply know which callees alloc-before-store, so root the operands of
# ALL calls — matching op_triggers_gc's "every call may allocate" conservatism.
# Purely additive (only adds roots; can never cause a UAF, at worst over-retains).
fn op_exposes_operands(op: sprout_ir.IROp) -> Bool =
  match op with
  | sprout_ir.IRMakeCtor _ _ _ _ -> true
  | sprout_ir.IRMkClosure _ _ _ _ -> true
  # @sprout_alloc_tuple_blob allocates, then the lowering stores the element
  # operands — same store-after-alloc exposure as @sprout_makeN.
  | sprout_ir.IRMakeTuple _ _ -> true
  # A call may collect before consuming its operands (e.g. @ref_new); root the
  # heap operands across the call.  See the function-level comment above.  The B2
  # non-allocating allow-list is NOT re-checked here: op_exposes_operands is only
  # consulted for ops op_triggers_gc already classified as triggers (process_op),
  # so an allow-listed read short-circuits upstream and never reaches this arm.
  | sprout_ir.IRCall _ _ _ _ -> true
  # Like IRCall, an allocating unboxed extern may collect before consuming its
  # operands; root the heap operands across it (additive — only adds roots).  The
  # non-allocating allow-list is enforced upstream in op_triggers_gc, so an
  # allow-listed unboxed read short-circuits and never reaches this arm.
  | sprout_ir.IRCallUnboxed2 _ _ _ _ _ -> true
  # IRRetUnboxed2 is a terminator: insertvalue+ret, no allocation, no exposure.
  | sprout_ir.IRRetUnboxed2 _ _ _ -> false
  # Like IRCall, a width-3 unboxed worker call may collect before consuming its
  # operands; root the heap operands across it (additive — only adds roots).
  | sprout_ir.IRCallUnboxed3 _ _ _ _ _ _ -> true
  # IRRetUnboxed3 is a terminator: insertvalue+ret, no allocation, no exposure.
  | sprout_ir.IRRetUnboxed3 _ _ _ _ -> false
  # Everything else does NOT expose operands: str builtins SPROUT_HANDLE their
  # inputs before allocating; the rest do not allocate.  EXHAUSTIVE on purpose —
  # no `_` catch-all, so a new allocating IROp is a COMPILE ERROR until its
  # exposure is decided.
  | sprout_ir.IRConst _ _ -> false
  | sprout_ir.IRRet _ -> false
  | sprout_ir.IRRetVoid -> false
  | sprout_ir.IRIAdd _ _ _ -> false
  | sprout_ir.IRISub _ _ _ -> false
  | sprout_ir.IRIMul _ _ _ -> false
  | sprout_ir.IRIDiv _ _ _ -> false
  # stdlib.bits: operands are unboxed i64 and nothing allocates, so there is no
  # window in which a collection could see them.
  | sprout_ir.IRIAnd _ _ _ -> false
  | sprout_ir.IRIOr _ _ _ -> false
  | sprout_ir.IRIXor _ _ _ -> false
  | sprout_ir.IRIShl _ _ _ -> false
  | sprout_ir.IRIAShr _ _ _ -> false
  | sprout_ir.IRILShr _ _ _ -> false
  | sprout_ir.IRFloatConst _ _ -> false
  | sprout_ir.IRFAdd _ _ _ -> false
  | sprout_ir.IRFSub _ _ _ -> false
  | sprout_ir.IRFMul _ _ _ -> false
  | sprout_ir.IRFDiv _ _ _ -> false
  | sprout_ir.IRFCmp _ _ _ _ -> false
  | sprout_ir.IRFNeg _ _ -> false
  | sprout_ir.IRSIToF _ _ -> false
  | sprout_ir.IRBoolNot _ _ -> false
  | sprout_ir.IRINeg _ _ -> false
  | sprout_ir.IRLoadGlobal _ _ -> false
  | sprout_ir.IRStoreGlobal _ _ -> false
  # Its only operand is a global name (@name), not an SSA value — nothing to root.
  | sprout_ir.IRRegisterGlobalRoot _ -> false
  | sprout_ir.IRGetTupleField _ _ _ _ -> false
  | sprout_ir.IRICmp _ _ _ _ -> false
  | sprout_ir.IRBr _ -> false
  | sprout_ir.IRCondBr _ _ _ -> false
  | sprout_ir.IRPhi _ _ _ -> false
  | sprout_ir.IRStrConst _ _ _ -> false
  | sprout_ir.IRStrSlice _ _ _ _ -> false
  | sprout_ir.IRStrConcat _ _ _ -> false
  | sprout_ir.IRStrEq _ _ _ -> false
  | sprout_ir.IRStrCompare _ _ _ _ -> false
  | sprout_ir.IRPrintStr _ _ _ -> false
  | sprout_ir.IRStrFromInt _ _ -> false
  | sprout_ir.IRApplyClosure _ _ _ -> false
  | sprout_ir.IRLoadEnvSlot _ _ _ _ -> false
  | sprout_ir.IRRoot _ _ _ -> false
  | sprout_ir.IRUnroot _ _ -> false
  | sprout_ir.IRGetTag _ _ -> false
  | sprout_ir.IRGetField _ _ _ _ -> false
  # B1: non-allocating raw loads/store — expose nothing (also never reached, as
  # op_triggers_gc classifies them non-triggers and process_op short-circuits).
  | sprout_ir.IRVecLenD _ _ -> false
  | sprout_ir.IRVecGetD _ _ _ -> false
  | sprout_ir.IRVecSetD _ _ _ _ -> false
  | sprout_ir.IRAbortMatch -> false
  # IRPanic does not trigger GC (panic exits), so it exposes no operands.
  | sprout_ir.IRPanic _ -> false
  | sprout_ir.IRZextI1ToI64 _ _ -> false
  | sprout_ir.IRTruncI64ToI1 _ _ -> false
  # TCO ops never trigger GC, so they expose nothing (the values they store are
  # protected by the liveness pass around the triggers that produced them).
  | sprout_ir.IRTcoEntry _ _ -> false
  | sprout_ir.IRTcoLoad _ _ _ _ -> false
  | sprout_ir.IRTcoBack _ _ _ -> false
  # IRTailCall does not trigger GC (see op_triggers_gc), so it exposes nothing:
  # its args are passed by value and rooted by the callee, never rooted here.
  | sprout_ir.IRTailCall _ _ _ _ -> false

# Set of an op's operand names.  O(uses).
fn op_operand_set(op: sprout_ir.IROp) -> Set =
  list_fold(\ (acc, u) -> set_insert(u, acc), set_empty(), op_uses(op))

# Like live_across, but also keeps any in-scope value that is an operand of
# this op (def order preserved, deduped by the single traversal).
fn roots_across_loop(in_scope_ord_rev: List String,
                     live_after_op: Set,
                     operands: Set,
                     acc: List String) -> List String =
  match in_scope_ord_rev with
  | Nil -> acc
  | Cons v rest ->
      if set_member(v, live_after_op) || set_member(v, operands)
      then roots_across_loop(rest, live_after_op, operands, Cons(v, acc))
      else roots_across_loop(rest, live_after_op, operands, acc)

# Values to root across `op`: those live after it, plus — for operand-exposing
# allocating ops — its own heap operands.  O(in_scope * uses).
fn roots_across(in_scope_ord_rev: List String, live_after_op: Set,
                op: sprout_ir.IROp) -> List String =
  if op_exposes_operands(op)
  then roots_across_loop(in_scope_ord_rev, live_after_op, op_operand_set(op), Nil)
  else live_across(in_scope_ord_rev, live_after_op)

# Emit one IRRoot per value (def order).  Each IRRoot consumes two fresh idx
# slots (slot-name and discard-reg).  Result is prepended to acc (reverse).
# prefix is always "%t$" (see prefix_for_fn) — matches ast_to_ir.fresh_name so
# rooting temps share a namespace with body temps and stay disjoint from
# source-derived names (incl. the IRLoadEnvSlot names %t$0, %t$1, ...).
fn emit_roots_loop(vs: List String, idx: Int, prefix: String, acc: List sprout_ir.IROp) -> (List sprout_ir.IROp, Int) =
  match vs with
  | Nil -> (acc, idx)
  | Cons v rest ->
      emit_roots_loop(rest, idx + 2, prefix,
        Cons(sprout_ir.IRRoot(prefix ++ int_to_string(idx),
                              v,
                              prefix ++ int_to_string(idx + 1)), acc))

fn unroot_op(n: Int, idx: Int, prefix: String) -> (sprout_ir.IROp, Int) =
  (sprout_ir.IRUnroot(n, prefix ++ int_to_string(idx)), idx + 1)

# Root-once stack coalescing.  Instead of bracketing each trigger with
# push-all-live + pop-all (O(uses) re-rooting), a persistent root stack `rooted`
# (head = TOP) is threaded across the block: at each trigger push only the values
# newly needed (`need \ rooted`), then pop dead values from the TOP only.  A dead
# value buried under a live one stays rooted until the live one above it dies —
# over-rooting, which is safe; under-rooting cannot occur because we never pop a
# live or non-top value.  At every trigger the rooted set is a superset of the old
# per-trigger scheme's, so safety follows from that scheme's.  The stack is emptied
# before each block terminator (empty-at-boundary), so cross-block rooting is
# unchanged.  See docs/archive/root-once-rooting-design-2026-06-30.md.

# `need` (def order) minus values already rooted; preserves def order.
fn delta_to_push(need: List String, rooted: List String) -> List String =
  match need with
  | Nil -> Nil
  | Cons v rest ->
      if list_member(v, rooted)
      then delta_to_push(rest, rooted)
      else Cons(v, delta_to_push(rest, rooted))

# Emit IRRoots for to_push in def order; the new stack head is the last pushed
# (= top), matching the runtime shadow-stack order.
fn push_phase(to_push: List String, rooted: List String, idx: Int, prefix: String,
              acc: List sprout_ir.IROp) -> (List sprout_ir.IROp, List String, Int) =
  match emit_roots_loop(to_push, idx, prefix, acc) with
  | (acc1, idx1) -> (acc1, list_append(list_reverse(to_push), rooted), idx1)

# Pop consecutive dead values from the top (head); stop at the first still-live
# value.  Returns the remaining stack and the pop count.
fn pop_dead_top(rooted: List String, live_after: Set, n: Int) -> (List String, Int) =
  match rooted with
  | Nil -> (Nil, n)
  | Cons v rest ->
      if set_member(v, live_after)
      then (rooted, n)
      else pop_dead_top(rest, live_after, n + 1)

fn emit_unroot_after(npop: Int, rooted2: List String, idx: Int, prefix: String,
                     acc: List sprout_ir.IROp) -> (List sprout_ir.IROp, List String, Int) =
  match unroot_op(npop, idx, prefix) with
  | (op_unroot, idx2) -> (Cons(op_unroot, acc), rooted2, idx2)

fn finish_trigger(live_after_op: Set, rooted1: List String, idx1: Int, prefix: String,
                  acc2: List sprout_ir.IROp) -> (List sprout_ir.IROp, List String, Int) =
  match pop_dead_top(rooted1, live_after_op, 0) with
  | (rooted2, npop) ->
      if npop == 0
      then (acc2, rooted1, idx1)
      else emit_unroot_after(npop, rooted2, idx1, prefix, acc2)

fn push_pop_trigger(op: sprout_ir.IROp, need: List String, live_after_op: Set,
                    rooted: List String, idx: Int, prefix: String,
                    acc: List sprout_ir.IROp) -> (List sprout_ir.IROp, List String, Int) =
  match push_phase(delta_to_push(need, rooted), rooted, idx, prefix, acc) with
  | (acc1, rooted1, idx1) ->
      finish_trigger(live_after_op, rooted1, idx1, prefix, Cons(op, acc1))

# Per-op: a trigger pushes its need-delta, emits the op, then pops dead top values;
# a non-trigger is emitted unchanged with the stack untouched.
fn process_op(op: sprout_ir.IROp, live_after_op: Set, in_scope_ord: List String,
              rooted: List String, idx: Int, prefix: String, summary: Dict Bool,
              acc: List sprout_ir.IROp) -> (List sprout_ir.IROp, List String, Int) =
  if op_triggers_gc_summary(op, summary)
  then push_pop_trigger(op, roots_across(in_scope_ord, live_after_op, op),
                        live_after_op, rooted, idx, prefix, acc)
  else (Cons(op, acc), rooted, idx)

# Pop all remaining roots BEFORE the terminator — emitting them after a terminator
# would be invalid IR (nothing executes past a terminator).
fn emit_block_end_pop(rooted: List String, idx: Int, prefix: String,
                      acc: List sprout_ir.IROp) -> (List sprout_ir.IROp, Int) =
  match rooted with
  | Nil -> (acc, idx)
  | _ ->
      match unroot_op(list_length(rooted), idx, prefix) with
      | (op_unroot, idx1) -> (Cons(op_unroot, acc), idx1)

fn finish_block(term_op: sprout_ir.IROp, rooted: List String, idx: Int, prefix: String,
                acc: List sprout_ir.IROp) -> (List sprout_ir.IROp, Int) =
  match emit_block_end_pop(rooted, idx, prefix, acc) with
  | (acc1, idx1) -> (list_reverse(Cons(term_op, acc1)), idx1)

# Carry both a reverse-definition-order list and dedup via list_member.
fn add_def(name: String, ord: List String) -> List String =
  if list_member(name, ord) then ord else Cons(name, ord)

fn update_scope(op: sprout_ir.IROp, heap_origin: Set,
                ord: List String) -> List String =
  match op_produces_simple_heap(op) with
  | Just r -> add_def(r, ord)
  | Nothing ->
      match op with
      | sprout_ir.IRPhi r _ _ ->
          if set_member(r, heap_origin)
          then add_def(r, ord)
          else ord
      | _ -> ord

# `live_afters` is the precomputed per-op live_after list (parallel to `ops`),
# from block_live_afters — so the per-op live set is read, not recomputed.
# `rooted` is the persistent root stack (head = top), empty at block entry.  The
# last op in a block is its terminator: pop all remaining roots before it.
fn rewrite_ops(ops: List sprout_ir.IROp,
               live_afters: List Set,
               heap_origin: Set,
               in_scope_ord: List String,
               rooted: List String,
               idx: Int,
               prefix: String,
               summary: Dict Bool,
               acc: List sprout_ir.IROp) -> (List sprout_ir.IROp, Int) =
  match ops with
  | Nil -> (list_reverse(acc), idx)
  | Cons op rest ->
      match live_afters with
      | Nil -> (list_reverse(acc), idx)
      | Cons live_after_op la_rest ->
          match rest with
          | Nil -> finish_block(op, rooted, idx, prefix, acc)
          | _ ->
              match process_op(op, live_after_op, in_scope_ord, rooted, idx, prefix, summary, acc) with
              | (acc1, rooted1, idx1) ->
                  rewrite_ops(rest, la_rest, heap_origin,
                              update_scope(op, heap_origin, in_scope_ord),
                              rooted1, idx1, prefix, summary, acc1)

fn seed_in_scope_loop(names: List String, ord: List String) -> List String =
  match names with
  | Nil -> ord
  | Cons n rest -> seed_in_scope_loop(rest, add_def(n, ord))

fn seed_in_scope(names: List String) -> List String =
  seed_in_scope_loop(names, Nil)

# Filter a Set down to those names also present in `keep`, returning a List.
# Used to seed in_scope_ord from (live_in ∩ heap_origin) at block entry.
fn intersect_to_list(s: Set, keep: Set) -> List String =
  list_fold(\ (acc, x) -> if set_member(x, keep) then Cons(x, acc) else acc,
            Nil, set_to_list(s))

fn rewrite_block_full(b: sprout_ir.IRBlock,
                      live_in_map: Dict Set,
                      heap_origin: Set,
                      all_blocks: List sprout_ir.IRBlock,
                      idx: Int,
                      prefix: String,
                      summary: Dict Bool) -> (sprout_ir.IRBlock, Int) =
  match b with
  | sprout_ir.IRBlock lbl ops ->
      match rewrite_ops(ops,
                        block_live_afters(ops, compute_live_out(b, all_blocks, live_in_map)),
                        heap_origin,
                        seed_in_scope(intersect_to_list(lookup_live(lbl, live_in_map), heap_origin)),
                        Nil,
                        idx, prefix, summary, Nil) with
      | (new_ops, idx_out) -> (sprout_ir.IRBlock(lbl, new_ops), idx_out)

fn rewrite_fn_blocks(blocks: List sprout_ir.IRBlock,
                     live_in_map: Dict Set,
                     heap_origin: Set,
                     all_blocks: List sprout_ir.IRBlock,
                     idx: Int,
                     prefix: String,
                     summary: Dict Bool,
                     acc: List sprout_ir.IRBlock) -> List sprout_ir.IRBlock =
  match blocks with
  | Nil -> list_reverse(acc)
  | Cons b rest ->
      match rewrite_block_full(b, live_in_map, heap_origin, all_blocks, idx, prefix, summary) with
      | (b1, idx1) ->
          rewrite_fn_blocks(rest, live_in_map, heap_origin, all_blocks, idx1, prefix, summary, Cons(b1, acc))

fn rewrite_fn(f: sprout_ir.IRFunction, start_idx: Int, prefix: String, summary: Dict Bool) -> sprout_ir.IRFunction =
  match f with
  | sprout_ir.IRFunction name params ret_ty blocks ->
      sprout_ir.IRFunction(name, params, ret_ty,
        rewrite_fn_blocks(blocks, compute_liveness(blocks),
                          set_union(params_heap_origin(params), compute_heap_origin(blocks)),
                          blocks, start_idx, prefix, summary, Nil))

# ---------------------------------------------------------------------------
# Seed heap_origin from function parameters.
#
# Filters by per-param IRType (added in BACKLOG.md:367 follow-up to close
# the PR 2.3 "over-roots all params" gap noted previously in this comment).
# IRTScalar params are skipped (Int/Bool/Char — never heap pointers);
# IRTHeap and IRTUnknown params are seeded (heap or conservative).
# Parameters carry no '%' prefix in the IRFunction param list, so we prepend
# '%' here to match the naming convention used throughout the pass.
fn params_heap_origin_loop(params: List (String, sprout_ir.IRType), acc: Set) -> Set =
  match params with
  | Nil -> acc
  | Cons (p, kind) rest ->
      match kind with
      | sprout_ir.IRTScalar -> params_heap_origin_loop(rest, acc)
      | _ -> params_heap_origin_loop(rest, set_insert("%" ++ p, acc))

fn params_heap_origin(params: List (String, sprout_ir.IRType)) -> Set =
  params_heap_origin_loop(params, set_empty())

# ---------------------------------------------------------------------------
# Alloc fixpoint — per-function may-trigger-GC summary.
#
# Lifts op_triggers_gc from per-op to per-function: a call to a Sprout function
# proven never to trigger GC needs no rooting across it.  `summary` maps each
# program function name to whether it MAY trigger GC.  A least fixpoint over the
# call graph (start all-false; `true` is absorbing → converges): a function may
# trigger iff it has a LOCAL trigger (a self-triggering op, a call to an unknown
# / non-allow-listed extern, or an indirect closure call) OR any Sprout callee
# may trigger.
#
# SAFETY (memory-critical, inherits op_triggers_gc's scars):
#   - Conservative default: anything not PROVEN non-triggering stays a trigger.
#     A call whose callee is absent from `summary` (unknown / external) → true.
#     IRApplyClosure and every self-triggering op → true (via op_triggers_gc).
#   - `summary[F] == false` is therefore a PROOF F cannot trigger GC, so eliding
#     roots across a call to F is sound.
#   - Validated under SPROUT_GC_STRESS=1 like every rooting change.

# --- Phase 1: raw per-function extraction (fn_names-INDEPENDENT, so the streaming
# pre-pass can build it one function at a time and discard the IR). ---

# The callee name of a call op, EXCLUDING allow-listed non-allocating externs.
# Just(fname) for any other IRCall/IRCallUnboxed2 (Sprout fn OR unknown extern —
# distinguished later, at resolution); Nothing for non-calls and allow-listed reads.
fn op_raw_callee(op: sprout_ir.IROp) -> Maybe String =
  match op with
  | sprout_ir.IRCall _ _ fname _ ->
      if is_nonallocating_read(fname) then Nothing else Just(fname)
  | sprout_ir.IRCallUnboxed2 _ _ _ fname _ ->
      if is_nonallocating_unboxed_read(fname) then Nothing else Just(fname)
  # Width-3 unboxed call targets a Sprout `@f_worker` (never an allow-listed extern
  # read), so the call-graph edge is always Just(fname) — the fixpoint refines it.
  | sprout_ir.IRCallUnboxed3 _ _ _ _ fname _ -> Just(fname)
  | _ -> Nothing

# Trigger contribution from NON-call ops only (calls are deferred to callee
# resolution).  IRMakeCtor/IRMakeTuple/string ops → true; IRApplyClosure (indirect)
# → true via op_triggers_gc; arithmetic/loads/control flow → false.
fn op_noncall_trigger(op: sprout_ir.IROp) -> Bool =
  match op with
  | sprout_ir.IRCall _ _ _ _ -> false
  | sprout_ir.IRCallUnboxed2 _ _ _ _ _ -> false
  # Width-3 unboxed call is a call — deferred to callee resolution (op_raw_callee).
  | sprout_ir.IRCallUnboxed3 _ _ _ _ _ _ -> false
  | _ -> op_triggers_gc(op)

fn scan_op_raw(op: sprout_ir.IROp, acc: (Bool, Set)) -> (Bool, Set) =
  match acc with
  | (nc, targets) ->
      match op_raw_callee(op) with
      | Just g -> (nc || op_noncall_trigger(op), set_insert(g, targets))
      | Nothing -> (nc || op_noncall_trigger(op), targets)

fn scan_ops_raw(ops: List sprout_ir.IROp, acc: (Bool, Set)) -> (Bool, Set) =
  match ops with
  | Nil -> acc
  | Cons op rest -> scan_ops_raw(rest, scan_op_raw(op, acc))

fn scan_blocks_raw(blocks: List sprout_ir.IRBlock, acc: (Bool, Set)) -> (Bool, Set) =
  match blocks with
  | Nil -> acc
  | Cons b rest -> scan_blocks_raw(rest, scan_ops_raw(block_ops(b), acc))

# Per-function raw summary: (has-non-call-trigger, non-allow-listed call targets).
# fn_names-independent — the streaming pre-pass calls this per translated fn.
export fn fn_raw_summary(f: sprout_ir.IRFunction) -> (Bool, Set) =
  match f with
  | sprout_ir.IRFunction _ _ _ blocks -> scan_blocks_raw(blocks, (false, set_empty()))

# --- Phase 2: resolve raw entries against the full name set, then fixpoint. ---

# Split raw targets into (any-unknown-extern?, Sprout-callee-list).  A target not
# in `names` is an unknown/external callee → conservatively a local trigger.
fn resolve_targets(targets: List String, names: Set,
                   acc_callees: List String) -> (Bool, List String) =
  match targets with
  | Nil -> (false, acc_callees)
  | Cons t rest ->
      if set_member(t, names)
      then resolve_targets(rest, names, Cons(t, acc_callees))
      else match resolve_targets(rest, names, acc_callees) with
           | (_, cs) -> (true, cs)

# Resolve one raw entry to (name, (local_trigger, sprout_callees)).
fn resolve_entry(name: String, nc: Bool, targets: Set, names: Set) -> (String, (Bool, List String)) =
  match resolve_targets(set_to_list(targets), names, Nil) with
  | (has_unknown, callees) -> (name, (nc || has_unknown, callees))

fn resolve_all(raw: List (String, (Bool, Set)), names: Set,
               acc: List (String, (Bool, List String))) -> List (String, (Bool, List String)) =
  match raw with
  | Nil -> list_reverse(acc)
  | Cons (name, (nc, targets)) rest ->
      resolve_all(rest, names, Cons(resolve_entry(name, nc, targets, names), acc))

fn raw_names_loop(raw: List (String, (Bool, Set)), acc: Set) -> Set =
  match raw with
  | Nil -> acc
  | Cons (name, _) rest -> raw_names_loop(rest, set_insert(name, acc))

fn extract_raw_summaries(fns: List sprout_ir.IRFunction,
                         acc: List (String, (Bool, Set))) -> List (String, (Bool, Set)) =
  match fns with
  | Nil -> list_reverse(acc)
  | Cons f rest ->
      match f with
      | sprout_ir.IRFunction name _ _ _ ->
          extract_raw_summaries(rest, Cons((name, fn_raw_summary(f)), acc))

fn lookup_may(name: String, cur: Dict Bool) -> Bool =
  match dict_get(name, cur) with
  | Just b -> b
  | Nothing -> false

# True if any callee currently may-trigger.
fn any_callee_may(callees: List String, cur: Dict Bool) -> Bool =
  match callees with
  | Nil -> false
  | Cons g rest -> if lookup_may(g, cur) then true else any_callee_may(rest, cur)

# One fixpoint round: recompute may[F] = local_trigger[F] OR any callee may.
# Returns (new map, its true-count) so convergence is a single Int compare — no
# separate O(N) walk per round.
fn fixpoint_round(entries: List (String, (Bool, List String)), cur: Dict Bool,
                  acc: Dict Bool, tcount: Int) -> (Dict Bool, Int) =
  match entries with
  | Nil -> (acc, tcount)
  | Cons (name, (lt, callees)) rest ->
      match lt || any_callee_may(callees, cur) with
      | v -> fixpoint_round(rest, cur, dict_set(name, v, acc),
                            if v then tcount + 1 else tcount)

# Iterate rounds until the true-count is stable — a monotone least fixpoint (`true`
# is absorbing, start all-false), so a round that flips nothing new is the exact
# fixed point.  prev_count is the true-count of `cur` (0 for the empty seed).
fn fixpoint_iterate(entries: List (String, (Bool, List String)),
                    prev_count: Int, cur: Dict Bool) -> Dict Bool =
  match fixpoint_round(entries, cur, dict_empty(), 0) with
  | (next, next_count) ->
      if next_count == prev_count
      then next
      else fixpoint_iterate(entries, next_count, next)

# Public (streaming path): build the summary from raw per-function entries the
# pre-pass collected one function at a time.  Names for callee resolution are the
# raw entries' own names.
export fn summary_from_raw(raw: List (String, (Bool, Set))) -> Dict Bool =
  match resolve_all(raw, raw_names_loop(raw, set_empty()), Nil) with
  | resolved -> fixpoint_iterate(resolved, 0, dict_empty())

# Public (batch path): build the summary directly from the whole function list.
export fn compute_alloc_summary(fns: List sprout_ir.IRFunction) -> Dict Bool =
  summary_from_raw(extract_raw_summaries(fns, Nil))

# Summary-aware trigger test: a call to a Sprout function proven non-triggering
# (summary lookup false) is a non-trigger; an unknown callee (absent from the
# summary) is conservatively a trigger.  Non-call ops delegate to op_triggers_gc.
fn op_triggers_gc_summary(op: sprout_ir.IROp, summary: Dict Bool) -> Bool =
  match op with
  | sprout_ir.IRCall _ _ fname _ ->
      if is_nonallocating_read(fname) then false
      else match dict_get(fname, summary) with | Just b -> b | Nothing -> true
  | sprout_ir.IRCallUnboxed2 _ _ _ fname _ ->
      if is_nonallocating_unboxed_read(fname) then false
      else match dict_get(fname, summary) with | Just b -> b | Nothing -> true
  # Width-3 worker call: refine via the summary (absent → conservatively a trigger),
  # so a proven-pure worker lets its call site elide roots.
  | sprout_ir.IRCallUnboxed3 _ _ _ _ fname _ ->
      match dict_get(fname, summary) with | Just b -> b | Nothing -> true
  | _ -> op_triggers_gc(op)

# ---------------------------------------------------------------------------
# Per-program driver.

# `summary` is the may-trigger-GC map (compute_alloc_summary).  Pass dict_empty()
# to disable the interprocedural elision (every Sprout-fn call then defaults to a
# trigger — the pre-fixpoint behaviour, conservative and safe).
export fn rewrite_one_fn_with_summary(f: sprout_ir.IRFunction, idx_map: Dict Int,
                                      summary: Dict Bool) -> sprout_ir.IRFunction =
  match f with
  | sprout_ir.IRFunction name _ _ _ ->
      # All functions use "%t$" as the fresh-name prefix (see prefix_for_fn),
      # matching ast_to_ir.fresh_name so rooting temps share the body namespace
      # and stay disjoint from source-derived names (incl. the IRLoadEnvSlot
      # names "%t$0", "%t$1", ... emitted by build_load_env_ops).  The start_idx
      # from idx_map prevents the rooting pass from reusing indices already
      # consumed by the translator; lifted lambdas in idx_map carry body_next_idx
      # which starts after the n_caps IRLoadEnvSlot names.
      match dict_get(name, idx_map) with
      | Just i -> rewrite_fn(f, i, prefix_for_fn(name), summary)
      | Nothing -> rewrite_fn(f, 0, prefix_for_fn(name), summary)

# SSA fresh-name prefix for root-slot temps the rooting pass generates: always
# "%t$".  Must match ast_to_ir.fresh_name (which hardcodes "%t$" for every body
# temp) so body temps and rooting temps share one namespace AND are disjoint
# from source-derived names.  '$' cannot appear in a source identifier, so a
# source param named `t<N>` (→ %t<N>) can never collide with %t$<N>.
# O(n) in the function name length.
fn prefix_for_fn(name: String) -> String =
  "%t$"

fn rewrite_fns(fns: List sprout_ir.IRFunction, idx_map: Dict Int, summary: Dict Bool,
               acc: List sprout_ir.IRFunction) -> List sprout_ir.IRFunction =
  match fns with
  | Nil -> list_reverse(acc)
  | Cons f rest -> rewrite_fns(rest, idx_map, summary, Cons(rewrite_one_fn_with_summary(f, idx_map, summary), acc))

# Entry point.  idx_map maps fn-name → next-free temp index produced by
# ast_to_ir.translate_program.  Unmapped functions default to 0.  The batch path
# has the whole function list, so it computes the alloc summary directly; the
# streaming path (ir_pipeline) computes it in a pre-pass and calls
# rewrite_one_fn_with_summary per function.
export fn insert_roots(prog: sprout_ir.IRProgram, idx_map: Dict Int) -> sprout_ir.IRProgram =
  match prog with
  | sprout_ir.IRProgram fns globals ctors externs ->
      sprout_ir.IRProgram(rewrite_fns(fns, idx_map, compute_alloc_summary(fns), Nil), globals, ctors, externs)
