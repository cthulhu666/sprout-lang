module stdlib.compiler.ir_rooting
import stdlib.compiler.sprout_ir as sprout_ir

# ---------------------------------------------------------------------------
# IR rooting pass (Milestone 2, PR 2.2 — Model C plan).
#
# Inserts IRRoot/IRUnroot ops around GC-triggering ops to keep heap-typed
# values alive across runtime allocation calls.  Operates as a separate
# post-translation pass over IRProgram; pure-functional (no Refs).
#
# Algorithm summary:
#   For each function:
#     1. Forward-scan blocks to compute heap_origin (Set of heap-typed defs).
#     2. Backward dataflow per function: per-block use/def, live_in/live_out.
#        CFG is a DAG through M2 (no loops); single reverse-topo pass.
#        Phi successors contribute only the operand from the right predecessor.
#     3. Forward rewrite per block:
#        - For each op, compute live_after on-the-fly by walking remaining
#          ops backward from block's live_out.
#        - For trigger ops, compute live_across (heap-typed values defined
#          earlier that remain live), emit IRRoot before / IRUnroot after.
#
# Representation: liveness/heap sets are `Set`; `in_scope_ord` stays a
# `List String` because the order of definitions is observable — IRRoot
# emission order is deterministic in definition order.

# ---------------------------------------------------------------------------
# Trigger / heap predicates

fn op_triggers_gc(op: sprout_ir.IROp) -> Bool =
  match op with
  | sprout_ir.IRStrSlice _ _ _ _ -> true
  | sprout_ir.IRStrConcat _ _ _ -> true
  | sprout_ir.IRStrFromInt _ _ -> true
  # IRStrEq calls @str_eq — a pure comparison; does NOT allocate.  NOT a GC trigger.
  | sprout_ir.IRStrEq _ _ _ -> false
  | sprout_ir.IRStrConst _ _ _ -> false
  # Conservative: every user call may transitively allocate.  Over-roots
  # non-allocating callees; correctness > optimization at M2.
  | sprout_ir.IRCall _ _ _ _ -> true
  # IRMakeCtor lowers to @sprout_makeN which always allocates; trigger.
  | sprout_ir.IRMakeCtor _ _ _ _ -> true
  # IRMkClosure allocates env via @sprout_alloc_closure_env; trigger.
  | sprout_ir.IRMkClosure _ _ _ -> true
  # IRApplyClosure does an indirect call to a user-provided code-ptr; conservative trigger.
  | sprout_ir.IRApplyClosure _ _ _ -> true
  # IRLoadEnvSlot is a pure i64 load — does NOT trigger GC.
  | sprout_ir.IRLoadEnvSlot _ _ _ _ -> false
  # PR 2.5: pattern-matching ops — all three are non-trigger by design.
  # IRGetTag / IRGetField lower to @sprout_tag / @sprout_field, pure reads.
  # IRAbortMatch never allocates.
  # See docs/pr-2.5-pattern-matching-plan.md "Rooting" section.
  | sprout_ir.IRGetTag _ _ -> false
  | sprout_ir.IRGetField _ _ _ _ -> false
  | sprout_ir.IRAbortMatch -> false
  # /code-review-v2 fix #3: width-conversion ops are pure casts; NOT triggers.
  | sprout_ir.IRZextI1ToI64 _ _ -> false
  | sprout_ir.IRTruncI64ToI1 _ _ -> false
  | _ -> false

# Returns Just <result-name> if op directly produces a heap value (excluding
# IRPhi, whose heap-ness depends on operand membership in heap_origin and is
# handled separately in compute_heap_origin / update_scope).
fn op_produces_simple_heap(op: sprout_ir.IROp) -> Maybe String =
  match op with
  | sprout_ir.IRStrConst r _ _ -> Just(r)
  | sprout_ir.IRStrSlice r _ _ _ -> Just(r)
  | sprout_ir.IRStrConcat r _ _ -> Just(r)
  | sprout_ir.IRStrFromInt r _ -> Just(r)
  # IRStrEq produces an i64-encoded Bool — a scalar, NOT a heap pointer.
  | sprout_ir.IRStrEq _ _ _ -> Nothing
  | sprout_ir.IRMakeCtor r _ _ _ -> Just(r)
  # Closure value is heap-allocated (an env pointer packed as i64).
  | sprout_ir.IRMkClosure r _ _ -> Just(r)
  # Closure-application result is conservatively heap-typed (M2: all results are i64).
  | sprout_ir.IRApplyClosure r _ _ -> Just(r)
  # FIX R4#7: honour the kind field. IRTScalar slots (Int, Bool, Char) are
  # not heap; IRTHeap slots (String, ADT, closure) are; IRTUnknown is
  # treated as heap (conservative). This avoids over-rooting scalar captures
  # in deep-recursive closures with many Int/Char captures.
  | sprout_ir.IRLoadEnvSlot r _ _ kind ->
      match kind with
      | sprout_ir.IRTScalar -> Nothing
      | _ -> Just(r)
  # PR 2.5: IRGetField result is heap-typed iff its kind is IRTHeap or
  # IRTUnknown (the kind is decoded by translate_match from the ctors-dict
  # field_kinds_string via field_kinds.field_kind_char_to_irtype).
  # IRGetTag returns an i64 tag, not a heap handle — never heap.
  | sprout_ir.IRGetField r _ _ kind ->
      match kind with
      | sprout_ir.IRTScalar -> Nothing
      | _ -> Just(r)
  | sprout_ir.IRGetTag _ _ -> Nothing
  # IRAbortMatch defines no value (/code-review fix #15: void noreturn).
  | sprout_ir.IRAbortMatch -> Nothing
  # Width-conversion ops produce i64/i1 scalars — never heap.
  | sprout_ir.IRZextI1ToI64 _ _ -> Nothing
  | sprout_ir.IRTruncI64ToI1 _ _ -> Nothing
  | _ -> Nothing

# ---------------------------------------------------------------------------
# CFG helpers

fn op_successors(op: sprout_ir.IROp) -> List String =
  match op with
  | sprout_ir.IRBr lbl -> Cons(lbl, Nil)
  | sprout_ir.IRCondBr _ t e -> Cons(t, Cons(e, Nil))
  # PR 2.5: pattern-matching ops are not control-flow terminators.
  # (IRAbortMatch emits `unreachable` at lowering time but is not a
  # successor-bearing branch op — the block simply ends.)
  | sprout_ir.IRGetTag _ _ -> Nil
  | sprout_ir.IRGetField _ _ _ _ -> Nil
  | sprout_ir.IRAbortMatch -> Nil
  | sprout_ir.IRZextI1ToI64 _ _ -> Nil
  | sprout_ir.IRTruncI64ToI1 _ _ -> Nil
  | _ -> Nil

fn last_op(ops: List sprout_ir.IROp) -> Maybe sprout_ir.IROp =
  match ops with
  | Nil -> Nothing
  | [op] -> Just(op)
  | Cons _ rest -> last_op(rest)

fn block_successors(b: sprout_ir.IRBlock) -> List String =
  match b with
  | sprout_ir.IRBlock _ ops ->
      match last_op(ops) with
      | Nothing -> Nil
      | Just op -> op_successors(op)

fn block_label(b: sprout_ir.IRBlock) -> String =
  match b with
  | sprout_ir.IRBlock lbl _ -> lbl

fn block_ops(b: sprout_ir.IRBlock) -> List sprout_ir.IROp =
  match b with
  | sprout_ir.IRBlock _ ops -> ops

fn find_block(label: String, blocks: List sprout_ir.IRBlock) -> Maybe sprout_ir.IRBlock =
  match blocks with
  | Nil -> Nothing
  | Cons b rest ->
      if block_label(b) == label then Just(b)
      else find_block(label, rest)

# ---------------------------------------------------------------------------
# Per-op use/def

fn op_uses(op: sprout_ir.IROp) -> List String =
  match op with
  | sprout_ir.IRConst _ _ -> Nil
  | sprout_ir.IRRet name -> Cons(name, Nil)
  | sprout_ir.IRRetVoid -> Nil
  | sprout_ir.IRIAdd _ a b -> Cons(a, Cons(b, Nil))
  | sprout_ir.IRISub _ a b -> Cons(a, Cons(b, Nil))
  | sprout_ir.IRIMul _ a b -> Cons(a, Cons(b, Nil))
  | sprout_ir.IRIDiv _ a b -> Cons(a, Cons(b, Nil))
  | sprout_ir.IRBoolNot _ a -> Cons(a, Nil)
  | sprout_ir.IRINeg _ a -> Cons(a, Nil)
  | sprout_ir.IRLoadGlobal _ _ -> Nil
  | sprout_ir.IRStoreGlobal _ v -> Cons(v, Nil)
  | sprout_ir.IRMakeTuple _ args -> args
  | sprout_ir.IRGetTupleField _ t _ -> Cons(t, Nil)
  | sprout_ir.IRICmp _ _ a b -> Cons(a, Cons(b, Nil))
  | sprout_ir.IRBr _ -> Nil
  | sprout_ir.IRCondBr cond _ _ -> Cons(cond, Nil)
  # Phi's "uses" are per-predecessor and contribute to the predecessor's
  # live_out — see successor_live_in_for_pred.  Intra-block uses are empty.
  | sprout_ir.IRPhi _ _ _ -> Nil
  | sprout_ir.IRCall _ _ _ args -> args
  | sprout_ir.IRStrConst _ _ _ -> Nil
  | sprout_ir.IRStrSlice _ s start len -> Cons(s, Cons(start, Cons(len, Nil)))
  | sprout_ir.IRStrConcat _ a b -> Cons(a, Cons(b, Nil))
  | sprout_ir.IRStrEq _ a b -> Cons(a, Cons(b, Nil))
  | sprout_ir.IRStrFromInt _ n -> Cons(n, Nil)
  | sprout_ir.IRMakeCtor _ _ _ args -> args
  | sprout_ir.IRMkClosure _ _ caps -> caps
  | sprout_ir.IRApplyClosure _ callee args -> Cons(callee, args)
  | sprout_ir.IRLoadEnvSlot _ env _ _ -> Cons(env, Nil)
  | sprout_ir.IRRoot _ v _ -> Cons(v, Nil)
  | sprout_ir.IRUnroot _ _ -> Nil
  # PR 2.5: pattern-matching ops — the scrutinee handle MUST appear here
  # for IRGetTag / IRGetField, otherwise liveness drops the scrutinee
  # across nested allocations inside branch bodies (silent GC bug).
  | sprout_ir.IRGetTag _ s -> Cons(s, Nil)
  | sprout_ir.IRGetField _ s _ _ -> Cons(s, Nil)
  | sprout_ir.IRAbortMatch -> Nil
  # /code-review-v2 fix #3: width-conversion ops use their single source.
  | sprout_ir.IRZextI1ToI64 _ s -> Cons(s, Nil)
  | sprout_ir.IRTruncI64ToI1 _ s -> Cons(s, Nil)

fn op_def(op: sprout_ir.IROp) -> Maybe String =
  match op with
  | sprout_ir.IRConst r _ -> Just(r)
  | sprout_ir.IRIAdd r _ _ -> Just(r)
  | sprout_ir.IRISub r _ _ -> Just(r)
  | sprout_ir.IRIMul r _ _ -> Just(r)
  | sprout_ir.IRIDiv r _ _ -> Just(r)
  | sprout_ir.IRBoolNot r _ -> Just(r)
  | sprout_ir.IRINeg r _ -> Just(r)
  | sprout_ir.IRLoadGlobal r _ -> Just(r)
  | sprout_ir.IRMakeTuple r _ -> Just(r)
  | sprout_ir.IRGetTupleField r _ _ -> Just(r)
  | sprout_ir.IRICmp r _ _ _ -> Just(r)
  | sprout_ir.IRPhi r _ _ -> Just(r)
  | sprout_ir.IRCall r _ _ _ -> Just(r)
  | sprout_ir.IRStrConst r _ _ -> Just(r)
  | sprout_ir.IRStrSlice r _ _ _ -> Just(r)
  | sprout_ir.IRStrConcat r _ _ -> Just(r)
  | sprout_ir.IRStrEq r _ _ -> Just(r)
  | sprout_ir.IRStrFromInt r _ -> Just(r)
  | sprout_ir.IRMakeCtor r _ _ _ -> Just(r)
  | sprout_ir.IRMkClosure r _ _ -> Just(r)
  | sprout_ir.IRApplyClosure r _ _ -> Just(r)
  | sprout_ir.IRLoadEnvSlot r _ _ _ -> Just(r)
  | sprout_ir.IRRoot _ _ discard -> Just(discard)
  | sprout_ir.IRUnroot _ discard -> Just(discard)
  # PR 2.5: pattern-matching ops register their result name so liveness
  # can reason about field bindings. IRAbortMatch is field-less (void
  # noreturn — /code-review fix #15) and falls through to the catch-all.
  | sprout_ir.IRGetTag r _ -> Just(r)
  | sprout_ir.IRGetField r _ _ _ -> Just(r)
  # IRAbortMatch no longer defines anything (/code-review fix #15).
  | sprout_ir.IRZextI1ToI64 r _ -> Just(r)
  | sprout_ir.IRTruncI64ToI1 r _ -> Just(r)
  | _ -> Nothing

# ---------------------------------------------------------------------------
# Liveness — backward dataflow per function.

fn add_uses(used: List String, uses: Set, defs: Set) -> Set =
  list_fold(\ (acc, u) -> if set_member(u, defs) then acc else set_insert(u, acc),
            uses, used)

fn add_def_maybe(d: Maybe String, defs: Set) -> Set =
  match d with
  | Nothing -> defs
  | Just name -> set_insert(name, defs)

fn block_use_def_loop(ops: List sprout_ir.IROp, uses: Set, defs: Set) -> (Set, Set) =
  match ops with
  | Nil -> (uses, defs)
  | Cons op rest ->
      block_use_def_loop(rest,
                         add_uses(op_uses(op), uses, defs),
                         add_def_maybe(op_def(op), defs))

fn block_use_def(b: sprout_ir.IRBlock) -> (Set, Set) =
  block_use_def_loop(block_ops(b), set_empty(), set_empty())

# For each IRPhi in S, replace its def-name in s_live_in with the operand
# chosen on the B→S edge.  Names that are not phi-defs pass through unchanged.
fn add_phi_operand_for_pred(pred_label: String,
                            pairs: List (String, String),
                            acc: Set) -> Set =
  match pairs with
  | Nil -> acc
  | Cons p rest ->
      match p with
      | (v, lbl) ->
          if lbl == pred_label then set_insert(v, acc)
          else add_phi_operand_for_pred(pred_label, rest, acc)

fn rewrite_phi_in_set(pred_label: String, r: String,
                      pairs: List (String, String),
                      acc: Set) -> Set =
  if set_member(r, acc)
  then add_phi_operand_for_pred(pred_label, pairs, set_remove(r, acc))
  else acc

fn s_live_in_phi_rewrite(pred_label: String,
                         ops: List sprout_ir.IROp,
                         acc: Set) -> Set =
  match ops with
  | Nil -> acc
  | Cons op rest ->
      match op with
      | sprout_ir.IRPhi r _ pairs ->
          s_live_in_phi_rewrite(pred_label, rest,
                                rewrite_phi_in_set(pred_label, r, pairs, acc))
      | _ -> s_live_in_phi_rewrite(pred_label, rest, acc)

fn successor_live_in_for_pred(pred_label: String,
                              s: sprout_ir.IRBlock,
                              s_live_in: Set) -> Set =
  s_live_in_phi_rewrite(pred_label, block_ops(s), s_live_in)

fn lookup_live(lbl: String, dict: Dict Set) -> Set =
  match dict_get(lbl, dict) with
  | Just xs -> xs
  | Nothing -> set_empty()

fn compute_live_out_loop(pred_label: String, succs: List String,
                         blocks: List sprout_ir.IRBlock,
                         live_in_map: Dict Set,
                         acc: Set) -> Set =
  match succs with
  | Nil -> acc
  | Cons s_lbl rest ->
      match find_block(s_lbl, blocks) with
      | Nothing -> compute_live_out_loop(pred_label, rest, blocks, live_in_map, acc)
      | Just s ->
          compute_live_out_loop(pred_label, rest, blocks, live_in_map,
            set_union(acc, successor_live_in_for_pred(pred_label, s, lookup_live(s_lbl, live_in_map))))

fn compute_live_out(b: sprout_ir.IRBlock,
                    blocks: List sprout_ir.IRBlock,
                    live_in_map: Dict Set) -> Set =
  compute_live_out_loop(block_label(b), block_successors(b), blocks, live_in_map, set_empty())

fn block_live_in(b: sprout_ir.IRBlock,
                 all_blocks: List sprout_ir.IRBlock,
                 live_in_map: Dict Set) -> Set =
  match block_use_def(b) with
  | (uses, defs) ->
      set_union(uses, set_diff(compute_live_out(b, all_blocks, live_in_map), defs))

fn compute_liveness_loop(rev_blocks: List sprout_ir.IRBlock,
                         all_blocks: List sprout_ir.IRBlock,
                         acc: Dict Set) -> Dict Set =
  match rev_blocks with
  | Nil -> acc
  | Cons b rest ->
      compute_liveness_loop(rest, all_blocks,
        dict_set(block_label(b), block_live_in(b, all_blocks, acc), acc))

fn compute_liveness(blocks: List sprout_ir.IRBlock) -> Dict Set =
  compute_liveness_loop(list_reverse(blocks), blocks, dict_empty())

# ---------------------------------------------------------------------------
# Per-op live_after, computed on-the-fly.

fn after_minus_def(d: Maybe String, after_set: Set) -> Set =
  match d with
  | Nothing -> after_set
  | Just name -> set_remove(name, after_set)

fn op_live_before(op: sprout_ir.IROp, live_after_op: Set) -> Set =
  list_fold(\ (acc, u) -> set_insert(u, acc),
            after_minus_def(op_def(op), live_after_op),
            op_uses(op))

# live_after for the HEAD of `ops` given the block's live_out — by walking the
# REST of ops backward, undoing each op.  O(N) per call → O(N²) per block.
fn live_after_head(ops: List sprout_ir.IROp, block_live_out: Set) -> Set =
  match ops with
  | Nil -> block_live_out
  | Cons _ rest -> live_before_first(rest, block_live_out)

fn live_before_first(ops: List sprout_ir.IROp, block_live_out: Set) -> Set =
  match ops with
  | Nil -> block_live_out
  | Cons op rest -> op_live_before(op, live_before_first(rest, block_live_out))

# ---------------------------------------------------------------------------
# heap_origin propagation
#
# Forward-scan blocks (topological order matches the IR's block-list order).
# Mark every heap-producing op's result, then any phi whose operands include
# a marked value.

fn any_pair_in_heap(pairs: List (String, String), heap: Set) -> Bool =
  match pairs with
  | Nil -> false
  | Cons p rest ->
      match p with
      | (v, _) ->
          if set_member(v, heap) then true
          else any_pair_in_heap(rest, heap)

fn mark_if_heap(op: sprout_ir.IROp, acc: Set) -> Set =
  match op_produces_simple_heap(op) with
  | Just r -> set_insert(r, acc)
  | Nothing ->
      match op with
      | sprout_ir.IRPhi r _ pairs ->
          if any_pair_in_heap(pairs, acc) then set_insert(r, acc) else acc
      | _ -> acc

fn scan_block_for_heap(ops: List sprout_ir.IROp, acc: Set) -> Set =
  match ops with
  | Nil -> acc
  | Cons op rest -> scan_block_for_heap(rest, mark_if_heap(op, acc))

fn compute_heap_origin_loop(blocks: List sprout_ir.IRBlock, acc: Set) -> Set =
  match blocks with
  | Nil -> acc
  | Cons b rest ->
      compute_heap_origin_loop(rest, scan_block_for_heap(block_ops(b), acc))

fn compute_heap_origin(blocks: List sprout_ir.IRBlock) -> Set =
  compute_heap_origin_loop(blocks, set_empty())

# ---------------------------------------------------------------------------
# Forward rewrite — insert IRRoot/IRUnroot around trigger ops.
#
# in_scope_ord is a List String (NOT a Set) because IRRoot emission order is
# observable: roots are emitted in definition order so identical input IR
# produces byte-identical LLVM output.

# Filter in_scope_ord (in reverse-def order) to those still live, returning in
# DEFINITION order so emitted IRRoots are deterministic.
fn live_across_loop(in_scope_ord_rev: List String,
                    live_after_op: Set,
                    acc: List String) -> List String =
  match in_scope_ord_rev with
  | Nil -> acc
  | Cons v rest ->
      if set_member(v, live_after_op)
      then live_across_loop(rest, live_after_op, Cons(v, acc))
      else live_across_loop(rest, live_after_op, acc)

fn live_across(in_scope_ord_rev: List String, live_after_op: Set) -> List String =
  live_across_loop(in_scope_ord_rev, live_after_op, Nil)

# Emit one IRRoot per value (def order).  Each IRRoot consumes two fresh idx
# slots (slot-name and discard-reg).  Result is prepended to acc (reverse).
# prefix: "%t" for user fns; "%t$" for lifted lambdas (avoids colliding with
# the IRLoadEnvSlot names %t$0, %t$1, ... emitted by build_load_env_ops_go).
fn emit_roots_loop(vs: List String, idx: Int, prefix: String, acc: List sprout_ir.IROp) -> (List sprout_ir.IROp, Int) =
  match vs with
  | Nil -> (acc, idx)
  | Cons v rest ->
      emit_roots_loop(rest, idx + 2, prefix,
        Cons(sprout_ir.IRRoot(prefix ++ int_to_string(idx),
                              v,
                              prefix ++ int_to_string(idx + 1)), acc))

fn unroot_op(n: Int, idx: Int, prefix: String) -> (sprout_ir.IROp, Int) =
  (sprout_ir.IRUnroot(n, prefix ++ int_to_string(idx)), idx + 1)

fn emit_with_roots(op: sprout_ir.IROp, live: List String, n: Int, idx: Int,
                   prefix: String, acc: List sprout_ir.IROp) -> (List sprout_ir.IROp, Int) =
  match emit_roots_loop(live, idx, prefix, acc) with
  | (acc1, idx1) ->
      match unroot_op(n, idx1, prefix) with
      | (op_unroot, idx2) ->
          (Cons(op_unroot, Cons(op, acc1)), idx2)

fn maybe_wrap_trigger(op: sprout_ir.IROp, live: List String, idx: Int,
                      prefix: String, acc: List sprout_ir.IROp) -> (List sprout_ir.IROp, Int) =
  match live with
  | Nil -> (Cons(op, acc), idx)
  | _ -> emit_with_roots(op, live, list_length(live), idx, prefix, acc)

fn maybe_wrap(op: sprout_ir.IROp,
              live_after_op: Set,
              in_scope_ord: List String,
              idx: Int,
              prefix: String,
              acc: List sprout_ir.IROp) -> (List sprout_ir.IROp, Int) =
  if op_triggers_gc(op)
  then maybe_wrap_trigger(op, live_across(in_scope_ord, live_after_op), idx, prefix, acc)
  else (Cons(op, acc), idx)

# Carry both a reverse-definition-order list and dedup via list_member.
fn add_def(name: String, ord: List String) -> List String =
  if list_member(name, ord) then ord else Cons(name, ord)

fn update_scope(op: sprout_ir.IROp, heap_origin: Set,
                ord: List String) -> List String =
  match op_produces_simple_heap(op) with
  | Just r -> add_def(r, ord)
  | Nothing ->
      match op with
      | sprout_ir.IRPhi r _ _ ->
          if set_member(r, heap_origin)
          then add_def(r, ord)
          else ord
      | _ -> ord

fn rewrite_ops(ops: List sprout_ir.IROp,
               block_live_out: Set,
               heap_origin: Set,
               in_scope_ord: List String,
               idx: Int,
               prefix: String,
               acc: List sprout_ir.IROp) -> (List sprout_ir.IROp, Int) =
  match ops with
  | Nil -> (list_reverse(acc), idx)
  | Cons op rest ->
      match maybe_wrap(op, live_after_head(ops, block_live_out),
                       in_scope_ord, idx, prefix, acc) with
      | (acc1, idx1) ->
          rewrite_ops(rest, block_live_out, heap_origin,
                      update_scope(op, heap_origin, in_scope_ord),
                      idx1, prefix, acc1)

fn seed_in_scope_loop(names: List String, ord: List String) -> List String =
  match names with
  | Nil -> ord
  | Cons n rest -> seed_in_scope_loop(rest, add_def(n, ord))

fn seed_in_scope(names: List String) -> List String =
  seed_in_scope_loop(names, Nil)

# Filter a Set down to those names also present in `keep`, returning a List.
# Used to seed in_scope_ord from (live_in ∩ heap_origin) at block entry.
fn intersect_to_list(s: Set, keep: Set) -> List String =
  list_fold(\ (acc, x) -> if set_member(x, keep) then Cons(x, acc) else acc,
            Nil, set_to_list(s))

fn rewrite_block_full(b: sprout_ir.IRBlock,
                      live_in_map: Dict Set,
                      heap_origin: Set,
                      all_blocks: List sprout_ir.IRBlock,
                      idx: Int,
                      prefix: String) -> (sprout_ir.IRBlock, Int) =
  match b with
  | sprout_ir.IRBlock lbl ops ->
      match rewrite_ops(ops,
                        compute_live_out(b, all_blocks, live_in_map),
                        heap_origin,
                        seed_in_scope(intersect_to_list(lookup_live(lbl, live_in_map), heap_origin)),
                        idx, prefix, Nil) with
      | (new_ops, idx_out) -> (sprout_ir.IRBlock(lbl, new_ops), idx_out)

fn rewrite_fn_blocks(blocks: List sprout_ir.IRBlock,
                     live_in_map: Dict Set,
                     heap_origin: Set,
                     all_blocks: List sprout_ir.IRBlock,
                     idx: Int,
                     prefix: String,
                     acc: List sprout_ir.IRBlock) -> List sprout_ir.IRBlock =
  match blocks with
  | Nil -> list_reverse(acc)
  | Cons b rest ->
      match rewrite_block_full(b, live_in_map, heap_origin, all_blocks, idx, prefix) with
      | (b1, idx1) ->
          rewrite_fn_blocks(rest, live_in_map, heap_origin, all_blocks, idx1, prefix, Cons(b1, acc))

fn rewrite_fn(f: sprout_ir.IRFunction, start_idx: Int, prefix: String) -> sprout_ir.IRFunction =
  match f with
  | sprout_ir.IRFunction name params ret_ty blocks ->
      sprout_ir.IRFunction(name, params, ret_ty,
        rewrite_fn_blocks(blocks, compute_liveness(blocks),
                          set_union(params_heap_origin(params), compute_heap_origin(blocks)),
                          blocks, start_idx, prefix, Nil))

# ---------------------------------------------------------------------------
# Seed heap_origin from function parameters.
#
# Filters by per-param IRType (added in BACKLOG.md:367 follow-up to close
# the PR 2.3 "over-roots all params" gap noted previously in this comment).
# IRTScalar params are skipped (Int/Bool/Char — never heap pointers);
# IRTHeap and IRTUnknown params are seeded (heap or conservative).
# Parameters carry no '%' prefix in the IRFunction param list, so we prepend
# '%' here to match the naming convention used throughout the pass.
fn params_heap_origin_loop(params: List (String, sprout_ir.IRType), acc: Set) -> Set =
  match params with
  | Nil -> acc
  | Cons (p, kind) rest ->
      match kind with
      | sprout_ir.IRTScalar -> params_heap_origin_loop(rest, acc)
      | _ -> params_heap_origin_loop(rest, set_insert("%" ++ p, acc))

fn params_heap_origin(params: List (String, sprout_ir.IRType)) -> Set =
  params_heap_origin_loop(params, set_empty())

# ---------------------------------------------------------------------------
# Per-program driver.

fn rewrite_one_fn(f: sprout_ir.IRFunction, idx_map: Dict Int) -> sprout_ir.IRFunction =
  match f with
  | sprout_ir.IRFunction name _ _ _ ->
      # Lifted lambda bodies use "%t$" as the fresh-name prefix to avoid colliding
      # with the IRLoadEnvSlot names "%t$0", "%t$1", ... emitted by build_load_env_ops.
      # User functions use "%t" (the classic prefix).  The start_idx from idx_map
      # prevents the rooting pass from reusing indices already consumed by the
      # translator; lifted lambdas in idx_map carry body_next_idx which starts
      # after the n_caps IRLoadEnvSlot names.
      match dict_get(name, idx_map) with
      | Just i -> rewrite_fn(f, i, prefix_for_fn(name))
      | Nothing -> rewrite_fn(f, 0, prefix_for_fn(name))

# Pick the SSA fresh-name prefix for a function: "%t$" for lifted lambdas,
# "%t" for user functions.  O(n) in the function name length.
fn prefix_for_fn(name: String) -> String =
  if str_starts_with(name, "__sprout_ir_lambda_") then "%t$" else "%t"

fn rewrite_fns(fns: List sprout_ir.IRFunction, idx_map: Dict Int,
               acc: List sprout_ir.IRFunction) -> List sprout_ir.IRFunction =
  match fns with
  | Nil -> list_reverse(acc)
  | Cons f rest -> rewrite_fns(rest, idx_map, Cons(rewrite_one_fn(f, idx_map), acc))

# Entry point.  idx_map maps fn-name → next-free temp index produced by
# ast_to_ir.translate_program.  Unmapped functions default to 0.
export fn insert_roots(prog: sprout_ir.IRProgram, idx_map: Dict Int) -> sprout_ir.IRProgram =
  match prog with
  | sprout_ir.IRProgram fns globals ctors externs -> sprout_ir.IRProgram(rewrite_fns(fns, idx_map, Nil), globals, ctors, externs)
