module stdlib.compiler.resolve

import stdlib.compiler.ast as ast
import stdlib.compiler.source as source
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types
import stdlib.string as string

# ---------------------------------------------------------------------------
# Constraint resolution / discharge pass
# ---------------------------------------------------------------------------
#
# Runs in the check phase, after type inference, over the typed program (which
# includes the bundled prelude decls).  For every TDict evidence node it walks
# the required instance dictionary tree and rejects a constraint whose head is
# a *concrete* type with no instance — the diagnostic the type checker owes but
# previously skipped, letting an unsatisfiable nested dictionary (e.g.
# `to_string([()])` needing `ToString ()`) reach codegen and segfault.
#
# A constraint whose head is a type *variable* is forwarded (lowering threads it as
# a hidden parameter), mirroring lowering's own resolution order — concrete head
# uses the instance table, variable head is forwarded. One case is checked anyway:
# an instance's context at a NAMED variable (`Eq (Maybe a)` needing `Eq a`) that
# the enclosing declaration does not forward, which lowering could only fill with
# the poison thunk (#423). See VarCover.
#
# Owns its instance tables (built from the typed decls, exactly like lowering's
# collect_instance_table / collect_inst_meta).  This is the first brick of the
# north-star refactor that moves all dictionary resolution into the checker.

export type ResolveResult (..) =
  | ResolveOk typed_ast.TypedProgram
  | ResolveErr source.SourcePos String

# Instance tables: existence (constraint_key → present from bundled decls),
# context (constraint_key → (instance head type args, instance context constraints)),
# the full checker env (carries @inst: markers for instances defined in imported
# modules whose decls are NOT bundled into this program), and super_map
# (class_name → direct superclass names, for transitive-super expansion — the same
# source lowering's collect_super_map reads).
type Tables = Tables(Dict Bool) (Dict (List ast.TypeExpr, List ast.TypeConstraint)) (Dict types.Scheme) (Dict (List String)) (Dict String)

fn tables_exists(t: Tables) -> Dict Bool =
  match t with | Tables e _ _ _ _ -> e

fn tables_ctx(t: Tables) -> Dict (List ast.TypeExpr, List ast.TypeConstraint) =
  match t with | Tables _ c _ _ _ -> c

fn tables_env(t: Tables) -> Dict types.Scheme =
  match t with | Tables _ _ v _ _ -> v

fn tables_super(t: Tables) -> Dict (List String) =
  match t with | Tables _ _ _ s _ -> s

fn tables_class_params(t: Tables) -> Dict String =
  match t with | Tables _ _ _ _ p -> p

# The constraints a declaration forwards as hidden dictionaries, grouped by class and
# head constructor (constraint_key_str): each slot's key (ast.dict_slot_key, one slot
# per whole constraint) with the arguments it was written with, aliases expanded.
# Two slots can share a group (`Ord (Maybe a)` brings `Eq (Maybe a)` beside a written
# `Eq (Maybe b)`); see forwarded_slot.
type alias Forwarded = Dict(List (String, List ast.TypeExpr))

# What an instance context's type-variable constraint is checked against. In a
# declaration body it must be one the declaration forwards (CoverFrom its table),
# and the remedy depends on the declaration (DeclKind). Inside a dictionary the
# declaration itself forwards, nothing is checked: the caller built that dictionary
# whole, context included (CoverByCaller).
type VarCover =
  | CoverFrom DeclKind Forwarded
  | CoverByCaller

# An instance method carries the variables its instance head binds: only a context
# constraint on those is filled by a caller, so only those count as forwarded, and
# they decide which remedy the message names.
type DeclKind =
  | InFn
  | InInstanceMethod (List String)

# The slot the declaration forwards for THIS constraint, not just one sharing its class
# and head. A written variable or a concrete type that differs from what the `where`
# wrote is a different constraint; `where Eq (Maybe a)` used to serve `Maybe b` and
# `Maybe Int` with `a`'s dictionary. An unnamed use-site position (`_`, an inference
# variable) is not evidence of a difference, so it takes the one slot it fits, and none
# when it fits two.
fn forwarded_slot(class_bare: String, type_args: List ast.TypeExpr, fwd: Forwarded) -> Maybe String =
  let Just slots = dict_get(constraint_key_str(class_bare, type_args), fwd) else Nothing
      exact = ast.dict_slot_key(class_bare, type_args)
  in
    if any(\s -> slot_key(s) == exact, slots) then Just(exact)
    else
      match list_filter(\s -> args_conflict(type_args, slot_args(s)) == false, slots) with
      | [(key, _)] -> Just(key)
      | _ -> Nothing

fn slot_key(s: (String, List ast.TypeExpr)) -> String =
  let (key, _) = s
  in key

fn slot_args(s: (String, List ast.TypeExpr)) -> List ast.TypeExpr =
  let (_, written) = s
  in written

fn forwards(class_bare: String, type_args: List ast.TypeExpr, fwd: Forwarded) -> Bool =
  forwarded_slot(class_bare, type_args, fwd) != Nothing

fn args_conflict(uses: List ast.TypeExpr, written: List ast.TypeExpr) -> Bool =
  match (uses, written) with
  | ([], []) -> false
  | ([u | us], [w | ws]) -> te_conflicts(u, w) || args_conflict(us, ws)
  | (_, _) -> true

fn te_conflicts(use: ast.TypeExpr, written: ast.TypeExpr) -> Bool =
  match (use, written) with
  # Compared without module prefixes: a `where` clause and an inferred type may
  # spell one type `Box` and `main.Box`, and a false conflict here is a rejection.
  | (ast.TypeName u, ast.TypeName w) ->
      string.substring_after_last(u, ".") != string.substring_after_last(w, ".") && is_unnamed(u) == false
  | (ast.TypeName u, _) -> is_unnamed(u) == false
  | (ast.TypeApply ub ua, ast.TypeApply wb wa) -> te_conflicts(ub, wb) || te_conflicts(ua, wa)
  | (ast.TupleType us, ast.TupleType ws) -> args_conflict(us, ws)
  # Any other pair, arrows included: the key-level answer, by head constructor. It is
  # what forwarding meant before arguments were compared, so it stays right for any shape.
  | (_, _) -> type_expr_head_name(use) != type_expr_head_name(written)

# A position nothing names: `_`, or an inference variable (`$t<n>`, as
# typed_ast.type_to_type_expr writes one). An existential (`$ex_<binder>`, a `$sk<n>`
# skolem), an unannotated slot's placeholder and a headerless file's own type
# (`$entry.Never`, source.entry_module_prefix) are types of their own; reading them as
# unknown let `where Eq (Maybe a)` serve them with `a`'s dictionary.
fn is_unnamed(name: String) -> Bool =
  name == "_"
    || (str_starts_with(name, "$") && is_existential_name(name) == false
          && str_starts_with(name, source.entry_module_prefix) == false)

fn is_existential_name(name: String) -> Bool =
  types.is_existential_head(name) || types.is_skolem_name(name)

# What a message prints as `_`: every compiler-made name, none of which the program wrote.
fn displays_as_hole(name: String) -> Bool =
  is_unnamed(name) || is_existential_name(name) || types.is_unann_placeholder(name)

# A `where` argument with its type aliases expanded, as the use-site types it is
# compared with already are. Aliases reach resolve as the checker's `@aliasty:`
# markers: a parameterized one under `@aliasfn:<name>:<arity>`, its parameters the
# variables `__aliasparam__<name>:<i>` (infer.register_alias). Aliases are acyclic
# (infer rejects a cycle), so the expansion ends.
fn expand_aliases(te: ast.TypeExpr, env: Dict types.Scheme) -> ast.TypeExpr =
  match te_spine(te, []) with
  | Just (name, args) -> expand_spine(name, list_map(\a -> expand_aliases(a, env), args), env)
  | Nothing -> expand_parts(te, env)

fn expand_parts(te: ast.TypeExpr, env: Dict types.Scheme) -> ast.TypeExpr =
  match te with
  | ast.TupleType items -> ast.TupleType(list_map(\i -> expand_aliases(i, env), items))
  | ast.TypeArrow p r eff mode -> ast.TypeArrow(expand_aliases(p, env), expand_aliases(r, env), eff, mode)
  | ast.TypeThunk r eff -> ast.TypeThunk(expand_aliases(r, env), eff)
  | ast.TypeEffect inner labels -> ast.TypeEffect(expand_aliases(inner, env), labels)
  | ast.TypeName _ -> te
  | ast.TypeApply _ _ -> te

# `F a b` as its head name and arguments; Nothing when the head is not a plain name.
fn te_spine(te: ast.TypeExpr, args: List ast.TypeExpr) -> Maybe (String, List ast.TypeExpr) =
  match te with
  | ast.TypeName name -> Just((name, args))
  | ast.TypeApply base arg -> te_spine(base, Cons(arg, args))
  | _ -> Nothing

fn expand_spine(name: String, args: List ast.TypeExpr, env: Dict types.Scheme) -> ast.TypeExpr =
  match alias_body(name, list_length(args), env) with
  | Just (body, applied) -> expand_aliases(apply_te_args(fill_alias_params(body, args), te_drop(args, applied)), env)
  | Nothing -> apply_te_args(ast.TypeName(name), args)

# The body and how many arguments it takes: a parameterized alias of this arity, else a
# plain one applied to the arguments (`type alias E = Result String`, then `E Int`).
fn alias_body(name: String, arity: Int, env: Dict types.Scheme) -> Maybe(ast.TypeExpr, Int) =
  match alias_marker(types.alias_fn_prefix ++ name ++ ":" ++ int_to_string(arity), env) with
  | Just body -> Just((body, arity))
  | Nothing -> plain_alias(name, env)

fn plain_alias(name: String, env: Dict types.Scheme) -> Maybe(ast.TypeExpr, Int) =
  match alias_marker(name, env) with
  | Just body -> Just((body, 0))
  | Nothing -> Nothing

# The env path keys an imported alias by its short name; try both spellings.
fn alias_marker(key: String, env: Dict types.Scheme) -> Maybe ast.TypeExpr =
  match dict_get(types.alias_marker_prefix ++ key, env) with
  | Just sch -> Just(typed_ast.type_to_type_expr(types.scheme_type(sch)))
  | Nothing ->
      match dict_get(types.alias_marker_prefix ++ string.after_last_dot(key), env) with
      | Just sch -> Just(typed_ast.type_to_type_expr(types.scheme_type(sch)))
      | Nothing -> Nothing

fn fill_alias_params(te: ast.TypeExpr, args: List ast.TypeExpr) -> ast.TypeExpr =
  match te with
  | ast.TypeName n -> alias_param_arg(n, args)
  | ast.TypeApply base arg -> ast.TypeApply(fill_alias_params(base, args), fill_alias_params(arg, args))
  | ast.TupleType items -> ast.TupleType(list_map(\i -> fill_alias_params(i, args), items))
  | ast.TypeArrow p r eff mode -> ast.TypeArrow(fill_alias_params(p, args), fill_alias_params(r, args), eff, mode)
  | ast.TypeThunk r eff -> ast.TypeThunk(fill_alias_params(r, args), eff)
  | ast.TypeEffect inner labels -> ast.TypeEffect(fill_alias_params(inner, args), labels)

# `__aliasparam__<name>:<i>` stands for argument i.
fn alias_param_arg(n: String, args: List ast.TypeExpr) -> ast.TypeExpr =
  if str_starts_with(n, types.alias_param_prefix) == false then ast.TypeName(n)
  else
    match parse_int(string.substring_after_last(n, ":")) with
    | Just i -> te_nth_or(args, i, ast.TypeName(n))
    | Nothing -> ast.TypeName(n)

fn te_nth_or(xs: List ast.TypeExpr, i: Int, dflt: ast.TypeExpr) -> ast.TypeExpr =
  match xs with
  | [] -> dflt
  | [x | rest] -> if i == 0 then x else te_nth_or(rest, i - 1, dflt)

fn apply_te_args(base: ast.TypeExpr, args: List ast.TypeExpr) -> ast.TypeExpr =
  match args with
  | [] -> base
  | [a | rest] -> apply_te_args(ast.TypeApply(base, a), rest)

fn te_drop(xs: List ast.TypeExpr, n: Int) -> List ast.TypeExpr =
  if n <= 0 then xs
  else
    match xs with
    | [] -> []
    | [_ | rest] -> te_drop(rest, n - 1)

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

export fn resolve_program(prog: typed_ast.TypedProgram, env: Dict types.Scheme) -> ResolveResult =
  match prog with
  | typed_ast.TypedProgram decls -> resolve_with_tables(decls, build_tables(decls, env))

# Two passes over the typed decls: check first (produce the diagnostic the type
# checker owes for an unsatisfiable concrete-head constraint), then, only if the
# program is well-formed, rewrite every TDict's Evidence field with the resolved
# instance/forward tree.  The rewrite is dormant today — lowering still resolves
# dictionaries itself and ignores the field — but M3b-3 makes lowering consume it.
fn resolve_with_tables(decls: List typed_ast.TypedDecl, tables: Tables) -> ResolveResult =
  match check_decls(decls, tables) with
  | Just (pos, msg) -> ResolveErr(pos, msg)
  | Nothing -> ResolveOk(typed_ast.TypedProgram(rewrite_decls(decls, tables)))

# ---------------------------------------------------------------------------
# Table construction (from typed decls — prelude is bundled in)
# ---------------------------------------------------------------------------

fn build_tables(decls: List typed_ast.TypedDecl, env: Dict types.Scheme) -> Tables =
  collect_tables(decls, Tables(dict_empty(), dict_empty(), env, collect_super_map(decls, dict_empty()), collect_class_params(decls, dict_empty())))

fn collect_tables(decls: List typed_ast.TypedDecl, acc: Tables) -> Tables =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | typed_ast.TInstanceDecl constraint inst_constraints _ ->
          collect_tables(rest, add_instance(constraint, inst_constraints, acc))
      | _ -> collect_tables(rest, acc)

fn add_instance(
  constraint: ast.TypeConstraint,
  inst_constraints: List ast.TypeConstraint,
  acc: Tables
) -> Tables =
  match constraint with
  | ast.TypeConstraint _ type_args ->
      Tables(
        dict_set(constraint_key_from_tc(constraint), true, tables_exists(acc)),
        add_ctx(constraint_key_from_tc(constraint), type_args, inst_constraints, tables_ctx(acc)),
        tables_env(acc),
        tables_super(acc),
        tables_class_params(acc))

fn add_ctx(
  key: String,
  type_args: List ast.TypeExpr,
  inst_constraints: List ast.TypeConstraint,
  acc: Dict (List ast.TypeExpr, List ast.TypeConstraint)
) -> Dict (List ast.TypeExpr, List ast.TypeConstraint) =
  match inst_constraints with
  | Nil -> acc
  | _ -> dict_set(key, (type_args, inst_constraints), acc)

# ---------------------------------------------------------------------------
# Constraint discharge
# ---------------------------------------------------------------------------

# Returns the first unsatisfiable-constraint error, or Nothing.
fn check_constraint(
  c: ast.TypeConstraint,
  pos: source.SourcePos,
  cover: VarCover,
  tables: Tables
) -> Maybe(source.SourcePos, String) =
  match c with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> Nothing
      | [head_arg | _] ->
          # Only diagnose constraints whose head is a concrete type constructor
          # (uppercase head). A lowercase/`_`/non-letter head is a type variable —
          # forwarded/polymorphic, resolved as a hidden parameter by lowering.
          if declares(string.substring_after_last(class_name, "."), type_args, cover) then Nothing
          else if head_is_concrete(head_arg) == false then Nothing
          else
            if instance_exists(string.substring_after_last(class_name, "."), type_args, head_arg, tables)
            then check_context(constraint_key_str(string.substring_after_last(class_name, "."), type_args),
                               class_name, head_arg, type_args, pos, cover, tables)
            else Just((pos,
              "No instance of " ++ string.substring_after_last(class_name, ".") ++ " for " ++ type_expr_head_name(head_arg)))

# A dictionary the declaration forwards arrives whole, context included, so no instance
# has to exist for it and its context is not this body's to supply. Decided as
# produce_one_class decides EvForward.
fn declares(class_bare: String, type_args: List ast.TypeExpr, cover: VarCover) -> Bool =
  match cover with
  | CoverByCaller -> false
  | CoverFrom _ fwd_keys -> forwards(class_bare, type_args, fwd_keys)

# An instance exists if a bundled decl provides it OR the checker env carries an
# @inst: marker for it (instances from imported modules whose decls are not
# bundled into this program register markers in the env but no TInstanceDecl).
fn instance_exists(
  class_bare: String,
  type_args: List ast.TypeExpr,
  head_arg: ast.TypeExpr,
  tables: Tables
) -> Bool =
  dict_has(constraint_key_str(class_bare, type_args), tables_exists(tables))
  || env_has_inst("@inst:" ++ class_bare ++ ":" ++ type_expr_head_name(head_arg), tables_env(tables))

fn env_has_inst(key: String, env: Dict types.Scheme) -> Bool =
  match dict_get(key, env) with
  | Just _ -> true
  | Nothing -> false

# Recurse into a matched instance's context constraints (substituted at the
# concrete type args).  A context-free instance has no entry → Nothing.
fn check_context(
  key: String,
  class_name: String,
  head_arg: ast.TypeExpr,
  type_args: List ast.TypeExpr,
  pos: source.SourcePos,
  cover: VarCover,
  tables: Tables
) -> Maybe(source.SourcePos, String) =
  match dict_get(key, tables_ctx(tables)) with
  | Nothing -> Nothing
  | Just (inst_type_args, inst_constraints) ->
      match spine_depth_mismatch(key, inst_type_args, type_args) with
      | Just msg -> Just((pos, msg))
      | Nothing ->
          check_context_subs(class_name, head_arg, inst_constraints,
            unify_type_args_list(inst_type_args, type_args, dict_empty()), pos, cover, tables)

# The recorder invariant, reported where there is a position to report it with: the
# instance head and the dispatch type must arrive at the same application depth,
# since unify_type_expr pairs the spines as they stand. A mismatch means some
# recorder recorded the wrong depth, and binding a context variable to whatever
# lines up is how that used to become a wrong witness instead of a diagnostic.
#
# Only this one of the three unify_type_args_list callers can report: the other two
# return an Evidence and a Maybe list, with no position between them.
fn spine_depth_mismatch(key: String, patterns: List ast.TypeExpr,
                        concretes: List ast.TypeExpr) -> Maybe String =
  match (patterns, concretes) with
  | ([p | rest_p], [c | rest_c]) ->
      if te_app_depth(p) == te_app_depth(c)
      then spine_depth_mismatch(key, rest_p, rest_c)
      else Just("internal: instance " ++ key ++ " is written at depth "
                  ++ int_to_string(te_app_depth(p)) ++ " but dispatches on a type at depth "
                  ++ int_to_string(te_app_depth(c)))
  | (_, _) -> Nothing

fn te_app_depth(te: ast.TypeExpr) -> Int =
  match te with
  | ast.TypeApply base _ -> 1 + te_app_depth(base)
  | _ -> 0

# A context variable the head match leaves unbound used to be rejected here, on the
# reasoning that the head and the dispatch type must then disagree about the class
# variable's arity. They need not: `instance Foo Bar where Baz k` binds no `k` and
# has no arity story at all. The arity disagreement is now caught at the
# declaration (infer.check_instance_head_kinds), so an unbound variable reaching
# here is exempt — see check_context_constraint.
fn check_context_subs(
  outer_class: String,
  outer_head: ast.TypeExpr,
  inst_constraints: List ast.TypeConstraint,
  subs: Dict ast.TypeExpr,
  pos: source.SourcePos,
  cover: VarCover,
  tables: Tables
) -> Maybe(source.SourcePos, String) =
  match inst_constraints with
  | Nil -> Nothing
  | Cons ic rest ->
      match check_context_constraint(outer_class, outer_head, ic, subs, pos, cover, tables) with
      | Just e -> Just(e)
      | Nothing -> check_context_subs(outer_class, outer_head, rest, subs, pos, cover, tables)

# One context constraint at the dispatch type. A concrete head is checked like any
# constraint. A variable head is a variable of the enclosing declaration, and must
# be one it forwards — unless the instance head never bound it (`instance Foo Bar
# where Baz k`): no caller can name that slot, and it stays unfilled
# (tests/conformance/run/instance_context_var_absent_from_head.spr).
fn check_context_constraint(
  outer_class: String,
  outer_head: ast.TypeExpr,
  ic: ast.TypeConstraint,
  subs: Dict ast.TypeExpr,
  pos: source.SourcePos,
  cover: VarCover,
  tables: Tables
) -> Maybe(source.SourcePos, String) =
  let ast.TypeConstraint class_name type_args = substitute_constraint(ic, subs)
      [head_arg | _] = type_args else Nothing
  in
    if head_is_concrete(head_arg) then check_constraint(ast.TypeConstraint(class_name, type_args), pos, cover, tables)
    else if context_head_bound(ic, subs) then
      unsupplied_context_var(outer_class, outer_head, class_name, type_args, pos, cover)
    else Nothing

fn context_head_bound(ic: ast.TypeConstraint, subs: Dict ast.TypeExpr) -> Bool =
  let ast.TypeConstraint _ type_args = ic
      [ast.TypeName v | _] = type_args else false
  in dict_has(v, subs)

# Only a variable the declaration's signature names is checked: one the program
# wrote, or an unannotated parameter's placeholder (`_unann@<fn>/<param>`, named by
# infer.seed_unann_names). `_` is a free variable no signature named, whose
# dictionary is never invoked (`to_string(Empty)`), and `$ex_` heads are existential
# givens, forwarded per match arm rather than per declaration.
fn unsupplied_context_var(
  outer_class: String,
  outer_head: ast.TypeExpr,
  class_name: String,
  type_args: List ast.TypeExpr,
  pos: source.SourcePos,
  cover: VarCover
) -> Maybe(source.SourcePos, String) =
  let CoverFrom kind fwd_keys = cover else Nothing
      [head_arg | _] = type_args else Nothing
  in
    if is_checked_var(type_expr_head_name(head_arg)) == false then Nothing
    else if forwards(string.substring_after_last(class_name, "."), type_args, fwd_keys) then Nothing
    else Just((pos, "the `" ++ string.substring_after_last(outer_class, ".") ++ "` instance for `"
                      ++ te_display(outer_head) ++ "` "
                      ++ unsupplied_remedy(kind, string.substring_after_last(class_name, "."), head_arg)))

fn is_checked_var(name: String) -> Bool =
  is_type_var_name(name) || types.is_unann_placeholder(name)

# What the message asks for depends on what can supply the dictionary. An
# unannotated slot has no variable to constrain until it is annotated; a `where` on
# an applied variable (`Eq (f a)`) is not supported; an instance method takes its
# context from the instance head, under the head's own variable names.
fn unsupplied_remedy(kind: DeclKind, cls: String, arg: ast.TypeExpr) -> String =
  if types.is_unann_placeholder(type_expr_head_name(arg)) then unann_remedy(cls, type_expr_head_name(arg))
  else
    "needs `" ++ cls ++ " " ++ te_display_atom(arg) ++ "`, which nothing in scope supplies — "
      ++ supply_hint(kind, cls, arg)

# An instance head's context reaches only the variables the head binds; for any other
# the method's own `where` is the place, and the class must declare it too. A method
# that renamed a head variable (`Box t` for the head's `Box a`) also lands here.
fn supply_hint(kind: DeclKind, cls: String, arg: ast.TypeExpr) -> String =
  match (arg, kind) with
  | (ast.TypeApply _ _, _) ->
      "a `where` constraint on an applied type variable is not supported; use a concrete type"
  | (_, InInstanceMethod bound) ->
      if list_member(type_expr_head_name(arg), bound) then "add it to the instance head's `where`"
      else
        "constrain `" ++ te_display(arg) ++ "` with a method-level `where` (the class declaration "
          ++ "must declare it too) — or, if it is the instance head's variable, spell it as the head does"
  | (_, InFn) -> "add `where " ++ cls ++ " " ++ te_display_atom(arg) ++ "`"

# A slot's own type takes a type variable; a variable INSIDE its type
# (types.is_unann_inner) cannot — `b: t` where `b: Box p` was inferred forces `t` to
# `Box p` — so the remedy is to write the type out, naming the variable.
fn unann_remedy(cls: String, placeholder: String) -> String =
  if types.is_unann_inner(placeholder) then
    "needs `" ++ cls ++ "` on a type variable inside " ++ unann_owner(unann_param(placeholder))
      ++ ", which has no annotation — write that type out, naming the variable, and add a `where "
      ++ cls ++ "` constraint on it"
  else
    "needs `" ++ cls ++ "` on " ++ unann_subject(unann_param(placeholder))
      ++ ", which has no annotation — annotate it with a type variable and add a `where "
      ++ cls ++ "` constraint on that variable"

fn unann_subject(param: Maybe String) -> String =
  match param with
  | Just p -> "the type of parameter `" ++ p ++ "`"
  | Nothing -> "the return type"

fn unann_owner(param: Maybe String) -> String =
  match param with
  | Just p -> "parameter `" ++ p ++ "`'s type"
  | Nothing -> "the return type"

# `_unann@f/x` is parameter `x` of `f`, `_unann@f` f's return type (Nothing). An
# instance method's owner is `#inst/<method>`, whose own `/` is not a parameter's.
fn unann_param(placeholder: String) -> Maybe String =
  let slot = unann_slot(string.drop(without_inner_suffix(placeholder), string.length(types.unann_prefix)))
  in if str_find(slot, "/") == -1 then Nothing else Just(string.substring_after_last(slot, "/"))

fn without_inner_suffix(placeholder: String) -> String =
  if types.is_unann_inner(placeholder)
  then string.take(placeholder, string.length(placeholder) - string.length(types.unann_inner_suffix))
  else placeholder

fn unann_slot(owner_and_param: String) -> String =
  if str_starts_with(owner_and_param, types.inst_owner_prefix)
  then string.drop(owner_and_param, string.length(types.inst_owner_prefix))
  else owner_and_param

# A type as the program would write it. Module prefixes are dropped, a tuple is
# `(a, Int)` rather than its internal head `Tuple2`, and a variable no signature
# named prints as `_`.
fn te_display(te: ast.TypeExpr) -> String =
  match te with
  | ast.TypeName n -> if displays_as_hole(n) then "_" else string.substring_after_last(n, ".")
  | ast.TypeApply base arg -> te_display(base) ++ " " ++ te_display_atom(arg)
  | ast.TupleType items -> "(" ++ string.join(", ", list_map(te_display, items)) ++ ")"
  | ast.TypeArrow param ret _ _ -> te_display_atom(param) ++ " -> " ++ te_display(ret)
  # A thunk or effect type in a context position: its head (`Fn`, `Eff`) still names it.
  | _ -> type_expr_head_name(te)

fn te_display_atom(te: ast.TypeExpr) -> String =
  match te with
  | ast.TypeApply _ _ -> "(" ++ te_display(te) ++ ")"
  | ast.TypeArrow _ _ _ _ -> "(" ++ te_display(te) ++ ")"
  | _ -> te_display(te)

fn dict_has(key: String, d: Dict v) -> Bool =
  match dict_get(key, d) with
  | Just _ -> true
  | Nothing -> false

# ---------------------------------------------------------------------------
# Evidence production
# ---------------------------------------------------------------------------
#
# Resolve one constraint into the Evidence tree lowering will consume.  A single
# TDict lowers to one witness block per *effective class* — the constraint's class
# followed by its transitive superclasses — so produce_evidence expands supers the
# same way lowering's resolve_tdict does, via the shared
# types.class_with_transitive_supers (one source of order + dedup), and wraps the
# per-class blocks in EvClasses.  Each block mirrors
# lowering's resolve_tdict_with_key decision order exactly:
#   * key in fwd_keys           → EvForward key   (the enclosing function forwards
#                                  this exact constraint as a hidden param — checked
#                                  FIRST, mirroring lowering's ctx_fwd-before-ctx_inst
#                                  priority; applies even to a CONCRETE head that also
#                                  has an instance, e.g. `where Summable (Vec Int)`)
#   * type-variable head        → EvForward key   (forwarded, or a phantom fresh tyvar
#                                  that lowering null-fills on the ctx_fwd miss)
#   * concrete head, bundled    → EvInstance key children  (children = one Evidence
#                                  per substituted instance context constraint)
#   * concrete head, env-marker → EvUnresolved    (imported instance not bundled;
#                                  lowering resolves it, same as today)
#   * concrete head, no instance→ EvMissing       (unreachable once check passes)
#
# fwd_keys is the set of constraint_keys the enclosing function forwards (its
# where-clause constraints, super-expanded) — built exactly as lowering's
# build_hidden_for_constraints keys ctx_fwd, so the two agree.
fn produce_evidence(c: ast.TypeConstraint, fwd_keys: Forwarded, tables: Tables) -> typed_ast.Evidence =
  match c with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> typed_ast.EvUnresolved
      | [head_arg | _] ->
          typed_ast.EvClasses(
            list_map(
              \eff_class -> produce_one_class(eff_class, head_arg, type_args, fwd_keys, tables),
              types.class_with_transitive_supers(class_name, tables_super(tables))))

# One effective-class block. A forward is keyed by ast.dict_slot_key, as lowering keys
# its slots; an instance by constraint_key_str, the head alone. class_name is kept
# UNSTRIPPED (eff_class); only the keys are stripped.
fn produce_one_class(
  eff_class: String,
  head_arg: ast.TypeExpr,
  type_args: List ast.TypeExpr,
  fwd_keys: Forwarded,
  tables: Tables
) -> typed_ast.Evidence =
  match forwarded_slot(string.substring_after_last(eff_class, "."), type_args, fwd_keys) with
  | Just slot -> typed_ast.EvForward(eff_class, slot)
  | Nothing ->
      if head_is_concrete(head_arg) == false then
        typed_ast.EvForward(eff_class, ast.dict_slot_key(string.substring_after_last(eff_class, "."), type_args))
      else
        produce_concrete_evidence(eff_class, string.substring_after_last(eff_class, "."), type_args, head_arg, fwd_keys, tables)

fn produce_concrete_evidence(
  eff_class: String,
  class_bare: String,
  type_args: List ast.TypeExpr,
  head_arg: ast.TypeExpr,
  fwd_keys: Forwarded,
  tables: Tables
) -> typed_ast.Evidence =
  if dict_has(constraint_key_str(class_bare, type_args), tables_exists(tables)) then
    produce_instance_evidence(eff_class, constraint_key_str(class_bare, type_args), type_args, fwd_keys, tables)
  else if env_has_inst("@inst:" ++ class_bare ++ ":" ++ type_expr_head_name(head_arg), tables_env(tables)) then
    typed_ast.EvUnresolved
  else
    typed_ast.EvMissing(ast.TypeConstraint(eff_class, type_args))

# Bundled instance: an unconstrained instance has no context entry → no children;
# a constrained instance recurses on each context constraint substituted at the
# concrete head's type args, in declaration order (matching lowering's inner_dicts).
# Each child is itself an EvClasses (the context constraint is super-expanded too).
# The inner dicts share the enclosing function's fwd_keys, exactly as lowering's
# resolve_inner_constraint_dicts resolves them against the same ctx_fwd.
fn produce_instance_evidence(
  eff_class: String,
  key: String,
  type_args: List ast.TypeExpr,
  fwd_keys: Forwarded,
  tables: Tables
) -> typed_ast.Evidence =
  match dict_get(key, tables_ctx(tables)) with
  | Nothing -> typed_ast.EvInstance(eff_class, key, Nil)
  | Just (inst_type_args, inst_constraints) ->
      typed_ast.EvInstance(eff_class, key,
        list_map(
          \ic -> produce_evidence(substitute_constraint(ic, unify_type_args_list(inst_type_args, type_args, dict_empty())), fwd_keys, tables),
          inst_constraints))

# The forwarded slots of a function/method body: one per (constraint, super) in its
# where-clause, keyed by the WRITTEN arguments exactly as lowering's
# build_hidden_for_constraints keys ctx_fwd (ast.dict_slot_key), and holding them with
# aliases expanded, as use sites are compared (expand_aliases).
fn build_fwd_keys(constraints: List ast.TypeConstraint, tables: Tables) -> Forwarded =
  add_fwd_keys(constraints, tables, dict_empty())

fn add_fwd_keys(constraints: List ast.TypeConstraint, tables: Tables, acc: Forwarded) -> Forwarded =
  match constraints with
  | Nil -> acc
  | Cons c rest ->
      match c with
      | ast.TypeConstraint class_name type_args ->
          add_fwd_keys(rest, tables,
            add_eff_keys(types.class_with_transitive_supers(class_name, tables_super(tables)), type_args,
                         list_map(\a -> expand_aliases(a, tables_env(tables)), type_args), acc))

fn add_eff_keys(effs: List String, type_args: List ast.TypeExpr, expanded: List ast.TypeExpr,
                acc: Forwarded) -> Forwarded =
  match effs with
  | Nil -> acc
  | Cons eff rest ->
      add_eff_keys(rest, type_args, expanded,
        add_slot(string.substring_after_last(eff, "."), type_args, expanded, acc))

# A slot already recorded (one constraint reached twice, as a superclass and directly)
# is not recorded again.
fn add_slot(class_bare: String, type_args: List ast.TypeExpr, expanded: List ast.TypeExpr,
            acc: Forwarded) -> Forwarded =
  let group = constraint_key_str(class_bare, type_args)
      slot = ast.dict_slot_key(class_bare, type_args)
      Just slots = dict_get(group, acc) else dict_set(group, [(slot, expanded)], acc)
  in
    if any(\s -> slot_key(s) == slot, slots) then acc
    else dict_set(group, list_append(slots, [(slot, expanded)]), acc)

# The type variables an instance head binds (`a` in `instance Eq (Maybe a)`).
fn head_vars(constraint: ast.TypeConstraint) -> List String =
  match constraint with
  | ast.TypeConstraint _ type_args -> te_vars_list(type_args, [])

fn te_vars_list(tes: List ast.TypeExpr, acc: List String) -> List String =
  match tes with
  | [] -> acc
  | [te | rest] -> te_vars_list(rest, te_vars(te, acc))

fn te_vars(te: ast.TypeExpr, acc: List String) -> List String =
  match te with
  | ast.TypeName n -> if is_type_var_name(n) then Cons(n, acc) else acc
  | ast.TypeApply base arg -> te_vars(arg, te_vars(base, acc))
  | ast.TupleType items -> te_vars_list(items, acc)
  | ast.TypeArrow p r _ _ -> te_vars(r, te_vars(p, acc))
  | ast.TypeThunk r _ -> te_vars(r, acc)
  | ast.TypeEffect inner _ -> te_vars(inner, acc)

# An instance context constraint on a variable the head does not bind (`instance Mk Box
# where Eq b`) is accepted, but no caller can fill its slot, so it supplies nothing.
fn head_bound(inst_constraints: List ast.TypeConstraint, bound: List String) -> List ast.TypeConstraint =
  list_filter(\c -> head_binds_all(c, bound), inst_constraints)

fn head_binds_all(c: ast.TypeConstraint, bound: List String) -> Bool =
  all(\v -> list_member(v, bound), te_vars_list(constraint_args(c), []))

fn constraint_args(c: ast.TypeConstraint) -> List ast.TypeExpr =
  match c with
  | ast.TypeConstraint _ type_args -> type_args

# ---------------------------------------------------------------------------
# Superclass expansion (ported verbatim from lowering.sprout so the effective-
# class order and diamond-dedup match byte-for-byte)
# ---------------------------------------------------------------------------

fn collect_super_map(decls: List typed_ast.TypedDecl, acc: Dict (List String)) -> Dict (List String) =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | typed_ast.TPassThrough inner_decl ->
          match inner_decl with
          | ast.ClassDecl class_name _ _ supers _ ->
              collect_super_map(rest, dict_set(class_name, extract_super_names(supers, Nil), acc))
          | _ -> collect_super_map(rest, acc)
      | _ -> collect_super_map(rest, acc)

fn extract_super_names(supers: List ast.TypeConstraint, acc: List String) -> List String =
  match supers with
  | Nil -> list_reverse(acc)
  | Cons c rest ->
      match c with
      | ast.TypeConstraint super_name _ ->
          extract_super_names(rest, Cons(super_name, acc))

# class_name → class-parameter name (e.g. "ToString" → "a"), the same table
# lowering's ctx_class_params carries.  Used to derive a value-position class
# method's head type from its (substituted) type.
fn collect_class_params(decls: List typed_ast.TypedDecl, acc: Dict String) -> Dict String =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | typed_ast.TPassThrough inner_decl ->
          match inner_decl with
          | ast.ClassDecl class_name params _ _ _ ->
              collect_class_params(rest, add_class_param(class_name, params, acc))
          | _ -> collect_class_params(rest, acc)
      | _ -> collect_class_params(rest, acc)

fn add_class_param(class_name: String, params: List String, acc: Dict String) -> Dict String =
  match params with
  | Nil -> acc
  | [p | _] -> dict_set(class_name, p, acc)

# Transitive-superclass DFS order now comes from the single shared source
# types.class_with_transitive_supers (the same one ast_to_ir's existential
# witness-slot count and lowering's unpack use), so resolve's PACK order and that
# UNPACK order cannot drift apart — a divergence would mismap packed witnesses to
# the wrong methods. See docs/gadts-v0.md §5b.

# ---------------------------------------------------------------------------
# Value-position class-method head derivation (ported from lowering.sprout so the
# resolve pass can fill a TMethodRef's Evidence the same way lowering eta-expands
# it). The `mr_` prefix avoids clashing with resolve's own helpers.
# ---------------------------------------------------------------------------

fn mr_first_concrete_head_str(t: types.Type) -> Maybe String =
  match t with
  | types.TConst name -> Just(types.type_id_display(name))
  | types.TApp base _ -> mr_first_concrete_head_str(base)
  | types.TTuple items -> Just(types.tuple_head(list_length(items)))
  | types.TVar _ -> Nothing
  | types.TFunc _ _ _ _ -> Nothing
  | types.TThunk _ _ -> Nothing

fn mr_class_param_for(class_name: String, class_params: Dict String) -> Maybe String =
  match dict_get(class_name, class_params) with
  | Just param -> Just(param)
  | Nothing -> dict_get(string.after_last_dot(class_name), class_params)

fn mr_eta_class_type(class_name: String, method_name: String, actual_type: types.Type, fallback: types.Type, class_params: Dict String, scheme_env: Dict types.Scheme) -> types.Type =
  match mr_class_param_for(class_name, class_params) with
  | Nothing -> fallback
  | Just class_param ->
      match mr_lookup_method_scheme(method_name, scheme_env) with
      | Nothing -> fallback
      | Just scheme -> mr_eta_class_type_from_scheme(class_param, types.scheme_type(scheme), actual_type, fallback)

fn mr_lookup_method_scheme(method_name: String, scheme_env: Dict types.Scheme) -> Maybe types.Scheme =
  match dict_get(method_name, scheme_env) with
  | Just scheme -> Just(scheme)
  | Nothing -> dict_get(string.after_last_dot(method_name), scheme_env)

fn mr_eta_class_type_from_scheme(class_param: String, scheme_type: types.Type, actual_type: types.Type, fallback: types.Type) -> types.Type =
  match dict_get(class_param, match_type_vars(scheme_type, actual_type, dict_empty())) with
  | Nothing -> fallback
  | Just class_type -> class_type

fn match_type_vars(pattern: types.Type, actual: types.Type, acc: Dict types.Type) -> Dict types.Type =
  match pattern with
  | types.TVar name -> dict_set(types.tyvar_identity(name), actual, acc)
  | types.TConst _ -> acc
  | types.TApp pbase parg ->
      match actual with
      | types.TApp abase aarg -> match_type_vars(parg, aarg, match_type_vars(pbase, abase, acc))
      | _ -> acc
  | types.TFunc pparam pret _ _ ->
      match actual with
      | types.TFunc aparam aret _ _ -> match_type_vars(pret, aret, match_type_vars(pparam, aparam, acc))
      | _ -> acc
  | types.TThunk pret _ ->
      match actual with
      | types.TThunk aret _ -> match_type_vars(pret, aret, acc)
      | _ -> acc
  | types.TTuple pitems ->
      match actual with
      | types.TTuple aitems -> match_type_var_lists(pitems, aitems, acc)
      | _ -> acc

fn match_type_var_lists(patterns: List types.Type, actuals: List types.Type, acc: Dict types.Type) -> Dict types.Type =
  match (patterns, actuals) with
  | (Nil, _) -> acc
  | (_, Nil) -> acc
  | (Cons p prest, Cons a arest) -> match_type_var_lists(prest, arest, match_type_vars(p, a, acc))

# Value-position class method: derive the class-parameter head type from the
# method's (substituted) type via the class-method scheme, then reuse
# produce_one_class for that single class. Non-derivable / non-concrete head →
# EvUnresolved (lowering falls back to its own eta reconstruction).
fn method_ref_evidence(method: String, class_name: String, t: types.Type, fwd_keys: Forwarded, tables: Tables) -> typed_ast.Evidence =
  let Just(ast.TypeConstraint _ args) = method_ref_constraint(method, class_name, t, tables)
        else typed_ast.EvUnresolved
      [head_arg] = args else typed_ast.EvUnresolved
  in produce_one_class(class_name, head_arg, args, fwd_keys, tables)

# The constraint a value-position method needs, its type named as the enclosing
# declaration wrote it; Nothing when the head is not a constructor.
fn method_ref_constraint(method: String, class_name: String, t: types.Type,
                         tables: Tables) -> Maybe ast.TypeConstraint =
  let class_type = mr_eta_class_type(class_name, method, t, t, tables_class_params(tables), tables_env(tables))
      Just _ = mr_first_concrete_head_str(class_type) else Nothing
  in Just(ast.TypeConstraint(class_name, [named_type_expr(class_type, tables_env(tables))]))

# The type with each signature variable named as it was declared, through the
# `@eta_fwdvar` markers, so a slot key built from it (ast.dict_slot_key) is the one the
# enclosing function's slot is under. Any other variable keeps its identity.
fn named_type_expr(t: types.Type, env: Dict types.Scheme) -> ast.TypeExpr =
  match t with
  | types.TVar v ->
      match dict_get("@eta_fwdvar:" ++ types.tyvar_identity(v), env) with
      | Just scheme -> typed_ast.type_to_type_expr(types.scheme_type(scheme))
      | Nothing -> typed_ast.type_to_type_expr(t)
  | types.TApp f x -> ast.TypeApply(named_type_expr(f, env), named_type_expr(x, env))
  | types.TTuple items -> ast.TupleType(list_map(\i -> named_type_expr(i, env), items))
  | types.TConst _ -> typed_ast.type_to_type_expr(t)
  | types.TFunc _ _ _ _ -> typed_ast.type_to_type_expr(t)
  | types.TThunk _ _ -> typed_ast.type_to_type_expr(t)

# ---------------------------------------------------------------------------
# Evidence rewrite: fill every TDict's Evidence, structure otherwise unchanged
# ---------------------------------------------------------------------------

fn rewrite_decls(decls: List typed_ast.TypedDecl, tables: Tables) -> List typed_ast.TypedDecl =
  list_map(\d -> rewrite_decl(d, tables), decls)

# Each decl body is rewritten under its own forwarded-key set: a function forwards
# its where-clause constraints; an instance method forwards the instance's context
# constraints and then its own (matching lowering's build_hidden_for_constraints
# call sites). A top-level let forwards nothing.
fn rewrite_decl(d: typed_ast.TypedDecl, tables: Tables) -> typed_ast.TypedDecl =
  match d with
  | typed_ast.TFnDecl name params ret_ty effects constraints body ->
      typed_ast.TFnDecl(name, params, ret_ty, effects, constraints,
        rewrite_expr(body, build_fwd_keys(constraints, tables), tables))
  | typed_ast.TLetDecl name body ->
      typed_ast.TLetDecl(name, rewrite_expr(body, dict_empty(), tables))
  | typed_ast.TInstanceDecl constraint inst_constraints methods ->
      typed_ast.TInstanceDecl(constraint, inst_constraints,
        list_map(\m -> rewrite_method(m, head_bound(inst_constraints, head_vars(constraint)), tables), methods))
  | typed_ast.TExternFnDecl _ _ _ _ -> d
  | typed_ast.TPassThrough _ -> d

fn rewrite_method(m: typed_ast.TypedInstanceMethod, inst_constraints: List ast.TypeConstraint,
                  tables: Tables) -> typed_ast.TypedInstanceMethod =
  match m with
  | typed_ast.TypedInstanceMethod name params ret_ty effects cs body ->
      typed_ast.TypedInstanceMethod(name, params, ret_ty, effects, cs,
        rewrite_expr(body, method_fwd_keys(inst_constraints, cs, tables), tables))

# lowering's generate_one_instance_fn passes the instance head's dicts, then the
# method's own.
fn method_fwd_keys(inst_constraints: List ast.TypeConstraint, method_constraints: List ast.TypeConstraint,
                   tables: Tables) -> Forwarded =
  build_fwd_keys(list_append(inst_constraints, method_constraints), tables)

# Structural rebuild that visits the same nodes as check_expr; at each TDict the
# Evidence field is replaced.  Any node not walked keeps EvUnresolved, which
# lowering resolves itself — so a missed site degrades to today's behavior, never
# to a wrong witness. fwd_keys is constant within a body (lambdas add no constraints).
fn rewrite_expr(e: typed_ast.TypedExpr, fwd_keys: Forwarded, tables: Tables) -> typed_ast.TypedExpr =
  match e with
  | typed_ast.TDict c t pos _ -> typed_ast.TDict(c, t, pos, produce_evidence(c, fwd_keys, tables))
  | typed_ast.TCall callee args t pos ->
      typed_ast.TCall(rewrite_expr(callee, fwd_keys, tables), list_map(\a -> rewrite_expr(a, fwd_keys, tables), args), t, pos)
  | typed_ast.TIf cnd thn els t pos ->
      typed_ast.TIf(rewrite_expr(cnd, fwd_keys, tables), rewrite_expr(thn, fwd_keys, tables), rewrite_expr(els, fwd_keys, tables), t, pos)
  | typed_ast.TMatch scrut branches t pos ->
      typed_ast.TMatch(rewrite_expr(scrut, fwd_keys, tables), list_map(\b -> rewrite_branch(b, fwd_keys, tables), branches), t, pos)
  | typed_ast.TLambda params body t pos ->
      typed_ast.TLambda(params, rewrite_expr(body, fwd_keys, tables), t, pos)
  | typed_ast.TTuple items t pos ->
      typed_ast.TTuple(list_map(\i -> rewrite_expr(i, fwd_keys, tables), items), t, pos)
  | typed_ast.TBinary op l r t pos ->
      typed_ast.TBinary(op, rewrite_expr(l, fwd_keys, tables), rewrite_expr(r, fwd_keys, tables), t, pos)
  | typed_ast.TUnary op x t pos ->
      typed_ast.TUnary(op, rewrite_expr(x, fwd_keys, tables), t, pos)
  | typed_ast.TRange lo hi t pos ->
      typed_ast.TRange(rewrite_expr(lo, fwd_keys, tables), rewrite_expr(hi, fwd_keys, tables), t, pos)
  | typed_ast.TDo steps t pos ->
      typed_ast.TDo(list_map(\s -> rewrite_step(s, fwd_keys, tables), steps), t, pos)
  | typed_ast.TRecord name fields t pos ->
      typed_ast.TRecord(name, list_map(\f -> rewrite_field(f, fwd_keys, tables), fields), t, pos)
  | typed_ast.TGetField obj fld t pos ->
      typed_ast.TGetField(rewrite_expr(obj, fwd_keys, tables), fld, t, pos)
  | typed_ast.TRecordUpdate base fields t pos ->
      typed_ast.TRecordUpdate(rewrite_expr(base, fwd_keys, tables),
        list_map(\f -> rewrite_field(f, fwd_keys, tables), fields), t, pos)
  | typed_ast.TMethodRef method class_name t pos _ ->
      typed_ast.TMethodRef(method, class_name, t, pos, method_ref_evidence(method, class_name, t, fwd_keys, tables))
  | _ -> e

fn rewrite_branch(b: typed_ast.TypedMatchBranch, fwd_keys: Forwarded, tables: Tables) -> typed_ast.TypedMatchBranch =
  match b with
  | typed_ast.TypedMatchBranch pat body -> typed_ast.TypedMatchBranch(pat, rewrite_expr(body, fwd_keys, tables))

fn rewrite_step(s: typed_ast.TypedDoStep, fwd_keys: Forwarded, tables: Tables) -> typed_ast.TypedDoStep =
  match s with
  | typed_ast.TDoBindStep pat ex -> typed_ast.TDoBindStep(pat, rewrite_expr(ex, fwd_keys, tables))
  | typed_ast.TDoLetStep name ex -> typed_ast.TDoLetStep(name, rewrite_expr(ex, fwd_keys, tables))
  | typed_ast.TDoExprStep ex -> typed_ast.TDoExprStep(rewrite_expr(ex, fwd_keys, tables))

fn rewrite_field(f: typed_ast.TypedRecordField, fwd_keys: Forwarded, tables: Tables) -> typed_ast.TypedRecordField =
  match f with
  | typed_ast.TypedRecordField name ex -> typed_ast.TypedRecordField(name, rewrite_expr(ex, fwd_keys, tables))

# ---------------------------------------------------------------------------
# Typed-AST walk: find every TDict and check its constraint
# ---------------------------------------------------------------------------

fn check_decls(
  decls: List typed_ast.TypedDecl,
  tables: Tables
) -> Maybe(source.SourcePos, String) =
  match decls with
  | Nil -> Nothing
  | Cons d rest ->
      match check_decl(d, tables) with
      | Just e -> Just(e)
      | Nothing -> check_decls(rest, tables)

# Each body is checked under the keys it forwards — the same sets rewrite_decl
# resolves Evidence with.
fn check_decl(d: typed_ast.TypedDecl, tables: Tables) -> Maybe(source.SourcePos, String) =
  match d with
  | typed_ast.TFnDecl _ _ _ _ constraints body -> check_body(body, InFn, constraints, tables)
  | typed_ast.TLetDecl _ body -> check_expr(body, CoverFrom (InFn, dict_empty()), tables)
  | typed_ast.TInstanceDecl constraint inst_constraints methods ->
      check_methods(head_vars(constraint), head_bound(inst_constraints, head_vars(constraint)), methods, tables)
  | typed_ast.TExternFnDecl _ _ _ _ -> Nothing
  | typed_ast.TPassThrough _ -> Nothing

fn check_body(body: typed_ast.TypedExpr, kind: DeclKind, constraints: List ast.TypeConstraint,
              tables: Tables) -> Maybe(source.SourcePos, String) =
  check_expr(body, CoverFrom(kind, build_fwd_keys(constraints, tables)), tables)

fn check_methods(
  bound: List String,
  inst_constraints: List ast.TypeConstraint,
  methods: List typed_ast.TypedInstanceMethod,
  tables: Tables
) -> Maybe(source.SourcePos, String) =
  match methods with
  | Nil -> Nothing
  | Cons m rest ->
      match m with
      | typed_ast.TypedInstanceMethod _ _ _ _ method_constraints body ->
          match check_body(body, InInstanceMethod(bound), list_append(inst_constraints, method_constraints), tables) with
          | Just e -> Just(e)
          | Nothing -> check_methods(bound, inst_constraints, rest, tables)

fn check_expr(e: typed_ast.TypedExpr, cover: VarCover, tables: Tables) -> Maybe(source.SourcePos, String) =
  match e with
  | typed_ast.TDict c _ pos _ -> check_constraint(c, pos, cover, tables)
  | typed_ast.TCall callee args _ _ -> check_expr_list(Cons(callee, args), cover, tables)
  | typed_ast.TIf cnd thn els _ _ -> check_expr_list([cnd, thn, els], cover, tables)
  | typed_ast.TMatch scrut branches _ _ -> check_expr_list(Cons(scrut, branch_bodies(branches)), cover, tables)
  | typed_ast.TLambda _ body _ _ -> check_expr(body, cover, tables)
  | typed_ast.TTuple items _ _ -> check_expr_list(items, cover, tables)
  | typed_ast.TBinary _ l r _ _ -> check_expr_list([l, r], cover, tables)
  | typed_ast.TUnary _ x _ _ -> check_expr(x, cover, tables)
  | typed_ast.TRange lo hi _ _ -> check_expr_list([lo, hi], cover, tables)
  | typed_ast.TDo steps _ _ -> check_expr_list(do_step_exprs(steps), cover, tables)
  | typed_ast.TRecord _ fields _ _ -> check_expr_list(record_field_exprs(fields), cover, tables)
  | typed_ast.TGetField obj _ _ _ -> check_expr(obj, cover, tables)
  | typed_ast.TRecordUpdate base fields _ _ -> check_expr_list(Cons(base, record_field_exprs(fields)), cover, tables)
  | typed_ast.TMethodRef method class_name t pos _ ->
      let Just c = method_ref_constraint(method, class_name, t, tables) else Nothing
      in check_constraint(c, pos, cover, tables)
  | _ -> Nothing

fn check_expr_list(
  es: List typed_ast.TypedExpr,
  cover: VarCover,
  tables: Tables
) -> Maybe(source.SourcePos, String) =
  match es with
  | Nil -> Nothing
  | Cons e rest ->
      match check_expr(e, cover, tables) with
      | Just x -> Just(x)
      | Nothing -> check_expr_list(rest, cover, tables)

fn branch_bodies(branches: List typed_ast.TypedMatchBranch) -> List typed_ast.TypedExpr =
  match branches with
  | Nil -> Nil
  | Cons b rest ->
      match b with
      | typed_ast.TypedMatchBranch _ body -> Cons(body, branch_bodies(rest))

fn do_step_exprs(steps: List typed_ast.TypedDoStep) -> List typed_ast.TypedExpr =
  match steps with
  | Nil -> Nil
  | Cons s rest ->
      match s with
      | typed_ast.TDoBindStep _ ex -> Cons(ex, do_step_exprs(rest))
      | typed_ast.TDoLetStep _ ex -> Cons(ex, do_step_exprs(rest))
      | typed_ast.TDoExprStep ex -> Cons(ex, do_step_exprs(rest))

fn record_field_exprs(fields: List typed_ast.TypedRecordField) -> List typed_ast.TypedExpr =
  match fields with
  | Nil -> Nil
  | Cons f rest ->
      match f with
      | typed_ast.TypedRecordField _ ex -> Cons(ex, record_field_exprs(rest))

# ---------------------------------------------------------------------------
# Type-expression helpers (ported from lowering; resolve owns its own copies)
# ---------------------------------------------------------------------------

# True if a type expression's outermost head is a concrete type constructor.
# Concrete heads start with an uppercase letter (List, Maybe, Int, Tuple2, Fn);
# type variables (a, b), wildcards (`_`), and fresh metavars do not.  Uses
# type_expr_head_name so module-qualified concrete names (stdlib.x.Bar) still
# read as concrete after their prefix is stripped.
# Concreteness is a property of the type NAME, not its module path: a canonical
# dotted head (e.g. "main.Maybe") is concrete iff its last segment starts uppercase.
fn head_is_concrete(te: ast.TypeExpr) -> Bool =
  types.type_id_is_concrete(types.type_id(type_expr_head_name(te)))

fn is_type_var_name(name: String) -> Bool =
  # A module-qualified name (dotted) is never a type variable — guard as
  # ast.is_lowercase_name does (code-review finding 2, 2026-07-10).
  if str_find(name, ".") != -1 then false
  else match str_char_at(name, 0) with
  | Nothing -> false
  | Just c ->
      c == 'a' || c == 'b' || c == 'c' || c == 'd' || c == 'e' || c == 'f' ||
      c == 'g' || c == 'h' || c == 'i' || c == 'j' || c == 'k' || c == 'l' ||
      c == 'm' || c == 'n' || c == 'o' || c == 'p' || c == 'q' || c == 'r' ||
      c == 's' || c == 't' || c == 'u' || c == 'v' || c == 'w' || c == 'x' ||
      c == 'y' || c == 'z'

fn constraint_key_from_tc(c: ast.TypeConstraint) -> String =
  match c with
  | ast.TypeConstraint class_name type_args ->
      constraint_key_str(string.substring_after_last(class_name, "."), type_args)

fn constraint_key_str(class_name: String, type_args: List ast.TypeExpr) -> String =
  match type_args with
  | Nil -> class_name
  | Cons h rest ->
      class_name ++ "_" ++ type_expr_head_name(h) ++ constraint_key_args_rest(rest)

fn constraint_key_args_rest(args: List ast.TypeExpr) -> String =
  match args with
  | Nil -> ""
  | Cons h rest -> "_" ++ type_expr_head_name(h) ++ constraint_key_args_rest(rest)

fn type_expr_head_name(te: ast.TypeExpr) -> String =
  match te with
  # Module-qualified type identity (T7): instance dispatch keys preserve the
  # canonical (dotted) name so main.Maybe and a prelude Maybe get distinct keys.
  # Must agree with infer's @inst registration and lowering's ctx_inst keys, which
  # are all raw dotted names; only the emitted __tc_ LLVM symbol is dot-sanitized.
  | ast.TypeName name -> name
  | ast.TypeApply base _ -> type_expr_head_name(base)
  | ast.TypeArrow _ _ _ _ -> "Fn"
  | ast.TypeThunk _ _ -> "Fn"
  | ast.TypeEffect _ _ -> "Eff"
  | ast.TupleType items -> types.tuple_head(list_length(items))

# The instance head and the dispatch type arrive at the SAME application depth:
# every recorder records the class variable's binding, and the head-arity check
# (infer.check_instance_head_kinds) rejects a head that would not match it. So the
# two spines pair up as they stand — this used to peel a surplus off the concrete
# side, computed per call, which was only ever right when the concrete side was
# the deeper of the two. docs/instance-head-kinds-v0.md §5.
fn unify_type_expr(
  pattern: ast.TypeExpr,
  concrete: ast.TypeExpr,
  acc: Dict ast.TypeExpr
) -> Dict ast.TypeExpr =
  match pattern with
  | ast.TypeName name ->
      if is_type_var_name(name) then dict_set(name, concrete, acc)
      else acc
  | ast.TypeApply pat_base pat_arg ->
      match concrete with
      | ast.TypeApply con_base con_arg ->
          unify_type_expr(pat_arg, con_arg, unify_type_expr(pat_base, con_base, acc))
      | _ -> acc
  | ast.TupleType pat_items ->
      match concrete with
      | ast.TupleType con_items -> unify_type_args_list(pat_items, con_items, acc)
      | _ -> acc
  | _ -> acc

fn unify_type_args_list(
  patterns: List ast.TypeExpr,
  concretes: List ast.TypeExpr,
  acc: Dict ast.TypeExpr
) -> Dict ast.TypeExpr =
  match (patterns, concretes) with
  | (Nil, _) -> acc
  | (_, Nil) -> acc
  | (Cons p rest_p, Cons c rest_c) ->
      unify_type_args_list(rest_p, rest_c, unify_type_expr(p, c, acc))

fn substitute_type_expr(te: ast.TypeExpr, subs: Dict ast.TypeExpr) -> ast.TypeExpr =
  match te with
  | ast.TypeName name ->
      match dict_get(name, subs) with
      | Just concrete -> concrete
      | Nothing -> te
  | ast.TypeApply base arg ->
      ast.TypeApply(substitute_type_expr(base, subs), substitute_type_expr(arg, subs))
  | ast.TypeArrow from_ to_ effs mode ->
      ast.TypeArrow(substitute_type_expr(from_, subs), substitute_type_expr(to_, subs), effs, mode)
  | ast.TypeThunk to_ effs ->
      ast.TypeThunk(substitute_type_expr(to_, subs), effs)
  | ast.TupleType items ->
      ast.TupleType(list_map(\item -> substitute_type_expr(item, subs), items))
  | _ -> te

fn substitute_constraint(tc: ast.TypeConstraint, subs: Dict ast.TypeExpr) -> ast.TypeConstraint =
  match tc with
  | ast.TypeConstraint class_name type_args ->
      ast.TypeConstraint(class_name, list_map(\te -> substitute_type_expr(te, subs), type_args))
