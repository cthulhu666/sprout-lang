module stdlib.compiler.resolve

import stdlib.compiler.ast as ast
import stdlib.compiler.linear_check as linear_check
import stdlib.compiler.source as source
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types
import stdlib.string as string

# ---------------------------------------------------------------------------
# Constraint resolution / discharge pass
# ---------------------------------------------------------------------------
#
# Runs in the check phase, after type inference, over the typed program (which
# includes the bundled prelude decls).  For every TDict evidence node it walks
# the required instance dictionary tree and rejects a constraint whose head is
# a *concrete* type with no instance — the diagnostic the type checker owes but
# previously skipped, letting an unsatisfiable nested dictionary (e.g.
# `to_string([()])` needing `ToString ()`) reach codegen and segfault.
#
# A constraint whose head is a type *variable* is forwarded (lowering threads it as
# a hidden parameter), mirroring lowering's own resolution order — concrete head
# uses the instance table, variable head is forwarded. One case is checked anyway:
# an instance's context at a NAMED variable (`Eq (Maybe a)` needing `Eq a`) that
# the enclosing declaration does not forward, which lowering could only fill with
# the poison thunk (#423). See VarCover.
#
# Owns its instance tables (built from the typed decls, exactly like lowering's
# collect_instance_table / collect_inst_meta).  This is the first brick of the
# north-star refactor that moves all dictionary resolution into the checker.

export type ResolveResult (..) =
  | ResolveOk typed_ast.TypedProgram
  | ResolveErr source.SourcePos String

# Instance tables: existence (constraint_key → the instance head's type args, for
# every bundled instance), context (constraint_key → (instance head type args,
# instance context constraints), for one that has a context),
# the full checker env (carries @inst: markers for instances defined in imported
# modules whose decls are NOT bundled into this program), and super_map
# (class_name → direct superclass names, for transitive-super expansion — the same
# source lowering's collect_super_map reads), and the `where linear` variables of the
# declaration being resolved (with_bounded).
type Tables = Tables(typed_ast.InstanceTable(List ast.TypeExpr))(typed_ast.InstanceTable(List ast.TypeExpr, List ast.TypeConstraint)) (Dict types.Scheme) (Dict (List String)) (Dict String) (List BoundVar)

fn tables_exists(t: Tables) -> typed_ast.InstanceTable(List ast.TypeExpr) =
  match t with | Tables e _ _ _ _ _ -> e

fn tables_ctx(t: Tables) -> typed_ast.InstanceTable(List ast.TypeExpr, List ast.TypeConstraint) =
  match t with | Tables _ c _ _ _ _ -> c

fn tables_env(t: Tables) -> Dict types.Scheme =
  match t with | Tables _ _ v _ _ _ -> v

fn tables_super(t: Tables) -> Dict (List String) =
  match t with | Tables _ _ _ s _ _ -> s

fn tables_class_params(t: Tables) -> Dict String =
  match t with | Tables _ _ _ _ p _ -> p

fn tables_bounded(t: Tables) -> List BoundVar =
  match t with | Tables _ _ _ _ _ b -> b

# A `where linear` variable of the declaration being resolved, as it is written, and
# the declaration a diagnostic names as bounding it (docs/linearity-bound-v0.md §6.7).
type BoundVar = (written: String, owner: String)

# The tables for one declaration's body: its bounded variables, each marked linear
# in the env, so linear_check.first_linear_in finds them.
fn with_bounded(bounded: List BoundVar, t: Tables) -> Tables =
  match t with
  | Tables e c v s p b ->
      Tables(e, c, list_fold(\ (acc, bv) -> dict_set(types.linear_marker_key(bv.written), types.presence_marker, acc), v, bounded),
             s, p, list_append(bounded, b))

# The constraints a declaration forwards as hidden dictionaries, grouped by class and
# head constructor (constraint_key_str): each slot's key (typed_ast.dict_slot_key, one slot
# per whole constraint) with the arguments it was written with, aliases expanded.
# Two slots can share a group (`Ord (Maybe a)` brings `Eq (Maybe a)` beside a written
# `Eq (Maybe b)`); see forwarded_slot.
type alias Forwarded = typed_ast.InstanceTable(List(typed_ast.SlotKey, List ast.TypeExpr))

# What an instance context's type-variable constraint is checked against. In a
# declaration body it must be one the declaration forwards (CoverFrom its table),
# and the remedy depends on the declaration (DeclKind). Inside a dictionary the
# declaration itself forwards, nothing is checked: the caller built that dictionary
# whole, context included (CoverByCaller).
type VarCover =
  | CoverFrom DeclKind Forwarded
  | CoverByCaller

# An instance method carries the variables its instance head binds: only a context
# constraint on those is filled by a caller, so only those count as forwarded, and
# they decide which remedy the message names.
type DeclKind =
  | InFn
  | InInstanceMethod (List String)

# The slot the declaration forwards for THIS constraint, not just one sharing its class
# and head. A written variable or a concrete type that differs from what the `where`
# wrote is a different constraint; `where Eq (Maybe a)` used to serve `Maybe b` and
# `Maybe Int` with `a`'s dictionary. An unnamed use-site position (`_`, an inference
# variable) is not evidence of a difference, so it takes the one slot it fits, and none
# when it fits two.
fn forwarded_slot(class_name: String, type_args: List ast.TypeExpr, fwd: Forwarded) -> Maybe typed_ast.SlotKey =
  let Just slots = typed_ast.instance_get(typed_ast.constraint_key_str(class_name, type_args), fwd) else Nothing
      exact = typed_ast.dict_slot_key(class_name, type_args)
  in
    if any(\s -> slot_key(s) == exact, slots) then Just(exact)
    else
      match list_filter(\s -> args_conflict(type_args, slot_args(s)) == false, slots) with
      | [(key, _)] -> Just(key)
      | _ -> Nothing

fn slot_key(s: (typed_ast.SlotKey, List ast.TypeExpr)) -> typed_ast.SlotKey =
  let (key, _) = s
  in key

fn slot_args(s: (typed_ast.SlotKey, List ast.TypeExpr)) -> List ast.TypeExpr =
  let (_, written) = s
  in written

fn forwards(class_name: String, type_args: List ast.TypeExpr, fwd: Forwarded) -> Bool =
  forwarded_slot(class_name, type_args, fwd) != Nothing

fn args_conflict(uses: List ast.TypeExpr, written: List ast.TypeExpr) -> Bool =
  match (uses, written) with
  | ([], []) -> false
  | ([u | us], [w | ws]) -> te_conflicts(u, w) || args_conflict(us, ws)
  | (_, _) -> true

fn te_conflicts(use: ast.TypeExpr, written: ast.TypeExpr) -> Bool =
  match (use, written) with
  # Compared without module prefixes: a `where` clause and an inferred type may
  # spell one type `Box` and `main.Box`, and a false conflict here is a rejection.
  | (ast.TypeName u, ast.TypeName w) ->
      string.after_last_dot(u) != string.after_last_dot(w) && typed_ast.is_unnamed(u) == false
  | (ast.TypeName u, _) -> typed_ast.is_unnamed(u) == false
  | (ast.TypeApply ub ua, ast.TypeApply wb wa) -> te_conflicts(ub, wb) || te_conflicts(ua, wa)
  | (ast.TupleType us, ast.TupleType ws) -> args_conflict(us, ws)
  # Any other pair, arrows included: the key-level answer, by head constructor. It is
  # what forwarding meant before arguments were compared, so it stays right for any shape.
  | (_, _) -> typed_ast.type_expr_head_name(use) != typed_ast.type_expr_head_name(written)

# A `where` argument with its type aliases expanded, as the use-site types it is
# compared with already are. Aliases reach resolve as the checker's `@aliasty:`
# markers: a parameterized one under `@aliasfn:<name>:<arity>`, its parameters the
# variables `__aliasparam__<name>:<i>` (infer.register_alias). Aliases are acyclic
# (infer rejects a cycle), so the expansion ends.
fn expand_aliases(te: ast.TypeExpr, env: Dict types.Scheme) -> ast.TypeExpr =
  match te_spine(te, []) with
  | Just (name, args) -> expand_spine(name, list_map(\a -> expand_aliases(a, env), args), env)
  | Nothing -> expand_parts(te, env)

fn expand_parts(te: ast.TypeExpr, env: Dict types.Scheme) -> ast.TypeExpr =
  match te with
  | ast.TupleType items -> ast.TupleType(list_map(\i -> expand_aliases(i, env), items))
  | ast.TypeArrow p r eff mode -> ast.TypeArrow(expand_aliases(p, env), expand_aliases(r, env), eff, mode)
  | ast.TypeThunk r eff -> ast.TypeThunk(expand_aliases(r, env), eff)
  | ast.TypeEffect inner labels -> ast.TypeEffect(expand_aliases(inner, env), labels)
  | ast.TypeName _ -> te
  | ast.TypeApply _ _ -> te

# `F a b` as its head name and arguments; Nothing when the head is not a plain name.
fn te_spine(te: ast.TypeExpr, args: List ast.TypeExpr) -> Maybe (String, List ast.TypeExpr) =
  match te with
  | ast.TypeName name -> Just((name, args))
  | ast.TypeApply base arg -> te_spine(base, Cons(arg, args))
  | _ -> Nothing

fn expand_spine(name: String, args: List ast.TypeExpr, env: Dict types.Scheme) -> ast.TypeExpr =
  match alias_body(name, list_length(args), env) with
  | Just (body, applied) -> expand_aliases(apply_te_args(fill_alias_params(body, args), te_drop(args, applied)), env)
  | Nothing -> apply_te_args(ast.TypeName(name), args)

# The body and how many arguments it takes: a parameterized alias of this arity, else a
# plain one applied to the arguments (`type alias E = Result String`, then `E Int`).
fn alias_body(name: String, arity: Int, env: Dict types.Scheme) -> Maybe(ast.TypeExpr, Int) =
  match alias_marker(types.alias_fn_prefix ++ name ++ ":" ++ int_to_string(arity), env) with
  | Just body -> Just((body, arity))
  | Nothing -> plain_alias(name, env)

fn plain_alias(name: String, env: Dict types.Scheme) -> Maybe(ast.TypeExpr, Int) =
  match alias_marker(name, env) with
  | Just body -> Just((body, 0))
  | Nothing -> Nothing

# The env path keys an imported alias by its short name; try both spellings.
fn alias_marker(key: String, env: Dict types.Scheme) -> Maybe ast.TypeExpr =
  match dict_get(types.alias_marker_prefix ++ key, env) with
  | Just sch -> Just(typed_ast.type_to_type_expr(types.scheme_type(sch)))
  | Nothing ->
      match dict_get(types.alias_marker_prefix ++ string.after_last_dot(key), env) with
      | Just sch -> Just(typed_ast.type_to_type_expr(types.scheme_type(sch)))
      | Nothing -> Nothing

fn fill_alias_params(te: ast.TypeExpr, args: List ast.TypeExpr) -> ast.TypeExpr =
  match te with
  | ast.TypeName n -> alias_param_arg(n, args)
  | ast.TypeApply base arg -> ast.TypeApply(fill_alias_params(base, args), fill_alias_params(arg, args))
  | ast.TupleType items -> ast.TupleType(list_map(\i -> fill_alias_params(i, args), items))
  | ast.TypeArrow p r eff mode -> ast.TypeArrow(fill_alias_params(p, args), fill_alias_params(r, args), eff, mode)
  | ast.TypeThunk r eff -> ast.TypeThunk(fill_alias_params(r, args), eff)
  | ast.TypeEffect inner labels -> ast.TypeEffect(fill_alias_params(inner, args), labels)

# `__aliasparam__<name>:<i>` stands for argument i.
fn alias_param_arg(n: String, args: List ast.TypeExpr) -> ast.TypeExpr =
  if str_starts_with(n, types.alias_param_prefix) == false then ast.TypeName(n)
  else
    match parse_int(string.substring_after_last(n, ":")) with
    | Just i -> te_nth_or(args, i, ast.TypeName(n))
    | Nothing -> ast.TypeName(n)

fn te_nth_or(xs: List ast.TypeExpr, i: Int, dflt: ast.TypeExpr) -> ast.TypeExpr =
  match xs with
  | [] -> dflt
  | [x | rest] -> if i == 0 then x else te_nth_or(rest, i - 1, dflt)

fn apply_te_args(base: ast.TypeExpr, args: List ast.TypeExpr) -> ast.TypeExpr =
  match args with
  | [] -> base
  | [a | rest] -> apply_te_args(ast.TypeApply(base, a), rest)

fn te_drop(xs: List ast.TypeExpr, n: Int) -> List ast.TypeExpr =
  if n <= 0 then xs
  else
    match xs with
    | [] -> []
    | [_ | rest] -> te_drop(rest, n - 1)

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

export fn resolve_program(prog: typed_ast.TypedProgram, env: Dict types.Scheme) -> ResolveResult =
  match prog with
  | typed_ast.TypedProgram decls -> resolve_with_tables(decls, build_tables(decls, env))

# A question's dictionaries, resolved as a top-level `let` body's are: the program's
# instances, and no `where` clause to forward from.
export fn resolve_question(prog: typed_ast.TypedProgram, env: Dict types.Scheme,
                           question: typed_ast.TypedExpr) -> Result(source.SourcePos, String) typed_ast.TypedExpr =
  match prog with
  | typed_ast.TypedProgram decls ->
      resolve_expr(question, InFn, typed_ast.instance_table_empty(), build_tables(decls, env))

# One walk over the typed decls: each TDict is checked (the diagnostic the type
# checker owes for an unsatisfiable concrete-head constraint), then its Evidence
# field is filled with the resolved instance/forward tree, which lowering consumes
# (evidence_to_witness). The first error in declaration order is the one reported.
fn resolve_with_tables(decls: List typed_ast.TypedDecl, tables: Tables) -> ResolveResult =
  match resolve_all(resolve_decl(_, tables), decls) with
  | Err (pos, msg) -> ResolveErr(pos, msg)
  | Ok resolved -> ResolveOk(typed_ast.TypedProgram(resolved))

# ---------------------------------------------------------------------------
# Table construction (from typed decls — prelude is bundled in)
# ---------------------------------------------------------------------------

fn build_tables(decls: List typed_ast.TypedDecl, env: Dict types.Scheme) -> Tables =
  collect_tables(decls, Tables(typed_ast.instance_table_empty(), typed_ast.instance_table_empty(), env, classes.supers, classes.params, Nil))
  where classes = typed_ast.class_tables(decls)

fn collect_tables(decls: List typed_ast.TypedDecl, acc: Tables) -> Tables =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | typed_ast.TInstanceDecl constraint inst_constraints _ ->
          collect_tables(rest, add_instance(constraint, inst_constraints, acc))
      | _ -> collect_tables(rest, acc)

fn add_instance(
  constraint: ast.TypeConstraint,
  inst_constraints: List ast.TypeConstraint,
  acc: Tables
) -> Tables =
  let ast.TypeConstraint _ type_args = constraint
      key = typed_ast.constraint_key_from_tc(constraint)
  in Tables(typed_ast.instance_set(key, type_args, tables_exists(acc)), add_ctx(key, type_args, inst_constraints, tables_ctx(acc)),
            tables_env(acc), tables_super(acc), tables_class_params(acc), tables_bounded(acc))

fn add_ctx(
  key: typed_ast.InstanceKey,
  type_args: List ast.TypeExpr,
  inst_constraints: List ast.TypeConstraint,
  acc: typed_ast.InstanceTable (List ast.TypeExpr, List ast.TypeConstraint)
) -> typed_ast.InstanceTable(List ast.TypeExpr, List ast.TypeConstraint) =
  match inst_constraints with
  | Nil -> acc
  | _ -> typed_ast.instance_set(key, (type_args, inst_constraints), acc)

# ---------------------------------------------------------------------------
# Constraint discharge
# ---------------------------------------------------------------------------

# Returns the first unsatisfiable-constraint error, or Nothing.
fn check_constraint(
  c: ast.TypeConstraint,
  pos: source.SourcePos,
  cover: VarCover,
  tables: Tables
) -> Maybe(source.SourcePos, String) =
  let ast.TypeConstraint class_name type_args = c
      [head_arg | _] = type_args else Nothing
      class_bare = string.after_last_dot(class_name)
  in
    # Only diagnose constraints whose head is a concrete type constructor
    # (uppercase head). A lowercase/`_`/non-letter head is a type variable —
    # forwarded/polymorphic, resolved as a hidden parameter by lowering.
    if declares(class_name, type_args, cover) then Nothing
    else if head_is_concrete(head_arg) == false then Nothing
    else
      let key = typed_ast.constraint_key_str(class_name, type_args)
      in if instance_exists(class_name, key, head_arg, tables)
         then check_context(key, class_name, head_arg, type_args, pos, cover, tables)
         else Just((pos, "No instance of " ++ class_bare ++ " for " ++ typed_ast.type_expr_head_name(head_arg)))

# docs/linearity-bound-v0.md §6.7: a dictionary built from a generic instance
# instantiates the instance head's variables, which no scheme shows. One the
# instance does not bound must hold no linear value, and the enclosing
# declaration's own `where linear` variables count as linear. The tree is walked
# as produce_evidence builds it: each superclass, and each instance's context.
fn dictionary_linearity_error(c: ast.TypeConstraint, pos: source.SourcePos, fwd_keys: Forwarded,
                              tables: Tables) -> Maybe(source.SourcePos, String) =
  let ast.TypeConstraint class_name type_args = c
      [head_arg | _] = type_args else Nothing
  in if head_is_concrete(head_arg) && may_hold_linear(tables) then
       find_map(class_linearity_error(_, head_arg, type_args, pos, fwd_keys, tables),
                types.class_with_transitive_supers(class_name, tables_super(tables)))
     else Nothing

# Without a linear type in the program or a bounded variable in scope, no type is linear.
fn may_hold_linear(tables: Tables) -> Bool =
  linear_check.program_has_linear(tables_env(tables)) || list_length(tables_bounded(tables)) > 0

# A forwarded dictionary needs nothing: its caller instantiated the forwarding
# declaration's variable, and that use was checked.
fn class_linearity_error(cls: String, head_arg: ast.TypeExpr, type_args: List ast.TypeExpr,
                         pos: source.SourcePos, fwd_keys: Forwarded,
                         tables: Tables) -> Maybe(source.SourcePos, String) =
  let Nothing = forwarded_slot(cls, type_args, fwd_keys) else Just _ -> Nothing
      key = typed_ast.constraint_key_str(cls, type_args)
      Just patterns = typed_ast.instance_get(key, tables_exists(tables)) else Nothing
      subs = unify_type_args_list(patterns, type_args, dict_empty())
      bounds = instance_bounds(cls, head_arg, tables)
      unbounded = list_filter(\v -> ! list_member (v, bounds), list_reverse(te_vars_list(patterns, [])))
  in match find_map(head_var_fault(cls, patterns, subs, pos, tables, _), unbounded) with
     | Just err -> Just(err)
     | Nothing -> context_linearity_error(key, subs, pos, fwd_keys, tables)

fn context_linearity_error(key: typed_ast.InstanceKey, subs: Dict ast.TypeExpr, pos: source.SourcePos,
                           fwd_keys: Forwarded, tables: Tables) -> Maybe(source.SourcePos, String) =
  let Just(_, inst_constraints) = typed_ast.instance_get(key, tables_ctx(tables)) else Nothing
  in find_map(\ic -> dictionary_linearity_error(substitute_constraint(ic, subs), pos, fwd_keys, tables),
              inst_constraints)

fn instance_bounds(cls: String, head_arg: ast.TypeExpr, tables: Tables) -> List String =
  match dict_get(types.inst_bound_key(cls, typed_ast.type_expr_head_name(head_arg)), tables_env(tables)) with
  | Just marker -> types.scheme_vars(marker)
  | Nothing -> Nil

fn head_var_fault(cls: String, patterns: List ast.TypeExpr, subs: Dict ast.TypeExpr, pos: source.SourcePos,
                  tables: Tables, v: String) -> Maybe(source.SourcePos, String) =
  let Just arg = dict_get(v, subs) else Nothing
      t = te_type(arg)
      Just lin = linear_check.first_linear_in(t, tables_env(tables)) else Nothing
  in Just((pos, "the `" ++ string.after_last_dot(cls) ++ "` instance for `" ++ typed_ast.te_display(head_pattern(patterns))
                  ++ "` takes `" ++ v ++ "` as a value it may copy or drop, and " ++ linear_reason(t, lin, tables)
                  ++ "; if the instance uses its `" ++ v ++ "` exactly once, add `where linear " ++ v
                  ++ "` to its head"))

fn head_pattern(patterns: List ast.TypeExpr) -> ast.TypeExpr =
  match patterns with
  | [p | _] -> p
  | [] -> ast.TypeName("_")

# Why `t` is linear, worded as infer.linear_reason words it at a call. A value a
# pattern unpacked is named by its constructor and `exists` variable.
fn linear_reason(t: types.Type, lin: types.Type, tables: Tables) -> String =
  let v = type_display(lin)
  in match find(\bv -> types.type_var_name(lin) == Just(bv.written), tables_bounded(tables)) with
     | Just bv -> bounded_reason(bv.owner, v)
     | Nothing ->
         match and_then(types.unpacked_of, and_then(\id -> dict_get(types.unpacked_key(id), tables_env(tables)),
                                                    types.type_var_name(lin))) with
         | Just (owner, written) -> bounded_reason(owner, written)
         | Nothing ->
             if t == lin then "`" ++ v ++ "` is linear"
             else "`" ++ type_display(t) ++ "` holds the linear `" ++ v ++ "`"

fn bounded_reason(owner: String, v: String) -> String =
  "`" ++ owner ++ "`'s `" ++ v ++ "` is linear under its `where linear " ++ v ++ "`"

fn type_display(t: types.Type) -> String = typed_ast.te_display(typed_ast.type_to_type_expr(t))

let holds_nothing: types.Type = types.TVar(types.tyvar_id("_"))

# A dispatch type as the linear check reads it. A function, thunk or effect type
# holds no value, as first_linear_in decides for TFunc and TThunk, so it becomes
# `_`, which no bound marks.
fn te_type(te: ast.TypeExpr) -> types.Type =
  match te with
  | ast.TypeName n -> if head_is_concrete(te) then types.TConst(types.type_id(n)) else types.TVar(types.tyvar_id(n))
  | ast.TypeApply base arg -> types.TApp(te_type(base), te_type(arg))
  | ast.TupleType items -> types.TTuple(list_map(te_type, items))
  | ast.TypeArrow _ _ _ _ -> holds_nothing
  | ast.TypeThunk _ _ -> holds_nothing
  | ast.TypeEffect _ _ -> holds_nothing

# A dictionary the declaration forwards arrives whole, context included, so no instance
# has to exist for it and its context is not this body's to supply. Decided as
# produce_one_class decides EvForward.
fn declares(class_name: String, type_args: List ast.TypeExpr, cover: VarCover) -> Bool =
  match cover with
  | CoverByCaller -> false
  | CoverFrom _ fwd_keys -> forwards(class_name, type_args, fwd_keys)

# An instance exists if a bundled decl provides it OR the checker env carries an
# @inst: marker for it (instances from imported modules whose decls are not
# bundled into this program register markers in the env but no TInstanceDecl).
fn instance_exists(
  class_name: String,
  key: typed_ast.InstanceKey,
  head_arg: ast.TypeExpr,
  tables: Tables
) -> Bool =
  typed_ast.instance_member(key, tables_exists(tables))
  || dict_member(types.inst_marker_key(class_name, typed_ast.type_expr_head_name(head_arg)), tables_env(tables))

# Recurse into a matched instance's context constraints (substituted at the
# concrete type args).  A context-free instance has no entry → Nothing.
fn check_context(
  key: typed_ast.InstanceKey,
  class_name: String,
  head_arg: ast.TypeExpr,
  type_args: List ast.TypeExpr,
  pos: source.SourcePos,
  cover: VarCover,
  tables: Tables
) -> Maybe(source.SourcePos, String) =
  match typed_ast.instance_get(key, tables_ctx(tables)) with
  | Nothing -> Nothing
  | Just (inst_type_args, inst_constraints) ->
      match spine_depth_mismatch(key, inst_type_args, type_args) with
      | Just msg -> Just((pos, msg))
      | Nothing ->
          check_context_subs(class_name, head_arg, inst_constraints,
            unify_type_args_list(inst_type_args, type_args, dict_empty()), pos, cover, tables)

# The recorder invariant, reported where there is a position to report it with: the
# instance head and the dispatch type must arrive at the same application depth,
# since unify_type_expr pairs the spines as they stand. A mismatch means some
# recorder recorded the wrong depth, and binding a context variable to whatever
# lines up is how that used to become a wrong witness instead of a diagnostic.
#
# Only this one of the three unify_type_args_list callers can report: the other two
# return an Evidence and a Maybe list, with no position between them.
fn spine_depth_mismatch(key: typed_ast.InstanceKey, patterns: List ast.TypeExpr,
                        concretes: List ast.TypeExpr) -> Maybe String =
  match (patterns, concretes) with
  | ([p | rest_p], [c | rest_c]) ->
      if te_app_depth(p) == te_app_depth(c)
      then spine_depth_mismatch(key, rest_p, rest_c)
      else Just("internal: instance " ++ typed_ast.instance_key_text(key) ++ " is written at depth "
                  ++ int_to_string(te_app_depth(p)) ++ " but dispatches on a type at depth "
                  ++ int_to_string(te_app_depth(c)))
  | (_, _) -> Nothing

fn te_app_depth(te: ast.TypeExpr) -> Int =
  match te with
  | ast.TypeApply base _ -> 1 + te_app_depth(base)
  | _ -> 0

# A context variable the head match leaves unbound used to be rejected here, on the
# reasoning that the head and the dispatch type must then disagree about the class
# variable's arity. They need not: `instance Foo Bar where Baz k` binds no `k` and
# has no arity story at all. The arity disagreement is now caught at the
# declaration (infer.check_instance_head_kinds), so an unbound variable reaching
# here is exempt — see check_context_constraint.
fn check_context_subs(
  outer_class: String,
  outer_head: ast.TypeExpr,
  inst_constraints: List ast.TypeConstraint,
  subs: Dict ast.TypeExpr,
  pos: source.SourcePos,
  cover: VarCover,
  tables: Tables
) -> Maybe(source.SourcePos, String) =
  match inst_constraints with
  | Nil -> Nothing
  | Cons ic rest ->
      match check_context_constraint(outer_class, outer_head, ic, subs, pos, cover, tables) with
      | Just e -> Just(e)
      | Nothing -> check_context_subs(outer_class, outer_head, rest, subs, pos, cover, tables)

# One context constraint at the dispatch type. A concrete head is checked like any
# constraint. A variable head is a variable of the enclosing declaration, and must
# be one it forwards — unless the instance head never bound it (`instance Foo Bar
# where Baz k`): no caller can name that slot, and it stays unfilled
# (tests/conformance/run/instance_context_var_absent_from_head.spr).
fn check_context_constraint(
  outer_class: String,
  outer_head: ast.TypeExpr,
  ic: ast.TypeConstraint,
  subs: Dict ast.TypeExpr,
  pos: source.SourcePos,
  cover: VarCover,
  tables: Tables
) -> Maybe(source.SourcePos, String) =
  let ast.TypeConstraint class_name type_args = substitute_constraint(ic, subs)
      [head_arg | _] = type_args else Nothing
  in
    if head_is_concrete(head_arg) then check_constraint(ast.TypeConstraint(class_name, type_args), pos, cover, tables)
    else if context_head_bound(ic, subs) then
      unsupplied_context_var(outer_class, outer_head, class_name, type_args, pos, cover)
    else Nothing

fn context_head_bound(ic: ast.TypeConstraint, subs: Dict ast.TypeExpr) -> Bool =
  let ast.TypeConstraint _ type_args = ic
      [ast.TypeName v | _] = type_args else false
  in dict_member(v, subs)

# Only a variable the declaration's signature names is checked: one the program
# wrote, or an unannotated parameter's placeholder (`_unann@<fn>/<param>`, named by
# infer.seed_unann_names). `_` is a free variable no signature named, whose
# dictionary is never invoked (`to_string(Empty)`), and `$ex_` heads are existential
# givens, forwarded per match arm rather than per declaration.
fn unsupplied_context_var(
  outer_class: String,
  outer_head: ast.TypeExpr,
  class_name: String,
  type_args: List ast.TypeExpr,
  pos: source.SourcePos,
  cover: VarCover
) -> Maybe(source.SourcePos, String) =
  let CoverFrom kind fwd_keys = cover else Nothing
      [head_arg | _] = type_args else Nothing
      class_bare = string.after_last_dot(class_name)
  in
    if is_checked_var(typed_ast.type_expr_head_name(head_arg)) == false then Nothing
    else if forwards(class_name, type_args, fwd_keys) then Nothing
    else Just((pos, "the `" ++ string.after_last_dot(outer_class) ++ "` instance for `"
                      ++ typed_ast.te_display(outer_head) ++ "` "
                      ++ unsupplied_remedy(kind, class_bare, head_arg)))

fn is_checked_var(name: String) -> Bool =
  source.is_lowercase_name(name) || types.is_unann_placeholder(name)

# What the message asks for depends on what can supply the dictionary. An
# unannotated slot has no variable to constrain until it is annotated; a `where` on
# an applied variable (`Eq (f a)`) is not supported; an instance method takes its
# context from the instance head, under the head's own variable names.
fn unsupplied_remedy(kind: DeclKind, cls: String, arg: ast.TypeExpr) -> String =
  if types.is_unann_placeholder(typed_ast.type_expr_head_name(arg)) then unann_remedy(cls, typed_ast.type_expr_head_name(arg))
  else
    "needs `" ++ cls ++ " " ++ typed_ast.te_display_atom(arg) ++ "`, which nothing in scope supplies — "
      ++ supply_hint(kind, cls, arg)

# An instance head's context reaches only the variables the head binds; for any other
# the method's own `where` is the place, and the class must declare it too. A method
# that renamed a head variable (`Box t` for the head's `Box a`) also lands here.
fn supply_hint(kind: DeclKind, cls: String, arg: ast.TypeExpr) -> String =
  match (arg, kind) with
  | (ast.TypeApply _ _, _) ->
      "a `where` constraint on an applied type variable is not supported; use a concrete type"
  | (_, InInstanceMethod bound) ->
      if list_member(typed_ast.type_expr_head_name(arg), bound) then "add it to the instance head's `where`"
      else
        "constrain `" ++ typed_ast.te_display(arg) ++ "` with a method-level `where` (the class declaration "
          ++ "must declare it too) — or, if it is the instance head's variable, spell it as the head does"
  | (_, InFn) -> "add `where " ++ cls ++ " " ++ typed_ast.te_display_atom(arg) ++ "`"

# A slot's own type takes a type variable; a variable INSIDE its type
# (types.is_unann_inner) cannot — `b: t` where `b: Box p` was inferred forces `t` to
# `Box p` — so the remedy is to write the type out, naming the variable.
fn unann_remedy(cls: String, placeholder: String) -> String =
  if types.is_unann_inner(placeholder) then
    "needs `" ++ cls ++ "` on a type variable inside " ++ unann_owner(unann_param(placeholder))
      ++ ", which has no annotation — write that type out, naming the variable, and add a `where "
      ++ cls ++ "` constraint on it"
  else
    "needs `" ++ cls ++ "` on " ++ unann_subject(unann_param(placeholder))
      ++ ", which has no annotation — annotate it with a type variable and add a `where "
      ++ cls ++ "` constraint on that variable"

fn unann_subject(param: Maybe String) -> String =
  match param with
  | Just p -> "the type of parameter `" ++ p ++ "`"
  | Nothing -> "the return type"

fn unann_owner(param: Maybe String) -> String =
  match param with
  | Just p -> "parameter `" ++ p ++ "`'s type"
  | Nothing -> "the return type"

# `_unann@f/x` is parameter `x` of `f`, `_unann@f` f's return type (Nothing). An
# instance method's owner is `#inst/<method>`, whose own `/` is not a parameter's.
fn unann_param(placeholder: String) -> Maybe String =
  let slot = unann_slot(string.drop(without_inner_suffix(placeholder), string.length(types.unann_prefix)))
  in if str_find(slot, "/") == -1 then Nothing else Just(string.substring_after_last(slot, "/"))

fn without_inner_suffix(placeholder: String) -> String =
  if types.is_unann_inner(placeholder)
  then string.take(placeholder, string.length(placeholder) - string.length(types.unann_inner_suffix))
  else placeholder

fn unann_slot(owner_and_param: String) -> String =
  if str_starts_with(owner_and_param, types.inst_owner_prefix)
  then string.drop(owner_and_param, string.length(types.inst_owner_prefix))
  else owner_and_param

# ---------------------------------------------------------------------------
# Evidence production
# ---------------------------------------------------------------------------
#
# Resolve one constraint into the Evidence tree lowering will consume.  A single
# TDict lowers to one witness block per *effective class* — the constraint's class
# followed by its transitive superclasses — so produce_evidence expands supers via
# types.class_with_transitive_supers (one source of order + dedup, shared with
# lowering's unresolved path), and wraps the per-class blocks in EvClasses.  Each
# block is decided in this order:
#   * key in fwd_keys           → EvForward key   (the enclosing function forwards
#                                  this exact constraint as a hidden param — checked
#                                  FIRST, so it applies even to a CONCRETE head that
#                                  also has an instance, e.g. `where Summable (Vec Int)`)
#   * type-variable head        → EvForward key   (forwarded, or a phantom fresh tyvar
#                                  that lowering null-fills on the ctx_fwd miss)
#   * concrete head, bundled    → EvInstance key children  (children = one Evidence
#                                  per substituted instance context constraint)
#   * concrete head, env-marker → EvUnresolved    (imported instance not bundled;
#                                  lowering emits __unresolved_ sentinels)
#   * concrete head, no instance→ EvMissing       (unreachable once check passes)
#
# fwd_keys is the set of constraint_keys the enclosing function forwards (its
# where-clause constraints, super-expanded) — built exactly as lowering's
# build_hidden_for_constraints keys ctx_fwd, so the two agree.
fn produce_evidence(c: ast.TypeConstraint, fwd_keys: Forwarded, tables: Tables) -> typed_ast.Evidence =
  match c with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> typed_ast.EvUnresolved
      | [head_arg | _] ->
          typed_ast.EvClasses(
            list_map(
              \eff_class -> produce_one_class(eff_class, head_arg, type_args, fwd_keys, tables),
              types.class_with_transitive_supers(class_name, tables_super(tables))))

# One effective-class block. A forward is keyed by typed_ast.dict_slot_key, as lowering keys
# its slots; an instance by constraint_key_str, the head alone.
fn produce_one_class(
  eff_class: String,
  head_arg: ast.TypeExpr,
  type_args: List ast.TypeExpr,
  fwd_keys: Forwarded,
  tables: Tables
) -> typed_ast.Evidence =
  match forwarded_slot(eff_class, type_args, fwd_keys) with
     | Just slot -> typed_ast.EvForward(eff_class, slot)
     | Nothing ->
         if head_is_concrete(head_arg) == false then
           typed_ast.EvForward(eff_class, typed_ast.dict_slot_key(eff_class, type_args))
         else
           produce_concrete_evidence(eff_class, type_args, head_arg, fwd_keys, tables)

fn produce_concrete_evidence(
  eff_class: String,
  type_args: List ast.TypeExpr,
  head_arg: ast.TypeExpr,
  fwd_keys: Forwarded,
  tables: Tables
) -> typed_ast.Evidence =
  let key = typed_ast.constraint_key_str(eff_class, type_args)
  in
    if typed_ast.instance_member(key, tables_exists(tables)) then produce_instance_evidence(eff_class, key, type_args, fwd_keys, tables)
    else if dict_member(types.inst_marker_key(eff_class, typed_ast.type_expr_head_name(head_arg)), tables_env(tables)) then
      typed_ast.EvUnresolved
    else
      typed_ast.EvMissing(ast.TypeConstraint(eff_class, type_args))

# Bundled instance: an unconstrained instance has no context entry → no children;
# a constrained instance recurses on each context constraint substituted at the
# concrete head's type args, in declaration order (matching lowering's inner_dicts).
# Each child is itself an EvClasses (the context constraint is super-expanded too).
# The inner dicts share the enclosing function's fwd_keys, so a forwarded inner
# constraint reads the same ctx_fwd slot in lowering.
fn produce_instance_evidence(
  eff_class: String,
  key: typed_ast.InstanceKey,
  type_args: List ast.TypeExpr,
  fwd_keys: Forwarded,
  tables: Tables
) -> typed_ast.Evidence =
  match typed_ast.instance_get(key, tables_ctx(tables)) with
  | Nothing -> typed_ast.EvInstance(eff_class, key, Nil)
  | Just (inst_type_args, inst_constraints) ->
      typed_ast.EvInstance(eff_class, key,
        list_map(
          \ic -> produce_evidence(substitute_constraint(ic, unify_type_args_list(inst_type_args, type_args, dict_empty())), fwd_keys, tables),
          inst_constraints))

# The forwarded slots of a function/method body: one per (constraint, super) in its
# where-clause, keyed by the WRITTEN arguments exactly as lowering's
# build_hidden_for_constraints keys ctx_fwd (typed_ast.dict_slot_key), and holding them with
# aliases expanded, as use sites are compared (expand_aliases).
fn build_fwd_keys(constraints: List ast.TypeConstraint, tables: Tables) -> Forwarded =
  add_fwd_keys(constraints, tables, typed_ast.instance_table_empty())

fn add_fwd_keys(constraints: List ast.TypeConstraint, tables: Tables, acc: Forwarded) -> Forwarded =
  match constraints with
  | Nil -> acc
  | Cons c rest ->
      match c with
      | ast.TypeConstraint class_name type_args ->
          add_fwd_keys(rest, tables,
            add_eff_keys(types.class_with_transitive_supers(class_name, tables_super(tables)), type_args,
                         list_map(\a -> expand_aliases(a, tables_env(tables)), type_args), acc))

fn add_eff_keys(effs: List String, type_args: List ast.TypeExpr, expanded: List ast.TypeExpr,
                acc: Forwarded) -> Forwarded =
  match effs with
  | Nil -> acc
  | Cons eff rest ->
      add_eff_keys(rest, type_args, expanded,
        add_slot(eff, type_args, expanded, acc))

# A slot already recorded (one constraint reached twice, as a superclass and directly)
# is not recorded again.
fn add_slot(class_name: String, type_args: List ast.TypeExpr, expanded: List ast.TypeExpr,
            acc: Forwarded) -> Forwarded =
  let group = typed_ast.constraint_key_str(class_name, type_args)
      slot = typed_ast.dict_slot_key(class_name, type_args)
      Just slots = typed_ast.instance_get(group, acc) else typed_ast.instance_set(group, [(slot, expanded)], acc)
  in
    if any(\s -> slot_key(s) == slot, slots) then acc
    else typed_ast.instance_set(group, list_append(slots, [(slot, expanded)]), acc)

# The type variables an instance head binds (`a` in `instance Eq (Maybe a)`).
fn head_vars(constraint: ast.TypeConstraint) -> List String =
  match constraint with
  | ast.TypeConstraint _ type_args -> te_vars_list(type_args, [])

fn te_vars_list(tes: List ast.TypeExpr, acc: List String) -> List String =
  match tes with
  | [] -> acc
  | [te | rest] -> te_vars_list(rest, te_vars(te, acc))

fn te_vars(te: ast.TypeExpr, acc: List String) -> List String =
  match te with
  | ast.TypeName n -> if source.is_lowercase_name(n) then Cons(n, acc) else acc
  | ast.TypeApply base arg -> te_vars(arg, te_vars(base, acc))
  | ast.TupleType items -> te_vars_list(items, acc)
  | ast.TypeArrow p r _ _ -> te_vars(r, te_vars(p, acc))
  | ast.TypeThunk r _ -> te_vars(r, acc)
  | ast.TypeEffect inner _ -> te_vars(inner, acc)

# An instance context constraint on a variable the head does not bind (`instance Mk Box
# where Eq b`) is accepted, but no caller can fill its slot, so it supplies nothing.
fn head_bound(inst_constraints: List ast.TypeConstraint, bound: List String) -> List ast.TypeConstraint =
  list_filter(\c -> head_binds_all(c, bound), inst_constraints)

fn head_binds_all(c: ast.TypeConstraint, bound: List String) -> Bool =
  all(\v -> list_member(v, bound), te_vars_list(constraint_args(c), []))

fn constraint_args(c: ast.TypeConstraint) -> List ast.TypeExpr =
  match c with
  | ast.TypeConstraint _ type_args -> type_args

# Transitive-superclass DFS order now comes from the single shared source
# types.class_with_transitive_supers (the same one ast_to_ir's existential
# witness-slot count and lowering's unpack use), so resolve's PACK order and that
# UNPACK order cannot drift apart — a divergence would mismap packed witnesses to
# the wrong methods. See docs/gadts-v0.md §5b.

# Value-position class method, given the constraint method_ref_constraint derived
# from its type: produce_one_class for that single class. A method reference with
# no derivable head keeps EvUnresolved (lowering falls back to its own eta
# reconstruction).
fn method_ref_evidence(c: ast.TypeConstraint, fwd_keys: Forwarded, tables: Tables) -> typed_ast.Evidence =
  let ast.TypeConstraint class_name args = c
      [head_arg] = args else typed_ast.EvUnresolved
  in produce_one_class(class_name, head_arg, args, fwd_keys, tables)

# The constraint a value-position method needs, its type named as the enclosing
# declaration wrote it; Nothing when the head is not a constructor.
fn method_ref_constraint(method: String, class_name: String, t: types.Type,
                         tables: Tables) -> Maybe ast.TypeConstraint =
  let class_type = types.eta_class_type(tables_class_params(tables), tables_env(tables), class_name, method, t, t)
      Just _ = types.first_concrete_head_str(class_type) else Nothing
  in Just(ast.TypeConstraint(class_name, [named_type_expr(class_type, tables_env(tables))]))

# The type with each signature variable named as it was declared, through the
# `@eta_fwdvar` markers, so a slot key built from it (typed_ast.dict_slot_key) is the one the
# enclosing function's slot is under. Any other variable keeps its identity.
fn named_type_expr(t: types.Type, env: Dict types.Scheme) -> ast.TypeExpr =
  match t with
  | types.TVar v ->
      match dict_get(types.eta_fwdvar_marker_key(types.tyvar_identity(v)), env) with
      | Just scheme -> typed_ast.type_to_type_expr(types.scheme_type(scheme))
      | Nothing -> typed_ast.type_to_type_expr(t)
  | types.TApp f x -> ast.TypeApply(named_type_expr(f, env), named_type_expr(x, env))
  | types.TTuple items -> ast.TupleType(list_map(\i -> named_type_expr(i, env), items))
  | types.TConst _ -> typed_ast.type_to_type_expr(t)
  | types.TFunc _ _ _ _ -> typed_ast.type_to_type_expr(t)
  | types.TThunk _ _ -> typed_ast.type_to_type_expr(t)

# ---------------------------------------------------------------------------
# The walk: check every TDict, then fill its Evidence; structure otherwise unchanged
# ---------------------------------------------------------------------------

# Each body is resolved under the keys it forwards: a function its where-clause
# constraints; an instance method the instance's context constraints and then its
# own (matching lowering's build_hidden_for_constraints call sites). A top-level
# let forwards nothing.
fn resolve_decl(d: typed_ast.TypedDecl, tables: Tables) -> Result(source.SourcePos, String) typed_ast.TypedDecl =
  match d with
  | typed_ast.TFnDecl name params ret_ty effects constraints body ->
      let fn_tables = with_bounded(bound_vars(types.written_bound_key(name), string.after_last_dot(name), tables), tables)
          b = try resolve_expr(body, InFn, build_fwd_keys(constraints, fn_tables), fn_tables)
      in Ok(typed_ast.TFnDecl(name, params, ret_ty, effects, constraints, b))
  | typed_ast.TLetDecl name body ->
      let b = try resolve_expr(body, InFn, typed_ast.instance_table_empty(), tables)
      in Ok(typed_ast.TLetDecl(name, b))
  | typed_ast.TInstanceDecl constraint inst_constraints methods ->
      let bound = head_vars(constraint)
          kind = InInstanceMethod(bound)
          ctx = head_bound(inst_constraints, bound)
          ast.TypeConstraint cls type_args = constraint
          head = typed_ast.type_expr_head_name(head_pattern(type_args))
          inst_tables = with_bounded(bound_vars(types.inst_bound_key(cls, head), typed_ast.instance_display(cls, type_args), tables),
                                     tables)
          ms = try resolve_all(resolve_method(_, kind, ctx, (cls, head), inst_tables), methods)
      in Ok(typed_ast.TInstanceDecl(constraint, inst_constraints, ms))
  | typed_ast.TExternFnDecl _ _ _ _ -> Ok(d)
  | typed_ast.TPassThrough _ -> Ok(d)

# A dictionary's instances exist, and none instantiates a head variable at a linear type.
fn check_dictionary(c: ast.TypeConstraint, pos: source.SourcePos, kind: DeclKind, fwd_keys: Forwarded,
                    tables: Tables) -> Maybe(source.SourcePos, String) =
  match check_constraint(c, pos, CoverFrom(kind, fwd_keys), tables) with
  | Just err -> Just(err)
  | Nothing -> dictionary_linearity_error(c, pos, fwd_keys, tables)

# The instance context's keys, then the method's own: the order lowering's
# generate_one_instance_fn passes the dictionaries in.
fn resolve_method(
  m: typed_ast.TypedInstanceMethod,
  kind: DeclKind,
  inst_constraints: List ast.TypeConstraint,
  inst: (String, String),
  inst_tables: Tables
) -> Result(source.SourcePos, String) typed_ast.TypedInstanceMethod =
  let typed_ast.TypedInstanceMethod name params ret_ty effects cs body = m
      (cls, head) = inst
      tables = with_bounded(bound_vars(types.inst_method_bound_key(cls, head, name), string.after_last_dot(name),
                                       inst_tables), inst_tables)
      b = try resolve_expr(body, kind, build_fwd_keys(list_append(inst_constraints, cs), tables), tables)
  in Ok(typed_ast.TypedInstanceMethod(name, params, ret_ty, effects, cs, b))

# The `where linear` variables a marker records, named with `owner`.
fn bound_vars(key: String, owner: String, tables: Tables) -> List BoundVar =
  match dict_get(key, tables_env(tables)) with
  | Just marker -> list_map(\v -> BoundVar(written = v, owner = owner), types.scheme_vars(marker))
  | Nothing -> Nil

# Every variant is listed, with no wildcard: a new one stops the build here, so
# whether it needs a check is decided, not defaulted. A TDict or method reference
# is checked before its Evidence is built; a node with children is rebuilt by
# resolve_children. fwd_keys is constant within a body (lambdas add no constraints).
fn resolve_expr(e: typed_ast.TypedExpr, kind: DeclKind, fwd_keys: Forwarded, tables: Tables)
    -> Result(source.SourcePos, String) typed_ast.TypedExpr =
  match e with
  | typed_ast.TDict c t pos _ ->
      let Nothing = check_dictionary(c, pos, kind, fwd_keys, tables) else Just err -> Err(err)
      in Ok(typed_ast.TDict(c, t, pos, produce_evidence(c, fwd_keys, tables)))
  | typed_ast.TMethodRef method class_name t pos _ ->
      let Just c = method_ref_constraint(method, class_name, t, tables)
            else Ok(typed_ast.TMethodRef(method, class_name, t, pos, typed_ast.EvUnresolved))
          Nothing = check_dictionary(c, pos, kind, fwd_keys, tables) else Just err -> Err(err)
      in Ok(typed_ast.TMethodRef(method, class_name, t, pos, method_ref_evidence(c, fwd_keys, tables)))
  | typed_ast.TVar _ _ _ -> Ok(e)
  | typed_ast.TInt _ _ _ -> Ok(e)
  | typed_ast.TFloat _ _ _ -> Ok(e)
  | typed_ast.TBool _ _ _ -> Ok(e)
  | typed_ast.TString _ _ _ -> Ok(e)
  | typed_ast.TChar _ _ _ -> Ok(e)
  | typed_ast.TUnit _ _ -> Ok(e)
  | typed_ast.TTuple _ _ _ -> resolve_children(e, kind, fwd_keys, tables)
  | typed_ast.TIf _ _ _ _ _ -> resolve_children(e, kind, fwd_keys, tables)
  | typed_ast.TMatch _ _ _ _ -> resolve_children(e, kind, fwd_keys, tables)
  | typed_ast.TCall _ _ _ _ -> resolve_children(e, kind, fwd_keys, tables)
  | typed_ast.TLambda _ _ _ _ -> resolve_children(e, kind, fwd_keys, tables)
  | typed_ast.TBinary _ _ _ _ _ -> resolve_children(e, kind, fwd_keys, tables)
  | typed_ast.TUnary _ _ _ _ -> resolve_children(e, kind, fwd_keys, tables)
  | typed_ast.TRange _ _ _ _ -> resolve_children(e, kind, fwd_keys, tables)
  | typed_ast.TDo _ _ _ -> resolve_children(e, kind, fwd_keys, tables)
  | typed_ast.TRecord _ _ _ _ -> resolve_children(e, kind, fwd_keys, tables)
  | typed_ast.TGetField _ _ _ _ -> resolve_children(e, kind, fwd_keys, tables)
  | typed_ast.TRecordUpdate _ _ _ _ -> resolve_children(e, kind, fwd_keys, tables)

# Children left to right, as typed_ast.children lists them; the first error stops
# the walk.
fn resolve_children(e: typed_ast.TypedExpr, kind: DeclKind, fwd_keys: Forwarded, tables: Tables)
    -> Result(source.SourcePos, String) typed_ast.TypedExpr =
  typed_ast.traverse_children(resolve_expr(_, kind, fwd_keys, tables), e)

# traverse over Result without its dictionaries or per-element closures. Left to right,
# stopping at the first Err: the first error reported depends on it. Tail recursive,
# since the program's decl list is one of the lists.
fn resolve_all(g: a -> Result(source.SourcePos, String) b, xs: List a) -> Result(source.SourcePos, String) (List b) =
  resolve_all_go(g, xs, [])

fn resolve_all_go(g: a -> Result(source.SourcePos, String) b, xs: List a, acc: List b)
    -> Result(source.SourcePos, String) (List b) =
  match xs with
  | [] -> Ok(list_reverse(acc))
  | [x | rest] ->
      let y = try g(x)
      in resolve_all_go(g, rest, Cons(y, acc))

# ---------------------------------------------------------------------------
# Type-expression helpers (ported from lowering; resolve owns its own copies)
# ---------------------------------------------------------------------------

# True if a type expression's outermost head is a concrete type constructor.
# Concrete heads start with an uppercase letter (List, Maybe, Int, Tuple2, Fn);
# type variables (a, b), wildcards (`_`), and fresh metavars do not.  Uses
# type_expr_head_name so module-qualified concrete names (stdlib.x.Bar) still
# read as concrete after their prefix is stripped.
# Concreteness is a property of the type NAME, not its module path: a canonical
# dotted head (e.g. "main.Maybe") is concrete iff its last segment starts uppercase.
fn head_is_concrete(te: ast.TypeExpr) -> Bool =
  types.type_id_is_concrete(types.type_id(typed_ast.type_expr_head_name(te)))

# The instance head and the dispatch type arrive at the SAME application depth:
# every recorder records the class variable's binding, and the head-arity check
# (infer.check_instance_head_kinds) rejects a head that would not match it. So the
# two spines pair up as they stand — this used to peel a surplus off the concrete
# side, computed per call, which was only ever right when the concrete side was
# the deeper of the two. docs/instance-head-kinds-v0.md §5.
fn unify_type_expr(
  pattern: ast.TypeExpr,
  concrete: ast.TypeExpr,
  acc: Dict ast.TypeExpr
) -> Dict ast.TypeExpr =
  match pattern with
  | ast.TypeName name ->
      if source.is_lowercase_name(name) then dict_set(name, concrete, acc)
      else acc
  | ast.TypeApply pat_base pat_arg ->
      match concrete with
      | ast.TypeApply con_base con_arg ->
          unify_type_expr(pat_arg, con_arg, unify_type_expr(pat_base, con_base, acc))
      | _ -> acc
  | ast.TupleType pat_items ->
      match concrete with
      | ast.TupleType con_items -> unify_type_args_list(pat_items, con_items, acc)
      | _ -> acc
  | _ -> acc

fn unify_type_args_list(
  patterns: List ast.TypeExpr,
  concretes: List ast.TypeExpr,
  acc: Dict ast.TypeExpr
) -> Dict ast.TypeExpr =
  match (patterns, concretes) with
  | (Nil, _) -> acc
  | (_, Nil) -> acc
  | (Cons p rest_p, Cons c rest_c) ->
      unify_type_args_list(rest_p, rest_c, unify_type_expr(p, c, acc))

fn substitute_type_expr(te: ast.TypeExpr, subs: Dict ast.TypeExpr) -> ast.TypeExpr =
  match te with
  | ast.TypeName name ->
      match dict_get(name, subs) with
      | Just concrete -> concrete
      | Nothing -> te
  | ast.TypeApply base arg ->
      ast.TypeApply(substitute_type_expr(base, subs), substitute_type_expr(arg, subs))
  | ast.TypeArrow from_ to_ effs mode ->
      ast.TypeArrow(substitute_type_expr(from_, subs), substitute_type_expr(to_, subs), effs, mode)
  | ast.TypeThunk to_ effs ->
      ast.TypeThunk(substitute_type_expr(to_, subs), effs)
  | ast.TupleType items ->
      ast.TupleType(list_map(\item -> substitute_type_expr(item, subs), items))
  | _ -> te

fn substitute_constraint(tc: ast.TypeConstraint, subs: Dict ast.TypeExpr) -> ast.TypeConstraint =
  match tc with
  | ast.TypeConstraint class_name type_args ->
      ast.TypeConstraint(class_name, list_map(\te -> substitute_type_expr(te, subs), type_args))
