module stdlib.compiler.resolve

import stdlib.compiler.ast as ast
import stdlib.compiler.source as source
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types
import stdlib.string as string

# ---------------------------------------------------------------------------
# Constraint resolution / discharge pass
# ---------------------------------------------------------------------------
#
# Runs in the check phase, after type inference, over the typed program (which
# includes the bundled prelude decls).  For every TDict evidence node it walks
# the required instance dictionary tree and rejects a constraint whose head is
# a *concrete* type with no instance — the diagnostic the type checker owes but
# previously skipped, letting an unsatisfiable nested dictionary (e.g.
# `to_string([()])` needing `ToString ()`) reach codegen and segfault.
#
# Conservative by design: a constraint whose head is a type *variable* is
# forwarded/polymorphic (lowering threads it as a hidden parameter), so it is
# left alone here.  This mirrors lowering's own resolution order — concrete head
# uses the instance table, variable head is forwarded — without needing the
# per-function forwarding table that only exists during lowering.
#
# Owns its instance tables (built from the typed decls, exactly like lowering's
# collect_instance_table / collect_inst_meta).  This is the first brick of the
# north-star refactor that moves all dictionary resolution into the checker.

export type ResolveResult (..) =
  | ResolveOk typed_ast.TypedProgram
  | ResolveErr source.SourcePos String

# Instance tables: existence (constraint_key → present from bundled decls),
# context (constraint_key → (instance head type args, instance context constraints)),
# the full checker env (carries @inst: markers for instances defined in imported
# modules whose decls are NOT bundled into this program), and super_map
# (class_name → direct superclass names, for transitive-super expansion — the same
# source lowering's collect_super_map reads).
type Tables = Tables(Dict Bool) (Dict (List ast.TypeExpr, List ast.TypeConstraint)) (Dict types.Scheme) (Dict (List String)) (Dict String)

fn tables_exists(t: Tables) -> Dict Bool =
  match t with | Tables e _ _ _ _ -> e

fn tables_ctx(t: Tables) -> Dict (List ast.TypeExpr, List ast.TypeConstraint) =
  match t with | Tables _ c _ _ _ -> c

fn tables_env(t: Tables) -> Dict types.Scheme =
  match t with | Tables _ _ v _ _ -> v

fn tables_super(t: Tables) -> Dict (List String) =
  match t with | Tables _ _ _ s _ -> s

fn tables_class_params(t: Tables) -> Dict String =
  match t with | Tables _ _ _ _ p -> p

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

export fn resolve_program(prog: typed_ast.TypedProgram, env: Dict types.Scheme) -> ResolveResult =
  match prog with
  | typed_ast.TypedProgram decls -> resolve_with_tables(decls, build_tables(decls, env))

# Two passes over the typed decls: check first (produce the diagnostic the type
# checker owes for an unsatisfiable concrete-head constraint), then, only if the
# program is well-formed, rewrite every TDict's Evidence field with the resolved
# instance/forward tree.  The rewrite is dormant today — lowering still resolves
# dictionaries itself and ignores the field — but M3b-3 makes lowering consume it.
fn resolve_with_tables(decls: List typed_ast.TypedDecl, tables: Tables) -> ResolveResult =
  match check_decls(decls, tables) with
  | Just (pos, msg) -> ResolveErr(pos, msg)
  | Nothing -> ResolveOk(typed_ast.TypedProgram(rewrite_decls(decls, tables)))

# ---------------------------------------------------------------------------
# Table construction (from typed decls — prelude is bundled in)
# ---------------------------------------------------------------------------

fn build_tables(decls: List typed_ast.TypedDecl, env: Dict types.Scheme) -> Tables =
  collect_tables(decls, Tables(dict_empty(), dict_empty(), env, collect_super_map(decls, dict_empty()), collect_class_params(decls, dict_empty())))

fn collect_tables(decls: List typed_ast.TypedDecl, acc: Tables) -> Tables =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | typed_ast.TInstanceDecl constraint inst_constraints _ ->
          collect_tables(rest, add_instance(constraint, inst_constraints, acc))
      | _ -> collect_tables(rest, acc)

fn add_instance(
  constraint: ast.TypeConstraint,
  inst_constraints: List ast.TypeConstraint,
  acc: Tables
) -> Tables =
  match constraint with
  | ast.TypeConstraint _ type_args ->
      Tables(
        dict_set(constraint_key_from_tc(constraint), true, tables_exists(acc)),
        add_ctx(constraint_key_from_tc(constraint), type_args, inst_constraints, tables_ctx(acc)),
        tables_env(acc),
        tables_super(acc),
        tables_class_params(acc))

fn add_ctx(
  key: String,
  type_args: List ast.TypeExpr,
  inst_constraints: List ast.TypeConstraint,
  acc: Dict (List ast.TypeExpr, List ast.TypeConstraint)
) -> Dict (List ast.TypeExpr, List ast.TypeConstraint) =
  match inst_constraints with
  | Nil -> acc
  | _ -> dict_set(key, (type_args, inst_constraints), acc)

# ---------------------------------------------------------------------------
# Constraint discharge
# ---------------------------------------------------------------------------

# Returns the first unsatisfiable-constraint error, or Nothing.
fn check_constraint(
  c: ast.TypeConstraint,
  pos: source.SourcePos,
  tables: Tables
) -> Maybe(source.SourcePos, String) =
  match c with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> Nothing
      | Cons head_arg _ ->
          # Only diagnose constraints whose head is a concrete type constructor
          # (uppercase head). A lowercase/`_`/non-letter head is a type variable —
          # forwarded/polymorphic, resolved as a hidden parameter by lowering.
          if head_is_concrete(head_arg) == false then Nothing
          else
            if instance_exists(string.substring_after_last(class_name, "."), type_args, head_arg, tables)
            then check_context(constraint_key_str(string.substring_after_last(class_name, "."), type_args), type_args, pos, tables)
            else Just((pos,
              "No instance of " ++ string.substring_after_last(class_name, ".") ++ " for " ++ type_expr_head_name(head_arg)))

# An instance exists if a bundled decl provides it OR the checker env carries an
# @inst: marker for it (instances from imported modules whose decls are not
# bundled into this program register markers in the env but no TInstanceDecl).
fn instance_exists(
  class_bare: String,
  type_args: List ast.TypeExpr,
  head_arg: ast.TypeExpr,
  tables: Tables
) -> Bool =
  dict_has(constraint_key_str(class_bare, type_args), tables_exists(tables))
  || env_has_inst("@inst:" ++ class_bare ++ ":" ++ type_expr_head_name(head_arg), tables_env(tables))

fn env_has_inst(key: String, env: Dict types.Scheme) -> Bool =
  match dict_get(key, env) with
  | Just _ -> true
  | Nothing -> false

# Recurse into a matched instance's context constraints (substituted at the
# concrete type args).  A context-free instance has no entry → Nothing.
fn check_context(
  key: String,
  type_args: List ast.TypeExpr,
  pos: source.SourcePos,
  tables: Tables
) -> Maybe(source.SourcePos, String) =
  match dict_get(key, tables_ctx(tables)) with
  | Nothing -> Nothing
  | Just (inst_type_args, inst_constraints) ->
      check_constraint_list(
        list_map(\c -> substitute_constraint(c, unify_type_args_list(inst_type_args, type_args, dict_empty())),
                 inst_constraints),
        pos, tables)

fn check_constraint_list(
  cs: List ast.TypeConstraint,
  pos: source.SourcePos,
  tables: Tables
) -> Maybe(source.SourcePos, String) =
  match cs with
  | Nil -> Nothing
  | Cons c rest ->
      match check_constraint(c, pos, tables) with
      | Just e -> Just(e)
      | Nothing -> check_constraint_list(rest, pos, tables)

fn dict_has(key: String, d: Dict Bool) -> Bool =
  match dict_get(key, d) with
  | Just _ -> true
  | Nothing -> false

# ---------------------------------------------------------------------------
# Evidence production
# ---------------------------------------------------------------------------
#
# Resolve one constraint into the Evidence tree lowering will consume.  A single
# TDict lowers to one witness block per *effective class* — the constraint's class
# followed by its transitive superclasses — so produce_evidence expands supers the
# same way lowering's resolve_tdict does (class_with_transitive_supers, verbatim
# order + dedup) and wraps the per-class blocks in EvClasses.  Each block mirrors
# lowering's resolve_tdict_with_key decision order exactly:
#   * key in fwd_keys           → EvForward key   (the enclosing function forwards
#                                  this exact constraint as a hidden param — checked
#                                  FIRST, mirroring lowering's ctx_fwd-before-ctx_inst
#                                  priority; applies even to a CONCRETE head that also
#                                  has an instance, e.g. `where Summable (Vec Int)`)
#   * type-variable head        → EvForward key   (forwarded, or a phantom fresh tyvar
#                                  that lowering null-fills on the ctx_fwd miss)
#   * concrete head, bundled    → EvInstance key children  (children = one Evidence
#                                  per substituted instance context constraint)
#   * concrete head, env-marker → EvUnresolved    (imported instance not bundled;
#                                  lowering resolves it, same as today)
#   * concrete head, no instance→ EvMissing       (unreachable once check passes)
#
# fwd_keys is the set of constraint_keys the enclosing function forwards (its
# where-clause constraints, super-expanded) — built exactly as lowering's
# build_hidden_for_constraints keys ctx_fwd, so the two agree.
fn produce_evidence(c: ast.TypeConstraint, fwd_keys: Dict Bool, tables: Tables) -> typed_ast.Evidence =
  match c with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Nil -> typed_ast.EvUnresolved
      | Cons head_arg _ ->
          typed_ast.EvClasses(
            list_map(
              \eff_class -> produce_one_class(eff_class, head_arg, type_args, fwd_keys, tables),
              class_with_transitive_supers(class_name, tables_super(tables))))

# One effective-class block. The key is computed exactly as lowering's
# resolve_tdict_for_classes does: constraint_key_str(after_last_dot(eff_class), args).
# class_name kept UNSTRIPPED (eff_class); only the key is stripped.
fn produce_one_class(
  eff_class: String,
  head_arg: ast.TypeExpr,
  type_args: List ast.TypeExpr,
  fwd_keys: Dict Bool,
  tables: Tables
) -> typed_ast.Evidence =
  if dict_has(constraint_key_str(string.substring_after_last(eff_class, "."), type_args), fwd_keys) then
    typed_ast.EvForward(eff_class, constraint_key_str(string.substring_after_last(eff_class, "."), type_args))
  else if head_is_concrete(head_arg) == false then
    typed_ast.EvForward(eff_class, constraint_key_str(string.substring_after_last(eff_class, "."), type_args))
  else
    produce_concrete_evidence(eff_class, string.substring_after_last(eff_class, "."), type_args, head_arg, fwd_keys, tables)

fn produce_concrete_evidence(
  eff_class: String,
  class_bare: String,
  type_args: List ast.TypeExpr,
  head_arg: ast.TypeExpr,
  fwd_keys: Dict Bool,
  tables: Tables
) -> typed_ast.Evidence =
  if dict_has(constraint_key_str(class_bare, type_args), tables_exists(tables)) then
    produce_instance_evidence(eff_class, constraint_key_str(class_bare, type_args), type_args, fwd_keys, tables)
  else if env_has_inst("@inst:" ++ class_bare ++ ":" ++ type_expr_head_name(head_arg), tables_env(tables)) then
    typed_ast.EvUnresolved
  else
    typed_ast.EvMissing(ast.TypeConstraint(eff_class, type_args))

# Bundled instance: an unconstrained instance has no context entry → no children;
# a constrained instance recurses on each context constraint substituted at the
# concrete head's type args, in declaration order (matching lowering's inner_dicts).
# Each child is itself an EvClasses (the context constraint is super-expanded too).
# The inner dicts share the enclosing function's fwd_keys, exactly as lowering's
# resolve_inner_constraint_dicts resolves them against the same ctx_fwd.
fn produce_instance_evidence(
  eff_class: String,
  key: String,
  type_args: List ast.TypeExpr,
  fwd_keys: Dict Bool,
  tables: Tables
) -> typed_ast.Evidence =
  match dict_get(key, tables_ctx(tables)) with
  | Nothing -> typed_ast.EvInstance(eff_class, key, Nil)
  | Just (inst_type_args, inst_constraints) ->
      typed_ast.EvInstance(eff_class, key,
        list_map(
          \ic -> produce_evidence(substitute_constraint(ic, unify_type_args_list(inst_type_args, type_args, dict_empty())), fwd_keys, tables),
          inst_constraints))

# The forwarded-key set for a function/method body: one key per (constraint, super)
# in its where-clause, computed exactly as lowering's build_hidden_for_constraints
# keys ctx_fwd (constraint_key_str(after_last_dot(eff_class), type_args)).
fn build_fwd_keys(constraints: List ast.TypeConstraint, super_map: Dict (List String)) -> Dict Bool =
  add_fwd_keys(constraints, super_map, dict_empty())

fn add_fwd_keys(constraints: List ast.TypeConstraint, super_map: Dict (List String), acc: Dict Bool) -> Dict Bool =
  match constraints with
  | Nil -> acc
  | Cons c rest ->
      match c with
      | ast.TypeConstraint class_name type_args ->
          add_fwd_keys(rest, super_map,
            add_eff_keys(class_with_transitive_supers(class_name, super_map), type_args, acc))

fn add_eff_keys(effs: List String, type_args: List ast.TypeExpr, acc: Dict Bool) -> Dict Bool =
  match effs with
  | Nil -> acc
  | Cons eff rest ->
      add_eff_keys(rest, type_args,
        dict_set(constraint_key_str(string.substring_after_last(eff, "."), type_args), true, acc))

# ---------------------------------------------------------------------------
# Superclass expansion (ported verbatim from lowering.sprout so the effective-
# class order and diamond-dedup match byte-for-byte)
# ---------------------------------------------------------------------------

fn collect_super_map(decls: List typed_ast.TypedDecl, acc: Dict (List String)) -> Dict (List String) =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | typed_ast.TPassThrough inner_decl ->
          match inner_decl with
          | ast.ClassDecl class_name _ _ supers _ ->
              collect_super_map(rest, dict_set(class_name, extract_super_names(supers, Nil), acc))
          | _ -> collect_super_map(rest, acc)
      | _ -> collect_super_map(rest, acc)

fn extract_super_names(supers: List ast.TypeConstraint, acc: List String) -> List String =
  match supers with
  | Nil -> list_reverse(acc)
  | Cons c rest ->
      match c with
      | ast.TypeConstraint super_name _ ->
          extract_super_names(rest, Cons(super_name, acc))

# class_name → class-parameter name (e.g. "ToString" → "a"), the same table
# lowering's ctx_class_params carries.  Used to derive a value-position class
# method's head type from its (substituted) type.
fn collect_class_params(decls: List typed_ast.TypedDecl, acc: Dict String) -> Dict String =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | typed_ast.TPassThrough inner_decl ->
          match inner_decl with
          | ast.ClassDecl class_name params _ _ _ ->
              collect_class_params(rest, add_class_param(class_name, params, acc))
          | _ -> collect_class_params(rest, acc)
      | _ -> collect_class_params(rest, acc)

fn add_class_param(class_name: String, params: List String, acc: Dict String) -> Dict String =
  match params with
  | Nil -> acc
  | Cons p _ -> dict_set(class_name, p, acc)

# Class itself followed by all transitive superclasses in DFS order, deduplicated.
fn class_with_transitive_supers(class_name: String, super_map: Dict (List String)) -> List String =
  list_reverse(collect_supers_dfs(Cons(class_name, Nil), super_map, Nil))

fn collect_supers_dfs(stack: List String, super_map: Dict (List String), visited: List String) -> List String =
  match stack with
  | Nil -> visited
  | Cons name rest ->
      if list_str_member(name, visited)
      then collect_supers_dfs(rest, super_map, visited)
      else collect_supers_dfs(prepend_supers(name, super_map, rest), super_map, Cons(name, visited))

fn prepend_supers(name: String, super_map: Dict (List String), rest: List String) -> List String =
  match dict_get(name, super_map) with
  | Nothing -> rest
  | Just supers -> append_str_list(supers, rest)

fn append_str_list(xs: List String, ys: List String) -> List String =
  match xs with
  | Nil -> ys
  | Cons h t -> Cons(h, append_str_list(t, ys))

fn list_str_member(x: String, xs: List String) -> Bool =
  match xs with
  | Nil -> false
  | Cons h t -> if h == x then true else list_str_member(x, t)

# ---------------------------------------------------------------------------
# Value-position class-method head derivation (ported from lowering.sprout so the
# resolve pass can fill a TMethodRef's Evidence the same way lowering eta-expands
# it). The `mr_` prefix avoids clashing with resolve's own helpers.
# ---------------------------------------------------------------------------

fn mr_first_concrete_head_str(t: types.Type) -> Maybe String =
  match t with
  | types.TConst name -> Just(types.type_id_display(name))
  | types.TApp base _ -> mr_first_concrete_head_str(base)
  | _ -> Nothing

fn mr_class_param_for(class_name: String, class_params: Dict String) -> Maybe String =
  match dict_get(class_name, class_params) with
  | Just param -> Just(param)
  | Nothing -> dict_get(string.after_last_dot(class_name), class_params)

fn mr_eta_class_type(class_name: String, method_name: String, actual_type: types.Type, fallback: types.Type, class_params: Dict String, scheme_env: Dict types.Scheme) -> types.Type =
  match mr_class_param_for(class_name, class_params) with
  | Nothing -> fallback
  | Just class_param ->
      match mr_lookup_method_scheme(method_name, scheme_env) with
      | Nothing -> fallback
      | Just scheme -> mr_eta_class_type_from_scheme(class_param, types.scheme_type(scheme), actual_type, fallback)

fn mr_lookup_method_scheme(method_name: String, scheme_env: Dict types.Scheme) -> Maybe types.Scheme =
  match dict_get(method_name, scheme_env) with
  | Just scheme -> Just(scheme)
  | Nothing -> dict_get(string.after_last_dot(method_name), scheme_env)

fn mr_eta_class_type_from_scheme(class_param: String, scheme_type: types.Type, actual_type: types.Type, fallback: types.Type) -> types.Type =
  match dict_get(class_param, match_type_vars(scheme_type, mr_eta_actual_type_for_scheme_match(scheme_type, actual_type), dict_empty())) with
  | Nothing -> fallback
  | Just class_type -> class_type

fn mr_eta_actual_type_for_scheme_match(scheme_type: types.Type, actual_type: types.Type) -> types.Type =
  match scheme_type with
  | types.TFunc _ _ _ -> actual_type
  | _ ->
      match actual_type with
      | types.TFunc param ret _ ->
          # Zero-arg methods are inferred as their result type, but can appear
          # in value position as Unit -> result.
          if type_is_unit(param) then ret else actual_type
      | _ -> actual_type

fn type_is_unit(t: types.Type) -> Bool =
  match t with
  | types.TConst name -> types.type_id_display(name) == "Unit"
  | _ -> false

fn match_type_vars(pattern: types.Type, actual: types.Type, acc: Dict types.Type) -> Dict types.Type =
  match pattern with
  | types.TVar name -> dict_set(types.tyvar_name(name), actual, acc)
  | types.TConst _ -> acc
  | types.TApp pbase parg ->
      match actual with
      | types.TApp abase aarg -> match_type_vars(parg, aarg, match_type_vars(pbase, abase, acc))
      | _ -> acc
  | types.TFunc pparam pret _ ->
      match actual with
      | types.TFunc aparam aret _ -> match_type_vars(pret, aret, match_type_vars(pparam, aparam, acc))
      | _ -> acc
  | types.TTuple pitems ->
      match actual with
      | types.TTuple aitems -> match_type_var_lists(pitems, aitems, acc)
      | _ -> acc

fn match_type_var_lists(patterns: List types.Type, actuals: List types.Type, acc: Dict types.Type) -> Dict types.Type =
  match (patterns, actuals) with
  | (Nil, _) -> acc
  | (_, Nil) -> acc
  | (Cons p prest, Cons a arest) -> match_type_var_lists(prest, arest, match_type_vars(p, a, acc))

# Value-position class method: derive the class-parameter head type from the
# method's (substituted) type via the class-method scheme, then reuse
# produce_one_class for that single class. Non-derivable / non-concrete head →
# EvUnresolved (lowering falls back to its own eta reconstruction).
fn method_ref_evidence(method: String, class_name: String, t: types.Type, fwd_keys: Dict Bool, tables: Tables) -> typed_ast.Evidence =
  match mr_eta_class_type(class_name, method, t, t, tables_class_params(tables), tables_env(tables)) with
  | class_type ->
      match mr_first_concrete_head_str(class_type) with
      | Nothing -> typed_ast.EvUnresolved
      | Just _ ->
          produce_one_class(class_name, typed_ast.type_to_type_expr(class_type),
            Cons(typed_ast.type_to_type_expr(class_type), Nil), fwd_keys, tables)

# ---------------------------------------------------------------------------
# Evidence rewrite: fill every TDict's Evidence, structure otherwise unchanged
# ---------------------------------------------------------------------------

fn rewrite_decls(decls: List typed_ast.TypedDecl, tables: Tables) -> List typed_ast.TypedDecl =
  list_map(\d -> rewrite_decl(d, tables), decls)

# Each decl body is rewritten under its own forwarded-key set: a function forwards
# its where-clause constraints; an instance method forwards the instance's context
# constraints (matching lowering's build_hidden_for_constraints call sites). A
# top-level let forwards nothing.
fn rewrite_decl(d: typed_ast.TypedDecl, tables: Tables) -> typed_ast.TypedDecl =
  match d with
  | typed_ast.TFnDecl name params ret_ty effects constraints body ->
      typed_ast.TFnDecl(name, params, ret_ty, effects, constraints,
        rewrite_expr(body, build_fwd_keys(constraints, tables_super(tables)), tables))
  | typed_ast.TLetDecl name body ->
      typed_ast.TLetDecl(name, rewrite_expr(body, dict_empty(), tables))
  | typed_ast.TInstanceDecl constraint inst_constraints methods ->
      typed_ast.TInstanceDecl(constraint, inst_constraints,
        list_map(\m -> rewrite_method(m, build_fwd_keys(inst_constraints, tables_super(tables)), tables), methods))
  | typed_ast.TExternFnDecl _ _ _ _ -> d
  | typed_ast.TPassThrough _ -> d

fn rewrite_method(m: typed_ast.TypedInstanceMethod, fwd_keys: Dict Bool, tables: Tables) -> typed_ast.TypedInstanceMethod =
  match m with
  | typed_ast.TypedInstanceMethod name params ret_ty effects body ->
      typed_ast.TypedInstanceMethod(name, params, ret_ty, effects, rewrite_expr(body, fwd_keys, tables))

# Structural rebuild that visits the same nodes as check_expr; at each TDict the
# Evidence field is replaced.  Any node not walked keeps EvUnresolved, which
# lowering resolves itself — so a missed site degrades to today's behavior, never
# to a wrong witness. fwd_keys is constant within a body (lambdas add no constraints).
fn rewrite_expr(e: typed_ast.TypedExpr, fwd_keys: Dict Bool, tables: Tables) -> typed_ast.TypedExpr =
  match e with
  | typed_ast.TDict c t pos _ -> typed_ast.TDict(c, t, pos, produce_evidence(c, fwd_keys, tables))
  | typed_ast.TCall callee args t pos ->
      typed_ast.TCall(rewrite_expr(callee, fwd_keys, tables), list_map(\a -> rewrite_expr(a, fwd_keys, tables), args), t, pos)
  | typed_ast.TIf cnd thn els t pos ->
      typed_ast.TIf(rewrite_expr(cnd, fwd_keys, tables), rewrite_expr(thn, fwd_keys, tables), rewrite_expr(els, fwd_keys, tables), t, pos)
  | typed_ast.TMatch scrut branches t pos ->
      typed_ast.TMatch(rewrite_expr(scrut, fwd_keys, tables), list_map(\b -> rewrite_branch(b, fwd_keys, tables), branches), t, pos)
  | typed_ast.TLambda params body t pos ->
      typed_ast.TLambda(params, rewrite_expr(body, fwd_keys, tables), t, pos)
  | typed_ast.TTuple items t pos ->
      typed_ast.TTuple(list_map(\i -> rewrite_expr(i, fwd_keys, tables), items), t, pos)
  | typed_ast.TBinary op l r t pos ->
      typed_ast.TBinary(op, rewrite_expr(l, fwd_keys, tables), rewrite_expr(r, fwd_keys, tables), t, pos)
  | typed_ast.TUnary op x t pos ->
      typed_ast.TUnary(op, rewrite_expr(x, fwd_keys, tables), t, pos)
  | typed_ast.TRange lo hi t pos ->
      typed_ast.TRange(rewrite_expr(lo, fwd_keys, tables), rewrite_expr(hi, fwd_keys, tables), t, pos)
  | typed_ast.TDo steps t pos ->
      typed_ast.TDo(list_map(\s -> rewrite_step(s, fwd_keys, tables), steps), t, pos)
  | typed_ast.TRecord name fields t pos ->
      typed_ast.TRecord(name, list_map(\f -> rewrite_field(f, fwd_keys, tables), fields), t, pos)
  | typed_ast.TGetField obj fld t pos ->
      typed_ast.TGetField(rewrite_expr(obj, fwd_keys, tables), fld, t, pos)
  | typed_ast.TMethodRef method class_name t pos _ ->
      typed_ast.TMethodRef(method, class_name, t, pos, method_ref_evidence(method, class_name, t, fwd_keys, tables))
  | _ -> e

fn rewrite_branch(b: typed_ast.TypedMatchBranch, fwd_keys: Dict Bool, tables: Tables) -> typed_ast.TypedMatchBranch =
  match b with
  | typed_ast.TypedMatchBranch pat body -> typed_ast.TypedMatchBranch(pat, rewrite_expr(body, fwd_keys, tables))

fn rewrite_step(s: typed_ast.TypedDoStep, fwd_keys: Dict Bool, tables: Tables) -> typed_ast.TypedDoStep =
  match s with
  | typed_ast.TDoBindStep pat ex -> typed_ast.TDoBindStep(pat, rewrite_expr(ex, fwd_keys, tables))
  | typed_ast.TDoLetStep name ex -> typed_ast.TDoLetStep(name, rewrite_expr(ex, fwd_keys, tables))
  | typed_ast.TDoExprStep ex -> typed_ast.TDoExprStep(rewrite_expr(ex, fwd_keys, tables))

fn rewrite_field(f: typed_ast.TypedRecordField, fwd_keys: Dict Bool, tables: Tables) -> typed_ast.TypedRecordField =
  match f with
  | typed_ast.TypedRecordField name ex -> typed_ast.TypedRecordField(name, rewrite_expr(ex, fwd_keys, tables))

# ---------------------------------------------------------------------------
# Typed-AST walk: find every TDict and check its constraint
# ---------------------------------------------------------------------------

fn check_decls(
  decls: List typed_ast.TypedDecl,
  tables: Tables
) -> Maybe(source.SourcePos, String) =
  match decls with
  | Nil -> Nothing
  | Cons d rest ->
      match check_decl(d, tables) with
      | Just e -> Just(e)
      | Nothing -> check_decls(rest, tables)

fn check_decl(d: typed_ast.TypedDecl, tables: Tables) -> Maybe(source.SourcePos, String) =
  match d with
  | typed_ast.TFnDecl _ _ _ _ _ body -> check_expr(body, tables)
  | typed_ast.TLetDecl _ body -> check_expr(body, tables)
  | typed_ast.TInstanceDecl _ _ methods -> check_methods(methods, tables)
  | typed_ast.TExternFnDecl _ _ _ _ -> Nothing
  | typed_ast.TPassThrough _ -> Nothing

fn check_methods(
  methods: List typed_ast.TypedInstanceMethod,
  tables: Tables
) -> Maybe(source.SourcePos, String) =
  match methods with
  | Nil -> Nothing
  | Cons m rest ->
      match m with
      | typed_ast.TypedInstanceMethod _ _ _ _ body ->
          match check_expr(body, tables) with
          | Just e -> Just(e)
          | Nothing -> check_methods(rest, tables)

fn check_expr(e: typed_ast.TypedExpr, tables: Tables) -> Maybe(source.SourcePos, String) =
  match e with
  | typed_ast.TDict c _ pos _ -> check_constraint(c, pos, tables)
  | typed_ast.TCall callee args _ _ -> check_expr_list(Cons(callee, args), tables)
  | typed_ast.TIf cnd thn els _ _ -> check_expr_list([cnd, thn, els], tables)
  | typed_ast.TMatch scrut branches _ _ -> check_expr_list(Cons(scrut, branch_bodies(branches)), tables)
  | typed_ast.TLambda _ body _ _ -> check_expr(body, tables)
  | typed_ast.TTuple items _ _ -> check_expr_list(items, tables)
  | typed_ast.TBinary _ l r _ _ -> check_expr_list([l, r], tables)
  | typed_ast.TUnary _ x _ _ -> check_expr(x, tables)
  | typed_ast.TRange lo hi _ _ -> check_expr_list([lo, hi], tables)
  | typed_ast.TDo steps _ _ -> check_expr_list(do_step_exprs(steps), tables)
  | typed_ast.TRecord _ fields _ _ -> check_expr_list(record_field_exprs(fields), tables)
  | typed_ast.TGetField obj _ _ _ -> check_expr(obj, tables)
  | _ -> Nothing

fn check_expr_list(
  es: List typed_ast.TypedExpr,
  tables: Tables
) -> Maybe(source.SourcePos, String) =
  match es with
  | Nil -> Nothing
  | Cons e rest ->
      match check_expr(e, tables) with
      | Just x -> Just(x)
      | Nothing -> check_expr_list(rest, tables)

fn branch_bodies(branches: List typed_ast.TypedMatchBranch) -> List typed_ast.TypedExpr =
  match branches with
  | Nil -> Nil
  | Cons b rest ->
      match b with
      | typed_ast.TypedMatchBranch _ body -> Cons(body, branch_bodies(rest))

fn do_step_exprs(steps: List typed_ast.TypedDoStep) -> List typed_ast.TypedExpr =
  match steps with
  | Nil -> Nil
  | Cons s rest ->
      match s with
      | typed_ast.TDoBindStep _ ex -> Cons(ex, do_step_exprs(rest))
      | typed_ast.TDoLetStep _ ex -> Cons(ex, do_step_exprs(rest))
      | typed_ast.TDoExprStep ex -> Cons(ex, do_step_exprs(rest))

fn record_field_exprs(fields: List typed_ast.TypedRecordField) -> List typed_ast.TypedExpr =
  match fields with
  | Nil -> Nil
  | Cons f rest ->
      match f with
      | typed_ast.TypedRecordField _ ex -> Cons(ex, record_field_exprs(rest))

# ---------------------------------------------------------------------------
# Type-expression helpers (ported from lowering; resolve owns its own copies)
# ---------------------------------------------------------------------------

# True if a type expression's outermost head is a concrete type constructor.
# Concrete heads start with an uppercase letter (List, Maybe, Int, Tuple2, Fn);
# type variables (a, b), wildcards (`_`), and fresh metavars do not.  Uses
# type_expr_head_name so module-qualified concrete names (stdlib.x.Bar) still
# read as concrete after their prefix is stripped.
# Concreteness is a property of the type NAME, not its module path: a canonical
# dotted head (e.g. "main.Maybe") is concrete iff its last segment starts uppercase.
fn head_is_concrete(te: ast.TypeExpr) -> Bool =
  types.type_id_is_concrete(types.type_id(type_expr_head_name(te)))

fn is_type_var_name(name: String) -> Bool =
  # A module-qualified name (dotted) is never a type variable — guard as
  # infer.is_lowercase_name does (code-review finding 2, 2026-07-10).
  if str_find(name, ".") != -1 then false
  else match str_char_at(name, 0) with
  | Nothing -> false
  | Just c ->
      c == 'a' || c == 'b' || c == 'c' || c == 'd' || c == 'e' || c == 'f' ||
      c == 'g' || c == 'h' || c == 'i' || c == 'j' || c == 'k' || c == 'l' ||
      c == 'm' || c == 'n' || c == 'o' || c == 'p' || c == 'q' || c == 'r' ||
      c == 's' || c == 't' || c == 'u' || c == 'v' || c == 'w' || c == 'x' ||
      c == 'y' || c == 'z'

fn constraint_key_from_tc(c: ast.TypeConstraint) -> String =
  match c with
  | ast.TypeConstraint class_name type_args ->
      constraint_key_str(string.substring_after_last(class_name, "."), type_args)

fn constraint_key_str(class_name: String, type_args: List ast.TypeExpr) -> String =
  match type_args with
  | Nil -> class_name
  | Cons h rest ->
      class_name ++ "_" ++ type_expr_head_name(h) ++ constraint_key_args_rest(rest)

fn constraint_key_args_rest(args: List ast.TypeExpr) -> String =
  match args with
  | Nil -> ""
  | Cons h rest -> "_" ++ type_expr_head_name(h) ++ constraint_key_args_rest(rest)

fn type_expr_head_name(te: ast.TypeExpr) -> String =
  match te with
  # Module-qualified type identity (T7): instance dispatch keys preserve the
  # canonical (dotted) name so main.Maybe and a prelude Maybe get distinct keys.
  # Must agree with infer's @inst registration and lowering's ctx_inst keys, which
  # are all raw dotted names; only the emitted __tc_ LLVM symbol is dot-sanitized.
  | ast.TypeName name -> name
  | ast.TypeApply base _ -> type_expr_head_name(base)
  | ast.TypeArrow _ _ _ -> "Fn"
  | ast.TypeEffect _ _ -> "Eff"
  | ast.TupleType items -> "Tuple" ++ int_to_string(list_length(items))

fn unify_type_expr(
  pattern: ast.TypeExpr,
  concrete: ast.TypeExpr,
  acc: Dict ast.TypeExpr
) -> Dict ast.TypeExpr =
  match pattern with
  | ast.TypeName name ->
      if is_type_var_name(name) then dict_set(name, concrete, acc)
      else acc
  | ast.TypeApply pat_base pat_arg ->
      match concrete with
      | ast.TypeApply con_base con_arg ->
          unify_type_expr(pat_arg, con_arg, unify_type_expr(pat_base, con_base, acc))
      | _ -> acc
  | ast.TupleType pat_items ->
      match concrete with
      | ast.TupleType con_items -> unify_type_args_list(pat_items, con_items, acc)
      | _ -> acc
  | _ -> acc

fn unify_type_args_list(
  patterns: List ast.TypeExpr,
  concretes: List ast.TypeExpr,
  acc: Dict ast.TypeExpr
) -> Dict ast.TypeExpr =
  match (patterns, concretes) with
  | (Nil, _) -> acc
  | (_, Nil) -> acc
  | (Cons p rest_p, Cons c rest_c) ->
      unify_type_args_list(rest_p, rest_c, unify_type_expr(p, c, acc))

fn substitute_type_expr(te: ast.TypeExpr, subs: Dict ast.TypeExpr) -> ast.TypeExpr =
  match te with
  | ast.TypeName name ->
      match dict_get(name, subs) with
      | Just concrete -> concrete
      | Nothing -> te
  | ast.TypeApply base arg ->
      ast.TypeApply(substitute_type_expr(base, subs), substitute_type_expr(arg, subs))
  | ast.TypeArrow from_ to_ effs ->
      ast.TypeArrow(substitute_type_expr(from_, subs), substitute_type_expr(to_, subs), effs)
  | ast.TupleType items ->
      ast.TupleType(list_map(\item -> substitute_type_expr(item, subs), items))
  | _ -> te

fn substitute_constraint(tc: ast.TypeConstraint, subs: Dict ast.TypeExpr) -> ast.TypeConstraint =
  match tc with
  | ast.TypeConstraint class_name type_args ->
      ast.TypeConstraint(class_name, list_map(\te -> substitute_type_expr(te, subs), type_args))
