module stdlib.compiler.ir_lowering
import stdlib.compiler.sprout_ir as sprout_ir

# ---------------------------------------------------------------------------
# Sprout-IR → LLVM IR text lowering.
# ---------------------------------------------------------------------------
#
# Milestone 1, PR 1.3 (see docs/gc-rooting-model-c-plan-2026-06-02.md).
#
# Mechanical lowering of the scalar-program subset (IRConst, IRRet,
# IRIAdd/Sub/Mul/Cmp) into textual LLVM.  Produces enough boilerplate that
# `clang -x ir -` accepts the output and the linked binary can run.
#
# Calling convention: every IRFunction lowers to
#   `define <ret-ty> @<name>(i64 %p, ...)`
# where <ret-ty> is the LLVM return-type field of the IRFunction ("i64" or
# "i1").  Each parameter is typed `i64`.  A synthetic C-ABI `main` shim is
# appended unconditionally — for PR 1.3 it just returns 0 because we cannot
# yet lower the user's `main` body (which would typically call into IO).
#
# This pass has no rooting decisions and no GC concerns: the supported ops
# operate purely on Int/Bool scalars.

# Render a single IROp as one LLVM IR line (without trailing newline).
fn lower_op(op: sprout_ir.IROp, ret_ty: String) -> String =
  match op with
  | sprout_ir.IRConst name n -> "  " ++ name ++ " = add i64 0, " ++ int_to_string(n)
  | sprout_ir.IRRet name -> "  ret " ++ ret_ty ++ " " ++ name
  | sprout_ir.IRIAdd r a b -> "  " ++ r ++ " = add i64 " ++ a ++ ", " ++ b
  | sprout_ir.IRISub r a b -> "  " ++ r ++ " = sub i64 " ++ a ++ ", " ++ b
  | sprout_ir.IRIMul r a b -> "  " ++ r ++ " = mul i64 " ++ a ++ ", " ++ b
  | sprout_ir.IRICmp r pred a b -> "  " ++ r ++ " = icmp " ++ pred ++ " i64 " ++ a ++ ", " ++ b

fn lower_ops(ops: List sprout_ir.IROp, ret_ty: String) -> String =
  match ops with
  | Nil -> ""
  | Cons op rest -> lower_op(op, ret_ty) ++ "\n" ++ lower_ops(rest, ret_ty)

fn lower_block(b: sprout_ir.IRBlock, ret_ty: String) -> String =
  match b with
  | sprout_ir.IRBlock label ops -> label ++ ":\n" ++ lower_ops(ops, ret_ty)

fn lower_blocks(bs: List sprout_ir.IRBlock, ret_ty: String) -> String =
  match bs with
  | Nil -> ""
  | Cons b rest -> lower_block(b, ret_ty) ++ lower_blocks(rest, ret_ty)

# Build the comma-separated "i64 %a, i64 %b, ..." parameter list.
fn lower_params(params: List String) -> String =
  match params with
  | Nil -> ""
  | Cons p Nil -> "i64 %" ++ p
  | Cons p rest -> "i64 %" ++ p ++ ", " ++ lower_params(rest)

fn lower_fn(f: sprout_ir.IRFunction) -> String =
  match f with
  | sprout_ir.IRFunction name params ret_ty blocks ->
      "define " ++ ret_ty ++ " @" ++ name ++ "(" ++ lower_params(params) ++ ") {\n" ++ lower_blocks(blocks, ret_ty) ++ "}\n"

fn lower_fns(fns: List sprout_ir.IRFunction) -> String =
  match fns with
  | Nil -> ""
  | Cons f rest -> lower_fn(f) ++ "\n" ++ lower_fns(rest)

# Header: the minimum prelude clang/opt accept.  Matches the existing
# codegen.sprout choice ("unknown-unknown-unknown") so the two paths share
# a target spec.
fn ir_header() -> String =
  "; Generated by sprout ir_lowering.sprout (M1 PR 1.3)\ntarget triple = \"unknown-unknown-unknown\"\n\n"

# Synthetic C-ABI main shim.  PR 1.3 cannot lower the user's `main` body, so
# we emit a minimal `int main(int, char**) { return 0; }` so the linker
# accepts the module.  Later PRs will replace this with a real translation.
fn main_shim() -> String =
  "define i32 @main(i32 %argc, ptr %argv) {\nentry:\n  ret i32 0\n}\n"

# lower_program: top-level entry.  Returns the complete LLVM IR text.
export fn lower_program(prog: sprout_ir.IRProgram) -> String =
  match prog with
  | sprout_ir.IRProgram fns -> ir_header() ++ lower_fns(fns) ++ main_shim()
