module stdlib.compiler.ir_lowering
import stdlib.compiler.sprout_ir as sprout_ir

# LLVM string/char escaping (escape_char_for_ir / encode_str_for_ir / global len).
fn escape_char_for_ir(ch: Char) -> String =
  if s == "\\" then "\\5C"
  else if s == "\"" then "\\22"
  else if s == "\n" then "\\0A"
  else if s == "\r" then "\\0D"
  else if s == "\t" then "\\09"
  else s
  where s = char_to_string(ch)

fn encode_str_for_ir(s: String, i: Int, acc: String) -> String =
  if i >= str_len(s) then acc
  else
    match str_char_at(s, i) with
    | Nothing -> acc
    | Just ch -> encode_str_for_ir(s, i + 1, acc ++ escape_char_for_ir(ch))

# ---------------------------------------------------------------------------
# Sprout-IR → LLVM IR text lowering.
# ---------------------------------------------------------------------------
#
# Milestone 1, PR 1.5 (see docs/gc-rooting-model-c-plan-2026-06-02.md).
#
# Mechanical lowering of the scalar-program subset (IRConst, IRRet,
# IRIAdd/Sub/Mul/Cmp, IRBr/IRCondBr/IRPhi, IRCall) into textual LLVM.
# Produces enough boilerplate that `clang -x ir -` accepts the output and
# the linked binary can run.
#
# IRCall is rendered as
#   %r = call i64 @<fname>(i64 %a0, i64 %a1, ...)
# Every value is i64 (uniform ABI).  IRCall's IRType field is the return-value
# kind consumed by ir_rooting; lowering ignores it and always emits an i64 call
# with a result binding (no function returns void in this ABI).
#
# Calling convention: every IRFunction lowers to
#   `define <ret-ty> @<name>(i64 %p, ...)`
# where <ret-ty> is the LLVM return-type field of the IRFunction, which is
# "i64" for every function post /code-review fix #2 (Bool flows as i64 too
# — 0 or 1 in an i64 register). Each parameter is typed `i64`. A synthetic
# C-ABI `main` shim is
# appended unconditionally — for PR 1.4 it just returns 0 because we cannot
# yet lower the user's `main` body (which would typically call into IO).
#
# Prefix convention for IRPhi pairs (see sprout_ir.sprout): the value name
# arrives '%-prefixed already; the block label arrives bare and we prefix it
# here.  IRBr/IRCondBr likewise receive bare labels and prefix them here;
# the cond value-name on IRCondBr arrives '%-prefixed.
#
# This pass has no rooting decisions and no GC concerns: the supported ops
# operate purely on Int/Bool scalars.

# Render the [<value>, %<label>], [<value>, %<label>], ... portion of a phi.
fn lower_phi_pairs(pairs: List (String, String)) -> String =
  match pairs with
  | Nil -> ""
  | [p] ->
      match p with
      | (v, lbl) -> "[" ++ v ++ ", %" ++ lbl ++ "]"
  | Cons p rest ->
      match p with
      | (v, lbl) -> "[" ++ v ++ ", %" ++ lbl ++ "], " ++ lower_phi_pairs(rest)

# Render the comma-separated "i64 %a, i64 %b, ..." argument list of a call.
# PR 1.5 emits `i64` for every arg (only Int args are supported at this
# milestone; Bool args would need an explicit type tag).
fn lower_call_args(args: List String) -> String =
  match args with
  | Nil -> ""
  | [a] -> "i64 " ++ a
  | Cons a rest -> "i64 " ++ a ++ ", " ++ lower_call_args(rest)

# Render the ", i64 %a, i64 %b, ..." suffix appended after a leading "i64 <tag>"
# in an `@sprout_makeN` call.  Returns "" for 0-arity ctors (no extra args).
fn make_ctor_args_tail(args: List String) -> String =
  match args with
  | Nil -> ""
  | _ -> ", " ++ lower_call_args(args)

# Emit GEP+store pairs for each capture in an IRMkClosure env.
# raw_name: the local ptr name (e.g. "%t5$raw"); idx: 1-based slot index.
# FIX R4#2: slot temp names use "$slot$" (was "_slot_") so they cannot collide
# with any source-level identifier (Sprout's lexer rejects '$' in identifiers).
# Returns a String starting with "\n" for each pair, or "" if caps is empty.
# O(n) in number of captures.
fn mk_closure_cap_stores(caps: List String, raw_name: String, idx: Int) -> String =
  match caps with
  | Nil -> ""
  | Cons cap rest ->
      "\n  " ++ raw_name ++ "$slot$" ++ int_to_string(idx) ++
        " = getelementptr i64, ptr " ++ raw_name ++ ", i64 " ++ int_to_string(idx) ++ "\n" ++
      "  store i64 " ++ cap ++ ", ptr " ++ raw_name ++ "$slot$" ++ int_to_string(idx) ++
      mk_closure_cap_stores(rest, raw_name, idx + 1)

# Produce a comma-separated list of n "i64" tokens for a function-type signature.
# E.g. replicate_i64_csv(1) = "i64", replicate_i64_csv(3) = "i64, i64, i64".
# Used by IRApplyClosure to spell out the callee's type for opaque-pointer LLVM (15+).
# O(n).
fn replicate_i64_csv(n: Int) -> String =
  if n == 0 then ""
  else if n == 1 then "i64"
  else "i64, " ++ replicate_i64_csv(n - 1)

# Render a single IROp as one LLVM IR line (without trailing newline).
# str_table maps raw-ptr names (e.g. "%t0") introduced by IRStrConst to
# (global_name, byte_length) — populated by collect_str_consts before lowering.
# Emit the 4-line bitcast dance for a Double binary op.  Intermediate names are
# namespaced under the unique result name `r` (`r$la`, `r$lb`, `r$fr`), so they
# stay SSA-unique without a fresh-name counter.
fn lower_float_binop(r: String, inst: String, a: String, b: String) -> String =
  "  " ++ r ++ "$la = bitcast i64 " ++ a ++ " to double\n" ++
  "  " ++ r ++ "$lb = bitcast i64 " ++ b ++ " to double\n" ++
  "  " ++ r ++ "$fr = " ++ inst ++ " double " ++ r ++ "$la, " ++ r ++ "$lb\n" ++
  "  " ++ r ++ " = bitcast double " ++ r ++ "$fr to i64"

# B1: the SINGLE source of the VectorVal element-address computation. Emits the
# preamble producing %<r>$ep = &(((VectorVal*)v)->data[i]). Layout
# VectorVal { i64 len@0, i64 cap@8, i64* data@16 } — data is at i64-index 2; if the
# layout changes (e.g. a GC header word), fix the `i64 2` here and nowhere else.
fn vec_elem_addr_ir(r: String, v: String, i: String) -> String =
  "  " ++ r ++ "$vp = inttoptr i64 " ++ v ++ " to ptr\n" ++
  "  " ++ r ++ "$dp = getelementptr i64, ptr " ++ r ++ "$vp, i64 2\n" ++
  "  " ++ r ++ "$data = load ptr, ptr " ++ r ++ "$dp\n" ++
  "  " ++ r ++ "$ep = getelementptr i64, ptr " ++ r ++ "$data, i64 " ++ i

fn lower_op(op: sprout_ir.IROp, ret_ty: String, str_table: Dict (String, Int)) -> String =
  match op with
  | sprout_ir.IRConst name n -> "  " ++ name ++ " = add i64 0, " ++ int_to_string(n)
  | sprout_ir.IRRet name -> "  ret " ++ ret_ty ++ " " ++ name
  | sprout_ir.IRRetVoid -> "  ret void"
  | sprout_ir.IRIAdd r a b -> "  " ++ r ++ " = add i64 " ++ a ++ ", " ++ b
  | sprout_ir.IRISub r a b -> "  " ++ r ++ " = sub i64 " ++ a ++ ", " ++ b
  | sprout_ir.IRIMul r a b -> "  " ++ r ++ " = mul i64 " ++ a ++ ", " ++ b
  | sprout_ir.IRIDiv r a b -> "  " ++ r ++ " = sdiv i64 " ++ a ++ ", " ++ b
  # Float ops: operands are i64 bit-patterns — bitcast to double, apply the
  # instruction, bitcast the result back to i64 (uniform ABI, §7.1).
  | sprout_ir.IRFloatConst r text -> "  " ++ r ++ " = bitcast double " ++ text ++ " to i64"
  | sprout_ir.IRFAdd r a b -> lower_float_binop(r, "fadd", a, b)
  | sprout_ir.IRFSub r a b -> lower_float_binop(r, "fsub", a, b)
  | sprout_ir.IRFMul r a b -> lower_float_binop(r, "fmul", a, b)
  | sprout_ir.IRFDiv r a b -> lower_float_binop(r, "fdiv", a, b)
  # IRFCmp yields i1 (like IRICmp); the caller follows it with IRZextI1ToI64.
  | sprout_ir.IRFCmp r pred a b ->
      "  " ++ r ++ "$fa = bitcast i64 " ++ a ++ " to double\n" ++
      "  " ++ r ++ "$fb = bitcast i64 " ++ b ++ " to double\n" ++
      "  " ++ r ++ " = fcmp " ++ pred ++ " double " ++ r ++ "$fa, " ++ r ++ "$fb"
  | sprout_ir.IRFNeg r a ->
      "  " ++ r ++ "$fa = bitcast i64 " ++ a ++ " to double\n" ++
      "  " ++ r ++ "$fr = fneg double " ++ r ++ "$fa\n" ++
      "  " ++ r ++ " = bitcast double " ++ r ++ "$fr to i64"
  # to_double: the operand is a real i64 int, so convert first, then bitcast the
  # resulting double to its i64 bit-pattern (opposite bitcast side from IRFNeg).
  | sprout_ir.IRSIToF r a ->
      "  " ++ r ++ "$fr = sitofp i64 " ++ a ++ " to double\n" ++
      "  " ++ r ++ " = bitcast double " ++ r ++ "$fr to i64"
  | sprout_ir.IRBoolNot r a -> "  " ++ r ++ " = xor i64 " ++ a ++ ", 1"
  | sprout_ir.IRINeg r a -> "  " ++ r ++ " = sub i64 0, " ++ a
  | sprout_ir.IRLoadGlobal r name -> "  " ++ r ++ " = load i64, ptr @" ++ name
  | sprout_ir.IRStoreGlobal name v -> "  store i64 " ++ v ++ ", ptr @" ++ name
  # Uncaptured i64 call: register the global's slot as a permanent GC root.
  # The return value (always 0) is unused; LLVM accepts an unnamed call result.
  | sprout_ir.IRRegisterGlobalRoot name ->
      "  call i64 @sprout_gc_register_i64_root(ptr @" ++ name ++ ")"
  | sprout_ir.IRMakeTuple r args ->
      "  " ++ r ++ " = call i64 @sprout_alloc_tuple_blob(i64 " ++
        int_to_string(list_length(args) * 8) ++ ")\n" ++
      "  " ++ r ++ "$ptr = inttoptr i64 " ++ r ++ " to ptr\n" ++
      lower_tuple_stores(r, args, 0)
  | sprout_ir.IRGetTupleField r t idx _ ->
      "  " ++ r ++ "$ptr = inttoptr i64 " ++ t ++ " to ptr\n" ++
      "  " ++ r ++ "$gep = getelementptr i64, ptr " ++ r ++ "$ptr, i64 " ++ int_to_string(idx) ++ "\n" ++
      "  " ++ r ++ " = load i64, ptr " ++ r ++ "$gep"
  | sprout_ir.IRICmp r pred a b -> "  " ++ r ++ " = icmp " ++ pred ++ " i64 " ++ a ++ ", " ++ b
  | sprout_ir.IRBr lbl -> "  br label %" ++ lbl
  | sprout_ir.IRCondBr cond t e -> "  br i1 " ++ cond ++ ", label %" ++ t ++ ", label %" ++ e
  | sprout_ir.IRPhi r ty pairs -> "  " ++ r ++ " = phi " ++ ty ++ " " ++ lower_phi_pairs(pairs)
  | sprout_ir.IRCall r _kind fname args ->
      "  " ++ r ++ " = call i64 @" ++ fname ++ "(" ++ lower_call_args(args) ++ ")"
  # Tier-1 CPR peephole: unboxed { i64, i64 } extern call + two extractvalues.
  # The struct SSA (<tag>$st) is synthesized here — it never exists at IR level.
  # The callee is declared explicitly in ir_header() (the 10 `declare { i64, i64 }
  # @<fn>_unboxed` lines) — an implicit declaration from the call site is NOT
  # emitted; the C runtime provides `SproutUnboxed2 <fn>(long long, …)`
  # (ABI-identical to { i64, i64 }).
  | sprout_ir.IRCallUnboxed2 tag val _vk fname args ->
      "  " ++ tag ++ "$st = call { i64, i64 } @" ++ fname ++ "(" ++ lower_call_args(args) ++ ")\n" ++
      "  " ++ tag ++ " = extractvalue { i64, i64 } " ++ tag ++ "$st, 0\n" ++
      "  " ++ val ++ " = extractvalue { i64, i64 } " ++ tag ++ "$st, 1"
  # Tier-2 CPR worker return: pack (tag, val) into the { i64, i64 } ABI and
  # return by value.  `undef` seeds the aggregate; two insertvalues fill it.
  | sprout_ir.IRRetUnboxed2 base tag val ->
      "  " ++ base ++ "$r0 = insertvalue { i64, i64 } undef, i64 " ++ tag ++ ", 0\n" ++
      "  " ++ base ++ "$r1 = insertvalue { i64, i64 } " ++ base ++ "$r0, i64 " ++ val ++ ", 1\n" ++
      "  ret { i64, i64 } " ++ base ++ "$r1"
  | sprout_ir.IRStrConst r raw _ ->
      match dict_get(raw, str_table) with
      | Just entry ->
          match entry with
          | (gname, len) ->
              "  " ++ raw ++ " = getelementptr inbounds [" ++ int_to_string(len) ++
                " x i8], ptr " ++ gname ++ ", i64 0, i64 0\n" ++
              "  " ++ r ++ " = ptrtoint ptr " ++ raw ++ " to i64"
      | Nothing -> "  ; ERROR: missing str global for " ++ raw
  | sprout_ir.IRStrSlice r s start len ->
      "  " ++ r ++ " = call i64 @str_slice(i64 " ++ s ++ ", i64 " ++ start ++ ", i64 " ++ len ++ ")"
  | sprout_ir.IRStrConcat r a b ->
      "  " ++ r ++ " = call i64 @str_concat(i64 " ++ a ++ ", i64 " ++ b ++ ")"
  | sprout_ir.IRStrEq r a b ->
      # str_eq takes ptr/ptr; coerce both i64 String handles with inttoptr,
      # call @str_eq (returns i1), then zext to i64 (Bool ABI).
      # Mirrors direct codegen's emit_ptr_comparison (codegen.sprout ~2097).
      "  " ++ r ++ "$lptr = inttoptr i64 " ++ a ++ " to ptr\n" ++
      "  " ++ r ++ "$rptr = inttoptr i64 " ++ b ++ " to ptr\n" ++
      "  " ++ r ++ "$i1 = call i1 @str_eq(ptr " ++ r ++ "$lptr, ptr " ++ r ++ "$rptr)\n" ++
      "  " ++ r ++ " = zext i1 " ++ r ++ "$i1 to i64"
  | sprout_ir.IRStrCompare r pred a b ->
      # str_compare takes i64/i64 per the C signature (long long str_compare(long long, long long)).
      # Operands are already i64 String/Char handles — NO inttoptr needed.
      # Declare: `declare i64 @str_compare(i64, i64)` in ir_header().
      # The runtime returns -1/0/1; icmp <pred> against 0 gives the Bool i1;
      # zext to i64 produces the Bool ABI value.
      "  " ++ r ++ "$cmp = call i64 @str_compare(i64 " ++ a ++ ", i64 " ++ b ++ ")\n" ++
      "  " ++ r ++ "$i1 = icmp " ++ pred ++ " i64 " ++ r ++ "$cmp, 0\n" ++
      "  " ++ r ++ " = zext i1 " ++ r ++ "$i1 to i64"
  | sprout_ir.IRPrintStr r callee arg ->
      # print_str / eprint_str take `const char*`; coerce the i64 String/Char
      # handle to ptr (inttoptr) before the call.  Mirrors direct codegen's
      # emit_print_call / emit_eprint_call (codegen.sprout ~2484).
      "  " ++ r ++ "$ptr = inttoptr i64 " ++ arg ++ " to ptr\n" ++
      "  " ++ r ++ " = call i64 @" ++ callee ++ "(ptr " ++ r ++ "$ptr)"
  | sprout_ir.IRStrFromInt r n ->
      "  " ++ r ++ " = call i64 @int_to_string(i64 " ++ n ++ ")"
  | sprout_ir.IRMakeCtor r _ tag args ->
      # Mirrors codegen.sprout's boxed-ctor lowering:
      #   %r = call i64 @sprout_makeN(i64 <tag>, i64 %a0, i64 %a1, ...)
      # The ctor-name field is intentionally not emitted — the tag is the
      # only thing the runtime sees.  CPR-eligible ctors are rejected in
      # ast_to_ir; this op is BOXED ADTs only.
      "  " ++ r ++ " = call i64 @sprout_make" ++ int_to_string(list_length(args)) ++
        "(i64 " ++ int_to_string(tag) ++ make_ctor_args_tail(args) ++ ")"
  | sprout_ir.IRMkClosure r code_fn caps ->
      # sz = (num_captures + 1) * 8 bytes; slot 0 holds the code pointer.
      # r is the i64 closure handle — directly the return of sprout_alloc_closure_env.
      # FIX R4#2: derived SSA names use '$' separator (was '_') so they cannot
      # collide with any user-written identifier. '$' is rejected by Sprout's lexer.
      # SYNC WITH runtime/sprout_runtime.c sprout_alloc_closure_env:
      #   IR computes size = (n_caps + 1) * 8.
      #   Runtime computes slots = (size / 8) - 1 = n_caps.
      # Any layout change must update both formulas. (See also FIX R4#8.)
      "  " ++ r ++ " = call i64 @sprout_alloc_closure_env(i64 " ++
        int_to_string((list_length(caps) + 1) * 8) ++ ")\n" ++
      "  " ++ r ++ "$raw = inttoptr i64 " ++ r ++ " to ptr\n" ++
      "  store ptr @" ++ code_fn ++ ", ptr " ++ r ++ "$raw" ++
      mk_closure_cap_stores(caps, r ++ "$raw", 1)
  | sprout_ir.IRApplyClosure r callee args ->
      # env (the closure handle) is passed as the implicit first arg per M2 ABI.
      # Opaque-pointer LLVM (15+) requires the function type spelled out at each indirect call.
      # FIX R4#2: derived names use '$' separator.
      "  " ++ r ++ "$env_ptr = inttoptr i64 " ++ callee ++ " to ptr\n" ++
      "  " ++ r ++ "$code = load ptr, ptr " ++ r ++ "$env_ptr\n" ++
      "  " ++ r ++ " = call i64 (" ++ replicate_i64_csv(1 + list_length(args)) ++ ") " ++
        r ++ "$code(i64 " ++ callee ++ make_ctor_args_tail(args) ++ ")"
  | sprout_ir.IRLoadEnvSlot r env slot _ ->
      # kind field (FIX R4#7) is ignored at lowering — always emit load i64.
      # FIX R4#2: derived names use '$' separator.
      "  " ++ r ++ "$env_ptr = inttoptr i64 " ++ env ++ " to ptr\n" ++
      "  " ++ r ++ "$slot_ptr = getelementptr i64, ptr " ++ r ++ "$env_ptr, i64 " ++ int_to_string(slot) ++ "\n" ++
      "  " ++ r ++ " = load i64, ptr " ++ r ++ "$slot_ptr"
  | sprout_ir.IRRoot slot v discard ->
      "  " ++ slot ++ " = alloca i64\n" ++
      "  store i64 " ++ v ++ ", ptr " ++ slot ++ "\n" ++
      "  " ++ discard ++ " = call i64 @sprout_gc_push_i64_root(ptr " ++ slot ++ ")"
  | sprout_ir.IRUnroot n discard ->
      "  " ++ discard ++ " = call i64 @sprout_gc_pop_roots(i64 " ++ int_to_string(n) ++ ")"
  | sprout_ir.IRGetTag r s ->
      "  " ++ r ++ " = call i64 @sprout_tag(i64 " ++ s ++ ")"
  | sprout_ir.IRGetField r s i _kind ->
      "  " ++ r ++ " = call i64 @sprout_field(i64 " ++ s ++ ", i64 " ++ int_to_string(i) ++ ")"
  # B1 Vector-Double inline access. VectorVal { i64 len@0, i64 cap@8, i64* data@16 };
  # data lives at i64-index 2. Unchecked: ast_to_ir has already emitted the null +
  # bounds guard blocks that dominate these. Temps derive from the unique result SSA.
  | sprout_ir.IRVecLenD r v ->
      "  " ++ r ++ "$vp = inttoptr i64 " ++ v ++ " to ptr\n" ++
      "  " ++ r ++ " = load i64, ptr " ++ r ++ "$vp"
  | sprout_ir.IRVecGetD r v i ->
      vec_elem_addr_ir(r, v, i) ++ "\n" ++
      "  " ++ r ++ " = load i64, ptr " ++ r ++ "$ep"
  | sprout_ir.IRVecSetD r v i x ->
      vec_elem_addr_ir(r, v, i) ++ "\n" ++
      "  store i64 " ++ x ++ ", ptr " ++ r ++ "$ep\n" ++
      "  " ++ r ++ " = add i64 0, 0"
  | sprout_ir.IRAbortMatch ->
      "  call void @sprout_abort_match()\n  unreachable"
  # W7/F-DIV: reuses the existing `panic` builtin. The call result is unused
  # (panic is noreturn); the block ends with `unreachable`.
  | sprout_ir.IRPanic msg ->
      "  call i64 @panic(i64 " ++ msg ++ ")\n  unreachable"
  | sprout_ir.IRZextI1ToI64 r s ->
      "  " ++ r ++ " = zext i1 " ++ s ++ " to i64"
  | sprout_ir.IRTruncI64ToI1 r s ->
      "  " ++ r ++ " = trunc i64 " ++ s ++ " to i1"
  # TCO entry: alloca + store each param slot, then save the stack pointer.
  # Slot allocas precede the stacksave so the back-edge's stackrestore frees
  # per-iteration root allocas without freeing the slots.
  | sprout_ir.IRTcoEntry slots sp ->
      lower_tco_entry_slots(slots) ++ "  " ++ sp ++ " = call ptr @llvm.stacksave()"
  # TCO loop header: re-load a param from its slot (kind ignored at lowering).
  | sprout_ir.IRTcoLoad loaded ll slot _kind ->
      "  " ++ loaded ++ " = load " ++ ll ++ ", ptr " ++ slot
  # TCO back-edge: store new args into the slots, restore the stack (free the
  # iteration's root allocas), and branch back to the loop header.
  | sprout_ir.IRTcoBack stores sp loop_lbl ->
      lower_tco_back_stores(stores) ++
      "  call void @llvm.stackrestore(ptr " ++ sp ++ ")\n" ++
      "  br label %" ++ loop_lbl
  # Mutual tail call: [restore the enclosing self-TCO loop's stack if any], then a
  # guaranteed `musttail` jump immediately followed by `ret` of its value (musttail
  # requires nothing between the call and the ret).
  | sprout_ir.IRTailCall result callee args sp ->
      (if sp == "" then "" else "  call void @llvm.stackrestore(ptr " ++ sp ++ ")\n") ++
      "  " ++ result ++ " = musttail call i64 @" ++ callee ++ "(" ++ lower_call_args(args) ++ ")\n" ++
      "  ret i64 " ++ result

fn lower_ops(ops: List sprout_ir.IROp, ret_ty: String, str_table: Dict (String, Int)) -> String =
  match ops with
  | Nil -> ""
  | Cons op rest -> lower_op(op, ret_ty, str_table) ++ "\n" ++ lower_ops(rest, ret_ty, str_table)

fn lower_block(b: sprout_ir.IRBlock, ret_ty: String, str_table: Dict (String, Int)) -> String =
  match b with
  | sprout_ir.IRBlock label ops -> label ++ ":\n" ++ lower_ops(ops, ret_ty, str_table)

fn lower_blocks(bs: List sprout_ir.IRBlock, ret_ty: String, str_table: Dict (String, Int)) -> String =
  match bs with
  | Nil -> ""
  | Cons b rest -> lower_block(b, ret_ty, str_table) ++ lower_blocks(rest, ret_ty, str_table)

# Emit `alloca` + `store` for each TCO param slot.  Each line ends in '\n' so the
# trailing `stacksave` (appended by the caller) starts on its own line.
fn lower_tco_entry_slots(slots: List (String, String, String)) -> String =
  match slots with
  | Nil -> ""
  | Cons (slot, ty, in_name) rest ->
      "  " ++ slot ++ " = alloca " ++ ty ++ "\n" ++
      "  store " ++ ty ++ " " ++ in_name ++ ", ptr " ++ slot ++ "\n" ++
      lower_tco_entry_slots(rest)

# Emit a `store` of each new value into its TCO slot (back-edge).
fn lower_tco_back_stores(stores: List (String, String, String)) -> String =
  match stores with
  | Nil -> ""
  | Cons (slot, ty, newv) rest ->
      "  store " ++ ty ++ " " ++ newv ++ ", ptr " ++ slot ++ "\n" ++
      lower_tco_back_stores(rest)

# Emit per-element store instructions for an IRMakeTuple expansion.
fn lower_tuple_stores(blob_result: String, args: List String, idx: Int) -> String =
  match args with
  | Nil -> ""
  | Cons a rest ->
      "  " ++ blob_result ++ "$s" ++ int_to_string(idx) ++ " = getelementptr i64, ptr " ++ blob_result ++ "$ptr, i64 " ++ int_to_string(idx) ++ "\n" ++
      "  store i64 " ++ a ++ ", ptr " ++ blob_result ++ "$s" ++ int_to_string(idx) ++
      (if rest == Nil then "" else "\n") ++
      lower_tuple_stores(blob_result, rest, idx + 1)

# Build the comma-separated "i64 %a, i64 %b, ..." parameter list.
# Param kinds (IRType) are intentionally ignored at lowering — they only
# affect rooting decisions upstream of this pass; every param lowers to i64.
fn lower_params(params: List (String, sprout_ir.IRType)) -> String =
  match params with
  | Nil -> ""
  | [(p, _)] -> "i64 %" ++ p
  | Cons (p, _) rest -> "i64 %" ++ p ++ ", " ++ lower_params(rest)

export fn lower_fn_with_table(f: sprout_ir.IRFunction, fn_table: Dict (String, Int)) -> String =
  match f with
  | sprout_ir.IRFunction name params ret_ty blocks ->
      "define " ++ ret_ty ++ " @" ++ name ++ "(" ++ lower_params(params) ++ ") {\n" ++ lower_blocks(blocks, ret_ty, fn_table) ++ "}\n"

fn lower_fn(f: sprout_ir.IRFunction, fn_tables: Dict (Dict (String, Int))) -> String =
  match f with
  | sprout_ir.IRFunction name _ _ _ ->
      lower_fn_with_table(f, fn_table_for(name, fn_tables))

fn fn_table_for(name: String, fn_tables: Dict (Dict (String, Int))) -> Dict (String, Int) =
  match dict_get(name, fn_tables) with
  | Just t -> t
  | Nothing -> dict_empty()

fn lower_fns(fns: List sprout_ir.IRFunction, fn_tables: Dict (Dict (String, Int))) -> String =
  match fns with
  | Nil -> ""
  | Cons f rest -> lower_fn(f, fn_tables) ++ "\n" ++ lower_fns(rest, fn_tables)

# Header: the minimum prelude clang/opt accept.  Uses the
# "unknown-unknown-unknown" target triple; the runtime `declare`s below
# mirror the compiler-intrinsic signature table the runtime exports.
export fn ir_header() -> String =
  "; Generated by sprout ir_lowering.sprout (M2 PR 2.3)\n" ++
  "target triple = \"unknown-unknown-unknown\"\n" ++
  "declare i64 @str_concat(i64, i64)\n" ++
  # str_eq takes ptr/ptr and returns i1 (C: _Bool str_eq(const char*, const char*)).
  # Strings are passed as i64 in the uniform ABI; IRStrEq lowering coerces with inttoptr.
  "declare i1 @str_eq(ptr, ptr)\n" ++
  # str_compare takes i64/i64 and returns i64 (C: long long str_compare(long long, long long)).
  # Operands are already i64 String/Char handles — no inttoptr needed.
  # Returns -1/0/1; IRStrCompare lowering compares result to 0 with icmp <pred>.
  # Note: codegen.sprout's @str_compare(ptr,ptr) is a separate latent ABI bug (BACKLOG §1).
  "declare i64 @str_compare(i64, i64)\n" ++
  "declare i64 @str_slice(i64, i64, i64)\n" ++
  "declare i64 @int_to_string(i64)\n" ++
  # char_to_string: encodes an i64 Char codepoint to a UTF-8 String (heap ptr as i64).
  # Declared here so callers compiled via the IR path (e.g. prelude ToString Char,
  # print of a Char) link.
  "declare i64 @char_to_string(i64)\n" ++
  "declare i64 @sprout_gc_push_i64_root(ptr)\n" ++
  "declare i64 @sprout_gc_pop_roots(i64)\n" ++
  "declare i64 @sprout_gc_register_i64_root(ptr)\n" ++
  "declare i64 @sprout_alloc_closure_env(i64)\n" ++
  # Heap-allocate a raw i64-array blob for tuple storage (N * 8 bytes).
  # Called by IRMakeTuple lowering; one declaration covers all arities.
  "declare i64 @sprout_alloc_tuple_blob(i64)\n" ++
  # @sprout_register_ctor populates g_ctor_meta[] in the runtime so find_ctor(tag)
  # returns metadata and sprout_heap_child_count traces heap-typed fields during GC.
  # Called once per constructor in @main's entry block before any user code runs.
  "declare i64 @sprout_register_ctor(i64, ptr, i64, ptr)\n" ++
  "declare i64 @sprout_tag(i64)\n" ++
  "declare i64 @sprout_field(i64, i64)\n" ++
  "declare void @sprout_abort_match() noreturn\n" ++
  # W7/F-DIV: `panic` (long long panic(long long)) backs the IRPanic terminator
  # emitted by the `/` divide-by-zero guard.
  "declare i64 @panic(i64)\n" ++
  # Stack save/restore intrinsics for TCO loops (reset per-iteration root allocas).
  "declare ptr @llvm.stacksave()\n" ++
  "declare void @llvm.stackrestore(ptr)\n" ++
  # Boxed-ADT constructors.  Mirrors the sprout_make0..sprout_make9 set in
  # codegen.sprout (compiler intrinsic table).  All arities are declared
  # unconditionally — only the ones actually called are linked.
  # NOTE: arity cap of 9 mirrored in ast_to_ir.sprout's translate_boxed_ctor_call.
  # If you add more entries here, also lift the cap there.
  "declare i64 @sprout_make0(i64)\n" ++
  "declare i64 @sprout_make1(i64, i64)\n" ++
  "declare i64 @sprout_make2(i64, i64, i64)\n" ++
  "declare i64 @sprout_make3(i64, i64, i64, i64)\n" ++
  "declare i64 @sprout_make4(i64, i64, i64, i64, i64)\n" ++
  "declare i64 @sprout_make5(i64, i64, i64, i64, i64, i64)\n" ++
  "declare i64 @sprout_make6(i64, i64, i64, i64, i64, i64, i64)\n" ++
  "declare i64 @sprout_make7(i64, i64, i64, i64, i64, i64, i64, i64)\n" ++
  "declare i64 @sprout_make8(i64, i64, i64, i64, i64, i64, i64, i64, i64)\n" ++
  "declare i64 @sprout_make9(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64)\n" ++
  # Tier-1 CPR peephole: unboxed { i64, i64 } (SproutUnboxed2) variants of the
  # Maybe-returning externs.  Emitted by IRCallUnboxed2 when a `match` scrutinizes
  # one of these directly.  Arg signatures mirror the boxed externs' uniform-i64
  # ABI (env/regex pass a pointer in an i64 register — identical to the boxed
  # declares above them).  All 10 declared unconditionally; only the linked ones
  # are used.  Must stay in sync with unboxed_maybe_extern_name in ast_to_ir.sprout.
  "declare { i64, i64 } @vector_get_unboxed(i64, i64)\n" ++
  "declare { i64, i64 } @map_get_unboxed(i64, i64)\n" ++
  "declare { i64, i64 } @map_nth_key_unboxed(i64, i64)\n" ++
  "declare { i64, i64 } @map_nth_value_unboxed(i64, i64)\n" ++
  "declare { i64, i64 } @bytes_get_unboxed(i64, i64)\n" ++
  "declare { i64, i64 } @str_char_at_unboxed(i64, i64)\n" ++
  "declare { i64, i64 } @regex_find_range_unboxed(i64, i64)\n" ++
  "declare { i64, i64 } @argv_get_unboxed(i64)\n" ++
  "declare { i64, i64 } @env_get_unboxed(i64)\n" ++
  "declare { i64, i64 } @term_read_line_unboxed()\n" ++
  # IO builtins used by programs after M3 PR 11 (do-block support) lands.
  # print() dispatches by argument type (mirrors direct codegen's emit_print_call):
  #   String/Char -> @print_str(ptr) via IRPrintStr;  Int/Bool -> @print_value(i64)
  #   via a plain IRCall.  eprint() -> @eprint_str(ptr).  There is intentionally NO
  #   `@print` symbol — the prelude `extern fn print` is suppressed in
  #   is_hardcoded_intrinsic so lower_extern_decls does not emit a (runtime-absent)
  #   @print declare.  All three take the C signatures literally (ptr for const char*).
  # @argv_get is declared in prelude (extern fn argv_get(idx: Int) -> Maybe String !{IO})
  # and called by argv_get_loop; it is always reachable via prelude.
  # NOTE: @append is intentionally NOT declared here — it is a Semigroup typeclass
  # method that gets DEFINED (not declared) in user programs via instance resolution;
  # a blanket declare would conflict with the define in files that include Semigroup
  # instances (produces "invalid redefinition" in LLVM). Files that call @append
  # without a definition are a pre-existing typeclass dispatch gap (tracked in xfail).
  "declare i64 @print_str(ptr)\n" ++
  "declare i64 @print_value(i64)\n" ++
  "declare i64 @eprint_str(ptr)\n" ++
  "declare i64 @argv_get(i64)\n" ++
  # The C-ABI main shim stashes argc/argv into the runtime so argv_all()/
  # argv_get() work in typed-built binaries (mirrors direct codegen,
  # codegen.sprout:3093/:3350).  i32/ptr match the C signature.
  "declare i64 @sprout_set_argv(i32, ptr)\n" ++
  # int_range is declared as extern fn in prelude.sprout; the declare is also
  # hardcoded here so files that call the range syntax (1..N) without importing
  # prelude explicitly still link.  Listed in is_hardcoded_intrinsic to suppress
  # the duplicate emit from lower_extern_decls.
  "declare i64 @int_range(i64, i64)\n" ++
  # analysis_* intrinsics are runtime-implemented compiler bridge functions
  # (sprout_runtime.c).  They are NOT represented as TExternFnDecl in any user
  # source file — they are registered only via checker.sprout's analysis_entries()
  # and synthesised directly into call sites.  Without these declares the emitted
  # IR fails opt --passes=verify.  String args use `ptr` to match the C signature
  # (`const char*`) as declared in the runtime's compiler-intrinsic table.
  "declare i64 @analysis_check_source(ptr)\n" ++
  "declare i64 @analysis_declared_names_in_source(ptr)\n" ++
  "declare i64 @analysis_exported_names_in_source(ptr)\n" ++
  "declare i64 @analysis_symbol_inventory_in_source(ptr)\n" ++
  "declare i64 @analysis_diagnostics_in_source(ptr)\n" ++
  "declare i64 @analysis_symbol_locations_in_source(ptr)\n" ++
  "declare i64 @analysis_type_of_in_source(ptr, ptr)\n" ++
  "declare i64 @analysis_eval_expr_in_source(ptr, ptr)\n" ++
  "declare i64 @analysis_instances_in_source(ptr, ptr)\n" ++
  "declare i64 @analysis_complete_in_state(ptr, ptr, ptr)\n\n"

# M3 PR 14: emit `declare i64 @<name>(i64, …)` for each user `extern fn`,
# skipping any name that is already in the hardcoded ir_header list (LLVM
# rejects duplicate declarations) or defined as a user fn (an `extern fn`
# shadowed by a real define is a typeclass-instance pattern — let the define
# win).  Also skips `append` since it is a typeclass method (see ir_header
# comment).  Sprout's i64-uniform encoding means we emit i64 for every
# parameter regardless of source type.
export fn lower_extern_decls(externs: List (String, Int),
                             fns: List sprout_ir.IRFunction) -> String =
  lower_extern_decls_loop(externs, fns, set_empty(), "")

fn lower_extern_decls_loop(externs: List (String, Int),
                           fns: List sprout_ir.IRFunction,
                           seen: Set, acc: String) -> String =
  match externs with
  | Nil -> acc
  | Cons p rest ->
      match p with
      | (name, arity) ->
          if extern_already_declared(name, fns, seen) then
            lower_extern_decls_loop(rest, fns, seen, acc)
          else
            lower_extern_decls_loop(rest, fns, set_insert(name, seen),
              acc ++ "declare i64 @" ++ name ++ "(" ++ i64_params(arity) ++ ")\n")

# Skip an extern decl if: it's already in the hardcoded ir_header list, it's
# defined as a user IRFunction in the same module (the define wins), or this
# specific decl name was already emitted (the bundled module loader can
# include the same `extern fn` line via multiple importers).
fn extern_already_declared(name: String, fns: List sprout_ir.IRFunction, seen: Set) -> Bool =
  is_hardcoded_intrinsic(name) || has_fn_named(name, fns) || set_member(name, seen)

fn is_hardcoded_intrinsic(name: String) -> Bool =
  name == "str_concat" || name == "str_eq" || name == "str_compare" ||
  name == "str_slice" ||
  name == "int_to_string" || name == "char_to_string" ||
  name == "sprout_gc_push_i64_root" || name == "sprout_gc_pop_roots" ||
  name == "sprout_alloc_closure_env" || name == "sprout_alloc_tuple_blob" ||
  name == "sprout_register_ctor" || name == "sprout_tag" || name == "sprout_field" ||
  name == "sprout_abort_match" || name == "panic" ||
  name == "sprout_make0" || name == "sprout_make1" || name == "sprout_make2" ||
  name == "sprout_make3" || name == "sprout_make4" || name == "sprout_make5" ||
  name == "sprout_make6" || name == "sprout_make7" || name == "sprout_make8" ||
  name == "sprout_make9" ||
  name == "print" || name == "eprint" || name == "argv_get" ||
  name == "print_str" || name == "print_value" || name == "eprint_str" ||
  name == "append" ||
  name == "int_range" ||
  name == "analysis_check_source" || name == "analysis_declared_names_in_source" ||
  name == "analysis_exported_names_in_source" ||
  name == "analysis_symbol_inventory_in_source" ||
  name == "analysis_diagnostics_in_source" ||
  name == "analysis_symbol_locations_in_source" ||
  name == "analysis_type_of_in_source" || name == "analysis_eval_expr_in_source" ||
  name == "analysis_instances_in_source" || name == "analysis_complete_in_state"

fn i64_params(arity: Int) -> String =
  if arity == 0 then "" else i64_params_loop(arity - 1, "i64")

fn i64_params_loop(remaining: Int, acc: String) -> String =
  if remaining == 0 then acc else i64_params_loop(remaining - 1, acc ++ ", i64")

# ---------------------------------------------------------------------------
# Ctor-registration global-string collection pre-pass.
#
# For each CtorReg we emit two LLVM global string constants keyed by tag:
#   @.cname.<tag>  — the constructor's source-level name.
#   @.cfkinds.<tag> — the field-kinds string ('i','b','s','p','_' per field).
# These are consumed by the @sprout_register_ctor calls emitted in main_shim.
# Naming by tag (not name) avoids collisions across modules.

export fn collect_ctor_globals(regs: List sprout_ir.CtorReg) -> String =
  collect_ctor_globals_loop(regs, "")

fn collect_ctor_globals_loop(regs: List sprout_ir.CtorReg, acc: String) -> String =
  match regs with
  | Nil -> acc
  | Cons reg rest ->
      match reg with
      | sprout_ir.CtorReg name tag _ fkinds ->
          collect_ctor_globals_loop(rest, acc ++ emit_ctor_name_global(tag, name) ++
                                          emit_ctor_fkinds_global(tag, fkinds))

fn emit_ctor_name_global(tag: Int, name: String) -> String =
  "@.cname." ++ int_to_string(tag) ++ " = private unnamed_addr constant [" ++
    int_to_string(str_byte_len(name) + 1) ++ " x i8] c\"" ++
    encode_str_for_ir(name, 0, "") ++ "\\00\"\n"

fn emit_ctor_fkinds_global(tag: Int, fkinds: String) -> String =
  "@.cfkinds." ++ int_to_string(tag) ++ " = private unnamed_addr constant [" ++
    int_to_string(str_byte_len(fkinds) + 1) ++ " x i8] c\"" ++
    encode_str_for_ir(fkinds, 0, "") ++ "\\00\"\n"

# Emit one @sprout_register_ctor call for a single CtorReg.
# Shape (verbatim from legacy codegen.sprout:3222-3226):
#   %ptrN   = getelementptr inbounds [<NAME_LEN> x i8], ptr @.cname.<tag>, i64 0, i64 0
#   %fkptrN = getelementptr inbounds [<FKLEN> x i8], ptr @.cfkinds.<tag>, i64 0, i64 0
#   %regN   = call i64 @sprout_register_ctor(i64 <tag>, ptr %ptrN, i64 <arity>, ptr %fkptrN)
#
# SSA temp names are suffixed by <tag> rather than a per-call counter.  Tags
# are guaranteed unique-by-construction (sequential across all ADT ctors in
# program order), so this is self-protecting against future call-site changes.
fn emit_ctor_reg_call(reg: sprout_ir.CtorReg) -> String =
  match reg with
  | sprout_ir.CtorReg name tag arity fkinds ->
      emit_ctor_reg_call_body(name, tag, arity, fkinds)

# Inner helper: takes destructured fields explicitly so the `where` clause
# can bind SSA temp names against `tag`. (Function-scope `where` cannot see
# names introduced by an outer match arm's pattern bindings.)
fn emit_ctor_reg_call_body(name: String, tag: Int, arity: Int, fkinds: String) -> String =
  "  " ++ ptr_reg ++ " = getelementptr inbounds [" ++ int_to_string(str_byte_len(name) + 1) ++
    " x i8], ptr @.cname." ++ int_to_string(tag) ++ ", i64 0, i64 0\n" ++
  "  " ++ fkptr_reg ++ " = getelementptr inbounds [" ++ int_to_string(str_byte_len(fkinds) + 1) ++
    " x i8], ptr @.cfkinds." ++ int_to_string(tag) ++ ", i64 0, i64 0\n" ++
  "  " ++ reg_reg ++ " = call i64 @sprout_register_ctor(i64 " ++ int_to_string(tag) ++
    ", ptr " ++ ptr_reg ++ ", i64 " ++ int_to_string(arity) ++
    ", ptr " ++ fkptr_reg ++ ")\n"
  where ptr_reg = "%cname_ptr_" ++ int_to_string(tag)
        fkptr_reg = "%cfkinds_ptr_" ++ int_to_string(tag)
        reg_reg = "%creg_" ++ int_to_string(tag)

fn emit_ctor_reg_calls(regs: List sprout_ir.CtorReg) -> String =
  match regs with
  | Nil -> ""
  | Cons reg rest ->
      emit_ctor_reg_call(reg) ++ emit_ctor_reg_calls(rest)

# Synthetic C-ABI main shim.  Emits ctor registrations + optional init
# call + optional call to @__sprout_user_main (produced by ast_to_ir when
# the user's `fn main` body is non-trivial).
#
# IMPORTANT: @sprout_register_ctor calls must run BEFORE any user code in
# @main so the runtime's g_ctor_meta[] table is populated before any heap
# allocation or GC tracing can occur.
#
# M3 PR 11: has_user_main signals that ast_to_ir translated the user's
# `fn main` body into @__sprout_user_main.  The shim calls it after the
# ctor/init preamble.  A forward declare is emitted so the call type-checks
# even when @__sprout_user_main appears later in the output.
export fn main_shim(regs: List sprout_ir.CtorReg, has_init: Bool, has_user_main: Bool) -> String =
  "define i32 @main(i32 %argc, ptr %argv) {\nentry:\n" ++
    # Stash argc/argv into the runtime before any user code so argv_all()/
    # argv_get() work (mirrors direct codegen).  Allocates nothing, so its
    # position relative to the ctor registrations below does not matter.
    "  %argv_set = call i64 @sprout_set_argv(i32 %argc, ptr %argv)\n" ++
    emit_ctor_reg_calls(regs) ++
    init_call(has_init) ++
    user_main_call(has_user_main) ++
    "  ret i32 0\n}\n"

# Emit the call to @__sprout_user_main() when the user's fn main has a body.
# The call is i64 (all Sprout fns return i64); result is discarded.
fn user_main_call(has_user_main: Bool) -> String =
  if has_user_main then "  call i64 @__sprout_user_main()\n"
  else ""

# True if any IRFunction in the list has the given name.
# Used to detect whether ast_to_ir produced @__sprout_user_main.
# O(n) where n = number of functions.
fn has_fn_named(name: String, fns: List sprout_ir.IRFunction) -> Bool =
  match fns with
  | Nil -> false
  | Cons f rest ->
      match f with
      | sprout_ir.IRFunction fname _ _ _ ->
          if fname == name then true else has_fn_named(name, rest)

# Emit the @__sprout_init_globals() call after ctor registration, if there
# are any runtime-computed top-level lets to initialize.  M3 PR 5; mirrors
# codegen.sprout:3093-3095.
fn init_call(has_init: Bool) -> String =
  if has_init then "  call void @__sprout_init_globals()\n"
  else ""

# Emit the module-header global declarations for top-level lets.
# Each IRGlobalDecl produces ONE LLVM `@name = ...` line.  Const-eligible
# lets become `private constant`; runtime-computed lets become `global`
# with zeroinit and are populated by @__sprout_init_globals at startup.
# M3 PR 5; mirrors codegen.sprout:3950-3966.
export fn lower_globals(globals: List sprout_ir.IRGlobalDecl) -> String =
  match globals with
  | Nil -> ""
  | Cons g rest ->
      match g with
      | sprout_ir.IRGlobalDecl name lltype init_form ->
          (match init_form with
           | sprout_ir.GlobalConst ir_literal ->
               "@" ++ name ++ " = private constant " ++ lltype ++ " " ++ ir_literal ++ "\n"
           | sprout_ir.GlobalZeroInit ->
               "@" ++ name ++ " = global " ++ lltype ++ " zeroinitializer\n")
          ++ lower_globals(rest)

# True if any IRGlobalDecl in the list uses GlobalZeroInit (a runtime-let).
# Used by main_shim to decide whether to emit the init-fn call.
export fn any_runtime_global(globals: List sprout_ir.IRGlobalDecl) -> Bool =
  match globals with
  | Nil -> false
  | Cons g rest ->
      match g with
      | sprout_ir.IRGlobalDecl _ _ init_form ->
          (match init_form with
           | sprout_ir.GlobalZeroInit -> true
           | _ -> any_runtime_global(rest))

# String-constant collection pre-pass.  Walks every IRStrConst in document
# order, allocates @.str.K names, and produces:
#   - globals_text: the "@.str.K = private unnamed_addr constant ..." lines.
#   - fn_tables:    Dict fn_name (Dict raw_ptr (gname, byte_len)).  raw_ptr
#                   names are per-function ("%t0", ...) and would collide
#                   across functions if keyed flat, hence the outer Dict.
fn collect_str_consts(fns: List sprout_ir.IRFunction) -> (String, Dict (Dict (String, Int)), Int) =
  collect_str_consts_loop(fns, 0, "", dict_empty())

fn collect_str_consts_loop(fns: List sprout_ir.IRFunction, next_idx: Int,
                           globals_acc: String, tables_acc: Dict (Dict (String, Int))) ->
    (String, Dict (Dict (String, Int)), Int) =
  match fns with
  | Nil -> (globals_acc, tables_acc, next_idx)
  | Cons f rest ->
      match f with
      | sprout_ir.IRFunction name _ _ blocks ->
          match walk_blocks_for_strs(blocks, next_idx, globals_acc, dict_empty()) with
          | (gs2, idx2, fn_table) ->
              collect_str_consts_loop(rest, idx2, gs2,
                                      dict_set(name, fn_table, tables_acc))

export fn walk_blocks_for_strs(blocks: List sprout_ir.IRBlock, next_idx: Int,
                               globals_acc: String, fn_table: Dict (String, Int)) ->
    (String, Int, Dict (String, Int)) =
  match blocks with
  | Nil -> (globals_acc, next_idx, fn_table)
  | Cons b rest ->
      match b with
      | sprout_ir.IRBlock _ ops ->
          match walk_ops_for_strs(ops, next_idx, globals_acc, fn_table) with
          | (gs2, idx2, ft2) -> walk_blocks_for_strs(rest, idx2, gs2, ft2)

fn walk_ops_for_strs(ops: List sprout_ir.IROp, next_idx: Int,
                     globals_acc: String, fn_table: Dict (String, Int)) ->
    (String, Int, Dict (String, Int)) =
  match ops with
  | Nil -> (globals_acc, next_idx, fn_table)
  | Cons op rest ->
      match op with
      | sprout_ir.IRStrConst _ raw s ->
          match emit_str_global(next_idx, s) with
          | (decl, len, gname) ->
              walk_ops_for_strs(rest, next_idx + 1,
                                globals_acc ++ decl,
                                dict_set(raw, (gname, len), fn_table))
      | _ -> walk_ops_for_strs(rest, next_idx, globals_acc, fn_table)

export fn emit_str_global(idx: Int, s: String) -> (String, Int, String) =
  (gname ++ " = private unnamed_addr constant [" ++ int_to_string(len) ++
     " x i8] c\"" ++ body ++ "\"\n",
   len, gname)
  where gname = "@.str." ++ int_to_string(idx)
        body = encode_str_for_ir(s, 0, "") ++ "\\00"
        len = str_byte_len(s) + 1

# lower_program: top-level entry.  Returns the complete LLVM IR text.
export fn lower_program(prog: sprout_ir.IRProgram) -> String =
  match prog with
  | sprout_ir.IRProgram fns globals ctor_regs externs ->
      match collect_str_consts(fns) with
      | (str_globals_text, fn_tables, _) ->
          lower_program_body(fns, globals, ctor_regs, externs, str_globals_text, fn_tables)

fn lower_program_body(fns: List sprout_ir.IRFunction,
                      let_globals: List sprout_ir.IRGlobalDecl,
                      ctor_regs: List sprout_ir.CtorReg,
                      externs: List (String, Int),
                      str_globals_text: String,
                      fn_tables: Dict (Dict (String, Int))) -> String =
  ir_header() ++ extern_decls_text ++ str_globals_text ++ ctor_globals ++ let_globals_text ++
    (if str_globals_text == "" && ctor_globals == "" && let_globals_text == "" && extern_decls_text == "" then "" else "\n") ++
    lower_fns(fns, fn_tables) ++ main_shim(ctor_regs, any_runtime_global(let_globals),
                                            has_fn_named("__sprout_user_main", fns))
  where ctor_globals = collect_ctor_globals(ctor_regs)
        let_globals_text = lower_globals(let_globals)
        extern_decls_text = lower_extern_decls(externs, fns)
