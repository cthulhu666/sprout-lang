module stdlib.compiler.ir_lowering
import stdlib.compiler.sprout_ir as sprout_ir

# Duplicated from codegen.sprout (escape_char_for_ir / encode_str_for_ir / global len)
# — keep aligned with codegen.sprout: a fix here likely needs a matching change there.
fn escape_char_for_ir(ch: Char) -> String =
  if s == "\\" then "\\5C"
  else if s == "\"" then "\\22"
  else if s == "\n" then "\\0A"
  else if s == "\r" then "\\0D"
  else if s == "\t" then "\\09"
  else s
  where s = char_to_string(ch)

fn encode_str_for_ir(s: String, i: Int, acc: String) -> String =
  if i >= str_len(s) then acc
  else
    match str_char_at(s, i) with
    | Nothing -> acc
    | Just ch -> encode_str_for_ir(s, i + 1, acc ++ escape_char_for_ir(ch))

# ---------------------------------------------------------------------------
# Sprout-IR → LLVM IR text lowering.
# ---------------------------------------------------------------------------
#
# Milestone 1, PR 1.5 (see docs/gc-rooting-model-c-plan-2026-06-02.md).
#
# Mechanical lowering of the scalar-program subset (IRConst, IRRet,
# IRIAdd/Sub/Mul/Cmp, IRBr/IRCondBr/IRPhi, IRCall) into textual LLVM.
# Produces enough boilerplate that `clang -x ir -` accepts the output and
# the linked binary can run.
#
# IRCall is rendered as
#   %r = call <ret-ty> @<fname>(i64 %a0, i64 %a1, ...)
# Every argument is typed `i64` — PR 1.5 only handles Int arguments; if
# IRCall ever arrives with `ret-ty == "void"` (not expected at this PR,
# but tolerated defensively) we omit the result binding.
#
# Calling convention: every IRFunction lowers to
#   `define <ret-ty> @<name>(i64 %p, ...)`
# where <ret-ty> is the LLVM return-type field of the IRFunction ("i64" or
# "i1").  Each parameter is typed `i64`.  A synthetic C-ABI `main` shim is
# appended unconditionally — for PR 1.4 it just returns 0 because we cannot
# yet lower the user's `main` body (which would typically call into IO).
#
# Prefix convention for IRPhi pairs (see sprout_ir.sprout): the value name
# arrives '%-prefixed already; the block label arrives bare and we prefix it
# here.  IRBr/IRCondBr likewise receive bare labels and prefix them here;
# the cond value-name on IRCondBr arrives '%-prefixed.
#
# This pass has no rooting decisions and no GC concerns: the supported ops
# operate purely on Int/Bool scalars.

# Render the [<value>, %<label>], [<value>, %<label>], ... portion of a phi.
fn lower_phi_pairs(pairs: List (String, String)) -> String =
  match pairs with
  | Nil -> ""
  | Cons p Nil ->
      match p with
      | (v, lbl) -> "[" ++ v ++ ", %" ++ lbl ++ "]"
  | Cons p rest ->
      match p with
      | (v, lbl) -> "[" ++ v ++ ", %" ++ lbl ++ "], " ++ lower_phi_pairs(rest)

# Render the comma-separated "i64 %a, i64 %b, ..." argument list of a call.
# PR 1.5 emits `i64` for every arg (only Int args are supported at this
# milestone; Bool args would need an explicit type tag).
fn lower_call_args(args: List String) -> String =
  match args with
  | Nil -> ""
  | Cons a Nil -> "i64 " ++ a
  | Cons a rest -> "i64 " ++ a ++ ", " ++ lower_call_args(rest)

# Render the ", i64 %a, i64 %b, ..." suffix appended after a leading "i64 <tag>"
# in an `@sprout_makeN` call.  Returns "" for 0-arity ctors (no extra args).
fn make_ctor_args_tail(args: List String) -> String =
  match args with
  | Nil -> ""
  | _ -> ", " ++ lower_call_args(args)

# Render a single IROp as one LLVM IR line (without trailing newline).
# str_table maps raw-ptr names (e.g. "%t0") introduced by IRStrConst to
# (global_name, byte_length) — populated by collect_str_consts before lowering.
fn lower_op(op: sprout_ir.IROp, ret_ty: String, str_table: Dict (String, Int)) -> String =
  match op with
  | sprout_ir.IRConst name n -> "  " ++ name ++ " = add i64 0, " ++ int_to_string(n)
  | sprout_ir.IRRet name -> "  ret " ++ ret_ty ++ " " ++ name
  | sprout_ir.IRIAdd r a b -> "  " ++ r ++ " = add i64 " ++ a ++ ", " ++ b
  | sprout_ir.IRISub r a b -> "  " ++ r ++ " = sub i64 " ++ a ++ ", " ++ b
  | sprout_ir.IRIMul r a b -> "  " ++ r ++ " = mul i64 " ++ a ++ ", " ++ b
  | sprout_ir.IRICmp r pred a b -> "  " ++ r ++ " = icmp " ++ pred ++ " i64 " ++ a ++ ", " ++ b
  | sprout_ir.IRBr lbl -> "  br label %" ++ lbl
  | sprout_ir.IRCondBr cond t e -> "  br i1 " ++ cond ++ ", label %" ++ t ++ ", label %" ++ e
  | sprout_ir.IRPhi r ty pairs -> "  " ++ r ++ " = phi " ++ ty ++ " " ++ lower_phi_pairs(pairs)
  | sprout_ir.IRCall r call_ret_ty fname args ->
      if call_ret_ty == "void"
      then "  call void @" ++ fname ++ "(" ++ lower_call_args(args) ++ ")"
      else "  " ++ r ++ " = call " ++ call_ret_ty ++ " @" ++ fname ++ "(" ++ lower_call_args(args) ++ ")"
  | sprout_ir.IRStrConst r raw _ ->
      match dict_get(raw, str_table) with
      | Just entry ->
          match entry with
          | (gname, len) ->
              "  " ++ raw ++ " = getelementptr inbounds [" ++ int_to_string(len) ++
                " x i8], ptr " ++ gname ++ ", i64 0, i64 0\n" ++
              "  " ++ r ++ " = ptrtoint ptr " ++ raw ++ " to i64"
      | Nothing -> "  ; ERROR: missing str global for " ++ raw
  | sprout_ir.IRStrSlice r s start len ->
      "  " ++ r ++ " = call i64 @str_slice(i64 " ++ s ++ ", i64 " ++ start ++ ", i64 " ++ len ++ ")"
  | sprout_ir.IRStrConcat r a b ->
      "  " ++ r ++ " = call i64 @str_concat(i64 " ++ a ++ ", i64 " ++ b ++ ")"
  | sprout_ir.IRStrFromInt r n ->
      "  " ++ r ++ " = call i64 @int_to_string(i64 " ++ n ++ ")"
  | sprout_ir.IRMakeCtor r _ tag args ->
      # Mirrors codegen.sprout's boxed-ctor lowering:
      #   %r = call i64 @sprout_makeN(i64 <tag>, i64 %a0, i64 %a1, ...)
      # The ctor-name field is intentionally not emitted — the tag is the
      # only thing the runtime sees.  CPR-eligible ctors are rejected in
      # ast_to_ir; this op is BOXED ADTs only.
      "  " ++ r ++ " = call i64 @sprout_make" ++ int_to_string(list_length(args)) ++
        "(i64 " ++ int_to_string(tag) ++ make_ctor_args_tail(args) ++ ")"
  | sprout_ir.IRRoot slot v discard ->
      "  " ++ slot ++ " = alloca i64\n" ++
      "  store i64 " ++ v ++ ", ptr " ++ slot ++ "\n" ++
      "  " ++ discard ++ " = call i64 @sprout_gc_push_i64_root(ptr " ++ slot ++ ")"
  | sprout_ir.IRUnroot n discard ->
      "  " ++ discard ++ " = call i64 @sprout_gc_pop_roots(i64 " ++ int_to_string(n) ++ ")"

fn lower_ops(ops: List sprout_ir.IROp, ret_ty: String, str_table: Dict (String, Int)) -> String =
  match ops with
  | Nil -> ""
  | Cons op rest -> lower_op(op, ret_ty, str_table) ++ "\n" ++ lower_ops(rest, ret_ty, str_table)

fn lower_block(b: sprout_ir.IRBlock, ret_ty: String, str_table: Dict (String, Int)) -> String =
  match b with
  | sprout_ir.IRBlock label ops -> label ++ ":\n" ++ lower_ops(ops, ret_ty, str_table)

fn lower_blocks(bs: List sprout_ir.IRBlock, ret_ty: String, str_table: Dict (String, Int)) -> String =
  match bs with
  | Nil -> ""
  | Cons b rest -> lower_block(b, ret_ty, str_table) ++ lower_blocks(rest, ret_ty, str_table)

# Build the comma-separated "i64 %a, i64 %b, ..." parameter list.
fn lower_params(params: List String) -> String =
  match params with
  | Nil -> ""
  | Cons p Nil -> "i64 %" ++ p
  | Cons p rest -> "i64 %" ++ p ++ ", " ++ lower_params(rest)

fn lower_fn(f: sprout_ir.IRFunction, fn_tables: Dict (Dict (String, Int))) -> String =
  match f with
  | sprout_ir.IRFunction name params ret_ty blocks ->
      "define " ++ ret_ty ++ " @" ++ name ++ "(" ++ lower_params(params) ++ ") {\n" ++ lower_blocks(blocks, ret_ty, fn_table_for(name, fn_tables)) ++ "}\n"

fn fn_table_for(name: String, fn_tables: Dict (Dict (String, Int))) -> Dict (String, Int) =
  match dict_get(name, fn_tables) with
  | Just t -> t
  | Nothing -> dict_empty()

fn lower_fns(fns: List sprout_ir.IRFunction, fn_tables: Dict (Dict (String, Int))) -> String =
  match fns with
  | Nil -> ""
  | Cons f rest -> lower_fn(f, fn_tables) ++ "\n" ++ lower_fns(rest, fn_tables)

# Header: the minimum prelude clang/opt accept.  Matches the existing
# codegen.sprout choice ("unknown-unknown-unknown") so the two paths share
# a target spec.  Runtime declares duplicate codegen.sprout's compiler-intrinsic
# table — keep aligned with codegen.sprout.
fn ir_header() -> String =
  "; Generated by sprout ir_lowering.sprout (M2 PR 2.3)\n" ++
  "target triple = \"unknown-unknown-unknown\"\n" ++
  "declare i64 @str_concat(i64, i64)\n" ++
  "declare i64 @str_slice(i64, i64, i64)\n" ++
  "declare i64 @int_to_string(i64)\n" ++
  "declare i64 @sprout_gc_push_i64_root(ptr)\n" ++
  "declare i64 @sprout_gc_pop_roots(i64)\n" ++
  # Boxed-ADT constructors.  Mirrors the sprout_make0..sprout_make9 set in
  # codegen.sprout (compiler intrinsic table).  All arities are declared
  # unconditionally — only the ones actually called are linked.
  "declare i64 @sprout_make0(i64)\n" ++
  "declare i64 @sprout_make1(i64, i64)\n" ++
  "declare i64 @sprout_make2(i64, i64, i64)\n" ++
  "declare i64 @sprout_make3(i64, i64, i64, i64)\n" ++
  "declare i64 @sprout_make4(i64, i64, i64, i64, i64)\n" ++
  "declare i64 @sprout_make5(i64, i64, i64, i64, i64, i64)\n" ++
  "declare i64 @sprout_make6(i64, i64, i64, i64, i64, i64, i64)\n" ++
  "declare i64 @sprout_make7(i64, i64, i64, i64, i64, i64, i64, i64)\n" ++
  "declare i64 @sprout_make8(i64, i64, i64, i64, i64, i64, i64, i64, i64)\n" ++
  "declare i64 @sprout_make9(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64)\n\n"

# Synthetic C-ABI main shim.  PR 1.5 still cannot lower the user's `main`
# body in general (anything beyond `()` requires heap/IO ops that don't
# arrive until M2), so we emit a minimal `int main(int, char**) { return
# 0; }`.  The AST→IR translator rejects non-trivial `main` bodies so the
# user gets a clean Err rather than a silently no-op binary.
fn main_shim() -> String =
  "define i32 @main(i32 %argc, ptr %argv) {\nentry:\n  ret i32 0\n}\n"

# String-constant collection pre-pass.  Walks every IRStrConst in document
# order, allocates @.str.K names, and produces:
#   - globals_text: the "@.str.K = private unnamed_addr constant ..." lines.
#   - fn_tables:    Dict fn_name (Dict raw_ptr (gname, byte_len)).  raw_ptr
#                   names are per-function ("%t0", ...) and would collide
#                   across functions if keyed flat, hence the outer Dict.
fn collect_str_consts(fns: List sprout_ir.IRFunction) -> (String, Dict (Dict (String, Int)), Int) =
  collect_str_consts_loop(fns, 0, "", dict_empty())

fn collect_str_consts_loop(fns: List sprout_ir.IRFunction, next_idx: Int,
                           globals_acc: String, tables_acc: Dict (Dict (String, Int))) ->
    (String, Dict (Dict (String, Int)), Int) =
  match fns with
  | Nil -> (globals_acc, tables_acc, next_idx)
  | Cons f rest ->
      match f with
      | sprout_ir.IRFunction name _ _ blocks ->
          match walk_blocks_for_strs(blocks, next_idx, globals_acc, dict_empty()) with
          | (gs2, idx2, fn_table) ->
              collect_str_consts_loop(rest, idx2, gs2,
                                      dict_set(name, fn_table, tables_acc))

fn walk_blocks_for_strs(blocks: List sprout_ir.IRBlock, next_idx: Int,
                        globals_acc: String, fn_table: Dict (String, Int)) ->
    (String, Int, Dict (String, Int)) =
  match blocks with
  | Nil -> (globals_acc, next_idx, fn_table)
  | Cons b rest ->
      match b with
      | sprout_ir.IRBlock _ ops ->
          match walk_ops_for_strs(ops, next_idx, globals_acc, fn_table) with
          | (gs2, idx2, ft2) -> walk_blocks_for_strs(rest, idx2, gs2, ft2)

fn walk_ops_for_strs(ops: List sprout_ir.IROp, next_idx: Int,
                     globals_acc: String, fn_table: Dict (String, Int)) ->
    (String, Int, Dict (String, Int)) =
  match ops with
  | Nil -> (globals_acc, next_idx, fn_table)
  | Cons op rest ->
      match op with
      | sprout_ir.IRStrConst _ raw s ->
          match emit_str_global(next_idx, s) with
          | (decl, len, gname) ->
              walk_ops_for_strs(rest, next_idx + 1,
                                globals_acc ++ decl,
                                dict_set(raw, (gname, len), fn_table))
      | _ -> walk_ops_for_strs(rest, next_idx, globals_acc, fn_table)

fn emit_str_global(idx: Int, s: String) -> (String, Int, String) =
  (gname ++ " = private unnamed_addr constant [" ++ int_to_string(len) ++
     " x i8] c\"" ++ body ++ "\"\n",
   len, gname)
  where gname = "@.str." ++ int_to_string(idx)
        body = encode_str_for_ir(s, 0, "") ++ "\\00"
        len = str_byte_len(s) + 1

# lower_program: top-level entry.  Returns the complete LLVM IR text.
export fn lower_program(prog: sprout_ir.IRProgram) -> String =
  match prog with
  | sprout_ir.IRProgram fns ->
      match collect_str_consts(fns) with
      | (globals_text, fn_tables, _) ->
          ir_header() ++ globals_text ++ (if globals_text == "" then "" else "\n") ++
            lower_fns(fns, fn_tables) ++ main_shim()
