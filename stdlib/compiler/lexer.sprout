module stdlib.compiler.lexer
import stdlib.collections (Vec, vec_append, vec_empty)
import stdlib.string as string
import stdlib.compiler.source as source
import stdlib.compiler.token as token

fn cursor_position(cursor: source.SourceCursor) -> source.SourcePos =
  source.source_position(cursor)

fn cursor_index(cursor: source.SourceCursor) -> Int =
  source.position_index(cursor_position(cursor))

fn slice_between(raw: String, start: source.SourceCursor, end: source.SourceCursor) -> String =
  string.slice(raw, cursor_index(start), cursor_index(end) - cursor_index(start))

fn is_ident_continue(ch: Char) -> Bool =
  string.is_ident_continue(ch) || ch == '.'

fn advance_while(raw: String, cursor: source.SourceCursor, pred: Char -> Bool) -> source.SourceCursor =
  match source.peek_char(cursor) with
  | Just ch ->
      if pred(ch) then advance_while(raw, source.advance_char(cursor), pred)
      else cursor
  | Nothing -> cursor

fn scan_ident_end(raw: String, cursor: source.SourceCursor) -> source.SourceCursor =
  advance_while(raw, source.advance_char(cursor), is_ident_continue)

fn scan_int_end(raw: String, cursor: source.SourceCursor) -> source.SourceCursor =
  advance_while(raw, source.advance_char(cursor), string.is_ascii_digit)

fn skip_comment(raw: String, cursor: source.SourceCursor) -> source.SourceCursor =
  match source.peek_char(cursor) with
  | Just ch ->
      if ch == '\n' then cursor
      else skip_comment(raw, source.advance_char(cursor))
  | Nothing -> cursor

fn is_keyword(raw: String) -> Bool =
  raw == "export" ||
  raw == "fn" ||
  raw == "let" ||
  raw == "type" ||
  raw == "class" ||
  raw == "instance" ||
  raw == "where" ||
  raw == "match" ||
  raw == "with" ||
  raw == "do" ||
  raw == "if" ||
  raw == "then" ||
  raw == "else" ||
  raw == "true" ||
  raw == "false" ||
  raw == "extern"

fn single_symbol(ch: Char) -> Bool =
  string.contains("()=,:+-*/<>\\!{}[]|", string.string_from_char(ch))

fn emit_token(kind: token.TokenKind, raw: String, start: source.SourceCursor, end: source.SourceCursor) -> token.Token =
  token.Token(kind, slice_between(raw, start, end), cursor_position(start))

fn ident_token(raw: String, start: source.SourceCursor, end: source.SourceCursor) -> token.Token =
  ident_token_from_text(slice_between(raw, start, end), start)

fn ident_token_from_text(text: String, start: source.SourceCursor) -> token.Token =
  token.Token(
    if is_keyword(text) then token.TokenKeywordKind else token.TokenIdentKind,
    text,
    cursor_position(start)
  )

fn unexpected_char_error(ch: Char, cursor: source.SourceCursor) -> token.TokenizeError =
  token.TokenizeError(
    string.concat("Unexpected character ", string.string_from_char(ch)),
    cursor_position(cursor)
  )

# Maps an escape character (the char after \) to its decoded value.
# Returns Nothing only for \0 (explicitly rejected per Python tokenizer parity).
# All other unrecognised escapes fall back to the raw character.
fn decode_escape(ch: Char) -> Maybe Char =
  if ch == 'n' then Just('\n')
  else if ch == 'r' then Just('\r')
  else if ch == 't' then Just('\t')
  else if ch == '"' then Just('"')
  else if ch == '\'' then Just('\'')
  else if ch == '\\' then Just('\\')
  else if ch == '0' then Nothing
  else Just(ch)

# Reads one logical character from a char literal (plain char or \X escape).
# cursor is positioned at the first character to read.
# start_pos is the opening-quote position, used for error messages.
fn scan_one_char(cursor: source.SourceCursor, start_pos: source.SourcePos) -> Result token.TokenizeError (Char, source.SourceCursor) =
  match source.peek_char(cursor) with
  | Nothing -> Err(token.TokenizeError("Unterminated char literal", start_pos))
  | Just ch ->
      if ch == '\\' then
        match source.peek_char(source.advance_char(cursor)) with
        | Nothing -> Err(token.TokenizeError("Unterminated char literal", start_pos))
        | Just esc ->
            match decode_escape(esc) with
            | Nothing -> Err(token.TokenizeError("\\0 escape is not supported in char literals", start_pos))
            | Just decoded -> Ok((decoded, source.advance_char(source.advance_char(cursor))))
      else Ok((ch, source.advance_char(cursor)))

# Scans the body of a char literal (cursor is past the opening ').
# Returns the single decoded Char and the cursor past the closing '.
fn scan_char_content(cursor: source.SourceCursor, start_pos: source.SourcePos) -> Result token.TokenizeError (Char, source.SourceCursor) =
  match scan_one_char(cursor, start_pos) with
  | Err e -> Err(e)
  | Ok (ch, after_char) ->
      match source.peek_char(after_char) with
      | Nothing -> Err(token.TokenizeError("Unterminated char literal", start_pos))
      | Just close ->
          if close == '\'' then Ok((ch, source.advance_char(after_char)))
          else Err(token.TokenizeError("Char literal must contain exactly one character", start_pos))

# Scans a string body (cursor is past the opening ").
# acc accumulates decoded characters in reverse order (Cons at head).
# Returns the decoded string content and the cursor past the closing ".
fn scan_string_content(cursor: source.SourceCursor, start_pos: source.SourcePos, acc: List String) -> Result token.TokenizeError (String, source.SourceCursor) =
  match source.peek_char(cursor) with
  | Nothing -> Err(token.TokenizeError("Unterminated string literal", start_pos))
  | Just ch ->
      if ch == '"' then Ok((string_concat_many(list_reverse(acc)), source.advance_char(cursor)))
      else if ch == '\\' then
        match source.peek_char(source.advance_char(cursor)) with
        | Nothing -> Err(token.TokenizeError("Unterminated string literal", start_pos))
        | Just esc ->
            match decode_escape(esc) with
            | Nothing -> Err(token.TokenizeError("\\0 escape is not supported in string literals", start_pos))
            | Just decoded ->
                scan_string_content(
                  source.advance_char(source.advance_char(cursor)),
                  start_pos,
                  Cons(string.string_from_char(decoded), acc)
                )
      else
        scan_string_content(
          source.advance_char(cursor),
          start_pos,
          Cons(string.string_from_char(ch), acc)
        )

# Decodes a template escape (the char after \).
# Recognised: \` -> ` , \${ -> $ (only \ before $ is special for \${),
# \n, \t, \\. Unknown escapes fall back to the raw character.
fn decode_template_escape(ch: Char, cursor_after_ch: source.SourceCursor) -> (String, source.SourceCursor) =
  if ch == '`' then ("`", cursor_after_ch)
  else if ch == '$' then ("$", cursor_after_ch)
  else if ch == 'n' then ("\n", cursor_after_ch)
  else if ch == 't' then ("\t", cursor_after_ch)
  else if ch == '\\' then ("\\", cursor_after_ch)
  else (string.string_from_char(ch), cursor_after_ch)

# Emits a TEMPLATE_LIT token if acc is non-empty, otherwise nothing.
# acc is in reverse order (built via Cons); reversed and joined here.
fn flush_template_lit(acc: List String, start_pos: source.SourcePos, toks: List token.Token) -> List token.Token =
  match acc with
  | Nil -> toks
  | _ -> Cons(token.Token(token.TokenTemplateLit, string_concat_many(list_reverse(acc)), start_pos), toks)

# Scans inside ${ ... } (the interpolation body) at the given brace depth.
# cursor is positioned right after ${.
# start_pos is the position of ${ (for error messages).
# toks_acc is the reversed token accumulator.
# Returns Ok((reversed_tok_list_including_INTERP_END, cursor_after_close_brace))
# or Err on unterminated interp.
fn scan_interp_body(raw: String, cursor: source.SourceCursor, start_pos: source.SourcePos, depth: Int, toks_acc: List token.Token) -> Result token.TokenizeError (List token.Token, source.SourceCursor) =
  match source.peek_char(cursor) with
  | Nothing -> Err(token.TokenizeError("Unterminated template interpolation", start_pos))
  | Just ch ->
      if ch == '}' then
        if depth == 0 then
          Ok((Cons(token.Token(token.TokenTemplateInterpEnd, "}", cursor_position(cursor)), toks_acc), source.advance_char(cursor)))
        else
          scan_interp_body(raw, source.advance_char(cursor), start_pos, depth - 1,
            Cons(emit_token(token.TokenSymbolKind, raw, cursor, source.advance_char(cursor)), toks_acc))
      else if ch == '{' then
        scan_interp_body(raw, source.advance_char(cursor), start_pos, depth + 1,
          Cons(emit_token(token.TokenSymbolKind, raw, cursor, source.advance_char(cursor)), toks_acc))
      else if ch == '`' then
        # Nested template: emit TEMPLATE_START then recurse into scan_template_content.
        scan_nested_template(raw, cursor, start_pos, depth, toks_acc)
      else if string.is_ascii_whitespace(ch) then
        scan_interp_body(raw, source.advance_char(cursor), start_pos, depth, toks_acc)
      else if ch == '#' then
        scan_interp_body(raw, skip_comment(raw, source.advance_char(cursor)), start_pos, depth, toks_acc)
      else
        match try_multi_char_symbol(cursor) with
        | Just next ->
            scan_interp_body(raw, next, start_pos, depth,
              Cons(emit_token(token.TokenSymbolKind, raw, cursor, next), toks_acc))
        | Nothing ->
            if string.is_ident_start(ch) then
              match scan_ident_next(raw, cursor) with
              | (next, tok) -> scan_interp_body(raw, next, start_pos, depth, Cons(tok, toks_acc))
            else if string.is_ascii_digit(ch) then
              match scan_int_next(raw, cursor) with
              | (next, tok) -> scan_interp_body(raw, next, start_pos, depth, Cons(tok, toks_acc))
            else if ch == '"' then
              match scan_string_next(cursor, cursor_position(cursor)) with
              | Err e -> Err(e)
              | Ok (next, tok) -> scan_interp_body(raw, next, start_pos, depth, Cons(tok, toks_acc))
            else if ch == '\'' then
              match scan_char_next(cursor, cursor_position(cursor)) with
              | Err e -> Err(e)
              | Ok (next, tok) -> scan_interp_body(raw, next, start_pos, depth, Cons(tok, toks_acc))
            else if single_symbol(ch) then
              scan_interp_body(raw, source.advance_char(cursor), start_pos, depth,
                Cons(emit_token(token.TokenSymbolKind, raw, cursor, source.advance_char(cursor)), toks_acc))
            else
              Err(unexpected_char_error(ch, cursor))

# Helper for nested template inside ${...}.
fn scan_nested_template(raw: String, cursor: source.SourceCursor, outer_start_pos: source.SourcePos, depth: Int, toks_acc: List token.Token) -> Result token.TokenizeError (List token.Token, source.SourceCursor) =
  scan_nested_template_with_start(raw, cursor, cursor_position(cursor), outer_start_pos, depth, toks_acc)

fn scan_nested_template_with_start(raw: String, cursor: source.SourceCursor, templ_start_pos: source.SourcePos, outer_start_pos: source.SourcePos, depth: Int, toks_acc: List token.Token) -> Result token.TokenizeError (List token.Token, source.SourceCursor) =
  match scan_template_content(raw, source.advance_char(cursor), templ_start_pos, Nil, templ_start_pos,
      Cons(token.Token(token.TokenTemplateStart, "`", templ_start_pos), toks_acc)) with
  | Err e -> Err(e)
  | Ok (toks2, cursor2) ->
      scan_interp_body(raw, cursor2, outer_start_pos, depth, toks2)

# Scans the body of a template literal (cursor is past the opening `).
# lit_acc accumulates decoded literal segments in reverse order (built via Cons).
# lit_start is the position where the current literal segment started.
# toks_acc is the reversed token accumulator (TEMPLATE_START already prepended).
# Returns Ok((full_reversed_tok_list, cursor_past_closing_`))
fn scan_template_content(raw: String, cursor: source.SourceCursor, start_pos: source.SourcePos, lit_acc: List String, lit_start: source.SourcePos, toks_acc: List token.Token) -> Result token.TokenizeError (List token.Token, source.SourceCursor) =
  match source.peek_char(cursor) with
  | Nothing -> Err(token.TokenizeError("Unterminated template literal", start_pos))
  | Just ch ->
      if ch == '`' then
        # End of template: flush lit, emit TEMPLATE_END, done.
        Ok((Cons(token.Token(token.TokenTemplateEnd, "`", cursor_position(cursor)),
                 flush_template_lit(lit_acc, lit_start, toks_acc)),
            source.advance_char(cursor)))
      else if ch == '$' then
        scan_template_dollar(raw, cursor, start_pos, lit_acc, lit_start, toks_acc)
      else if ch == '\\' then
        scan_template_escape(raw, cursor, start_pos, lit_acc, lit_start, toks_acc)
      else
        scan_template_content(raw, source.advance_char(cursor), start_pos,
          Cons(string.string_from_char(ch), lit_acc), lit_start, toks_acc)

# Handle $ in template: either ${ (interp start) or bare $ (literal).
fn scan_template_dollar(raw: String, cursor: source.SourceCursor, start_pos: source.SourcePos, lit_acc: List String, lit_start: source.SourcePos, toks_acc: List token.Token) -> Result token.TokenizeError (List token.Token, source.SourceCursor) =
  match source.peek_char(source.advance_char(cursor)) with
  | Nothing ->
      scan_template_content(raw, source.advance_char(cursor), start_pos,
        Cons("$", lit_acc), lit_start, toks_acc)
  | Just c ->
      if c == '{' then
        scan_template_interp_start(raw, cursor, start_pos, lit_acc, lit_start, toks_acc)
      else
        scan_template_content(raw, source.advance_char(cursor), start_pos,
          Cons("$", lit_acc), lit_start, toks_acc)

# cursor is at '$', next char is '{'. Flush lit, emit INTERP_START, enter body.
fn scan_template_interp_start(raw: String, cursor: source.SourceCursor, start_pos: source.SourcePos, lit_acc: List String, lit_start: source.SourcePos, toks_acc: List token.Token) -> Result token.TokenizeError (List token.Token, source.SourceCursor) =
  scan_template_interp_body(
    raw,
    source.advance_char(source.advance_char(cursor)),
    start_pos,
    cursor_position(cursor),
    Cons(token.Token(token.TokenTemplateInterpStart, "${", cursor_position(cursor)),
         flush_template_lit(lit_acc, lit_start, toks_acc))
  )

fn scan_template_interp_body(raw: String, cursor_after_brace: source.SourceCursor, start_pos: source.SourcePos, interp_start: source.SourcePos, toks2: List token.Token) -> Result token.TokenizeError (List token.Token, source.SourceCursor) =
  match scan_interp_body(raw, cursor_after_brace, interp_start, 0, toks2) with
  | Err e -> Err(e)
  | Ok (toks3, cursor2) ->
      scan_template_content(raw, cursor2, start_pos, Nil, cursor_position(cursor2), toks3)

# Handle \ in template: decode escape and continue.
fn scan_template_escape(raw: String, cursor: source.SourceCursor, start_pos: source.SourcePos, lit_acc: List String, lit_start: source.SourcePos, toks_acc: List token.Token) -> Result token.TokenizeError (List token.Token, source.SourceCursor) =
  match source.peek_char(source.advance_char(cursor)) with
  | Nothing -> Err(token.TokenizeError("Unterminated template literal", start_pos))
  | Just esc ->
      match decode_template_escape(esc, source.advance_char(source.advance_char(cursor))) with
      | (decoded_str, next_cursor) ->
          scan_template_content(raw, next_cursor, start_pos,
            Cons(decoded_str, lit_acc), lit_start, toks_acc)

# Tries each operator string in order, returning the cursor past the first match.
fn try_ops(cursor: source.SourceCursor, ops: List String) -> Maybe source.SourceCursor =
  match ops with
  | Nil -> Nothing
  | Cons op rest ->
      match source.match_string(op, cursor) with
      | Just c -> Just(c)
      | Nothing -> try_ops(cursor, rest)

# Tries all multi-char operators in Python-matching priority order.
fn try_multi_char_symbol(cursor: source.SourceCursor) -> Maybe source.SourceCursor =
  try_ops(cursor, ["->", "<-", "==", "!=", "<=", ">=", "&&", "||", ">>", "<<", "|>", "++", ".."])

fn scan_ident_next(raw: String, cursor: source.SourceCursor) -> (source.SourceCursor, token.Token) =
  (end_cursor, ident_token(raw, cursor, end_cursor))
where
  end_cursor = scan_ident_end(raw, cursor)

fn scan_int_next(raw: String, cursor: source.SourceCursor) -> (source.SourceCursor, token.Token) =
  (end_cursor, emit_token(token.TokenIntKind, raw, cursor, end_cursor))
where
  end_cursor = scan_int_end(raw, cursor)

fn scan_string_next(cursor: source.SourceCursor, start_pos: source.SourcePos) -> Result token.TokenizeError (source.SourceCursor, token.Token) =
  match scan_string_content(source.advance_char(cursor), start_pos, Nil) with
  | Err e -> Err(e)
  | Ok (text, next) -> Ok((next, token.Token(token.TokenStringKind, text, start_pos)))

fn scan_char_next(cursor: source.SourceCursor, start_pos: source.SourcePos) -> Result token.TokenizeError (source.SourceCursor, token.Token) =
  match scan_char_content(source.advance_char(cursor), start_pos) with
  | Err e -> Err(e)
  | Ok (lit_ch, next) -> Ok((next, token.Token(token.TokenCharKind, string.string_from_char(lit_ch), start_pos)))

fn scan_template_from(raw: String, cursor: source.SourceCursor, acc: List token.Token) -> Result token.TokenizeError (List token.Token) =
  scan_template_from_with_pos(raw, cursor, cursor_position(cursor), acc)

fn scan_template_from_with_pos(raw: String, cursor: source.SourceCursor, templ_start_pos: source.SourcePos, acc: List token.Token) -> Result token.TokenizeError (List token.Token) =
  match scan_template_content(raw, source.advance_char(cursor), templ_start_pos, Nil, templ_start_pos,
      Cons(token.Token(token.TokenTemplateStart, "`", templ_start_pos), acc)) with
  | Err e -> Err(e)
  | Ok (toks, next) -> tokenize_from(raw, next, toks)

fn tokenize_from(raw: String, cursor: source.SourceCursor, acc: List token.Token) -> Result token.TokenizeError (List token.Token) =
  match source.peek_char(cursor) with
  | Nothing -> Ok(Cons(token.eof_token(cursor_position(cursor)), acc))
  | Just ch ->
      if string.is_ascii_whitespace(ch) then
        tokenize_from(raw, source.advance_char(cursor), acc)
      else if ch == '#' then
        tokenize_from(raw, skip_comment(raw, source.advance_char(cursor)), acc)
      else
        match try_multi_char_symbol(cursor) with
        | Just next ->
            tokenize_from(raw, next, Cons(emit_token(token.TokenSymbolKind, raw, cursor, next), acc))
        | Nothing ->
            if string.is_ident_start(ch) then
              match scan_ident_next(raw, cursor) with
              | (next, tok) -> tokenize_from(raw, next, Cons(tok, acc))
            else if string.is_ascii_digit(ch) then
              match scan_int_next(raw, cursor) with
              | (next, tok) -> tokenize_from(raw, next, Cons(tok, acc))
            else if ch == '"' then
              match scan_string_next(cursor, cursor_position(cursor)) with
              | Err e -> Err(e)
              | Ok (next, tok) -> tokenize_from(raw, next, Cons(tok, acc))
            else if ch == '\'' then
              match scan_char_next(cursor, cursor_position(cursor)) with
              | Err e -> Err(e)
              | Ok (next, tok) -> tokenize_from(raw, next, Cons(tok, acc))
            else if ch == '`' then
              scan_template_from(raw, cursor, acc)
            else if single_symbol(ch) then
              tokenize_from(raw, source.advance_char(cursor), Cons(emit_token(token.TokenSymbolKind, raw, cursor, source.advance_char(cursor)), acc))
            else
              Err(unexpected_char_error(ch, cursor))

export fn tokenize(raw: String) -> Result token.TokenizeError (Vec token.Token) =
  match tokenize_from(raw, source.cursor_from_string(raw), Nil) with
  | Err e -> Err(e)
  | Ok lst -> Ok(vec_from_list(list_reverse(lst)))
