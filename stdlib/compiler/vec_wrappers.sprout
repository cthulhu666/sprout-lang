module stdlib.compiler.vec_wrappers
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.ast as ast
import stdlib.compiler.type_kind as type_kind

# Vector-access wrappers, shared by `bce` (loop versioning) and `wsi` (wrapper store inline).
#
# A wrapper is an unconstrained function whose whole body is one `vector_get_direct` or
# `vector_mutset` call over its own parameters: each used once, in order, with only
# projections (pure one-field reads), small literals and sums or products in between. So
# substituting a call's arguments for the parameters neither repeats, drops nor reorders an
# argument, and the only extra steps are projection calls. `Wrapper` records that shape;
# `apply_wrapper` instantiates it at a call.

# ---------------------------------------------------------------------------
# Accesses and the wrappers that reduce to one.
# ---------------------------------------------------------------------------

# An access with its operands in terms of the enclosing function.
export type Shape (..) = (is_set: Bool, vec: typed_ast.TypedExpr, idx: typed_ast.TypedExpr,
                   val: Maybe typed_ast.TypedExpr)

# A function whose whole body is one access over its own parameters, each used
# once and in order, so inlining it neither repeats nor drops an argument.
export type Wrapper (..) = (params: List String, shape: Shape)

export fn is_pure_decl(eff: Maybe (List String)) -> Bool =
  match eff with
  | Nothing -> true
  | Just es -> list_length(es) == 0

# `match v with | C x -> x` or `v.field`: a read of one field of an immutable value.
fn is_projection(d: typed_ast.TypedDecl) -> Bool =
  match d with
  | typed_ast.TFnDecl _ [ast.Param p _ _] _ eff _ body -> is_pure_decl(eff) && projects(p, body)
  | _ -> false

fn projects(p: String, body: typed_ast.TypedExpr) -> Bool =
  match body with
  | typed_ast.TMatch scrut [typed_ast.TypedMatchBranch pat arm] _ _ ->
      typed_ast.is_var(p, scrut) && is_field_pattern(pat, arm)
  | typed_ast.TGetField obj _ _ _ -> typed_ast.is_var(p, obj)
  | _ -> false

fn is_field_pattern(pat: ast.Pattern, arm: typed_ast.TypedExpr) -> Bool =
  match pat with
  | ast.ConstructorPattern _ [ast.VarPattern x _] _ -> typed_ast.is_var(x, arm)
  | _ -> false

fn decl_projection_name(d: typed_ast.TypedDecl) -> Maybe String =
  match d with
  | typed_ast.TFnDecl name _ _ _ _ _ -> if is_projection(d) then Just(name) else Nothing
  | _ -> Nothing

# Operands a wrapper may pass on: its parameters, small literals, sums and
# products of those, and projections of them.
fn operand_ok(e: typed_ast.TypedExpr, projs: Set) -> Bool =
  match e with
  | typed_ast.TVar _ _ _ -> true
  | typed_ast.TInt _ _ _ -> true
  | typed_ast.TBinary op l r _ _ ->
      (op == "+" || op == "-" || op == "*") && operand_ok(l, projs) && operand_ok(r, projs)
  | typed_ast.TCall (typed_ast.TVar g _ _) [x] _ _ -> set_member(g, projs) && operand_ok(x, projs)
  | _ -> false

# Parameter names in the order the operands mention them.
fn mentions(e: typed_ast.TypedExpr, acc: List String) -> List String =
  match e with
  | typed_ast.TVar n _ _ -> Cons(n, acc)
  | typed_ast.TBinary _ l r _ _ -> mentions(r, mentions(l, acc))
  | typed_ast.TCall _ args _ _ -> list_fold(\ (a, x) -> mentions(x, a), acc, args)
  | _ -> acc

fn names_in_order(es: List typed_ast.TypedExpr) -> List String =
  list_reverse(list_fold(\ (a, x) -> mentions(x, a), Nil, es))

fn wrapper_of(d: typed_ast.TypedDecl, projs: Set) -> Maybe (String, Wrapper) =
  match d with
  | typed_ast.TFnDecl name params _ _ Nil (typed_ast.TCall(typed_ast.TVar callee _ _) cargs _ _) ->
      wrapper_from(name, ast.param_names(params), callee, cargs, projs)
  | _ -> Nothing

fn wrapper_from(name: String, pnames: List String, callee: String,
                cargs: List typed_ast.TypedExpr, projs: Set) -> Maybe (String, Wrapper) =
  if !all(operand_ok(_, projs), cargs) || names_in_order(cargs) != pnames then Nothing
  else
    match direct_shape(callee, cargs) with
    | Just shape -> Just((name, Wrapper(params = pnames, shape = shape)))
    | Nothing -> Nothing

# `vector_get_direct` and `vector_mutset` are externs, so their names are bare and
# cannot belong to a user function.
export fn direct_shape(callee: String, args: List typed_ast.TypedExpr) -> Maybe Shape =
  if callee == "vector_get_direct" then get_shape(args)
  else if callee == "vector_mutset" then set_shape(args)
  else Nothing

fn get_shape(args: List typed_ast.TypedExpr) -> Maybe Shape =
  match args with
  | [v, i] -> Just (Shape(is_set = false, vec = v, idx = i, val = Nothing))
  | _ -> Nothing

fn set_shape(args: List typed_ast.TypedExpr) -> Maybe Shape =
  match args with
  | [v, i, x] -> Just (Shape(is_set = true, vec = v, idx = i, val = Just(x)))
  | _ -> Nothing

fn subst(e: typed_ast.TypedExpr, env: Dict typed_ast.TypedExpr) -> typed_ast.TypedExpr =
  match e with
  | typed_ast.TVar n _ _ -> subst_var(n, e, env)
  | typed_ast.TBinary op l r t p -> typed_ast.TBinary(op, subst(l, env), subst(r, env), t, p)
  | typed_ast.TCall callee args t p -> typed_ast.TCall(callee, list_map(subst(_, env), args), t, p)
  | _ -> e

fn subst_var(n: String, e: typed_ast.TypedExpr, env: Dict typed_ast.TypedExpr) -> typed_ast.TypedExpr =
  match dict_get(n, env) with
  | Just arg -> arg
  | Nothing -> e

export fn apply_wrapper(w: Wrapper, args: List typed_ast.TypedExpr) -> Maybe Shape =
  if list_length(args) != list_length(w.params) then Nothing
  else
    let env = dict_from_list(zip(w.params, args))
    in Just(Shape(is_set = w.shape.is_set, vec = subst(w.shape.vec, env), idx = subst(w.shape.idx, env),
                  val = fmap(subst(_, env), w.shape.val)))

# The access a call to wrapper `n` performs, if `n` is in `wrappers`.
export fn shape_at(n: String, args: List typed_ast.TypedExpr, wrappers: Dict Wrapper) -> Maybe Shape =
  let Just w = dict_get(n, wrappers) else Nothing
  in apply_wrapper(w, args)

# A store of a non-heap scalar needs no write hook; any other store stays checked.
export fn shape_converts(s: Shape) -> Bool =
  match s.val with
  | Nothing -> true
  | Just x -> type_kind.type_is_non_heap_scalar(typed_ast.typed_expr_type(x))

# The projections and wrappers a program declares. `projs` is the set `wrapper_table` reads
# operands against, so it is built first.
export fn projection_set(decls: List typed_ast.TypedDecl) -> Set =
  set_from_list(list_filter_map(decl_projection_name, decls))

fn wrapper_entries(decls: List typed_ast.TypedDecl, projs: Set) -> List (String, Wrapper) =
  list_filter_map(wrapper_of(_, projs), decls)

export fn wrapper_table(decls: List typed_ast.TypedDecl, projs: Set) -> Dict Wrapper =
  dict_from_list(wrapper_entries(decls, projs))

# The wrappers that store, as entries, so a caller can tell none from some.
export fn store_wrappers(decls: List typed_ast.TypedDecl, projs: Set) -> List (String, Wrapper) =
  list_filter(is_store_entry, wrapper_entries(decls, projs))

fn is_store_entry(entry: (String, Wrapper)) -> Bool =
  match entry with
  | (_, w) -> w.shape.is_set
