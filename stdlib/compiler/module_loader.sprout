module stdlib.compiler.module_loader
import stdlib.compiler.ast as ast
import stdlib.compiler.types as types
import stdlib.compiler.lexer as lexer
import stdlib.compiler.parser as parser
import stdlib.compiler.checker as checker
import stdlib.compiler.source as source
import stdlib.fs as fs
import stdlib.string as string

# ---------------------------------------------------------------------------
# ImportSpec — parsed representation of one import line
# ---------------------------------------------------------------------------
#
# ImportAlias module_name alias
#   e.g. "import stdlib.compiler.ast as ast" -> ImportAlias "stdlib.compiler.ast" "ast"
#   All names from the module are exposed prefixed with "alias."
#
# ImportSelective module_name names
#   e.g. "import stdlib.collections (Vec, vec_get)" -> ImportSelective "stdlib.collections" ["Vec", "vec_get"]
#   Only the listed names are exposed, unqualified.

export type ImportSpec (..) =
  | ImportAlias String String
  | ImportSelective String (List String)

# ---------------------------------------------------------------------------
# Import header parsing
# ---------------------------------------------------------------------------

fn is_word_char(ch: Char) -> Bool =
  (ch != ' ') && (ch != '\t') && (ch != '(') && (ch != ')') && (ch != ',') && (ch != '\n') && (ch != '\r')

fn skip_spaces(s: String, i: Int) -> Int =
  if i >= str_len(s) then i
  else
    match str_char_at(s, i) with
    | Nothing -> i
    | Just ch -> if ch == ' ' || ch == '\t' then skip_spaces(s, i + 1) else i

fn read_word_acc(s: String, i: Int, acc: String) -> (String, Int) =
  if i >= str_len(s) then (acc, i)
  else
    match str_char_at(s, i) with
    | Nothing -> (acc, i)
    | Just ch ->
        if is_word_char(ch) then read_word_acc(s, i + 1, str_concat(acc, char_to_string(ch)))
        else (acc, i)

fn read_word(s: String, i: Int) -> (String, Int) =
  read_word_acc(s, skip_spaces(s, i), "")

fn parse_selective_names_acc(s: String, i: Int, acc: List String) -> List String =
  match read_word(s, i) with
  | ("", _) -> list_reverse(acc)
  | (name, i2) ->
      parse_selective_names_acc(s, skip_after_comma(s, i2), Cons(name, acc))

fn skip_after_comma(s: String, i: Int) -> Int =
  if i >= str_len(s) then i
  else
    match str_char_at(s, i) with
    | Nothing -> i
    | Just ch ->
        if ch == ')' then str_len(s)
        else if ch == ',' then i + 1
        else skip_after_comma(s, i + 1)

fn module_last_segment_go(s: String, i: Int, last_dot: Int) -> String =
  if i >= str_len(s) then str_slice(s, last_dot, str_len(s))
  else
    match str_char_at(s, i) with
    | Nothing -> str_slice(s, last_dot, str_len(s))
    | Just ch ->
        if ch == '.' then module_last_segment_go(s, i + 1, i + 1)
        else module_last_segment_go(s, i + 1, last_dot)

fn module_last_segment(module_name: String) -> String =
  module_last_segment_go(module_name, 0, 0)

fn parse_import_after_module(rest: String, module_name: String, i: Int) -> Maybe ImportSpec =
  match read_word(rest, i) with
  | ("as", i2) ->
      match read_word(rest, i2) with
      | ("", _) -> Nothing
      | (alias, _) -> Just(ImportAlias(module_name, alias))
  | _ ->
      if str_starts_with(str_slice(rest, skip_spaces(rest, i), str_len(rest)), "(") then
        Just(ImportSelective(module_name, parse_selective_names_acc(rest, skip_spaces(rest, i) + 1, Nil)))
      else Just(ImportAlias(module_name, module_last_segment(module_name)))

export fn parse_import_line(line: String) -> Maybe ImportSpec =
  if str_starts_with(line, "import ") then
    match read_word(line, 7) with
    | ("", _) -> Nothing
    | (module_name, i2) -> parse_import_after_module(line, module_name, i2)
  else Nothing

# Joins the lines of ONE import whose parenthesised list is still open, so
# `parse_import_line` always sees a complete declaration. Joined with a space:
# `is_word_char` already treats a space as a separator exactly as it treats the
# original line break, so the name scan is unaffected.
#
# Depth comes from `source.line_paren_delta` — the SAME scan `strip_headers`
# uses. The two must consume the same number of lines, and a private helper on
# each side would be free to drift; the failure would be silent, showing up as
# dropped imports or a fragment handed to the parser.
#
# Every line is stripped of its comment before being spliced, INCLUDING the first
# — the join starts from that line, so a comment trailing it lands mid-string
# just as one on a continuation line does. Splicing verbatim left a `#` in the
# middle of the joined text and `parse_import_line`'s name scan stops there, so a
# comment anywhere in the list dropped every name below it, surfacing later and
# elsewhere as `Unknown variable`. The depth scan already looks past comments;
# this only brings the text into line with it.
fn join_wrapped_import(joined: String, lines: List String, depth: Int) -> (String, List String) =
  if depth <= 0 then (joined, lines)
  else
    match lines with
    | Nil -> (joined, Nil)
    | Cons l rest ->
        join_wrapped_import(joined ++ " " ++ source.strip_line_comment(l), rest,
                            depth + source.line_paren_delta(l))

fn collect_imports_from_lines(lines: List String, acc: List ImportSpec) -> List ImportSpec =
  match lines with
  | Nil -> list_reverse(acc)
  | Cons line rest ->
      if str_starts_with(line, "module ") || line == "" || str_starts_with(line, "#") then
        collect_imports_from_lines(rest, acc)
      else if str_starts_with(line, "import ") then
        match join_wrapped_import(source.strip_line_comment(line), rest,
                                  source.line_paren_delta(line)) with
        | (joined, remaining) ->
            match parse_import_line(joined) with
            | Nothing -> collect_imports_from_lines(remaining, acc)
            | Just spec -> collect_imports_from_lines(remaining, Cons(spec, acc))
      else
        list_reverse(acc)

fn split_lines_at(s: String, i: Int, line_start: Int, acc: List String) -> List String =
  if i >= str_len(s) then
    list_reverse(Cons(str_slice(s, line_start, str_len(s)), acc))
  else
    match str_char_at(s, i) with
    | Nothing -> list_reverse(acc)
    | Just ch ->
        if ch == '\n' then
          split_lines_at(s, i + 1, i + 1, Cons(str_slice(s, line_start, i), acc))
        else
          split_lines_at(s, i + 1, line_start, acc)

export fn collect_imports(src: String) -> List ImportSpec =
  collect_imports_from_lines(str_split_lines(src), Nil)

# ---------------------------------------------------------------------------
# Module path resolution
# ---------------------------------------------------------------------------
#
# Converts a module name to a file path.
# Handles two forms:
#   "stdlib.*"  — strips the "stdlib." prefix and maps dots to slashes.
#   bare name   — no dot: treated as a top-level stdlib module (e.g. "string" → stdlib/string.sprout).
# Non-stdlib names that contain a dot return Nothing.
#
# Examples:
#   "stdlib.compiler.ast" + "/proj/stdlib" -> "/proj/stdlib/compiler/ast.sprout"
#   "string"              + "/proj/stdlib" -> "/proj/stdlib/string.sprout"

fn replace_dots_with_slash(s: String, i: Int, acc: String) -> String =
  if i >= str_len(s) then acc
  else
    match str_char_at(s, i) with
    | Nothing -> acc
    | Just ch ->
        if ch == '.' then replace_dots_with_slash(s, i + 1, str_concat(acc, "/"))
        else replace_dots_with_slash(s, i + 1, str_concat(acc, char_to_string(ch)))

export fn module_name_to_path(name: source.ModuleName, stdlib_root: String) -> Maybe String =
  if str_starts_with(n, "stdlib.") then
    Just(str_concat(stdlib_root, str_concat("/", str_concat(replace_dots_with_slash(str_slice(n, 7, str_len(n)), 0, ""), ".sprout"))))
  else if str_find(n, ".") == -1 then
    Just(str_concat(stdlib_root, str_concat("/", str_concat(n, ".sprout"))))
  else Nothing
  where n = source.module_name_str(name)

# resolve_module_path — module_name_to_path (stdlib.* / bare name, against
# stdlib_root) plus a fallback: a dotted non-stdlib name (e.g. `postgres.wire`)
# that module_name_to_path rejects is tried under an extra package root as
# `<root>/<dotted-as-path>.sprout`. First increment of the multi-repo package
# resolver (docs/packaging-v0.md §10 phase 2). Pure — no filesystem existence
# check — so only the first extra root is consulted; multi-root disambiguation
# needs IO and is deferred. The locked single-root module_name_to_path is left
# untouched; this only wraps it.
export fn resolve_module_path(name: source.ModuleName, stdlib_root: String, extra_roots: List String) -> Maybe String =
  match module_name_to_path(name, stdlib_root) with
  | Just path -> Just(path)
  | Nothing -> try_extra_roots(name, extra_roots)

fn try_extra_roots(name: source.ModuleName, extra_roots: List String) -> Maybe String =
  match extra_roots with
  | Nil -> Nothing
  | [root | _] ->
      Just(str_concat(root, str_concat("/", str_concat(replace_dots_with_slash(source.module_name_str(name), 0, ""), ".sprout"))))

# ---------------------------------------------------------------------------
# Dict → pairs list (needed to extract env after checking)
# ---------------------------------------------------------------------------

fn vec_str_to_list(v: Vec String, i: Int) -> List String =
  if i >= vec_length(v) then Nil
  else
    match vec_get(i, v) with
    | Nothing -> vec_str_to_list(v, i + 1)
    | Just k -> Cons(k, vec_str_to_list(v, i + 1))

fn dict_to_pairs(d: Dict types.Scheme) -> List (String, types.Scheme) =
  keys_to_pairs(d, vec_str_to_list(dict_keys(d), 0))

fn keys_to_pairs(d: Dict types.Scheme, keys: List String) -> List (String, types.Scheme) =
  match keys with
  | Nil -> Nil
  | Cons k rest ->
      match dict_get(k, d) with
      | Nothing -> keys_to_pairs(d, rest)
      | Just v -> Cons((k, v), keys_to_pairs(d, rest))

# ---------------------------------------------------------------------------
# Env prefixing / selective filtering
# ---------------------------------------------------------------------------
#
# @inst:, @class:, @fwd: keys are global internal markers used by the
# checker for typeclass instance dispatch.  They must never be qualified
# with an alias prefix or silently dropped during selective import.

fn is_marker_key(k: String) -> Bool = str_starts_with(k, "@")

fn collect_marker_pairs(pairs: List (String, types.Scheme)) -> List (String, types.Scheme) =
  match pairs with
  | Nil -> Nil
  | Cons (k, v) rest ->
      if is_marker_key(k) then Cons((k, v), collect_marker_pairs(rest))
      else collect_marker_pairs(rest)

# Names infer marked "@extern:" — the ast.ScopeGlobal class. A global name is
# spelled bare wherever its declaring module is in the build, so it is exempt from
# aliasing and from selective filtering alike; both exemptions read this list.
fn extern_marker_prefix() -> String = "@extern:"

fn extern_names(pairs: List (String, types.Scheme)) -> List String =
  match pairs with
  | Nil -> Nil
  | Cons (k, _) rest ->
      if str_starts_with(k, extern_marker_prefix())
      then Cons(str_slice(k, str_len(extern_marker_prefix()), str_len(k)), extern_names(rest))
      else extern_names(rest)

# @class: and @instance: markers are intentionally NOT prefixed — they are
# looked up by unqualified class/type name, not by the call-site expression. A
# constrained fn's constraints ride its own (prefixed) scheme via the Scheme
# constraint field (§13.3(B)), so no marker key needs the call-site name folded in.
#
# `globals` gets the same pass-through for a different reason: an extern is never
# module-qualified (ast.NameScope, spec-v0 §"Externs are outside the module
# system"), so prefixing one invents a spelling the bundler will reject.
fn prefix_pairs(pairs: List (String, types.Scheme), pfx: String, globals: List String) -> List (String, types.Scheme) =
  match pairs with
  | Nil -> Nil
  | Cons (k, v) rest ->
      if is_marker_key(k) || list_member(k, globals) then Cons((k, v), prefix_pairs(rest, pfx, globals))
      else Cons((str_concat(pfx, str_concat(".", k)), v), prefix_pairs(rest, pfx, globals))

# Select explicitly-named pairs AND all marker pairs from the module so
# that typeclass instances defined in the imported module remain available.
# Globals ride along unconditionally: naming an extern in an import list does
# nothing and omitting one does not hide it.
fn select_pairs(pairs: List (String, types.Scheme), names: List String, globals: List String) -> List (String, types.Scheme) =
  collect_marker_pairs(pairs) ++ select_named_pairs(pairs, names ++ globals)

fn select_named_pairs(pairs: List (String, types.Scheme), names: List String) -> List (String, types.Scheme) =
  match names with
  | Nil -> Nil
  | Cons name rest ->
      match find_pair(pairs, name) with
      | Nothing -> select_named_pairs(pairs, rest)
      | Just scheme -> Cons((name, scheme), select_named_pairs(pairs, rest))

fn find_pair(pairs: List (String, types.Scheme), name: String) -> Maybe types.Scheme =
  match pairs with
  | Nil -> Nothing
  | Cons (k, v) rest ->
      if k == name then Just(v)
      else find_pair(rest, name)

# ---------------------------------------------------------------------------
# Own-entry extraction
# ---------------------------------------------------------------------------
#
# We extract own_pairs by selecting only the names that the module source
# explicitly declares, plus all @-prefixed marker pairs (typeclass instances,
# record fields).  Using declared names is more precise than a key-exclusion
# filter: the exclusion approach breaks when a module re-declares a name that
# also exists in the prelude (e.g. collections.sprout re-declares vec_singleton).
#
# Globals are the one exception, and are selected by MARKER rather than by
# declaration: an extern is visible wherever its declaring module is in the build,
# including transitively, so a module re-exports the ones that reached it as well
# as its own. Marker-driven selection covers both in one pass.

# Module-scoped value names only — the names an importer sees under the module's
# alias. Which names those are is ast.decl_value_scopes' call, not this file's;
# globals are excluded here and picked up from their "@extern:" markers instead, so
# a module's own externs and its transitively inherited ones travel one path.
fn program_module_value_names(prog: ast.Program) -> List String =
  match prog with
  | ast.Program decls _ -> program_decls_loop(decls, Nil)

fn program_decls_loop(decls: List ast.Decl, acc: List String) -> List String =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      program_decls_loop(rest, ast.scope_names_module(ast.decl_value_scopes(d)) ++ acc)

# Header stripping is source.strip_headers (line-preserving, shared authority).

# ---------------------------------------------------------------------------
# Memoized recursive module loading
# ---------------------------------------------------------------------------
#
# The cache maps module_name → pairs from that module's check result.
# Modules not in "stdlib.*" are skipped (they're pre-seeded in builtin_env).

export type alias ModuleCache = Ref(Dict (List (String, types.Scheme)))

export fn new_cache() -> ModuleCache !{IO} =
  ref_new(dict_empty())

fn cache_put(cache: ModuleCache, name: String, pairs: List (String, types.Scheme)) -> Unit !{IO} =
  do
    d <- ref_read(cache)
    ref_write(cache, dict_set(name, pairs, d))

# Load a module by name, returning all its top-level name→scheme pairs.
# Recursively loads imports first, using the cache to avoid re-checking.
# Non-stdlib or unresolvable modules return Nil (silently skipped).
#
# Note: the cache lookup is done via ref_read + dict_get in a plain match (not
# a do-bind) to avoid the typechecker treating Maybe as the do-sequence family.
fn load_module(name: String, stdlib_root: String, cache: ModuleCache) -> List (String, types.Scheme) !{IO} =
  do
    d <- ref_read(cache)
    match dict_get(name, d) with
    | Just pairs -> pairs
    | Nothing ->
        do
          cache_put(cache, name, Nil)
          match module_name_to_path(source.ModuleName(name), stdlib_root) with
          | Nothing -> Nil
          | Just path ->
              match fs.read_text(path) with
              | Err msg -> panic("read_file: " ++ path ++ ": " ++ msg)
              | Ok src ->
                  do
                    import_pairs <- build_import_pairs(collect_imports(src), stdlib_root, cache)
                    prelude_pairs <- if name == "stdlib.prelude" then Nil else load_module("stdlib.prelude", stdlib_root, cache)
                    let base_pairs = prelude_pairs ++ import_pairs
                    match lexer.tokenize(source.strip_headers(src)) with
                    | Err _ -> Nil
                    | Ok tokens ->
                        match parser.parse_program(tokens) with
                        | Err _ -> Nil
                        | Ok prog ->
                            do
                              result <- checker.check_program_with_env(prog, base_pairs)
                              match result with
                              | checker.CheckErr _ _ -> Nil
                              | checker.CheckOk env ->
                                  do
                                    # Canonicalize this module's OWN type names on the way out, and
                                    # drop the importer-scoped @qual* markers so one module's aliases
                                    # never resolve inside another's.
                                    let env_pairs = dict_to_pairs(env)
                                    let markers = drop_import_qualifiers(collect_marker_pairs(env_pairs))
                                    # Globals are re-exported by name, not by declaration: the markers
                                    # cover this module's own externs AND every extern reaching it
                                    # through an import, which is what makes a transitively imported
                                    # extern resolve here the way it does after bundling.
                                    let own_pairs =
                                      select_named_pairs(env_pairs, program_module_value_names(prog))
                                        ++ select_named_pairs(env_pairs, extern_names(markers))
                                        ++ markers
                                    cache_put(cache, name, own_pairs)
                                    own_pairs

# ---- Import-alias resolution ----------------------------------------------
#
# `@qualalias:<alias>` records that `<alias>` is a name this module bound with
# `import M as alias`, so the checker can tell the alias-qualified spelling
# `alias.T` from a genuinely module-qualified type name.
#
# Only the ALIAS needs recording. The env path names every type by its short
# name — a module is checked with its header stripped, so its own decls are
# bare, and `prefix_pairs` qualifies binding KEYS without touching the types
# inside their schemes. So `bytes.to_string` has type `Bytes -> Result
# Utf8Error String`, and an annotation `Result bytes.Utf8Error String` matches
# it once the alias is dropped. Nothing else has to move.
#
# This marker describes the IMPORTER's vocabulary, not the imported module's,
# so unlike every other marker family it must NOT propagate onward:
# `load_module` drops it when collecting the markers it exports, or one
# module's aliases would resolve inside another's.

fn is_import_qualifier_key(k: String) -> Bool =
  str_starts_with(k, "@qualalias:")

fn drop_import_qualifiers(pairs: List (String, types.Scheme)) -> List (String, types.Scheme) =
  match pairs with
  | Nil -> Nil
  | Cons (k, v) rest ->
      if is_import_qualifier_key(k) then drop_import_qualifiers(rest)
      else Cons((k, v), drop_import_qualifiers(rest))

fn alias_marker(module_name: String) -> types.Scheme =
  types.mono(types.TConst(types.type_id(module_name)))

# Apply a single import spec: load the module and namespace/filter its pairs.
fn apply_import_spec(spec: ImportSpec, stdlib_root: String, cache: ModuleCache) -> List (String, types.Scheme) !{IO} =
  match spec with
  | ImportAlias module_name alias ->
      do
        pairs <- load_module(module_name, stdlib_root, cache)
        let visible = drop_import_qualifiers(pairs)
        Cons((str_concat("@qualalias:", alias), alias_marker(module_name)),
          prefix_pairs(visible, alias, extern_names(visible)))
  | ImportSelective module_name names ->
      do
        pairs <- load_module(module_name, stdlib_root, cache)
        let visible = drop_import_qualifiers(pairs)
        select_pairs(visible, names, extern_names(visible))

fn build_import_pairs_acc(specs: List ImportSpec, stdlib_root: String, cache: ModuleCache, acc: List (String, types.Scheme)) -> List (String, types.Scheme) !{IO} =
  match specs with
  | Nil -> acc
  | Cons spec rest ->
      do
        pairs <- apply_import_spec(spec, stdlib_root, cache)
        build_import_pairs_acc(rest, stdlib_root, cache, acc ++ pairs)

export fn build_import_pairs(specs: List ImportSpec, stdlib_root: String, cache: ModuleCache) -> List (String, types.Scheme) !{IO} =
  build_import_pairs_acc(specs, stdlib_root, cache, Nil)

# Load the prelude's exported name→scheme pairs (unqualified, same as how the
# Python CLI exposes them via with_prelude).  Always call before build_import_pairs
# so the cache is warm for any module that transitively imports the prelude.
export fn load_prelude_pairs(stdlib_root: String, cache: ModuleCache) -> List (String, types.Scheme) !{IO} =
  load_module("stdlib.prelude", stdlib_root, cache)
