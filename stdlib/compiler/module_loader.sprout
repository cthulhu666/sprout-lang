module stdlib.compiler.module_loader
import stdlib.compiler.source as source
import stdlib.string as string

# ---------------------------------------------------------------------------
# ImportSpec — parsed representation of one import line
# ---------------------------------------------------------------------------
#
# ImportAlias module_name alias
#   e.g. "import stdlib.compiler.ast as ast" -> ImportAlias "stdlib.compiler.ast" "ast"
#   All names from the module are exposed prefixed with "alias."
#
# ImportSelective module_name names
#   e.g. "import stdlib.collections (Vec, vec_get)" -> ImportSelective "stdlib.collections" ["Vec", "vec_get"]
#   Only the listed names are exposed, unqualified.
#
# Both carry the position of the line the import starts on, where its diagnostics point.

export type ImportSpec (..) =
  | ImportAlias String String source.SourcePos
  | ImportSelective String (List String) source.SourcePos

export fn import_module(spec: ImportSpec) -> String =
  match spec with
  | ImportAlias m _ _ -> m
  | ImportSelective m _ _ -> m

export fn import_pos(spec: ImportSpec) -> source.SourcePos =
  match spec with
  | ImportAlias _ _ pos -> pos
  | ImportSelective _ _ pos -> pos

# ---------------------------------------------------------------------------
# Import header parsing
# ---------------------------------------------------------------------------

fn is_word_char(ch: Char) -> Bool =
  (ch != ' ') && (ch != '\t') && (ch != '(') && (ch != ')') && (ch != ',') && (ch != '\n') && (ch != '\r')

fn skip_spaces(s: String, i: Int) -> Int =
  if i >= str_len(s) then i
  else
    match str_char_at(s, i) with
    | Nothing -> i
    | Just ch -> if ch == ' ' || ch == '\t' then skip_spaces(s, i + 1) else i

fn read_word_acc(s: String, i: Int, acc: String) -> (String, Int) =
  if i >= str_len(s) then (acc, i)
  else
    match str_char_at(s, i) with
    | Nothing -> (acc, i)
    | Just ch ->
        if is_word_char(ch) then read_word_acc(s, i + 1, str_concat(acc, char_to_string(ch)))
        else (acc, i)

fn read_word(s: String, i: Int) -> (String, Int) =
  read_word_acc(s, skip_spaces(s, i), "")

# A parenthesised group after a name in a selective list is NOT import syntax:
# spec §3 *Imports* lists bare names, and `(..)` is declaration-side (spec
# §5.6.1). The scan consumes it anyway, keeping its text as part of the name.
#
# Consuming it is the point. `skip_after_comma` ends the whole list at the first
# `)`, and in `import M (T(..), f)` that is the one inside `(..)` — so `f` was
# dropped with no diagnostic, and a bare `f` then reached whatever else was in
# scope, typically the prelude's homonym. A different function ran than the
# import line named.
#
# Keeping the group makes `T(..)` a listed name no module exports, so the
# existing "every listed name must be exported" rule (spec §3) rejects it at the
# import line, and every name after it still binds. Depth is tracked so a nested
# group cannot end the scan early; an unbalanced one collapses the rest of the
# list into one bogus name, which is still an error rather than a silent drop.
fn read_group_acc(s: String, i: Int, depth: Int, acc: String) -> (String, Int) =
  if i >= str_len(s) then (acc, i)
  else
    match str_char_at(s, i) with
    | Nothing -> (acc, i)
    | Just ch ->
        if ch == '(' then read_group_acc(s, i + 1, depth + 1, acc ++ char_to_string(ch))
        else if ch == ')' && depth <= 1 then (acc ++ char_to_string(ch), i + 1)
        else if ch == ')' then read_group_acc(s, i + 1, depth - 1, acc ++ char_to_string(ch))
        else read_group_acc(s, i + 1, depth, acc ++ char_to_string(ch))

# `at` has already skipped whitespace, and that is load-bearing rather than
# tidiness. Every `(..)` in this tree is written with a space before it
# (`export type Tone (..)`), so a reader copying a declaration's shape into an
# import writes `Tone (..)`. Looking for the `(` at the byte straight after the
# word missed that spelling and left the drop alive for the form people actually
# write, while rejecting only the tight one. No legal entry is followed by a `(`
# across whitespace, so skipping it cannot over-trigger.
#
# The separator is not kept, so `Tone (..)` and `Tone(..)` both report as
# `Tone(..)` — one normalised spelling for the diagnostic to quote.
fn group_after_name(s: String, name: String, at: Int) -> (String, Int) =
  match str_char_at(s, at) with
  | Nothing -> (name, at)
  | Just ch ->
      if ch != '(' then (name, at)
      else
        match read_group_acc(s, at, 0, "") with
        | (group, i3) -> (name ++ group, i3)

fn read_list_entry(s: String, i: Int) -> (String, Int) =
  match read_word(s, i) with
  | ("", i2) -> ("", i2)
  | (name, i2) -> group_after_name(s, name, skip_spaces(s, i2))

fn parse_selective_names_acc(s: String, i: Int, acc: List String) -> List String =
  match read_list_entry(s, i) with
  | ("", _) -> list_reverse(acc)
  | (name, i2) ->
      parse_selective_names_acc(s, skip_after_comma(s, i2), Cons(name, acc))

fn skip_after_comma(s: String, i: Int) -> Int =
  if i >= str_len(s) then i
  else
    match str_char_at(s, i) with
    | Nothing -> i
    | Just ch ->
        if ch == ')' then str_len(s)
        else if ch == ',' then i + 1
        else skip_after_comma(s, i + 1)

fn module_last_segment_go(s: String, i: Int, last_dot: Int) -> String =
  if i >= str_len(s) then str_slice(s, last_dot, str_len(s))
  else
    match str_char_at(s, i) with
    | Nothing -> str_slice(s, last_dot, str_len(s))
    | Just ch ->
        if ch == '.' then module_last_segment_go(s, i + 1, i + 1)
        else module_last_segment_go(s, i + 1, last_dot)

fn module_last_segment(module_name: String) -> String =
  module_last_segment_go(module_name, 0, 0)

fn parse_import_after_module(rest: String, module_name: String, i: Int, pos: source.SourcePos) -> Maybe ImportSpec =
  match read_word(rest, i) with
  | ("as", i2) ->
      match read_word(rest, i2) with
      | ("", _) -> Nothing
      | (alias, _) -> Just(ImportAlias(module_name, alias, pos))
  | _ ->
      if str_starts_with(str_slice(rest, skip_spaces(rest, i), str_len(rest)), "(") then
        Just(ImportSelective(module_name, parse_selective_names_acc(rest, skip_spaces(rest, i) + 1, Nil), pos))
      else Just(ImportAlias(module_name, module_last_segment(module_name), pos))

# `pos` is where `line` starts in its file.
export fn parse_import_line(line: String, pos: source.SourcePos) -> Maybe ImportSpec =
  if str_starts_with(line, "import ") then
    match read_word(line, 7) with
    | ("", _) -> Nothing
    | (module_name, i2) -> parse_import_after_module(line, module_name, i2, pos)
  else Nothing

# Joins the lines of ONE import whose parenthesised list is still open, so
# `parse_import_line` always sees a complete declaration. Joined with a space:
# `is_word_char` already treats a space as a separator exactly as it treats the
# original line break, so the name scan is unaffected.
#
# Depth comes from `source.line_paren_delta` — the SAME scan `strip_headers`
# uses. The two must consume the same number of lines, and a private helper on
# each side would be free to drift; the failure would be silent, showing up as
# dropped imports or a fragment handed to the parser.
#
# Every line is stripped of its comment before being spliced, INCLUDING the first
# — the join starts from that line, so a comment trailing it lands mid-string
# just as one on a continuation line does. Splicing verbatim left a `#` in the
# middle of the joined text and `parse_import_line`'s name scan stops there, so a
# comment anywhere in the list dropped every name below it, surfacing later and
# elsewhere as `Unknown variable`. The depth scan already looks past comments;
# this only brings the text into line with it.
#
# `next` is the start of the line after the last one joined.
fn join_wrapped_import(joined: String, lines: List String, depth: Int, next: source.SourcePos) -> (String, List String, source.SourcePos) =
  if depth <= 0 then (joined, lines, next)
  else
    match lines with
    | Nil -> (joined, Nil, next)
    | Cons l rest ->
        join_wrapped_import(joined ++ " " ++ source.strip_line_comment(l), rest,
                            depth + source.line_paren_delta(l), after_line(next, l))

# The start of the line after `line`, which starts at `pos`. `str_split_lines`
# drops only the `\n`, so the index advances by the line's codepoints plus one.
fn after_line(pos: source.SourcePos, line: String) -> source.SourcePos =
  source.SourcePos(index = pos.index + str_len(line) + 1, line = pos.line + 1, column = 1)

fn collect_imports_from_lines(lines: List String, pos: source.SourcePos, acc: List ImportSpec) -> List ImportSpec =
  match lines with
  | Nil -> list_reverse(acc)
  | Cons line rest ->
      if str_starts_with(line, "import ") then
        match join_wrapped_import(source.strip_line_comment(line), rest,
                                  source.line_paren_delta(line), after_line(pos, line)) with
        | (joined, remaining, next) ->
            match parse_import_line(joined, pos) with
            | Nothing -> collect_imports_from_lines(remaining, next, acc)
            | Just spec -> collect_imports_from_lines(remaining, next, Cons(spec, acc))
      # The header block ends where `strip_headers` ends it, `no_prelude` included.
      else if source.is_header_line(line) then
        collect_imports_from_lines(rest, after_line(pos, line), acc)
      else
        list_reverse(acc)

export fn collect_imports(src: String) -> List ImportSpec =
  collect_imports_from_lines(str_split_lines(src), source.SourcePos(index = 0, line = 1, column = 1), Nil)

# ---------------------------------------------------------------------------
# Module path resolution
# ---------------------------------------------------------------------------
#
# Converts a module name to a file path.
# Handles two forms:
#   "stdlib.*"  — strips the "stdlib." prefix and maps dots to slashes.
#   bare name   — no dot: treated as a top-level stdlib module (e.g. "string" → stdlib/string.sprout).
# Non-stdlib names that contain a dot return Nothing.
#
# Examples:
#   "stdlib.compiler.ast" + "/proj/stdlib" -> "/proj/stdlib/compiler/ast.sprout"
#   "string"              + "/proj/stdlib" -> "/proj/stdlib/string.sprout"

export fn module_name_to_path(name: source.ModuleName, stdlib_root: String) -> Maybe String =
  if str_starts_with(n, "stdlib.") then
    Just(stdlib_root ++ "/" ++ string.replace_all(".", "/", str_slice(n, 7, str_len(n))) ++ ".sprout")
  else if str_find(n, ".") == -1 then
    Just(stdlib_root ++ "/" ++ n ++ ".sprout")
  else Nothing
  where n = source.module_name_str(name)

# resolve_module_path — module_name_to_path (stdlib.* / bare name, against
# stdlib_root) plus a fallback: a dotted non-stdlib name (e.g. `postgres.wire`)
# that module_name_to_path rejects is tried under an extra package root as
# `<root>/<dotted-as-path>.sprout`. First increment of the multi-repo package
# resolver (docs/packaging-v0.md §10 phase 2). Pure — no filesystem existence
# check — so only the first extra root is consulted; multi-root disambiguation
# needs IO and is deferred. The locked single-root module_name_to_path is left
# untouched; this only wraps it.
export fn resolve_module_path(name: source.ModuleName, stdlib_root: String, extra_roots: List String) -> Maybe String =
  match module_name_to_path(name, stdlib_root) with
  | Just path -> Just(path)
  | Nothing -> try_extra_roots(name, extra_roots)

fn try_extra_roots(name: source.ModuleName, extra_roots: List String) -> Maybe String =
  match extra_roots with
  | Nil -> Nothing
  | [root | _] ->
      Just(root ++ "/" ++ string.replace_all(".", "/", source.module_name_str(name)) ++ ".sprout")
