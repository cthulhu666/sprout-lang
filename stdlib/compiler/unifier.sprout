module stdlib.compiler.unifier
import stdlib.compiler.types as types
import stdlib.compiler.source as source
import stdlib.string as string

# ---------------------------------------------------------------------------
# InferState — mutable counter for fresh type/effect variables
# ---------------------------------------------------------------------------
#
# The substitution is NOT stored here; callers thread it as a pure Dict.
# Only the fresh-variable counters and the parked field obligations mutate.

# A field access inferred before its receiver's type was known. Inference is a
# single left-to-right pass, so `p.x` can be reached while `p` is still an
# unbound variable that a LATER call in the same body pins down. The access
# cannot be typed at that moment, so the obligation is parked here and
# discharged at the declaration boundary, where the substitution is final.
# Parking is what makes the two orders agree: `zero(p) + str_len(p.x)` and
# `str_len(p.x) + zero(p)` must not get different answers.
export type FieldObligation (..) =
  | FieldObligation types.Type String types.Type source.SourcePos
  # FieldObligation receiver_type  field_name  result_var  pos

export fn field_obligation_receiver(o: FieldObligation) -> types.Type =
  match o with
  | FieldObligation r _ _ _ -> r

export fn field_obligation_field(o: FieldObligation) -> String =
  match o with
  | FieldObligation _ f _ _ -> f

export fn field_obligation_result(o: FieldObligation) -> types.Type =
  match o with
  | FieldObligation _ _ v _ -> v

export fn field_obligation_pos(o: FieldObligation) -> source.SourcePos =
  match o with
  | FieldObligation _ _ _ p -> p

# One function's declared effect next to the effect its body actually performs.
# Recorded by infer.check_fn_body for every declaration, whether or not the two
# agree, and reported by `--phase effects`. Nothing acts on a mismatch yet: the
# v0 checker does not enforce the effect rules (spec-v0.md §7), and the point of
# collecting this is to size that enforcement before committing to it.
# The declared scheme is carried alongside the two effects because the two rules
# ask about different things. Rule 8 compares declared against inferred, so the
# effects are enough. Rule 9 constrains the SIGNATURE — "may quantify a singleton
# effect variable" — and neither effect can answer that: the declared field holds
# only the top-level effect (blind to a variable written on a parameter's arrow),
# and the inferred field describes what the body did, which is not what rule 9
# governs. The scheme is the declaration, so it is what rule 9 reads.
export type EffectReport (..) =
  | EffectReport String types.Effect types.Effect source.SourcePos types.Scheme
  # EffectReport fn_name  declared  inferred  pos  declared_scheme

export fn effect_report_name(r: EffectReport) -> String =
  match r with
  | EffectReport n _ _ _ _ -> n

export fn effect_report_declared(r: EffectReport) -> types.Effect =
  match r with
  | EffectReport _ d _ _ _ -> d

export fn effect_report_inferred(r: EffectReport) -> types.Effect =
  match r with
  | EffectReport _ _ i _ _ -> i

export fn effect_report_pos(r: EffectReport) -> source.SourcePos =
  match r with
  | EffectReport _ _ _ p _ -> p

export fn effect_report_decl_scheme(r: EffectReport) -> types.Scheme =
  match r with
  | EffectReport _ _ _ _ s -> s

# "This declaration under-declares its effect." The SINGLE definition, used by
# both consumers: `--phase effects` to label a line GAP, and `checker` to reject.
#
# They must not drift, because they answer the same question for opposite
# purposes — the report exists to predict exactly what enforcement will reject,
# and a report that disagrees with the checker is worse than no report.
#
# Only under-declaration counts. Over-declaring is legal and deliberate: the rule
# is subsumption, inferred ⊑ declared, so a pure body under an `!{IO}` signature
# is how `mutvec_len` says its result is not a function of its argument alone.
# An unresolved effect VARIABLE is not a gap either — the checker accepts when it
# does not know, which is the only safe direction for a conservatism knob.
export fn effect_report_is_gap(r: EffectReport) -> Bool =
  match (effect_report_declared(r), effect_report_inferred(r)) with
  | (types.EffectPure, types.EffectIO) -> true
  | _ -> false

# "This signature is not a singleton effect variable." The second rejection, for
# spec §7 rule 9. The SINGLE definition, read by both `--phase effects` (to label
# a line ROW) and `checker` (to reject) — same no-drift contract as rule 8 above.
#
# Two distinct causes, because they are two different defects:
#
#   - more than one effect variable named — `f: a -> Unit !{e}, g: b -> Unit !{d}`.
#     Rule 9's singleton limit, stated directly.
#   - a written multi-label row — `!{IO, e}`. Names ONE variable, so it satisfies
#     the singleton count; it is undefined for the separate reason that §7 has no
#     row form. Reporting it under rule 9's wording is what made the earlier
#     diagnostic call `IO` an effect variable.
#
# This reads the DECLARATION, never the inferred effect, and that is the fix for
# a check that got both directions wrong by reading inference instead:
#
#   - false REJECTION. An inferred row is also what two fresh instantiations of
#     ONE variable produce. `fn maybe_do(n: Int) -> Unit !{e}` called twice merges
#     `$e0` with `$e1` into a row, and the declaration was rejected for combining
#     two variables when it named one. `apply_effect_subst` could not collapse it
#     either: both members are unbound, so no substitution relates them.
#     Fixture: `run/effect_one_variable_unpinned_ok.spr`.
#   - false ACCEPTANCE. A signature naming two variables whose body never makes
#     them meet builds no row at all, so it compiled.
#     Fixture: `type_error/effect_two_variables_uncombined.spr`.
#
# Dropping the inferred side opens no rule-8 hole: `merge_effects` matches
# `EffectIO` in both argument positions before building any row, so IO absorbs
# every variable it meets and a row can never contain it. An inferred row is
# therefore always IO-free, and a body that truly performs IO still infers `!{IO}`
# and is still caught. Pinned by `type_error/effect_var_merged_with_io.spr`.
export fn effect_report_is_multi_var(r: EffectReport) -> Bool =
  list_length(effect_report_effect_vars(r)) > 1
    || effect_report_has_row(r)

# The effect variables the SIGNATURE names, in source spelling — `e`, `d`, not the
# freshened `$e0`. Every arrow is scanned, not just the top-level effect, because
# a variable written on a parameter (`list_each`'s `f: a -> Unit !{e}`) is the
# common case and never appears at the top level of anything else.
export fn effect_report_effect_vars(r: EffectReport) -> List String =
  types.scheme_effect_vars(effect_report_decl_scheme(r))

export fn effect_report_has_row(r: EffectReport) -> Bool =
  types.scheme_has_multi_label_row(effect_report_decl_scheme(r))

# The labels of the written row, for the diagnostic. `Nil` when the signature
# writes none, in which case the rejection came from the variable count instead.
export fn effect_report_row_labels(r: EffectReport) -> List String =
  types.scheme_row_labels(effect_report_decl_scheme(r))

# What a unification returns: BOTH substitutions, or a message.
#
# This replaced `Result String (Dict types.Type)` when arrow effects started
# unifying. The pair is deliberately one value rather than two returns: several
# callers unify speculatively and drop the result on failure (infer.sprout's
# push_down_arg_slots is the clearest — `| Err _ -> subst`), and an effect
# substitution returned separately from a failed attempt would leak that
# attempt's bindings into the real one. Bundling them means a discarded
# unification discards both halves or neither, with no per-call-site discipline
# required.
export type Unified (..) =
  | UnifyOk (Dict types.Type) (Dict types.Effect)
  | UnifyErr String

# Which side of a unification carries the EXPECTED type. Argument order cannot
# say it: the same (pure, IO) pair means opposite things at a parameter and at a
# return, and `infer`'s call sites use both orders
# (docs/effect-subsumption-v0.md §6.2).
#
# `NoExpectation` is a join — an `if` branch meeting its sibling, where neither
# side is the contract. It binds without rejecting, which is what every site did
# before this change; part 2 gives joins their own LUB/GLB rule.
export type Polarity (..) =
  | ExpectedLeft
  | ExpectedRight
  | NoExpectation

# Descending into an arrow's PARAMETER swaps which side is the contract; the
# result keeps it. Ordinary function subtyping, and what makes a second-order
# case come out right rather than backwards.
fn flip_polarity(p: Polarity) -> Polarity =
  match p with
  | ExpectedLeft -> ExpectedRight
  | ExpectedRight -> ExpectedLeft
  | NoExpectation -> NoExpectation

export fn unified_subst(u: Unified, fallback: Dict types.Type) -> Dict types.Type =
  match u with
  | UnifyOk s _ -> s
  | UnifyErr _ -> fallback

export fn unified_eff_subst(u: Unified, fallback: Dict types.Effect) -> Dict types.Effect =
  match u with
  | UnifyOk _ es -> es
  | UnifyErr _ -> fallback

fn unified_of_bind(r: Result String (Dict types.Type), eff_subst: Dict types.Effect) -> Unified =
  match r with
  | Ok s -> UnifyOk(s, eff_subst)
  | Err e -> UnifyErr(e)

# Was the type being bound a written slot or an observed value? At a join neither
# is a contract, so nothing is recorded and the old behaviour stands.
type BoundRole (..) =
  | AsCeiling
  | AsFloor
  | NoBound

fn bound_role(polarity: Polarity, bound_is_left: Bool) -> BoundRole =
  match polarity with
  | NoExpectation -> NoBound
  | ExpectedLeft -> if bound_is_left then AsCeiling else AsFloor
  | ExpectedRight -> if bound_is_left then AsFloor else AsCeiling

# A unification that deliberately does not participate in effect
# inference. Grep for it to find every such site.
#
# Some callers sit behind a result type that carries only a type substitution —
# the deferred field-obligation chain (`OneResult`) is six functions deep and
# would need all six widened. Rather than widen them for a case that needs a
# record field whose type is a function carrying an effect variable, reached
# through a DEFERRED access, those sites opt out here.
#
# This is sound, not merely tolerable, and the reason is worth stating: arrow
# effect unification is total (see `unify_arrow_effects`), so the effect
# substitution can never change whether a unification succeeds. Passing an empty
# one therefore produces exactly the same types and the same errors as passing
# the real one; the only loss is that a binding CREATED at such a site is not
# visible later. That direction under-reports an effect, which is the direction
# the report is already conservative in. It is not a correctness hole, and it
# would become one only if arrow effect unification were ever made strict.
export fn no_effect_subst() -> Dict types.Effect = dict_empty()

export type InferState (..) =
  | InferState (Ref Int) (Ref Int) (Ref (Dict (List String))) (Ref (List FieldObligation)) (Ref (List EffectReport))
  # InferState next_type_id  next_effect_id  ctor_map  parked_field_obligations  effect_reports

export fn new_state() -> InferState !{IO} =
  do
    t_id <- ref_new(0)
    e_id <- ref_new(0)
    ctor_ref <- ref_new(dict_empty())
    field_ref <- ref_new(Nil)
    effect_ref <- ref_new(Nil)
    InferState(t_id, e_id, ctor_ref, field_ref, effect_ref)

# Unlike take_field_obligations this ACCUMULATES across the whole program: the
# report is a whole-program census, not a per-declaration obligation.
export fn record_effect_report(state: InferState, r: EffectReport) -> Unit !{IO} =
  match state with
  | InferState _ _ _ _ effect_ref ->
      do
        prior <- ref_read(effect_ref)
        ref_write(effect_ref, Cons(r, prior))

export fn effect_reports(state: InferState) -> List EffectReport !{IO} =
  match state with
  | InferState _ _ _ _ effect_ref ->
      do
        prior <- ref_read(effect_ref)
        list_reverse_reports(prior)

fn list_reverse_reports(xs: List EffectReport) -> List EffectReport =
  list_reverse_reports_acc(xs, Nil)

fn list_reverse_reports_acc(xs: List EffectReport, acc: List EffectReport) -> List EffectReport =
  match xs with
  | Nil -> acc
  | Cons h t -> list_reverse_reports_acc(t, Cons(h, acc))

export fn park_field_obligation(state: InferState, o: FieldObligation) -> Unit !{IO} =
  match state with
  | InferState _ _ _ field_ref _ ->
      do
        parked <- ref_read(field_ref)
        ref_write(field_ref, Cons(o, parked))

# Read AND clear. Every declaration body passes through the boundary that calls
# this, so clearing keeps one declaration's unresolved accesses from being
# discharged against the next declaration's environment — including when a body
# errors out before its own obligations are discharged.
export fn take_field_obligations(state: InferState) -> List FieldObligation !{IO} =
  match state with
  | InferState _ _ _ field_ref _ ->
      do
        parked <- ref_read(field_ref)
        ref_write(field_ref, Nil)
        list_reverse(parked)

# "$" cannot open a Sprout identifier (string.is_ident_start admits only
# ASCII alpha or '_'; see stdlib/string.sprout), so a "$"-prefixed name can
# never collide with a user-written identifier — same convention already
# used for IR-level generated names in ast_to_ir.sprout/ir_lowering.sprout.
# Without this prefix, a user type variable spelled like a fresh name (e.g.
# "t1") could alias a live compiler-internal metavariable of the same name
# and silently corrupt unification (see tests/stdlib/compiler/test_fresh_tvar_collision.spr).
export fn fresh(state: InferState) -> String !{IO} =
  match state with
  | InferState t_ref _ _ _ _ ->
      do
        n <- ref_read(t_ref)
        ref_write(t_ref, n + 1)
        "$t" ++ int_to_string(n)

export fn fresh_effect(state: InferState) -> String !{IO} =
  match state with
  | InferState _ e_ref _ _ _ ->
      do
        n <- ref_read(e_ref)
        ref_write(e_ref, n + 1)
        "$e" ++ int_to_string(n)

export fn set_ctor_map(state: InferState, ctor_map: Dict (List String)) -> Unit !{IO} =
  match state with
  | InferState _ _ ctor_ref _ _ -> ref_write(ctor_ref, ctor_map)

export fn get_ctor_map(state: InferState) -> Dict (List String) !{IO} =
  match state with
  | InferState _ _ ctor_ref _ _ -> ref_read(ctor_ref)

# ---------------------------------------------------------------------------
# apply_subst — walk a Type, replacing bound TVars
# ---------------------------------------------------------------------------

fn apply_subst_lookup(subst: Dict types.Type, t: types.Type, name: String) -> types.Type =
  match dict_get(name, subst) with
  | Nothing -> t
  | Just bound -> apply_subst(subst, bound)

export fn apply_subst(subst: Dict types.Type, t: types.Type) -> types.Type =
  match t with
  | types.TVar name -> apply_subst_lookup(subst, t, types.tyvar_identity(name))
  | types.TConst _ -> t
  | types.TApp base arg ->
      types.TApp(apply_subst(subst, base), apply_subst(subst, arg))
  | types.TFunc param ret eff own ->
      types.TFunc(apply_subst(subst, param), apply_subst(subst, ret), eff, own)
  | types.TThunk ret eff -> types.TThunk(apply_subst(subst, ret), eff)
  | types.TTuple items ->
      types.TTuple(apply_subst_list(subst, items))

export fn apply_subst_list(subst: Dict types.Type, items: List types.Type) -> List types.Type =
  match items with
  | Nil -> Nil
  | Cons h t -> Cons(apply_subst(subst, h), apply_subst_list(subst, t))

# ---------------------------------------------------------------------------
# apply_effect_subst — walk an Effect, replacing bound EVars
# ---------------------------------------------------------------------------

fn apply_effect_subst_lookup(eff_subst: Dict types.Effect, e: types.Effect, name: String) -> types.Effect =
  match dict_get(name, eff_subst) with
  | Nothing -> e
  | Just bound -> apply_effect_subst(eff_subst, bound)

export fn apply_effect_subst(eff_subst: Dict types.Effect, e: types.Effect) -> types.Effect =
  match e with
  | types.EffectVar name -> apply_effect_subst_lookup(eff_subst, e, name)
  | _ -> e

# Resolve both type and effect substitutions together
fn apply_full_subst_lookup(subst: Dict types.Type, eff_subst: Dict types.Effect, t: types.Type, name: String) -> types.Type =
  match dict_get(name, subst) with
  | Nothing -> t
  | Just bound -> apply_full_subst(subst, eff_subst, bound)

export fn apply_full_subst(subst: Dict types.Type, eff_subst: Dict types.Effect, t: types.Type) -> types.Type =
  match t with
  | types.TVar name -> apply_full_subst_lookup(subst, eff_subst, t, types.tyvar_identity(name))
  | types.TConst _ -> t
  | types.TApp base arg ->
      types.TApp(apply_full_subst(subst, eff_subst, base), apply_full_subst(subst, eff_subst, arg))
  | types.TFunc param ret eff own ->
      types.TFunc(
        apply_full_subst(subst, eff_subst, param),
        apply_full_subst(subst, eff_subst, ret),
        apply_effect_subst(eff_subst, eff),
        own
      )
  | types.TThunk ret eff ->
      types.TThunk(apply_full_subst(subst, eff_subst, ret), apply_effect_subst(eff_subst, eff))
  | types.TTuple items ->
      types.TTuple(apply_full_subst_list(subst, eff_subst, items))

fn apply_full_subst_list(subst: Dict types.Type, eff_subst: Dict types.Effect, items: List types.Type) -> List types.Type =
  match items with
  | Nil -> Nil
  | Cons h t -> Cons(apply_full_subst(subst, eff_subst, h), apply_full_subst_list(subst, eff_subst, t))

# ---------------------------------------------------------------------------
# occurs — prevent infinite types
# ---------------------------------------------------------------------------

fn occurs(name: String, subst: Dict types.Type, t: types.Type) -> Bool =
  match apply_subst(subst, t) with
  | types.TVar n -> types.tyvar_identity(n) == name
  | types.TConst _ -> false
  | types.TApp base arg -> occurs(name, subst, base) || occurs(name, subst, arg)
  | types.TFunc param ret _ _ -> occurs(name, subst, param) || occurs(name, subst, ret)
  | types.TThunk ret _ -> occurs(name, subst, ret)
  | types.TTuple items -> occurs_list(name, subst, items)

fn occurs_list(name: String, subst: Dict types.Type, items: List types.Type) -> Bool =
  match items with
  | Nil -> false
  | Cons h t -> if occurs(name, subst, h) then true else occurs_list(name, subst, t)

# ---------------------------------------------------------------------------
# bind_var — extend substitution, with occurs check
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Bounded effect variables (docs/effect-subsumption-v0.md §6.4b)
# ---------------------------------------------------------------------------
#
# Bounds live in `eff_subst` under `@`-prefixed keys, which no effect variable can
# spell, so the carrier and every `UnifyOk s es` site are unchanged. `@lo:v` is
# "v must permit at least this"; `@hi:v` is "at most this". A contradiction —
# lower IO under upper pure — is the §7 rejection, raised where it closes.
fn lower_bound_key(v: String) -> String = "@lo:" ++ v

fn upper_bound_key(v: String) -> String = "@hi:" ++ v

fn effect_is_io(e: types.Effect) -> Bool =
  match e with
  | types.EffectIO -> true
  | types.EffectPure -> false
  | types.EffectVar _ -> false
  | types.EffectRow _ -> false

fn effect_is_pure(e: types.Effect) -> Bool =
  match e with
  | types.EffectPure -> true
  | types.EffectIO -> false
  | types.EffectVar _ -> false
  | types.EffectRow _ -> false

# A value performs at least `e`. Contradicts an existing pure ceiling.
#
# Raising the floor also RE-BINDS the variable, because the binding is what
# `apply_effect_subst` reads later and IO absorbs. Leaving the first-arrival
# binding in place is how `[shout, quiet]` under a pure element type laundered:
# `quiet`'s pure overwrote `shout`'s IO and the annotation then saw pure.
fn record_lower(eff_subst: Dict types.Effect, v: String,
                e: types.Effect) -> Result String (Dict types.Effect) =
  if ! effect_is_io (e) then Ok(eff_subst)
  else if upper_is_pure(eff_subst, v) then Err(io_into_pure_error())
  else Ok(dict_set(v, e, dict_set(lower_bound_key(v), e, eff_subst)))

# A slot permits at most `e`. Contradicts an existing IO floor.
fn record_upper(eff_subst: Dict types.Effect, v: String,
                e: types.Effect) -> Result String (Dict types.Effect) =
  if ! effect_is_pure (e) then Ok(eff_subst)
  else if lower_is_io(eff_subst, v) then Err(io_into_pure_error())
  else Ok(dict_set(upper_bound_key(v), e, eff_subst))

# The traversal's result: the rewritten type, the next index, and the bounds owed.
type Freshened (..) =
  | Freshened types.Type Int (List (String, types.Effect))

# Binding a tyvar to a type carrying CONCRETE arrow effects is what turns a value's
# observed effect into a contract for everything that variable later meets.
# Replace each with a variable derived from the owner and a positional index —
# single assignment makes that collision-free without a name supply — and hand back
# the concrete as a bound for the caller to record with the right role.
fn freshen_arrow_effects(owner: String, t: types.Type, idx: Int) -> Freshened =
  match t with
  | types.TFunc p r e o ->
      match freshen_arrow_effects(owner, p, idx) with
      | Freshened p2 i1 b1 ->
          match freshen_arrow_effects(owner, r, i1) with
          | Freshened r2 i2 b2 ->
              freshen_one(owner, types.TFunc(p2, r2, types.EffectVar(derived_var(owner, i2)), o),
                          e, i2, list_append(b1, b2))
  | types.TThunk r e ->
      match freshen_arrow_effects(owner, r, idx) with
      | Freshened r2 i1 b1 ->
          freshen_one(owner, types.TThunk(r2, types.EffectVar(derived_var(owner, i1))),
                      e, i1, b1)
  | types.TApp b a ->
      match freshen_arrow_effects(owner, b, idx) with
      | Freshened b2 i1 b1 ->
          match freshen_arrow_effects(owner, a, i1) with
          | Freshened a2 i2 b2s -> Freshened(types.TApp(b2, a2), i2, list_append(b1, b2s))
  | types.TTuple xs ->
      match freshen_list(owner, xs, idx, Nil, Nil) with
      | Freshened rebuilt i1 bs -> Freshened(rebuilt, i1, bs)
  | types.TVar _ -> Freshened(t, idx, Nil)
  | types.TConst _ -> Freshened(t, idx, Nil)

# A concrete effect becomes a bound; a variable is left exactly as written, since
# it is already flexible and its own bounds travel with it.
fn freshen_one(owner: String, rebuilt: types.Type, e: types.Effect, idx: Int,
               acc: List (String, types.Effect)) -> Freshened =
  match e with
  | types.EffectVar _ -> Freshened(restore_effect(rebuilt, e), idx, acc)
  | types.EffectRow _ -> Freshened(restore_effect(rebuilt, e), idx, acc)
  | types.EffectPure ->
      Freshened(rebuilt, idx + 1, list_append(acc, [(derived_var(owner, idx), e)]))
  | types.EffectIO ->
      Freshened(rebuilt, idx + 1, list_append(acc, [(derived_var(owner, idx), e)]))

# Enumerated, not defaulted: a future effect-carrying constructor would silently
# DROP its effect here, and the loss is invisible — the type still checks
# (guidelines.md §2a).
fn restore_effect(t: types.Type, e: types.Effect) -> types.Type =
  match t with
  | types.TFunc p r _ o -> types.TFunc(p, r, e, o)
  | types.TThunk r _ -> types.TThunk(r, e)
  | types.TApp _ _ -> t
  | types.TTuple _ -> t
  | types.TVar _ -> t
  | types.TConst _ -> t

fn derived_var(owner: String, idx: Int) -> String =
  "$b" ++ owner ++ "/" ++ int_to_string(idx)

fn freshen_list(owner: String, xs: List types.Type, idx: Int,
                acc: List types.Type, bs: List (String, types.Effect)) -> Freshened =
  match xs with
  | Nil -> Freshened(types.TTuple(list_reverse(acc)), idx, bs)
  | Cons x rest ->
      match freshen_arrow_effects(owner, x, idx) with
      | Freshened x2 i1 b1 -> freshen_list(owner, rest, i1, Cons(x2, acc), list_append(bs, b1))

# Bind, but leave the variable's effects flexible and remember what was seen.
# At a join nothing is remembered, so the pre-change behaviour stands there.
fn bind_bounded(name: String, t: types.Type, subst: Dict types.Type,
                eff_subst: Dict types.Effect, role: BoundRole) -> Unified =
  match role with
  | NoBound -> unified_of_bind(bind_var(name, t, subst), eff_subst)
  | AsCeiling -> bind_bounded_with(name, t, subst, eff_subst, role)
  | AsFloor -> bind_bounded_with(name, t, subst, eff_subst, role)

fn bind_bounded_with(name: String, t: types.Type, subst: Dict types.Type,
                     eff_subst: Dict types.Effect, role: BoundRole) -> Unified =
  match freshen_arrow_effects(name, t, 0) with
  | Freshened rewritten _ bounds ->
      match record_bounds(eff_subst, bounds, role) with
      | Err e -> UnifyErr(e)
      | Ok es1 -> unified_of_bind(bind_var(name, rewritten, subst), es1)

fn record_bounds(eff_subst: Dict types.Effect, bounds: List (String, types.Effect),
                 role: BoundRole) -> Result String (Dict types.Effect) =
  match bounds with
  | Nil -> Ok(eff_subst)
  | Cons b rest ->
      match b with
      | (v, e) ->
          match record_one_bound(eff_subst, v, e, role) with
          | Err msg -> Err(msg)
          | Ok es1 -> record_bounds(es1, rest, role)

fn record_one_bound(eff_subst: Dict types.Effect, v: String, e: types.Effect,
                    role: BoundRole) -> Result String (Dict types.Effect) =
  match role with
  | AsCeiling -> record_upper(eff_subst, v, e)
  | AsFloor -> record_lower(eff_subst, v, e)
  | NoBound -> Ok(eff_subst)

fn lower_is_io(eff_subst: Dict types.Effect, v: String) -> Bool =
  match dict_get(lower_bound_key(v), eff_subst) with
  | Just e -> effect_is_io(e)
  | Nothing -> false

fn upper_is_pure(eff_subst: Dict types.Effect, v: String) -> Bool =
  match dict_get(upper_bound_key(v), eff_subst) with
  | Just e -> effect_is_pure(e)
  | Nothing -> false

fn bind_var(name: String, t: types.Type, subst: Dict types.Type) -> Result String (Dict types.Type) =
  match t with
  | types.TVar n ->
      if types.tyvar_identity(n) == name then Ok(subst)
      else Ok(dict_set(name, t, subst))
  | _ ->
      if occurs(name, subst, t)
      then Err("Infinite type: " ++ name ++ " occurs in " ++ types.type_to_string(t))
      else Ok(dict_set(name, t, subst))

# ---------------------------------------------------------------------------
# unification — pure and structural, with an explicit polarity
# ---------------------------------------------------------------------------
#
# Returns an extended substitution, or an error message.
# Callers that need to thread state must pass the updated subst to the next
# unification — this function is IO-free.

# Three spellings, no symmetric one. Every caller states which side is the
# contract, because a site left on the wrong direction is a silent hole or a
# false rejection and neither shows up in a corpus with no violations — a green
# suite is not evidence the audit was done (docs/effect-subsumption-v0.md §6.3).
export fn unify_expect_actual(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  expected: types.Type,
  actual: types.Type
) -> Unified =
  unify_directed(subst, eff_subst, ExpectedLeft, expected, actual)

export fn unify_actual_expected(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  actual: types.Type,
  expected: types.Type
) -> Unified =
  unify_directed(subst, eff_subst, ExpectedRight, actual, expected)

# A peer meet: `if` branches, binary operands, match-arm accumulation. Neither
# side is the contract, so no effect rejection happens here — today's behaviour,
# until part 2 gives joins a LUB/GLB rule of their own.
export fn unify_join(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  left: types.Type,
  right: types.Type
) -> Unified =
  unify_directed(subst, eff_subst, NoExpectation, left, right)

fn unify_directed(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  polarity: Polarity,
  left: types.Type,
  right: types.Type
) -> Unified =
  unify_applied(subst, eff_subst, polarity,
                apply_subst(subst, left), apply_subst(subst, right))

# Helpers to avoid nested-match-in-arm pattern (Sprout typechecker limitation)
# A type ARGUMENT keeps the enclosing polarity. Sprout declares no variance, so
# `Vec (Int -> Int)` against `Vec (Int -> Int !{IO})` is judged as if the element
# position were covariant — sound for reads, not for writes through a mutable
# container. Narrowing it to invariance is its own change: it would reject the
# accepting direction too, which nothing in the corpus needs today.
fn unify_tapp(subst: Dict types.Type, eff_subst: Dict types.Effect, polarity: Polarity,
              bl: types.Type, al: types.Type, br: types.Type, ar: types.Type) -> Unified =
  match unify_applied(subst, eff_subst, polarity, bl, br) with
  | UnifyErr e -> UnifyErr(e)
  | UnifyOk s1 es1 ->
      unify_applied(s1, es1, polarity, apply_subst(s1, al), apply_subst(s1, ar))

# The arrows' effects meet here, and this is the ONLY place an effect variable
# ever gets bound. `e1` and `e2` are unified BEFORE the parameter and return, so
# a later failure discards the binding along with the substitution — the two
# travel together in `Unified` precisely so a speculative unification that is
# thrown away cannot leave an effect binding behind.
fn unify_tfunc(subst: Dict types.Type, eff_subst: Dict types.Effect, polarity: Polarity,
               p1: types.Type, r1: types.Type, e1: types.Effect,
               p2: types.Type, r2: types.Type, e2: types.Effect) -> Unified =
  match arrow_effect_meet(eff_subst, polarity, e1, e2) with
  | Err msg -> UnifyErr(msg)
  | Ok es1 -> unify_tfunc_parts(subst, es1, polarity, p1, r1, p2, r2)

fn unify_tfunc_parts(subst: Dict types.Type, eff_subst: Dict types.Effect, polarity: Polarity,
                     p1: types.Type, r1: types.Type,
                     p2: types.Type, r2: types.Type) -> Unified =
  match unify_applied(subst, eff_subst, flip_polarity(polarity), p1, p2) with
  | UnifyErr e -> UnifyErr(e)
  | UnifyOk s1 es1 ->
      unify_applied(s1, es1, polarity, apply_subst(s1, r1), apply_subst(s1, r2))

# A thunk has no parameter and no ownership, so this is unify_tfunc without
# either: meet the effects on the same bind-never-reject terms, then the results.
fn unify_tthunk(subst: Dict types.Type, eff_subst: Dict types.Effect, polarity: Polarity,
                r1: types.Type, e1: types.Effect,
                r2: types.Type, e2: types.Effect) -> Unified =
  match arrow_effect_meet(eff_subst, polarity, e1, e2) with
  | Err msg -> UnifyErr(msg)
  | Ok es1 -> unify_applied(subst, es1, polarity, r1, r2)

# The BINDING half of an arrow-position meet — it still never rejects. Rejection
# is `arrow_effect_meet`'s, which calls this only for the cells that survive.
#
# `unify_effects` has an Err arm for a row meeting an incompatible row, and that
# arm must not reach a user: an effect imprecision anywhere in inference would
# become a compile error on correct code. Swallowing it keeps that guarantee, so
# inference can make the REPORT wrong but never the ACCEPT/REJECT decision.
fn unify_arrow_effects(eff_subst: Dict types.Effect, e1: types.Effect, e2: types.Effect) -> Dict types.Effect =
  match unify_effects(eff_subst, e1, e2) with
  | Ok es -> es
  | Err _ -> eff_subst

# The arrow-position rule (spec §7, docs/effect-subsumption-v0.md §6.3): the
# ACTUAL arrow may perform at most what the EXPECTED slot permits. Only the
# concrete pure-slot/IO-value cell rejects; everything else binds as before, so
# every `!{e}` combinator keeps working.
#
# A row is not something a conformant signature can write (rule 9), but
# inference builds rows internally via `merge_effects`, so the arm is reachable
# and says so rather than falling through to a silent accept.
# The meet, with the substitution applied so a variable already pinned to `!{IO}`
# is judged as `!{IO}` rather than as a variable — §6.4a's laundering hole. A
# variable that is still open records a bound instead of binding, so the verdict
# waits for the side that is actually a contract (§6.4b).
fn arrow_effect_meet(eff_subst: Dict types.Effect, polarity: Polarity,
                     e1: types.Effect, e2: types.Effect) -> Result String (Dict types.Effect) =
  match polarity with
  | NoExpectation -> Ok(unify_arrow_effects(eff_subst, e1, e2))
  | ExpectedLeft ->
      effect_slot_meet(eff_subst, apply_effect_subst(eff_subst, e1),
                       apply_effect_subst(eff_subst, e2))
  | ExpectedRight ->
      effect_slot_meet(eff_subst, apply_effect_subst(eff_subst, e2),
                       apply_effect_subst(eff_subst, e1))

fn effect_slot_meet(eff_subst: Dict types.Effect, expected: types.Effect,
                    actual: types.Effect) -> Result String (Dict types.Effect) =
  match (expected, actual) with
  | (types.EffectVar v, _) ->
      # The slot is open: what arrives is a floor on it.
      record_lower(bind_open(eff_subst, v, actual), v, actual)
  | (_, types.EffectVar v) ->
      # The value is open: the slot is a ceiling on it.
      record_upper(bind_open(eff_subst, v, expected), v, expected)
  | _ ->
      match effect_slot_error(expected, actual) with
      | Just msg -> Err(msg)
      | Nothing -> Ok(unify_arrow_effects(eff_subst, expected, actual))

# Keep today's binding for a still-unbound variable so `!{e}` continues to resolve;
# the bound recorded alongside is what makes the resolution checkable.
fn bind_open(eff_subst: Dict types.Effect, v: String, e: types.Effect) -> Dict types.Effect =
  match dict_get(v, eff_subst) with
  | Just _ -> eff_subst
  | Nothing -> unify_arrow_effects(eff_subst, types.EffectVar(v), e)

# Total over both sides. A catch-all here would answer "accept" for a
# constructor added later, and the one cell that must reject is a single pair —
# so the wrong default is the silent one (guidelines.md §2a).
#
# A row DECLINES rather than rejects. The design predicted no row could reach
# here; it can — a written `!{IO, e}` reaches this comparison at the call, ahead
# of rule 9, and rejecting it masked rule 9's diagnostic with a worse one
# (tests/conformance/type_error/effect_mixed_row.spr). Same shape as the
# instance-side row in §6.1a: the pass that sees it first is not the pass that
# should name it.
fn effect_slot_error(expected: types.Effect, actual: types.Effect) -> Maybe String =
  match (expected, actual) with
  | (types.EffectRow _, _) -> Nothing
  | (_, types.EffectRow _) -> Nothing
  | (types.EffectPure, types.EffectIO) -> Just(io_into_pure_error())
  | (types.EffectPure, types.EffectPure) -> Nothing
  | (types.EffectPure, types.EffectVar _) -> Nothing
  | (types.EffectIO, types.EffectPure) -> Nothing
  | (types.EffectIO, types.EffectIO) -> Nothing
  | (types.EffectIO, types.EffectVar _) -> Nothing
  | (types.EffectVar _, types.EffectPure) -> Nothing
  | (types.EffectVar _, types.EffectIO) -> Nothing
  | (types.EffectVar _, types.EffectVar _) -> Nothing

fn io_into_pure_error() -> String =
  "a function that performs IO cannot be used where a pure one is required"
    ++ " — spec-v0.md §7. A pure function is accepted wherever an `!{IO}` one is"
    ++ " expected; the reverse would let the IO run behind a pure signature."

# Parameter ownership is INVARIANT (M4.6): the two conventions are different
# types and neither substitutes for the other. Both directions are unsound —
# supplying a consuming function where a borrowing one is expected means the
# argument is released by a call the caller still owns the value after (double
# consume); supplying a borrowing one where consuming is expected discharges the
# caller's obligation via a call that releases nothing (leak). Swift SE-0377
# reaches the same rule for a noncopyable parameter: "the convention must match
# exactly".
#
# Effects are deliberately still ignored above; ownership is not, because an
# ownership mismatch is a soundness bug rather than a conservatism knob.
fn unify_tfunc_owned(subst: Dict types.Type, eff_subst: Dict types.Effect, polarity: Polarity,
                     l: types.Type, r: types.Type,
                     p1: types.Type, r1: types.Type, e1: types.Effect, o1: types.Ownership,
                     p2: types.Type, r2: types.Type, e2: types.Effect, o2: types.Ownership) -> Unified =
  if types.ownership_eq(o1, o2)
  then unify_tfunc(subst, eff_subst, polarity, p1, r1, e1, p2, r2, e2)
  else UnifyErr(ownership_mismatch_error(l, r, o1, o2))

# The explanation branches on WHICH pair actually mismatched. It used to be a
# single sentence about `borrowing`, written when Ownership had two values; once
# `once` was added that text named the wrong modifier and offered a workaround
# about a modifier the program did not use.
fn ownership_mismatch_error(l: types.Type, r: types.Type,
                            o1: types.Ownership, o2: types.Ownership) -> String =
  "ownership mismatch: " ++ types.type_to_string(l) ++ " vs " ++ types.type_to_string(r)
    ++ " — " ++ ownership_mismatch_reason(o1, o2)

fn ownership_mismatch_reason(o1: types.Ownership, o2: types.Ownership) -> String =
  if types.ownership_is_once(o1) || types.ownership_is_once(o2) then once_mismatch_reason()
  else borrow_mismatch_reason()

fn once_mismatch_reason() -> String =
  "these differ only in whether the parameter is `once`, and that must match exactly: `once` promises the callee invokes it at most once, which is what licenses a caller to move a linear value into the closure it passes — a function without the promise cannot stand in for one with it"

fn borrow_mismatch_reason() -> String =
  "these differ only in how the parameter is taken, and a `borrowing` parameter's convention must match exactly; note that an arrow type cannot yet be written with `borrowing`"

# A unification mismatch. If either side is (or mentions) a skolem, the real
# fault is an existential type leaking out of its match branch — rephrase rather
# than surface the internal "$sk3" name. See docs/gadts-v0.md §7/§8.
fn type_mismatch_error(l: types.Type, r: types.Type) -> String =
  if types.type_mentions_skolem(l) || types.type_mentions_skolem(r)
  then "existential type escapes its scope: a hidden `exists`-bound type cannot be used at a concrete or a different hidden type"
  else "Type mismatch: " ++ types.type_to_string(l) ++ " vs " ++ types.type_to_string(r)
         ++ list_vec_hint(l, r)

# `List` and `Vec` are the pair users most often expect to be interchangeable,
# and the bare mismatch names no way across. The remedy is deliberately
# DIRECTION-AGNOSTIC: the two sides arrive in opposite orders depending on
# position — an argument reports `Vec vs List`, a return `List vs Vec` — so
# naming a single conversion would be wrong half the time. The second sentence
# is the one that answers the question actually being asked, which is why a list
# literal in the same slot was accepted and this value is not.
# Fixtures: tests/conformance/type_error/vec_{nonliteral,return}_list_not_coerced.
fn list_vec_hint(l: types.Type, r: types.Type) -> String =
  if is_list_vec_pair(l, r)
  then " — `List` and `Vec` are distinct types; convert with vec_from_list or vec_to_list (a list literal or comprehension in a `Vec` position converts automatically, spec 5.5.1, but a `List`-typed value carries no such proof before inference)"
  else ""

fn is_list_vec_pair(l: types.Type, r: types.Type) -> Bool =
  let a = type_head_name(l)
      b = type_head_name(r)
  in ((a == "List") && (b == "Vec")) || ((a == "Vec") && (b == "List"))

# The head constructor of an applied type: `Vec Int` -> "Vec". Empty for any
# shape without one (a variable, an arrow, a tuple).
fn type_head_name(t: types.Type) -> String =
  match t with
  | types.TConst id -> types.type_id_name(id)
  | types.TApp base _ -> type_head_name(base)
  | _ -> ""

fn unify_applied(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  polarity: Polarity,
  l: types.Type,
  r: types.Type
) -> Unified =
  match (l, r) with
  | (types.TVar a, types.TVar b) ->
      # Bind right→left so the left (expected/older) TVar stays canonical.
      # This ensures @fwd markers (keyed by the instantiation TVar) remain
      # reachable after tuple pattern matching introduces fresh element vars.
      if types.tyvar_eq(a, b) then UnifyOk(subst, eff_subst)
      else unified_of_bind(bind_var(types.tyvar_identity(b), l, subst), eff_subst)
  # The bound side's role decides how its concrete effects are remembered: a value
  # gives a floor, a written slot gives a ceiling. `bind_bounded` freshens them so
  # neither becomes a contract for whatever the variable meets next (§6.4b).
  | (types.TVar a, _) ->
      bind_bounded(types.tyvar_identity(a), r, subst, eff_subst, bound_role(polarity, false))
  | (_, types.TVar b) ->
      bind_bounded(types.tyvar_identity(b), l, subst, eff_subst, bound_role(polarity, true))
  | (types.TConst a, types.TConst b) ->
      # Module-qualified type identity (T7): exact match on the canonical name.
      # Bare-name comparison (after_last_dot both sides) silently unified two
      # same-short-named types from different modules — distinct layouts, one
      # identity. The bundler already resolves references to canonical names, so
      # equal identity means equal name; the prelude's canonical form is unqualified.
      if types.type_id_eq(a, b) then UnifyOk(subst, eff_subst) else UnifyErr(type_mismatch_error(l, r))
  | (types.TApp bl al, types.TApp br ar) -> unify_tapp(subst, eff_subst, polarity, bl, al, br, ar)
  | (types.TFunc p1 r1 e1 o1, types.TFunc p2 r2 e2 o2) ->
      unify_tfunc_owned(subst, eff_subst, polarity, l, r, p1, r1, e1, o1, p2, r2, e2, o2)
  | (types.TThunk r1 e1, types.TThunk r2 e2) ->
      unify_tthunk(subst, eff_subst, polarity, r1, e1, r2, e2)
  | (types.TTuple xs, types.TTuple ys) -> unify_list(subst, eff_subst, polarity, xs, ys)
  | _ ->
      UnifyErr(type_mismatch_error(l, r))

fn unify_list_step(subst: Dict types.Type, eff_subst: Dict types.Effect, polarity: Polarity,
                   x: types.Type, y: types.Type,
                   xr: List types.Type, yr: List types.Type) -> Unified =
  match unify_applied(subst, eff_subst, polarity,
                      apply_subst(subst, x), apply_subst(subst, y)) with
  | UnifyErr e -> UnifyErr(e)
  | UnifyOk s1 es1 -> unify_list(s1, es1, polarity, xr, yr)

fn unify_list(
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  polarity: Polarity,
  xs: List types.Type,
  ys: List types.Type
) -> Unified =
  match (xs, ys) with
  | (Nil, Nil) -> UnifyOk(subst, eff_subst)
  | (Nil, _) -> UnifyErr("Tuple arity mismatch")
  | (_, Nil) -> UnifyErr("Tuple arity mismatch")
  | (Cons x xr, Cons y yr) -> unify_list_step(subst, eff_subst, polarity, x, y, xr, yr)

# ---------------------------------------------------------------------------
# unify_effects — pure effect-row unification
# ---------------------------------------------------------------------------
#
# Conservative: IO and Pure unify as IO (callee decides if it can accept it).

export fn unify_effects(
  eff_subst: Dict types.Effect,
  left: types.Effect,
  right: types.Effect
) -> Result String (Dict types.Effect) =
  unify_effects_applied(
    eff_subst,
    apply_effect_subst(eff_subst, left),
    apply_effect_subst(eff_subst, right)
  )

fn unify_effects_applied(
  eff_subst: Dict types.Effect,
  l: types.Effect,
  r: types.Effect
) -> Result String (Dict types.Effect) =
  match (l, r) with
  | (types.EffectVar a, types.EffectVar b) ->
      if a == b then Ok(eff_subst) else Ok(dict_set(a, r, eff_subst))
  | (types.EffectVar a, _) -> Ok(dict_set(a, r, eff_subst))
  | (_, types.EffectVar b) -> Ok(dict_set(b, l, eff_subst))
  | (types.EffectPure, types.EffectPure) -> Ok(eff_subst)
  | (types.EffectIO, types.EffectIO) -> Ok(eff_subst)
  | (types.EffectPure, types.EffectIO) -> Ok(eff_subst)
  | (types.EffectIO, types.EffectPure) -> Ok(eff_subst)
  | _ ->
      Err("Effect mismatch: " ++ types.effect_to_string(l) ++ " vs " ++ types.effect_to_string(r))

# ---------------------------------------------------------------------------
# instantiate — replace quantified variables with fresh ones
# ---------------------------------------------------------------------------

export fn instantiate(state: InferState, scheme: types.Scheme) -> types.Type !{IO} =
  do
    type_repl <- build_type_repl(state, types.scheme_vars(scheme), dict_empty())
    effect_repl <- build_effect_repl(state, types.scheme_effect_vars(scheme), dict_empty())
    apply_full_subst(type_repl, effect_repl, types.scheme_type(scheme))

# Like instantiate but also returns the prog-var → fresh-TVar substitution.
# Used by infer.check_fn_body to build constraint-forwarding markers.
export fn instantiate_with_vars(state: InferState, scheme: types.Scheme) -> (types.Type, Dict types.Type) !{IO} =
  do
    type_repl <- build_type_repl(state, types.scheme_vars(scheme), dict_empty())
    effect_repl <- build_effect_repl(state, types.scheme_effect_vars(scheme), dict_empty())
    let t = apply_full_subst(type_repl, effect_repl, types.scheme_type(scheme))
    (t, type_repl)

# Instantiate a constructor scheme for use in a PATTERN (unpack). A scheme var
# that does NOT appear in the ctor's result type is existential (a head param
# always appears in the result; an existential never does) and is instantiated
# to a fresh rigid skolem TConst ($sk<n>). The existing nominal-unification rule
# (unify(TConst,TConst) succeeds only on name equality) then keeps it abstract
# for free: unifying a skolem with a concrete type or a distinct skolem fails,
# which is exactly the existential escape/merge soundness guard. Ordinary type
# params instantiate to fresh TVars, as in `instantiate`. See docs/gadts-v0.md.
export fn instantiate_ctor_pattern(state: InferState, scheme: types.Scheme) -> types.Type !{IO} =
  do
    let body = types.scheme_type(scheme)
    let result_ftv = types.ftv(ctor_result_of(body))
    type_repl <- build_ctor_pattern_repl(state, types.scheme_vars(scheme), result_ftv, dict_empty())
    effect_repl <- build_effect_repl(state, types.scheme_effect_vars(scheme), dict_empty())
    apply_full_subst(type_repl, effect_repl, body)

fn ctor_result_of(t: types.Type) -> types.Type =
  match t with
  | types.TFunc _ ret _ _ -> ctor_result_of(ret)
  | _ -> t

fn build_ctor_pattern_repl(state: InferState, vars: List String, result_ftv: List String, acc: Dict types.Type) -> Dict types.Type !{IO} =
  match vars with
  | Nil -> acc
  | Cons v rest ->
      do
        repl <- fresh_ctor_pattern_var(state, v, result_ftv)
        build_ctor_pattern_repl(state, rest, result_ftv, dict_set(v, repl, acc))

fn fresh_ctor_pattern_var(state: InferState, v: String, result_ftv: List String) -> types.Type !{IO} =
  if list_member(v, result_ftv) then fresh_pattern_tvar(state) else fresh_pattern_skolem(state)

fn fresh_pattern_tvar(state: InferState) -> types.Type !{IO} =
  do
    name <- fresh(state)
    types.TVar(types.tyvar_id(name))

fn fresh_pattern_skolem(state: InferState) -> types.Type !{IO} =
  do
    n <- fresh_skolem(state)
    types.TConst(types.type_id(n))

# A skolem is a rigid, uniquely-named type CONSTANT (not a variable). "$" cannot
# open a user identifier, so "$sk<n>" can never name a real type — same
# no-collision guarantee as `fresh`. Shares the tyvar counter for uniqueness.
fn fresh_skolem(state: InferState) -> String !{IO} =
  match state with
  | InferState t_ref _ _ _ _ ->
      do
        n <- ref_read(t_ref)
        ref_write(t_ref, n + 1)
        "$sk" ++ int_to_string(n)

fn build_type_repl(state: InferState, vars: List String, acc: Dict types.Type) -> Dict types.Type !{IO} =
  match vars with
  | Nil -> acc
  | Cons v rest ->
      do
        name <- fresh(state)
        build_type_repl(state, rest, dict_set(v, types.TVar(types.tyvar_id(name)), acc))

fn build_effect_repl(state: InferState, vars: List String, acc: Dict types.Effect) -> Dict types.Effect !{IO} =
  match vars with
  | Nil -> acc
  | Cons v rest ->
      do
        name <- fresh_effect(state)
        build_effect_repl(state, rest, dict_set(v, types.EffectVar(name), acc))

# ---------------------------------------------------------------------------
# generalize — universally quantify type variables free in t but not in env
# ---------------------------------------------------------------------------

export fn generalize(
  env_ftv: List String,
  subst: Dict types.Type,
  eff_subst: Dict types.Effect,
  t: types.Type,
  e: types.Effect
) -> types.Scheme =
  generalize_resolved(
    env_ftv,
    apply_full_subst(subst, eff_subst, t),
    apply_effect_subst(eff_subst, e)
  )

fn generalize_resolved(env_ftv: List String, resolved: types.Type, resolved_eff: types.Effect) -> types.Scheme =
  types.Scheme(
    types.list_diff(types.ftv(resolved), env_ftv),
    # scheme_effect_vars_of, not ftv_effect: an inferred function value can carry
    # an effect variable in a parameter's arrow with nothing at the top level, and
    # a scheme that fails to name it leaves it globally shared after instantiation.
    types.list_diff(types.scheme_effect_vars_of(resolved, resolved_eff), env_ftv),
    resolved,
    resolved_eff,
    Nil
  )

# ---------------------------------------------------------------------------
# ftv_env — union of free type variables across all schemes in an environment
# ---------------------------------------------------------------------------

export fn ftv_env(env: Dict types.Scheme) -> List String =
  vec_fold(\ (acc, s) -> types.list_union(types.ftv_scheme(s), acc), Nil, dict_values(env))
