module stdlib.compiler.linear_check

import stdlib.compiler.ast as ast
import stdlib.compiler.types as types
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.source as source

# ---------------------------------------------------------------------------
# Linear-types M4.2 — consume-exactly-once enforcement.
# ---------------------------------------------------------------------------
#
# A value of a `type linear` type must be used exactly once in a function body:
# not zero times (a leaked resource), not twice (use-after-consume). This is a
# post-pass over the fully-substituted typed AST — inference is untouched
# (linearity is looked up from the `@linear:<TypeName>` env sentinel M4.1 records,
# never inferred). See docs/linear-types-m4.2-enforcement-2026-08-06.md.
#
# The analysis computes, per subexpression, TWO sets of linear bindings: the ones
# it CONSUMES and the ones it merely BORROWS (M4.5). Composition rules:
#   - sequential siblings' consumed sets must be DISJOINT (twice -> reuse error);
#   - a later sibling may not BORROW what an earlier one CONSUMED (use-after-
#     consume); the reverse order — borrow then consume — is the normal session
#     shape and is fine;
#   - `if`/`match` arms must consume the IDENTICAL set (branch convergence), but
#     their borrowed sets merely union: a borrow carries no obligation;
#   - each OWNED linear binding must appear in its scope's consumed set exactly
#     once (0 -> leak). A borrow never discharges that obligation.
# Consume-exactly-once on every control-flow path follows: disjointness bounds a
# path at <=1, scope-membership forces >=1, convergence makes all paths agree.
#
# M4.5 BORROWING. A parameter declared `borrowing` is used without claiming the
# value's one consuming use, so an acquire -> use N times -> release once resource
# (a socket) becomes expressible. A reference is a borrow iff it sits at a
# `borrowing` parameter position of the callee, or the binding it names is itself
# a `borrowing` parameter — the latter is what makes a field read `p.x` borrow on
# a borrowed binding while still consuming on an owned one, with no rule about
# field syntax at all. Modifiers are erased before lowering and reach no IR pass.
# See docs/linear-borrowing-v0.md.
#
# Scope (M4.2): EVERY binder that can hold a linear value — function parameters,
# do-block `let`, match-arm pattern variables (a var pattern aliases the whole
# linear scrutinee; a constructor/tuple sub-pattern binds a linear field, resolved
# by `pattern_linear_binders`), and `<-` do-bind vars — in `fn`, top-level `let`,
# and instance-method bodies. Deferred (loud-rejected, never silently accepted):
# a linear lambda parameter and a linear binding captured by a lambda body
# (higher-order linearity, M4.4 — a closure may run 0..n times).

# A consumed linear binding: its name, and where it was consumed.
export type LinUse (..) = LinUse String source.SourcePos

# A binder carrying a linear obligation: its name, and the type that gives it one.
# The type travels with the name because under containment they differ — `xs` is
# obliged because `List File` MENTIONS `File`, and a diagnostic naming only `xs`
# describes a rule the reader cannot look up.
type LinBinder (..) = LinBinder String types.Type

fn lbind_name(b: LinBinder) -> String =
  match b with | LinBinder n _ -> n

fn lbind_type(b: LinBinder) -> types.Type =
  match b with | LinBinder _ t -> t

fn binder_names(bs: List LinBinder) -> List String =
  list_map(lbind_name, bs)

fn app_binders(a: List LinBinder, b: List LinBinder) -> List LinBinder =
  match a with
  | Nil -> b
  | Cons x rest -> Cons(x, app_binders(rest, b))

# Result of a use-set computation: the linear bindings CONSUMED (each at most once
# along any path) and those merely BORROWED, or a diagnostic. Two sets, not one:
# a borrow neither discharges the once-only obligation nor collides with another
# use, so it cannot be folded into the consumed set — but it must still be ordered
# against consumes, which is what the second list makes possible.
export type LinRes (..) =
  | LinOk (List LinUse) (List LinUse)
  | LinErr source.SourcePos String

# Result of checking a whole function body.
export type LinCheck (..) =
  | LinPass
  | LinFail source.SourcePos String

# --- small set helpers over List LinUse / List String ---

fn luse_name(u: LinUse) -> String =
  match u with
  | LinUse n _ -> n

fn luse_pos(u: LinUse) -> source.SourcePos =
  match u with
  | LinUse _ p -> p

fn luse_member(name: String, us: List LinUse) -> Bool =
  match us with
  | Nil -> false
  | Cons u rest -> if luse_name(u) == name then true else luse_member(name, rest)

fn luse_remove(name: String, us: List LinUse) -> List LinUse =
  match us with
  | Nil -> Nil
  | Cons u rest ->
      if luse_name(u) == name then luse_remove(name, rest)
      else Cons(u, luse_remove(name, rest))

fn str_member(x: String, xs: List String) -> Bool =
  match xs with
  | Nil -> false
  | Cons y rest -> if y == x then true else str_member(x, rest)

# A name present in `a` but absent from `b`, if any (drives divergence errors).
fn first_missing(a: List LinUse, b: List LinUse) -> Maybe String =
  match a with
  | Nil -> Nothing
  | Cons u rest ->
      if luse_member(luse_name(u), b) then first_missing(rest, b)
      else Just(luse_name(u))

# --- linearity of a type head (mirrors infer.type_head_str / type_name_is_linear;
#     reimplemented here to avoid an infer <-> linear_check import cycle) ---

fn head_type_name(t: types.Type) -> String =
  match t with
  | types.TConst name -> types.type_id_name(name)
  | types.TApp base _ -> head_type_name(base)
  | types.TVar name -> types.tyvar_identity(name)
  | types.TTuple items -> "Tuple" ++ int_to_string(list_length(items))
  | _ -> types.type_to_string(t)

fn type_is_linear(t: types.Type, env: Dict types.Scheme) -> Bool =
  match dict_get("@linear:" ++ head_type_name(t), env) with
  | Just _ -> true
  | Nothing -> false

# True when the program declares any linear type (a cheap gate that lets a
# linear-free compilation skip the whole pass — set alongside @linear:<name>).
export fn program_has_linear(env: Dict types.Scheme) -> Bool =
  match dict_get("@any_linear", env) with
  | Just _ -> true
  | Nothing -> false

# --- resolving the types of pattern-bound variables (for linear tracking) ---
#
# A pattern that binds a variable to a linear value (or a linear field of one)
# introduces a NEW linear binding that must itself be consumed exactly once — a
# plain `VarPattern` aliases the WHOLE scrutinee; a constructor sub-pattern binds
# a field. We recover each bound variable's type by matching the pattern against
# the (already fully-substituted) value type, and report the linear ones.

fn ctor_result_ty(t: types.Type) -> types.Type =
  match t with
  | types.TFunc _ ret _ _ -> ctor_result_ty(ret)
  | _ -> t

fn ctor_param_tys(t: types.Type) -> List types.Type =
  match t with
  | types.TFunc p rest _ _ -> Cons(p, ctor_param_tys(rest))
  | _ -> Nil

# Read off the constructor's tyvar instantiation by structurally aligning its
# declared result type with the concrete scrutinee type. No unifier needed: the
# scrutinee is already concrete, so each tyvar maps to the aligned subtree.
fn struct_match(decl: types.Type, concrete: types.Type, acc: Dict types.Type) -> Dict types.Type =
  match decl with
  | types.TVar name -> dict_set(types.tyvar_identity(name), concrete, acc)
  | types.TApp f x ->
      match concrete with
      | types.TApp g y -> struct_match(x, y, struct_match(f, g, acc))
      | _ -> acc
  | types.TFunc a b _ _ ->
      match concrete with
      | types.TFunc c d _ _ -> struct_match(b, d, struct_match(a, c, acc))
      | _ -> acc
  | types.TThunk b _ ->
      match concrete with
      | types.TThunk d _ -> struct_match(b, d, acc)
      | _ -> acc
  | types.TTuple items ->
      match concrete with
      | types.TTuple citems -> struct_match_list(items, citems, acc)
      | _ -> acc
  | _ -> acc

fn struct_match_list(ds: List types.Type, cs: List types.Type, acc: Dict types.Type) -> Dict types.Type =
  match (ds, cs) with
  | (Cons d drest, Cons c crest) -> struct_match_list(drest, crest, struct_match(d, c, acc))
  | _ -> acc

fn apply_tvar_subst(sub: Dict types.Type, t: types.Type) -> types.Type =
  match t with
  | types.TVar name ->
      match dict_get(types.tyvar_identity(name), sub) with
      | Just concrete -> concrete
      | Nothing -> t
  | types.TApp f x -> types.TApp(apply_tvar_subst(sub, f), apply_tvar_subst(sub, x))
  | types.TFunc a b e o -> types.TFunc(apply_tvar_subst(sub, a), apply_tvar_subst(sub, b), e, o)
  | types.TThunk b e -> types.TThunk(apply_tvar_subst(sub, b), e)
  | types.TTuple items -> types.TTuple(list_map(\i -> apply_tvar_subst(sub, i), items))
  | _ -> t

# The field types of constructor `ctor` when its result equals `value_type`.
fn ctor_field_types_at(ctor: String, value_type: types.Type, env: Dict types.Scheme) -> Maybe (List types.Type) =
  match dict_get(ctor, env) with
  | Nothing -> Nothing
  | Just scheme ->
      match scheme with
      | types.Scheme _ _ body _ _ ->
          Just(list_map(\ft -> apply_tvar_subst(struct_match(ctor_result_ty(body), value_type, dict_empty()), ft),
                        ctor_param_tys(body)))

# The variables a pattern binds that carry a linear obligation, when matched
# against `value_type`.
#
# `type_mentions_linear`, not `type_is_linear`: a binder is obliged when its type
# CONTAINS a linear type, not only when its head is one. Head-only left every
# container silently leaking — `let m = Just(File(1)) in 7` compiled — while the
# discarded-do-step rule next door already used containment for the same reason.
# See docs/linearity-virality-v0.md §1.1.
fn pattern_linear_binders(pat: ast.Pattern, value_type: types.Type, env: Dict types.Scheme) -> List LinBinder =
  match pat with
  | ast.VarPattern name _ ->
      if type_mentions_linear(value_type, env) then Cons(LinBinder(name, value_type), Nil) else Nil
  | ast.WildcardPattern _ -> Nil
  | ast.IntPattern _ _ -> Nil
  | ast.BoolPattern _ _ -> Nil
  | ast.StringPattern _ _ -> Nil
  | ast.CharPattern _ _ -> Nil
  | ast.UnitPattern _ -> Nil
  | ast.TuplePattern pats _ ->
      match value_type with
      | types.TTuple items -> pattern_binders_list(pats, items, env)
      | _ -> Nil
  | ast.ConstructorPattern ctor subpats _ ->
      match ctor_field_types_at(ctor, value_type, env) with
      | Just field_tys -> pattern_binders_list(subpats, field_tys, env)
      | Nothing -> Nil

fn pattern_binders_list(pats: List ast.Pattern, tys: List types.Type, env: Dict types.Scheme) -> List LinBinder =
  match (pats, tys) with
  | (Cons p prest, Cons t trest) ->
      app_binders(pattern_linear_binders(p, t, env), pattern_binders_list(prest, trest, env))
  | _ -> Nil

# In a `x <- m` do-bind the bound variable's type is m's payload. The monad kind
# (Maybe/Result unwrap vs effectful no-unwrap) isn't recoverable here, so we take
# the last type argument: sound (catches every linear payload), only over-strict
# on the rare effectful bind of a non-linear container of a linear.
fn payload_type(t: types.Type) -> types.Type =
  match t with
  | types.TApp _ arg -> arg
  | _ -> t

# The type a `<-` bind introduces. For a monadic bind the pattern binds the container's PAYLOAD
# (`x <- (m: Maybe File)` binds `x: File`), recovered by `payload_type`. For an effect bind
# (`h <- (io: Task a !{IO})`) the pattern binds the FULL result type — `<-` does not unwrap an
# effect — so an effect-bound linear value must be tracked whole. The post-pass cannot see the
# monad kind, so decide structurally: if the full type is itself linear it is an effect-bound
# linear (use it whole); otherwise fall back to the payload (the monadic case, and the existing
# conservative over-strict edge where a non-linear container holds a linear).
#
# A PHANTOM last position is not a payload. `Handle File` yields no File — the
# declaration stores an Int — so stripping the argument invented an obligation
# the same value escapes as a `let` binder or a parameter, and reported it under
# a type the binder does not have. Bind the container whole instead; containment
# then declines to descend the phantom position, as it does everywhere else.
fn do_bind_type(t: types.Type, env: Dict types.Scheme) -> types.Type =
  if type_is_linear(t, env) then t
  else if last_arg_is_phantom(t, env) then t
  else payload_type(t)

fn last_arg_is_phantom(t: types.Type, env: Dict types.Scheme) -> Bool =
  match t with
  | types.TApp _ _ ->
      param_is_phantom(head_type_name(t), list_length(app_spine_args(t)) - 1, env)
  | _ -> false

fn app_names(a: List String, b: List String) -> List String =
  match a with
  | Nil -> b
  | Cons x rest -> Cons(x, app_names(rest, b))

# Each name in `binders` must appear in `consumed` (else it leaked); returns the
# first unconsumed one.
fn unconsumed_binder(binders: List LinBinder, consumed: List LinUse) -> Maybe LinBinder =
  match binders with
  | Nil -> Nothing
  | Cons b rest ->
      if luse_member(lbind_name(b), consumed) then unconsumed_binder(rest, consumed) else Just(b)

fn remove_all(names: List String, us: List LinUse) -> List LinUse =
  match names with
  | Nil -> us
  | Cons n rest -> remove_all(rest, luse_remove(n, us))

# The lambda parameter that still defers the whole lambda: linear, and NOT taken
# `borrowing` — a borrowing one is admissible (M4.4b), so only an owned one is a
# rejection. Ownership is read off the TYPE, which is where it lives and the only
# place it is found when the mode is unwritten and pushed down from the slot.
#
# Returns the binder, not just its name: under containment the obliged type is
# often not the linear one, and "linear lambda parameter 'x'" for `x: Maybe File`
# tells the reader a type is linear that §5.8 says is not. Same fix, and same
# reason, as leak_binder_msg on the binder path.
fn first_owned_linear_param(params: List ast.Param, lam_type: types.Type,
                            env: Dict types.Scheme) -> Maybe LinBinder =
  match params with
  | Nil -> Nothing
  | Cons prm rest ->
      match lam_type with
      | types.TFunc a b _ own ->
          if type_mentions_linear(a, env) && ! types.ownership_is_borrow (own)
          then Just(LinBinder(param_name(prm), a))
          else first_owned_linear_param(rest, b, env)
      | _ -> Nothing

# The complement: the names to track as borrowed while walking the body. Selected
# by type AND ownership, so a non-linear parameter at a `borrowing` slot is not
# tracked — nothing about it is checkable and the scope lists mean linearity.
fn borrowed_linear_params(params: List ast.Param, lam_type: types.Type,
                          env: Dict types.Scheme) -> List String =
  match params with
  | Nil -> Nil
  | Cons prm rest ->
      match lam_type with
      | types.TFunc a b _ own ->
          linear_param_cons(type_mentions_linear(a, env) && types.ownership_is_borrow(own),
                            param_name(prm), borrowed_linear_params(rest, b, env))
      | _ -> Nil

# The accumulator of a comprehension's synthesized fold, dropped before the
# search. It is the fold's first parameter and is not a binder the user wrote;
# under containment its type mentions the linear type on every step while the
# comprehension builds a `List File`, so searching it rejected every such
# comprehension and blamed the generator, which binds something else entirely.
# What remains after the drop is the generator binder — the thing M4.4 defers.
# POSITIONAL INVARIANT — the accumulator is the fold's FIRST parameter
# (infer.build_comp_fold), and only the first. Keyed on that position rather than
# on `is_comprehension_fold`, which answers the looser question "was this lambda
# synthesized" by scanning every parameter: a destructuring generator binds a
# generated name too, and dropping the head on the strength of a match further
# down would silently drop a real binder. Do not swap one predicate for the other.
fn drop_comp_acc_params(params: List ast.Param) -> List ast.Param =
  if first_param_is_comp_acc(params) then params_tail(params) else params

fn drop_comp_acc_type(params: List ast.Param, t: types.Type) -> types.Type =
  if first_param_is_comp_acc(params) then fn_type_tail(t) else t

fn first_param_is_comp_acc(params: List ast.Param) -> Bool =
  match params with
  | [] -> false
  | [prm | _] -> str_starts_with(param_name(prm), ast.comp_binder_prefix)

fn params_tail(ps: List ast.Param) -> List ast.Param =
  match ps with
  | Nil -> Nil
  | Cons _ rest -> rest

fn fn_type_tail(t: types.Type) -> types.Type =
  match t with
  | types.TFunc _ b _ _ -> b
  | _ -> t

# --- borrow-vs-consume composition (M4.5) ---

fn reuse_msg(name: String) -> String =
  "linear value '" ++ name ++ "' is used more than once (linear values must be used exactly once)"

fn leak_msg(name: String) -> String =
  "linear value '" ++ name ++ "' is never used (linear values must be used exactly once)"

# The leak wording for a BINDER, which under containment may be obliged by a type
# it merely contains. `let xs = [File(1)]` reported as "linear value 'xs'" is
# accurate and useless: `List File` is not a linear type, and a reader who has
# only met the `type linear` rule cannot see why `xs` is bound by it. So name the
# type and the linear type inside it. A binder that IS linear keeps the original
# wording — there is nothing to explain there.
fn leak_binder_msg(b: LinBinder, env: Dict types.Scheme) -> String =
  if type_is_linear(lbind_type(b), env) then leak_msg(lbind_name(b))
  else contained_leak_msg(lbind_name(b), lbind_type(b), first_linear_in(lbind_type(b), env))

fn contained_leak_msg(name: String, t: types.Type, inner: Maybe types.Type) -> String =
  match inner with
  | Nothing -> leak_msg(name)
  | Just lin ->
      "linear value '" ++ name ++ "' is never used: its type `" ++ types.type_to_string(t)
        ++ "` contains the linear type `" ++ types.type_to_string(lin)
        ++ "` (linear values must be used exactly once)"

fn diverge_msg(name: String) -> String =
  "linear value '" ++ name ++ "' is used in some branches but not others (every branch must use it exactly once)"

fn after_fallible_msg(name: String) -> String =
  "linear value '" ++ name ++ "' is consumed after a fallible bind in this block; the bind can short-circuit, so the consume would be skipped and the value leaked — consume it before the first `<-`, or branch with `match`"

fn after_consume_msg(name: String) -> String =
  "linear value '" ++ name ++ "' is used after it was consumed"

fn consumed_borrow_msg(name: String) -> String =
  "'" ++ name ++ "' is a borrowing parameter and cannot be consumed; take it `consuming` if this function should release it"

# The lambda's own wording, because the declared parameter's advice does not
# transfer: `consuming` on a linear lambda parameter is the rest of M4.4 and is
# still rejected, so pointing at it would send the reader into a second error.
# Goes through lambda_param_subject because the `_`-hole form reaches here more
# than any other — `with_file(n, release(_))` is the shape issue #364 reported.
fn lambda_consumed_borrow_msg(name: String) -> String =
  lambda_borrow_subject(name) ++ " cannot be consumed; the caller that passes the value releases it itself, so only read it here"

fn lambda_borrow_subject(name: String) -> String =
  if is_placeholder_param(name)
  then "the `_` placeholder in this partial application is borrowed and"
  else "'" ++ name ++ "' is a borrowing parameter of this lambda and"

# A `_`-hole lambda's parameter is named by the desugaring, not the author, who
# wrote `_`. Never print it — the same rule, and the same reason, as
# comprehension_binder_subject. Both lambda messages ask, so the test is one
# place: a second copy is how one of them drifts.
fn is_placeholder_param(name: String) -> Bool =
  str_starts_with(name, ast.placeholder_param_prefix)

fn method_once_mismatch_msg(name: String) -> String =
  "instance method parameter '" ++ name ++ "' must match the class declaration on `once`: a call dispatches through the CLASS signature, so callers move linear values into the closure they pass on the strength of the class's promise, and an instance free to invoke it repeatedly would consume those values more than once"

fn method_mismatch_msg(name: String) -> String =
  "instance method parameter '" ++ name ++ "' must match the class declaration's ownership: a call dispatches through the CLASS signature, so an instance that only borrows where the class consumes discharges the caller's obligation and leaks the value"

fn borrowed_field_read_msg() -> String =
  "a linear field cannot be read out of a borrowed value (its owner will still release it); take the parameter `consuming` if this function should own it"

fn borrowed_binder_msg(name: String) -> String =
  "linear value '" ++ name ++ "' is borrowed and cannot be consumed (it was destructured from a borrowed value, which its owner will still release)"

fn nonvar_borrow_msg() -> String =
  "a borrowing argument must be a variable reference (a freshly-built linear value here would never be consumed)"

# Which of the three reasons a modifier was rejected. They need different
# messages: telling the author of `fn f(x: borrowing a)` that `a` "is not a
# linear type" invites them to make `a` linear, which is not expressible — the
# real reason is that linearity is per-declaration and cannot be decided for a
# type variable. `once` fails for a reason of its own (M4.4a): it constrains how
# often the parameter is INVOKED, so it needs a function to invoke.
type BadModifier (..) =
  | BadOnTyvar String
  | BadNonLinear String
  | BadOnceNonFunction String
  | BadOnceOnTyvar String
  # A modifier written in the RETURN type, which names no parameter to blame.
  | BadInReturn

fn bad_modifier_message(b: BadModifier) -> String =
  match b with
  | BadOnTyvar name -> tyvar_modifier_msg(name)
  | BadNonLinear name -> bad_modifier_msg(name)
  | BadOnceNonFunction name -> once_modifier_msg(name)
  | BadOnceOnTyvar name -> once_tyvar_msg(name)
  | BadInReturn -> return_modifier_msg()

# The return type is checked by the same walk as a parameter's, so the fault it
# reports is already worded for a parameter. Re-word rather than re-derive: the
# walk knows WHICH rule failed, and only the caller knows the position.
fn return_modifier_msg() -> String =
  "an ownership modifier in a return type is only meaningful on a parameter of a linear type"


fn tyvar_modifier_msg(name: String) -> String =
  "`borrowing`/`consuming` cannot be used on a type variable (parameter '" ++ name ++ "'): linearity is per-declaration, so whether the argument is linear is not known here"

fn bad_modifier_msg(name: String) -> String =
  "`borrowing`/`consuming` is only allowed on a parameter of a linear type (parameter '" ++ name ++ "')"

fn once_modifier_msg(name: String) -> String =
  "`once` applies only to a function-typed parameter (parameter '" ++ name ++ "'): it bounds how many times the callee may invoke it"

fn once_tyvar_msg(name: String) -> String =
  "`once` cannot be used on a type variable (parameter '" ++ name ++ "'): the promise is that the callee INVOKES this parameter at most once, which it cannot do when the type is not known to be a function — while a caller could still move a linear value in and get it back out"

fn once_reuse_msg(name: String) -> String =
  "`once` parameter '" ++ name ++ "' is used more than once: declaring it `once` promises callers this function invokes it AT MOST once, and that promise is what licenses them to move a linear value into the closure they pass"

fn once_borrow_capture_msg(name: String) -> String =
  "borrowed value '" ++ name ++ "' cannot be captured by a closure passed to a `once` parameter: the closure may run after the value is consumed. Move it instead — pass ownership in and consume it inside the closure"

# The lambda restriction M4.4b did NOT lift — a CONSUMING linear parameter. It
# names `borrowing` so the wall has a door in it: an author whose lambda only
# reads the value is told which modifier says so, rather than being left at a
# dead end. Before M4.4b the door was `once`, which was never the answer here —
# `once` bounds how often a closure RUNS, not what may be handed to it per run.
fn linear_lambda_param_msg(name: String) -> String =
  "consuming " ++ lambda_param_subject(name) ++ " is not yet supported (higher-order linearity is deferred: the closure may run 0..n times, so the value cannot be proved consumed exactly once); take it `borrowing` if this lambda only reads the value"

fn lambda_param_subject(name: String) -> String =
  if is_placeholder_param(name)
  then "the `_` placeholder in this partial application"
  else "linear lambda parameter '" ++ name ++ "'"

# A parameter obliged by CONTAINMENT is not itself of a linear type, so the
# wording above would assert what §5.8 denies. Name the type and the linear type
# inside it, as contained_leak_msg does for a binder.
fn lambda_param_binder_msg(b: LinBinder, env: Dict types.Scheme) -> String =
  if type_is_linear(lbind_type(b), env) then linear_lambda_param_msg(lbind_name(b))
  else contained_lambda_param_msg(lbind_name(b), lbind_type(b),
                                  first_linear_in(lbind_type(b), env))

fn contained_lambda_param_msg(name: String, t: types.Type, inner: Maybe types.Type) -> String =
  match inner with
  | Nothing -> linear_lambda_param_msg(name)
  | Just lin ->
      "lambda parameter '" ++ name ++ "' has type `" ++ types.type_to_string(t)
        ++ "`, which contains the linear type `" ++ types.type_to_string(lin)
        ++ "`; this is not yet supported (higher-order linearity is deferred: the closure may run 0..n times, so the value cannot be proved consumed exactly once). `borrowing` is not a way out here — it is only allowed on a parameter whose own type is linear — so take the container apart before the lambda, or walk it in a named recursive function"

fn lambda_capture_msg(name: String) -> String =
  "linear value '" ++ name ++ "' captured by a lambda is not yet supported (higher-order linearity is deferred; if the callee invokes this closure at most once, declare that parameter `once`)"

# A comprehension elaborates to a fold over lambdas the user never wrote
# (infer.build_comp_fold), so the two messages above misdescribe it three ways:
# they name a lambda absent from the source, they advise declaring a callee
# parameter `once` when the callee is the elaboration's own `list_fold`, and for
# a non-variable generator pattern they print a generated binder name. These
# name the generator instead. The rewrite each one suggests is pinned by
# tests/stdlib/test_comprehension_linear_advice.spr, so advice that stops
# working fails a gate instead of rotting inside a message nobody re-checks.
fn comprehension_binder_msg(name: String) -> String =
  comprehension_binder_subject(name) ++ " binds a linear value, which is not yet supported (a comprehension elaborates to a fold, and higher-order linearity is deferred: the step function runs once per element, so a linear binder cannot yet be tracked across iterations); consume the elements in an explicit recursive function instead"

# The fold parameter is the user's own binder for a plain variable generator
# pattern, and a generated name for any other pattern; never show the latter.
fn comprehension_binder_subject(name: String) -> String =
  if str_starts_with(name, ast.comp_binder_prefix)
  then "this comprehension generator"
  else "comprehension generator '" ++ name ++ "'"

fn comprehension_capture_msg(name: String) -> String =
  "linear value '" ++ name ++ "' cannot be used inside a comprehension (a comprehension elaborates to a fold, and higher-order linearity is deferred: the step function runs once per element, so the compiler cannot yet prove '" ++ name ++ "' is consumed exactly once); consume it before the comprehension and use the result inside"

fn app_uses(a: List LinUse, b: List LinUse) -> List LinUse =
  match a with
  | Nil -> b
  | Cons x rest -> Cons(x, app_uses(rest, b))

# The first use in `us` whose name also appears in `other`.
fn first_shared(us: List LinUse, other: List LinUse) -> Maybe LinUse =
  match us with
  | Nil -> Nothing
  | Cons u rest -> if luse_member(luse_name(u), other) then Just(u) else first_shared(rest, other)

# Sequential composition of two subexpressions, `a` strictly BEFORE `b`. The
# order is real, not assumed: spec-v0.md §6 fixes evaluation left-to-right for
# application arguments, binary operands, and constructor/tuple fields, and every
# caller below folds in that order. Three rules:
#
#   - consume in `a` AND consume in `b`  -> reuse (the M4.2 rule, unchanged);
#   - consume in `a` AND borrow  in `b`  -> USE AFTER CONSUME. This is the hole a
#     set-only analysis cannot see: `close(conn); write(conn, x)` records one
#     consume and zero consumes, so the sets stay disjoint and M4.2 would accept
#     a write to a closed socket;
#   - borrow  in `a` AND consume in `b`  -> the normal session order (`write`
#     then `close`). Always fine.
#
# Errors report the position of the LATER use, which is the offending one.
fn seq2(ac: List LinUse, ab: List LinUse, bc: List LinUse, bb: List LinUse) -> LinRes =
  match first_shared(bc, ac) with
  | Just u -> LinErr(luse_pos(u), reuse_msg(luse_name(u)))
  | Nothing -> seq2_after_reuse(ac, ab, bc, bb)

fn seq2_after_reuse(ac: List LinUse, ab: List LinUse, bc: List LinUse, bb: List LinUse) -> LinRes =
  match first_shared(bb, ac) with
  | Just u -> LinErr(luse_pos(u), after_consume_msg(luse_name(u)))
  | Nothing -> LinOk(app_uses(ac, bc), app_uses(ab, bb))

# Two alternative branches. Consumed sets must be EQUAL (an obligation discharged
# on one path must be discharged on all). Borrowed sets merely UNION: a borrow
# carries no obligation, so borrowing in one arm and not the other is harmless.
fn alt_converge(ac: List LinUse, ab: List LinUse, bc: List LinUse, bb: List LinUse,
                at: source.SourcePos) -> LinRes =
  match first_missing(ac, bc) with
  | Just n -> LinErr(at, diverge_msg(n))
  | Nothing -> alt_converge_rev(ac, ab, bc, bb, at)

fn alt_converge_rev(ac: List LinUse, ab: List LinUse, bc: List LinUse, bb: List LinUse,
                    at: source.SourcePos) -> LinRes =
  match first_missing(bc, ac) with
  | Just n -> LinErr(at, diverge_msg(n))
  | Nothing -> LinOk(ac, app_uses(ab, bb))

# --- the linear bindings in scope, split by mode ---
#
# `owned` must each be consumed exactly once (a parameter with no modifier or
# with `consuming`, a do-`let`, a `<-` bind, a pattern binder). `borrowed` is a
# `borrowing` parameter: it carries NO consume obligation here — that stayed with
# the caller — and must not be consumed at all.
export type LinScope (..) = LinScope(List String) (List String)

fn scope_owned(sc: LinScope) -> List String =
  match sc with
  | LinScope o _ -> o

fn scope_borrowed(sc: LinScope) -> List String =
  match sc with
  | LinScope _ b -> b

fn scope_is_owned(name: String, sc: LinScope) -> Bool = str_member(name, scope_owned(sc))

fn scope_is_borrowed(name: String, sc: LinScope) -> Bool = str_member(name, scope_borrowed(sc))

fn scope_is_linear(name: String, sc: LinScope) -> Bool =
  scope_is_owned(name, sc) || scope_is_borrowed(name, sc)

# Drop every entry for `names` from BOTH lists. A new binder SHADOWS whatever the
# name meant before, so its old tracking must go — otherwise a non-linear binder
# shadowing a linear one leaves the stale entry behind, and a use of the shadow
# is credited as a consume of the shadowed resource. That satisfied the leak
# check while nothing was ever released:
#
#     fn shadow(c: File) -> Int = do { let c = 5; c + 1 }   # accepted, c leaked
#
# The lists model an environment, so every introduction must shadow, not append.
# Regression: tests/conformance/type_error/borrow_shadowed_linear_binder.
fn scope_shadow(names: List String, sc: LinScope) -> LinScope =
  LinScope(str_remove_all(names, scope_owned(sc)), str_remove_all(names, scope_borrowed(sc)))

fn str_remove_all(names: List String, xs: List String) -> List String =
  match names with
  | Nil -> xs
  | Cons n rest -> str_remove_all(rest, str_remove(n, xs))

fn str_remove(name: String, xs: List String) -> List String =
  match xs with
  | Nil -> Nil
  | Cons y rest -> if y == name then str_remove(name, rest) else Cons(y, str_remove(name, rest))

fn scope_add_owned(names: List String, sc: LinScope) -> LinScope =
  scope_add_owned_after(names, scope_shadow(names, sc))

fn scope_add_owned_after(names: List String, sc: LinScope) -> LinScope =
  LinScope(app_names(names, scope_owned(sc)), scope_borrowed(sc))

# --- the recursive walk ---

fn lin_consumed(e: typed_ast.TypedExpr, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match e with
  | typed_ast.TVar name _ p -> lin_var(name, p, sc)
  | typed_ast.TInt _ _ _ -> LinOk(Nil, Nil)
  | typed_ast.TFloat _ _ _ -> LinOk(Nil, Nil)
  | typed_ast.TBool _ _ _ -> LinOk(Nil, Nil)
  | typed_ast.TString _ _ _ -> LinOk(Nil, Nil)
  | typed_ast.TChar _ _ _ -> LinOk(Nil, Nil)
  | typed_ast.TUnit _ _ -> LinOk(Nil, Nil)
  | typed_ast.TDict _ _ _ _ -> LinOk(Nil, Nil)
  | typed_ast.TMethodRef _ _ _ _ _ -> LinOk(Nil, Nil)
  | typed_ast.TGetField base _ fty fp -> lin_getfield(base, fty, fp, sc, env)
  | typed_ast.TUnary _ inner _ _ -> lin_consumed(inner, sc, env)
  | typed_ast.TTuple items _ _ -> seq_list(items, sc, env)
  | typed_ast.TCall callee args _ _ -> lin_call(callee, args, sc, env)
  | typed_ast.TBinary _ l r _ _ -> seq_list(Cons(l, Cons(r, Nil)), sc, env)
  | typed_ast.TRange lo hi _ _ -> seq_list(Cons(lo, Cons(hi, Nil)), sc, env)
  | typed_ast.TRecord _ fields _ _ -> seq_list(record_field_exprs(fields), sc, env)
  | typed_ast.TRecordUpdate base fields _ _ ->
      seq_list(Cons(base, record_field_exprs(fields)), sc, env)
  | typed_ast.TIf c a b _ p -> lin_if(c, a, b, p, sc, env)
  | typed_ast.TMatch scrut arms _ p -> lin_match(scrut, arms, p, sc, env)
  | typed_ast.TDo steps _ _ -> lin_do(steps, sc, env)
  | typed_ast.TLambda params body lam_type p -> lin_lambda(params, body, lam_type, p, sc, env)

# A bare reference in a CONSUMING position: a `consuming`/unmodified argument, a
# do-`let` or `<-` right-hand side, or return position. This consumes whatever
# mode the binding has — deliberately, including a BORROWED one, because that is
# how the two escape rules are caught with no separate machinery: consuming or
# returning a `borrowing` parameter puts it in the consumed set, and
# `param_obligations` rejects any borrowed name found there. Recording it as a
# borrow instead would make the violation unrepresentable.
# M4.6: the mode now rides on the function TYPE, so a `borrowing` function used
# as a VALUE keeps its mode and no longer needs the blanket rejection M4.5 had
# here. A function-typed binding is never itself linear, so walking one as an
# ordinary reference records nothing.
fn lin_var(name: String, p: source.SourcePos, sc: LinScope) -> LinRes =
  if scope_is_linear(name, sc) then LinOk(Cons (LinUse(name, p), Nil), Nil)
  else LinOk(Nil, Nil)

# A use in a READING position — the base of a field access, or a match scrutinee.
# These look INTO the value without taking it, so on a BORROWED binding they are
# borrows: that is what makes `p.x + p.y` legal for `p: borrowing Pos`, and what
# lets `tcp_connection_handle(conn: borrowing TcpConnection)` do `match conn with`
# to reach the handle. On an OWNED binding a read still consumes, exactly as M4.2
# and spec-v0.md §5.8 define — which is why `get_x(p: Pos) = p.x` stays accepted
# and `manhattan(p: Pos) = p.x + p.y` stays a reuse.
# Reading a field of a BORROWED value borrows the base — that is what makes
# `p.x + p.y` legal for `p: borrowing Pos`. But only when the FIELD ITSELF is
# non-linear. A LINEAR field read out of a borrow yields an OWNED linear value
# that the caller still owns and will release, so
#
#     fn steal(w: borrowing Wrap) -> Int  = release(w.inner)   # double consume
#     fn take (w: borrowing Wrap) -> File = w.inner            # launders it out
#
# both had to be rejected. Expressing this properly needs the extracted field to
# be a borrow too, and v0 has no type for a borrow — so v0 rejects the read.
# The `match` form of this hole is handled by `from_borrow` in arm_consumed; this
# is the field-access form, which that path never reached.
# Regressions: tests/conformance/type_error/borrow_field_{extract,escape}.
fn lin_getfield(base: typed_ast.TypedExpr, field_ty: types.Type, p: source.SourcePos,
                sc: LinScope, env: Dict types.Scheme) -> LinRes =
  if expr_is_borrowed_binding(base, sc) && type_is_linear(field_ty, env)
  then LinErr(p, borrowed_field_read_msg())
  else lin_read(base, sc, env)

fn lin_read(e: typed_ast.TypedExpr, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match e with
  | typed_ast.TVar name _ p -> lin_read_var(name, p, sc, e, env)
  | _ -> lin_consumed(e, sc, env)

fn lin_read_var(name: String, p: source.SourcePos, sc: LinScope,
                e: typed_ast.TypedExpr, env: Dict types.Scheme) -> LinRes =
  if scope_is_borrowed(name, sc) then LinOk(Nil, Cons (LinUse(name, p), Nil))
  else lin_consumed(e, sc, env)

# --- calls: classify each argument position by the callee's declared modes ---

# M4.6: each argument position is classified from the CALLEE'S TYPE — one
# `types.Ownership` per `TFunc` node of its spine — rather than from a mask keyed
# by the callee's declaration name. The type is present on every callee shape, so
# a lambda, a function-typed parameter, a `let`-bound function and a typeclass
# method are all classified correctly; the name-keyed table saw none of them and
# silently read every argument as consuming, discharging the caller's obligation.
#
# A spine shorter than the argument list (an unresolved callee type, over-
# application) yields OwnConsume, which is the conservative reading.
fn spine_own(t: types.Type) -> types.Ownership =
  match t with
  | types.TFunc _ _ _ own -> own
  | _ -> types.OwnConsume

fn spine_rest(t: types.Type) -> types.Type =
  match t with
  | types.TFunc _ ret _ _ -> ret
  | _ -> t

# ALIGNMENT. infer prepends a TDict evidence node per class constraint to a
# constrained call's argument list (maybe_rewrite_class_method_call), but the
# callee's TYPE spine has no dictionary parameter — those are added later, by
# lowering.append_hidden_param_types. Zipping the two naively therefore shifts
# every mode by the number of dictionaries, so a `borrowing` parameter on a class
# method reads as consuming and the value is double-counted. A TDict carries no
# linear use of its own (lin_consumed's TDict arm is LinOk(Nil, Nil)), so
# dropping the leading run before the zip is both necessary and complete.
# Regression: tests/stdlib/test_linear_borrow_in_type.spr `via_class`.
fn drop_leading_dicts(args: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  match args with
  | Nil -> Nil
  | Cons a rest ->
      match a with
      | typed_ast.TDict _ _ _ _ -> drop_leading_dicts(rest)
      | _ -> args

fn lin_call(callee: typed_ast.TypedExpr, args: List typed_ast.TypedExpr,
            sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match lin_consumed(callee, sc, env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk cc cb ->
      lin_call_args(drop_leading_dicts(args), typed_ast.typed_expr_type(callee), cc, cb, sc, env)

# Arguments fold left-to-right (spec-v0.md §6.1), so `seq2` sees them in real
# evaluation order and the borrow-after-consume rule is exact rather than
# approximate.
fn lin_call_args(args: List typed_ast.TypedExpr, spine: types.Type,
                 ac: List LinUse, ab: List LinUse,
                 sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match args with
  | Nil -> LinOk(ac, ab)
  | Cons a rest ->
      match lin_arg(a, spine_own(spine), sc, env) with
      | LinErr p m -> LinErr(p, m)
      | LinOk c b -> lin_call_args_rest(rest, spine, ac, ab, c, b, sc, env)

fn lin_call_args_rest(rest: List typed_ast.TypedExpr, spine: types.Type,
                      ac: List LinUse, ab: List LinUse, c: List LinUse, b: List LinUse,
                      sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match seq2(ac, ab, c, b) with
  | LinErr p m -> LinErr(p, m)
  | LinOk nc nb -> lin_call_args(rest, spine_rest(spine), nc, nb, sc, env)

# One argument, dispatched on how the callee's type says that parameter is
# received. At a `borrowing` position a LINEAR argument must be a bare variable: a
# freshly-built linear value there would be borrowed and then dropped, with nothing
# left to consume it and no binder for the leak check to find — the analysis tracks
# binders only (BACKLOG "discarded linear expression result"). A non-linear
# argument at a borrowing position is walked normally; the position is simply
# irrelevant to it.
fn lin_arg(a: typed_ast.TypedExpr, own: types.Ownership, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match own with
  | types.OwnBorrow -> lin_borrow_arg(a, sc, env)
  | types.OwnOnce -> lin_once_arg(a, sc, env)
  | types.OwnConsume -> lin_consumed(a, sc, env)

# M4.4a. At a `once` position the callee promises to invoke this closure at most
# once and not to store it, which makes a lambda's linear captures MOVES: the
# value is transferred into the closure, so it is consumed HERE, at the call.
#
# Only a literal lambda gets the licence. Anything else — a named function, a
# `let`-bound one — captures nothing by construction, so there is nothing to
# transfer and the ordinary consuming walk is exactly right.
fn lin_once_arg(a: typed_ast.TypedExpr, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match a with
  | typed_ast.TLambda params body lam_type p -> lin_once_lambda(params, body, lam_type, p, sc, env)
  | _ -> lin_consumed(a, sc, env)

# The body is walked by the SAME code as any other lambda body — the licence
# changes only what happens to the result. That is what keeps the rest of the
# checker in force inside a one-shot closure: a capture consumed twice is caught
# by the body walk's own seq2, and one consumed on only some branches is caught by
# M4.3 branch convergence (tests/conformance/type_error/once_capture_branch_leak).
#
# An OWNED linear parameter stays rejected: `once` bounds how often the closure
# runs, and says nothing about a value handed to it on each run. That is the rest
# of M4.4. A BORROWING one is admitted on M4.4b's terms, the same as at any other
# position — `once` is the stricter promise, so a shape legal at a plain slot
# cannot sensibly be illegal here.
fn lin_once_lambda(params: List ast.Param, body: typed_ast.TypedExpr, lam_type: types.Type,
                   p: source.SourcePos, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match first_owned_linear_param(params, lam_type, env) with
  | Just b -> LinErr(p, lambda_param_binder_msg(b, env))
  | Nothing ->
      lin_once_lambda_body(borrowed_linear_params(params, lam_type, env), params, body, p, sc, env)

# The borrowing parameters are discharged first and on their own terms — not
# consumed, then dropped from both sets — so what reaches lin_once_captures is
# the captures alone, which is what its move rule is about.
fn lin_once_lambda_body(borrowed: List String, params: List ast.Param,
                        body: typed_ast.TypedExpr, p: source.SourcePos,
                        sc: LinScope, env: Dict types.Scheme) -> LinRes =
  lin_once_captures(
    borrow_params_discharged(
      lin_consumed(body,
        scope_add_borrowed(borrowed, scope_shadow(lambda_param_names(params), sc)), env),
      borrowed),
    p)

# Shared by both lambda arms: a borrowing parameter may not be consumed, and once
# that holds it is invisible to whatever rule the caller applies next.
fn borrow_params_discharged(res: LinRes, borrowed: List String) -> LinRes =
  match res with
  | LinErr ep m -> LinErr(ep, m)
  | LinOk bc bb -> borrow_params_removed(first_consumed_borrow(borrowed, bc), bc, bb, borrowed)

fn borrow_params_removed(bad: Maybe LinUse, bc: List LinUse, bb: List LinUse,
                         borrowed: List String) -> LinRes =
  match bad with
  | Just u -> LinErr(luse_pos(u), lambda_consumed_borrow_msg(luse_name(u)))
  | Nothing -> LinOk(remove_all(borrowed, bc), remove_all(borrowed, bb))

# Consumed captures become the call's consumed set — the move. A capture that is
# only BORROWED is refused: `with_scope` joins AFTER its body, so a spawned closure
# can run against a value the body already released, and Sprout has no escaping /
# non-escaping or lifetime distinction that could rule it out. Rust draws the same
# line — `std::thread::spawn` takes `F: FnOnce() -> T + Send + 'static`, and the
# `'static` bound is precisely what forbids a captured borrow.
#
# A capture that is borrowed AND consumed in the same body is a MOVE, not a borrow,
# and must be allowed — `\_ -> do { write(c, x); close(c) }` is the shape the whole
# milestone exists to enable. `lin_borrow_var` files an owned binding under BORROWED
# whenever it appears at a `borrowing` parameter position, and `seq2` keeps it there
# after the later consume, so the raw borrowed set over-reports; subtracting the
# consumed set is what distinguishes "read someone else's value" from "used my own
# before releasing it". Use-after-consume inside the body is unaffected — the body
# walk's own ordering rule catches that before this point.
# Regression: tests/conformance/type_error/once_capture_borrow (borrow only) and
# tests/stdlib/test_once_closures.spr `borrow_and_move_inside` (borrow + consume).
fn lin_once_captures(res: LinRes, p: source.SourcePos) -> LinRes =
  match res with
  | LinErr ep m -> LinErr(ep, m)
  | LinOk bc bb -> lin_once_no_borrows(bc, luse_remove_all(names_of(bc), bb), p)

fn lin_once_no_borrows(bc: List LinUse, bb: List LinUse, p: source.SourcePos) -> LinRes =
  match bb with
  | Nil -> LinOk(bc, Nil)
  | [u | _] -> LinErr(p, once_borrow_capture_msg(luse_name(u)))

fn names_of(uses: List LinUse) -> List String =
  match uses with
  | Nil -> Nil
  | Cons u rest -> Cons(luse_name(u), names_of(rest))

fn luse_remove_all(names: List String, uses: List LinUse) -> List LinUse =
  match uses with
  | Nil -> Nil
  | Cons u rest ->
      if str_member(luse_name(u), names) then luse_remove_all(names, rest)
      else Cons(u, luse_remove_all(names, rest))

fn lin_borrow_arg(a: typed_ast.TypedExpr, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match a with
  | typed_ast.TVar name _ p -> lin_borrow_var(name, p, sc, a, env)
  | _ -> lin_nonvar_borrow(a, sc, env)

# An untracked name (a module-level linear `let`, say) is still a VARIABLE, so it
# must not fall into the "must be a variable reference" rejection — that message
# contradicted the source and named a cause ("a freshly-built linear value") that
# was false for the program. Walk it as an ordinary reference instead; that also
# routes it through the borrowing-function-as-value check.
# Regression: tests/stdlib/test_linear_borrowing.spr `borrow_module_level`.
fn lin_borrow_var(name: String, p: source.SourcePos, sc: LinScope,
                  a: typed_ast.TypedExpr, env: Dict types.Scheme) -> LinRes =
  if scope_is_linear(name, sc) then LinOk(Nil, Cons (LinUse(name, p), Nil))
  else lin_consumed(a, sc, env)

fn lin_nonvar_borrow(a: typed_ast.TypedExpr, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  if type_is_linear(typed_ast.typed_expr_type(a), env)
  then LinErr(typed_ast.typed_expr_pos(a), nonvar_borrow_msg())
  else lin_consumed(a, sc, env)

fn record_field_exprs(fields: List typed_ast.TypedRecordField) -> List typed_ast.TypedExpr =
  match fields with
  | Nil -> Nil
  | Cons f rest ->
      match f with
      | typed_ast.TypedRecordField _ v -> Cons(v, record_field_exprs(rest))

# Sequentially combine a list of subexpressions, left to right.
fn seq_list(exprs: List typed_ast.TypedExpr, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match exprs with
  | Nil -> LinOk(Nil, Nil)
  | Cons e rest ->
      match lin_consumed(e, sc, env) with
      | LinErr p m -> LinErr(p, m)
      | LinOk ac ab -> seq_list_rest(rest, ac, ab, sc, env)

fn seq_list_rest(rest: List typed_ast.TypedExpr, ac: List LinUse, ab: List LinUse,
                 sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match seq_list(rest, sc, env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk bc bb -> seq2(ac, ab, bc, bb)

fn lin_if(c: typed_ast.TypedExpr, a: typed_ast.TypedExpr, b: typed_ast.TypedExpr,
          p: source.SourcePos, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  let LinOk cc cb = lin_consumed(c, sc, env) else LinErr ep m -> LinErr(ep, m)
      LinOk ac ab = lin_consumed(a, sc, env) else LinErr ep m -> LinErr(ep, m)
      LinOk bc bb = lin_consumed(b, sc, env) else LinErr ep m -> LinErr(ep, m)
      LinOk mc mb = alt_converge(ac, ab, bc, bb, p) else LinErr ep m -> LinErr(ep, m)
  in seq2(cc, cb, mc, mb)

fn lin_match(scrut: typed_ast.TypedExpr, arms: List typed_ast.TypedMatchBranch,
             p: source.SourcePos, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match lin_read(scrut, sc, env) with
  | LinErr ep m -> LinErr(ep, m)
  | LinOk sc_c sc_b -> lin_match_arms(scrut, arms, sc_c, sc_b, sc, env)

fn lin_match_arms(scrut: typed_ast.TypedExpr, arms: List typed_ast.TypedMatchBranch,
                  sc_c: List LinUse, sc_b: List LinUse,
                  sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match arm_sets(arms, sc, typed_ast.typed_expr_type(scrut),
                 expr_is_borrowed_binding(scrut, sc), env) with
  | LinErr ep m -> LinErr(ep, m)
  | LinOk mc mb -> seq2(sc_c, sc_b, mc, mb)

# CONTAINMENT: destructuring a BORROWED value yields BORROWED fields. Without
# this, `match w with | Wrap f -> release(f)` inside a `borrowing Wrap` function
# would consume the inner linear field while the caller still owns the Wrap and
# will release it again — a double consume laundered through a pattern match.
# Reads through a borrow are borrows all the way down.
fn expr_is_borrowed_binding(e: typed_ast.TypedExpr, sc: LinScope) -> Bool =
  match e with
  | typed_ast.TVar name _ _ -> scope_is_borrowed(name, sc)
  | _ -> false

# All arm bodies must converge to the identical CONSUMED set of outer linear
# bindings. An arm's own pattern-bound linear vars are arm-local: owned (consumed
# exactly once inside the arm) when the scrutinee is owned, borrowed (never
# consumed) when it came from a borrow. Either way they are removed before the
# convergence comparison.
fn arm_sets(arms: List typed_ast.TypedMatchBranch, sc: LinScope, scrut_type: types.Type,
            from_borrow: Bool, env: Dict types.Scheme) -> LinRes =
  match arms with
  | Nil -> LinOk(Nil, Nil)
  | [br] -> arm_consumed(br, sc, scrut_type, from_borrow, env)
  | Cons br rest ->
      match arm_consumed(br, sc, scrut_type, from_borrow, env) with
      | LinErr p m -> LinErr(p, m)
      | LinOk ac ab -> arm_sets_rest(rest, ac, ab, arm_pos(br), sc, scrut_type, from_borrow, env)

fn arm_sets_rest(rest: List typed_ast.TypedMatchBranch, ac: List LinUse, ab: List LinUse,
                 at: source.SourcePos, sc: LinScope, scrut_type: types.Type,
                 from_borrow: Bool, env: Dict types.Scheme) -> LinRes =
  match arm_sets(rest, sc, scrut_type, from_borrow, env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk bc bb -> alt_converge(ac, ab, bc, bb, at)

fn arm_consumed(br: typed_ast.TypedMatchBranch, sc: LinScope, scrut_type: types.Type,
                from_borrow: Bool, env: Dict types.Scheme) -> LinRes =
  match br with
  | typed_ast.TypedMatchBranch pat body ->
      scope_consumed(pattern_linear_binders(pat, scrut_type, env), from_borrow, body,
                     typed_ast.typed_expr_pos(body),
                     scope_shadow(pattern_all_binders(pat), sc), env)

# EVERY name a pattern binds, linear or not. `pattern_linear_binders` reports only
# the linear ones (they carry obligations); this reports all of them, because a
# NON-linear pattern variable must still shadow a linear binding of the same name.
fn pattern_all_binders(pat: ast.Pattern) -> List String =
  match pat with
  | ast.VarPattern name _ -> Cons(name, Nil)
  | ast.WildcardPattern _ -> Nil
  | ast.IntPattern _ _ -> Nil
  | ast.BoolPattern _ _ -> Nil
  | ast.StringPattern _ _ -> Nil
  | ast.CharPattern _ _ -> Nil
  | ast.UnitPattern _ -> Nil
  | ast.TuplePattern pats _ -> pattern_all_binders_list(pats)
  | ast.ConstructorPattern _ subpats _ -> pattern_all_binders_list(subpats)

fn pattern_all_binders_list(pats: List ast.Pattern) -> List String =
  match pats with
  | Nil -> Nil
  | Cons p rest -> app_names(pattern_all_binders(p), pattern_all_binders_list(rest))

# Check `body` with `binders` in scope. Owned binders must each be consumed
# exactly once inside (reuse is caught by seq2; a leftover binder is a leak);
# borrowed binders must NOT be consumed at all. Either way they are removed from
# both sets reported to the enclosing scope.
fn scope_consumed(binders: List LinBinder, from_borrow: Bool, body: typed_ast.TypedExpr,
                  leak_pos: source.SourcePos, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match lin_consumed(body, scope_add(binder_names(binders), from_borrow, sc), env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk consumed borrowed -> scope_close(binders, from_borrow, consumed, borrowed, leak_pos, env)

fn scope_add(names: List String, from_borrow: Bool, sc: LinScope) -> LinScope =
  if from_borrow then scope_add_borrowed(names, scope_shadow(names, sc))
  else scope_add_owned(names, sc)

fn scope_add_borrowed(names: List String, sc: LinScope) -> LinScope =
  LinScope(scope_owned(sc), app_names(names, scope_borrowed(sc)))

fn scope_close(binders: List LinBinder, from_borrow: Bool, consumed: List LinUse,
               borrowed: List LinUse, leak_pos: source.SourcePos,
               env: Dict types.Scheme) -> LinRes =
  if from_borrow then scope_close_borrowed(binders, consumed, borrowed)
  else scope_close_owned(binders, consumed, borrowed, leak_pos, env)

fn scope_close_borrowed(binders: List LinBinder, consumed: List LinUse,
                        borrowed: List LinUse) -> LinRes =
  match first_consumed_borrow(binder_names(binders), consumed) with
  | Just u -> LinErr(luse_pos(u), borrowed_binder_msg(luse_name(u)))
  | Nothing -> LinOk(remove_all(binder_names(binders), consumed),
                     remove_all(binder_names(binders), borrowed))

fn scope_close_owned(binders: List LinBinder, consumed: List LinUse, borrowed: List LinUse,
                     leak_pos: source.SourcePos, env: Dict types.Scheme) -> LinRes =
  match unconsumed_binder(binders, consumed) with
  | Just leaked -> LinErr(leak_pos, leak_binder_msg(leaked, env))
  | Nothing -> LinOk(remove_all(binder_names(binders), consumed),
                     remove_all(binder_names(binders), borrowed))

fn arm_pos(br: typed_ast.TypedMatchBranch) -> source.SourcePos =
  match br with
  | typed_ast.TypedMatchBranch _ body -> typed_ast.typed_expr_pos(body)

# Does THIS bind short-circuit? `Maybe` short-circuits on Nothing and `Result e`
# is left-biased on the first Err (spec-v0.md §5.9), so the steps AFTER such a bind
# are conditional: on failure the enclosing function returns and they never run.
#
# The discriminator is the BIND's right-hand-side type, not the block's. Keying it
# on the block's type — which is what this did, following a spec sentence that also
# claimed "Effectful blocks (`!{IO}`) run every step and are unaffected" — is wrong
# in both directions. `!{IO}` is orthogonal to short-circuiting, so a `-> Unit !{IO}`
# block containing a fallible bind switched the rule off entirely (the `P0` leak in
# `bench/http_worker_pool/`, regression
# `tests/conformance/type_error/consume_after_fallible_bind_effect_block`); and a
# `Result`-typed block whose binds are all non-fallible had it switched on for steps
# that in fact always run. Per-bind is both correct and strictly more precise.
#
# One fallible bind is enough to condemn every consume after it, so there is no need
# to remember the flag across steps: the OUTERMOST fallible bind sees the whole
# remainder of the block in its `restc` and reports there.
fn bind_short_circuits(rhs_ty: types.Type) -> Bool =
  short_circuit_head(after_last_dot(head_type_name(rhs_ty)))

fn short_circuit_head(h: String) -> Bool = h == "Maybe" || h == "Result"

fn after_last_dot(name: String) -> String =
  if str_find(name, ".") == -1 then name else after_last_dot(str_slice(name, str_find(name, ".") + 1, str_len(name)))

fn lin_do(steps: List typed_ast.TypedDoStep, sc: LinScope,
          env: Dict types.Scheme) -> LinRes =
  match steps with
  | Nil -> LinOk(Nil, Nil)
  | Cons step rest ->
      match step with
      | typed_ast.TDoLetStep name rhs -> lin_do_let(name, rhs, rest, sc, env)
      | typed_ast.TDoExprStep e -> lin_do_seq(e, rest, sc, env)
      | typed_ast.TDoBindStep pat e -> lin_do_bind(pat, e, rest, sc, env)

# A `<-` do-bind: its pattern binds variables (possibly linear) scoped to the
# remaining steps, each consumed exactly once there. The RHS is sequential-before
# the rest — which is what makes `close(conn)` followed by a later `write(conn,…)`
# in a do-block a use-after-consume rather than an unordered set collision.
fn lin_do_bind(pat: ast.Pattern, e: typed_ast.TypedExpr, rest: List typed_ast.TypedDoStep,
               sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match lin_consumed(e, sc, env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk ec eb -> lin_do_bind_checked(pat, do_bind_type(typed_ast.typed_expr_type(e), env),
                                       ec, eb, e, rest, sc, env)

# `_ <- e` binds no name, so `pattern_linear_binders` yields nothing and the
# binder-keyed rules attach no obligation — the payload is dropped exactly as a
# bare step would drop it. Rejecting it is not optional politeness: the
# discarded-step diagnostic tells the author to "bind its result with `<-`", and
# `_ <-` is the shape that advice most directly produces. `_h <- e` is already
# caught (a named binder that is never used is a leak), so this closes a
# one-character gap between two spellings of the same mistake.
#
# Only a WILDCARD is treated this way. A constructor pattern that drops a linear
# FIELD (`Wrap _ <- …`) is the separate open question of whether destructuring
# discharges the obligation for what it does not bind — filed in BACKLOG, not
# decided here.
fn lin_do_bind_checked(pat: ast.Pattern, bind_type: types.Type, ec: List LinUse,
                       eb: List LinUse, e: typed_ast.TypedExpr,
                       rest: List typed_ast.TypedDoStep,
                       sc: LinScope, env: Dict types.Scheme) -> LinRes =
  if wildcard_discards_linear(pat, bind_type, env) then
    LinErr(typed_ast.typed_expr_pos(e), wildcard_bind_msg())
  else
    lin_do_bind_rest(pattern_linear_binders(pat, bind_type, env),
                     ec, eb, e, rest, sc, env)

fn wildcard_discards_linear(pat: ast.Pattern, t: types.Type, env: Dict types.Scheme) -> Bool =
  match pat with
  | ast.WildcardPattern _ -> discardable_type(t, env)
  | _ -> false

fn wildcard_bind_msg() -> String =
  "`_ <-` discards a linear value: a wildcard binds no name, so nothing can consume it (linear values must be used exactly once); bind a name and consume it"

fn lin_do_bind_rest(binders: List LinBinder, ec: List LinUse, eb: List LinUse,
                    e: typed_ast.TypedExpr, rest: List typed_ast.TypedDoStep,
                    sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match lin_do(rest, scope_add_owned(binder_names(binders), sc), env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk restc restb -> lin_do_bind_close(binders, ec, eb, restc, restb, e, env)

fn lin_do_bind_close(binders: List LinBinder, ec: List LinUse, eb: List LinUse,
                     restc: List LinUse, restb: List LinUse,
                     e: typed_ast.TypedExpr, env: Dict types.Scheme) -> LinRes =
  match unconsumed_binder(binders, restc) with
  | Just leaked -> LinErr(typed_ast.typed_expr_pos(e), leak_binder_msg(leaked, env))
  | Nothing -> lin_do_bind_after(binders, ec, eb, restc, restb, e)

# When THIS bind is fallible the steps after it are conditional, so a consume of a
# binding introduced OUTSIDE the block is not guaranteed to run:
#
#     do { _ <- write(c); reply <- read(c); let _ = close(c); Ok(reply) }
#
# was accepted with `close` counted as executed, yet on any Err the block returns
# early and the socket leaks for the process lifetime — the very shape M4.5 makes
# idiomatic. The bind's OWN binders are exempt: they do not exist on the
# short-circuit path, so they owe nothing there.
#
# Regressions: tests/conformance/type_error/borrow_after_fallible_bind (a `Result`
# block) and .../consume_after_fallible_bind_effect_block (a `Unit !{IO}` block,
# which the old block-type keying missed entirely — see `bind_short_circuits`).
fn lin_do_bind_after(binders: List LinBinder, ec: List LinUse, eb: List LinUse,
                     restc: List LinUse, restb: List LinUse,
                     e: typed_ast.TypedExpr) -> LinRes =
  match conditional_consume(bind_short_circuits(typed_ast.typed_expr_type(e)),
                            remove_all(binder_names(binders), restc)) with
  | Just u -> LinErr(luse_pos(u), after_fallible_msg(luse_name(u)))
  | Nothing -> seq2(ec, eb, remove_all(binder_names(binders), restc),
                    remove_all(binder_names(binders), restb))

fn conditional_consume(sc_bind: Bool, outer: List LinUse) -> Maybe LinUse =
  if ! sc_bind then Nothing
  else
    match outer with
    | [] -> Nothing
    | [u | _] -> Just(u)

fn lin_do_seq(e: typed_ast.TypedExpr, rest: List typed_ast.TypedDoStep,
              sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match lin_consumed(e, sc, env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk ec eb -> lin_do_seq_checked(e, rest, ec, eb, sc, env)

# The consumed-set analysis is keyed on BINDERS (params, `let`, `<-`, pattern
# vars): every rule asks whether the obligation attached to a NAME was
# discharged. A linear value produced by a bare do-step and never bound has no
# name, so no obligation is attached to it and no leak rule can find it
# unfulfilled — `do { task_fork(s, w); 7 }` silently drops the handle. It has to
# be caught at the step itself.
#
# The TRAILING step is exempt: it is the block's RESULT, returned to the caller,
# whose obligation it becomes there (the caller's binder picks it up, or the
# caller's own trailing position passes it on again). `rest` being empty is
# exactly that test.
#
# Diagnostic precedence: an error inside `e` wins, since `lin_consumed(e, …)` runs
# first. This error can in turn mask an ENCLOSING binder leak reported at an
# earlier line, because `lin_do_bind_rest` abandons its own leak check as soon as
# the rest of the block errors. That is the pass's pre-existing one-error-at-a-time,
# innermost-first behaviour — an inner reuse already masks an outer leak the same
# way — not something this rule introduces.
fn lin_do_seq_checked(e: typed_ast.TypedExpr, rest: List typed_ast.TypedDoStep,
                      ec: List LinUse, eb: List LinUse,
                      sc: LinScope, env: Dict types.Scheme) -> LinRes =
  if step_discards_linear(e, rest, env) then
    LinErr(typed_ast.typed_expr_pos(e), discarded_step_msg(e, env))
  else
    lin_do_seq_rest(rest, ec, eb, sc, env)

fn step_discards_linear(e: typed_ast.TypedExpr, rest: List typed_ast.TypedDoStep,
                        env: Dict types.Scheme) -> Bool =
  match rest with
  | [] -> false
  | [_ | _] -> discardable_type(typed_ast.typed_expr_type(e), env)

# A discarded value is an unmet obligation when it IS or CONTAINS a linear
# resource, or when it MIGHT be one.
#
# The "might" arm is a bare type variable. Inside a polymorphic function the body
# is checked with the variable rigid, so `do { f(1); 7 }` with `f : Int -> a`
# would otherwise escape entirely — and then a caller instantiating `a` at a
# linear type leaks. Sprout has no linearity bound on a type parameter with which
# to say "`a` is never linear" (the same universe gap that blocks `borrowing a`;
# see BACKLOG), so the conservative answer is the only sound one available. A
# tyvar NESTED in a container (`Maybe a`) is deliberately NOT counted: that needs
# the bound to be usable at all, and counting it would reject most polymorphic
# do-blocks over `Maybe`/`Result`.
fn discardable_type(t: types.Type, env: Dict types.Scheme) -> Bool =
  if type_is_tyvar(t) then true
  else type_mentions_linear(t, env)

# The linear type inside `t`, if any — `t` itself when its head is linear, else
# the first one found among its type arguments and tuple components.
#
# Containment is not optional: in a Maybe/Result do-block EVERY step has type
# `Maybe X` / `Result E X`, so a head-only test could never fire in a
# short-circuiting block at all. It is equally not optional for a binder — a
# `let` over `Maybe File` drops the File just as surely — and the two paths
# disagreed until 2026-09-07. Both now ask THIS function, which is why it returns
# the type rather than a Bool: the leak diagnostic has to name the contained type,
# since the value the author wrote is not the value the rule is about.
#
# Does NOT descend into a function type: `Unit -> File` is a recipe for a
# resource, not a resource, and discarding one leaks nothing.
fn first_linear_in(t: types.Type, env: Dict types.Scheme) -> Maybe types.Type =
  match first_linear_seen(t, env, dict_empty()) with
  | (found, _) -> found

# `seen` names every declaration this walk has already opened, and it is THREADED
# — each step returns the set it grew and the next starts from that — which makes
# it a memo rather than a path stack. The distinction is the entire cost of the
# walk: handing each sibling the unmodified set unfolds the declaration graph as a
# tree, so `type Ti = | Ti T(i-1) T(i-1)` costs 2^i. Twenty-six such declarations
# took 100s; memoized they cost what an empty file costs.
# Pinned by tests/stdlib/test_linear_containment_cost.spr.
#
# Threading is sound because a declaration's answer depends on its NAME and the
# env, never on the path that reached it. A name is marked before its fields are
# opened, so a cycle reads it as `Nothing` and terminates; the one case where that
# early `Nothing` could be wrong — the declaration does hold a linear type — is
# the case where the expansion already in progress returns `Just` and
# short-circuits the whole walk anyway.
fn first_linear_seen(t: types.Type, env: Dict types.Scheme,
                     seen: Dict Bool) -> (Maybe types.Type, Dict Bool) =
  if type_is_linear(t, env) then (Just(t), seen)
  else
    match t with
    # Both halves of containment, in the order that keeps the diagnostic useful:
    # a type ARGUMENT names a linear type the author wrote at the application, so
    # prefer it over one buried in the declaration's concrete fields.
    | types.TApp _ _ ->
        match first_linear_in_args(head_type_name(t), 0, app_spine_args(t), env, seen) with
        | (Just found, seen2) -> (Just(found), seen2)
        | (Nothing, seen2) -> first_linear_in_stored(head_type_name(t), env, seen2)
    | types.TConst _ -> first_linear_in_stored(head_type_name(t), env, seen)
    | types.TTuple items -> first_linear_in_list(items, env, seen)
    # The three non-descending answers, spelled out rather than left to a
    # catch-all (docs/guidelines.md §2a): each is a decision, and a type variant
    # added later would silently inherit "holds no linear value" — the exact
    # shape of the phantom bug this walk was once fixed for.
    | types.TVar _ -> (Nothing, seen)  # universe unknown; see §5.8 on type variables
    | types.TFunc _ _ _ _ -> (Nothing, seen)  # a recipe for a resource, not a resource
    | types.TThunk _ _ -> (Nothing, seen)  # likewise: nothing is held until it is forced

# The concrete half of containment: what the DECLARATION stores, which a type
# application never mentions. `type Box = | Box Res` has no argument to walk, so
# before this a wrapper around a linear resource was not a container at all.
fn first_linear_in_stored(tname: String, env: Dict types.Scheme,
                          seen: Dict Bool) -> (Maybe types.Type, Dict Bool) =
  match dict_get(tname, seen) with
  | Just _ -> (Nothing, seen)
  | Nothing ->
      first_linear_in_list(stored_field_types(tname, env), env, dict_set(tname, true, seen))

# Mirrors infer.stored_fields_marker, respelled for the same reason
# param_is_phantom is (the infer <-> linear_check cycle); the two must agree and
# only behaviour says so. A type with no marker stores nothing this walk can see
# — an extern or C-runtime type, or a declaration with no fields.
fn stored_field_types(tname: String, env: Dict types.Scheme) -> List types.Type =
  match dict_get("@stores:" ++ tname, env) with
  | Nothing -> Nil
  | Just scheme ->
      match scheme with
      | types.Scheme _ _ body _ _ ->
          match body with
          | types.TTuple items -> items
          | _ -> Nil

# The arguments of a type application in DECLARATION order. `TApp` nests to the
# left, so the spine is unwound and re-appended; the index is what lets the
# phantom test below line an argument up with the parameter it was written for.
fn app_spine_args(t: types.Type) -> List types.Type =
  match t with
  | types.TApp base arg -> list_append(app_spine_args(base), Cons(arg, Nil))
  | _ -> Nil

# Containment asks what the DECLARATION stores, not what the application
# mentions: a position the declaration drops holds nothing to leak.
# `type Chan a = | Chan Int` keeps an Int handle, so `Chan TcpConnection` is not
# a container and `pool_worker(ch: Chan TcpConnection, ...)` owes nothing — while
# `chan_recv(ch)`, whose `Recv a` does store its `a`, still hands back a binder
# that does. Before this, every phantom position was descended blindly and the
# leak diagnostic named a linear type the value provably does not hold.
fn first_linear_in_args(tname: String, idx: Int, args: List types.Type,
                        env: Dict types.Scheme,
                        seen: Dict Bool) -> (Maybe types.Type, Dict Bool) =
  match args with
  | Nil -> (Nothing, seen)
  | Cons a rest ->
      if param_is_phantom(tname, idx, env) then
        first_linear_in_args(tname, idx + 1, rest, env, seen)
      else
        match first_linear_seen(a, env, seen) with
        | (Just found, seen2) -> (Just(found), seen2)
        | (Nothing, seen2) -> first_linear_in_args(tname, idx + 1, rest, env, seen2)

# Mirrors infer.phantom_param_marker, respelled rather than imported for the same
# reason type_is_linear is (the infer <-> linear_check cycle). The two spellings
# must agree, and nothing but behaviour says so: a drift silently stops finding
# the marker and every phantom position is descended again. That is what the
# phantom cases in tests/stdlib/test_linear_binders.spr catch.
fn param_is_phantom(tname: String, idx: Int, env: Dict types.Scheme) -> Bool =
  match dict_get("@phantom:" ++ tname ++ ":" ++ int_to_string(idx), env) with
  | Just _ -> true
  | Nothing -> false

fn first_linear_in_list(ts: List types.Type, env: Dict types.Scheme,
                        seen: Dict Bool) -> (Maybe types.Type, Dict Bool) =
  match ts with
  | Nil -> (Nothing, seen)
  | Cons t rest ->
      match first_linear_seen(t, env, seen) with
      | (Just found, seen2) -> (Just(found), seen2)
      # `seen2`, not `seen`: the sibling's answers carry forward. This one
      # character is the difference between a memo and an exponential walk.
      | (Nothing, seen2) -> first_linear_in_list(rest, env, seen2)

fn type_mentions_linear(t: types.Type, env: Dict types.Scheme) -> Bool =
  match first_linear_in(t, env) with
  | Just _ -> true
  | Nothing -> false

# A bare reference (`do { x; 0 }`) needs its own wording: `x` IS referenced
# exactly once, so telling the author to "bind its result" describes a rule the
# program does not break and advice they cannot act on. What is wrong is that a
# reference in statement position does nothing with the value.
fn discarded_step_msg(e: typed_ast.TypedExpr, env: Dict types.Scheme) -> String =
  match e with
  | typed_ast.TVar name _ _ -> discarded_ref_msg(name)
  | _ -> discarded_value_msg(typed_ast.typed_expr_type(e), env)

fn discarded_ref_msg(name: String) -> String =
  "linear value '" ++ name ++ "' is referenced as a statement, which discards it — a bare reference does not consume it; pass it to a consuming function, or destructure it with `match`"

fn discarded_value_msg(t: types.Type, env: Dict types.Scheme) -> String =
  if type_mentions_linear(t, env) then
    "this step discards a linear value (linear values must be used exactly once); bind its result with `<-` or `let` and consume the binding"
  else
    "this step discards a value that may be linear: its type is a type variable, which a caller may instantiate at a linear type (Sprout cannot yet declare a type parameter non-linear); bind its result with `<-` or `let` and consume the binding"

fn lin_do_seq_rest(rest: List typed_ast.TypedDoStep, ec: List LinUse, eb: List LinUse,
                   sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match lin_do(rest, sc, env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk restc restb -> seq2(ec, eb, restc, restb)

fn lin_do_let(name: String, rhs: typed_ast.TypedExpr, rest: List typed_ast.TypedDoStep,
              sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match lin_consumed(rhs, sc, env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk rc rb ->
      lin_do_let_body(name, rhs, rc, rb, rest, sc, env,
                      type_mentions_linear(typed_ast.typed_expr_type(rhs), env))

# A linear do-let binding is OWNED, scoped to `rest`, consumed exactly once there.
fn lin_do_let_body(name: String, rhs: typed_ast.TypedExpr, rc: List LinUse, rb: List LinUse,
                   rest: List typed_ast.TypedDoStep, sc: LinScope,
                   env: Dict types.Scheme, is_lin: Bool) -> LinRes =
  match lin_do(rest, extend_scope(is_lin, name, sc), env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk restc restb -> lin_do_let_close(name, rhs, rc, rb, restc, restb, is_lin, env)

fn lin_do_let_close(name: String, rhs: typed_ast.TypedExpr, rc: List LinUse, rb: List LinUse,
                    restc: List LinUse, restb: List LinUse, is_lin: Bool,
                    env: Dict types.Scheme) -> LinRes =
  if ! is_lin then seq2(rc, rb, restc, restb)
  else if luse_member(name, restc) then
    seq2(rc, rb, luse_remove(name, restc), luse_remove(name, restb))
  else LinErr(typed_ast.typed_expr_pos(rhs),
              leak_binder_msg(LinBinder(name, typed_ast.typed_expr_type(rhs)), env))

# A non-linear do-`let` must SHADOW, not be ignored: `let c = 5` over a linear
# `c` has to drop the old entry, or `c + 1` is credited as consuming the resource.
fn extend_scope(is_lin: Bool, name: String, sc: LinScope) -> LinScope =
  if is_lin then scope_add_owned(Cons(name, Nil), sc)
  else scope_shadow(Cons(name, Nil), sc)

# A lambda at an UNANNOTATED parameter may run zero or many times, so (higher-order
# linearity, M4.4, deferred) it must neither take a linear parameter nor capture an
# outer linear binding. BORROWS count as captures here too: the v0 borrowing rule
# (design note §7) is that a borrowed value may not be captured at all, because
# soundness would turn on whether the closure escapes and outlives the consume, and
# Sprout has no escaping/non-escaping distinction. Both are loud-rejected, never
# silently taken.
#
# M4.4a narrows the scope of this arm rather than weakening it: a lambda that is
# the ARGUMENT at a `once` parameter is routed to lin_once_lambda before it gets
# here, so what remains is exactly the 0..n case this rejection was written for.
# Regression: tests/conformance/type_error/lambda_capture_still_rejected.
#
# M4.4b narrows it again, on the PARAMETER half. A parameter the lambda's type
# takes `borrowing` carries no consume obligation, so how often the closure runs
# says nothing about it and the 0..n argument does not apply — which is what makes
# this half separable from the captures, where it still does. The parameter is
# walked BORROWED, exactly as check_fn_linear walks a declared borrowing one, and
# the body is then held to the same rule: it may read the value, not release it.
# Ownership is read off the lambda's TYPE, not its source text, because the mode
# usually is not written — it is pushed down from the slot (infer.seed_param_modes).
fn lin_lambda(params: List ast.Param, body: typed_ast.TypedExpr, lam_type: types.Type,
              p: source.SourcePos, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  let from_comp = is_comprehension_fold(params)
  in match first_owned_linear_param(drop_comp_acc_params(params),
                                    drop_comp_acc_type(params, lam_type), env) with
     | Just b -> LinErr(p, linear_param_msg(from_comp, b, env))
     | Nothing ->
         lin_lambda_body(body, p, params,
           borrowed_linear_params(drop_comp_acc_params(params),
                                  drop_comp_acc_type(params, lam_type), env),
           sc, env, from_comp)

# The rejection is identical either way; only the wording differs, so provenance
# is carried as a flag rather than duplicating the analysis.
fn linear_param_msg(from_comp: Bool, b: LinBinder, env: Dict types.Scheme) -> String =
  if from_comp then comprehension_binder_msg(lbind_name(b))
  else lambda_param_binder_msg(b, env)

fn lambda_capture_msg_for(from_comp: Bool, name: String) -> String =
  if from_comp then comprehension_capture_msg(name) else lambda_capture_msg(name)

# Every fold the comprehension elaboration builds takes the accumulator as its
# first parameter, under a generated name; a lambda holding any such binder is
# therefore synthesized rather than written.
fn is_comprehension_fold(params: List ast.Param) -> Bool =
  match params with
  | Nil -> false
  | Cons prm rest ->
      if str_starts_with(param_name(prm), ast.comp_binder_prefix) then true
      else is_comprehension_fold(rest)

fn lambda_param_names(params: List ast.Param) -> List String =
  match params with
  | Nil -> Nil
  | Cons prm rest -> Cons(param_name(prm), lambda_param_names(rest))

# Every parameter SHADOWS first, then the borrowing linear ones are tracked —
# shadowing afterwards would drop what was just added. `borrowed` is empty for
# every lambda without a linear parameter, and each step below is then the
# identity, so this is the pre-M4.4b walk unchanged for them.
fn lin_lambda_body(body: typed_ast.TypedExpr, p: source.SourcePos,
                   params: List ast.Param, borrowed: List String,
                   sc: LinScope, env: Dict types.Scheme, from_comp: Bool) -> LinRes =
  match lin_consumed(body,
          scope_add_borrowed(borrowed, scope_shadow(lambda_param_names(params), sc)),
          env) with
  | LinErr ep m -> LinErr(ep, m)
  | LinOk bc bb -> lin_lambda_close(borrow_params_discharged(LinOk(bc, bb), borrowed), p, from_comp)

# What is left once the lambda's own borrowing parameters are discharged is a
# CAPTURE, and captures are still rejected outright.
fn lin_lambda_close(res: LinRes, p: source.SourcePos, from_comp: Bool) -> LinRes =
  match res with
  | LinErr ep m -> LinErr(ep, m)
  | LinOk bc bb -> lin_lambda_captures(app_uses(bc, bb), p, from_comp)

fn lin_lambda_captures(uses: List LinUse, p: source.SourcePos, from_comp: Bool) -> LinRes =
  match uses with
  | Nil -> LinOk(Nil, Nil)
  | [u | _] -> LinErr(p, lambda_capture_msg_for(from_comp, luse_name(u)))

# --- parameter modes ---

fn param_mode(p: ast.Param) -> ast.ParamMode =
  match p with
  | ast.Param _ _ m -> m

fn mode_is_written(m: ast.ParamMode) -> Bool =
  match m with
  | ast.ModeDefault -> false
  | _ -> true

fn mode_is_borrowing(m: ast.ParamMode) -> Bool =
  match m with
  | ast.ModeBorrowing -> true
  | _ -> false

fn mode_is_once(m: ast.ParamMode) -> Bool =
  match m with
  | ast.ModeOnce -> true
  | _ -> false

# THE single ParamMode -> Ownership collapse. It lived in three copies (infer,
# iface_codec, here) and `iface_codec` documents that the declaration path and the
# wire path "must agree" — an invariant that three identically-typed copies upheld
# only by luck. Missing one when a mode is added fails SILENTLY: the mode would be
# right in a same-module call and wrong across an `.iface` boundary, which shows up
# as legal callers being rejected far from the cause, not as a compile error.
# This module is the home because it owns what a mode MEANS, and both other callers
# can import it without a cycle.
export fn ownership_of_param_mode(m: ast.ParamMode) -> types.Ownership =
  types.ownership_of_mode(mode_is_borrowing(m), mode_is_once(m))

fn mode_ownership(m: ast.ParamMode) -> types.Ownership = ownership_of_param_mode(m)

# True when any parameter carries a written modifier. Used to widen the M4.2
# gate: a program with NO linear type at all must still reject a modifier on a
# non-linear parameter, and that program never trips `program_has_linear`.
export fn any_param_mode_written(params: List ast.Param) -> Bool =
  match params with
  | Nil -> false
  | Cons prm rest ->
      if mode_is_written(param_mode(prm)) || type_expr_writes_mode(param_type_expr(prm)) then true
      else any_param_mode_written(rest)

# A mode written inside an ARROW counts too. The gate asked only about declared
# parameters, so `fn apply(g: (borrowing Int) -> Int)` in a module with no linear
# type of its own skipped the whole pass — the validation existed and nothing
# reached it. The fixture that was supposed to pin it passed only because it
# declared an unrelated `type linear File`, which made the gate fire for the
# other reason.
export fn type_expr_mode_written(te: Maybe ast.TypeExpr) -> Bool =
  type_expr_writes_mode(te)

fn type_expr_writes_mode(te: Maybe ast.TypeExpr) -> Bool =
  match te with
  | Nothing -> false
  | Just written -> type_expr_writes_mode_at(written)

fn type_expr_writes_mode_at(te: ast.TypeExpr) -> Bool =
  match te with
  | ast.TypeArrow p r _ mode ->
      mode_is_written(mode) || type_expr_writes_mode_at(p) || type_expr_writes_mode_at(r)
  | ast.TypeApply f x -> type_expr_writes_mode_at(f) || type_expr_writes_mode_at(x)
  | ast.TupleType parts -> any_type_expr_writes_mode(parts)
  | ast.TypeEffect inner _ -> type_expr_writes_mode_at(inner)
  | ast.TypeThunk r _ -> type_expr_writes_mode_at(r)
  | ast.TypeName _ -> false

fn any_type_expr_writes_mode(tes: List ast.TypeExpr) -> Bool =
  match tes with
  | Nil -> false
  | Cons te rest -> if type_expr_writes_mode_at(te) then true else any_type_expr_writes_mode(rest)

# M4.6: an instance method MAY carry an ownership modifier — the mode is on the
# method's type now, so a call site can see it — but it must AGREE with the class
# declaration. A call dispatches through the CLASS signature, so if the class says
# the parameter is consumed and the instance only borrows it, the caller's
# obligation is discharged by a body that releases nothing and the value leaks.
# That is the exact defect M4.5 rejected the whole feature to avoid; here it is
# reported precisely instead.
#
# Compared as OWNERSHIP, not as written modifiers: `consuming` on the instance
# against an unmodified class parameter is agreement, since both consume.
# Swift SE-0377 reaches the same rule — for a noncopyable parameter the
# convention "must match exactly", protocol conformances included.
# Regression: tests/conformance/type_error/borrow_instance_method,
# tests/stdlib/test_linear_borrow_in_type.spr `via_consuming`.
# Returns the MESSAGE, not just the offending parameter name: which of the three
# ownership values disagreed decides what to say, and only this walk knows that.
# The single leak-flavoured sentence it used to return was written when Ownership
# had two values, and described a leak even when the actual disagreement was about
# `once`, whose failure is an unbounded invocation count.
export fn method_mode_mismatch(params: List ast.Param, class_type: types.Type) -> Maybe String =
  match params with
  | Nil -> Nothing
  | Cons prm rest ->
      if ownership_agrees(param_mode(prm), class_type)
      then method_mode_mismatch(rest, spine_rest(class_type))
      else Just(method_mismatch_for(param_name(prm), mode_ownership(param_mode(prm)),
                                    spine_own(class_type)))

fn ownership_agrees(m: ast.ParamMode, class_type: types.Type) -> Bool =
  types.ownership_eq(mode_ownership(m), spine_own(class_type))

fn method_mismatch_for(name: String, inst: types.Ownership, cls: types.Ownership) -> String =
  if types.ownership_is_once(inst) || types.ownership_is_once(cls)
  then method_once_mismatch_msg(name)
  else method_mismatch_msg(name)

# Validate modifiers against a signature ALONE, with no body to walk. Used for
# `extern fn`, which has no body and so never reaches check_fn_linear.
export fn check_signature_modes(params: List ast.Param, ret_te: Maybe ast.TypeExpr,
                                fn_type: types.Type,
                                pos: source.SourcePos, env: Dict types.Scheme) -> LinCheck =
  match first_bad_modifier(params, ret_te, fn_type, env) with
  | Just bad -> LinFail(pos, bad_modifier_message(bad))
  | Nothing -> LinPass

# `borrowing`/`consuming` are only meaningful on a linear parameter. Sprout erases
# the modifiers before IR and the GC owns memory, so on a non-linear parameter they
# would carry no meaning whatsoever — a deliberate divergence from Swift SE-0377,
# where they still affect ARC traffic and are therefore allowed everywhere. A
# type-variable parameter is rejected too: per-declaration linearity cannot decide
# it, and polymorphism over linear types is an M4.2 non-goal.
#
# `once` (M4.4a) is validated on a different axis — it says the callee invokes the
# parameter at most once, so the parameter must be a FUNCTION; its argument type is
# irrelevant and typically non-linear (`Unit -> Unit`). Routing it through the
# linear check would reject every legitimate use.
# `ret_te` is the declaration's written RETURN annotation, validated once the
# parameter spine runs out: `fn make() -> (borrowing Int) -> Int` writes a
# modifier nowhere near a parameter, and the walk reached only parameters, so the
# position went unchecked and surfaced as a return-type MISMATCH instead.
fn first_bad_modifier(params: List ast.Param, ret_te: Maybe ast.TypeExpr,
                      fn_type: types.Type, env: Dict types.Scheme) -> Maybe BadModifier =
  match params with
  | Nil ->
      match written_mode_fault("the return type", ret_te, declared_result(fn_type), env) with
      | Just _ -> Just(BadInReturn)
      | Nothing -> Nothing
  | Cons prm rest ->
      match fn_type with
      | types.TFunc a b _ _ -> bad_modifier_here(prm, ret_te, a, rest, b, env)
      | _ -> Nothing

fn bad_modifier_here(prm: ast.Param, ret_te: Maybe ast.TypeExpr, a: types.Type,
                     rest: List ast.Param, b: types.Type,
                     env: Dict types.Scheme) -> Maybe BadModifier =
  match written_mode_fault(param_name(prm), param_type_expr(prm), a, env) with
  | Just bad -> Just(bad)
  | Nothing ->
      if mode_is_once(param_mode(prm)) then bad_once_here(prm, ret_te, a, rest, b, env)
      else if ! mode_is_written (param_mode(prm)) then first_bad_modifier(rest, ret_te, b, env)
      else if type_is_tyvar(a) then Just(BadOnTyvar(param_name(prm)))
      else if ! type_is_linear (a, env) then Just(BadNonLinear(param_name(prm)))
      else first_bad_modifier(rest, ret_te, b, env)

# The same rules, for a modifier written INSIDE a type rather than on a declared
# parameter: `g: (borrowing Int) -> Int`. Without this an arrow was the one place
# a meaningless modifier survived, to be reported as an unrelated mismatch at some
# call site if at all.
#
# It walks the written TypeExpr in lockstep with the RESOLVED type, because the
# two answer different halves. Only the TypeExpr distinguishes a written
# `consuming` from an unmarked arrow — they are one `Ownership`, so a walk over
# the type alone let `(consuming Int) -> Int` through while rejecting the
# identical `x: consuming Int`. Only the type can answer "is this linear", since
# that is an env lookup on a resolved head.
#
# Both sides are descended, not just the arrow spine: an arrow inside a type
# ARGUMENT or a tuple component is still an arrow someone wrote a modifier on.
# `List ((borrowing a) -> Int)` was accepted while the same modifier one layer up
# was rejected — and that is the type-variable case, the one whose entire point is
# that `borrowing Int` must not be reachable by instantiating it.
#
# Where the two shapes DESYNC — an alias that expands to an arrow, say — the walk
# stops. Failing open there keeps it from inventing a fault out of a mismatch
# between two representations of the same type.
fn written_mode_fault(name: String, te: Maybe ast.TypeExpr, t: types.Type,
                      env: Dict types.Scheme) -> Maybe BadModifier =
  match te with
  | Nothing -> Nothing
  | Just written -> written_mode_fault_at(name, written, t, env)

fn written_mode_fault_at(name: String, te: ast.TypeExpr, t: types.Type,
                         env: Dict types.Scheme) -> Maybe BadModifier =
  match (te, t) with
  # A trailing `!{...}` wraps the TypeExpr but never the resolved type, so it is
  # unwrapped rather than treated as a desync.
  | (ast.TypeEffect inner _, _) -> written_mode_fault_at(name, inner, t, env)
  | (ast.TypeArrow p r _ mode, types.TFunc a b _ _) ->
      match written_arrow_fault(name, mode, a, env) with
      | Just bad -> Just(bad)
      | Nothing ->
          match written_mode_fault_at(name, p, a, env) with
          | Just bad -> Just(bad)
          | Nothing -> written_mode_fault_at(name, r, b, env)
  | (ast.TypeApply f x, types.TApp tf tx) ->
      match written_mode_fault_at(name, f, tf, env) with
      | Just bad -> Just(bad)
      | Nothing -> written_mode_fault_at(name, x, tx, env)
  | (ast.TupleType parts, types.TTuple items) -> written_mode_fault_list(name, parts, items, env)
  | (ast.TypeThunk r _, types.TThunk b _) -> written_mode_fault_at(name, r, b, env)
  # Everything else is a leaf or a desync; both stop the walk.
  | _ -> Nothing

fn written_mode_fault_list(name: String, tes: List ast.TypeExpr, ts: List types.Type,
                           env: Dict types.Scheme) -> Maybe BadModifier =
  match (tes, ts) with
  | (Cons te trest, Cons t rest) ->
      match written_mode_fault_at(name, te, t, env) with
      | Just bad -> Just(bad)
      | Nothing -> written_mode_fault_list(name, trest, rest, env)
  | _ -> Nothing

# One arrow's written mode against its resolved parameter type. ModeDefault is the
# only one that says nothing the author wrote, so it is the only one skipped.
fn written_arrow_fault(name: String, mode: ast.ParamMode, a: types.Type,
                       env: Dict types.Scheme) -> Maybe BadModifier =
  if mode_is_once(mode) then
    if type_is_tyvar(a) then Just(BadOnceOnTyvar(name))
    else if ! type_is_func (a) then Just(BadOnceNonFunction(name))
    else Nothing
  else if ! mode_is_written (mode) then Nothing
  else if type_is_tyvar(a) then Just(BadOnTyvar(name))
  else if ! type_is_linear (a, env) then Just(BadNonLinear(name))
  else Nothing

# A type variable is REJECTED, like it is for `borrowing` — though for a different
# reason, and post-review: an earlier version accepted it, reasoning that `once`
# needs no linearity judgement about the argument so `fn run(f: once a)` was
# "merely useless rather than unsound". That was backwards, and the counterexample
# is tests/conformance/type_error/once_on_type_variable: `fn keep(work: once a) -> a
# = work` lets the caller move a linear value in and get it back out, then call it
# twice — a verified double release.
#
# The licence does not rest on the argument's linearity; it rests on the callee
# being able to INVOKE the parameter at most once. At `once a` the callee cannot
# invoke it at all (the type is not known to be a function), so the promise is
# vacuous, while the value stays freely returnable and duplicable. `once a` is
# therefore strictly worse than a dishonestly-annotated concrete parameter.
fn bad_once_here(prm: ast.Param, ret_te: Maybe ast.TypeExpr, a: types.Type,
                 rest: List ast.Param, b: types.Type,
                 env: Dict types.Scheme) -> Maybe BadModifier =
  if type_is_tyvar(a) then Just(BadOnceOnTyvar(param_name(prm)))
  else if type_is_func(a) then first_bad_modifier(rest, ret_te, b, env)
  else Just(BadOnceNonFunction(param_name(prm)))

fn type_is_tyvar(t: types.Type) -> Bool =
  match t with
  | types.TVar _ -> true
  | _ -> false

fn type_is_func(t: types.Type) -> Bool =
  match t with
  | types.TFunc _ _ _ _ -> true
  | types.TThunk _ _ -> true
  | _ -> false

# The linear parameters that own their argument (no modifier, or `consuming`).
# Owned parameters carry their TYPE, not just their name: under containment the
# obliged type is often not the linear one (`Maybe File`), and a leak reported as
# "linear value 'm'" names a type the `type linear` rule never mentioned. The
# binder path learned this first (leak_binder_msg); this is the same fix for
# parameters, which is why both now end in the same message function.
fn owned_param_binders(params: List ast.Param, fn_type: types.Type,
                       env: Dict types.Scheme) -> List LinBinder =
  match params with
  | Nil -> Nil
  | Cons prm rest ->
      match fn_type with
      | types.TFunc a b _ _ ->
          linear_binder_cons(type_mentions_linear(a, env) && ! mode_is_borrowing (param_mode(prm)),
                             LinBinder(param_name(prm), a), owned_param_binders(rest, b, env))
      | _ -> Nil

fn linear_binder_cons(keep: Bool, b: LinBinder, tail: List LinBinder) -> List LinBinder =
  if keep then Cons(b, tail) else tail

# The linear parameters declared `borrowing`. Head-only ON PURPOSE, where the
# owned list above is containment: an ownership MODE may only be written on a
# type that IS linear (first_bad_modifier's BadNonLinear), so `borrowing m: Maybe
# File` never reaches here to be classified. Containment in parameter modes is
# the deferred Option 2, so matching the owned list here would be dead code that
# reads like a decision.
fn borrowed_param_names(params: List ast.Param, fn_type: types.Type,
                        env: Dict types.Scheme) -> List String =
  match params with
  | Nil -> Nil
  | Cons prm rest ->
      match fn_type with
      | types.TFunc a b _ _ ->
          linear_param_cons(type_is_linear(a, env) && mode_is_borrowing(param_mode(prm)),
                            param_name(prm), borrowed_param_names(rest, b, env))
      | _ -> Nil

fn linear_param_cons(keep: Bool, nm: String, tail: List String) -> List String =
  if keep then Cons(nm, tail) else tail

fn param_name(p: ast.Param) -> String =
  match p with
  | ast.Param name _ _ -> name

# The annotation as WRITTEN. `Nothing` for an unannotated parameter, which has no
# written modifier to validate by construction.
fn param_type_expr(p: ast.Param) -> Maybe ast.TypeExpr =
  match p with
  | ast.Param _ te _ -> te

# What is left of a signature's type once its parameters are accounted for. A
# NULLARY signature is `() -> T`, a TThunk, and its `()` appears in no return
# annotation — so pairing the written return type against the thunk itself
# desyncs the walk and it silently checks nothing. That is the shape an
# `extern fn` returning a function has, which is the only way to reach the
# return position at all (a declared `fn` is rejected earlier by unification).
fn declared_result(fn_type: types.Type) -> types.Type =
  match fn_type with
  | types.TThunk b _ -> b
  | _ -> fn_type

# --- entry points ---

# Check a function body for linear-use violations. `fn_type` is the function's
# fully-substituted type (its param types drive linearity of the parameters);
# `body` is the fully-substituted typed body; `env` carries the `@linear:` markers
# and the `@parammode:` masks.
export fn check_fn_linear(params: List ast.Param, ret_te: Maybe ast.TypeExpr,
                          fn_type: types.Type,
                          body: typed_ast.TypedExpr, fn_pos: source.SourcePos,
                          env: Dict types.Scheme) -> LinCheck =
  match first_bad_modifier(params, ret_te, fn_type, env) with
  | Just bad -> LinFail(fn_pos, bad_modifier_message(bad))
  | Nothing ->
      linear_result(owned_param_binders(params, fn_type, env),
                    borrowed_param_names(params, fn_type, env),
                    once_param_names(params), body, fn_pos, env)

# The parameters declared `once`. Selected by MODE alone, not by type: `once` is
# already restricted to a function-typed parameter by first_bad_modifier, and the
# function type is never `type linear`, so the linearity-based filters above see
# none of these.
fn once_param_names(params: List ast.Param) -> List String =
  match params with
  | Nil -> Nil
  | Cons prm rest ->
      linear_param_cons(mode_is_once(param_mode(prm)), param_name(prm),
                        once_param_names(rest))

# Check a body with no parameters (a top-level `let` declaration): there are no
# linear params to leak, but do-`let`/pattern/lambda binders inside are still
# enforced by the walk.
export fn check_body_linear(body: typed_ast.TypedExpr, env: Dict types.Scheme) -> LinCheck =
  match lin_consumed(body, LinScope (Nil, Nil), env) with
  | LinErr p m -> LinFail(p, m)
  | LinOk _ _ -> LinPass

fn linear_result(owned: List LinBinder, borrowed: List String, once_names: List String,
                 body: typed_ast.TypedExpr, fn_pos: source.SourcePos,
                 env: Dict types.Scheme) -> LinCheck =
  match lin_consumed(body, LinScope(binder_names(owned), borrowed), env) with
  | LinErr p m -> LinFail(p, m)
  | LinOk consumed _ ->
      once_honesty_after(param_obligations(owned, borrowed, consumed, fn_pos, env),
                         once_names, body, env)

# CALLEE-SIDE HONESTY (post-review). `once` is a promise the callee makes, and the
# caller's whole licence to move a linear value into the closure rests on it — so
# it is checked rather than taken on trust. Without this,
# `fn run_twice(work: once Unit -> Int) = work(()) + work(())` compiles and the
# caller's moved-in value is released twice, verified.
#
# Reuses the ordinary walk with ONLY this parameter in scope, which buys exact
# branch-aware counting for free: `if c then work(()) else work(())` is one
# invocation per path and stays legal, where a syntactic occurrence count would
# reject it. Run strictly AFTER the main walk has passed, which is what makes the
# attribution sound — with no other name tracked, any error this walk reports can
# only be about this parameter.
#
# ZERO uses stay legal. `once` bounds invocations from ABOVE ("at most once", per
# Rust's FnOnce and OxCaml's `once`), so a callee may decline to invoke; that is
# also why this is a reuse rule and not the linear exactly-once rule.
# Regression: tests/conformance/type_error/once_callee_invokes_twice, and
# tests/stdlib/test_once_closures.spr `declines_to_run` for the zero-use side.
fn once_honesty_after(prior: LinCheck, once_names: List String,
                      body: typed_ast.TypedExpr, env: Dict types.Scheme) -> LinCheck =
  match prior with
  | LinFail p m -> LinFail(p, m)
  | LinPass -> once_honesty(once_names, body, env)

fn once_honesty(names: List String, body: typed_ast.TypedExpr,
                env: Dict types.Scheme) -> LinCheck =
  match names with
  | Nil -> LinPass
  | Cons n rest ->
      match lin_consumed(body, LinScope (Cons(n, Nil), Nil), env) with
      | LinErr p _ -> LinFail(p, once_reuse_msg(n))
      | LinOk _ _ -> once_honesty(rest, body, env)

# Two opposite obligations. An OWNED linear parameter must appear in the consumed
# set (else it leaked). A BORROWED one must NOT: consuming it spends a use that
# belongs to the caller. Returning a borrowed parameter lands here too — a bare
# reference in return position is a consume — so no separate escape rule is needed.
fn param_obligations(owned: List LinBinder, borrowed: List String,
                     consumed: List LinUse, fn_pos: source.SourcePos,
                     env: Dict types.Scheme) -> LinCheck =
  match first_consumed_borrow(borrowed, consumed) with
  | Just u -> LinFail(luse_pos(u), consumed_borrow_msg(luse_name(u)))
  | Nothing -> unused_linear_param(owned, consumed, fn_pos, env)

fn first_consumed_borrow(borrowed: List String, consumed: List LinUse) -> Maybe LinUse =
  match consumed with
  | Nil -> Nothing
  | Cons u rest -> if str_member(luse_name(u), borrowed) then Just(u) else first_consumed_borrow(borrowed, rest)

fn unused_linear_param(owned: List LinBinder, consumed: List LinUse,
                       fn_pos: source.SourcePos, env: Dict types.Scheme) -> LinCheck =
  match owned with
  | Nil -> LinPass
  | Cons b rest ->
      if luse_member(lbind_name(b), consumed) then unused_linear_param(rest, consumed, fn_pos, env)
      else LinFail(fn_pos, leak_binder_msg(b, env))
