module stdlib.compiler.linear_check

import stdlib.compiler.ast as ast
import stdlib.compiler.types as types
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.source as source

# ---------------------------------------------------------------------------
# Linear-types M4.2 — consume-exactly-once enforcement.
# ---------------------------------------------------------------------------
#
# A value of a `type linear` type must be used exactly once in a function body:
# not zero times (a leaked resource), not twice (use-after-consume). This is a
# post-pass over the fully-substituted typed AST — inference is untouched
# (linearity is looked up from the `@linear:<TypeName>` env sentinel M4.1 records,
# never inferred). See docs/linear-types-m4.2-enforcement-2026-08-06.md.
#
# The analysis computes, per subexpression, TWO sets of linear bindings: the ones
# it CONSUMES and the ones it merely BORROWS (M4.5). Composition rules:
#   - sequential siblings' consumed sets must be DISJOINT (twice -> reuse error);
#   - a later sibling may not BORROW what an earlier one CONSUMED (use-after-
#     consume); the reverse order — borrow then consume — is the normal session
#     shape and is fine;
#   - `if`/`match` arms must consume the IDENTICAL set (branch convergence), but
#     their borrowed sets merely union: a borrow carries no obligation;
#   - each OWNED linear binding must appear in its scope's consumed set exactly
#     once (0 -> leak). A borrow never discharges that obligation.
# Consume-exactly-once on every control-flow path follows: disjointness bounds a
# path at <=1, scope-membership forces >=1, convergence makes all paths agree.
#
# M4.5 BORROWING. A parameter declared `borrowing` is used without claiming the
# value's one consuming use, so an acquire -> use N times -> release once resource
# (a socket) becomes expressible. A reference is a borrow iff it sits at a
# `borrowing` parameter position of the callee, or the binding it names is itself
# a `borrowing` parameter — the latter is what makes a field read `p.x` borrow on
# a borrowed binding while still consuming on an owned one, with no rule about
# field syntax at all. Modifiers are erased before lowering and reach no IR pass.
# See docs/linear-borrowing-v0.md.
#
# Scope (M4.2): EVERY binder that can hold a linear value — function parameters,
# do-block `let`, match-arm pattern variables (a var pattern aliases the whole
# linear scrutinee; a constructor/tuple sub-pattern binds a linear field, resolved
# by `pattern_linear_binders`), and `<-` do-bind vars — in `fn`, top-level `let`,
# and instance-method bodies. Deferred (loud-rejected, never silently accepted):
# a linear lambda parameter and a linear binding captured by a lambda body
# (higher-order linearity, M4.4 — a closure may run 0..n times).

# A consumed linear binding: its name, and where it was consumed.
export type LinUse (..) = LinUse String source.SourcePos

# Result of a use-set computation: the linear bindings CONSUMED (each at most once
# along any path) and those merely BORROWED, or a diagnostic. Two sets, not one:
# a borrow neither discharges the once-only obligation nor collides with another
# use, so it cannot be folded into the consumed set — but it must still be ordered
# against consumes, which is what the second list makes possible.
export type LinRes (..) =
  | LinOk (List LinUse) (List LinUse)
  | LinErr source.SourcePos String

# Result of checking a whole function body.
export type LinCheck (..) =
  | LinPass
  | LinFail source.SourcePos String

# --- small set helpers over List LinUse / List String ---

fn luse_name(u: LinUse) -> String =
  match u with
  | LinUse n _ -> n

fn luse_pos(u: LinUse) -> source.SourcePos =
  match u with
  | LinUse _ p -> p

fn luse_member(name: String, us: List LinUse) -> Bool =
  match us with
  | Nil -> false
  | Cons u rest -> if luse_name(u) == name then true else luse_member(name, rest)

fn luse_remove(name: String, us: List LinUse) -> List LinUse =
  match us with
  | Nil -> Nil
  | Cons u rest ->
      if luse_name(u) == name then luse_remove(name, rest)
      else Cons(u, luse_remove(name, rest))

fn str_member(x: String, xs: List String) -> Bool =
  match xs with
  | Nil -> false
  | Cons y rest -> if y == x then true else str_member(x, rest)

# A name present in `a` but absent from `b`, if any (drives divergence errors).
fn first_missing(a: List LinUse, b: List LinUse) -> Maybe String =
  match a with
  | Nil -> Nothing
  | Cons u rest ->
      if luse_member(luse_name(u), b) then first_missing(rest, b)
      else Just(luse_name(u))

# --- linearity of a type head (mirrors infer.type_head_str / type_name_is_linear;
#     reimplemented here to avoid an infer <-> linear_check import cycle) ---

fn head_type_name(t: types.Type) -> String =
  match t with
  | types.TConst name -> types.type_id_name(name)
  | types.TApp base _ -> head_type_name(base)
  | types.TVar name -> types.tyvar_identity(name)
  | types.TTuple items -> "Tuple" ++ int_to_string(list_length(items))
  | _ -> types.type_to_string(t)

fn type_is_linear(t: types.Type, env: Dict types.Scheme) -> Bool =
  match dict_get("@linear:" ++ head_type_name(t), env) with
  | Just _ -> true
  | Nothing -> false

# True when the program declares any linear type (a cheap gate that lets a
# linear-free compilation skip the whole pass — set alongside @linear:<name>).
export fn program_has_linear(env: Dict types.Scheme) -> Bool =
  match dict_get("@any_linear", env) with
  | Just _ -> true
  | Nothing -> false

# --- resolving the types of pattern-bound variables (for linear tracking) ---
#
# A pattern that binds a variable to a linear value (or a linear field of one)
# introduces a NEW linear binding that must itself be consumed exactly once — a
# plain `VarPattern` aliases the WHOLE scrutinee; a constructor sub-pattern binds
# a field. We recover each bound variable's type by matching the pattern against
# the (already fully-substituted) value type, and report the linear ones.

fn ctor_result_ty(t: types.Type) -> types.Type =
  match t with
  | types.TFunc _ ret _ _ -> ctor_result_ty(ret)
  | _ -> t

fn ctor_param_tys(t: types.Type) -> List types.Type =
  match t with
  | types.TFunc p rest _ _ -> Cons(p, ctor_param_tys(rest))
  | _ -> Nil

# Read off the constructor's tyvar instantiation by structurally aligning its
# declared result type with the concrete scrutinee type. No unifier needed: the
# scrutinee is already concrete, so each tyvar maps to the aligned subtree.
fn struct_match(decl: types.Type, concrete: types.Type, acc: Dict types.Type) -> Dict types.Type =
  match decl with
  | types.TVar name -> dict_set(types.tyvar_identity(name), concrete, acc)
  | types.TApp f x ->
      match concrete with
      | types.TApp g y -> struct_match(x, y, struct_match(f, g, acc))
      | _ -> acc
  | types.TFunc a b _ _ ->
      match concrete with
      | types.TFunc c d _ _ -> struct_match(b, d, struct_match(a, c, acc))
      | _ -> acc
  | types.TTuple items ->
      match concrete with
      | types.TTuple citems -> struct_match_list(items, citems, acc)
      | _ -> acc
  | _ -> acc

fn struct_match_list(ds: List types.Type, cs: List types.Type, acc: Dict types.Type) -> Dict types.Type =
  match (ds, cs) with
  | (Cons d drest, Cons c crest) -> struct_match_list(drest, crest, struct_match(d, c, acc))
  | _ -> acc

fn apply_tvar_subst(sub: Dict types.Type, t: types.Type) -> types.Type =
  match t with
  | types.TVar name ->
      match dict_get(types.tyvar_identity(name), sub) with
      | Just concrete -> concrete
      | Nothing -> t
  | types.TApp f x -> types.TApp(apply_tvar_subst(sub, f), apply_tvar_subst(sub, x))
  | types.TFunc a b e o -> types.TFunc(apply_tvar_subst(sub, a), apply_tvar_subst(sub, b), e, o)
  | types.TTuple items -> types.TTuple(list_map(\i -> apply_tvar_subst(sub, i), items))
  | _ -> t

# The field types of constructor `ctor` when its result equals `value_type`.
fn ctor_field_types_at(ctor: String, value_type: types.Type, env: Dict types.Scheme) -> Maybe (List types.Type) =
  match dict_get(ctor, env) with
  | Nothing -> Nothing
  | Just scheme ->
      match scheme with
      | types.Scheme _ _ body _ _ ->
          Just(list_map(\ft -> apply_tvar_subst(struct_match(ctor_result_ty(body), value_type, dict_empty()), ft),
                        ctor_param_tys(body)))

# The linear-typed variables a pattern binds when matched against `value_type`.
fn pattern_linear_binders(pat: ast.Pattern, value_type: types.Type, env: Dict types.Scheme) -> List String =
  match pat with
  | ast.VarPattern name _ -> if type_is_linear(value_type, env) then Cons(name, Nil) else Nil
  | ast.WildcardPattern _ -> Nil
  | ast.IntPattern _ _ -> Nil
  | ast.BoolPattern _ _ -> Nil
  | ast.StringPattern _ _ -> Nil
  | ast.CharPattern _ _ -> Nil
  | ast.UnitPattern _ -> Nil
  | ast.TuplePattern pats _ ->
      match value_type with
      | types.TTuple items -> pattern_binders_list(pats, items, env)
      | _ -> Nil
  | ast.ConstructorPattern ctor subpats _ ->
      match ctor_field_types_at(ctor, value_type, env) with
      | Just field_tys -> pattern_binders_list(subpats, field_tys, env)
      | Nothing -> Nil

fn pattern_binders_list(pats: List ast.Pattern, tys: List types.Type, env: Dict types.Scheme) -> List String =
  match (pats, tys) with
  | (Cons p prest, Cons t trest) ->
      app_names(pattern_linear_binders(p, t, env), pattern_binders_list(prest, trest, env))
  | _ -> Nil

# In a `x <- m` do-bind the bound variable's type is m's payload. The monad kind
# (Maybe/Result unwrap vs effectful no-unwrap) isn't recoverable here, so we take
# the last type argument: sound (catches every linear payload), only over-strict
# on the rare effectful bind of a non-linear container of a linear.
fn payload_type(t: types.Type) -> types.Type =
  match t with
  | types.TApp _ arg -> arg
  | _ -> t

# The type a `<-` bind introduces. For a monadic bind the pattern binds the container's PAYLOAD
# (`x <- (m: Maybe File)` binds `x: File`), recovered by `payload_type`. For an effect bind
# (`h <- (io: Task a !{IO})`) the pattern binds the FULL result type — `<-` does not unwrap an
# effect — so an effect-bound linear value must be tracked whole. The post-pass cannot see the
# monad kind, so decide structurally: if the full type is itself linear it is an effect-bound
# linear (use it whole); otherwise fall back to the payload (the monadic case, and the existing
# conservative over-strict edge where a non-linear container holds a linear).
fn do_bind_type(t: types.Type, env: Dict types.Scheme) -> types.Type =
  if type_is_linear(t, env) then t else payload_type(t)

fn app_names(a: List String, b: List String) -> List String =
  match a with
  | Nil -> b
  | Cons x rest -> Cons(x, app_names(rest, b))

# Each name in `binders` must appear in `consumed` (else it leaked); returns the
# first unconsumed one.
fn unconsumed_binder(binders: List String, consumed: List LinUse) -> Maybe String =
  match binders with
  | Nil -> Nothing
  | Cons b rest -> if luse_member(b, consumed) then unconsumed_binder(rest, consumed) else Just(b)

fn remove_all(names: List String, us: List LinUse) -> List LinUse =
  match names with
  | Nil -> us
  | Cons n rest -> remove_all(rest, luse_remove(n, us))

fn first_linear_param(params: List ast.Param, lam_type: types.Type, env: Dict types.Scheme) -> Maybe String =
  match params with
  | Nil -> Nothing
  | Cons prm rest ->
      match lam_type with
      | types.TFunc a b _ _ ->
          if type_is_linear(a, env) then Just(param_name(prm))
          else first_linear_param(rest, b, env)
      | _ -> Nothing

# --- borrow-vs-consume composition (M4.5) ---

fn reuse_msg(name: String) -> String =
  "linear value '" ++ name ++ "' is used more than once (linear values must be used exactly once)"

fn leak_msg(name: String) -> String =
  "linear value '" ++ name ++ "' is never used (linear values must be used exactly once)"

fn diverge_msg(name: String) -> String =
  "linear value '" ++ name ++ "' is used in some branches but not others (every branch must use it exactly once)"

fn after_fallible_msg(name: String) -> String =
  "linear value '" ++ name ++ "' is consumed after a fallible bind in this block; the bind can short-circuit, so the consume would be skipped and the value leaked — consume it before the first `<-`, or branch with `match`"

fn after_consume_msg(name: String) -> String =
  "linear value '" ++ name ++ "' is used after it was consumed"

fn consumed_borrow_msg(name: String) -> String =
  "'" ++ name ++ "' is a borrowing parameter and cannot be consumed; take it `consuming` if this function should release it"

fn method_mismatch_msg(name: String) -> String =
  "instance method parameter '" ++ name ++ "' must match the class declaration's ownership: a call dispatches through the CLASS signature, so an instance that only borrows where the class consumes discharges the caller's obligation and leaks the value"

fn borrowed_field_read_msg() -> String =
  "a linear field cannot be read out of a borrowed value (its owner will still release it); take the parameter `consuming` if this function should own it"

fn borrowed_binder_msg(name: String) -> String =
  "linear value '" ++ name ++ "' is borrowed and cannot be consumed (it was destructured from a borrowed value, which its owner will still release)"

fn nonvar_borrow_msg() -> String =
  "a borrowing argument must be a variable reference (a freshly-built linear value here would never be consumed)"

# Which of the two reasons a modifier was rejected. They need different messages:
# telling the author of `fn f(x: borrowing a)` that `a` "is not a linear type"
# invites them to make `a` linear, which is not expressible — the real reason is
# that linearity is per-declaration and cannot be decided for a type variable.
type BadModifier (..) = BadModifier String Bool

fn bad_modifier_message(b: BadModifier) -> String =
  match b with
  | BadModifier name on_tyvar ->
      if on_tyvar then tyvar_modifier_msg(name) else bad_modifier_msg(name)

fn tyvar_modifier_msg(name: String) -> String =
  "`borrowing`/`consuming` cannot be used on a type variable (parameter '" ++ name ++ "'): linearity is per-declaration, so whether the argument is linear is not known here"

fn bad_modifier_msg(name: String) -> String =
  "`borrowing`/`consuming` is only allowed on a parameter of a linear type (parameter '" ++ name ++ "')"

fn app_uses(a: List LinUse, b: List LinUse) -> List LinUse =
  match a with
  | Nil -> b
  | Cons x rest -> Cons(x, app_uses(rest, b))

# The first use in `us` whose name also appears in `other`.
fn first_shared(us: List LinUse, other: List LinUse) -> Maybe LinUse =
  match us with
  | Nil -> Nothing
  | Cons u rest -> if luse_member(luse_name(u), other) then Just(u) else first_shared(rest, other)

# Sequential composition of two subexpressions, `a` strictly BEFORE `b`. The
# order is real, not assumed: spec-v0.md §6 fixes evaluation left-to-right for
# application arguments, binary operands, and constructor/tuple fields, and every
# caller below folds in that order. Three rules:
#
#   - consume in `a` AND consume in `b`  -> reuse (the M4.2 rule, unchanged);
#   - consume in `a` AND borrow  in `b`  -> USE AFTER CONSUME. This is the hole a
#     set-only analysis cannot see: `close(conn); write(conn, x)` records one
#     consume and zero consumes, so the sets stay disjoint and M4.2 would accept
#     a write to a closed socket;
#   - borrow  in `a` AND consume in `b`  -> the normal session order (`write`
#     then `close`). Always fine.
#
# Errors report the position of the LATER use, which is the offending one.
fn seq2(ac: List LinUse, ab: List LinUse, bc: List LinUse, bb: List LinUse) -> LinRes =
  match first_shared(bc, ac) with
  | Just u -> LinErr(luse_pos(u), reuse_msg(luse_name(u)))
  | Nothing -> seq2_after_reuse(ac, ab, bc, bb)

fn seq2_after_reuse(ac: List LinUse, ab: List LinUse, bc: List LinUse, bb: List LinUse) -> LinRes =
  match first_shared(bb, ac) with
  | Just u -> LinErr(luse_pos(u), after_consume_msg(luse_name(u)))
  | Nothing -> LinOk(app_uses(ac, bc), app_uses(ab, bb))

# Two alternative branches. Consumed sets must be EQUAL (an obligation discharged
# on one path must be discharged on all). Borrowed sets merely UNION: a borrow
# carries no obligation, so borrowing in one arm and not the other is harmless.
fn alt_converge(ac: List LinUse, ab: List LinUse, bc: List LinUse, bb: List LinUse,
                at: source.SourcePos) -> LinRes =
  match first_missing(ac, bc) with
  | Just n -> LinErr(at, diverge_msg(n))
  | Nothing -> alt_converge_rev(ac, ab, bc, bb, at)

fn alt_converge_rev(ac: List LinUse, ab: List LinUse, bc: List LinUse, bb: List LinUse,
                    at: source.SourcePos) -> LinRes =
  match first_missing(bc, ac) with
  | Just n -> LinErr(at, diverge_msg(n))
  | Nothing -> LinOk(ac, app_uses(ab, bb))

# --- the linear bindings in scope, split by mode ---
#
# `owned` must each be consumed exactly once (a parameter with no modifier or
# with `consuming`, a do-`let`, a `<-` bind, a pattern binder). `borrowed` is a
# `borrowing` parameter: it carries NO consume obligation here — that stayed with
# the caller — and must not be consumed at all.
export type LinScope (..) = LinScope(List String) (List String)

fn scope_owned(sc: LinScope) -> List String =
  match sc with
  | LinScope o _ -> o

fn scope_borrowed(sc: LinScope) -> List String =
  match sc with
  | LinScope _ b -> b

fn scope_is_owned(name: String, sc: LinScope) -> Bool = str_member(name, scope_owned(sc))

fn scope_is_borrowed(name: String, sc: LinScope) -> Bool = str_member(name, scope_borrowed(sc))

fn scope_is_linear(name: String, sc: LinScope) -> Bool =
  scope_is_owned(name, sc) || scope_is_borrowed(name, sc)

# Drop every entry for `names` from BOTH lists. A new binder SHADOWS whatever the
# name meant before, so its old tracking must go — otherwise a non-linear binder
# shadowing a linear one leaves the stale entry behind, and a use of the shadow
# is credited as a consume of the shadowed resource. That satisfied the leak
# check while nothing was ever released:
#
#     fn shadow(c: File) -> Int = do { let c = 5; c + 1 }   # accepted, c leaked
#
# The lists model an environment, so every introduction must shadow, not append.
# Regression: tests/conformance/type_error/borrow_shadowed_linear_binder.
fn scope_shadow(names: List String, sc: LinScope) -> LinScope =
  LinScope(str_remove_all(names, scope_owned(sc)), str_remove_all(names, scope_borrowed(sc)))

fn str_remove_all(names: List String, xs: List String) -> List String =
  match names with
  | Nil -> xs
  | Cons n rest -> str_remove_all(rest, str_remove(n, xs))

fn str_remove(name: String, xs: List String) -> List String =
  match xs with
  | Nil -> Nil
  | Cons y rest -> if y == name then str_remove(name, rest) else Cons(y, str_remove(name, rest))

fn scope_add_owned(names: List String, sc: LinScope) -> LinScope =
  scope_add_owned_after(names, scope_shadow(names, sc))

fn scope_add_owned_after(names: List String, sc: LinScope) -> LinScope =
  LinScope(app_names(names, scope_owned(sc)), scope_borrowed(sc))

# --- the recursive walk ---

fn lin_consumed(e: typed_ast.TypedExpr, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match e with
  | typed_ast.TVar name _ p -> lin_var(name, p, sc)
  | typed_ast.TInt _ _ _ -> LinOk(Nil, Nil)
  | typed_ast.TFloat _ _ _ -> LinOk(Nil, Nil)
  | typed_ast.TBool _ _ _ -> LinOk(Nil, Nil)
  | typed_ast.TString _ _ _ -> LinOk(Nil, Nil)
  | typed_ast.TChar _ _ _ -> LinOk(Nil, Nil)
  | typed_ast.TUnit _ _ -> LinOk(Nil, Nil)
  | typed_ast.TDict _ _ _ _ -> LinOk(Nil, Nil)
  | typed_ast.TMethodRef _ _ _ _ _ -> LinOk(Nil, Nil)
  | typed_ast.TGetField base _ fty fp -> lin_getfield(base, fty, fp, sc, env)
  | typed_ast.TUnary _ inner _ _ -> lin_consumed(inner, sc, env)
  | typed_ast.TTuple items _ _ -> seq_list(items, sc, env)
  | typed_ast.TCall callee args _ _ -> lin_call(callee, args, sc, env)
  | typed_ast.TBinary _ l r _ _ -> seq_list(Cons(l, Cons(r, Nil)), sc, env)
  | typed_ast.TRange lo hi _ _ -> seq_list(Cons(lo, Cons(hi, Nil)), sc, env)
  | typed_ast.TRecord _ fields _ _ -> seq_list(record_field_exprs(fields), sc, env)
  | typed_ast.TRecordUpdate base fields _ _ ->
      seq_list(Cons(base, record_field_exprs(fields)), sc, env)
  | typed_ast.TIf c a b _ p -> lin_if(c, a, b, p, sc, env)
  | typed_ast.TMatch scrut arms _ p -> lin_match(scrut, arms, p, sc, env)
  | typed_ast.TDo steps dty _ -> lin_do(steps, block_short_circuits(dty), sc, env)
  | typed_ast.TLambda params body lam_type p -> lin_lambda(params, body, lam_type, p, sc, env)

# A bare reference in a CONSUMING position: a `consuming`/unmodified argument, a
# do-`let` or `<-` right-hand side, or return position. This consumes whatever
# mode the binding has — deliberately, including a BORROWED one, because that is
# how the two escape rules are caught with no separate machinery: consuming or
# returning a `borrowing` parameter puts it in the consumed set, and
# `param_obligations` rejects any borrowed name found there. Recording it as a
# borrow instead would make the violation unrepresentable.
# M4.6: the mode now rides on the function TYPE, so a `borrowing` function used
# as a VALUE keeps its mode and no longer needs the blanket rejection M4.5 had
# here. A function-typed binding is never itself linear, so walking one as an
# ordinary reference records nothing.
fn lin_var(name: String, p: source.SourcePos, sc: LinScope) -> LinRes =
  if scope_is_linear(name, sc) then LinOk(Cons (LinUse(name, p), Nil), Nil)
  else LinOk(Nil, Nil)

# A use in a READING position — the base of a field access, or a match scrutinee.
# These look INTO the value without taking it, so on a BORROWED binding they are
# borrows: that is what makes `p.x + p.y` legal for `p: borrowing Pos`, and what
# lets `tcp_connection_handle(conn: borrowing TcpConnection)` do `match conn with`
# to reach the handle. On an OWNED binding a read still consumes, exactly as M4.2
# and spec-v0.md §5.8 define — which is why `get_x(p: Pos) = p.x` stays accepted
# and `manhattan(p: Pos) = p.x + p.y` stays a reuse.
# Reading a field of a BORROWED value borrows the base — that is what makes
# `p.x + p.y` legal for `p: borrowing Pos`. But only when the FIELD ITSELF is
# non-linear. A LINEAR field read out of a borrow yields an OWNED linear value
# that the caller still owns and will release, so
#
#     fn steal(w: borrowing Wrap) -> Int  = release(w.inner)   # double consume
#     fn take (w: borrowing Wrap) -> File = w.inner            # launders it out
#
# both had to be rejected. Expressing this properly needs the extracted field to
# be a borrow too, and v0 has no type for a borrow — so v0 rejects the read.
# The `match` form of this hole is handled by `from_borrow` in arm_consumed; this
# is the field-access form, which that path never reached.
# Regressions: tests/conformance/type_error/borrow_field_{extract,escape}.
fn lin_getfield(base: typed_ast.TypedExpr, field_ty: types.Type, p: source.SourcePos,
                sc: LinScope, env: Dict types.Scheme) -> LinRes =
  if expr_is_borrowed_binding(base, sc) && type_is_linear(field_ty, env)
  then LinErr(p, borrowed_field_read_msg())
  else lin_read(base, sc, env)

fn lin_read(e: typed_ast.TypedExpr, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match e with
  | typed_ast.TVar name _ p -> lin_read_var(name, p, sc, e, env)
  | _ -> lin_consumed(e, sc, env)

fn lin_read_var(name: String, p: source.SourcePos, sc: LinScope,
                e: typed_ast.TypedExpr, env: Dict types.Scheme) -> LinRes =
  if scope_is_borrowed(name, sc) then LinOk(Nil, Cons (LinUse(name, p), Nil))
  else lin_consumed(e, sc, env)

# --- calls: classify each argument position by the callee's declared modes ---

# M4.6: each argument position is classified from the CALLEE'S TYPE — one
# `types.Ownership` per `TFunc` node of its spine — rather than from a mask keyed
# by the callee's declaration name. The type is present on every callee shape, so
# a lambda, a function-typed parameter, a `let`-bound function and a typeclass
# method are all classified correctly; the name-keyed table saw none of them and
# silently read every argument as consuming, discharging the caller's obligation.
#
# A spine shorter than the argument list (an unresolved callee type, over-
# application) yields OwnConsume, which is the conservative reading.
fn spine_is_borrow(t: types.Type) -> Bool =
  match t with
  | types.TFunc _ _ _ own -> types.ownership_is_borrow(own)
  | _ -> false

fn spine_rest(t: types.Type) -> types.Type =
  match t with
  | types.TFunc _ ret _ _ -> ret
  | _ -> t

# ALIGNMENT. infer prepends a TDict evidence node per class constraint to a
# constrained call's argument list (maybe_rewrite_class_method_call), but the
# callee's TYPE spine has no dictionary parameter — those are added later, by
# lowering.append_hidden_param_types. Zipping the two naively therefore shifts
# every mode by the number of dictionaries, so a `borrowing` parameter on a class
# method reads as consuming and the value is double-counted. A TDict carries no
# linear use of its own (lin_consumed's TDict arm is LinOk(Nil, Nil)), so
# dropping the leading run before the zip is both necessary and complete.
# Regression: tests/stdlib/test_linear_borrow_in_type.spr `via_class`.
fn drop_leading_dicts(args: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  match args with
  | Nil -> Nil
  | Cons a rest ->
      match a with
      | typed_ast.TDict _ _ _ _ -> drop_leading_dicts(rest)
      | _ -> args

fn lin_call(callee: typed_ast.TypedExpr, args: List typed_ast.TypedExpr,
            sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match lin_consumed(callee, sc, env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk cc cb ->
      lin_call_args(drop_leading_dicts(args), typed_ast.typed_expr_type(callee), cc, cb, sc, env)

# Arguments fold left-to-right (spec-v0.md §6.1), so `seq2` sees them in real
# evaluation order and the borrow-after-consume rule is exact rather than
# approximate.
fn lin_call_args(args: List typed_ast.TypedExpr, spine: types.Type,
                 ac: List LinUse, ab: List LinUse,
                 sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match args with
  | Nil -> LinOk(ac, ab)
  | Cons a rest ->
      match lin_arg(a, spine_is_borrow(spine), sc, env) with
      | LinErr p m -> LinErr(p, m)
      | LinOk c b -> lin_call_args_rest(rest, spine, ac, ab, c, b, sc, env)

fn lin_call_args_rest(rest: List typed_ast.TypedExpr, spine: types.Type,
                      ac: List LinUse, ab: List LinUse, c: List LinUse, b: List LinUse,
                      sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match seq2(ac, ab, c, b) with
  | LinErr p m -> LinErr(p, m)
  | LinOk nc nb -> lin_call_args(rest, spine_rest(spine), nc, nb, sc, env)

# One argument. At a `borrowing` position a LINEAR argument must be a bare
# variable: a freshly-built linear value there would be borrowed and then dropped,
# with nothing left to consume it and no binder for the leak check to find — the
# analysis tracks binders only (BACKLOG "discarded linear expression result").
# A non-linear argument at a borrowing position is walked normally; the position
# is simply irrelevant to it.
fn lin_arg(a: typed_ast.TypedExpr, is_borrow: Bool, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  if ! is_borrow then lin_consumed(a, sc, env) else lin_borrow_arg(a, sc, env)

fn lin_borrow_arg(a: typed_ast.TypedExpr, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match a with
  | typed_ast.TVar name _ p -> lin_borrow_var(name, p, sc, a, env)
  | _ -> lin_nonvar_borrow(a, sc, env)

# An untracked name (a module-level linear `let`, say) is still a VARIABLE, so it
# must not fall into the "must be a variable reference" rejection — that message
# contradicted the source and named a cause ("a freshly-built linear value") that
# was false for the program. Walk it as an ordinary reference instead; that also
# routes it through the borrowing-function-as-value check.
# Regression: tests/stdlib/test_linear_borrowing.spr `borrow_module_level`.
fn lin_borrow_var(name: String, p: source.SourcePos, sc: LinScope,
                  a: typed_ast.TypedExpr, env: Dict types.Scheme) -> LinRes =
  if scope_is_linear(name, sc) then LinOk(Nil, Cons (LinUse(name, p), Nil))
  else lin_consumed(a, sc, env)

fn lin_nonvar_borrow(a: typed_ast.TypedExpr, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  if type_is_linear(typed_ast.typed_expr_type(a), env)
  then LinErr(typed_ast.typed_expr_pos(a), nonvar_borrow_msg())
  else lin_consumed(a, sc, env)

fn record_field_exprs(fields: List typed_ast.TypedRecordField) -> List typed_ast.TypedExpr =
  match fields with
  | Nil -> Nil
  | Cons f rest ->
      match f with
      | typed_ast.TypedRecordField _ v -> Cons(v, record_field_exprs(rest))

# Sequentially combine a list of subexpressions, left to right.
fn seq_list(exprs: List typed_ast.TypedExpr, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match exprs with
  | Nil -> LinOk(Nil, Nil)
  | Cons e rest ->
      match lin_consumed(e, sc, env) with
      | LinErr p m -> LinErr(p, m)
      | LinOk ac ab -> seq_list_rest(rest, ac, ab, sc, env)

fn seq_list_rest(rest: List typed_ast.TypedExpr, ac: List LinUse, ab: List LinUse,
                 sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match seq_list(rest, sc, env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk bc bb -> seq2(ac, ab, bc, bb)

fn lin_if(c: typed_ast.TypedExpr, a: typed_ast.TypedExpr, b: typed_ast.TypedExpr,
          p: source.SourcePos, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  let LinOk cc cb = lin_consumed(c, sc, env) else LinErr ep m -> LinErr(ep, m)
      LinOk ac ab = lin_consumed(a, sc, env) else LinErr ep m -> LinErr(ep, m)
      LinOk bc bb = lin_consumed(b, sc, env) else LinErr ep m -> LinErr(ep, m)
      LinOk mc mb = alt_converge(ac, ab, bc, bb, p) else LinErr ep m -> LinErr(ep, m)
  in seq2(cc, cb, mc, mb)

fn lin_match(scrut: typed_ast.TypedExpr, arms: List typed_ast.TypedMatchBranch,
             p: source.SourcePos, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match lin_read(scrut, sc, env) with
  | LinErr ep m -> LinErr(ep, m)
  | LinOk sc_c sc_b -> lin_match_arms(scrut, arms, sc_c, sc_b, sc, env)

fn lin_match_arms(scrut: typed_ast.TypedExpr, arms: List typed_ast.TypedMatchBranch,
                  sc_c: List LinUse, sc_b: List LinUse,
                  sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match arm_sets(arms, sc, typed_ast.typed_expr_type(scrut),
                 expr_is_borrowed_binding(scrut, sc), env) with
  | LinErr ep m -> LinErr(ep, m)
  | LinOk mc mb -> seq2(sc_c, sc_b, mc, mb)

# CONTAINMENT: destructuring a BORROWED value yields BORROWED fields. Without
# this, `match w with | Wrap f -> release(f)` inside a `borrowing Wrap` function
# would consume the inner linear field while the caller still owns the Wrap and
# will release it again — a double consume laundered through a pattern match.
# Reads through a borrow are borrows all the way down.
fn expr_is_borrowed_binding(e: typed_ast.TypedExpr, sc: LinScope) -> Bool =
  match e with
  | typed_ast.TVar name _ _ -> scope_is_borrowed(name, sc)
  | _ -> false

# All arm bodies must converge to the identical CONSUMED set of outer linear
# bindings. An arm's own pattern-bound linear vars are arm-local: owned (consumed
# exactly once inside the arm) when the scrutinee is owned, borrowed (never
# consumed) when it came from a borrow. Either way they are removed before the
# convergence comparison.
fn arm_sets(arms: List typed_ast.TypedMatchBranch, sc: LinScope, scrut_type: types.Type,
            from_borrow: Bool, env: Dict types.Scheme) -> LinRes =
  match arms with
  | Nil -> LinOk(Nil, Nil)
  | [br] -> arm_consumed(br, sc, scrut_type, from_borrow, env)
  | Cons br rest ->
      match arm_consumed(br, sc, scrut_type, from_borrow, env) with
      | LinErr p m -> LinErr(p, m)
      | LinOk ac ab -> arm_sets_rest(rest, ac, ab, arm_pos(br), sc, scrut_type, from_borrow, env)

fn arm_sets_rest(rest: List typed_ast.TypedMatchBranch, ac: List LinUse, ab: List LinUse,
                 at: source.SourcePos, sc: LinScope, scrut_type: types.Type,
                 from_borrow: Bool, env: Dict types.Scheme) -> LinRes =
  match arm_sets(rest, sc, scrut_type, from_borrow, env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk bc bb -> alt_converge(ac, ab, bc, bb, at)

fn arm_consumed(br: typed_ast.TypedMatchBranch, sc: LinScope, scrut_type: types.Type,
                from_borrow: Bool, env: Dict types.Scheme) -> LinRes =
  match br with
  | typed_ast.TypedMatchBranch pat body ->
      scope_consumed(pattern_linear_binders(pat, scrut_type, env), from_borrow, body,
                     typed_ast.typed_expr_pos(body),
                     scope_shadow(pattern_all_binders(pat), sc), env)

# EVERY name a pattern binds, linear or not. `pattern_linear_binders` reports only
# the linear ones (they carry obligations); this reports all of them, because a
# NON-linear pattern variable must still shadow a linear binding of the same name.
fn pattern_all_binders(pat: ast.Pattern) -> List String =
  match pat with
  | ast.VarPattern name _ -> Cons(name, Nil)
  | ast.WildcardPattern _ -> Nil
  | ast.IntPattern _ _ -> Nil
  | ast.BoolPattern _ _ -> Nil
  | ast.StringPattern _ _ -> Nil
  | ast.CharPattern _ _ -> Nil
  | ast.UnitPattern _ -> Nil
  | ast.TuplePattern pats _ -> pattern_all_binders_list(pats)
  | ast.ConstructorPattern _ subpats _ -> pattern_all_binders_list(subpats)

fn pattern_all_binders_list(pats: List ast.Pattern) -> List String =
  match pats with
  | Nil -> Nil
  | Cons p rest -> app_names(pattern_all_binders(p), pattern_all_binders_list(rest))

# Check `body` with `binders` in scope. Owned binders must each be consumed
# exactly once inside (reuse is caught by seq2; a leftover binder is a leak);
# borrowed binders must NOT be consumed at all. Either way they are removed from
# both sets reported to the enclosing scope.
fn scope_consumed(binders: List String, from_borrow: Bool, body: typed_ast.TypedExpr,
                  leak_pos: source.SourcePos, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match lin_consumed(body, scope_add(binders, from_borrow, sc), env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk consumed borrowed -> scope_close(binders, from_borrow, consumed, borrowed, leak_pos)

fn scope_add(names: List String, from_borrow: Bool, sc: LinScope) -> LinScope =
  if from_borrow then scope_add_borrowed(names, scope_shadow(names, sc))
  else scope_add_owned(names, sc)

fn scope_add_borrowed(names: List String, sc: LinScope) -> LinScope =
  LinScope(scope_owned(sc), app_names(names, scope_borrowed(sc)))

fn scope_close(binders: List String, from_borrow: Bool, consumed: List LinUse,
               borrowed: List LinUse, leak_pos: source.SourcePos) -> LinRes =
  if from_borrow then scope_close_borrowed(binders, consumed, borrowed)
  else scope_close_owned(binders, consumed, borrowed, leak_pos)

fn scope_close_borrowed(binders: List String, consumed: List LinUse,
                        borrowed: List LinUse) -> LinRes =
  match first_consumed_borrow(binders, consumed) with
  | Just u -> LinErr(luse_pos(u), borrowed_binder_msg(luse_name(u)))
  | Nothing -> LinOk(remove_all(binders, consumed), remove_all(binders, borrowed))

fn scope_close_owned(binders: List String, consumed: List LinUse, borrowed: List LinUse,
                     leak_pos: source.SourcePos) -> LinRes =
  match unconsumed_binder(binders, consumed) with
  | Just leaked -> LinErr(leak_pos, leak_msg(leaked))
  | Nothing -> LinOk(remove_all(binders, consumed), remove_all(binders, borrowed))

fn arm_pos(br: typed_ast.TypedMatchBranch) -> source.SourcePos =
  match br with
  | typed_ast.TypedMatchBranch _ body -> typed_ast.typed_expr_pos(body)

# Does a `<-` bind in THIS block short-circuit? `Maybe` short-circuits on Nothing
# and `Result e` is left-biased on the first Err (spec-v0.md §11), so in such a
# block the steps AFTER a bind are conditional. An effectful block (`Unit !{IO}`)
# runs every step, so its binds are unconditional. The block's own type is the
# discriminator; effect rows live on TFunc, so the head is unaffected by `!{IO}`.
fn block_short_circuits(block_ty: types.Type) -> Bool =
  short_circuit_head(after_last_dot(head_type_name(block_ty)))

fn short_circuit_head(h: String) -> Bool = h == "Maybe" || h == "Result"

fn after_last_dot(name: String) -> String =
  if str_find(name, ".") == -1 then name else after_last_dot(str_slice(name, str_find(name, ".") + 1, str_len(name)))

fn lin_do(steps: List typed_ast.TypedDoStep, sc_block: Bool, sc: LinScope,
          env: Dict types.Scheme) -> LinRes =
  match steps with
  | Nil -> LinOk(Nil, Nil)
  | Cons step rest ->
      match step with
      | typed_ast.TDoLetStep name rhs -> lin_do_let(name, rhs, rest, sc_block, sc, env)
      | typed_ast.TDoExprStep e -> lin_do_seq(e, rest, sc_block, sc, env)
      | typed_ast.TDoBindStep pat e -> lin_do_bind(pat, e, rest, sc_block, sc, env)

# A `<-` do-bind: its pattern binds variables (possibly linear) scoped to the
# remaining steps, each consumed exactly once there. The RHS is sequential-before
# the rest — which is what makes `close(conn)` followed by a later `write(conn,…)`
# in a do-block a use-after-consume rather than an unordered set collision.
fn lin_do_bind(pat: ast.Pattern, e: typed_ast.TypedExpr, rest: List typed_ast.TypedDoStep,
               sc_block: Bool, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match lin_consumed(e, sc, env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk ec eb ->
      lin_do_bind_rest(pattern_linear_binders(pat, do_bind_type(typed_ast.typed_expr_type(e), env), env),
                       ec, eb, e, rest, sc_block, sc, env)

fn lin_do_bind_rest(binders: List String, ec: List LinUse, eb: List LinUse,
                    e: typed_ast.TypedExpr, rest: List typed_ast.TypedDoStep,
                    sc_block: Bool, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match lin_do(rest, sc_block, scope_add_owned(binders, sc), env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk restc restb -> lin_do_bind_close(binders, ec, eb, restc, restb, e, sc_block)

fn lin_do_bind_close(binders: List String, ec: List LinUse, eb: List LinUse,
                     restc: List LinUse, restb: List LinUse, e: typed_ast.TypedExpr,
                     sc_block: Bool) -> LinRes =
  match unconsumed_binder(binders, restc) with
  | Just leaked -> LinErr(typed_ast.typed_expr_pos(e), leak_msg(leaked))
  | Nothing -> lin_do_bind_after(binders, ec, eb, restc, restb, e, sc_block)

# In a SHORT-CIRCUITING block the steps after this bind are conditional, so a
# consume of a binding introduced OUTSIDE the block is not guaranteed to run:
#
#     do { _ <- write(c); reply <- read(c); let _ = close(c); Ok(reply) }
#
# was accepted with `close` counted as executed, yet on any Err the block returns
# early and the socket leaks for the process lifetime — the very shape M4.5 makes
# idiomatic. The bind's OWN binders are exempt: they do not exist on the
# short-circuit path, so they owe nothing there.
# Regression: tests/conformance/type_error/borrow_after_fallible_bind.
fn lin_do_bind_after(binders: List String, ec: List LinUse, eb: List LinUse,
                     restc: List LinUse, restb: List LinUse, e: typed_ast.TypedExpr,
                     sc_block: Bool) -> LinRes =
  match conditional_consume(sc_block, remove_all(binders, restc)) with
  | Just u -> LinErr(luse_pos(u), after_fallible_msg(luse_name(u)))
  | Nothing -> seq2(ec, eb, remove_all(binders, restc), remove_all(binders, restb))

fn conditional_consume(sc_block: Bool, outer: List LinUse) -> Maybe LinUse =
  if ! sc_block then Nothing
  else
    match outer with
    | [] -> Nothing
    | [u | _] -> Just(u)

fn lin_do_seq(e: typed_ast.TypedExpr, rest: List typed_ast.TypedDoStep,
              sc_block: Bool, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match lin_consumed(e, sc, env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk ec eb -> lin_do_seq_rest(rest, ec, eb, sc_block, sc, env)

fn lin_do_seq_rest(rest: List typed_ast.TypedDoStep, ec: List LinUse, eb: List LinUse,
                   sc_block: Bool, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match lin_do(rest, sc_block, sc, env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk restc restb -> seq2(ec, eb, restc, restb)

fn lin_do_let(name: String, rhs: typed_ast.TypedExpr, rest: List typed_ast.TypedDoStep,
              sc_block: Bool, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match lin_consumed(rhs, sc, env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk rc rb ->
      lin_do_let_body(name, rhs, rc, rb, rest, sc_block, sc, env,
                      type_is_linear(typed_ast.typed_expr_type(rhs), env))

# A linear do-let binding is OWNED, scoped to `rest`, consumed exactly once there.
fn lin_do_let_body(name: String, rhs: typed_ast.TypedExpr, rc: List LinUse, rb: List LinUse,
                   rest: List typed_ast.TypedDoStep, sc_block: Bool, sc: LinScope,
                   env: Dict types.Scheme, is_lin: Bool) -> LinRes =
  match lin_do(rest, sc_block, extend_scope(is_lin, name, sc), env) with
  | LinErr p m -> LinErr(p, m)
  | LinOk restc restb -> lin_do_let_close(name, rhs, rc, rb, restc, restb, is_lin)

fn lin_do_let_close(name: String, rhs: typed_ast.TypedExpr, rc: List LinUse, rb: List LinUse,
                    restc: List LinUse, restb: List LinUse, is_lin: Bool) -> LinRes =
  if ! is_lin then seq2(rc, rb, restc, restb)
  else if luse_member(name, restc) then
    seq2(rc, rb, luse_remove(name, restc), luse_remove(name, restb))
  else LinErr(typed_ast.typed_expr_pos(rhs), leak_msg(name))

# A non-linear do-`let` must SHADOW, not be ignored: `let c = 5` over a linear
# `c` has to drop the old entry, or `c + 1` is credited as consuming the resource.
fn extend_scope(is_lin: Bool, name: String, sc: LinScope) -> LinScope =
  if is_lin then scope_add_owned(Cons(name, Nil), sc)
  else scope_shadow(Cons(name, Nil), sc)

# A lambda may run zero or many times, so (higher-order linearity, M4.4, deferred)
# it must neither take a linear parameter nor capture an outer linear binding.
# BORROWS count as captures here too: the v0 borrowing rule (design note §7) is
# that a borrowed value may not be captured at all, because soundness would turn
# on whether the closure escapes and outlives the consume, and Sprout has no
# escaping/non-escaping distinction. Both are loud-rejected, never silently taken.
fn lin_lambda(params: List ast.Param, body: typed_ast.TypedExpr, lam_type: types.Type,
              p: source.SourcePos, sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match first_linear_param(params, lam_type, env) with
  | Just pname ->
      LinErr(p, "linear lambda parameter '" ++ pname
        ++ "' is not yet supported (higher-order linearity is deferred)")
  | Nothing -> lin_lambda_body(body, p, scope_shadow(lambda_param_names(params), sc), env)

fn lambda_param_names(params: List ast.Param) -> List String =
  match params with
  | Nil -> Nil
  | Cons prm rest -> Cons(param_name(prm), lambda_param_names(rest))

fn lin_lambda_body(body: typed_ast.TypedExpr, p: source.SourcePos,
                   sc: LinScope, env: Dict types.Scheme) -> LinRes =
  match lin_consumed(body, sc, env) with
  | LinErr ep m -> LinErr(ep, m)
  | LinOk bc bb -> lin_lambda_captures(app_uses(bc, bb), p)

fn lin_lambda_captures(uses: List LinUse, p: source.SourcePos) -> LinRes =
  match uses with
  | Nil -> LinOk(Nil, Nil)
  | [u | _] ->
      LinErr(p, "linear value '" ++ luse_name(u)
        ++ "' captured by a lambda is not yet supported (higher-order linearity is deferred)")

# --- parameter modes ---

fn param_mode(p: ast.Param) -> ast.ParamMode =
  match p with
  | ast.Param _ _ m -> m

fn mode_is_written(m: ast.ParamMode) -> Bool =
  match m with
  | ast.ModeDefault -> false
  | _ -> true

fn mode_is_borrowing(m: ast.ParamMode) -> Bool =
  match m with
  | ast.ModeBorrowing -> true
  | _ -> false

# True when any parameter carries a written modifier. Used to widen the M4.2
# gate: a program with NO linear type at all must still reject a modifier on a
# non-linear parameter, and that program never trips `program_has_linear`.
export fn any_param_mode_written(params: List ast.Param) -> Bool =
  match params with
  | Nil -> false
  | Cons prm rest -> if mode_is_written(param_mode(prm)) then true else any_param_mode_written(rest)

# M4.6: an instance method MAY carry an ownership modifier — the mode is on the
# method's type now, so a call site can see it — but it must AGREE with the class
# declaration. A call dispatches through the CLASS signature, so if the class says
# the parameter is consumed and the instance only borrows it, the caller's
# obligation is discharged by a body that releases nothing and the value leaks.
# That is the exact defect M4.5 rejected the whole feature to avoid; here it is
# reported precisely instead.
#
# Compared as OWNERSHIP, not as written modifiers: `consuming` on the instance
# against an unmodified class parameter is agreement, since both consume.
# Swift SE-0377 reaches the same rule — for a noncopyable parameter the
# convention "must match exactly", protocol conformances included.
# Regression: tests/conformance/type_error/borrow_instance_method,
# tests/stdlib/test_linear_borrow_in_type.spr `via_consuming`.
export fn method_mode_mismatch(params: List ast.Param, class_type: types.Type) -> Maybe String =
  match params with
  | Nil -> Nothing
  | Cons prm rest ->
      if ownership_agrees(param_mode(prm), class_type)
      then method_mode_mismatch(rest, spine_rest(class_type))
      else Just(param_name(prm))

fn ownership_agrees(m: ast.ParamMode, class_type: types.Type) -> Bool =
  mode_is_borrowing(m) == spine_is_borrow(class_type)

export fn method_mode_mismatch_message(name: String) -> String = method_mismatch_msg(name)

# Validate modifiers against a signature ALONE, with no body to walk. Used for
# `extern fn`, which has no body and so never reaches check_fn_linear.
export fn check_signature_modes(params: List ast.Param, fn_type: types.Type,
                                pos: source.SourcePos, env: Dict types.Scheme) -> LinCheck =
  match first_bad_modifier(params, fn_type, env) with
  | Just bad -> LinFail(pos, bad_modifier_message(bad))
  | Nothing -> LinPass

# A modifier is only meaningful on a linear parameter. Sprout erases the modifiers
# before IR and the GC owns memory, so on a non-linear parameter they would carry
# no meaning whatsoever — a deliberate divergence from Swift SE-0377, where they
# still affect ARC traffic and are therefore allowed everywhere. A type-variable
# parameter is rejected too: per-declaration linearity cannot decide it, and
# polymorphism over linear types is an M4.2 non-goal.
fn first_bad_modifier(params: List ast.Param, fn_type: types.Type,
                      env: Dict types.Scheme) -> Maybe BadModifier =
  match params with
  | Nil -> Nothing
  | Cons prm rest ->
      match fn_type with
      | types.TFunc a b _ _ -> bad_modifier_here(prm, a, rest, b, env)
      | _ -> Nothing

fn bad_modifier_here(prm: ast.Param, a: types.Type, rest: List ast.Param,
                     b: types.Type, env: Dict types.Scheme) -> Maybe BadModifier =
  if ! mode_is_written (param_mode(prm)) then first_bad_modifier(rest, b, env)
  else if type_is_tyvar(a) then Just(BadModifier(param_name(prm), true))
  else if ! type_is_linear (a, env) then Just(BadModifier(param_name(prm), false))
  else first_bad_modifier(rest, b, env)

fn type_is_tyvar(t: types.Type) -> Bool =
  match t with
  | types.TVar _ -> true
  | _ -> false

# The linear parameters that own their argument (no modifier, or `consuming`).
fn owned_param_names(params: List ast.Param, fn_type: types.Type,
                     env: Dict types.Scheme) -> List String =
  match params with
  | Nil -> Nil
  | Cons prm rest ->
      match fn_type with
      | types.TFunc a b _ _ ->
          linear_param_cons(type_is_linear(a, env) && ! mode_is_borrowing (param_mode(prm)),
                            param_name(prm), owned_param_names(rest, b, env))
      | _ -> Nil

# The linear parameters declared `borrowing`.
fn borrowed_param_names(params: List ast.Param, fn_type: types.Type,
                        env: Dict types.Scheme) -> List String =
  match params with
  | Nil -> Nil
  | Cons prm rest ->
      match fn_type with
      | types.TFunc a b _ _ ->
          linear_param_cons(type_is_linear(a, env) && mode_is_borrowing(param_mode(prm)),
                            param_name(prm), borrowed_param_names(rest, b, env))
      | _ -> Nil

fn linear_param_cons(keep: Bool, nm: String, tail: List String) -> List String =
  if keep then Cons(nm, tail) else tail

fn param_name(p: ast.Param) -> String =
  match p with
  | ast.Param name _ _ -> name

# --- entry points ---

# Check a function body for linear-use violations. `fn_type` is the function's
# fully-substituted type (its param types drive linearity of the parameters);
# `body` is the fully-substituted typed body; `env` carries the `@linear:` markers
# and the `@parammode:` masks.
export fn check_fn_linear(params: List ast.Param, fn_type: types.Type,
                          body: typed_ast.TypedExpr, fn_pos: source.SourcePos,
                          env: Dict types.Scheme) -> LinCheck =
  match first_bad_modifier(params, fn_type, env) with
  | Just bad -> LinFail(fn_pos, bad_modifier_message(bad))
  | Nothing ->
      linear_result(owned_param_names(params, fn_type, env),
                    borrowed_param_names(params, fn_type, env), body, fn_pos, env)

# Check a body with no parameters (a top-level `let` declaration): there are no
# linear params to leak, but do-`let`/pattern/lambda binders inside are still
# enforced by the walk.
export fn check_body_linear(body: typed_ast.TypedExpr, env: Dict types.Scheme) -> LinCheck =
  match lin_consumed(body, LinScope (Nil, Nil), env) with
  | LinErr p m -> LinFail(p, m)
  | LinOk _ _ -> LinPass

fn linear_result(owned: List String, borrowed: List String, body: typed_ast.TypedExpr,
                 fn_pos: source.SourcePos, env: Dict types.Scheme) -> LinCheck =
  match lin_consumed(body, LinScope(owned, borrowed), env) with
  | LinErr p m -> LinFail(p, m)
  | LinOk consumed _ -> param_obligations(owned, borrowed, consumed, fn_pos)

# Two opposite obligations. An OWNED linear parameter must appear in the consumed
# set (else it leaked). A BORROWED one must NOT: consuming it spends a use that
# belongs to the caller. Returning a borrowed parameter lands here too — a bare
# reference in return position is a consume — so no separate escape rule is needed.
fn param_obligations(owned: List String, borrowed: List String,
                     consumed: List LinUse, fn_pos: source.SourcePos) -> LinCheck =
  match first_consumed_borrow(borrowed, consumed) with
  | Just u -> LinFail(luse_pos(u), consumed_borrow_msg(luse_name(u)))
  | Nothing -> unused_linear_param(owned, consumed, fn_pos)

fn first_consumed_borrow(borrowed: List String, consumed: List LinUse) -> Maybe LinUse =
  match consumed with
  | Nil -> Nothing
  | Cons u rest -> if str_member(luse_name(u), borrowed) then Just(u) else first_consumed_borrow(borrowed, rest)

fn unused_linear_param(owned: List String, consumed: List LinUse,
                       fn_pos: source.SourcePos) -> LinCheck =
  match owned with
  | Nil -> LinPass
  | Cons nm rest ->
      if luse_member(nm, consumed) then unused_linear_param(rest, consumed, fn_pos)
      else LinFail(fn_pos, leak_msg(nm))
