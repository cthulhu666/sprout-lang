module stdlib.compiler.lowering
import stdlib.compiler.ast as ast
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.source as source
import stdlib.compiler.types as types

# ---------------------------------------------------------------------------
# Public API
# ---------------------------------------------------------------------------

export type LowerResult (..) =
  | LowerOk typed_ast.TypedProgram
  | LowerErr String

# lower_program: transform a TypedProgram (with TDict evidence nodes) into a
# typed TypedProgram using the dictionary-passing lowering:
#
#   1. ClassDecl → generate class-method dispatch wrappers (dropped from output).
#   2. InstanceDecl → generate __tc_{Class}_{mangled}_{method} TFnDecls.
#   3. FnDecl with constraints → add hidden params + rewrite body.
#   4. TDict evidence nodes in TCall args → expand to concrete instance fn refs
#      or forwarded hidden params.
#
# Types are preserved through lowering: lower_expr returns TypedExpr, and
# generated declarations carry types derived from the scheme environment.
# This is the Sprout-native equivalent of Python's lower_typeclasses pass.
export fn lower_program(prog: typed_ast.TypedProgram, env: Dict types.Scheme) -> LowerResult =
  match prog with
  | typed_ast.TypedProgram decls -> lower_program_decls(decls, env)

fn lower_program_decls(decls: List typed_ast.TypedDecl, scheme_env: Dict types.Scheme) -> LowerResult =
  match lower_decls(decls,
                    LowerEnv(collect_class_order(decls, dict_empty()),
                             collect_instance_table(decls, dict_empty()),
                             collect_super_map(decls, dict_empty()),
                             collect_inst_meta(decls, dict_empty()),
                             scheme_env),
                    Nil, Nil, Nil) with
  | (user_rev, wrapper_rev, inst_rev) ->
      LowerOk(typed_ast.TypedProgram(
        list_append(
          list_append(list_reverse(user_rev), list_reverse(wrapper_rev)),
          list_reverse(inst_rev))))

# ---------------------------------------------------------------------------
# Internal types
# ---------------------------------------------------------------------------

# LowerEnv: global information collected from the typed program.
#   class_order  – class_name → [method_names in declaration order]
#   inst_table   – constraint_key → { method_name → instance_fn_name }
#   super_map    – class_name → [direct superclass names in declaration order]
#   inst_meta    – constraint_key → (instance_type_args, instance_constraints, method_arities)
#                  Populated only for constrained instances (e.g. instance Eq (Maybe a) where Eq a).
#                  Used to build lambda wrappers that capture inner dicts at call sites.
#   scheme_env   – the full type scheme environment from the typechecker; used to
#                  assign types to generated nodes so types survive lowering.
type LowerEnv =
  | LowerEnv (Dict (List String)) (Dict (Dict String)) (Dict (List String)) (Dict (List ast.TypeExpr, List ast.TypeConstraint, Dict Int)) (Dict types.Scheme)

# LowerCtx: per-function context passed during expression lowering.
#   class_order  – inherited from LowerEnv
#   fwd_methods  – constraint_key → { method_name → hidden_param_name }  (forwarded)
#   inst_table   – constraint_key → { method_name → instance_fn_name }   (concrete)
#   super_map    – class_name → [direct superclass names]
#   inst_meta    – same as LowerEnv.inst_meta, threaded through for resolve_tdict
#   scheme_env   – inherited from LowerEnv; used in resolve_tdict to type generated VarExprs
#   bound_vars   – locally bound names (fn params, lambda params) that must NOT be eta-expanded
type LowerCtx =
  | LowerCtx (Dict (List String)) (Dict (Dict String)) (Dict (Dict String)) (Dict (List String)) (Dict (List ast.TypeExpr, List ast.TypeConstraint, Dict Int)) (Dict types.Scheme) (List String)

fn env_class_order(env: LowerEnv) -> Dict (List String) =
  match env with | LowerEnv co _ _ _ _ -> co

fn env_inst_table(env: LowerEnv) -> Dict (Dict String) =
  match env with | LowerEnv _ it _ _ _ -> it

fn env_super_map(env: LowerEnv) -> Dict (List String) =
  match env with | LowerEnv _ _ sm _ _ -> sm

fn env_inst_meta(env: LowerEnv) -> Dict (List ast.TypeExpr, List ast.TypeConstraint, Dict Int) =
  match env with | LowerEnv _ _ _ im _ -> im

fn env_scheme_env(env: LowerEnv) -> Dict types.Scheme =
  match env with | LowerEnv _ _ _ _ se -> se

fn ctx_class_order(ctx: LowerCtx) -> Dict (List String) =
  match ctx with | LowerCtx co _ _ _ _ _ _ -> co

fn ctx_fwd(ctx: LowerCtx) -> Dict (Dict String) =
  match ctx with | LowerCtx _ fwd _ _ _ _ _ -> fwd

fn ctx_inst(ctx: LowerCtx) -> Dict (Dict String) =
  match ctx with | LowerCtx _ _ inst _ _ _ _ -> inst

fn ctx_super_map(ctx: LowerCtx) -> Dict (List String) =
  match ctx with | LowerCtx _ _ _ sm _ _ _ -> sm

fn ctx_inst_meta(ctx: LowerCtx) -> Dict (List ast.TypeExpr, List ast.TypeConstraint, Dict Int) =
  match ctx with | LowerCtx _ _ _ _ im _ _ -> im

fn ctx_scheme_env(ctx: LowerCtx) -> Dict types.Scheme =
  match ctx with | LowerCtx _ _ _ _ _ se _ -> se

fn ctx_bound_vars(ctx: LowerCtx) -> List String =
  match ctx with | LowerCtx _ _ _ _ _ _ bv -> bv

fn ctx_with_bound(vars: List String, ctx: LowerCtx) -> LowerCtx =
  LowerCtx(ctx_class_order(ctx), ctx_fwd(ctx), ctx_inst(ctx), ctx_super_map(ctx), ctx_inst_meta(ctx), ctx_scheme_env(ctx), list_append(ctx_bound_vars(ctx), vars))

fn dummy_pos() -> source.SourcePos = source.SourcePos(0, 0, 0)

fn param_names_from_list(ps: List ast.Param) -> List String =
  match ps with
  | Nil -> Nil
  | Cons (ast.Param name _) rest -> Cons(name, param_names_from_list(rest))

# ---------------------------------------------------------------------------
# Type helpers for generated nodes
# ---------------------------------------------------------------------------
#
# lookup_scheme_type: get the body type of a named scheme from the env, or a
# sentinel TVar if the name is not found (generated names not yet in env).
fn lookup_scheme_type(name: String, env: Dict types.Scheme) -> types.Type =
  match dict_get(name, env) with
  | Nothing -> types.TVar("?gen")
  | Just s -> types.scheme_type(s)

# tfunc_result_type: strip all leading TFunc layers to find the result type.
# e.g. TFunc a (TFunc a Bool) -> Bool
fn tfunc_result_type(t: types.Type) -> types.Type =
  match t with
  | types.TFunc _ ret _ -> tfunc_result_type(ret)
  | _ -> t

# generate_typed_param_vars: build TVar nodes for each user param, assigning
# types by peeling the curried method type one layer per parameter.
fn generate_typed_param_vars(params: List ast.Param, method_type: types.Type, pos: source.SourcePos) -> List typed_ast.TypedExpr =
  match params with
  | Nil -> Nil
  | Cons (ast.Param pname _) rest ->
      match method_type with
      | types.TFunc arg_t ret_t _ ->
          Cons(typed_ast.TVar(pname, arg_t, pos),
               generate_typed_param_vars(rest, ret_t, pos))
      | _ ->
          Cons(typed_ast.TVar(pname, method_type, pos),
               generate_typed_param_vars(rest, method_type, pos))

# ---------------------------------------------------------------------------
# Pass 1 – collect class_order
# ---------------------------------------------------------------------------

fn collect_class_order(decls: List typed_ast.TypedDecl, acc: Dict (List String)) -> Dict (List String) =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | typed_ast.TPassThrough inner_decl ->
          match inner_decl with
          | ast.ClassDecl class_name _ methods _ _ ->
              collect_class_order(rest, dict_set(class_name, extract_method_names(methods), acc))
          | _ -> collect_class_order(rest, acc)
      | _ -> collect_class_order(rest, acc)

fn extract_method_names(methods: List ast.ClassMethodSig) -> List String =
  extract_method_names_acc(methods, Nil)

fn extract_method_names_acc(methods: List ast.ClassMethodSig, acc: List String) -> List String =
  match methods with
  | Nil -> list_reverse(acc)
  | Cons sig rest ->
      match sig with
      | ast.ClassMethodSig name _ _ _ ->
          extract_method_names_acc(rest, Cons(name, acc))

# ---------------------------------------------------------------------------
# Pass 1 – collect superclass map
# ---------------------------------------------------------------------------
#
# class_name → list of direct superclass class names (in declaration order).
# Used to expand transitive superclass dictionaries when lowering constraints.

fn collect_super_map(decls: List typed_ast.TypedDecl, acc: Dict (List String)) -> Dict (List String) =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | typed_ast.TPassThrough inner_decl ->
          match inner_decl with
          | ast.ClassDecl class_name _ _ supers _ ->
              collect_super_map(rest, dict_set(class_name, extract_super_names(supers, Nil), acc))
          | _ -> collect_super_map(rest, acc)
      | _ -> collect_super_map(rest, acc)

fn extract_super_names(supers: List ast.TypeConstraint, acc: List String) -> List String =
  match supers with
  | Nil -> list_reverse(acc)
  | Cons c rest ->
      match c with
      | ast.TypeConstraint super_name _ ->
          extract_super_names(rest, Cons(super_name, acc))

# Returns the class itself followed by all transitive superclasses in DFS order,
# deduplicated.  Used to compute the ordered list of class names whose method
# slots a constraint instance dictionary must populate.
fn class_with_transitive_supers(class_name: String, super_map: Dict (List String)) -> List String =
  list_reverse(collect_supers_dfs(Cons(class_name, Nil), super_map, Nil))

fn collect_supers_dfs(stack: List String, super_map: Dict (List String), visited: List String) -> List String =
  match stack with
  | Nil -> visited
  | Cons name rest ->
      if list_str_member(name, visited)
      then collect_supers_dfs(rest, super_map, visited)
      else collect_supers_dfs(prepend_supers(name, super_map, rest), super_map, Cons(name, visited))

fn prepend_supers(name: String, super_map: Dict (List String), rest: List String) -> List String =
  match dict_get(name, super_map) with
  | Nothing -> rest
  | Just supers -> append_str_list(supers, rest)

fn append_str_list(xs: List String, ys: List String) -> List String =
  match xs with
  | Nil -> ys
  | Cons h t -> Cons(h, append_str_list(t, ys))

fn list_str_member(x: String, xs: List String) -> Bool =
  match xs with
  | Nil -> false
  | Cons h rest -> if h == x then true else list_str_member(x, rest)

# ---------------------------------------------------------------------------
# Pass 1 – collect instance_table
# ---------------------------------------------------------------------------
#
# For each TInstanceDecl, map constraint_key → { method_name → instance_fn_name }.
# The constraint_key uses the HEAD type of the first constraint arg (same as the
# @inst: markers in the typechecker) so it matches keys produced from TDict nodes.

fn collect_instance_table(decls: List typed_ast.TypedDecl, acc: Dict (Dict String)) -> Dict (Dict String) =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | typed_ast.TInstanceDecl constraint _ methods ->
          collect_instance_table(rest,
            dict_set(constraint_key_from_tc(constraint),
                     build_inst_method_map(constraint, methods, dict_empty()),
                     acc))
      | _ -> collect_instance_table(rest, acc)

fn build_inst_method_map(
  constraint: ast.TypeConstraint,
  methods: List typed_ast.TypedInstanceMethod,
  acc: Dict String
) -> Dict String =
  match methods with
  | Nil -> acc
  | Cons m rest ->
      match m with
      | typed_ast.TypedInstanceMethod method_name _ _ _ _ ->
          build_inst_method_map(constraint, rest,
            dict_set(method_name, instance_fn_name(constraint, method_name), acc))

# ---------------------------------------------------------------------------
# Pass 1b – collect inst_meta (instance constraints + method arities)
# ---------------------------------------------------------------------------
#
# For each constrained TInstanceDecl (e.g. instance Eq (Maybe a) where Eq a),
# map constraint_key → (instance_type_args, instance_constraints, method_arities).
# This is used by resolve_tdict_with_key to build lambda wrappers that capture
# inner dicts at call sites where the type parameter is concrete (e.g. Maybe Int).

fn collect_inst_meta(
  decls: List typed_ast.TypedDecl,
  acc: Dict (List ast.TypeExpr, List ast.TypeConstraint, Dict Int)
) -> Dict (List ast.TypeExpr, List ast.TypeConstraint, Dict Int) =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | typed_ast.TInstanceDecl constraint inst_constraints methods ->
          match inst_constraints with
          | Nil -> collect_inst_meta(rest, acc)
          | _ ->
              match constraint with
              | ast.TypeConstraint _ type_args ->
                  collect_inst_meta(rest,
                    dict_set(constraint_key_from_tc(constraint),
                             (type_args, inst_constraints, collect_method_arities(methods, dict_empty())),
                             acc))
      | _ -> collect_inst_meta(rest, acc)

fn collect_method_arities(
  methods: List typed_ast.TypedInstanceMethod,
  acc: Dict Int
) -> Dict Int =
  match methods with
  | Nil -> acc
  | Cons m rest ->
      match m with
      | typed_ast.TypedInstanceMethod name params _ _ _ ->
          collect_method_arities(rest, dict_set(name, list_length(params), acc))

# ---------------------------------------------------------------------------
# Pass 2 – lower typed declarations
# ---------------------------------------------------------------------------

fn lower_decls(
  decls: List typed_ast.TypedDecl,
  env: LowerEnv,
  user_rev: List typed_ast.TypedDecl,
  wrapper_rev: List typed_ast.TypedDecl,
  inst_rev: List typed_ast.TypedDecl
) -> (List typed_ast.TypedDecl, List typed_ast.TypedDecl, List typed_ast.TypedDecl) =
  match decls with
  | Nil -> (user_rev, wrapper_rev, inst_rev)
  | Cons d rest ->
      match lower_one_decl(d, env, user_rev, wrapper_rev, inst_rev) with
      | (u2, w2, i2) -> lower_decls(rest, env, u2, w2, i2)

fn lower_one_decl(
  d: typed_ast.TypedDecl,
  env: LowerEnv,
  user_rev: List typed_ast.TypedDecl,
  wrapper_rev: List typed_ast.TypedDecl,
  inst_rev: List typed_ast.TypedDecl
) -> (List typed_ast.TypedDecl, List typed_ast.TypedDecl, List typed_ast.TypedDecl) =
  match d with
  | typed_ast.TPassThrough inner ->
      match inner with
      # Generate class method dispatch wrappers; drop ClassDecl from output.
      | ast.ClassDecl class_name _ methods _ _ ->
          (user_rev,
           prepend_decls(generate_class_wrappers(class_name, methods, env_class_order(env), env_super_map(env), env_scheme_env(env)), wrapper_rev),
           inst_rev)
      # Drop InstanceDecl — replaced by generated instance fns.
      | ast.InstanceDecl _ _ _ _ ->
          (user_rev, wrapper_rev, inst_rev)
      | _ ->
          (Cons(typed_ast.TPassThrough(inner), user_rev), wrapper_rev, inst_rev)
  | typed_ast.TFnDecl name params ret_ty effects constraints body ->
      (Cons(lower_fn_decl(name, params, ret_ty, effects, constraints, body, env), user_rev),
       wrapper_rev, inst_rev)
  | typed_ast.TLetDecl name body ->
      (Cons(typed_ast.TLetDecl(name,
                               lower_expr(body, LowerCtx(env_class_order(env), dict_empty(), env_inst_table(env), env_super_map(env), env_inst_meta(env), env_scheme_env(env), Nil))),
            user_rev),
       wrapper_rev, inst_rev)
  | typed_ast.TInstanceDecl constraint inst_constraints methods ->
      (user_rev, wrapper_rev,
       prepend_decls(generate_instance_fns(constraint, inst_constraints, methods, env), inst_rev))
  | typed_ast.TExternFnDecl name params ret_ty effects ->
      (Cons(typed_ast.TExternFnDecl(name, params, ret_ty, effects), user_rev), wrapper_rev, inst_rev)

fn prepend_decls(new_decls: List typed_ast.TypedDecl, acc: List typed_ast.TypedDecl) -> List typed_ast.TypedDecl =
  match new_decls with
  | Nil -> acc
  | Cons d rest -> prepend_decls(rest, Cons(d, acc))

# ---------------------------------------------------------------------------
# Class method wrapper generation
# ---------------------------------------------------------------------------
#
# For each class method sig, generate a top-level dispatch function:
#   fn {method}({params..., __tc_{Class}_0_{m1}, ..., __tc_{Class}_0_{mN}}) =
#     __tc_{Class}_0_{method}({param_names...})
#
# The hidden params are added for ALL methods of the class (at index 0),
# but only the own-method hidden param is called in the body.

fn generate_class_wrappers(
  class_name: String,
  methods: List ast.ClassMethodSig,
  class_order: Dict (List String),
  super_map: Dict (List String),
  scheme_env: Dict types.Scheme
) -> List typed_ast.TypedDecl =
  generate_class_wrappers_acc(class_name, methods, hidden_params_for_classes(
                                                     class_with_transitive_supers(class_name, super_map),
                                                     0, class_order, Nil), scheme_env, Nil)

fn generate_class_wrappers_acc(
  class_name: String,
  methods: List ast.ClassMethodSig,
  hidden_params: List ast.Param,
  scheme_env: Dict types.Scheme,
  acc: List typed_ast.TypedDecl
) -> List typed_ast.TypedDecl =
  match methods with
  | Nil -> list_reverse(acc)
  | Cons sig rest ->
      generate_class_wrappers_acc(class_name, rest, hidden_params, scheme_env,
        Cons(generate_one_class_wrapper(class_name, sig, hidden_params, scheme_env), acc))

# Build a list of hidden params __tc_<C>_<idx>_<method> for the ordered list of
# class names (typically [Class, super1, super2, ...]) at the given index.
fn hidden_params_for_classes(
  classes: List String,
  idx: Int,
  class_order: Dict (List String),
  acc: List ast.Param
) -> List ast.Param =
  match classes with
  | Nil -> list_reverse(acc)
  | Cons c rest ->
      hidden_params_for_classes(rest, idx, class_order,
        prepend_class_hidden_params(c, idx, class_methods_for(c, class_order), acc))

fn prepend_class_hidden_params(
  class_name: String,
  idx: Int,
  methods: List String,
  acc: List ast.Param
) -> List ast.Param =
  match methods with
  | Nil -> acc
  | Cons m rest ->
      prepend_class_hidden_params(class_name, idx, rest,
        Cons(ast.Param(tc_slot_name(class_name, idx, m), Nothing), acc))

fn generate_one_class_wrapper(
  class_name: String,
  sig: ast.ClassMethodSig,
  hidden_params: List ast.Param,
  scheme_env: Dict types.Scheme
) -> typed_ast.TypedDecl =
  match sig with
  | ast.ClassMethodSig method_name params ret_ty effects_maybe ->
      typed_ast.TFnDecl(
        method_name,
        list_append(params, hidden_params),
        Just(ret_ty),
        effects_maybe,
        [],
        typed_ast.TCall(
          # NOTE: slot_name is a hidden param (concrete instance fn pointer), but
          # lookup_scheme_type returns the polymorphic class method scheme body (e.g.
          # ∀a. a→a→Bool for "eq").  The types are imprecise — codegen resolves the
          # slot from locals by name and never dispatches on the type field here.
          typed_ast.TVar(
            tc_slot_name(class_name, 0, method_name),
            lookup_scheme_type(method_name, scheme_env),
            dummy_pos()),
          generate_typed_param_vars(
            params,
            lookup_scheme_type(method_name, scheme_env),
            dummy_pos()),
          tfunc_result_type(lookup_scheme_type(method_name, scheme_env)),
          dummy_pos()))

# ---------------------------------------------------------------------------
# Instance function generation
# ---------------------------------------------------------------------------
#
# For each instance method, generate __tc_{Class}_{mangled_args}_{method}.
# If the instance has its own constraints (e.g. instance X where Eq a),
# add hidden params for those constraints too.

fn generate_instance_fns(
  constraint: ast.TypeConstraint,
  inst_constraints: List ast.TypeConstraint,
  methods: List typed_ast.TypedInstanceMethod,
  env: LowerEnv
) -> List typed_ast.TypedDecl =
  generate_instance_fns_acc(constraint, inst_constraints, methods, env, Nil)

fn generate_instance_fns_acc(
  constraint: ast.TypeConstraint,
  inst_constraints: List ast.TypeConstraint,
  methods: List typed_ast.TypedInstanceMethod,
  env: LowerEnv,
  acc: List typed_ast.TypedDecl
) -> List typed_ast.TypedDecl =
  match methods with
  | Nil -> list_reverse(acc)
  | Cons m rest ->
      generate_instance_fns_acc(constraint, inst_constraints, rest, env,
        Cons(generate_one_instance_fn(constraint, inst_constraints, m, env), acc))

fn generate_one_instance_fn(
  constraint: ast.TypeConstraint,
  inst_constraints: List ast.TypeConstraint,
  method: typed_ast.TypedInstanceMethod,
  env: LowerEnv
) -> typed_ast.TypedDecl =
  match method with
  | typed_ast.TypedInstanceMethod method_name params ret_maybe effects_maybe body ->
      match build_hidden_for_constraints(inst_constraints, env_class_order(env), env_super_map(env)) with
      | (hidden_params, fwd_map) ->
          typed_ast.TFnDecl(
            instance_fn_name(constraint, method_name),
            list_append(params, hidden_params),
            ret_maybe,
            effects_maybe,
            [],
            lower_expr(body, LowerCtx(env_class_order(env), fwd_map, env_inst_table(env), env_super_map(env), env_inst_meta(env), env_scheme_env(env), param_names_from_list(list_append(params, hidden_params)))))

# ---------------------------------------------------------------------------
# FnDecl lowering
# ---------------------------------------------------------------------------

fn lower_fn_decl(
  name: String,
  params: List ast.Param,
  ret_ty: Maybe ast.TypeExpr,
  effects: Maybe (List String),
  constraints: List ast.TypeConstraint,
  body: typed_ast.TypedExpr,
  env: LowerEnv
) -> typed_ast.TypedDecl =
  match build_hidden_for_constraints(constraints, env_class_order(env), env_super_map(env)) with
  | (hidden_params, fwd_map) ->
      typed_ast.TFnDecl(
        name,
        list_append(params, hidden_params),
        ret_ty,
        effects,
        [],
        lower_expr(body, LowerCtx(env_class_order(env), fwd_map, env_inst_table(env), env_super_map(env), env_inst_meta(env), env_scheme_env(env), param_names_from_list(list_append(params, hidden_params)))))

# ---------------------------------------------------------------------------
# Build hidden params for a list of constraints
# ---------------------------------------------------------------------------
#
# Returns:
#   (List Param) - the hidden params to append to the function params
#   (Dict (Dict String)) - fwd_map: constraint_key → { method → hidden_param_name }

fn build_hidden_for_constraints(
  constraints: List ast.TypeConstraint,
  class_order: Dict (List String),
  super_map: Dict (List String)
) -> (List ast.Param, Dict (Dict String)) =
  build_hidden_acc(constraints, class_order, super_map, 0, Nil, dict_empty())

fn build_hidden_acc(
  constraints: List ast.TypeConstraint,
  class_order: Dict (List String),
  super_map: Dict (List String),
  idx: Int,
  param_rev: List ast.Param,
  map_acc: Dict (Dict String)
) -> (List ast.Param, Dict (Dict String)) =
  match constraints with
  | Nil -> (list_reverse(param_rev), map_acc)
  | Cons c rest ->
      match c with
      | ast.TypeConstraint class_name type_args ->
          match build_hidden_for_constraint_with_supers(
                  class_name, type_args, idx,
                  class_with_transitive_supers(class_name, super_map),
                  class_order, param_rev, map_acc) with
          | (param_rev2, map_acc2) ->
              build_hidden_acc(rest, class_order, super_map, idx + 1, param_rev2, map_acc2)

# For one direct constraint (Class, T) at idx, iterate over the ordered list
# [Class, super1, super2, ...] (transitive) and for each effective class build
# hidden params __tc_<EffClass>_<idx>_<method> and seed the fwd_map entry under
# key <EffClass>_<T_head>.  This guarantees that downstream calls needing a
# super-class dictionary find a forwarded slot under the correct key.
fn build_hidden_for_constraint_with_supers(
  direct_class: String,
  type_args: List ast.TypeExpr,
  idx: Int,
  classes: List String,
  class_order: Dict (List String),
  param_rev: List ast.Param,
  map_acc: Dict (Dict String)
) -> (List ast.Param, Dict (Dict String)) =
  match classes with
  | Nil -> (param_rev, map_acc)
  | Cons eff_class rest ->
      match build_hidden_for_one(eff_class, idx, class_methods_for(eff_class, class_order)) with
      | (new_params, method_map) ->
          build_hidden_for_constraint_with_supers(direct_class, type_args, idx, rest, class_order,
            prepend_params(new_params, param_rev),
            dict_set(constraint_key_str(strip_module_prefix(eff_class), type_args), method_map, map_acc))

fn build_hidden_for_one(
  class_name: String,
  idx: Int,
  methods: List String
) -> (List ast.Param, Dict String) =
  build_hidden_one_acc(class_name, idx, methods, Nil, dict_empty())

fn build_hidden_one_acc(
  class_name: String,
  idx: Int,
  methods: List String,
  param_rev: List ast.Param,
  map_acc: Dict String
) -> (List ast.Param, Dict String) =
  match methods with
  | Nil -> (list_reverse(param_rev), map_acc)
  | Cons method_name rest ->
      match tc_slot_name(class_name, idx, method_name) with
      | slot ->
          build_hidden_one_acc(class_name, idx, rest,
            Cons(ast.Param(slot, Nothing), param_rev),
            dict_set(method_name, slot, map_acc))

fn prepend_params(new_params: List ast.Param, acc: List ast.Param) -> List ast.Param =
  match new_params with
  | Nil -> acc
  | Cons p rest -> prepend_params(rest, Cons(p, acc))

fn tc_slot_name(class_name: String, idx: Int, method_name: String) -> String =
  string_concat_many(["__tc_", class_name, "_", int_to_string(idx), "_", method_name])

fn class_methods_for(class_name: String, class_order: Dict (List String)) -> List String =
  match dict_get(class_name, class_order) with
  | Nothing -> Nil
  | Just ms -> ms

# ---------------------------------------------------------------------------
# Constraint key helpers
# ---------------------------------------------------------------------------
#
# The constraint key is: class_name + "_" + head_of_each_type_arg
# using the OUTERMOST constructor name only (no type parameters).
# This matches the @inst: marker keys used in the typechecker.

fn constraint_key_from_tc(c: ast.TypeConstraint) -> String =
  match c with
  | ast.TypeConstraint class_name type_args ->
      constraint_key_str(strip_module_prefix(class_name), type_args)

fn constraint_key_str(class_name: String, type_args: List ast.TypeExpr) -> String =
  match type_args with
  | Nil -> class_name
  | Cons h rest ->
      class_name ++ "_" ++ type_expr_head_name(h) ++ constraint_key_args_rest(rest)

fn constraint_key_args_rest(args: List ast.TypeExpr) -> String =
  match args with
  | Nil -> ""
  | Cons h rest -> "_" ++ type_expr_head_name(h) ++ constraint_key_args_rest(rest)

# Returns the outermost constructor/variable name from a type expression.
fn type_expr_head_name(te: ast.TypeExpr) -> String =
  match te with
  | ast.TypeName name -> strip_module_prefix(name)
  | ast.TypeApply base _ -> type_expr_head_name(base)
  | ast.TypeArrow _ _ _ -> "Fn"
  | ast.TypeEffect _ _ -> "Eff"
  | ast.TupleType _ -> "Tuple"

# ---------------------------------------------------------------------------
# Instance function name
# ---------------------------------------------------------------------------
#
# __tc_{ClassName}_{mangled_args}_{method_name}
# where mangled_args uses full type mangle (TypeApply(List, a) → "List_a").

fn instance_fn_name(c: ast.TypeConstraint, method_name: String) -> String =
  match c with
  | ast.TypeConstraint class_name type_args ->
      "__tc_" ++ class_name ++ "_" ++ mangle_type_args(type_args) ++ "_" ++ method_name

fn mangle_type_args(args: List ast.TypeExpr) -> String =
  string_concat_many(list_reverse(mangle_type_args_rev(args, Nil)))

fn mangle_type_args_rev(args: List ast.TypeExpr, acc: List String) -> List String =
  match args with
  | Nil -> acc
  | Cons h Nil -> Cons(mangle_type_expr(h), acc)
  | Cons h rest -> mangle_type_args_rev(rest, Cons("_", Cons(mangle_type_expr(h), acc)))

fn mangle_type_expr(te: ast.TypeExpr) -> String =
  match te with
  | ast.TypeName name -> strip_module_prefix(name)
  | ast.TypeApply base arg ->
      mangle_type_expr(base) ++ "_" ++ mangle_type_expr(arg)
  | ast.TypeArrow l r effects_maybe ->
      "Fn_" ++ mangle_type_expr(l) ++ "_" ++ mangle_type_expr(r) ++ mangle_effects_suffix(effects_maybe)
  | ast.TypeEffect base _ -> mangle_type_expr(base) ++ "_eff"
  | ast.TupleType items -> "Tuple_" ++ mangle_type_args(items)

fn mangle_effects_suffix(effects_maybe: Maybe (List String)) -> String =
  match effects_maybe with
  | Nothing -> ""
  | Just effs -> "_eff_" ++ join_strings(effs, "_")

fn join_strings(ss: List String, sep: String) -> String =
  string_concat_many(list_reverse(join_strings_rev(ss, sep, Nil)))

fn join_strings_rev(ss: List String, sep: String, acc: List String) -> List String =
  match ss with
  | Nil -> acc
  | Cons s Nil -> Cons(s, acc)
  | Cons s rest -> join_strings_rev(rest, sep, Cons(sep, Cons(s, acc)))

# ---------------------------------------------------------------------------
# Module prefix stripping
# ---------------------------------------------------------------------------

fn strip_module_prefix(name: String) -> String =
  if dot_pos < 0
  then name
  else strip_module_prefix(str_slice(name, dot_pos + 1, str_len(name)))
  where dot_pos = str_find(name, ".")

# ---------------------------------------------------------------------------
# Eta-expansion of class methods in value position
# ---------------------------------------------------------------------------
#
# When a class method (e.g. `to_string`) is used as a value — passed to a
# higher-order function like `fmap` — the generic closure wrapping it includes
# dict slots as extra arguments.  Callers that don't know the dict arity crash
# (SIGBUS on AArch64).  Fix: rewrite the TVar to a TLambda that calls the
# resolved concrete or forwarded implementation directly, bypassing the generic
# wrapper and its hidden dict parameter.
#
# lower_expr_callee (used for TCall callees) skips eta-expansion so that
# infer-injected TDict nodes in direct calls expand correctly.

fn find_class_of_method(method_name: String, class_order: Dict (List String)) -> Maybe String =
  find_class_in_co_entries(method_name, vec_to_list(dict_entries(class_order)))

fn find_class_in_co_entries(method_name: String, entries: List (String, List String)) -> Maybe String =
  match entries with
  | Nil -> Nothing
  | Cons (class_name, methods) rest ->
      if list_str_member(method_name, methods) then Just(class_name)
      else find_class_in_co_entries(method_name, rest)

fn first_concrete_head_str(t: types.Type) -> Maybe String =
  match t with
  | types.TConst name -> Just(strip_module_prefix(name))
  | types.TApp base _ -> first_concrete_head_str(base)
  | _ -> Nothing

fn find_concrete_method_impl(class_name: String, method_name: String, head: String, ctx: LowerCtx) -> Maybe String =
  # strip_module_prefix: class_order stores bundler-qualified names (e.g. "prelude.ToString")
  # but inst_table keys are always stripped (built via constraint_key_from_tc which calls
  # strip_module_prefix).  Strip here so both sides of the lookup use the same key form.
  match dict_get(strip_module_prefix(class_name) ++ "_" ++ head, ctx_inst(ctx)) with
  | Nothing -> Nothing
  | Just method_map -> dict_get(method_name, method_map)

fn find_fwd_method_impl(class_name: String, method_name: String, ctx: LowerCtx) -> Maybe String =
  find_fwd_in_co_entries(class_name, method_name, vec_to_list(dict_entries(ctx_fwd(ctx))))

fn find_fwd_in_co_entries(class_name: String, method_name: String, entries: List (String, Dict String)) -> Maybe String =
  match entries with
  | Nil -> Nothing
  | Cons (key, method_map) rest ->
      # fwd_map keys are always stripped; strip class_name here to match.
      if str_starts_with(key, strip_module_prefix(class_name) ++ "_") then
        match dict_get(method_name, method_map) with
        | Just impl_name -> Just(impl_name)
        | Nothing -> find_fwd_in_co_entries(class_name, method_name, rest)
      else
        find_fwd_in_co_entries(class_name, method_name, rest)

fn eta_param_name(i: Int) -> String =
  "__eta_x" ++ int_to_string(i)

fn count_method_params(t: types.Type) -> Int =
  match t with
  | types.TFunc _ ret _ -> 1 + count_method_params(ret)
  | _ -> 0

fn make_eta_params_list(n: Int, i: Int) -> List ast.Param =
  if i >= n then Nil
  else Cons(ast.Param(eta_param_name(i), Nothing), make_eta_params_list(n, i + 1))

fn make_eta_arg_tvars(t: types.Type, i: Int, n: Int, pos: source.SourcePos) -> List typed_ast.TypedExpr =
  if i >= n then Nil
  else
    match t with
    | types.TFunc param ret _ ->
        Cons(typed_ast.TVar(eta_param_name(i), param, pos),
             make_eta_arg_tvars(ret, i + 1, n, pos))
    | _ ->
        Cons(typed_ast.TVar(eta_param_name(i), t, pos),
             make_eta_arg_tvars(t, i + 1, n, pos))

fn make_eta_lambda(impl_name: String, method_type: types.Type, pos: source.SourcePos) -> typed_ast.TypedExpr =
  make_eta_lambda_n(impl_name, method_type, count_method_params(method_type), pos)

fn make_eta_lambda_n(impl_name: String, method_type: types.Type, n: Int, pos: source.SourcePos) -> typed_ast.TypedExpr =
  typed_ast.TLambda(
    make_eta_params_list(n, 0),
    typed_ast.TCall(
      typed_ast.TVar(impl_name, method_type, pos),
      make_eta_arg_tvars(method_type, 0, n, pos),
      tfunc_result_type(method_type), pos),
    method_type, pos)

fn tvar_head_name(t: types.Type) -> Maybe String =
  match t with
  | types.TVar name -> Just(name)
  | _ -> Nothing

fn make_eta_lambda_with_dicts(impl_name: String, method_type: types.Type, dict_args: List typed_ast.TypedExpr, pos: source.SourcePos) -> typed_ast.TypedExpr =
  make_eta_lambda_with_dicts_n(impl_name, method_type, count_method_params(method_type), dict_args, pos)

fn make_eta_lambda_with_dicts_n(impl_name: String, method_type: types.Type, n: Int, dict_args: List typed_ast.TypedExpr, pos: source.SourcePos) -> typed_ast.TypedExpr =
  typed_ast.TLambda(
    make_eta_params_list(n, 0),
    typed_ast.TCall(
      typed_ast.TVar(impl_name, method_type, pos),
      list_append(make_eta_arg_tvars(method_type, 0, n, pos), dict_args),
      tfunc_result_type(method_type), pos),
    method_type, pos)

fn collect_slots_from_method_map(methods: List String, method_map: Dict String, pos: source.SourcePos) -> List typed_ast.TypedExpr =
  match methods with
  | Nil -> Nil
  | Cons m rest ->
      match dict_get(m, method_map) with
      | Nothing -> collect_slots_from_method_map(rest, method_map, pos)
      | Just slot ->
          Cons(typed_ast.TVar(slot, types.TVar("?lambda"), pos),
               collect_slots_from_method_map(rest, method_map, pos))

fn type_to_eta_typeexpr(t: types.Type) -> ast.TypeExpr =
  match t with
  | types.TConst name -> ast.TypeName(strip_module_prefix(name))
  | types.TVar name -> ast.TypeName(name)
  | types.TApp base arg -> ast.TypeApply(type_to_eta_typeexpr(base), type_to_eta_typeexpr(arg))
  | types.TFunc param ret _ ->
      ast.TypeArrow(type_to_eta_typeexpr(param), type_to_eta_typeexpr(ret), Nothing)
  | types.TTuple items -> ast.TupleType(list_map(\item -> type_to_eta_typeexpr(item), items))

fn lookup_eta_inner_dicts_general(class_name: String, head: String, actual_param: types.Type, ctx: LowerCtx) -> Maybe (List typed_ast.TypedExpr) =
  match dict_get(class_name ++ "_" ++ head, ctx_inst_meta(ctx)) with
  | Nothing -> Nothing
  | Just (inst_type_args, inst_constraints, _) ->
      match inst_constraints with
      | Nil -> Nothing
      | _ ->
          match resolve_eta_substituted_inner_dicts(
            inst_constraints,
            unify_type_args_list(inst_type_args, Cons(type_to_eta_typeexpr(actual_param), Nil), dict_empty()),
            dummy_pos(),
            ctx) with
          | Nil -> Nothing
          | inner_dicts -> Just(inner_dicts)

fn resolve_eta_substituted_inner_dicts(inst_constraints: List ast.TypeConstraint, subs: Dict ast.TypeExpr, pos: source.SourcePos, ctx: LowerCtx) -> List typed_ast.TypedExpr =
  match inst_constraints with
  | Nil -> Nil
  | Cons c rest ->
      list_append(
        resolve_eta_substituted_inner_dict(substitute_constraint(c, subs), pos, ctx),
        resolve_eta_substituted_inner_dicts(rest, subs, pos, ctx))

fn resolve_eta_substituted_inner_dict(c: ast.TypeConstraint, pos: source.SourcePos, ctx: LowerCtx) -> List typed_ast.TypedExpr =
  match c with
  | ast.TypeConstraint class_name type_args ->
      match type_args with
      | Cons (ast.TypeName name) Nil ->
          match resolve_eta_fwd_type_name_dict(class_name, name, pos, ctx) with
          | Just dicts -> dicts
          | Nothing -> resolve_tdict(c, pos, ctx)
      | _ -> resolve_tdict(c, pos, ctx)

fn resolve_eta_fwd_type_name_dict(class_name: String, tvar_name: String, pos: source.SourcePos, ctx: LowerCtx) -> Maybe (List typed_ast.TypedExpr) =
  match dict_get("@eta_fwd:" ++ tvar_name ++ ":" ++ strip_module_prefix(class_name), ctx_scheme_env(ctx)) with
  | Nothing -> Nothing
  | Just prog_scheme ->
      match types.scheme_type(prog_scheme) with
      | types.TConst prog_var ->
          match dict_get(strip_module_prefix(class_name) ++ "_" ++ prog_var, ctx_fwd(ctx)) with
          | Nothing -> Nothing
          | Just method_map ->
              Just(collect_slots_from_method_map(
                class_methods_for(strip_module_prefix(class_name), ctx_class_order(ctx)),
                method_map, pos))
      | _ -> Nothing

fn try_eta_expand_class_method(name: String, t: types.Type, ctx: LowerCtx) -> Maybe typed_ast.TypedExpr =
  match find_class_of_method(name, ctx_class_order(ctx)) with
  | Nothing -> Nothing
  | Just class_name -> try_eta_in_class(class_name, name, t, ctx)

fn try_eta_in_class(class_name: String, name: String, t: types.Type, ctx: LowerCtx) -> Maybe typed_ast.TypedExpr =
  match t with
  | types.TFunc param _ _ ->
      match first_concrete_head_str(param) with
      | Just head ->
          match find_concrete_method_impl(class_name, name, head, ctx) with
          | Just impl_name ->
              match lookup_eta_inner_dicts_general(strip_module_prefix(class_name), head, param, ctx) with
              | Nothing -> Just(make_eta_lambda(impl_name, t, dummy_pos()))
              | Just inner_dicts -> Just(make_eta_lambda_with_dicts(impl_name, t, inner_dicts, dummy_pos()))
          | Nothing -> Nothing
      | Nothing ->
          # @eta_fwd markers (distinct from per-function @fwd:) are threaded into
          # scheme_env during typecheck_decl. Key: "@eta_fwd:{fresh_tvar}:{class_name}".
          # Maps fresh TVar names back to programmer constraint var names (e.g., "b"),
          # enabling exact slot selection when multiple same-class constraints exist.
          match tvar_head_name(param) with
          | Just tvar_name ->
              match dict_get("@eta_fwd:" ++ tvar_name ++ ":" ++ class_name, ctx_scheme_env(ctx)) with
              | Just fwd_scheme ->
                  match types.scheme_type(fwd_scheme) with
                  | types.TConst prog_var ->
                      match dict_get(strip_module_prefix(class_name) ++ "_" ++ prog_var, ctx_fwd(ctx)) with
                      | Just method_map ->
                          match dict_get(name, method_map) with
                          | Just impl_name -> Just(make_eta_lambda(impl_name, t, dummy_pos()))
                          | Nothing -> Nothing
                      | Nothing -> Nothing
                  | _ -> Nothing
              | Nothing -> Nothing
          | Nothing -> Nothing
  | _ -> Nothing

# lower_expr_callee: lower the callee of a TCall without eta-expanding TVar class methods.
# Direct class method calls already have TDict nodes injected by infer; rewriting the
# callee would corrupt those dict args.
fn lower_expr_callee(te: typed_ast.TypedExpr, ctx: LowerCtx) -> typed_ast.TypedExpr =
  match te with
  | typed_ast.TVar name t pos -> typed_ast.TVar(name, t, pos)
  | _ -> lower_expr(te, ctx)

# ---------------------------------------------------------------------------
# Expression lowering
# ---------------------------------------------------------------------------

fn lower_expr(te: typed_ast.TypedExpr, ctx: LowerCtx) -> typed_ast.TypedExpr =
  match te with
  | typed_ast.TVar name t pos ->
      if list_member(name, ctx_bound_vars(ctx)) then
        typed_ast.TVar(name, t, pos)
      else
        match try_eta_expand_class_method(name, t, ctx) with
        | Just expanded -> lower_expr(expanded, ctx)
        | Nothing -> typed_ast.TVar(name, t, pos)
  | typed_ast.TInt n t pos -> typed_ast.TInt(n, t, pos)
  | typed_ast.TBool b t pos -> typed_ast.TBool(b, t, pos)
  | typed_ast.TString s t pos -> typed_ast.TString(s, t, pos)
  | typed_ast.TChar c t pos -> typed_ast.TChar(c, t, pos)
  | typed_ast.TUnit t pos -> typed_ast.TUnit(t, pos)
  | typed_ast.TTuple items t pos ->
      typed_ast.TTuple(lower_expr_list(items, ctx), t, pos)
  | typed_ast.TIf cond then_ else_ t pos ->
      typed_ast.TIf(lower_expr(cond, ctx), lower_expr(then_, ctx), lower_expr(else_, ctx), t, pos)
  | typed_ast.TMatch scrut branches t pos ->
      typed_ast.TMatch(lower_expr(scrut, ctx), lower_branches(branches, ctx), t, pos)
  | typed_ast.TCall callee args t pos ->
      typed_ast.TCall(lower_expr_callee(callee, ctx), expand_call_args(args, ctx), t, pos)
  | typed_ast.TDict _ t pos ->
      # TDict should only appear as a prefix arg inside TCall — never standalone.
      # If seen standalone, emit as unit.  Note: `t` here is the constraint evidence
      # type (not TConst "Unit"), but this path is unreachable in valid programs so
      # the type mismatch on the TUnit node is harmless.
      typed_ast.TUnit(t, pos)
  | typed_ast.TLambda params body t pos ->
      typed_ast.TLambda(params, lower_expr(body, ctx_with_bound(param_names_from_list(params), ctx)), t, pos)
  | typed_ast.TBinary op l r t pos ->
      typed_ast.TBinary(op, lower_expr(l, ctx), lower_expr(r, ctx), t, pos)
  | typed_ast.TUnary op e t pos ->
      typed_ast.TUnary(op, lower_expr(e, ctx), t, pos)
  | typed_ast.TRange lo hi t pos ->
      typed_ast.TRange(lower_expr(lo, ctx), lower_expr(hi, ctx), t, pos)
  | typed_ast.TDo steps t pos ->
      typed_ast.TDo(lower_do_steps(steps, ctx), t, pos)
  | typed_ast.TRecord name fields t pos ->
      typed_ast.TRecord(name, lower_record_fields(fields, ctx), t, pos)
  | typed_ast.TGetField e fname t pos ->
      typed_ast.TGetField(lower_expr(e, ctx), fname, t, pos)

# expand_call_args: lower user args first (in order), then append expanded TDict
# witness args at the end.  This matches Python typeclass_lowering.py which also
# appends the extra dict args after the user-visible args.  TDict nodes in the
# TypedExpr arg list are evidence prepended by infer.sprout at call sites; they
# must land AFTER the user args to match the hidden params that lower_fn_decl
# appends to the parameter list.
fn expand_call_args(args: List typed_ast.TypedExpr, ctx: LowerCtx) -> List typed_ast.TypedExpr =
  list_append(expand_user_args(args, ctx), expand_dict_witness_args(args, ctx))

fn expand_user_args(args: List typed_ast.TypedExpr, ctx: LowerCtx) -> List typed_ast.TypedExpr =
  match args with
  | Nil -> Nil
  | Cons (typed_ast.TDict _ _ _) rest -> expand_user_args(rest, ctx)
  | Cons e rest -> Cons(lower_expr(e, ctx), expand_user_args(rest, ctx))

fn expand_dict_witness_args(args: List typed_ast.TypedExpr, ctx: LowerCtx) -> List typed_ast.TypedExpr =
  match args with
  | Nil -> Nil
  | Cons (typed_ast.TDict c _ pos) rest ->
      list_append(resolve_tdict(c, pos, ctx), expand_dict_witness_args(rest, ctx))
  | Cons _ rest -> expand_dict_witness_args(rest, ctx)

# resolve_tdict: expand one TDict witness into a list of TypedExprs, one per
# class method.  Resolution order:
#   1. Forwarded hidden param (fwd_methods in ctx — polymorphic call site)
#   2. Concrete instance fn  (inst_table in ctx — concrete call site)
#   3. Fallback: TVar with unresolved name (should not happen in well-typed programs)
fn resolve_tdict(
  c: ast.TypeConstraint,
  pos: source.SourcePos,
  ctx: LowerCtx
) -> List typed_ast.TypedExpr =
  match c with
  | ast.TypeConstraint class_name type_args ->
      resolve_tdict_for_classes(
        class_with_transitive_supers(class_name, ctx_super_map(ctx)),
        type_args, pos, ctx)

# Iterate over [Class, super1, super2, ...] (transitive) and concatenate the
# witness exprs each effective class needs. This must mirror the order in which
# build_hidden_for_constraints (and class wrappers) lay out hidden params, so
# the call site's witness list lines up with the callee's hidden param list.
fn resolve_tdict_for_classes(
  classes: List String,
  type_args: List ast.TypeExpr,
  pos: source.SourcePos,
  ctx: LowerCtx
) -> List typed_ast.TypedExpr =
  match classes with
  | Nil -> Nil
  | Cons eff_class rest ->
      list_append(
        resolve_tdict_with_key(
          constraint_key_str(strip_module_prefix(eff_class), type_args),
          eff_class, type_args, pos, ctx),
        resolve_tdict_for_classes(rest, type_args, pos, ctx))

fn resolve_tdict_with_key(
  key: String,
  class_name: String,
  type_args: List ast.TypeExpr,
  pos: source.SourcePos,
  ctx: LowerCtx
) -> List typed_ast.TypedExpr =
  match dict_get(key, ctx_fwd(ctx)) with
  | Just method_map ->
      list_map(\m -> resolve_method_var(m, method_map, key, pos, ctx_scheme_env(ctx)),
               class_methods_for(class_name, ctx_class_order(ctx)))
  | Nothing ->
      match dict_get(key, ctx_inst(ctx)) with
      | Just method_map ->
          resolve_tdict_for_inst(key, type_args, pos, ctx, method_map,
                                 class_methods_for(class_name, ctx_class_order(ctx)))
      | Nothing ->
          list_map(\_ -> typed_ast.TVar("__unresolved_" ++ key, types.TVar("?gen"), pos),
                   class_methods_for(class_name, ctx_class_order(ctx)))

# Resolve a concrete instance's dict, checking inst_meta for lambda-wrapping of
# constrained instances (e.g. instance Eq (Maybe a) where Eq a).
fn resolve_tdict_for_inst(
  key: String,
  type_args: List ast.TypeExpr,
  pos: source.SourcePos,
  ctx: LowerCtx,
  method_map: Dict String,
  methods: List String
) -> List typed_ast.TypedExpr =
  match dict_get(key, ctx_inst_meta(ctx)) with
  | Nothing ->
      list_map(\m -> resolve_method_var(m, method_map, key, pos, ctx_scheme_env(ctx)), methods)
  | Just (inst_type_args, inst_constraints, method_arities) ->
      resolve_tdict_apply_inner_dicts(key, pos, method_map, methods, method_arities,
        resolve_inner_constraint_dicts(
          inst_constraints,
          unify_type_args_list(inst_type_args, type_args, dict_empty()),
          pos, ctx),
        ctx_scheme_env(ctx))

# Apply resolved inner dicts to instance methods: bare refs if Nil, lambda-wrapped otherwise.
fn resolve_tdict_apply_inner_dicts(
  key: String,
  pos: source.SourcePos,
  method_map: Dict String,
  methods: List String,
  method_arities: Dict Int,
  inner_dicts: List typed_ast.TypedExpr,
  scheme_env: Dict types.Scheme
) -> List typed_ast.TypedExpr =
  match inner_dicts with
  | Nil -> list_map(\m -> resolve_method_var(m, method_map, key, pos, scheme_env), methods)
  | _ -> list_map(\m -> resolve_method_with_lambda(m, key, method_map, method_arities, inner_dicts, pos), methods)

fn resolve_method_with_lambda(
  method_name: String,
  key: String,
  method_map: Dict String,
  method_arities: Dict Int,
  inner_dicts: List typed_ast.TypedExpr,
  pos: source.SourcePos
) -> typed_ast.TypedExpr =
  match dict_get(method_name, method_map) with
  | Nothing -> typed_ast.TVar("__unresolved_" ++ key ++ "_" ++ method_name, types.TVar("?gen"), pos)
  | Just fn_name ->
      build_lambda_with_inner_dicts(fn_name, get_method_arity(method_name, method_arities), inner_dicts, pos)

fn get_method_arity(method_name: String, method_arities: Dict Int) -> Int =
  match dict_get(method_name, method_arities) with
  | Just n -> n
  | Nothing -> 0

fn resolve_method_var(
  method_name: String,
  method_map: Dict String,
  fallback_key: String,
  pos: source.SourcePos,
  scheme_env: Dict types.Scheme
) -> typed_ast.TypedExpr =
  match dict_get(method_name, method_map) with
  | Just fn_name -> typed_ast.TVar(fn_name, lookup_scheme_type(fn_name, scheme_env), pos)
  | Nothing -> typed_ast.TVar("__unresolved_" ++ fallback_key ++ "_" ++ method_name, types.TVar("?gen"), pos)

# ---------------------------------------------------------------------------
# Inner-dict helpers: type unification, substitution, lambda wrapping
# ---------------------------------------------------------------------------

# is_type_var_name: true if a TypeName refers to a type variable (lowercase first char).
# In Sprout, type variable names start with a lowercase letter; concrete types with uppercase.
fn is_type_var_name(name: String) -> Bool =
  match str_char_at(name, 0) with
  | Nothing -> false
  | Just c ->
      c == 'a' || c == 'b' || c == 'c' || c == 'd' || c == 'e' || c == 'f' ||
      c == 'g' || c == 'h' || c == 'i' || c == 'j' || c == 'k' || c == 'l' ||
      c == 'm' || c == 'n' || c == 'o' || c == 'p' || c == 'q' || c == 'r' ||
      c == 's' || c == 't' || c == 'u' || c == 'v' || c == 'w' || c == 'x' ||
      c == 'y' || c == 'z'

# unify_type_expr: match a type pattern (from instance decl) against a concrete type
# (from call site), accumulating type-variable bindings in acc.
fn unify_type_expr(
  pattern: ast.TypeExpr,
  concrete: ast.TypeExpr,
  acc: Dict ast.TypeExpr
) -> Dict ast.TypeExpr =
  match pattern with
  | ast.TypeName name ->
      if is_type_var_name(name) then dict_set(name, concrete, acc)
      else acc
  | ast.TypeApply pat_base pat_arg ->
      match concrete with
      | ast.TypeApply con_base con_arg ->
          unify_type_expr(pat_arg, con_arg,
            unify_type_expr(pat_base, con_base, acc))
      | _ -> acc
  | _ -> acc

# unify_type_args_list: unify each pair of (pattern, concrete) type args.
fn unify_type_args_list(
  patterns: List ast.TypeExpr,
  concretes: List ast.TypeExpr,
  acc: Dict ast.TypeExpr
) -> Dict ast.TypeExpr =
  match patterns with
  | Nil -> acc
  | Cons p rest_p ->
      match concretes with
      | Nil -> acc
      | Cons c rest_c ->
          unify_type_args_list(rest_p, rest_c, unify_type_expr(p, c, acc))

# substitute_type_expr: apply type-variable substitution to a TypeExpr.
fn substitute_type_expr(te: ast.TypeExpr, subs: Dict ast.TypeExpr) -> ast.TypeExpr =
  match te with
  | ast.TypeName name ->
      match dict_get(name, subs) with
      | Just concrete -> concrete
      | Nothing -> te
  | ast.TypeApply base arg ->
      ast.TypeApply(substitute_type_expr(base, subs), substitute_type_expr(arg, subs))
  | ast.TypeArrow from_ to_ effs ->
      ast.TypeArrow(substitute_type_expr(from_, subs), substitute_type_expr(to_, subs), effs)
  | _ -> te

# substitute_constraint: apply substitution to all type args of a TypeConstraint.
fn substitute_constraint(tc: ast.TypeConstraint, subs: Dict ast.TypeExpr) -> ast.TypeConstraint =
  match tc with
  | ast.TypeConstraint class_name type_args ->
      ast.TypeConstraint(class_name, list_map(\te -> substitute_type_expr(te, subs), type_args))

# resolve_inner_constraint_dicts: resolve each inner constraint (after substitution)
# into a list of typed dict expressions (one per class method).
fn resolve_inner_constraint_dicts(
  inst_constraints: List ast.TypeConstraint,
  subs: Dict ast.TypeExpr,
  pos: source.SourcePos,
  ctx: LowerCtx
) -> List typed_ast.TypedExpr =
  match inst_constraints with
  | Nil -> Nil
  | Cons c rest ->
      list_append(
        resolve_tdict(substitute_constraint(c, subs), pos, ctx),
        resolve_inner_constraint_dicts(rest, subs, pos, ctx))

# build_lambda_with_inner_dicts: build a lambda that pre-applies inner dict args.
# For an instance method fn_name with n_params explicit params and inner_dicts as
# the resolved inner dicts, produces:
#   \__lp_0 ... __lp_{n-1} -> fn_name(__lp_0, ..., __lp_{n-1}, inner_dict_0, ...)
# Lambda and inner call types use TVar "?lambda" — these are dict witnesses whose
# LLVM representation is always a closure pointer (i64) regardless of Sprout type.
# type_to_ll(TVar _) = "i64", so codegen emits correct i64 params/returns for these
# nodes even though no precise Sprout type is available at lowering time.
fn build_lambda_with_inner_dicts(
  fn_name: String,
  n_params: Int,
  inner_dicts: List typed_ast.TypedExpr,
  pos: source.SourcePos
) -> typed_ast.TypedExpr =
  build_lambda_helper(fn_name, make_lp_names(n_params, 0), inner_dicts, pos)

fn build_lambda_helper(
  fn_name: String,
  lp_names: List String,
  inner_dicts: List typed_ast.TypedExpr,
  pos: source.SourcePos
) -> typed_ast.TypedExpr =
  typed_ast.TLambda(
    list_map(\nm -> ast.Param(nm, Nothing), lp_names),
    typed_ast.TCall(
      typed_ast.TVar(fn_name, types.TVar("?lambda"), pos),
      list_append(list_map(\nm -> typed_ast.TVar(nm, types.TVar("?lambda"), pos), lp_names), inner_dicts),
      types.TVar("?lambda"),
      pos),
    types.TVar("?lambda"),
    pos)

fn make_lp_names(n: Int, i: Int) -> List String =
  if i >= n then Nil
  else Cons("__lp_" ++ int_to_string(i), make_lp_names(n, i + 1))

# ---------------------------------------------------------------------------
# Recursive lowering helpers
# ---------------------------------------------------------------------------

fn lower_expr_list(exprs: List typed_ast.TypedExpr, ctx: LowerCtx) -> List typed_ast.TypedExpr =
  match exprs with
  | Nil -> Nil
  | Cons e rest -> Cons(lower_expr(e, ctx), lower_expr_list(rest, ctx))

fn pat_bound_names(pat: ast.Pattern) -> List String =
  match pat with
  | ast.WildcardPattern _ -> Nil
  | ast.VarPattern name _ -> Cons(name, Nil)
  | ast.IntPattern _ _ -> Nil
  | ast.BoolPattern _ _ -> Nil
  | ast.StringPattern _ _ -> Nil
  | ast.CharPattern _ _ -> Nil
  | ast.UnitPattern _ -> Nil
  | ast.TuplePattern pats _ -> pat_list_bound_names(pats)
  | ast.ConstructorPattern _ pats _ -> pat_list_bound_names(pats)

fn pat_list_bound_names(pats: List ast.Pattern) -> List String =
  match pats with
  | Nil -> Nil
  | Cons p rest -> list_append(pat_bound_names(p), pat_list_bound_names(rest))

fn do_step_bound_names(step: typed_ast.TypedDoStep) -> List String =
  match step with
  | typed_ast.TDoBindStep pat _ -> pat_bound_names(pat)
  | typed_ast.TDoLetStep name _ -> Cons(name, Nil)
  | typed_ast.TDoExprStep _ -> Nil

fn lower_branches(branches: List typed_ast.TypedMatchBranch, ctx: LowerCtx) -> List typed_ast.TypedMatchBranch =
  match branches with
  | Nil -> Nil
  | Cons b rest ->
      match b with
      | typed_ast.TypedMatchBranch pat body ->
          Cons(typed_ast.TypedMatchBranch(pat, lower_expr(body, ctx_with_bound(pat_bound_names(pat), ctx))), lower_branches(rest, ctx))

fn lower_do_steps(steps: List typed_ast.TypedDoStep, ctx: LowerCtx) -> List typed_ast.TypedDoStep =
  match steps with
  | Nil -> Nil
  | Cons s rest -> Cons(lower_do_step(s, ctx), lower_do_steps(rest, ctx_with_bound(do_step_bound_names(s), ctx)))

fn lower_do_step(step: typed_ast.TypedDoStep, ctx: LowerCtx) -> typed_ast.TypedDoStep =
  match step with
  | typed_ast.TDoBindStep pat e -> typed_ast.TDoBindStep(pat, lower_expr(e, ctx))
  | typed_ast.TDoLetStep name e -> typed_ast.TDoLetStep(name, lower_expr(e, ctx))
  | typed_ast.TDoExprStep e -> typed_ast.TDoExprStep(lower_expr(e, ctx))

fn lower_record_fields(fields: List typed_ast.TypedRecordField, ctx: LowerCtx) -> List typed_ast.TypedRecordField =
  match fields with
  | Nil -> Nil
  | Cons f rest ->
      match f with
      | typed_ast.TypedRecordField fname e ->
          Cons(typed_ast.TypedRecordField(fname, lower_expr(e, ctx)), lower_record_fields(rest, ctx))
