module stdlib.compiler.verify_dispatch

import stdlib.compiler.ast as ast
import stdlib.compiler.source as source
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types
import stdlib.string as string

# ---------------------------------------------------------------------------
# Dictionary-passing verifier (Core-lint style) — retro item 1, phase 1
# ---------------------------------------------------------------------------
#
# A defence-in-depth cross-check on typeclass dictionary selection. Motivated by
# the vec_sort_by projection-sort crash (PR #176) and its siblings (#141,
# return-type dispatch): a constraint `Ord k` resolved to the WRONG instance
# (the element type instead of the projected key), a silent runtime SIGSEGV
# because dispatch is unenforced (docs/retro-dict-dispatch-soundness-2026-07-13.md).
#
# The check is deliberately INDEPENDENT of the resolver. Truth is re-derived from
# the callee's SOURCE-level signature (its written param types + `where`-clause,
# in source names) matched against the call's concrete argument types — never from
# the generalized env scheme / prog_to_fresh / Scheme constraint field the resolver
# uses. Two different computations cross-checked is the whole value of a Core-lint
# pass; it also means the check self-guards a canonicalize_constrained_constraints
# regression (its truth does not depend on canonicalize having run).
#
# A `where`-constraint exists IFF an explicit signature exists (you cannot write
# `where Ord k` without annotating), so "constraint present" yields the source
# info by construction. Everything the source signature cannot pin down —
# inferred constraints on un-annotated fns, indirect/higher-order callees,
# still-polymorphic call sites — is skip-and-log, never a false alarm.

# Outcome for one (constraint, injected-dict) pair at a call site.
export type VerifyOutcome (..) =
  | VerifyOk String  # class: verified concrete head matches derived truth
  | VerifyMismatch source.SourcePos String  # a concrete dict head disagrees with the derived truth
  | VerifySkip String  # cannot verify (polymorphic / underdetermined) — reason

# How to treat a constraint for which NO dict was injected at all.
#
# The two callee kinds differ in whether anything downstream could still supply
# one. A constrained `fn` forwards its obligation through a hidden dict param, so
# an absent dict at an underdetermined call site is routine — the resolver defers
# it to whoever supplies the param. A CLASS METHOD has no `where` clause to
# forward through and no later pass to fill it in: by the time this walk runs,
# infer's `resolve_dispatch_typed_expr` and `resolve.resolve_program` have both
# already had their chance. For a method, absent is final.
export type MissingPolicy (..) =
  | MissingDeferred  # constrained fn: an absent dict may be a legitimate forward
  | MissingFinal String  # class method (its name): an absent dict is unresolvable

# A callee signature the verifier can derive truth from, tagged with which
# missing-dict policy applies. `SigMethod` carries the method name for the
# diagnostic.
type CalleeSig (..) =
  | SigFn (List ast.TypeExpr) (Maybe ast.TypeExpr) (List ast.TypeConstraint)
  | SigMethod String (List ast.TypeExpr) (Maybe ast.TypeExpr) (List ast.TypeConstraint)

# ---------------------------------------------------------------------------
# Structural match: source TypeExpr pattern <- concrete Type
# ---------------------------------------------------------------------------
#
# One-directional: instantiate the declared pattern's source var names from a
# concrete type, accumulating name -> concrete-type bindings in theta. A source
# var is a lowercase TypeName; an uppercase TypeName is a type constructor that
# must match the concrete head. Returns Nothing on a structural mismatch (the
# call would not have type-checked, but we stay total and just skip).

# The dispatch-relevant identity of a type/constructor name is its LAST dotted
# segment: post-bundling the same type can appear qualified (`main.Foo`) in one
# place and short (`Foo`) in another, and `types.type_id_display` already
# normalises to the short form. Compare everything short, or legitimate calls
# false-positive on a qualified-vs-short head mismatch.
fn short(s: String) -> String = string.after_last_dot(s)

# Concreteness on the SHORT name: a source type variable is lowercase (`a`, `k`);
# a constructor is uppercase (`Foo`) — even when qualified (`main.Foo` -> `Foo`).
fn starts_lower(s: String) -> Bool =
  match str_char_at(short(s), 0) with
  | Nothing -> false
  | Just c -> c >= 'a' && c <= 'z'

# A `$`-prefixed name is resolver-internal and never a user type constructor:
# `$sk<n>` is the skolem minted by unpacking an existential, and `$ex_<var>` is
# that skolem's STABLE forwarding identity (types.existential_fwd_head). The
# compiler's own convention is that `$` marks a NON-CONCRETE head — resolve routes
# it to EvForward (types.sprout:141) — but `starts_lower` is false for `$`, which
# would otherwise classify both as constructors and compare them as if they were.
# They deliberately denote the SAME rigid type through different passes: `$ex_<var>`
# exists precisely because `$sk<n>` is fresh-per-instantiation and unstable. So a
# correct existential dispatch reads as `ToString $ex_x` against a truth of
# `$sk2416` and would be reported as a mismatch.
#
# Verifying an existential's dict is resolve_skolem_given's job, which looks the
# given up PRECISELY by skolem name. This pass re-derives truth from a source
# signature, which cannot see the packing, so it skips rather than guesses.
fn is_reserved_head(s: String) -> Bool = str_starts_with(short(s), "$")

fn bind_var(name: String, concrete: types.Type, theta: Dict types.Type) -> Maybe (Dict types.Type) =
  match dict_get(name, theta) with
  | Nothing -> Just(dict_set(name, concrete, theta))
  | Just prev ->
      # Already bound — consistent binding required (same source var, same type).
      if type_head_str_eq(prev, concrete) then Just(theta) else Nothing

export fn match_te(pattern: ast.TypeExpr, concrete: types.Type, theta: Dict types.Type) -> Maybe (Dict types.Type) =
  match pattern with
  | ast.TypeName n ->
      if starts_lower(n) then bind_var(n, concrete, theta)
      else
        # Constructor: heads must agree (short display name), e.g. TypeName "Int" ~ TConst Int.
        match concrete with
        | types.TConst id -> if types.type_id_display(id) == short(n) then Just(theta) else Nothing
        | types.TApp base _ -> match_te(pattern, base, theta)
        | _ -> Nothing
  | ast.TypeApply pb pa ->
      match concrete with
      | types.TApp cb ca ->
          match match_te(pb, cb, theta) with
          | Nothing -> Nothing
          | Just theta1 -> match_te(pa, ca, theta1)
      | _ -> Nothing
  | ast.TypeArrow pp pr _ ->
      match concrete with
      | types.TFunc cp cr _ _ ->
          match match_te(pp, cp, theta) with
          | Nothing -> Nothing
          | Just theta1 -> match_te(pr, cr, theta1)
      | _ -> Nothing
  | ast.TypeEffect te _ -> match_te(te, concrete, theta)
  | ast.TupleType items ->
      match concrete with
      | types.TTuple citems -> match_te_list(items, citems, theta)
      | _ -> Nothing

fn match_te_list(patterns: List ast.TypeExpr, concretes: List types.Type, theta: Dict types.Type) -> Maybe (Dict types.Type) =
  match patterns with
  | Nil -> Just(theta)
  | Cons p prest ->
      match concretes with
      | Nil -> Nothing
      | Cons c crest ->
          match match_te(p, c, theta) with
          | Nothing -> Nothing
          | Just theta1 -> match_te_list(prest, crest, theta1)

# ---------------------------------------------------------------------------
# Type head rendering (mirrors ast_to_ir/infer's concrete_type_str)
# ---------------------------------------------------------------------------
#
# The dispatch-relevant head of a type: the constructor name a dictionary keys on.
# Returns Nothing for a still-polymorphic type (TVar) or a function type — neither
# is a concrete dictionary head we can check.
export fn type_head_str(t: types.Type) -> Maybe String =
  match t with
  | types.TConst id ->
      if is_reserved_head(types.type_id_display(id)) then Nothing
      else Just(types.type_id_display(id))
  | types.TApp base _ -> type_head_str(base)
  | types.TTuple items -> Just("Tuple" ++ int_to_string(list_length(items)))
  | types.TVar _ -> Nothing
  | types.TFunc _ _ _ _ -> Nothing

fn type_head_str_eq(a: types.Type, b: types.Type) -> Bool =
  match type_head_str(a) with
  | Nothing -> false
  | Just ha ->
      match type_head_str(b) with
      | Nothing -> false
      | Just hb -> ha == hb

# ---------------------------------------------------------------------------
# Per-call verification
# ---------------------------------------------------------------------------
#
# Inputs (all in source terms except arg_types / ret_ty / dict heads):
#   decl_param_tes  — the callee's declared param type annotations, in order
#   decl_ret_te     — the callee's declared return type annotation (Nothing if none)
#   constraints     — the callee's `where` clause, source names, in order
#   arg_types       — concrete (zonked) types of the call's VALUE arguments, in order
#   ret_ty          — concrete (zonked) return type at the call site (the TCall type)
#   dict_heads      — (class, Just concrete-head | Nothing if polymorphic) for each
#                     injected dict, in `where`-clause order (the caller correlates
#                     injected TDicts positionally; binary-op dicts prepend, calls
#                     append — the caller normalises to constraint order before here)
#
# Builds theta by matching declared params to concrete args AND the declared return
# to the concrete call-site return (phase 2a — pins a return-position constraint
# var), then checks each constraint's var against its injected dict head.
export fn verify_call(
  decl_param_tes: List ast.TypeExpr,
  decl_ret_te: Maybe ast.TypeExpr,
  constraints: List ast.TypeConstraint,
  arg_types: List types.Type,
  ret_ty: types.Type,
  dict_heads: List (String, Maybe String),
  pos: source.SourcePos
) -> List VerifyOutcome =
  verify_call_with_policy(decl_param_tes, decl_ret_te, constraints, arg_types, ret_ty, dict_heads, pos, MissingDeferred)

# Class-method variant. Same truth derivation, but an absent dict is FINAL rather
# than deferred (see MissingPolicy). `method_name` appears in the diagnostic —
# the class's own type-parameter name (`a` in `class Codec a`) means nothing to a
# reader on its own, so the method that failed to dispatch is what identifies the
# call.
export fn verify_class_method_call(
  method_name: String,
  decl_param_tes: List ast.TypeExpr,
  decl_ret_te: Maybe ast.TypeExpr,
  constraints: List ast.TypeConstraint,
  arg_types: List types.Type,
  ret_ty: types.Type,
  dict_heads: List (String, Maybe String),
  pos: source.SourcePos
) -> List VerifyOutcome =
  verify_call_with_policy(decl_param_tes, decl_ret_te, constraints, arg_types, ret_ty, dict_heads, pos, MissingFinal(method_name))

fn verify_call_with_policy(
  decl_param_tes: List ast.TypeExpr,
  decl_ret_te: Maybe ast.TypeExpr,
  constraints: List ast.TypeConstraint,
  arg_types: List types.Type,
  ret_ty: types.Type,
  dict_heads: List (String, Maybe String),
  pos: source.SourcePos,
  policy: MissingPolicy
) -> List VerifyOutcome =
  check_constraints(constraints, dict_heads,
    build_theta_ret(decl_ret_te, ret_ty, build_theta(decl_param_tes, arg_types, dict_empty())), pos, policy)

# Extend theta with return-position bindings: match the declared return TypeExpr
# against the concrete call-site return type. A structural mismatch is swallowed
# (theta unchanged) exactly as build_theta swallows a per-param failure, so the pass
# stays total and degrades to skip rather than a false alarm. A still-polymorphic
# concrete return (TVar) binds the source ret-var to a TVar -> type_head_str Nothing
# -> the constraint skips, never fires.
fn build_theta_ret(ret_te: Maybe ast.TypeExpr, ret_ty: types.Type, theta: Dict types.Type) -> Dict types.Type =
  let Just te = ret_te else theta
      Just theta1 = match_te(te, ret_ty, theta) else theta
  in theta1

# Fold declared params over concrete args, accumulating source-var bindings. A
# per-param match failure is swallowed (the binding for that param is simply
# absent -> its constraints become underdetermined -> skip), keeping the pass total.
fn build_theta(param_tes: List ast.TypeExpr, arg_types: List types.Type, theta: Dict types.Type) -> Dict types.Type =
  match param_tes with
  | Nil -> theta
  | Cons pt prest ->
      match arg_types with
      | Nil -> theta
      | Cons at arest ->
          match match_te(pt, at, theta) with
          | Just theta1 -> build_theta(prest, arest, theta1)
          | Nothing -> build_theta(prest, arest, theta)

# The head source-var name of a constraint (`Ord k` -> Just "k"). A multi-param or
# non-var-headed constraint head yields Nothing -> that constraint is skipped.
fn constraint_var(c: ast.TypeConstraint) -> Maybe String =
  match c with
  | ast.TypeConstraint _ args ->
      match args with
      | [ast.TypeName v | _] -> if starts_lower(v) then Just(v) else Nothing
      | _ -> Nothing

fn constraint_class(c: ast.TypeConstraint) -> String =
  match c with | ast.TypeConstraint cls _ -> cls

fn check_constraints(constraints: List ast.TypeConstraint, dict_heads: List (String, Maybe String), theta: Dict types.Type, pos: source.SourcePos, policy: MissingPolicy) -> List VerifyOutcome =
  match constraints with
  | Nil -> Nil
  | Cons c crest ->
      match take_by_class(constraint_class(c), dict_heads) with
      | Just (dh, remaining) ->
          Cons(check_one(c, dh, theta, pos), check_constraints(crest, remaining, theta, pos, policy))
      | Nothing ->
          Cons(check_missing(c, theta, pos, policy), check_constraints(crest, dict_heads, theta, pos, policy))

# Remove and return the first (class, head) entry in dict_heads whose class
# matches class_name (short name), preserving order of the remainder — mirrors
# infer.sprout's take_dict_for_class. Constraints must be matched to dicts BY
# CLASS, not position: a constraint whose dict the resolver dropped (see
# check_missing) leaves a gap that positional pairing would misalign against
# every constraint after it.
fn take_by_class(class_name: String, dict_heads: List (String, Maybe String)) -> Maybe((String, Maybe String), List (String, Maybe String)) =
  match dict_heads with
  | Nil -> Nothing
  | Cons dh rest ->
      match dh with
      | (dict_class, _) ->
          if short(dict_class) == short(class_name)
          then Just((dh, rest))
          else
            match take_by_class(class_name, rest) with
            | Just (found, remaining) -> Just((found, Cons(dh, remaining)))
            | Nothing -> Nothing

# No dict was injected for this constraint's class at all — as opposed to
# check_one's "a dict exists but its head might disagree". Legitimate when the
# constraint's var is still underdetermined at this call site (a genuinely
# forwarded/polymorphic obligation the resolver defers to a hidden param
# elsewhere); a real soundness gap when theta already pins the var to a
# CONCRETE type, since a headed constraint with a concrete instantiation and
# no dict means the resolver silently dropped an unsatisfiable instance
# instead of rejecting the program (return-position constraints resolved only
# after the call's return type is concrete, e.g. `concat_map`'s `Monoid t`
# when `t` resolves to `Vec Int` and `Vec` has no Monoid instance).
fn check_missing(c: ast.TypeConstraint, theta: Dict types.Type, pos: source.SourcePos, policy: MissingPolicy) -> VerifyOutcome =
  let Just v = constraint_var(c) else VerifySkip(constraint_class(c) ++ ": non-var constraint head")
  in
    match dict_get(v, theta) with
    | Nothing -> underdetermined_missing(c, v, pos, policy)
    | Just truth_ty ->
        match type_head_str(truth_ty) with
        | Just truth_head -> VerifyMismatch(pos, "No instance of " ++ constraint_class(c) ++ " for " ++ truth_head)
        | Nothing -> underdetermined_missing(c, v, pos, policy)

# The constraint var is not pinned to any concrete type AND no dict was injected.
#
# For a constrained `fn` this is the deferred case the pass must stay silent
# about. For a class method it is the classic `show . read` ambiguity: the
# instance is selected by a type that appears nowhere the call can see, both
# instances satisfy the constraint, and they disagree. Left unreported it emits a
# call with no dictionary at all, which survives every later check and fails at
# the LINKER with no Sprout source position — or, worse, silently adopts an
# unrelated variable's dict and makes one closed expression denote two different
# values. See docs/spec-v0.md §constraint well-formedness.
#
# A legitimately forwarded polymorphic call does NOT reach here: it carries a
# dict whose head is a type variable, so it takes check_one's skip path.
fn underdetermined_missing(c: ast.TypeConstraint, v: String, pos: source.SourcePos, policy: MissingPolicy) -> VerifyOutcome =
  match policy with
  | MissingDeferred -> VerifySkip(constraint_class(c) ++ " " ++ v ++ ": underdetermined by source signature")
  | MissingFinal method_name ->
      # `short` on the class: post-bundling it carries a module prefix
      # (`main.Codec`), which is noise in a message naming a class the user wrote.
      VerifyMismatch(pos,
        "ambiguous type variable in `" ++ short(method_name) ++ "`: nothing determines which `"
        ++ short(constraint_class(c)) ++ "` instance to use. Annotate the "
        ++ "expression with the type you mean.")

fn check_one(c: ast.TypeConstraint, dict_head: (String, Maybe String), theta: Dict types.Type, pos: source.SourcePos) -> VerifyOutcome =
  match dict_head with
  | (dict_class, mhead) ->
      let Just head = mhead else VerifySkip(constraint_class(c) ++ ": forwarded/polymorphic dict")
          Just v = constraint_var(c) else VerifySkip(constraint_class(c) ++ ": non-var constraint head")
          Just truth_ty = dict_get(v, theta) else VerifySkip(constraint_class(c) ++ " " ++ v ++ ": underdetermined by source signature")
          Just truth_head = type_head_str(truth_ty) else VerifySkip(constraint_class(c) ++ " " ++ v ++ ": truth still polymorphic")
      in
        if truth_head == head then VerifyOk(constraint_class(c))
        else VerifyMismatch(pos,
          "dictionary for `" ++ constraint_class(c) ++ " " ++ v
          ++ "` resolved to `" ++ constraint_class(c) ++ " " ++ head
          ++ "` but the call fixes " ++ v ++ " = " ++ truth_head
          ++ " (expected `" ++ constraint_class(c) ++ " " ++ truth_head ++ "`)")

# ---------------------------------------------------------------------------
# Program walker: run verify_call at every constrained call site
# ---------------------------------------------------------------------------
#
# Two passes: build a signature table from every callee whose truth is derivable
# — a TFnDecl with BOTH a `where`-clause and fully-annotated params, plus every
# CLASS METHOD (whose constraint is its class applied to its own type parameter);
# everything else is skip-by-construction — then walk all expression trees and
# check each TCall against it. Returns the first mismatch's (pos, message), or
# Nothing if every checkable call verified.
#
# The two kinds differ only in how an ABSENT dict is read; see MissingPolicy.
#
# Residual gap: a class method invoked through a TMethodRef callee (rather than a
# named TVar) is still not covered — check_call keys the callee by TVar name, so a
# method-ref callee is never looked up.

# Signature entry: the callee's param type annotations (in order) + its where-clause.
# verify_program surfaces the first mismatch (the gate's failure); verify_stats
# tallies (verified, skipped, mismatched) so a clean run is distinguishable from a
# silent no-op (the verifier firing on real calls vs. skipping everything).
export fn verify_program(prog: typed_ast.TypedProgram) -> Maybe(source.SourcePos, String) =
  first_mismatch(collect_program(prog))

export fn verify_stats(prog: typed_ast.TypedProgram) -> (Int, Int, Int) =
  tally(collect_program(prog), 0, 0, 0)

fn collect_program(prog: typed_ast.TypedProgram) -> List VerifyOutcome =
  match prog with
  | typed_ast.TypedProgram decls ->
      collect_decls(decls, build_sig_table(decls, dict_empty()))

fn tally(os: List VerifyOutcome, ok: Int, sk: Int, mm: Int) -> (Int, Int, Int) =
  match os with
  | Nil -> (ok, sk, mm)
  | Cons o rest ->
      match o with
      | VerifyOk _ -> tally(rest, ok + 1, sk, mm)
      | VerifySkip _ -> tally(rest, ok, sk + 1, mm)
      | VerifyMismatch _ _ -> tally(rest, ok, sk, mm + 1)

# A top-level `fn` may legitimately SHADOW a class-method name — `tests/stdlib/
# test_classmethod_dispatch_identity.spr` declares `fn append(x: Int) -> Int`
# alongside Semigroup's `append` on purpose. Calls to that name then reach the fn,
# not the method, so the method entry must not be registered at all. Overwriting
# it with the fn's entry is not enough: an UNCONSTRAINED shadowing fn has no
# verifiable signature (fn_sig returns Nothing), which would leave the method
# entry in place and report `No instance of Semigroup for Int` on a plain call.
fn build_sig_table(decls: List typed_ast.TypedDecl, acc: Dict CalleeSig) -> Dict CalleeSig =
  build_fn_sigs(decls, build_class_sigs(decls, collect_fn_names(decls, dict_empty()), acc))

fn collect_fn_names(decls: List typed_ast.TypedDecl, acc: Dict Bool) -> Dict Bool =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name _ _ _ _ _ -> collect_fn_names(rest, dict_set(name, true, acc))
      | _ -> collect_fn_names(rest, acc)

fn build_fn_sigs(decls: List typed_ast.TypedDecl, acc: Dict CalleeSig) -> Dict CalleeSig =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name params ret _ constraints _ ->
          match fn_sig(params, ret, constraints) with
          | Just sig -> build_fn_sigs(rest, dict_set(name, sig, acc))
          | Nothing -> build_fn_sigs(rest, acc)
      | _ -> build_fn_sigs(rest, acc)

# A class declaration survives inference as TPassThrough, still carrying every
# method's written signature. Each method is registered as a callee whose sole
# constraint is the class applied to its own type parameter — the obligation the
# resolver must discharge with a dict at each call site. Registered under the bare
# method name, which is exactly how infer keys `@class:{method}` and how the
# callee appears as `TVar {method}`.
#
# Multi-parameter classes are skipped: `constraint_var` only reads a single
# var-headed constraint, so a two-parameter class would yield an unusable head.
fn build_class_sigs(decls: List typed_ast.TypedDecl, fn_names: Dict Bool, acc: Dict CalleeSig) -> Dict CalleeSig =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      let typed_ast.TPassThrough inner = d else build_class_sigs(rest, fn_names, acc)
          ast.ClassDecl class_name type_params methods _ _ = inner else build_class_sigs(rest, fn_names, acc)
          [tv] = type_params else build_class_sigs(rest, fn_names, acc)
      in build_class_sigs(rest, fn_names, add_class_methods(class_name, tv, methods, fn_names, acc))

fn add_class_methods(class_name: String, tv: String, methods: List ast.ClassMethodSig, fn_names: Dict Bool, acc: Dict CalleeSig) -> Dict CalleeSig =
  match methods with
  | Nil -> acc
  | Cons m rest ->
      match m with
      | ast.ClassMethodSig name params ret_te _ ->
          match dict_get(name, fn_names) with
          | Just _ -> add_class_methods(class_name, tv, rest, fn_names, acc)
          | Nothing ->
              match all_annotated(params) with
              | Nothing -> add_class_methods(class_name, tv, rest, fn_names, acc)
              | Just tes ->
                  add_class_methods(class_name, tv, rest, fn_names,
                    dict_set(name,
                      SigMethod(name, tes, Just(ret_te), [ast.TypeConstraint(class_name, [ast.TypeName(tv)])]),
                      acc))

# A verifiable signature: has a where-clause AND every param is annotated (which a
# where-clause guarantees in source, but stay defensive against synthesized decls).
# The declared return type (`Maybe ast.TypeExpr`) is threaded so return-type dispatch
# — a constraint var appearing only in the return — can be pinned (phase 2a). A
# return-position var is bound by matching this declared return against the call's
# concrete return type; params alone leave it underdetermined -> skip.
fn fn_sig(params: List ast.Param, ret: Maybe ast.TypeExpr, constraints: List ast.TypeConstraint) -> Maybe CalleeSig =
  match constraints with
  | Nil -> Nothing
  | _ ->
      match all_annotated(params) with
      | Nothing -> Nothing
      | Just tes -> Just(SigFn(tes, ret, constraints))

fn all_annotated(params: List ast.Param) -> Maybe (List ast.TypeExpr) =
  match params with
  | Nil -> Just(Nil)
  | Cons p rest ->
      match p with
      | ast.Param _ (Just te) _ ->
          match all_annotated(rest) with
          | Just tes -> Just(Cons(te, tes))
          | Nothing -> Nothing
      | ast.Param _ Nothing _ -> Nothing

# Names bound LOCALLY at the current point of the walk.
#
# A class method is registered under its bare name, and the callee of a call is
# just a `TVar name` — nothing in the typed AST marks it as a method rather than
# an ordinary variable. `collect_fn_names` handles the top-level case by removing
# the method entry when a top-level `fn` shares its name; a local binding needs
# the mirror of that, but scoped, because it shadows the method only inside its
# own body. So the walk carries the set of names in scope and `check_call` skips
# a callee that is one of them.
#
# Without this, a parameter named after a method produced a hard error naming a
# class the code never mentions:
#
#   fn use_it(append: Int -> Int -> Int, x: Int) -> Int = append(x, x)
#   ERROR: dispatch-verify: No instance of Semigroup for Int
fn bind_names(names: List String, locals: Dict Bool) -> Dict Bool =
  match names with
  | Nil -> locals
  | Cons n rest -> bind_names(rest, dict_set(n, true, locals))

fn bind_params(params: List ast.Param, locals: Dict Bool) -> Dict Bool =
  match params with
  | Nil -> locals
  | Cons p rest ->
      match p with
      | ast.Param name _ _ -> bind_params(rest, dict_set(name, true, locals))

# Every name a pattern binds. Literal and wildcard patterns bind nothing; a
# constructor or tuple pattern binds whatever its sub-patterns do.
#
# Every variant is spelled out rather than defaulted, so a new binding-capable
# pattern is a compile error here instead of a silent `Nil`. Answering `Nil` for a
# pattern that does bind leaves the name looking unbound to `check_call`, which
# then reads a call to that local as a call to the class method of the same name
# — the defect this pass was extended to prevent. The codebase's other four
# answers to the same question (`ast_to_ir.pattern_names`, `dce.pat_binds`,
# `linear_check.pattern_all_binders`, `pattern_linear_binders`) are exhaustive for
# this reason; this one was written with a catch-all and is now brought in line.
fn pattern_bound_names(pat: ast.Pattern) -> List String =
  match pat with
  | ast.VarPattern name _ -> [name]
  | ast.ConstructorPattern _ subpats _ -> pattern_list_bound_names(subpats)
  | ast.TuplePattern subpats _ -> pattern_list_bound_names(subpats)
  | ast.WildcardPattern _ -> Nil
  | ast.IntPattern _ _ -> Nil
  | ast.BoolPattern _ _ -> Nil
  | ast.StringPattern _ _ -> Nil
  | ast.CharPattern _ _ -> Nil
  | ast.UnitPattern _ -> Nil

fn pattern_list_bound_names(pats: List ast.Pattern) -> List String =
  match pats with
  | Nil -> Nil
  | Cons p rest -> list_append(pattern_bound_names(p), pattern_list_bound_names(rest))

fn collect_decls(decls: List typed_ast.TypedDecl, sigs: Dict CalleeSig) -> List VerifyOutcome =
  match decls with
  | Nil -> Nil
  | Cons d rest -> list_append(collect_decl(d, sigs), collect_decls(rest, sigs))

fn collect_decl(d: typed_ast.TypedDecl, sigs: Dict CalleeSig) -> List VerifyOutcome =
  match d with
  | typed_ast.TFnDecl _ params _ _ _ body -> collect_expr(body, sigs, bind_params(params, dict_empty()))
  | typed_ast.TInstanceDecl _ _ methods -> collect_methods(methods, sigs)
  # A top-level `let` initializer is a body like any other and is walked like one:
  # an ambiguous class-method chain in one is rejected here rather than left to
  # surface at the linker. It binds no parameters, so nothing shadows a callee name.
  | typed_ast.TLetDecl _ body -> collect_expr(body, sigs, dict_empty())
  # Bodyless. Every declaration is listed rather than left to a wildcard, so a
  # TypedDecl carrying an expression fails to compile here instead of silently
  # skipping verification.
  | typed_ast.TExternFnDecl _ _ _ _ -> Nil
  | typed_ast.TPassThrough _ -> Nil

fn collect_methods(methods: List typed_ast.TypedInstanceMethod, sigs: Dict CalleeSig) -> List VerifyOutcome =
  match methods with
  | Nil -> Nil
  | Cons m rest ->
      match m with
      | typed_ast.TypedInstanceMethod _ params _ _ body ->
          list_append(collect_expr(body, sigs, bind_params(params, dict_empty())),
                      collect_methods(rest, sigs))

# Walk an expression, checking every TCall and recursing into all subexpressions.
# `locals` grows at each binding form and is discarded on the way out, so a shadow
# suppresses verification only within its own scope.
fn collect_expr(e: typed_ast.TypedExpr, sigs: Dict CalleeSig, locals: Dict Bool) -> List VerifyOutcome =
  match e with
  | typed_ast.TCall callee args ret_ty pos ->
      list_append(check_call(callee, args, ret_ty, pos, sigs, locals),
                  collect_exprs(Cons(callee, args), sigs, locals))
  | typed_ast.TIf c th el _ _ -> collect_exprs([c, th, el], sigs, locals)
  | typed_ast.TMatch scrut branches _ _ ->
      list_append(collect_expr(scrut, sigs, locals), collect_branches(branches, sigs, locals))
  | typed_ast.TLambda params body _ _ -> collect_expr(body, sigs, bind_params(params, locals))
  | typed_ast.TBinary _ l r _ _ -> collect_exprs([l, r], sigs, locals)
  | typed_ast.TUnary _ x _ _ -> collect_expr(x, sigs, locals)
  | typed_ast.TRange lo hi _ _ -> collect_exprs([lo, hi], sigs, locals)
  | typed_ast.TTuple items _ _ -> collect_exprs(items, sigs, locals)
  | typed_ast.TDo steps _ _ -> collect_do_steps(steps, sigs, locals)
  | typed_ast.TRecord _ fields _ _ -> collect_record_fields(fields, sigs, locals)
  | typed_ast.TGetField x _ _ _ -> collect_expr(x, sigs, locals)
  | typed_ast.TRecordUpdate base fields _ _ ->
      list_append(collect_expr(base, sigs, locals), collect_record_fields(fields, sigs, locals))
  | _ -> Nil

fn collect_exprs(es: List typed_ast.TypedExpr, sigs: Dict CalleeSig, locals: Dict Bool) -> List VerifyOutcome =
  match es with
  | Nil -> Nil
  | Cons h t -> list_append(collect_expr(h, sigs, locals), collect_exprs(t, sigs, locals))

fn collect_branches(branches: List typed_ast.TypedMatchBranch, sigs: Dict CalleeSig, locals: Dict Bool) -> List VerifyOutcome =
  match branches with
  | Nil -> Nil
  | Cons b rest ->
      match b with
      | typed_ast.TypedMatchBranch pat body ->
          list_append(collect_expr(body, sigs, bind_names(pattern_bound_names(pat), locals)),
                      collect_branches(rest, sigs, locals))

# Do steps bind SEQUENTIALLY: a name bound by one step is in scope for the steps
# below it, but not for its own right-hand side.
fn collect_do_steps(steps: List typed_ast.TypedDoStep, sigs: Dict CalleeSig, locals: Dict Bool) -> List VerifyOutcome =
  match steps with
  | Nil -> Nil
  | Cons s rest ->
      list_append(collect_step(s, sigs, locals), collect_do_steps(rest, sigs, step_binds(s, locals)))

fn step_binds(s: typed_ast.TypedDoStep, locals: Dict Bool) -> Dict Bool =
  match s with
  | typed_ast.TDoBindStep pat _ -> bind_names(pattern_bound_names(pat), locals)
  | typed_ast.TDoLetStep name _ -> dict_set(name, true, locals)
  | typed_ast.TDoExprStep _ -> locals

fn collect_step(s: typed_ast.TypedDoStep, sigs: Dict CalleeSig, locals: Dict Bool) -> List VerifyOutcome =
  match s with
  | typed_ast.TDoBindStep _ expr -> collect_expr(expr, sigs, locals)
  | typed_ast.TDoLetStep _ expr -> collect_expr(expr, sigs, locals)
  | typed_ast.TDoExprStep expr -> collect_expr(expr, sigs, locals)

fn collect_record_fields(fields: List typed_ast.TypedRecordField, sigs: Dict CalleeSig, locals: Dict Bool) -> List VerifyOutcome =
  match fields with
  | Nil -> Nil
  | Cons f rest ->
      match f with
      | typed_ast.TypedRecordField _ expr ->
          list_append(collect_expr(expr, sigs, locals), collect_record_fields(rest, sigs, locals))

# Check one call: look up the callee's signature, split args into value-args and
# injected dicts (by variant — prepend and append both yield dicts in order), and
# verify. Returns every (constraint, dict) outcome for the call — Nil for a
# non-constrained or unknown callee.
#
# A callee bound in `locals` is not the class method or top-level fn of that name
# — it is a parameter, lambda parameter, `let` or pattern binding that shadows it
# — so it carries no signature to verify against and is skipped like any unknown.
fn check_call(callee: typed_ast.TypedExpr, args: List typed_ast.TypedExpr, ret_ty: types.Type, pos: source.SourcePos, sigs: Dict CalleeSig, locals: Dict Bool) -> List VerifyOutcome =
  let Just name = callee_name(callee) else Nil
      Nothing = dict_get(name, locals) else Nil
      Just sig = dict_get(name, sigs) else Nil
  in
    match sig with
    | SigFn param_tes ret_te constraints ->
        verify_call(param_tes, ret_te, constraints, value_arg_types(args), ret_ty, dict_heads_of(args), pos)
    | SigMethod method_name param_tes ret_te constraints ->
        verify_class_method_call(method_name, param_tes, ret_te, constraints, value_arg_types(args), ret_ty, dict_heads_of(args), pos)

fn callee_name(e: typed_ast.TypedExpr) -> Maybe String =
  match e with
  | typed_ast.TVar name _ _ -> Just(name)
  | _ -> Nothing

# Value-arg types: the concrete (zonked) type of each non-TDict argument, in order.
fn value_arg_types(args: List typed_ast.TypedExpr) -> List types.Type =
  match args with
  | Nil -> Nil
  | Cons a rest ->
      match a with
      | typed_ast.TDict _ _ _ _ -> value_arg_types(rest)
      | _ -> Cons(typed_ast.typed_expr_type(a), value_arg_types(rest))

# Injected dict heads: (class, Just concrete-head | Nothing polymorphic), in order.
fn dict_heads_of(args: List typed_ast.TypedExpr) -> List (String, Maybe String) =
  match args with
  | Nil -> Nil
  | Cons a rest ->
      match a with
      | typed_ast.TDict (ast.TypeConstraint cls head_args) _ _ _ ->
          Cons((cls, dict_head_from_args(head_args)), dict_heads_of(rest))
      | _ -> dict_heads_of(rest)

fn dict_head_from_args(head_args: List ast.TypeExpr) -> Maybe String =
  match head_args with
  | [te | _] -> dict_head_te(te)
  | Nil -> Nothing

# The concrete head name of a resolved dict's constraint TypeExpr, or Nothing if
# the head is a type variable (a forwarded/polymorphic dict — legitimately skipped).
fn dict_head_te(te: ast.TypeExpr) -> Maybe String =
  match te with
  | ast.TypeName n -> if starts_lower(n) || is_reserved_head(n) then Nothing else Just(short(n))
  | ast.TypeApply base _ -> dict_head_te(base)
  | ast.TupleType items -> Just("Tuple" ++ int_to_string(list_length(items)))
  | _ -> Nothing

fn first_mismatch(outcomes: List VerifyOutcome) -> Maybe(source.SourcePos, String) =
  match outcomes with
  | Nil -> Nothing
  | Cons o rest ->
      match o with
      | VerifyMismatch pos msg -> Just((pos, msg))
      | _ -> first_mismatch(rest)
