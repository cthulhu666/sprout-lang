fn crypto_ext_entries() -> List (String, types.Scheme) =
  [ ("crypto_sha256",        bt_mono(bt_fn(bt_bytes(), bt_bytes())))
  , ("crypto_hmac_sha256",   bt_mono(bt_fn2(bt_bytes(), bt_bytes(), bt_bytes())))
  , ("crypto_base64_encode", bt_mono(bt_fn(bt_bytes(), bt_str())))
  , ("crypto_base64_decode", bt_mono(bt_fn(bt_str(), bt_result(types.TConst("stdlib.crypto.Base64Error"), bt_bytes()))))
  , ("crypto_bytes_xor",     bt_mono(bt_fn2(bt_bytes(), bt_bytes(), bt_result(types.TConst("stdlib.crypto.BytesOpError"), bt_bytes()))))
  , ("crypto_random_bytes",  bt_mono(bt_io(bt_int(), bt_result(types.TConst("stdlib.crypto.CryptoError"), bt_bytes()))))
  ]

fn tcp_ext_entries() -> List (String, types.Scheme) =
  [ ("tcp_listen",         bt_mono(bt_io(bt_int(), bt_int())))
  , ("tcp_accept",         bt_mono(bt_io(bt_int(), bt_int())))
  , ("tcp_read",           bt_mono(bt_io(bt_int(), bt_str())))
  , ("tcp_write",          bt_mono(bt_fn(bt_int(), bt_io(bt_str(), bt_unit()))))
  , ("tcp_connect",        bt_mono(bt_fn(bt_str(), bt_io(bt_int(), bt_result(types.TConst("stdlib.net.TcpError"), bt_int())))))
  , ("tcp_read_exact",     bt_mono(bt_fn(bt_int(), bt_io(bt_int(), bt_result(types.TConst("stdlib.net.TcpError"), bt_bytes())))))
  , ("tcp_write_all",      bt_mono(bt_fn(bt_int(), bt_io(bt_bytes(), bt_result(types.TConst("stdlib.net.TcpError"), bt_int())))))
  , ("tcp_close",          bt_mono(bt_io(bt_int(), bt_unit())))
  , ("tcp_close_listener", bt_mono(bt_io(bt_int(), bt_unit())))
  , ("tcp_echo_serve",     bt_mono(bt_fn(bt_int(), bt_io(bt_int(), bt_unit()))))
  ]

fn http_ext_entries() -> List (String, types.Scheme) =
  [ ("http_request", bt_mono(bt_fn(bt_str(), bt_fn(bt_str(), bt_fn(bt_str(), bt_fn(bt_str(), bt_io(bt_int(), bt_result(types.TConst("stdlib.http.HttpError"), types.TConst("stdlib.http.HttpResponse")))))))))
  ]

fn term_ext_entries() -> List (String, types.Scheme) =
  [ ("term_clear",          bt_mono(bt_io(bt_unit(), bt_unit())))
  , ("term_move",           bt_mono(bt_fn(bt_int(), bt_io(bt_int(), bt_unit()))))
  , ("term_hide_cursor",    bt_mono(bt_io(bt_unit(), bt_unit())))
  , ("term_show_cursor",    bt_mono(bt_io(bt_unit(), bt_unit())))
  , ("term_read_key",       bt_mono(bt_io(bt_unit(), bt_str())))
  , ("term_read_line",      bt_mono(bt_io(bt_unit(), bt_maybe(bt_str()))))
  , ("term_is_interactive", bt_mono(bt_io(bt_unit(), bt_bool())))
  , ("term_write",          bt_mono(bt_io(bt_str(), bt_unit())))
  ]
