module stdlib.compiler.checker
import stdlib.compiler.ast as ast
import stdlib.compiler.types as types
import stdlib.compiler.unifier as unifier
import stdlib.compiler.infer as infer
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.source as source
import stdlib.string as string

# ---------------------------------------------------------------------------
# CheckResult — the output of the Sprout-owned checker seam
# ---------------------------------------------------------------------------
#
# CheckOk carries the final typing environment (a Dict mapping every
# user-declared name to its inferred or annotation-derived Scheme).
# CheckErr carries a human-readable error message.

export type CheckResult (..) =
  | CheckOk (Dict types.Scheme)
  | CheckErr String

# ---------------------------------------------------------------------------
# check_program — the integration seam entry point
# ---------------------------------------------------------------------------
#
# Accepts a parsed ast.Program and runs the bootstrap HM typechecker stack
# (infer.typecheck_decls, which threads through types/unifier/infer).
# Returns CheckOk with the final env on success, CheckErr on first error.
#
# Bootstrap-level behaviour (current limitations):
#   - FnDecl schemes are read from explicit annotations; bodies are inferred
#     and type-checked against the annotation (lenient on unknown names).
#   - TypeDecl constructors are fully registered with correct polymorphism.
#   - LetDecl values are inferred from their expression bodies.
#   - ClassDecl/InstanceDecl are registered as no-ops (not yet supported).
#
# The initial environment is pre-seeded with built-in and prelude schemes so
# that body inference can type-check calls to common functions without
# falling back to the "unknown variable" leniency rule.  Source-level
# declarations overwrite built-in entries for the same name.

export fn check_program(prog: ast.Program) -> CheckResult !{IO} =
  check_program_with_env(prog, Nil)

# check_program_with_env: like check_program but merges caller-supplied
# name→scheme pairs (e.g., from imported modules) into the initial env.
# Builtin entries are always included; extra entries are added on top.
export fn check_program_with_env(prog: ast.Program, extra: List (String, types.Scheme)) -> CheckResult !{IO} =
  do
    state <- unifier.new_state()
    let desugared = desugar_program(prog)
    match desugared with
    | ast.Program decls _ ->
        do
          r <- infer.typecheck_decls(state, decls, dict_from_list(builtin_entries() ++ extra), dict_empty(), dict_empty())
          match r with
          | typed_ast.TypedErr msg -> CheckErr(msg)
          | typed_ast.TypedOk _ env -> CheckOk(env)

# Like check_program_with_env but returns the full TypedResult (TypedProgram + env).
# Used by lower_driver to feed the lowering pass.
export fn typecheck_typed(prog: ast.Program, extra: List (String, types.Scheme)) -> typed_ast.TypedResult !{IO} =
  do
    state <- unifier.new_state()
    let desugared = desugar_program(prog)
    match desugared with
    | ast.Program decls _ ->
        infer.typecheck_decls(state, decls, dict_from_list(builtin_entries() ++ extra), dict_empty(), dict_empty())

# ---------------------------------------------------------------------------
# String template desugar pass
# ---------------------------------------------------------------------------
#
# Rewrites all StringTemplateExpr nodes in a Program before typechecking.
# This mirrors Python's desugar_string_templates_in_program in elaborate.py.
# Lowering rules (must match Python exactly for parity):
#   empty              → StringExpr("")
#   all-literal        → StringExpr(merged_text)
#   single effective part → that part's expr directly (to_string or StringExpr)
#   general            → string_concat_many(Cons(p0, Cons(p1, ... Nil)))
# Each interp part is wrapped in to_string(expr).
# Empty literal segments are skipped from the parts list.

fn desugar_program(prog: ast.Program) -> ast.Program =
  match prog with
  | ast.Program decls pos -> ast.Program(desugar_decls(decls), pos)

fn desugar_decls(decls: List ast.Decl) -> List ast.Decl =
  match decls with
  | Nil -> Nil
  | Cons d rest -> Cons(desugar_decl(d), desugar_decls(rest))

fn desugar_decl(d: ast.Decl) -> ast.Decl =
  match d with
  | ast.FnDecl name params ret effs constraints body pos ->
      ast.FnDecl(name, params, ret, effs, constraints, desugar_expr(body), pos)
  | ast.LetDecl name body pos ->
      ast.LetDecl(name, desugar_expr(body), pos)
  | ast.InstanceDecl constraint inst_constraints methods pos ->
      ast.InstanceDecl(constraint, inst_constraints, desugar_instance_methods(methods), pos)
  | _ -> d

fn desugar_instance_methods(methods: List ast.InstanceMethodImpl) -> List ast.InstanceMethodImpl =
  match methods with
  | Nil -> Nil
  | Cons m rest -> Cons(desugar_instance_method(m), desugar_instance_methods(rest))

fn desugar_instance_method(m: ast.InstanceMethodImpl) -> ast.InstanceMethodImpl =
  match m with
  | ast.InstanceMethodImpl name params ret effs body ->
      ast.InstanceMethodImpl(name, params, ret, effs, desugar_expr(body))

fn desugar_expr(expr: ast.Expr) -> ast.Expr =
  match expr with
  | ast.StringTemplateExpr parts pos ->
      desugar_template(parts, pos)
  | ast.IfExpr cond then_ else_ pos ->
      ast.IfExpr(desugar_expr(cond), desugar_expr(then_), desugar_expr(else_), pos)
  | ast.CallExpr callee args pos ->
      ast.CallExpr(desugar_expr(callee), desugar_exprs(args), pos)
  | ast.MatchExpr scrut branches pos ->
      ast.MatchExpr(desugar_expr(scrut), desugar_branches(branches), pos)
  | ast.TupleExpr elems pos ->
      ast.TupleExpr(desugar_exprs(elems), pos)
  | ast.BinaryExpr op left right pos ->
      ast.BinaryExpr(op, desugar_expr(left), desugar_expr(right), pos)
  | ast.UnaryExpr op operand pos ->
      ast.UnaryExpr(op, desugar_expr(operand), pos)
  | ast.LambdaExpr params body pos ->
      ast.LambdaExpr(params, desugar_expr(body), pos)
  | ast.DoExpr steps pos ->
      ast.DoExpr(desugar_do_steps(steps), pos)
  | ast.RecordExpr type_name fields pos ->
      ast.RecordExpr(type_name, desugar_record_fields(fields), pos)
  | ast.GetFieldExpr rec_expr field_name pos ->
      ast.GetFieldExpr(desugar_expr(rec_expr), field_name, pos)
  | ast.IntRangeExpr lo hi pos ->
      ast.IntRangeExpr(desugar_expr(lo), desugar_expr(hi), pos)
  | _ -> expr

fn desugar_exprs(exprs: List ast.Expr) -> List ast.Expr =
  match exprs with
  | Nil -> Nil
  | Cons e rest -> Cons(desugar_expr(e), desugar_exprs(rest))

fn desugar_branches(branches: List ast.MatchBranch) -> List ast.MatchBranch =
  match branches with
  | Nil -> Nil
  | Cons b rest ->
      match b with
      | ast.MatchBranch pat body ->
          Cons(ast.MatchBranch(pat, desugar_expr(body)), desugar_branches(rest))

fn desugar_do_steps(steps: List ast.DoStep) -> List ast.DoStep =
  match steps with
  | Nil -> Nil
  | Cons s rest -> Cons(desugar_do_step(s), desugar_do_steps(rest))

fn desugar_do_step(s: ast.DoStep) -> ast.DoStep =
  match s with
  | ast.DoBindStep pat value -> ast.DoBindStep(pat, desugar_expr(value))
  | ast.DoLetStep name value -> ast.DoLetStep(name, desugar_expr(value))
  | ast.DoExprStep value -> ast.DoExprStep(desugar_expr(value))

fn desugar_record_fields(fields: List ast.RecordField) -> List ast.RecordField =
  match fields with
  | Nil -> Nil
  | Cons f rest ->
      match f with
      | ast.RecordField name value ->
          Cons(ast.RecordField(name, desugar_expr(value)), desugar_record_fields(rest))

# Lowering for a single StringTemplateExpr.
fn desugar_template(parts: List ast.TemplateExprPart, pos: source.SourcePos) -> ast.Expr =
  if list_length(parts) == 0 then
    ast.StringExpr("", pos)
  else if all_lit_parts(parts) then
    ast.StringExpr(merge_lit_parts(parts, ""), pos)
  else
    desugar_template_general(collect_effective_parts(parts, pos), pos)

fn desugar_template_general(effective: List ast.Expr, pos: source.SourcePos) -> ast.Expr =
  if list_length(effective) == 1 then
    match effective with
    | Cons single _ -> single
    | Nil -> ast.StringExpr("", pos)
  else
    ast.CallExpr(
      ast.VarExpr("string_concat_many", pos),
      Cons(build_cons_list(effective, pos), Nil),
      pos
    )

fn all_lit_parts(parts: List ast.TemplateExprPart) -> Bool =
  match parts with
  | Nil -> true
  | Cons p rest ->
      match p with
      | ast.LitPart _ -> all_lit_parts(rest)
      | ast.InterpPart _ -> false

fn merge_lit_parts(parts: List ast.TemplateExprPart, acc: String) -> String =
  match parts with
  | Nil -> acc
  | Cons p rest ->
      match p with
      | ast.LitPart text -> merge_lit_parts(rest, string.concat(acc, text))
      | ast.InterpPart _ -> merge_lit_parts(rest, acc)

# Build the list of effective (non-empty) part expressions.
fn collect_effective_parts(parts: List ast.TemplateExprPart, pos: source.SourcePos) -> List ast.Expr =
  match parts with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.LitPart text ->
          if str_len(text) == 0 then collect_effective_parts(rest, pos)
          else Cons(ast.StringExpr(text, pos), collect_effective_parts(rest, pos))
      | ast.InterpPart inner_expr ->
          Cons(
            ast.CallExpr(ast.VarExpr("to_string", pos), Cons(desugar_expr(inner_expr), Nil), pos),
            collect_effective_parts(rest, pos)
          )

fn build_cons_list(exprs: List ast.Expr, pos: source.SourcePos) -> ast.Expr =
  match exprs with
  | Nil -> ast.VarExpr("Nil", pos)
  | Cons e rest ->
      ast.CallExpr(
        ast.VarExpr("Cons", pos),
        Cons(e, Cons(build_cons_list(rest, pos), Nil)),
        pos
      )

# ---------------------------------------------------------------------------
# dump_typed_names — parity-test output renderer
# ---------------------------------------------------------------------------
#
# Walks the declaration list in source order and prints one line per
# user-declared name:
#
#   <name> : <scheme_string>
#
# Printed names:
#   FnDecl    -> the function name
#   LetDecl   -> the binding name
#   TypeDecl  -> each constructor name
#   others    -> nothing (ClassDecl, InstanceDecl, RecordDecl skipped)
#
# This matches what tools/dump_types.py emits from the Python typechecker,
# enabling line-by-line diffing in tests/test_checker_parity.py.

export fn dump_typed_names(decls: List ast.Decl, env: Dict types.Scheme) -> Unit !{IO} =
  match decls with
  | Nil -> ()
  | Cons d rest ->
      do
        dump_decl_name(d, env)
        dump_typed_names(rest, env)

fn dump_decl_name(d: ast.Decl, env: Dict types.Scheme) -> Unit !{IO} =
  match d with
  | ast.FnDecl name _ _ _ _ _ _ -> print_name_scheme(name, env)
  | ast.LetDecl name _ _        -> print_name_scheme(name, env)
  | ast.TypeDecl _ _ ctors _    -> dump_ctor_names(ctors, env)
  | _                           -> ()

fn dump_ctor_names(ctors: List ast.TypeConstructor, env: Dict types.Scheme) -> Unit !{IO} =
  match ctors with
  | Nil -> ()
  | Cons ctor rest ->
      do
        match ctor with
        | ast.TypeConstructor ctor_name _ -> print_name_scheme(ctor_name, env)
        dump_ctor_names(rest, env)

fn print_name_scheme(name: String, env: Dict types.Scheme) -> Unit !{IO} =
  match dict_get(name, env) with
  | Nothing     -> print(name ++ " : <not found>")
  | Just scheme -> print(name ++ " : " ++ types.scheme_to_string(scheme))

# ---------------------------------------------------------------------------
# Built-in typing environment
# ---------------------------------------------------------------------------
#
# Pre-populates the initial env with schemes for built-in functions and
# common prelude helpers.  This allows body inference to type-check calls to
# these functions rather than silently accepting them via the leniency rule.
#
# Type variable names ("a", "b", "v", "e") match conventional Sprout/Haskell
# usage; they are freshly instantiated at each call site by unifier.instantiate.
#
# Source-level TypeDecl/FnDecl/LetDecl declarations are added on top of this
# env by typecheck_decls, so source definitions always take precedence.

export fn builtin_entries() -> List (String, types.Scheme) =
  ctor_entries() ++
  str_entries() ++
  list_entries() ++
  dict_builtin_entries() ++
  set_entries() ++
  vec_entries() ++
  ref_entries() ++
  string_module_entries() ++
  raw_range_entries() ++
  raw_vector_entries() ++
  raw_map_entries() ++
  raw_native_set_entries() ++
  raw_str_entries() ++
  semigroup_markers()

fn raw_range_entries() -> List (String, types.Scheme) =
  [ ("int_range",       bt_mono(bt_fn2(bt_int(), bt_int(), bt_intrange())))
  , ("int_range_start", bt_mono(bt_fn(bt_intrange(), bt_int())))
  , ("int_range_end",   bt_mono(bt_fn(bt_intrange(), bt_int())))
  ]

fn raw_vector_entries() -> List (String, types.Scheme) =
  [ ("vector_empty",    bt_poly1("a", bt_vector(bt_a())))
  , ("vector_length",   bt_poly1("a", bt_fn(bt_vector(bt_a()), bt_int())))
  , ("vector_get",      bt_poly1("a", bt_fn2(bt_vector(bt_a()), bt_int(), bt_maybe(bt_a()))))
  , ("vector_set",      bt_poly1("a", bt_fn3(bt_vector(bt_a()), bt_int(), bt_a(), bt_vector(bt_a()))))
  , ("vector_append",   bt_poly1("a", bt_fn2(bt_vector(bt_a()), bt_a(), bt_vector(bt_a()))))
  , ("vector_from_list",bt_poly1("a", bt_fn(bt_list(bt_a()), bt_vector(bt_a()))))
  ]

fn raw_map_entries() -> List (String, types.Scheme) =
  [ ("map_empty",     bt_poly1("v", bt_map(bt_v())))
  , ("map_get",       bt_poly1("v", bt_fn2(bt_map(bt_v()), bt_str(), bt_maybe(bt_v()))))
  , ("map_set",       bt_poly1("v", bt_fn3(bt_map(bt_v()), bt_str(), bt_v(), bt_map(bt_v()))))
  , ("map_remove",    bt_poly1("v", bt_fn2(bt_map(bt_v()), bt_str(), bt_map(bt_v()))))
  , ("map_size",      bt_poly1("v", bt_fn(bt_map(bt_v()), bt_int())))
  , ("map_nth_key",   bt_poly1("v", bt_fn2(bt_map(bt_v()), bt_int(), bt_maybe(bt_str()))))
  , ("map_nth_value", bt_poly1("v", bt_fn2(bt_map(bt_v()), bt_int(), bt_maybe(bt_v()))))
  ]

fn raw_native_set_entries() -> List (String, types.Scheme) =
  [ ("native_set_empty",   bt_mono(bt_native_set()))
  , ("native_set_insert",  bt_mono(bt_fn2(bt_str(), bt_native_set(), bt_native_set())))
  , ("native_set_member",  bt_mono(bt_fn2(bt_str(), bt_native_set(), bt_bool())))
  , ("native_set_to_list", bt_mono(bt_fn(bt_native_set(), bt_list(bt_str()))))
  , ("native_set_size",    bt_mono(bt_fn(bt_native_set(), bt_int())))
  ]

fn raw_str_entries() -> List (String, types.Scheme) =
  [ ("split_words",              bt_mono(bt_fn(bt_str(), bt_list(bt_str()))))
  , ("str_char_at",              bt_mono(bt_fn2(bt_str(), bt_int(), bt_maybe(bt_char()))))
  , ("str_split_lines",          bt_mono(bt_fn(bt_str(), bt_list(bt_str()))))
  , ("str_char_at_byte",         bt_mono(bt_fn2(bt_str(), bt_int(), bt_maybe(bt_char()))))
  , ("str_char_width_at_byte",   bt_mono(bt_fn2(bt_str(), bt_int(), bt_int())))
  , ("str_byte_len",             bt_mono(bt_fn(bt_str(), bt_int())))
  , ("str_starts_with_at_byte",  bt_mono(bt_fn3(bt_str(), bt_int(), bt_str(), bt_bool())))
  ]

fn semigroup_markers() -> List (String, types.Scheme) =
  [ ("@class:append",          types.mono(types.TConst("Semigroup")))
  , ("@inst:Semigroup:String", types.mono(types.TConst("Unit")))
  , ("@inst:Semigroup:List",   types.mono(types.TConst("Unit")))
  ]

fn builtin_env() -> Dict types.Scheme =
  dict_from_list(builtin_entries())

# -- Type shortcuts ----------------------------------------------------------

fn bt_str()  -> types.Type = types.TConst("String")
fn bt_int()  -> types.Type = types.TConst("Int")
fn bt_bool() -> types.Type = types.TConst("Bool")
fn bt_unit() -> types.Type = types.TConst("Unit")
fn bt_char() -> types.Type = types.TConst("Char")
fn bt_a()    -> types.Type = types.TVar("a")
fn bt_b()    -> types.Type = types.TVar("b")
fn bt_e()    -> types.Type = types.TVar("e")
fn bt_v()    -> types.Type = types.TVar("v")

fn bt_maybe(t: types.Type)  -> types.Type = types.TApp(types.TConst("Maybe"), t)
fn bt_list(t: types.Type)   -> types.Type = types.TApp(types.TConst("List"), t)
fn bt_dict(t: types.Type)   -> types.Type = types.TApp(types.TConst("Dict"), t)
fn bt_vec(t: types.Type)     -> types.Type = types.TApp(types.TConst("Vec"), t)
fn bt_set()                  -> types.Type = types.TConst("Set")
fn bt_vector(t: types.Type)  -> types.Type = types.TApp(types.TConst("Vector"), t)
fn bt_map(t: types.Type)     -> types.Type = types.TApp(types.TConst("Map"), t)
fn bt_native_set()           -> types.Type = types.TConst("NativeSet")
fn bt_intrange()             -> types.Type = types.TConst("IntRange")
fn bt_result(e: types.Type, a: types.Type) -> types.Type =
  types.TApp(types.TApp(types.TConst("Result"), e), a)

fn bt_fn(a: types.Type, b: types.Type) -> types.Type =
  types.TFunc(a, b, types.EffectPure)
fn bt_io(a: types.Type, b: types.Type) -> types.Type =
  types.TFunc(a, b, types.EffectIO)
fn bt_fn2(a: types.Type, b: types.Type, c: types.Type) -> types.Type =
  bt_fn(a, bt_fn(b, c))
fn bt_fn3(a: types.Type, b: types.Type, c: types.Type, d: types.Type) -> types.Type =
  bt_fn(a, bt_fn2(b, c, d))

# -- Scheme shortcuts --------------------------------------------------------

fn bt_mono(t: types.Type) -> types.Scheme =
  types.Scheme(Nil, Nil, t, types.EffectPure)
fn bt_poly1(v: String, t: types.Type) -> types.Scheme =
  types.Scheme(Cons(v, Nil), Nil, t, types.EffectPure)
fn bt_poly2(v1: String, v2: String, t: types.Type) -> types.Scheme =
  types.Scheme(Cons(v1, Cons(v2, Nil)), Nil, t, types.EffectPure)

# -- Seeding helpers ---------------------------------------------------------

fn ctor_entries() -> List (String, types.Scheme) =
  [ ("Just",    bt_poly1("a", bt_fn(bt_a(), bt_maybe(bt_a()))))
  , ("Nothing", bt_poly1("a", bt_maybe(bt_a())))
  , ("Cons",    bt_poly1("a", bt_fn(bt_a(), bt_fn(bt_list(bt_a()), bt_list(bt_a())))))
  , ("Nil",     bt_poly1("a", bt_list(bt_a())))
  , ("Ok",      bt_poly2("e", "a", bt_fn(bt_a(), bt_result(bt_e(), bt_a()))))
  , ("Err",     bt_poly2("e", "a", bt_fn(bt_e(), bt_result(bt_e(), bt_a()))))
  ]

fn str_entries() -> List (String, types.Scheme) =
  [ ("print",           bt_poly1("a", bt_io(bt_a(), bt_unit())))
  , ("str_len",         bt_mono(bt_fn(bt_str(), bt_int())))
  , ("str_slice",       bt_mono(bt_fn3(bt_str(), bt_int(), bt_int(), bt_str())))
  , ("str_find",        bt_mono(bt_fn2(bt_str(), bt_str(), bt_int())))
  , ("str_starts_with", bt_mono(bt_fn2(bt_str(), bt_str(), bt_bool())))
  , ("str_compare",     bt_mono(bt_fn2(bt_str(), bt_str(), bt_int())))
  , ("str_concat",      bt_mono(bt_fn2(bt_str(), bt_str(), bt_str())))
  , ("append",          bt_poly1("t", bt_fn2(types.TVar("t"), types.TVar("t"), types.TVar("t"))))
  , ("int_to_string",   bt_mono(bt_fn(bt_int(), bt_str())))
  , ("parse_int",       bt_mono(bt_fn(bt_str(), bt_int())))
  , ("char_to_string",  bt_mono(bt_fn(bt_char(), bt_str())))
  , ("read_file",       bt_mono(bt_io(bt_str(), bt_str())))
  , ("argv_get",        bt_mono(bt_io(bt_int(), bt_maybe(bt_str()))))
  ]

fn list_entries() -> List (String, types.Scheme) =
  [ ("list_reverse", bt_poly1("a", bt_fn(bt_list(bt_a()), bt_list(bt_a()))))
  , ("list_append",  bt_poly1("a", bt_fn2(bt_list(bt_a()), bt_list(bt_a()), bt_list(bt_a()))))
  , ("list_map",     bt_poly2("a", "b", bt_fn2(bt_fn(bt_a(), bt_b()), bt_list(bt_a()), bt_list(bt_b()))))
  , ("list_fold",    bt_poly2("a", "b", bt_fn3(bt_fn2(bt_b(), bt_a(), bt_b()), bt_b(), bt_list(bt_a()), bt_b())))
  , ("filter",       bt_poly1("a", bt_fn2(bt_fn(bt_a(), bt_bool()), bt_list(bt_a()), bt_list(bt_a()))))
  ]

fn dict_builtin_entries() -> List (String, types.Scheme) =
  [ ("dict_empty",  bt_poly1("v", bt_dict(bt_v())))
  , ("dict_get",    bt_poly1("v", bt_fn2(bt_str(), bt_dict(bt_v()), bt_maybe(bt_v()))))
  , ("dict_set",    bt_poly1("v", bt_fn3(bt_str(), bt_v(), bt_dict(bt_v()), bt_dict(bt_v()))))
  , ("dict_remove", bt_poly1("v", bt_fn2(bt_str(), bt_dict(bt_v()), bt_dict(bt_v()))))
  , ("dict_keys",   bt_poly1("v", bt_fn(bt_dict(bt_v()), bt_vec(bt_str()))))
  , ("dict_values", bt_poly1("v", bt_fn(bt_dict(bt_v()), bt_vec(bt_v()))))
  ]

fn set_entries() -> List (String, types.Scheme) =
  [ ("set_empty",   bt_mono(bt_set()))
  , ("set_insert",  bt_mono(bt_fn2(bt_str(), bt_set(), bt_set())))
  , ("set_member",  bt_mono(bt_fn2(bt_str(), bt_set(), bt_bool())))
  , ("set_to_list", bt_mono(bt_fn(bt_set(), bt_list(bt_str()))))
  , ("set_size",    bt_mono(bt_fn(bt_set(), bt_int())))
  ]

fn bt_vec_a() -> types.Type = bt_vec(bt_a())
fn bt_ref(t: types.Type) -> types.Type = types.TApp(types.TConst("Ref"), t)

fn vec_entries() -> List (String, types.Scheme) =
  [ ("vec_empty",    bt_poly1("a", bt_vec_a()))
  , ("vec_append",   bt_poly1("a", bt_fn2(bt_a(), bt_vec_a(), bt_vec_a())))
  , ("vec_get",      bt_poly1("a", bt_fn2(bt_int(), bt_vec_a(), bt_maybe(bt_a()))))
  , ("vec_length",   bt_poly1("a", bt_fn(bt_vec_a(), bt_int())))
  , ("vec_slice",    bt_poly1("a", bt_fn3(bt_int(), bt_int(), bt_vec_a(), bt_vec_a())))
  , ("vec_from_list",bt_poly1("a", bt_fn(bt_list(bt_a()), bt_vec_a())))
  ]

fn ref_entries() -> List (String, types.Scheme) =
  [ ("ref_new",   bt_poly1("a", bt_io(bt_a(), bt_ref(bt_a()))))
  , ("ref_read",  bt_poly1("a", bt_io(bt_ref(bt_a()), bt_a())))
  , ("ref_write", bt_poly1("a", bt_io(bt_ref(bt_a()), bt_fn(bt_a(), bt_unit()))))
  ]

# Seeded entries for "import stdlib.string as string" usage.
# Maps "string.X" → the type of X from stdlib/string.sprout.
fn string_module_entries() -> List (String, types.Scheme) =
  [ ("string.concat",            bt_mono(bt_fn2(bt_str(), bt_str(), bt_str())))
  , ("string.length",            bt_mono(bt_fn(bt_str(), bt_int())))
  , ("string.slice",             bt_mono(bt_fn3(bt_str(), bt_int(), bt_int(), bt_str())))
  , ("string.drop",              bt_mono(bt_fn2(bt_str(), bt_int(), bt_str())))
  , ("string.find",              bt_mono(bt_fn2(bt_str(), bt_str(), bt_int())))
  , ("string.starts_with",       bt_mono(bt_fn2(bt_str(), bt_str(), bt_bool())))
  , ("string.contains",          bt_mono(bt_fn2(bt_str(), bt_str(), bt_bool())))
