module stdlib.compiler.checker
import stdlib.compiler.ast as ast
import stdlib.compiler.types as types
import stdlib.compiler.unifier as unifier
import stdlib.compiler.infer as infer
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.source as source
import stdlib.string as string

# ---------------------------------------------------------------------------
# CheckResult — the output of the Sprout-owned checker seam
# ---------------------------------------------------------------------------
#
# CheckOk carries the final typing environment (a Dict mapping every
# user-declared name to its inferred or annotation-derived Scheme).
# CheckErr carries a human-readable error message.

export type CheckResult (..) =
  | CheckOk (Dict types.Scheme)
  | CheckErr String

# ---------------------------------------------------------------------------
# check_program — the integration seam entry point
# ---------------------------------------------------------------------------
#
# Accepts a parsed ast.Program and runs the bootstrap HM typechecker stack
# (infer.typecheck_decls, which threads through types/unifier/infer).
# Returns CheckOk with the final env on success, CheckErr on first error.
#
# Bootstrap-level behaviour (current limitations):
#   - FnDecl schemes are read from explicit annotations; bodies are inferred
#     and type-checked against the annotation (lenient on unknown names).
#   - TypeDecl constructors are fully registered with correct polymorphism.
#   - LetDecl values are inferred from their expression bodies.
#   - ClassDecl/InstanceDecl are registered as no-ops (not yet supported).
#
# The initial environment is pre-seeded with built-in and prelude schemes so
# that body inference can type-check calls to common functions without
# falling back to the "unknown variable" leniency rule.  Source-level
# declarations overwrite built-in entries for the same name.

export fn check_program(prog: ast.Program) -> CheckResult !{IO} =
  check_program_with_env(prog, Nil)

# check_program_with_env: like check_program but merges caller-supplied
# name→scheme pairs (e.g., from imported modules) into the initial env.
# Builtin entries are always included; extra entries are added on top.
export fn check_program_with_env(prog: ast.Program, extra: List (String, types.Scheme)) -> CheckResult !{IO} =
  do
    state <- unifier.new_state()
    let desugared = desugar_program(prog)
    match desugared with
    | ast.Program decls _ ->
        do
          r <- infer.typecheck_decls(state, decls, dict_from_list(builtin_entries() ++ extra), dict_empty(), dict_empty())
          match r with
          | typed_ast.TypedErr msg -> CheckErr(msg)
          | typed_ast.TypedOk _ env -> CheckOk(env)

# Like check_program_with_env but returns the full TypedResult (TypedProgram + env).
# Used by lower_driver to feed the lowering pass.
export fn typecheck_typed(prog: ast.Program, extra: List (String, types.Scheme)) -> typed_ast.TypedResult !{IO} =
  do
    state <- unifier.new_state()
    let desugared = desugar_program(prog)
    match desugared with
    | ast.Program decls _ ->
        infer.typecheck_decls(state, decls, dict_from_list(builtin_entries() ++ extra), dict_empty(), dict_empty())

# ---------------------------------------------------------------------------
# String template desugar pass
# ---------------------------------------------------------------------------
#
# Rewrites all StringTemplateExpr nodes in a Program before typechecking.
# This mirrors Python's desugar_string_templates_in_program in elaborate.py.
# Lowering rules (must match Python exactly for parity):
#   empty              → StringExpr("")
#   all-literal        → StringExpr(merged_text)
#   single effective part → that part's expr directly (to_string or StringExpr)
#   general            → string_concat_many(Cons(p0, Cons(p1, ... Nil)))
# Each interp part is wrapped in to_string(expr).
# Empty literal segments are skipped from the parts list.

fn desugar_program(prog: ast.Program) -> ast.Program =
  match prog with
  | ast.Program decls pos ->
      ast.Program(desugar_decls_i(decls, build_fn_sig_index(decls)), pos)

# ---------------------------------------------------------------------------
# strip_module_prefix — strip all leading module path segments from a name
# ---------------------------------------------------------------------------
# Duplicated from infer.sprout/unifier.sprout to avoid circular imports.

fn strip_module_prefix(name: String) -> String =
  if dot == -1 then name
  else strip_module_prefix(str_slice(name, dot + 1, str_len(name)))
  where dot = str_find(name, ".")

# ---------------------------------------------------------------------------
# Phase 4B.5 — FnSig index: maps fn name → List (Maybe String) of param types
# ---------------------------------------------------------------------------

fn build_fn_sig_index(decls: List ast.Decl) -> Dict (List (Maybe String)) =
  build_fn_sig_index_loop(decls, dict_empty())

fn build_fn_sig_index_loop(decls: List ast.Decl, acc: Dict (List (Maybe String))) -> Dict (List (Maybe String)) =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | ast.FnDecl name params _ _ _ _ _ ->
          build_fn_sig_index_loop(rest, dict_set(name, extract_param_type_names(params), acc))
      | _ -> build_fn_sig_index_loop(rest, acc)

fn extract_param_type_names(params: List ast.Param) -> List (Maybe String) =
  match params with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.Param _ mtype ->
          Cons(type_expr_bare_name(mtype), extract_param_type_names(rest))

# Dispatch desugar for a list of call args against the callee's param type list.
# Both lists are walked in parallel — when param_types runs out, remaining args
# are desugared with Nothing (no expected type).
fn desugar_args_with_types(args: List ast.Expr, param_types: List (Maybe String), fn_idx: Dict (List (Maybe String))) -> List ast.Expr =
  match args with
  | Nil -> Nil
  | Cons a rest_args ->
      match param_types with
      | Nil ->
          Cons(desugar_expr_i(a, Nothing, fn_idx), desugar_args_with_types(rest_args, Nil, fn_idx))
      | Cons pt rest_pts ->
          Cons(desugar_expr_i(a, pt, fn_idx), desugar_args_with_types(rest_args, rest_pts, fn_idx))

# Extract the var name from a callee expr (VarExpr only; others return Nothing).
fn callee_var_name(callee: ast.Expr) -> Maybe String =
  match callee with
  | ast.VarExpr name _ -> Just(name)
  | _ -> Nothing

# ---------------------------------------------------------------------------
# Indexed desugar walk — threads fn_idx through for call-site param lookup
# ---------------------------------------------------------------------------

fn desugar_decls_i(decls: List ast.Decl, fn_idx: Dict (List (Maybe String))) -> List ast.Decl =
  match decls with
  | Nil -> Nil
  | Cons d rest -> Cons(desugar_decl_i(d, fn_idx), desugar_decls_i(rest, fn_idx))

fn desugar_decl_i(d: ast.Decl, fn_idx: Dict (List (Maybe String))) -> ast.Decl =
  match d with
  | ast.FnDecl name params ret effs constraints body pos ->
      ast.FnDecl(name, params, ret, effs, constraints, desugar_expr_i(body, type_expr_bare_name(ret), fn_idx), pos)
  | ast.LetDecl name body pos ->
      ast.LetDecl(name, desugar_expr_i(body, Nothing, fn_idx), pos)
  | ast.InstanceDecl constraint inst_constraints methods pos ->
      ast.InstanceDecl(constraint, inst_constraints, desugar_instance_methods_i(methods, fn_idx), pos)
  | _ -> d

fn desugar_instance_methods_i(methods: List ast.InstanceMethodImpl, fn_idx: Dict (List (Maybe String))) -> List ast.InstanceMethodImpl =
  match methods with
  | Nil -> Nil
  | Cons m rest -> Cons(desugar_instance_method_i(m, fn_idx), desugar_instance_methods_i(rest, fn_idx))

fn desugar_instance_method_i(m: ast.InstanceMethodImpl, fn_idx: Dict (List (Maybe String))) -> ast.InstanceMethodImpl =
  match m with
  | ast.InstanceMethodImpl name params ret effs body ->
      ast.InstanceMethodImpl(name, params, ret, effs, desugar_expr_i(body, type_expr_bare_name(ret), fn_idx))

# Context-aware indexed desugar.
fn desugar_expr_i(expr: ast.Expr, expected: Maybe String, fn_idx: Dict (List (Maybe String))) -> ast.Expr =
  match expected with
  | Nothing -> desugar_expr_no_ctx_i(expr, fn_idx)
  | Just exp_name ->
      if exp_name == "StringTemplate" then
        match expr with
        | ast.StringTemplateExpr parts pos ->
            desugar_template_as_string_template_i(parts, pos, fn_idx)
        | ast.IfExpr cond then_ else_ pos ->
            ast.IfExpr(
              desugar_expr_no_ctx_i(cond, fn_idx),
              desugar_expr_i(then_, expected, fn_idx),
              desugar_expr_i(else_, expected, fn_idx),
              pos
            )
        | ast.MatchExpr scrut branches pos ->
            ast.MatchExpr(desugar_expr_no_ctx_i(scrut, fn_idx), desugar_branches_i(branches, expected, fn_idx), pos)
        | _ -> desugar_expr_no_ctx_i(expr, fn_idx)
      else
        desugar_expr_no_ctx_i(expr, fn_idx)

fn desugar_branches_i(branches: List ast.MatchBranch, expected: Maybe String, fn_idx: Dict (List (Maybe String))) -> List ast.MatchBranch =
  match branches with
  | Nil -> Nil
  | Cons b rest ->
      match b with
      | ast.MatchBranch pat body ->
          Cons(ast.MatchBranch(pat, desugar_expr_i(body, expected, fn_idx)), desugar_branches_i(rest, expected, fn_idx))

# Desugar expression without a StringTemplate expected-type context, but
# WITH the fn_idx for call-site lookup.
fn desugar_expr_no_ctx_i(expr: ast.Expr, fn_idx: Dict (List (Maybe String))) -> ast.Expr =
  match expr with
  | ast.StringTemplateExpr parts pos ->
      desugar_template_i(parts, pos, fn_idx)
  | ast.IfExpr cond then_ else_ pos ->
      ast.IfExpr(desugar_expr_no_ctx_i(cond, fn_idx), desugar_expr_no_ctx_i(then_, fn_idx), desugar_expr_no_ctx_i(else_, fn_idx), pos)
  | ast.CallExpr callee args pos ->
      desugar_call_expr_i(callee, args, pos, fn_idx)
  | ast.MatchExpr scrut branches pos ->
      ast.MatchExpr(desugar_expr_no_ctx_i(scrut, fn_idx), desugar_branches_no_ctx_i(branches, fn_idx), pos)
  | ast.TupleExpr elems pos ->
      ast.TupleExpr(desugar_exprs_no_ctx_i(elems, fn_idx), pos)
  | ast.BinaryExpr op left right pos ->
      ast.BinaryExpr(op, desugar_expr_no_ctx_i(left, fn_idx), desugar_expr_no_ctx_i(right, fn_idx), pos)
  | ast.UnaryExpr op operand pos ->
      ast.UnaryExpr(op, desugar_expr_no_ctx_i(operand, fn_idx), pos)
  | ast.LambdaExpr params body pos ->
      ast.LambdaExpr(params, desugar_expr_no_ctx_i(body, fn_idx), pos)
  | ast.DoExpr steps pos ->
      ast.DoExpr(desugar_do_steps_i(steps, fn_idx), pos)
  | ast.RecordExpr type_name fields pos ->
      ast.RecordExpr(type_name, desugar_record_fields_i(fields, fn_idx), pos)
  | ast.GetFieldExpr rec_expr field_name pos ->
      ast.GetFieldExpr(desugar_expr_no_ctx_i(rec_expr, fn_idx), field_name, pos)
  | ast.IntRangeExpr lo hi pos ->
      ast.IntRangeExpr(desugar_expr_no_ctx_i(lo, fn_idx), desugar_expr_no_ctx_i(hi, fn_idx), pos)
  | _ -> expr

fn desugar_call_expr_i(callee: ast.Expr, args: List ast.Expr, pos: source.SourcePos, fn_idx: Dict (List (Maybe String))) -> ast.Expr =
  ast.CallExpr(
    desugar_expr_no_ctx_i(callee, fn_idx),
    desugar_args_with_callee(callee, args, fn_idx),
    pos
  )

fn desugar_args_with_callee(callee: ast.Expr, args: List ast.Expr, fn_idx: Dict (List (Maybe String))) -> List ast.Expr =
  match callee_var_name(callee) with
  | Nothing -> desugar_exprs_no_ctx_i(args, fn_idx)
  | Just name ->
      match dict_get(name, fn_idx) with
      | Nothing -> desugar_exprs_no_ctx_i(args, fn_idx)
      | Just param_types -> desugar_args_with_types(args, param_types, fn_idx)

fn desugar_exprs_no_ctx_i(exprs: List ast.Expr, fn_idx: Dict (List (Maybe String))) -> List ast.Expr =
  match exprs with
  | Nil -> Nil
  | Cons e rest -> Cons(desugar_expr_no_ctx_i(e, fn_idx), desugar_exprs_no_ctx_i(rest, fn_idx))

fn desugar_branches_no_ctx_i(branches: List ast.MatchBranch, fn_idx: Dict (List (Maybe String))) -> List ast.MatchBranch =
  match branches with
  | Nil -> Nil
  | Cons b rest ->
      match b with
      | ast.MatchBranch pat body ->
          Cons(ast.MatchBranch(pat, desugar_expr_no_ctx_i(body, fn_idx)), desugar_branches_no_ctx_i(rest, fn_idx))

fn desugar_do_steps_i(steps: List ast.DoStep, fn_idx: Dict (List (Maybe String))) -> List ast.DoStep =
  match steps with
  | Nil -> Nil
  | Cons s rest -> Cons(desugar_do_step_i(s, fn_idx), desugar_do_steps_i(rest, fn_idx))

fn desugar_do_step_i(s: ast.DoStep, fn_idx: Dict (List (Maybe String))) -> ast.DoStep =
  match s with
  | ast.DoBindStep pat value -> ast.DoBindStep(pat, desugar_expr_no_ctx_i(value, fn_idx))
  | ast.DoLetStep name value -> ast.DoLetStep(name, desugar_expr_no_ctx_i(value, fn_idx))
  | ast.DoExprStep value -> ast.DoExprStep(desugar_expr_no_ctx_i(value, fn_idx))

fn desugar_record_fields_i(fields: List ast.RecordField, fn_idx: Dict (List (Maybe String))) -> List ast.RecordField =
  match fields with
  | Nil -> Nil
  | Cons f rest ->
      match f with
      | ast.RecordField name value ->
          Cons(ast.RecordField(name, desugar_expr_no_ctx_i(value, fn_idx)), desugar_record_fields_i(rest, fn_idx))

# Indexed StringTemplate lowering — passes fn_idx to collect_effective_parts_i.
fn desugar_template_i(parts: List ast.TemplateExprPart, pos: source.SourcePos, fn_idx: Dict (List (Maybe String))) -> ast.Expr =
  if list_length(parts) == 0 then
    ast.StringExpr("", pos)
  else if all_lit_parts(parts) then
    ast.StringExpr(merge_lit_parts(parts, ""), pos)
  else
    desugar_template_general(collect_effective_parts_i(parts, pos, fn_idx), pos)

fn collect_effective_parts_i(parts: List ast.TemplateExprPart, pos: source.SourcePos, fn_idx: Dict (List (Maybe String))) -> List ast.Expr =
  match parts with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.LitPart text ->
          if str_len(text) == 0 then collect_effective_parts_i(rest, pos, fn_idx)
          else Cons(ast.StringExpr(text, pos), collect_effective_parts_i(rest, pos, fn_idx))
      | ast.InterpPart inner_expr ->
          Cons(
            ast.CallExpr(ast.VarExpr("to_string", pos), Cons(desugar_expr_no_ctx_i(inner_expr, fn_idx), Nil), pos),
            collect_effective_parts_i(rest, pos, fn_idx)
          )

# Indexed StringTemplate ADT lowering — used when expected type is StringTemplate.
fn desugar_template_as_string_template_i(parts: List ast.TemplateExprPart, pos: source.SourcePos, fn_idx: Dict (List (Maybe String))) -> ast.Expr =
  if list_length(parts) == 0 then
    wrap_string_template(ast.VarExpr("Nil", pos), pos)
  else if all_lit_parts(parts) then
    wrap_string_template(
      ast.CallExpr(
        ast.VarExpr("Cons", pos),
        Cons(
          ast.CallExpr(ast.VarExpr("TemplateLit", pos), Cons(ast.StringExpr(merge_lit_parts(parts, ""), pos), Nil), pos),
          Cons(ast.VarExpr("Nil", pos), Nil)
        ),
        pos
      ),
      pos
    )
  else
    wrap_string_template(
      build_cons_list(collect_template_part_nodes_i(parts, pos, fn_idx), pos),
      pos
    )

fn collect_template_part_nodes_i(parts: List ast.TemplateExprPart, pos: source.SourcePos, fn_idx: Dict (List (Maybe String))) -> List ast.Expr =
  match parts with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.LitPart text ->
          if str_len(text) == 0 then collect_template_part_nodes_i(rest, pos, fn_idx)
          else
            Cons(
              ast.CallExpr(ast.VarExpr("TemplateLit", pos), Cons(ast.StringExpr(text, pos), Nil), pos),
              collect_template_part_nodes_i(rest, pos, fn_idx)
            )
      | ast.InterpPart inner_expr ->
          Cons(
            ast.CallExpr(
              ast.VarExpr("TemplateInterp", pos),
              Cons(
                ast.CallExpr(ast.VarExpr("to_string", pos), Cons(desugar_expr_no_ctx_i(inner_expr, fn_idx), Nil), pos),
                Nil
              ),
              pos
            ),
            collect_template_part_nodes_i(rest, pos, fn_idx)
          )

# ---------------------------------------------------------------------------
# Legacy (non-indexed) desugar helpers — kept for reference; the program-level
# desugar now goes through the indexed path above.
# ---------------------------------------------------------------------------

fn desugar_decls(decls: List ast.Decl) -> List ast.Decl =
  match decls with
  | Nil -> Nil
  | Cons d rest -> Cons(desugar_decl(d), desugar_decls(rest))

fn desugar_decl(d: ast.Decl) -> ast.Decl =
  match d with
  | ast.FnDecl name params ret effs constraints body pos ->
      ast.FnDecl(name, params, ret, effs, constraints, desugar_expr_with_expected(body, type_expr_bare_name(ret)), pos)
  | ast.LetDecl name body pos ->
      ast.LetDecl(name, desugar_expr(body), pos)
  | ast.InstanceDecl constraint inst_constraints methods pos ->
      ast.InstanceDecl(constraint, inst_constraints, desugar_instance_methods(methods), pos)
  | _ -> d

# Extract the bare constructor name from a Maybe TypeExpr, or Nothing if not
# a simple TypeName.  Used to propagate "StringTemplate" context downward.
fn type_expr_bare_name(te: Maybe ast.TypeExpr) -> Maybe String =
  match te with
  | Nothing -> Nothing
  | Just texpr -> type_texpr_to_maybe_name(texpr)

fn type_texpr_to_maybe_name(texpr: ast.TypeExpr) -> Maybe String =
  match texpr with
  | ast.TypeName tname ->
      Just(strip_module_prefix(tname))
  | _ ->
      Nothing

fn desugar_instance_methods(methods: List ast.InstanceMethodImpl) -> List ast.InstanceMethodImpl =
  match methods with
  | Nil -> Nil
  | Cons m rest -> Cons(desugar_instance_method(m), desugar_instance_methods(rest))

fn desugar_instance_method(m: ast.InstanceMethodImpl) -> ast.InstanceMethodImpl =
  match m with
  | ast.InstanceMethodImpl name params ret effs body ->
      ast.InstanceMethodImpl(name, params, ret, effs, desugar_expr_with_expected(body, type_expr_bare_name(ret)))

# Context-aware desugar.  When expected is Just "StringTemplate" and the
# expression is a StringTemplateExpr, lowers to the StringTemplate ADT.
# In all other positions, behaves identically to desugar_expr.
fn desugar_expr_with_expected(expr: ast.Expr, expected: Maybe String) -> ast.Expr =
  match expected with
  | Nothing -> desugar_expr(expr)
  | Just exp_name ->
      if exp_name == "StringTemplate" then
        match expr with
        | ast.StringTemplateExpr parts pos ->
            desugar_template_as_string_template(parts, pos)
        | ast.IfExpr cond then_ else_ pos ->
            ast.IfExpr(
              desugar_expr(cond),
              desugar_expr_with_expected(then_, expected),
              desugar_expr_with_expected(else_, expected),
              pos
            )
        | ast.MatchExpr scrut branches pos ->
            ast.MatchExpr(desugar_expr(scrut), desugar_branches_with_expected(branches, expected), pos)
        | _ -> desugar_expr(expr)
      else
        desugar_expr(expr)

fn desugar_branches_with_expected(branches: List ast.MatchBranch, expected: Maybe String) -> List ast.MatchBranch =
  match branches with
  | Nil -> Nil
  | Cons b rest ->
      match b with
      | ast.MatchBranch pat body ->
          Cons(ast.MatchBranch(pat, desugar_expr_with_expected(body, expected)), desugar_branches_with_expected(rest, expected))

fn desugar_expr(expr: ast.Expr) -> ast.Expr =
  match expr with
  | ast.StringTemplateExpr parts pos ->
      desugar_template(parts, pos)
  | ast.IfExpr cond then_ else_ pos ->
      ast.IfExpr(desugar_expr(cond), desugar_expr(then_), desugar_expr(else_), pos)
  | ast.CallExpr callee args pos ->
      ast.CallExpr(desugar_expr(callee), desugar_exprs(args), pos)
  | ast.MatchExpr scrut branches pos ->
      ast.MatchExpr(desugar_expr(scrut), desugar_branches(branches), pos)
  | ast.TupleExpr elems pos ->
      ast.TupleExpr(desugar_exprs(elems), pos)
  | ast.BinaryExpr op left right pos ->
      ast.BinaryExpr(op, desugar_expr(left), desugar_expr(right), pos)
  | ast.UnaryExpr op operand pos ->
      ast.UnaryExpr(op, desugar_expr(operand), pos)
  | ast.LambdaExpr params body pos ->
      ast.LambdaExpr(params, desugar_expr(body), pos)
  | ast.DoExpr steps pos ->
      ast.DoExpr(desugar_do_steps(steps), pos)
  | ast.RecordExpr type_name fields pos ->
      ast.RecordExpr(type_name, desugar_record_fields(fields), pos)
  | ast.GetFieldExpr rec_expr field_name pos ->
      ast.GetFieldExpr(desugar_expr(rec_expr), field_name, pos)
  | ast.IntRangeExpr lo hi pos ->
      ast.IntRangeExpr(desugar_expr(lo), desugar_expr(hi), pos)
  | _ -> expr

fn desugar_exprs(exprs: List ast.Expr) -> List ast.Expr =
  match exprs with
  | Nil -> Nil
  | Cons e rest -> Cons(desugar_expr(e), desugar_exprs(rest))

fn desugar_branches(branches: List ast.MatchBranch) -> List ast.MatchBranch =
  match branches with
  | Nil -> Nil
  | Cons b rest ->
      match b with
      | ast.MatchBranch pat body ->
          Cons(ast.MatchBranch(pat, desugar_expr(body)), desugar_branches(rest))

fn desugar_do_steps(steps: List ast.DoStep) -> List ast.DoStep =
  match steps with
  | Nil -> Nil
  | Cons s rest -> Cons(desugar_do_step(s), desugar_do_steps(rest))

fn desugar_do_step(s: ast.DoStep) -> ast.DoStep =
  match s with
  | ast.DoBindStep pat value -> ast.DoBindStep(pat, desugar_expr(value))
  | ast.DoLetStep name value -> ast.DoLetStep(name, desugar_expr(value))
  | ast.DoExprStep value -> ast.DoExprStep(desugar_expr(value))

fn desugar_record_fields(fields: List ast.RecordField) -> List ast.RecordField =
  match fields with
  | Nil -> Nil
  | Cons f rest ->
      match f with
      | ast.RecordField name value ->
          Cons(ast.RecordField(name, desugar_expr(value)), desugar_record_fields(rest))

# Lowering for a single StringTemplateExpr.
fn desugar_template(parts: List ast.TemplateExprPart, pos: source.SourcePos) -> ast.Expr =
  if list_length(parts) == 0 then
    ast.StringExpr("", pos)
  else if all_lit_parts(parts) then
    ast.StringExpr(merge_lit_parts(parts, ""), pos)
  else
    desugar_template_general(collect_effective_parts(parts, pos), pos)

fn desugar_template_general(effective: List ast.Expr, pos: source.SourcePos) -> ast.Expr =
  if list_length(effective) == 1 then
    match effective with
    | Cons single _ -> single
    | Nil -> ast.StringExpr("", pos)
  else
    ast.CallExpr(
      ast.VarExpr("string_concat_many", pos),
      Cons(build_cons_list(effective, pos), Nil),
      pos
    )

fn all_lit_parts(parts: List ast.TemplateExprPart) -> Bool =
  match parts with
  | Nil -> true
  | Cons p rest ->
      match p with
      | ast.LitPart _ -> all_lit_parts(rest)
      | ast.InterpPart _ -> false

fn merge_lit_parts(parts: List ast.TemplateExprPart, acc: String) -> String =
  match parts with
  | Nil -> acc
  | Cons p rest ->
      match p with
      | ast.LitPart text -> merge_lit_parts(rest, string.concat(acc, text))
      | ast.InterpPart _ -> merge_lit_parts(rest, acc)

# Build the list of effective (non-empty) part expressions.
fn collect_effective_parts(parts: List ast.TemplateExprPart, pos: source.SourcePos) -> List ast.Expr =
  match parts with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.LitPart text ->
          if str_len(text) == 0 then collect_effective_parts(rest, pos)
          else Cons(ast.StringExpr(text, pos), collect_effective_parts(rest, pos))
      | ast.InterpPart inner_expr ->
          Cons(
            ast.CallExpr(ast.VarExpr("to_string", pos), Cons(desugar_expr(inner_expr), Nil), pos),
            collect_effective_parts(rest, pos)
          )

fn build_cons_list(exprs: List ast.Expr, pos: source.SourcePos) -> ast.Expr =
  match exprs with
  | Nil -> ast.VarExpr("Nil", pos)
  | Cons e rest ->
      ast.CallExpr(
        ast.VarExpr("Cons", pos),
        Cons(e, Cons(build_cons_list(rest, pos), Nil)),
        pos
      )

# ---------------------------------------------------------------------------
# StringTemplate ADT lowering (Phase 4B)
# ---------------------------------------------------------------------------
#
# desugar_template_as_string_template mirrors Python's
# desugar_string_template_as_string_template.  It is called when the
# immediate expected-type context is "StringTemplate".
#
# Produces:
#   StringTemplate(Cons(TemplateLit("lit"), Cons(TemplateInterp(to_string(x)), Nil)))
# Optimisations:
#   empty        → StringTemplate(Nil)
#   all-literal  → StringTemplate(Cons(TemplateLit("combined"), Nil))
#   general      → StringTemplate(Cons(... parts ..., Nil))
#
# Note: coverage here is limited to the *immediate-annotation* rule:
# fn/method return type = StringTemplate.  Call-site param-type lookup is
# NOT implemented in this bootstrap path (declared reduced coverage, Phase 4C
# note: add full callee param lookup once the Sprout-side compiler can query
# its own function-signature table from a pre-desugar index).

fn wrap_string_template(parts_list: ast.Expr, pos: source.SourcePos) -> ast.Expr =
  ast.CallExpr(
    ast.VarExpr("StringTemplate", pos),
    Cons(parts_list, Nil),
    pos
  )

fn desugar_template_as_string_template(parts: List ast.TemplateExprPart, pos: source.SourcePos) -> ast.Expr =
  if list_length(parts) == 0 then
    wrap_string_template(ast.VarExpr("Nil", pos), pos)
  else if all_lit_parts(parts) then
    wrap_string_template(
      ast.CallExpr(
        ast.VarExpr("Cons", pos),
        Cons(
          ast.CallExpr(ast.VarExpr("TemplateLit", pos), Cons(ast.StringExpr(merge_lit_parts(parts, ""), pos), Nil), pos),
          Cons(ast.VarExpr("Nil", pos), Nil)
        ),
        pos
      ),
      pos
    )
  else
    wrap_string_template(
      build_cons_list(collect_template_part_nodes(parts, pos), pos),
      pos
    )

# Build the list of TemplateLit/TemplateInterp AST nodes for each effective part.
fn collect_template_part_nodes(parts: List ast.TemplateExprPart, pos: source.SourcePos) -> List ast.Expr =
  match parts with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.LitPart text ->
          if str_len(text) == 0 then collect_template_part_nodes(rest, pos)
          else
            Cons(
              ast.CallExpr(ast.VarExpr("TemplateLit", pos), Cons(ast.StringExpr(text, pos), Nil), pos),
              collect_template_part_nodes(rest, pos)
            )
      | ast.InterpPart inner_expr ->
          Cons(
            ast.CallExpr(
              ast.VarExpr("TemplateInterp", pos),
              Cons(
                ast.CallExpr(ast.VarExpr("to_string", pos), Cons(desugar_expr(inner_expr), Nil), pos),
                Nil
              ),
              pos
            ),
            collect_template_part_nodes(rest, pos)
          )

# ---------------------------------------------------------------------------
# dump_typed_names — parity-test output renderer
# ---------------------------------------------------------------------------
#
# Walks the declaration list in source order and prints one line per
# user-declared name:
#
#   <name> : <scheme_string>
#
# Printed names:
#   FnDecl    -> the function name
#   LetDecl   -> the binding name
#   TypeDecl  -> each constructor name
#   others    -> nothing (ClassDecl, InstanceDecl, RecordDecl skipped)
#
# This matches what tools/dump_types.py emits from the Python typechecker,
# enabling line-by-line diffing in tests/test_checker_parity.py.

export fn dump_typed_names(decls: List ast.Decl, env: Dict types.Scheme) -> Unit !{IO} =
  match decls with
  | Nil -> ()
  | Cons d rest ->
      do
        dump_decl_name(d, env)
        dump_typed_names(rest, env)

fn dump_decl_name(d: ast.Decl, env: Dict types.Scheme) -> Unit !{IO} =
  match d with
  | ast.FnDecl name _ _ _ _ _ _ -> print_name_scheme(name, env)
  | ast.LetDecl name _ _        -> print_name_scheme(name, env)
  | ast.TypeDecl _ _ ctors _    -> dump_ctor_names(ctors, env)
  | _                           -> ()

fn dump_ctor_names(ctors: List ast.TypeConstructor, env: Dict types.Scheme) -> Unit !{IO} =
  match ctors with
  | Nil -> ()
  | Cons ctor rest ->
      do
        match ctor with
        | ast.TypeConstructor ctor_name _ -> print_name_scheme(ctor_name, env)
        dump_ctor_names(rest, env)

fn print_name_scheme(name: String, env: Dict types.Scheme) -> Unit !{IO} =
  match dict_get(name, env) with
  | Nothing     -> print(name ++ " : <not found>")
  | Just scheme -> print(name ++ " : " ++ types.scheme_to_string(scheme))

# ---------------------------------------------------------------------------
# Built-in typing environment
# ---------------------------------------------------------------------------
#
# Pre-populates the initial env with schemes for built-in functions and
# common prelude helpers.  This allows body inference to type-check calls to
# these functions rather than silently accepting them via the leniency rule.
#
# Type variable names ("a", "b", "v", "e") match conventional Sprout/Haskell
# usage; they are freshly instantiated at each call site by unifier.instantiate.
#
# Source-level TypeDecl/FnDecl/LetDecl declarations are added on top of this
# env by typecheck_decls, so source definitions always take precedence.

export fn dump_typed_program_names(prog: typed_ast.TypedProgram, env: Dict types.Scheme) -> Unit !{IO} =
  match prog with
  | typed_ast.TypedProgram decls -> dump_typed_decl_names(decls, env)

fn dump_typed_decl_names(decls: List typed_ast.TypedDecl, env: Dict types.Scheme) -> Unit !{IO} =
  match decls with
  | Nil -> ()
  | Cons d rest ->
      do
        match d with
        | typed_ast.TFnDecl name _ _ _ _ _  -> print_name_scheme(name, env)
        | typed_ast.TExternFnDecl name _ _ _ -> print_name_scheme(name, env)
        | typed_ast.TLetDecl name _         -> print_name_scheme(name, env)
        | typed_ast.TInstanceDecl _ _ _     -> ()
        | typed_ast.TPassThrough _          -> ()
        dump_typed_decl_names(rest, env)

export fn builtin_entries() -> List (String, types.Scheme) =
  string_module_entries() ++
  analysis_entries()


# -- Type shortcuts ----------------------------------------------------------

fn bt_str()  -> types.Type = types.TConst("String")
fn bt_int()  -> types.Type = types.TConst("Int")
fn bt_bool() -> types.Type = types.TConst("Bool")
fn bt_unit() -> types.Type = types.TConst("Unit")
fn bt_char() -> types.Type = types.TConst("Char")
fn bt_a()    -> types.Type = types.TVar("a")
fn bt_b()    -> types.Type = types.TVar("b")
fn bt_e()    -> types.Type = types.TVar("e")
fn bt_v()    -> types.Type = types.TVar("v")

fn bt_maybe(t: types.Type)  -> types.Type = types.TApp(types.TConst("Maybe"), t)
fn bt_list(t: types.Type)   -> types.Type = types.TApp(types.TConst("List"), t)
fn bt_dict(t: types.Type)   -> types.Type = types.TApp(types.TConst("Dict"), t)
fn bt_vec(t: types.Type)     -> types.Type = types.TApp(types.TConst("Vec"), t)
fn bt_result(e: types.Type, a: types.Type) -> types.Type =
  types.TApp(types.TApp(types.TConst("Result"), e), a)

fn bt_fn(a: types.Type, b: types.Type) -> types.Type =
  types.TFunc(a, b, types.EffectPure)
fn bt_io(a: types.Type, b: types.Type) -> types.Type =
  types.TFunc(a, b, types.EffectIO)
fn bt_fn2(a: types.Type, b: types.Type, c: types.Type) -> types.Type =
  bt_fn(a, bt_fn(b, c))
fn bt_fn3(a: types.Type, b: types.Type, c: types.Type, d: types.Type) -> types.Type =
  bt_fn(a, bt_fn2(b, c, d))

# -- Scheme shortcuts --------------------------------------------------------

fn bt_mono(t: types.Type) -> types.Scheme =
  types.Scheme(Nil, Nil, t, types.EffectPure)
fn bt_poly1(v: String, t: types.Type) -> types.Scheme =
  types.Scheme(Cons(v, Nil), Nil, t, types.EffectPure)
fn bt_poly2(v1: String, v2: String, t: types.Type) -> types.Scheme =
  types.Scheme(Cons(v1, Cons(v2, Nil)), Nil, t, types.EffectPure)

# Seeded entries for "import stdlib.string as string" usage.
# Maps "string.X" → the type of X from stdlib/string.sprout.
fn string_module_entries() -> List (String, types.Scheme) =
  [ ("string.concat",            bt_mono(bt_fn2(bt_str(), bt_str(), bt_str())))
  , ("string.length",            bt_mono(bt_fn(bt_str(), bt_int())))
  , ("string.slice",             bt_mono(bt_fn3(bt_str(), bt_int(), bt_int(), bt_str())))
  , ("string.drop",              bt_mono(bt_fn2(bt_str(), bt_int(), bt_str())))
  , ("string.find",              bt_mono(bt_fn2(bt_str(), bt_str(), bt_int())))
  , ("string.starts_with",       bt_mono(bt_fn2(bt_str(), bt_str(), bt_bool())))
  , ("string.contains",          bt_mono(bt_fn2(bt_str(), bt_str(), bt_bool())))
  , ("string.char_at",           bt_mono(bt_fn2(bt_str(), bt_int(), bt_maybe(bt_char()))))
  , ("string.char_at_or",        bt_mono(bt_fn3(bt_str(), bt_int(), bt_char(), bt_char())))
  , ("string.string_from_char",  bt_mono(bt_fn(bt_char(), bt_str())))
  , ("string.is_ascii_whitespace", bt_mono(bt_fn(bt_char(), bt_bool())))
  , ("string.is_ascii_digit",    bt_mono(bt_fn(bt_char(), bt_bool())))
  , ("string.is_ident_start",    bt_mono(bt_fn(bt_char(), bt_bool())))
  , ("string.is_ident_continue", bt_mono(bt_fn(bt_char(), bt_bool())))
  ]

fn bt_pair(a: types.Type, b: types.Type) -> types.Type =
  types.TTuple(Cons(a, Cons(b, Nil)))

fn bt_triple(a: types.Type, b: types.Type, c: types.Type) -> types.Type =
  types.TTuple(Cons(a, Cons(b, Cons(c, Nil))))

fn bt_quad(a: types.Type, b: types.Type, c: types.Type, d: types.Type) -> types.Type =
  types.TTuple(Cons(a, Cons(b, Cons(c, Cons(d, Nil)))))


# Analysis bridge builtins — C functions provided by sprout_runtime.c analysis bridge.
# Used by stdlib/compiler.sprout.
# These functions are intentionally NOT declared as `extern fn` in prelude.sprout.
# build_extern_sigs_from_decls overwrites compiler_intrinsic_sigs() entries via dict_set,
# so an `extern fn String` declaration would replace the ll_ptr() intrinsic entry with an
# ll_i64() entry, breaking the const char* calling convention. Intrinsics only win when
# there is no matching extern fn declaration for the same name.
fn analysis_entries() -> List (String, types.Scheme) =
  [ ("analysis_check_source",
      bt_mono(bt_io(bt_str(), bt_result(bt_str(), bt_unit()))))
  , ("analysis_declared_names_in_source",
      bt_mono(bt_io(bt_str(), bt_result(bt_str(), bt_vec(bt_str())))))
  , ("analysis_exported_names_in_source",
      bt_mono(bt_io(bt_str(), bt_result(bt_str(), bt_vec(bt_str())))))
  , ("analysis_type_of_in_source",
      bt_mono(bt_fn(bt_str(), bt_io(bt_str(), bt_result(bt_str(), bt_str())))))
  , ("analysis_eval_expr_in_source",
      bt_mono(bt_fn(bt_str(), bt_io(bt_str(), bt_result(bt_str(), bt_vec(bt_str()))))))
  , ("analysis_instances_in_source",
      bt_mono(bt_fn(bt_str(), bt_io(bt_str(), bt_result(bt_str(), bt_pair(bt_str(), bt_vec(bt_str())))))))
  , ("analysis_symbol_inventory_in_source",
      bt_mono(bt_io(bt_str(), bt_result(bt_str(), bt_triple(bt_vec(bt_str()), bt_vec(bt_str()), bt_vec(bt_str()))))))
  , ("analysis_diagnostics_in_source",
      bt_mono(bt_io(bt_str(), bt_vec(bt_triple(bt_str(), bt_int(), bt_int())))))
  , ("analysis_symbol_locations_in_source",
      bt_mono(bt_io(bt_str(), bt_result(bt_str(), bt_vec(bt_quad(bt_str(), bt_str(), bt_int(), bt_int()))))))
  , ("analysis_complete_in_state",
      bt_mono(bt_fn(bt_str(), bt_fn(bt_vec(bt_str()), bt_io(bt_vec(bt_str()), bt_pair(bt_str(), bt_vec(bt_str())))))))
  ]
