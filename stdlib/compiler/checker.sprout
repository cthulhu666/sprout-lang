module stdlib.compiler.checker
import stdlib.compiler.ast as ast
import stdlib.compiler.types as types
import stdlib.compiler.unifier as unifier
import stdlib.compiler.infer as infer
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.source as source
import stdlib.string as string
import stdlib.compiler.desugar_ctx as desugar_ctx

# ---------------------------------------------------------------------------
# CheckResult — the output of the Sprout-owned checker seam
# ---------------------------------------------------------------------------
#
# CheckOk carries the final typing environment (a Dict mapping every
# user-declared name to its inferred or annotation-derived Scheme).
# CheckErr carries a human-readable error message.

export type CheckResult (..) =
  | CheckOk (Dict types.Scheme)
  | CheckErr source.SourcePos String

# ---------------------------------------------------------------------------
# check_program — the integration seam entry point
# ---------------------------------------------------------------------------
#
# Accepts a parsed ast.Program and runs the bootstrap HM typechecker stack
# (infer.typecheck_decls, which threads through types/unifier/infer).
# Returns CheckOk with the final env on success, CheckErr on first error.
#
# Bootstrap-level behaviour (current limitations):
#   - FnDecl schemes are read from explicit annotations; bodies are inferred
#     and type-checked against the annotation (lenient on unknown names).
#   - TypeDecl constructors are fully registered with correct polymorphism.
#   - LetDecl values are inferred from their expression bodies.
#   - ClassDecl/InstanceDecl are registered as no-ops (not yet supported).
#
# The initial environment is pre-seeded with built-in and prelude schemes so
# that body inference can type-check calls to common functions without
# falling back to the "unknown variable" leniency rule.  Source-level
# declarations overwrite built-in entries for the same name.

export fn check_program(prog: ast.Program) -> CheckResult !{IO} =
  check_program_with_env(prog, Nil)

# check_program_with_env: like check_program but merges caller-supplied
# name→scheme pairs (e.g., from imported modules) into the initial env.
# Builtin entries are always included; extra entries are added on top.
export fn check_program_with_env(prog: ast.Program, extra: List (String, types.Scheme)) -> CheckResult !{IO} =
  do
    state <- unifier.new_state()
    let desugared = desugar_program(prog)
    match desugared with
    | ast.Program decls _ ->
        do
          r <- infer.typecheck_decls(state, decls, dict_from_list(builtin_entries() ++ extra), dict_empty(), dict_empty())
          match r with
          | typed_ast.TypedErr pos msg -> CheckErr(pos, msg)
          | typed_ast.TypedOk _ env ->
              match stored_effect_var_error(decls) with
              | Nothing -> CheckOk(env)
              | Just (pos, msg) -> CheckErr(pos, msg)

# Like check_program_with_env but returns the full TypedResult (TypedProgram + env).
# Used by lower_driver to feed the lowering pass.
export fn typecheck_typed(prog: ast.Program, extra: List (String, types.Scheme)) -> typed_ast.TypedResult !{IO} =
  do
    (result, reports) <- typecheck_typed_with_effects(prog, extra)
    enforce_stored_effect_vars(prog, enforce_effects(result, reports))

# Rule 9's stored-position half, applied on the SAME path as rule 8's post-pass
# and for the same reason: `--phase effects` calls
# `typecheck_typed_with_effects` directly, so the census still enumerates a
# program this rejects. Type declarations carry no expressions, so the
# un-desugared `prog` is the right thing to read.
fn enforce_stored_effect_vars(prog: ast.Program,
                              result: typed_ast.TypedResult) -> typed_ast.TypedResult =
  match result with
  | typed_ast.TypedErr _ _ -> result
  | typed_ast.TypedOk _ _ ->
      match prog with
      | ast.Program decls _ ->
          match stored_effect_var_error(decls) with
          | Nothing -> result
          | Just (pos, msg) -> typed_ast.TypedErr(pos, msg)

# spec-v0.md §7 rule 8, enforced. A declaration whose body performs IO under a
# pure signature is rejected here.
#
# Deliberately a POST-PASS over the whole report list rather than an error raised
# at the declaration boundary, for two reasons.
#
# It reports every offending declaration at once. The boundary raises one error
# and inference stops; a codebase migrating to enforced effects would then get
# its gaps one compile at a time, which is the difference between a morning and
# a week.
#
# And it keeps `--phase effects` alive. That phase calls
# typecheck_typed_with_effects directly and so never reaches this function: the
# census instrument survives enforcement intact, which matters most precisely
# when enforcement is new and somebody needs the full list to migrate against.
# Both paths share `unifier.effect_report_is_gap`, so the report cannot drift
# from what the checker actually rejects.
#
# A pre-existing type error wins: `result` is returned untouched when it is
# already TypedErr, and infer records nothing for a declaration whose return type
# failed to unify.
fn enforce_effects(result: typed_ast.TypedResult, reports: List unifier.EffectReport)
    -> typed_ast.TypedResult =
  match result with
  | typed_ast.TypedErr _ _ -> result
  | typed_ast.TypedOk _ _ ->
      match effect_gaps(reports) with
      | Cons first rest ->
          typed_ast.TypedErr(unifier.effect_report_pos(first),
            effect_gap_message(first, rest))
      | Nil ->
          # Rule 8 first, rule 9 second. A declaration that both under-declares
          # and needs two variables is more usefully reported as the former: the
          # missing `!{IO}` is a fact about what the code does, while the extra
          # variable is a fact about how its signature is written.
          match effect_multi_vars(reports) with
          | Nil -> result
          | [first | _] ->
              typed_ast.TypedErr(unifier.effect_report_pos(first),
                effect_multi_var_message(first))

# The prelude has no list_filter; these are the local ones, as compile_driver
# does for its own count. Order is source order, so each list reports its FIRST
# offending declaration rather than an arbitrary one.
#
# Across the two lists, order is by RULE and not by position: every gap is
# considered before any rule-9 violation, so a rule-9 error early in a file is
# masked by a gap later in it, and fixing the gap makes the reported position
# jump backwards. That is deliberate — see the ordering note in enforce_effects
# — but it does mean "first offending declaration" holds within a rule, not
# across the file.
fn effect_gaps(reports: List unifier.EffectReport) -> List unifier.EffectReport =
  match reports with
  | Nil -> Nil
  | Cons r rest ->
      if unifier.effect_report_is_gap(r) then Cons(r, effect_gaps(rest))
      else effect_gaps(rest)

fn effect_multi_vars(reports: List unifier.EffectReport) -> List unifier.EffectReport =
  match reports with
  | Nil -> Nil
  | Cons r rest ->
      if unifier.effect_report_is_multi_var(r) then Cons(r, effect_multi_vars(rest))
      else effect_multi_vars(rest)

# Two causes, two messages. Both are rule-9 rejections, but the fix differs and a
# single wording could only fit one of them.
#
# The variables are named in their SOURCE spelling, which is possible now that the
# check reads the declared scheme. The earlier message could only give a count:
# it read the inferred row, whose members are freshened (`$e0`, `$e1`) and appear
# nowhere in the source, so printing them sent the reader hunting for identifiers
# that do not exist.
fn effect_multi_var_message(r: unifier.EffectReport) -> String =
  match unifier.effect_report_effect_vars(r) with
  | [a, b | rest] -> effect_too_many_vars_message(r, Cons(a, Cons(b, rest)))
  | _ -> effect_row_message(r)

fn effect_too_many_vars_message(r: unifier.EffectReport, vars: List String) -> String =
  "`" ++ unifier.effect_report_name(r) ++ "` names "
    ++ int_to_string(list_length(vars)) ++ " effect variables ("
    ++ quoted_var_list(vars)
    ++ "), but a signature may quantify only one (spec-v0.md §7 rule 9)"
    ++ " — write the same variable on every effect-polymorphic parameter,"
    ++ " e.g. `f: a -> Unit !{e}, g: b -> Unit !{e}`"

# `!{IO, e}` satisfies the singleton count — one variable — so rule 9's "write the
# same variable everywhere" advice does not apply. It is rejected because §7
# defines no row form at all.
fn effect_row_message(r: unifier.EffectReport) -> String =
  types.effect_row_undefined_message(
    "`" ++ unifier.effect_report_name(r) ++ "`",
    "!{" ++ join_effect_labels(unifier.effect_report_row_labels(r)) ++ "}")

fn quoted_var_list(vars: List String) -> String =
  match vars with
  | Nil -> ""
  | Cons v rest ->
      match rest with
      | Nil -> "`" ++ v ++ "`"
      | _ -> "`" ++ v ++ "`, " ++ quoted_var_list(rest)

fn join_effect_labels(labels: List String) -> String =
  match labels with
  | Nil -> ""
  | Cons l rest ->
      match rest with
      | Nil -> l
      | _ -> l ++ ", " ++ join_effect_labels(rest)

# Names every offending declaration, and shows the fix rather than describing it.
# The first line carries the phrase the conformance fixtures pin.
fn effect_gap_message(first: unifier.EffectReport, rest: List unifier.EffectReport) -> String =
  "`" ++ unifier.effect_report_name(first) ++ "` performs IO but is declared pure"
    ++ " — add `!{IO}` after its return type (spec-v0.md §7 rule 8)"
    ++ effect_gap_others(rest)

fn effect_gap_others(rest: List unifier.EffectReport) -> String =
  match rest with
  | Nil -> ""
  | _ ->
      "\n  " ++ int_to_string(list_length(rest)) ++ " more in this program:"
        ++ list_fold(\ (acc, r) -> acc ++ "\n    " ++ unifier.effect_report_name(r), "", rest)

# ---------------------------------------------------------------------------
# Stored effect variables — spec-v0.md §7 rule 9
# ---------------------------------------------------------------------------
#
# An effect variable belongs to a FUNCTION TYPE. Written in a stored position — a
# record field or a constructor payload — it is unsound, and the reason is
# quantification rather than storage: `e` is not a parameter of the type, so the
# constructor's scheme quantifies it and then has nowhere to record what it was
# bound to. Reading the field re-instantiates a fresh, unconstrained variable,
# which rule 8 lets through (correctly — that let-through is what makes every
# prelude HOF legal). The result was IO running inside a function the checker
# believed pure.
#
# A concrete `!{IO}` in the same position has nothing to quantify and stays
# legal; five stdlib types depend on it. Fixtures pin both sides:
# type_error/effect_var_in_record_field, type_error/effect_var_in_ctor_payload,
# run/effect_concrete_io_stored_ok.
#
# Syntactic, so it reads the declaration rather than an inference result — there
# is nothing to infer, and the position is exactly where the author wrote it.
fn stored_effect_var_error(decls: List ast.Decl) -> Maybe(source.SourcePos, String) =
  match decls with
  | Nil -> Nothing
  | Cons d rest ->
      match stored_effect_var_in_decl(d) with
      | Just err -> Just(err)
      | Nothing -> stored_effect_var_error(rest)

# Every variant is spelled out, per docs/guidelines.md §2a: this answers a
# question ABOUT a declaration form, so a catch-all is right only for today's
# variants. A `Decl` added later that stores a type would slip through silently —
# which is the exact hole this function exists to close, and is how `WrapDecl`
# was missed on the first draft.
#
# THREE variants are stored positions. A `wrap` is a newtype: constructing one
# stores the value, so `wrap Handler = Int -> Int !{e}` launders IO exactly as a
# constructor payload does.
#
# The rest are exempt because they declare FUNCTION TYPES, which is where an
# effect variable belongs:
#   FnDecl, ExternFnDecl, ClassDecl, InstanceDecl — signatures.
#   LetDecl — a value annotation; a top-level `let` must be pure (spec §5.2) and
#     its effect annotation is discarded today, which is a separate open item.
#   AliasDecl — transparent, so its body is judged where the alias is USED.
#     Dependency worth knowing: an alias is not expanded in a record field today,
#     and whoever fixes that must re-check this walk. It runs before expansion,
#     so an alias body carrying an effect variable would reach a field as a bare
#     `TypeName` and be invisible here.
fn stored_effect_var_in_decl(d: ast.Decl) -> Maybe(source.SourcePos, String) =
  match d with
  | ast.RecordDecl name _ fields _ _ pos -> stored_in_fields(name, fields, pos)
  | ast.TypeDecl name _ ctors _ _ pos -> stored_in_ctors(name, ctors, pos)
  | ast.WrapDecl name inner _ pos -> stored_in_wrap(name, inner, pos)
  | ast.FnDecl _ _ _ _ _ _ _ -> Nothing
  | ast.ExternFnDecl _ _ _ _ _ -> Nothing
  | ast.LetDecl _ _ _ _ -> Nothing
  | ast.ClassDecl _ _ _ _ _ -> Nothing
  | ast.InstanceDecl _ _ _ _ -> Nothing
  | ast.AliasDecl _ _ _ _ -> Nothing

fn stored_in_wrap(tname: String, inner: ast.TypeExpr,
                  pos: source.SourcePos) -> Maybe(source.SourcePos, String) =
  match effect_var_in_type(inner) with
  | Just v -> Just((pos, stored_effect_var_message(tname, "its wrapped type", v)))
  | Nothing -> Nothing

fn stored_in_fields(tname: String, fields: List ast.RecordFieldDecl,
                    pos: source.SourcePos) -> Maybe(source.SourcePos, String) =
  match fields with
  | Nil -> Nothing
  | Cons (ast.RecordFieldDecl fname ftype) rest ->
      match effect_var_in_type(ftype) with
      | Just v -> Just((pos, stored_effect_var_message(tname, `field \`${fname}\``, v)))
      | Nothing -> stored_in_fields(tname, rest, pos)

fn stored_in_ctors(tname: String, ctors: List ast.TypeConstructor,
                   pos: source.SourcePos) -> Maybe(source.SourcePos, String) =
  match ctors with
  | Nil -> Nothing
  | Cons (ast.TypeConstructor cname payloads _ _) rest ->
      match first_effect_var(payloads) with
      | Just v -> Just((pos, stored_effect_var_message(tname, `constructor \`${cname}\``, v)))
      | Nothing -> stored_in_ctors(tname, rest, pos)

fn first_effect_var(ts: List ast.TypeExpr) -> Maybe String =
  match ts with
  | Nil -> Nothing
  | Cons t rest ->
      match effect_var_in_type(t) with
      | Just v -> Just(v)
      | Nothing -> first_effect_var(rest)

# Both annotation carriers are walked: `TypeArrow`/`TypeThunk` trailing labels
# and the standalone `TypeEffect` node. A check that read only one would leave
# the other spelling open, and the parser produces both.
fn effect_var_in_type(t: ast.TypeExpr) -> Maybe String =
  match t with
  | ast.TypeName _ -> Nothing
  | ast.TypeApply a b -> first_effect_var([a, b])
  | ast.TupleType ts -> first_effect_var(ts)
  | ast.TypeEffect inner labels ->
      match effect_var_label(labels) with
      | Just v -> Just(v)
      | Nothing -> effect_var_in_type(inner)
  | ast.TypeArrow a b labels ->
      match effect_var_label(arrow_labels(labels)) with
      | Just v -> Just(v)
      | Nothing -> first_effect_var([a, b])
  | ast.TypeThunk b labels ->
      match effect_var_label(arrow_labels(labels)) with
      | Just v -> Just(v)
      | Nothing -> effect_var_in_type(b)

fn arrow_labels(labels: Maybe (List String)) -> List String =
  match labels with
  | Nothing -> Nil
  | Just ls -> ls

# Lowercase-initial is what distinguishes a variable from a label. An
# unrecognised label never reaches here: the parser rejects it where the
# annotation is read (spec-v0.md §7 rule 9).
fn effect_var_label(labels: List String) -> Maybe String =
  match labels with
  | Nil -> Nothing
  | Cons l rest ->
      if types.effect_label_is_var(l) then Just(l) else effect_var_label(rest)

# The phrase the conformance fixtures pin is "in a stored position".
fn stored_effect_var_message(tname: String, where_desc: String, v: String) -> String =
  `\`${tname}\` writes the effect variable \`!{${v}}\` in a stored position (${where_desc})`
    ++ " — it is discarded when a value is constructed, so reading it back yields a"
    ++ " fresh unconstrained effect and IO escapes a pure signature."
    ++ " Use a concrete `!{IO}` there instead (spec-v0.md §7 rule 9)"

# Like typecheck_typed but hands back the declared-vs-inferred effect census
# alongside the result, and does NOT enforce it. The reports live on the
# InferState, which is created and dropped here, so reaching them needs an entry
# point at this level rather than a reader further out.
#
# Two callers, and the difference between them is the point. `typecheck_typed`
# wraps this in `enforce_effects` and is what every normal compile goes through.
# `--phase effects` calls this one directly, so the census keeps enumerating
# every declaration even in a program enforcement would reject — which is what
# makes the phase usable for migrating a codebase onto enforced effects rather
# than something that dies at the first gap.
export fn typecheck_typed_with_effects(prog: ast.Program, extra: List (String, types.Scheme))
    -> (typed_ast.TypedResult, List unifier.EffectReport) !{IO} =
  do
    state <- unifier.new_state()
    let desugared = desugar_program(prog)
    match desugared with
    | ast.Program decls _ ->
        do
          result <- infer.typecheck_decls(state, decls, dict_from_list(builtin_entries() ++ extra), dict_empty(), dict_empty())
          reports <- unifier.effect_reports(state)
          (result, reports)

# ---------------------------------------------------------------------------
# String template / Vec-literal desugar pass
# ---------------------------------------------------------------------------
#
# Rewrites StringTemplateExpr nodes and bare list literals in Vec-typed
# positions before typechecking. Extracted to desugar_ctx.sprout (ast/source/
# string only, no typechecker dependency) so lint_rules.sprout can reuse the
# same Vec-context computation without depending on this module's stack.

fn desugar_program(prog: ast.Program) -> ast.Program =
  desugar_ctx.desugar_program(prog)

# ---------------------------------------------------------------------------
# dump_typed_names — parity-test output renderer
# ---------------------------------------------------------------------------
#
# Walks the declaration list in source order and prints one line per
# user-declared name:
#
#   <name> : <scheme_string>
#
# Printed names:
#   FnDecl    -> the function name
#   LetDecl   -> the binding name
#   TypeDecl  -> each constructor name
#   others    -> nothing (ClassDecl, InstanceDecl, RecordDecl skipped)
#
# This matches what tools/dump_types.py emits from the Python typechecker,
# enabling line-by-line diffing in tests/test_checker_parity.py.

export fn dump_typed_names(decls: List ast.Decl, env: Dict types.Scheme) -> Unit !{IO} =
  match decls with
  | Nil -> ()
  | Cons d rest ->
      do
        dump_decl_name(d, env)
        dump_typed_names(rest, env)

fn dump_decl_name(d: ast.Decl, env: Dict types.Scheme) -> Unit !{IO} =
  match d with
  | ast.FnDecl name _ _ _ _ _ _ -> print_name_scheme(name, env)
  | ast.LetDecl name _ _ _ -> print_name_scheme(name, env)
  | ast.TypeDecl _ _ ctors _ _ _ -> dump_ctor_names(ctors, env)
  | _ -> ()

fn dump_ctor_names(ctors: List ast.TypeConstructor, env: Dict types.Scheme) -> Unit !{IO} =
  match ctors with
  | Nil -> ()
  | Cons ctor rest ->
      do
        match ctor with
        | ast.TypeConstructor ctor_name _ _ _ -> print_name_scheme(ctor_name, env)
        dump_ctor_names(rest, env)

fn print_name_scheme(name: String, env: Dict types.Scheme) -> Unit !{IO} =
  match dict_get(name, env) with
  | Nothing -> print(name ++ " : <not found>")
  | Just scheme -> print(name ++ " : " ++ types.scheme_to_string(scheme))

# ---------------------------------------------------------------------------
# Built-in typing environment
# ---------------------------------------------------------------------------
#
# Pre-populates the initial env with schemes for built-in functions and
# common prelude helpers.  This allows body inference to type-check calls to
# these functions rather than silently accepting them via the leniency rule.
#
# Type variable names ("a", "b", "v", "e") match conventional Sprout/Haskell
# usage; they are freshly instantiated at each call site by unifier.instantiate.
#
# Source-level TypeDecl/FnDecl/LetDecl declarations are added on top of this
# env by typecheck_decls, so source definitions always take precedence.

export fn dump_typed_program_names(prog: typed_ast.TypedProgram, env: Dict types.Scheme) -> Unit !{IO} =
  match prog with
  | typed_ast.TypedProgram decls -> dump_typed_decl_names(decls, env)

fn dump_typed_decl_names(decls: List typed_ast.TypedDecl, env: Dict types.Scheme) -> Unit !{IO} =
  match decls with
  | Nil -> ()
  | Cons d rest ->
      do
        match d with
        | typed_ast.TFnDecl name _ _ _ _ _ -> print_name_scheme(name, env)
        | typed_ast.TExternFnDecl name _ _ _ -> print_name_scheme(name, env)
        | typed_ast.TLetDecl name _ -> print_name_scheme(name, env)
        | typed_ast.TInstanceDecl _ _ _ -> ()
        | typed_ast.TPassThrough _ -> ()
        dump_typed_decl_names(rest, env)

export fn builtin_entries() -> List (String, types.Scheme) =
  analysis_entries()


# -- Type shortcuts ----------------------------------------------------------

fn bt_str() -> types.Type = types.TConst(types.type_id("String"))
fn bt_int() -> types.Type = types.TConst(types.type_id("Int"))
fn bt_unit() -> types.Type = types.TConst(types.type_id("Unit"))

fn bt_vec(t: types.Type) -> types.Type = types.TApp(types.TConst(types.type_id("Vec")), t)
fn bt_result(e: types.Type, a: types.Type) -> types.Type =
  types.TApp(types.TApp(types.TConst(types.type_id("Result")), e), a)

fn bt_fn(a: types.Type, b: types.Type) -> types.Type =
  types.TFunc(a, b, types.EffectPure, types.OwnConsume)
fn bt_io(a: types.Type, b: types.Type) -> types.Type =
  types.TFunc(a, b, types.EffectIO, types.OwnConsume)

fn bt_mono(t: types.Type) -> types.Scheme =
  types.Scheme(Nil, Nil, t, types.EffectPure, Nil)

fn bt_pair(a: types.Type, b: types.Type) -> types.Type =
  types.TTuple([a, b])

fn bt_triple(a: types.Type, b: types.Type, c: types.Type) -> types.Type =
  types.TTuple([a, b, c])

fn bt_quad(a: types.Type, b: types.Type, c: types.Type, d: types.Type) -> types.Type =
  types.TTuple([a, b, c, d])


# Analysis bridge builtins — C functions provided by sprout_runtime.c analysis bridge.
# Used by stdlib/compiler.sprout.
# These functions are intentionally NOT declared as `extern fn` in prelude.sprout.
# build_extern_sigs_from_decls overwrites compiler_intrinsic_sigs() entries via dict_set,
# so an `extern fn String` declaration would replace the ll_ptr() intrinsic entry with an
# ll_i64() entry, breaking the const char* calling convention. Intrinsics only win when
# there is no matching extern fn declaration for the same name.
fn analysis_entries() -> List (String, types.Scheme) =
  [("analysis_check_source",
      bt_mono(bt_io(bt_str(), bt_result(bt_str(), bt_unit()))))
  , ("analysis_declared_names_in_source",
      bt_mono(bt_io(bt_str(), bt_result(bt_str(), bt_vec(bt_str())))))
  , ("analysis_exported_names_in_source",
      bt_mono(bt_io(bt_str(), bt_result(bt_str(), bt_vec(bt_str())))))
  , ("analysis_type_of_in_source",
      bt_mono(bt_fn(bt_str(), bt_io(bt_str(), bt_result(bt_str(), bt_str())))))
  , ("analysis_eval_expr_in_source",
      bt_mono(bt_fn(bt_str(), bt_io(bt_str(), bt_result(bt_str(), bt_vec(bt_str()))))))
  , ("analysis_instances_in_source",
      bt_mono(bt_fn(bt_str(), bt_io(bt_str(), bt_result(bt_str(), bt_pair(bt_str(), bt_vec(bt_str())))))))
  , ("analysis_symbol_inventory_in_source",
      bt_mono(bt_io(bt_str(), bt_result(bt_str(), bt_triple(bt_vec(bt_str()), bt_vec(bt_str()), bt_vec(bt_str()))))))
  , ("analysis_diagnostics_in_source",
      bt_mono(bt_io(bt_str(), bt_vec(bt_triple(bt_str(), bt_int(), bt_int())))))
  , ("analysis_symbol_locations_in_source",
      bt_mono(bt_io(bt_str(), bt_result(bt_str(), bt_vec(bt_quad(bt_str(), bt_str(), bt_int(), bt_int()))))))
  , ("analysis_complete_in_state",
      bt_mono(bt_fn(bt_str(), bt_fn(bt_vec(bt_str()), bt_io(bt_vec(bt_str()), bt_pair(bt_str(), bt_vec(bt_str())))))))
  ]
