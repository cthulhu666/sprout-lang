  , ("string.find",              bt_mono(bt_fn2(bt_str(), bt_str(), bt_int())))
  , ("string.starts_with",       bt_mono(bt_fn2(bt_str(), bt_str(), bt_bool())))
  , ("string.contains",          bt_mono(bt_fn2(bt_str(), bt_str(), bt_bool())))
  , ("string.char_at",           bt_mono(bt_fn2(bt_str(), bt_int(), bt_maybe(bt_char()))))
  , ("string.char_at_or",        bt_mono(bt_fn3(bt_str(), bt_int(), bt_char(), bt_char())))
  , ("string.string_from_char",  bt_mono(bt_fn(bt_char(), bt_str())))
  , ("string.is_ascii_whitespace", bt_mono(bt_fn(bt_char(), bt_bool())))
  , ("string.is_ascii_digit",    bt_mono(bt_fn(bt_char(), bt_bool())))
  , ("string.is_ident_start",    bt_mono(bt_fn(bt_char(), bt_bool())))
  , ("string.is_ident_continue", bt_mono(bt_fn(bt_char(), bt_bool())))
  ]

# Prelude functions that stdlib modules use without an explicit import.
# These are defined in stdlib/prelude.sprout but must be visible when the
# module_loader checks stdlib/*.sprout files in isolation (no bundler step).
# filter_own_pairs strips these from a module's own exports, so they don't
# pollute the namespace.
fn bt_pair(a: types.Type, b: types.Type) -> types.Type =
  types.TTuple(Cons(a, Cons(b, Nil)))

fn prelude_ext_entries() -> List (String, types.Scheme) =
  [ ("dict_entries",   bt_poly1("v", bt_fn(bt_dict(bt_v()), bt_vec(bt_pair(bt_str(), bt_v())))))
  , ("dict_from_list", bt_poly1("v", bt_fn(bt_list(bt_pair(bt_str(), bt_v())), bt_dict(bt_v()))))
  , ("vec_to_list",    bt_poly1("a", bt_fn(bt_vec_a(), bt_list(bt_a()))))
  , ("vec_singleton",  bt_poly1("a", bt_fn(bt_a(), bt_vec_a())))
  , ("vec_map",        bt_poly2("a", "b", bt_fn2(bt_fn(bt_a(), bt_b()), bt_vec_a(), bt_vec(bt_b()))))
  , ("vec_fold",       bt_poly2("a", "b", bt_fn3(bt_fn2(bt_b(), bt_a(), bt_b()), bt_b(), bt_vec_a(), bt_b())))
  , ("vec_filter",     bt_poly1("a", bt_fn2(bt_fn(bt_a(), bt_bool()), bt_vec_a(), bt_vec_a())))
  , ("vec_reverse",    bt_poly1("a", bt_fn(bt_vec_a(), bt_vec_a())))
  , ("vec_any",        bt_poly1("a", bt_fn2(bt_fn(bt_a(), bt_bool()), bt_vec_a(), bt_bool())))
  , ("vec_all",        bt_poly1("a", bt_fn2(bt_fn(bt_a(), bt_bool()), bt_vec_a(), bt_bool())))
  , ("vec_count",      bt_poly1("a", bt_fn2(bt_fn(bt_a(), bt_bool()), bt_vec_a(), bt_int())))
  , ("vec_sum",        bt_mono(bt_fn(bt_vec(bt_int()), bt_int())))
  , ("vec_sum_by",     bt_poly1("a", bt_fn2(bt_fn(bt_a(), bt_int()), bt_vec_a(), bt_int())))
  , ("vec_filter_map", bt_poly2("a", "b", bt_fn2(bt_fn(bt_a(), bt_maybe(bt_b())), bt_vec_a(), bt_vec(bt_b()))))
  , ("pipe",           bt_poly2("a", "b", bt_fn2(bt_fn(bt_a(), bt_b()), bt_a(), bt_b())))
  , ("list_length",    bt_poly1("a", bt_fn(bt_list(bt_a()), bt_int())))
  , ("fold",           bt_poly2("a", "b", bt_fn3(bt_fn2(bt_b(), bt_a(), bt_b()), bt_b(), bt_list(bt_a()), bt_b())))
  , ("map",            bt_poly2("a", "b", bt_fn2(bt_fn(bt_a(), bt_b()), bt_list(bt_a()), bt_list(bt_b()))))
  , ("split_ints",     bt_mono(bt_fn(bt_str(), bt_list(bt_int()))))
  ]

fn bt_bytes()   -> types.Type = types.TConst("Bytes")
