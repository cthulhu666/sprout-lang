module stdlib.compiler.dce
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.ast as ast
import stdlib.compiler.source as source

# Declaration reachability: `elim_unreachable` drops whole declarations that the entry
# point cannot reach. It is applied after typeclass lowering and before IR emission.
#
# There is no dead-`let` elimination. A do-block `let` runs even when its name is
# never read (docs/spec-v0.md §6 rule 4), and a pure right-hand side can still
# panic: `panic` is pure, Int `+ - *` and unary `-` panic on overflow, `/` panics
# on zero. Deleting the binding would delete the panic. The call-purity oracle ("can this
# call do IO") is `typed_ast.callee_is_pure`.

# ---------------------------------------------------------------------------
# Binders
# ---------------------------------------------------------------------------

# The names a construct binds, for reachability below.
fn bind_param(p: ast.Param, bound: Set) -> Set =
  match p with
  | ast.Param n _ _ -> set_insert(n, bound)

fn bind_params(ps: List ast.Param, bound: Set) -> Set =
  match ps with
  | Nil -> bound
  | Cons p rest -> bind_params(rest, bind_param(p, bound))

fn bind_pat(pat: ast.Pattern, bound: Set) -> Set =
  list_fold(\ (s, n) -> set_insert(n, s), bound, ast.pattern_names(pat))

# ---------------------------------------------------------------------------
# Declaration reachability elimination
# ---------------------------------------------------------------------------
#
# This section drops whole declarations nothing reaches, which is what stops every
# program from carrying the entire prelude: before it, a six-line `module main` emitted 276 functions
# of which 3 were reachable.
#
# Running after `lowering.lower_program` is what makes plain name reachability
# sufficient. Lowering has already expanded TDict evidence into concrete
# instance-function references and flattened each instance into
# `__tc_{Class}_{mangled}_{method}` TFnDecls, so by this point every live edge —
# including every typeclass dispatch — is an ordinary TVar.
#
# The pass errs in one direction only: an invented edge costs lines, a missed one
# is a link failure or a silently missing instance. Any construct whose scoping
# this file does not model must therefore fall on the "invent the edge" side.

# Names an expression references. `bound` holds the names a lambda parameter,
# match binder or do-binding has taken: a TVar naming one of those is a local, and
# an edge from it to a top-level declaration of that name would be invented.
fn refs_expr(e: typed_ast.TypedExpr, bound: Set, acc: Set) -> Set =
  match e with
  | typed_ast.TVar n _ _ -> if set_member(n, bound) then acc else set_insert(n, acc)
  | typed_ast.TInt _ _ _ -> acc
  | typed_ast.TFloat _ _ _ -> acc
  | typed_ast.TBool _ _ _ -> acc
  | typed_ast.TString _ _ _ -> acc
  | typed_ast.TChar _ _ _ -> acc
  | typed_ast.TUnit _ _ -> acc
  | typed_ast.TTuple items _ _ -> refs_list(items, bound, acc)
  | typed_ast.TIf cond thn els _ _ ->
      refs_expr(els, bound, refs_expr(thn, bound, refs_expr(cond, bound, acc)))
  | typed_ast.TMatch scrut arms _ _ -> refs_arms(arms, bound, refs_expr(scrut, bound, acc))
  | typed_ast.TCall callee args _ _ -> refs_list(args, bound, refs_expr(callee, bound, acc))
  # Neither can survive lowering — ast_to_ir rejects a TDict outright. Panicking
  # rather than returning `acc` keeps a future regression loud: silently
  # reporting "no references" here would delete the instance functions a
  # surviving dictionary points at.
  | typed_ast.TDict _ _ _ _ -> panic("dce.refs_expr: TDict survived lowering (internal error)")
  | typed_ast.TMethodRef _ _ _ _ _ -> panic("dce.refs_expr: TMethodRef survived lowering (internal error)")
  | typed_ast.TLambda params body _ _ -> refs_expr(body, bind_params(params, bound), acc)
  # `++` on lists lowers to a call to the prelude's `list_append` whose name is a
  # STRING LITERAL in codegen (ast_to_ir.sprout:5400), so no TVar names it. Rooted
  # for every `++` rather than only for list operands: reproducing codegen's
  # `is_list_type` test here would be a second copy of a rule that must agree, and
  # the cost of being wrong is a deleted callee. String `++` lowers to the
  # `str_concat` extern, which is kept anyway.
  | typed_ast.TBinary op l r _ _ ->
      if op == "++" then
        set_insert("list_append", refs_expr(r, bound, refs_expr(l, bound, acc)))
      else refs_expr(r, bound, refs_expr(l, bound, acc))
  | typed_ast.TUnary _ operand _ _ -> refs_expr(operand, bound, acc)
  # Likewise `a..b`, which lowers to a literal-named `range_up` call
  # (ast_to_ir.sprout:1104) rather than to an inline IntRange construction.
  | typed_ast.TRange l r _ _ ->
      set_insert("range_up", refs_expr(r, bound, refs_expr(l, bound, acc)))
  | typed_ast.TDo steps _ _ -> refs_steps(steps, bound, acc)
  | typed_ast.TRecord _ fields _ _ -> refs_fields(fields, bound, acc)
  | typed_ast.TGetField obj _ _ _ -> refs_expr(obj, bound, acc)
  | typed_ast.TRecordUpdate base fields _ _ ->
      refs_fields(fields, bound, refs_expr(base, bound, acc))

fn refs_list(es: List typed_ast.TypedExpr, bound: Set, acc: Set) -> Set =
  match es with
  | Nil -> acc
  | Cons e rest -> refs_list(rest, bound, refs_expr(e, bound, acc))

# A pattern's own names are binders, not references: a constructor lowers to an
# inline allocation rather than to a callable symbol, so nothing in a pattern
# could be pruned by name.
fn refs_arms(arms: List typed_ast.TypedMatchBranch, bound: Set, acc: Set) -> Set =
  match arms with
  | Nil -> acc
  | Cons arm rest ->
      match arm with
      | typed_ast.TypedMatchBranch pat body ->
          refs_arms(rest, bound, refs_expr(body, bind_pat(pat, bound), acc))

fn refs_fields(fields: List typed_ast.TypedRecordField, bound: Set, acc: Set) -> Set =
  match fields with
  | Nil -> acc
  | Cons f rest ->
      match f with
      | typed_ast.TypedRecordField _ v -> refs_fields(rest, bound, refs_expr(v, bound, acc))

# A do-binding scopes over the steps that FOLLOW it, never over its own
# right-hand side.
fn refs_steps(steps: List typed_ast.TypedDoStep, bound: Set, acc: Set) -> Set =
  match steps with
  | Nil -> acc
  | Cons step rest ->
      match step with
      | typed_ast.TDoBindStep pat e _ ->
          refs_steps(rest, bind_pat(pat, bound), refs_expr(e, bound, acc))
      | typed_ast.TDoLetStep n e ->
          refs_steps(rest, set_insert(n, bound), refs_expr(e, bound, acc))
      | typed_ast.TDoExprStep e -> refs_steps(rest, bound, refs_expr(e, bound, acc))

fn refs_instance_methods(ms: List typed_ast.TypedInstanceMethod, acc: Set) -> Set =
  match ms with
  | Nil -> acc
  | Cons m rest ->
      match m with
      | typed_ast.TypedInstanceMethod _ params _ _ _ body ->
          refs_instance_methods(rest, refs_expr(body, bind_params(params, set_empty()), acc))

# A pass-through carries a declaration the typed pipeline had no typed form for.
# Today that is only type-level: a type, record, class, alias or wrap, none of
# which reference a value. A VALUE declaration arriving here would carry a body
# this walker cannot see, and pruning around it could delete a live callee — so
# it is a hard error rather than an assumption.
fn refs_passthrough(d: ast.Decl, acc: Set) -> Set =
  match d with
  | ast.TypeDecl _ _ _ _ _ _ _ -> acc
  | ast.RecordDecl _ _ _ _ _ _ _ -> acc
  | ast.ClassDecl _ _ _ _ _ -> acc
  | ast.AliasDecl _ _ _ _ -> acc
  | ast.WrapDecl _ _ _ _ _ _ _ -> acc
  | ast.ExternFnDecl _ _ _ _ _ _ _ -> acc
  | ast.FnDecl name _ _ _ _ _ _ _ ->
      panic("dce.refs_passthrough: untyped FnDecl `" ++ name ++ "` reached codegen (internal error)")
  | ast.LetDecl name _ _ _ ->
      panic("dce.refs_passthrough: untyped LetDecl `" ++ name ++ "` reached codegen (internal error)")
  | ast.InstanceDecl _ _ _ _ _ ->
      panic("dce.refs_passthrough: untyped InstanceDecl reached codegen (internal error)")

fn refs_decl(d: typed_ast.TypedDecl, acc: Set) -> Set =
  match d with
  | typed_ast.TFnDecl _ params _ _ _ body -> refs_expr(body, bind_params(params, set_empty()), acc)
  | typed_ast.TExternFnDecl _ _ _ _ -> acc
  | typed_ast.TLetDecl _ e -> refs_expr(e, set_empty(), acc)
  # Lowering replaces every instance with generated TFnDecls, so this arm is
  # defensive. Traversing rather than ignoring keeps it safe if that changes.
  | typed_ast.TInstanceDecl _ _ methods -> refs_instance_methods(methods, acc)
  | typed_ast.TPassThrough decl -> refs_passthrough(decl, acc)

# A declaration kept regardless of who references it — so also a starting point
# for reachability, since whatever its body calls is live too.
#
# Externs lower to `declare` lines whose absence is a link error, and pass-through
# type declarations are reached from patterns and field access rather than by
# name, so neither is a candidate for pruning.
fn is_rooted_decl(d: typed_ast.TypedDecl) -> Bool =
  match d with
  | typed_ast.TFnDecl name _ _ _ _ _ -> source.is_entry_main(name)
  | typed_ast.TExternFnDecl _ _ _ _ -> true
  # Order-sensitive and effectively free to keep: the prelude declares none.
  | typed_ast.TLetDecl _ _ -> true
  | typed_ast.TInstanceDecl _ _ _ -> true
  | typed_ast.TPassThrough _ -> true

# name -> declaration, so the worklist resolves an edge in O(log n).
fn decl_index(decls: List typed_ast.TypedDecl, acc: Dict typed_ast.TypedDecl) -> Dict typed_ast.TypedDecl =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match typed_ast.decl_name(d) with
      | Nothing -> decl_index(rest, acc)
      | Just name -> decl_index(rest, dict_set(name, d, acc))

# Names reachable from the always-kept declarations, plus those names themselves.
#
# The worklist marks a name live on POP rather than on push, so one already live
# is skipped before its body is walked again — which is what lets a self- or
# mutually-recursive DEAD cluster terminate without rooting itself. A pass built
# on "is this name referenced anywhere?" keeps both of those clusters forever.
fn close_over(queue: List String, index: Dict typed_ast.TypedDecl, live: Set) -> Set =
  match queue with
  | Nil -> live
  | Cons name rest ->
      if set_member(name, live) then close_over(rest, index, live)
      else
        match dict_get(name, index) with
        | Nothing -> close_over(rest, index, set_insert(name, live))
        | Just d ->
            close_over(list_append(set_to_list(refs_decl(d, set_empty())), rest),
                       index, set_insert(name, live))

fn seed_queue(decls: List typed_ast.TypedDecl, acc: List String) -> List String =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      if !is_rooted_decl(d) then seed_queue(rest, acc)
      else
        match typed_ast.decl_name(d) with
        | Nothing -> seed_queue(rest, list_append(set_to_list(refs_decl(d, set_empty())), acc))
        | Just name -> seed_queue(rest, Cons(name, acc))

fn keep_live(decls: List typed_ast.TypedDecl, live: Set) -> List typed_ast.TypedDecl =
  match decls with
  | Nil -> Nil
  | Cons d rest ->
      if is_rooted_decl(d) then Cons(d, keep_live(rest, live))
      else
        match typed_ast.decl_name(d) with
        | Nothing -> Cons(d, keep_live(rest, live))
        | Just name ->
            if set_member(name, live) then Cons(d, keep_live(rest, live))
            else keep_live(rest, live)

fn has_entry(decls: List typed_ast.TypedDecl) -> Bool =
  match decls with
  | Nil -> false
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name _ _ _ _ _ -> if source.is_entry_main(name) then true else has_entry(rest)
      | _ -> has_entry(rest)

# Drop every declaration the entry point cannot reach.
#
# WITH NO ENTRY POINT THIS IS A NO-OP, and that is a correctness requirement, not
# a nicety. `compile_program_streaming` also translates FRAGMENTS: the differential
# IR-shape tests (`test_ir_call_result_rooting`, `test_ir_tuple_result_rooting`)
# hand it a few functions with no `main` and count root pushes in the result.
# Rooting from nothing would prune everything, and those tests would compare zero
# against zero and pass for the wrong reason on the way to failing. A program
# without an entry is not a program whose every declaration is unreachable — it is
# one where reachability is not defined, so nothing is claimed and nothing is cut.
#
# O(total expression nodes × log n): each reachable declaration's body is walked
# once, and every set operation is an AVL insert or lookup.
export fn elim_unreachable(prog: typed_ast.TypedProgram) -> typed_ast.TypedProgram =
  match prog with
  | typed_ast.TypedProgram decls ->
      if !has_entry(decls) then prog
      else
        typed_ast.TypedProgram(
          keep_live(decls,
                    close_over(seed_queue(decls, Nil), decl_index(decls, dict_empty()), set_empty())))
