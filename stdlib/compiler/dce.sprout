module stdlib.compiler.dce
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types
import stdlib.compiler.ast as ast

# Two eliminations, both applied after typeclass lowering and before IR emission.
#
# Dead Let Elimination (DLE) — `elim_program`. Removes TDoLetStep name expr from
# TDo blocks where:
#   (1) name does not appear free in any subsequent do-step, and
#   (2) expr is pure (has no observable side effects)
# Recurses into all expression positions so nested TDo blocks are optimised too.
#
# Declaration reachability — `elim_unreachable`. Drops whole declarations that
# the entry point cannot reach. See the section at the bottom of this file.
#
# The two are independent and DLE runs first: shrinking bodies can only remove
# references, so it can only ever make reachability drop MORE. Running them the
# other way round would still be correct, merely weaker.

# ---------------------------------------------------------------------------
# Purity check
# ---------------------------------------------------------------------------

fn is_pure_callee_type(t: types.Type) -> Bool =
  match t with
  | types.TFunc _ _ eff _ -> match eff with
      | types.EffectPure -> true
      | _ -> false
  | _ -> false

fn is_pure_expr(e: typed_ast.TypedExpr) -> Bool =
  match e with
  | typed_ast.TVar _ _ _ -> true
  | typed_ast.TInt _ _ _ -> true
  | typed_ast.TFloat _ _ _ -> true
  | typed_ast.TBool _ _ _ -> true
  | typed_ast.TString _ _ _ -> true
  | typed_ast.TChar _ _ _ -> true
  | typed_ast.TUnit _ _ -> true
  | typed_ast.TTuple items _ _ -> all_pure_list(items)
  | typed_ast.TIf cond thn els _ _ ->
      is_pure_expr(cond) && is_pure_expr(thn) && is_pure_expr(els)
  | typed_ast.TMatch scrut arms _ _ ->
      is_pure_expr(scrut) && all_pure_arms(arms)
  | typed_ast.TCall callee args _ _ ->
      is_pure_callee_type(typed_ast.typed_expr_type(callee)) &&
      is_pure_expr(callee) && all_pure_list(args)
  | typed_ast.TDict _ _ _ _ -> true
  | typed_ast.TMethodRef _ _ _ _ _ -> panic("dce.is_pure_expr: TMethodRef survived lowering (internal error)")
  | typed_ast.TLambda _ _ _ _ -> true
  | typed_ast.TBinary _ l r _ _ -> is_pure_expr(l) && is_pure_expr(r)
  | typed_ast.TUnary _ operand _ _ -> is_pure_expr(operand)
  | typed_ast.TRange l r _ _ -> is_pure_expr(l) && is_pure_expr(r)
  | typed_ast.TDo _ _ _ -> false
  | typed_ast.TRecord _ fields _ _ -> all_pure_fields(fields)
  | typed_ast.TGetField obj _ _ _ -> is_pure_expr(obj)
  | typed_ast.TRecordUpdate base fields _ _ -> is_pure_expr(base) && all_pure_fields(fields)

fn all_pure_list(es: List typed_ast.TypedExpr) -> Bool =
  match es with
  | Nil -> true
  | Cons e rest -> is_pure_expr(e) && all_pure_list(rest)

fn all_pure_arms(arms: List typed_ast.TypedMatchBranch) -> Bool =
  match arms with
  | Nil -> true
  | Cons arm rest ->
      match arm with
      | typed_ast.TypedMatchBranch _ body -> is_pure_expr(body) && all_pure_arms(rest)

fn all_pure_fields(fields: List typed_ast.TypedRecordField) -> Bool =
  match fields with
  | Nil -> true
  | Cons f rest ->
      match f with
      | typed_ast.TypedRecordField _ v -> is_pure_expr(v) && all_pure_fields(rest)

# ---------------------------------------------------------------------------
# Free-variable check — is `name` free anywhere in the given construct?
# ---------------------------------------------------------------------------

fn param_binds(name: String, p: ast.Param) -> Bool =
  match p with
  | ast.Param n _ _ -> n == name

fn params_bind(name: String, ps: List ast.Param) -> Bool =
  match ps with
  | Nil -> false
  | Cons p rest -> param_binds(name, p) || params_bind(name, rest)

fn pat_binds(name: String, pat: ast.Pattern) -> Bool =
  match pat with
  | ast.VarPattern n _ -> n == name
  | ast.WildcardPattern _ -> false
  | ast.IntPattern _ _ -> false
  | ast.BoolPattern _ _ -> false
  | ast.StringPattern _ _ -> false
  | ast.CharPattern _ _ -> false
  | ast.UnitPattern _ -> false
  | ast.TuplePattern pats _ -> any_pat_binds(name, pats)
  | ast.ConstructorPattern _ pats _ -> any_pat_binds(name, pats)

fn any_pat_binds(name: String, pats: List ast.Pattern) -> Bool =
  match pats with
  | Nil -> false
  | Cons p rest -> pat_binds(name, p) || any_pat_binds(name, rest)

fn is_free(name: String, e: typed_ast.TypedExpr) -> Bool =
  match e with
  | typed_ast.TVar n _ _ -> n == name
  | typed_ast.TInt _ _ _ -> false
  | typed_ast.TFloat _ _ _ -> false
  | typed_ast.TBool _ _ _ -> false
  | typed_ast.TString _ _ _ -> false
  | typed_ast.TChar _ _ _ -> false
  | typed_ast.TUnit _ _ -> false
  | typed_ast.TTuple items _ _ -> any_free_list(name, items)
  | typed_ast.TIf cond thn els _ _ ->
      is_free(name, cond) || is_free(name, thn) || is_free(name, els)
  | typed_ast.TMatch scrut arms _ _ ->
      is_free(name, scrut) || any_free_arms(name, arms)
  | typed_ast.TCall callee args _ _ ->
      is_free(name, callee) || any_free_list(name, args)
  | typed_ast.TDict _ _ _ _ -> false
  | typed_ast.TMethodRef _ _ _ _ _ -> panic("dce.is_free: TMethodRef survived lowering (internal error)")
  | typed_ast.TLambda params body _ _ ->
      if params_bind(name, params) then false else is_free(name, body)
  | typed_ast.TBinary _ l r _ _ -> is_free(name, l) || is_free(name, r)
  | typed_ast.TUnary _ operand _ _ -> is_free(name, operand)
  | typed_ast.TRange l r _ _ -> is_free(name, l) || is_free(name, r)
  | typed_ast.TDo steps _ _ -> is_free_in_steps(name, steps)
  | typed_ast.TRecord _ fields _ _ -> any_free_fields(name, fields)
  | typed_ast.TGetField obj _ _ _ -> is_free(name, obj)
  | typed_ast.TRecordUpdate base fields _ _ -> is_free(name, base) || any_free_fields(name, fields)

fn any_free_list(name: String, es: List typed_ast.TypedExpr) -> Bool =
  match es with
  | Nil -> false
  | Cons e rest -> is_free(name, e) || any_free_list(name, rest)

fn any_free_arms(name: String, arms: List typed_ast.TypedMatchBranch) -> Bool =
  match arms with
  | Nil -> false
  | Cons arm rest ->
      match arm with
      | typed_ast.TypedMatchBranch pat body ->
          (if pat_binds(name, pat) then false else is_free(name, body)) ||
          any_free_arms(name, rest)

fn any_free_fields(name: String, fields: List typed_ast.TypedRecordField) -> Bool =
  match fields with
  | Nil -> false
  | Cons f rest ->
      match f with
      | typed_ast.TypedRecordField _ v -> is_free(name, v) || any_free_fields(name, rest)

fn is_free_in_steps(name: String, steps: List typed_ast.TypedDoStep) -> Bool =
  match steps with
  | Nil -> false
  | Cons step rest ->
      match step with
      | typed_ast.TDoBindStep pat e ->
          is_free(name, e) ||
          (if pat_binds(name, pat) then false else is_free_in_steps(name, rest))
      | typed_ast.TDoLetStep n e ->
          is_free(name, e) ||
          (if n == name then false else is_free_in_steps(name, rest))
      | typed_ast.TDoExprStep e ->
          is_free(name, e) || is_free_in_steps(name, rest)

# ---------------------------------------------------------------------------
# Rewrite pass — bottom-up elimination; recurses into all expression positions
# ---------------------------------------------------------------------------

fn elim_expr(e: typed_ast.TypedExpr) -> typed_ast.TypedExpr =
  match e with
  | typed_ast.TVar _ _ _ -> e
  | typed_ast.TInt _ _ _ -> e
  | typed_ast.TFloat _ _ _ -> e
  | typed_ast.TBool _ _ _ -> e
  | typed_ast.TString _ _ _ -> e
  | typed_ast.TChar _ _ _ -> e
  | typed_ast.TUnit _ _ -> e
  | typed_ast.TTuple items t p ->
      typed_ast.TTuple(elim_list(items), t, p)
  | typed_ast.TIf cond thn els t p ->
      typed_ast.TIf(elim_expr(cond), elim_expr(thn), elim_expr(els), t, p)
  | typed_ast.TMatch scrut arms t p ->
      typed_ast.TMatch(elim_expr(scrut), elim_arms(arms), t, p)
  | typed_ast.TCall callee args t p ->
      typed_ast.TCall(elim_expr(callee), elim_list(args), t, p)
  | typed_ast.TDict _ _ _ _ -> e
  | typed_ast.TMethodRef _ _ _ _ _ -> panic("dce.elim_expr: TMethodRef survived lowering (internal error)")
  | typed_ast.TLambda params body t p ->
      typed_ast.TLambda(params, elim_expr(body), t, p)
  | typed_ast.TBinary op l r t p ->
      typed_ast.TBinary(op, elim_expr(l), elim_expr(r), t, p)
  | typed_ast.TUnary op operand t p ->
      typed_ast.TUnary(op, elim_expr(operand), t, p)
  | typed_ast.TRange l r t p ->
      typed_ast.TRange(elim_expr(l), elim_expr(r), t, p)
  | typed_ast.TDo steps t p ->
      typed_ast.TDo(elim_steps(steps), t, p)
  | typed_ast.TRecord name fields t p ->
      typed_ast.TRecord(name, elim_record_fields(fields), t, p)
  | typed_ast.TGetField obj fname t p ->
      typed_ast.TGetField(elim_expr(obj), fname, t, p)
  | typed_ast.TRecordUpdate base fields t p ->
      typed_ast.TRecordUpdate(elim_expr(base), elim_record_fields(fields), t, p)

fn elim_list(es: List typed_ast.TypedExpr) -> List typed_ast.TypedExpr =
  match es with
  | Nil -> Nil
  | Cons e rest -> Cons(elim_expr(e), elim_list(rest))

fn elim_arms(arms: List typed_ast.TypedMatchBranch) -> List typed_ast.TypedMatchBranch =
  match arms with
  | Nil -> Nil
  | Cons arm rest ->
      match arm with
      | typed_ast.TypedMatchBranch pat body ->
          Cons(typed_ast.TypedMatchBranch(pat, elim_expr(body)), elim_arms(rest))

fn elim_record_fields(fields: List typed_ast.TypedRecordField) -> List typed_ast.TypedRecordField =
  match fields with
  | Nil -> Nil
  | Cons f rest ->
      match f with
      | typed_ast.TypedRecordField name v ->
          Cons(typed_ast.TypedRecordField(name, elim_expr(v)), elim_record_fields(rest))

# elim_steps processes bottom-up: the tail is already optimised when checking
# whether the current step's binding is dead.
fn elim_steps(steps: List typed_ast.TypedDoStep) -> List typed_ast.TypedDoStep =
  match steps with
  | Nil -> Nil
  | Cons step rest -> elim_one_step(step, elim_steps(rest))

fn elim_one_step(step: typed_ast.TypedDoStep, tail: List typed_ast.TypedDoStep) -> List typed_ast.TypedDoStep =
  match step with
  | typed_ast.TDoLetStep name e ->
      if is_pure_expr(e) && (is_free_in_steps(name, tail) == false)
      then tail
      else Cons(typed_ast.TDoLetStep(name, elim_expr(e)), tail)
  | typed_ast.TDoBindStep pat e ->
      Cons(typed_ast.TDoBindStep(pat, elim_expr(e)), tail)
  | typed_ast.TDoExprStep e ->
      Cons(typed_ast.TDoExprStep(elim_expr(e)), tail)

fn elim_instance_methods(ms: List typed_ast.TypedInstanceMethod) -> List typed_ast.TypedInstanceMethod =
  match ms with
  | Nil -> Nil
  | Cons m rest ->
      match m with
      | typed_ast.TypedInstanceMethod name params ret_ann eff_ann body ->
          Cons(typed_ast.TypedInstanceMethod(name, params, ret_ann, eff_ann, elim_expr(body)),
               elim_instance_methods(rest))

fn elim_decl(d: typed_ast.TypedDecl) -> typed_ast.TypedDecl =
  match d with
  | typed_ast.TFnDecl name params ret_ann eff_ann constraints body ->
      typed_ast.TFnDecl(name, params, ret_ann, eff_ann, constraints, elim_expr(body))
  | typed_ast.TExternFnDecl _ _ _ _ -> d
  | typed_ast.TLetDecl name e ->
      typed_ast.TLetDecl(name, elim_expr(e))
  | typed_ast.TInstanceDecl constraint constraints methods ->
      typed_ast.TInstanceDecl(constraint, constraints, elim_instance_methods(methods))
  | typed_ast.TPassThrough _ -> d

fn elim_decls(ds: List typed_ast.TypedDecl) -> List typed_ast.TypedDecl =
  match ds with
  | Nil -> Nil
  | Cons d rest -> Cons(elim_decl(d), elim_decls(rest))

# O(n) in the number of TypedExpr nodes; is_free_in_steps adds O(steps × expr_size)
# per do-block, which is bounded in practice.
export fn elim_program(prog: typed_ast.TypedProgram) -> typed_ast.TypedProgram =
  match prog with
  | typed_ast.TypedProgram (decls) -> typed_ast.TypedProgram(elim_decls(decls))

# ---------------------------------------------------------------------------
# Declaration reachability elimination
# ---------------------------------------------------------------------------
#
# Everything above rewrites declaration BODIES. This section drops whole
# declarations nothing reaches, which is what stops every program from carrying
# the entire prelude: before it, a six-line `module main` emitted 276 functions
# of which 3 were reachable.
#
# Running after `lowering.lower_program` is what makes plain name reachability
# sufficient. Lowering has already expanded TDict evidence into concrete
# instance-function references and flattened each instance into
# `__tc_{Class}_{mangled}_{method}` TFnDecls, so by this point every live edge —
# including every typeclass dispatch — is an ordinary TVar.
#
# The pass is deliberately IMPRECISE, in one direction only. It collects TVar
# names without tracking binders, so a lambda parameter or match binding that
# shares a top-level function's name adds an edge that keeps a dead function
# alive. That is the safe error: dropping a live declaration is a link failure
# or a silently missing instance, while keeping a dead one costs lines.
# `tests/stdlib/compiler/test_dce_reachable.spr` asserts the over-approximation
# directly, so making the pass precise means deleting a test on purpose.

# Names an expression references. Mirrors `is_free`'s traversal, but collecting
# instead of testing — and with no binder handling, per the note above.
fn refs_expr(e: typed_ast.TypedExpr, acc: Set) -> Set =
  match e with
  | typed_ast.TVar n _ _ -> set_insert(n, acc)
  | typed_ast.TInt _ _ _ -> acc
  | typed_ast.TFloat _ _ _ -> acc
  | typed_ast.TBool _ _ _ -> acc
  | typed_ast.TString _ _ _ -> acc
  | typed_ast.TChar _ _ _ -> acc
  | typed_ast.TUnit _ _ -> acc
  | typed_ast.TTuple items _ _ -> refs_list(items, acc)
  | typed_ast.TIf cond thn els _ _ -> refs_expr(els, refs_expr(thn, refs_expr(cond, acc)))
  | typed_ast.TMatch scrut arms _ _ -> refs_arms(arms, refs_expr(scrut, acc))
  | typed_ast.TCall callee args _ _ -> refs_list(args, refs_expr(callee, acc))
  # Neither can survive lowering — ast_to_ir rejects a TDict outright. Panicking
  # rather than returning `acc` keeps a future regression loud: silently
  # reporting "no references" here would delete the instance functions a
  # surviving dictionary points at.
  | typed_ast.TDict _ _ _ _ -> panic("dce.refs_expr: TDict survived lowering (internal error)")
  | typed_ast.TMethodRef _ _ _ _ _ -> panic("dce.refs_expr: TMethodRef survived lowering (internal error)")
  | typed_ast.TLambda _ body _ _ -> refs_expr(body, acc)
  # `++` on lists lowers to a call to the prelude's `list_append` whose name is a
  # STRING LITERAL in codegen (ast_to_ir.sprout:5400), so no TVar names it. Rooted
  # for every `++` rather than only for list operands: reproducing codegen's
  # `is_list_type` test here would be a second copy of a rule that must agree, and
  # the cost of being wrong is a deleted callee. String `++` lowers to the
  # `str_concat` extern, which is kept anyway.
  | typed_ast.TBinary op l r _ _ ->
      if op == "++" then set_insert("list_append", refs_expr(r, refs_expr(l, acc)))
      else refs_expr(r, refs_expr(l, acc))
  | typed_ast.TUnary _ operand _ _ -> refs_expr(operand, acc)
  # Likewise `a..b`, which lowers to a literal-named `range_up` call
  # (ast_to_ir.sprout:1104) rather than to an inline IntRange construction.
  | typed_ast.TRange l r _ _ -> set_insert("range_up", refs_expr(r, refs_expr(l, acc)))
  | typed_ast.TDo steps _ _ -> refs_steps(steps, acc)
  | typed_ast.TRecord _ fields _ _ -> refs_fields(fields, acc)
  | typed_ast.TGetField obj _ _ _ -> refs_expr(obj, acc)
  | typed_ast.TRecordUpdate base fields _ _ -> refs_fields(fields, refs_expr(base, acc))

fn refs_list(es: List typed_ast.TypedExpr, acc: Set) -> Set =
  match es with
  | Nil -> acc
  | Cons e rest -> refs_list(rest, refs_expr(e, acc))

# Pattern positions are not traversed: a constructor lowers to an inline
# allocation, never to a callable symbol, so a pattern references nothing that
# could be pruned.
fn refs_arms(arms: List typed_ast.TypedMatchBranch, acc: Set) -> Set =
  match arms with
  | Nil -> acc
  | Cons arm rest ->
      match arm with
      | typed_ast.TypedMatchBranch _ body -> refs_arms(rest, refs_expr(body, acc))

fn refs_fields(fields: List typed_ast.TypedRecordField, acc: Set) -> Set =
  match fields with
  | Nil -> acc
  | Cons f rest ->
      match f with
      | typed_ast.TypedRecordField _ v -> refs_fields(rest, refs_expr(v, acc))

fn refs_steps(steps: List typed_ast.TypedDoStep, acc: Set) -> Set =
  match steps with
  | Nil -> acc
  | Cons step rest ->
      match step with
      | typed_ast.TDoBindStep _ e -> refs_steps(rest, refs_expr(e, acc))
      | typed_ast.TDoLetStep _ e -> refs_steps(rest, refs_expr(e, acc))
      | typed_ast.TDoExprStep e -> refs_steps(rest, refs_expr(e, acc))

fn refs_instance_methods(ms: List typed_ast.TypedInstanceMethod, acc: Set) -> Set =
  match ms with
  | Nil -> acc
  | Cons m rest ->
      match m with
      | typed_ast.TypedInstanceMethod _ _ _ _ body ->
          refs_instance_methods(rest, refs_expr(body, acc))

# A pass-through carries a declaration the typed pipeline had no typed form for.
# Today that is only type-level: a type, record, class, alias or wrap, none of
# which reference a value. A VALUE declaration arriving here would carry a body
# this walker cannot see, and pruning around it could delete a live callee — so
# it is a hard error rather than an assumption.
fn refs_passthrough(d: ast.Decl, acc: Set) -> Set =
  match d with
  | ast.TypeDecl _ _ _ _ _ _ -> acc
  | ast.RecordDecl _ _ _ _ _ _ -> acc
  | ast.ClassDecl _ _ _ _ _ -> acc
  | ast.AliasDecl _ _ _ _ -> acc
  | ast.WrapDecl _ _ _ -> acc
  | ast.ExternFnDecl _ _ _ _ _ -> acc
  | ast.FnDecl name _ _ _ _ _ _ ->
      panic("dce.refs_passthrough: untyped FnDecl `" ++ name ++ "` reached codegen (internal error)")
  | ast.LetDecl name _ _ _ ->
      panic("dce.refs_passthrough: untyped LetDecl `" ++ name ++ "` reached codegen (internal error)")
  | ast.InstanceDecl _ _ _ _ ->
      panic("dce.refs_passthrough: untyped InstanceDecl reached codegen (internal error)")

fn refs_decl(d: typed_ast.TypedDecl, acc: Set) -> Set =
  match d with
  | typed_ast.TFnDecl _ _ _ _ _ body -> refs_expr(body, acc)
  | typed_ast.TExternFnDecl _ _ _ _ -> acc
  | typed_ast.TLetDecl _ e -> refs_expr(e, acc)
  # Lowering replaces every instance with generated TFnDecls, so this arm is
  # defensive. Traversing rather than ignoring keeps it safe if that changes.
  | typed_ast.TInstanceDecl _ _ methods -> refs_instance_methods(methods, acc)
  | typed_ast.TPassThrough decl -> refs_passthrough(decl, acc)

# The program entry: bare `main`, or the bundler-qualified `<module>.main` a file
# with a `module` header emits. Deliberately the same rule as codegen's
# `ast_to_ir.is_entry_fn_name`, so what this pass keeps and what codegen calls
# cannot disagree.
fn is_entry_name(name: String) -> Bool =
  name == "main" || (n >= 5 && str_slice(name, n - 5, 5) == ".main")
  where n = str_len(name)

# A declaration kept regardless of who references it — so also a starting point
# for reachability, since whatever its body calls is live too.
#
# Externs lower to `declare` lines whose absence is a link error, and pass-through
# type declarations are reached from patterns and field access rather than by
# name, so neither is a candidate for pruning.
fn is_rooted_decl(d: typed_ast.TypedDecl) -> Bool =
  match d with
  | typed_ast.TFnDecl name _ _ _ _ _ -> is_entry_name(name)
  | typed_ast.TExternFnDecl _ _ _ _ -> true
  # Order-sensitive and effectively free to keep: the prelude declares none.
  | typed_ast.TLetDecl _ _ -> true
  | typed_ast.TInstanceDecl _ _ _ -> true
  | typed_ast.TPassThrough _ -> true

fn decl_name_of(d: typed_ast.TypedDecl) -> Maybe String =
  match d with
  | typed_ast.TFnDecl name _ _ _ _ _ -> Just(name)
  | typed_ast.TExternFnDecl name _ _ _ -> Just(name)
  | typed_ast.TLetDecl name _ -> Just(name)
  | typed_ast.TInstanceDecl _ _ _ -> Nothing
  | typed_ast.TPassThrough _ -> Nothing

# name -> declaration, so the worklist resolves an edge in O(log n).
fn decl_index(decls: List typed_ast.TypedDecl, acc: Dict typed_ast.TypedDecl) -> Dict typed_ast.TypedDecl =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match decl_name_of(d) with
      | Nothing -> decl_index(rest, acc)
      | Just name -> decl_index(rest, dict_set(name, d, acc))

# Names reachable from the always-kept declarations, plus those names themselves.
#
# The worklist marks a name live on POP rather than on push, so one already live
# is skipped before its body is walked again — which is what lets a self- or
# mutually-recursive DEAD cluster terminate without rooting itself. A pass built
# on "is this name referenced anywhere?" keeps both of those clusters forever.
fn close_over(queue: List String, index: Dict typed_ast.TypedDecl, live: Set) -> Set =
  match queue with
  | Nil -> live
  | Cons name rest ->
      if set_member(name, live) then close_over(rest, index, live)
      else
        match dict_get(name, index) with
        | Nothing -> close_over(rest, index, set_insert(name, live))
        | Just d ->
            close_over(list_append(set_to_list(refs_decl(d, set_empty())), rest),
                       index, set_insert(name, live))

fn seed_queue(decls: List typed_ast.TypedDecl, acc: List String) -> List String =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      if ! is_rooted_decl (d) then seed_queue(rest, acc)
      else
        match decl_name_of(d) with
        | Nothing -> seed_queue(rest, list_append(set_to_list(refs_decl(d, set_empty())), acc))
        | Just name -> seed_queue(rest, Cons(name, acc))

fn keep_live(decls: List typed_ast.TypedDecl, live: Set) -> List typed_ast.TypedDecl =
  match decls with
  | Nil -> Nil
  | Cons d rest ->
      if is_rooted_decl(d) then Cons(d, keep_live(rest, live))
      else
        match decl_name_of(d) with
        | Nothing -> Cons(d, keep_live(rest, live))
        | Just name ->
            if set_member(name, live) then Cons(d, keep_live(rest, live))
            else keep_live(rest, live)

fn has_entry(decls: List typed_ast.TypedDecl) -> Bool =
  match decls with
  | Nil -> false
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name _ _ _ _ _ -> if is_entry_name(name) then true else has_entry(rest)
      | _ -> has_entry(rest)

# Drop every declaration the entry point cannot reach.
#
# WITH NO ENTRY POINT THIS IS A NO-OP, and that is a correctness requirement, not
# a nicety. `compile_program_streaming` also translates FRAGMENTS: the differential
# IR-shape tests (`test_ir_call_result_rooting`, `test_ir_tuple_result_rooting`)
# hand it a few functions with no `main` and count root pushes in the result.
# Rooting from nothing would prune everything, and those tests would compare zero
# against zero and pass for the wrong reason on the way to failing. A program
# without an entry is not a program whose every declaration is unreachable — it is
# one where reachability is not defined, so nothing is claimed and nothing is cut.
#
# O(total expression nodes × log n): each reachable declaration's body is walked
# once, and every set operation is an AVL insert or lookup.
export fn elim_unreachable(prog: typed_ast.TypedProgram) -> typed_ast.TypedProgram =
  match prog with
  | typed_ast.TypedProgram decls ->
      if ! has_entry (decls) then prog
      else
        typed_ast.TypedProgram(
          keep_live(decls,
                    close_over(seed_queue(decls, Nil), decl_index(decls, dict_empty()), set_empty())))
