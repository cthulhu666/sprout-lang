module main
import stdlib.compiler.lexer as lexer
import stdlib.compiler.token as token
import stdlib.compiler.parser as parser
import stdlib.compiler.ast as ast
import stdlib.compiler.checker as checker
import stdlib.compiler.compiler as compiler
import stdlib.compiler.types as types
import stdlib.compiler.codegen as codegen
import stdlib.compiler.bundler as bundler
import stdlib.compiler.typed_ast as typed_ast

# ---------------------------------------------------------------------------
# Header stripping (mirrors compiler.sprout / type_driver.sprout)

fn is_header_line(s: String, pos: Int) -> Bool =
  str_starts_with(str_slice(s, pos, str_len(s)), "module ") ||
  str_starts_with(str_slice(s, pos, str_len(s)), "import ") ||
  str_starts_with(str_slice(s, pos, str_len(s)), "\n")

fn next_line(s: String, pos: Int) -> Int =
  if nl == -1 then str_len(s)
  else pos + nl + 1
  where nl = str_find(str_slice(s, pos, str_len(s)), "\n")

fn strip_headers(s: String, pos: Int) -> String =
  if pos >= str_len(s) then ""
  else if is_header_line(s, pos) then strip_headers(s, next_line(s, pos))
  else str_slice(s, pos, str_len(s))

# ---------------------------------------------------------------------------
# Diagnostic printing

fn print_diags(diags: List compiler.Diagnostic) -> Unit !{IO} =
  match diags with
  | Nil -> ()
  | Cons d rest ->
      do
        match d with
        | compiler.DiagError msg -> print("ERROR: " ++ msg)
        | compiler.DiagWarning msg -> print("WARNING: " ++ msg)
        print_diags(rest)

# ---------------------------------------------------------------------------
# Entry point (default phase: source-level typecheck with import resolution)

fn run_file(path: String, stdlib_root: String) -> Unit !{IO} =
  match read_file(path) with
  | Err msg -> panic("read_file: " ++ path ++ ": " ++ msg)
  | Ok raw -> run_with_src(raw, stdlib_root)

fn parse_for_decls(src: String) -> Maybe (List ast.Decl) =
  match lexer.tokenize(src) with
  | Err _ -> Nothing
  | Ok tokens ->
      match parser.parse_program(tokens) with
      | Err _ -> Nothing
      | Ok prog ->
          match prog with
          | ast.Program decls _ -> Just(decls)

fn run_with_src(src: String, stdlib_root: String) -> Unit !{IO} =
  do
    result <- compiler.compile_source_with_root(src, stdlib_root)
    match result with
    | compiler.CompileFail diags -> print_diags(diags)
    | compiler.CompileOk env ->
        do
          print("OK")
          match parse_for_decls(strip_headers(src, 0)) with
          | Nothing -> ()
          | Just decls -> checker.dump_typed_names(decls, env)

# ---------------------------------------------------------------------------
# Phase: bundle — load entry file + imports, qualify names

fn dump_ast_decl_names(decls: List ast.Decl) -> Unit !{IO} =
  match decls with
  | Nil -> ()
  | Cons d rest ->
      do
        match d with
        | ast.FnDecl name _ _ _ _ _ _ -> print(name)
        | ast.LetDecl name _ _ -> print(name)
        | _ -> ()
        dump_ast_decl_names(rest)

fn run_file_bundle(path: String, stdlib_root: String) -> Unit !{IO} =
  do
    result <- compiler.compile_phase_bundle(path, stdlib_root)
    match result with
    | bundler.BundleErr msg -> print("ERROR: bundle: " ++ msg)
    | bundler.BundleOk prog ->
        do
          print("OK")
          match prog with
          | ast.Program decls _ -> dump_ast_decl_names(decls)

# ---------------------------------------------------------------------------
# Phase: check — bundle + HM typecheck, produces typed IR

fn run_file_check(path: String, stdlib_root: String) -> Unit !{IO} =
  do
    result <- compiler.compile_phase_check(path, stdlib_root)
    match result with
    | typed_ast.TypedErr msg -> print("ERROR: " ++ msg)
    | typed_ast.TypedOk typed_prog env ->
        do
          print("OK")
          checker.dump_typed_program_names(typed_prog, env)

# ---------------------------------------------------------------------------
# Phase: lower — typeclass dictionary-passing lowering

fn run_file_lower(path: String, stdlib_root: String) -> Unit !{IO} =
  do
    result <- compiler.compile_phase_lower(path, stdlib_root)
    match result with
    | typed_ast.TypedErr msg -> print("ERROR: " ++ msg)
    | typed_ast.TypedOk typed_prog env ->
        do
          print("OK")
          checker.dump_typed_program_names(typed_prog, env)

# ---------------------------------------------------------------------------
# Phase: recheck — re-typecheck the lowered AST so typed nodes carry resolved types

fn run_file_recheck(path: String, stdlib_root: String) -> Unit !{IO} =
  do
    result <- compiler.compile_phase_recheck(path, stdlib_root)
    match result with
    | typed_ast.TypedErr msg -> print("ERROR: " ++ msg)
    | typed_ast.TypedOk typed_prog env ->
        do
          print("OK")
          checker.dump_typed_program_names(typed_prog, env)

# ---------------------------------------------------------------------------
# Phase: ir — emit LLVM IR text

fn run_file_ir(path: String, stdlib_root: String, debug_mode_: Bool) -> Unit !{IO} =
  do
    result <- compiler.compile_full_ir_lines(path, stdlib_root, debug_mode_)
    match result with
    | compiler.IrFullLinesFail diags -> print_diags(diags)
    | compiler.IrFullLinesOk header_lines str_lines def_lines dbg_lines ->
        do
          print_lines(header_lines)
          print_lines(str_lines)
          print_lines(def_lines)
          print_lines(dbg_lines)

fn run_file_ir_one(fn_name: String, path: String, stdlib_root: String) -> Unit !{IO} =
  do
    result <- compiler.compile_one_fn_ir_lines(fn_name, path, stdlib_root)
    match result with
    | compiler.IrFullLinesFail diags -> print_diags(diags)
    | compiler.IrFullLinesOk header_lines str_lines def_lines dbg_lines ->
        do
          print_lines(header_lines)
          print_lines(str_lines)
          print_lines(def_lines)
          print_lines(dbg_lines)

fn print_lines(lines: List String) -> Unit !{IO} =
  match lines with
  | Nil -> ()
  | Cons line rest ->
      do
        print(line)
        print_lines(rest)

# ---------------------------------------------------------------------------
# Phase: scan-info — call scan_source_info and print mod_name + exports.
# Diagnoses scan_source_info bugs without a full bundler run.

fn print_prefixed_list(prefix: String, items: List String) -> Unit !{IO} =
  match items with
  | Nil -> ()
  | Cons item rest ->
      do
        print(prefix ++ ": " ++ item)
        print_prefixed_list(prefix, rest)

fn run_file_scan_info(path: String, stdlib_root: String) -> Unit !{IO} =
  match read_file(path) with
  | Err msg -> panic("read_file: " ++ path ++ ": " ++ msg)
  | Ok raw ->
      match bundler.scan_source_info(raw) with
      | (mod_name, exports, ctor_types) ->
          do
            print("module: " ++ mod_name)
            print_prefixed_list("export", exports)
            print_prefixed_list("ctor", ctor_types)

# ---------------------------------------------------------------------------
# Phase: dump-qualify — show original→qualified name mapping per module.
# Reveals whether the resolve context was empty for a module (a common bug).

fn run_file_dump_qualify(path: String, stdlib_root: String) -> Unit !{IO} =
  do
    lines <- bundler.dump_qualify_file(path, stdlib_root)
    print_lines(lines)

# ---------------------------------------------------------------------------
# Batch entry point: stdlib_root as argv[0], file paths as argv[1..N]
# Prints "=== <path> ===" before each file's output (except for ir phase).
#
# phase: "" = default source check,
#        "bundle"|"check"|"lower"|"recheck"|"ir"|"scan-info"|"dump-qualify"

fn run_batch(stdlib_root: String, idx: Int, phase: String, debug_mode_: Bool) -> Unit !{IO} =
  match argv_get(idx) with
  | Nothing -> ()
  | Just path ->
      do
        if phase == "ir" then ()
        else print("=== " ++ path ++ " ===")
        if phase == "bundle" then run_file_bundle(path, stdlib_root)
        else if phase == "check" then run_file_check(path, stdlib_root)
        else if phase == "lower" then run_file_lower(path, stdlib_root)
        else if phase == "recheck" then run_file_recheck(path, stdlib_root)
        else if phase == "ir" then run_file_ir(path, stdlib_root, debug_mode_)
        else if phase == "scan-info" then run_file_scan_info(path, stdlib_root)
        else if phase == "dump-qualify" then run_file_dump_qualify(path, stdlib_root)
        else run_file(path, stdlib_root)
        run_batch(stdlib_root, idx + 1, phase, debug_mode_)

fn main() -> Unit !{IO} =
  match argv_get(0) with
  | Nothing -> print("ERROR: usage: compile-driver [--phase bundle|check|lower|recheck|ir|scan-info|dump-qualify | --emit-ir [--debug] | --emit-ir-one <fn_name>] <stdlib-root> <file>...")
  | Just first_arg ->
      if first_arg == "--emit-ir" then
        match argv_get(1) with
        | Nothing -> print("ERROR: usage: compile-driver --emit-ir [--debug] <stdlib-root> <file>...")
        | Just second_arg ->
            if second_arg == "--debug" then
              match argv_get(2) with
              | Nothing -> print("ERROR: usage: compile-driver --emit-ir --debug <stdlib-root> <file>...")
              | Just stdlib_root -> run_batch(stdlib_root, 3, "ir", true)
            else
              run_batch(second_arg, 2, "ir", false)
      else if first_arg == "--emit-ir-one" then
        match argv_get(1) with
        | Nothing -> print("ERROR: --emit-ir-one requires a function name argument")
        | Just fn_name ->
            match argv_get(2) with
            | Nothing -> print("ERROR: usage: compile-driver --emit-ir-one <fn_name> <stdlib-root> <file>")
            | Just stdlib_root ->
                match argv_get(3) with
                | Nothing -> print("ERROR: usage: compile-driver --emit-ir-one <fn_name> <stdlib-root> <file>")
                | Just file -> run_file_ir_one(fn_name, file, stdlib_root)
      else if first_arg == "--phase" then
        match argv_get(1) with
        | Nothing -> print("ERROR: --phase requires an argument: bundle|check|lower|recheck|ir|scan-info|dump-qualify")
        | Just phase ->
            match argv_get(2) with
            | Nothing -> print("ERROR: usage: compile-driver --phase <phase> <stdlib-root> <file>...")
            | Just stdlib_root -> run_batch(stdlib_root, 3, phase, false)
      else
        run_batch(first_arg, 1, "", false)
