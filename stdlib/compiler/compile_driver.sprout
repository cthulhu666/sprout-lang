module main
import stdlib.compiler.lexer as lexer
import stdlib.compiler.token as token
import stdlib.compiler.parser as parser
import stdlib.compiler.ast as ast
import stdlib.compiler.checker as checker
import stdlib.compiler.compiler as compiler
import stdlib.compiler.types as types
import stdlib.compiler.unifier as unifier
import stdlib.compiler.bundler as bundler
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.sprout_ir as sprout_ir
import stdlib.compiler.ast_to_ir as ast_to_ir
import stdlib.compiler.ir_lowering as ir_lowering
import stdlib.compiler.ir_rooting as ir_rooting
import stdlib.compiler.ir_pipeline as ir_pipeline
import stdlib.compiler.iface_codec as iface_codec
import stdlib.compiler.source as source
import stdlib.fs as fs

# ---------------------------------------------------------------------------
# Diagnostic position formatting

# format_pos: "line:col: " prefix when position is known; empty string for no_pos().
fn format_pos(pos: source.SourcePos) -> String =
  match pos with
  | source.SourcePos _ line col ->
      if line == 0 then ""
      else `${line}:${col}: `

# ---------------------------------------------------------------------------
# Header stripping is source.strip_headers (line-preserving, shared authority).

# ---------------------------------------------------------------------------
# Diagnostic reporting
#
# TWO INVARIANTS, both load-bearing. `just diagnostic-stream-smoke` guards them.
#
#   1. Diagnostics go to STDERR. stdout carries the ARTIFACT — LLVM IR, an encoded
#      iface, status lines — and callers redirect it to a file. A diagnostic on
#      stdout does not merely look untidy, it BECOMES the artifact: with
#      `compile_driver --emit-ir root f.spr > f.ll` (the dev loop AGENTS.md
#      documents, piped straight into clang) the error text was written into f.ll,
#      so a Sprout type error resurfaced later as
#      `clang: error: expected top-level entity` quoting the Sprout error back at
#      you. The rule was already stated for --emit-iface below; --emit-ir, --phase
#      and the default path had simply never followed it.
#
#   2. A failed run exits NONZERO. Every run_* returns Unit, so the status is
#      carried by a `Ref Int` flag threaded from main and read as main's result.
#      Before this the driver exited 0 on every error — which is why
#      `just loud-fail-smoke` was structurally incapable of firing, and why the
#      negative-test harness has to grep text (`2>&1 || true`) rather than trust
#      the status.
#
# `failed` is write-1-only; no path ever clears it. So "an error happened somewhere
# in this batch" survives to main however many files follow the failing one.

# report_error: the single funnel for an error diagnostic — stderr, and mark the
# run failed. Prefer this over a bare eprint so neither half can be forgotten.
#
# Being the single funnel makes it the right place to drop the synthetic module
# name a headerless entry file carries (source.strip_entry_names): every
# diagnostic this driver emits passes through here, so no message-building site
# has to remember. `--phase dump-qualify` prints through `print` instead and so
# still shows the real qualified names, which is what a debug dump is for.
fn report_error(failed: Ref Int, msg: String) -> Unit !{IO} =
  do
    eprint(source.strip_entry_names(msg))
    ref_write(failed, 1)

fn print_diags(diags: List compiler.Diagnostic, failed: Ref Int) -> Unit !{IO} =
  match diags with
  | Nil -> ()
  | Cons d rest ->
      do
        match d with
        | compiler.DiagError pos msg -> report_error(failed, format_pos(pos) ++ "ERROR: " ++ msg)
        # A warning is a diagnostic but not a failure: stderr, no flag.
        | compiler.DiagWarning pos msg -> eprint(format_pos(pos) ++ "WARNING: " ++ msg)
        print_diags(rest, failed)

# ---------------------------------------------------------------------------
# Entry point (default phase: source-level typecheck with import resolution)

fn run_file(path: String, stdlib_root: String, failed: Ref Int) -> Unit !{IO} =
  match fs.read_text(path) with
  | Err msg -> panic("read_file: " ++ path ++ ": " ++ msg)
  | Ok raw -> run_with_src(raw, stdlib_root, failed)

fn parse_for_decls(src: String) -> Maybe (List ast.Decl) =
  match lexer.tokenize(src) with
  | Err _ -> Nothing
  | Ok tokens ->
      match parser.parse_program(tokens) with
      | Err _ -> Nothing
      | Ok prog ->
          match prog with
          | ast.Program decls _ -> Just(decls)

fn run_with_src(src: String, stdlib_root: String, failed: Ref Int) -> Unit !{IO} =
  do
    result <- compiler.compile_source_with_root(src, source.StdlibRoot(stdlib_root))
    match result with
    | compiler.CompileFail diags -> print_diags(diags, failed)
    | compiler.CompileOk env ->
        do
          print("OK")
          match parse_for_decls(source.strip_headers(src)) with
          | Nothing -> ()
          | Just decls -> checker.dump_typed_names(decls, env)

# ---------------------------------------------------------------------------
# Phase: bundle — load entry file + imports, qualify names

fn dump_ast_decl_names(decls: List ast.Decl) -> Unit !{IO} =
  match decls with
  | Nil -> ()
  | Cons d rest ->
      do
        match d with
        | ast.FnDecl name _ _ _ _ _ _ -> print(name)
        | ast.LetDecl name _ _ _ -> print(name)
        | _ -> ()
        dump_ast_decl_names(rest)

fn run_file_bundle(path: String, stdlib_root: String, extra_roots: List String, failed: Ref Int) -> Unit !{IO} =
  do
    result <- compiler.compile_phase_bundle_with_roots(source.FilePath(path), source.StdlibRoot(stdlib_root), extra_roots)
    match result with
    | bundler.BundleErr _ msg -> report_error(failed, "ERROR: bundle: " ++ msg)
    | bundler.BundleOk prog ->
        do
          print("OK")
          match prog with
          | ast.Program decls _ -> dump_ast_decl_names(decls)

# ---------------------------------------------------------------------------
# Phase: check — bundle + HM typecheck, produces typed IR

fn run_file_check(path: String, stdlib_root: String, extra_roots: List String, failed: Ref Int) -> Unit !{IO} =
  do
    result <- compiler.compile_phase_check_with_roots(source.FilePath(path), source.StdlibRoot(stdlib_root), extra_roots)
    match result with
    | typed_ast.TypedErr pos msg -> report_error(failed, format_pos(pos) ++ "ERROR: " ++ msg)
    | typed_ast.TypedOk typed_prog env ->
        do
          print("OK")
          checker.dump_typed_program_names(typed_prog, env)

# ---------------------------------------------------------------------------
# Phase: effects — declared-vs-inferred effect census
#
# Reports, never rejects. The v0 checker does not enforce the effect rules
# (spec-v0.md §7), and this exists to measure what enforcing them would cost
# before the language commits to it.
#
# READ THE SUMMARY AS A LOWER BOUND. Callers resolve a callee through its env
# scheme, which carries the DECLARED effect — nothing writes an inferred effect
# back. So when `helper` is mis-declared pure, this run flags `helper` alone; the
# callers it taints only surface on a later run, after `helper` is annotated.
# One wave of propagation, not a fixed point.

fn run_file_effects(path: String, stdlib_root: String, extra_roots: List String, failed: Ref Int) -> Unit !{IO} =
  do
    (result, reports) <- compiler.compile_phase_effects_with_roots(source.FilePath(path), source.StdlibRoot(stdlib_root), extra_roots)
    match result with
    | typed_ast.TypedErr pos msg -> report_error(failed, format_pos(pos) ++ "ERROR: " ++ msg)
    | typed_ast.TypedOk _ _ ->
        do
          print_effect_reports(reports)
          print_effect_summary(reports)

fn print_effect_reports(reports: List unifier.EffectReport) -> Unit !{IO} =
  list_each(\r -> print(effect_report_line(r)), reports)

fn effect_report_line(r: unifier.EffectReport) -> String =
  "effect " ++ effect_report_verdict(r) ++ " "
    ++ unifier.effect_report_name(r) ++ ": declared "
    ++ types.effect_to_string(unifier.effect_report_declared(r)) ++ ", inferred "
    ++ types.effect_to_string(unifier.effect_report_inferred(r))

# Every verdict other than `ok` is a REJECTION by `checker.enforce_effects`, and
# that correspondence is the phase's whole value — a reader migrating a codebase
# needs the report to enumerate exactly what will fail to compile.
#
#   GAP  rule 8 — the body performs IO under a pure signature
#   ROW  rule 9 — the signature names more than one effect variable, or writes a
#                 multi-label row
#
# `ROW` was added when rule 9 started being enforced. Leaving it out would have
# printed `ok` for a declaration the checker rejects, which is precisely the
# report-disagrees-with-checker failure this file already guards against.
#
# The name outlived its original meaning: the verdict was called ROW when rule 9
# was checked against the INFERRED effect, where a violation always was a row.
# The check now reads the declared signature, so the common cause is two written
# variables and no row need exist. Kept because the smoke gate, the spec note and
# `docs/effect-enforcement-v0.md` all pin the token; it means "rule 9", not "a row
# was inferred".
fn effect_report_verdict(r: unifier.EffectReport) -> String =
  if effect_report_is_gap(r) then "GAP"
  else if unifier.effect_report_is_multi_var(r) then "ROW"
  else "ok"

# Deliberately NOT a local copy. This phase's whole value is that a GAP line
# predicts exactly what `checker.enforce_effects` will reject, so both read the
# one definition in `unifier`. A second copy here would be free to drift, and a
# report that disagrees with the checker is worse than no report at all.
fn effect_report_is_gap(r: unifier.EffectReport) -> Bool =
  unifier.effect_report_is_gap(r)

# An inferred row counts as unresolved, and deliberately so: its members ARE
# unbound effect variables, and after rule 9 moved to the declared side an
# inferred row is no longer a rejection at all — it is what two fresh
# instantiations of one legitimate variable look like.
fn effect_report_is_var(r: unifier.EffectReport) -> Bool =
  match unifier.effect_report_inferred(r) with
  | types.EffectVar _ -> true
  | types.EffectRow _ -> true
  | _ -> false

# The two violation counts are disjoint by construction — one reads the inferred
# effect, the other the declared signature — so they can be added. They were not
# when rule 9 read the inferred side: every declaration counted as a row was also
# counted as an unresolved var, and the migration estimate this line exists to
# feed double-counted them.
fn print_effect_summary(reports: List unifier.EffectReport) -> Unit !{IO} =
  print("effect-summary: " ++ int_to_string(list_length(reports)) ++ " declarations, "
    ++ int_to_string(count_where(effect_report_is_gap, reports)) ++ " gaps (declared pure, inferred !{IO}), "
    ++ int_to_string(count_where(unifier.effect_report_is_multi_var, reports)) ++ " singleton-rule violations, "
    ++ int_to_string(count_where(effect_report_is_var, reports)) ++ " unresolved effect vars")

fn count_where(p: unifier.EffectReport -> Bool, reports: List unifier.EffectReport) -> Int =
  list_fold(\ (acc, r) -> if p(r) then acc + 1 else acc, 0, reports)

# ---------------------------------------------------------------------------
# Phase: lower — typeclass dictionary-passing lowering

fn run_file_lower(path: String, stdlib_root: String, extra_roots: List String, failed: Ref Int) -> Unit !{IO} =
  do
    result <- compiler.compile_phase_lower_with_roots(source.FilePath(path), source.StdlibRoot(stdlib_root), extra_roots)
    match result with
    | typed_ast.TypedErr pos msg -> report_error(failed, format_pos(pos) ++ "ERROR: " ++ msg)
    | typed_ast.TypedOk typed_prog env ->
        do
          print("OK")
          checker.dump_typed_program_names(typed_prog, env)

# ---------------------------------------------------------------------------
# Phase: recheck — re-typecheck the lowered AST so typed nodes carry resolved types

fn run_file_recheck(path: String, stdlib_root: String, extra_roots: List String, failed: Ref Int) -> Unit !{IO} =
  do
    result <- compiler.compile_phase_recheck_with_roots(source.FilePath(path), source.StdlibRoot(stdlib_root), extra_roots)
    match result with
    | typed_ast.TypedErr pos msg -> report_error(failed, format_pos(pos) ++ "ERROR: " ++ msg)
    | typed_ast.TypedOk typed_prog env ->
        do
          print("OK")
          checker.dump_typed_program_names(typed_prog, env)

# ---------------------------------------------------------------------------
# Mode: --emit-iface — Phase 1.x of iface-precompiled-modules-v1-draft.md
#
# Parses + typechecks the given module, filters the post-typecheck env to
# entries whose qualified name starts with `<module_name>.`, wraps them in
# an IfaceFile (version=1), encodes via iface_codec.encode_iface_file, and
# prints to stdout. Errors go to stderr so they don't pollute the iface
# artifact when stdout is redirected to a file.
#
# Usage: compile-driver --emit-iface <stdlib-root> <module-name> <path> > out.iface

fn run_file_emit_iface(module_name: String, path: String, stdlib_root: String, failed: Ref Int) -> Unit !{IO} =
  do
    result <- compiler.compile_phase_check(source.FilePath(path), source.StdlibRoot(stdlib_root))
    match result with
    | typed_ast.TypedErr pos msg -> report_error(failed, format_pos(pos) ++ "ERROR: " ++ msg)
    | typed_ast.TypedOk typed_prog env ->
        do
          let schemes = iface_codec.extract_named_schemes(env, module_name)
          let ctors = iface_codec.extract_ctor_infos(typed_prog, module_name)
          let classes = iface_codec.extract_class_infos(typed_prog, module_name)
          let instances = iface_codec.extract_instance_infos(typed_prog, module_name)
          let iface = iface_codec.IfaceFile(6, module_name, schemes, ctors, classes, instances)
          print(iface_codec.encode_iface_file(iface))

# ---------------------------------------------------------------------------
# Mode: --check-iface — Phase 1.x companion to --emit-iface
#
# Reads an iface file from disk, runs it through decode_iface_file, and
# reports well-formedness. Used by `just check-iface-all` to validate cached
# artifacts before any consumer relies on them.
#
# Output (stdout):
#   OK: <path> (version <N>, <K> schemes)         on success
#   INVALID: <path>                                on decode failure
#
# Both lines stay on STDOUT: unlike a diagnostic they are this mode's ARTIFACT —
# the documented, greppable output contract that `just check-iface-all` consumes
# (`--check-iface "$f" 2>&1 | grep -q "^OK:"`). An INVALID decode does now also
# set a nonzero exit status, so a caller can gate on the status instead of
# scraping text; the previous note here said exit-code gating "belongs in the
# calling recipe", which was a description of a driver that had no working exit
# status at all rather than a reason to keep it that way. check-iface-all is
# unaffected either way — its driver call sits in an `if` condition, so the
# grep, not the status, still decides.

# An UNREADABLE file is INVALID, not silence. This used to open `contents <- fs.read_text(path)`
# inside the `do`, which discards the `Err` and returns early from a `Unit`-returning function —
# so the driver printed nothing at all and exited 0 for a file it never read, defeating the exit-status
# contract promised directly above. `match read_file` makes the failure a case, the same shape
# `run_file` and the emit-iface path already use.
#
# Found 2026-08-11 by the discarded-fallible-bind measurement in
# docs/fallible-bind-diagnostic-v0.md: of 1539 binds in the tree this was the ONLY hit in production
# code, which is the measurement's central result and the reason a diagnostic for the shape is worth
# having. Regression: the --check-iface cases in `just diagnostic-stream-smoke`.
fn run_check_iface(path: String, failed: Ref Int) -> Unit !{IO} =
  match fs.read_text(path) with
  | Err msg ->
      do
        print("INVALID: " ++ path ++ " (unreadable: " ++ msg ++ ")")
        ref_write(failed, 1)
  | Ok contents -> run_check_iface_contents(path, contents, failed)

fn run_check_iface_contents(path: String, contents: String, failed: Ref Int) -> Unit !{IO} =
    match iface_codec.decode_iface_file(contents) with
    | Nothing ->
        do
          print("INVALID: " ++ path)
          ref_write(failed, 1)
    | Just iface ->
        match iface with
        | iface_codec.IfaceFile version mod schemes ctors classes instances ->
            print("OK: " ++ path
              ++ " (version " ++ int_to_string(version)
              ++ ", module " ++ mod
              ++ ", " ++ int_to_string(list_length(schemes)) ++ " schemes"
              ++ ", " ++ int_to_string(list_length(ctors)) ++ " ctors"
              ++ ", " ++ int_to_string(list_length(classes)) ++ " classes"
              ++ ", " ++ int_to_string(list_length(instances)) ++ " instances)")


fn print_lines(lines: List String) -> Unit !{IO} =
  match lines with
  | Nil -> ()
  | Cons line rest ->
      do
        print(line)
        print_lines(rest)

# ---------------------------------------------------------------------------
# Phase: use-ir-codegen — typed AST → Sprout-IR → LLVM IR text.
#
# Milestone 1, PR 1.2 (see docs/gc-rooting-model-c-plan-2026-06-02.md).
# Reuses compile_phase_recheck to get the typed AST (no LLVM is produced by
# that phase), then delegates to ast_to_ir + ir_lowering.

fn run_file_use_ir_codegen(path: String, stdlib_root: String, extra_roots: List String, failed: Ref Int) -> Unit !{IO} =
  do
    recheck_result <- compiler.compile_phase_recheck_with_roots(source.FilePath(path), source.StdlibRoot(stdlib_root), extra_roots)
    match recheck_result with
    | typed_ast.TypedErr pos msg -> report_error(failed, format_pos(pos) ++ "ERROR: " ++ msg)
    | typed_ast.TypedOk typed_prog _ ->
        match ir_pipeline.compile_program_streaming(typed_prog) with
        | Err msg -> report_error(failed, "ERROR: " ++ msg)
        | Ok ir_text -> print(ir_text)

# ---------------------------------------------------------------------------
# Phase: scan-info — call scan_source_info and print mod_name + exports.
# Diagnoses scan_source_info bugs without a full bundler run.

fn print_prefixed_list(prefix: String, items: List String) -> Unit !{IO} =
  match items with
  | Nil -> ()
  | Cons item rest ->
      do
        print(prefix ++ ": " ++ item)
        print_prefixed_list(prefix, rest)

fn run_file_scan_info(path: String, stdlib_root: String) -> Unit !{IO} =
  match fs.read_text(path) with
  | Err msg -> panic("read_file: " ++ path ++ ": " ++ msg)
  | Ok raw ->
      match bundler.scan_source_info(raw) with
      | (mod_name, exports, ctor_types) ->
          do
            print("module: " ++ mod_name)
            print_prefixed_list("export", exports)
            print_prefixed_list("ctor", ctor_types)

# ---------------------------------------------------------------------------
# Phase: dump-qualify — show original→qualified name mapping per module.
# Reveals whether the resolve context was empty for a module (a common bug).

fn run_file_dump_qualify(path: String, stdlib_root: String) -> Unit !{IO} =
  do
    lines <- bundler.dump_qualify_file(source.FilePath(path), source.StdlibRoot(stdlib_root))
    print_lines(lines)

# ---------------------------------------------------------------------------
# Batch entry point: stdlib_root as argv[0], file paths as argv[1..N]
# Prints "=== <path> ===" before each file's output (except the IR phase).
#
# phase: "" = default source check,
#        "bundle"|"check"|"lower"|"recheck"|"ir-typed"|"scan-info"|"dump-qualify"

fn run_batch(stdlib_root: String, idx: Int, phase: String, extra_roots: List String, failed: Ref Int) -> Unit !{IO} =
  match argv_get(idx) with
  | Nothing -> ()
  | Just path ->
      do
        if phase == "ir-typed" then ()
        else print("=== " ++ path ++ " ===")
        if phase == "bundle" then run_file_bundle(path, stdlib_root, extra_roots, failed)
        else if phase == "check" then run_file_check(path, stdlib_root, extra_roots, failed)
        else if phase == "lower" then run_file_lower(path, stdlib_root, extra_roots, failed)
        else if phase == "effects" then run_file_effects(path, stdlib_root, extra_roots, failed)
        else if phase == "recheck" then run_file_recheck(path, stdlib_root, extra_roots, failed)
        else if phase == "ir-typed" then run_file_use_ir_codegen(path, stdlib_root, extra_roots, failed)
        # scan-info and dump-qualify have no diagnostic path of their own — they
        # panic on a read failure — so they take no flag.
        else if phase == "scan-info" then run_file_scan_info(path, stdlib_root)
        else if phase == "dump-qualify" then run_file_dump_qualify(path, stdlib_root)
        else if phase == "" then run_file(path, stdlib_root, failed)
        # An unrecognised phase used to fall through to the default source check
        # and exit 0, so `--phase efects` silently ran something else and looked
        # like it had worked. A gate asserting on a phase's output is only as good
        # as the driver's willingness to admit the phase does not exist.
        else report_error(failed, "ERROR: unknown phase `" ++ phase
               ++ "`: expected bundle|check|effects|lower|recheck|scan-info|dump-qualify")
        # Keep going after a failure: a batch reports every bad file, and `failed`
        # is write-1-only so the status survives the remaining files.
        run_batch(stdlib_root, idx + 1, phase, extra_roots, failed)

# Exit status: 0 when nothing reported an error, 1 otherwise. `failed` is created
# here, threaded down, and read back as main's result — see the "Diagnostic
# reporting" header for why a Ref rather than a return value (every run_* is Unit,
# and run_batch recurses, so a Ref avoids restructuring the recursion into a fold).
# A usage error is a failure too: it exits 1, so a mistyped invocation in a script
# stops the script instead of looking like a successful no-op.
fn main() -> Int !{IO} =
  do
    failed <- ref_new(0)
    args <- argv_all()
    match args with
    | ["--emit-ir", "--debug", stdlib_root | _] ->
        run_batch(stdlib_root, 3, "ir-typed", Nil, failed)
    | ["--emit-ir", "--debug" | _] ->
        report_error(failed, "ERROR: usage: compile-driver --emit-ir --debug <stdlib-root> <file>...")
    # One extra package root, fixed right after <stdlib-root>: dotted non-stdlib
    # imports (e.g. postgres.*) resolve under <pkg-root> (docs/packaging-v0.md §10
    # phase 2). Single root, fixed position — the walking-skeleton surface.
    | ["--emit-ir", stdlib_root, "--package-root", dir | _] ->
        run_batch(stdlib_root, 4, "ir-typed", Cons(dir, Nil), failed)
    | ["--emit-ir", stdlib_root | _] ->
        run_batch(stdlib_root, 2, "ir-typed", Nil, failed)
    | ["--emit-ir" | _] ->
        report_error(failed, "ERROR: usage: compile-driver --emit-ir [--debug] <stdlib-root> [--package-root <dir>] <file>...")
    | ["--phase", phase, stdlib_root, "--package-root", dir | _] ->
        run_batch(stdlib_root, 5, phase, Cons(dir, Nil), failed)
    | ["--phase", phase, stdlib_root | _] ->
        run_batch(stdlib_root, 3, phase, Nil, failed)
    | ["--phase", _ | _] ->
        report_error(failed, "ERROR: usage: compile-driver --phase <phase> <stdlib-root> [--package-root <dir>] <file>...")
    | ["--phase" | _] ->
        report_error(failed, "ERROR: --phase requires an argument: bundle|check|effects|lower|recheck|scan-info|dump-qualify")
    # --package-root before the bare form: the general arm would otherwise bind
    # path to the literal "--package-root". Mirrors the --emit-ir surface so the
    # typed-codegen path resolves dotted non-stdlib imports (e.g. testsupport.*).
    | ["--use-ir-codegen", stdlib_root, "--package-root", dir, path | _] ->
        run_file_use_ir_codegen(path, stdlib_root, Cons(dir, Nil), failed)
    | ["--use-ir-codegen", stdlib_root, path | _] ->
        run_file_use_ir_codegen(path, stdlib_root, Nil, failed)
    | ["--use-ir-codegen" | _] ->
        report_error(failed, "ERROR: usage: compile-driver --use-ir-codegen <stdlib-root> [--package-root <dir>] <file>")
    | ["--emit-iface", stdlib_root, module_name, path | _] ->
        run_file_emit_iface(module_name, path, stdlib_root, failed)
    | ["--emit-iface" | _] ->
        report_error(failed, "ERROR: usage: compile-driver --emit-iface <stdlib-root> <module-name> <file>")
    | ["--check-iface", path | _] ->
        run_check_iface(path, failed)
    | ["--check-iface" | _] ->
        report_error(failed, "ERROR: usage: compile-driver --check-iface <iface-file>")
    | [stdlib_root | _] ->
        run_batch(stdlib_root, 1, "", Nil, failed)
    | _ ->
        report_error(failed, "ERROR: usage: compile-driver [--phase bundle|check|effects|lower|recheck|scan-info|dump-qualify | --emit-ir [--debug] | --use-ir-codegen | --emit-iface <module-name> | --check-iface <iface-file>] <stdlib-root> <file>...")
    code <- ref_read(failed)
    code
