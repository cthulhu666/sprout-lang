module stdlib.compiler.rec_inline
import stdlib.compiler.ast as ast
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types
import stdlib.compiler.source as source
import stdlib.compiler.scc as scc
import stdlib.compiler.vec_wrappers as vec_wrappers
import stdlib.string as string

# Record scalar replacement. Design: docs/record-sra-v0.md.
#
# Stage 1, the split. A record let
#
#   let x = R(f1 = e1, f2 = e2) in b      (R a non-linear record, x read only as `x.f`)
#
# becomes one scalar let per field, in declaration order, with each `x.f` in `b` read from its
# let. The record is never built. A bare use of `x` (passed on, returned, stored, updated) keeps
# the let as it is.
#
# Stage 2, the inliner. A call to a small, pure, non-recursive top-level function inlines when a
# record allocation goes away by it: a record builder (one whose body ends in a record literal)
# whose result a split let reads, or a call that has a field-only parameter (one only read by
# `.field` or passed to another such parameter) fed by a builder call, a record literal or a
# variable bound by a let that splits. Nothing else inlines. The inlined body is walked again in the caller's
# context, so the builders it calls inline in turn and its record lets split. That re-walk can
# nest without end, so each top-level declaration (and each instance method) has a budget of
# `inline_budget` nodes: an inline spends the size of the callee's prepared body, and a call the
# budget cannot cover stays a call. A record that then has a bare use stays boxed.
#
# Fields are bound in DECLARATION order, which is the order lowering evaluates a literal in, not
# the order the source wrote them, so traps and effects happen in the same order. A field no one
# reads is still bound, so its trap still fires. An inlined call binds each argument that is not a
# variable or literal, left to right, before the body: the call's own order.
#
# Scope: the occurrence check and the substitution both stop below a binder that rebinds `x`: a
# match-arm pattern, a lambda parameter, a do step (for the steps after it only). `$` cannot
# appear in a user identifier, so every name this pass makes (`x$f$N$ri` for a field, `p$N$ri`
# for an argument, `y$N$ri` for a binder of an inlined body) cannot clash with a name the program
# wrote. `N` counts across the whole program, so no two share it. Every binder in an inlined body
# is renamed, so a copy's own names neither capture nor are captured. Its free names are another
# matter: a callee that reads a top-level `k` must not be copied below a binder of a local `k`.
# The walk keeps the names bound above it (`Ctx.locals`) and leaves such a call, so the pass does
# not depend on the bundler having renamed that local. Only lets named so float (`peel_lets`).

# The most nodes a callee body may have, once its own calls are prepared.
let inline_limit: Int = 64

# The most nodes of callee body one declaration may inline, and one callee's preparation.
let inline_budget: Int = 256

# Runs on any program, bundled or not: capture safety is the walk's own (`captures`), not the
# bundler's local rename. `recs` below: the field names of every non-linear record, in
# declaration order, by name.
export fn expand_program(prog: typed_ast.TypedProgram) -> typed_ast.TypedProgram =
  match prog with
  | typed_ast.TypedProgram decls ->
      match list_filter_map(record_entry, decls) with
      | [] -> prog
      | entries ->
          let recs = dict_from_list(entries)
              (callees, n) = prepare_callees(decls, recs)
          in expand_decls(prog, decls, Ctx(recs = recs, callees = callees, flat = [], locals = set_empty()),
                          Gen(n = n, budget = inline_budget))

fn expand_decls(prog: typed_ast.TypedProgram, decls: List typed_ast.TypedDecl, cx: Ctx, g: Gen) ->
    typed_ast.TypedProgram =
  match walk_seq(\ (d, k) -> walk_decl(d, cx, k), decls, g) with
  | (rewritten, true, _) -> typed_ast.TypedProgram(rewritten)
  | (_, false, _) -> prog

# A linear record is never split: the checker counts its uses, and a split would change them.
fn record_entry(d: typed_ast.TypedDecl) -> Maybe (String, List String) =
  match d with
  | typed_ast.TPassThrough (ast.RecordDecl name _ fields _ mult _ _) ->
      match mult with
      | ast.Unrestricted -> Just((name, list_map(field_decl_name, fields)))
      | ast.Linear -> Nothing
  | _ -> Nothing

fn field_decl_name(f: ast.RecordFieldDecl) -> String =
  match f with
  | ast.RecordFieldDecl name _ -> name

# ---------------------------------------------------------------------------
# What the walk knows.
# ---------------------------------------------------------------------------

# A callee that may inline: its parameter names, which of them are field-only (parallel to
# `params`), its body with its own calls already prepared, the record its body builds when the
# tail is a record literal (a builder), the body's node count, and its free names: the top-level
# names the body reads, through the calls already inlined into it as well.
type Callee = (params: List String, field_only: List Bool, body: typed_ast.TypedExpr, builder: Maybe String,
               size: Int, free: List String)

# `flat` lists the variables bound by a let that is about to split. A binder that rebinds one of
# them removes it, so a name in `flat` is always the let's own. `locals` is every name a binder
# above the current point binds: a copy of a callee that reads a top-level of such a name would
# read the local instead, so that call stays (`captures`).
type Ctx = (recs: Dict (List String), callees: Dict Callee, flat: List String, locals: Set)

# What the context does with a value: `OnlyFields` reads it by field, `AsValue` takes it whole.
type Demand = OnlyFields | AsValue

# What the walk threads: `n` the next free name suffix, program-wide, and `budget` the nodes of
# inlined body the current declaration may still add.
type Gen = (n: Int, budget: Int)

fn wants_fields(dm: Demand) -> Bool =
  match dm with
  | OnlyFields -> true
  | AsValue -> false

fn fresh_budget(g: Gen) -> Gen = g with (budget = inline_budget)

# `cx` under a binder of `names`: they leave `flat` (they rebind a flat variable) and join `locals`.
fn cx_bind_names(cx: Ctx, names: List String) -> Ctx =
  cx with (flat = flat_without(cx.flat, names),
           locals = list_fold(\ (acc, n) -> set_insert(n, acc), cx.locals, names))

fn flat_without(flat: List String, names: List String) -> List String =
  match flat with
  | [] -> []
  | _ -> list_filter(\v -> !list_member(v, names), flat)

# `cx` under the binder of `item`, whose names are `names_of(item)`.
fn cx_bind(cx: Ctx, names_of: a -> List String, item: a) -> Ctx = cx_bind_names(cx, names_of(item))

# Whether a copy of `c` at this point would read a local in place of a top-level.
fn captures(c: Callee, cx: Ctx) -> Bool = any(\n -> set_member(n, cx.locals), c.free)

# ---------------------------------------------------------------------------
# Eligible callees (docs/record-sra-v0.md §4.1, §4.5).
# ---------------------------------------------------------------------------

type PrepEnv = (recs: Dict (List String), fns: Dict typed_ast.TypedDecl, graph: Dict Set, top: Set)

# Callees by name, and the next free suffix. Callee-first over the call graph, so a callee's body
# is prepared with the calls to eligible callees below it already inlined, and its field-only
# parameters read the callee's own flags.
fn prepare_callees(decls: List typed_ast.TypedDecl, recs: Dict (List String)) -> (Dict Callee, Int) =
  let graph = scc.call_graph(decls)
      pe = PrepEnv(recs = recs, fns = dict_from_list(list_filter_map(fn_entry, decls)), graph = graph,
                   top = set_from_list(list_filter_map(typed_ast.decl_name, decls)))
  in list_fold(prepare_comp(pe, _, _), (dict_empty(), 0),
               scc.sccs_in_dependency_order(scc.fn_order(decls), graph))

fn fn_entry(d: typed_ast.TypedDecl) -> Maybe (String, typed_ast.TypedDecl) =
  match d with
  | typed_ast.TFnDecl name _ _ _ _ _ -> Just((name, d))
  | _ -> Nothing

# One strongly connected component of `scc.call_graph`. Only a lone function that does not call
# itself can be a callee.
fn prepare_comp(pe: PrepEnv, st: (Dict Callee, Int), members: List String) -> (Dict Callee, Int) =
  match members with
  | [name] ->
      let Just d = dict_get(name, pe.fns) else st
      in if calls_itself(name, pe.graph) then st else prepare_fn(d, pe, st)
  | _ -> st

fn calls_itself(name: String, graph: Dict Set) -> Bool =
  match dict_get(name, graph) with
  | Just callees -> set_member(name, callees)
  | Nothing -> false

# A body over `2 * inline_limit` nodes is not walked: the walk only shrinks a body a little (a
# split drops a record literal and its field reads), so such a body stays over `inline_limit` and
# `callee_of` would refuse it. The factor 2 is slack for that shrink, not a measured bound.
fn prepare_fn(d: typed_ast.TypedDecl, pe: PrepEnv, st: (Dict Callee, Int)) -> (Dict Callee, Int) =
  let (callees, n) = st
      typed_ast.TFnDecl name params ret eff cs body = d else st
  in
    if !header_eligible(name, params, ret, eff, cs, pe.recs) then st
    else
      let Just raw_size = body_size(body, pe.top) else st
      in
        if raw_size > 2 * inline_limit then st
        else
          let cx = cx_bind(Ctx(recs = pe.recs, callees = callees, flat = [], locals = set_empty()),
                           ast.param_names, params)
              (b, _, g1) = walk(body, tail_demand(ret, pe.recs), cx, Gen(n = n, budget = inline_budget))
          in match callee_of(params, b, callees, pe.top) with
             | Just c -> (dict_set(name, c, callees), g1.n)
             | Nothing -> (callees, g1.n)

# A callee that returns a record is read by field, so its tail builder calls inline.
fn tail_demand(ret: Maybe ast.TypeExpr, recs: Dict (List String)) -> Demand =
  match ret with
  | Just (ast.TypeName n) -> if dict_member(n, recs) then OnlyFields else AsValue
  | _ -> AsValue

# A parameter is field-only when `splittable`: every use is a field read or an argument at a
# field-only parameter.
fn callee_of(params: List ast.Param, body: typed_ast.TypedExpr, callees: Dict Callee, top: Set) -> Maybe Callee =
  let Just size = body_size(body, top) else Nothing
      names = ast.param_names(params)
  in
    if size > inline_limit then Nothing
    else Just(Callee(params = names, field_only = list_map(splittable(_, callees, body), names),
                     body = body, builder = tail_record(body), size = size,
                     free = set_to_list(free_names(body, set_from_list(names), set_empty()))))

# The variables `e` reads that `bound` and the lets inside `e` do not bind, added to `acc`. The
# only binder in a callee body is the one-arm variable let that `body_size` admits.
fn free_names(e: typed_ast.TypedExpr, bound: Set, acc: Set) -> Set =
  match e with
  | typed_ast.TVar v _ _ -> if set_member(v, bound) then acc else set_insert(v, acc)
  | typed_ast.TMatch scrut [typed_ast.TypedMatchBranch(ast.VarPattern y _) body] _ _ ->
      free_names(body, set_insert(y, bound), free_names(scrut, bound, acc))
  | _ -> list_fold(\ (a, c) -> free_names(c, bound, a), acc, typed_ast.children(e))

fn tail_record(e: typed_ast.TypedExpr) -> Maybe String =
  match e with
  | typed_ast.TRecord rname _ _ _ -> Just(rname)
  | typed_ast.TMatch _ [typed_ast.TypedMatchBranch(ast.VarPattern _ _) body] _ _ -> tail_record(body)
  | _ -> Nothing

# Pure, no dictionary parameter, every type written and closed, and a result that is a non-linear
# record or a primitive: never an ADT or tuple, which CPR routes by the shape of the call, and an
# inlined call is no longer a call.
#
# The name need not be dotted: a prelude callee inlines too. A copy cannot capture: `inst` renames
# the body's own binders, and a call where a local has the name of a top-level the body reads
# stays a call (`captures`), whether or not the bundler renamed that local.
fn header_eligible(name: String, params: List ast.Param, ret: Maybe ast.TypeExpr, eff: Maybe (List String),
                   cs: List ast.TypeConstraint, recs: Dict (List String)) -> Bool =
  vec_wrappers.is_pure_decl(eff) && list_length(cs) == 0
  && all(param_eligible, params) && result_eligible(ret, recs)

fn param_eligible(p: ast.Param) -> Bool =
  match p with
  | ast.Param name (Just te) mode -> closed_type(te) && !str_starts_with(name, "__tc_") && mode_plain(mode)
  | ast.Param _ Nothing _ -> false

fn mode_plain(m: ast.ParamMode) -> Bool =
  match m with
  | ast.ModeDefault -> true
  | ast.ModeConsuming -> true
  | ast.ModeBorrowing -> false
  | ast.ModeOnce -> false
  | ast.ModeLocal -> false
  | ast.ModeOnceLocal -> false

let primitive_results: List String = ["Int", "Double", "Bool", "Char"]

fn result_eligible(ret: Maybe ast.TypeExpr, recs: Dict (List String)) -> Bool =
  match ret with
  | Just (ast.TypeName n) -> dict_member(n, recs) || list_member(n, primitive_results)
  | _ -> false

# No type variable, and no arrow, thunk or effect row.
fn closed_type(te: ast.TypeExpr) -> Bool =
  match te with
  | ast.TypeName n -> !source.is_lowercase_name(n)
  | ast.TypeApply f a -> closed_type(f) && closed_type(a)
  | ast.TupleType items -> all(closed_type, items)
  | ast.TypeArrow _ _ _ _ -> false
  | ast.TypeThunk _ _ -> false
  | ast.TypeEffect _ _ -> false

# The node count of an inlinable body, `Nothing` when it holds a form that cannot be copied:
# only variables, literals, arithmetic, field reads, record literals, calls of a top-level name
# and one-arm variable lets. A lambda, `match`, `do`, `if`, tuple, range, record update or
# dictionary reference makes the callee ineligible.
fn body_size(e: typed_ast.TypedExpr, top: Set) -> Maybe Int =
  match e with
  | typed_ast.TVar _ _ _ -> Just(1)
  | typed_ast.TInt _ _ _ -> Just(1)
  | typed_ast.TFloat _ _ _ -> Just(1)
  | typed_ast.TBool _ _ _ -> Just(1)
  | typed_ast.TString _ _ _ -> Just(1)
  | typed_ast.TChar _ _ _ -> Just(1)
  | typed_ast.TUnit _ _ -> Just(1)
  | typed_ast.TBinary _ l r _ _ -> sum_sizes([l, r], top, 1)
  | typed_ast.TUnary _ x _ _ -> sum_sizes([x], top, 1)
  | typed_ast.TGetField base _ _ _ -> sum_sizes([base], top, 1)
  | typed_ast.TRecord _ fields _ _ -> sum_sizes(list_map(typed_ast.field_value, fields), top, 1)
  | typed_ast.TCall callee args _ _ ->
      match callee with
      | typed_ast.TVar f _ _ -> if set_member(f, top) then sum_sizes(args, top, 2) else Nothing
      | _ -> Nothing
  | typed_ast.TMatch scrut branches _ _ ->
      match branches with
      | [typed_ast.TypedMatchBranch(ast.VarPattern _ _) body] -> sum_sizes([scrut, body], top, 1)
      | _ -> Nothing
  | typed_ast.TTuple _ _ _ -> Nothing
  | typed_ast.TIf _ _ _ _ _ -> Nothing
  | typed_ast.TDict _ _ _ _ -> Nothing
  | typed_ast.TMethodRef _ _ _ _ _ -> Nothing
  | typed_ast.TLambda _ _ _ _ -> Nothing
  | typed_ast.TRange _ _ _ _ -> Nothing
  | typed_ast.TDo _ _ _ -> Nothing
  | typed_ast.TRecordUpdate _ _ _ _ -> Nothing

fn sum_sizes(es: List typed_ast.TypedExpr, top: Set, acc: Int) -> Maybe Int =
  match es with
  | [] -> Just(acc)
  | [x | rest] ->
      match body_size(x, top) with
      | Nothing -> Nothing
      | Just k -> sum_sizes(rest, top, acc + k)

# ---------------------------------------------------------------------------
# The walk. Bottom-up, so a record let nested in another splits too. Every step returns the
# rewritten node, whether anything below it changed, and the state (next free suffix, budget
# left); a node with no change below it comes back as the same node, which `expand_program` uses
# to share the program.
# ---------------------------------------------------------------------------

# Each declaration starts with a full budget.
fn walk_decl(d: typed_ast.TypedDecl, cx: Ctx, g: Gen) -> (typed_ast.TypedDecl, Bool, Gen) =
  match d with
  | typed_ast.TFnDecl name params ret eff cs body ->
      let (b, changed, g1) = walk(body, AsValue, cx_bind(cx, ast.param_names, params), fresh_budget(g))
      in if changed then (typed_ast.TFnDecl(name, params, ret, eff, cs, b), true, g1) else (d, false, g1)
  | typed_ast.TLetDecl name value ->
      let (v, changed, g1) = walk(value, AsValue, cx, fresh_budget(g))
      in if changed then (typed_ast.TLetDecl(name, v), true, g1) else (d, false, g1)
  | typed_ast.TInstanceDecl c cs methods ->
      let (ms, changed, g1) = walk_seq(\ (m, k) -> walk_method(m, cx, k), methods, g)
      in if changed then (typed_ast.TInstanceDecl(c, cs, ms), true, g1) else (d, false, g1)
  | typed_ast.TExternFnDecl _ _ _ _ -> (d, false, g)
  | typed_ast.TPassThrough _ -> (d, false, g)

fn walk_method(m: typed_ast.TypedInstanceMethod, cx: Ctx, g: Gen) ->
    (typed_ast.TypedInstanceMethod, Bool, Gen) =
  match m with
  | typed_ast.TypedInstanceMethod name params ret eff cs body ->
      let (b, changed, g1) = walk(body, AsValue, cx_bind(cx, ast.param_names, params), fresh_budget(g))
      in if changed then (typed_ast.TypedInstanceMethod(name, params, ret, eff, cs, b), true, g1)
         else (m, false, g1)

# A call may inline, a let may split; every other form walks its children.
fn walk(e: typed_ast.TypedExpr, dm: Demand, cx: Ctx, g: Gen) -> (typed_ast.TypedExpr, Bool, Gen) =
  match e with
  | typed_ast.TCall (typed_ast.TVar f _ _) args t p -> walk_call(e, f, args, t, p, dm, cx, g)
  | typed_ast.TMatch scrut [typed_ast.TypedMatchBranch(ast.VarPattern x vp) body] t p ->
      walk_let(e, scrut, x, vp, body, t, p, dm, cx, g)
  | _ -> walk_children(e, cx, g)

# `f(args)`, when `f` is a callee, a record allocation goes away, the budget covers the body and
# the copy would not read a local in place of a top-level (`captures`): copy its body in and walk
# the copy, whose calls may now inline in turn. Otherwise the arguments walk as values.
fn walk_call(e: typed_ast.TypedExpr, f: String, args: List typed_ast.TypedExpr, t: types.Type,
             p: source.SourcePos, dm: Demand, cx: Ctx, g: Gen) -> (typed_ast.TypedExpr, Bool, Gen) =
  match dict_get(f, cx.callees) with
  | Just c ->
      if inlines(c, args, dm, cx) && c.size <= g.budget && !captures(c, cx)
      then
        let (copy, n1) = instantiate(c, args, t, p, g.n)
            (r, _, g2) = walk(copy, dm, cx, Gen(n = n1, budget = g.budget - c.size))
        in (r, true, g2)
      else walk_children(e, cx, g)
  | Nothing -> walk_children(e, cx, g)

# A builder under `OnlyFields` always inlines; any callee inlines when a field-only parameter gets a
# flat argument. A call that does not pass every parameter is a partial application and stays.
fn inlines(c: Callee, args: List typed_ast.TypedExpr, dm: Demand, cx: Ctx) -> Bool =
  list_length(args) == list_length(c.params)
  && ((wants_fields(dm) && is_just(c.builder)) || has_flat_arg(c.field_only, args, cx))

fn has_flat_arg(flags: List Bool, args: List typed_ast.TypedExpr, cx: Ctx) -> Bool =
  match flags with
  | [] -> false
  | [fo | rest] ->
      match args with
      | [] -> false
      | [a | more] -> (fo && flat_arg(a, cx)) || has_flat_arg(rest, more, cx)

# A builder call, a literal of a non-linear record (`recs` holds no other), or a variable bound by
# a let that will split. Inlining let-binds a literal, which `walk_let` then splits.
fn flat_arg(a: typed_ast.TypedExpr, cx: Ctx) -> Bool =
  match a with
  | typed_ast.TVar v _ _ -> list_member(v, cx.flat)
  | typed_ast.TRecord rname _ _ _ -> dict_member(rname, cx.recs)
  | typed_ast.TCall (typed_ast.TVar g _ _) gargs _ _ -> is_just(builder_call(g, gargs, cx))
  | _ -> false

# The record `g(gargs)` builds, when `g` is a builder and the call passes every parameter.
fn builder_call(g: String, gargs: List typed_ast.TypedExpr, cx: Ctx) -> Maybe String =
  let Just c = dict_get(g, cx.callees) else Nothing
  in if list_length(gargs) == list_length(c.params) then c.builder else Nothing

# ---------------------------------------------------------------------------
# Inlining a call (docs/record-sra-v0.md §4.3).
# ---------------------------------------------------------------------------

# The callee's body with each parameter replaced. A variable or literal argument substitutes
# directly, which keeps a split variable visible to the split; any other is let-bound first, in
# argument order, to a fresh `param$N`. The lets carry the call's type and position; the body keeps
# the callee's.
fn instantiate(c: Callee, args: List typed_ast.TypedExpr, t: types.Type, p: source.SourcePos, n: Int) ->
    (typed_ast.TypedExpr, Int) =
  let (env, lets, n1) = bind_args(c.params, args, dict_empty(), [], n)
      (body, n2) = inst(c.body, env, n1)
  in (let_chain(list_map(arg_binding(p, _), lets), body, t), n2)

# An argument's let: its pattern sits where its value does, and the let where the call does.
fn arg_binding(p: source.SourcePos, b: (String, typed_ast.TypedExpr)) ->
    (String, source.SourcePos, typed_ast.TypedExpr, source.SourcePos) =
  let (name, value) = b
  in (name, typed_ast.typed_expr_pos(value), value, p)

fn bind_args(params: List String, args: List typed_ast.TypedExpr, env: Dict typed_ast.TypedExpr,
             lets: List (String, typed_ast.TypedExpr), n: Int) ->
    (Dict typed_ast.TypedExpr, List (String, typed_ast.TypedExpr), Int) =
  match params with
  | [] -> (env, list_reverse(lets), n)
  | [pn | prest] ->
      match args with
      | [] -> (env, list_reverse(lets), n)
      | [a | arest] ->
          if vec_wrappers.is_atomic(a) then bind_args(prest, arest, dict_set(pn, a, env), lets, n)
          else
            let fresh = pass_name(pn, n)
                v = typed_ast.TVar(fresh, typed_ast.typed_expr_type(a), typed_ast.typed_expr_pos(a))
            in bind_args(prest, arest, dict_set(pn, v, env), Cons((fresh, a), lets), n + 1)

# `let n1 = v1 in let n2 = v2 in ... body`, the first binding outermost so it runs first. A binding
# is its name, the position of its pattern, its value and the position of its let; every let has
# type `t`.
fn let_chain(lets: List (String, source.SourcePos, typed_ast.TypedExpr, source.SourcePos),
             body: typed_ast.TypedExpr, t: types.Type) -> typed_ast.TypedExpr =
  match lets with
  | [] -> body
  | [(name, vp, value, p) | rest] ->
      typed_ast.TMatch(value, [typed_ast.TypedMatchBranch(ast.VarPattern(name, vp), let_chain(rest, body, t))],
                       t, p)

# `e` with each variable `env` maps replaced, and every let binder renamed to a fresh name. A
# callee body holds only the forms `body_size` admits, so the rest cannot arrive.
fn inst(e: typed_ast.TypedExpr, env: Dict typed_ast.TypedExpr, n: Int) -> (typed_ast.TypedExpr, Int) =
  match e with
  | typed_ast.TVar v _ _ ->
      match dict_get(v, env) with
      | Just r -> (r, n)
      | Nothing -> (e, n)
  | typed_ast.TInt _ _ _ -> (e, n)
  | typed_ast.TFloat _ _ _ -> (e, n)
  | typed_ast.TBool _ _ _ -> (e, n)
  | typed_ast.TString _ _ _ -> (e, n)
  | typed_ast.TChar _ _ _ -> (e, n)
  | typed_ast.TUnit _ _ -> (e, n)
  | typed_ast.TBinary op l r t p ->
      let (l1, n1) = inst(l, env, n)
          (r1, n2) = inst(r, env, n1)
      in (typed_ast.TBinary(op, l1, r1, t, p), n2)
  | typed_ast.TUnary op x t p ->
      let (x1, n1) = inst(x, env, n)
      in (typed_ast.TUnary(op, x1, t, p), n1)
  | typed_ast.TGetField base fld t p ->
      let (b1, n1) = inst(base, env, n)
      in (typed_ast.TGetField(b1, fld, t, p), n1)
  | typed_ast.TRecord name fields t p ->
      let (fs, n1) = inst_fields(fields, env, n)
      in (typed_ast.TRecord(name, fs, t, p), n1)
  | typed_ast.TCall callee args t p ->
      let (f, n1) = inst(callee, env, n)
          (xs, n2) = inst_list(args, env, n1)
      in (typed_ast.TCall(f, xs, t, p), n2)
  | typed_ast.TMatch scrut branches t p -> inst_let(scrut, branches, t, p, env, n)
  | typed_ast.TTuple _ _ _ -> inst_unreachable()
  | typed_ast.TIf _ _ _ _ _ -> inst_unreachable()
  | typed_ast.TDict _ _ _ _ -> inst_unreachable()
  | typed_ast.TMethodRef _ _ _ _ _ -> inst_unreachable()
  | typed_ast.TLambda _ _ _ _ -> inst_unreachable()
  | typed_ast.TRange _ _ _ _ -> inst_unreachable()
  | typed_ast.TDo _ _ _ -> inst_unreachable()
  | typed_ast.TRecordUpdate _ _ _ _ -> inst_unreachable()

fn inst_unreachable() -> (typed_ast.TypedExpr, Int) =
  panic("rec_inline.inst: a callee body holds a form body_size rejects (internal error)")

fn inst_list(es: List typed_ast.TypedExpr, env: Dict typed_ast.TypedExpr, n: Int) ->
    (List typed_ast.TypedExpr, Int) =
  match es with
  | [] -> ([], n)
  | [x | rest] ->
      let (y, n1) = inst(x, env, n)
          (ys, n2) = inst_list(rest, env, n1)
      in (Cons(y, ys), n2)

fn inst_fields(fields: List typed_ast.TypedRecordField, env: Dict typed_ast.TypedExpr, n: Int) ->
    (List typed_ast.TypedRecordField, Int) =
  match fields with
  | [] -> ([], n)
  | [typed_ast.TypedRecordField name v | rest] ->
      let (v1, n1) = inst(v, env, n)
          (rest1, n2) = inst_fields(rest, env, n1)
      in (Cons(typed_ast.TypedRecordField(name, v1), rest1), n2)

# A one-arm variable let: the value sees the outer scope, the body sees the fresh binder.
fn inst_let(scrut: typed_ast.TypedExpr, branches: List typed_ast.TypedMatchBranch, t: types.Type,
            p: source.SourcePos, env: Dict typed_ast.TypedExpr, n: Int) -> (typed_ast.TypedExpr, Int) =
  match branches with
  | [typed_ast.TypedMatchBranch(ast.VarPattern x vp) body] ->
      let (s, n1) = inst(scrut, env, n)
          fresh = pass_name(x, n1)
          v = typed_ast.TVar(fresh, typed_ast.typed_expr_type(s), vp)
          (b, n2) = inst(body, dict_set(x, v, env), n1 + 1)
      in (typed_ast.TMatch(s, [typed_ast.TypedMatchBranch(ast.VarPattern(fresh, vp), b)], t, p), n2)
  | _ -> inst_unreachable()

# ---------------------------------------------------------------------------
# A let, and the split it may take.
# ---------------------------------------------------------------------------

# `let x = scrut in body`. When `scrut` is a record literal or a builder call and `body` only reads
# `x` by field or hands it to a field-only parameter, `x` is expected to split: `scrut` walks as
# read by field. `x` is flat in `body` only if the walked `scrut` then ends in a record literal. A
# builder call the budget kept from inlining is still a call, so `x` stays an allocated result and
# a callee that takes it must not inline. With `x` flat, the calls in `body` that take it inline:
# one walk for a cycle ("`x` splits iff the call inlines iff `x` is flat"). The split runs only
# when `x` was flat (a let that does not expect to split cannot: the check with callees is the
# looser one) and on what the walk produced; when the budget kept a call in `body` from inlining,
# `x` has a bare use left, `subst` refuses, and the let stays.
fn walk_let(e: typed_ast.TypedExpr, scrut: typed_ast.TypedExpr, x: String, vp: source.SourcePos,
            body: typed_ast.TypedExpr, t: types.Type, p: source.SourcePos, dm: Demand, cx: Ctx, g: Gen) ->
    (typed_ast.TypedExpr, Bool, Gen) =
  let expected = split_expected(scrut, x, body, cx)
      (s, ch1, g1) = walk(scrut, if expected then OnlyFields else AsValue, cx, g)
      flat_x = expected && ends_in_record(s, cx.recs)
      cx_body = bind_flat(cx, x, flat_x)
      (b, ch2, g2) = walk(body, dm, cx_body, g1)
      rebuilt = if ch1 || ch2
                then typed_ast.TMatch(s, [typed_ast.TypedMatchBranch(ast.VarPattern(x, vp), b)], t, p)
                else e
  in if !flat_x then (rebuilt, ch1 || ch2, g2)
     else
       match split_let(rebuilt, cx.recs, g2.n) with
       | Just (split, n3) -> (split, true, g2 with (n = n3))
       | Nothing -> (rebuilt, ch1 || ch2, g2)

# Whether `e`, past its leading pass-made lets, is a literal of a non-linear record: what
# `split_let` takes apart.
fn ends_in_record(e: typed_ast.TypedExpr, recs: Dict (List String)) -> Bool =
  match peel_lets(e, []) with
  | (_, typed_ast.TRecord rname _ _ _) -> dict_member(rname, recs)
  | _ -> false

# `cx` for the body of `let x`: `x` flat when it will split, and not flat otherwise, since it
# shadows an outer variable of the same name.
fn bind_flat(cx: Ctx, x: String, is_flat: Bool) -> Ctx =
  let outer = cx_bind_names(cx, [x])
  in if is_flat then outer with (flat = Cons(x, outer.flat)) else outer

# Whether the let will split: its value is a record literal or a builder call, and every use of
# `x` in the body allows it.
fn split_expected(scrut: typed_ast.TypedExpr, x: String, body: typed_ast.TypedExpr, cx: Ctx) -> Bool =
  let Just rname = record_source(scrut, cx) else false
      Just _ = dict_get(rname, cx.recs) else false
  in splittable(x, cx.callees, body)

fn record_source(scrut: typed_ast.TypedExpr, cx: Ctx) -> Maybe String =
  match scrut with
  | typed_ast.TRecord rname _ _ _ -> Just(rname)
  | typed_ast.TCall (typed_ast.TVar g _ _) gargs _ _ -> builder_call(g, gargs, cx)
  | _ -> Nothing

# `e` with each child walked, left to right, as a value. Exhaustive with no wildcard, as
# `typed_ast.children` is, so a new expression form stops the build here. A binder removes the
# variables it rebinds from `flat` for what it scopes over.
fn walk_children(e: typed_ast.TypedExpr, cx: Ctx, g: Gen) -> (typed_ast.TypedExpr, Bool, Gen) =
  match e with
  | typed_ast.TVar _ _ _ -> (e, false, g)
  | typed_ast.TInt _ _ _ -> (e, false, g)
  | typed_ast.TFloat _ _ _ -> (e, false, g)
  | typed_ast.TBool _ _ _ -> (e, false, g)
  | typed_ast.TString _ _ _ -> (e, false, g)
  | typed_ast.TChar _ _ _ -> (e, false, g)
  | typed_ast.TUnit _ _ -> (e, false, g)
  | typed_ast.TDict _ _ _ _ -> (e, false, g)
  | typed_ast.TMethodRef _ _ _ _ _ -> (e, false, g)
  | typed_ast.TTuple items t p ->
      let (xs, changed, g1) = walk_exprs(items, cx, g)
      in if changed then (typed_ast.TTuple(xs, t, p), true, g1) else (e, false, g1)
  | typed_ast.TIf cond then_e else_e t p ->
      let (c, ch1, g1) = walk(cond, AsValue, cx, g)
          (a, ch2, g2) = walk(then_e, AsValue, cx, g1)
          (b, ch3, g3) = walk(else_e, AsValue, cx, g2)
      in if ch1 || ch2 || ch3 then (typed_ast.TIf(c, a, b, t, p), true, g3) else (e, false, g3)
  | typed_ast.TMatch scrut branches t p ->
      let (s, ch1, g1) = walk(scrut, AsValue, cx, g)
          (bs, ch2, g2) = walk_seq(\ (b, k) -> walk_branch(b, cx, k), branches, g1)
      in if ch1 || ch2 then (typed_ast.TMatch(s, bs, t, p), true, g2) else (e, false, g2)
  | typed_ast.TCall callee args t p ->
      let (f, ch1, g1) = walk(callee, AsValue, cx, g)
          (xs, ch2, g2) = walk_exprs(args, cx, g1)
      in if ch1 || ch2 then (typed_ast.TCall(f, xs, t, p), true, g2) else (e, false, g2)
  | typed_ast.TLambda params body t p ->
      let (b, changed, g1) = walk(body, AsValue, cx_bind(cx, ast.param_names, params), g)
      in if changed then (typed_ast.TLambda(params, b, t, p), true, g1) else (e, false, g1)
  | typed_ast.TBinary op left right t p ->
      let (l, ch1, g1) = walk(left, AsValue, cx, g)
          (r, ch2, g2) = walk(right, AsValue, cx, g1)
      in if ch1 || ch2 then (typed_ast.TBinary(op, l, r, t, p), true, g2) else (e, false, g2)
  | typed_ast.TUnary op operand t p ->
      let (x, changed, g1) = walk(operand, AsValue, cx, g)
      in if changed then (typed_ast.TUnary(op, x, t, p), true, g1) else (e, false, g1)
  | typed_ast.TRange lo hi t p ->
      let (a, ch1, g1) = walk(lo, AsValue, cx, g)
          (b, ch2, g2) = walk(hi, AsValue, cx, g1)
      in if ch1 || ch2 then (typed_ast.TRange(a, b, t, p), true, g2) else (e, false, g2)
  | typed_ast.TDo steps t p ->
      let (ss, changed, g1) = walk_steps(steps, cx, g, [], false)
      in if changed then (typed_ast.TDo(ss, t, p), true, g1) else (e, false, g1)
  | typed_ast.TRecord name fields t p ->
      let (fs, changed, g1) = walk_seq(\ (f, k) -> walk_field(f, cx, k), fields, g)
      in if changed then (typed_ast.TRecord(name, fs, t, p), true, g1) else (e, false, g1)
  | typed_ast.TGetField base fld t p ->
      let (b, changed, g1) = walk(base, AsValue, cx, g)
      in if changed then (typed_ast.TGetField(b, fld, t, p), true, g1) else (e, false, g1)
  | typed_ast.TRecordUpdate base fields t p ->
      let (b, ch1, g1) = walk(base, AsValue, cx, g)
          (fs, ch2, g2) = walk_seq(\ (f, k) -> walk_field(f, cx, k), fields, g1)
      in if ch1 || ch2 then (typed_ast.TRecordUpdate(b, fs, t, p), true, g2) else (e, false, g2)

fn walk_exprs(es: List typed_ast.TypedExpr, cx: Ctx, g: Gen) -> (List typed_ast.TypedExpr, Bool, Gen) =
  walk_seq(\ (x, k) -> walk(x, AsValue, cx, k), es, g)

fn walk_branch(b: typed_ast.TypedMatchBranch, cx: Ctx, g: Gen) -> (typed_ast.TypedMatchBranch, Bool, Gen) =
  match b with
  | typed_ast.TypedMatchBranch pat body ->
      let (x, changed, g1) = walk(body, AsValue, cx_bind(cx, ast.pattern_names, pat), g)
      in if changed then (typed_ast.TypedMatchBranch(pat, x), true, g1) else (b, false, g1)

fn step_binders(s: typed_ast.TypedDoStep) -> List String =
  match s with
  | typed_ast.TDoBindStep pat _ _ -> ast.pattern_names(pat)
  | typed_ast.TDoLetStep name _ -> [name]
  | typed_ast.TDoExprStep _ -> []

# The steps in order. A step's value sees the `flat` of the steps before it; its binders hide a
# variable from the steps after it only, as `subst_steps` scopes them.
fn walk_steps(steps: List typed_ast.TypedDoStep, cx: Ctx, g: Gen, acc: List typed_ast.TypedDoStep,
              changed: Bool) -> (List typed_ast.TypedDoStep, Bool, Gen) =
  match steps with
  | [] -> (list_reverse(acc), changed, g)
  | [s | rest] ->
      let (s1, ch, g1) = walk_step(s, cx, g)
      in walk_steps(rest, cx_bind(cx, step_binders, s), g1, Cons(s1, acc), changed || ch)

fn walk_step(s: typed_ast.TypedDoStep, cx: Ctx, g: Gen) -> (typed_ast.TypedDoStep, Bool, Gen) =
  match s with
  | typed_ast.TDoBindStep pat value mode ->
      let (v, changed, g1) = walk(value, AsValue, cx, g)
      in if changed then (typed_ast.TDoBindStep(pat, v, mode), true, g1) else (s, false, g1)
  | typed_ast.TDoLetStep name value ->
      let (v, changed, g1) = walk(value, AsValue, cx, g)
      in if changed then (typed_ast.TDoLetStep(name, v), true, g1) else (s, false, g1)
  | typed_ast.TDoExprStep value ->
      let (v, changed, g1) = walk(value, AsValue, cx, g)
      in if changed then (typed_ast.TDoExprStep(v), true, g1) else (s, false, g1)

fn walk_field(f: typed_ast.TypedRecordField, cx: Ctx, g: Gen) -> (typed_ast.TypedRecordField, Bool, Gen) =
  match f with
  | typed_ast.TypedRecordField name value ->
      let (v, changed, g1) = walk(value, AsValue, cx, g)
      in if changed then (typed_ast.TypedRecordField(name, v), true, g1) else (f, false, g1)

# `step` over a list, left to right, threading the state. Tail recursive.
fn walk_seq(step: a -> Gen -> (a, Bool, Gen), xs: List a, g: Gen) -> (List a, Bool, Gen) =
  walk_seq_go(step, xs, g, [], false)

fn walk_seq_go(step: a -> Gen -> (a, Bool, Gen), xs: List a, g: Gen, acc: List a, changed: Bool) ->
    (List a, Bool, Gen) =
  match xs with
  | [] -> (list_reverse(acc), changed, g)
  | [x | rest] ->
      let (y, ch, g1) = step(x, g)
      in walk_seq_go(step, rest, g1, Cons(y, acc), changed || ch)

# ---------------------------------------------------------------------------
# The split (docs/record-sra-v0.md §4.4).
# ---------------------------------------------------------------------------

# A `let x = R(..) in b` is a one-arm match on a variable pattern (`ast.let_bind_match`; `where`
# is the same construct). Splits it when `R` is a splittable record, the literal names every field
# once, and every free occurrence of `x` in `b` is the base of a field read, which `subst` checks
# as it rewrites: `Err` for a bare use, so the let stays. Lets leading the value
# float out first, when the pass made them (`is_pass_name`):
#
#   let x = (let y = e0 in r) in b   ->   let y = e0 in let x = r in b
#
# `y` is fresh, so `b` cannot mention it. Any other let stays and blocks the split: a user's, and
# a bundler-renamed one (`$l_<name>`), which holds `$` too and may shadow a name `b` reads.
fn split_let(e: typed_ast.TypedExpr, recs: Dict (List String), n: Int) -> Maybe(typed_ast.TypedExpr, Int) =
  match e with
  | typed_ast.TMatch scrut [typed_ast.TypedMatchBranch(ast.VarPattern x vp) body] t p ->
      let (floated, tail) = peel_lets(scrut, [])
          typed_ast.TRecord rname fields _ _ = tail else Nothing
          Just decl_names = dict_get(rname, recs) else Nothing
          Just values = in_decl_order(decl_names, fields) else Nothing
          fresh = list_map(fresh_name(x, n, _), decl_names)
          Ok body1 = subst(x, dict_from_list(zip(decl_names, fresh)), body) else Nothing
          fields_lets = list_map(field_binding(vp, p, _), zip(fresh, values))
      in Just((let_chain(floated, let_chain(fields_lets, body1, t), t), n + 1))
  | _ -> Nothing

# A field's let: the original let's pattern and position.
fn field_binding(vp: source.SourcePos, p: source.SourcePos, b: (String, typed_ast.TypedExpr)) ->
    (String, source.SourcePos, typed_ast.TypedExpr, source.SourcePos) =
  let (name, value) = b
  in (name, vp, value, p)

# The leading pass-made lets of `e` as (name, pattern position, value, position), outermost
# first, and what they scope over.
fn peel_lets(e: typed_ast.TypedExpr, acc: List (String, source.SourcePos, typed_ast.TypedExpr, source.SourcePos)) ->
    (List (String, source.SourcePos, typed_ast.TypedExpr, source.SourcePos), typed_ast.TypedExpr) =
  match e with
  | typed_ast.TMatch value [typed_ast.TypedMatchBranch(ast.VarPattern y yp) inner] _ ip ->
      if is_pass_name(y) then peel_lets(inner, Cons((y, yp, value, ip), acc)) else (list_reverse(acc), e)
  | _ -> (list_reverse(acc), e)

fn fresh_name(x: String, n: Int, field: String) -> String =
  pass_name(x ++ "$" ++ field, n)

# Every name this pass makes: `base$N$ri`. `N` is used once program-wide, so the name is fresh, and
# the `$ri` suffix is this pass's alone: no source identifier holds `$`, and no other pass ends a
# name in `$ri`.
fn pass_name(base: String, n: Int) -> String =
  base ++ "$" ++ int_to_string(n) ++ "$ri"

fn is_pass_name(name: String) -> Bool = string.ends_with(name, "$ri")

# The literal's field values in declaration order, the order lowering evaluates a literal in.
# `Nothing` when a declared field is missing or the literal carries more fields than the record
# declares.
fn in_decl_order(names: List String, fields: List typed_ast.TypedRecordField) ->
    Maybe(List typed_ast.TypedExpr) =
  if list_length(names) == list_length(fields)
  then typed_ast.record_exprs_in_decl_order(names, fields)
  else Nothing

# ---------------------------------------------------------------------------
# Uses of the variable: may it split (`splittable`), and the rewrite (`subst`). Both stop below a
# binder that rebinds `x`, where `x` is a different variable. A scrutinee, a do-step value and a
# let's own value are outside the binder they feed. Both are exhaustive with no wildcard: a new
# expression form may bind names, and a scope-blind default would look below its binder.
# ---------------------------------------------------------------------------

# Whether every use of `x` in `e` allows the split: a field read, or an argument at a field-only
# parameter of a call to a callee in `callees` that passes every parameter (the call will inline,
# so the argument becomes field reads). Allocates nothing.
fn splittable(x: String, callees: Dict Callee, e: typed_ast.TypedExpr) -> Bool =
  match e with
  | typed_ast.TVar v _ _ -> v != x
  | typed_ast.TInt _ _ _ -> true
  | typed_ast.TFloat _ _ _ -> true
  | typed_ast.TBool _ _ _ -> true
  | typed_ast.TString _ _ _ -> true
  | typed_ast.TChar _ _ _ -> true
  | typed_ast.TUnit _ _ -> true
  | typed_ast.TDict _ _ _ _ -> true
  | typed_ast.TMethodRef _ _ _ _ _ -> true
  | typed_ast.TTuple _ _ _ -> children_splittable(x, callees, e)
  | typed_ast.TIf _ _ _ _ _ -> children_splittable(x, callees, e)
  | typed_ast.TBinary _ _ _ _ _ -> children_splittable(x, callees, e)
  | typed_ast.TUnary _ _ _ _ -> children_splittable(x, callees, e)
  | typed_ast.TRange _ _ _ _ -> children_splittable(x, callees, e)
  | typed_ast.TRecord _ _ _ _ -> children_splittable(x, callees, e)
  | typed_ast.TRecordUpdate _ _ _ _ -> children_splittable(x, callees, e)
  | typed_ast.TCall callee args _ _ ->
      match inlinable_callee(callee, args, callees) with
      | Just c -> all(arg_splittable(x, callees, _), zip(args, c.field_only))
      | Nothing -> children_splittable(x, callees, e)
  | typed_ast.TGetField base _ _ _ ->
      match base with
      | typed_ast.TVar _ _ _ -> true
      | _ -> children_splittable(x, callees, e)
  | typed_ast.TMatch scrut branches _ _ ->
      splittable(x, callees, scrut) && all(branch_splittable(x, callees, _), branches)
  | typed_ast.TLambda params body _ _ ->
      list_member(x, ast.param_names(params)) || splittable(x, callees, body)
  | typed_ast.TDo steps _ _ -> steps_splittable(x, callees, steps)

fn children_splittable(x: String, callees: Dict Callee, e: typed_ast.TypedExpr) -> Bool =
  all(splittable(x, callees, _), typed_ast.children(e))

# The callee of a call to a top-level callee that passes every parameter.
fn inlinable_callee(callee: typed_ast.TypedExpr, args: List typed_ast.TypedExpr, callees: Dict Callee) ->
    Maybe Callee =
  let typed_ast.TVar f _ _ = callee else Nothing
      Just c = dict_get(f, callees) else Nothing
  in if list_length(args) == list_length(c.params) then Just(c) else Nothing

# `x` itself is fine at a field-only parameter; anything else is checked as an expression.
fn arg_splittable(x: String, callees: Dict Callee, arg: (typed_ast.TypedExpr, Bool)) -> Bool =
  let (a, field_only) = arg
  in match a with
     | typed_ast.TVar v _ _ -> (v == x && field_only) || splittable(x, callees, a)
     | _ -> splittable(x, callees, a)

fn branch_splittable(x: String, callees: Dict Callee, b: typed_ast.TypedMatchBranch) -> Bool =
  match b with
  | typed_ast.TypedMatchBranch pat body ->
      list_member(x, ast.pattern_names(pat)) || splittable(x, callees, body)

# A step's value sees the `x` of the steps before it; its binder covers only the steps after it.
fn steps_splittable(x: String, callees: Dict Callee, steps: List typed_ast.TypedDoStep) -> Bool =
  match steps with
  | [] -> true
  | [s | rest] ->
      splittable(x, callees, typed_ast.step_value(s))
      && (list_member(x, step_binders(s)) || steps_splittable(x, callees, rest))

# `e` with each `x.f` read replaced by the variable `names` binds for `f`. `Err` when `x` occurs any
# other way, which `splittable` rules out first. Below a binder that rebinds `x`, `x` is a
# different variable: left alone.
fn subst(x: String, names: Dict String, e: typed_ast.TypedExpr) -> Result Unit typed_ast.TypedExpr =
  match e with
  | typed_ast.TVar v _ _ -> if v == x then Err(()) else Ok(e)
  | typed_ast.TInt _ _ _ -> Ok(e)
  | typed_ast.TFloat _ _ _ -> Ok(e)
  | typed_ast.TBool _ _ _ -> Ok(e)
  | typed_ast.TString _ _ _ -> Ok(e)
  | typed_ast.TChar _ _ _ -> Ok(e)
  | typed_ast.TUnit _ _ -> Ok(e)
  | typed_ast.TDict _ _ _ _ -> Ok(e)
  | typed_ast.TMethodRef _ _ _ _ _ -> Ok(e)
  | typed_ast.TTuple _ _ _ -> typed_ast.traverse_children(subst(x, names, _), e)
  | typed_ast.TIf _ _ _ _ _ -> typed_ast.traverse_children(subst(x, names, _), e)
  | typed_ast.TCall _ _ _ _ -> typed_ast.traverse_children(subst(x, names, _), e)
  | typed_ast.TBinary _ _ _ _ _ -> typed_ast.traverse_children(subst(x, names, _), e)
  | typed_ast.TUnary _ _ _ _ -> typed_ast.traverse_children(subst(x, names, _), e)
  | typed_ast.TRange _ _ _ _ -> typed_ast.traverse_children(subst(x, names, _), e)
  | typed_ast.TRecord _ _ _ _ -> typed_ast.traverse_children(subst(x, names, _), e)
  | typed_ast.TRecordUpdate _ _ _ _ -> typed_ast.traverse_children(subst(x, names, _), e)
  | typed_ast.TGetField base fld t p -> subst_field(x, names, base, fld, t, p, e)
  | typed_ast.TMatch scrut branches t p ->
      let s = try subst(x, names, scrut)
          bs = try traverse(subst_branch(x, names, _), branches)
      in Ok(typed_ast.TMatch(s, bs, t, p))
  | typed_ast.TLambda params body t p ->
      if list_member(x, ast.param_names(params))
      then Ok(e)
      else
        let b = try subst(x, names, body)
        in Ok(typed_ast.TLambda(params, b, t, p))
  | typed_ast.TDo steps t p ->
      let ss = try subst_steps(x, names, steps)
      in Ok(typed_ast.TDo(ss, t, p))

# `x.f` becomes the variable bound for `f`; a read of anything else recurses into its base.
fn subst_field(x: String, names: Dict String, base: typed_ast.TypedExpr, fld: String, t: types.Type,
               p: source.SourcePos, e: typed_ast.TypedExpr) -> Result Unit typed_ast.TypedExpr =
  match base with
  | typed_ast.TVar v _ _ ->
      if v != x then Ok(e)
      else
        match dict_get(fld, names) with
        | Just name -> Ok(typed_ast.TVar(name, t, p))
        | Nothing -> Err(())
  | _ -> typed_ast.traverse_children(subst(x, names, _), e)

fn subst_branch(x: String, names: Dict String, b: typed_ast.TypedMatchBranch) ->
    Result Unit typed_ast.TypedMatchBranch =
  match b with
  | typed_ast.TypedMatchBranch pat body ->
      if list_member(x, ast.pattern_names(pat))
      then Ok(b)
      else
        let body1 = try subst(x, names, body)
        in Ok(typed_ast.TypedMatchBranch(pat, body1))

# A step's value sees the `x` of the steps before it; its binder covers only the steps after it.
fn subst_steps(x: String, names: Dict String, steps: List typed_ast.TypedDoStep) ->
    Result Unit (List typed_ast.TypedDoStep) =
  match steps with
  | [] -> Ok([])
  | [s | rest] ->
      match s with
      | typed_ast.TDoBindStep pat value dmode ->
          let v = try subst(x, names, value)
          in subst_rest(typed_ast.TDoBindStep(pat, v, dmode), list_member(x, ast.pattern_names(pat)),
                        x, names, rest)
      | typed_ast.TDoLetStep name value ->
          let v = try subst(x, names, value)
          in subst_rest(typed_ast.TDoLetStep(name, v), name == x, x, names, rest)
      | typed_ast.TDoExprStep value ->
          let v = try subst(x, names, value)
          in subst_rest(typed_ast.TDoExprStep(v), false, x, names, rest)

fn subst_rest(done: typed_ast.TypedDoStep, rebinds: Bool, x: String, names: Dict String,
              rest: List typed_ast.TypedDoStep) -> Result Unit (List typed_ast.TypedDoStep) =
  if rebinds
  then Ok(Cons(done, rest))
  else
    let more = try subst_steps(x, names, rest)
    in Ok(Cons(done, more))
