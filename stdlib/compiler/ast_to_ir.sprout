module stdlib.compiler.ast_to_ir
import stdlib.compiler.ast as ast
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types
import stdlib.compiler.sprout_ir as sprout_ir

# ---------------------------------------------------------------------------
# AST → Sprout-IR translator.
# ---------------------------------------------------------------------------
#
# Milestone 1, PR 1.3 (see docs/gc-rooting-model-c-plan-2026-06-02.md).
#
# Supports the scalar subset of Sprout used for the IR-codegen bring-up:
#   - fn foo() -> Int = <intlit>            → IRConst + IRRet
#   - fn id(x: Int) -> Int = x              → IRRet "%x"   (parameter reference)
#   - fn add1(x: Int) -> Int = x + 1        → IRConst, IRIAdd, IRRet
#   - fn sub1, mul2 — likewise for Sub / Mul
#   - fn is_zero(x: Int) -> Bool = x == 0   → IRConst, IRICmp, IRRet  (i1)
#     (and the rest of the comparison family: !=, <, <=, >, >=)
#
# The user-declared `main` function is intentionally skipped here: it has a
# different LLVM calling convention (i32 @main(i32, ptr)) and the IR
# lowering emits a synthetic shim for it.
#
# Any other AST construct returns Err with a clear message — we never
# silently produce wrong IR.

# Fresh-name counter threaded through the translator.
# %t0, %t1, … name intermediate results introduced by the IR.
fn fresh_name(idx: Int) -> String =
  "%t" ++ int_to_string(idx)

# Map a TBinary op String to its LLVM icmp predicate, if it is a comparison.
# Returns Nothing for non-comparison ops (the caller handles those separately).
fn cmp_predicate(op: String) -> Maybe String =
  if op == "==" then Just("eq")
  else if op == "!=" then Just("ne")
  else if op == "<" then Just("slt")
  else if op == "<=" then Just("sle")
  else if op == ">" then Just("sgt")
  else if op == ">=" then Just("sge")
  else Nothing

# True iff t is the monomorphic Int type.
fn is_int_type(t: types.Type) -> Bool =
  match t with
  | types.TConst name -> name == "Int"
  | _ -> false

# True iff t is the monomorphic Bool type.
fn is_bool_type(t: types.Type) -> Bool =
  match t with
  | types.TConst name -> name == "Bool"
  | _ -> false

# Map an inferred return type to the LLVM type used for `define`/`ret`.
# PR 1.3 only emits i64 (Int) and i1 (Bool); anything else falls back to i64
# but the translator will already have rejected unsupported bodies before
# we get here.
fn llvm_ret_type(t: types.Type) -> String =
  if is_bool_type(t) then "i1" else "i64"

# Wrap an IntLit constant into the (ops, name, next-idx) triple.
fn intlit_triple(n: Int, idx: Int) -> (List sprout_ir.IROp, String, Int) =
  (Cons(sprout_ir.IRConst(name, n), Nil), name, idx + 1)
  where name = fresh_name(idx)

# Translate a TypedExpr into (ops_to_produce_value, result-name, next-idx).
# - For TVar x: ops=[], name="%x".
# - For TInt n: ops=[IRConst %tN n], name="%tN".
# - For TBinary: recursively translate operands, then append the arith/cmp op.
# Returns Err for any unsupported expression.
fn translate_expr(expr: typed_ast.TypedExpr, params: List String, idx: Int) -> Result String (List sprout_ir.IROp, String, Int) =
  match expr with
  | typed_ast.TInt n _ _ -> Ok(intlit_triple(n, idx))
  | typed_ast.TVar name _ _ ->
      if param_known(name, params)
      then Ok((Nil, "%" ++ name, idx))
      else Err("ast_to_ir: unbound variable '" ++ name ++ "'")
  | typed_ast.TBinary op left right _ _ -> translate_binary(op, left, right, params, idx)
  | typed_ast.TBool _ _ _ -> Err("ast_to_ir: Bool literal not yet supported")
  | typed_ast.TString _ _ _ -> Err("ast_to_ir: String literal not yet supported")
  | typed_ast.TChar _ _ _ -> Err("ast_to_ir: Char literal not yet supported")
  | typed_ast.TUnit _ _ -> Err("ast_to_ir: Unit literal not yet supported")
  | typed_ast.TTuple _ _ _ -> Err("ast_to_ir: Tuple not yet supported")
  | typed_ast.TIf _ _ _ _ _ -> Err("ast_to_ir: if-then-else not yet supported")
  | typed_ast.TMatch _ _ _ _ -> Err("ast_to_ir: match not yet supported")
  | typed_ast.TCall _ _ _ _ -> Err("ast_to_ir: call not yet supported")
  | typed_ast.TDict _ _ _ -> Err("ast_to_ir: TDict not yet supported")
  | typed_ast.TLambda _ _ _ _ -> Err("ast_to_ir: lambda not yet supported")
  | typed_ast.TUnary _ _ _ _ -> Err("ast_to_ir: unary op not yet supported")
  | typed_ast.TRange _ _ _ _ -> Err("ast_to_ir: range not yet supported")
  | typed_ast.TDo _ _ _ -> Err("ast_to_ir: do-block not yet supported")
  | typed_ast.TRecord _ _ _ _ -> Err("ast_to_ir: record not yet supported")
  | typed_ast.TGetField _ _ _ _ -> Err("ast_to_ir: field access not yet supported")

# Translate `left <op> right` into IR ops.  Op must be one of
# +, -, *, ==, !=, <, <=, >, >=.  Both operands must be Int-typed
# (Char comparison is intentionally rejected at this milestone).
fn translate_binary(op: String, left: typed_ast.TypedExpr, right: typed_ast.TypedExpr,
                    params: List String, idx: Int) -> Result String (List sprout_ir.IROp, String, Int) =
  if ! (is_int_type(typed_ast.typed_expr_type(left)) && is_int_type(typed_ast.typed_expr_type(right)))
  then Err("ast_to_ir: binary op '" ++ op ++ "' requires Int operands")
  else
    match translate_expr(left, params, idx) with
    | Err msg -> Err(msg)
    | Ok lpair ->
        match lpair with
        | (l_ops, l_name, idx1) ->
            match translate_expr(right, params, idx1) with
            | Err msg -> Err(msg)
            | Ok rpair ->
                match rpair with
                | (r_ops, r_name, idx2) -> finish_binary(op, l_ops, l_name, r_ops, r_name, idx2)

fn finish_binary(op: String, l_ops: List sprout_ir.IROp, l_name: String,
                 r_ops: List sprout_ir.IROp, r_name: String,
                 idx: Int) -> Result String (List sprout_ir.IROp, String, Int) =
  match arith_op(op, result, l_name, r_name) with
  | Just iop -> Ok((list_append(l_ops, list_append(r_ops, Cons(iop, Nil))), result, idx + 1))
  | Nothing ->
      match cmp_predicate(op) with
      | Just pred ->
          Ok((list_append(l_ops, list_append(r_ops,
                Cons(sprout_ir.IRICmp(result, pred, l_name, r_name), Nil))),
              result, idx + 1))
      | Nothing -> Err("ast_to_ir: binary op '" ++ op ++ "' not yet supported")
  where result = fresh_name(idx)

# Map a TBinary op String to the matching arithmetic IR constructor.
# Returns Nothing for non-arith ops; the caller falls back to cmp_predicate.
fn arith_op(op: String, result: String, lhs: String, rhs: String) -> Maybe sprout_ir.IROp =
  if op == "+" then Just(sprout_ir.IRIAdd(result, lhs, rhs))
  else if op == "-" then Just(sprout_ir.IRISub(result, lhs, rhs))
  else if op == "*" then Just(sprout_ir.IRIMul(result, lhs, rhs))
  else Nothing

# Translate a function body into a complete list of ops terminated by IRRet.
fn translate_body(body: typed_ast.TypedExpr, params: List String, idx: Int) -> Result String (List sprout_ir.IROp, Int) =
  match translate_expr(body, params, idx) with
  | Err msg -> Err(msg)
  | Ok triple ->
      match triple with
      | (ops, name, next_idx) -> Ok((list_append(ops, Cons(sprout_ir.IRRet(name), Nil)), next_idx))

fn param_known(name: String, params: List String) -> Bool =
  match params with
  | Nil -> false
  | Cons p rest -> if p == name then true else param_known(name, rest)

fn param_names(params: List ast.Param) -> List String =
  match params with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.Param n _ -> Cons(n, param_names(rest))

# Build an IRFunction from a (name, param-names, ret-type, body) tuple.
fn build_fn(name: String, pnames: List String, ret_ty: String, ops: List sprout_ir.IROp) -> sprout_ir.IRFunction =
  sprout_ir.IRFunction(name, pnames, ret_ty, Cons(sprout_ir.IRBlock("entry", ops), Nil))

# Translate a single TypedDecl into Maybe IRFunction.
# Returns Ok Nothing for decls we deliberately skip (main, externs, instances,
# pass-throughs, let-decls).  Returns Ok (Just f) for translated functions.
# Returns Err for an unsupported body surfaced by a function we tried to lower.
fn translate_decl(d: typed_ast.TypedDecl) -> Result String (Maybe sprout_ir.IRFunction) =
  match d with
  | typed_ast.TFnDecl name params _ _ _ body ->
      if name == "main"
      then Ok(Nothing)  # synthesized by ir_lowering as the C-ABI shim
      else translate_user_fn(name, param_names(params), body)
  | typed_ast.TExternFnDecl _ _ _ _ -> Ok(Nothing)
  | typed_ast.TLetDecl _ _ -> Ok(Nothing)
  | typed_ast.TInstanceDecl _ _ _ -> Ok(Nothing)
  | typed_ast.TPassThrough _ -> Ok(Nothing)

fn translate_user_fn(name: String, pnames: List String, body: typed_ast.TypedExpr) -> Result String (Maybe sprout_ir.IRFunction) =
  match translate_body(body, pnames, 0) with
  | Err msg -> Err(msg)
  | Ok pair ->
      match pair with
      | (ops, _) -> Ok(Just(build_fn(name, pnames, ret_ty, ops)))
  where ret_ty = llvm_ret_type(typed_ast.typed_expr_type(body))

fn translate_decls(decls: List typed_ast.TypedDecl, acc: List sprout_ir.IRFunction) -> Result String (List sprout_ir.IRFunction) =
  match decls with
  | Nil -> Ok(list_reverse(acc))
  | Cons d rest ->
      match translate_decl(d) with
      | Err msg -> Err(msg)
      | Ok maybe_f ->
          match maybe_f with
          | Nothing -> translate_decls(rest, acc)
          | Just f -> translate_decls(rest, Cons(f, acc))

# translate_program: top-level entry.  Accepts a TypedProgram (the output of
# compile_phase_recheck) and returns either the translated IRProgram or an
# Err describing the first unsupported AST node encountered.
export fn translate_program(prog: typed_ast.TypedProgram) -> Result String sprout_ir.IRProgram =
  match prog with
  | typed_ast.TypedProgram decls ->
      match translate_decls(decls, Nil) with
      | Err msg -> Err(msg)
      | Ok fns -> Ok(sprout_ir.IRProgram(fns))
