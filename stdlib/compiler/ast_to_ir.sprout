module stdlib.compiler.ast_to_ir
import stdlib.compiler.ast as ast
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types
import stdlib.compiler.source as source
import stdlib.compiler.sprout_ir as sprout_ir
import stdlib.compiler.field_kinds as fk
import stdlib.compiler.type_kind as type_kind
import stdlib.string as string

# ---------------------------------------------------------------------------
# Free-variable computation helpers (mirrored from codegen.sprout — not
# exported there, so duplicated here; follow-up cleanup: move to a shared
# typed_ast_utils module).
#
# compute_free_vars(expr, bound, top_level) -> Set String
#   A name is FREE if it appears as TVar and is not in `bound` (lambda params /
#   enclosing function params at this nesting level).
#   For TLambda sub-expressions the lambda's own params are added to `bound`
#   before recursing into the body.
#   `top_level` is retained for signature symmetry but NOT used to exclude names.
#   Excluding top_level here was WRONG: an enclosing parameter that collides with
#   a top-level fn name (e.g. `body` in `with_timeout(ms, body)` when the program
#   also defines `fn body`) would be dropped from the free set, hence never
#   captured, then re-resolved inside the lifted lambda to the top-level fn and
#   eta-expanded — a silent miscompile. The sole caller filters the result through
#   `filter_capturable` (params ∪ captures), which already drops genuine globals,
#   so the top_level exclusion was redundant everywhere except at a collision.
# O(n * log(n)) where n = number of TVar nodes.

# O(n * log(n)).
fn set_from_list(xs: List String) -> Set =
  list_fold(\ (s, x) -> set_insert(x, s), set_empty(), xs)

# O(n * log(n)).
fn compute_free_vars(expr: typed_ast.TypedExpr, bound: Set, top_level: Set) -> Set =
  match expr with
  | typed_ast.TVar name _ _ ->
      if set_member(name, bound)
      then set_empty()
      else set_insert(name, set_empty())
  | typed_ast.TInt _ _ _ -> set_empty()
  | typed_ast.TFloat _ _ _ -> set_empty()
  | typed_ast.TBool _ _ _ -> set_empty()
  | typed_ast.TString _ _ _ -> set_empty()
  | typed_ast.TChar _ _ _ -> set_empty()
  | typed_ast.TUnit _ _ -> set_empty()
  | typed_ast.TTuple items _ _ ->
      compute_free_vars_list(items, bound, top_level)
  | typed_ast.TIf cond thn els _ _ ->
      set_union(compute_free_vars(cond, bound, top_level),
        set_union(compute_free_vars(thn, bound, top_level),
                  compute_free_vars(els, bound, top_level)))
  | typed_ast.TBinary _ l r _ _ ->
      set_union(compute_free_vars(l, bound, top_level),
                compute_free_vars(r, bound, top_level))
  | typed_ast.TUnary _ operand _ _ ->
      compute_free_vars(operand, bound, top_level)
  | typed_ast.TCall callee args _ _ ->
      set_union(compute_free_vars(callee, bound, top_level),
                compute_free_vars_list(args, bound, top_level))
  | typed_ast.TLambda lparams body _ _ ->
      compute_free_vars(body,
        set_union(bound, set_from_list(fv_param_names(lparams))),
        top_level)
  | typed_ast.TRange start end_ _ _ ->
      set_union(compute_free_vars(start, bound, top_level),
                compute_free_vars(end_, bound, top_level))
  | typed_ast.TDo steps _ _ ->
      compute_free_vars_do_steps(steps, bound, top_level)
  | typed_ast.TDict _ _ _ _ -> set_empty()
  | typed_ast.TMethodRef _ _ _ _ _ -> panic("ast_to_ir.compute_free_vars: TMethodRef survived lowering (internal error)")
  | typed_ast.TRecord _ fields _ _ ->
      compute_free_vars_record_fields(fields, bound, top_level)
  | typed_ast.TMatch scrut arms _ _ ->
      set_union(compute_free_vars(scrut, bound, top_level),
                compute_free_vars_match_arms(arms, bound, top_level))
  | typed_ast.TGetField obj _ _ _ ->
      compute_free_vars(obj, bound, top_level)
  | typed_ast.TRecordUpdate base fields _ _ ->
      set_union(compute_free_vars(base, bound, top_level),
                compute_free_vars_record_fields(fields, bound, top_level))

# O(n * k * log(k)) where n = list length, k = expr size.
fn compute_free_vars_list(exprs: List typed_ast.TypedExpr, bound: Set, top_level: Set) -> Set =
  match exprs with
  | Nil -> set_empty()
  | Cons e rest ->
      set_union(compute_free_vars(e, bound, top_level),
                compute_free_vars_list(rest, bound, top_level))

# Extract param names for free-var computation (private to this section).
# O(n).
fn fv_param_names(params: List ast.Param) -> List String =
  match params with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.Param n _ _ -> Cons(n, fv_param_names(rest))

# Bind lambda param names (in order) to their argument SSA values in `captures` —
# the beta-reduction substitution for an inlined immediately-applied lambda (arc (b),
# translate_call's TLambda arm). A TVar for `n` then resolves via `captures` to its SSA
# with no IR emitted (see translate_expr's TVar arm), exactly like a do-block `let`.
# Names and ssas are equal length (the caller's arity guard); a short list stops early.
# O(n * log n).
fn bind_params(names: List String, ssas: List String, captures: Dict String) -> Dict String =
  match names with
  | Nil -> captures
  | Cons n nrest ->
      match ssas with
      | Nil -> captures
      | Cons s srest -> bind_params(nrest, srest, dict_set(n, s, captures))

# Collect all variable names bound by a pattern.
# Explicit on every constructor so adding a new Pattern variant surfaces here
# at compile time (no silent wildcard fallthrough).
# O(n) where n = pattern node count.
fn pattern_names(pat: ast.Pattern) -> List String =
  match pat with
  | ast.VarPattern name _ -> Cons(name, Nil)
  | ast.TuplePattern items _ -> pattern_names_list(items)
  | ast.ConstructorPattern _ args _ -> pattern_names_list(args)
  | ast.WildcardPattern _ -> Nil
  | ast.IntPattern _ _ -> Nil
  | ast.BoolPattern _ _ -> Nil
  | ast.StringPattern _ _ -> Nil
  | ast.CharPattern _ _ -> Nil
  | ast.UnitPattern _ -> Nil

# O(n) — accumulator + prepend-each avoids the O(n²) cost of list_append
# in a recursive call. Order is unimportant: all callers wrap the result
# in set_from_list for membership tests.
fn pattern_names_list(pats: List ast.Pattern) -> List String =
  pattern_names_list_go(pats, Nil)

fn pattern_names_list_go(pats: List ast.Pattern, acc: List String) -> List String =
  match pats with
  | Nil -> acc
  | Cons p rest -> pattern_names_list_go(rest, list_prepend_all(pattern_names(p), acc))

# Prepend every element of xs onto acc (in xs-order, reversed relative to acc).
# Order within a single pattern's names does not matter for set membership.
# O(n) where n = length of xs.
fn list_prepend_all(xs: List String, acc: List String) -> List String =
  match xs with
  | Nil -> acc
  | Cons x rest -> list_prepend_all(rest, Cons(x, acc))

# Free vars in a TDo step list, threading bound names left-to-right.
# Unreachable today (translate_expr rejects TDo); kept for when that
# translation lands — closure capture will then be correct without further
# changes to this helper.
# O(n * k * log(k)) where n = steps, k = expr size.
fn compute_free_vars_do_steps(steps: List typed_ast.TypedDoStep,
                              bound: Set, top_level: Set) -> Set =
  match steps with
  | Nil -> set_empty()
  | Cons step rest ->
      match step with
      | typed_ast.TDoBindStep pat e ->
          set_union(compute_free_vars(e, bound, top_level),
                    compute_free_vars_do_steps(rest,
                      set_union(bound, set_from_list(pattern_names(pat))), top_level))
      | typed_ast.TDoLetStep name e ->
          set_union(compute_free_vars(e, bound, top_level),
                    compute_free_vars_do_steps(rest,
                      set_insert(name, bound), top_level))
      | typed_ast.TDoExprStep e ->
          set_union(compute_free_vars(e, bound, top_level),
                    compute_free_vars_do_steps(rest, bound, top_level))

# Free vars across all TMatch arms, extending bound with pattern-bound names
# before recursing into each arm body.
# O(n * k * log(k)) where n = arms, k = arm body size.
fn compute_free_vars_match_arms(arms: List typed_ast.TypedMatchBranch,
                                bound: Set, top_level: Set) -> Set =
  match arms with
  | Nil -> set_empty()
  | Cons arm rest ->
      match arm with
      | typed_ast.TypedMatchBranch pat body ->
          set_union(
            compute_free_vars(body,
              set_union(bound, set_from_list(pattern_names(pat))), top_level),
            compute_free_vars_match_arms(rest, bound, top_level))

# Free vars in a TRecord field list — a record literal captured inside a lambda
# collects the free vars of each field value expression.
# O(n * k * log(k)) where n = fields, k = field expr size.
fn compute_free_vars_record_fields(fields: List typed_ast.TypedRecordField,
                                   bound: Set, top_level: Set) -> Set =
  match fields with
  | Nil -> set_empty()
  | Cons field rest ->
      match field with
      | typed_ast.TypedRecordField _ e ->
          set_union(compute_free_vars(e, bound, top_level),
                    compute_free_vars_record_fields(rest, bound, top_level))

# Build the top-level name Set from decl list + ctor dict.
# Includes user fn names, extern fn names, and ctor names.
# O(n * log(n)).
export fn build_top_level_set(decls: List typed_ast.TypedDecl, ctors: Dict sprout_ir.CtorInfo) -> Set =
  set_union(build_top_level_fn_set(decls),
            set_from_list(vec_to_list(dict_keys(ctors))))

# O(n).
fn build_top_level_fn_set(decls: List typed_ast.TypedDecl) -> Set =
  match decls with
  | Nil -> set_empty()
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name _ _ _ _ _ ->
          set_insert(name, build_top_level_fn_set(rest))
      | typed_ast.TExternFnDecl name _ _ _ ->
          set_insert(name, build_top_level_fn_set(rest))
      # FIX R4#4: TLetDecl names are top-level and must not be treated as free
      # variables inside nested lambdas. Adding them here prevents compute_free_vars
      # from classifying them as captures (filter_capturable drops them because
      # they appear in top_level but not in params).
      # NOTE: TVar resolution for top-level let names still requires a follow-up
      # decision — see T20 gap note in final review report.
      | typed_ast.TLetDecl name _ ->
          set_insert(name, build_top_level_fn_set(rest))
      | _ -> build_top_level_fn_set(rest)

# Filter a list of free-var names to those that are in `params` or `captures`.
# Names not in either are top-level and addressable by @ — skip them.
# O(n).
fn filter_capturable(frees: List String, params: List String,
                     captures: Dict String) -> List String =
  match frees with
  | Nil -> Nil
  | Cons v rest ->
      if param_known(v, params) || dict_has(v, captures)
      then Cons(v, filter_capturable(rest, params, captures))
      else filter_capturable(rest, params, captures)

# dict_has: true if key present in dict. O(log n).
fn dict_has(k: String, d: Dict String) -> Bool =
  match dict_get(k, d) with
  | Just _ -> true
  | Nothing -> false

# Look up a free var's current SSA name:
# - If in captures dict (was a capture in an outer lambda), use that SSA name.
# - If in params (a function parameter), use "%" ++ v.
# Returns Nothing if not found (should not happen after filter_capturable).
# O(log n).
fn lookup_free_var_ssa(v: String, params: List String,
                       captures: Dict String) -> Maybe String =
  match dict_get(v, captures) with
  | Just ssa -> Just(ssa)
  | Nothing ->
      if param_known(v, params)
      then Just("%" ++ v)
      else Nothing

# Build the list of SSA names for captured free vars (in order).
# Returns Err if any free var cannot be resolved (indicates a bug in
# filter_capturable: it should only pass names known to params or captures).
# O(n).
fn build_captures_list_ir(frees: List String, params: List String,
                          captures: Dict String) -> Result String (List String) =
  match frees with
  | Nil -> Ok(Nil)
  | Cons v rest ->
      match lookup_free_var_ssa(v, params, captures) with
      | Nothing -> Err("ast_to_ir: build_captures_list_ir: free var '" ++ v ++ "' not in params or captures — unreachable if filter_capturable is correct")
      | Just ssa ->
          match build_captures_list_ir(rest, params, captures) with
          | Err msg -> Err(msg)
          | Ok tail -> Ok(Cons(ssa, tail))

# Build the captures dict for a lifted lambda body.
# For each free var at index i (0-based), the lifted body reads it from
# env slot (i+1) as SSA name "%t$<base+i>".
# The "%t$" prefix uses '$' which Sprout's lexer cannot produce in user
# identifiers, so lifted-body SSA names are guaranteed disjoint from any
# user-written lambda param name (e.g. "t0").  See FIX #4.
# O(n).
fn build_lifted_captures(frees: List String, base_idx: Int) -> Dict String =
  build_lifted_captures_go(frees, base_idx, 0, dict_empty())

fn build_lifted_captures_go(frees: List String, base_idx: Int,
                             i: Int, acc: Dict String) -> Dict String =
  match frees with
  | Nil -> acc
  | Cons v rest ->
      build_lifted_captures_go(rest, base_idx, i + 1,
        dict_set(v, "%t$" ++ int_to_string(base_idx + i), acc))

# Determine the IRLoadEnvSlot kind for a single captured variable:
#   IRTScalar  — Int (no GC root needed)
#   IRTHeap    — everything else with a known type
#   IRTUnknown — type lookup failed (conservative; ir_rooting treats as heap)
# Char is a non-heap scalar (an immediate i64 codepoint), so a captured Char is
# treated like Int and needs no rooting.
# O(n) where n = body size (scans body for the TVar occurrence).
fn capture_kind(v: String, body: typed_ast.TypedExpr) -> sprout_ir.IRType =
  match find_capture_type(body, v) with
  | Nothing -> sprout_ir.IRTUnknown
  | Just t ->
      if is_int_type(t) || is_char_type(t) || is_double_type(t)
      then sprout_ir.IRTScalar
      else sprout_ir.IRTHeap

# Build a parallel list of kinds for each name in `frees`, given the lambda body.
# O(n * m) where n = frees length, m = body size.
fn build_capture_kinds(frees: List String, body: typed_ast.TypedExpr) -> List sprout_ir.IRType =
  match frees with
  | Nil -> Nil
  | Cons v rest -> Cons(capture_kind(v, body), build_capture_kinds(rest, body))

# Map a source-level TypeExpr annotation (or its absence) to an IRType used as
# the IRFunction param kind.  Known-scalar annotations → IRTScalar, other
# explicit annotations → IRTHeap, missing annotation → IRTUnknown.  All three
# enter heap_origin EXCEPT IRTScalar, so the IRTUnknown fallback is correctness-
# safe (over-roots) while preserving the "we didn't have type info" signal.
fn ann_to_irtype(ann: Maybe ast.TypeExpr) -> sprout_ir.IRType =
  match ann with
  | Just te ->
      if type_kind.type_expr_is_non_heap_scalar(te)
      then sprout_ir.IRTScalar
      else sprout_ir.IRTHeap
  | Nothing -> sprout_ir.IRTUnknown

# Zip ast.Param list with a parallel name list to produce IRFunction's params
# field shape.  Used at both IRFunction construction sites (lifted lambda and
# top-level fn).  Both list arguments are expected to be the same length; the
# function tolerates mismatch by truncating to the shorter (defensive).
fn ast_params_to_irtype_pairs(params: List ast.Param, names: List String) -> List (String, sprout_ir.IRType) =
  match (params, names) with
  | (Nil, _) -> Nil
  | (_, Nil) -> Nil
  | (Cons(ast.Param _ ann _) rest_p, Cons n rest_n) ->
      Cons((n, ann_to_irtype(ann)), ast_params_to_irtype_pairs(rest_p, rest_n))

# Build the IRLoadEnvSlot ops for the lifted lambda entry block.
# Each free var at index i gets: IRLoadEnvSlot("%t$<base+i>", "%env$", i+1, kind).
# (Slot 0 is the code pointer; captures start at slot 1.)
# "%t$" uses '$' which Sprout's lexer cannot produce in user identifiers,
# so lifted-body SSA names are guaranteed disjoint from any user-written
# lambda param name (e.g. "t0").
# "%env$" is likewise '$'-safe; disjoint from any user-written lambda param.
# FIX R4#7: accepts a `kinds` list (parallel to frees) for scalar vs heap.
# O(n).
fn build_load_env_ops(frees: List String, kinds: List sprout_ir.IRType, base_idx: Int) -> List sprout_ir.IROp =
  build_load_env_ops_go(frees, kinds, base_idx, 0)

fn build_load_env_ops_go(frees: List String, kinds: List sprout_ir.IRType, base_idx: Int, i: Int) -> List sprout_ir.IROp =
  match frees with
  | Nil -> Nil
  | Cons _ rest_frees ->
      match kinds with
      | Nil ->
          # Defensive: more frees than kinds (should not happen); treat as heap.
          Cons(sprout_ir.IRLoadEnvSlot("%t$" ++ int_to_string(base_idx + i), "%env$", i + 1, sprout_ir.IRTHeap),
               build_load_env_ops_go(rest_frees, Nil, base_idx, i + 1))
      | Cons k rest_kinds ->
          Cons(sprout_ir.IRLoadEnvSlot("%t$" ++ int_to_string(base_idx + i), "%env$", i + 1, k),
               build_load_env_ops_go(rest_frees, rest_kinds, base_idx, i + 1))

# ---------------------------------------------------------------------------
# Constructor table — name → (tag, actual_arity, max_arity_of_owning_ADT).
#
# Built once at program-translation entry by mirroring
# `build_ctor_sigs_from_decls` in `codegen.sprout`: tags are assigned
# sequentially across all `TPassThrough (TypeDecl …)` declarations in
# program order, starting from 0.  Matching codegen's numbering exactly is
# load-bearing: it lets the legacy and IR codegen paths be cross-checked.
#
# `actual_arity` is the number of fields of this specific constructor.
# It is used to validate ctor application arity (Bug B fix) and to guard
# bare TVar references to non-zero-arity ctors (Bug A fix).
#
# `max_arity_of_owning_ADT` is the largest field-count among the ADT's
# constructors.  `cpr_width_for_type_expr` in codegen.sprout classifies an
# ADT as CPR-eligible when this is 1 or 2 (yielding unboxed widths 2 and 3
# respectively).  Currently unused by ast_to_ir (M3 PR 2 routes CPR-eligible
# ctors through the boxed path); reserved for PR 2b which will use it to
# choose between boxed and sret lowering at the IRMakeCprCtor site.

# ---------------------------------------------------------------------------
# AST → Sprout-IR translator.
# ---------------------------------------------------------------------------
#
# Milestone 1, PR 1.5 (see docs/gc-rooting-model-c-plan-2026-06-02.md).
#
# Supports the scalar subset of Sprout used for the IR-codegen bring-up:
#   - fn foo() -> Int = <intlit>            → IRConst + IRRet
#   - fn id(x: Int) -> Int = x              → IRRet "%x"   (parameter reference)
#   - fn add1(x: Int) -> Int = x + 1        → IRConst, IRIAdd, IRRet
#   - fn sub1, mul2 — likewise for Sub / Mul
#   - fn is_zero(x: Int) -> Bool = x == 0   → IRConst, IRICmp, IRRet
#     (all named SSA values at function boundaries are i64 per
#     /code-review fix #2. IRICmp's lowering produces an i1 that LLVM
#     accepts as the IRRet operand only when the function ret_ty is i1;
#     because llvm_ret_type returns i64 unconditionally, Bool-returning
#     functions whose body ends in a comparison currently rely on the
#     fact that comparison-ending function bodies aren't yet exercised
#     by translator-driven tests. /code-review-v2 finding #3 tracks the
#     IRZext insertion that will close this case.)
#     (and the rest of the comparison family: !=, <, <=, >, >=)
#   - fn abs(x: Int) -> Int = if x < 0 then 0 - x else x
#       → IRICmp, IRCondBr, then-block, else-block, IRPhi, IRRet
#   - nested if-then-else, with each branch contributing its own blocks.
#   - direct calls: fn f(x: Int) -> Int = g(x + 1)  →  IRCall site after
#     arg eval; method / closure / typeclass dispatch are out of scope at
#     this milestone and produce a clear Err.
#   - self-recursive scalar calls: fn fact(n) = if n == 0 then 1 else n * fact(n - 1).
#     Recursion needs no special handling — the callee name `fact` is just
#     the TVar inside the TCall.
#
# The user-declared `main` function is special-cased here.  Its LLVM
# calling convention (i32 @main(i32, ptr)) differs from Sprout fns, and
# ir_lowering emits a synthetic shim for it that ignores the user body.
# That synthetic shim is silent: if the user wrote a non-trivial main
# body (e.g. one that calls print), the shim would still emit a no-op
# binary and the user would be confused.  To prevent that, translate_decl
# REJECTS any main whose body is not literally the unit literal `()`.
# A trivially-Unit main is skipped (Ok Nothing); any other main body
# returns Err with a clear message.
#
# Any other AST construct returns Err with a clear message — we never
# silently produce wrong IR.
#
# ---------------------------------------------------------------------------
# translate_expr contract (PR 1.4)
# ---------------------------------------------------------------------------
#
# Multi-block-aware expression translator.  The signature is:
#
#   translate_expr(expr, params, ctors, idx, cur_label, cur_ops) ->
#     Result String (List IRBlock, String, List IROp, String, Int)
#                    completed-blocks, new-cur-label, new-cur-ops,
#                    result-name, next-idx
#
# Inputs:
#   cur_label  — the label of the block currently being assembled (e.g.
#                "entry" at the function start, or a fresh join-label after
#                a previous if).
#   cur_ops    — the ops accumulated so far for cur_label (in forward
#                order).  Pure expressions append to it; control-flow
#                constructs seal it into a completed block and start a new
#                "current" block.
#
# Outputs:
#   completed-blocks — any blocks introduced by this sub-expression that
#                are NOT the current one.  These are FULLY SEALED — each
#                ends with IRBr or IRCondBr.  Order is the order they
#                should appear in the function (then before else before
#                join, for the if-case).
#   new-cur-label, new-cur-ops — the block label and forward-ordered ops
#                that the caller continues appending to.  For a pure
#                expression this is just (cur_label, cur_ops ++ new_ops).
#                For an if-expression this is the freshly-started join
#                block, whose first op is the merging IRPhi.
#   result-name — the value-name (with '%' prefix) holding the expression's
#                result.  For an if this is the phi's result-name.
#   next-idx    — the updated fresh-name counter.
#
# Invariant: the function-level driver (translate_body) is responsible for
# sealing the final "current" block with IRRet and collecting the produced
# (List IRBlock).  Sub-expressions never emit IRRet.

# field_kinds helpers (ctor_field_kind, ctor_field_kinds_string,
# field_kind_char_to_irtype, fk_at) and their leaf utilities moved to
# stdlib.compiler.field_kinds (/code-review fix #10). Call sites below
# use fk.* prefix.

# ---------------------------------------------------------------------------
# Build the ctor-table by walking program declarations once.  Tag assignment
# mirrors `register_ctors` in codegen.sprout exactly: sequential across all
# TPassThrough (TypeDecl _) declarations in program order, starting at 0.
#
# Returns both the lookup dict (3-tuple, no field_kinds needed for dispatch)
# and the flat CtorReg list (with field_kinds) used by ir_lowering for
# @sprout_register_ctor emission.  Every ctor is registered — both boxed and
# CPR-eligible — so the runtime's find_ctor(tag) never returns NULL.
# class_order / super_map builders. Declaration-order extraction only (no
# ordering heuristic that could diverge); the drift-prone traversal lives once in
# types.witness_slots_for_class. Twins of lowering.collect_class_order /
# collect_super_map — kept local to avoid a cross-pass import; both faithfully
# extract the same (class → names-in-decl-order) content.
fn ai_collect_class_order(decls: List typed_ast.TypedDecl, acc: Dict (List String)) -> Dict (List String) =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | typed_ast.TPassThrough (ast.ClassDecl class_name _ methods _ _) ->
          ai_collect_class_order(rest, dict_set(class_name, ai_method_names(methods, Nil), acc))
      | _ -> ai_collect_class_order(rest, acc)

fn ai_method_names(methods: List ast.ClassMethodSig, acc: List String) -> List String =
  match methods with
  | Nil -> list_reverse(acc)
  | Cons sig rest ->
      match sig with
      | ast.ClassMethodSig name _ _ _ -> ai_method_names(rest, Cons(name, acc))

fn ai_collect_super_map(decls: List typed_ast.TypedDecl, acc: Dict (List String)) -> Dict (List String) =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | typed_ast.TPassThrough (ast.ClassDecl class_name _ _ supers _) ->
          ai_collect_super_map(rest, dict_set(class_name, ai_super_names(supers, Nil), acc))
      | _ -> ai_collect_super_map(rest, acc)

fn ai_super_names(supers: List ast.TypeConstraint, acc: List String) -> List String =
  match supers with
  | Nil -> list_reverse(acc)
  | Cons c rest ->
      match c with
      | ast.TypeConstraint super_name _ -> ai_super_names(rest, Cons(super_name, acc))

# cenv = (class_order, super_map): class→methods and class→direct-supers, in
# declaration order. Threaded so register_ctor_entries can size a constrained
# existential's packed witness fields via types.witness_slots_for_class (the SAME
# transitive-super method expansion the dict-lowering path uses), matching the
# per-method witness args construction packs.
export fn build_ctor_table(decls: List typed_ast.TypedDecl) -> (Dict sprout_ir.CtorInfo, List sprout_ir.CtorReg) =
  build_ctor_table_acc(decls, 0, dict_empty(), Nil,
                       (ai_collect_class_order(decls, dict_empty()), ai_collect_super_map(decls, dict_empty())))

fn build_ctor_table_acc(decls: List typed_ast.TypedDecl, next_tag: Int,
                        acc: Dict sprout_ir.CtorInfo,
                        regs: List sprout_ir.CtorReg,
                        cenv: (Dict (List String), Dict (List String))) -> (Dict sprout_ir.CtorInfo, List sprout_ir.CtorReg) =
  match decls with
  | Nil -> (acc, list_reverse(regs))
  | Cons decl rest ->
      match decl with
      | typed_ast.TPassThrough (ast.TypeDecl _ _ ctors _ _ _) ->
          match register_ctor_entries(ctors, next_tag, max_arity_of(ctors, 0), acc, regs, cenv) with
          | (acc1, new_tag, regs1) -> build_ctor_table_acc(rest, new_tag, acc1, regs1, cenv)
      # Wrap types: synthetic ctor with tag sentinel -1 (mirrors codegen.sprout wrap_tag() = -1).
      # Not added to regs — wrap types have no runtime allocation or tag.
      # next_tag is not incremented: wrap consumes no numeric tag slot.
      | typed_ast.TPassThrough (ast.WrapDecl type_name inner _) ->
          build_ctor_table_acc(rest, next_tag,
            dict_set(type_name, sprout_ir.CtorInfo(-1, 1, 1, fk.ctor_field_kinds_string(Cons(inner, Nil)), ""), acc),
            regs, cenv)
      # Records: a single-constructor product keyed by the type name.  It carries
      # a real tag/arity (it allocates a boxed object via IRMakeCtor, unlike wrap)
      # plus declaration-order field names so codegen can resolve `.field` offsets
      # and reorder literal fields.  Not added to regs — GC tracing is header-driven
      # (arity in the object header), so no runtime ctor registration is needed.
      | typed_ast.TPassThrough (ast.RecordDecl type_name _params fields _ _ _) ->
          build_ctor_table_acc(rest, next_tag + 1,
            dict_set(type_name,
              sprout_ir.CtorInfo(next_tag, record_field_count(fields), record_field_count(fields),
                                 fk.ctor_field_kinds_string(record_field_types(fields)),
                                 record_field_names_csv(fields)),
              acc),
            regs, cenv)
      | _ -> build_ctor_table_acc(rest, next_tag, acc, regs, cenv)

# Declaration-order field TypeExprs of a record, for field-kind computation.
fn record_field_types(fields: List ast.RecordFieldDecl) -> List ast.TypeExpr =
  match fields with
  | Nil -> Nil
  | Cons f rest ->
      match f with
      | ast.RecordFieldDecl _ ty -> Cons(ty, record_field_types(rest))

fn record_field_count(fields: List ast.RecordFieldDecl) -> Int =
  list_length(fields)

# Comma-separated declaration-order field labels; the codegen field-offset key.
fn record_field_names_csv(fields: List ast.RecordFieldDecl) -> String =
  match fields with
  | Nil -> ""
  | Cons f rest ->
      match f with
      | ast.RecordFieldDecl nm _ ->
          match rest with
          | Nil -> nm
          | _ -> nm ++ "," ++ record_field_names_csv(rest)

# Field-count ceiling for a boxed product — an ADT constructor or a record.
# Mirrors SPROUT_MAX_OBJ_ARITY in runtime/sprout_runtime.c: the object header
# packs aux as (tag << 8) | arity, so the arity field holds 0..255 and the GC
# reads it for object size and child count.  Lowering is arity-generic
# (@sprout_alloc_obj + one store per field), so this header field is the only
# remaining limit.  Raising it means widening that field, which narrows the tag.
fn max_boxed_arity() -> Int = 255

# Nothing when `ar` fits the ceiling, Just an error message when it does not.
# Every field-carrying IRMakeCtor site must consult this: a product wider than
# the header's arity field would be allocated with a truncated field count, and
# the GC would then size and scan it short — silent heap corruption rather than
# a loud failure.  `what` names the construct ("constructor", "record").
fn boxed_arity_error(what: String, name: String, ar: Int) -> Maybe String =
  if ar > max_boxed_arity()
  then Just("ast_to_ir: " ++ what ++ " '" ++ name ++ "' has " ++ int_to_string(ar) ++
            " fields, exceeding the limit of " ++ int_to_string(max_boxed_arity()) ++
            "; the runtime object header stores a field count of at most " ++
            int_to_string(max_boxed_arity()))
  else Nothing

# Terminating IRMakeCtor for a boxed product, or Err when the field count
# exceeds max_boxed_arity().  The single choke point the three field-carrying
# paths route through — ADT constructor application, record literal, record
# functional update — so the arity check cannot be forgotten at a new call site.
# translate_zero_arity_ctor builds its 0-field product directly; a nullary ctor
# cannot exceed the ceiling, so it needs no check.
fn finish_make_ctor(what: String, name: String, tag: Int, arg_names: List String,
                    blocks: List sprout_ir.IRBlock, cur_label: String,
                    cur_ops: List sprout_ir.IROp, idx: Int, prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  match boxed_arity_error(what, name, list_length(arg_names)) with
  | Just msg -> Err(msg)
  | Nothing ->
      Ok((blocks, cur_label,
           list_append(cur_ops,
             Cons(sprout_ir.IRMakeCtor(fresh_name(prefix, idx), name, tag, arg_names), Nil)),
           fresh_name(prefix, idx), idx + 1))

fn max_arity_of(ctors: List ast.TypeConstructor, m: Int) -> Int =
  match ctors with
  | Nil -> m
  | Cons tc rest ->
      match tc with
      | ast.TypeConstructor _ args _ _ ->
          match list_length(args) with
          | n -> max_arity_of(rest, if n > m then n else m)

fn register_ctor_entries(ctors: List ast.TypeConstructor, next_tag: Int,
                         max_ar: Int, acc: Dict sprout_ir.CtorInfo,
                         regs: List sprout_ir.CtorReg,
                         cenv: (Dict (List String), Dict (List String))) -> (Dict sprout_ir.CtorInfo, Int, List sprout_ir.CtorReg) =
  match ctors with
  | Nil -> (acc, next_tag, regs)
  | Cons tc rest ->
      match tc with
      | ast.TypeConstructor ctor_name ctor_args _ exist_constraints ->
          # Stage 0b: a constrained existential packs one hidden dictionary field
          # per witness slot — one per method across each constraint's class AND
          # its transitive superclasses (docs/gadts-v0.md §5b). These extra `'p'`
          # (heap) fields are PHYSICAL — invisible to the user-facing ctor and never
          # serialized (CtorInfo is codegen-only, unlike the iface-visible scheme).
          # The count must equal what construction's dict expansion emits; both
          # derive from types.witness_slots_for_class so they cannot drift.
          register_ctor_one(ctor_name, ctor_args, witness_slot_count(exist_constraints, cenv),
                            rest, next_tag, max_ar, acc, regs, cenv)

# /code-review fix #9: helper that computes arity and fks ONCE per ctor.
# Without this, register_ctor_entries called list_length(ctor_args) and
# ctor_field_kinds_string(ctor_args) twice each (one pair for the dict
# tuple, one for CtorReg) — doubled traversal/allocation with no benefit.
# Sprout's `where` clauses don't see names bound by inner match arms, so
# we factor the duplicate computation into this helper where the where
# binding is visible to the call body.
fn register_ctor_one(ctor_name: String, ctor_args: List ast.TypeExpr, witness_slots: Int,
                     rest: List ast.TypeConstructor, next_tag: Int, max_ar: Int,
                     acc: Dict sprout_ir.CtorInfo,
                     regs: List sprout_ir.CtorReg,
                     cenv: (Dict (List String), Dict (List String))) ->
    (Dict sprout_ir.CtorInfo, Int, List sprout_ir.CtorReg) =
  register_ctor_entries(rest, next_tag + 1, max_ar,
                        dict_set(ctor_name, sprout_ir.CtorInfo(next_tag, arity, max_ar, fks, ""), acc),
                        Cons(sprout_ir.CtorReg(ctor_name, next_tag, arity, fks), regs), cenv)
  where arity = list_length(ctor_args) + witness_slots
        fks = fk.ctor_field_kinds_string(ctor_args) ++ witness_field_kinds(witness_slots)

# Stage 0b: physical heap-field slots a constrained existential's packed
# dictionaries occupy = the total number of dictionary methods across each
# constraint's class and its transitive superclasses, via the shared enumerator
# so the count equals construction's per-method dict expansion (cannot drift).
fn witness_slot_count(exist_constraints: List ast.TypeConstraint,
                      cenv: (Dict (List String), Dict (List String))) -> Int =
  match cenv with
  | (class_order, super_map) ->
      match exist_constraints with
      | Nil -> 0
      | Cons c rest ->
          match c with
          | ast.TypeConstraint class_name _ ->
              list_length(types.witness_slots_for_class(class_name, class_order, super_map))
                + witness_slot_count(rest, cenv)

# `'p'` (traced heap pointer) per witness slot — a packed dictionary is a
# function-pointer/closure value, so the GC must trace it.
fn witness_field_kinds(n: Int) -> String =
  if n <= 0 then "" else "p" ++ witness_field_kinds(n - 1)

# Fresh-name counter threaded through the translator.
# ALL synthetic SSA temporaries use the "%t$" prefix → %t$0, %t$1, …
# '$' cannot appear in a Sprout-source identifier (enforced by the lexer; see
# tests/stdlib/test_lexer_dollar_reserved.spr), so synthetic temps are provably
# disjoint from EVERY source-derived name — params, lets, pattern vars, lambda
# params. A source parameter literally named `t0` lowers to `%t0`, which can
# never collide with `%t$0`.
#
# DO NOT reintroduce a caller-supplied prefix into the body. The prefix is
# hardcoded in this single generator on purpose: every synthetic temp name flows
# through here, so hardcoding makes the disjointness invariant hold BY
# CONSTRUCTION — no call site can produce a speakable `%tN` name. The vestigial
# `prefix` argument is ignored (kept only to avoid churning every call site);
# do not wire it back into the body.
# The same counter is reused for block labels via fresh_then/else/join_label
# below — different namespaces, so uniqueness is preserved.
fn fresh_name(prefix: String, idx: Int) -> String =
  "%t$" ++ int_to_string(idx)

fn fresh_then_label(idx: Int) -> String =
  "then_" ++ int_to_string(idx)

fn fresh_else_label(idx: Int) -> String =
  "else_" ++ int_to_string(idx)

fn fresh_join_label(idx: Int) -> String =
  "join_" ++ int_to_string(idx)

# Build a fresh nested-test block label for nested constructor pattern checks.
# "ntest_<idx>" is disjoint from arm_N_M, body_N_M, join_N, then_N, else_N.
fn fresh_nested_test_label(idx: Int) -> String =
  "ntest_" ++ int_to_string(idx)

# Map a TBinary op String to its LLVM icmp predicate, if it is a comparison.
# Returns Nothing for non-comparison ops (the caller handles those separately).
fn cmp_predicate(op: String) -> Maybe String =
  if op == "==" then Just("eq")
  else if op == "!=" then Just("ne")
  else if op == "<" then Just("slt")
  else if op == "<=" then Just("sle")
  else if op == ">" then Just("sgt")
  else if op == ">=" then Just("sge")
  else Nothing

# True iff t is the monomorphic Int type.
fn is_int_type(t: types.Type) -> Bool =
  match t with
  | types.TConst name -> types.type_id_name(name) == "Int"
  | _ -> false

# True iff t is the monomorphic Double type.
fn is_double_type(t: types.Type) -> Bool =
  match t with
  | types.TConst name -> types.type_id_name(name) == "Double"
  | _ -> false

# True iff t is the monomorphic Bool type.
fn is_bool_type(t: types.Type) -> Bool =
  match t with
  | types.TConst name -> types.type_id_name(name) == "Bool"
  | _ -> false

fn is_string_type(t: types.Type) -> Bool =
  match t with
  | types.TConst name -> types.type_id_name(name) == "String"
  | _ -> false

# True iff t is the monomorphic Char type.
fn is_char_type(t: types.Type) -> Bool =
  match t with
  | types.TConst name -> types.type_id_name(name) == "Char"
  | _ -> false

# True iff t is Int or Char — both are immediate i64 values that compare and
# arithmetically lower through the same integer IR path.
fn is_int_or_char_type(t: types.Type) -> Bool =
  is_int_type(t) || is_char_type(t)

# True iff t is the monomorphic Unit type.
fn is_unit_type(t: types.Type) -> Bool =
  match t with
  | types.TConst name -> types.type_id_name(name) == "Unit"
  | _ -> false

# True iff t is a Maybe type (TApp (TConst "Maybe") _).
# Mirrors codegen.sprout:is_maybe_type; duplicated here because codegen
# does not export it.
fn is_maybe_type(t: types.Type) -> Bool =
  match t with
  | types.TApp (types.TConst name) _ -> types.type_id_name(name) == "Maybe"
  | _ -> false

# True iff t is a Result type (TApp (TApp (TConst "Result") err) ok).
# Result is binary, so it appears as a nested TApp.  Used to route do-binds
# through the Result wrapper-strip path (Err short-circuit, Ok unwrap).
fn is_result_type(t: types.Type) -> Bool =
  match t with
  | types.TApp (types.TApp(types.TConst name) _) _ -> types.type_id_name(name) == "Result"
  | _ -> false

# True iff t is a List type (TApp (TConst "List") _).
# Mirrors codegen.sprout:is_list_type; duplicated here because codegen
# does not export it.
fn is_list_type(t: types.Type) -> Bool =
  match t with
  | types.TApp (types.TConst name) _ -> types.type_id_name(name) == "List"
  | _ -> false


# Scalar argument types accepted by IRCall / IRApplyClosure (direct and
# closure call sites).  All IR values are i64; the typechecker is the source
# of truth for type compatibility.
#
# Bool: accepted.  TBool emits IRConst (i64 0/1) — the i64-uniform encoding
# validated by /code-review fix #2.  Comparison results are widened to i64
# by IRZextI1ToI64 before reaching a call site, so all Bool-valued args
# arrive as i64.  (M3 PR 10)
#
# Unit: accepted.  TUnit emits IRConst(name, 0) — the i64 0 sentinel used by
# direct codegen (codegen.sprout val_make(ll_i64(), "0")).  Every parameter
# slot is filled; the callee convention is unchanged.  (M3 PR 10)
#
# Ctor field args use the separate is_supported_ctor_arg_type guard below,
# which keeps its own deferred restrictions on Bool and Unit.
fn is_supported_arg_type(_t: types.Type) -> Bool = true

# Ctor field argument types accepted by translate_args_ctor.
#
# IRMakeCtor lowering (ir_lowering.sprout `lower_op` / `lower_call_args`)
# hardcodes `i64 %argN` for every argument slot.  Int, String, Bool, Unit,
# and heap-typed ADT values all produce i64 in LLVM IR.
#
# Bool is ACCEPTED: all Bool-valued translate_expr results are i64-uniform.
# TBool literals emit IRConst (i64 0/1); comparison results go through
# IRICmp (i1) + IRZextI1ToI64 (i64) in finish_binary, so the value
# reaching the ctor field slot is always i64.  (M3 PR 15a)
#
# Unit is ACCEPTED: translate_expr's TUnit arm emits IRConst(name, 0) —
# the i64 0 sentinel (mirrors codegen.sprout val_make(ll_i64(), "0")).
# The field slot is filled with i64 0; the callee convention is unchanged.
# (M3 PR 15e)
#
# All other types (including TVar, TApp, TypeArrow, ADT names) are accepted;
# they all produce i64 in the IR path.
fn is_supported_ctor_arg_type(_t: types.Type) -> Bool = true

# Map an inferred return type to the LLVM type used for `define`/`ret`.
# PR 1.3 only emits i64 (Int) and i1 (Bool); anything else falls back to i64
# but the translator will already have rejected unsupported bodies before
# we get here.
# /code-review fix #2: all SSA values flow as i64 at function boundaries.
# Bool values use i64 encoding (0 or 1), not i1. Reasons:
#   - lower_params unconditionally emits 'i64 %p' for every parameter,
#     so any function with a Bool parameter would otherwise have a
#     parameter SSA name typed i64 in the signature but used as i1 in
#     the body (e.g. in match arm tests) — invalid LLVM IR.
#   - lower_call_args unconditionally emits 'i64 <arg>' for every call
#     argument, so Bool return values must also be i64 to round-trip.
# The i1 representation only appears as the implicit result of icmp /
# the cond operand of br i1, both of which are local to a block.
# LLVM return-type string for IRPhi / IRFunction fields — always i64 under the
# uniform-value ABI.
fn llvm_ret_type(t: types.Type) -> String =
  "i64"

# Map a call's Sprout return type to the IRType kind carried by IRCall, so
# ir_rooting roots only heap-returning call results.  Scalars (Int/Bool/Char)
# are IRTScalar (never rooted); everything else is conservatively heap.
fn ret_irtype(t: types.Type) -> sprout_ir.IRType =
  if type_kind.type_is_non_heap_scalar(t)
  then sprout_ir.IRTScalar
  else sprout_ir.IRTUnknown

# Translate a TypedExpr in a multi-block-aware fashion.  See the contract
# block at the top of this file for the full signature description.
#
# Returns: (completed-blocks, new-cur-label, new-cur-ops, result-name, next-idx)
#
# PR 2.4 threading additions (all read-only or write-only side-channels):
#   captures   — Dict String — maps a free var's source name to the SSA name
#                produced by IRLoadEnvSlot in the enclosing lifted body.
#                Empty dict_empty() for top-level user fns.
#   lifted_ref — Ref (List IRFunction) — accumulator; each TLambda translation
#                prepends its lifted IRFunction here (shared across the whole
#                user fn; nested lambdas thus stay flat).
#   top_level  — Set String — top-level fn names + ctor names; used by
#                compute_free_vars to exclude globally addressable names.
fn translate_expr(expr: typed_ast.TypedExpr, params: List String,
                  ctors: Dict sprout_ir.CtorInfo, idx: Int,
                  cur_label: String, cur_ops: List sprout_ir.IROp,
                  captures: Dict String,
                  lifted_ref: Ref (List sprout_ir.IRFunction),
                  top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                  lambda_ctr_ref: Ref Int,
                  lifted_idx_ref: Ref (Dict Int),
                  name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match expr with
  | typed_ast.TInt n _ _ ->
      Ok((Nil, cur_label,
           list_append(cur_ops, Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx), n), Nil)),
           fresh_name(name_prefix, idx), idx + 1))
  | typed_ast.TFloat text _ _ ->
      Ok((Nil, cur_label,
           list_append(cur_ops, Cons(sprout_ir.IRFloatConst(fresh_name(name_prefix, idx), text), Nil)),
           fresh_name(name_prefix, idx), idx + 1))
  | typed_ast.TVar name _ _ ->
      # A TVar may reference: (a) a function parameter, (b) a 0-arity
      # constructor (e.g. Nil, Nothing) used without parens, (c) a captured
      # free variable in a lifted lambda body (present in `captures`).
      # Check captures FIRST so that a captured free var does not accidentally
      # resolve as a param that shadows it.
      match dict_get(name, captures) with
      | Just ssa -> Ok((Nil, cur_label, cur_ops, ssa, idx))
      | Nothing ->
          if param_known(name, params)
          then Ok((Nil, cur_label, cur_ops, "%" ++ name, idx))
          else
            match dict_get(name, ctors) with
            | Just entry ->
                match entry with
                | sprout_ir.CtorInfo tag actual_ar _max_ar _fks _ ->
                    # M3 PR 2: CPR-eligible ctors route through the same boxed
                    # allocation path as non-CPR ctors (@sprout_alloc_obj).
                    # The unboxing sret optimization lands in PR 2b.
                    if actual_ar == 0
                    then translate_zero_arity_ctor(name, tag, idx, cur_label, cur_ops, name_prefix)
                    else Err("ast_to_ir: bare reference to non-zero-arity ctor '" ++ name ++ "' (eta/partial application) deferred to follow-up PR")
            | Nothing ->
                # M3 PR 5: top-level `let x = expr` declarations are stored in
                # LLVM globals; TVar references load from the global slot.
                # Mirrors codegen.sprout's `load i64, ptr @<name>` emission.
                if set_member(name, let_names)
                then Ok((Nil, cur_label,
                          list_append(cur_ops,
                            Cons(sprout_ir.IRLoadGlobal(fresh_name(name_prefix, idx), name), Nil)),
                          fresh_name(name_prefix, idx), idx + 1))
                else
                  # M3 PR 6: top-level fn reference (eta-expansion).
                  # Mirrors codegen.sprout:1894-1903 — synthesize a wrapper
                  # IRFunction that takes Sprout's closure ABI signature
                  # (i64 env + N user args) and forwards to the original fn,
                  # then emit IRMkClosure to package the wrapper as a value.
                  match dict_get(name, fn_arities) with
                  | Just info ->
                      do
                        let arity = info.arity
                        ctr <- ref_read(lambda_ctr_ref)
                        ref_write(lambda_ctr_ref, ctr + 1)
                        let wrapper_name = "__sprout_ir_eta_" ++ name ++ "_" ++ int_to_string(ctr)
                        let wrapper_fn = synthesize_eta_wrapper(name, arity, wrapper_name)
                        existing_lifted <- ref_read(lifted_ref)
                        ref_write(lifted_ref, Cons(wrapper_fn, existing_lifted))
                        Ok((Nil, cur_label,
                             list_append(cur_ops,
                               Cons(sprout_ir.IRMkClosure(fresh_name(name_prefix, idx), wrapper_name, arity, Nil), Nil)),
                             fresh_name(name_prefix, idx), idx + 1))
                  | Nothing ->
                      # An unbound name at codegen is always a compiler-internal
                      # sentinel — genuine unbound vars are rejected at typecheck,
                      # before lowering. `lowering` mints `__unresolved_<Class>...`
                      # TVars for inner typeclass dicts whose type var is free
                      # (e.g. `ToString a` for `to_string(Empty)`, `Empty : Box a`).
                      # Such a dict is provably never invoked: it goes unresolved
                      # iff its type var is free iff no value of that type is present
                      # iff the method body never reaches the dict. Null-fill with
                      # `i64 0`, matching the unresolved-dict slot direct codegen emits.
                      # Every OTHER unknown name stays a hard error — keeping this
                      # path stricter than direct codegen, a backstop for future
                      # compiler regressions.
                      if str_starts_with(name, "__unresolved_")
                      then
                        # Poison the unresolved dict instead of null-filling it.
                        # The slot is provably dead for the legitimate free-tyvar
                        # case (the method body never reaches it), so the poison
                        # is inert there.  But the "never invoked" invariant has
                        # been violated before (the missing-superclass SIGSEGV,
                        # PR #268); a bare `i64 0` turns any future violation into
                        # a SILENT crash when the null dict is applied.  Emit a
                        # closure whose code pointer PANICS on apply — loud and
                        # located — mirroring the eta-wrapper synthesis above.
                        # Reuses @panic (IRPanic); no runtime change, no builtin.
                        do
                          ctr <- ref_read(lambda_ctr_ref)
                          ref_write(lambda_ctr_ref, ctr + 1)
                          let thunk_name = "__sprout_ir_unresolved_thunk_" ++ int_to_string(ctr)
                          existing_lifted <- ref_read(lifted_ref)
                          ref_write(lifted_ref, Cons(synthesize_unresolved_poison_thunk(thunk_name), existing_lifted))
                          Ok((Nil, cur_label,
                               list_append(cur_ops,
                                 Cons(sprout_ir.IRMkClosure(fresh_name(name_prefix, idx), thunk_name,
                                        closure_arity_any(), Nil), Nil)),
                               fresh_name(name_prefix, idx), idx + 1))
                      else Err("ast_to_ir: unbound variable '" ++ name ++ "'")
  | typed_ast.TBinary op left right _ _ ->
      translate_binary(op, left, right, params, ctors, idx, cur_label, cur_ops,
                       captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                       name_prefix)
  | typed_ast.TIf cond t e ty _ ->
      translate_if(cond, t, e, ty, params, ctors, idx, cur_label, cur_ops,
                   captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                   name_prefix)
  | typed_ast.TCall callee args ty _ ->
      translate_call(callee, args, ty, params, ctors, idx, cur_label, cur_ops,
                     captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                     name_prefix)
  | typed_ast.TBool b _ _ ->
      # /code-review fix #2: Bool uses i64 encoding uniformly through the
      # IR (0 or 1). The earlier IRConstBool emitted 'add i1 0, N' which
      # mismatched the i64-typed function parameter SSA produced by
      # lower_params when a Bool param was matched on.
      Ok((Nil, cur_label,
           list_append(cur_ops, Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx),
                                                       if b then 1 else 0), Nil)),
           fresh_name(name_prefix, idx), idx + 1))
  | typed_ast.TString s _ _ ->
      # Two fresh names: the raw ptr from the GEP, and the i64 result.
      Ok((Nil, cur_label,
           list_append(cur_ops, Cons(sprout_ir.IRStrConst(fresh_name(name_prefix, idx + 1), fresh_name(name_prefix, idx), s), Nil)),
           fresh_name(name_prefix, idx + 1), idx + 2))
  | typed_ast.TChar ch _ _ ->
      # A Char is an immediate i64 Unicode codepoint; ch is that codepoint.
      # Lower to an IRConst, exactly like TInt.
      Ok((Nil, cur_label,
           list_append(cur_ops, Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx), ch), Nil)),
           fresh_name(name_prefix, idx), idx + 1))
  | typed_ast.TUnit _ _ ->
      # Direct codegen convention: Unit has no meaningful value; emit i64 0
      # sentinel (mirrors codegen.sprout val_make(ll_i64(), "0")).  The
      # callee's parameter slot is filled; the value is never observed.
      Ok((Nil, cur_label,
           list_append(cur_ops, Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx), 0), Nil)),
           fresh_name(name_prefix, idx), idx + 1))
  | typed_ast.TTuple items _ _ ->
      # M3 PR 7: tuple construction.  Translate each element in left-to-right
      # order, then emit IRMakeTuple which lowers to sprout_alloc_tuple_blob
      # + N per-element GEP+store.  Result is the heap-allocated blob's i64
      # pointer.  Mirrors codegen.sprout:940-968.
      translate_tuple_items(items, params, ctors, idx, cur_label, cur_ops, Nil, Nil,
                            captures, lifted_ref, top_level, let_names, fn_arities,
                            lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | typed_ast.TMatch scrut arms match_ty _ ->
      translate_match(scrut, arms, match_ty, params, ctors, idx, cur_label, cur_ops,
                      captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                      name_prefix)
  | typed_ast.TDict _ _ _ _ -> Err("ast_to_ir: TDict not yet supported")
  | typed_ast.TMethodRef _ _ _ _ _ -> panic("ast_to_ir.translate_expr: TMethodRef survived lowering (internal error)")
  | typed_ast.TLambda lparams body lam_ty _ ->
      translate_lambda(lparams, body, lam_ty, params, ctors, idx, cur_label, cur_ops,
                       captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                       name_prefix)
  | typed_ast.TUnary op operand _ _ ->
      # Parser produces TUnary "!" (boolean negation, parser.sprout:665) and
      # TUnary "-" (arithmetic negation, parser.sprout:661).  No other unary ops.
      # !x lowers to IRBoolNot (`xor i64 %x, 1`).  -x lowers to IRINeg
      # (`sub i64 0, %x`) for Int, or IRFNeg (`fneg double`) for Double: negating
      # a double's i64 bit-pattern with `sub` corrupts it, so dispatch on type.
      match translate_expr(operand, params, ctors, idx, cur_label, cur_ops,
                           captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                           name_prefix) with
      | Err msg -> Err(msg)
      | Ok or_ ->
          match or_ with
          | (oblocks, ocur_lbl, ocur_ops, o_name, idx1) ->
              if op == "!"
              then Ok((oblocks, ocur_lbl,
                        list_append(ocur_ops,
                          Cons(sprout_ir.IRBoolNot(fresh_name(name_prefix, idx1), o_name), Nil)),
                        fresh_name(name_prefix, idx1), idx1 + 1))
              else if op == "-"
              then Ok((oblocks, ocur_lbl,
                        list_append(ocur_ops,
                          Cons(if is_double_type(typed_ast.typed_expr_type(operand))
                               then sprout_ir.IRFNeg(fresh_name(name_prefix, idx1), o_name)
                               else sprout_ir.IRINeg(fresh_name(name_prefix, idx1), o_name), Nil)),
                        fresh_name(name_prefix, idx1), idx1 + 1))
              else Err("ast_to_ir: unary op '" ++ op ++ "' not yet supported")
  | typed_ast.TRange start end_ _ _ ->
      # call @int_range(start, end_) returning the IntRange handle.  int_range is
      # declared as extern fn in prelude.sprout so it flows through
      # collect_extern_decls automatically.
      #
      # No step argument, because `a..b` is ALWAYS ascending: the syntax has no
      # descending form, so a reversed literal like `5..1` is an EMPTY ascending
      # range rather than a descending one (docs/ranges-v0.md §5).  @int_range
      # sets step = +1 itself; range_down goes through @int_range_by instead.
      match translate_expr(start, params, ctors, idx, cur_label, cur_ops,
                           captures, lifted_ref, top_level, let_names, fn_arities,
                           lambda_ctr_ref, lifted_idx_ref, name_prefix) with
      | Err msg -> Err(msg)
      | Ok sr ->
          match sr with
          | (sblocks, scur_lbl, scur_ops, s_name, idx1) ->
              match translate_expr(end_, params, ctors, idx1, scur_lbl, scur_ops,
                                   captures, lifted_ref, top_level, let_names, fn_arities,
                                   lambda_ctr_ref, lifted_idx_ref, name_prefix) with
              | Err msg -> Err(msg)
              | Ok er ->
                  match er with
                  | (eblocks, ecur_lbl, ecur_ops, e_name, idx2) ->
                      Ok((list_append(sblocks, eblocks), ecur_lbl,
                           list_append(ecur_ops,
                             Cons(sprout_ir.IRCall(fresh_name(name_prefix, idx2), sprout_ir.IRTHeap,
                                                   "int_range", [s_name, e_name]), Nil)),
                           fresh_name(name_prefix, idx2), idx2 + 1))
  | typed_ast.TDo steps _ _ ->
      translate_do(steps, params, ctors, idx, cur_label, cur_ops,
                   captures, lifted_ref, top_level, let_names, fn_arities,
                   lambda_ctr_ref, lifted_idx_ref, name_prefix, dict_empty())
  # Record construction: a record is a single-constructor product.  Reorder the
  # literal's source-order fields into declaration order (the fixed offset layout
  # in the ctor table), then emit one IRMakeCtor exactly like an ADT constructor.
  | typed_ast.TRecord type_name fields _ _ ->
      match dict_get(type_name, ctors) with
      | Nothing -> Err("ast_to_ir: unknown record type '" ++ type_name ++ "'")
      | Just entry ->
          match entry with
          | sprout_ir.CtorInfo tag _arity _max_ar _fks names_csv ->
              match record_exprs_in_decl_order(split_on_comma(names_csv), fields) with
              | Nothing -> Err("ast_to_ir: record '" ++ type_name ++ "' literal is missing a declared field")
              | Just ordered_exprs ->
                  match translate_args_ctor(ordered_exprs, params, ctors, idx, cur_label, cur_ops, Nil, Nil,
                                            captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                                            name_prefix) with
                  | Err msg -> Err(msg)
                  | Ok r ->
                      match r with
                      | (arg_blocks, arg_cur_lbl, arg_cur_ops, arg_names, idx1) ->
                          finish_make_ctor("record", type_name, tag, arg_names,
                                           arg_blocks, arg_cur_lbl, arg_cur_ops, idx1, name_prefix)
  # Field access: resolve the field name to its declaration offset and emit a
  # single IRGetField (an offset load), reusing the ADT field-projection op.
  | typed_ast.TGetField rec_expr field_name _ _ ->
      match translate_expr(rec_expr, params, ctors, idx, cur_label, cur_ops,
                           captures, lifted_ref, top_level, let_names, fn_arities,
                           lambda_ctr_ref, lifted_idx_ref, name_prefix) with
      | Err msg -> Err(msg)
      | Ok r ->
          match r with
          | (rec_blocks, rec_lbl, rec_ops, rec_ssa, idx1) ->
              match type_head_name(typed_ast.typed_expr_type(rec_expr)) with
              | Nothing -> Err("ast_to_ir: field access '." ++ field_name ++ "' on a non-record value")
              | Just rname ->
                  match dict_get(rname, ctors) with
                  | Nothing -> Err("ast_to_ir: unknown record type '" ++ rname ++ "'")
                  | Just entry ->
                      match entry with
                      | sprout_ir.CtorInfo _tag _arity _max_ar fks names_csv ->
                          match field_index(split_on_comma(names_csv), field_name, 0) with
                          | Nothing -> Err("ast_to_ir: record '" ++ rname ++ "' has no field '" ++ field_name ++ "'")
                          | Just fi ->
                              Ok((rec_blocks, rec_lbl,
                                   list_append(rec_ops,
                                     Cons(sprout_ir.IRGetField(fresh_name(name_prefix, idx1), rec_ssa, fi, fk.fk_at(fks, fi)), Nil)),
                                   fresh_name(name_prefix, idx1), idx1 + 1))
  # Functional update: evaluate the base ONCE, then build a fresh record whose
  # named fields take the updated values and whose other fields are copied from
  # the base by offset (IRGetField), and emit one IRMakeCtor.
  | typed_ast.TRecordUpdate base fields _ _ ->
      match translate_expr(base, params, ctors, idx, cur_label, cur_ops,
                           captures, lifted_ref, top_level, let_names, fn_arities,
                           lambda_ctr_ref, lifted_idx_ref, name_prefix) with
      | Err msg -> Err(msg)
      | Ok r ->
          match r with
          | (base_blocks, base_lbl, base_ops, base_ssa, idx1) ->
              match type_head_name(typed_ast.typed_expr_type(base)) with
              | Nothing -> Err("ast_to_ir: record update `with` on a non-record value")
              | Just rname ->
                  match dict_get(rname, ctors) with
                  | Nothing -> Err("ast_to_ir: unknown record type '" ++ rname ++ "'")
                  | Just entry ->
                      match entry with
                      | sprout_ir.CtorInfo tag _arity _max_ar fks names_csv ->
                          build_update_args(split_on_comma(names_csv), 0, fields, base_ssa, tag, rname, fks,
                                            params, ctors, idx1, base_lbl, base_ops, base_blocks, Nil,
                                            captures, lifted_ref, top_level, let_names, fn_arities,
                                            lambda_ctr_ref, lifted_idx_ref, name_prefix)

# Emit a single IRMakeCtor op for a 0-arity boxed constructor reference (Nil,
# custom enum constants, etc.).  Used by translate_expr's TVar case when the
# variable name resolves in the ctor-table.
# Pure leaf — no IO needed.
fn translate_zero_arity_ctor(name: String, tag: Int, idx: Int,
                             cur_label: String, cur_ops: List sprout_ir.IROp,
                             prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  Ok((Nil, cur_label,
       list_append(cur_ops, Cons(sprout_ir.IRMakeCtor(fresh_name(prefix, idx), name, tag, Nil), Nil)),
       fresh_name(prefix, idx), idx + 1))

# ---------------------------------------------------------------------------
# Record codegen helpers (docs/records-v0.md §10.6)
# ---------------------------------------------------------------------------

# Split a comma-separated field-name list (CtorInfo.field_names) into segments.
# Record field names never contain commas, so first-comma splitting is exact.
fn split_on_comma(s: String) -> List String =
  match string.split_once(s, ",") with
  | Nothing -> Cons(s, Nil)
  | Just (head, rest) -> Cons(head, split_on_comma(rest))

# 0-based position of `field` in a declaration-order name list, or Nothing.
fn field_index(names: List String, field: String, i: Int) -> Maybe Int =
  match names with
  | Nil -> Nothing
  | Cons nm rest -> if nm == field then Just(i) else field_index(rest, field, i + 1)

# The value expression bound to `name` in a source-order record literal.
fn typed_field_expr_for(name: String, fields: List typed_ast.TypedRecordField) -> Maybe typed_ast.TypedExpr =
  match fields with
  | Nil -> Nothing
  | Cons f rest ->
      match f with
      | typed_ast.TypedRecordField fname fexpr ->
          if fname == name then Just(fexpr) else typed_field_expr_for(name, rest)

# Reorder a record literal's fields (source order) into declaration order so the
# positional IRMakeCtor lays each value at its fixed offset.  Nothing if a
# declared field is absent (a missing-field literal — rejected upstream by
# inference, but guarded here too).
fn record_exprs_in_decl_order(decl_names: List String, fields: List typed_ast.TypedRecordField) -> Maybe (List typed_ast.TypedExpr) =
  match decl_names with
  | Nil -> Just(Nil)
  | Cons nm rest ->
      match typed_field_expr_for(nm, fields) with
      | Nothing -> Nothing
      | Just e ->
          match record_exprs_in_decl_order(rest, fields) with
          | Nothing -> Nothing
          | Just es -> Just(Cons(e, es))

# ---------------------------------------------------------------------------
# translate_do — M3 PR 11
# ---------------------------------------------------------------------------
#
# Lower a TDo step list into the flat SSA / block stream used throughout
# this translator.  Mirrors codegen.sprout's emit_do for the three pure-IO
# step kinds.  Maybe/Result bind is deferred (it requires multi-block phi
# merge; those arms are guarded by a clear Err for now).
#
# Signature matches translate_expr: returns
#   (completed_blocks, cur_label, cur_ops, result_ssa, next_idx)
#
# Step semantics (mirrors codegen.sprout:emit_do):
#   TDoExprStep e      — emit e for side-effects; if last step the result IS
#                        the do-block value; otherwise discard result.
#   TDoLetStep name e  — emit e, bind name → SSA in captures; recurse; rest
#                        provides the do-block value.
#   TDoBindStep pat e  — emit e (plain IO: T !{IO}); bind VarPattern/Wildcard
#                        directly to the i64 SSA result; recurse.  Maybe/Result
#                        wrapping is detected and returns Err to keep parity
#                        visible in the xfail list.
#   Nil                — emit IRConst 0 (unit sentinel; mirrors codegen
#                        zero_val / val_make(ll_i64(), "0")).
#
# The ordinary (boxed) do-expr-step: last step → its value is the do value; non-last → emit for
# side-effects then continue. Factored so the SRA-consumer path reuses it with a substituted
# expression + captures (the arm body + tuple binders bound to the field scalars).
fn translate_do_expr_step(step_expr: typed_ast.TypedExpr, step_caps: Dict String,
                          rest: List typed_ast.TypedDoStep, params: List String,
                          ctors: Dict sprout_ir.CtorInfo, idx: Int, cur_label: String,
                          cur_ops: List sprout_ir.IROp, lifted_ref: Ref (List sprout_ir.IRFunction),
                          top_level: Set, let_names: Set, fn_arities: Dict FnInfo, lambda_ctr_ref: Ref Int,
                          lifted_idx_ref: Ref (Dict Int), name_prefix: String, sra: Dict (List String)) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match rest with
  | Nil ->
      translate_expr(step_expr, params, ctors, idx, cur_label, cur_ops, step_caps, lifted_ref,
                     top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | _ ->
      match translate_expr(step_expr, params, ctors, idx, cur_label, cur_ops, step_caps, lifted_ref,
                           top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix) with
      | Err msg -> Err(msg)
      | Ok r ->
          match r with
          | (eblocks, elabel, eops, _discard, eidx) ->
              match translate_do(rest, params, ctors, eidx, elabel, eops, step_caps, lifted_ref,
                                 top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix, sra) with
              | Err msg -> Err(msg)
              | Ok rr ->
                  match rr with
                  | (rblocks, rlabel, rops, rname, ridx) ->
                      Ok((list_append(eblocks, rblocks), rlabel, rops, rname, ridx))

# The ordinary (boxed) do-let-step: evaluate e, bind name→SSA in captures, continue. Used when a let
# is not SRA-eligible (or its producers are shadowed).
fn translate_do_let_boxed(name: String, e: typed_ast.TypedExpr, rest: List typed_ast.TypedDoStep,
                          params: List String, ctors: Dict sprout_ir.CtorInfo, idx: Int,
                          cur_label: String, cur_ops: List sprout_ir.IROp, captures: Dict String,
                          lifted_ref: Ref (List sprout_ir.IRFunction), top_level: Set, let_names: Set,
                          fn_arities: Dict FnInfo, lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                          name_prefix: String, sra: Dict (List String)) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match translate_expr(e, params, ctors, idx, cur_label, cur_ops, captures, lifted_ref, top_level,
                       let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix) with
  | Err msg -> Err(msg)
  | Ok r ->
      match r with
      | (eblocks, elabel, eops, ename, eidx) ->
          match translate_do(rest, params, ctors, eidx, elabel, eops, dict_set(name, ename, captures),
                             lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                             name_prefix, sra) with
          | Err msg -> Err(msg)
          | Ok rr ->
              match rr with
              | (rblocks, rlabel, rops, rname, ridx) ->
                  Ok((list_append(eblocks, rblocks), rlabel, rops, rname, ridx))

# O(n * k) where n = step count, k = per-step translate_expr cost.
fn translate_do(steps: List typed_ast.TypedDoStep,
                params: List String, ctors: Dict sprout_ir.CtorInfo,
                idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                captures: Dict String,
                lifted_ref: Ref (List sprout_ir.IRFunction),
                top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                name_prefix: String, sra: Dict (List String)) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match steps with
  | Nil ->
      # Empty do-block: return unit sentinel (i64 0).
      Ok((Nil, cur_label,
           list_append(cur_ops, Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx), 0), Nil)),
           fresh_name(name_prefix, idx), idx + 1))
  | Cons step rest ->
      match step with
      | typed_ast.TDoExprStep e ->
          # SRA consumer: if `e` is the `match name with (pats) -> body` for an SRA-bound name, bind
          # the tuple binders to the field scalars and translate the arm body — no boxed scrutinee.
          (match sra_consume_here(e, sra) with
           | Just cm ->
               (match cm with
                | (binders, body, scalars) ->
                    translate_do_expr_step(body, bind_tuple_slots(binders, scalars, captures), rest,
                                           params, ctors, idx, cur_label, cur_ops, lifted_ref, top_level,
                                           let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix, sra))
           | Nothing ->
               translate_do_expr_step(e, captures, rest, params, ctors, idx, cur_label, cur_ops, lifted_ref,
                                      top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix, sra))
      | typed_ast.TDoLetStep name e ->
          # SRA producer: if `let name = e` is scalar-replaceable (shared oracle) and its producers are
          # unshadowed, lower `e` to its field scalars, record name→scalars in the SRA map, and DO NOT
          # bind name as a boxed value. Otherwise fall back to the ordinary boxed let.
          (match sra_core_eligible(name, e, rest, top_level) with
           | Just info ->
               (match info with
                | (width, _producers, _binders, _body) ->
                    if sra_producers_unshadowed(e, params, captures, let_names, ctors)
                    then (match translate_tuple_scalars(e, width, params, ctors, idx, cur_label, cur_ops,
                                                        captures, lifted_ref, top_level, let_names, fn_arities,
                                                        lambda_ctr_ref, lifted_idx_ref, name_prefix) with
                          | Err msg -> Err(msg)
                          | Ok r ->
                              (match r with
                               | (eblocks, elabel, eops, scalars, eidx) ->
                                   (match translate_do(rest, params, ctors, eidx, elabel, eops, captures,
                                                       lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                                                       lifted_idx_ref, name_prefix, dict_set(name, scalars, sra)) with
                                    | Err msg -> Err(msg)
                                    | Ok rr ->
                                        (match rr with
                                         | (rblocks, rlabel, rops, rname, ridx) ->
                                             Ok((list_append(eblocks, rblocks), rlabel, rops, rname, ridx))))))
                    else translate_do_let_boxed(name, e, rest, params, ctors, idx, cur_label, cur_ops, captures,
                                                lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                                                lifted_idx_ref, name_prefix, sra))
           | Nothing ->
               translate_do_let_boxed(name, e, rest, params, ctors, idx, cur_label, cur_ops, captures,
                                      lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                                      lifted_idx_ref, name_prefix, sra))
      | typed_ast.TDoBindStep pat e ->
          # Maybe and Result wrapper-strip binds short-circuit (on Nothing / on
          # Err) using a CFG-branching + phi pattern, mirroring codegen.sprout's
          # emit_do_maybe_bind.  Maybe rebuilds Nothing on the short branch;
          # Result propagates the original Err box unchanged.  Plain IO bind (no
          # wrapper) falls through to the simple path.
          if is_maybe_type(typed_ast.typed_expr_type(e))
          then translate_do_bind_maybe(pat, e, rest, params, ctors, idx,
                                       cur_label, cur_ops, captures,
                                       lifted_ref, top_level, let_names, fn_arities,
                                       lambda_ctr_ref, lifted_idx_ref, name_prefix)
          else if is_result_type(typed_ast.typed_expr_type(e))
          then translate_do_bind_result(pat, e, rest, params, ctors, idx,
                                        cur_label, cur_ops, captures,
                                        lifted_ref, top_level, let_names, fn_arities,
                                        lambda_ctr_ref, lifted_idx_ref, name_prefix)
          else
            match translate_expr(e, params, ctors, idx, cur_label, cur_ops,
                                 captures, lifted_ref, top_level, let_names, fn_arities,
                                 lambda_ctr_ref, lifted_idx_ref, name_prefix) with
            | Err msg -> Err(msg)
            | Ok r ->
                match r with
                | (eblocks, elabel, eops, ename, eidx) ->
                    match do_bind_captures(pat, ename, captures, eidx, name_prefix) with
                    | Err msg -> Err(msg)
                    | Ok bind_result ->
                        match bind_result with
                        | (bind_ops, new_captures, bind_idx) ->
                            match translate_do(rest, params, ctors, bind_idx, elabel,
                                               list_append(eops, bind_ops),
                                               new_captures, lifted_ref, top_level, let_names, fn_arities,
                                               lambda_ctr_ref, lifted_idx_ref, name_prefix, sra) with
                            | Err msg -> Err(msg)
                            | Ok rr ->
                                match rr with
                                | (rblocks, rlabel, rops, rname, ridx) ->
                                    Ok((list_append(eblocks, rblocks), rlabel, rops, rname, ridx))

# Extend the captures dict (and emit field-extraction ops) for a TDoBindStep pattern.
# VarPattern binds the SSA name directly; WildcardPattern/UnitPattern discard it.
# TuplePattern emits IRGetTupleField ops and recurses into nested TuplePatterns.
# Constructor and literal patterns are not yet supported.
# Returns (emitted_ops, new_captures, new_idx).
# O(n) where n = total pattern nodes in pat (recursively).
fn do_bind_captures(pat: ast.Pattern, ssa: String,
                    captures: Dict String,
                    idx: Int, name_prefix: String) -> Result String (List sprout_ir.IROp, Dict String, Int) =
  match pat with
  | ast.VarPattern name _ -> Ok((Nil, dict_set(name, ssa, captures), idx))
  | ast.WildcardPattern _ -> Ok((Nil, captures, idx))
  | ast.UnitPattern _ -> Ok((Nil, captures, idx))
  | ast.TuplePattern items _ ->
      do_bind_tuple_items(items, ssa, idx, 0, name_prefix, Nil, captures)
  | ast.ConstructorPattern _ _ _ -> Err("ast_to_ir: do-block bind to constructor pattern not yet supported")
  | ast.IntPattern _ _ -> Err("ast_to_ir: do-block bind to int pattern not yet supported")
  | ast.BoolPattern _ _ -> Err("ast_to_ir: do-block bind to bool pattern not yet supported")
  | ast.StringPattern _ _ -> Err("ast_to_ir: do-block bind to string pattern not yet supported")
  | ast.CharPattern _ _ -> Err("ast_to_ir: do-block bind to char pattern not yet supported")

# Emit IRGetTupleField binds for each item in a do-bind TuplePattern.
# Handles VarPattern (bind), WildcardPattern/UnitPattern (skip), and nested
# TuplePattern (fetch element + recurse).  No tag tests; tuples always match.
# acc_ops accumulates ops in reverse; result reverses before returning.
# O(n) where n = total pattern nodes in items (recursively).
fn do_bind_tuple_items(items: List ast.Pattern, scrut_name: String,
                       idx: Int, field_idx: Int,
                       name_prefix: String,
                       acc_ops: List sprout_ir.IROp,
                       acc_captures: Dict String) ->
    Result String (List sprout_ir.IROp, Dict String, Int) =
  match items with
  | Nil -> Ok((list_reverse(acc_ops), acc_captures, idx))
  | Cons pat rest_items ->
      match pat with
      | ast.WildcardPattern _ ->
          do_bind_tuple_items(rest_items, scrut_name, idx, field_idx + 1,
                              name_prefix, acc_ops, acc_captures)
      | ast.UnitPattern _ ->
          do_bind_tuple_items(rest_items, scrut_name, idx, field_idx + 1,
                              name_prefix, acc_ops, acc_captures)
      | ast.VarPattern v _ ->
          do_bind_tuple_items(rest_items, scrut_name, idx + 1, field_idx + 1,
                              name_prefix,
                              Cons(sprout_ir.IRGetTupleField(fresh_name(name_prefix, idx),
                                                             scrut_name, field_idx, sprout_ir.IRTUnknown),
                                   acc_ops),
                              dict_set(v, fresh_name(name_prefix, idx), acc_captures))
      | ast.TuplePattern inner_items _ ->
          match fresh_name(name_prefix, idx) with
          | field_ssa ->
              match do_bind_tuple_items(inner_items, field_ssa, idx + 1, 0,
                                        name_prefix,
                                        Cons(sprout_ir.IRGetTupleField(field_ssa, scrut_name, field_idx, sprout_ir.IRTUnknown),
                                             acc_ops),
                                        acc_captures) with
              | Err msg -> Err(msg)
              | Ok inner_result ->
                  match inner_result with
                  | (inner_ops_rev, inner_captures, idx2) ->
                      do_bind_tuple_items(rest_items, scrut_name, idx2, field_idx + 1,
                                          name_prefix, list_reverse(inner_ops_rev),
                                          inner_captures)
      | ast.ConstructorPattern _ _ _ ->
          Err("ast_to_ir: nested constructor pattern in do-bind tuple not yet supported")
      | ast.IntPattern _ _ ->
          Err("ast_to_ir: nested int pattern in do-bind tuple not yet supported")
      | ast.BoolPattern _ _ ->
          Err("ast_to_ir: nested bool pattern in do-bind tuple not yet supported")
      | ast.StringPattern _ _ ->
          Err("ast_to_ir: nested string pattern in do-bind tuple not yet supported")
      | ast.CharPattern _ _ ->
          Err("ast_to_ir: nested char pattern in do-bind tuple not yet supported")

# M3 PR 13: ctor-tag lookup helper for the Maybe do-bind short-circuit.
# Mirrors codegen.sprout's find_nothing_tag — checks both the bare name (when
# prelude is imported unqualified) and the prelude-qualified form.  Defensive
# fallback (0) matches direct codegen; a do-block bind on Maybe whose ctor
# table is missing the names shouldn't typecheck in the first place.
fn find_nothing_tag_ir(ctors: Dict sprout_ir.CtorInfo) -> Int =
  match dict_get("Nothing", ctors) with
  | Just entry ->
      match entry with
      | sprout_ir.CtorInfo tag _ _ _ _ -> tag
  | Nothing ->
      match dict_get("stdlib.prelude.Nothing", ctors) with
      | Just entry ->
          match entry with
          | sprout_ir.CtorInfo tag _ _ _ _ -> tag
      | Nothing -> 0

# Ctor-tag lookup for the Result do-bind short-circuit.  Like
# find_nothing_tag_ir, checks both the bare name and the prelude-qualified
# form.  The Result branch tests for Err (short-circuit on failure); Ok is the
# continue case.  Defensive fallback matches direct codegen; a Result do-bind
# whose ctor table lacks the names would not have typechecked.
fn find_err_tag_ir(ctors: Dict sprout_ir.CtorInfo) -> Int =
  match dict_get("Err", ctors) with
  | Just entry ->
      match entry with
      | sprout_ir.CtorInfo tag _ _ _ _ -> tag
  | Nothing ->
      match dict_get("stdlib.prelude.Err", ctors) with
      | Just entry ->
          match entry with
          | sprout_ir.CtorInfo tag _ _ _ _ -> tag
      | Nothing -> 0

# M3 PR 13: lower `x <- f()` where f returns `Maybe a !{IO}`.
#
# Per memory project_do_block_result_io_quirk: both layers (IO and Maybe)
# strip; `x` is bound to the inner `a`.  Nothing short-circuits as the do
# block's overall result, mirroring Haskell-style monadic propagation.
#
# Block layout (mirrors codegen.sprout's emit_do_maybe_bind, lines 2913-2956):
#
#   <cur_lbl>:
#     ... cur_ops ...
#     %e = <translate e>           ← may emit blocks of its own (eblocks)
#     %tag = call i64 @sprout_tag(i64 %e)
#     %nt = const <nothing_tag>
#     %is_n = icmp eq i64 %tag, i64 %nt
#     br i1 %is_n, label %do_short_K, label %do_cont_K
#   do_short_K:
#     %nv = call i64 @sprout_alloc_obj(i64 <nothing_tag>, i64 0)
#     br label %do_done_K
#   do_cont_K:
#     %p = call i64 @sprout_field(i64 %e, i64 0)
#     ... bind pat to %p via do_bind_captures ...
#     ... translate rest of do-block ...
#     <rest_final_lbl>: br label %do_done_K
#   do_done_K:
#     %result = phi i64 [%nv, %do_short_K], [%rest_name, %rest_final_lbl]
# The unbox target (`@f_worker` for a top-level fn, `@f_unboxed` for a
# Maybe/Result C extern) a `pat <- f(..)` do-bind routes to, or Nothing (boxed).
# Local, like translate_match's router — the worker is guaranteed to exist because
# collect_worker_callees scans do-binds (collect_wc_do_bind_callee).
fn do_bind_unbox_target(e: typed_ast.TypedExpr, params: List String, captures: Dict String,
                        let_names: Set, top_level: Set, ctors: Dict sprout_ir.CtorInfo,
                        fn_arities: Dict FnInfo) ->
    Maybe String =
  match e with
  | typed_ast.TCall callee _ _ _ ->
      match callee with
      | typed_ast.TVar name _ _ ->
          if ! callee_name_shadowed (name, params, captures, let_names, ctors)
          then match unboxed_maybe_extern_name(name) with
               | Just ufn -> Just(ufn)
               | Nothing ->
                   # Same representation gate as translate_match's routers: a
                   # callee whose declared result is a type variable has no
                   # lowerable worker convention.
                   if set_member(name, top_level) && cpr_result_known(name, fn_arities)
                   then Just(name ++ "_worker") else Nothing
          else Nothing
      | _ -> Nothing
  | _ -> Nothing

fn translate_do_bind_maybe(pat: ast.Pattern, e: typed_ast.TypedExpr,
                            rest: List typed_ast.TypedDoStep,
                            params: List String, ctors: Dict sprout_ir.CtorInfo,
                            idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                            captures: Dict String,
                            lifted_ref: Ref (List sprout_ir.IRFunction),
                            top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                            lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                            name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match do_bind_unbox_target(e, params, captures, let_names, top_level, ctors, fn_arities) with
  | Just target ->
      match e with
      | typed_ast.TCall _ eargs _ _ ->
          translate_do_bind_maybe_unboxed(pat, target, eargs, rest, params, ctors, idx,
                                          cur_label, cur_ops, captures, lifted_ref,
                                          top_level, let_names, fn_arities,
                                          lambda_ctr_ref, lifted_idx_ref, name_prefix)
      | _ -> Err("ast_to_ir: do-bind unbox target on non-call (internal error)")
  | Nothing ->
      match translate_expr(e, params, ctors, idx, cur_label, cur_ops,
                           captures, lifted_ref, top_level, let_names, fn_arities,
                           lambda_ctr_ref, lifted_idx_ref, name_prefix) with
      | Err msg -> Err(msg)
      | Ok er ->
          match er with
          | (eblocks, elbl, eops, ename, eidx) ->
              translate_do_bind_maybe_finish(pat, rest, eblocks, elbl, eops, ename, eidx,
                                              params, ctors, captures, lifted_ref,
                                              top_level, let_names, fn_arities,
                                              lambda_ctr_ref, lifted_idx_ref, name_prefix)

# Unboxed `pat <- f(..)`: call @target -> { tag, val }, short-circuit on Nothing
# using tag directly (no IRGetTag), bind `pat` to val directly (no IRGetField).
fn translate_do_bind_maybe_unboxed(pat: ast.Pattern, target: String,
                                   eargs: List typed_ast.TypedExpr, rest: List typed_ast.TypedDoStep,
                                   params: List String, ctors: Dict sprout_ir.CtorInfo,
                                   idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                                   captures: Dict String,
                                   lifted_ref: Ref (List sprout_ir.IRFunction),
                                   top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                                   lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                                   name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match translate_args_scalar(eargs, params, ctors, idx, cur_label, cur_ops, Nil, Nil, captures,
                              lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                              lifted_idx_ref, name_prefix) with
  | Err msg -> Err(msg)
  | Ok ar ->
      match ar with
      | (ablocks, albl, aops, anames, aidx) ->
          match (fresh_name(name_prefix, aidx), fresh_name(name_prefix, aidx + 1)) with
          | (tag_ssa, val_ssa) ->
              translate_do_bind_maybe_finish_unboxed(pat, rest, ablocks, albl,
                list_append(aops, Cons(sprout_ir.IRCallUnboxed2(tag_ssa, val_ssa, sprout_ir.IRTUnknown, target, anames), Nil)),
                tag_ssa, val_ssa, aidx + 2, params, ctors, captures, lifted_ref,
                top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix)

fn translate_do_bind_maybe_finish(pat: ast.Pattern, rest: List typed_ast.TypedDoStep,
                                   eblocks: List sprout_ir.IRBlock,
                                   elbl: String, eops: List sprout_ir.IROp,
                                   ename: String, eidx: Int,
                                   params: List String,
                                   ctors: Dict sprout_ir.CtorInfo,
                                   captures: Dict String,
                                   lifted_ref: Ref (List sprout_ir.IRFunction),
                                   top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                                   lambda_ctr_ref: Ref Int,
                                   lifted_idx_ref: Ref (Dict Int),
                                   name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match do_bind_captures(pat, payload_name, captures, eidx + 6, name_prefix) with
  | Err msg -> Err(msg)
  | Ok bind_result ->
      match bind_result with
      | (bind_ops, new_captures, bind_idx) ->
          match translate_do(rest, params, ctors, bind_idx, cont_lbl,
                             list_append(Cons(payload_op, Nil), bind_ops),
                             new_captures, lifted_ref, top_level, let_names, fn_arities,
                             lambda_ctr_ref, lifted_idx_ref, name_prefix, dict_empty()) with
          | Err msg -> Err(msg)
          | Ok rr ->
              match rr with
              | (rblocks, rfinal_lbl, rfinal_ops, rname, ridx) ->
                  Ok((list_append(eblocks,
                        Cons(test_block,
                        Cons(short_block,
                        list_append(rblocks,
                          Cons(sprout_ir.IRBlock(rfinal_lbl,
                                 list_append(rfinal_ops,
                                   Cons(sprout_ir.IRBr(done_lbl), Nil))),
                          Nil))))),
                       done_lbl,
                       Cons(sprout_ir.IRPhi(fresh_name(name_prefix, ridx), "i64",
                              Cons((nothing_val_name, short_lbl),
                              Cons((rname, rfinal_lbl), Nil))), Nil),
                       fresh_name(name_prefix, ridx), ridx + 1))
  where nothing_tag = find_nothing_tag_ir(ctors)
        tag_name = fresh_name(name_prefix, eidx)
        const_name = fresh_name(name_prefix, eidx + 1)
        cmp_name = fresh_name(name_prefix, eidx + 2)
        short_lbl = "do_short_" ++ int_to_string(eidx)
        cont_lbl = "do_cont_" ++ int_to_string(eidx)
        done_lbl = "do_done_" ++ int_to_string(eidx)
        test_block = sprout_ir.IRBlock(elbl,
                       list_append(eops,
                         Cons(sprout_ir.IRGetTag(tag_name, ename),
                         Cons(sprout_ir.IRConst(const_name, nothing_tag),
                         Cons(sprout_ir.IRICmp(cmp_name, "eq", tag_name, const_name),
                         Cons(sprout_ir.IRCondBr(cmp_name, short_lbl, cont_lbl), Nil))))))
        nothing_val_name = fresh_name(name_prefix, eidx + 4)
        short_block = sprout_ir.IRBlock(short_lbl,
                        Cons(sprout_ir.IRMakeCtor(nothing_val_name, "Nothing", nothing_tag, Nil),
                        Cons(sprout_ir.IRBr(done_lbl), Nil)))
        payload_name = fresh_name(name_prefix, eidx + 5)
        payload_op = sprout_ir.IRGetField(payload_name, ename, 0, sprout_ir.IRTUnknown)

# Unboxed variant: (tag_ssa, val_ssa) come from an IRCallUnboxed2 already emitted
# into `eops`.  Mirrors translate_do_bind_maybe_finish's CFG (test/short/cont/done
# + phi) but tests tag_ssa directly and binds `pat` to val_ssa — no box, no
# IRGetTag/IRGetField.  val_ssa is 0 on the Nothing path, never dereferenced.
fn translate_do_bind_maybe_finish_unboxed(pat: ast.Pattern, rest: List typed_ast.TypedDoStep,
                                          eblocks: List sprout_ir.IRBlock, elbl: String,
                                          eops: List sprout_ir.IROp, tag_ssa: String, val_ssa: String,
                                          eidx: Int, params: List String,
                                          ctors: Dict sprout_ir.CtorInfo, captures: Dict String,
                                          lifted_ref: Ref (List sprout_ir.IRFunction),
                                          top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                                          lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                                          name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match do_bind_captures(pat, val_ssa, captures, eidx + 4, name_prefix) with
  | Err msg -> Err(msg)
  | Ok bind_result ->
      match bind_result with
      | (bind_ops, new_captures, bind_idx) ->
          match translate_do(rest, params, ctors, bind_idx, cont_lbl, bind_ops,
                             new_captures, lifted_ref, top_level, let_names, fn_arities,
                             lambda_ctr_ref, lifted_idx_ref, name_prefix, dict_empty()) with
          | Err msg -> Err(msg)
          | Ok rr ->
              match rr with
              | (rblocks, rfinal_lbl, rfinal_ops, rname, ridx) ->
                  Ok((list_append(eblocks,
                        Cons(test_block,
                        Cons(short_block,
                        list_append(rblocks,
                          Cons(sprout_ir.IRBlock(rfinal_lbl,
                                 list_append(rfinal_ops,
                                   Cons(sprout_ir.IRBr(done_lbl), Nil))),
                          Nil))))),
                       done_lbl,
                       Cons(sprout_ir.IRPhi(fresh_name(name_prefix, ridx), "i64",
                              Cons((nothing_val_name, short_lbl),
                              Cons((rname, rfinal_lbl), Nil))), Nil),
                       fresh_name(name_prefix, ridx), ridx + 1))
  where nothing_tag = find_nothing_tag_ir(ctors)
        const_name = fresh_name(name_prefix, eidx)
        cmp_name = fresh_name(name_prefix, eidx + 1)
        short_lbl = "do_short_" ++ int_to_string(eidx)
        cont_lbl = "do_cont_" ++ int_to_string(eidx)
        done_lbl = "do_done_" ++ int_to_string(eidx)
        test_block = sprout_ir.IRBlock(elbl,
                       list_append(eops,
                         Cons(sprout_ir.IRConst(const_name, nothing_tag),
                         Cons(sprout_ir.IRICmp(cmp_name, "eq", tag_ssa, const_name),
                         Cons(sprout_ir.IRCondBr(cmp_name, short_lbl, cont_lbl), Nil)))))
        nothing_val_name = fresh_name(name_prefix, eidx + 3)
        short_block = sprout_ir.IRBlock(short_lbl,
                        Cons(sprout_ir.IRMakeCtor(nothing_val_name, "Nothing", nothing_tag, Nil),
                        Cons(sprout_ir.IRBr(done_lbl), Nil)))

# Lower `pat <- f()` where f returns `Result E a` (optionally `!{IO}`).
# Mirrors translate_do_bind_maybe but short-circuits on Err instead of Nothing.
# The Err box already carries the E payload and is valid as the do-block's
# overall `Result E b`, so the short branch propagates `ename` unchanged rather
# than rebuilding -- this is why Result needs fewer fresh names than Maybe (no
# Nothing-rebuild).  Block layout:
#
#   <elbl>:
#     ... eops ...
#     %tag = call i64 @sprout_tag(i64 %e)
#     %ec  = const <err_tag>
#     %is_e = icmp eq i64 %tag, %ec
#     br i1 %is_e, label %do_short_K, label %do_cont_K
#   do_short_K:
#     br label %do_done_K                     ← err propagates %e via phi
#   do_cont_K:
#     %p = call i64 @sprout_field(i64 %e, i64 0)   ← strip Ok
#     ... bind pat to %p; translate rest ...
#     <rest_final>: br label %do_done_K
#   do_done_K:
#     %result = phi i64 [%e, %do_short_K], [%rest_name, <rest_final>]
#
# The boxed (non-unboxed) path: taken when do_bind_unbox_target finds no
# eligible unbox target. Split out so translate_do_bind_result's own
# do_bind_unbox_target dispatch reads as a flat `let..else` (a call, not an
# inline multi-line fallback — that layout tripped the let-binding's
# step-boundary scanner, since the nested match's shallow-indented arms sat
# at columns below the binding's own layout column).
fn translate_do_bind_result_boxed(pat: ast.Pattern, e: typed_ast.TypedExpr,
                                  rest: List typed_ast.TypedDoStep,
                                  params: List String, ctors: Dict sprout_ir.CtorInfo,
                                  idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                                  captures: Dict String,
                                  lifted_ref: Ref (List sprout_ir.IRFunction),
                                  top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                                  lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                                  name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match translate_expr(e, params, ctors, idx, cur_label, cur_ops,
                       captures, lifted_ref, top_level, let_names, fn_arities,
                       lambda_ctr_ref, lifted_idx_ref, name_prefix) with
  | Err msg -> Err(msg)
  | Ok er ->
      match er with
      | (eblocks, elbl, eops, ename, eidx) ->
          translate_do_bind_result_finish(pat, rest, eblocks, elbl, eops, ename, eidx,
                                          params, ctors, captures, lifted_ref,
                                          top_level, let_names, fn_arities,
                                          lambda_ctr_ref, lifted_idx_ref, name_prefix)

fn translate_do_bind_result(pat: ast.Pattern, e: typed_ast.TypedExpr,
                            rest: List typed_ast.TypedDoStep,
                            params: List String, ctors: Dict sprout_ir.CtorInfo,
                            idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                            captures: Dict String,
                            lifted_ref: Ref (List sprout_ir.IRFunction),
                            top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                            lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                            name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  let Just target = do_bind_unbox_target(e, params, captures, let_names, top_level, ctors, fn_arities)
      else translate_do_bind_result_boxed(pat, e, rest, params, ctors, idx, cur_label, cur_ops,
             captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
             name_prefix)
  in
  match e with
  | typed_ast.TCall _ eargs _ _ ->
      match translate_args_scalar(eargs, params, ctors, idx, cur_label, cur_ops, Nil, Nil, captures,
                                  lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                                  lifted_idx_ref, name_prefix) with
      | Err msg -> Err(msg)
      | Ok ar ->
          match ar with
          | (ablocks, albl, aops, anames, aidx) ->
              match (fresh_name(name_prefix, aidx), fresh_name(name_prefix, aidx + 1)) with
              | (tag_ssa, val_ssa) ->
                  translate_do_bind_result_finish_unboxed(pat, rest, ablocks, albl,
                    list_append(aops, Cons(sprout_ir.IRCallUnboxed2(tag_ssa, val_ssa, sprout_ir.IRTUnknown, target, anames), Nil)),
                    tag_ssa, val_ssa, aidx + 2, params, ctors, captures, lifted_ref,
                    top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | _ -> Err("ast_to_ir: do-bind unbox target on non-call (internal error)")

# Unboxed `pat <- f()` for Result: call @target -> { tag, val }, short-circuit on
# Err by REBUILDING Err(val) (the boxed path propagated the box; unboxed has none),
# bind `pat` to val on the Ok path.  Mirrors translate_do_bind_result_finish.
fn translate_do_bind_result_finish_unboxed(pat: ast.Pattern, rest: List typed_ast.TypedDoStep,
                                           eblocks: List sprout_ir.IRBlock, elbl: String,
                                           eops: List sprout_ir.IROp, tag_ssa: String, val_ssa: String,
                                           eidx: Int, params: List String,
                                           ctors: Dict sprout_ir.CtorInfo, captures: Dict String,
                                           lifted_ref: Ref (List sprout_ir.IRFunction),
                                           top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                                           lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                                           name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match do_bind_captures(pat, val_ssa, captures, eidx + 4, name_prefix) with
  | Err msg -> Err(msg)
  | Ok bind_result ->
      match bind_result with
      | (bind_ops, new_captures, bind_idx) ->
          match translate_do(rest, params, ctors, bind_idx, cont_lbl, bind_ops,
                             new_captures, lifted_ref, top_level, let_names, fn_arities,
                             lambda_ctr_ref, lifted_idx_ref, name_prefix, dict_empty()) with
          | Err msg -> Err(msg)
          | Ok rr ->
              match rr with
              | (rblocks, rfinal_lbl, rfinal_ops, rname, ridx) ->
                  Ok((list_append(eblocks,
                        Cons(test_block,
                        Cons(short_block,
                        list_append(rblocks,
                          Cons(sprout_ir.IRBlock(rfinal_lbl,
                                 list_append(rfinal_ops,
                                   Cons(sprout_ir.IRBr(done_lbl), Nil))),
                          Nil))))),
                       done_lbl,
                       Cons(sprout_ir.IRPhi(fresh_name(name_prefix, ridx), "i64",
                              Cons((err_val_name, short_lbl),
                              Cons((rname, rfinal_lbl), Nil))), Nil),
                       fresh_name(name_prefix, ridx), ridx + 1))
  where err_tag = find_err_tag_ir(ctors)
        const_name = fresh_name(name_prefix, eidx)
        cmp_name = fresh_name(name_prefix, eidx + 1)
        short_lbl = "do_short_" ++ int_to_string(eidx)
        cont_lbl = "do_cont_" ++ int_to_string(eidx)
        done_lbl = "do_done_" ++ int_to_string(eidx)
        test_block = sprout_ir.IRBlock(elbl,
                       list_append(eops,
                         [sprout_ir.IRConst(const_name, err_tag),
                          sprout_ir.IRICmp(cmp_name, "eq", tag_ssa, const_name),
                          sprout_ir.IRCondBr(cmp_name, short_lbl, cont_lbl)]))
        err_val_name = fresh_name(name_prefix, eidx + 3)
        short_block = sprout_ir.IRBlock(short_lbl,
                        [sprout_ir.IRMakeCtor(err_val_name, "Err", err_tag, [val_ssa]),
                         sprout_ir.IRBr(done_lbl)])

fn translate_do_bind_result_finish(pat: ast.Pattern, rest: List typed_ast.TypedDoStep,
                                   eblocks: List sprout_ir.IRBlock,
                                   elbl: String, eops: List sprout_ir.IROp,
                                   ename: String, eidx: Int,
                                   params: List String,
                                   ctors: Dict sprout_ir.CtorInfo,
                                   captures: Dict String,
                                   lifted_ref: Ref (List sprout_ir.IRFunction),
                                   top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                                   lambda_ctr_ref: Ref Int,
                                   lifted_idx_ref: Ref (Dict Int),
                                   name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match do_bind_captures(pat, payload_name, captures, eidx + 4, name_prefix) with
  | Err msg -> Err(msg)
  | Ok bind_result ->
      match bind_result with
      | (bind_ops, new_captures, bind_idx) ->
          match translate_do(rest, params, ctors, bind_idx, cont_lbl,
                             list_append(Cons(payload_op, Nil), bind_ops),
                             new_captures, lifted_ref, top_level, let_names, fn_arities,
                             lambda_ctr_ref, lifted_idx_ref, name_prefix, dict_empty()) with
          | Err msg -> Err(msg)
          | Ok rr ->
              match rr with
              | (rblocks, rfinal_lbl, rfinal_ops, rname, ridx) ->
                  Ok((list_append(eblocks,
                        Cons(test_block,
                        Cons(short_block,
                        list_append(rblocks,
                          Cons(sprout_ir.IRBlock(rfinal_lbl,
                                 list_append(rfinal_ops,
                                   Cons(sprout_ir.IRBr(done_lbl), Nil))),
                          Nil))))),
                       done_lbl,
                       Cons(sprout_ir.IRPhi(fresh_name(name_prefix, ridx), "i64",
                              Cons((ename, short_lbl),
                              Cons((rname, rfinal_lbl), Nil))), Nil),
                       fresh_name(name_prefix, ridx), ridx + 1))
  where err_tag = find_err_tag_ir(ctors)
        tag_name = fresh_name(name_prefix, eidx)
        const_name = fresh_name(name_prefix, eidx + 1)
        cmp_name = fresh_name(name_prefix, eidx + 2)
        short_lbl = "do_short_" ++ int_to_string(eidx)
        cont_lbl = "do_cont_" ++ int_to_string(eidx)
        done_lbl = "do_done_" ++ int_to_string(eidx)
        test_block = sprout_ir.IRBlock(elbl,
                       list_append(eops,
                         Cons(sprout_ir.IRGetTag(tag_name, ename),
                         Cons(sprout_ir.IRConst(const_name, err_tag),
                         Cons(sprout_ir.IRICmp(cmp_name, "eq", tag_name, const_name),
                         Cons(sprout_ir.IRCondBr(cmp_name, short_lbl, cont_lbl), Nil))))))
        short_block = sprout_ir.IRBlock(short_lbl,
                        Cons(sprout_ir.IRBr(done_lbl), Nil))
        payload_name = fresh_name(name_prefix, eidx + 3)
        payload_op = sprout_ir.IRGetField(payload_name, ename, 0, sprout_ir.IRTUnknown)

# Find the type of the first TVar with the given name inside expr.
# Used by translate_lambda to check whether a captured variable is Bool-typed.
# Returns Nothing if no matching TVar is found (should not happen for a name
# that passed filter_capturable, but we handle it defensively).
# O(n) where n = expression node count.
fn find_capture_type(expr: typed_ast.TypedExpr, name: String) -> Maybe types.Type =
  match expr with
  | typed_ast.TVar n ty _ ->
      if n == name then Just(ty) else Nothing
  | typed_ast.TInt _ _ _ -> Nothing
  | typed_ast.TFloat _ _ _ -> Nothing
  | typed_ast.TBool _ _ _ -> Nothing
  | typed_ast.TString _ _ _ -> Nothing
  | typed_ast.TChar _ _ _ -> Nothing
  | typed_ast.TUnit _ _ -> Nothing
  | typed_ast.TTuple items _ _ ->
      find_capture_type_list(items, name)
  | typed_ast.TIf cond thn els _ _ ->
      find_capture_type_first([cond, thn, els], name)
  | typed_ast.TBinary _ l r _ _ ->
      find_capture_type_first([l, r], name)
  | typed_ast.TUnary _ operand _ _ ->
      find_capture_type(operand, name)
  | typed_ast.TCall callee args _ _ ->
      find_capture_type_first(Cons(callee, args), name)
  | typed_ast.TLambda lparams body _ _ ->
      # FIX R4#1: if `name` is shadowed by the inner lambda's own param, stop —
      # the inner body's TVar resolves to the param, not the outer capture.
      if param_known(name, fv_param_names(lparams))
      then Nothing
      else find_capture_type(body, name)
  | typed_ast.TRange s e _ _ ->
      find_capture_type_first([s, e], name)
  | typed_ast.TDo steps _ _ ->
      # FIX R4#6: mirror compute_free_vars_do_steps; walk steps threading shadow info.
      find_capture_type_do_steps(steps, name)
  | typed_ast.TDict _ _ _ _ -> Nothing
  | typed_ast.TMethodRef _ _ _ _ _ -> panic("ast_to_ir.find_capture_type: TMethodRef survived lowering (internal error)")
  | typed_ast.TRecord _ fields _ _ ->
      find_capture_type_fields(fields, name)
  | typed_ast.TMatch scrut arms _ _ ->
      # FIX R4#6: mirror compute_free_vars_match_arms; walk arm bodies with pattern shadowing.
      match find_capture_type(scrut, name) with
      | Just t -> Just(t)
      | Nothing -> find_capture_type_match_arms(arms, name)
  | typed_ast.TGetField obj _ _ _ ->
      find_capture_type(obj, name)
  | typed_ast.TRecordUpdate base fields _ _ ->
      match find_capture_type(base, name) with
      | Just t -> Just(t)
      | Nothing -> find_capture_type_fields(fields, name)

# O(n * k) where n = list length, k = expr size.
fn find_capture_type_list(exprs: List typed_ast.TypedExpr, name: String) -> Maybe types.Type =
  match exprs with
  | Nil -> Nothing
  | Cons e rest ->
      match find_capture_type(e, name) with
      | Just t -> Just(t)
      | Nothing -> find_capture_type_list(rest, name)

fn find_capture_type_first(exprs: List typed_ast.TypedExpr, name: String) -> Maybe types.Type =
  find_capture_type_list(exprs, name)

fn find_capture_type_fields(fields: List typed_ast.TypedRecordField, name: String) -> Maybe types.Type =
  match fields with
  | Nil -> Nothing
  | Cons field rest ->
      match field with
      | typed_ast.TypedRecordField _ e ->
          match find_capture_type(e, name) with
          | Just t -> Just(t)
          | Nothing -> find_capture_type_fields(rest, name)

# FIX R4#6: walk TMatch arms, respecting pattern shadowing.
# If the arm pattern binds `name`, skip the arm body (the reference resolves
# to the pattern variable, not the outer capture).
# O(n * k) where n = arm count, k = arm body size.
fn find_capture_type_match_arms(arms: List typed_ast.TypedMatchBranch, name: String) -> Maybe types.Type =
  match arms with
  | Nil -> Nothing
  | Cons arm rest ->
      match arm with
      | typed_ast.TypedMatchBranch pat body ->
          if param_known(name, pattern_names(pat))
          then find_capture_type_match_arms(rest, name)
          else
            match find_capture_type(body, name) with
            | Just t -> Just(t)
            | Nothing -> find_capture_type_match_arms(rest, name)

# FIX R4#6: walk TDo steps, threading shadow information left-to-right.
# TDoBindStep and TDoLetStep add new names to the shadowed set; once `name`
# is bound in a step, stop searching subsequent steps (mirroring
# compute_free_vars_do_steps which removes a newly-bound name from free vars).
# O(n * k) where n = step count, k = expr size.
fn find_capture_type_do_steps(steps: List typed_ast.TypedDoStep, name: String) -> Maybe types.Type =
  match steps with
  | Nil -> Nothing
  | Cons step rest ->
      match step with
      | typed_ast.TDoBindStep pat e ->
          match find_capture_type(e, name) with
          | Just t -> Just(t)
          | Nothing ->
              if param_known(name, pattern_names(pat))
              then Nothing
              else find_capture_type_do_steps(rest, name)
      | typed_ast.TDoLetStep lname e ->
          match find_capture_type(e, name) with
          | Just t -> Just(t)
          | Nothing ->
              if lname == name
              then Nothing
              else find_capture_type_do_steps(rest, name)
      | typed_ast.TDoExprStep e ->
          match find_capture_type(e, name) with
          | Just t -> Just(t)
          | Nothing -> find_capture_type_do_steps(rest, name)

# Check whether any name in capturable is Bool-typed in the lambda body.
# Returns Just(name) for the first Bool-typed capture, Nothing if none.
# O(n * m) where n = capturable length, m = body size.
fn find_bool_capture(capturable: List String, body: typed_ast.TypedExpr) -> Maybe String =
  match capturable with
  | Nil -> Nothing
  | Cons v rest ->
      match find_capture_type(body, v) with
      | Just ty ->
          if is_bool_type(ty) then Just(v)
          else find_bool_capture(rest, body)
      | Nothing -> find_bool_capture(rest, body)

# Translate a TLambda node: lift the body into a synthetic function, emit
# IRMkClosure at the use site, and register the lifted function via lifted_ref.
#
# Algorithm:
#   1. Compute free variables of the lambda body (excluding lambda's own params
#      AND the outer fn's params — both are in `lam_bound`).  Exclude top_level.
#   2. Filter free names to those accessible in the outer scope (in `params` or
#      `captures`). These become the closure's captured slots.
#   3. Use the current length of lifted_ref's list as the lambda index.  This
#      is the per-user-fn accumulator, so indices restart at 0 per user fn.
#      (Prompt says "shared counter" across decls; we use list_length of the
#      shared lifted_ref instead of a separate Ref<Int> to avoid extra threading
#      through translate_expr.  This is a deliberate deviation reported in the
#      summary — the result is still correct unique naming within the program
#      because translate_user_fn creates a fresh lifted_ref per call.)
#   4. For the lifted body: pre-emit IRLoadEnvSlot ops (slot i+1 for capture i;
#      slot 0 is the code pointer). Build a captures dict from free-var name to
#      "%t<i>" where i matches the slot index.
#   5. Translate the body in the lifted fn's own idx-space starting at N
#      (where N = number of captures), using lifted params and captures dict.
#   6. Build the IRFunction and register it by prepending to lifted_ref.
#   7. Emit IRMkClosure at the call site.
#
# Rejects: Bool-returning lambda (body type is Bool → i1, but lifted fn is i64);
#          Bool-capturing lambda (IRLoadEnvSlot returns i64 but Bool needs i1).
# Both require IRZextI1ToI64 / IRTruncI64ToI1 — deferred to a follow-up PR.
#
# O(n * log(n)) where n = lambda body size.
fn translate_lambda(lparams: List ast.Param, body: typed_ast.TypedExpr,
                    lam_ty: types.Type,
                    params: List String, ctors: Dict sprout_ir.CtorInfo,
                    idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                    captures: Dict String,
                    lifted_ref: Ref (List sprout_ir.IRFunction),
                    top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                    lambda_ctr_ref: Ref Int,
                    lifted_idx_ref: Ref (Dict Int),
                    name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  # /code-review-v2 fix #6: Bool-return guard removed. Post-fix-#2 + #3, Bool
  # flows as i64 throughout: TBool literals emit IRConst (i64); comparison
  # results are widened by IRZextI1ToI64 (i64); function ret_ty is "i64"
  # uniformly. A Bool-returning lambda's lifted ret_ty is "i64"; IRRet emits
  # `ret i64 %val` where %val is i64. Internally consistent — no zext at
  # IRRet needed.
  translate_lambda_after_ret_check(lparams, body, lam_ty, params, ctors, idx,
                                   cur_label, cur_ops, captures, lifted_ref,
                                   top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix)

# Continues translate_lambda after the Bool-return guard has passed.
# Splitting avoids `else let` inside a do block (not valid Sprout).
fn translate_lambda_after_ret_check(lparams: List ast.Param, body: typed_ast.TypedExpr,
                                    lam_ty: types.Type,
                                    params: List String, ctors: Dict sprout_ir.CtorInfo,
                                    idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                                    captures: Dict String,
                                    lifted_ref: Ref (List sprout_ir.IRFunction),
                                    top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                                    lambda_ctr_ref: Ref Int,
                                    lifted_idx_ref: Ref (Dict Int),
                                    name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  do
    let lam_param_names = fv_param_names(lparams)
    # bound = ONLY the lambda's own params. Outer fn's params (and outer
    # captures) are *free* from the lambda's perspective — they're the
    # capture candidates. filter_capturable below restricts to ones that are
    # actually visible at the use site (in `params` or `captures`).
    let lam_bound = set_from_list(lam_param_names)
    # set_to_list returns keys in sorted (alphabetical) order because Set is a
    # BST keyed by string-compare. Capture slot indices are therefore stable
    # across unrelated renames — only renaming a captured variable itself
    # changes its slot index.
    let all_frees_list = set_to_list(compute_free_vars(body, lam_bound, top_level))
    let capturable = filter_capturable(all_frees_list, params, captures)
    # /code-review-v2 fix #7: Bool-capture guard removed. Post-fix-#2 + #3,
    # Bool flows as i64; IRLoadEnvSlot returns i64; the captured Bool is i64
    # in the env. Internally consistent.
    translate_lambda_emit(lparams, body, capturable, lam_param_names,
                          params, ctors, idx, cur_label, cur_ops, captures,
                          lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix)

# Final emission stage of translate_lambda after both Bool checks pass.
# Extracted so each match arm in the parent can return a single expression
# (Err or a clean tail call), avoiding Sprout's "match arm doesn't continue
# the outer do block" restriction.
fn translate_lambda_emit(lparams: List ast.Param, body: typed_ast.TypedExpr,
                         capturable: List String, lam_param_names: List String,
                         params: List String, ctors: Dict sprout_ir.CtorInfo,
                         idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                         captures: Dict String,
                         lifted_ref: Ref (List sprout_ir.IRFunction),
                         top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                         lambda_ctr_ref: Ref Int,
                         lifted_idx_ref: Ref (Dict Int),
                         name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  do
    # Allocate this lambda's unique index BEFORE translating the body, so that
    # any nested TLambda encountered during body translation receives the next
    # (higher) index and cannot collide with this one. lambda_ctr_ref is shared
    # across all user fns (lives at translate_program scope).
    lam_idx <- ref_read(lambda_ctr_ref)
    ref_write(lambda_ctr_ref, lam_idx + 1)
    # Prefix with __sprout_ to avoid collisions with user-written fns. Names
    # starting with __sprout_ are rejected up-front by validate_reserved_namespace.
    let lam_fn_name = "__sprout_ir_lambda_" ++ int_to_string(lam_idx)
    # SSA names for the captured values at the call site (outer scope).
    # build_captures_list_ir propagates Err loudly: Nothing is a bug in filter_capturable.
    match build_captures_list_ir(capturable, params, captures) with
    | Err msg -> Err(msg)
    | Ok cap_ssas ->
        translate_lambda_lifted(lparams, body, capturable, lam_param_names, cap_ssas,
                                lam_fn_name, params, ctors, idx, cur_label, cur_ops,
                                captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                                lifted_idx_ref, name_prefix)

# Translates the lifted body, registers the IRFunction, and emits IRMkClosure.
fn translate_lambda_lifted(lparams: List ast.Param, body: typed_ast.TypedExpr,
                           capturable: List String, lam_param_names: List String,
                           cap_ssas: List String, lam_fn_name: String,
                           params: List String, ctors: Dict sprout_ir.CtorInfo,
                           idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                           captures: Dict String,
                           lifted_ref: Ref (List sprout_ir.IRFunction),
                           top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                           lambda_ctr_ref: Ref Int,
                           lifted_idx_ref: Ref (Dict Int),
                           name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  do
    let n_caps = list_length(capturable)
    # FIX R4#7: compute scalar vs heap kind for each capture so ir_rooting can
    # skip rooting Int/Char captures (they are i64 scalars, never GC'd).
    let cap_kinds = build_capture_kinds(capturable, body)
    # IRLoadEnvSlot ops seeding the lifted entry block (slots 1..n_caps).
    let load_ops = build_load_env_ops(capturable, cap_kinds, 0)
    # captures dict for the lifted body: free-var name → "%t$<i>" for slot i.
    let lifted_captures = build_lifted_captures(capturable, 0)
    # Lifted body uses "%t$" prefix to avoid colliding with user lambda params
    # like "t0" (which produce "%t0" in LLVM). FIX #4.
    match translate_expr(body, lam_param_names, ctors, n_caps,
                         "entry", load_ops, lifted_captures, lifted_ref, top_level, let_names, fn_arities,
                         lambda_ctr_ref, lifted_idx_ref, "%t$") with
    | Err msg -> Err(msg)
    | Ok br ->
        match br with
        | (body_blocks, body_cur_lbl, body_cur_ops, body_result, body_next_idx) ->
            do
              let ret_block = sprout_ir.IRBlock(body_cur_lbl,
                                list_append(body_cur_ops,
                                  Cons(sprout_ir.IRRet(body_result), Nil)))
              let lifted_blocks = list_append(body_blocks, Cons(ret_block, Nil))
              # Lifted fn receives "env$" as first param ("$" rejected by source),
              # then lambda's own params.
              # Derive per-param IRType so ir_rooting can skip seeding scalar
              # params into heap_origin.  "env$" is always heap (closure env
              # pointer); lambda params come from lparams' type annotations
              # via type_kind.type_expr_is_non_heap_scalar.
              let lam_params_with_kinds = ast_params_to_irtype_pairs(lparams, lam_param_names)
              let lifted_fn = sprout_ir.IRFunction(lam_fn_name,
                                Cons(("env$", sprout_ir.IRTHeap), lam_params_with_kinds), "i64", lifted_blocks)
              new_lifted <- ref_read(lifted_ref)
              ref_write(lifted_ref, Cons(lifted_fn, new_lifted))
              # Record the lifted fn's next-free idx so the rooting pass picks
              # fresh names that don't collide with %t$0..%t$(n_caps-1) IRLoadEnvSlot.
              cur_lifted_idx <- ref_read(lifted_idx_ref)
              ref_write(lifted_idx_ref, dict_set(lam_fn_name, body_next_idx, cur_lifted_idx))
              # IRMkClosure is at the outer call site — use outer name_prefix.
              let closure_result = fresh_name(name_prefix, idx)
              Ok((Nil, cur_label,
                   list_append(cur_ops,
                     Cons(sprout_ir.IRMkClosure(closure_result, lam_fn_name,
                            list_length(lam_param_names), cap_ssas), Nil)),
                   closure_result, idx + 1))

# Translate `left <op> right` into IR ops.  Op must be one of
# +, -, *, ==, !=, <, <=, >, >=.  Both operands must be Int-typed
# (Char comparison is intentionally rejected at this milestone).
fn translate_binary(op: String, left: typed_ast.TypedExpr, right: typed_ast.TypedExpr,
                    params: List String, ctors: Dict sprout_ir.CtorInfo, idx: Int,
                    cur_label: String, cur_ops: List sprout_ir.IROp,
                    captures: Dict String,
                    lifted_ref: Ref (List sprout_ir.IRFunction),
                    top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                    lambda_ctr_ref: Ref Int,
                    lifted_idx_ref: Ref (Dict Int),
                    name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  # M3 PR 4: `&&` and `||` are short-circuit operators.  Desugar into the
  # equivalent TIf and reuse translate_if, which produces the canonical
  # `br i1 + label + phi` LLVM pattern.  This mirrors direct codegen's
  # emit_short_circuit (codegen.sprout:2046+) structurally; the differential
  # framework (PR 1.5) reports 0 divergence on shared-OK files.
  #   a && b  ≡  if a then b else false
  #   a || b  ≡  if a then true else b
  # Synthetic TBool literal carries the LHS position (used only for diagnostics).
  if op == "&&"
  then translate_if(left, right,
                    typed_ast.TBool(false, types.type_bool(), typed_ast.typed_expr_pos(left)),
                    types.type_bool(),
                    params, ctors, idx, cur_label, cur_ops,
                    captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                    name_prefix)
  else if op == "||"
  then translate_if(left,
                    typed_ast.TBool(true, types.type_bool(), typed_ast.typed_expr_pos(left)),
                    right, types.type_bool(),
                    params, ctors, idx, cur_label, cur_ops,
                    captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                    name_prefix)
  else if op == "++" && is_string_type(typed_ast.typed_expr_type(left))
                     && is_string_type(typed_ast.typed_expr_type(right))
  then
    match translate_expr(left, params, ctors, idx, cur_label, cur_ops,
                         captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                         name_prefix) with
    | Err msg -> Err(msg)
    | Ok lr ->
        match lr with
        | (lblocks, lcur_lbl, lcur_ops, l_name, idx1) ->
            match translate_expr(right, params, ctors, idx1, lcur_lbl, lcur_ops,
                                 captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                                 name_prefix) with
            | Err msg -> Err(msg)
            | Ok rr ->
                match rr with
                | (rblocks, rcur_lbl, rcur_ops, r_name, idx2) ->
                    Ok((list_append(lblocks, rblocks), rcur_lbl,
                         list_append(rcur_ops,
                           Cons(sprout_ir.IRStrConcat(fresh_name(name_prefix, idx2), l_name, r_name), Nil)),
                         fresh_name(name_prefix, idx2), idx2 + 1))
  # M3 PR 9: `==` and `!=` on String operands lower to @str_eq (i1 result,
  # zext'd to i64 for Bool ABI).  Must be before the Int-type guard below.
  # Direct codegen's equivalent: emit_ptr_comparison (codegen.sprout ~2094).
  # Char is NOT here: it is an immediate i64 codepoint and compares via integer
  # icmp through the Int/Char path below.
  # `!=` is `==` followed by IRBoolNot (xor i64 %r, 1) — same as other Bool
  # negation in the IR pipeline (PR 3's IRBoolNot op).
  else if (op == "==" || op == "!=")
       && is_string_type(typed_ast.typed_expr_type(left))
       && is_string_type(typed_ast.typed_expr_type(right))
  then
    match translate_expr(left, params, ctors, idx, cur_label, cur_ops,
                         captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                         name_prefix) with
    | Err msg -> Err(msg)
    | Ok lr ->
        match lr with
        | (lblocks, lcur_lbl, lcur_ops, l_name, idx1) ->
            match translate_expr(right, params, ctors, idx1, lcur_lbl, lcur_ops,
                                 captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                                 name_prefix) with
            | Err msg -> Err(msg)
            | Ok rr ->
                match rr with
                | (rblocks, rcur_lbl, rcur_ops, r_name, idx2) ->
                    if op == "=="
                    then Ok((list_append(lblocks, rblocks), rcur_lbl,
                              list_append(rcur_ops,
                                Cons(sprout_ir.IRStrEq(fresh_name(name_prefix, idx2), l_name, r_name), Nil)),
                              fresh_name(name_prefix, idx2), idx2 + 1))
                    else Ok((list_append(lblocks, rblocks), rcur_lbl,
                              list_append(rcur_ops,
                                Cons(sprout_ir.IRStrEq(fresh_name(name_prefix, idx2), l_name, r_name),
                                Cons(sprout_ir.IRBoolNot(fresh_name(name_prefix, idx2 + 1),
                                                         fresh_name(name_prefix, idx2)), Nil))),
                              fresh_name(name_prefix, idx2 + 1), idx2 + 2))
  # String ordering: `<` / `<=` / `>` / `>=` on String operands.
  # Emits IRStrCompare which lowers to @str_compare(i64,i64) + icmp <pred> i64 _,0 + zext.
  # @str_compare takes i64 handles directly (C: long long str_compare(long long, long long)).
  # Must appear before the Int-only guard below.
  # Char ordering is NOT here: a Char is an immediate i64 codepoint and orders via
  # integer icmp through the Int/Char path below (codepoint order == UTF-8 order).
  # Note: String literal ordering is currently also gated at the type-checker level
  # (infer.sprout check_compare accepts only Int/Char); the is_string_type arm here
  # is a forward-compatibility hook for when that restriction is lifted.
  else if (op == "<" || op == "<=" || op == ">" || op == ">=")
       && is_string_type(typed_ast.typed_expr_type(left))
       && is_string_type(typed_ast.typed_expr_type(right))
  then
    match cmp_predicate(op) with
    | Nothing -> Err("ast_to_ir: unexpected ordering op: " ++ op)
    | Just pred ->
        match translate_expr(left, params, ctors, idx, cur_label, cur_ops,
                             captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                             name_prefix) with
        | Err msg -> Err(msg)
        | Ok lr ->
            match lr with
            | (lblocks, lcur_lbl, lcur_ops, l_name, idx1) ->
                match translate_expr(right, params, ctors, idx1, lcur_lbl, lcur_ops,
                                     captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                                     name_prefix) with
                | Err msg -> Err(msg)
                | Ok rr ->
                    match rr with
                    | (rblocks, rcur_lbl, rcur_ops, r_name, idx2) ->
                        Ok((list_append(lblocks, rblocks), rcur_lbl,
                            list_append(rcur_ops,
                              Cons(sprout_ir.IRStrCompare(fresh_name(name_prefix, idx2), pred, l_name, r_name), Nil)),
                            fresh_name(name_prefix, idx2), idx2 + 1))
  # Bool equality: Bool is i64 in the IR (0 or 1), so `==` / `!=` lower
  # to the same `icmp eq i64` path as Int.  This covers `condition == false`
  # in stdlib/test.sprout (assert_false) and any user-written Bool == / !=.
  # Must appear before the Int-only guard below to avoid a false rejection.
  else if (op == "==" || op == "!=")
       && is_bool_type(typed_ast.typed_expr_type(left))
       && is_bool_type(typed_ast.typed_expr_type(right))
  then
    match translate_expr(left, params, ctors, idx, cur_label, cur_ops,
                         captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                         name_prefix) with
    | Err msg -> Err(msg)
    | Ok lr ->
        match lr with
        | (lblocks, lcur_lbl, lcur_ops, l_name, idx1) ->
            match translate_expr(right, params, ctors, idx1, lcur_lbl, lcur_ops,
                                 captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                                 name_prefix) with
            | Err msg -> Err(msg)
            | Ok rr ->
                match rr with
                | (rblocks, rcur_lbl, rcur_ops, r_name, idx2) ->
                    finish_binary(op, lblocks, rblocks, rcur_lbl, rcur_ops,
                                  l_name, r_name, idx2, false, name_prefix)
  else if ! ((is_int_or_char_type(typed_ast.typed_expr_type(left)) && is_int_or_char_type(typed_ast.typed_expr_type(right)))
             || (is_double_type(typed_ast.typed_expr_type(left)) && is_double_type(typed_ast.typed_expr_type(right))))
  then Err("ast_to_ir: binary op '" ++ op ++ "' requires Int or Double operands")
  else
    match translate_expr(left, params, ctors, idx, cur_label, cur_ops,
                         captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                         name_prefix) with
    | Err msg -> Err(msg)
    | Ok lr ->
        match lr with
        | (lblocks, lcur_lbl, lcur_ops, l_name, idx1) ->
            match translate_expr(right, params, ctors, idx1, lcur_lbl, lcur_ops,
                                 captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                                 name_prefix) with
            | Err msg -> Err(msg)
            | Ok rr ->
                match rr with
                | (rblocks, rcur_lbl, rcur_ops, r_name, idx2) ->
                    finish_binary(op, lblocks, rblocks, rcur_lbl, rcur_ops,
                                  l_name, r_name, idx2, is_double_type(typed_ast.typed_expr_type(left)), name_prefix)

fn finish_binary(op: String,
                 lblocks: List sprout_ir.IRBlock, rblocks: List sprout_ir.IRBlock,
                 cur_lbl: String, cur_ops: List sprout_ir.IROp,
                 l_name: String, r_name: String,
                 idx: Int, is_float: Bool, name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  if is_float then
    finish_binary_float(op, lblocks, rblocks, cur_lbl, cur_ops, l_name, r_name, idx, name_prefix)
  else if op == "/" then
    finish_checked_div(lblocks, rblocks, cur_lbl, cur_ops, l_name, r_name, idx, name_prefix)
  else
  match arith_op(op, result, l_name, r_name) with
  | Just iop ->
      Ok((list_append(lblocks, rblocks), cur_lbl,
           list_append(cur_ops, Cons(iop, Nil)),
           result, idx + 1))
  | Nothing ->
      match cmp_predicate(op) with
      | Just pred ->
          # /code-review-v2 fix #3: comparison op emits IRICmp (produces i1 by
          # LLVM semantics) followed by IRZextI1ToI64 to widen the result to
          # the i64-uniform Bool representation. Downstream consumers (phi,
          # ret, ctor arg, IRMakeCtor arg, IRCondBr after narrow) all see
          # i64. The "value" of the binary expression is the zext result.
          Ok((list_append(lblocks, rblocks), cur_lbl,
               list_append(cur_ops,
                 Cons(sprout_ir.IRICmp(result, pred, l_name, r_name),
                 Cons(sprout_ir.IRZextI1ToI64(zext_result, result), Nil))),
               zext_result, idx + 2))
      | Nothing -> Err("ast_to_ir: binary op '" ++ op ++ "' not yet supported")
  where result = fresh_name(name_prefix, idx)
        zext_result = fresh_name(name_prefix, idx + 1)

# Double binary ops.  fdiv-by-zero is IEEE defined (no guard needed, unlike
# IRIDiv).  Comparisons use ordered fcmp predicates and, like the Int path, zext
# the i1 result to the i64-uniform Bool.
fn finish_binary_float(op: String,
                       lblocks: List sprout_ir.IRBlock, rblocks: List sprout_ir.IRBlock,
                       cur_lbl: String, cur_ops: List sprout_ir.IROp,
                       l_name: String, r_name: String,
                       idx: Int, name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  match float_arith_op(op, result, l_name, r_name) with
  | Just fop ->
      Ok((list_append(lblocks, rblocks), cur_lbl,
           list_append(cur_ops, Cons(fop, Nil)),
           result, idx + 1))
  | Nothing ->
      match float_cmp_predicate(op) with
      | Just pred ->
          Ok((list_append(lblocks, rblocks), cur_lbl,
               list_append(cur_ops,
                 Cons(sprout_ir.IRFCmp(result, pred, l_name, r_name),
                 Cons(sprout_ir.IRZextI1ToI64(zext_result, result), Nil))),
               zext_result, idx + 2))
      | Nothing -> Err("ast_to_ir: float binary op '" ++ op ++ "' not yet supported")
  where result = fresh_name(name_prefix, idx)
        zext_result = fresh_name(name_prefix, idx + 1)

# Map a Double arith op to its float IR constructor (Nothing for comparisons).
fn float_arith_op(op: String, result: String, lhs: String, rhs: String) -> Maybe sprout_ir.IROp =
  if op == "+" then Just(sprout_ir.IRFAdd(result, lhs, rhs))
  else if op == "-" then Just(sprout_ir.IRFSub(result, lhs, rhs))
  else if op == "*" then Just(sprout_ir.IRFMul(result, lhs, rhs))
  else if op == "/" then Just(sprout_ir.IRFDiv(result, lhs, rhs))
  else Nothing

# Map a Double comparison op to its ordered fcmp predicate ("ordered" = false
# when either operand is NaN).
fn float_cmp_predicate(op: String) -> Maybe String =
  if op == "<" then Just("olt")
  else if op == "<=" then Just("ole")
  else if op == ">" then Just("ogt")
  else if op == ">=" then Just("oge")
  else if op == "==" then Just("oeq")
  else if op == "!=" then Just("one")
  else Nothing

# W7/F-DIV: `/` lowers to a guarded division. A bare `sdiv i64 _, 0` is LLVM
# undefined behavior, so the current block is sealed with a check `divisor == 0`
# that branches either to a panic block (build the message String, call @panic
# via IRPanic, then `unreachable`) or to a continuation block holding the sdiv.
# The continuation block becomes the new current block, so downstream phis name
# it as their predecessor (block/label threading stays consistent — the reason
# this cannot be done at the ir_lowering text layer). The INT_MIN / -1 overflow
# (the other undefined case) is covered by the total `safe_div`; guarding it here
# too is a follow-up. Consumes 4 fresh-name slots (icmp, msg-raw, msg, quotient).
fn finish_checked_div(lblocks: List sprout_ir.IRBlock, rblocks: List sprout_ir.IRBlock,
                      cur_lbl: String, cur_ops: List sprout_ir.IROp,
                      l_name: String, r_name: String,
                      idx: Int, name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  Ok((all_blocks, ok_lbl, Cons(div_op, Nil), div_result, idx + 4))
  where z_name = fresh_name(name_prefix, idx)
        msg_raw = fresh_name(name_prefix, idx + 1)
        msg_result = fresh_name(name_prefix, idx + 2)
        div_result = fresh_name(name_prefix, idx + 3)
        panic_lbl = "divpanic_" ++ int_to_string(idx)
        ok_lbl = "divok_" ++ int_to_string(idx)
        # Seal the current block: divisor == 0 ? panic : ok. IRICmp yields i1,
        # which IRCondBr consumes directly (no trunc needed).
        cond_block = sprout_ir.IRBlock(cur_lbl,
                       list_append(cur_ops,
                         [sprout_ir.IRICmp(z_name, "eq", r_name, "0"),
                          sprout_ir.IRCondBr(z_name, panic_lbl, ok_lbl)]))
        # Panic block: materialize the message String, then panic + unreachable.
        panic_block = sprout_ir.IRBlock(panic_lbl,
                        [sprout_ir.IRStrConst(msg_result, msg_raw, "division by zero"),
                         sprout_ir.IRPanic(msg_result)])
        # Continuation block: the sdiv runs here; it is the new current block.
        div_op = sprout_ir.IRIDiv(div_result, l_name, r_name)
        all_blocks = list_append(list_append(lblocks, rblocks),
                       [cond_block, panic_block])

# Map a TBinary op String to the matching arithmetic IR constructor.
# Returns Nothing for non-arith ops; the caller falls back to cmp_predicate.
fn arith_op(op: String, result: String, lhs: String, rhs: String) -> Maybe sprout_ir.IROp =
  if op == "+" then Just(sprout_ir.IRIAdd(result, lhs, rhs))
  else if op == "-" then Just(sprout_ir.IRISub(result, lhs, rhs))
  else if op == "*" then Just(sprout_ir.IRIMul(result, lhs, rhs))
  else if op == "/" then Just(sprout_ir.IRIDiv(result, lhs, rhs))
  else Nothing

# Translate an if-then-else.
#
# Block layout produced (per if-expression):
#   <cur_label>:                      ← sealed with IRCondBr
#     ... cur_ops ...
#     %cN = icmp/...   <cond>
#     br i1 %cN, label %then_K, label %else_K
#   then_K:                           ← may itself contain nested if-blocks
#     ... then-branch ops ...
#     br label %join_K
#   else_K:
#     ... else-branch ops ...
#     br label %join_K
#   join_K:                           ← becomes the new cur_label
#     %rN = phi <ty> [<v_then>, %<then-final-lbl>], [<v_else>, %<else-final-lbl>]
#
# Crucially the incoming labels of the phi are NOT necessarily "then_K" /
# "else_K" — if a branch itself contained nested ifs, the value was
# produced in the inner join block.  We capture each branch's final
# cur_label after sub-translation and use it for the phi.
#
# K is allocated by consuming one fresh-name slot for each of then/else/join.
fn translate_if(cond: typed_ast.TypedExpr, t: typed_ast.TypedExpr, e: typed_ast.TypedExpr,
                if_ty: types.Type, params: List String, ctors: Dict sprout_ir.CtorInfo,
                idx: Int,
                cur_label: String, cur_ops: List sprout_ir.IROp,
                captures: Dict String,
                lifted_ref: Ref (List sprout_ir.IRFunction),
                top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                lambda_ctr_ref: Ref Int,
                lifted_idx_ref: Ref (Dict Int),
                name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match translate_expr(cond, params, ctors, idx, cur_label, cur_ops,
                       captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                       name_prefix) with
  | Err msg -> Err(msg)
  | Ok cr ->
      match cr with
      | (cblocks, ccur_lbl, ccur_ops, c_name, idx1) ->
          translate_if_after_cond(t, e, if_ty, params, ctors,
                                  cblocks, ccur_lbl, ccur_ops, c_name, idx1,
                                  captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                                  name_prefix)

fn translate_if_after_cond(t: typed_ast.TypedExpr, e: typed_ast.TypedExpr,
                           if_ty: types.Type, params: List String,
                           ctors: Dict sprout_ir.CtorInfo,
                           cblocks: List sprout_ir.IRBlock,
                           ccur_lbl: String, ccur_ops: List sprout_ir.IROp,
                           c_name: String, idx: Int,
                           captures: Dict String,
                           lifted_ref: Ref (List sprout_ir.IRFunction),
                           top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                           lambda_ctr_ref: Ref Int,
                           lifted_idx_ref: Ref (Dict Int),
                           name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  # Allocate one fresh id `idx` shared by then_<idx> / else_<idx> / join_<idx>
  # — they live in disjoint label namespaces so uniqueness is preserved.
  # Then consume idx+1 for the phi result-name.  Sub-translation continues
  # from idx+2.
  match translate_expr(t, params, ctors, idx + 2, then_lbl, Nil,
                       captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                       name_prefix) with
  | Err msg -> Err(msg)
  | Ok tr ->
      match tr with
      | (tblocks, tcur_lbl, tcur_ops, t_name, idx2) ->
          match translate_expr(e, params, ctors, idx2, else_lbl, Nil,
                               captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                               name_prefix) with
          | Err msg -> Err(msg)
          | Ok er ->
              match er with
              | (eblocks, ecur_lbl, ecur_ops, e_name, idx3) ->
                  finish_if(if_ty, cblocks, ccur_lbl, ccur_ops, c_name,
                            then_lbl, tblocks, tcur_lbl, tcur_ops, t_name,
                            else_lbl, eblocks, ecur_lbl, ecur_ops, e_name,
                            join_lbl, phi_name, idx3, name_prefix)
  where then_lbl = fresh_then_label(idx)
        else_lbl = fresh_else_label(idx)
        join_lbl = fresh_join_label(idx)
        phi_name = fresh_name(name_prefix, idx + 1)

fn finish_if(if_ty: types.Type,
             cblocks: List sprout_ir.IRBlock,
             ccur_lbl: String, ccur_ops: List sprout_ir.IROp, c_name: String,
             then_lbl: String, tblocks: List sprout_ir.IRBlock,
             tcur_lbl: String, tcur_ops: List sprout_ir.IROp, t_name: String,
             else_lbl: String, eblocks: List sprout_ir.IRBlock,
             ecur_lbl: String, ecur_ops: List sprout_ir.IROp, e_name: String,
             join_lbl: String, phi_name: String, idx: Int,
             name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  Ok((all_blocks, join_lbl, Cons(phi_op, Nil), phi_name, idx + 1))
  where phi_ty = llvm_ret_type(if_ty)
        phi_op = sprout_ir.IRPhi(phi_name, phi_ty,
                                 Cons((t_name, tcur_lbl),
                                 Cons((e_name, ecur_lbl), Nil)))
        # /code-review-v2 fix #3: narrow the i64-Bool cond to i1 before IRCondBr.
        # Every cond source (comparison + IRZext, TBool IRConst, Bool param/call)
        # produces i64 post fix #2 + fix #3; LLVM's `br i1` requires i1.
        cond_i1_name = fresh_name(name_prefix, idx)
        # Seal the entry/condition block with IRTrunc + IRCondBr.
        cond_block = sprout_ir.IRBlock(ccur_lbl,
                       list_append(ccur_ops,
                         Cons(sprout_ir.IRTruncI64ToI1(cond_i1_name, c_name),
                         Cons(sprout_ir.IRCondBr(cond_i1_name, then_lbl, else_lbl), Nil))))
        # Seal the then-branch's final block with IRBr → join.
        then_final = sprout_ir.IRBlock(tcur_lbl,
                       list_append(tcur_ops, Cons(sprout_ir.IRBr(join_lbl), Nil)))
        # Seal the else-branch's final block with IRBr → join.
        else_final = sprout_ir.IRBlock(ecur_lbl,
                       list_append(ecur_ops, Cons(sprout_ir.IRBr(join_lbl), Nil)))
        # Order: cond-blocks (already-completed inner blocks of cond) then
        # this-if's cond block, then-blocks (inner) then this then_final,
        # else-blocks (inner) then this else_final.  Join is the new cur,
        # not in the completed list — translate_body / outer if will seal it.
        all_blocks = list_append(cblocks,
                       Cons(cond_block,
                       list_append(tblocks,
                         Cons(then_final,
                         list_append(eblocks, Cons(else_final, Nil))))))

# ---------------------------------------------------------------------------
# translate_match — PR 2.5
# ---------------------------------------------------------------------------
#
# Block layout for `match scrut with | P0 -> B0 | P1 -> B1 | ...`:
#
#   <scrut_cur_lbl>:          ← sealed with IRBr → arm_0_K (or body_0_K if always-match)
#     ... cur_ops ...
#     %s  = <scrutinee>
#     [%tag = call @sprout_tag(%s)]   ← only when a ConstructorPattern arm exists
#     br label %arm_0_K
#   arm_0_K:                  ← test block (skipped for Wildcard/Var)
#     %const_i = ...
#     %cmp_i   = icmp ...
#     br i1 %cmp_i, label %body_0_K, label %arm_1_K
#   body_0_K:
#     [IRGetField binds...]
#     ... body ops ...
#     br label %join_K
#   arm_1_K / body_1_K: ...
#   arm_N_K (miss-all):
#     %d = call @sprout_abort_match()
#     unreachable
#   join_K:
#     %phi_K = phi <ty> [val0, body_0_cur_lbl], [val1, body_1_cur_lbl], ...
#
# K = base_idx (allocated once per match expression; shared across arm_i/body_i
#     label namespaces, which are disjoint from %tN SSA names).
#
# idx threading: each arm body is translated with the then-current idx; the
# body's next_idx is threaded forward.  Branch number i is baked into label
# names so arms allocated at the same base_idx cannot collide.

# True iff any arm's pattern is a ConstructorPattern.
# Used to decide whether to emit IRGetTag before the first arm test.
fn has_ctor_pattern_arm(arms: List typed_ast.TypedMatchBranch) -> Bool =
  match arms with
  | Nil -> false
  | Cons arm rest ->
      match arm with
      | typed_ast.TypedMatchBranch pat _ ->
          match pat with
          | ast.ConstructorPattern _ _ _ -> true
          | _ -> has_ctor_pattern_arm(rest)

# True if a ConstructorPattern arm matches a `wrap` ctor (tag sentinel -1,
# mirrors codegen.sprout wrap_tag()).  Wrap values are UNBOXED (the raw
# payload), so the match must NOT hoist IRGetTag — sprout_tag on a raw Int
# derefs it as a pointer and segfaults.  The downstream arm dispatch already
# binds the wrap field by identity, so skipping the tag hoist suffices.  A wrap
# type has exactly one ctor, so the first ctor-pattern arm is decisive; the
# discriminator is strictly tag == -1 (a normal single-field ADT is boxed and
# genuinely needs the tag).
fn is_wrap_match(arms: List typed_ast.TypedMatchBranch,
                 ctors: Dict sprout_ir.CtorInfo) -> Bool =
  match arms with
  | Nil -> false
  | Cons arm rest ->
      match arm with
      | typed_ast.TypedMatchBranch pat _ ->
          match pat with
          | ast.ConstructorPattern name _ _ ->
              match dict_get(name, ctors) with
              | Just entry ->
                  match entry with
                  | sprout_ir.CtorInfo tag _ _ _ _ -> tag == -1
              | Nothing -> is_wrap_match(rest, ctors)
          | _ -> is_wrap_match(rest, ctors)

# field_kind_char_to_irtype and fk_at moved to stdlib.compiler.field_kinds
# (/code-review fix #10). Call sites below use fk.field_kind_char_to_irtype /
# fk.fk_at.

# Emit binding ops for each pattern arg of a ConstructorPattern.
# Handles VarPattern (IRGetField bind), WildcardPattern (skip), nested
# ConstructorPattern (tag test + new block), and nested TuplePattern (field
# fetch + recursive tuple binding — no block break since tuples always match).
# Literal patterns (Int/Bool/String/Char/Unit) as nested sub-patterns are
# not supported in this PR and yield a clear Err naming the pattern type.
#
# Parameters:
#   args         — remaining ctor arg patterns to process
#   scrut_name   — SSA name of the current constructor value being matched
#   fks          — field-kind string for scrut_name's constructor (one byte per arg)
#   idx          — next available SSA/label index
#   field_idx    — 0-based field index into fks (and IRGetField)
#   name_prefix  — SSA name prefix
#   cur_ops      — REVERSED ops accumulated for the current open block
#   acc_captures — captures dict extended by bound variables so far
#   cur_lbl      — label of the current OPEN block being built
#   miss_lbl     — label to jump to on a nested ctor tag mismatch
#   ctors        — constructor registry (needed to look up nested ctor tags/fks)
#   acc_extra    — REVERSED list of already-sealed intermediate IRBlocks
#
# Returns Ok((extra_blocks_src_order, final_lbl, preamble_ops_src_order, captures, idx))
# O(n) where n = total number of pattern nodes in the arg list (recursively).
fn bind_ctor_field_args(args: List ast.Pattern, scrut_name: String,
                        fks: String, idx: Int, field_idx: Int,
                        name_prefix: String, cur_ops: List sprout_ir.IROp,
                        acc_captures: Dict String,
                        cur_lbl: String, miss_lbl: String,
                        ctors: Dict sprout_ir.CtorInfo,
                        acc_extra: List sprout_ir.IRBlock) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, Dict String, Int) =
  match args with
  | Nil -> Ok((list_reverse(acc_extra), cur_lbl, list_reverse(cur_ops), acc_captures, idx))
  | Cons pat rest_args ->
      # /code-review fix #14: bounds check for field_idx vs fks length.
      if field_idx >= str_len(fks) then
        Err("ast_to_ir: internal compiler bug: bind_ctor_field_args field_idx=" ++
            int_to_string(field_idx) ++ " exceeds fks length " ++
            int_to_string(str_len(fks)) ++ " (expected one byte per ctor arg)")
      else
        match pat with
        | ast.WildcardPattern _ ->
            bind_ctor_field_args(rest_args, scrut_name, fks, idx, field_idx + 1,
                                 name_prefix, cur_ops, acc_captures,
                                 cur_lbl, miss_lbl, ctors, acc_extra)
        | ast.VarPattern v _ ->
            bind_ctor_field_args(rest_args, scrut_name, fks, idx + 1, field_idx + 1,
                                 name_prefix,
                                 Cons(sprout_ir.IRGetField(fresh_name(name_prefix, idx),
                                                           scrut_name, field_idx,
                                                           fk.fk_at(fks, field_idx)),
                                      cur_ops),
                                 dict_set(v, fresh_name(name_prefix, idx), acc_captures),
                                 cur_lbl, miss_lbl, ctors, acc_extra)
        | ast.ConstructorPattern nested_ctor nested_args _ ->
            # Fetch the field holding the nested constructor value; seal cur_lbl
            # with a tag test and branch, then recurse into nested sub-args followed
            # by the remaining outer args.
            match dict_get(nested_ctor, ctors) with
            | Nothing -> Err("ast_to_ir: unknown constructor '" ++ nested_ctor ++ "' in nested pattern")
            | Just nested_entry ->
                match nested_entry with
                | sprout_ir.CtorInfo nested_tag _na _nm nested_fks _ ->
                    match fresh_name(name_prefix, idx) with
                    | field_ssa ->
                        match fresh_name(name_prefix, idx + 1) with
                        | tag_ssa ->
                            match fresh_name(name_prefix, idx + 2) with
                            | c_ssa ->
                                match fresh_name(name_prefix, idx + 3) with
                                | cmp_ssa ->
                                    match fresh_nested_test_label(idx) with
                                    | inner_lbl ->
                                        match list_append(
                                          list_reverse(cur_ops),
                                          Cons(sprout_ir.IRGetField(field_ssa, scrut_name, field_idx,
                                                                     fk.fk_at(fks, field_idx)),
                                          Cons(sprout_ir.IRGetTag(tag_ssa, field_ssa),
                                          Cons(sprout_ir.IRConst(c_ssa, nested_tag),
                                          Cons(sprout_ir.IRICmp(cmp_ssa, "eq", tag_ssa, c_ssa),
                                          Cons(sprout_ir.IRCondBr(cmp_ssa, inner_lbl, miss_lbl),
                                          Nil)))))) with
                                        | sealed_ops ->
                                            match bind_ctor_field_args(nested_args, field_ssa, nested_fks,
                                                                        idx + 4, 0, name_prefix, Nil,
                                                                        acc_captures, inner_lbl, miss_lbl, ctors,
                                                                        Cons(sprout_ir.IRBlock(cur_lbl, sealed_ops), acc_extra)) with
                                            | Err msg -> Err(msg)
                                            | Ok sub_result ->
                                                match sub_result with
                                                | (extra2, cont_lbl, cont_ops_src, captures2, idx2) ->
                                                    # cont_ops_src is in source order (from the Nil base).
                                                    # Re-reverse to restore reversed-accumulator form for
                                                    # the remaining outer-arg recursion.
                                                    bind_ctor_field_args(rest_args, scrut_name, fks,
                                                                         idx2, field_idx + 1, name_prefix,
                                                                         list_reverse(cont_ops_src), captures2,
                                                                         cont_lbl, miss_lbl, ctors,
                                                                         list_reverse(extra2))
        | ast.TuplePattern tuple_items _ ->
            # Fetch the field holding the nested tuple value (no tag test — tuples always match).
            # Emit IRGetField for the slot, then recurse into the tuple items.
            match fresh_name(name_prefix, idx) with
            | field_ssa ->
                match bind_tuple_items(tuple_items, field_ssa, idx + 1, 0, name_prefix,
                                       Cons(sprout_ir.IRGetField(field_ssa, scrut_name, field_idx,
                                                                  fk.fk_at(fks, field_idx)), cur_ops),
                                       acc_captures, cur_lbl, miss_lbl, ctors, acc_extra) with
                | Err msg -> Err(msg)
                | Ok sub_result ->
                    match sub_result with
                    | (extra2, cont_lbl, cont_ops_src, captures2, idx2) ->
                        bind_ctor_field_args(rest_args, scrut_name, fks,
                                            idx2, field_idx + 1, name_prefix,
                                            list_reverse(cont_ops_src), captures2,
                                            cont_lbl, miss_lbl, ctors,
                                            list_reverse(extra2))
        | ast.IntPattern n _ ->
            # Fetch the constructor field; seal cur_lbl with an integer equality test;
            # open inner_lbl and continue binding remaining args.
            # Fresh name slots:
            #   idx   = field SSA (IRGetField)
            #   idx+1 = IRConst i64 literal value
            #   idx+2 = IRICmp i1 result (used directly in IRCondBr)
            match fresh_name(name_prefix, idx) with
            | field_ssa ->
                match fresh_nested_test_label(idx) with
                | inner_lbl ->
                    match list_append(
                      list_reverse(cur_ops),
                      Cons(sprout_ir.IRGetField(field_ssa, scrut_name, field_idx,
                                                fk.fk_at(fks, field_idx)),
                      Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx + 1), n),
                      Cons(sprout_ir.IRICmp(fresh_name(name_prefix, idx + 2), "eq",
                                            field_ssa,
                                            fresh_name(name_prefix, idx + 1)),
                      Cons(sprout_ir.IRCondBr(fresh_name(name_prefix, idx + 2),
                                              inner_lbl, miss_lbl),
                      Nil))))) with
                    | sealed_ops ->
                        bind_ctor_field_args(rest_args, scrut_name, fks,
                                             idx + 3, field_idx + 1, name_prefix, Nil,
                                             acc_captures, inner_lbl, miss_lbl, ctors,
                                             Cons(sprout_ir.IRBlock(cur_lbl, sealed_ops),
                                                  acc_extra))
        | ast.BoolPattern b _ ->
            # Fetch the constructor field; seal cur_lbl with a Bool equality test.
            # Bool fields flow as i64 (0 = false, 1 = true) per the zext convention.
            # Fresh name slots:
            #   idx   = field SSA (IRGetField)
            #   idx+1 = IRConst i64 0 or 1 (the bool literal)
            #   idx+2 = IRICmp i1 result (used directly in IRCondBr)
            match fresh_name(name_prefix, idx) with
            | field_ssa ->
                match fresh_nested_test_label(idx) with
                | inner_lbl ->
                    match list_append(
                      list_reverse(cur_ops),
                      Cons(sprout_ir.IRGetField(field_ssa, scrut_name, field_idx,
                                                fk.fk_at(fks, field_idx)),
                      Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx + 1),
                                             if b then 1 else 0),
                      Cons(sprout_ir.IRICmp(fresh_name(name_prefix, idx + 2), "eq",
                                            field_ssa,
                                            fresh_name(name_prefix, idx + 1)),
                      Cons(sprout_ir.IRCondBr(fresh_name(name_prefix, idx + 2),
                                              inner_lbl, miss_lbl),
                      Nil))))) with
                    | sealed_ops ->
                        bind_ctor_field_args(rest_args, scrut_name, fks,
                                             idx + 3, field_idx + 1, name_prefix, Nil,
                                             acc_captures, inner_lbl, miss_lbl, ctors,
                                             Cons(sprout_ir.IRBlock(cur_lbl, sealed_ops),
                                                  acc_extra))
        | ast.StringPattern s _ ->
            # Fetch the constructor field; seal cur_lbl with a string equality test;
            # open inner_lbl and continue binding remaining args.
            # Fresh name slots:
            #   idx   = field SSA (IRGetField)
            #   idx+1 = raw GEP ptr (IRStrConst raw name)
            #   idx+2 = i64 ptrtoint result (IRStrConst result)
            #   idx+3 = IRStrEq i64 Bool result
            #   idx+4 = IRConst 1
            #   idx+5 = IRICmp i1 result (used in IRCondBr)
            match fresh_name(name_prefix, idx) with
            | field_ssa ->
                match fresh_nested_test_label(idx) with
                | inner_lbl ->
                    match list_append(
                      list_reverse(cur_ops),
                      Cons(sprout_ir.IRGetField(field_ssa, scrut_name, field_idx,
                                                fk.fk_at(fks, field_idx)),
                      Cons(sprout_ir.IRStrConst(fresh_name(name_prefix, idx + 2),
                                                fresh_name(name_prefix, idx + 1), s),
                      Cons(sprout_ir.IRStrEq(fresh_name(name_prefix, idx + 3),
                                             field_ssa,
                                             fresh_name(name_prefix, idx + 2)),
                      Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx + 4), 1),
                      Cons(sprout_ir.IRICmp(fresh_name(name_prefix, idx + 5), "eq",
                                            fresh_name(name_prefix, idx + 3),
                                            fresh_name(name_prefix, idx + 4)),
                      Cons(sprout_ir.IRCondBr(fresh_name(name_prefix, idx + 5),
                                              inner_lbl, miss_lbl),
                      Nil))))))) with
                    | sealed_ops ->
                        bind_ctor_field_args(rest_args, scrut_name, fks,
                                             idx + 6, field_idx + 1, name_prefix, Nil,
                                             acc_captures, inner_lbl, miss_lbl, ctors,
                                             Cons(sprout_ir.IRBlock(cur_lbl, sealed_ops),
                                                  acc_extra))
        | ast.CharPattern _ _ ->
            Err("ast_to_ir: nested CharPattern in constructor match not yet supported")
        | ast.UnitPattern _ ->
            Err("ast_to_ir: nested UnitPattern in constructor match not yet supported")

# Bind the single inner pattern arg of a wrap-ctor match arm to the scrutinee SSA.
# Wrap types are zero-cost: the scrutinee IS the inner value, so no IRGetField is needed.
# Mirrors codegen.sprout emit_pattern_bind wrap branch (line 1253):
#   "Wrap destructuring is identity: the scrut value IS the inner value."
# Supports VarPattern (add var → s_name to captures) and WildcardPattern (no-op).
# Any other pattern inside a wrap is rejected — they are not needed in practice and
# would require recursive tag/field ops that this function deliberately avoids.
fn bind_wrap_inner_arg(args: List ast.Pattern, s_name: String, captures: Dict String) ->
    Result String (Dict String) =
  match args with
  | [ast.VarPattern v _] -> Ok(dict_set(v, s_name, captures))
  | [ast.WildcardPattern _] -> Ok(captures)
  | _ -> Err("ast_to_ir: wrap pattern must have exactly one inner arg (VarPattern or WildcardPattern)")

# Emit binding ops for each pattern item of a TuplePattern.
# Handles VarPattern (IRGetTupleField bind), WildcardPattern (skip), nested
# TuplePattern (tuple fetch + recursive binding), and nested ConstructorPattern
# (tag test + new block). Literal patterns yield a clear Err.
#
# Same accumulator contract as bind_ctor_field_args: cur_ops and acc_extra
# are REVERSED; base case reverses both before returning.
# O(n) where n = total pattern nodes in the item list (recursively).
fn bind_tuple_items(items: List ast.Pattern, scrut_name: String,
                    idx: Int, field_idx: Int,
                    name_prefix: String, cur_ops: List sprout_ir.IROp,
                    acc_captures: Dict String,
                    cur_lbl: String, miss_lbl: String,
                    ctors: Dict sprout_ir.CtorInfo,
                    acc_extra: List sprout_ir.IRBlock) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, Dict String, Int) =
  match items with
  | Nil -> Ok((list_reverse(acc_extra), cur_lbl, list_reverse(cur_ops), acc_captures, idx))
  | Cons pat rest_items ->
      match pat with
      | ast.WildcardPattern _ ->
          bind_tuple_items(rest_items, scrut_name, idx, field_idx + 1,
                           name_prefix, cur_ops, acc_captures,
                           cur_lbl, miss_lbl, ctors, acc_extra)
      | ast.VarPattern v _ ->
          bind_tuple_items(rest_items, scrut_name, idx + 1, field_idx + 1,
                           name_prefix,
                           Cons(sprout_ir.IRGetTupleField(fresh_name(name_prefix, idx),
                                                          scrut_name, field_idx, sprout_ir.IRTUnknown),
                                cur_ops),
                           dict_set(v, fresh_name(name_prefix, idx), acc_captures),
                           cur_lbl, miss_lbl, ctors, acc_extra)
      | ast.TuplePattern inner_items _ ->
          # Fetch the tuple element holding the inner tuple, then recurse into its items.
          match fresh_name(name_prefix, idx) with
          | field_ssa ->
              match bind_tuple_items(inner_items, field_ssa, idx + 1, 0, name_prefix,
                                     Cons(sprout_ir.IRGetTupleField(field_ssa, scrut_name, field_idx, sprout_ir.IRTUnknown),
                                          cur_ops),
                                     acc_captures, cur_lbl, miss_lbl, ctors, acc_extra) with
              | Err msg -> Err(msg)
              | Ok sub_result ->
                  match sub_result with
                  | (extra2, cont_lbl, cont_ops_src, captures2, idx2) ->
                      bind_tuple_items(rest_items, scrut_name, idx2, field_idx + 1,
                                       name_prefix, list_reverse(cont_ops_src), captures2,
                                       cont_lbl, miss_lbl, ctors, list_reverse(extra2))
      | ast.ConstructorPattern nested_ctor nested_args _ ->
          # Fetch the tuple element holding the nested ctor; seal cur_lbl with a tag
          # test and branch; recurse into nested sub-args followed by rest_items.
          match dict_get(nested_ctor, ctors) with
          | Nothing -> Err("ast_to_ir: unknown constructor '" ++ nested_ctor ++ "' in nested tuple pattern")
          | Just nested_entry ->
              match nested_entry with
              | sprout_ir.CtorInfo nested_tag _na _nm nested_fks _ ->
                  match fresh_name(name_prefix, idx) with
                  | field_ssa ->
                      match fresh_name(name_prefix, idx + 1) with
                      | tag_ssa ->
                          match fresh_name(name_prefix, idx + 2) with
                          | c_ssa ->
                              match fresh_name(name_prefix, idx + 3) with
                              | cmp_ssa ->
                                  match fresh_nested_test_label(idx) with
                                  | inner_lbl ->
                                      match list_append(
                                        list_reverse(cur_ops),
                                        Cons(sprout_ir.IRGetTupleField(field_ssa, scrut_name, field_idx, sprout_ir.IRTUnknown),
                                        Cons(sprout_ir.IRGetTag(tag_ssa, field_ssa),
                                        Cons(sprout_ir.IRConst(c_ssa, nested_tag),
                                        Cons(sprout_ir.IRICmp(cmp_ssa, "eq", tag_ssa, c_ssa),
                                        Cons(sprout_ir.IRCondBr(cmp_ssa, inner_lbl, miss_lbl),
                                        Nil)))))) with
                                      | sealed_ops ->
                                          match bind_ctor_field_args(nested_args, field_ssa, nested_fks,
                                                                      idx + 4, 0, name_prefix, Nil,
                                                                      acc_captures, inner_lbl, miss_lbl, ctors,
                                                                      Cons(sprout_ir.IRBlock(cur_lbl, sealed_ops),
                                                                           acc_extra)) with
                                          | Err msg -> Err(msg)
                                          | Ok sub_result ->
                                              match sub_result with
                                              | (extra2, cont_lbl, cont_ops_src, captures2, idx2) ->
                                                  bind_tuple_items(rest_items, scrut_name, idx2, field_idx + 1,
                                                                   name_prefix, list_reverse(cont_ops_src),
                                                                   captures2, cont_lbl, miss_lbl, ctors,
                                                                   list_reverse(extra2))
      | ast.IntPattern n _ ->
          # Fetch the tuple element; seal cur_lbl with an integer equality test;
          # open inner_lbl and continue binding remaining tuple items.
          # Fresh name slots:
          #   idx   = field SSA (IRGetTupleField)
          #   idx+1 = IRConst i64 literal value
          #   idx+2 = IRICmp i1 result (used directly in IRCondBr)
          match fresh_name(name_prefix, idx) with
          | field_ssa ->
              match fresh_nested_test_label(idx) with
              | inner_lbl ->
                  match list_append(
                    list_reverse(cur_ops),
                    Cons(sprout_ir.IRGetTupleField(field_ssa, scrut_name, field_idx, sprout_ir.IRTScalar),
                    Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx + 1), n),
                    Cons(sprout_ir.IRICmp(fresh_name(name_prefix, idx + 2), "eq",
                                          field_ssa,
                                          fresh_name(name_prefix, idx + 1)),
                    Cons(sprout_ir.IRCondBr(fresh_name(name_prefix, idx + 2),
                                            inner_lbl, miss_lbl),
                    Nil))))) with
                  | sealed_ops ->
                      bind_tuple_items(rest_items, scrut_name, idx + 3, field_idx + 1,
                                       name_prefix, Nil, acc_captures,
                                       inner_lbl, miss_lbl, ctors,
                                       Cons(sprout_ir.IRBlock(cur_lbl, sealed_ops),
                                            acc_extra))
      | ast.BoolPattern b _ ->
          # Fetch the tuple element; seal cur_lbl with a Bool equality test.
          # Bool values flow as i64 (0 = false, 1 = true) throughout.
          # Fresh name slots:
          #   idx   = field SSA (IRGetTupleField)
          #   idx+1 = IRConst i64 0 or 1 (the bool literal)
          #   idx+2 = IRICmp i1 result (used directly in IRCondBr)
          match fresh_name(name_prefix, idx) with
          | field_ssa ->
              match fresh_nested_test_label(idx) with
              | inner_lbl ->
                  match list_append(
                    list_reverse(cur_ops),
                    Cons(sprout_ir.IRGetTupleField(field_ssa, scrut_name, field_idx, sprout_ir.IRTScalar),
                    Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx + 1),
                                           if b then 1 else 0),
                    Cons(sprout_ir.IRICmp(fresh_name(name_prefix, idx + 2), "eq",
                                          field_ssa,
                                          fresh_name(name_prefix, idx + 1)),
                    Cons(sprout_ir.IRCondBr(fresh_name(name_prefix, idx + 2),
                                            inner_lbl, miss_lbl),
                    Nil))))) with
                  | sealed_ops ->
                      bind_tuple_items(rest_items, scrut_name, idx + 3, field_idx + 1,
                                       name_prefix, Nil, acc_captures,
                                       inner_lbl, miss_lbl, ctors,
                                       Cons(sprout_ir.IRBlock(cur_lbl, sealed_ops),
                                            acc_extra))
      | ast.StringPattern s _ ->
          # Fetch the tuple field; seal cur_lbl with a string equality test;
          # open inner_lbl and continue binding remaining tuple items.
          # Fresh name slots:
          #   idx   = field SSA (IRGetTupleField)
          #   idx+1 = raw GEP ptr (IRStrConst raw name)
          #   idx+2 = i64 ptrtoint result (IRStrConst result)
          #   idx+3 = IRStrEq i64 Bool result
          #   idx+4 = IRConst 1
          #   idx+5 = IRICmp i1 result (used in IRCondBr)
          match fresh_name(name_prefix, idx) with
          | field_ssa ->
              match fresh_nested_test_label(idx) with
              | inner_lbl ->
                  match list_append(
                    list_reverse(cur_ops),
                    Cons(sprout_ir.IRGetTupleField(field_ssa, scrut_name, field_idx, sprout_ir.IRTUnknown),
                    Cons(sprout_ir.IRStrConst(fresh_name(name_prefix, idx + 2),
                                              fresh_name(name_prefix, idx + 1), s),
                    Cons(sprout_ir.IRStrEq(fresh_name(name_prefix, idx + 3),
                                           field_ssa,
                                           fresh_name(name_prefix, idx + 2)),
                    Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx + 4), 1),
                    Cons(sprout_ir.IRICmp(fresh_name(name_prefix, idx + 5), "eq",
                                          fresh_name(name_prefix, idx + 3),
                                          fresh_name(name_prefix, idx + 4)),
                    Cons(sprout_ir.IRCondBr(fresh_name(name_prefix, idx + 5),
                                            inner_lbl, miss_lbl),
                    Nil))))))) with
                  | sealed_ops ->
                      bind_tuple_items(rest_items, scrut_name, idx + 6, field_idx + 1,
                                       name_prefix, Nil, acc_captures,
                                       inner_lbl, miss_lbl, ctors,
                                       Cons(sprout_ir.IRBlock(cur_lbl, sealed_ops),
                                            acc_extra))
      | ast.CharPattern _ _ ->
          Err("ast_to_ir: nested CharPattern in tuple match not yet supported")
      | ast.UnitPattern _ ->
          Err("ast_to_ir: nested UnitPattern in tuple match not yet supported")

# Like translate_match_arm_body_always but with field-binding preamble_ops
# injected into the body block's initial ops.
# Tuples always match (no tag check), so dispatch_lbl IS the chain entry.
# When nested ConstructorPatterns inside tuple items generate extra intermediate
# blocks (tag tests), those are passed as extra_blocks (source order) and the
# actual body entry is real_body_lbl (the continuation label after all tests).
# rest_arms are structurally dead for always-match arms but translated to keep
# phi numbering stable.
fn translate_match_arm_body_always_with_ops(body: typed_ast.TypedExpr,
                                            rest_arms: List typed_ast.TypedMatchBranch,
                                            branch_idx: Int, base_idx: Int,
                                            real_body_lbl: String, join_lbl: String,
                                            match_ty: types.Type,
                                            s_name: String, tag_name: String,
                                            preamble_ops: List sprout_ir.IROp,
                                            extra_blocks: List sprout_ir.IRBlock,
                                            params: List String,
                                            ctors: Dict sprout_ir.CtorInfo, idx: Int,
                                            acc_blocks: List sprout_ir.IRBlock,
                                            acc_phi: List (String, String),
                                            captures: Dict String,
                                            outer_captures: Dict String,
                                            lifted_ref: Ref (List sprout_ir.IRFunction),
                                            top_level: Set,
                                            let_names: Set,
                                            fn_arities: Dict FnInfo,
                                            lambda_ctr_ref: Ref Int,
                                            lifted_idx_ref: Ref (Dict Int),
                                            name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, List (String, String), Int) !{IO} =
  match translate_expr(body, params, ctors, idx, real_body_lbl, preamble_ops,
                       captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                       name_prefix) with
  | Err msg -> Err(msg)
  | Ok br ->
      match br with
      | (body_blocks, body_cur_lbl, body_cur_ops, body_val, idx1) ->
          translate_match_arms(rest_arms, branch_idx + 1, base_idx,
                               join_lbl, match_ty, s_name, tag_name,
                               params, ctors, idx1,
                               Cons(sprout_ir.IRBlock(body_cur_lbl,
                                      list_append(body_cur_ops,
                                        Cons(sprout_ir.IRBr(join_lbl), Nil))),
                                    list_append(list_reverse(body_blocks),
                                                list_append(list_reverse(extra_blocks),
                                                            acc_blocks))),
                               Cons((body_val, body_cur_lbl), acc_phi),
                               outer_captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                               lifted_idx_ref, name_prefix)

# Translate a TuplePattern match arm.
# Tuples always match (no tag check). Emits IRGetTupleField binds for each
# VarPattern item; WildcardPattern items are skipped. After binding, delegates
# to translate_match_arm_body_always_with_ops which recurses into rest_arms
# via dispatch_lbl (= body_lbl) so phi numbering stays consistent with all
# other arm translators.
fn translate_match_arm_tuple(tuple_items: List ast.Pattern,
                              body: typed_ast.TypedExpr,
                              rest_arms: List typed_ast.TypedMatchBranch,
                              branch_idx: Int, base_idx: Int,
                              dispatch_lbl: String, join_lbl: String,
                              match_ty: types.Type, s_name: String, tag_name: String,
                              params: List String, ctors: Dict sprout_ir.CtorInfo,
                              idx: Int,
                              acc_blocks: List sprout_ir.IRBlock,
                              acc_phi: List (String, String),
                              captures: Dict String,
                              lifted_ref: Ref (List sprout_ir.IRFunction),
                              top_level: Set,
                              let_names: Set,
                              fn_arities: Dict FnInfo,
                              lambda_ctr_ref: Ref Int,
                              lifted_idx_ref: Ref (Dict Int),
                              name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, List (String, String), Int) !{IO} =
  # miss_lbl: where to branch when a nested ConstructorPattern tag test fails.
  # For a TuplePattern arm (always-match), a nested ctor failure falls through to
  # the next arm — use the next arm's dispatch label as the miss target.
  match fresh_arm_label(branch_idx + 1, base_idx) with
  | miss_lbl ->
      match bind_tuple_items(tuple_items, s_name, idx, 0, name_prefix, Nil, captures,
                             dispatch_lbl, miss_lbl, ctors, Nil) with
      | Err msg -> Err(msg)
      | Ok bound ->
          match bound with
          | (extra_blocks, real_body_lbl, field_ops, arm_captures, idx2) ->
              translate_match_arm_body_always_with_ops(body, rest_arms,
                branch_idx, base_idx, real_body_lbl, join_lbl,
                match_ty, s_name, tag_name,
                field_ops, extra_blocks, params, ctors, idx2,
                acc_blocks, acc_phi,
                arm_captures, captures,
                lifted_ref, top_level, let_names, fn_arities,
                lambda_ctr_ref, lifted_idx_ref, name_prefix)

# Build a fresh arm-test label (for the test block of a given arm).
fn fresh_arm_label(branch_idx: Int, base_idx: Int) -> String =
  "arm_" ++ int_to_string(branch_idx) ++ "_" ++ int_to_string(base_idx)

# Build a fresh arm-body label.
fn fresh_body_label(branch_idx: Int, base_idx: Int) -> String =
  "body_" ++ int_to_string(branch_idx) ++ "_" ++ int_to_string(base_idx)

# ---------------------------------------------------------------------------
# Tier-1 CPR peephole: unbox a `match` over a Maybe-returning C extern.
# ---------------------------------------------------------------------------
# When the scrutinee is a DIRECT call to one of the Maybe-returning externs that
# has an `_unboxed` { i64, i64 } variant, and every arm is a simple Maybe pattern
# (Nothing / Just <var|_> / wildcard), we emit IRCallUnboxed2 + a tag branch that
# binds the Just payload straight from the returned struct — no heap `Just`.
# This is a dedicated dispatcher: it does NOT touch the shared arm machinery
# (translate_match_arms/…), so boxed matches are byte-identical to before.

# Maybe-returning externs with a runtime `<name>_unboxed` (SproutUnboxed2) variant.
# Width-3 (native_set_to_list) is excluded — different sret ABI, not Tier 1.
fn unboxed_maybe_extern_name(base: String) -> Maybe String =
  if base == "vector_get" || base == "map_get" || base == "map_nth_key"
     || base == "map_nth_value" || base == "bytes_get" || base == "str_char_at"
     || base == "argv_get" || base == "env_get" || base == "regex_find_range"
     || base == "term_read_line"
  then Just(base ++ "_unboxed")
  else Nothing

# An arm is "simple" iff it needs neither the boxed handle nor nested destructure:
#   Nothing | Just <var> | Just _ | _ (wildcard).
# A top-level VarPattern binds the WHOLE Maybe, which needs the boxed value —
# excluded so the peephole falls back to the boxed path for it.
fn is_simple_maybe_arm(pat: ast.Pattern) -> Bool =
  match pat with
  | ast.WildcardPattern _ -> true
  | ast.ConstructorPattern "Nothing" Nil _ -> true
  | ast.ConstructorPattern "Just" args _ ->
      match args with
      | [ast.VarPattern _ _] -> true
      | [ast.WildcardPattern _] -> true
      | _ -> false
  | _ -> false

fn all_arms_simple_maybe(arms: List typed_ast.TypedMatchBranch) -> Bool =
  match arms with
  | Nil -> true
  | Cons (typed_ast.TypedMatchBranch pat _) rest ->
      is_simple_maybe_arm(pat) && all_arms_simple_maybe(rest)

# Tier-2 generalization: an arm is unboxable for ANY width-2 ADT — a constructor
# of a max_ar<=1 type with 0 or 1 var/wildcard sub-pattern, or a wildcard.  Same
# shape as is_simple_maybe_arm but keyed on the ctor table's max_ar (field 3) so
# it covers Maybe/Result AND custom `type Box a = Empty | Full a`.  A top-level
# VarPattern (binds the whole value) is excluded — it needs the boxed handle.
fn is_simple_width2_arm(pat: ast.Pattern, ctors: Dict sprout_ir.CtorInfo) -> Bool =
  match pat with
  | ast.WildcardPattern _ -> true
  | ast.ConstructorPattern name args _ ->
      match dict_get(name, ctors) with
      | Nothing -> false
      | Just entry ->
          match entry with
          | sprout_ir.CtorInfo tag _ar max_ar _fks _ ->
              # tag == -1 is the `wrap` sentinel: wrap values are UNBOXED (the raw
              # inner value, no heap ctor/tag), so the { tag, val } worker machinery
              # (IRGetTag/IRMakeCtor) does not apply — exclude them like Bool is.
              (tag != -1) && (max_ar <= 1) &&
              (match args with
               | Nil -> true
               | [ast.VarPattern _ _] -> true
               | [ast.WildcardPattern _] -> true
               | _ -> false)
  | _ -> false

fn all_arms_simple_width2(arms: List typed_ast.TypedMatchBranch,
                          ctors: Dict sprout_ir.CtorInfo) -> Bool =
  match arms with
  | Nil -> true
  | Cons (typed_ast.TypedMatchBranch pat _) rest ->
      is_simple_width2_arm(pat, ctors) && all_arms_simple_width2(rest, ctors)

# True iff at least one arm is a ConstructorPattern — anchors the match to a real
# ADT so a wildcard-only `match f(x) with | _ -> …` (no ctor to size) never routes.
fn arms_have_ctor_anchor(arms: List typed_ast.TypedMatchBranch) -> Bool =
  match arms with
  | Nil -> false
  | Cons (typed_ast.TypedMatchBranch pat _) rest ->
      (match pat with
       | ast.ConstructorPattern _ _ _ -> true
       | _ -> false)
      || arms_have_ctor_anchor(rest)

fn ctors_has(ctors: Dict sprout_ir.CtorInfo, name: String) -> Bool =
  match dict_get(name, ctors) with
  | Just _ -> true
  | Nothing -> false

# True iff `name` is bound more locally than the top-level extern — a captured
# closure, a parameter, a top-level `let`, or a constructor.  In any of these the
# bare TVar does NOT refer to the prelude C extern, so the peephole must NOT fire:
# the boxed path routes these to IRApplyClosure / IRLoadGlobal / a ctor call.
# Mirrors translate_call's dispatch precedence (captures → param → let → ctor →
# direct call); a param named e.g. `env_get` would otherwise be miscompiled into
# a direct `@env_get_unboxed` call to the C runtime.
fn callee_name_shadowed(name: String, params: List String, captures: Dict String,
                        let_names: Set, ctors: Dict sprout_ir.CtorInfo) -> Bool =
  (match dict_get(name, captures) with | Just _ -> true | Nothing -> false)
  || param_known(name, params)
  || set_member(name, let_names)
  || ctors_has(ctors, name)

# Returns Just (unboxed_fn_name, call_args) when the peephole applies.
# Shared Tier-2 SHAPE core (shadow-free): `name` is a non-extern callee whose
# match arms are all simple width-2 patterns anchored by a real ctor.  The single
# authority used by BOTH the call-site router (which further requires not-shadowed)
# and the emission scan (collect_worker_callees, which stays shadow-free — a
# superset, so it can never fail to emit a worker the router routes to).
fn tier2_worker_shape(name: String, arms: List typed_ast.TypedMatchBranch,
                      ctors: Dict sprout_ir.CtorInfo) -> Bool =
  (match unboxed_maybe_extern_name(name) with | Just _ -> false | Nothing -> true)
  && all_arms_simple_width2(arms, ctors)
  && arms_have_ctor_anchor(arms)

fn unboxed_maybe_match_target(scrut: typed_ast.TypedExpr,
                              arms: List typed_ast.TypedMatchBranch,
                              params: List String, captures: Dict String,
                              let_names: Set, top_level: Set,
                              ctors: Dict sprout_ir.CtorInfo,
                              fn_arities: Dict FnInfo) ->
    Maybe(String, List typed_ast.TypedExpr) =
  let typed_ast.TCall callee args call_ty _ = scrut else Nothing
      typed_ast.TVar name _ _ = callee else Nothing
  in
    # Test the O(1) extern-name allowlist first — the most selective check —
    # so the common (non-extern) match skips the O(arms) arm walk below.
    match unboxed_maybe_extern_name(name) with
    | Just ufn ->
        # Tier-1: direct Maybe-returning C extern with a runtime `_unboxed`.
        if is_maybe_type(call_ty) && all_arms_simple_maybe(arms)
           && ctors_has(ctors, "Just") && ctors_has(ctors, "Nothing")
           && ! callee_name_shadowed (name, params, captures, let_names, ctors)
        then Just((ufn, args))
        else Nothing
    | Nothing ->
        # Tier-2: direct call to a top-level Sprout fn returning a width-2
        # ADT — routes to the emitted `@<name>_worker` (guaranteed to exist
        # because collect_worker_callees scans on the same shape core).
        #
        # The arms describe the value at THIS call site; `cpr_result_known`
        # describes the callee's declared result, which is what fixes the
        # worker's convention. Both must hold: a polymorphic callee's arms look
        # identical here while its worker cannot know the representation.
        if set_member(name, top_level)
           && cpr_result_known(name, fn_arities)
           && tier2_worker_shape(name, arms, ctors)
           && ! callee_name_shadowed (name, params, captures, let_names, ctors)
        then Just((name ++ "_worker", args))
        else Nothing

# Bind the `Just x` payload variable to the extracted val SSA (no IRGetField).
# `Just _`, `Nothing`, and wildcard bind nothing.
fn bind_just_arg(ctor_args: List ast.Pattern, val_ssa: String,
                 captures: Dict String) -> Dict String =
  match ctor_args with
  | [ast.VarPattern v _] -> dict_set(v, val_ssa, captures)
  | _ -> captures

# Prepend an arm's tag-test block (present for Just/Nothing, absent for wildcard).
fn prepend_test_block(tb: Maybe sprout_ir.IRBlock,
                      acc: List sprout_ir.IRBlock) -> List sprout_ir.IRBlock =
  match tb with
  | Just b -> Cons(b, acc)
  | Nothing -> acc

# Translate one arm's body at body_lbl, seal it with `br join`, then recurse into
# the rest.  `test_block` is the arm's tag-test block (Nothing for a wildcard arm,
# whose dispatch_lbl IS the body entry).  Mirrors the block/phi accumulation of
# translate_match_arm_body_with_test_and_ops but for the self-contained dispatcher.
fn emit_unboxed_arm_body(body: typed_ast.TypedExpr,
                         rest: List typed_ast.TypedMatchBranch,
                         branch_idx: Int, base_idx: Int,
                         test_block: Maybe sprout_ir.IRBlock, body_lbl: String,
                         join_lbl: String, match_ty: types.Type,
                         val_ssa: String, tag_ssa: String,
                         params: List String, ctors: Dict sprout_ir.CtorInfo,
                         idx: Int,
                         acc_blocks: List sprout_ir.IRBlock,
                         acc_phi: List (String, String),
                         body_captures: Dict String, outer_captures: Dict String,
                         lifted_ref: Ref (List sprout_ir.IRFunction),
                         top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                         lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                         name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, List (String, String), Int) !{IO} =
  match translate_expr(body, params, ctors, idx, body_lbl, Nil, body_captures,
                       lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                       name_prefix) with
  | Err msg -> Err(msg)
  | Ok br ->
      match br with
      | (body_blocks, body_cur_lbl, body_cur_ops, body_val, idx1) ->
          do
            let base_blocks = prepend_test_block(test_block, acc_blocks)
            translate_unboxed_maybe_arms(rest, branch_idx + 1, base_idx, join_lbl, match_ty,
              val_ssa, tag_ssa, params, ctors, idx1,
              Cons(sprout_ir.IRBlock(body_cur_lbl,
                     list_append(body_cur_ops, Cons(sprout_ir.IRBr(join_lbl), Nil))),
                   list_append(list_reverse(body_blocks), base_blocks)),
              Cons((body_val, body_cur_lbl), acc_phi),
              outer_captures, lifted_ref, top_level, let_names, fn_arities,
              lambda_ctr_ref, lifted_idx_ref, name_prefix)

# Dispatch one simple Maybe arm: wildcard (unconditional) or a Just/Nothing tag test.
fn translate_unboxed_maybe_one_arm(pat: ast.Pattern, body: typed_ast.TypedExpr,
                                   rest: List typed_ast.TypedMatchBranch,
                                   branch_idx: Int, base_idx: Int,
                                   dispatch_lbl: String, join_lbl: String,
                                   match_ty: types.Type, val_ssa: String, tag_ssa: String,
                                   params: List String, ctors: Dict sprout_ir.CtorInfo,
                                   idx: Int,
                                   acc_blocks: List sprout_ir.IRBlock,
                                   acc_phi: List (String, String),
                                   captures: Dict String,
                                   lifted_ref: Ref (List sprout_ir.IRFunction),
                                   top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                                   lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                                   name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, List (String, String), Int) !{IO} =
  match pat with
  | ast.WildcardPattern _ ->
      emit_unboxed_arm_body(body, rest, branch_idx, base_idx, Nothing, dispatch_lbl, join_lbl,
        match_ty, val_ssa, tag_ssa, params, ctors, idx, acc_blocks, acc_phi,
        captures, captures, lifted_ref, top_level, let_names, fn_arities,
        lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | ast.ConstructorPattern ctor_name ctor_args _ ->
      match dict_get(ctor_name, ctors) with
      | Nothing -> Err("ast_to_ir: unknown constructor '" ++ ctor_name ++ "' in unboxed match pattern")
      | Just entry ->
          match entry with
          | sprout_ir.CtorInfo ctor_tag _a _m _f _ ->
              do
                let miss_lbl = fresh_arm_label(branch_idx + 1, base_idx)
                let body_lbl = fresh_body_label(branch_idx, base_idx)
                let test_block = sprout_ir.IRBlock(dispatch_lbl,
                  Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx), ctor_tag),
                  Cons(sprout_ir.IRICmp(fresh_name(name_prefix, idx + 1), "eq", tag_ssa,
                                        fresh_name(name_prefix, idx)),
                  Cons(sprout_ir.IRCondBr(fresh_name(name_prefix, idx + 1), body_lbl, miss_lbl),
                  Nil))))
                emit_unboxed_arm_body(body, rest, branch_idx, base_idx, Just(test_block), body_lbl,
                  join_lbl, match_ty, val_ssa, tag_ssa, params, ctors, idx + 2, acc_blocks, acc_phi,
                  bind_just_arg(ctor_args, val_ssa, captures), captures,
                  lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | _ -> Err("ast_to_ir: non-simple pattern reached unboxed-maybe dispatcher (internal error)")

# Recurse over the simple Maybe arms; Nil seals a final miss block with IRAbortMatch.
# Mirrors translate_match_arms' Nil base (reversed acc, single list_reverse).
fn translate_unboxed_maybe_arms(arms: List typed_ast.TypedMatchBranch,
                                branch_idx: Int, base_idx: Int, join_lbl: String,
                                match_ty: types.Type, val_ssa: String, tag_ssa: String,
                                params: List String, ctors: Dict sprout_ir.CtorInfo,
                                idx: Int,
                                acc_blocks: List sprout_ir.IRBlock,
                                acc_phi: List (String, String),
                                captures: Dict String,
                                lifted_ref: Ref (List sprout_ir.IRFunction),
                                top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                                lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                                name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, List (String, String), Int) !{IO} =
  match arms with
  | Nil ->
      Ok((list_reverse(Cons(sprout_ir.IRBlock(fresh_arm_label(branch_idx, base_idx),
                              Cons(sprout_ir.IRAbortMatch, Nil)),
                            acc_blocks)),
          list_reverse(acc_phi), idx))
  | Cons arm rest ->
      match arm with
      | typed_ast.TypedMatchBranch pat body ->
          translate_unboxed_maybe_one_arm(pat, body, rest, branch_idx, base_idx,
            fresh_arm_label(branch_idx, base_idx), join_lbl, match_ty, val_ssa, tag_ssa,
            params, ctors, idx, acc_blocks, acc_phi, captures, lifted_ref, top_level, let_names,
            fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix)

# Emit the whole unboxed match: translate the call args, emit IRCallUnboxed2 to get
# (tag, val), seal the scrutinee block, then dispatch arms.  Label/idx conventions
# mirror translate_match_dispatch (base = dispatch namespace; arms at base+2; phi
# at base+1; join at base).
fn translate_unboxed_maybe_match(ufn: String, call_args: List typed_ast.TypedExpr,
                                 arms: List typed_ast.TypedMatchBranch,
                                 match_ty: types.Type, params: List String,
                                 ctors: Dict sprout_ir.CtorInfo, idx: Int,
                                 cur_label: String, cur_ops: List sprout_ir.IROp,
                                 captures: Dict String,
                                 lifted_ref: Ref (List sprout_ir.IRFunction),
                                 top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                                 lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                                 name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match translate_args_scalar(call_args, params, ctors, idx, cur_label, cur_ops, Nil, Nil,
                              captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                              lifted_idx_ref, name_prefix) with
  | Err msg -> Err(msg)
  | Ok r ->
      match r with
      | (arg_blocks, arg_cur_lbl, arg_cur_ops, arg_names, idx1) ->
          do
           let tag_ssa = fresh_name(name_prefix, idx1)
           let val_ssa = fresh_name(name_prefix, idx1 + 1)
           let call_ops = list_append(arg_cur_ops,
             Cons(sprout_ir.IRCallUnboxed2(tag_ssa, val_ssa, sprout_ir.IRTUnknown, ufn, arg_names), Nil))
           let base = idx1 + 2
           match translate_unboxed_maybe_arms(arms, 0, base, fresh_join_label(base), match_ty,
                                              val_ssa, tag_ssa, params, ctors, base + 2, Nil, Nil,
                                              captures, lifted_ref, top_level, let_names, fn_arities,
                                              lambda_ctr_ref, lifted_idx_ref, name_prefix) with
           | Err msg -> Err(msg)
           | Ok ar ->
              match ar with
              | (arm_blocks, phi_incoming, idx_after) ->
                  finish_match(match_ty, arg_blocks,
                    sprout_ir.IRBlock(arg_cur_lbl,
                      list_append(call_ops, Cons(sprout_ir.IRBr(fresh_arm_label(0, base)), Nil))),
                    arm_blocks, phi_incoming, fresh_join_label(base),
                    fresh_name(name_prefix, base + 1), idx_after)

# --- Tuple-CPR (docs/scalar-replacement-v0.md, Stage 1) ---------------------
# `match f(args) with | (a, b) -> body` over a top-level fn returning a 2-tuple of non-heap scalars
# unboxes to `@f_worker` returning `{ i64, i64 }`, so the tuple never touches the heap. All-scalar
# fields ⇒ the two returned slots carry no GC-rooting obligation (the milestone-1 guard). The tuple
# pattern is irrefutable (one arm, no tag test), so the call site is simpler than the Maybe path.

# A 2-tuple whose fields are both non-heap scalars (Int/Bool/Char).
fn all_non_heap_scalar(ts: List types.Type) -> Bool =
  match ts with
  | Nil -> true
  | Cons t rest -> type_kind.type_is_non_heap_scalar(t) && all_non_heap_scalar(rest)

# The SINGLE width oracle for tuple-CPR (docs/scalar-replacement-v0.md). Returns the width of an
# all-non-heap-scalar tuple type when it is one the tuple-CPR ABI supports (2 → { i64, i64 } direct;
# 3 → { i64, i64, i64 } direct, no sret); Nothing for non-tuples, heap-field tuples, and widths
# outside {2,3} (boxed fallback — a documented cap, not an error). The router (tuple_worker_shape),
# the worker return-type (emit_worker_fn), and the repack tail all consult THIS on the same
# fn-result type, so the call-site op and the worker's ret can never disagree on width.
fn scalar_tuple_width(t: types.Type) -> Maybe Int =
  match t with
  | types.TTuple items ->
      if all_non_heap_scalar(items)
      then (match list_length(items) with | 2 -> Just(2) | 3 -> Just(3) | _ -> Nothing)
      else Nothing
  | _ -> Nothing

# True iff a tuple worker's tail body has a scalar 3-tuple result (→ repack via IRRetUnboxed3).
fn tuple_repack_is_w3(body: typed_ast.TypedExpr) -> Bool =
  match scalar_tuple_width(typed_ast.typed_expr_type(body)) with
  | Just w -> w == 3
  | Nothing -> false

# The worker fn's declared LLVM return-type string. A width-3 scalar-tuple worker returns
# { i64, i64, i64 } (direct, no sret); every other worker (ADT tier-2, width-2 tuple) uses
# { i64, i64 }. Derived from the same scalar_tuple_width oracle the call site uses, so the
# `define`'s ret type always matches the IRCallUnboxed{2,3} at the call site.
fn worker_ret_ty(body: typed_ast.TypedExpr) -> String =
  match scalar_tuple_width(typed_ast.typed_expr_type(body)) with
  | Just w -> if w == 3 then "{ i64, i64, i64 }" else "{ i64, i64 }"
  | Nothing -> "{ i64, i64 }"

# The unboxed struct width a worker-chain tail returns: a scalar 3-tuple → 3; everything else
# (width-2 ADT chain, scalar 2-tuple, Maybe-extern) → 2. Must equal the chaining worker's
# worker_ret_ty (both read scalar_tuple_width on the same tail-result type).
fn chain_width(body: typed_ast.TypedExpr) -> Int =
  match scalar_tuple_width(typed_ast.typed_expr_type(body)) with
  | Just w -> w
  | Nothing -> 2

# ---------------------------------------------------------------------------
# C2: intra-function tuple SRA (do-block-localized). docs/scalar-replacement-v0.md Stage 3.
# A scalar tuple `let`-bound in a do-block and consumed by exactly ONE tuple match (no other use) is
# scalar-replaced: no heap tuple is allocated, an `if` producer merges the fields via per-field phis,
# and any fn producers become width-w workers. Two consumers share the core eligibility oracle:
# collect_wc (emits the producer workers; shadow-FREE superset) and translate_do (fires the rewrite,
# after an extra shadow gate). Shared oracle ⇒ they cannot disagree on WHETHER a producer is
# workerized, so translation never calls an un-emitted @<f>_worker (the C1 divergence class).

# Callees inside a scalar-tuple PRODUCER `e` that must be workerized: Nil for a tuple literal, [f] for
# a bare top-level call f(args), the union for an `if` of producers. Nothing if `e` is not a lowerable
# producer. Shadow-free — over-collecting a worker is harmless; calling an un-emitted one is not.
fn sra_producer_callees(e: typed_ast.TypedExpr, width: Int, top_level: Set) -> Maybe (List String) =
  match e with
  | typed_ast.TTuple items _ _ ->
      if list_length(items) == width then Just(Nil) else Nothing
  | typed_ast.TCall callee _ _ _ ->
      (match callee with
       | typed_ast.TVar name _ _ -> if set_member(name, top_level) then Just(Cons(name, Nil)) else Nothing
       | _ -> Nothing)
  | typed_ast.TIf _ thn els _ _ ->
      (match sra_producer_callees(thn, width, top_level) with
       | Just tcs -> (match sra_producer_callees(els, width, top_level) with
                      | Just ecs -> Just(list_append(tcs, ecs))
                      | Nothing -> Nothing)
       | Nothing -> Nothing)
  | _ -> Nothing

# Translation-time shadow gate: every producer call's callee must be an unshadowed top-level fn (so
# @<f>_worker is a real target). Recurses like sra_producer_callees. Keeps translation ⊆ collection.
fn sra_producers_unshadowed(e: typed_ast.TypedExpr, params: List String, captures: Dict String,
                            let_names: Set, ctors: Dict sprout_ir.CtorInfo) -> Bool =
  match e with
  | typed_ast.TTuple _ _ _ -> true
  | typed_ast.TCall callee _ _ _ ->
      (match callee with
       | typed_ast.TVar name _ _ -> ! callee_name_shadowed (name, params, captures, let_names, ctors)
       | _ -> false)
  | typed_ast.TIf _ thn els _ _ ->
      sra_producers_unshadowed(thn, params, captures, let_names, ctors)
      && sra_producers_unshadowed(els, params, captures, let_names, ctors)
  | _ -> false

# The shape of a consuming step: a `match name with | (p0..) -> body` where scrutinee is exactly
# `TVar name`, with one simple w-wide tuple arm. Returns (binders, arm_body).
fn sra_match_shape(e: typed_ast.TypedExpr, name: String, width: Int) ->
    Maybe(List ast.Pattern, typed_ast.TypedExpr) =
  match e with
  | typed_ast.TMatch scrut arms _ _ ->
      (match scrut with
       | typed_ast.TVar sname _ _ ->
           if sname == name
           then (match arms with
                 | [typed_ast.TypedMatchBranch armpat body] ->
                     (match armpat with
                      | ast.TuplePattern pats _ ->
                          if list_length(pats) == width && all_simple_tuple_binders(pats)
                          then Just((pats, body)) else Nothing
                      | _ -> Nothing)
                 | _ -> Nothing)
           else Nothing
       | _ -> Nothing)
  | _ -> Nothing

# The single consuming tuple match for `name` among the rest do-steps (the FIRST one of the right
# shape). Nothing if none. Uniqueness + escape are enforced by sra_escape_ok.
fn sra_consuming_match(name: String, rest: List typed_ast.TypedDoStep, width: Int) ->
    Maybe(List ast.Pattern, typed_ast.TypedExpr) =
  match rest with
  | Nil -> Nothing
  | Cons step more ->
      (match step with
       | typed_ast.TDoExprStep e ->
           (match sra_match_shape(e, name, width) with
            | Just r -> Just(r)
            | Nothing -> sra_consuming_match(name, more, width))
       | _ -> sra_consuming_match(name, more, width))

# Default-deny escape/linearity check: `name` may escape NOWHERE except as the single consuming
# match's scrutinee. Any rebinding of name, any use of name in another step (or in the consuming
# arm's body), or a SECOND consuming match → ineligible. compute_free_vars is exhaustive (recurses
# into nested do-blocks, lambda captures, and all match arms), so a hidden use cannot slip through.
fn sra_escape_ok(name: String, rest: List typed_ast.TypedDoStep, width: Int, top_level: Set) -> Bool =
  sra_escape_ok_go(name, rest, width, top_level, false)

fn sra_escape_ok_go(name: String, rest: List typed_ast.TypedDoStep, width: Int, top_level: Set,
                    consumed: Bool) -> Bool =
  match rest with
  | Nil -> consumed
  | Cons step more ->
      (match step with
       | typed_ast.TDoLetStep n e ->
           if n == name then false
           else if set_member(name, compute_free_vars(e, set_empty(), top_level)) then false
           else sra_escape_ok_go(name, more, width, top_level, consumed)
       | typed_ast.TDoBindStep pat e ->
           if set_member(name, set_from_list(pattern_names(pat))) then false
           else if set_member(name, compute_free_vars(e, set_empty(), top_level)) then false
           else sra_escape_ok_go(name, more, width, top_level, consumed)
       | typed_ast.TDoExprStep e ->
           (match sra_match_shape(e, name, width) with
            | Just cm ->
                if consumed then false
                else (match cm with
                      | (_binders, body) ->
                          if set_member(name, compute_free_vars(body, set_empty(), top_level)) then false
                          else sra_escape_ok_go(name, more, width, top_level, true))
            | Nothing ->
                if set_member(name, compute_free_vars(e, set_empty(), top_level)) then false
                else sra_escape_ok_go(name, more, width, top_level, consumed)))

# The continuation must contain NO Maybe/Result do-bind: those route to translate_do_bind_* helpers,
# which reset the SRA side-table to empty (they never thread it). The guard guarantees no SRA-bound
# name is ever live across such a boundary, so the reset loses nothing. (A `let t=…; x<-maybeThing();
# match t` shape is simply left boxed — a rare, filable follow-up, not a correctness risk.)
fn sra_rest_plain(rest: List typed_ast.TypedDoStep) -> Bool =
  match rest with
  | Nil -> true
  | Cons step more ->
      (match step with
       | typed_ast.TDoBindStep _ e ->
           if is_maybe_type(typed_ast.typed_expr_type(e)) || is_result_type(typed_ast.typed_expr_type(e))
           then false else sra_rest_plain(more)
       | _ -> sra_rest_plain(more))

# Shared SRA eligibility oracle (shadow-free). Just (width, producer-callees, binders, arm_body) when
# `let name = e` in a do-block is scalar-replaceable. Consulted by BOTH collect_wc and translate_do.
fn sra_core_eligible(name: String, e: typed_ast.TypedExpr, rest: List typed_ast.TypedDoStep,
                     top_level: Set) ->
    Maybe(Int, List String, List ast.Pattern, typed_ast.TypedExpr) =
  let Just w = scalar_tuple_width(typed_ast.typed_expr_type(e)) else Nothing
      Just producers = sra_producer_callees(e, w, top_level) else Nothing
      Just((binders, body)) = sra_consuming_match(name, rest, w) else Nothing
  in
    if sra_escape_ok(name, rest, w, top_level) && sra_rest_plain(rest)
    then Just((w, producers, binders, body))
    else Nothing

# When a do-expr-step is the consuming `match name with | (pats) -> body` for an SRA-bound `name`,
# return (binders, arm_body, field-scalars) so the caller binds the binders to the scalars and
# translates the arm body directly — the boxed scrutinee is never materialized. Nothing otherwise.
fn sra_consume_here(e: typed_ast.TypedExpr, sra: Dict (List String)) ->
    Maybe(List ast.Pattern, typed_ast.TypedExpr, List String) =
  let typed_ast.TMatch scrut arms _ _ = e else Nothing
      typed_ast.TVar name _ _ = scrut else Nothing
      Just scalars = dict_get(name, sra) else Nothing
      [typed_ast.TypedMatchBranch(ast.TuplePattern pats _) body] = arms else Nothing
  in Just((pats, body, scalars))

# Build N per-field phis merging the then/else field lists at their branch-final labels. Returns the
# phi ops (in field order), the phi result names, and the next idx.
fn build_tuple_phis(t_names: List String, e_names: List String, tcur_lbl: String, ecur_lbl: String,
                    idx: Int, name_prefix: String) -> (List sprout_ir.IROp, List String, Int) =
  match t_names with
  | Cons tn trest ->
      (match e_names with
       | Cons en erest ->
           (match build_tuple_phis(trest, erest, tcur_lbl, ecur_lbl, idx + 1, name_prefix) with
            | (rest_ops, rest_names, idx2) ->
                (Cons(sprout_ir.IRPhi(fresh_name(name_prefix, idx), "i64",
                        Cons((tn, tcur_lbl), Cons((en, ecur_lbl), Nil))), rest_ops),
                 Cons(fresh_name(name_prefix, idx), rest_names), idx2))
       | Nil -> (Nil, Nil, idx))
  | Nil -> (Nil, Nil, idx)

# Emit a width-w unboxed worker call for an SRA producer call `f(args)` (args already lowered).
# Returns the w field SSA names. Mirrors translate_unboxed_tuple_match's call-site emission.
fn sra_emit_worker_call(fname: String, anames: List String, width: Int,
                        ablocks: List sprout_ir.IRBlock, albl: String, aops: List sprout_ir.IROp,
                        idx1: Int, name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, List String, Int) =
  if width == 3
  then Ok((ablocks, albl,
           list_append(aops, Cons(sprout_ir.IRCallUnboxed3(fresh_name(name_prefix, idx1),
             fresh_name(name_prefix, idx1 + 1), fresh_name(name_prefix, idx1 + 2), sprout_ir.IRTScalar,
             fname ++ "_worker", anames), Nil)),
           [fresh_name(name_prefix, idx1), fresh_name(name_prefix, idx1 + 1), fresh_name(name_prefix, idx1 + 2)],
           idx1 + 3))
  else Ok((ablocks, albl,
           list_append(aops, Cons(sprout_ir.IRCallUnboxed2(fresh_name(name_prefix, idx1),
             fresh_name(name_prefix, idx1 + 1), sprout_ir.IRTScalar, fname ++ "_worker", anames), Nil)),
           [fresh_name(name_prefix, idx1), fresh_name(name_prefix, idx1 + 1)], idx1 + 2))

# Lower a scalar-tuple PRODUCER `e` to its `width` field SSA names (NO heap tuple). Literal → eval
# each field; call → width-w unboxed worker; if → recurse both branches + N-phi merge. Callers gate
# `e` with sra_producer_callees (+ shadow check), so the catch-all is an internal invariant break.
fn translate_tuple_scalars(e: typed_ast.TypedExpr, width: Int, params: List String,
                           ctors: Dict sprout_ir.CtorInfo, idx: Int, cur_label: String,
                           cur_ops: List sprout_ir.IROp, captures: Dict String,
                           lifted_ref: Ref (List sprout_ir.IRFunction), top_level: Set,
                           let_names: Set, fn_arities: Dict FnInfo, lambda_ctr_ref: Ref Int,
                           lifted_idx_ref: Ref (Dict Int), name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, List String, Int) !{IO} =
  match e with
  | typed_ast.TTuple items _ _ ->
      translate_args_scalar(items, params, ctors, idx, cur_label, cur_ops, Nil, Nil, captures,
                            lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                            lifted_idx_ref, name_prefix)
  | typed_ast.TCall callee args _ _ ->
      (match callee with
       | typed_ast.TVar fname _ _ ->
           (match translate_args_scalar(args, params, ctors, idx, cur_label, cur_ops, Nil, Nil, captures,
                                        lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                                        lifted_idx_ref, name_prefix) with
            | Err msg -> Err(msg)
            | Ok r ->
                (match r with
                 | (ablocks, albl, aops, anames, idx1) ->
                     sra_emit_worker_call(fname, anames, width, ablocks, albl, aops, idx1, name_prefix)))
       | _ -> Err("translate_tuple_scalars: non-var producer callee (internal error)"))
  | typed_ast.TIf cond thn els _ _ ->
      (match translate_expr(cond, params, ctors, idx, cur_label, cur_ops, captures, lifted_ref,
                            top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix) with
       | Err msg -> Err(msg)
       | Ok cr ->
           (match cr with
            | (cblocks, ccur_lbl, ccur_ops, c_name, idx1) ->
                translate_tuple_if(thn, els, width, params, ctors, cblocks, ccur_lbl, ccur_ops, c_name, idx1,
                                   captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                                   lifted_idx_ref, name_prefix)))
  | _ -> Err("translate_tuple_scalars: non-producer expr (internal error)")

fn translate_tuple_if(thn: typed_ast.TypedExpr, els: typed_ast.TypedExpr, width: Int,
                      params: List String, ctors: Dict sprout_ir.CtorInfo,
                      cblocks: List sprout_ir.IRBlock, ccur_lbl: String, ccur_ops: List sprout_ir.IROp,
                      c_name: String, idx: Int, captures: Dict String,
                      lifted_ref: Ref (List sprout_ir.IRFunction), top_level: Set, let_names: Set,
                      fn_arities: Dict FnInfo, lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                      name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, List String, Int) !{IO} =
  match translate_tuple_scalars(thn, width, params, ctors, idx + 1, then_lbl, Nil, captures, lifted_ref,
                                top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix) with
  | Err msg -> Err(msg)
  | Ok tr ->
      (match tr with
       | (tblocks, tcur_lbl, tcur_ops, t_names, idx2) ->
           (match translate_tuple_scalars(els, width, params, ctors, idx2, else_lbl, Nil, captures, lifted_ref,
                                          top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix) with
            | Err msg -> Err(msg)
            | Ok er ->
                (match er with
                 | (eblocks, ecur_lbl, ecur_ops, e_names, idx3) ->
                     finish_tuple_if(cblocks, ccur_lbl, ccur_ops, c_name, then_lbl, tblocks, tcur_lbl, tcur_ops, t_names,
                                     else_lbl, eblocks, ecur_lbl, ecur_ops, e_names, join_lbl, idx3, name_prefix))))
  where then_lbl = fresh_then_label(idx)
        else_lbl = fresh_else_label(idx)
        join_lbl = fresh_join_label(idx)

fn finish_tuple_if(cblocks: List sprout_ir.IRBlock, ccur_lbl: String, ccur_ops: List sprout_ir.IROp,
                   c_name: String, then_lbl: String, tblocks: List sprout_ir.IRBlock, tcur_lbl: String,
                   tcur_ops: List sprout_ir.IROp, t_names: List String, else_lbl: String,
                   eblocks: List sprout_ir.IRBlock, ecur_lbl: String, ecur_ops: List sprout_ir.IROp,
                   e_names: List String, join_lbl: String, idx: Int, name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, List String, Int) =
  match build_tuple_phis(t_names, e_names, tcur_lbl, ecur_lbl, idx + 1, name_prefix) with
  | (phi_ops, phi_names, idx2) ->
      Ok((all_blocks, join_lbl, phi_ops, phi_names, idx2))
  where cond_i1 = fresh_name(name_prefix, idx)
        cond_block = sprout_ir.IRBlock(ccur_lbl,
                       list_append(ccur_ops,
                         Cons(sprout_ir.IRTruncI64ToI1(cond_i1, c_name),
                         Cons(sprout_ir.IRCondBr(cond_i1, then_lbl, else_lbl), Nil))))
        then_final = sprout_ir.IRBlock(tcur_lbl, list_append(tcur_ops, Cons(sprout_ir.IRBr(join_lbl), Nil)))
        else_final = sprout_ir.IRBlock(ecur_lbl, list_append(ecur_ops, Cons(sprout_ir.IRBr(join_lbl), Nil)))
        all_blocks = list_append(cblocks,
                       Cons(cond_block,
                       list_append(tblocks,
                         Cons(then_final,
                         list_append(eblocks, Cons(else_final, Nil))))))

# A tuple pattern binds only vars/wildcards — the bound value is a raw returned slot, no box handle.
fn all_simple_tuple_binders(pats: List ast.Pattern) -> Bool =
  match pats with
  | Nil -> true
  | Cons p rest ->
      (match p with | ast.VarPattern _ _ -> true | ast.WildcardPattern _ -> true | _ -> false)
      && all_simple_tuple_binders(rest)

# Shared shape core (shadow-free), used by BOTH the call-site router and collect_wc_scrutinee: a
# single irrefutable 2-var/wildcard tuple arm over a scalar 2-tuple result.
fn tuple_worker_shape(arms: List typed_ast.TypedMatchBranch, call_ty: types.Type) -> Bool =
  match arms with
  | [typed_ast.TypedMatchBranch armpat _] ->
      (match scalar_tuple_width(call_ty) with
       | Just w ->
           (match armpat with
            | ast.TuplePattern pats _ -> (list_length(pats) == w) && all_simple_tuple_binders(pats)
            | _ -> false)
       | Nothing -> false)
  | _ -> false

# Returns Just (worker_name, args, binders, body) when the tuple peephole applies.
fn unboxed_tuple_match_target(scrut: typed_ast.TypedExpr,
                              arms: List typed_ast.TypedMatchBranch,
                              params: List String, captures: Dict String,
                              let_names: Set, top_level: Set,
                              ctors: Dict sprout_ir.CtorInfo,
                              fn_arities: Dict FnInfo) ->
    Maybe(String, List typed_ast.TypedExpr, List ast.Pattern, typed_ast.TypedExpr) =
  let typed_ast.TCall callee args _ _ = scrut else Nothing
      typed_ast.TVar name _ _ = callee else Nothing
      [typed_ast.TypedMatchBranch(ast.TuplePattern pats _) body] = arms else Nothing
  in
    # `tuple_worker_shape` reads the INSTANTIATED result at this call site; a
    # polymorphic callee can be instantiated at a tuple here and at an ADT
    # elsewhere, and one worker symbol cannot answer both — so gate on the
    # callee's declared result too.
    if set_member(name, top_level)
       && cpr_result_known(name, fn_arities)
       && ! callee_name_shadowed (name, params, captures, let_names, ctors)
       && tuple_worker_shape(arms, typed_ast.typed_expr_type(scrut))
    then Just((name ++ "_worker", args, pats, body))
    else Nothing

# Bind the tuple pattern's two binders to the two unboxed return slots (VarPattern → slot; wildcard
# binds nothing). Mirrors bind_just_arg for the tuple case.
fn bind_one_slot(p: ast.Pattern, ssa: String, caps: Dict String) -> Dict String =
  match p with
  | ast.VarPattern v _ -> dict_set(v, ssa, caps)
  | _ -> caps

# Bind each tuple binder to its unboxed return slot, pairwise (width 2 or 3). VarPattern → slot;
# wildcard binds nothing. Lengths always match (the router ties pattern arity to the tuple width).
fn bind_tuple_slots(pats: List ast.Pattern, slots: List String, caps: Dict String) -> Dict String =
  match pats with
  | Cons p prest ->
      (match slots with
       | Cons s srest -> bind_tuple_slots(prest, srest, bind_one_slot(p, s, caps))
       | Nil -> caps)
  | Nil -> caps

# Emit an unboxed tuple match: eval args, `IRCallUnboxed2` → (slot0, slot1), bind the two pattern
# vars directly to the slots, translate the single arm body in place. No tag test / phi / join.
fn translate_unboxed_tuple_match(worker: String, call_args: List typed_ast.TypedExpr,
                                 binders: List ast.Pattern, body: typed_ast.TypedExpr,
                                 params: List String, ctors: Dict sprout_ir.CtorInfo, idx: Int,
                                 cur_label: String, cur_ops: List sprout_ir.IROp,
                                 captures: Dict String,
                                 lifted_ref: Ref (List sprout_ir.IRFunction),
                                 top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                                 lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                                 name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match translate_args_scalar(call_args, params, ctors, idx, cur_label, cur_ops, Nil, Nil,
                              captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                              lifted_idx_ref, name_prefix) with
  | Err msg -> Err(msg)
  | Ok r ->
      match r with
      | (arg_blocks, arg_lbl, arg_ops, arg_names, idx1) ->
          do
            let width = list_length(binders)
            let slot0 = fresh_name(name_prefix, idx1)
            let slot1 = fresh_name(name_prefix, idx1 + 1)
            let slot2 = fresh_name(name_prefix, idx1 + 2)
            # width comes from the binder count (= tuple width, tied by tuple_worker_shape); the
            # worker's declared ret type is derived from the SAME width in emit_worker_fn, so the
            # { i64,… } arity here always matches the worker's `ret`.
            let call_op = if width == 3
              then sprout_ir.IRCallUnboxed3(slot0, slot1, slot2, sprout_ir.IRTScalar, worker, arg_names)
              else sprout_ir.IRCallUnboxed2(slot0, slot1, sprout_ir.IRTScalar, worker, arg_names)
            let slots = if width == 3 then [slot0, slot1, slot2] else [slot0, slot1]
            let next_idx = if width == 3 then idx1 + 3 else idx1 + 2
            let call_ops = list_append(arg_ops, Cons(call_op, Nil))
            let body_caps = bind_tuple_slots(binders, slots, captures)
            match translate_expr(body, params, ctors, next_idx, arg_lbl, call_ops, body_caps,
                                 lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                                 lifted_idx_ref, name_prefix) with
            | Err msg -> Err(msg)
            | Ok br ->
                match br with
                | (b_blocks, b_lbl, b_ops, b_name, idx2) ->
                    Ok((list_append(arg_blocks, b_blocks), b_lbl, b_ops, b_name, idx2))

# Entry point: translate a TMatch expression.
fn translate_match(scrut: typed_ast.TypedExpr, arms: List typed_ast.TypedMatchBranch,
                   match_ty: types.Type, params: List String,
                   ctors: Dict sprout_ir.CtorInfo, idx: Int,
                   cur_label: String, cur_ops: List sprout_ir.IROp,
                   captures: Dict String,
                   lifted_ref: Ref (List sprout_ir.IRFunction),
                   top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                   lambda_ctr_ref: Ref Int,
                   lifted_idx_ref: Ref (Dict Int),
                   name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  # Tier-1 CPR peephole: a `match` over a Maybe-returning C extern with an
  # `_unboxed` variant + simple arms skips the boxed scrutinee entirely.
  match unboxed_maybe_match_target(scrut, arms, params, captures, let_names, top_level, ctors,
                                   fn_arities) with
  | Just tgt ->
      match tgt with
      | (ufn, call_args) ->
          translate_unboxed_maybe_match(ufn, call_args, arms, match_ty, params, ctors, idx,
                                        cur_label, cur_ops, captures, lifted_ref, top_level, let_names,
                                        fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | Nothing ->
      # Tuple-CPR peephole: `match f(args) with (a,b) ->` over a scalar-2-tuple-returning top-level
      # fn routes to `@f_worker` returning { i64, i64 } — the tuple never touches the heap.
      match unboxed_tuple_match_target(scrut, arms, params, captures, let_names, top_level, ctors,
                                       fn_arities) with
      | Just ttgt ->
          (match ttgt with
           | (worker, targs, binders, tbody) ->
               translate_unboxed_tuple_match(worker, targs, binders, tbody, params, ctors, idx,
                                             cur_label, cur_ops, captures, lifted_ref, top_level,
                                             let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix))
      | Nothing ->
      match translate_expr(scrut, params, ctors, idx, cur_label, cur_ops,
                           captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                           name_prefix) with
      | Err msg -> Err(msg)
      | Ok sr ->
          match sr with
          | (s_blocks, s_cur_lbl, s_ops, s_name, idx1) ->
              translate_match_after_scrut(arms, match_ty, params, ctors, s_blocks, s_cur_lbl,
                                          s_ops, s_name, idx1, captures, lifted_ref, top_level, let_names, fn_arities,
                                          lambda_ctr_ref, lifted_idx_ref, name_prefix)

# Continues after the scrutinee is translated.
# Emits IRGetTag if needed, seals the scrutinee block, then dispatches arms.
fn translate_match_after_scrut(arms: List typed_ast.TypedMatchBranch,
                                match_ty: types.Type, params: List String,
                                ctors: Dict sprout_ir.CtorInfo,
                                s_blocks: List sprout_ir.IRBlock,
                                s_cur_lbl: String, s_ops: List sprout_ir.IROp,
                                s_name: String, idx: Int,
                                captures: Dict String,
                                lifted_ref: Ref (List sprout_ir.IRFunction),
                                top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                                lambda_ctr_ref: Ref Int,
                                lifted_idx_ref: Ref (Dict Int),
                                name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  # Hoist IRGetTag once up-front if any arm is a ConstructorPattern.
  # This SSA name is reused in every ctor branch test.
  #
  # /code-review-v2 #9: s_ops arrives in SOURCE ORDER from translate_expr
  # (translate_expr accumulates via list_append throughout). The Cons-prepend
  # convention introduced by /code-review fix #7/#8 lives INSIDE
  # translate_match_arms only — it does not extend to translate_expr's outputs.
  # This list_append is O(|s_ops|) but is called ONCE per match expression
  # (not once per arm), so it is bounded and is NOT the O(N²) pattern that
  # fix #7/#8 eliminated. Widening the Cons-prepend convention upstream into
  # translate_expr is a broader refactor and is out of scope here.
  if has_ctor_pattern_arm(arms) && ! is_wrap_match (arms, ctors)
  then
    translate_match_dispatch(arms, match_ty, params, ctors, s_blocks, s_cur_lbl,
                             list_append(s_ops,
                               Cons(sprout_ir.IRGetTag(fresh_name(name_prefix, idx), s_name), Nil)),
                             s_name, fresh_name(name_prefix, idx), idx + 1,
                             captures, lifted_ref, top_level, let_names, fn_arities,
                             lambda_ctr_ref, lifted_idx_ref, name_prefix)
  else
    translate_match_dispatch(arms, match_ty, params, ctors, s_blocks, s_cur_lbl,
                             s_ops, s_name, "", idx, captures, lifted_ref, top_level, let_names, fn_arities,
                             lambda_ctr_ref, lifted_idx_ref, name_prefix)

# Sets up join/phi labels and kicks off arm translation.
# base_idx = idx here = basis for join/phi/arm/body label naming.
fn translate_match_dispatch(arms: List typed_ast.TypedMatchBranch,
                             match_ty: types.Type, params: List String,
                             ctors: Dict sprout_ir.CtorInfo,
                             s_blocks: List sprout_ir.IRBlock,
                             s_cur_lbl: String, s_ops: List sprout_ir.IROp,
                             s_name: String, tag_name: String, idx: Int,
                             captures: Dict String,
                             lifted_ref: Ref (List sprout_ir.IRFunction),
                             top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                             lambda_ctr_ref: Ref Int,
                             lifted_idx_ref: Ref (Dict Int),
                             name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  # Allocate join_lbl and phi_name from the current idx, arms start at idx+2.
  # join_lbl uses "join_N" label-namespace (disjoint from %tN SSA names).
  # Seal scrutinee block: br → first arm's dispatch label.
  match translate_match_arms(arms, 0, idx, fresh_join_label(idx), match_ty,
                              s_name, tag_name, params, ctors, idx + 2, Nil, Nil,
                              captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                              lifted_idx_ref, name_prefix) with
  | Err msg -> Err(msg)
  | Ok ar ->
      match ar with
      | (arm_blocks, phi_incoming, idx_after) ->
          finish_match(match_ty, s_blocks,
                       sprout_ir.IRBlock(s_cur_lbl,
                         list_append(s_ops,
                           Cons(sprout_ir.IRBr(fresh_arm_label(0, idx)), Nil))),
                       arm_blocks, phi_incoming,
                       fresh_join_label(idx), fresh_name(name_prefix, idx + 1), idx_after)

# Process all arms recursively, accumulating completed blocks and phi incoming list.
# dispatch_lbl = label of the current "entry point" for this arm (test block or body block).
# branch_idx = 0-based arm index (for unique label naming).
# base_idx = the idx allocated in translate_match_dispatch (baked into label names).
# Returns (arm_blocks, phi_incoming, next_idx).
fn translate_match_arms(arms: List typed_ast.TypedMatchBranch,
                         branch_idx: Int, base_idx: Int,
                         join_lbl: String, match_ty: types.Type,
                         s_name: String, tag_name: String,
                         params: List String, ctors: Dict sprout_ir.CtorInfo,
                         idx: Int,
                         acc_blocks: List sprout_ir.IRBlock,
                         acc_phi: List (String, String),
                         captures: Dict String,
                         lifted_ref: Ref (List sprout_ir.IRFunction),
                         top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                         lambda_ctr_ref: Ref Int,
                         lifted_idx_ref: Ref (Dict Int),
                         name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, List (String, String), Int) !{IO} =
  match arms with
  | Nil ->
      # No more arms: current dispatch_lbl is the "miss all" block → IRAbortMatch.
      # IRAbortMatch is field-less (/code-review fix #15: void noreturn).
      # /code-review fix #8: acc_blocks is built REVERSED internally
      # (Cons-prepended per arm — O(B_i) instead of O(|acc_blocks|) per arm).
      # The abort block joins at the head, then a single list_reverse
      # restores source order before returning to the caller.
      Ok((list_reverse(Cons(sprout_ir.IRBlock(fresh_arm_label(branch_idx, base_idx),
                              Cons(sprout_ir.IRAbortMatch, Nil)),
                            acc_blocks)),
          list_reverse(acc_phi),
          idx))
  | Cons arm rest_arms ->
      match arm with
      | typed_ast.TypedMatchBranch pat body ->
          translate_match_one_arm(pat, body, rest_arms, branch_idx, base_idx,
                                  fresh_arm_label(branch_idx, base_idx),
                                  join_lbl, match_ty, s_name, tag_name,
                                  params, ctors, idx, acc_blocks, acc_phi,
                                  captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                                  lifted_idx_ref, name_prefix)

# Translate a single match arm, then recurse into translate_match_arms.
fn translate_match_one_arm(pat: ast.Pattern, body: typed_ast.TypedExpr,
                            rest_arms: List typed_ast.TypedMatchBranch,
                            branch_idx: Int, base_idx: Int,
                            dispatch_lbl: String, join_lbl: String,
                            match_ty: types.Type, s_name: String, tag_name: String,
                            params: List String, ctors: Dict sprout_ir.CtorInfo,
                            idx: Int,
                            acc_blocks: List sprout_ir.IRBlock,
                            acc_phi: List (String, String),
                            captures: Dict String,
                            lifted_ref: Ref (List sprout_ir.IRFunction),
                            top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                            lambda_ctr_ref: Ref Int,
                            lifted_idx_ref: Ref (Dict Int),
                            name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, List (String, String), Int) !{IO} =
  match pat with
  | ast.WildcardPattern _ ->
      # Always-match: dispatch_lbl IS the body entry (no test block emitted).
      # No shadowing: captures == outer_captures.
      translate_match_arm_body_always(body, rest_arms, branch_idx, base_idx,
                                      dispatch_lbl, join_lbl, match_ty,
                                      s_name, tag_name,
                                      params, ctors, idx, acc_blocks, acc_phi,
                                      captures, captures, lifted_ref, top_level, let_names, fn_arities,
                                      lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | ast.VarPattern v _ ->
      # Always-match with one binding: bind v → s_name in captures for the body;
      # pass plain captures as outer_captures so the binding does not leak into rest_arms.
      translate_match_arm_body_always(body, rest_arms, branch_idx, base_idx,
                                      dispatch_lbl, join_lbl, match_ty,
                                      s_name, tag_name,
                                      params, ctors, idx, acc_blocks, acc_phi,
                                      dict_set(v, s_name, captures), captures,
                                      lifted_ref, top_level, let_names, fn_arities,
                                      lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | ast.IntPattern n _ ->
      translate_match_arm_int(n, body, rest_arms, branch_idx, base_idx,
                              dispatch_lbl, join_lbl, match_ty, s_name, tag_name,
                              params, ctors, idx, acc_blocks, acc_phi,
                              captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                              lifted_idx_ref, name_prefix)
  | ast.BoolPattern b _ ->
      translate_match_arm_bool(b, body, rest_arms, branch_idx, base_idx,
                               dispatch_lbl, join_lbl, match_ty, s_name, tag_name,
                               params, ctors, idx, acc_blocks, acc_phi,
                               captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                               lifted_idx_ref, name_prefix)
  | ast.ConstructorPattern ctor_name ctor_args _ ->
      translate_match_arm_ctor(ctor_name, ctor_args, body, rest_arms,
                               branch_idx, base_idx, dispatch_lbl, join_lbl,
                               match_ty, s_name, tag_name, params, ctors, idx,
                               acc_blocks, acc_phi, captures, lifted_ref, top_level, let_names, fn_arities,
                               lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | ast.TuplePattern tuple_items _ ->
      translate_match_arm_tuple(tuple_items, body, rest_arms,
                                branch_idx, base_idx, dispatch_lbl, join_lbl,
                                match_ty, s_name, tag_name, params, ctors, idx,
                                acc_blocks, acc_phi, captures, lifted_ref, top_level, let_names, fn_arities,
                                lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | ast.StringPattern s _ ->
      translate_match_arm_string(s, body, rest_arms, branch_idx, base_idx,
                                 dispatch_lbl, join_lbl, match_ty, s_name, tag_name,
                                 params, ctors, idx, acc_blocks, acc_phi,
                                 captures, lifted_ref, top_level, let_names, fn_arities,
                                 lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | ast.CharPattern ch _ ->
      translate_match_arm_char(ch, body, rest_arms, branch_idx, base_idx,
                               dispatch_lbl, join_lbl, match_ty, s_name, tag_name,
                               params, ctors, idx, acc_blocks, acc_phi,
                               captures, lifted_ref, top_level, let_names, fn_arities,
                               lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | ast.UnitPattern _ -> Err("ast_to_ir: UnitPattern in match not yet supported")

# Translate body for an always-match arm (Wildcard or Var-after-binding).
# dispatch_lbl (= body_lbl) IS the body entry; no test block is emitted.
#
# /code-review fix #3 + #6: this function now recurses into translate_match_arms
# for rest_arms, matching the recursion shape of translate_match_arm_int /
# _bool / _ctor. Previously it short-circuited (dropped rest_arms entirely)
# and reversed acc_phi inline; the runtime IR was valid but two structural
# fragilities lurked:
#   - any arms after the wildcard were silently dropped from the IR (semantically
#     equivalent to LLVM DCE removing dead arms, but inconsistent with the old
#     codegen and with the test-bearing arm functions);
#   - the inline list_reverse would scramble phi ordering if anyone ever added
#     recursion without removing the early reverse.
# Unifying the recursion eliminates both fragilities. The Nil-base of
# translate_match_arms performs the single final list_reverse.
#
# Dead arms after the wildcard still get translated into blocks; LLVM DCE
# removes them. Their phi entries reference body labels that ARE reachable
# inside the recursion (each dead arm dispatcher branches to its own body),
# so LLVM's phi-operand-from-predecessor rule is satisfied.
fn translate_match_arm_body_always(body: typed_ast.TypedExpr,
                                    rest_arms: List typed_ast.TypedMatchBranch,
                                    branch_idx: Int, base_idx: Int,
                                    body_lbl: String, join_lbl: String,
                                    match_ty: types.Type,
                                    s_name: String, tag_name: String,
                                    params: List String,
                                    ctors: Dict sprout_ir.CtorInfo, idx: Int,
                                    acc_blocks: List sprout_ir.IRBlock,
                                    acc_phi: List (String, String),
                                    captures: Dict String,
                                    outer_captures: Dict String,
                                    lifted_ref: Ref (List sprout_ir.IRFunction),
                                    top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                                    lambda_ctr_ref: Ref Int,
                                    lifted_idx_ref: Ref (Dict Int),
                                    name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, List (String, String), Int) !{IO} =
  # `captures` is used by this arm's body (may include a VarPattern binding).
  # `outer_captures` is forwarded to rest_arms — it is the unextended dict,
  # preventing VarPattern bindings from leaking into sibling arms.
  match translate_expr(body, params, ctors, idx, body_lbl, Nil,
                       captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                       name_prefix) with
  | Err msg -> Err(msg)
  | Ok br ->
      match br with
      | (body_blocks, body_cur_lbl, body_cur_ops, body_val, idx1) ->
          # /code-review fix #8: same reversed-acc_blocks convention as
          # translate_match_arm_body_with_test_and_ops. No test_block for
          # the always-arm path; new blocks are body_blocks ++ [body_block_sealed].
          translate_match_arms(rest_arms, branch_idx + 1, base_idx,
                               join_lbl, match_ty, s_name, tag_name,
                               params, ctors, idx1,
                               Cons(sprout_ir.IRBlock(body_cur_lbl,
                                      list_append(body_cur_ops,
                                        Cons(sprout_ir.IRBr(join_lbl), Nil))),
                                    list_append(list_reverse(body_blocks),
                                                acc_blocks)),
                               Cons((body_val, body_cur_lbl), acc_phi),
                               outer_captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                               lifted_idx_ref, name_prefix)

# Translate an IntPattern arm.
# Emits test in dispatch_lbl, body in body_lbl, recurses into rest_arms via miss_lbl.
fn translate_match_arm_int(n: Int, body: typed_ast.TypedExpr,
                            rest_arms: List typed_ast.TypedMatchBranch,
                            branch_idx: Int, base_idx: Int,
                            dispatch_lbl: String, join_lbl: String,
                            match_ty: types.Type, s_name: String, tag_name: String,
                            params: List String, ctors: Dict sprout_ir.CtorInfo,
                            idx: Int,
                            acc_blocks: List sprout_ir.IRBlock,
                            acc_phi: List (String, String),
                            captures: Dict String,
                            lifted_ref: Ref (List sprout_ir.IRFunction),
                            top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                            lambda_ctr_ref: Ref Int,
                            lifted_idx_ref: Ref (Dict Int),
                            name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, List (String, String), Int) !{IO} =
  # Emit: %const = add i64 0, n; %cmp = icmp eq i64 s_name, const
  translate_match_arm_body_with_test(body, rest_arms, branch_idx, base_idx,
    sprout_ir.IRBlock(dispatch_lbl,
      list_append(
        Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx), n),
        Cons(sprout_ir.IRICmp(fresh_name(name_prefix, idx + 1), "eq", s_name,
                              fresh_name(name_prefix, idx)),
        Nil)),
        Cons(sprout_ir.IRCondBr(fresh_name(name_prefix, idx + 1),
                                fresh_body_label(branch_idx, base_idx),
                                fresh_arm_label(branch_idx + 1, base_idx)), Nil))),
    fresh_body_label(branch_idx, base_idx),
    fresh_arm_label(branch_idx + 1, base_idx),
    join_lbl, match_ty, s_name, tag_name, params, ctors,
    idx + 2, acc_blocks, acc_phi, captures,
    lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
    lifted_idx_ref, name_prefix)

# Translate a BoolPattern arm.
# Emits test in dispatch_lbl, body in body_lbl, recurses via miss_lbl.
fn translate_match_arm_bool(b: Bool, body: typed_ast.TypedExpr,
                             rest_arms: List typed_ast.TypedMatchBranch,
                             branch_idx: Int, base_idx: Int,
                             dispatch_lbl: String, join_lbl: String,
                             match_ty: types.Type, s_name: String, tag_name: String,
                             params: List String, ctors: Dict sprout_ir.CtorInfo,
                             idx: Int,
                             acc_blocks: List sprout_ir.IRBlock,
                             acc_phi: List (String, String),
                             captures: Dict String,
                             lifted_ref: Ref (List sprout_ir.IRFunction),
                             top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                             lambda_ctr_ref: Ref Int,
                             lifted_idx_ref: Ref (Dict Int),
                             name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, List (String, String), Int) !{IO} =
  # /code-review fix #2: emit IRConst (i64 with value 0/1) + IRICmp (i64
  # comparison) instead of IRConstBool/IRICmpBool. The Bool scrutinee SSA
  # is an i64 (per lower_params); both operands of the test must agree on
  # type. Sibling-i1 ops have been deleted from sprout_ir as part of the
  # same fix.
  translate_match_arm_body_with_test(body, rest_arms, branch_idx, base_idx,
    sprout_ir.IRBlock(dispatch_lbl,
      list_append(
        Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx), if b then 1 else 0),
        Cons(sprout_ir.IRICmp(fresh_name(name_prefix, idx + 1), "eq", s_name,
                              fresh_name(name_prefix, idx)),
        Nil)),
        Cons(sprout_ir.IRCondBr(fresh_name(name_prefix, idx + 1),
                                fresh_body_label(branch_idx, base_idx),
                                fresh_arm_label(branch_idx + 1, base_idx)), Nil))),
    fresh_body_label(branch_idx, base_idx),
    fresh_arm_label(branch_idx + 1, base_idx),
    join_lbl, match_ty, s_name, tag_name, params, ctors,
    idx + 2, acc_blocks, acc_phi, captures,
    lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
    lifted_idx_ref, name_prefix)

# Translate a StringPattern arm.
# Emit: IRStrConst for the literal, IRStrEq (i64 Bool result), IRConst(1),
# IRICmp eq i64→i1 for IRCondBr. Identical structure to CharPattern except
# the literal is used directly (no char_to_string conversion needed).
# Fresh name slots:
#   idx   = raw GEP ptr (IRStrConst raw name)
#   idx+1 = i64 ptrtoint result (IRStrConst result)
#   idx+2 = IRStrEq i64 Bool result
#   idx+3 = IRConst 1 (the true sentinel for comparison)
#   idx+4 = IRICmp i1 result (used in IRCondBr)
fn translate_match_arm_string(s: String, body: typed_ast.TypedExpr,
                               rest_arms: List typed_ast.TypedMatchBranch,
                               branch_idx: Int, base_idx: Int,
                               dispatch_lbl: String, join_lbl: String,
                               match_ty: types.Type, s_name: String, tag_name: String,
                               params: List String, ctors: Dict sprout_ir.CtorInfo,
                               idx: Int,
                               acc_blocks: List sprout_ir.IRBlock,
                               acc_phi: List (String, String),
                               captures: Dict String,
                               lifted_ref: Ref (List sprout_ir.IRFunction),
                               top_level: Set,
                               let_names: Set,
                               fn_arities: Dict FnInfo,
                               lambda_ctr_ref: Ref Int,
                               lifted_idx_ref: Ref (Dict Int),
                               name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, List (String, String), Int) !{IO} =
  translate_match_arm_body_with_test(body, rest_arms, branch_idx, base_idx,
    sprout_ir.IRBlock(dispatch_lbl,
      list_append(
        Cons(sprout_ir.IRStrConst(fresh_name(name_prefix, idx + 1), fresh_name(name_prefix, idx), s),
        Cons(sprout_ir.IRStrEq(fresh_name(name_prefix, idx + 2), s_name,
                               fresh_name(name_prefix, idx + 1)),
        Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx + 3), 1),
        Cons(sprout_ir.IRICmp(fresh_name(name_prefix, idx + 4), "eq",
                              fresh_name(name_prefix, idx + 2),
                              fresh_name(name_prefix, idx + 3)),
        Nil)))),
        Cons(sprout_ir.IRCondBr(fresh_name(name_prefix, idx + 4),
                                fresh_body_label(branch_idx, base_idx),
                                fresh_arm_label(branch_idx + 1, base_idx)), Nil))),
    fresh_body_label(branch_idx, base_idx),
    fresh_arm_label(branch_idx + 1, base_idx),
    join_lbl, match_ty, s_name, tag_name, params, ctors,
    idx + 5, acc_blocks, acc_phi, captures,
    lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
    lifted_idx_ref, name_prefix)

# Translate a CharPattern arm.
# A Char is an immediate i64 codepoint, so the dispatch is an integer compare
# against the codepoint — identical in shape to translate_match_arm_int.
# Emit: %const = const ch; %cmp = icmp eq i64 s_name, const; condbr.
# Fresh name slots:
#   idx   = IRConst (the codepoint)
#   idx+1 = IRICmp i1 result (used in IRCondBr)
fn translate_match_arm_char(ch: Int, body: typed_ast.TypedExpr,
                             rest_arms: List typed_ast.TypedMatchBranch,
                             branch_idx: Int, base_idx: Int,
                             dispatch_lbl: String, join_lbl: String,
                             match_ty: types.Type, s_name: String, tag_name: String,
                             params: List String, ctors: Dict sprout_ir.CtorInfo,
                             idx: Int,
                             acc_blocks: List sprout_ir.IRBlock,
                             acc_phi: List (String, String),
                             captures: Dict String,
                             lifted_ref: Ref (List sprout_ir.IRFunction),
                             top_level: Set,
                             let_names: Set,
                             fn_arities: Dict FnInfo,
                             lambda_ctr_ref: Ref Int,
                             lifted_idx_ref: Ref (Dict Int),
                             name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, List (String, String), Int) !{IO} =
  translate_match_arm_body_with_test(body, rest_arms, branch_idx, base_idx,
    sprout_ir.IRBlock(dispatch_lbl,
      list_append(
        Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx), ch),
        Cons(sprout_ir.IRICmp(fresh_name(name_prefix, idx + 1), "eq", s_name,
                              fresh_name(name_prefix, idx)),
        Nil)),
        Cons(sprout_ir.IRCondBr(fresh_name(name_prefix, idx + 1),
                                fresh_body_label(branch_idx, base_idx),
                                fresh_arm_label(branch_idx + 1, base_idx)), Nil))),
    fresh_body_label(branch_idx, base_idx),
    fresh_arm_label(branch_idx + 1, base_idx),
    join_lbl, match_ty, s_name, tag_name, params, ctors,
    idx + 2, acc_blocks, acc_phi, captures,
    lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
    lifted_idx_ref, name_prefix)

# Translate a ConstructorPattern arm.
# Emits tag test in dispatch_lbl, field binds at body_lbl start, body, recurses via miss_lbl.
fn translate_match_arm_ctor(ctor_name: String, ctor_args: List ast.Pattern,
                             body: typed_ast.TypedExpr,
                             rest_arms: List typed_ast.TypedMatchBranch,
                             branch_idx: Int, base_idx: Int,
                             dispatch_lbl: String, join_lbl: String,
                             match_ty: types.Type, s_name: String, tag_name: String,
                             params: List String, ctors: Dict sprout_ir.CtorInfo,
                             idx: Int,
                             acc_blocks: List sprout_ir.IRBlock,
                             acc_phi: List (String, String),
                             captures: Dict String,
                             lifted_ref: Ref (List sprout_ir.IRFunction),
                             top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                             lambda_ctr_ref: Ref Int,
                             lifted_idx_ref: Ref (Dict Int),
                             name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, List (String, String), Int) !{IO} =
  match dict_get(ctor_name, ctors) with
  | Nothing -> Err("ast_to_ir: unknown constructor '" ++ ctor_name ++ "' in match pattern")
  | Just entry ->
      match entry with
      | sprout_ir.CtorInfo ctor_tag _arity _max_ar fks _ ->
          if ctor_tag == -1
          then
            # Wrap match: the scrutinee IS the inner value — no tag test, no IRGetField.
            # Mirror codegen.sprout ctor_is_wrap path (emit_pattern_bind:1253, emit_ctor_pattern_test:1122).
            # dispatch_lbl gets an unconditional branch to body_lbl; inner arg binds to s_name directly.
            match fresh_arm_label(branch_idx + 1, base_idx) with
            | miss_lbl ->
                match fresh_body_label(branch_idx, base_idx) with
                | body_lbl ->
                    match bind_wrap_inner_arg(ctor_args, s_name, captures) with
                    | Err msg -> Err(msg)
                    | Ok arm_captures ->
                        translate_match_arm_body_with_test_and_ops(body, rest_arms,
                          branch_idx, base_idx,
                          sprout_ir.IRBlock(dispatch_lbl,
                            Cons(sprout_ir.IRBr(body_lbl), Nil)),
                          body_lbl,
                          Nil, Nil,
                          miss_lbl,
                          join_lbl, match_ty, s_name, tag_name,
                          params, ctors, idx, acc_blocks,
                          acc_phi, arm_captures, captures,
                          lifted_ref,
                          top_level, let_names, fn_arities, lambda_ctr_ref,
                          lifted_idx_ref, name_prefix)
          else
            # Regular ADT ctor: emit tag test in dispatch_lbl, bind fields at body_lbl.
            # Field ops start at idx+2 to leave room for the tag_const and cmp SSA names
            # allocated by the dispatch_lbl block.  body_lbl is the entry of the open block;
            # nested ConstructorPatterns may seal body_lbl and introduce extra intermediate
            # blocks before the real body.
            match fresh_arm_label(branch_idx + 1, base_idx) with
            | miss_lbl ->
                match fresh_body_label(branch_idx, base_idx) with
                | body_lbl ->
                    match bind_ctor_field_args(ctor_args, s_name, fks, idx + 2, 0,
                                               name_prefix, Nil, captures,
                                               body_lbl, miss_lbl, ctors, Nil) with
                    | Err msg -> Err(msg)
                    | Ok bound ->
                        match bound with
                        | (extra_blocks, real_body_lbl, field_ops, arm_captures, idx3) ->
                            translate_match_arm_body_with_test_and_ops(body, rest_arms,
                              branch_idx, base_idx,
                              sprout_ir.IRBlock(dispatch_lbl,
                                list_append(
                                  Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx), ctor_tag),
                                  Cons(sprout_ir.IRICmp(fresh_name(name_prefix, idx + 1), "eq",
                                                        tag_name, fresh_name(name_prefix, idx)),
                                  Nil)),
                                  Cons(sprout_ir.IRCondBr(fresh_name(name_prefix, idx + 1),
                                                          body_lbl,
                                                          miss_lbl),
                                  Nil))),
                              real_body_lbl,
                              field_ops,
                              extra_blocks,
                              miss_lbl,
                              join_lbl, match_ty, s_name, tag_name,
                              params, ctors, idx3, acc_blocks,
                              acc_phi, arm_captures, captures,
                              lifted_ref,
                              top_level, let_names, fn_arities, lambda_ctr_ref,
                              lifted_idx_ref, name_prefix)

# Translate body after test block is sealed, no extra preamble ops.
# Int and Bool arm wrapper: captures == outer_captures (no shadowing happens
# in test-only patterns), so we just pass captures both as the body-time
# environment and as the unshadowed dict for rest_arms.
fn translate_match_arm_body_with_test(body: typed_ast.TypedExpr,
                                       rest_arms: List typed_ast.TypedMatchBranch,
                                       branch_idx: Int, base_idx: Int,
                                       test_block: sprout_ir.IRBlock,
                                       body_lbl: String,
                                       miss_lbl: String, join_lbl: String,
                                       match_ty: types.Type, s_name: String,
                                       tag_name: String,
                                       params: List String,
                                       ctors: Dict sprout_ir.CtorInfo,
                                       idx: Int,
                                       acc_blocks: List sprout_ir.IRBlock,
                                       acc_phi: List (String, String),
                                       captures: Dict String,
                                       lifted_ref: Ref (List sprout_ir.IRFunction),
                                       top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                                       lambda_ctr_ref: Ref Int,
                                       lifted_idx_ref: Ref (Dict Int),
                                       name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, List (String, String), Int) !{IO} =
  translate_match_arm_body_with_test_and_ops(body, rest_arms, branch_idx, base_idx,
                                             test_block, body_lbl, Nil, Nil, miss_lbl, join_lbl,
                                             match_ty, s_name, tag_name, params, ctors, idx,
                                             acc_blocks, acc_phi, captures, captures,
                                             lifted_ref, top_level, let_names, fn_arities,
                                             lambda_ctr_ref, lifted_idx_ref, name_prefix)

# Translate body after test block is sealed, with optional preamble ops (field binds)
# and optional extra intermediate blocks emitted by nested constructor patterns.
# /code-review fix #4: takes both `captures` (arm_captures — outer extended with
# this arm's field bindings, used for THIS arm's body) AND `outer_captures` (the
# unshadowed dict, used when recursing into rest_arms).  Int/Bool arms pass the
# same dict for both (no-op).
# extra_blocks: intermediate blocks between test_block and body_lbl, emitted when
# nested ConstructorPatterns require inner tag tests (source order, possibly Nil).
fn translate_match_arm_body_with_test_and_ops(body: typed_ast.TypedExpr,
                                               rest_arms: List typed_ast.TypedMatchBranch,
                                               branch_idx: Int, base_idx: Int,
                                               test_block: sprout_ir.IRBlock,
                                               body_lbl: String,
                                               preamble_ops: List sprout_ir.IROp,
                                               extra_blocks: List sprout_ir.IRBlock,
                                               miss_lbl: String, join_lbl: String,
                                               match_ty: types.Type, s_name: String,
                                               tag_name: String,
                                               params: List String,
                                               ctors: Dict sprout_ir.CtorInfo,
                                               idx: Int,
                                               acc_blocks: List sprout_ir.IRBlock,
                                               acc_phi: List (String, String),
                                               captures: Dict String,
                                               outer_captures: Dict String,
                                               lifted_ref: Ref (List sprout_ir.IRFunction),
                                               top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                                               lambda_ctr_ref: Ref Int,
                                               lifted_idx_ref: Ref (Dict Int),
                                               name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, List (String, String), Int) !{IO} =
  match translate_expr(body, params, ctors, idx, body_lbl, preamble_ops,
                       captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                       name_prefix) with
  | Err msg -> Err(msg)
  | Ok br ->
      match br with
      | (body_blocks, body_cur_lbl, body_cur_ops, body_val, idx1) ->
          # /code-review fix #8: acc_blocks is built reversed (Cons-prepend
          # most-recent block at head).  With nested-pattern extra_blocks, source
          # order for this arm is:
          #   [test_block] ++ extra_blocks ++ body_blocks ++ [body_block_sealed]
          # Reversed (to prepend to acc_blocks):
          #   Cons(body_block_sealed, reverse(body_blocks) ++ reverse(extra_blocks)
          #        ++ Cons(test_block, acc_blocks))
          # The inner list_appends walk only per-arm-small lists — O(B_i + E_i).
          translate_match_arms(rest_arms, branch_idx + 1, base_idx, join_lbl,
                               match_ty, s_name, tag_name, params, ctors, idx1,
                               Cons(sprout_ir.IRBlock(body_cur_lbl,
                                      list_append(body_cur_ops,
                                        Cons(sprout_ir.IRBr(join_lbl), Nil))),
                                    list_append(list_reverse(body_blocks),
                                                list_append(list_reverse(extra_blocks),
                                                            Cons(test_block, acc_blocks)))),
                               Cons((body_val, body_cur_lbl), acc_phi),
                               outer_captures, lifted_ref, top_level, let_names, fn_arities,
                               lambda_ctr_ref, lifted_idx_ref, name_prefix)

# Seal the join block with a phi (or no phi if no incoming edges).
fn finish_match(match_ty: types.Type, s_blocks: List sprout_ir.IRBlock,
                s_final_block: sprout_ir.IRBlock,
                arm_blocks: List sprout_ir.IRBlock,
                phi_incoming: List (String, String),
                join_lbl: String, phi_name: String, idx: Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  # /code-review-v2 #10: s_blocks arrives in SOURCE ORDER from translate_expr
  # (same reason as #9). arm_blocks is reversed inside translate_match_arms but
  # list_reverse'd to source order before being returned (see translate_match_arms
  # Nil base, line ~1415). The Cons-prepend convention is local to
  # translate_match_arms' internal acc_blocks accumulator and does not extend
  # here. Both list_append calls below are O(|s_blocks|) but called ONCE per
  # match expression — bounded, not O(N²) per arm. Widening the convention
  # upstream into translate_expr is a broader refactor and is out of scope.
  match phi_incoming with
  | Nil ->
      # All branches terminate (abort/unreachable); join is unreachable.
      # Return phi_name = "undef" per plan (mirrors old codegen no-edges path).
      Ok((list_append(s_blocks, Cons(s_final_block, arm_blocks)),
          join_lbl, Nil, "undef", idx))
  | _ ->
      Ok((list_append(s_blocks, Cons(s_final_block, arm_blocks)),
          join_lbl,
          Cons(sprout_ir.IRPhi(phi_name, llvm_ret_type(match_ty), phi_incoming), Nil),
          phi_name, idx))

# Translate a TCall node.
#
# Dispatch on the callee shape:
#   - TVar fname _ _ where fname is NOT a parameter → direct named call to
#     @fname.  Recursion just works: a self-call's TVar carries the
#     defining function's own name.
#   - TVar fname _ _ where fname IS a parameter → first-class function
#     value, out of scope for PR 1.5 (would need indirect call lowering).
#   - TGetField _ _ _ _ → method/record-field call, out of scope.
#   - TLambda _ _ _ _ → IIFE / closure application, out of scope.
#   - TDict _ _ _ → typeclass-dictionary dispatch, out of scope.
#   - anything else → "indirect call not yet supported".
#
# Each argument is translated left-to-right via translate_args_scalar (for
# direct fn calls) or translate_args_ctor (for ctor calls); the resulting
# (lbl, ops, idx) is the call site's current block.  PR 1.5 only handles
# scalar (Int) arguments for IRCall; the IRCall lowering hard-codes `i64`
# for every arg position.  The call's LLVM ret-type comes from `call_ty`
# (the TCall node's own inferred type), mapped via llvm_ret_type, which
# returns "i64" for every type post /code-review fix #2 (Bool flows as
# i64 too — 0 or 1 encoded in an i64 register).
# print / eprint dispatch by argument type, mirroring direct codegen's
# emit_print_call / emit_eprint_call (codegen.sprout ~2474):
#   eprint(_)        -> IRPrintStr "eprint_str"  (always String)
#   print(String)    -> IRPrintStr "print_str"   (i64 handle coerced to ptr in lowering)
#   print(Char)      -> IRPrintStr "print_str"   (Char is a String pointer at runtime)
#   print(Int/Bool)  -> IRCall @print_value(i64)  (value already i64-uniform)
# There is no @print symbol in the runtime; a generic call would fail to link.
fn translate_print_call(fname: String, args: List typed_ast.TypedExpr,
                        params: List String, ctors: Dict sprout_ir.CtorInfo, idx: Int,
                        cur_label: String, cur_ops: List sprout_ir.IROp,
                        captures: Dict String,
                        lifted_ref: Ref (List sprout_ir.IRFunction),
                        top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                        lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                        name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match args with
  | Nil ->
      # print() with no args — emit the unit sentinel 0 (mirrors emit_print_call Nil).
      Ok((Nil, cur_label,
           list_append(cur_ops, Cons(sprout_ir.IRConst(fresh_name(name_prefix, idx), 0), Nil)),
           fresh_name(name_prefix, idx), idx + 1))
  | [arg | _] ->
      match translate_expr(arg, params, ctors, idx, cur_label, cur_ops,
                           captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                           name_prefix) with
      | Err msg -> Err(msg)
      | Ok ar ->
          match ar with
          | (ablocks, acur_lbl, acur_ops, a_name, idx1) ->
              if fname == "eprint"
              then Ok((ablocks, acur_lbl,
                        list_append(acur_ops,
                          Cons(sprout_ir.IRPrintStr(fresh_name(name_prefix, idx1), "eprint_str", a_name), Nil)),
                        fresh_name(name_prefix, idx1), idx1 + 1))
              else if is_char_type(typed_ast.typed_expr_type(arg))
              then  # A Char is an i64 codepoint; encode to a String before printing.
                   Ok((ablocks, acur_lbl,
                        list_append(acur_ops,
                          [sprout_ir.IRCall(fresh_name(name_prefix, idx1), sprout_ir.IRTHeap, "char_to_string", Cons(a_name, Nil)),
                           sprout_ir.IRPrintStr(fresh_name(name_prefix, idx1 + 1), "print_str", fresh_name(name_prefix, idx1))]),
                        fresh_name(name_prefix, idx1 + 1), idx1 + 2))
              else if is_string_type(typed_ast.typed_expr_type(arg))
              then Ok((ablocks, acur_lbl,
                        list_append(acur_ops,
                          Cons(sprout_ir.IRPrintStr(fresh_name(name_prefix, idx1), "print_str", a_name), Nil)),
                        fresh_name(name_prefix, idx1), idx1 + 1))
              else Ok((ablocks, acur_lbl,
                        list_append(acur_ops,
                          Cons(sprout_ir.IRCall(fresh_name(name_prefix, idx1), sprout_ir.IRTScalar, "print_value", Cons(a_name, Nil)), Nil)),
                        fresh_name(name_prefix, idx1), idx1 + 1))

# `to_double(n)` — compiler intrinsic (no runtime symbol).  Translate the single
# Int arg, then emit IRSIToF (sitofp) to convert it to the equal Double value.
# Mirrors the print interception: recognized by name in translate_call.
fn translate_to_double_call(args: List typed_ast.TypedExpr,
                            params: List String, ctors: Dict sprout_ir.CtorInfo, idx: Int,
                            cur_label: String, cur_ops: List sprout_ir.IROp,
                            captures: Dict String,
                            lifted_ref: Ref (List sprout_ir.IRFunction),
                            top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                            lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                            name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match args with
  | [arg | _] ->
      match translate_expr(arg, params, ctors, idx, cur_label, cur_ops,
                           captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                           name_prefix) with
      | Err msg -> Err(msg)
      | Ok ar ->
          match ar with
          | (ablocks, acur_lbl, acur_ops, a_name, idx1) ->
              Ok((ablocks, acur_lbl,
                   list_append(acur_ops,
                     Cons(sprout_ir.IRSIToF(fresh_name(name_prefix, idx1), a_name), Nil)),
                   fresh_name(name_prefix, idx1), idx1 + 1))
  | Nil -> Err("ast_to_ir: to_double expects 1 argument, got 0")

# double_to_bits / double_from_bits — raw IEEE 754 bit reinterpretation.
#
# Emits NO IR op. Under the i64-uniform value ABI a Double and an Int are already
# the same LLVM type (both `i64`; a Double travels as its raw bit pattern with no
# tag and no box), so there is nothing to convert: the result IS the argument's
# SSA value. Contrast translate_to_double_call above, which must emit an IRSIToF
# because `to_double` is a NUMERIC conversion and genuinely changes the bits.
#
# So this returns translate_expr's result untouched — not as a shortcut, but
# because any emitted op would be a no-op that only obstructs LLVM. The `fname`
# parameter exists solely to name the right function in the arity diagnostic;
# both directions are the same identity.
#
# See docs/double-bit-access-v0.md and the prelude declarations for why this is a
# compiler intrinsic rather than a runtime builtin (there is no symbol to call).
fn translate_double_bits_call(fname: String, args: List typed_ast.TypedExpr,
                              params: List String, ctors: Dict sprout_ir.CtorInfo, idx: Int,
                              cur_label: String, cur_ops: List sprout_ir.IROp,
                              captures: Dict String,
                              lifted_ref: Ref (List sprout_ir.IRFunction),
                              top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                              lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                              name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match args with
  | [arg | _] ->
      translate_expr(arg, params, ctors, idx, cur_label, cur_ops,
                     captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                     name_prefix)
  | Nil -> Err("ast_to_ir: " ++ fname ++ " expects 1 argument, got 0")

# --- stdlib.bits intrinsics.  docs/bitwise-int-ops-v0.md ---------------------
#
# Recognized by name in translate_call and lowered to one LLVM instruction each,
# the same arrangement as `to_double` / `double_to_bits`: there is no @bit_and
# symbol in the runtime and no APPROVED_BUILTINS entry, because nothing is being
# called.
#
# `bit_not` has no IR op of its own — flipping every bit is xor against -1, so it
# reuses IRIXor with a literal operand (as IRBoolNot does with `xor i64 %x, 1`).
fn bits_plain_op(fname: String, result: String, a: String, b: String) -> Maybe sprout_ir.IROp =
  if fname == "bit_and" then Just(sprout_ir.IRIAnd(result, a, b))
  else if fname == "bit_or" then Just(sprout_ir.IRIOr(result, a, b))
  else if fname == "bit_xor" then Just(sprout_ir.IRIXor(result, a, b))
  else Nothing

fn bits_shift_op(fname: String, result: String, x: String, n: String) -> Maybe sprout_ir.IROp =
  if fname == "bit_shl" then Just(sprout_ir.IRIShl(result, x, n))
  else if fname == "bit_shr" then Just(sprout_ir.IRIAShr(result, x, n))
  else if fname == "bit_shr_zf" then Just(sprout_ir.IRILShr(result, x, n))
  else Nothing

fn is_bits_shift(fname: String) -> Bool =
  fname == "bit_shl" || fname == "bit_shr" || fname == "bit_shr_zf"

export fn is_bits_intrinsic(fname: String) -> Bool =
  fname == "bit_and" || fname == "bit_or" || fname == "bit_xor"
    || fname == "bit_not" || is_bits_shift(fname)

# The value a shift saturates to once the count leaves 0..63.  Shifting a 64-bit
# word by 64 or more leaves nothing of it — except for the ARITHMETIC right
# shift, whose limit is the sign bit smeared across the whole word, which is
# what `ashr x, 63` produces for both signs.
fn bits_saturate_op(fname: String, result: String, x: String) -> sprout_ir.IROp =
  if fname == "bit_shr" then sprout_ir.IRIAShr(result, x, "63")
  else sprout_ir.IRConst(result, 0)

# Guard CFG for a shift whose count is not a literal.  LLVM's shl/ashr/lshr are
# POISON for a count at or above the bit width, so the count must be bounded
# before the instruction is reached — the same undefined-behaviour class the
# division-by-zero guard closed (finish_checked_div above), and the reason this
# cannot be done at the ir_lowering text layer: splitting blocks there breaks
# phi predecessors.
#
# Emits five blocks.  The negative-count arm panics (noreturn, so it needs no
# join edge); the >= 64 arm materialises the saturated value; the in-range arm
# does the shift; and a join phi selects between the latter two.  The join block
# becomes the new current block, so downstream phis name it as their predecessor.
#
# The `sgt 63` test is signed and correct because the negative case has already
# branched away, so the value reaching it is known non-negative.
#
# Consumes 7 fresh-name slots: neg-cmp, msg-raw, msg, ovf-cmp, saturated,
# shifted, phi.
fn finish_checked_shift(fname: String,
                        xblocks: List sprout_ir.IRBlock, nblocks: List sprout_ir.IRBlock,
                        cur_lbl: String, cur_ops: List sprout_ir.IROp,
                        x_name: String, n_name: String,
                        idx: Int, name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  match bits_shift_op(fname, shifted, x_name, n_name) with
  | Nothing -> Err("ast_to_ir: finish_checked_shift on non-shift " ++ fname)
  | Just do_op ->
      Ok((list_append(list_append(xblocks, nblocks),
                      [cond_block, panic_block, chk_block, sat_block,
                       sprout_ir.IRBlock(do_lbl,
                         [do_op, sprout_ir.IRBr(join_lbl)])]),
          join_lbl, Cons(phi_op, Nil), phi_result, idx + 7))
  where neg_name = fresh_name(name_prefix, idx)
        msg_raw = fresh_name(name_prefix, idx + 1)
        msg_result = fresh_name(name_prefix, idx + 2)
        ovf_name = fresh_name(name_prefix, idx + 3)
        sat_value = fresh_name(name_prefix, idx + 4)
        shifted = fresh_name(name_prefix, idx + 5)
        phi_result = fresh_name(name_prefix, idx + 6)
        panic_lbl = "shiftpanic_" ++ int_to_string(idx)
        chk_lbl = "shiftchk_" ++ int_to_string(idx)
        sat_lbl = "shiftsat_" ++ int_to_string(idx)
        do_lbl = "shiftdo_" ++ int_to_string(idx)
        join_lbl = "shiftjoin_" ++ int_to_string(idx)
        cond_block = sprout_ir.IRBlock(cur_lbl,
                       list_append(cur_ops,
                         [sprout_ir.IRICmp(neg_name, "slt", n_name, "0"),
                          sprout_ir.IRCondBr(neg_name, panic_lbl, chk_lbl)]))
        panic_block = sprout_ir.IRBlock(panic_lbl,
                        [sprout_ir.IRStrConst(msg_result, msg_raw,
                           fname ++ ": negative shift count"),
                         sprout_ir.IRPanic(msg_result)])
        chk_block = sprout_ir.IRBlock(chk_lbl,
                      [sprout_ir.IRICmp(ovf_name, "sgt", n_name, "63"),
                       sprout_ir.IRCondBr(ovf_name, sat_lbl, do_lbl)])
        sat_block = sprout_ir.IRBlock(sat_lbl,
                      [bits_saturate_op(fname, sat_value, x_name),
                       sprout_ir.IRBr(join_lbl)])
        phi_op = sprout_ir.IRPhi(phi_result, "i64",
                   [(sat_value, sat_lbl), (shifted, do_lbl)])

# A shift whose count is an integer LITERAL needs no guard at all: the domain is
# decided at compile time.  In range, the count becomes an immediate operand
# (`shl i64 %x, 14`), so a mask or field extract is one instruction with no
# branch and no block — which is the whole reason the guard above is acceptable.
#
# A literal count of 64 or more folds to the saturated value.  A literal NEGATIVE
# count is rejected outright: the dynamic case can only panic at run time, but a
# statically known one is a program that cannot be right, and Go and Zig reject
# constant out-of-range shifts at compile time for the same reason.
fn translate_folded_shift(fname: String, n: Int,
                          xblocks: List sprout_ir.IRBlock, cur_lbl: String,
                          cur_ops: List sprout_ir.IROp, x_name: String,
                          idx: Int, name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  if n < 0 then
    Err("ast_to_ir: " ++ fname ++ " shift count is negative (" ++ int_to_string(n)
          ++ "); a shift count must be 0 or greater")
  else if n > 63 then
    Ok((xblocks, cur_lbl,
        list_append(cur_ops, Cons(bits_saturate_op(fname, result, x_name), Nil)),
        result, idx + 1))
  else
    match bits_shift_op(fname, result, x_name, int_to_string(n)) with
    | Nothing -> Err("ast_to_ir: translate_folded_shift on non-shift " ++ fname)
    | Just op ->
        Ok((xblocks, cur_lbl, list_append(cur_ops, Cons(op, Nil)), result, idx + 1))
  where result = fresh_name(name_prefix, idx)

fn translate_bits_call(fname: String, args: List typed_ast.TypedExpr,
                       params: List String, ctors: Dict sprout_ir.CtorInfo, idx: Int,
                       cur_label: String, cur_ops: List sprout_ir.IROp,
                       captures: Dict String,
                       lifted_ref: Ref (List sprout_ir.IRFunction),
                       top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                       lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                       name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match args with
  | [x, n | _] ->
      match translate_expr(x, params, ctors, idx, cur_label, cur_ops,
                           captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                           name_prefix) with
      | Err msg -> Err(msg)
      | Ok xr ->
          match xr with
          | (xblocks, xlbl, xops, x_name, idx1) ->
              if is_bits_shift(fname) then
                # A literal count is folded; anything else gets the guard.  The
                # literal's own translation is skipped entirely — an immediate
                # operand costs no instruction, and a TInt has no side effects to
                # preserve.
                match n with
                | typed_ast.TInt count _ _ ->
                    translate_folded_shift(fname, count, xblocks, xlbl, xops, x_name,
                                           idx1, name_prefix)
                | _ ->
                    match translate_expr(n, params, ctors, idx1, xlbl, xops,
                                         captures, lifted_ref, top_level, let_names, fn_arities,
                                         lambda_ctr_ref, lifted_idx_ref, name_prefix) with
                    | Err msg -> Err(msg)
                    | Ok nr ->
                        match nr with
                        | (nblocks, nlbl, nops, n_name, idx2) ->
                            finish_checked_shift(fname, xblocks, nblocks, nlbl, nops,
                                                 x_name, n_name, idx2, name_prefix)
              else
                match translate_expr(n, params, ctors, idx1, xlbl, xops,
                                     captures, lifted_ref, top_level, let_names, fn_arities,
                                     lambda_ctr_ref, lifted_idx_ref, name_prefix) with
                | Err msg -> Err(msg)
                | Ok nr ->
                    match nr with
                    | (nblocks, nlbl, nops, n_name, idx2) ->
                        match bits_plain_op(fname, fresh_name(name_prefix, idx2), x_name, n_name) with
                        | Nothing ->
                            Err("ast_to_ir: " ++ fname ++ " expects 1 argument, got 2")
                        | Just op ->
                            Ok((list_append(xblocks, nblocks), nlbl,
                                list_append(nops, Cons(op, Nil)),
                                fresh_name(name_prefix, idx2), idx2 + 1))
  | [x | _] ->
      if fname == "bit_not" then
        match translate_expr(x, params, ctors, idx, cur_label, cur_ops,
                             captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                             name_prefix) with
        | Err msg -> Err(msg)
        | Ok xr ->
            match xr with
            | (xblocks, xlbl, xops, x_name, idx1) ->
                Ok((xblocks, xlbl,
                    list_append(xops,
                      Cons(sprout_ir.IRIXor(fresh_name(name_prefix, idx1), x_name, "-1"), Nil)),
                    fresh_name(name_prefix, idx1), idx1 + 1))
      else Err("ast_to_ir: " ++ fname ++ " expects 2 arguments, got 1")
  | Nil -> Err("ast_to_ir: " ++ fname ++ " expects arguments, got 0")

fn translate_call(callee: typed_ast.TypedExpr, args: List typed_ast.TypedExpr,
                  call_ty: types.Type, params: List String,
                  ctors: Dict sprout_ir.CtorInfo, idx: Int,
                  cur_label: String, cur_ops: List sprout_ir.IROp,
                  captures: Dict String,
                  lifted_ref: Ref (List sprout_ir.IRFunction),
                  top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                  lambda_ctr_ref: Ref Int,
                  lifted_idx_ref: Ref (Dict Int),
                  name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match callee with
  | typed_ast.TVar fname _ _ ->
      # Check captures first: a free var of function type stored in the env
      # must be called via IRApplyClosure.
      match dict_get(fname, captures) with
      | Just cap_ssa ->
          # captured free var — must be a closure; emit IRApplyClosure.
          translate_closure_call(cap_ssa, args, params, ctors, idx, cur_label, cur_ops,
                                 captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                                 name_prefix)
      | Nothing ->
          # print / eprint are builtins that dispatch by argument type, mirroring
          # direct codegen's emit_print_call (codegen.sprout ~2474): String/Char ->
          # @print_str(ptr), Int/Bool -> @print_value(i64), eprint -> @eprint_str(ptr).
          # There is no @print symbol in the runtime, so a generic call would not link.
          if fname == "print" || fname == "eprint"
          then translate_print_call(fname, args, params, ctors, idx,
                                    cur_label, cur_ops, captures, lifted_ref, top_level, let_names, fn_arities,
                                    lambda_ctr_ref, lifted_idx_ref, name_prefix)
          else if fname == "to_double"
          then translate_to_double_call(args, params, ctors, idx,
                                        cur_label, cur_ops, captures, lifted_ref, top_level, let_names, fn_arities,
                                        lambda_ctr_ref, lifted_idx_ref, name_prefix)
          else if fname == "double_to_bits" || fname == "double_from_bits"
          then translate_double_bits_call(fname, args, params, ctors, idx,
                                          cur_label, cur_ops, captures, lifted_ref, top_level, let_names, fn_arities,
                                          lambda_ctr_ref, lifted_idx_ref, name_prefix)
          else if is_bits_intrinsic(fname)
          then translate_bits_call(fname, args, params, ctors, idx,
                                   cur_label, cur_ops, captures, lifted_ref, top_level, let_names, fn_arities,
                                   lambda_ctr_ref, lifted_idx_ref, name_prefix)
          else if param_known(fname, params)
          then
            # Trust the typechecker: any param reached here was accepted as
            # callable at the call site. No defensive type check — that would
            # contradict the is_supported_arg_type trust contract and create an
            # asymmetry with the captures branch above.
            translate_closure_call("%" ++ fname, args, params, ctors, idx,
                                   cur_label, cur_ops, captures, lifted_ref, top_level, let_names, fn_arities,
                                   lambda_ctr_ref, lifted_idx_ref, name_prefix)
          else if set_member(fname, let_names)
          then
            # Top-level `let` bound to a closure value: load the global slot,
            # then apply via IRApplyClosure.  Mirrors the bare-TVar IRLoadGlobal
            # path (translate_expr ~706) followed by translate_closure_call.  A
            # direct `call @<name>` here would jump into the global's data slot
            # (SIGSEGV).  fresh_name is deterministic, so the load result and the
            # closure-call callee SSA agree; arg evaluation advances from idx + 1.
            translate_closure_call(fresh_name(name_prefix, idx), args, params, ctors,
                                   idx + 1, cur_label,
                                   list_append(cur_ops,
                                     Cons(sprout_ir.IRLoadGlobal(fresh_name(name_prefix, idx), fname), Nil)),
                                   captures, lifted_ref, top_level, let_names, fn_arities,
                                   lambda_ctr_ref, lifted_idx_ref, name_prefix)
          else
            # Constructor application takes precedence over named-call dispatch
            # because a ctor name is never simultaneously a function.  M3 PR 2:
            # CPR-eligible ctors are routed through the same boxed allocation
            # path as non-CPR ctors; the unboxing sret optimization lands in
            # PR 2b alongside the IRMakeCprCtor op and the bulletproofing
            # layers (CprAbi ADT, single-source ABI, post-codegen lint).
            match dict_get(fname, ctors) with
            | Just entry ->
                match entry with
                | sprout_ir.CtorInfo tag actual_ar _max_ar _fks _ ->
                    translate_boxed_ctor_call(fname, tag, actual_ar, args, params,
                                              ctors, idx, cur_label, cur_ops,
                                              captures, lifted_ref, top_level, let_names, fn_arities,
                                              lambda_ctr_ref, lifted_idx_ref,
                                              name_prefix)
            | Nothing ->
                translate_direct_call(fname, args, call_ty, params, ctors, idx,
                                      cur_label, cur_ops, captures, lifted_ref, top_level, let_names, fn_arities,
                                      lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | typed_ast.TLambda lparams lbody _lam_ty _ ->
      # Directly-applied lambda (IIFE): (\x -> body)(arg) — the desugaring of
      # `let x = arg in body` and `where x = arg`.
      # FIX #6: check arity before emitting any IR; partial application is not
      # yet supported (each IRApplyClosure call is one application).
      if list_length(lparams) != list_length(args)
      then Err("ast_to_ir: closure arity mismatch (lambda expects " ++
               int_to_string(list_length(lparams)) ++ " args, got " ++
               int_to_string(list_length(args)) ++ ") — partial application not yet supported")
      else
      # Arc (b): beta-reduce the IIFE INLINE instead of lifting a heap closure +
      # indirect apply. Evaluate each arg once in the outer scope, bind param -> its
      # arg SSA in `captures`, and translate the body in place (the do-`let` path).
      # An IIFE is applied exactly once, so inlining never duplicates the body — no
      # code bloat. Inlining is value-preserving (the IIFE result IS the body's value,
      # never a first-class closure) and keeps any recursive tail call in the body a
      # direct call, so mutual-TCO (musttail) can fire through a `where`/`let..in`.
      # See docs/mutual-tco-v0.md "arc (b)".
      match translate_args_scalar(args, params, ctors, idx, cur_label, cur_ops, Nil, Nil,
                                  captures, lifted_ref, top_level, let_names, fn_arities,
                                  lambda_ctr_ref, lifted_idx_ref, name_prefix) with
      | Err msg -> Err(msg)
      | Ok ar ->
          match ar with
          | (arg_blocks, arg_lbl, arg_ops, arg_names, idx1) ->
              # Bind params AFTER evaluating args: args see the outer scope
              # (call-by-value), the body sees params shadowing it (lexical scope).
              match translate_expr(lbody, params, ctors, idx1, arg_lbl, arg_ops,
                                   bind_params(fv_param_names(lparams), arg_names, captures),
                                   lifted_ref, top_level, let_names, fn_arities,
                                   lambda_ctr_ref, lifted_idx_ref, name_prefix) with
              | Err msg -> Err(msg)
              | Ok br ->
                  match br with
                  | (body_blocks, body_lbl, body_ops, body_result, idx2) ->
                      Ok((list_append(arg_blocks, body_blocks), body_lbl, body_ops,
                           body_result, idx2))
  | typed_ast.TCall inner_callee inner_args inner_ty _ ->
      # Chained curried call: f(x)(y) where the inner TCall returns a closure.
      # Translate the inner call to get the closure SSA value, then apply it
      # to the outer args via IRApplyClosure.
      match translate_call(inner_callee, inner_args, inner_ty, params, ctors, idx,
                           cur_label, cur_ops, captures, lifted_ref, top_level, let_names, fn_arities,
                           lambda_ctr_ref, lifted_idx_ref, name_prefix) with
      | Err msg -> Err(msg)
      | Ok ir ->
          match ir with
          | (inner_blocks, inner_lbl, inner_ops, inner_result, idx1) ->
              match translate_closure_call(inner_result, args, params, ctors, idx1,
                                           inner_lbl, inner_ops,
                                           captures, lifted_ref, top_level, let_names, fn_arities,
                                           lambda_ctr_ref, lifted_idx_ref, name_prefix) with
              | Err msg -> Err(msg)
              | Ok cr ->
                  match cr with
                  | (call_blocks, call_lbl, call_ops, call_result, idx2) ->
                      Ok((list_append(inner_blocks, call_blocks), call_lbl, call_ops,
                           call_result, idx2))
  | typed_ast.TGetField _ _ _ _ ->
      # A call whose callee is a record field access (`v.render(x)`): load the
      # field's closure value into an SSA, then apply the args to it via
      # IRApplyClosure — the same shape as the chained-call (TCall) arm above.
      match translate_expr(callee, params, ctors, idx, cur_label, cur_ops,
                           captures, lifted_ref, top_level, let_names, fn_arities,
                           lambda_ctr_ref, lifted_idx_ref, name_prefix) with
      | Err msg -> Err(msg)
      | Ok fr ->
          match fr with
          | (field_blocks, field_lbl, field_ops, field_result, idx1) ->
              match translate_closure_call(field_result, args, params, ctors, idx1,
                                           field_lbl, field_ops,
                                           captures, lifted_ref, top_level, let_names, fn_arities,
                                           lambda_ctr_ref, lifted_idx_ref, name_prefix) with
              | Err msg -> Err(msg)
              | Ok cr ->
                  match cr with
                  | (call_blocks, call_lbl, call_ops, call_result, idx2) ->
                      Ok((list_append(field_blocks, call_blocks), call_lbl, call_ops,
                           call_result, idx2))
  | typed_ast.TDict _ _ _ _ -> Err("ast_to_ir: typeclass dispatch call not yet supported")
  | _ -> Err("ast_to_ir: indirect call not yet supported")

# Evaluate args left-to-right, then emit IRApplyClosure(result, callee_ssa, arg_names).
# Used for: (a) fn-typed params, (b) captured free vars, (c) IIFE closures.
# TODO(PR 2.5): reject partial application (fewer args than TFunc arity).
# Currently accepts any arg count; callee type is not checked here.
# O(n) in number of args.
fn translate_closure_call(callee_ssa: String, args: List typed_ast.TypedExpr,
                          params: List String, ctors: Dict sprout_ir.CtorInfo,
                          idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                          captures: Dict String,
                          lifted_ref: Ref (List sprout_ir.IRFunction),
                          top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                          lambda_ctr_ref: Ref Int,
                          lifted_idx_ref: Ref (Dict Int),
                          name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match translate_args_scalar(args, params, ctors, idx, cur_label, cur_ops, Nil, Nil,
                              captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                              name_prefix) with
  | Err msg -> Err(msg)
  | Ok r ->
      match r with
      | (arg_blocks, arg_cur_lbl, arg_cur_ops, arg_names, idx1) ->
          Ok((arg_blocks, arg_cur_lbl,
               list_append(arg_cur_ops,
                 Cons(sprout_ir.IRApplyClosure(fresh_name(name_prefix, idx1), callee_ssa, arg_names), Nil)),
               fresh_name(name_prefix, idx1), idx1 + 1))

# Boxed n-arity constructor application.  Mirrors the legacy codegen's
# `emit_ctor_call_expr` for the `n_args == n_arity` branch: evaluate args
# left-to-right, then emit a single IRMakeCtor.  Partial application is NOT
# supported at this milestone (legacy emits closures for `n_args < n_arity`,
# IR codegen does not yet have closure infrastructure).
#
# `actual_ar` is the per-ctor field count from the ctor-table.  We validate
# that the call-site provides exactly that many arguments before emitting IR.
fn translate_boxed_ctor_call(name: String, tag: Int, actual_ar: Int,
                             args: List typed_ast.TypedExpr,
                             params: List String, ctors: Dict sprout_ir.CtorInfo,
                             idx: Int, cur_label: String,
                             cur_ops: List sprout_ir.IROp,
                             captures: Dict String,
                             lifted_ref: Ref (List sprout_ir.IRFunction),
                             top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                             lambda_ctr_ref: Ref Int,
                             lifted_idx_ref: Ref (Dict Int),
                             name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  # Wrap ctor: identity — evaluate the single inner arg and return its SSA unchanged.
  # Mirrors codegen.sprout ctor_is_wrap path (emit_wrap_ctor_wrapper:1924):
  #   "Wrap ctor used in value position: closure wrapper is identity."
  # tag == -1 is the wrap sentinel (mirrors codegen.sprout wrap_tag() = -1).
  if tag == -1
  then
    match translate_args_ctor(args, params, ctors, idx, cur_label, cur_ops, Nil, Nil,
                              captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                              name_prefix) with
    | Err msg -> Err(msg)
    | Ok r ->
        match r with
        | (arg_blocks, arg_cur_lbl, arg_cur_ops, arg_names, idx1) ->
            match arg_names with
            | [inner_ssa] -> Ok((arg_blocks, arg_cur_lbl, arg_cur_ops, inner_ssa, idx1))
            | _ -> Err("ast_to_ir: wrap ctor must have exactly one field")
  else
  # The field-count ceiling is enforced by finish_make_ctor below, the single
  # exit every construction path shares; an over-wide ctor errors there.
  if list_length(args) != actual_ar
  then Err("ast_to_ir: ctor application has wrong arity (got " ++ int_to_string(list_length(args)) ++ ", expected " ++ int_to_string(actual_ar) ++ ")")
  else
    match translate_args_ctor(args, params, ctors, idx, cur_label, cur_ops, Nil, Nil,
                              captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                              name_prefix) with
    | Err msg -> Err(msg)
    | Ok r ->
        match r with
        | (arg_blocks, arg_cur_lbl, arg_cur_ops, arg_names, idx1) ->
            finish_make_ctor("constructor", name, tag, arg_names,
                             arg_blocks, arg_cur_lbl, arg_cur_ops, idx1, name_prefix)

type StringBuiltin (..) =
  | SBStrConcat
  | SBStrSlice
  | SBIntToString

fn recognize_string_builtin(fname: String) -> Maybe StringBuiltin =
  if fname == "str_concat" then Just(SBStrConcat)
  else if fname == "str_slice" then Just(SBStrSlice)
  else if fname == "int_to_string" then Just(SBIntToString)
  else Nothing

# Handle the `append` / `++` Semigroup method.
#
# The parser desugars `a ++ b` to CallExpr("append", [a, b]).  When no import
# brings the Semigroup class into scope, the typeclass lowering emits no dict
# witness and the call reaches translate_direct_call as TCall(TVar "append",
# [a, b]).  When a dict witness is present the arg list has 3 elements:
# [TDict ..., left, right].  Both shapes are accepted here; the dict arg is
# skipped if present.
#
# Mirrors codegen.sprout emit_append_call / emit_append_operands (~2591).
fn translate_append_call(args: List typed_ast.TypedExpr, call_ty: types.Type,
                         params: List String,
                         ctors: Dict sprout_ir.CtorInfo, idx: Int,
                         cur_label: String, cur_ops: List sprout_ir.IROp,
                         captures: Dict String,
                         lifted_ref: Ref (List sprout_ir.IRFunction),
                         top_level: Set,
                         let_names: Set,
                         fn_arities: Dict FnInfo,
                         lambda_ctr_ref: Ref Int,
                         lifted_idx_ref: Ref (Dict Int),
                         name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match args with
  | [typed_ast.TDict _ _ _ _, left, right | ws] ->
      translate_append_operands(left, right, append_witness(ws), call_ty, params, ctors, idx,
                                cur_label, cur_ops, captures, lifted_ref, top_level, let_names,
                                fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | [left, right | ws] ->
      translate_append_operands(left, right, append_witness(ws), call_ty, params, ctors, idx,
                                cur_label, cur_ops, captures, lifted_ref, top_level, let_names,
                                fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | _ -> Err("ast_to_ir: append expects at least 2 arguments")

# The Semigroup dictionary witness lowering appends after the two value operands
# (user args first, then dict witnesses).  Semigroup has one method (`append`), so
# at most one witness trails; take it if present.
fn append_witness(ws: List typed_ast.TypedExpr) -> Maybe typed_ast.TypedExpr =
  match ws with
  | Nil -> Nothing
  | [w | _] -> Just(w)

fn translate_append_operands(left: typed_ast.TypedExpr, right: typed_ast.TypedExpr,
                              witness: Maybe typed_ast.TypedExpr,
                              call_ty: types.Type,
                              params: List String,
                              ctors: Dict sprout_ir.CtorInfo, idx: Int,
                              cur_label: String, cur_ops: List sprout_ir.IROp,
                              captures: Dict String,
                              lifted_ref: Ref (List sprout_ir.IRFunction),
                              top_level: Set,
                              let_names: Set,
                              fn_arities: Dict FnInfo,
                              lambda_ctr_ref: Ref Int,
                              lifted_idx_ref: Ref (Dict Int),
                              name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  if is_string_type(typed_ast.typed_expr_type(left)) || is_string_type(call_ty) then
    # String ++ String → IRStrConcat.  Mirrors the translate_binary "++" path
    # at ~line 1513 and codegen.sprout emit_append_operands (~2600).
    match translate_expr(left, params, ctors, idx, cur_label, cur_ops,
                         captures, lifted_ref, top_level, let_names, fn_arities,
                         lambda_ctr_ref, lifted_idx_ref, name_prefix) with
    | Err msg -> Err(msg)
    | Ok lr ->
        match lr with
        | (lblocks, lcur_lbl, lcur_ops, l_name, idx1) ->
            match translate_expr(right, params, ctors, idx1, lcur_lbl, lcur_ops,
                                 captures, lifted_ref, top_level, let_names, fn_arities,
                                 lambda_ctr_ref, lifted_idx_ref, name_prefix) with
            | Err msg -> Err(msg)
            | Ok rr ->
                match rr with
                | (rblocks, rcur_lbl, rcur_ops, r_name, idx2) ->
                    Ok((list_append(lblocks, rblocks), rcur_lbl,
                         list_append(rcur_ops,
                           Cons(sprout_ir.IRStrConcat(fresh_name(name_prefix, idx2), l_name, r_name), Nil)),
                         fresh_name(name_prefix, idx2), idx2 + 1))
  else if is_list_type(typed_ast.typed_expr_type(left)) || is_list_type(call_ty) then
    # List ++ List → call @list_append.  Mirrors codegen.sprout (~2611).
    match translate_args_scalar([left, right], params, ctors, idx, cur_label, cur_ops, Nil, Nil,
                                captures, lifted_ref, top_level, let_names, fn_arities,
                                lambda_ctr_ref, lifted_idx_ref, name_prefix) with
    | Err msg -> Err(msg)
    | Ok r ->
        match r with
        | (arg_blocks, arg_cur_lbl, arg_cur_ops, arg_names, idx1) ->
            match arg_names with
            | [l_name, r_name] ->
                Ok((arg_blocks, arg_cur_lbl,
                     list_append(arg_cur_ops,
                       Cons(sprout_ir.IRCall(fresh_name(name_prefix, idx1), sprout_ir.IRTHeap, "list_append", [l_name, r_name]), Nil)),
                     fresh_name(name_prefix, idx1), idx1 + 1))
            | _ -> Err("ast_to_ir: append (list): expected exactly 2 translated args")
  else
    # Every other type dispatches through the resolved Semigroup instance.  The
    # checker attaches the dictionary and lowering leaves it as the trailing
    # `witness` — a `TVar` naming the instance method for a concrete type
    # (`__tc_Semigroup_<T>_append`, a direct call) or the enclosing function's
    # dict parameter for a polymorphic site (a closure apply).  translate_call
    # picks the right calling convention for either.  `Vec`/`Dict`/user instances
    # all reach here; String/List are handled above only as a peephole.
    match witness with
    | Just w ->
        translate_call(w, [left, right], call_ty, params, ctors, idx,
                       cur_label, cur_ops, captures, lifted_ref, top_level, let_names,
                       fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix)
    | Nothing ->
        Err("ast_to_ir: `++`/append on a non-String/List type with no resolved Semigroup witness")

fn translate_direct_call(fname: String, args: List typed_ast.TypedExpr,
                         call_ty: types.Type, params: List String,
                         ctors: Dict sprout_ir.CtorInfo, idx: Int,
                         cur_label: String, cur_ops: List sprout_ir.IROp,
                         captures: Dict String,
                         lifted_ref: Ref (List sprout_ir.IRFunction),
                         top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                         lambda_ctr_ref: Ref Int,
                         lifted_idx_ref: Ref (Dict Int),
                         name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  # The String/List `++` peephole (str_concat / list_append) keys on the mangled
  # Semigroup dispatch identity, NOT the source name "append".  lowering rewrites
  # every genuine Semigroup append callee to "__cm_Semigroup_append"
  # (classmethod_dispatch_name); a user top-level `fn append` keeps its bare name
  # and falls through to the normal call path below, never hijacked here.
  if fname == "__cm_Semigroup_append" then
    translate_append_call(args, call_ty, params, ctors, idx, cur_label, cur_ops,
                          captures, lifted_ref, top_level, let_names, fn_arities,
                          lambda_ctr_ref, lifted_idx_ref, name_prefix)
  else
  match recognize_string_builtin(fname) with
  | Just kind -> translate_string_builtin(kind, fname, args, params, ctors, idx,
                                          cur_label, cur_ops, captures, lifted_ref, top_level, let_names, fn_arities,
                                          lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | Nothing ->
      # FIX R4#3: removed the is_string_type(call_ty) rejection that was here.
      # All IR values are i64 — String-returning user fns are i64 just like Int.
      # The check was a placeholder from PR 1.5 that blocked capturing-IIFE-returning-String.
      match translate_args_scalar(args, params, ctors, idx, cur_label, cur_ops, Nil, Nil,
                                  captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                                  name_prefix) with
      | Err msg -> Err(msg)
      | Ok r ->
          match r with
          | (arg_blocks, arg_cur_lbl, arg_cur_ops, arg_names, idx1) ->
              # B1: inline Vector element access. try_vector_intrinsic recognizes the
              # op (by name), gates on full application (an under-applied call falls
              # through to translate_general_call, which rejects it — inference should
              # already have) and on the element representation; Nothing = general path.
              match try_vector_intrinsic(fname, args, arg_blocks, arg_cur_lbl,
                                         arg_cur_ops, arg_names, idx1, fn_arities, name_prefix) with
              | Just r -> r
              | Nothing ->
                  translate_general_call(fname, call_ty, arg_blocks, arg_cur_lbl,
                                         arg_cur_ops, arg_names, idx1, fn_arities,
                                         lifted_ref, lambda_ctr_ref, name_prefix)

fn translate_string_builtin(kind: StringBuiltin, fname: String,
                            args: List typed_ast.TypedExpr,
                            params: List String, ctors: Dict sprout_ir.CtorInfo,
                            idx: Int,
                            cur_label: String, cur_ops: List sprout_ir.IROp,
                            captures: Dict String,
                            lifted_ref: Ref (List sprout_ir.IRFunction),
                            top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                            lambda_ctr_ref: Ref Int,
                            lifted_idx_ref: Ref (Dict Int),
                            name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match translate_args_scalar(args, params, ctors, idx, cur_label, cur_ops, Nil, Nil,
                              captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                              name_prefix) with
  | Err msg -> Err(msg)
  | Ok r ->
      match r with
      | (arg_blocks, arg_cur_lbl, arg_cur_ops, arg_names, idx1) ->
          finish_string_builtin(kind, fname, arg_blocks, arg_cur_lbl,
                                arg_cur_ops, arg_names, idx1, name_prefix)

fn finish_string_builtin(kind: StringBuiltin, fname: String,
                         arg_blocks: List sprout_ir.IRBlock, cur_lbl: String,
                         cur_ops: List sprout_ir.IROp, arg_names: List String,
                         idx: Int, name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  match kind with
  | SBStrConcat ->
      match arg_names with
      | [a, b] ->
          Ok((arg_blocks, cur_lbl,
               list_append(cur_ops, Cons(sprout_ir.IRStrConcat(result, a, b), Nil)),
               result, idx + 1))
      | _ -> Err("ast_to_ir: str_concat expects 2 arguments")
  | SBStrSlice ->
      match arg_names with
      | [s, st, ln] ->
          Ok((arg_blocks, cur_lbl,
               list_append(cur_ops, Cons(sprout_ir.IRStrSlice(result, s, st, ln), Nil)),
               result, idx + 1))
      | _ -> Err("ast_to_ir: str_slice expects 3 arguments")
  | SBIntToString ->
      match arg_names with
      | [n] ->
          Ok((arg_blocks, cur_lbl,
               list_append(cur_ops, Cons(sprout_ir.IRStrFromInt(result, n), Nil)),
               result, idx + 1))
      | _ -> Err("ast_to_ir: int_to_string expects 1 argument")
  where result = fresh_name(name_prefix, idx)

fn finish_direct_call(fname: String, call_ty: types.Type,
                      arg_blocks: List sprout_ir.IRBlock, arg_cur_lbl: String,
                      arg_cur_ops: List sprout_ir.IROp, arg_names: List String,
                      idx: Int, name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  Ok((arg_blocks, arg_cur_lbl,
       list_append(arg_cur_ops, Cons(call_op, Nil)),
       result, idx + 1))
  where result = fresh_name(name_prefix, idx)
        call_op = sprout_ir.IRCall(result, ret_irtype(call_ty),
                                   fname, arg_names)

# The general (non-intrinsic) call path: under-applied a known-arity fn → loud
# internal error (inference should have rejected it); fully applied (or unknown
# arity) → direct call. Reached when try_vector_intrinsic declines. Extracted so
# the dispatch site's outer match has a single-expression arm (avoids same-column
# nested-match layout ambiguity).
fn translate_general_call(fname: String, call_ty: types.Type,
                          arg_blocks: List sprout_ir.IRBlock, cur_lbl: String,
                          cur_ops: List sprout_ir.IROp, arg_names: List String,
                          idx: Int, fn_arities: Dict FnInfo,
                          lifted_ref: Ref (List sprout_ir.IRFunction),
                          lambda_ctr_ref: Ref Int, name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  match dict_get(fname, fn_arities) with
  | Just info ->
      # Under-application of a known-arity direct fn is rejected in inference
      # (infer.under_application_error, n-ary Package C-b), so it never reaches
      # codegen. If it does, the arity check leaked — fail loudly rather than
      # silently synthesize a partial wrapper (precise-or-loud; the wrapper path is
      # retired). `_`-placeholder partials build ordinary lambdas, not this path.
      if info.arity > list_length(arg_names)
      then Err("internal error: under-application of '" ++ fname ++ "' reached codegen (arity "
                 ++ int_to_string(info.arity) ++ ", got " ++ int_to_string(list_length(arg_names))
                 ++ "); the n-ary arity check should have rejected it before lowering")
      # Over-application is the same leak in the other direction, and it used to
      # fall through to a direct call carrying the surplus arguments. LLVM drops
      # them silently — the call returned the closure handle as the result type,
      # exit 0, no diagnostic. The surplus cannot be re-applied as one group here
      # either: the closure's runtime arity follows the BODY (`\ (x, y) -> …` is
      # one two-argument closure, `\x -> \y -> …` two one-argument ones), which
      # this site cannot see. infer.over_application_error rejects it first.
      else if info.arity < list_length(arg_names)
      then Err("internal error: over-application of '" ++ fname ++ "' reached codegen (arity "
                 ++ int_to_string(info.arity) ++ ", got " ++ int_to_string(list_length(arg_names))
                 ++ "); the n-ary arity check should have rejected it before lowering")
      else finish_direct_call(fname, call_ty, arg_blocks, cur_lbl,
                              cur_ops, arg_names, idx, name_prefix)
  | Nothing ->
      finish_direct_call(fname, call_ty, arg_blocks, cur_lbl,
                         cur_ops, arg_names, idx, name_prefix)

# B1 Vector-Double gate. True when the first argument's static type is a
# `Vector Double` where Double is the PRIMITIVE. Matches on EXACT canonical
# `type_id_name` (mirroring is_maybe_type / is_list_type at ~600/616), NOT the
# last-segment `type_id_display`: a user `type Double = <heap ADT>` has canonical
# name `main.Double` (dotted) and must NOT fire this scalar fast-path, or
# IRVecGetD would load a heap pointer that ir_rooting classifies scalar and never
# roots — a use-after-free under GC. The primitive Double / Vector have bare
# canonical names, so exact match fires on them and only them. A false negative
# merely forgoes the optimization; a false positive on a heap element is unsafe.
fn type_is_vector_double(t: types.Type) -> Bool =
  match t with
  | types.TApp (types.TConst vname)(types.TConst ename) ->
      types.type_id_name(vname) == "Vector" && types.type_id_name(ename) == "Double"
  | _ -> false

# B1 inline vector element access, decomposed into two independent axes so the
# mechanism grows cleanly as B1 generalizes past Double (docs/phase-d-numeric-
# fastpath-design §B1). VecOp = which OPERATION (from the runtime symbol);
# VecRep = which element REPRESENTATION is safe to inline (from arg0's type).
# The name determines the op; the type determines the rep — the same symbol
# (vector_get_direct) maps to different inline forms as representations multiply,
# so the two must not be conflated into one name→op enum.
type VecOp (..) =
  | VecGet
  | VecSet

type VecRep (..) =
  | RepScalarDouble
  | RepUnsupported

# Name → vector element-access operation. The runtime symbols live ONLY here
# (mirrors recognize_string_builtin); Nothing for any non-vector-access name.
fn recognize_vector_op(fname: String) -> Maybe VecOp =
  if fname == "vector_get_direct" then Just(VecGet)
  else if fname == "vector_mutset" then Just(VecSet)
  else Nothing

# Representation of arg0's element type — decides which inline form is SAFE.
# RepScalarDouble: primitive `Vector Double` (unboxed f64 slot) → inline op.
# RepUnsupported : anything else (a user `type Double` heap ADT, a Vector of a
#   non-Double primitive, a Vector of pointers) → keep the runtime call. Reuses
#   the exact-canonical-name guard `type_is_vector_double` unchanged; a false
#   positive would inline a heap load ir_rooting never roots (use-after-free).
fn classify_vec_elem(args: List typed_ast.TypedExpr) -> VecRep =
  match args with
  | [head | _] ->
      if type_is_vector_double(typed_ast.typed_expr_type(head))
      then RepScalarDouble
      else RepUnsupported
  | Nil -> RepUnsupported

# True iff every declared parameter is supplied — the arity comes from the
# DECLARATION (externs are in fn_arities), NOT a hardcoded literal. An
# under-applied call returns false; the vector fast-path then declines it and
# translate_general_call rejects the under-application (inference should already).
fn is_fully_applied(fname: String, arg_names: List String, fn_arities: Dict FnInfo) -> Bool =
  match dict_get(fname, fn_arities) with
  | Just info -> list_length(arg_names) == info.arity
  | Nothing -> false

# Recognize + lower an inline vector element access. Nothing = "not an inline
# vector access here" → the caller uses the general call path. The three gates
# (operation, full application, element representation) are each a named
# predicate, so no magic string or arity literal survives in control flow.
# Adding a VecRep variant forces every match below to handle it (exhaustiveness),
# so a new representation cannot ship without a conscious lowering + guard.
fn try_vector_intrinsic(fname: String, args: List typed_ast.TypedExpr,
                        arg_blocks: List sprout_ir.IRBlock, cur_lbl: String,
                        cur_ops: List sprout_ir.IROp, arg_names: List String,
                        idx: Int, fn_arities: Dict FnInfo, name_prefix: String) ->
    Maybe(Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int)) =
  match recognize_vector_op(fname) with
  | Nothing -> Nothing
  | Just op ->
      if is_fully_applied(fname, arg_names, fn_arities) == false then Nothing
      else match classify_vec_elem(args) with
           | RepUnsupported -> Nothing
           | RepScalarDouble ->
               match op with
               | VecGet -> Just(finish_vec_get_d(arg_blocks, cur_lbl, cur_ops, arg_names, idx, name_prefix))
               | VecSet -> Just(finish_vec_set_d(arg_blocks, cur_lbl, cur_ops, arg_names, idx, name_prefix))

# Shared null + bounds guard for B1 Vector-Double access. Emits the three blocks
# (cond / len+bounds / panic) that dominate a fresh continuation block <ok2>, and
# returns (guard_blocks, ok2_label). The check MUST be built at the IRBlock layer,
# not the ir_lowering text layer (mirrors finish_checked_div): a checked op that
# split blocks via text would leave downstream phi predecessors naming the wrong
# block. Reserves fresh-name slots idx..idx+4; the caller uses idx+5 for its
# result and advances idx by 6. Bounds uses one UNSIGNED compare (idx>=len also
# catches idx<0), matching vector_get_direct/vector_mutset's semantics.
fn vec_double_guard(cur_lbl: String, cur_ops: List sprout_ir.IROp, vec: String, i: String,
                    msg_text: String, idx: Int, name_prefix: String)
    -> (List sprout_ir.IRBlock, String) =
  ([cond_block, ok1_block, panic_block], ok2_lbl)
  where isnull = fresh_name(name_prefix, idx)
        len = fresh_name(name_prefix, idx + 1)
        oob = fresh_name(name_prefix, idx + 2)
        msg_raw = fresh_name(name_prefix, idx + 3)
        msg = fresh_name(name_prefix, idx + 4)
        ok1_lbl = "vok1_" ++ int_to_string(idx)
        panic_lbl = "vpanic_" ++ int_to_string(idx)
        ok2_lbl = "vok2_" ++ int_to_string(idx)
        cond_block = sprout_ir.IRBlock(cur_lbl,
                       list_append(cur_ops,
                         Cons(sprout_ir.IRICmp(isnull, "eq", vec, "0"),
                         Cons(sprout_ir.IRCondBr(isnull, panic_lbl, ok1_lbl), Nil))))
        ok1_block = sprout_ir.IRBlock(ok1_lbl,
                      Cons(sprout_ir.IRVecLenD(len, vec),
                      Cons(sprout_ir.IRICmp(oob, "uge", i, len),
                      Cons(sprout_ir.IRCondBr(oob, panic_lbl, ok2_lbl), Nil))))
        panic_block = sprout_ir.IRBlock(panic_lbl,
                        Cons(sprout_ir.IRStrConst(msg, msg_raw, msg_text),
                        Cons(sprout_ir.IRPanic(msg), Nil)))

# B1: guard + inline op for a Vector-Double access. Shared by the get/set finish
# wrappers below; they build `tail_op` with result = fresh_name(idx+5) (which this
# function also returns — fresh_name is deterministic, so the op's def and the
# returned result SSA agree). The tail op runs in the guard's ok2 continuation.
fn emit_vec_access(arg_blocks: List sprout_ir.IRBlock, cur_lbl: String,
                   cur_ops: List sprout_ir.IROp, vec: String, i: String,
                   tail_op: sprout_ir.IROp, msg_text: String,
                   idx: Int, name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  match vec_double_guard(cur_lbl, cur_ops, vec, i, msg_text, idx, name_prefix) with
  | (guard_blocks, ok2_lbl) ->
      Ok((list_append(arg_blocks, guard_blocks), ok2_lbl,
          Cons(tail_op, Nil), fresh_name(name_prefix, idx + 5), idx + 6))

# B1: `vector_get_direct(vec, i)` on a Vector Double -> guard + inline IRVecGetD.
fn finish_vec_get_d(arg_blocks: List sprout_ir.IRBlock, cur_lbl: String,
                    cur_ops: List sprout_ir.IROp, arg_names: List String,
                    idx: Int, name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  match arg_names with
  | [vec, i] ->
      emit_vec_access(arg_blocks, cur_lbl, cur_ops, vec, i,
                      sprout_ir.IRVecGetD(fresh_name(name_prefix, idx + 5), vec, i),
                      "vector_get_direct: null vector or index out of bounds", idx, name_prefix)
  | _ -> Err("ast_to_ir: vector_get_direct expects 2 arguments")

# B1: `vector_mutset(vec, i, val)` on a Vector Double -> guard + inline IRVecSetD.
fn finish_vec_set_d(arg_blocks: List sprout_ir.IRBlock, cur_lbl: String,
                    cur_ops: List sprout_ir.IROp, arg_names: List String,
                    idx: Int, name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  match arg_names with
  | [vec, i, val] ->
      emit_vec_access(arg_blocks, cur_lbl, cur_ops, vec, i,
                      sprout_ir.IRVecSetD(fresh_name(name_prefix, idx + 5), vec, i, val),
                      "vector_mutset: null vector or index out of bounds", idx, name_prefix)
  | _ -> Err("ast_to_ir: vector_mutset expects 3 arguments")

# Thread a list of argument expressions through translate_expr, accumulating
# completed blocks, current-block ops, and the result-name of each arg.
# `acc_blocks` is in already-correct order (we append, not prepend); the
# arg-name list `acc_names` is built in reverse and reversed at the end so
# the caller sees them in source order.
#
# translate_args_scalar — for IRCall / direct-call paths.  Rejects any arg
# whose type is not Int or String (scalar-only milestone constraint).
#
# translate_args_ctor — for IRMakeCtor paths.  Accepts all types including
# Unit (i64 0 sentinel), Bool, Int, String, and heap-typed ADT values — see
# is_supported_ctor_arg_type for the full rationale.
#
# Both delegate to translate_args_core with a type-filter flag.

# M3 PR 7: translate tuple elements left-to-right, accumulate SSAs, emit
# IRMakeTuple at the end.  Each element gets its own translate_expr call;
# blocks from intra-element control flow merge into acc_blocks.  Tuple
# fields are i64-uniform, so no per-element type filtering needed.
fn translate_tuple_items(items: List typed_ast.TypedExpr, params: List String,
                          ctors: Dict sprout_ir.CtorInfo,
                          idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                          acc_blocks: List sprout_ir.IRBlock,
                          acc_names: List String,
                          captures: Dict String,
                          lifted_ref: Ref (List sprout_ir.IRFunction),
                          top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                          lambda_ctr_ref: Ref Int,
                          lifted_idx_ref: Ref (Dict Int),
                          name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match items with
  | Nil ->
      Ok((acc_blocks, cur_label,
           list_append(cur_ops,
             Cons(sprout_ir.IRMakeTuple(fresh_name(name_prefix, idx), list_reverse(acc_names)), Nil)),
           fresh_name(name_prefix, idx), idx + 1))
  | Cons item rest ->
      match translate_expr(item, params, ctors, idx, cur_label, cur_ops,
                           captures, lifted_ref, top_level, let_names, fn_arities,
                           lambda_ctr_ref, lifted_idx_ref, name_prefix) with
      | Err msg -> Err(msg)
      | Ok ir ->
          match ir with
          | (iblocks, icur_lbl, icur_ops, i_name, idx1) ->
              translate_tuple_items(rest, params, ctors, idx1, icur_lbl, icur_ops,
                                     list_append(acc_blocks, iblocks),
                                     Cons(i_name, acc_names),
                                     captures, lifted_ref, top_level, let_names, fn_arities,
                                     lambda_ctr_ref, lifted_idx_ref, name_prefix)

# Build the argument list for a record functional update, in declaration order.
# For each declared field: if it is named in `update_fields`, translate the new
# value; otherwise copy it from the pre-evaluated base (`base_ssa`) with an
# IRGetField at its declaration offset (`field_pos`).  At the end emit the single
# IRMakeCtor for the fresh record.  Mirrors translate_tuple_items' threading.
fn build_update_args(decl_names: List String, field_pos: Int,
                     update_fields: List typed_ast.TypedRecordField,
                     base_ssa: String, tag: Int, rname: String, fks: String,
                     params: List String, ctors: Dict sprout_ir.CtorInfo,
                     idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                     acc_blocks: List sprout_ir.IRBlock, acc_names: List String,
                     captures: Dict String,
                     lifted_ref: Ref (List sprout_ir.IRFunction),
                     top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                     lambda_ctr_ref: Ref Int,
                     lifted_idx_ref: Ref (Dict Int),
                     name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match decl_names with
  | Nil ->
      finish_make_ctor("record", rname, tag, list_reverse(acc_names),
                       acc_blocks, cur_label, cur_ops, idx, name_prefix)
  | Cons nm rest ->
      match typed_field_expr_for(nm, update_fields) with
      | Just fexpr ->
          match translate_expr(fexpr, params, ctors, idx, cur_label, cur_ops,
                               captures, lifted_ref, top_level, let_names, fn_arities,
                               lambda_ctr_ref, lifted_idx_ref, name_prefix) with
          | Err msg -> Err(msg)
          | Ok ir ->
              match ir with
              | (iblocks, icur_lbl, icur_ops, i_name, idx1) ->
                  build_update_args(rest, field_pos + 1, update_fields, base_ssa, tag, rname, fks,
                                    params, ctors, idx1, icur_lbl, icur_ops,
                                    list_append(acc_blocks, iblocks), Cons(i_name, acc_names),
                                    captures, lifted_ref, top_level, let_names, fn_arities,
                                    lambda_ctr_ref, lifted_idx_ref, name_prefix)
      | Nothing ->
          build_update_args(rest, field_pos + 1, update_fields, base_ssa, tag, rname, fks,
                            params, ctors, idx + 1, cur_label,
                            list_append(cur_ops,
                              Cons(sprout_ir.IRGetField(fresh_name(name_prefix, idx), base_ssa, field_pos, fk.fk_at(fks, field_pos)), Nil)),
                            acc_blocks, Cons(fresh_name(name_prefix, idx), acc_names),
                            captures, lifted_ref, top_level, let_names, fn_arities,
                            lambda_ctr_ref, lifted_idx_ref, name_prefix)

fn translate_args_scalar(args: List typed_ast.TypedExpr, params: List String,
                         ctors: Dict sprout_ir.CtorInfo,
                         idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                         acc_blocks: List sprout_ir.IRBlock, acc_names: List String,
                         captures: Dict String,
                         lifted_ref: Ref (List sprout_ir.IRFunction),
                         top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                         lambda_ctr_ref: Ref Int,
                         lifted_idx_ref: Ref (Dict Int),
                         name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, List String, Int) !{IO} =
  translate_args_core(args, params, ctors, idx, cur_label, cur_ops, acc_blocks, acc_names,
                      true, captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                      name_prefix)

fn translate_args_ctor(args: List typed_ast.TypedExpr, params: List String,
                       ctors: Dict sprout_ir.CtorInfo,
                       idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                       acc_blocks: List sprout_ir.IRBlock, acc_names: List String,
                       captures: Dict String,
                       lifted_ref: Ref (List sprout_ir.IRFunction),
                       top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                       lambda_ctr_ref: Ref Int,
                       lifted_idx_ref: Ref (Dict Int),
                       name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, List String, Int) !{IO} =
  translate_args_core(args, params, ctors, idx, cur_label, cur_ops, acc_blocks, acc_names,
                      false, captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                      name_prefix)

fn translate_args_core(args: List typed_ast.TypedExpr, params: List String,
                       ctors: Dict sprout_ir.CtorInfo,
                       idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                       acc_blocks: List sprout_ir.IRBlock, acc_names: List String,
                       scalar_only: Bool,
                       captures: Dict String,
                       lifted_ref: Ref (List sprout_ir.IRFunction),
                       top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                       lambda_ctr_ref: Ref Int,
                       lifted_idx_ref: Ref (Dict Int),
                       name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, List String, Int) !{IO} =
  match args with
  | Nil -> Ok((acc_blocks, cur_label, cur_ops, list_reverse(acc_names), idx))
  | Cons a rest ->
      if scalar_only && ! is_supported_arg_type (typed_ast.typed_expr_type(a))
      then Err("ast_to_ir: call argument type not supported (Bool and Unit cannot be passed as i64)")
      else
        match translate_expr(a, params, ctors, idx, cur_label, cur_ops,
                             captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                             name_prefix) with
        | Err msg -> Err(msg)
        | Ok ar ->
            match ar with
            | (ablocks, acur_lbl, acur_ops, a_name, idx1) ->
                translate_args_core(rest, params, ctors, idx1, acur_lbl, acur_ops,
                                    list_append(acc_blocks, ablocks),
                                    Cons(a_name, acc_names), scalar_only,
                                    captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                                    lifted_idx_ref, name_prefix)

# Translate a function body into a complete List IRBlock.  The body always
# starts in the "entry" block; the final block (whatever cur_label is after
# translation) is sealed with IRRet.
# name_prefix is threaded through translate_expr but IGNORED by fresh_name,
# which hardcodes "%t$" for every synthetic temp (see fresh_name). The arg is
# vestigial; all fresh SSA names are "%t$N" regardless of what is passed.
fn translate_body(body: typed_ast.TypedExpr, params: List String,
                  ctors: Dict sprout_ir.CtorInfo, idx: Int,
                  captures: Dict String,
                  lifted_ref: Ref (List sprout_ir.IRFunction),
                  top_level: Set,
                let_names: Set,
                fn_arities: Dict FnInfo,
                  lambda_ctr_ref: Ref Int,
                  lifted_idx_ref: Ref (Dict Int),
                  name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, Int) !{IO} =
  match translate_expr(body, params, ctors, idx, "entry", Nil,
                       captures, lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref,
                       name_prefix) with
  | Err msg -> Err(msg)
  | Ok r ->
      match r with
      | (blocks, cur_lbl, cur_ops, name, next_idx) ->
          Ok((list_append(blocks,
                Cons(sprout_ir.IRBlock(cur_lbl,
                       list_append(cur_ops, Cons(sprout_ir.IRRet(name), Nil))),
                Nil)),
              next_idx))

fn param_known(name: String, params: List String) -> Bool =
  match params with
  | Nil -> false
  | Cons p rest -> if p == name then true else param_known(name, rest)

fn param_names(params: List ast.Param) -> List String =
  match params with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.Param n _ _ -> Cons(n, param_names(rest))

# Build an IRFunction from a (name, params, ret-type, blocks) tuple.
# `params` carries per-param IRType for ir_rooting's heap-origin seeding
# (closes BACKLOG.md:367 over-rooting bug).  `blocks` is already a fully-
# assembled List IRBlock — typically starting with an "entry" block —
# produced by translate_body.
fn build_fn(name: String, params: List (String, sprout_ir.IRType), ret_ty: String,
            blocks: List sprout_ir.IRBlock) -> sprout_ir.IRFunction =
  sprout_ir.IRFunction(name, params, ret_ty, blocks)

# True for the program entry point: bare `main`, or the bundler-qualified
# `<module>.main` when the entry file declares a `module`.  Mirrors direct
# codegen's is_entry_fn_name (codegen.sprout:1906).  O(name length).
fn is_entry_fn_name(name: String) -> Bool =
  name == "main" || (n >= 5 && str_slice(name, n - 5, 5) == ".main")
  where n = str_len(name)

# The synthetic name a non-trivial `main` body is translated to.  An
# `Int`-declared return type uses __sprout_user_main_int instead of
# __sprout_user_main: main_shim (ir_lowering.sprout) recognizes it and
# threads the returned i64 through as the process exit code (truncated to
# i32), rather than the unconditional `ret i32 0` used for a Unit-returning
# main. The name (not a side channel) carries the signal all the way
# through the streaming ir_pipeline, mirroring how __sprout_user_main
# itself is already detected by name.
fn user_main_fn_name(ret_ty: Maybe ast.TypeExpr) -> String =
  match ret_ty with
  | Just (ast.TypeName "Int") -> "__sprout_user_main_int"
  | _ -> "__sprout_user_main"

# ===========================================================================
# TCO rewrite — self-tail-recursion -> alloca-slot loop.
#
# Runs on the PRE-rooting IRFunction (called from translate_user_fn before
# ir_rooting). A tail self-call `%r = call @self(args); ... ret <r-via-phi>`
# becomes an IRTcoBack back-edge that stores the args into per-param slots; the
# loop header (IRTcoLoad) re-loads them each iteration. Running before rooting
# is essential: ir_rooting would otherwise root the self-call's heap arg across
# the (non-tail) call, and that root accumulates per frame -> root-pool
# exhaustion. As an IRTcoBack (not a GC trigger), no such root is emitted.
# v1: self-recursion only, i64 returns only. See
# docs/archive/typed-tco-implementation-2026-06-27.md.
# ===========================================================================

fn tco_block_label(b: sprout_ir.IRBlock) -> String =
  match b with | sprout_ir.IRBlock l _ -> l

fn tco_block_ops(b: sprout_ir.IRBlock) -> List sprout_ir.IROp =
  match b with | sprout_ir.IRBlock _ ops -> ops

# The value returned by a block, if it ends in IRRet.
fn tco_ret_value(ops: List sprout_ir.IROp) -> Maybe String =
  match ops with
  | Nil -> Nothing
  | Cons op rest ->
      match op with
      | sprout_ir.IRRet v -> Just(v)
      | _ -> tco_ret_value(rest)

# Incomings of the IRPhi defining `name`, if present in ops.
fn tco_phi_incomings(name: String, ops: List sprout_ir.IROp) -> Maybe (List (String, String)) =
  match ops with
  | Nil -> Nothing
  | Cons op rest ->
      match op with
      | sprout_ir.IRPhi r _ inc ->
          if r == name then Just(inc) else tco_phi_incomings(name, rest)
      | _ -> tco_phi_incomings(name, rest)

# Args of `IRCall(val, _, self_name, args)` within ops, if present.
fn tco_self_call_args(val: String, self_name: String, ops: List sprout_ir.IROp) -> Maybe (List String) =
  match ops with
  | Nil -> Nothing
  | Cons op rest ->
      match op with
      | sprout_ir.IRCall r _ fname args ->
          if r == val && fname == self_name then Just(args)
          else tco_self_call_args(val, self_name, rest)
      | _ -> tco_self_call_args(val, self_name, rest)

# A tail-call hit: (pred_label, args, call_result, phi_block).
# phi_block == "" means a direct `call; ret` (no phi incoming to drop).
fn tco_collect(self_name: String, blocks: List sprout_ir.IRBlock, all: List sprout_ir.IRBlock) -> List (String, List String, String, String) =
  match blocks with
  | Nil -> Nil
  | Cons b rest ->
      list_append(tco_hits_for_block(self_name, b, all), tco_collect(self_name, rest, all))

fn tco_hits_for_block(self_name: String, b: sprout_ir.IRBlock, all: List sprout_ir.IRBlock) -> List (String, List String, String, String) =
  match tco_ret_value(ops) with
  | Nothing -> Nil
  | Just rv ->
      match tco_self_call_args(rv, self_name, ops) with
      | Just args -> Cons((tco_block_label(b), args, rv, ""), Nil)
      | Nothing -> tco_trace_phis(self_name, all, Cons(rv, Nil), set_empty(), Nil)
  where ops = tco_block_ops(b)

# Find the phi defining `val` anywhere: (phi_block_label, incomings).
fn tco_find_phi(val: String, blocks: List sprout_ir.IRBlock) -> Maybe (String, List (String, String)) =
  match blocks with
  | Nil -> Nothing
  | Cons b rest ->
      match tco_phi_incomings(val, tco_block_ops(b)) with
      | Just inc -> Just((tco_block_label(b), inc))
      | Nothing -> tco_find_phi(val, rest)

# Args of a self-call defining `val` specifically in block `pred`.
fn tco_self_call_in_block(val: String, self_name: String, pred: String, blocks: List sprout_ir.IRBlock) -> Maybe (List String) =
  match blocks with
  | Nil -> Nothing
  | Cons b rest ->
      if tco_block_label(b) == pred
      then tco_self_call_args(val, self_name, tco_block_ops(b))
      else tco_self_call_in_block(val, self_name, pred, rest)

# Trace returned values through (possibly nested) phis to collect tail self-calls.
# worklist holds phi-result names still to expand; visited prevents cycles.
fn tco_trace_phis(self_name: String, all: List sprout_ir.IRBlock, worklist: List String,
                  visited: Set, acc: List (String, List String, String, String)) -> List (String, List String, String, String) =
  match worklist with
  | Nil -> acc
  | Cons v rest ->
      if set_member(v, visited)
      then tco_trace_phis(self_name, all, rest, visited, acc)
      else
        match tco_find_phi(v, all) with
        | Nothing -> tco_trace_phis(self_name, all, rest, set_insert(v, visited), acc)
        | Just (phi_block, incomings) ->
            match tco_scan_incomings(self_name, all, incomings, phi_block, rest, acc) with
            | (wl2, acc2) -> tco_trace_phis(self_name, all, wl2, set_insert(v, visited), acc2)

# Each (val, pred) incoming: a self-call -> a hit; otherwise enqueue val (it may
# itself be a nested phi).
fn tco_scan_incomings(self_name: String, all: List sprout_ir.IRBlock, incomings: List (String, String),
                      phi_block: String, worklist: List String,
                      acc: List (String, List String, String, String)) ->
    (List String, List (String, List String, String, String)) =
  match incomings with
  | Nil -> (worklist, acc)
  | Cons (val, pred) rest ->
      match tco_self_call_in_block(val, self_name, pred, all) with
      | Just args -> tco_scan_incomings(self_name, all, rest, phi_block, worklist, Cons((pred, args, val, phi_block), acc))
      | Nothing -> tco_scan_incomings(self_name, all, rest, phi_block, Cons(val, worklist), acc)

# Per-param slot info: (orig_name, slot_ssa, in_name=%<p>$in, kind).
fn tco_build_slots(params: List (String, sprout_ir.IRType), idx: Int,
                   acc: List (String, String, String, sprout_ir.IRType)) ->
    (List (String, String, String, sprout_ir.IRType), Int) =
  match params with
  | Nil -> (list_reverse(acc), idx)
  | Cons (p, kind) rest ->
      tco_build_slots(rest, idx + 1, Cons((p, fresh_name("%t", idx), "%" ++ p ++ "$in", kind), acc))

fn tco_rename_params(params: List (String, sprout_ir.IRType)) -> List (String, sprout_ir.IRType) =
  match params with
  | Nil -> Nil
  | Cons (p, k) rest -> Cons((p ++ "$in", k), tco_rename_params(rest))

fn tco_entry_slot_list(slots: List (String, String, String, sprout_ir.IRType)) -> List (String, String, String) =
  match slots with
  | Nil -> Nil
  | Cons (_p, slot, in_name, _k) rest -> Cons((slot, "i64", in_name), tco_entry_slot_list(rest))

fn tco_load_ops(slots: List (String, String, String, sprout_ir.IRType)) -> List sprout_ir.IROp =
  match slots with
  | Nil -> Nil
  | Cons (p, slot, _in, kind) rest ->
      Cons(sprout_ir.IRTcoLoad("%" ++ p, "i64", slot, kind), tco_load_ops(rest))

# Zip the per-param slots with a tail call's args -> IRTcoBack stores.
fn tco_zip_stores(slots: List (String, String, String, sprout_ir.IRType), args: List String) -> List (String, String, String) =
  match (slots, args) with
  | (Cons(_p, slot, _in, _k) srest, Cons a arest) ->
      Cons((slot, "i64", a), tco_zip_stores(srest, arest))
  | _ -> Nil

# Drop the self-call (result == call_result) and the block terminator, then
# append the IRTcoBack back-edge.
fn tco_rewrite_pred_ops(ops: List sprout_ir.IROp, call_result: String,
                        stores: List (String, String, String), sp: String) -> List sprout_ir.IROp =
  list_append(tco_filter_call_and_term(ops, call_result),
              Cons(sprout_ir.IRTcoBack(stores, sp, "tco_loop"), Nil))

fn tco_filter_call_and_term(ops: List sprout_ir.IROp, call_result: String) -> List sprout_ir.IROp =
  match ops with
  | Nil -> Nil
  | Cons op rest ->
      match op with
      | sprout_ir.IRCall r _ _ _ ->
          if r == call_result then tco_filter_call_and_term(rest, call_result)
          else Cons(op, tco_filter_call_and_term(rest, call_result))
      | sprout_ir.IRBr _ -> tco_filter_call_and_term(rest, call_result)
      | sprout_ir.IRRet _ -> tco_filter_call_and_term(rest, call_result)
      | _ -> Cons(op, tco_filter_call_and_term(rest, call_result))

fn tco_find_hit_for_pred(lbl: String, hits: List (String, List String, String, String)) -> Maybe (List String, String) =
  match hits with
  | Nil -> Nothing
  | Cons (pred, args, call_result, _phi) rest ->
      if pred == lbl then Just((args, call_result)) else tco_find_hit_for_pred(lbl, rest)

fn tco_rewrite_block_if_pred(b: sprout_ir.IRBlock, hits: List (String, List String, String, String),
                             slots: List (String, String, String, sprout_ir.IRType), sp: String) -> sprout_ir.IRBlock =
  match tco_find_hit_for_pred(tco_block_label(b), hits) with
  | Nothing -> b
  | Just (args, call_result) ->
      sprout_ir.IRBlock(tco_block_label(b),
        tco_rewrite_pred_ops(tco_block_ops(b), call_result, tco_zip_stores(slots, args), sp))

# Remove (removed_val, pred) from every IRPhi's incomings in `ops`.
fn tco_fix_phi_in_ops(ops: List sprout_ir.IROp, removed_val: String, pred: String) -> List sprout_ir.IROp =
  match ops with
  | Nil -> Nil
  | Cons op rest ->
      match op with
      | sprout_ir.IRPhi r ty inc ->
          Cons(sprout_ir.IRPhi(r, ty, tco_drop_incoming(inc, removed_val, pred)), tco_fix_phi_in_ops(rest, removed_val, pred))
      | _ -> Cons(op, tco_fix_phi_in_ops(rest, removed_val, pred))

fn tco_drop_incoming(inc: List (String, String), removed_val: String, pred: String) -> List (String, String) =
  match inc with
  | Nil -> Nil
  | Cons (v, p) rest ->
      if v == removed_val && p == pred then tco_drop_incoming(rest, removed_val, pred)
      else Cons((v, p), tco_drop_incoming(rest, removed_val, pred))

fn tco_fix_phi_block(blocks: List sprout_ir.IRBlock, phi_block: String, removed_val: String, pred: String) -> List sprout_ir.IRBlock =
  list_map(\b ->
    if tco_block_label(b) == phi_block
    then sprout_ir.IRBlock(phi_block, tco_fix_phi_in_ops(tco_block_ops(b), removed_val, pred))
    else b, blocks)

fn tco_fix_all_phis(blocks: List sprout_ir.IRBlock, hits: List (String, List String, String, String)) -> List sprout_ir.IRBlock =
  match hits with
  | Nil -> blocks
  | Cons (pred, _args, call_result, phi_block) rest ->
      if phi_block == ""
      then tco_fix_all_phis(blocks, rest)
      else tco_fix_all_phis(tco_fix_phi_block(blocks, phi_block, call_result, pred), rest)

# Rename the old "entry" block to "tco_loop" and prepend the per-param reloads.
fn tco_make_loop_blocks(blocks: List sprout_ir.IRBlock, slots: List (String, String, String, sprout_ir.IRType)) -> List sprout_ir.IRBlock =
  list_map(\b ->
    if tco_block_label(b) == "entry"
    then sprout_ir.IRBlock("tco_loop", list_append(tco_load_ops(slots), tco_block_ops(b)))
    else b, blocks)

# Drop blocks left unreachable when a join's phi loses all incomings (every
# predecessor was a tail call rewritten to IRTcoBack). A phi with no incomings
# means its block has no reachable predecessors, so the block is dead. Iterative:
# dropping block D also strips the [_, D] incoming from D's branch-successor's
# phis, which can empty THAT phi — caught on the next pass. Terminates: each pass
# removes >= 1 block. The function's ret-feeding phi always keeps its base-case
# incoming (a non-recursive tail), so the cascade stops before the ret. This is
# what lets single-arm matches (one real arm + an `unreachable` sibling → a
# single-incoming pass-through phi) and both-branches-recurse joins be TCO'd.
fn tco_ops_have_empty_phi(ops: List sprout_ir.IROp) -> Bool =
  match ops with
  | Nil -> false
  | Cons op rest ->
      match op with
      | sprout_ir.IRPhi _ _ Nil -> true
      | _ -> tco_ops_have_empty_phi(rest)

# Label of the first block whose phi has no incomings (dead), if any.
fn tco_find_empty_phi_block(blocks: List sprout_ir.IRBlock) -> Maybe String =
  match blocks with
  | Nil -> Nothing
  | Cons b rest ->
      if tco_ops_have_empty_phi(tco_block_ops(b))
      then Just(tco_block_label(b))
      else tco_find_empty_phi_block(rest)

# The IRBr successor label of a block's terminator ("" if it is not a plain br).
fn tco_block_br_succ(ops: List sprout_ir.IROp) -> String =
  match ops with
  | Nil -> ""
  | Cons op rest ->
      match op with
      | sprout_ir.IRBr target -> target
      | _ -> tco_block_br_succ(rest)

fn tco_succ_of_block(blocks: List sprout_ir.IRBlock, lbl: String) -> String =
  match blocks with
  | Nil -> ""
  | Cons b rest ->
      if tco_block_label(b) == lbl then tco_block_br_succ(tco_block_ops(b))
      else tco_succ_of_block(rest, lbl)

# Strip every phi incoming whose predecessor is `pred`, in `ops`.
fn tco_drop_incomings_from_pred(inc: List (String, String), pred: String) -> List (String, String) =
  match inc with
  | Nil -> Nil
  | Cons (v, p) rest ->
      if p == pred then tco_drop_incomings_from_pred(rest, pred)
      else Cons((v, p), tco_drop_incomings_from_pred(rest, pred))

fn tco_strip_pred_in_ops(ops: List sprout_ir.IROp, pred: String) -> List sprout_ir.IROp =
  match ops with
  | Nil -> Nil
  | Cons op rest ->
      match op with
      | sprout_ir.IRPhi r ty inc ->
          Cons(sprout_ir.IRPhi(r, ty, tco_drop_incomings_from_pred(inc, pred)), tco_strip_pred_in_ops(rest, pred))
      | _ -> Cons(op, tco_strip_pred_in_ops(rest, pred))

# Remove block `dead`; in its successor `succ`, strip any phi incoming from `dead`.
fn tco_remove_block_and_fix(blocks: List sprout_ir.IRBlock, dead: String, succ: String) -> List sprout_ir.IRBlock =
  match blocks with
  | Nil -> Nil
  | Cons b rest ->
      if tco_block_label(b) == dead
      then tco_remove_block_and_fix(rest, dead, succ)
      else if tco_block_label(b) == succ
      then Cons(sprout_ir.IRBlock(succ, tco_strip_pred_in_ops(tco_block_ops(b), dead)), tco_remove_block_and_fix(rest, dead, succ))
      else Cons(b, tco_remove_block_and_fix(rest, dead, succ))

fn tco_prune_dead_blocks(blocks: List sprout_ir.IRBlock) -> List sprout_ir.IRBlock =
  match tco_find_empty_phi_block(blocks) with
  | Nothing -> blocks
  | Just dead -> tco_prune_dead_blocks(tco_remove_block_and_fix(blocks, dead, tco_succ_of_block(blocks, dead)))

# A self-call is only a TRUE tail call when nothing after it in its block consumes
# its result — i.e. the IRCall is followed only by the block terminator.  A do-step
# like `r <- g(..); h(r); r` (e.g. union-find path compression:
# `root <- find_root(..); ref_write(.., BoundTo(root)); root`) places `h(r)` after
# the call, so g is NOT in tail position: the return value still traces back to the
# call through the join phi, but the result is also `h`'s operand, and converting
# the call to an IRTcoBack back-edge would drop the value `h` needs (an SSA
# use-of-undefined).  Such hits are filtered out and stay normal IRCalls.
fn tco_tail_safe_hits(hits: List (String, List String, String, String), all: List sprout_ir.IRBlock) -> List (String, List String, String, String) =
  match hits with
  | Nil -> Nil
  | Cons (pred, args, call_result, phi_block) rest ->
      if tco_call_in_tail_position(call_result, pred, all)
      then Cons((pred, args, call_result, phi_block), tco_tail_safe_hits(rest, all))
      else tco_tail_safe_hits(rest, all)

fn tco_call_in_tail_position(call_result: String, pred: String, blocks: List sprout_ir.IRBlock) -> Bool =
  match blocks with
  | Nil -> false
  | Cons b rest ->
      if tco_block_label(b) == pred
      then tco_ops_after_call_are_terminators(tco_block_ops(b), call_result)
      else tco_call_in_tail_position(call_result, pred, rest)

# Find the IRCall defining call_result; true iff only terminators (IRBr/IRRet)
# follow it in the block.
fn tco_ops_after_call_are_terminators(ops: List sprout_ir.IROp, call_result: String) -> Bool =
  match ops with
  | Nil -> false
  | Cons op rest ->
      match op with
      | sprout_ir.IRCall r _ _ _ ->
          if r == call_result then tco_only_terminators(rest)
          else tco_ops_after_call_are_terminators(rest, call_result)
      | _ -> tco_ops_after_call_are_terminators(rest, call_result)

fn tco_only_terminators(ops: List sprout_ir.IROp) -> Bool =
  match ops with
  | Nil -> true
  | Cons op rest ->
      match op with
      | sprout_ir.IRBr _ -> tco_only_terminators(rest)
      | sprout_ir.IRRet _ -> tco_only_terminators(rest)
      | _ -> false

export fn tco_rewrite(f: sprout_ir.IRFunction, next_idx: Int) -> (sprout_ir.IRFunction, Int) =
  match f with
  | sprout_ir.IRFunction name params ret_ty blocks ->
      if ret_ty == "i64"
      then
        match tco_tail_safe_hits(tco_collect(name, blocks, blocks), blocks) with
        | Nil -> (f, next_idx)
        | hits ->
            match tco_build_slots(params, next_idx, Nil) with
            | (slots, idx1) -> tco_assemble(name, params, ret_ty, blocks, hits, slots, fresh_name("%t", idx1), idx1 + 1)
      else (f, next_idx)

fn tco_assemble(name: String, params: List (String, sprout_ir.IRType), ret_ty: String,
                blocks: List sprout_ir.IRBlock, hits: List (String, List String, String, String),
                slots: List (String, String, String, sprout_ir.IRType), sp: String, idx2: Int) ->
    (sprout_ir.IRFunction, Int) =
  (sprout_ir.IRFunction(name, tco_rename_params(params), ret_ty, new_blocks), idx2)
  where rewritten = tco_fix_all_phis(list_map(\b -> tco_rewrite_block_if_pred(b, hits, slots, sp), blocks), hits)
        loop_blocks = tco_make_loop_blocks(rewritten, slots)
        entry_block = sprout_ir.IRBlock("entry",
                        Cons(sprout_ir.IRTcoEntry(tco_entry_slot_list(slots), sp),
                        Cons(sprout_ir.IRBr("tco_loop"), Nil)))
        new_blocks = tco_prune_dead_blocks(Cons(entry_block, loop_blocks))

# Apply TCO unless this is the program entry point (mirrors direct codegen's
# is_entry exclusion). tco_rewrite is itself a no-op without a tail self-call.
fn maybe_tco(name: String, f: sprout_ir.IRFunction, next_idx: Int) -> (sprout_ir.IRFunction, Int) =
  if is_entry_fn_name(name) then (f, next_idx) else tco_rewrite(f, next_idx)

# ===========================================================================
# MUTUAL TCO — cross-function tail calls in a same-prototype cycle become
# `musttail` (IRTailCall), so PBKDF2-style mutual recursion runs in O(1) stack
# and O(1) GC roots.  See docs/mutual-tco-v0.md.  This is self-TCO's ASSEMBLY
# (reuse tco_tail_safe_hits / tco_fix_all_phis / tco_prune_dead_blocks) with
# IRTailCall swapped for IRTcoBack and NO slot/entry/loop restructuring —
# musttail is call+ret in place, so the function keeps its normal entry and the
# original call_result is reused (no fresh-name threading).
#
# `targets` is the precomputed eligible set for this fn: (callee_name, arity) for
# each same-prototype cycle partner (computed in ir_pipeline from the call graph).
# Runs PRE-rooting (like self-TCO): once a tail call is an IRTailCall (not a GC
# trigger that exposes its heap args), ir_rooting emits no accumulating root.
# Phase A: SKIP functions that are ALSO self-TCO'd (blocks already restructured);
# scram's hi_loop/hi_step are not self-recursive so they are covered.
# ===========================================================================

# True iff any block already carries an IRTcoEntry (i.e. self-TCO'd).
fn mutual_has_tco_entry(blocks: List sprout_ir.IRBlock) -> Bool =
  match blocks with
  | Nil -> false
  | Cons b rest ->
      if mutual_ops_have_tco_entry(tco_block_ops(b)) then true
      else mutual_has_tco_entry(rest)

fn mutual_ops_have_tco_entry(ops: List sprout_ir.IROp) -> Bool =
  match ops with
  | Nil -> false
  | Cons op rest ->
      match op with
      | sprout_ir.IRTcoEntry _ _ -> true
      | _ -> mutual_ops_have_tco_entry(rest)

# Collect tagged hits for every eligible target: reuse tco_collect (finds tail
# calls to a NAME within blocks) + tco_tail_safe_hits (result not consumed after),
# then the IR-site arity guard (args count == callee arity) so a mismatched edge
# is a no-op, never an illegal musttail.  Each hit is tagged with its callee.
fn mutual_collect_hits(targets: List (String, Int), blocks: List sprout_ir.IRBlock) ->
    List(String, (String, List String, String, String)) =
  match targets with
  | Nil -> Nil
  | Cons (g, g_arity) rest ->
      list_append(
        mutual_tag_hits(g, g_arity, tco_tail_safe_hits(tco_collect(g, blocks, blocks), blocks)),
        mutual_collect_hits(rest, blocks))

fn mutual_tag_hits(g: String, g_arity: Int,
                   hits: List (String, List String, String, String)) ->
    List(String, (String, List String, String, String)) =
  match hits with
  | Nil -> Nil
  | Cons (pred, args, call_result, phi_block) rest ->
      if list_length(args) == g_arity
      then Cons((g, (pred, args, call_result, phi_block)), mutual_tag_hits(g, g_arity, rest))
      else mutual_tag_hits(g, g_arity, rest)

# Drop the tag → the hit shape tco_fix_all_phis expects.
fn mutual_untag(tagged: List (String, (String, List String, String, String))) ->
    List(String, List String, String, String) =
  match tagged with
  | Nil -> Nil
  | Cons (_g, hit) rest -> Cons(hit, mutual_untag(rest))

# Rewrite a hit-predecessor block: drop the IRCall + its terminator, append the
# IRTailCall (musttail; ret).  sp_save is "" — Phase A skips self-TCO'd fns, so
# there is never an enclosing loop stack to restore.
fn mutual_rewrite_block(b: sprout_ir.IRBlock,
                        tagged: List (String, (String, List String, String, String))) ->
    sprout_ir.IRBlock =
  match mutual_find_hit_for_pred(tco_block_label(b), tagged) with
  | Nothing -> b
  | Just (g, args, call_result) ->
      sprout_ir.IRBlock(tco_block_label(b),
        list_append(tco_filter_call_and_term(tco_block_ops(b), call_result),
                    Cons(sprout_ir.IRTailCall(call_result, g, args, ""), Nil)))

fn mutual_find_hit_for_pred(lbl: String,
                            tagged: List (String, (String, List String, String, String))) ->
    Maybe(String, List String, String) =
  match tagged with
  | Nil -> Nothing
  | Cons (g, (pred, args, call_result, _phi)) rest ->
      if pred == lbl then Just((g, args, call_result))
      else mutual_find_hit_for_pred(lbl, rest)

# Assemble: rewrite each hit-pred block, then fix the join phis that lost an
# incoming and prune blocks that became unreachable — identical to self-TCO's
# tco_assemble tail, minus the entry/loop restructuring.
fn mutual_assemble(blocks: List sprout_ir.IRBlock,
                   tagged: List (String, (String, List String, String, String))) ->
    List sprout_ir.IRBlock =
  tco_prune_dead_blocks(
    tco_fix_all_phis(list_map(\b -> mutual_rewrite_block(b, tagged), blocks), mutual_untag(tagged)))

# Rewrite f's eligible mutual tail calls to IRTailCall.  No-op unless ret is i64,
# f is not self-TCO'd, and at least one eligible tail call survives the guards.
export fn mutual_tco_rewrite_fn(f: sprout_ir.IRFunction, targets: List (String, Int)) ->
    sprout_ir.IRFunction =
  match f with
  | sprout_ir.IRFunction name params ret_ty blocks ->
      if ret_ty == "i64" && ! mutual_has_tco_entry (blocks)
      then mutual_finish_rewrite(name, params, ret_ty, blocks, mutual_collect_hits(targets, blocks), f)
      else f

fn mutual_finish_rewrite(name: String, params: List (String, sprout_ir.IRType), ret_ty: String,
                         blocks: List sprout_ir.IRBlock,
                         hits: List (String, (String, List String, String, String)),
                         f: sprout_ir.IRFunction) -> sprout_ir.IRFunction =
  match hits with
  | Nil -> f
  | _ -> sprout_ir.IRFunction(name, params, ret_ty, mutual_assemble(blocks, hits))

# --- Eligibility: which mutual tail edges close a same-prototype cycle. --------
# Built once (in ir_pipeline) from the interprocedural call graph — the
# alloc-summary callee sets, already IR-namespace — plus per-fn arity and return
# kind.  An edge f->g is eligible iff g is a callee of f, both return i64,
# arity(f)==arity(g) (⇒ identical prototype, since every value lowers to i64), and
# g can reach f in the call graph (they share a cycle).  Over-approximation is
# safe: the per-fn rewrite only touches ACTUAL tail calls and re-checks arity at
# the IR site, and a wrong edge would be a prototype-mismatched musttail the LLVM
# verifier rejects — loud, never a silent miscompile.  Result: fname -> [(callee,
# arity)] consumed by mutual_tco_rewrite_fn.

# Per-fn LLVM return kind (i64 vs not) from the typed decls.
export fn build_ret_i64(decls: List typed_ast.TypedDecl) -> Dict Bool =
  match decls with
  | Nil -> dict_empty()
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name _ _ _ _ body ->
          dict_set(name, llvm_ret_type(typed_ast.typed_expr_type(body)) == "i64", build_ret_i64(rest))
      | _ -> build_ret_i64(rest)

fn mutual_graph_of(raw: List (String, (Bool, Set))) -> Dict Set =
  match raw with
  | Nil -> dict_empty()
  | Cons (name, (_gc, callees)) rest -> dict_set(name, callees, mutual_graph_of(rest))

fn mutual_neighbors(n: String, graph: Dict Set) -> List String =
  match dict_get(n, graph) with
  | Just s -> set_to_list(s)
  | Nothing -> Nil

# Does `start` reach `target` over the call graph?  Visited-guarded DFS worklist.
fn mutual_reaches(start: String, target: String, graph: Dict Set) -> Bool =
  mutual_reaches_loop(Cons(start, Nil), target, graph, set_empty())

fn mutual_reaches_loop(work: List String, target: String, graph: Dict Set, seen: Set) -> Bool =
  match work with
  | Nil -> false
  | Cons n rest ->
      if n == target then true
      else if set_member(n, seen) then mutual_reaches_loop(rest, target, graph, seen)
      else mutual_reaches_loop(list_append(mutual_neighbors(n, graph), rest), target, graph, set_insert(n, seen))

fn mutual_arity_of(name: String, arities: Dict FnInfo) -> Int =
  match dict_get(name, arities) with | Just info -> info.arity | Nothing -> -1

fn mutual_ret_i64_of(name: String, ret_i64: Dict Bool) -> Bool =
  match dict_get(name, ret_i64) with | Just b -> b | Nothing -> false

export fn mutual_build_eligible(raw: List (String, (Bool, Set)), arities: Dict FnInfo, ret_i64: Dict Bool) ->
    Dict(List (String, Int)) =
  mutual_eligible_loop(raw, mutual_graph_of(raw), arities, ret_i64, dict_empty())

fn mutual_eligible_loop(raw: List (String, (Bool, Set)), graph: Dict Set, arities: Dict FnInfo,
                        ret_i64: Dict Bool, acc: Dict (List (String, Int))) -> Dict (List (String, Int)) =
  match raw with
  | Nil -> acc
  | Cons (name, (_gc, callees)) rest ->
      mutual_eligible_loop(rest, graph, arities, ret_i64,
        dict_set(name, mutual_targets_for(name, set_to_list(callees), graph, arities, ret_i64), acc))

fn mutual_targets_for(f: String, callees: List String, graph: Dict Set, arities: Dict FnInfo,
                      ret_i64: Dict Bool) -> List (String, Int) =
  if mutual_ret_i64_of(f, ret_i64) && mutual_arity_of(f, arities) >= 0
  then mutual_filter_targets(callees, f, mutual_arity_of(f, arities), graph, arities, ret_i64)
  else Nil

fn mutual_filter_targets(callees: List String, f: String, f_arity: Int, graph: Dict Set,
                         arities: Dict FnInfo, ret_i64: Dict Bool) -> List (String, Int) =
  match callees with
  | Nil -> Nil
  | Cons g rest ->
      if ! (g == f) && mutual_ret_i64_of(g, ret_i64) && mutual_arity_of(g, arities) == f_arity
         && mutual_reaches(g, f, graph)
      then Cons((g, f_arity), mutual_filter_targets(rest, f, f_arity, graph, arities, ret_i64))
      else mutual_filter_targets(rest, f, f_arity, graph, arities, ret_i64)

# Look up a fn's eligible targets (empty if absent, e.g. lifted lambdas/workers).
export fn mutual_eligible_for(name: String, eligible: Dict (List (String, Int))) -> List (String, Int) =
  match dict_get(name, eligible) with
  | Just ts -> ts
  | Nothing -> Nil

# ===========================================================================
# Phase B — signature unification for heterogeneous-arity mutual tail-call SCCs.
# See docs/mutual-tco-phase-b-v0.md.  A typed-program pre-pass pads such SCCs to a
# uniform max arity so Phase A's musttail (mutual_build_eligible + rewrite) fires;
# originals become thin trampolines.
# ===========================================================================

# Names of functions called in TAIL position in `body`.  Tail positions: the body
# itself, both `if` branches, every `match` arm, the last `do` step (only a
# TDoExprStep), and an immediately-applied lambda's (let/where) body.  Call ARGUMENTS
# and all non-tail sub-exprs are excluded — this is the discriminator that keeps
# Phase B off the non-tail recursive-descent superset.  Returns names verbatim (as
# they appear on the TVar callee), for matching against the decl fn names.
export fn pb_tail_callees(body: typed_ast.TypedExpr) -> Set =
  pb_tail_callees_sc(body, set_empty())

# Scope-aware tail-callee collection.  `bound` holds names bound MORE LOCALLY than
# the top-level fn — params, IIFE-lambda params, match-arm pattern vars, and
# do-`let`/`<-` binders in scope for the tail step.  A tail call whose callee TVar
# names such a local is an INDIRECT closure call, not a static edge to the
# same-named top-level fn; recording it would fabricate a spurious SCC and later
# route the `$u` rewrite to a global (finding #1: silent miscompile).  Mirrors
# translate_call's capture→param→let precedence; see callee_name_shadowed.
fn pb_tail_callees_sc(body: typed_ast.TypedExpr, bound: Set) -> Set =
  match body with
  | typed_ast.TCall callee args _ _ ->
      match callee with
      | typed_ast.TVar name _ _ ->
          if set_member(name, bound) then set_empty() else set_insert(name, set_empty())
      | typed_ast.TLambda lparams lbody _ _ ->
          # IIFE (let/where) at full arity: the let-body is the tail position; the
          # lambda params shadow within it.
          if list_length(lparams) == list_length(args)
          then pb_tail_callees_sc(lbody, set_union(bound, set_from_list(param_names(lparams))))
          else set_empty()
      | _ -> set_empty()
  | typed_ast.TIf _ t e _ _ -> set_union(pb_tail_callees_sc(t, bound), pb_tail_callees_sc(e, bound))
  | typed_ast.TMatch _ arms _ _ -> pb_tail_callees_arms(arms, bound)
  | typed_ast.TDo steps _ _ -> pb_tail_callees_do_last(steps, bound)
  | _ -> set_empty()

fn pb_tail_callees_arms(arms: List typed_ast.TypedMatchBranch, bound: Set) -> Set =
  match arms with
  | Nil -> set_empty()
  | Cons b rest ->
      match b with
      | typed_ast.TypedMatchBranch pat body ->
          set_union(pb_tail_callees_sc(body, set_union(bound, set_from_list(pattern_names(pat)))),
                    pb_tail_callees_arms(rest, bound))

# Names a do-step binds into scope for the steps that follow it.
fn pb_do_step_extend_bound(step: typed_ast.TypedDoStep, bound: Set) -> Set =
  match step with
  | typed_ast.TDoLetStep name _ -> set_insert(name, bound)
  | typed_ast.TDoBindStep pat _ -> set_union(bound, set_from_list(pattern_names(pat)))
  | typed_ast.TDoExprStep _ -> bound

# Only the LAST do-step is in tail position, and only if it is a plain expression
# step (a trailing `let`/`<-` bind is not a direct named tail call).  Earlier steps'
# binders are threaded into `bound` so a last-step call to a shadowed name is skipped.
fn pb_tail_callees_do_last(steps: List typed_ast.TypedDoStep, bound: Set) -> Set =
  match steps with
  | Nil -> set_empty()
  | Cons step rest ->
      match rest with
      | Nil ->
          match step with
          | typed_ast.TDoExprStep e -> pb_tail_callees_sc(e, bound)
          | typed_ast.TDoLetStep _ _ -> set_empty()
          | typed_ast.TDoBindStep _ _ -> set_empty()
      | _ -> pb_tail_callees_do_last(rest, pb_do_step_extend_bound(step, bound))

# --- Heterogeneous-arity tail-call SCC detection over typed decls. -----------
# Result: one (name, arity) list per SCC that is (a) a real mutual cycle (size >= 2)
# over TAIL edges, (b) all-`i64`-returning, and (c) heterogeneous (members differ in
# arity — same-arity cycles are Phase A's job). Deterministic: fns iterated in decl
# order, members in decl order.

fn pb_fn_arity(decls: List typed_ast.TypedDecl) -> Dict Int =
  match decls with
  | Nil -> dict_empty()
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name params _ _ _ _ -> dict_set(name, list_length(params), pb_fn_arity(rest))
      | _ -> pb_fn_arity(rest)

fn pb_fn_order(decls: List typed_ast.TypedDecl) -> List String =
  match decls with
  | Nil -> Nil
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name _ _ _ _ _ -> Cons(name, pb_fn_order(rest))
      | _ -> pb_fn_order(rest)

fn pb_set_keep_in(s: Set, fnset: Set) -> Set =
  pb_keep_go(set_to_list(s), fnset, set_empty())

fn pb_keep_go(xs: List String, fnset: Set, acc: Set) -> Set =
  match xs with
  | Nil -> acc
  | Cons x rest ->
      if set_member(x, fnset) then pb_keep_go(rest, fnset, set_insert(x, acc)) else pb_keep_go(rest, fnset, acc)

# name -> (tail callees restricted to fns in this program).
fn pb_tail_graph(decls: List typed_ast.TypedDecl, fnset: Set) -> Dict Set =
  match decls with
  | Nil -> dict_empty()
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name params _ _ _ body ->
          dict_set(name,
                   pb_set_keep_in(pb_tail_callees_sc(body, set_from_list(param_names(params))), fnset),
                   pb_tail_graph(rest, fnset))
      | _ -> pb_tail_graph(rest, fnset)

# The SCC (in `order`) of `f`: itself plus every g mutually tail-reachable with it.
fn pb_scc_of(f: String, order: List String, graph: Dict Set) -> List String =
  match order with
  | Nil -> Nil
  | Cons g rest ->
      if g == f then Cons(f, pb_scc_of_rest(f, rest, graph))
      else if mutual_reaches(f, g, graph) && mutual_reaches(g, f, graph)
           then Cons(g, pb_scc_of_rest(f, rest, graph))
           else pb_scc_of(f, rest, graph)

fn pb_scc_of_rest(f: String, order: List String, graph: Dict Set) -> List String =
  match order with
  | Nil -> Nil
  | Cons g rest ->
      if g == f then Cons(f, pb_scc_of_rest(f, rest, graph))
      else if mutual_reaches(f, g, graph) && mutual_reaches(g, f, graph)
           then Cons(g, pb_scc_of_rest(f, rest, graph))
           else pb_scc_of_rest(f, rest, graph)

# All members pass the return gate (v0: scalar return — see pb_scalar_ret_map).
fn pb_all_ret_ok(members: List String, ok: Dict Bool) -> Bool =
  match members with
  | Nil -> true
  | Cons m rest -> mutual_ret_i64_of(m, ok) && pb_all_ret_ok(rest, ok)

# The mutual-TCO pre-pass builds its OWN name→arity map (pb_fn_arity); it carries
# no CPR facts, so it stays a plain `Dict Int` and reads through this accessor
# rather than FnInfo's.
fn pb_arity_of(name: String, arity: Dict Int) -> Int =
  match dict_get(name, arity) with | Just a -> a | Nothing -> -1

# True iff the members do NOT all share one arity.
fn pb_heterogeneous(members: List String, arity: Dict Int) -> Bool =
  match members with
  | Nil -> false
  | Cons m rest -> pb_any_differs(pb_arity_of(m, arity), rest, arity)

fn pb_any_differs(a0: Int, members: List String, arity: Dict Int) -> Bool =
  match members with
  | Nil -> false
  | Cons m rest ->
      if ! (pb_arity_of(m, arity) == a0) then true else pb_any_differs(a0, rest, arity)

fn pb_members_with_arity(members: List String, arity: Dict Int) -> List (String, Int) =
  match members with
  | Nil -> Nil
  | Cons m rest -> Cons((m, pb_arity_of(m, arity)), pb_members_with_arity(rest, arity))

# Return gate: a member's return type must be a single i64 value — a scalar
# (TConst Int/Bool/Char/Float) OR a named ADT (TConst nullary / TApp
# parameterized, a heap pointer) — so the member fits the unified i64(i64×M)
# prototype Phase A musttail's.  Correctness when a member is match-routed to a
# Tier-2 CPR worker is handled independently of this gate: routing is gated to
# max-ctor-arity<=1 (is_simple_width2_arm), so the trampoline's width-2 repack
# shim is always correct and wider ADTs are simply never worker-routed; and the
# trampoline body carries the real return type (pb_gen_pair) so repack derives a
# non-empty ctor list.  Tuples/functions/type-vars are excluded (not the tested
# single-i64-return shape).  See docs/mutual-tco-phase-b-v0.md §5b.
fn pb_ret_unifiable(t: types.Type) -> Bool =
  # The conjunct makes "Phase B detection ⇒ Phase A musttail-eligibility"
  # structural rather than coincidental: Phase A's gate is llvm_ret_type == "i64"
  # (mutual_tco_rewrite_fn), so Phase B must not unify anything that gate would
  # reject.  Today llvm_ret_type ≡ "i64", so this conjunct is a no-op — but it
  # future-proofs the reserved sret return work (PR 2b), where llvm_ret_type turns
  # conditional and a bare shape test would silently unify sret cycles Phase A then
  # declines.  The shape test stays the STRICTER half (also excludes TFunc/TVar).
  # (Broadening the shape test to admit TTuple is a separate missed-optimization —
  # deferred: a tuple return has no adt_index entry, so worker-repack would derive
  # an empty ctor list. See BACKLOG §mutual-TCO follow-ups.)
  (llvm_ret_type(t) == "i64") &&
  (match t with
   | types.TConst _ -> true
   | types.TApp _ _ -> true
   | _ -> false)

fn pb_unifiable_ret_map(decls: List typed_ast.TypedDecl) -> Dict Bool =
  match decls with
  | Nil -> dict_empty()
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name _ _ _ _ body ->
          dict_set(name, pb_ret_unifiable(typed_ast.typed_expr_type(body)), pb_unifiable_ret_map(rest))
      | _ -> pb_unifiable_ret_map(rest)

export fn pb_hetero_sccs(decls: List typed_ast.TypedDecl) -> List (List (String, Int)) =
  pb_scc_collect(pb_fn_order(decls),
                 pb_fn_order(decls),
                 pb_tail_graph(decls, set_from_list(pb_fn_order(decls))),
                 pb_fn_arity(decls),
                 pb_unifiable_ret_map(decls),
                 set_empty())

fn pb_scc_collect(work: List String, order: List String, graph: Dict Set,
                  arity: Dict Int, ret: Dict Bool, seen: Set) -> List (List (String, Int)) =
  match work with
  | Nil -> Nil
  | Cons f rest ->
      if set_member(f, seen) then pb_scc_collect(rest, order, graph, arity, ret, seen)
      else pb_scc_emit(f, rest, order, graph, arity, ret, seen)

fn pb_scc_emit(f: String, rest: List String, order: List String, graph: Dict Set,
               arity: Dict Int, ret: Dict Bool, seen: Set) -> List (List (String, Int)) =
  if list_length(members) >= 2 && pb_all_ret_ok(members, ret) && pb_heterogeneous(members, arity)
  then Cons(pb_members_with_arity(members, arity),
            pb_scc_collect(rest, order, graph, arity, ret, seen2))
  else pb_scc_collect(rest, order, graph, arity, ret, seen2)
where
  members = pb_scc_of(f, order, graph)
  seen2 = set_union(seen, set_from_list(members))

# --- Generator: unify each heterogeneous SCC to a uniform max arity + emit a
# trampoline for each original.  `phase_b_unify(decls)` runs BEFORE detection in the
# pipeline (§5a); after it, the `<name>$u` variants are a same-prototype tail cycle
# that Phase A's musttail handles.  `$` is lexer-reserved, so `<name>$u` cannot
# collide with any source name and is not the reserved `__sprout_` prefix. -----

fn pb_int_ty() -> types.Type = types.TConst(types.type_id("Int"))

fn pb_max_int(a: Int, b: Int) -> Int = if a >= b then a else b

fn pb_max_arity(members: List (String, Int)) -> Int =
  match members with
  | Nil -> 0
  | Cons (_n, a) rest -> pb_max_int(a, pb_max_arity(rest))

fn pb_member_names(members: List (String, Int)) -> Set =
  match members with
  | Nil -> set_empty()
  | Cons (n, _a) rest -> set_insert(n, pb_member_names(rest))

# member-name -> (maxArity, memberSet).
fn pb_build_index(sccs: List (List (String, Int))) -> Dict (Int, Set) =
  match sccs with
  | Nil -> dict_empty()
  | Cons scc rest -> pb_index_scc(scc, pb_max_arity(scc), pb_member_names(scc), pb_build_index(rest))

fn pb_index_scc(members: List (String, Int), m: Int, mset: Set, acc: Dict (Int, Set)) -> Dict (Int, Set) =
  match members with
  | Nil -> acc
  | Cons (n, _a) rest -> dict_set(n, (m, mset), pb_index_scc(rest, m, mset, acc))

# `count` synthetic ignored params, uniquely named with a lexer-reserved `$`.
fn pb_pad_params(start: Int, count: Int) -> List ast.Param =
  if count <= 0 then Nil
  else Cons(ast.Param("pbpad$" ++ int_to_string(start), Nothing, ast.ModeDefault), pb_pad_params(start + 1, count - 1))

fn pb_zeros(count: Int, pos: source.SourcePos) -> List typed_ast.TypedExpr =
  if count <= 0 then Nil
  else Cons(typed_ast.TInt(0, pb_int_ty(), pos), pb_zeros(count - 1, pos))

# TVar reference for each original param (for the trampoline forwarding call).
fn pb_var_args(params: List ast.Param, pos: source.SourcePos) -> List typed_ast.TypedExpr =
  match params with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.Param n _ _ -> Cons(typed_ast.TVar(n, pb_int_ty(), pos), pb_var_args(rest, pos))

# Pad a call-arg list to length m with 0s.
fn pb_pad_to(args: List typed_ast.TypedExpr, m: Int, pos: source.SourcePos) -> List typed_ast.TypedExpr =
  list_append(args, pb_zeros(m - list_length(args), pos))

# Rewrite calls to SCC members that sit in TAIL position: retarget to `<g>$u` and pad
# args to m.  Mirrors pb_tail_callees' traversal exactly (so only true tail edges are
# rewritten); non-tail sub-exprs and non-member calls are left untouched.
# `bound` is threaded identically to pb_tail_callees_sc: a callee whose name is a
# local binding (param/IIFE/arm/do-binder) must NOT be retargeted to `<name>$u`
# even when it collides with a member name, or the indirect closure call becomes a
# direct global call (finding #1). Detection already drops such edges; this keeps
# rewrite consistent when a legit SCC formed via other edges.
fn pb_retarget_tail(body: typed_ast.TypedExpr, mset: Set, m: Int, bound: Set) -> typed_ast.TypedExpr =
  match body with
  | typed_ast.TCall callee args ty pos ->
      match callee with
      | typed_ast.TVar name vty vpos ->
          if set_member(name, mset) && ! set_member (name, bound)
          then typed_ast.TCall(typed_ast.TVar(name ++ "$u", vty, vpos), pb_pad_to(args, m, pos), ty, pos)
          else body
      | typed_ast.TLambda lparams lbody lty lpos ->
          if list_length(lparams) == list_length(args)
          then typed_ast.TCall(typed_ast.TLambda(lparams,
                 pb_retarget_tail(lbody, mset, m, set_union(bound, set_from_list(param_names(lparams)))),
                 lty, lpos), args, ty, pos)
          else body
      | _ -> body
  | typed_ast.TIf c t e ty pos ->
      typed_ast.TIf(c, pb_retarget_tail(t, mset, m, bound), pb_retarget_tail(e, mset, m, bound), ty, pos)
  | typed_ast.TMatch scrut arms ty pos ->
      typed_ast.TMatch(scrut, pb_retarget_arms(arms, mset, m, bound), ty, pos)
  | typed_ast.TDo steps ty pos ->
      typed_ast.TDo(pb_retarget_do(steps, mset, m, bound), ty, pos)
  | _ -> body

fn pb_retarget_arms(arms: List typed_ast.TypedMatchBranch, mset: Set, m: Int, bound: Set) -> List typed_ast.TypedMatchBranch =
  match arms with
  | Nil -> Nil
  | Cons b rest ->
      match b with
      | typed_ast.TypedMatchBranch pat body ->
          Cons(typed_ast.TypedMatchBranch(pat,
                 pb_retarget_tail(body, mset, m, set_union(bound, set_from_list(pattern_names(pat))))),
               pb_retarget_arms(rest, mset, m, bound))

fn pb_retarget_do(steps: List typed_ast.TypedDoStep, mset: Set, m: Int, bound: Set) -> List typed_ast.TypedDoStep =
  match steps with
  | Nil -> Nil
  | Cons step rest ->
      match rest with
      | Nil ->
          match step with
          | typed_ast.TDoExprStep e -> Cons(typed_ast.TDoExprStep(pb_retarget_tail(e, mset, m, bound)), Nil)
          | _ -> Cons(step, Nil)
      | _ -> Cons(step, pb_retarget_do(rest, mset, m, pb_do_step_extend_bound(step, bound)))

# For an SCC member, emit [trampoline (original name/arity), `<name>$u` (arity m)].
fn pb_gen_pair(name: String, params: List ast.Param, ret: Maybe ast.TypeExpr,
               eff: Maybe (List String), constraints: List ast.TypeConstraint,
               body: typed_ast.TypedExpr, m: Int, mset: Set) -> List typed_ast.TypedDecl =
  Cons(typed_ast.TFnDecl(name, params, ret, eff, constraints, tramp_body),
    Cons(typed_ast.TFnDecl(name ++ "$u", list_append(params, pb_pad_params(list_length(params), m - list_length(params))),
                           ret, eff, constraints, pb_retarget_tail(body, mset, m, set_from_list(param_names(params)))),
      Nil))
where
  pos = typed_ast.typed_expr_pos(body)
  # The trampoline body must carry the member's REAL return type: when the member
  # is match-routed to a CPR worker, worker_source_for derives the repack ctor
  # list from typed_expr_type(trampoline_body).  A placeholder Int here yields
  # adt_ctors_of_type(Int)=Nil -> "empty repack" crash for ADT returns.  See §5b.
  ret_ty = typed_ast.typed_expr_type(body)
  tramp_body = typed_ast.TCall(typed_ast.TVar(name ++ "$u", pb_int_ty(), pos),
                 list_append(pb_var_args(params, pos), pb_zeros(m - list_length(params), pos)),
                 ret_ty, pos)

# THE Phase B pre-pass: replace each heterogeneous-tail-SCC member with its
# trampoline + `$u` variant; pass everything else through.  No-op when there are no
# such SCCs (the common case), so its overhead is one detection pass.
export fn phase_b_unify(decls: List typed_ast.TypedDecl) -> List typed_ast.TypedDecl =
  pb_unify_with(decls, pb_build_index(pb_hetero_sccs(decls)))

# Program-level wrapper (used at the pipeline seam, before detection).
export fn phase_b_program(prog: typed_ast.TypedProgram) -> typed_ast.TypedProgram =
  match prog with
  | typed_ast.TypedProgram decls -> typed_ast.TypedProgram(phase_b_unify(decls))

fn pb_unify_with(decls: List typed_ast.TypedDecl, index: Dict (Int, Set)) -> List typed_ast.TypedDecl =
  match decls with
  | Nil -> Nil
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name params ret eff constraints body ->
          match dict_get(name, index) with
          | Just (m, mset) ->
              list_append(pb_gen_pair(name, params, ret, eff, constraints, body, m, mset),
                          pb_unify_with(rest, index))
          | Nothing -> Cons(d, pb_unify_with(rest, index))
      | _ -> Cons(d, pb_unify_with(rest, index))

# translate_user_fn: returns (IRFunction, next-free-temp-index, lifted-lambdas).
# The next-free index is the smallest idx never used as %tN/then_N/else_N/join_N
# during body translation; the rooting pass (M2 PR 2.2) consumes it to allocate
# fresh %tN names that do not collide with the translator's output.
# The third field is the flat list of lambda IRFunctions lifted during this fn.
# lambda_ctr_ref is shared across all user fns (lives at translate_program scope)
# so that lifted lambda names are unique program-wide (__sprout_ir_lambda_0, __sprout_ir_lambda_1, …).
fn translate_user_fn(name: String, params: List ast.Param, body: typed_ast.TypedExpr,
                     ctors: Dict sprout_ir.CtorInfo, top_level: Set,
                     let_names: Set,
                fn_arities: Dict FnInfo,
                     lambda_ctr_ref: Ref Int,
                     lifted_idx_ref: Ref (Dict Int)) ->
    Result String (Maybe(sprout_ir.IRFunction, Int, List sprout_ir.IRFunction)) !{IO} =
  do
    lifted_ref <- ref_new(Nil)
    # Prefix arg is ignored — fresh_name hardcodes "%t$" for ALL functions so
    # synthetic temps never collide with a source param named `t<N>` (→ %t<N>).
    match translate_body(body, pnames, ctors, 0, dict_empty(), lifted_ref, top_level, let_names, fn_arities,
                         lambda_ctr_ref, lifted_idx_ref, "%t") with
    | Err msg -> Err(msg)
    | Ok pair ->
        match pair with
        | (blocks, next_idx) ->
            do
              lifted <- ref_read(lifted_ref)
              # TCO: rewrite self-tail-recursion into an alloca-slot loop before
              # rooting. Skipped for the program entry point (never recursive) and
              # internally a no-op unless the body has a tail self-call.
              match maybe_tco(name, build_fn(name, params_with_kinds, ret_ty, blocks), next_idx) with
              | (tco_fn, next_idx2) ->
                  Ok(Just((tco_fn, next_idx2, list_reverse(lifted))))
  where ret_ty = llvm_ret_type(typed_ast.typed_expr_type(body))
        pnames = param_names(params)
        params_with_kinds = ast_params_to_irtype_pairs(params, pnames)

# Validate that no TInstanceDecl method name starts with "__sprout_".
# TInstanceDecl carries a List TypedInstanceMethod; each method's first field
# is the method name (TypedInstanceMethod String ...).
# FIX R4#5.
# O(n) where n = number of instance methods.
fn validate_instance_methods(methods: List typed_ast.TypedInstanceMethod) -> Result String Unit =
  match methods with
  | Nil -> Ok(())
  | Cons m rest ->
      match m with
      | typed_ast.TypedInstanceMethod mname _ _ _ _ ->
          if str_starts_with(mname, "__sprout_")
          then Err("ast_to_ir: instance method '" ++ mname ++ "' is reserved (cannot start with '__sprout_')")
          else validate_instance_methods(rest)

# Validate that no user declaration uses the reserved "__sprout_" name prefix.
# Checked once up-front in translate_program so every decl variant is covered
# by a single source of truth (avoids per-arm repetition and bypass bugs).
# TFnDecl and TExternFnDecl both carry a name field; TLetDecl carries a name
# field; TInstanceDecl has no single name field (it's a typeclass instance) and
# is skipped. TPassThrough contains type declarations, not fn names — skipped.
# Returns Ok(()) on success; Err describing the first violating name on failure.
# O(n) where n = number of declarations.
export fn validate_reserved_namespace(decls: List typed_ast.TypedDecl) -> Result String Unit =
  match decls with
  | Nil -> Ok(())
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name _ _ _ _ _ ->
          if str_starts_with(name, "__sprout_")
          then Err("ast_to_ir: name '" ++ name ++ "' is reserved (cannot start with '__sprout_')")
          else validate_reserved_namespace(rest)
      | typed_ast.TExternFnDecl name _ _ _ ->
          if str_starts_with(name, "__sprout_")
          then Err("ast_to_ir: name '" ++ name ++ "' is reserved (cannot start with '__sprout_')")
          else validate_reserved_namespace(rest)
      | typed_ast.TLetDecl name _ ->
          if str_starts_with(name, "__sprout_")
          then Err("ast_to_ir: name '" ++ name ++ "' is reserved (cannot start with '__sprout_')")
          else validate_reserved_namespace(rest)
      # FIX R4#5: TInstanceDecl methods were not checked. A user instance with a
      # method named __sprout_ir_lambda_<N> would silently collide with lifted lambdas.
      | typed_ast.TInstanceDecl _ _ methods ->
          match validate_instance_methods(methods) with
          | Err msg -> Err(msg)
          | Ok _ -> validate_reserved_namespace(rest)
      | _ -> validate_reserved_namespace(rest)

export fn translate_decl_with_idx(d: typed_ast.TypedDecl, ctors: Dict sprout_ir.CtorInfo,
                                  top_level: Set,
                         let_names: Set,
                         fn_arities: Dict FnInfo, lambda_ctr_ref: Ref Int,
                                  lifted_idx_ref: Ref (Dict Int)) ->
    Result String (Maybe(sprout_ir.IRFunction, Int, List sprout_ir.IRFunction)) !{IO} =
  match d with
  | typed_ast.TFnDecl name params ret_ty _ _ body ->
      # __sprout_ reservation check is done once up-front in translate_program via
      # validate_reserved_namespace; no per-arm check needed here.
      # is_entry_fn_name accepts both bare `main` and the bundler-qualified
      # `<module>.main` (any entry file with a `module` declaration), mirroring
      # direct codegen's is_entry_fn_name (codegen.sprout:1906). Without the
      # qualified form, a module-declaring program's main was emitted as
      # `<module>.main` and the @main shim never called it → empty output.
      if is_entry_fn_name(name)
      then
        # M3 PR 11: accept any main body.  A trivial TUnit body needs no IR
        # (the C-ABI shim in ir_lowering handles @main); a non-trivial body
        # (TCall, TDo, …) is translated as @__sprout_user_main with no params
        # and called by the shim.  See ir_lowering.main_shim.
        match body with
        | typed_ast.TUnit _ _ -> Ok(Nothing)
        | _ -> translate_user_fn(user_main_fn_name(ret_ty), params, body, ctors, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref)
      else translate_user_fn(name, params, body, ctors, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref)
  | typed_ast.TExternFnDecl _ _ _ _ -> Ok(Nothing)
  | typed_ast.TLetDecl _ _ -> Ok(Nothing)
  | typed_ast.TInstanceDecl _ _ _ -> Ok(Nothing)
  | typed_ast.TPassThrough _ -> Ok(Nothing)

fn translate_decls(decls: List typed_ast.TypedDecl, ctors: Dict sprout_ir.CtorInfo,
                   acc_fns: List sprout_ir.IRFunction,
                   acc_idx: Dict Int, top_level: Set, let_names: Set, fn_arities: Dict FnInfo, lambda_ctr_ref: Ref Int,
                   lifted_idx_ref: Ref (Dict Int)) ->
    Result String (List sprout_ir.IRFunction, Dict Int) !{IO} =
  match decls with
  | Nil -> Ok((list_reverse(acc_fns), acc_idx))
  | Cons d rest ->
      match translate_decl_with_idx(d, ctors, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref) with
      | Err msg -> Err(msg)
      | Ok maybe_f ->
          match maybe_f with
          | Nothing -> translate_decls(rest, ctors, acc_fns, acc_idx, top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref)
          | Just triple ->
              match triple with
              | (f, idx, lifted) ->
                  match f with
                  | sprout_ir.IRFunction fname _ _ _ ->
                      # acc_fns is built in reverse; list_reverse at Nil base.
                      # Prepend f, then lifted lambdas in front of it.
                      # cons_list(lifted, acc_fns) pushes lifted in reverse onto
                      # acc_fns; Cons(f, ...) puts f in front of them.
                      # After list_reverse at the end: lifted_0, lifted_1, ..., f
                      # — lifted lambdas appear BEFORE the user fn that references them.
                      translate_decls(rest, ctors,
                                      Cons(f, cons_list(lifted, acc_fns)),
                                      dict_set(fname, idx, acc_idx),
                                      top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref)

# Prepend a list (in order) onto an accumulator list.
# cons_list([a,b,c], rest) = Cons(c, Cons(b, Cons(a, rest)))
# so that after list_reverse at end: [...rest_reversed, a, b, c]
# O(n).
fn cons_list(xs: List sprout_ir.IRFunction,
             acc: List sprout_ir.IRFunction) -> List sprout_ir.IRFunction =
  match xs with
  | Nil -> acc
  | Cons x rest -> cons_list(rest, Cons(x, acc))

# Merge two fn-name → idx dicts, with d2 entries taking precedence.
# Used to fold lifted-lambda idx entries into the main idx_map.
# O(n * log(n)) where n = |d2|.
export fn merge_idx_dicts(d1: Dict Int, d2: Dict Int) -> Result String (Dict Int) =
  merge_idx_dicts_keys(d1, vec_to_list(dict_keys(d2)), d2)

# O(n * log(n)).
fn merge_idx_dicts_keys(acc: Dict Int, keys: List String, src: Dict Int) -> Result String (Dict Int) =
  match keys with
  | Nil -> Ok(acc)
  | Cons k rest ->
      match dict_get(k, src) with
      # Nothing is unreachable: dict_keys and dict_get must agree on the same dict.
      # If this fires, the stdlib Dict implementation has a consistency bug.
      | Nothing -> Err("merge_idx_dicts: dict_keys/dict_get inconsistency for key '" ++ k ++ "' — this is unreachable")
      | Just v -> merge_idx_dicts_keys(dict_set(k, v, acc), rest, src)

# M3 PR 5: top-level let binding helpers.
#
# Sprout's top-level `let x = expr` declarations lower to LLVM globals,
# matching direct codegen's mechanism exactly (codegen.sprout:3895-3917).
#
# - eval_const_expr_ir(e) classifies an expression as compile-time-evaluable.
#   Only TInt / TBool / TUnit literals qualify — anything else (binary ops,
#   string concat, fn calls, …) is runtime-computed.
# - build_top_level_let_names(decls) collects let names into a Set, used by
#   the TVar resolution branch in translate_expr to detect a global load.
# - classify_let_decls_ir(decls) splits TLetDecls into two buckets:
#     (1) const-eligible → IRGlobalDecl with GlobalConst (emitted as
#         `@name = private constant T <literal>` by ir_lowering).
#     (2) runtime-computed → IRGlobalDecl with GlobalZeroInit + a pending
#         (name, body) pair that becomes a store in @__sprout_init_globals.

fn eval_const_expr_ir(e: typed_ast.TypedExpr) -> Maybe String =
  match e with
  | typed_ast.TInt n _ _ -> Just(int_to_string(n))
  | typed_ast.TBool b _ _ -> Just(if b then "1" else "0")
  | typed_ast.TUnit _ _ -> Just("0")
  | _ -> Nothing

# Per-fn codegen facts, keyed by top-level fn/extern name.
#   arity      — declared parameter count.
#   cpr_result — the declared result type has a KNOWN representation, so a CPR
#                worker for it can be lowered.
#
# `cpr_result` is false for a type-variable result. One `@f_worker` symbol
# cannot serve both an ADT instantiation ({ tag, field0 }) and a tuple one
# ({ f0, f1 }), and without monomorphization a polymorphic callee has both
# available in the same program — so the routers must decline it. Reading the
# payload as a tag was silent wrong answers plus an out-of-bounds load; see
# docs/bug-adt-through-generic-param-2026-08-12.md.
export type FnInfo = (arity: Int, cpr_result: Bool)

export fn fn_info(arity: Int, cpr_result: Bool) -> FnInfo =
  FnInfo(arity = arity, cpr_result = cpr_result)

# True iff a worker returning `t` can be lowered: `t` is a known ADT (its tag
# chain drives emit_repack_arms) or a scalar tuple (all-fields convention).
# The SAME oracle the emitter uses, so router and emitter cannot disagree.
fn cpr_result_lowerable(t: types.Type, adt_index: Dict (List (Int, Int))) -> Bool =
  (match adt_ctors_of_type(t, adt_index) with | Nil -> false | _ -> true)
  || (match scalar_tuple_width(t) with | Just _ -> true | Nothing -> false)

fn cpr_result_lowerable_typeexpr(mte: Maybe ast.TypeExpr,
                                 adt_index: Dict (List (Int, Int))) -> Bool =
  match adt_ctors_of_typeexpr(mte, adt_index) with | Nil -> false | _ -> true

# True iff `name` is a callee whose result the CPR worker path can lower.
# Unknown names answer false: a top-level `let` or ctor is never workerized
# (worker_source_for returns Nothing for it), so routing one would call a
# symbol that is never emitted.
fn cpr_result_known(name: String, fn_arities: Dict FnInfo) -> Bool =
  match dict_get(name, fn_arities) with
  | Just info -> info.cpr_result
  | Nothing -> false

# M3 PR 6: build a Dict mapping every top-level fn name (user fns +
# externs) to its FnInfo.  `arity` is used in translate_expr's TVar
# fallthrough to synthesize an eta wrapper closure when a fn is passed as a
# value (e.g. `list_map_go(parse_int, xs)`).  Top-level fns referenced by name
# but not called need a wrapper because Sprout's closure ABI requires the
# code-ptr fn to take `i64 %env` as its first argument — the original
# fn has no such param.
export fn build_fn_arities(decls: List typed_ast.TypedDecl,
                           adt_index: Dict (List (Int, Int))) -> Dict FnInfo =
  match decls with
  | Nil -> dict_empty()
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name params _ _ _ body ->
          dict_set(name,
                   fn_info(list_length(params),
                           cpr_result_lowerable(typed_ast.typed_expr_type(body), adt_index)),
                   build_fn_arities(rest, adt_index))
      | typed_ast.TExternFnDecl name params eret _ ->
          dict_set(name,
                   fn_info(list_length(params),
                           cpr_result_lowerable_typeexpr(eret, adt_index)),
                   build_fn_arities(rest, adt_index))
      | _ -> build_fn_arities(rest, adt_index)

# M3 PR 14: collect user `extern fn` declarations as (name, arity) pairs so
# ir_lowering can emit a `declare i64 @<name>(i64, …)` line for each.  The
# i64-uniform encoding means we only need the arity — parameter and return
# types are all i64 in the IR codegen path.
export fn collect_extern_decls(decls: List typed_ast.TypedDecl) -> List (String, Int) =
  match decls with
  | Nil -> Nil
  | Cons d rest ->
      match d with
      | typed_ast.TExternFnDecl name params _ _ ->
          Cons((name, list_length(params)), collect_extern_decls(rest))
      | _ -> collect_extern_decls(rest)

# M3 PR 6: synthesize the wrapper IRFunction for an eta-expanded named-fn
# reference.  Mirrors codegen.sprout:1434-1444's emit_named_fn_wrapper_lines.
# Shape (arity N):
#   define i64 @<wrapper_name>(i64 %env, i64 %a0, ..., i64 %a{N-1}) {
#   entry:
#     %ret = call i64 @<fn_name>(i64 %a0, ..., i64 %a{N-1})
#     ret i64 %ret
#   }
# The %env param is required by Sprout's closure ABI (first arg is the env
# pointer) but is unused — the wrapper just forwards the user args.
fn synthesize_eta_wrapper(fn_name: String, arity: Int, wrapper_name: String) -> sprout_ir.IRFunction =
  sprout_ir.IRFunction(wrapper_name,
                        Cons(("env$", sprout_ir.IRTHeap), build_wrapper_arg_params(0, arity)),
                        "i64",
                        Cons(sprout_ir.IRBlock("entry",
                              Cons(sprout_ir.IRCall("%ret", sprout_ir.IRTUnknown, fn_name, build_wrapper_arg_ssas(0, arity)),
                              Cons(sprout_ir.IRRet("%ret"), Nil))),
                        Nil))

# Arity recorded for a closure the apply-site check must wave through.
#
# SYNC WITH runtime/sprout_runtime.c SPROUT_CLOSURE_ARITY_ANY (the arity field is
# 18 bits; this is all of them set).  Only the poison thunk below uses it: that
# thunk declares no user parameters yet is applied with the method's arguments,
# so a real arity would make the check fire first and replace its located message
# with a generic arity mismatch.
fn closure_arity_any() -> Int = 262143

# Poison thunk for an unresolved (free-tyvar) typeclass dict — see the
# `__unresolved_` branch in translate_expr.  A closure whose slot-0 code pointer
# is this thunk lowers exactly like any other closure (IRMkClosure), so applying
# it via the closure ABI (ir_lowering IRApplyClosure: `load code; call code(...)`)
# runs the thunk, which PANICS with a located message.  Takes only the implicit
# `env$` handle; the apply site may pass extra method args, which a `noreturn`
# panic ignores.  Reuses the existing `@panic` builtin (IRPanic) — no runtime
# change.  The message substring "unresolved typeclass dictionary" is pinned by
# tests/stdlib/test_unresolved_dict_poison.spr.
fn synthesize_unresolved_poison_thunk(thunk_name: String) -> sprout_ir.IRFunction =
  sprout_ir.IRFunction(thunk_name,
                        Cons(("env$", sprout_ir.IRTHeap), Nil),
                        "i64",
                        Cons(sprout_ir.IRBlock("entry",
                              Cons(sprout_ir.IRStrConst("%__poison_msg", "%__poison_msg_raw",
                                     "runtime error: dispatched through an unresolved typeclass dictionary — a required instance was missing at compile time (compiler-soundness backstop; please report)"),
                              Cons(sprout_ir.IRPanic("%__poison_msg"), Nil))),
                        Nil))

fn build_wrapper_arg_params(idx: Int, arity: Int) -> List (String, sprout_ir.IRType) =
  if idx >= arity then Nil
  else Cons(("a" ++ int_to_string(idx), sprout_ir.IRTHeap), build_wrapper_arg_params(idx + 1, arity))

fn build_wrapper_arg_ssas(idx: Int, arity: Int) -> List String =
  if idx >= arity then Nil
  else Cons("%a" ++ int_to_string(idx), build_wrapper_arg_ssas(idx + 1, arity))

export fn build_top_level_let_names(decls: List typed_ast.TypedDecl) -> Set =
  match decls with
  | Nil -> set_empty()
  | Cons d rest ->
      match d with
      | typed_ast.TLetDecl name _ -> set_insert(name, build_top_level_let_names(rest))
      | _ -> build_top_level_let_names(rest)

export fn classify_let_decls_ir(decls: List typed_ast.TypedDecl) ->
    (List sprout_ir.IRGlobalDecl, List(source.GlobalName, typed_ast.TypedExpr)) =
  classify_let_decls_ir_acc(decls, Nil, Nil)

fn classify_let_decls_ir_acc(decls: List typed_ast.TypedDecl,
                              globals_acc: List sprout_ir.IRGlobalDecl,
                              runtime_acc: List (source.GlobalName, typed_ast.TypedExpr)) ->
    (List sprout_ir.IRGlobalDecl, List(source.GlobalName, typed_ast.TypedExpr)) =
  match decls with
  | Nil -> (list_reverse(globals_acc), list_reverse(runtime_acc))
  | Cons d rest ->
      match d with
      | typed_ast.TLetDecl name body ->
          match eval_const_expr_ir(body) with
          | Just ir_literal ->
              classify_let_decls_ir_acc(rest,
                Cons(sprout_ir.IRGlobalDecl(name, "i64", sprout_ir.GlobalConst(ir_literal)), globals_acc),
                runtime_acc)
          | Nothing ->
              classify_let_decls_ir_acc(rest,
                Cons(sprout_ir.IRGlobalDecl(name, "i64", sprout_ir.GlobalZeroInit), globals_acc),
                Cons((source.GlobalName(name), body), runtime_acc))
      | _ -> classify_let_decls_ir_acc(rest, globals_acc, runtime_acc)

# Synthesize @__sprout_init_globals: evaluate each runtime-let body in
# sequence, IRStoreGlobal the result into the corresponding @name slot,
# end with `ret void`.  Mirrors codegen.sprout:3276-3297.
# Returns (init_fn, lifted) where `lifted` are functions synthesized while
# translating the let-initializer bodies (eta wrappers and lifted lambdas).
# Callers MUST emit `lifted` alongside init_fn — a top-level `let` bound to a
# `_`-placeholder partial (e.g. `let f = repeat("x", _)`) lifts a lambda here;
# dropping it leaves an undefined reference.
export fn synthesize_init_globals_fn(runtime_lets: List (source.GlobalName, typed_ast.TypedExpr),
                                     ctors: Dict sprout_ir.CtorInfo,
                                     top_level: Set, let_names: Set,
                                     fn_arities: Dict FnInfo,
                                     lambda_ctr_ref: Ref Int,
                                     lifted_idx_ref: Ref (Dict Int)) ->
    Result String (sprout_ir.IRFunction, List sprout_ir.IRFunction, Int) !{IO} =
  do
    lifted_ref <- ref_new(Nil)
    match synthesize_init_body_loop(runtime_lets, ctors, "entry", Nil, Nil, 0,
                                     lifted_ref, top_level, let_names, fn_arities,
                                     lambda_ctr_ref, lifted_idx_ref) with
    | Err msg -> Err(msg)
    | Ok pair ->
        match pair with
        # next_idx is the next-free %tN index after the init body; it MUST be
        # registered in idx_map for "__sprout_init_globals" so the rooting pass
        # picks collision-free root-slot names (else %t0.. collide with body).
        | (blocks, cur_lbl, cur_ops, next_idx) ->
            do
              lifted <- ref_read(lifted_ref)
              Ok((sprout_ir.IRFunction("__sprout_init_globals", Nil, "void",
                                       list_append(blocks,
                                         Cons(sprout_ir.IRBlock(cur_lbl,
                                                list_append(cur_ops,
                                                  Cons(sprout_ir.IRRetVoid, Nil))),
                                         Nil))),
                   list_reverse(lifted), next_idx))

# The root-registration op for a top-level let's storage slot — or Nil when the global
# holds a non-heap scalar.
#
# Type-aware global rooting.  Only a global that can hold a heap value needs a permanent
# entry in the GC root table.  Int / Bool / Char / Double are immediate i64 values, never
# pointers, so registering them is pure cost: the root table is walked on every collection
# for the life of the process, and a conservative scan is handed raw arithmetic bit
# patterns as pointer candidates.  `stdlib/math.sprout` alone contributed 33 such entries,
# every one an arithmetic Double.
#
# This mirrors the policy `ir_rooting` already applies to SSA values — "Intentional design
# — do not root non-heap scalars" (docs/compiler-internals.md), where type-aware rooting
# measured 1.5-2.7x on N-queens — which the global path did not previously honour: the
# registration was emitted unconditionally, with no type check.
#
# Conservative by construction, per the companion invariant "when no source-level type is
# available, root conservatively": type_is_non_heap_scalar returns false for everything
# that is not one of those four TConsts, TVar included, so an unknown type is still rooted.
# A spurious root is harmless; a missing root corrupts the heap.
fn global_root_ops(gname: String, t: types.Type) -> List sprout_ir.IROp =
  if type_kind.type_is_non_heap_scalar(t) then Nil
  else Cons(sprout_ir.IRRegisterGlobalRoot(gname), Nil)

fn synthesize_init_body_loop(runtime_lets: List (source.GlobalName, typed_ast.TypedExpr),
                              ctors: Dict sprout_ir.CtorInfo,
                              cur_label: String,
                              cur_ops: List sprout_ir.IROp,
                              blocks: List sprout_ir.IRBlock,
                              idx: Int,
                              lifted_ref: Ref (List sprout_ir.IRFunction),
                              top_level: Set, let_names: Set,
                              fn_arities: Dict FnInfo,
                              lambda_ctr_ref: Ref Int,
                              lifted_idx_ref: Ref (Dict Int)) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, Int) !{IO} =
  match runtime_lets with
  | Nil -> Ok((blocks, cur_label, cur_ops, idx))
  | Cons head rest ->
      match head with
      | (gname, body) ->
          match translate_expr(body, Nil, ctors, idx, cur_label, cur_ops,
                                dict_empty(), lifted_ref, top_level, let_names, fn_arities,
                                lambda_ctr_ref, lifted_idx_ref, "%t") with
          | Err msg -> Err(msg)
          | Ok body_r ->
              match body_r with
              | (body_blocks, body_lbl, body_ops, body_result, next_idx) ->
                  # Store the initializer, then register the global's slot as a
                  # permanent GC root — but only if it can hold a heap value; see
                  # global_root_ops.  IRStoreGlobal/IRRegisterGlobalRoot take the
                  # raw @name string.
                  synthesize_init_body_loop(rest, ctors, body_lbl,
                    list_append(body_ops,
                      Cons(sprout_ir.IRStoreGlobal(source.global_name_str(gname), body_result),
                        global_root_ops(source.global_name_str(gname),
                                        typed_ast.typed_expr_type(body)))),
                    list_append(blocks, body_blocks), next_idx,
                    lifted_ref, top_level, let_names, fn_arities,
                    lambda_ctr_ref, lifted_idx_ref)

# translate_program: top-level entry.  Accepts a TypedProgram (the output of
# compile_phase_recheck) and returns either (IRProgram, next-idx-per-fn) or an
# Err describing the first unsupported AST node encountered.
#
# The Dict maps fn-name → next-free %tN index; the rooting pass uses it to
# pick fresh slot/discard names without colliding with translator-allocated
# ones.
export fn translate_program(prog: typed_ast.TypedProgram) ->
    Result String (sprout_ir.IRProgram, Dict Int) !{IO} =
  match prog with
  | typed_ast.TypedProgram decls ->
      match validate_reserved_namespace(decls) with
      | Err msg -> Err(msg)
      | Ok _ ->
      match build_ctor_table(decls) with
      | (ctor_dict, ctor_regs) ->
          do
            # Shared counter for unique __sprout_ir_lambda_N naming across all user fns.
            lambda_ctr_ref <- ref_new(0)
            # Accumulates lifted-lambda name → next-free-idx for the rooting pass.
            lifted_idx_ref <- ref_new(dict_empty())
            # M3 PR 5: top-level let bindings.
            # M3 PR 6: top-level fn arities (for eta-expansion at TVar refs).
            let let_names = build_top_level_let_names(decls)
            let top_level_set = build_top_level_set(decls, ctor_dict)
            let fn_arities = build_fn_arities(decls, build_adt_ctor_index(decls, ctor_dict))
            let classified = classify_let_decls_ir(decls)
            translate_program_after_classify(decls, ctor_dict, ctor_regs,
                                              classified, top_level_set, let_names,
                                              fn_arities,
                                              lambda_ctr_ref, lifted_idx_ref)

# Helper for translate_program's post-classify pipeline.  Extracted so the
# match nesting stays linear and avoids deep do-block indentation.
fn translate_program_after_classify(decls: List typed_ast.TypedDecl,
                                    ctors: Dict sprout_ir.CtorInfo,
                                    ctor_regs: List sprout_ir.CtorReg,
                                    classified: (List sprout_ir.IRGlobalDecl, List(source.GlobalName, typed_ast.TypedExpr)),
                                    top_level_set: Set, let_names: Set,
                                    fn_arities: Dict FnInfo,
                                    lambda_ctr_ref: Ref Int,
                                    lifted_idx_ref: Ref (Dict Int)) ->
    Result String (sprout_ir.IRProgram, Dict Int) !{IO} =
  match classified with
  | (let_globals, runtime_lets) ->
      match translate_decls(decls, ctors, Nil, dict_empty(),
                             top_level_set, let_names, fn_arities,
                             lambda_ctr_ref, lifted_idx_ref) with
      | Err msg -> Err(msg)
      | Ok pair ->
          match pair with
          | (fns0, idx_map0) ->
            # Tier-2 CPR: emit an unboxed { i64, i64 } worker for every matched
            # callee, appended after the boxed fns; their next-free idx is merged
            # into idx_map so the rooting pass can allocate fresh temps.  (The
            # active streaming path does the same in ir_pipeline.stream_workers.)
            match tier2_augment_fns(decls, ctors, top_level_set, let_names, fn_arities,
                                    lambda_ctr_ref, lifted_idx_ref, fns0, idx_map0) with
            | Err wmsg -> Err(wmsg)
            | Ok aug ->
              match aug with
              | (fns, idx_map) ->
              match runtime_lets with
              | Nil ->
                  do
                    lifted_idx <- ref_read(lifted_idx_ref)
                    match merge_idx_dicts(idx_map, lifted_idx) with
                    | Err msg -> Err(msg)
                    | Ok merged -> Ok((sprout_ir.IRProgram(fns, let_globals, ctor_regs, externs), merged))
              | _ ->
                  match synthesize_init_globals_fn(runtime_lets, ctors,
                                                    top_level_set, let_names, fn_arities,
                                                    lambda_ctr_ref, lifted_idx_ref) with
                  | Err msg -> Err(msg)
                  | Ok init_pair ->
                      match init_pair with
                      | (init_fn, init_lifted, init_idx) ->
                          do
                            # Read lifted-idx AFTER init synthesis so lambdas lifted
                            # while translating let-initializer bodies are registered,
                            # and record __sprout_init_globals' own next-free idx.
                            lifted_idx <- ref_read(lifted_idx_ref)
                            match merge_idx_dicts(idx_map, lifted_idx) with
                            | Err msg -> Err(msg)
                            | Ok merged ->
                                Ok((sprout_ir.IRProgram(
                                      list_append(fns, list_append(init_lifted, Cons(init_fn, Nil))),
                                      let_globals, ctor_regs, externs),
                                    dict_set("__sprout_init_globals", init_idx, merged)))
  where externs = collect_extern_decls(decls)

# ===========================================================================
# Tier-2 CPR: worker emission for width-2-ADT-returning Sprout fns / externs.
# ===========================================================================
# A `match f(args)` over a top-level fn/extern `f` whose result is a width-2 ADT
# (every ctor holds <=1 field) routes to an emitted `{i64,i64}`-returning worker
# `@f_worker` (unboxed_maybe_match_target) instead of allocating a boxed ctor.
# Worker emission is TOTAL over the matched-callee set: recognized tail shapes
# (nullary / 1-field ctor, `if`, chained call to a Maybe-extern) unbox directly;
# anything else falls back to a boxed repack (call boxed, read tag, pack {tag,val}
# — val=0 in the tag-less arm so a nullary ctor's absent field is never read).

# Head TConst of a possibly-applied inferred type: `Maybe Int` -> "Maybe".
fn type_head_name(t: types.Type) -> Maybe String =
  match t with
  | types.TConst name -> Just(types.type_id_name(name))
  | types.TApp base _ -> type_head_name(base)
  | _ -> Nothing

# Head TypeName of a possibly-applied syntactic type: `Result E T` -> "Result".
fn typeexpr_head_name(te: ast.TypeExpr) -> Maybe String =
  match te with
  | ast.TypeName name -> Just(name)
  | ast.TypeApply base _ -> typeexpr_head_name(base)
  | _ -> Nothing

# adt_name -> [(tag, arity)] over its ctors, from the program's TypeDecls.  The
# repack fallback consults this to know which tags carry a payload.
export fn build_adt_ctor_index(decls: List typed_ast.TypedDecl,
                               ctors: Dict sprout_ir.CtorInfo) -> Dict (List (Int, Int)) =
  build_adt_ctor_index_go(decls, ctors, dict_empty())

fn build_adt_ctor_index_go(decls: List typed_ast.TypedDecl,
                           ctors: Dict sprout_ir.CtorInfo,
                           acc: Dict (List (Int, Int))) -> Dict (List (Int, Int)) =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      match d with
      | typed_ast.TPassThrough pd ->
          match pd with
          | ast.TypeDecl adt_name _ ctor_list _ _ _ ->
              # Key by BOTH the (possibly module-qualified) declared name AND its
              # bare last segment.  The type system identifies types by bare
              # TConst names, so a catch-all repack's `type_head_name(body)` is
              # bare (e.g. "TokenKind") while the bundled TypeDecl name is
              # qualified ("stdlib.compiler.token.TokenKind"); keying both lets
              # the bare lookup resolve.
              build_adt_ctor_index_go(rest, ctors,
                dict_set(after_last_dot_local(adt_name), adt_ctor_entries(ctor_list, ctors),
                  dict_set(adt_name, adt_ctor_entries(ctor_list, ctors), acc)))
          | _ -> build_adt_ctor_index_go(rest, ctors, acc)
      | _ -> build_adt_ctor_index_go(rest, ctors, acc)

# Bare last segment of a possibly-dotted name: "a.b.C" -> "C", "C" -> "C".
fn after_last_dot_local(name: String) -> String =
  match last_dot_index(name, 0, str_len(name), 0 - 1) with
  | idx -> if idx < 0 then name else str_slice(name, idx + 1, str_len(name) - idx - 1)

fn last_dot_index(name: String, i: Int, n: Int, last: Int) -> Int =
  if i >= n then last
  else match str_char_at(name, i) with
       | Just c -> last_dot_index(name, i + 1, n, if c == '.' then i else last)
       | Nothing -> last

fn adt_ctor_entries(cs: List ast.TypeConstructor,
                    ctors: Dict sprout_ir.CtorInfo) -> List (Int, Int) =
  match cs with
  | Nil -> Nil
  | Cons c rest ->
      match c with
      | ast.TypeConstructor cname args _ _ ->
          match dict_get(cname, ctors) with
          | Just entry ->
              match entry with
              | sprout_ir.CtorInfo tag _ar _m _f _ -> Cons((tag, list_length(args)), adt_ctor_entries(rest, ctors))
          | Nothing -> adt_ctor_entries(rest, ctors)

fn adt_ctors_of_type(t: types.Type, adt_index: Dict (List (Int, Int))) -> List (Int, Int) =
  match type_head_name(t) with
  | Just name ->
      (match dict_get(name, adt_index) with | Just cs -> cs | Nothing -> Nil)
  | Nothing -> Nil

fn adt_ctors_of_typeexpr(mte: Maybe ast.TypeExpr,
                         adt_index: Dict (List (Int, Int))) -> List (Int, Int) =
  let Just te = mte else Nil
      Just name = typeexpr_head_name(te) else Nil
      Just cs = dict_get(name, adt_index) else Nil
  in cs

# ---------------------------------------------------------------------------
# Emission scan: the shadow-free superset of what the router routes.

export fn collect_worker_callees(decls: List typed_ast.TypedDecl, top_level: Set,
                                 ctors: Dict sprout_ir.CtorInfo,
                                 fn_arities: Dict FnInfo) -> Set =
  # The scan itself stays shape-only (a shadow-free superset of the router), and
  # the representation gate is applied once to the result. Filtering here rather
  # than at each insertion point keeps the ~12 collect_wc_* walkers untouched;
  # the predicate depends only on the callee name, so the two are equivalent.
  #
  # This must match the routers exactly. Emitting a worker the routers decline
  # would be dead code, but `translate_tail_chain` also chains to any name in
  # this set — so an un-gated entry here would reintroduce the ABI mismatch on
  # the worker-to-worker path.
  keep_cpr_eligible(set_to_list(collect_wc_decls(decls, top_level, ctors, set_empty())),
                    fn_arities, set_empty())

fn keep_cpr_eligible(names: List String, fn_arities: Dict FnInfo, acc: Set) -> Set =
  match names with
  | Nil -> acc
  | Cons n rest ->
      keep_cpr_eligible(rest, fn_arities,
                        if cpr_result_known(n, fn_arities) then set_insert(n, acc) else acc)

fn collect_wc_decls(decls: List typed_ast.TypedDecl, top_level: Set,
                    ctors: Dict sprout_ir.CtorInfo, acc: Set) -> Set =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      collect_wc_decls(rest, top_level, ctors, collect_wc_decl(d, top_level, ctors, acc))

fn collect_wc_decl(d: typed_ast.TypedDecl, top_level: Set,
                   ctors: Dict sprout_ir.CtorInfo, acc: Set) -> Set =
  match d with
  | typed_ast.TFnDecl _ _ _ _ _ body -> collect_wc_expr(body, top_level, ctors, acc)
  | typed_ast.TLetDecl _ body -> collect_wc_expr(body, top_level, ctors, acc)
  | typed_ast.TInstanceDecl _ _ methods -> collect_wc_methods(methods, top_level, ctors, acc)
  | _ -> acc

fn collect_wc_methods(methods: List typed_ast.TypedInstanceMethod, top_level: Set,
                      ctors: Dict sprout_ir.CtorInfo, acc: Set) -> Set =
  match methods with
  | Nil -> acc
  | Cons m rest ->
      match m with
      | typed_ast.TypedInstanceMethod _ _ _ _ body ->
          collect_wc_methods(rest, top_level, ctors, collect_wc_expr(body, top_level, ctors, acc))

fn collect_wc_expr(e: typed_ast.TypedExpr, top_level: Set,
                   ctors: Dict sprout_ir.CtorInfo, acc: Set) -> Set =
  match e with
  | typed_ast.TMatch scrut arms _ _ ->
      collect_wc_branches(arms, top_level, ctors,
        collect_wc_expr(scrut, top_level, ctors,
          collect_wc_scrutinee(scrut, arms, top_level, ctors, acc)))
  | typed_ast.TCall callee args _ _ ->
      collect_wc_exprs(args, top_level, ctors, collect_wc_expr(callee, top_level, ctors, acc))
  | typed_ast.TIf c t el _ _ ->
      collect_wc_expr(el, top_level, ctors,
        collect_wc_expr(t, top_level, ctors,
          collect_wc_expr(c, top_level, ctors, acc)))
  | typed_ast.TTuple es _ _ -> collect_wc_exprs(es, top_level, ctors, acc)
  | typed_ast.TLambda _ body _ _ -> collect_wc_expr(body, top_level, ctors, acc)
  | typed_ast.TBinary _ l r _ _ ->
      collect_wc_expr(r, top_level, ctors, collect_wc_expr(l, top_level, ctors, acc))
  | typed_ast.TUnary _ x _ _ -> collect_wc_expr(x, top_level, ctors, acc)
  | typed_ast.TRange a b _ _ ->
      collect_wc_expr(b, top_level, ctors, collect_wc_expr(a, top_level, ctors, acc))
  | typed_ast.TDo steps _ _ -> collect_wc_dosteps(steps, top_level, ctors, acc)
  | typed_ast.TRecord _ fields _ _ -> collect_wc_fields(fields, top_level, ctors, acc)
  | typed_ast.TGetField x _ _ _ -> collect_wc_expr(x, top_level, ctors, acc)
  | typed_ast.TRecordUpdate base fields _ _ ->
      collect_wc_fields(fields, top_level, ctors, collect_wc_expr(base, top_level, ctors, acc))
  | _ -> acc

fn collect_wc_scrutinee(scrut: typed_ast.TypedExpr, arms: List typed_ast.TypedMatchBranch,
                        top_level: Set, ctors: Dict sprout_ir.CtorInfo, acc: Set) -> Set =
  match scrut with
  | typed_ast.TCall callee _ call_ty _ ->
      match callee with
      | typed_ast.TVar name _ _ ->
          # ADT (width-2) OR tuple (scalar 2-tuple) result matched immediately → f needs a worker.
          # Shadow-free superset of the router (tier2_worker_shape / tuple_worker_shape).
          if set_member(name, top_level)
             && (tier2_worker_shape(name, arms, ctors) || tuple_worker_shape(arms, call_ty))
          then set_insert(name, acc)
          else acc
      | _ -> acc
  | _ -> acc

fn collect_wc_branches(arms: List typed_ast.TypedMatchBranch, top_level: Set,
                       ctors: Dict sprout_ir.CtorInfo, acc: Set) -> Set =
  match arms with
  | Nil -> acc
  | Cons b rest ->
      match b with
      | typed_ast.TypedMatchBranch _ body ->
          collect_wc_branches(rest, top_level, ctors, collect_wc_expr(body, top_level, ctors, acc))

fn collect_wc_exprs(es: List typed_ast.TypedExpr, top_level: Set,
                    ctors: Dict sprout_ir.CtorInfo, acc: Set) -> Set =
  match es with
  | Nil -> acc
  | Cons e rest -> collect_wc_exprs(rest, top_level, ctors, collect_wc_expr(e, top_level, ctors, acc))

fn collect_wc_dosteps(steps: List typed_ast.TypedDoStep, top_level: Set,
                      ctors: Dict sprout_ir.CtorInfo, acc: Set) -> Set =
  match steps with
  | Nil -> acc
  | Cons step rest ->
      collect_wc_dosteps(rest, top_level, ctors,
        match step with
        # A `pat <- f(..)` do-bind on a Maybe/Result-returning direct call to a
        # top-level fn routes to @f_worker (Piece 3), so f needs a worker.
        | typed_ast.TDoBindStep _ e ->
            collect_wc_expr(e, top_level, ctors, collect_wc_do_bind_callee(e, top_level, acc))
        # An SRA-eligible `let name = e` (C2) makes e's tuple producers (river_rgb/biome_rgb-style)
        # into width-w workers even though they are never a match scrutinee. Shadow-free superset:
        # collection consults the SAME oracle translate_do uses, so a producer worker is emitted for
        # exactly the lets that fire (translation adds only a shadow gate → translation ⊆ collection).
        | typed_ast.TDoLetStep name e ->
            collect_wc_expr(e, top_level, ctors, collect_wc_sra_producers(name, e, rest, top_level, acc))
        | typed_ast.TDoExprStep e -> collect_wc_expr(e, top_level, ctors, acc))

# Add the SRA producer callees of an eligible `let name = e` to the worker set (shadow-free).
fn collect_wc_sra_producers(name: String, e: typed_ast.TypedExpr, rest: List typed_ast.TypedDoStep,
                            top_level: Set, acc: Set) -> Set =
  match sra_core_eligible(name, e, rest, top_level) with
  | Just info -> (match info with | (_w, producers, _b, _body) -> set_union(acc, set_from_list(producers)))
  | Nothing -> acc

# The raw top-level Sprout fn `f` a `x <- f(..)` (Maybe/Result) do-bind unboxes
# to @f_worker; shadow-free superset (Nothing for externs / non-direct calls).
fn do_bind_worker_callee(e: typed_ast.TypedExpr, top_level: Set) -> Maybe String =
  match e with
  | typed_ast.TCall callee _ ety _ ->
      match callee with
      | typed_ast.TVar name _ _ ->
          if set_member(name, top_level)
             && (match unboxed_maybe_extern_name(name) with | Just _ -> false | Nothing -> true)
             && (is_maybe_type(ety) || is_result_type(ety))
          then Just(name)
          else Nothing
      | _ -> Nothing
  | _ -> Nothing

fn collect_wc_do_bind_callee(e: typed_ast.TypedExpr, top_level: Set, acc: Set) -> Set =
  match do_bind_worker_callee(e, top_level) with
  | Just name -> set_insert(name, acc)
  | Nothing -> acc

fn collect_wc_fields(fields: List typed_ast.TypedRecordField, top_level: Set,
                     ctors: Dict sprout_ir.CtorInfo, acc: Set) -> Set =
  match fields with
  | Nil -> acc
  | Cons f rest ->
      match f with
      | typed_ast.TypedRecordField _ e ->
          collect_wc_fields(rest, top_level, ctors, collect_wc_expr(e, top_level, ctors, acc))

# ---------------------------------------------------------------------------
# Tail-unboxed translation of a worker body.

# A ctor name usable as a value here iff it is in `ctors` and NOT shadowed by a
# param or capture (which would make the TVar/TCall a local reference).
fn name_is_local(name: String, params: List String, captures: Dict String) -> Bool =
  param_known(name, params) || (match dict_get(name, captures) with | Just _ -> true | Nothing -> false)

fn nullary_ctor_tag_if(name: String, params: List String, captures: Dict String,
                       ctors: Dict sprout_ir.CtorInfo) -> Maybe Int =
  if name_is_local(name, params, captures) then Nothing
  else match dict_get(name, ctors) with
       | Just entry -> (match entry with | sprout_ir.CtorInfo tag arity _m _f _ -> if arity == 0 then Just(tag) else Nothing)
       | Nothing -> Nothing

fn unary_ctor_tag_if(name: String, params: List String, captures: Dict String,
                     ctors: Dict sprout_ir.CtorInfo) -> Maybe Int =
  if name_is_local(name, params, captures) then Nothing
  else match dict_get(name, ctors) with
       | Just entry -> (match entry with | sprout_ir.CtorInfo tag arity _m _f _ -> if arity == 1 then Just(tag) else Nothing)
       | Nothing -> Nothing

# Translate `body` so every tail position returns the { i64, i64 } worker struct.
# `worker_set` = fns that have an emitted worker (chain tail-calls to them);
# `self_name` = the fn being emitted (self-recursive tail-calls stay boxed via the
# catch-all to keep TCO, rather than chaining un-TCO'd into @self_worker).
fn translate_tail_unboxed(body: typed_ast.TypedExpr, params: List String,
                          ctors: Dict sprout_ir.CtorInfo, idx: Int,
                          cur_label: String, cur_ops: List sprout_ir.IROp,
                          captures: Dict String,
                          lifted_ref: Ref (List sprout_ir.IRFunction),
                          top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                          result_adt_ctors: List (Int, Int),
                          worker_set: Set, self_name: String,
                          lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                          name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, Int) !{IO} =
  match body with
  | typed_ast.TIf cond t e _ _ ->
      translate_tail_if(cond, t, e, params, ctors, idx, cur_label, cur_ops, captures,
                        lifted_ref, top_level, let_names, fn_arities, result_adt_ctors,
                        worker_set, self_name, lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | typed_ast.TMatch scrut arms _ _ ->
      # A tuple-worker tail that is itself a match (e.g. unwrapping a `wrap (Int,Int)` via
      # `match s with | W p -> p`) must NOT go through the ADT-oriented translate_tail_match, which
      # tag-dispatches the scrutinee — a wrap value has no tag. Detect the tuple result from the body
      # type and box-and-extract instead (translate_expr handles wrap identity correctly).
      match scalar_tuple_width(typed_ast.typed_expr_type(body)) with
      | Just _ -> translate_tail_tuple_repack(body, params, ctors, idx, cur_label, cur_ops, captures,
                                       lifted_ref, top_level, let_names, fn_arities,
                                       lambda_ctr_ref, lifted_idx_ref, name_prefix)
      | Nothing -> translate_tail_match(scrut, arms, body, params, ctors, idx, cur_label, cur_ops, captures,
                                lifted_ref, top_level, let_names, fn_arities, result_adt_ctors,
                                worker_set, self_name, lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | typed_ast.TTuple items _ _ ->
      # Tuple-CPR worker tail: a 2-tuple literal returns its fields unboxed as { i64, i64 } (only
      # reached for a tuple worker; an ADT worker's result is never a tuple). Non-literal tuple tails
      # fall to the catch-all, which repacks via IRGetTupleField (see translate_tail_catchall).
      translate_tail_tuple(items, params, ctors, idx, cur_label, cur_ops, captures,
                           lifted_ref, top_level, let_names, fn_arities,
                           lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | typed_ast.TVar name _ _ ->
      match nullary_ctor_tag_if(name, params, captures, ctors) with
      | Just tag ->
          Ok((Cons(sprout_ir.IRBlock(cur_label,
                     list_append(cur_ops, Cons(sprout_ir.IRRetUnboxed2(fresh_name(name_prefix, idx), int_to_string(tag), "0"), Nil))),
                   Nil), idx + 1))
      | Nothing ->
          translate_tail_catchall(body, params, ctors, idx, cur_label, cur_ops, captures,
                                  lifted_ref, top_level, let_names, fn_arities, result_adt_ctors,
                                  lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | typed_ast.TCall callee args _ _ ->
      match callee with
      | typed_ast.TVar name _ _ ->
          match unary_ctor_tag_if(name, params, captures, ctors) with
          | Just tag ->
              translate_tail_unary_ctor(tag, args, params, ctors, idx, cur_label, cur_ops, captures,
                                        lifted_ref, top_level, let_names, fn_arities,
                                        lambda_ctr_ref, lifted_idx_ref, name_prefix)
          | Nothing ->
              match unboxed_maybe_extern_name(name) with
              | Just ufn ->
                  if ! callee_name_shadowed (name, params, captures, let_names, ctors)
                  then translate_tail_chain(ufn, args, params, ctors, idx, cur_label, cur_ops, captures,
                                            lifted_ref, top_level, let_names, fn_arities,
                                            lambda_ctr_ref, lifted_idx_ref, name_prefix, 2)
                  else translate_tail_catchall(body, params, ctors, idx, cur_label, cur_ops, captures,
                                               lifted_ref, top_level, let_names, fn_arities, result_adt_ctors,
                                               lambda_ctr_ref, lifted_idx_ref, name_prefix)
              | Nothing ->
                  # Worker-chain: a tail-call to another fn that has a worker (not
                  # self — self stays boxed for TCO) chains to its @<name>_worker,
                  # so the whole call chain returns { tag, val } with no box.
                  if set_member(name, worker_set) && name != self_name
                     && ! callee_name_shadowed (name, params, captures, let_names, ctors)
                  then translate_tail_chain(name ++ "_worker", args, params, ctors, idx, cur_label, cur_ops, captures,
                                            lifted_ref, top_level, let_names, fn_arities,
                                            lambda_ctr_ref, lifted_idx_ref, name_prefix, chain_width(body))
                  else translate_tail_catchall(body, params, ctors, idx, cur_label, cur_ops, captures,
                                               lifted_ref, top_level, let_names, fn_arities, result_adt_ctors,
                                               lambda_ctr_ref, lifted_idx_ref, name_prefix)
      | _ ->
          translate_tail_catchall(body, params, ctors, idx, cur_label, cur_ops, captures,
                                  lifted_ref, top_level, let_names, fn_arities, result_adt_ctors,
                                  lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | _ ->
      translate_tail_catchall(body, params, ctors, idx, cur_label, cur_ops, captures,
                              lifted_ref, top_level, let_names, fn_arities, result_adt_ctors,
                              lambda_ctr_ref, lifted_idx_ref, name_prefix)

# tail single-arm `match scrut with | Ctor f0 f1 … -> body`: destructure the
# scrutinee (bind each field var) and translate the arm body tail-unboxed.  A
# single ConstructorPattern arm is exhaustive only for a one-ctor (record-like)
# type, so no tag test is needed.  Multi-arm / nested-field matches fall back to
# the boxed catch-all (still correct, just not fully unboxed).
fn translate_tail_match(scrut: typed_ast.TypedExpr, arms: List typed_ast.TypedMatchBranch,
                        whole: typed_ast.TypedExpr, params: List String,
                        ctors: Dict sprout_ir.CtorInfo, idx: Int,
                        cur_label: String, cur_ops: List sprout_ir.IROp, captures: Dict String,
                        lifted_ref: Ref (List sprout_ir.IRFunction),
                        top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                        result_adt_ctors: List (Int, Int),
                        worker_set: Set, self_name: String,
                        lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                        name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, Int) !{IO} =
  match arms with
  | [typed_ast.TypedMatchBranch(ast.ConstructorPattern _cname cargs _) arm_body] ->
      if all_var_or_wild(cargs)
      then
        match translate_expr(scrut, params, ctors, idx, cur_label, cur_ops, captures, lifted_ref,
                             top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix) with
        | Err msg -> Err(msg)
        | Ok sr ->
            match sr with
            | (sblocks, slbl, sops, scrut_ssa, idx1) ->
                match bind_ctor_fields(cargs, scrut_ssa, 0, idx1, sops, captures, name_prefix) with
                | (fops, idx2, caps2) ->
                    match translate_tail_unboxed(arm_body, params, ctors, idx2, slbl, fops, caps2,
                                                 lifted_ref, top_level, let_names, fn_arities, result_adt_ctors,
                                                 worker_set, self_name, lambda_ctr_ref, lifted_idx_ref, name_prefix) with
                    | Err msg -> Err(msg)
                    | Ok br ->
                        match br with
                        | (bblocks, idx3) -> Ok((list_append(sblocks, bblocks), idx3))
      else translate_tail_catchall(whole, params, ctors, idx, cur_label, cur_ops, captures,
                                   lifted_ref, top_level, let_names, fn_arities, result_adt_ctors,
                                   lambda_ctr_ref, lifted_idx_ref, name_prefix)
  | _ -> translate_tail_catchall(whole, params, ctors, idx, cur_label, cur_ops, captures,
                                 lifted_ref, top_level, let_names, fn_arities, result_adt_ctors,
                                 lambda_ctr_ref, lifted_idx_ref, name_prefix)

fn all_var_or_wild(pats: List ast.Pattern) -> Bool =
  match pats with
  | Nil -> true
  | Cons p rest ->
      (match p with | ast.VarPattern _ _ -> true | ast.WildcardPattern _ -> true | _ -> false)
      && all_var_or_wild(rest)

# Emit IRGetField for each ConstructorPattern field, binding VarPattern names into
# `captures` (WildcardPattern binds nothing).  Field i lives at box offset i.
fn bind_ctor_fields(pats: List ast.Pattern, box_ssa: String, field_i: Int, idx: Int,
                    ops: List sprout_ir.IROp, captures: Dict String, prefix: String) ->
    (List sprout_ir.IROp, Int, Dict String) =
  match pats with
  | Nil -> (ops, idx, captures)
  | Cons p rest ->
      match p with
      | ast.VarPattern v _ ->
          bind_ctor_fields(rest, box_ssa, field_i + 1, idx + 1,
            list_append(ops, Cons(sprout_ir.IRGetField(fresh_name(prefix, idx), box_ssa, field_i, sprout_ir.IRTUnknown), Nil)),
            dict_set(v, fresh_name(prefix, idx), captures), prefix)
      | _ -> bind_ctor_fields(rest, box_ssa, field_i + 1, idx, ops, captures, prefix)

# tail `Ctor arg`: evaluate the single payload, return { tag, payload }.
fn translate_tail_unary_ctor(tag: Int, args: List typed_ast.TypedExpr, params: List String,
                             ctors: Dict sprout_ir.CtorInfo, idx: Int,
                             cur_label: String, cur_ops: List sprout_ir.IROp,
                             captures: Dict String,
                             lifted_ref: Ref (List sprout_ir.IRFunction),
                             top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                             lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                             name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, Int) !{IO} =
  match args with
  | [arg] ->
      match translate_expr(arg, params, ctors, idx, cur_label, cur_ops, captures, lifted_ref,
                           top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix) with
      | Err msg -> Err(msg)
      | Ok r ->
          match r with
          | (blocks, lbl, ops, val_ssa, idx1) ->
              Ok((list_append(blocks,
                    Cons(sprout_ir.IRBlock(lbl,
                           list_append(ops, Cons(sprout_ir.IRRetUnboxed2(fresh_name(name_prefix, idx1), int_to_string(tag), val_ssa), Nil))),
                    Nil)), idx1 + 1))
  | _ -> Err("ast_to_ir: worker unary ctor with non-single arg (internal error)")

# tail 2-tuple literal `(e0, e1)`: evaluate both fields, return { e0, e1 } unboxed. Stage-1 fields
# are scalar, so the two slots need no rooting. Mirrors translate_tail_unary_ctor's block sealing.
fn translate_tail_tuple(items: List typed_ast.TypedExpr, params: List String,
                        ctors: Dict sprout_ir.CtorInfo, idx: Int,
                        cur_label: String, cur_ops: List sprout_ir.IROp,
                        captures: Dict String,
                        lifted_ref: Ref (List sprout_ir.IRFunction),
                        top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                        lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                        name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, Int) !{IO} =
  match translate_args_scalar(items, params, ctors, idx, cur_label, cur_ops, Nil, Nil, captures,
                              lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                              lifted_idx_ref, name_prefix) with
  | Err msg -> Err(msg)
  | Ok r ->
      match r with
      | (ablocks, albl, aops, anames, idx1) ->
          match anames with
          | [n0, n1] ->
              Ok((list_append(ablocks,
                    Cons(sprout_ir.IRBlock(albl,
                           list_append(aops, Cons(sprout_ir.IRRetUnboxed2(fresh_name(name_prefix, idx1), n0, n1), Nil))),
                    Nil)), idx1 + 1))
          | [n0, n1, n2] ->
              Ok((list_append(ablocks,
                    Cons(sprout_ir.IRBlock(albl,
                           list_append(aops, Cons(sprout_ir.IRRetUnboxed3(fresh_name(name_prefix, idx1), n0, n1, n2), Nil))),
                    Nil)), idx1 + 1))
          | _ -> Err("ast_to_ir: tuple worker tail with unsupported width (not 2 or 3) (internal error)")

# Repack a NON-literal tuple tail (a match/var/call returning a 2-tuple, e.g. unwrapping a
# `wrap (Int,Int)`): translate it normally to a boxed tuple (wrap-aware), then read its two fields
# into the { i64, i64 } worker struct. The tuple already exists here, so this adds no allocation;
# it just avoids handing the boxed handle back to the caller. Fields scalar in Stage 1 (no rooting).
fn translate_tail_tuple_repack(body: typed_ast.TypedExpr, params: List String,
                               ctors: Dict sprout_ir.CtorInfo, idx: Int,
                               cur_label: String, cur_ops: List sprout_ir.IROp,
                               captures: Dict String,
                               lifted_ref: Ref (List sprout_ir.IRFunction),
                               top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                               lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                               name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, Int) !{IO} =
  match translate_expr(body, params, ctors, idx, cur_label, cur_ops, captures, lifted_ref,
                       top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix) with
  | Err msg -> Err(msg)
  | Ok r ->
      match r with
      | (blocks, lbl, ops, box_ssa, idx1) ->
          # Width from the body's tuple type — the SAME oracle the worker's ret-type used, so the
          # repacked { i64,… } arity matches the worker signature. Width 3 reads a third field and
          # returns IRRetUnboxed3; width 2 (or the never-reached non-tuple default) uses IRRetUnboxed2.
          if tuple_repack_is_w3(body)
          then Ok((list_append(blocks,
                Cons(sprout_ir.IRBlock(lbl,
                       list_append(ops,
                         Cons(sprout_ir.IRGetTupleField(fresh_name(name_prefix, idx1), box_ssa, 0, sprout_ir.IRTScalar),
                         Cons(sprout_ir.IRGetTupleField(fresh_name(name_prefix, idx1 + 1), box_ssa, 1, sprout_ir.IRTScalar),
                         Cons(sprout_ir.IRGetTupleField(fresh_name(name_prefix, idx1 + 2), box_ssa, 2, sprout_ir.IRTScalar),
                         Cons(sprout_ir.IRRetUnboxed3(fresh_name(name_prefix, idx1 + 3),
                                fresh_name(name_prefix, idx1), fresh_name(name_prefix, idx1 + 1), fresh_name(name_prefix, idx1 + 2)), Nil)))))),
                Nil)), idx1 + 4))
          else Ok((list_append(blocks,
                Cons(sprout_ir.IRBlock(lbl,
                       list_append(ops,
                         Cons(sprout_ir.IRGetTupleField(fresh_name(name_prefix, idx1), box_ssa, 0, sprout_ir.IRTScalar),
                         Cons(sprout_ir.IRGetTupleField(fresh_name(name_prefix, idx1 + 1), box_ssa, 1, sprout_ir.IRTScalar),
                         Cons(sprout_ir.IRRetUnboxed2(fresh_name(name_prefix, idx1 + 2),
                                fresh_name(name_prefix, idx1), fresh_name(name_prefix, idx1 + 1)), Nil))))),
                Nil)), idx1 + 3))

# tail chained call to an unboxed-returning target (a Maybe-extern _unboxed, or another fn's worker).
# `width` is the returned struct's field count: 2 → { i64, i64 } (Maybe-extern, width-2 ADT, or a
# scalar 2-tuple worker); 3 → { i64, i64, i64 } (a scalar 3-tuple worker). It MUST equal the chaining
# fn's own declared worker_ret_ty, else the emitted `ret` mismatches the `define` (caught by opt-verify).
fn translate_tail_chain(target_fn: String, args: List typed_ast.TypedExpr, params: List String,
                        ctors: Dict sprout_ir.CtorInfo, idx: Int,
                        cur_label: String, cur_ops: List sprout_ir.IROp,
                        captures: Dict String,
                        lifted_ref: Ref (List sprout_ir.IRFunction),
                        top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                        lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                        name_prefix: String, width: Int) ->
    Result String (List sprout_ir.IRBlock, Int) !{IO} =
  match translate_args_scalar(args, params, ctors, idx, cur_label, cur_ops, Nil, Nil, captures,
                              lifted_ref, top_level, let_names, fn_arities, lambda_ctr_ref,
                              lifted_idx_ref, name_prefix) with
  | Err msg -> Err(msg)
  | Ok r ->
      match r with
      | (ablocks, albl, aops, anames, idx1) ->
          if width == 3
          then Ok((list_append(ablocks,
                    Cons(sprout_ir.IRBlock(albl,
                           list_append(aops,
                             Cons(sprout_ir.IRCallUnboxed3(fresh_name(name_prefix, idx1), fresh_name(name_prefix, idx1 + 1),
                                    fresh_name(name_prefix, idx1 + 2), sprout_ir.IRTUnknown, target_fn, anames),
                             Cons(sprout_ir.IRRetUnboxed3(fresh_name(name_prefix, idx1 + 3),
                                    fresh_name(name_prefix, idx1), fresh_name(name_prefix, idx1 + 1), fresh_name(name_prefix, idx1 + 2)), Nil)))),
                    Nil)), idx1 + 4))
          else match (fresh_name(name_prefix, idx1), fresh_name(name_prefix, idx1 + 1), fresh_name(name_prefix, idx1 + 2)) with
          | (tag_ssa, val_ssa, base_ssa) ->
              Ok((list_append(ablocks,
                    Cons(sprout_ir.IRBlock(albl,
                           list_append(aops,
                             Cons(sprout_ir.IRCallUnboxed2(tag_ssa, val_ssa, sprout_ir.IRTUnknown, target_fn, anames),
                             Cons(sprout_ir.IRRetUnboxed2(base_ssa, tag_ssa, val_ssa), Nil)))),
                    Nil)), idx1 + 3))

# tail `if`: both arms return, so no join/phi — each branch recurses tail-unboxed.
fn translate_tail_if(cond: typed_ast.TypedExpr, t: typed_ast.TypedExpr, e: typed_ast.TypedExpr,
                     params: List String, ctors: Dict sprout_ir.CtorInfo, idx: Int,
                     cur_label: String, cur_ops: List sprout_ir.IROp, captures: Dict String,
                     lifted_ref: Ref (List sprout_ir.IRFunction),
                     top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                     result_adt_ctors: List (Int, Int),
                     worker_set: Set, self_name: String,
                     lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                     name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, Int) !{IO} =
  match translate_expr(cond, params, ctors, idx, cur_label, cur_ops, captures, lifted_ref,
                       top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix) with
  | Err msg -> Err(msg)
  | Ok cr ->
      match cr with
      | (cblocks, ccur_lbl, ccur_ops, c_name, idx1) ->
          match translate_tail_if_branches(t, e, params, ctors, idx1 + 1, captures, lifted_ref,
                                           top_level, let_names, fn_arities, result_adt_ctors,
                                           worker_set, self_name, lambda_ctr_ref, lifted_idx_ref, name_prefix,
                                           fresh_then_label(idx1), fresh_else_label(idx1)) with
          | Err msg -> Err(msg)
          | Ok br ->
              match br with
              | (branch_blocks, idx2) ->
                  match fresh_name(name_prefix, idx1) with
                  | cond_i1 ->
                      Ok((list_append(cblocks,
                            Cons(sprout_ir.IRBlock(ccur_lbl,
                                   list_append(ccur_ops,
                                     Cons(sprout_ir.IRTruncI64ToI1(cond_i1, c_name),
                                     Cons(sprout_ir.IRCondBr(cond_i1, fresh_then_label(idx1), fresh_else_label(idx1)), Nil)))),
                            branch_blocks)), idx2))

fn translate_tail_if_branches(t: typed_ast.TypedExpr, e: typed_ast.TypedExpr, params: List String,
                              ctors: Dict sprout_ir.CtorInfo, idx: Int, captures: Dict String,
                              lifted_ref: Ref (List sprout_ir.IRFunction),
                              top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                              result_adt_ctors: List (Int, Int),
                              worker_set: Set, self_name: String,
                              lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                              name_prefix: String, then_lbl: String, else_lbl: String) ->
    Result String (List sprout_ir.IRBlock, Int) !{IO} =
  match translate_tail_unboxed(t, params, ctors, idx, then_lbl, Nil, captures, lifted_ref,
                               top_level, let_names, fn_arities, result_adt_ctors,
                               worker_set, self_name, lambda_ctr_ref, lifted_idx_ref, name_prefix) with
  | Err msg -> Err(msg)
  | Ok tr ->
      match tr with
      | (tblocks, idx1) ->
          match translate_tail_unboxed(e, params, ctors, idx1, else_lbl, Nil, captures, lifted_ref,
                                       top_level, let_names, fn_arities, result_adt_ctors,
                                       worker_set, self_name, lambda_ctr_ref, lifted_idx_ref, name_prefix) with
          | Err msg -> Err(msg)
          | Ok er ->
              match er with
              | (eblocks, idx2) -> Ok((list_append(tblocks, eblocks), idx2))

# Fallback: translate `body` to a boxed value, then unpack it into { tag, val }.
# Reads the payload field only inside a payload-ctor arm, so a nullary ctor's
# missing field is never touched; the tag-less arm returns val=0.
fn translate_tail_catchall(body: typed_ast.TypedExpr, params: List String,
                           ctors: Dict sprout_ir.CtorInfo, idx: Int,
                           cur_label: String, cur_ops: List sprout_ir.IROp,
                           captures: Dict String,
                           lifted_ref: Ref (List sprout_ir.IRFunction),
                           top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                           result_adt_ctors: List (Int, Int),
                           lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                           name_prefix: String) ->
    Result String (List sprout_ir.IRBlock, Int) !{IO} =
  # An empty ctor list means the result type's head was not found in adt_index,
  # so the repack below would emit only IRGetTag + IRAbortMatch — an always-
  # aborting worker the router still calls.  Fail loudly at compile time instead;
  # routing guarantees this is a width-2 ADT that SHOULD resolve (wrap/Bool are
  # excluded upstream), so an empty list is an internal invariant break.
  match result_adt_ctors with
  | Nil ->
      # No ADT ctors. This is a TUPLE worker only if the body's type actually IS a scalar tuple —
      # then the all-fields repack (Tuple-CPR, docs/scalar-replacement-v0.md) is the right
      # convention: box a non-literal tuple tail and read its two fields.
      #
      # Anything else reaching here is a convention gap, NOT a tuple. Assuming "empty ctor list ⇒
      # tuple" is what silently gave a type-variable result the all-fields repack while its call
      # site read slot 0 as a tag — silent wrong answers plus an out-of-bounds load
      # (docs/bug-adt-through-generic-param-2026-08-12.md). The routers now decline such callees,
      # so reaching this arm means a router and this emitter disagree: fail loudly.
      match scalar_tuple_width(typed_ast.typed_expr_type(body)) with
      | Just _ ->
          translate_tail_tuple_repack(body, params, ctors, idx, cur_label, cur_ops, captures, lifted_ref,
                                      top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix)
      | Nothing ->
          Err("ast_to_ir: CPR worker for a result that is neither a known ADT nor a scalar tuple; "
              ++ "the call-site router and the worker emitter disagree on the unboxed convention")
  | _ ->
  match translate_expr(body, params, ctors, idx, cur_label, cur_ops, captures, lifted_ref,
                       top_level, let_names, fn_arities, lambda_ctr_ref, lifted_idx_ref, name_prefix) with
  | Err msg -> Err(msg)
  | Ok r ->
      match r with
      | (blocks, lbl, ops, box_ssa, idx1) ->
          match fresh_name(name_prefix, idx1) with
          | tag_ssa ->
              emit_repack_arms(box_ssa, tag_ssa, result_adt_ctors, idx1 + 1, lbl,
                               list_append(ops, Cons(sprout_ir.IRGetTag(tag_ssa, box_ssa), Nil)),
                               blocks, name_prefix)

# Per-ctor tag-test chain that repacks a boxed width-2 value into { tag, val }.
fn emit_repack_arms(box_ssa: String, tag_ssa: String, entries: List (Int, Int), idx: Int,
                    cur_lbl: String, cur_ops: List sprout_ir.IROp,
                    acc_blocks: List sprout_ir.IRBlock, prefix: String) ->
    Result String (List sprout_ir.IRBlock, Int) =
  match entries with
  | Nil ->
      # Unreachable for a well-typed ADT value (all ctors tested above).
      Ok((list_append(acc_blocks,
            Cons(sprout_ir.IRBlock(cur_lbl, list_append(cur_ops, Cons(sprout_ir.IRAbortMatch, Nil))), Nil)),
          idx))
  | Cons entry rest ->
      match entry with
      | (ctor_tag, arity) ->
          emit_repack_one(box_ssa, tag_ssa, ctor_tag, arity, rest, idx, cur_lbl, cur_ops, acc_blocks, prefix)

fn emit_repack_one(box_ssa: String, tag_ssa: String, ctor_tag: Int, arity: Int,
                   rest: List (Int, Int), idx: Int, cur_lbl: String, cur_ops: List sprout_ir.IROp,
                   acc_blocks: List sprout_ir.IRBlock, prefix: String) ->
    Result String (List sprout_ir.IRBlock, Int) =
  emit_repack_arms(box_ssa, tag_ssa, rest, next_idx, next_lbl, Nil,
                   list_append(acc_blocks, [test_block, hit_block]), prefix)
  where k_ssa = fresh_name(prefix, idx)
        cmp_ssa = fresh_name(prefix, idx + 1)
        hit_lbl = "wrepack_hit_" ++ int_to_string(idx)
        next_lbl = "wrepack_next_" ++ int_to_string(idx)
        test_block = sprout_ir.IRBlock(cur_lbl,
          list_append(cur_ops,
            Cons(sprout_ir.IRConst(k_ssa, ctor_tag),
            Cons(sprout_ir.IRICmp(cmp_ssa, "eq", tag_ssa, k_ssa),
            Cons(sprout_ir.IRCondBr(cmp_ssa, hit_lbl, next_lbl), Nil)))))
        field_ssa = fresh_name(prefix, idx + 2)
        base_ssa = fresh_name(prefix, idx + 3)
        hit_block = if arity == 1
          then sprout_ir.IRBlock(hit_lbl,
                 Cons(sprout_ir.IRGetField(field_ssa, box_ssa, 0, sprout_ir.IRTUnknown),
                 Cons(sprout_ir.IRRetUnboxed2(base_ssa, tag_ssa, field_ssa), Nil)))
          else sprout_ir.IRBlock(hit_lbl, Cons(sprout_ir.IRRetUnboxed2(base_ssa, tag_ssa, "0"), Nil))
        next_idx = idx + 4

# ---------------------------------------------------------------------------
# Worker function synthesis + wiring.

# Build the `@<name>_worker` IRFunction and return it with its next-free idx and
# any lambdas lifted from the body.  `body` is the fn's real body (or, for an
# extern, a synthesized self-call that the catch-all repacks).
fn emit_worker_fn(worker_name: String, self_name: String, params: List ast.Param,
                  body: typed_ast.TypedExpr, result_adt_ctors: List (Int, Int),
                  ctors: Dict sprout_ir.CtorInfo, top_level: Set, let_names: Set,
                  fn_arities: Dict FnInfo, worker_set: Set,
                  lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int)) ->
    Result String (sprout_ir.IRFunction, Int, List sprout_ir.IRFunction) !{IO} =
  do
    lifted_ref <- ref_new(Nil)
    match translate_tail_unboxed(body, param_names(params), ctors, 0, "entry", Nil, dict_empty(),
                                 lifted_ref, top_level, let_names, fn_arities, result_adt_ctors,
                                 worker_set, self_name, lambda_ctr_ref, lifted_idx_ref, "%t") with
    | Err msg -> Err(msg)
    | Ok res ->
        match res with
        | (blocks, next_idx) ->
            do
              lifted <- ref_read(lifted_ref)
              Ok((sprout_ir.IRFunction(worker_name,
                    ast_params_to_irtype_pairs(params, param_names(params)),
                    worker_ret_ty(body), blocks),
                  next_idx, list_reverse(lifted)))

# Look up the (params, body, result-ADT-ctors) for a matched worker callee.
# Skips entry `main`, lets, and ctors (they are never routed to a worker).
fn worker_source_for(name: String, decls: List typed_ast.TypedDecl,
                     adt_index: Dict (List (Int, Int))) ->
    Maybe(List ast.Param, typed_ast.TypedExpr, List (Int, Int)) =
  match decls with
  | Nil -> Nothing
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl fname fparams _ _ _ fbody ->
          if fname == name && ! is_entry_fn_name (name)
          then Just((fparams, fbody, adt_ctors_of_type(typed_ast.typed_expr_type(fbody), adt_index)))
          else worker_source_for(name, rest, adt_index)
      | typed_ast.TExternFnDecl ename eparams eret _ ->
          if ename == name
          then Just((eparams, synth_extern_body(name, eparams), adt_ctors_of_typeexpr(eret, adt_index)))
          else worker_source_for(name, rest, adt_index)
      | _ -> worker_source_for(name, rest, adt_index)

# A synthetic `name(p0, p1, …)` used as an extern shim's body: the catch-all
# translates it to a boxed `call @name(…)` and repacks the result.
fn synth_extern_body(name: String, params: List ast.Param) -> typed_ast.TypedExpr =
  typed_ast.TCall(
    typed_ast.TVar(name, types.TConst(types.type_id("Unit")), source.SourcePos(0, 0, 0)),
    synth_param_vars(params),
    types.TConst(types.type_id("Unit")), source.SourcePos(0, 0, 0))

fn synth_param_vars(params: List ast.Param) -> List typed_ast.TypedExpr =
  match params with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.Param pname _ _ ->
          Cons(typed_ast.TVar(pname, types.TConst(types.type_id("Unit")), source.SourcePos(0, 0, 0)),
               synth_param_vars(rest))

# Emit the worker (+ its lifted lambdas) for one matched callee `name`, or
# Nothing when `name` is not a top-level fn/extern (a let/ctor over-collected by
# the shadow-free scan).  Exported: the active streaming pipeline (ir_pipeline)
# calls this per-name so each worker is rooted+lowered like any other fn.
export fn emit_worker_for(name: String, decls: List typed_ast.TypedDecl,
                          ctors: Dict sprout_ir.CtorInfo, top_level: Set, let_names: Set,
                          fn_arities: Dict FnInfo, adt_index: Dict (List (Int, Int)), worker_set: Set,
                          lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int)) ->
    Result String (Maybe(sprout_ir.IRFunction, Int, List sprout_ir.IRFunction)) !{IO} =
  # Guard: `@<name>_worker` shares the LLVM symbol namespace with user fns.  If a
  # top-level fn is literally named `<name>_worker`, both emit `define @<name>_worker`
  # -> duplicate-symbol link error.  Fail loudly here instead (no `_worker` suffix
  # reservation, since the compiler's own internals use `_unboxed`/`_worker`).
  if set_member(name ++ "_worker", top_level)
  then Err("ast_to_ir: CPR worker name '" ++ name ++ "_worker' collides with an existing top-level definition")
  else
  match worker_source_for(name, decls, adt_index) with
  | Nothing -> Ok(Nothing)
  | Just src ->
      match src with
      | (params, body, radt) ->
          match emit_worker_fn(name ++ "_worker", name, params, body, radt, ctors, top_level,
                               let_names, fn_arities, worker_set, lambda_ctr_ref, lifted_idx_ref) with
          | Err msg -> Err(msg)
          | Ok wres -> Ok(Just(wres))

# Batch worker emission for translate_program (the non-streaming path used by the
# IR-shape tests): append every worker to `fns0`, merge next-idx into `idx_map0`.
fn tier2_augment_fns(decls: List typed_ast.TypedDecl, ctors: Dict sprout_ir.CtorInfo,
                     top_level: Set, let_names: Set, fn_arities: Dict FnInfo,
                     lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                     fns0: List sprout_ir.IRFunction, idx_map0: Dict Int) ->
    Result String (List sprout_ir.IRFunction, Dict Int) !{IO} =
  match collect_worker_callees(decls, top_level, ctors, fn_arities) with
  | wset ->
      emit_all_workers(set_to_list(wset), wset,
                       decls, ctors, top_level, let_names, fn_arities,
                       build_adt_ctor_index(decls, ctors),
                       lambda_ctr_ref, lifted_idx_ref, fns0, idx_map0)

fn emit_all_workers(names: List String, worker_set: Set, decls: List typed_ast.TypedDecl,
                    ctors: Dict sprout_ir.CtorInfo, top_level: Set, let_names: Set,
                    fn_arities: Dict FnInfo, adt_index: Dict (List (Int, Int)),
                    lambda_ctr_ref: Ref Int, lifted_idx_ref: Ref (Dict Int),
                    acc_fns: List sprout_ir.IRFunction, acc_idx: Dict Int) ->
    Result String (List sprout_ir.IRFunction, Dict Int) !{IO} =
  match names with
  | Nil -> Ok((acc_fns, acc_idx))
  | Cons name rest ->
      match emit_worker_for(name, decls, ctors, top_level, let_names, fn_arities, adt_index, worker_set,
                            lambda_ctr_ref, lifted_idx_ref) with
      | Err msg -> Err(msg)
      | Ok Nothing ->
          emit_all_workers(rest, worker_set, decls, ctors, top_level, let_names, fn_arities, adt_index,
                           lambda_ctr_ref, lifted_idx_ref, acc_fns, acc_idx)
      | Ok justw ->
          match justw with
          | Just wres ->
              match wres with
              | (wfn, wnext, wlifted) ->
                  emit_all_workers(rest, worker_set, decls, ctors, top_level, let_names, fn_arities, adt_index,
                                   lambda_ctr_ref, lifted_idx_ref,
                                   Cons(wfn, list_append(wlifted, acc_fns)),
                                   dict_set(name ++ "_worker", wnext, acc_idx))
          | Nothing ->
              emit_all_workers(rest, worker_set, decls, ctors, top_level, let_names, fn_arities, adt_index,
                               lambda_ctr_ref, lifted_idx_ref, acc_fns, acc_idx)
