module stdlib.compiler.ast_to_ir
import stdlib.compiler.ast as ast
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types
import stdlib.compiler.sprout_ir as sprout_ir

# ---------------------------------------------------------------------------
# Free-variable computation helpers (mirrored from codegen.sprout — not
# exported there, so duplicated here; follow-up cleanup: move to a shared
# typed_ast_utils module).
#
# compute_free_vars(expr, bound, top_level) -> Set String
#   A name is FREE if it appears as TVar, is not in `bound` (lambda params /
#   enclosing function params at this nesting level), and is not in
#   `top_level` (top-level fn names + ctor names, addressable by @ in IR).
#   For TLambda sub-expressions the lambda's own params are added to `bound`
#   before recursing into the body.
# O(n * log(n)) where n = number of TVar nodes.

# O(n * log(n)).
fn set_from_list(xs: List String) -> Set =
  list_fold(\ (s, x) -> set_insert(x, s), set_empty(), xs)

# O(n * log(n)).
fn compute_free_vars(expr: typed_ast.TypedExpr, bound: Set, top_level: Set) -> Set =
  match expr with
  | typed_ast.TVar name _ _ ->
      if set_member(name, bound) || set_member(name, top_level)
      then set_empty()
      else set_insert(name, set_empty())
  | typed_ast.TInt _ _ _ -> set_empty()
  | typed_ast.TBool _ _ _ -> set_empty()
  | typed_ast.TString _ _ _ -> set_empty()
  | typed_ast.TChar _ _ _ -> set_empty()
  | typed_ast.TUnit _ _ -> set_empty()
  | typed_ast.TTuple items _ _ ->
      compute_free_vars_list(items, bound, top_level)
  | typed_ast.TIf cond thn els _ _ ->
      set_union(compute_free_vars(cond, bound, top_level),
        set_union(compute_free_vars(thn, bound, top_level),
                  compute_free_vars(els, bound, top_level)))
  | typed_ast.TBinary _ l r _ _ ->
      set_union(compute_free_vars(l, bound, top_level),
                compute_free_vars(r, bound, top_level))
  | typed_ast.TUnary _ operand _ _ ->
      compute_free_vars(operand, bound, top_level)
  | typed_ast.TCall callee args _ _ ->
      set_union(compute_free_vars(callee, bound, top_level),
                compute_free_vars_list(args, bound, top_level))
  | typed_ast.TLambda lparams body _ _ ->
      compute_free_vars(body,
        set_union(bound, set_from_list(fv_param_names(lparams))),
        top_level)
  | typed_ast.TRange start end_ _ _ ->
      set_union(compute_free_vars(start, bound, top_level),
                compute_free_vars(end_, bound, top_level))
  | typed_ast.TDo _ _ _ -> set_empty()
  | typed_ast.TDict _ _ _ -> set_empty()
  | typed_ast.TRecord _ _ _ _ -> set_empty()
  | typed_ast.TMatch scrut _ _ _ ->
      compute_free_vars(scrut, bound, top_level)
  | typed_ast.TGetField obj _ _ _ ->
      compute_free_vars(obj, bound, top_level)

# O(n * k * log(k)) where n = list length, k = expr size.
fn compute_free_vars_list(exprs: List typed_ast.TypedExpr, bound: Set, top_level: Set) -> Set =
  match exprs with
  | Nil -> set_empty()
  | Cons e rest ->
      set_union(compute_free_vars(e, bound, top_level),
                compute_free_vars_list(rest, bound, top_level))

# Extract param names for free-var computation (private to this section).
# O(n).
fn fv_param_names(params: List ast.Param) -> List String =
  match params with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.Param n _ -> Cons(n, fv_param_names(rest))

# Build the top-level name Set from decl list + ctor dict.
# Includes user fn names, extern fn names, and ctor names.
# O(n * log(n)).
fn build_top_level_set(decls: List typed_ast.TypedDecl, ctors: Dict (Int, Int, Int)) -> Set =
  set_union(build_top_level_fn_set(decls),
            set_from_list(vec_to_list(dict_keys(ctors))))

# O(n).
fn build_top_level_fn_set(decls: List typed_ast.TypedDecl) -> Set =
  match decls with
  | Nil -> set_empty()
  | Cons d rest ->
      match d with
      | typed_ast.TFnDecl name _ _ _ _ _ ->
          set_insert(name, build_top_level_fn_set(rest))
      | typed_ast.TExternFnDecl name _ _ _ ->
          set_insert(name, build_top_level_fn_set(rest))
      | _ -> build_top_level_fn_set(rest)

# Filter a list of free-var names to those that are in `params` or `captures`.
# Names not in either are top-level and addressable by @ — skip them.
# O(n).
fn filter_capturable(frees: List String, params: List String,
                     captures: Dict String) -> List String =
  match frees with
  | Nil -> Nil
  | Cons v rest ->
      if param_known(v, params) || dict_has(v, captures)
      then Cons(v, filter_capturable(rest, params, captures))
      else filter_capturable(rest, params, captures)

# dict_has: true if key present in dict. O(log n).
fn dict_has(k: String, d: Dict String) -> Bool =
  match dict_get(k, d) with
  | Just _ -> true
  | Nothing -> false

# Look up a free var's current SSA name:
# - If in captures dict (was a capture in an outer lambda), use that SSA name.
# - If in params (a function parameter), use "%" ++ v.
# Returns Nothing if not found (should not happen after filter_capturable).
# O(log n).
fn lookup_free_var_ssa(v: String, params: List String,
                       captures: Dict String) -> Maybe String =
  match dict_get(v, captures) with
  | Just ssa -> Just(ssa)
  | Nothing ->
      if param_known(v, params)
      then Just("%" ++ v)
      else Nothing

# Build the list of SSA names for captured free vars (in order).
# O(n).
fn build_captures_list_ir(frees: List String, params: List String,
                          captures: Dict String) -> List String =
  match frees with
  | Nil -> Nil
  | Cons v rest ->
      match lookup_free_var_ssa(v, params, captures) with
      | Just ssa -> Cons(ssa, build_captures_list_ir(rest, params, captures))
      | Nothing -> build_captures_list_ir(rest, params, captures)

# Build the captures dict for a lifted lambda body.
# For each free var at index i (0-based), the lifted body reads it from
# env slot (i+1) as SSA name "%t<base+i>".
# O(n).
fn build_lifted_captures(frees: List String, base_idx: Int) -> Dict String =
  build_lifted_captures_go(frees, base_idx, 0, dict_empty())

fn build_lifted_captures_go(frees: List String, base_idx: Int,
                             i: Int, acc: Dict String) -> Dict String =
  match frees with
  | Nil -> acc
  | Cons v rest ->
      build_lifted_captures_go(rest, base_idx, i + 1,
        dict_set(v, "%t" ++ int_to_string(base_idx + i), acc))

# Build the IRLoadEnvSlot ops for the lifted lambda entry block.
# Each free var at index i gets: IRLoadEnvSlot("%t<base+i>", "%env", i+1).
# (Slot 0 is the code pointer; captures start at slot 1.)
# O(n).
fn build_load_env_ops(frees: List String, base_idx: Int) -> List sprout_ir.IROp =
  build_load_env_ops_go(frees, base_idx, 0)

fn build_load_env_ops_go(frees: List String, base_idx: Int, i: Int) -> List sprout_ir.IROp =
  match frees with
  | Nil -> Nil
  | Cons _ rest ->
      Cons(sprout_ir.IRLoadEnvSlot("%t" ++ int_to_string(base_idx + i), "%env", i + 1),
           build_load_env_ops_go(rest, base_idx, i + 1))

# True iff a types.Type is a function type (TFunc). O(1).
fn is_fn_type(t: types.Type) -> Bool =
  match t with
  | types.TFunc _ _ _ -> true
  | _ -> false

# ---------------------------------------------------------------------------
# Constructor table — name → (tag, actual_arity, max_arity_of_owning_ADT).
#
# Built once at program-translation entry by mirroring
# `build_ctor_sigs_from_decls` in `codegen.sprout`: tags are assigned
# sequentially across all `TPassThrough (TypeDecl …)` declarations in
# program order, starting from 0.  Matching codegen's numbering exactly is
# load-bearing: it lets the legacy and IR codegen paths be cross-checked.
#
# `actual_arity` is the number of fields of this specific constructor.
# It is used to validate ctor application arity (Bug B fix) and to guard
# bare TVar references to non-zero-arity ctors (Bug A fix).
#
# `max_arity_of_owning_ADT` is the largest field-count among the ADT's
# constructors.  `cpr_width_for_type_expr` in codegen.sprout classifies an
# ADT as CPR-eligible when this is 1 or 2 (yielding unboxed widths 2 and 3
# respectively).  Storing it inline makes `ctor_is_cpr_eligible` a single
# Dict lookup without re-walking type decls.
#
# PR 2.3 covers BOXED ADTs only.  CPR-eligible ctors are rejected at
# translate time with a clear Err (see translate_expr).

# ---------------------------------------------------------------------------
# AST → Sprout-IR translator.
# ---------------------------------------------------------------------------
#
# Milestone 1, PR 1.5 (see docs/gc-rooting-model-c-plan-2026-06-02.md).
#
# Supports the scalar subset of Sprout used for the IR-codegen bring-up:
#   - fn foo() -> Int = <intlit>            → IRConst + IRRet
#   - fn id(x: Int) -> Int = x              → IRRet "%x"   (parameter reference)
#   - fn add1(x: Int) -> Int = x + 1        → IRConst, IRIAdd, IRRet
#   - fn sub1, mul2 — likewise for Sub / Mul
#   - fn is_zero(x: Int) -> Bool = x == 0   → IRConst, IRICmp, IRRet  (i1)
#     (and the rest of the comparison family: !=, <, <=, >, >=)
#   - fn abs(x: Int) -> Int = if x < 0 then 0 - x else x
#       → IRICmp, IRCondBr, then-block, else-block, IRPhi, IRRet
#   - nested if-then-else, with each branch contributing its own blocks.
#   - direct calls: fn f(x: Int) -> Int = g(x + 1)  →  IRCall site after
#     arg eval; method / closure / typeclass dispatch are out of scope at
#     this milestone and produce a clear Err.
#   - self-recursive scalar calls: fn fact(n) = if n == 0 then 1 else n * fact(n - 1).
#     Recursion needs no special handling — the callee name `fact` is just
#     the TVar inside the TCall.
#
# The user-declared `main` function is special-cased here.  Its LLVM
# calling convention (i32 @main(i32, ptr)) differs from Sprout fns, and
# ir_lowering emits a synthetic shim for it that ignores the user body.
# That synthetic shim is silent: if the user wrote a non-trivial main
# body (e.g. one that calls print), the shim would still emit a no-op
# binary and the user would be confused.  To prevent that, translate_decl
# REJECTS any main whose body is not literally the unit literal `()`.
# A trivially-Unit main is skipped (Ok Nothing); any other main body
# returns Err with a clear message.
#
# Any other AST construct returns Err with a clear message — we never
# silently produce wrong IR.
#
# ---------------------------------------------------------------------------
# translate_expr contract (PR 1.4)
# ---------------------------------------------------------------------------
#
# Multi-block-aware expression translator.  The signature is:
#
#   translate_expr(expr, params, ctors, idx, cur_label, cur_ops) ->
#     Result String (List IRBlock, String, List IROp, String, Int)
#                    completed-blocks, new-cur-label, new-cur-ops,
#                    result-name, next-idx
#
# Inputs:
#   cur_label  — the label of the block currently being assembled (e.g.
#                "entry" at the function start, or a fresh join-label after
#                a previous if).
#   cur_ops    — the ops accumulated so far for cur_label (in forward
#                order).  Pure expressions append to it; control-flow
#                constructs seal it into a completed block and start a new
#                "current" block.
#
# Outputs:
#   completed-blocks — any blocks introduced by this sub-expression that
#                are NOT the current one.  These are FULLY SEALED — each
#                ends with IRBr or IRCondBr.  Order is the order they
#                should appear in the function (then before else before
#                join, for the if-case).
#   new-cur-label, new-cur-ops — the block label and forward-ordered ops
#                that the caller continues appending to.  For a pure
#                expression this is just (cur_label, cur_ops ++ new_ops).
#                For an if-expression this is the freshly-started join
#                block, whose first op is the merging IRPhi.
#   result-name — the value-name (with '%' prefix) holding the expression's
#                result.  For an if this is the phi's result-name.
#   next-idx    — the updated fresh-name counter.
#
# Invariant: the function-level driver (translate_body) is responsible for
# sealing the final "current" block with IRRet and collecting the produced
# (List IRBlock).  Sub-expressions never emit IRRet.

# ---------------------------------------------------------------------------
# field_kinds helpers — duplicated from codegen.sprout (not exported there).
# Keep aligned with codegen.sprout: ctor_field_kind / ctor_field_kinds_string.
# Encoding: 'i'=Int  'b'=Bool  's'=String/Char  'p'=ADT/closure/tuple  '_'=type-var

fn fk_char_is_uppercase(ch: Char) -> Bool =
  str_find("ABCDEFGHIJKLMNOPQRSTUVWXYZ", char_to_string(ch)) >= 0

fn fk_type_name_leaf_is(name: String, leaf: String) -> Bool =
  name == leaf || fk_string_ends_with(name, "." ++ leaf)

fn fk_string_ends_with(raw: String, suffix: String) -> Bool =
  str_len(raw) >= str_len(suffix) &&
  str_slice(raw, str_len(raw) - str_len(suffix), str_len(raw)) == suffix

fn fk_strip_module_prefix(name: String) -> String =
  if dot_pos < 0
  then name
  else fk_strip_module_prefix(str_slice(name, dot_pos + 1, str_len(name)))
  where dot_pos = str_find(name, ".")

fn ctor_field_kind(te: ast.TypeExpr) -> String =
  match te with
  | ast.TypeName name ->
      if fk_type_name_leaf_is(name, "Int") then "i"
      else if fk_type_name_leaf_is(name, "Bool") then "b"
      else if fk_type_name_leaf_is(name, "String") then "s"
      else if fk_type_name_leaf_is(name, "Char") then "s"
      else
        match str_char_at(fk_strip_module_prefix(name), 0) with
        | Nothing -> "_"
        | Just ch -> if fk_char_is_uppercase(ch) then "p" else "_"
  | ast.TypeArrow _ _ _ -> "p"
  | ast.TypeApply _ _ -> "p"
  | ast.TypeEffect inner _ -> ctor_field_kind(inner)
  | ast.TupleType _ -> "p"

fn ctor_field_kinds_string(exprs: List ast.TypeExpr) -> String =
  match exprs with
  | Nil -> ""
  | Cons e rest -> ctor_field_kind(e) ++ ctor_field_kinds_string(rest)

# ---------------------------------------------------------------------------
# Build the ctor-table by walking program declarations once.  Tag assignment
# mirrors `register_ctors` in codegen.sprout exactly: sequential across all
# TPassThrough (TypeDecl _) declarations in program order, starting at 0.
#
# Returns both the lookup dict (3-tuple, no field_kinds needed for dispatch)
# and the flat CtorReg list (with field_kinds) used by ir_lowering for
# @sprout_register_ctor emission.  Every ctor is registered — both boxed and
# CPR-eligible — so the runtime's find_ctor(tag) never returns NULL.
fn build_ctor_table(decls: List typed_ast.TypedDecl) -> (Dict (Int, Int, Int), List sprout_ir.CtorReg) =
  build_ctor_table_acc(decls, 0, dict_empty(), Nil)

fn build_ctor_table_acc(decls: List typed_ast.TypedDecl, next_tag: Int,
                        acc: Dict (Int, Int, Int),
                        regs: List sprout_ir.CtorReg) -> (Dict (Int, Int, Int), List sprout_ir.CtorReg) =
  match decls with
  | Nil -> (acc, list_reverse(regs))
  | Cons decl rest ->
      match decl with
      | typed_ast.TPassThrough (ast.TypeDecl _ _ ctors _) ->
          match register_ctor_entries(ctors, next_tag, max_arity_of(ctors, 0), acc, regs) with
          | (acc1, new_tag, regs1) -> build_ctor_table_acc(rest, new_tag, acc1, regs1)
      | _ -> build_ctor_table_acc(rest, next_tag, acc, regs)

fn max_arity_of(ctors: List ast.TypeConstructor, m: Int) -> Int =
  match ctors with
  | Nil -> m
  | Cons tc rest ->
      match tc with
      | ast.TypeConstructor _ args ->
          match list_length(args) with
          | n -> max_arity_of(rest, if n > m then n else m)

fn register_ctor_entries(ctors: List ast.TypeConstructor, next_tag: Int,
                         max_ar: Int, acc: Dict (Int, Int, Int),
                         regs: List sprout_ir.CtorReg) -> (Dict (Int, Int, Int), Int, List sprout_ir.CtorReg) =
  match ctors with
  | Nil -> (acc, next_tag, regs)
  | Cons tc rest ->
      match tc with
      | ast.TypeConstructor ctor_name ctor_args ->
          register_ctor_entries(rest, next_tag + 1, max_ar,
                                dict_set(ctor_name, (next_tag, list_length(ctor_args), max_ar), acc),
                                Cons(sprout_ir.CtorReg(ctor_name, next_tag, list_length(ctor_args),
                                                       ctor_field_kinds_string(ctor_args)),
                                     regs))

# True when an ADT with this max-arity is CPR-eligible (unboxed widths 2 or 3).
# Mirrors `unboxed_width_for_arity` in codegen.sprout.
fn ctor_is_cpr_eligible(max_arity: Int) -> Bool =
  max_arity == 1 || max_arity == 2

# Fresh-name counter threaded through the translator.
# %t0, %t1, … name intermediate results introduced by the IR.
# The same counter is reused for block labels via fresh_then/else/join_label
# below — different namespaces, so uniqueness is preserved.
fn fresh_name(idx: Int) -> String =
  "%t" ++ int_to_string(idx)

fn fresh_then_label(idx: Int) -> String =
  "then_" ++ int_to_string(idx)

fn fresh_else_label(idx: Int) -> String =
  "else_" ++ int_to_string(idx)

fn fresh_join_label(idx: Int) -> String =
  "join_" ++ int_to_string(idx)

# Map a TBinary op String to its LLVM icmp predicate, if it is a comparison.
# Returns Nothing for non-comparison ops (the caller handles those separately).
fn cmp_predicate(op: String) -> Maybe String =
  if op == "==" then Just("eq")
  else if op == "!=" then Just("ne")
  else if op == "<" then Just("slt")
  else if op == "<=" then Just("sle")
  else if op == ">" then Just("sgt")
  else if op == ">=" then Just("sge")
  else Nothing

# True iff t is the monomorphic Int type.
fn is_int_type(t: types.Type) -> Bool =
  match t with
  | types.TConst name -> name == "Int"
  | _ -> false

# True iff t is the monomorphic Bool type.
fn is_bool_type(t: types.Type) -> Bool =
  match t with
  | types.TConst name -> name == "Bool"
  | _ -> false

fn is_string_type(t: types.Type) -> Bool =
  match t with
  | types.TConst name -> name == "String"
  | _ -> false

# True iff t is the monomorphic Unit type.
fn is_unit_type(t: types.Type) -> Bool =
  match t with
  | types.TConst name -> name == "Unit"
  | _ -> false

# Scalar argument types accepted by IRCall in PR 1.5 (Int), PR 2.1 (String),
# and PR 2.4 (function types — closures are i64 at the IR level).
# Bool/Unit/etc remain rejected.
fn is_supported_arg_type(t: types.Type) -> Bool =
  is_int_type(t) || is_string_type(t) || is_fn_type(t)

# Ctor field argument types accepted by translate_args_ctor.
#
# IRMakeCtor lowering (ir_lowering.sprout `lower_op` / `lower_call_args`)
# hardcodes `i64 %argN` for every argument slot.  This is correct for Int,
# String, and heap-typed ADT values (all of which produce i64 in LLVM IR).
#
# Bool is REJECTED: Bool expressions produce `i1` in LLVM IR (see
# codegen.sprout `pack_to_i64`, line ~960, which emits `zext i1 ... to i64`
# to widen Bool before passing it to sprout_makeN).  The IR path has no
# equivalent zext step; emitting `i64 %bool_val` when `%bool_val` is `i1`
# causes an LLVM verifier ABI mismatch.  The root fix is to add an
# IRZextI1ToI64 op (deferred); for now, reject Bool ctor fields early.
#
# Unit is REJECTED: Unit produces no LLVM value; there is no valid `i64` to
# pass.
#
# All other types (including TVar, TApp, TypeArrow, ADT names) are accepted;
# they all produce i64 in the IR path.
fn is_supported_ctor_arg_type(t: types.Type) -> Bool =
  ! is_bool_type (t) && ! is_unit_type (t)

# Map an inferred return type to the LLVM type used for `define`/`ret`.
# PR 1.3 only emits i64 (Int) and i1 (Bool); anything else falls back to i64
# but the translator will already have rejected unsupported bodies before
# we get here.
fn llvm_ret_type(t: types.Type) -> String =
  if is_bool_type(t) then "i1" else "i64"

# Translate a TypedExpr in a multi-block-aware fashion.  See the contract
# block at the top of this file for the full signature description.
#
# Returns: (completed-blocks, new-cur-label, new-cur-ops, result-name, next-idx)
#
# PR 2.4 threading additions (all read-only or write-only side-channels):
#   captures   — Dict String — maps a free var's source name to the SSA name
#                produced by IRLoadEnvSlot in the enclosing lifted body.
#                Empty dict_empty() for top-level user fns.
#   lifted_ref — Ref (List IRFunction) — accumulator; each TLambda translation
#                prepends its lifted IRFunction here (shared across the whole
#                user fn; nested lambdas thus stay flat).
#   top_level  — Set String — top-level fn names + ctor names; used by
#                compute_free_vars to exclude globally addressable names.
fn translate_expr(expr: typed_ast.TypedExpr, params: List String,
                  ctors: Dict (Int, Int, Int), idx: Int,
                  cur_label: String, cur_ops: List sprout_ir.IROp,
                  captures: Dict String,
                  lifted_ref: Ref (List sprout_ir.IRFunction),
                  top_level: Set,
                  lambda_ctr_ref: Ref Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match expr with
  | typed_ast.TInt n _ _ ->
      Ok((Nil, cur_label,
           list_append(cur_ops, Cons(sprout_ir.IRConst(fresh_name(idx), n), Nil)),
           fresh_name(idx), idx + 1))
  | typed_ast.TVar name _ _ ->
      # A TVar may reference: (a) a function parameter, (b) a 0-arity
      # constructor (e.g. Nil, Nothing) used without parens, (c) a captured
      # free variable in a lifted lambda body (present in `captures`).
      # Check captures FIRST so that a captured free var does not accidentally
      # resolve as a param that shadows it.
      match dict_get(name, captures) with
      | Just ssa -> Ok((Nil, cur_label, cur_ops, ssa, idx))
      | Nothing ->
          if param_known(name, params)
          then Ok((Nil, cur_label, cur_ops, "%" ++ name, idx))
          else
            match dict_get(name, ctors) with
            | Just entry ->
                match entry with
                | (tag, actual_ar, max_ar) ->
                    if ctor_is_cpr_eligible(max_ar)
                    then Err("ast_to_ir: CPR ctor lowering deferred to follow-up PR")
                    else if actual_ar == 0
                    then translate_zero_arity_ctor(name, tag, idx, cur_label, cur_ops)
                    else Err("ast_to_ir: bare reference to non-zero-arity ctor '" ++ name ++ "' (eta/partial application) deferred to follow-up PR")
            | Nothing -> Err("ast_to_ir: unbound variable '" ++ name ++ "'")
  | typed_ast.TBinary op left right _ _ ->
      translate_binary(op, left, right, params, ctors, idx, cur_label, cur_ops,
                       captures, lifted_ref, top_level, lambda_ctr_ref)
  | typed_ast.TIf cond t e ty _ ->
      translate_if(cond, t, e, ty, params, ctors, idx, cur_label, cur_ops,
                   captures, lifted_ref, top_level, lambda_ctr_ref)
  | typed_ast.TCall callee args ty _ ->
      translate_call(callee, args, ty, params, ctors, idx, cur_label, cur_ops,
                     captures, lifted_ref, top_level, lambda_ctr_ref)
  | typed_ast.TBool _ _ _ -> Err("ast_to_ir: Bool literal not yet supported")
  | typed_ast.TString s _ _ ->
      # Two fresh names: the raw ptr from the GEP, and the i64 result.
      Ok((Nil, cur_label,
           list_append(cur_ops, Cons(sprout_ir.IRStrConst(fresh_name(idx + 1), fresh_name(idx), s), Nil)),
           fresh_name(idx + 1), idx + 2))
  | typed_ast.TChar _ _ _ -> Err("ast_to_ir: Char literal not yet supported")
  | typed_ast.TUnit _ _ -> Err("ast_to_ir: Unit literal not yet supported")
  | typed_ast.TTuple _ _ _ -> Err("ast_to_ir: Tuple not yet supported")
  | typed_ast.TMatch _ _ _ _ -> Err("ast_to_ir: match not yet supported")
  | typed_ast.TDict _ _ _ -> Err("ast_to_ir: TDict not yet supported")
  | typed_ast.TLambda lparams body lam_ty _ ->
      translate_lambda(lparams, body, lam_ty, params, ctors, idx, cur_label, cur_ops,
                       captures, lifted_ref, top_level, lambda_ctr_ref)
  | typed_ast.TUnary _ _ _ _ -> Err("ast_to_ir: unary op not yet supported")
  | typed_ast.TRange _ _ _ _ -> Err("ast_to_ir: range not yet supported")
  | typed_ast.TDo _ _ _ -> Err("ast_to_ir: do-block not yet supported")
  | typed_ast.TRecord _ _ _ _ -> Err("ast_to_ir: record not yet supported")
  | typed_ast.TGetField _ _ _ _ -> Err("ast_to_ir: field access not yet supported")

# Emit a single IRMakeCtor op for a 0-arity boxed constructor reference (Nil,
# custom enum constants, etc.).  Used by translate_expr's TVar case when the
# variable name resolves in the ctor-table.
# Pure leaf — no IO needed.
fn translate_zero_arity_ctor(name: String, tag: Int, idx: Int,
                             cur_label: String, cur_ops: List sprout_ir.IROp) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  Ok((Nil, cur_label,
       list_append(cur_ops, Cons(sprout_ir.IRMakeCtor(fresh_name(idx), name, tag, Nil), Nil)),
       fresh_name(idx), idx + 1))

# Translate a TLambda node: lift the body into a synthetic function, emit
# IRMkClosure at the use site, and register the lifted function via lifted_ref.
#
# Algorithm:
#   1. Compute free variables of the lambda body (excluding lambda's own params
#      AND the outer fn's params — both are in `lam_bound`).  Exclude top_level.
#   2. Filter free names to those accessible in the outer scope (in `params` or
#      `captures`). These become the closure's captured slots.
#   3. Use the current length of lifted_ref's list as the lambda index.  This
#      is the per-user-fn accumulator, so indices restart at 0 per user fn.
#      (Prompt says "shared counter" across decls; we use list_length of the
#      shared lifted_ref instead of a separate Ref<Int> to avoid extra threading
#      through translate_expr.  This is a deliberate deviation reported in the
#      summary — the result is still correct unique naming within the program
#      because translate_user_fn creates a fresh lifted_ref per call.)
#   4. For the lifted body: pre-emit IRLoadEnvSlot ops (slot i+1 for capture i;
#      slot 0 is the code pointer). Build a captures dict from free-var name to
#      "%t<i>" where i matches the slot index.
#   5. Translate the body in the lifted fn's own idx-space starting at N
#      (where N = number of captures), using lifted params and captures dict.
#   6. Build the IRFunction and register it by prepending to lifted_ref.
#   7. Emit IRMkClosure at the call site.
#
# O(n * log(n)) where n = lambda body size.
fn translate_lambda(lparams: List ast.Param, body: typed_ast.TypedExpr,
                    lam_ty: types.Type,
                    params: List String, ctors: Dict (Int, Int, Int),
                    idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                    captures: Dict String,
                    lifted_ref: Ref (List sprout_ir.IRFunction),
                    top_level: Set,
                    lambda_ctr_ref: Ref Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  do
    let lam_param_names = fv_param_names(lparams)
    # bound = ONLY the lambda's own params. Outer fn's params (and outer
    # captures) are *free* from the lambda's perspective — they're the
    # capture candidates. filter_capturable below restricts to ones that are
    # actually visible at the use site (in `params` or `captures`).
    let lam_bound = set_from_list(lam_param_names)
    let all_frees_list = set_to_list(compute_free_vars(body, lam_bound, top_level))
    let capturable = filter_capturable(all_frees_list, params, captures)
    # Allocate this lambda's unique index BEFORE translating the body, so that
    # any nested TLambda encountered during body translation will receive the
    # next (higher) index and cannot collide with this one.  lambda_ctr_ref is
    # shared across all user fns (lives at translate_program scope), guaranteeing
    # uniqueness across decls as well.
    lam_idx <- ref_read(lambda_ctr_ref)
    ref_write(lambda_ctr_ref, lam_idx + 1)
    let lam_fn_name = "ir_lambda_" ++ int_to_string(lam_idx)
    # SSA names for the captured values at the call site (outer scope).
    let cap_ssas = build_captures_list_ir(capturable, params, captures)
    # n_caps = number of captured free vars.
    let n_caps = list_length(capturable)
    # IRLoadEnvSlot ops seeding the lifted entry block (slots 1..n_caps).
    let load_ops = build_load_env_ops(capturable, 0)
    # captures dict for the lifted body: free-var name → "%t<i>" for slot i.
    let lifted_captures = build_lifted_captures(capturable, 0)
    # Lifted body translation starts at idx n_caps (slots 0..n_caps-1 consumed).
    match translate_expr(body, lam_param_names, ctors, n_caps,
                         "entry", load_ops, lifted_captures, lifted_ref, top_level,
                         lambda_ctr_ref) with
    | Err msg -> Err(msg)
    | Ok br ->
        match br with
        | (body_blocks, body_cur_lbl, body_cur_ops, body_result, _) ->
            do
              let ret_block = sprout_ir.IRBlock(body_cur_lbl,
                                list_append(body_cur_ops,
                                  Cons(sprout_ir.IRRet(body_result), Nil)))
              let lifted_blocks = list_append(body_blocks, Cons(ret_block, Nil))
              # Lifted fn receives "env" as first param, then lambda's own params.
              let lifted_fn = sprout_ir.IRFunction(lam_fn_name,
                                Cons("env", lam_param_names), "i64", lifted_blocks)
              new_lifted <- ref_read(lifted_ref)
              ref_write(lifted_ref, Cons(lifted_fn, new_lifted))
              let closure_result = fresh_name(idx)
              Ok((Nil, cur_label,
                   list_append(cur_ops,
                     Cons(sprout_ir.IRMkClosure(closure_result, lam_fn_name, cap_ssas), Nil)),
                   closure_result, idx + 1))

# Translate `left <op> right` into IR ops.  Op must be one of
# +, -, *, ==, !=, <, <=, >, >=.  Both operands must be Int-typed
# (Char comparison is intentionally rejected at this milestone).
fn translate_binary(op: String, left: typed_ast.TypedExpr, right: typed_ast.TypedExpr,
                    params: List String, ctors: Dict (Int, Int, Int), idx: Int,
                    cur_label: String, cur_ops: List sprout_ir.IROp,
                    captures: Dict String,
                    lifted_ref: Ref (List sprout_ir.IRFunction),
                    top_level: Set,
                    lambda_ctr_ref: Ref Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  if op == "++" && is_string_type(typed_ast.typed_expr_type(left))
                && is_string_type(typed_ast.typed_expr_type(right))
  then
    match translate_expr(left, params, ctors, idx, cur_label, cur_ops,
                         captures, lifted_ref, top_level, lambda_ctr_ref) with
    | Err msg -> Err(msg)
    | Ok lr ->
        match lr with
        | (lblocks, lcur_lbl, lcur_ops, l_name, idx1) ->
            match translate_expr(right, params, ctors, idx1, lcur_lbl, lcur_ops,
                                 captures, lifted_ref, top_level, lambda_ctr_ref) with
            | Err msg -> Err(msg)
            | Ok rr ->
                match rr with
                | (rblocks, rcur_lbl, rcur_ops, r_name, idx2) ->
                    Ok((list_append(lblocks, rblocks), rcur_lbl,
                         list_append(rcur_ops,
                           Cons(sprout_ir.IRStrConcat(fresh_name(idx2), l_name, r_name), Nil)),
                         fresh_name(idx2), idx2 + 1))
  else if ! (is_int_type(typed_ast.typed_expr_type(left)) && is_int_type(typed_ast.typed_expr_type(right)))
  then Err("ast_to_ir: binary op '" ++ op ++ "' requires Int operands")
  else
    match translate_expr(left, params, ctors, idx, cur_label, cur_ops,
                         captures, lifted_ref, top_level, lambda_ctr_ref) with
    | Err msg -> Err(msg)
    | Ok lr ->
        match lr with
        | (lblocks, lcur_lbl, lcur_ops, l_name, idx1) ->
            match translate_expr(right, params, ctors, idx1, lcur_lbl, lcur_ops,
                                 captures, lifted_ref, top_level, lambda_ctr_ref) with
            | Err msg -> Err(msg)
            | Ok rr ->
                match rr with
                | (rblocks, rcur_lbl, rcur_ops, r_name, idx2) ->
                    finish_binary(op, lblocks, rblocks, rcur_lbl, rcur_ops,
                                  l_name, r_name, idx2)

fn finish_binary(op: String,
                 lblocks: List sprout_ir.IRBlock, rblocks: List sprout_ir.IRBlock,
                 cur_lbl: String, cur_ops: List sprout_ir.IROp,
                 l_name: String, r_name: String,
                 idx: Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  match arith_op(op, result, l_name, r_name) with
  | Just iop ->
      Ok((list_append(lblocks, rblocks), cur_lbl,
           list_append(cur_ops, Cons(iop, Nil)),
           result, idx + 1))
  | Nothing ->
      match cmp_predicate(op) with
      | Just pred ->
          Ok((list_append(lblocks, rblocks), cur_lbl,
               list_append(cur_ops,
                 Cons(sprout_ir.IRICmp(result, pred, l_name, r_name), Nil)),
               result, idx + 1))
      | Nothing -> Err("ast_to_ir: binary op '" ++ op ++ "' not yet supported")
  where result = fresh_name(idx)

# Map a TBinary op String to the matching arithmetic IR constructor.
# Returns Nothing for non-arith ops; the caller falls back to cmp_predicate.
fn arith_op(op: String, result: String, lhs: String, rhs: String) -> Maybe sprout_ir.IROp =
  if op == "+" then Just(sprout_ir.IRIAdd(result, lhs, rhs))
  else if op == "-" then Just(sprout_ir.IRISub(result, lhs, rhs))
  else if op == "*" then Just(sprout_ir.IRIMul(result, lhs, rhs))
  else Nothing

# Translate an if-then-else.
#
# Block layout produced (per if-expression):
#   <cur_label>:                      ← sealed with IRCondBr
#     ... cur_ops ...
#     %cN = icmp/...   <cond>
#     br i1 %cN, label %then_K, label %else_K
#   then_K:                           ← may itself contain nested if-blocks
#     ... then-branch ops ...
#     br label %join_K
#   else_K:
#     ... else-branch ops ...
#     br label %join_K
#   join_K:                           ← becomes the new cur_label
#     %rN = phi <ty> [<v_then>, %<then-final-lbl>], [<v_else>, %<else-final-lbl>]
#
# Crucially the incoming labels of the phi are NOT necessarily "then_K" /
# "else_K" — if a branch itself contained nested ifs, the value was
# produced in the inner join block.  We capture each branch's final
# cur_label after sub-translation and use it for the phi.
#
# K is allocated by consuming one fresh-name slot for each of then/else/join.
fn translate_if(cond: typed_ast.TypedExpr, t: typed_ast.TypedExpr, e: typed_ast.TypedExpr,
                if_ty: types.Type, params: List String, ctors: Dict (Int, Int, Int),
                idx: Int,
                cur_label: String, cur_ops: List sprout_ir.IROp,
                captures: Dict String,
                lifted_ref: Ref (List sprout_ir.IRFunction),
                top_level: Set,
                lambda_ctr_ref: Ref Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match translate_expr(cond, params, ctors, idx, cur_label, cur_ops,
                       captures, lifted_ref, top_level, lambda_ctr_ref) with
  | Err msg -> Err(msg)
  | Ok cr ->
      match cr with
      | (cblocks, ccur_lbl, ccur_ops, c_name, idx1) ->
          translate_if_after_cond(t, e, if_ty, params, ctors,
                                  cblocks, ccur_lbl, ccur_ops, c_name, idx1,
                                  captures, lifted_ref, top_level, lambda_ctr_ref)

fn translate_if_after_cond(t: typed_ast.TypedExpr, e: typed_ast.TypedExpr,
                           if_ty: types.Type, params: List String,
                           ctors: Dict (Int, Int, Int),
                           cblocks: List sprout_ir.IRBlock,
                           ccur_lbl: String, ccur_ops: List sprout_ir.IROp,
                           c_name: String, idx: Int,
                           captures: Dict String,
                           lifted_ref: Ref (List sprout_ir.IRFunction),
                           top_level: Set,
                           lambda_ctr_ref: Ref Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  # Allocate one fresh id `idx` shared by then_<idx> / else_<idx> / join_<idx>
  # — they live in disjoint label namespaces so uniqueness is preserved.
  # Then consume idx+1 for the phi result-name.  Sub-translation continues
  # from idx+2.
  match translate_expr(t, params, ctors, idx + 2, then_lbl, Nil,
                       captures, lifted_ref, top_level, lambda_ctr_ref) with
  | Err msg -> Err(msg)
  | Ok tr ->
      match tr with
      | (tblocks, tcur_lbl, tcur_ops, t_name, idx2) ->
          match translate_expr(e, params, ctors, idx2, else_lbl, Nil,
                               captures, lifted_ref, top_level, lambda_ctr_ref) with
          | Err msg -> Err(msg)
          | Ok er ->
              match er with
              | (eblocks, ecur_lbl, ecur_ops, e_name, idx3) ->
                  finish_if(if_ty, cblocks, ccur_lbl, ccur_ops, c_name,
                            then_lbl, tblocks, tcur_lbl, tcur_ops, t_name,
                            else_lbl, eblocks, ecur_lbl, ecur_ops, e_name,
                            join_lbl, phi_name, idx3)
  where then_lbl = fresh_then_label(idx)
        else_lbl = fresh_else_label(idx)
        join_lbl = fresh_join_label(idx)
        phi_name = fresh_name(idx + 1)

fn finish_if(if_ty: types.Type,
             cblocks: List sprout_ir.IRBlock,
             ccur_lbl: String, ccur_ops: List sprout_ir.IROp, c_name: String,
             then_lbl: String, tblocks: List sprout_ir.IRBlock,
             tcur_lbl: String, tcur_ops: List sprout_ir.IROp, t_name: String,
             else_lbl: String, eblocks: List sprout_ir.IRBlock,
             ecur_lbl: String, ecur_ops: List sprout_ir.IROp, e_name: String,
             join_lbl: String, phi_name: String, idx: Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  Ok((all_blocks, join_lbl, Cons(phi_op, Nil), phi_name, idx))
  where phi_ty = llvm_ret_type(if_ty)
        phi_op = sprout_ir.IRPhi(phi_name, phi_ty,
                                 Cons((t_name, tcur_lbl),
                                 Cons((e_name, ecur_lbl), Nil)))
        # Seal the entry/condition block with IRCondBr.
        cond_block = sprout_ir.IRBlock(ccur_lbl,
                       list_append(ccur_ops,
                         Cons(sprout_ir.IRCondBr(c_name, then_lbl, else_lbl), Nil)))
        # Seal the then-branch's final block with IRBr → join.
        then_final = sprout_ir.IRBlock(tcur_lbl,
                       list_append(tcur_ops, Cons(sprout_ir.IRBr(join_lbl), Nil)))
        # Seal the else-branch's final block with IRBr → join.
        else_final = sprout_ir.IRBlock(ecur_lbl,
                       list_append(ecur_ops, Cons(sprout_ir.IRBr(join_lbl), Nil)))
        # Order: cond-blocks (already-completed inner blocks of cond) then
        # this-if's cond block, then-blocks (inner) then this then_final,
        # else-blocks (inner) then this else_final.  Join is the new cur,
        # not in the completed list — translate_body / outer if will seal it.
        all_blocks = list_append(cblocks,
                       Cons(cond_block,
                       list_append(tblocks,
                         Cons(then_final,
                         list_append(eblocks, Cons(else_final, Nil))))))

# Translate a TCall node.
#
# Dispatch on the callee shape:
#   - TVar fname _ _ where fname is NOT a parameter → direct named call to
#     @fname.  Recursion just works: a self-call's TVar carries the
#     defining function's own name.
#   - TVar fname _ _ where fname IS a parameter → first-class function
#     value, out of scope for PR 1.5 (would need indirect call lowering).
#   - TGetField _ _ _ _ → method/record-field call, out of scope.
#   - TLambda _ _ _ _ → IIFE / closure application, out of scope.
#   - TDict _ _ _ → typeclass-dictionary dispatch, out of scope.
#   - anything else → "indirect call not yet supported".
#
# Each argument is translated left-to-right via translate_args_scalar (for
# direct fn calls) or translate_args_ctor (for ctor calls); the resulting
# (lbl, ops, idx) is the call site's current block.  PR 1.5 only handles
# scalar (Int) arguments for IRCall; the IRCall lowering hard-codes `i64`
# for every arg position.  The call's LLVM ret-type comes from `call_ty`
# (the TCall node's own inferred type), mapped via llvm_ret_type — typically
# "i64" for Int callees, "i1" for Bool.
fn translate_call(callee: typed_ast.TypedExpr, args: List typed_ast.TypedExpr,
                  call_ty: types.Type, params: List String,
                  ctors: Dict (Int, Int, Int), idx: Int,
                  cur_label: String, cur_ops: List sprout_ir.IROp,
                  captures: Dict String,
                  lifted_ref: Ref (List sprout_ir.IRFunction),
                  top_level: Set,
                  lambda_ctr_ref: Ref Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match callee with
  | typed_ast.TVar fname fty _ ->
      # Check captures first: a free var of function type stored in the env
      # must be called via IRApplyClosure.
      match dict_get(fname, captures) with
      | Just cap_ssa ->
          # captured free var — must be a closure; emit IRApplyClosure.
          translate_closure_call(cap_ssa, args, params, ctors, idx, cur_label, cur_ops,
                                 captures, lifted_ref, top_level, lambda_ctr_ref)
      | Nothing ->
          if param_known(fname, params)
          then
            # Calling a parameter: the typechecker already verified the callee
            # is function-typed (otherwise the call wouldn't typecheck).  We
            # don't re-check via is_fn_type because the TVar's `fty` may carry
            # a polymorphic / unresolved type that doesn't match TFunc — the
            # typechecker is the source of truth here.
            translate_closure_call("%" ++ fname, args, params, ctors, idx,
                                   cur_label, cur_ops, captures, lifted_ref, top_level,
                                   lambda_ctr_ref)
          else
            # Constructor application takes precedence over named-call dispatch
            # because a ctor name is never simultaneously a function.  CPR-
            # eligible ADTs are rejected at this milestone (boxed only).
            match dict_get(fname, ctors) with
            | Just entry ->
                match entry with
                | (tag, actual_ar, max_ar) ->
                    if ctor_is_cpr_eligible(max_ar)
                    then Err("ast_to_ir: CPR ctor lowering deferred to follow-up PR")
                    else translate_boxed_ctor_call(fname, tag, actual_ar, args, params,
                                                   ctors, idx, cur_label, cur_ops,
                                                   captures, lifted_ref, top_level,
                                                   lambda_ctr_ref)
            | Nothing ->
                translate_direct_call(fname, args, call_ty, params, ctors, idx,
                                      cur_label, cur_ops, captures, lifted_ref, top_level,
                                      lambda_ctr_ref)
  | typed_ast.TLambda lparams lbody lam_ty _ ->
      # Directly-applied lambda (IIFE): (\x -> body)(arg).
      # Translate the lambda to get a closure value at the call site, then apply.
      match translate_lambda(lparams, lbody, lam_ty, params, ctors, idx, cur_label, cur_ops,
                             captures, lifted_ref, top_level, lambda_ctr_ref) with
      | Err msg -> Err(msg)
      | Ok lr ->
          match lr with
          | (lam_blocks, lam_cur_lbl, lam_cur_ops, closure_ssa, idx1) ->
              match translate_closure_call(closure_ssa, args, params, ctors, idx1,
                                           lam_cur_lbl, lam_cur_ops,
                                           captures, lifted_ref, top_level, lambda_ctr_ref) with
              | Err msg -> Err(msg)
              | Ok cr ->
                  match cr with
                  | (call_blocks, call_lbl, call_ops, call_result, idx2) ->
                      Ok((list_append(lam_blocks, call_blocks), call_lbl, call_ops,
                           call_result, idx2))
  | typed_ast.TGetField _ _ _ _ -> Err("ast_to_ir: method/field call not yet supported")
  | typed_ast.TDict _ _ _ -> Err("ast_to_ir: typeclass dispatch call not yet supported")
  | _ -> Err("ast_to_ir: indirect call not yet supported")

# Evaluate args left-to-right, then emit IRApplyClosure(result, callee_ssa, arg_names).
# Used for: (a) fn-typed params, (b) captured free vars, (c) IIFE closures.
# TODO(PR 2.5): reject partial application (fewer args than TFunc arity).
# Currently accepts any arg count; callee type is not checked here.
# O(n) in number of args.
fn translate_closure_call(callee_ssa: String, args: List typed_ast.TypedExpr,
                          params: List String, ctors: Dict (Int, Int, Int),
                          idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                          captures: Dict String,
                          lifted_ref: Ref (List sprout_ir.IRFunction),
                          top_level: Set,
                          lambda_ctr_ref: Ref Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match translate_args_scalar(args, params, ctors, idx, cur_label, cur_ops, Nil, Nil,
                              captures, lifted_ref, top_level, lambda_ctr_ref) with
  | Err msg -> Err(msg)
  | Ok r ->
      match r with
      | (arg_blocks, arg_cur_lbl, arg_cur_ops, arg_names, idx1) ->
          Ok((arg_blocks, arg_cur_lbl,
               list_append(arg_cur_ops,
                 Cons(sprout_ir.IRApplyClosure(fresh_name(idx1), callee_ssa, arg_names), Nil)),
               fresh_name(idx1), idx1 + 1))

# Boxed n-arity constructor application.  Mirrors the legacy codegen's
# `emit_ctor_call_expr` for the `n_args == n_arity` branch: evaluate args
# left-to-right, then emit a single IRMakeCtor.  Partial application is NOT
# supported at this milestone (legacy emits closures for `n_args < n_arity`,
# IR codegen does not yet have closure infrastructure).
#
# `actual_ar` is the per-ctor field count from the ctor-table.  We validate
# that the call-site provides exactly that many arguments before emitting IR.
fn translate_boxed_ctor_call(name: String, tag: Int, actual_ar: Int,
                             args: List typed_ast.TypedExpr,
                             params: List String, ctors: Dict (Int, Int, Int),
                             idx: Int, cur_label: String,
                             cur_ops: List sprout_ir.IROp,
                             captures: Dict String,
                             lifted_ref: Ref (List sprout_ir.IRFunction),
                             top_level: Set,
                             lambda_ctr_ref: Ref Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  # NOTE: cap of 9 mirrors @sprout_make0..@sprout_make9 declared in
  # ir_lowering.sprout's ir_header(). If you lift this, also extend
  # ir_header's declares.
  if actual_ar >= 10
  then Err("ast_to_ir: ctor arity exceeds 9 (got " ++ int_to_string(actual_ar) ++ "); add a runtime sprout_make_wide entry point and lift this check")
  else if list_length(args) != actual_ar
  then Err("ast_to_ir: ctor application has wrong arity (got " ++ int_to_string(list_length(args)) ++ ", expected " ++ int_to_string(actual_ar) ++ ")")
  else
    match translate_args_ctor(args, params, ctors, idx, cur_label, cur_ops, Nil, Nil,
                              captures, lifted_ref, top_level, lambda_ctr_ref) with
    | Err msg -> Err(msg)
    | Ok r ->
        match r with
        | (arg_blocks, arg_cur_lbl, arg_cur_ops, arg_names, idx1) ->
            Ok((arg_blocks, arg_cur_lbl,
                 list_append(arg_cur_ops,
                   Cons(sprout_ir.IRMakeCtor(fresh_name(idx1), name, tag, arg_names), Nil)),
                 fresh_name(idx1), idx1 + 1))

type StringBuiltin (..) =
  | SBStrConcat
  | SBStrSlice
  | SBIntToString

fn recognize_string_builtin(fname: String) -> Maybe StringBuiltin =
  if fname == "str_concat" then Just(SBStrConcat)
  else if fname == "str_slice" then Just(SBStrSlice)
  else if fname == "int_to_string" then Just(SBIntToString)
  else Nothing

fn translate_direct_call(fname: String, args: List typed_ast.TypedExpr,
                         call_ty: types.Type, params: List String,
                         ctors: Dict (Int, Int, Int), idx: Int,
                         cur_label: String, cur_ops: List sprout_ir.IROp,
                         captures: Dict String,
                         lifted_ref: Ref (List sprout_ir.IRFunction),
                         top_level: Set,
                         lambda_ctr_ref: Ref Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match recognize_string_builtin(fname) with
  | Just kind -> translate_string_builtin(kind, fname, args, params, ctors, idx,
                                          cur_label, cur_ops, captures, lifted_ref, top_level,
                                          lambda_ctr_ref)
  | Nothing ->
      if is_string_type(call_ty)
      then Err("ast_to_ir: user fn returning String not yet supported in IR codegen")
      else
        match translate_args_scalar(args, params, ctors, idx, cur_label, cur_ops, Nil, Nil,
                                    captures, lifted_ref, top_level, lambda_ctr_ref) with
        | Err msg -> Err(msg)
        | Ok r ->
            match r with
            | (arg_blocks, arg_cur_lbl, arg_cur_ops, arg_names, idx1) ->
                finish_direct_call(fname, call_ty, arg_blocks, arg_cur_lbl,
                                   arg_cur_ops, arg_names, idx1)

fn translate_string_builtin(kind: StringBuiltin, fname: String,
                            args: List typed_ast.TypedExpr,
                            params: List String, ctors: Dict (Int, Int, Int),
                            idx: Int,
                            cur_label: String, cur_ops: List sprout_ir.IROp,
                            captures: Dict String,
                            lifted_ref: Ref (List sprout_ir.IRFunction),
                            top_level: Set,
                            lambda_ctr_ref: Ref Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) !{IO} =
  match translate_args_scalar(args, params, ctors, idx, cur_label, cur_ops, Nil, Nil,
                              captures, lifted_ref, top_level, lambda_ctr_ref) with
  | Err msg -> Err(msg)
  | Ok r ->
      match r with
      | (arg_blocks, arg_cur_lbl, arg_cur_ops, arg_names, idx1) ->
          finish_string_builtin(kind, fname, arg_blocks, arg_cur_lbl,
                                arg_cur_ops, arg_names, idx1)

fn finish_string_builtin(kind: StringBuiltin, fname: String,
                         arg_blocks: List sprout_ir.IRBlock, cur_lbl: String,
                         cur_ops: List sprout_ir.IROp, arg_names: List String,
                         idx: Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  match kind with
  | SBStrConcat ->
      match arg_names with
      | Cons a (Cons b Nil) ->
          Ok((arg_blocks, cur_lbl,
               list_append(cur_ops, Cons(sprout_ir.IRStrConcat(result, a, b), Nil)),
               result, idx + 1))
      | _ -> Err("ast_to_ir: str_concat expects 2 arguments")
  | SBStrSlice ->
      match arg_names with
      | Cons s (Cons st (Cons ln Nil)) ->
          Ok((arg_blocks, cur_lbl,
               list_append(cur_ops, Cons(sprout_ir.IRStrSlice(result, s, st, ln), Nil)),
               result, idx + 1))
      | _ -> Err("ast_to_ir: str_slice expects 3 arguments")
  | SBIntToString ->
      match arg_names with
      | Cons n Nil ->
          Ok((arg_blocks, cur_lbl,
               list_append(cur_ops, Cons(sprout_ir.IRStrFromInt(result, n), Nil)),
               result, idx + 1))
      | _ -> Err("ast_to_ir: int_to_string expects 1 argument")
  where result = fresh_name(idx)

fn finish_direct_call(fname: String, call_ty: types.Type,
                      arg_blocks: List sprout_ir.IRBlock, arg_cur_lbl: String,
                      arg_cur_ops: List sprout_ir.IROp, arg_names: List String,
                      idx: Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, String, Int) =
  Ok((arg_blocks, arg_cur_lbl,
       list_append(arg_cur_ops, Cons(call_op, Nil)),
       result, idx + 1))
  where result = fresh_name(idx)
        call_op = sprout_ir.IRCall(result, llvm_ret_type(call_ty),
                                   fname, arg_names)

# Thread a list of argument expressions through translate_expr, accumulating
# completed blocks, current-block ops, and the result-name of each arg.
# `acc_blocks` is in already-correct order (we append, not prepend); the
# arg-name list `acc_names` is built in reverse and reversed at the end so
# the caller sees them in source order.
#
# translate_args_scalar — for IRCall / direct-call paths.  Rejects any arg
# whose type is not Int or String (scalar-only milestone constraint).
#
# translate_args_ctor — for IRMakeCtor paths.  Accepts Int, String, and any
# heap-typed value (ADT, TVar, TApp, etc.), but rejects Bool and Unit — see
# is_supported_ctor_arg_type for the full rationale.
#
# Both delegate to translate_args_core with a type-filter flag.

fn translate_args_scalar(args: List typed_ast.TypedExpr, params: List String,
                         ctors: Dict (Int, Int, Int),
                         idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                         acc_blocks: List sprout_ir.IRBlock, acc_names: List String,
                         captures: Dict String,
                         lifted_ref: Ref (List sprout_ir.IRFunction),
                         top_level: Set,
                         lambda_ctr_ref: Ref Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, List String, Int) !{IO} =
  translate_args_core(args, params, ctors, idx, cur_label, cur_ops, acc_blocks, acc_names,
                      true, captures, lifted_ref, top_level, lambda_ctr_ref)

fn translate_args_ctor(args: List typed_ast.TypedExpr, params: List String,
                       ctors: Dict (Int, Int, Int),
                       idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                       acc_blocks: List sprout_ir.IRBlock, acc_names: List String,
                       captures: Dict String,
                       lifted_ref: Ref (List sprout_ir.IRFunction),
                       top_level: Set,
                       lambda_ctr_ref: Ref Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, List String, Int) !{IO} =
  translate_args_core(args, params, ctors, idx, cur_label, cur_ops, acc_blocks, acc_names,
                      false, captures, lifted_ref, top_level, lambda_ctr_ref)

fn translate_args_core(args: List typed_ast.TypedExpr, params: List String,
                       ctors: Dict (Int, Int, Int),
                       idx: Int, cur_label: String, cur_ops: List sprout_ir.IROp,
                       acc_blocks: List sprout_ir.IRBlock, acc_names: List String,
                       scalar_only: Bool,
                       captures: Dict String,
                       lifted_ref: Ref (List sprout_ir.IRFunction),
                       top_level: Set,
                       lambda_ctr_ref: Ref Int) ->
    Result String (List sprout_ir.IRBlock, String, List sprout_ir.IROp, List String, Int) !{IO} =
  match args with
  | Nil -> Ok((acc_blocks, cur_label, cur_ops, list_reverse(acc_names), idx))
  | Cons a rest ->
      if scalar_only && ! is_supported_arg_type (typed_ast.typed_expr_type(a))
      then Err("ast_to_ir: call argument must be Int or String at this milestone")
      else if ! scalar_only && is_bool_type(typed_ast.typed_expr_type(a))
      then Err("ast_to_ir: Bool ctor field not yet supported (requires zext i1 to i64 — deferred to follow-up PR)")
      else if ! scalar_only && is_unit_type(typed_ast.typed_expr_type(a))
      then Err("ast_to_ir: Unit ctor field not supported (Unit has no LLVM value to pass)")
      else
        match translate_expr(a, params, ctors, idx, cur_label, cur_ops,
                             captures, lifted_ref, top_level, lambda_ctr_ref) with
        | Err msg -> Err(msg)
        | Ok ar ->
            match ar with
            | (ablocks, acur_lbl, acur_ops, a_name, idx1) ->
                translate_args_core(rest, params, ctors, idx1, acur_lbl, acur_ops,
                                    list_append(acc_blocks, ablocks),
                                    Cons(a_name, acc_names), scalar_only,
                                    captures, lifted_ref, top_level, lambda_ctr_ref)

# Translate a function body into a complete List IRBlock.  The body always
# starts in the "entry" block; the final block (whatever cur_label is after
# translation) is sealed with IRRet.
fn translate_body(body: typed_ast.TypedExpr, params: List String,
                  ctors: Dict (Int, Int, Int), idx: Int,
                  captures: Dict String,
                  lifted_ref: Ref (List sprout_ir.IRFunction),
                  top_level: Set,
                  lambda_ctr_ref: Ref Int) ->
    Result String (List sprout_ir.IRBlock, Int) !{IO} =
  match translate_expr(body, params, ctors, idx, "entry", Nil,
                       captures, lifted_ref, top_level, lambda_ctr_ref) with
  | Err msg -> Err(msg)
  | Ok r ->
      match r with
      | (blocks, cur_lbl, cur_ops, name, next_idx) ->
          Ok((list_append(blocks,
                Cons(sprout_ir.IRBlock(cur_lbl,
                       list_append(cur_ops, Cons(sprout_ir.IRRet(name), Nil))),
                Nil)),
              next_idx))

fn param_known(name: String, params: List String) -> Bool =
  match params with
  | Nil -> false
  | Cons p rest -> if p == name then true else param_known(name, rest)

fn param_names(params: List ast.Param) -> List String =
  match params with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.Param n _ -> Cons(n, param_names(rest))

# Build an IRFunction from a (name, param-names, ret-type, blocks) tuple.
# `blocks` is already a fully-assembled List IRBlock — typically starting
# with an "entry" block — produced by translate_body.
fn build_fn(name: String, pnames: List String, ret_ty: String,
            blocks: List sprout_ir.IRBlock) -> sprout_ir.IRFunction =
  sprout_ir.IRFunction(name, pnames, ret_ty, blocks)

# Accept `main` only if its body is the literal unit expression `()`.
# Any other body would be silently dropped by ir_lowering's synthetic
# shim, leaving the user with a no-op binary; we surface a clear Err
# instead.  This is the documented PR 1.5 contract.
fn validate_main_body(body: typed_ast.TypedExpr) -> Result String (Maybe sprout_ir.IRFunction) =
  match body with
  | typed_ast.TUnit _ _ -> Ok(Nothing)
  | _ -> Err("ast_to_ir: main body must be () at this milestone — IR codegen does not yet lower IO/print")

# translate_user_fn: returns (IRFunction, next-free-temp-index, lifted-lambdas).
# The next-free index is the smallest idx never used as %tN/then_N/else_N/join_N
# during body translation; the rooting pass (M2 PR 2.2) consumes it to allocate
# fresh %tN names that do not collide with the translator's output.
# The third field is the flat list of lambda IRFunctions lifted during this fn.
# lambda_ctr_ref is shared across all user fns (lives at translate_program scope)
# so that lifted lambda names are unique program-wide (ir_lambda_0, ir_lambda_1, …).
fn translate_user_fn(name: String, pnames: List String, body: typed_ast.TypedExpr,
                     ctors: Dict (Int, Int, Int), top_level: Set,
                     lambda_ctr_ref: Ref Int) ->
    Result String (Maybe(sprout_ir.IRFunction, Int, List sprout_ir.IRFunction)) !{IO} =
  do
    lifted_ref <- ref_new(Nil)
    match translate_body(body, pnames, ctors, 0, dict_empty(), lifted_ref, top_level,
                         lambda_ctr_ref) with
    | Err msg -> Err(msg)
    | Ok pair ->
        match pair with
        | (blocks, next_idx) ->
            do
              lifted <- ref_read(lifted_ref)
              Ok(Just((build_fn(name, pnames, ret_ty, blocks), next_idx, list_reverse(lifted))))
  where ret_ty = llvm_ret_type(typed_ast.typed_expr_type(body))

fn translate_decl_with_idx(d: typed_ast.TypedDecl, ctors: Dict (Int, Int, Int),
                           top_level: Set, lambda_ctr_ref: Ref Int) ->
    Result String (Maybe(sprout_ir.IRFunction, Int, List sprout_ir.IRFunction)) !{IO} =
  match d with
  | typed_ast.TFnDecl name params _ _ _ body ->
      if name == "main"
      then
        match validate_main_body(body) with
        | Err msg -> Err(msg)
        | Ok Nothing -> Ok(Nothing)
        | Ok (Just _) -> Err("ast_to_ir: validate_main_body unexpectedly returned a function")
      else translate_user_fn(name, param_names(params), body, ctors, top_level, lambda_ctr_ref)
  | typed_ast.TExternFnDecl _ _ _ _ -> Ok(Nothing)
  | typed_ast.TLetDecl _ _ -> Ok(Nothing)
  | typed_ast.TInstanceDecl _ _ _ -> Ok(Nothing)
  | typed_ast.TPassThrough _ -> Ok(Nothing)

fn translate_decls(decls: List typed_ast.TypedDecl, ctors: Dict (Int, Int, Int),
                   acc_fns: List sprout_ir.IRFunction,
                   acc_idx: Dict Int, top_level: Set, lambda_ctr_ref: Ref Int) ->
    Result String (List sprout_ir.IRFunction, Dict Int) !{IO} =
  match decls with
  | Nil -> Ok((list_reverse(acc_fns), acc_idx))
  | Cons d rest ->
      match translate_decl_with_idx(d, ctors, top_level, lambda_ctr_ref) with
      | Err msg -> Err(msg)
      | Ok maybe_f ->
          match maybe_f with
          | Nothing -> translate_decls(rest, ctors, acc_fns, acc_idx, top_level, lambda_ctr_ref)
          | Just triple ->
              match triple with
              | (f, idx, lifted) ->
                  match f with
                  | sprout_ir.IRFunction fname _ _ _ ->
                      # acc_fns is built in reverse; list_reverse at Nil base.
                      # Prepend lifted lambdas first (in reverse order), then f.
                      # After list_reverse at the end: f, lifted_0, lifted_1, ...
                      translate_decls(rest, ctors,
                                      cons_list(lifted, Cons(f, acc_fns)),
                                      dict_set(fname, idx, acc_idx),
                                      top_level, lambda_ctr_ref)

# Prepend a list (in order) onto an accumulator list.
# cons_list([a,b,c], rest) = Cons(c, Cons(b, Cons(a, rest)))
# so that after list_reverse at end: [...rest_reversed, a, b, c]
# O(n).
fn cons_list(xs: List sprout_ir.IRFunction,
             acc: List sprout_ir.IRFunction) -> List sprout_ir.IRFunction =
  match xs with
  | Nil -> acc
  | Cons x rest -> cons_list(rest, Cons(x, acc))

# translate_program: top-level entry.  Accepts a TypedProgram (the output of
# compile_phase_recheck) and returns either (IRProgram, next-idx-per-fn) or an
# Err describing the first unsupported AST node encountered.
#
# The Dict maps fn-name → next-free %tN index; the rooting pass uses it to
# pick fresh slot/discard names without colliding with translator-allocated
# ones.
export fn translate_program(prog: typed_ast.TypedProgram) ->
    Result String (sprout_ir.IRProgram, Dict Int) !{IO} =
  match prog with
  | typed_ast.TypedProgram decls ->
      match build_ctor_table(decls) with
      | (ctor_dict, ctor_regs) ->
          do
            # Shared counter for unique ir_lambda_N naming across all user fns.
            lambda_ctr_ref <- ref_new(0)
            match translate_decls(decls, ctor_dict, Nil, dict_empty(),
                                  build_top_level_set(decls, ctor_dict),
                                  lambda_ctr_ref) with
            | Err msg -> Err(msg)
            | Ok pair ->
                match pair with
                | (fns, idx_map) -> Ok((sprout_ir.IRProgram(fns, ctor_regs), idx_map))
