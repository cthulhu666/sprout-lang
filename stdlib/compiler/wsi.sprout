module stdlib.compiler.wsi
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.types as types
import stdlib.compiler.source as source
import stdlib.compiler.vec_wrappers as vec_wrappers

# Wrapper store inline (docs/scalar-store-inline-v0.md). A call to a store wrapper such as
# `mutvec_set(g, i, x)` becomes the direct `vector_mutset(mutvec_raw(g), i, x)` when the
# stored operand has a non-heap scalar type, so `ast_to_ir` lowers it inline with no call and
# no write barrier. Any other call is left alone.
#
# Order of evaluation: a wrapper uses each parameter once, in order (`vec_wrappers`), so each
# argument still runs once, left to right. The only added steps are projection calls, which
# are pure field reads.
#
# Why the operand's type suffices: when the wrapper passes a bare parameter as the value, the
# operand is the caller's own expression with the caller's own type. When it passes anything
# else (a projection, a sum), `subst` keeps the wrapper's node type, which is the wrapper's
# type variable, so the type test fails and the call stays.
#
# Shadowing needs no scope tracking, for two names. The wrapper's name is a top-level
# declaration, so the bundler writes it `module.name`; a local binder is a bare identifier
# and never equals it. The inserted `vector_mutset` is an extern, and the bundler renames any
# local named like an extern (docs/prelude-name-identity-v0.md §5), so no binder captures it.
# The fixture's `set_shadowed` and tests/stdlib/test_mutvec_scalar_store.spr pin both.
#
# Only a node with a rewrite below it is rebuilt: the pass runs before dead-code removal, so
# it sees the whole program, and the unchanged rest is shared.

export fn expand_program(prog: typed_ast.TypedProgram) -> typed_ast.TypedProgram =
  match prog with
  | typed_ast.TypedProgram decls ->
      let stores = vec_wrappers.store_wrappers(decls, vec_wrappers.projection_set(decls))
      in if list_length(stores) == 0 then prog else expand_decls(prog, decls, dict_from_list(stores))

fn expand_decls(prog: typed_ast.TypedProgram, decls: List typed_ast.TypedDecl,
                stores: Dict vec_wrappers.Wrapper) -> typed_ast.TypedProgram =
  match typed_ast.share_list(rewrite_decl(_, stores), decls) with
  | Just rewritten -> typed_ast.TypedProgram(rewritten)
  | Nothing -> prog

fn rewrite_decl(d: typed_ast.TypedDecl, stores: Dict vec_wrappers.Wrapper) -> Maybe typed_ast.TypedDecl =
  match d with
  | typed_ast.TFnDecl name params ret eff cs body ->
      fmap(\b -> typed_ast.TFnDecl(name, params, ret, eff, cs, b), rewrite(body, stores))
  | typed_ast.TLetDecl name value -> fmap(\v -> typed_ast.TLetDecl(name, v), rewrite(value, stores))
  | typed_ast.TInstanceDecl c cs methods ->
      fmap(\ms -> typed_ast.TInstanceDecl(c, cs, ms), typed_ast.share_list(rewrite_method(_, stores), methods))
  | typed_ast.TExternFnDecl _ _ _ _ -> Nothing
  | typed_ast.TPassThrough _ -> Nothing

fn rewrite_method(m: typed_ast.TypedInstanceMethod, stores: Dict vec_wrappers.Wrapper) ->
    Maybe typed_ast.TypedInstanceMethod =
  match m with
  | typed_ast.TypedInstanceMethod name params ret eff cs body ->
      fmap(\b -> typed_ast.TypedInstanceMethod(name, params, ret, eff, cs, b), rewrite(body, stores))

# Bottom-up, so a store nested in an argument of another is rewritten first. `Nothing` means
# nothing below or at `e` changed.
fn rewrite(e: typed_ast.TypedExpr, stores: Dict vec_wrappers.Wrapper) -> Maybe typed_ast.TypedExpr =
  let rebuilt = typed_ast.map_children_shared(rewrite(_, stores), e)
  in maybe_or_else(expand_store(maybe_with_default(e, rebuilt), stores), rebuilt)

# The new callee keeps the wrapper callee's type `vt`, as `bce` does for its pseudo-callees:
# lowering reads the name and the argument types, not this one.
fn expand_store(e: typed_ast.TypedExpr, stores: Dict vec_wrappers.Wrapper) -> Maybe typed_ast.TypedExpr =
  match e with
  | typed_ast.TCall (typed_ast.TVar f vt vp) args t p ->
      let Just s = vec_wrappers.shape_at(f, args, stores) else Nothing
          Just x = s.val else Nothing
      in if vec_wrappers.shape_converts(s)
         then Just(typed_ast.TCall(typed_ast.TVar("vector_mutset", vt, vp), [s.vec, s.idx, x], t, p))
         else Nothing
  | _ -> Nothing
