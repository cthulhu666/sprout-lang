module stdlib.compiler.bundler
import stdlib.compiler.ast as ast
import stdlib.compiler.source as source
import stdlib.compiler.lexer as lexer
import stdlib.compiler.token as token
import stdlib.compiler.parser as parser
import stdlib.compiler.module_loader as module_loader
import stdlib.compiler.types as types
import stdlib.compiler.deriving as deriving
import stdlib.string as string
# Load-bearing despite the alias never being written — see the note in source.sprout.
# `bytes_from_utf8` is an extern owned by stdlib.bytes and needs that module bundled.
import stdlib.bytes as bytes
import stdlib.fs as fs

# ---------------------------------------------------------------------------
# Public API
# ---------------------------------------------------------------------------

# Each module's declarations, in the program's order: the prelude first and each
# module after its imports. bundle_program is them as one program.
export type BundleResult (..) =
  | BundleOk (List (List ast.Decl))
  | BundleErr source.SourcePos String

export fn bundle_program(modules: List (List ast.Decl)) -> ast.Program =
  ast.Program(ast.flatten_modules(modules), no_pos())

# Where module sources come from, and what has already been parsed.
#
#   overlay : in-memory sources, keyed by path, that take PRECEDENCE over the
#             filesystem. An editor typechecks buffers that are not on disk — unsaved
#             edits, and an entry "file" that may have no path at all — and this is how
#             they enter the bundle. Every open dirty buffer can be supplied, not just
#             the active one, which the env path could never do.
#   parsed  : memo of path → (source text, ParsedModule), so a session that checks the
#             same file after each keystroke re-parses its imports once instead of always.
#
# A memo hit needs the source just read to equal the source the module was parsed from,
# so an import edited on disk is re-parsed. The read is the cost of that check; mtime
# would skip it but has whole-second resolution and would miss a save-then-eval.
# Overlay paths are never memoised: they are dirty by definition.
export type LoadEnv (..) =
  | LoadEnv (Dict String) (Ref (Dict (String, ParsedModule)))

export fn new_load_env() -> LoadEnv !{IO} =
  do
    parsed <- ref_new(dict_empty())
    LoadEnv(dict_empty(), parsed)

# A LoadEnv sharing this one's memos but reading the given in-memory sources first.
export fn load_env_with_overlay(overlay: Dict String, base: LoadEnv) -> LoadEnv =
  match base with
  | LoadEnv _ parsed -> LoadEnv(overlay, parsed)

fn load_env_overlay(e: LoadEnv) -> Dict String =
  match e with | LoadEnv o _ -> o

fn load_env_parsed(e: LoadEnv) -> Ref (Dict (String, ParsedModule)) =
  match e with | LoadEnv _ p -> p

# ---------------------------------------------------------------------------
# Internal types
# ---------------------------------------------------------------------------

# A single loaded+parsed module file.
#   ParsedModule module_name path specs exported ctor_types decls
#   module_name : "" for prelude (no module header)
#   exported    : names declared with `export` (fn / type / let / class)
#   ctor_types  : subset of exported – type names whose ctors are exported (export type X(..))
type ParsedModule =
  | ParsedModule String String (List module_loader.ImportSpec) (List String) (List String) (List ast.Decl)

# Per-module name tables.
#   ModuleSymbols value_locals type_locals class_locals
#                 exported_vals exported_types exported_cls
#                 class_methods ctor_exports extern_names
#
# A class method is a module value like a function (docs/qualified-class-methods-v0.md):
# it is in `value_locals`, and in `exported_vals` when its class is exported.
# `class_methods` maps a class's bare name to its methods (bare -> canonical), so
# importing the class binds them.
#
# `extern_names` is for DIAGNOSTICS and `foreign_externs`, and is the one entry that is not a
# resolution binding: an extern is ScopeGlobal, so it resolves by bare name
# wherever its module is bundled and never lands in a name map. Listing one in an
# import is still meaningful — it is what bundles the module — so the import
# checks have to know the name exists.
type ModuleSymbols =
  | ModuleSymbols
      (Dict String) (Dict String) (Dict String)
      (Dict String) (Dict String) (Dict String)
      (Dict (Dict String)) (Dict (Dict String)) (List String)

# What one import binds, in one namespace.
#
#   ImportBinding ns name target
#
# The namespace is what keeps a type and a value of the same name from reading as
# a conflict: `wrap Foo` legitimately binds both.
type ImportNs =
  | NsValue  # unqual_values — exported values, and the ctors an `(..)` type brings
  | NsType  # unqual_types
  | NsClass  # unqual_classes
  | NsPrefix  # a whole-module import's prefix; `target` is the module name

type ImportBinding =
  | ImportBinding ImportNs String String

# Name-resolution context for qualifying one module's declarations.
#
# `prelude` is what the prelude declares, for `prelude.X` and for renaming a local
# that shares a prelude value's name (`local_name`).
#
# `canonical_names` is the one entry that is not per-module: it is every
# `<module>.<name>` in the bundle, and it is here so the two `qualify_*_name`
# fallbacks can tell a hand-written canonical name from a field chain. See
# `guard_canonical`.
#
# `foreign` is the private externs declared by OTHER modules, by name; see
# `foreign_externs`.
type ResolveCtx = (value_locals: Dict String, type_locals: Dict String,
                   class_locals: Dict String,
                   unqual_values: Dict String, unqual_types: Dict String,
                   unqual_classes: Dict String,
                   alias_val_exports: Dict (Dict String),
                   alias_type_exports: Dict (Dict String),
                   canonical_names: Dict String, prelude: PreludeNames,
                   foreign: Dict PrivateExtern)

# An extern a module may NOT reach unless it declares it too: the module that declares
# it, and whether its signature writes `local` (which only changes the diagnostic).
type PrivateExtern = (declarer: String, name: String, writes_local: Bool)

# The prelude's own symbol tables, held as they are, built once per bundle beside
# `canonical`. `bare` is built from the externs, which are in no value table.
#
# `unexported` is the prelude's `fn` and `let` names that it does not export. It is
# built from the declarations, not the value table, which also holds constructors
# and methods. Empty in the prelude's own context, and when the bundle has none.
type PreludeNames = (values: Dict String, bare: Dict String, types: Dict String,
                     classes: Dict String, unexported: Set)

# ---------------------------------------------------------------------------
# ModuleSymbols accessors
# ---------------------------------------------------------------------------

fn sym_value_locals(s: ModuleSymbols) -> Dict String =
  match s with | ModuleSymbols v _ _ _ _ _ _ _ _ -> v

fn sym_type_locals(s: ModuleSymbols) -> Dict String =
  match s with | ModuleSymbols _ t _ _ _ _ _ _ _ -> t

fn sym_class_locals(s: ModuleSymbols) -> Dict String =
  match s with | ModuleSymbols _ _ c _ _ _ _ _ _ -> c

fn sym_exported_vals(s: ModuleSymbols) -> Dict String =
  match s with | ModuleSymbols _ _ _ ev _ _ _ _ _ -> ev

fn sym_exported_types(s: ModuleSymbols) -> Dict String =
  match s with | ModuleSymbols _ _ _ _ et _ _ _ _ -> et

fn sym_exported_cls(s: ModuleSymbols) -> Dict String =
  match s with | ModuleSymbols _ _ _ _ _ ec _ _ _ -> ec

fn sym_class_methods(s: ModuleSymbols) -> Dict (Dict String) =
  match s with | ModuleSymbols _ _ _ _ _ _ cm _ _ -> cm

fn sym_ctor_exports(s: ModuleSymbols) -> Dict (Dict String) =
  match s with | ModuleSymbols _ _ _ _ _ _ _ ce _ -> ce

fn sym_extern_names(s: ModuleSymbols) -> List String =
  match s with | ModuleSymbols _ _ _ _ _ _ _ _ xs -> xs

# ---------------------------------------------------------------------------
# ResolveCtx updates
# ---------------------------------------------------------------------------

fn ctx_with_alias_val(c: ResolveCtx, alias: String, exports: Dict String) -> ResolveCtx =
  c with (alias_val_exports = dict_set(alias, exports, c.alias_val_exports))

fn ctx_with_alias_type(c: ResolveCtx, alias: String, exports: Dict String) -> ResolveCtx =
  c with (alias_type_exports = dict_set(alias, exports, c.alias_type_exports))

fn ctx_with_unqual_value(c: ResolveCtx, name: String, canonical: String) -> ResolveCtx =
  c with (unqual_values = dict_set(name, canonical, c.unqual_values))

fn ctx_with_unqual_type(c: ResolveCtx, name: String, canonical: String) -> ResolveCtx =
  c with (unqual_types = dict_set(name, canonical, c.unqual_types))

fn ctx_with_unqual_class(c: ResolveCtx, name: String, canonical: String) -> ResolveCtx =
  c with (unqual_classes = dict_set(name, canonical, c.unqual_classes))

fn empty_resolve_ctx() -> ResolveCtx =
  ResolveCtx(value_locals = dict_empty(), type_locals = dict_empty(),
             class_locals = dict_empty(),
             unqual_values = dict_empty(), unqual_types = dict_empty(),
             unqual_classes = dict_empty(), alias_val_exports = dict_empty(),
             alias_type_exports = dict_empty(), canonical_names = dict_empty(),
             prelude = no_prelude_names(), foreign = dict_empty())

# ---------------------------------------------------------------------------
# Utilities
# ---------------------------------------------------------------------------

fn no_pos() -> source.SourcePos = source.SourcePos(index = 0, line = 0, column = 0)

fn qualified_name(module_name: source.ModuleName, name: source.RawName) -> source.QualifiedName =
  source.QualifiedName(
    if mn == "" then rn else mn ++ "." ++ rn)
  where mn = source.module_name_str(module_name)
        rn = source.raw_name_str(name)

# Prelude `list_member` allocates its `Eq String` closure on every call, once per
# name resolved; with it, self-compile peaks ~15 MB higher.
fn str_list_member(name: String, lst: List String) -> Bool =
  match lst with
  | Nil -> false
  | Cons h t -> if h == name then true else str_list_member(name, t)

# `maybe_with_default` would box the `dict_get` result; matching it in place does not.
fn dict_get_or(key: String, d: Dict String, default: String) -> String =
  match dict_get(key, d) with
  | Nothing -> default
  | Just v -> v

# ---------------------------------------------------------------------------
# Source scanning: module name and export names from raw source text
# ---------------------------------------------------------------------------

fn find_newline(s: String, bytes: Bytes, b: Int) -> Int =
  if b >= str_byte_len(s) then str_byte_len(s)
  else
    match source.decode_char_at(bytes, b) with
    | Nothing -> b + 1
    | Just (ch, next_b) -> if ch == '\n' then b else find_newline(s, bytes, next_b)

fn skip_spaces_in(s: String, bytes: Bytes, b: Int) -> Int =
  if b >= str_byte_len(s) then b
  else
    match source.decode_char_at(bytes, b) with
    | Nothing -> b
    | Just (ch, _) -> if ch == ' ' || ch == '\t' then skip_spaces_in(s, bytes, b + 1) else b

fn is_ident_char(ch: Char) -> Bool =
  (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
  (ch >= '0' && ch <= '9') || ch == '_'

# Read a dotted identifier like "stdlib.compiler.ast".
fn read_dotted_ident_chars(s: String, bytes: Bytes, b: Int, acc: String) -> (String, Int) =
  if b >= str_byte_len(s) then (acc, b)
  else
    match source.decode_char_at(bytes, b) with
    | Nothing -> (acc, b)
    | Just (ch, _) ->
        if is_ident_char(ch) then read_dotted_ident_chars(s, bytes, b + 1, str_concat(acc, char_to_string(ch)))
        else if ch == '.' then
          match source.decode_char_at(bytes, b + 1) with
          | Nothing -> (acc, b)
          | Just (next, _) ->
              if is_ident_char(next) then
                read_dotted_ident_chars(s, bytes, b + 1, str_concat(acc, char_to_string(ch)))
              else (acc, b)
        else (acc, b)

fn read_dotted_ident_at(s: String, bytes: Bytes, b: Int) -> (String, Int) =
  read_dotted_ident_chars(s, bytes, skip_spaces_in(s, bytes, b), "")

# Returns (module_name, exported_names, ctor_export_type_names).
#
# The export set and the `(..)` constructor-export markers come from
# `parser.scan_module_surface`, the single definition of a module's surface
# (docs/module-surface-authority-v0.md §6). They used to be recovered here by
# matching line prefixes, which is how this function came to disagree with the
# REPL's own scanner about what a module publishes — and why the prefix order
# `export type linear ` before `export type ` was load-bearing (the generic prefix
# otherwise read the contextual marker word `linear` as the type's name; regression
# tests/stdlib/test_linear_cross_module.spr `consume_annotated`). A token scan
# cannot have that hazard.
#
# Only the module name is still read from the text, because headers are stripped
# before tokenizing and so `module x.y` never reaches the token stream.
export fn scan_source_info(src: String) -> (String, List String, List String) =
  match lexer.tokenize_source(src) with
  # A source that does not lex has no surface to report. Callers that need the
  # error raise it from their own tokenize (process_wi_finalize); the rest are
  # diagnostic paths where an empty surface is the honest answer.
  | Err _ -> (scan_module_name(src), Nil, Nil)
  | Ok tokens -> surface_info(scan_module_name(src), parser.scan_module_surface(tokens))

fn surface_info(mod_name: String, surface: parser.ModuleSurface) -> (String, List String, List String) =
  (mod_name, parser.surface_exported(surface), parser.surface_ctor_types(surface))

# The `module x.y` header, or "" when there is none. Takes the FIRST such line: a
# module header is the first declaration in a file, and the line scan this replaced
# took the last, which would have preferred a line inside a multi-line string
# literal over the real header.
export fn scan_module_name(src: String) -> String =
  scan_module_name_at(src, bytes, 0)
  where bytes = bytes_from_utf8(src)

fn scan_module_name_at(src: String, bytes: Bytes, i: Int) -> String =
  if i >= str_byte_len(src) then ""
  else if str_starts_with_at_byte(src, i, "module ") then
    match read_dotted_ident_at(src, bytes, i + 7) with
    | (name, _) -> name
  else scan_module_name_at(src, bytes, find_newline(src, bytes, i) + 1)

# ---------------------------------------------------------------------------
# Header stripping (strips module + import lines before parsing)
# ---------------------------------------------------------------------------

# Header stripping is source.strip_headers (line-preserving, shared authority).

# ---------------------------------------------------------------------------
# Topological DFS collection (iterative, using an explicit work stack)
# ---------------------------------------------------------------------------
#
# The original recursive visit_module → visit_imports → visit_one_import →
# visit_by_name → visit_module chain is 4-way mutual recursion that the
# code generator cannot TCO.  For compile_driver.sprout (18 transitive stdlib
# deps) this easily overflows the 8 MB default stack.
#
# We replace it with an iterative DFS driven by a Ref (List WorkItem) stack.
# process_work is self-tail-recursive, so the code generator emits a single
# tco_loop for it — O(1) native stack depth regardless of import graph size.
#
# Three work-item variants preserve the original semantics:
#   WIVisit path edge — check seen/visiting; enqueue deps then WIFinalize + WILeave
#   WILeave path      — pop path from the visiting (ancestor) set after its subtree
#   WIFinalize path src specs — lex/parse/record the module; add to seen

fn prelude_path(stdlib_root: String) -> String =
  stdlib_root ++ "/prelude.sprout"

# The import that led to a module, so a failure to load it can point at that line.
type ImportEdge = (importer: String, spec: module_loader.ImportSpec)

type WorkItem =
  # `Nothing` for the entry, which nothing imported.
  | WIVisit String (Maybe ImportEdge)
  | WILeave String
  | WIFinalize String String (List module_loader.ImportSpec)
  # Already parsed on an earlier call: record the memoised module, skip lex and parse.
  | WIRecord ParsedModule

# A load failure: the file it came from, where in that file, and what went wrong.
#
# The position is carried SEPARATELY from the message rather than only being embedded in
# its text. An editor needs it as a range, and a lex or parse error reported at
# `no_pos()` lands on line 0 and squiggles nothing — which is what happened to every
# syntax error the moment the editor started typechecking by bundling. TokenizeError and
# ParseError have always carried the position; only this channel dropped it.
type LoadIssue =
  | LoadIssue String source.SourcePos String

fn spec_to_path(spec: module_loader.ImportSpec, stdlib_root: String, extra_roots: List String) -> Maybe String =
  module_loader.resolve_module_path(source.ModuleName(module_loader.import_module(spec)), stdlib_root, extra_roots)

# Each import with its path, or the first import that resolves to no path.
fn resolve_specs(specs: List module_loader.ImportSpec, stdlib_root: String, extra_roots: List String) -> Result module_loader.ImportSpec (List (String, module_loader.ImportSpec)) =
  match specs with
  | Nil -> Ok(Nil)
  | Cons spec rest ->
      let Just path = spec_to_path(spec, stdlib_root, extra_roots) else Err(spec)
          deps = try resolve_specs(rest, stdlib_root, extra_roots)
      in Ok(Cons((path, spec), deps))

# Push a WIVisit item for each dependency onto stack.
# Called with the deps reversed so the first import ends up on top.
fn push_visit_items(importer: String, deps: List (String, module_loader.ImportSpec), stack: List WorkItem) -> List WorkItem =
  match deps with
  | Nil -> stack
  | Cons (path, spec) rest ->
      push_visit_items(importer, rest, Cons (WIVisit(path, Just (ImportEdge(importer = importer, spec = spec))), stack))

# `import math.int` for `stdlib.math.int`: a hint, looked up only once loading has failed.
fn stdlib_prefix_hint(mod_name: String, stdlib_root: String) -> String !{IO} =
  if str_starts_with(mod_name, "stdlib.") || str_find(mod_name, ".") == -1 then ""
  else
    match module_loader.module_name_to_path(source.ModuleName("stdlib." ++ mod_name), stdlib_root) with
    | Nothing -> ""
    | Just path ->
        do
          found <- fs.is_file(path)
          if found then `; did you mean \`stdlib.${mod_name}\`?` else ""

# An issue at an import's line, naming the module, with the stdlib-prefix hint.
fn import_issue(importer: String, spec: module_loader.ImportSpec, detail: String, stdlib_root: String) -> LoadIssue !{IO} =
  do
    let mod_name = module_loader.import_module(spec)
    hint <- stdlib_prefix_hint(mod_name, stdlib_root)
    LoadIssue(importer, module_loader.import_pos(spec), `${importer}: import ${mod_name}: ${detail}${hint}`)

# A dotted, non-stdlib name resolves to no path only when no package root is configured.
fn unresolved_issue(importer: String, spec: module_loader.ImportSpec, stdlib_root: String) -> LoadIssue !{IO} =
  import_issue(importer, spec, "unknown module — it is not a stdlib module, and no package root is configured", stdlib_root)

# A module that resolved to a path but could not be read. The entry has no import to blame.
fn unreadable_issue(path: String, edge: Maybe ImportEdge, msg: String, stdlib_root: String) -> LoadIssue !{IO} =
  match edge with
  | Nothing -> LoadIssue(path, no_pos(), `cannot read ${path}: ${msg}`)
  | Just e -> import_issue(e.importer, e.spec, `cannot read ${path}: ${msg}`, stdlib_root)

fn remove_str_from_list(s: String, lst: List String) -> List String =
  match lst with
  | Nil -> Nil
  | Cons h t -> if h == s then t else Cons(h, remove_str_from_list(s, t))

# Main iterative DFS loop.  Self-tail-recursive → TCO'd by the code generator.
fn process_work(
  work: Ref (List WorkItem),
  visiting: Ref (List String),
  seen: Ref (List String),
  ordered: Ref (List ParsedModule),
  stdlib_root: String,
  extra_roots: List String,
  load_env: LoadEnv
) -> List LoadIssue !{IO} =
  do
    stack <- ref_read(work)
    match stack with
    | Nil -> Nil
    | Cons item rest ->
        do
          ref_write(work, rest)
          errs <- process_item(item, work, visiting, seen, ordered, stdlib_root, extra_roots, load_env)
          match errs with
          | [_ | _] -> errs
          | Nil -> process_work(work, visiting, seen, ordered, stdlib_root, extra_roots, load_env)

fn process_item(
  item: WorkItem,
  work: Ref (List WorkItem),
  visiting: Ref (List String),
  seen: Ref (List String),
  ordered: Ref (List ParsedModule),
  stdlib_root: String,
  extra_roots: List String,
  load_env: LoadEnv
) -> List LoadIssue !{IO} =
  match item with
  | WIVisit path edge -> process_wi_visit(path, edge, work, visiting, seen, ordered, stdlib_root, extra_roots, load_env)
  | WILeave path -> process_wi_leave(path, visiting)
  | WIFinalize path src specs -> process_wi_finalize(path, src, specs, seen, ordered, load_env)
  | WIRecord mod -> process_wi_record(mod, seen, ordered)

# The source of a module: an in-memory buffer if the caller supplied one, else the file.
# An overlay entry for a path that does not exist on disk is the point, not an edge case —
# it is how an editor typechecks an unsaved buffer.
fn module_source(path: String, load_env: LoadEnv) -> Result String String !{IO} =
  match dict_get(path, load_env_overlay(load_env)) with
  | Just src -> Ok(src)
  | Nothing -> fs.read_text(path)

# A memoised parse of `src`, only when the caller has not overridden this path in memory.
fn memoised_module(path: String, src: String, load_env: LoadEnv) -> Maybe ParsedModule !{IO} =
  match dict_get(path, load_env_overlay(load_env)) with
  | Just _ -> Nothing
  | Nothing ->
      do
        parsed <- ref_read(load_env_parsed(load_env))
        match dict_get(path, parsed) with
        | Just (old_src, mod) -> if old_src == src then Just(mod) else Nothing
        | Nothing -> Nothing

fn process_wi_record(
  mod: ParsedModule,
  seen: Ref (List String),
  ordered: Ref (List ParsedModule)
) -> List LoadIssue !{IO} =
  match mod with
  | ParsedModule _ path _ _ _ _ ->
      do
        ordered_now <- ref_read(ordered)
        ref_write(ordered, Cons(mod, ordered_now))
        seen_now <- ref_read(seen)
        ref_write(seen, Cons(path, seen_now))
        Nil

fn process_wi_visit(
  path: String,
  edge: Maybe ImportEdge,
  work: Ref (List WorkItem),
  visiting: Ref (List String),
  seen: Ref (List String),
  ordered: Ref (List ParsedModule),
  stdlib_root: String,
  extra_roots: List String,
  load_env: LoadEnv
) -> List LoadIssue !{IO} =
  do
    seen_list <- ref_read(seen)
    if str_list_member(path, seen_list) then Nil
    else
      do
        visiting_list <- ref_read(visiting)
        if str_list_member(path, visiting_list) then
          Cons(LoadIssue(path, no_pos(), "Import cycle detected involving: " ++ path), Nil)
        else
          do
            match module_source(path, load_env) with
            | Err msg ->
                do
                  issue <- unreadable_issue(path, edge, msg, stdlib_root)
                  [issue]
            | Ok src ->
                # A memo hit carries the module's own import specs, so it skips the lex
                # and the parse while still walking exactly the same dependency edges.
                # Matched at the call, not bound with `<-`: a do-bind unwraps a Maybe
                # returned from an effectful function and would lose the miss case.
                match memoised_module(path, src, load_env) with
                | Just mod ->
                    enqueue_module(path, parsed_specs(mod), WIRecord(mod),
                      work, visiting, visiting_list, stdlib_root, extra_roots)
                | Nothing ->
                    do
                      let specs = module_loader.collect_imports(src)
                      enqueue_module(path, specs, WIFinalize(path, src, specs),
                        work, visiting, visiting_list, stdlib_root, extra_roots)

# Mark the module in progress and push its dependencies above the item that completes it,
# so the subtree is finished before the module itself is recorded. An import that resolves
# to no path stops the walk here, before anything is pushed.
fn enqueue_module(
  path: String,
  specs: List module_loader.ImportSpec,
  finish: WorkItem,
  work: Ref (List WorkItem),
  visiting: Ref (List String),
  visiting_list: List String,
  stdlib_root: String,
  extra_roots: List String
) -> List LoadIssue !{IO} =
  match resolve_specs(specs, stdlib_root, extra_roots) with
  | Err spec ->
      do
        issue <- unresolved_issue(path, spec, stdlib_root)
        [issue]
  | Ok deps ->
      do
        ref_write(visiting, Cons(path, visiting_list))
        stack_now <- ref_read(work)
        ref_write(work, push_visit_items(path, list_reverse(deps), Cons(finish, Cons (WILeave(path), stack_now))))
        Nil

fn parsed_specs(mod: ParsedModule) -> List module_loader.ImportSpec =
  match mod with
  | ParsedModule _ _ specs _ _ _ -> specs

fn parsed_path(mod: ParsedModule) -> String =
  match mod with
  | ParsedModule _ path _ _ _ _ -> path

fn issue_message(issue: LoadIssue) -> String =
  match issue with | LoadIssue _ _ msg -> msg

# A position is only reportable when the failure is in the file the caller asked about.
# An error inside an IMPORTED module has a position in THAT file, and handing it back
# would land the squiggle on an unrelated line of the document being edited. The message
# still names the offending path or module, so nothing is lost but a misplaced marker.
fn pos_for_entry(path: String, pos: source.SourcePos, entry_path: String) -> source.SourcePos =
  if path == entry_path then pos else no_pos()

fn issue_pos_for_entry(issue: LoadIssue, entry_path: String) -> source.SourcePos =
  match issue with
  | LoadIssue path pos _ -> pos_for_entry(path, pos, entry_path)

fn process_wi_leave(path: String, visiting: Ref (List String)) -> List LoadIssue !{IO} =
  do
    visiting_list <- ref_read(visiting)
    ref_write(visiting, remove_str_from_list(path, visiting_list))
    Nil

fn process_wi_finalize(
  path: String,
  src: String,
  specs: List module_loader.ImportSpec,
  seen: Ref (List String),
  ordered: Ref (List ParsedModule),
  load_env: LoadEnv
) -> List LoadIssue !{IO} =
  do
    # One tokenize serves both the module surface and the parse. Calling
    # scan_source_info here would lex the source a second time, and lexing it twice
    # is how the surface could differ from the AST in the first place.
    match lexer.tokenize_source(src) with
    | Err e ->
        match e with
        | token.TokenizeError msg pos -> Cons(LoadIssue(path, pos, "Lex error in " ++ path ++ ": " ++ msg), Nil)
    | Ok tokens ->
        match parser.parse_program(tokens) with
          | Err e ->
              match e with
              | parser.ParseError msg pos -> Cons(LoadIssue(path, pos, "Parse error in " ++ path ++ ": " ++ msg), Nil)
          | Ok prog ->
              do
                match prog with
                | ast.Program decls _ ->
                    do
                      let surface = parser.scan_module_surface(tokens)
                      let mod = ParsedModule(scan_module_name(src), path, specs,
                        parser.surface_exported(surface), parser.surface_ctor_types(surface), decls)
                      memoise_module(path, src, mod, load_env)
                      ordered_now <- ref_read(ordered)
                      ref_write(ordered, Cons(mod, ordered_now))
                      seen_now <- ref_read(seen)
                      ref_write(seen, Cons(path, seen_now))
                      Nil

# Record a parse for reuse — unless the caller supplied this path's source in memory, in
# which case it is a dirty buffer and memoising it would serve a stale parse next time.
fn memoise_module(path: String, src: String, mod: ParsedModule, load_env: LoadEnv) -> Unit !{IO} =
  match dict_get(path, load_env_overlay(load_env)) with
  | Just _ -> ()
  | Nothing ->
      do
        parsed <- ref_read(load_env_parsed(load_env))
        ref_write(load_env_parsed(load_env), dict_set(path, (src, mod), parsed))

fn visit_module_iter(
  entry_path: String,
  stdlib_root: String,
  extra_roots: List String,
  seen: Ref (List String),
  ordered: Ref (List ParsedModule),
  load_env: LoadEnv
) -> List LoadIssue !{IO} =
  do
    work <- ref_new(Cons (WIVisit(entry_path, Nothing), Nil))
    visiting <- ref_new(Nil)
    process_work(work, visiting, seen, ordered, stdlib_root, extra_roots, load_env)

# Collect all modules in topological order, prepending the prelude.
#
# The prelude is UNCONDITIONAL (docs/prelude-scope-v0.md). It used to be withheld
# from a file with no named module anywhere in its import closure, on the theory
# that such a file was a self-contained unit defining its own types. Two things
# were wrong with that. It inferred the language available in a file from its
# import graph, so adding one unrelated `import` silently changed it. And it
# withheld only the prelude's DECLARATIONS — the checker was handed its schemes
# regardless — so a call to a prelude function from such a file type-checked,
# emitted a call with no matching define, and failed inside clang instead of
# producing a diagnostic.
#
# A headerless entry file keeps its own namespace rather than sharing the
# prelude's; see name_entry_module.
fn collect_modules(entry_path: String, stdlib_root: String, extra_roots: List String, load_env: LoadEnv) -> (Maybe LoadIssue, List ParsedModule) !{IO} =
  do
    seen <- ref_new(Nil)
    ordered <- ref_new(Nil)
    errs <- visit_module_iter(entry_path, stdlib_root, extra_roots, seen, ordered, load_env)
    match errs with
    | [e | _] -> (Just(e), Nil)
    | Nil ->
        do
          mods <- ref_read(ordered)
          let plain_mods = list_reverse(mods)
          match headerless_import(plain_mods, entry_path) with
          | Just issue -> (Just(issue), Nil)
          | Nothing ->
              do
                skip <- skip_prelude(entry_path, stdlib_root, load_env)
                # THREE dispositions, not two. `skip_prelude` answers "no full
                # prelude", which covers two cases that now want different things.
                #
                # The prelude AS the entry gets nothing prepended: prepending even
                # the floor would list its own externs a second time and every one
                # would be "defined more than once". `--phase bundle
                # stdlib/prelude.sprout` is a standing check (DoD #8), so this is
                # reachable, not theoretical.
                #
                # A `no_prelude` file gets the FLOOR (docs/no-prelude-core-v0.md):
                # the primitive-only externs, so the opt-out drops the library
                # without dropping the language's runtime interface.
                #
                # Naming the entry is COUPLED to prepending the FULL prelude, not
                # done unconditionally: the synthetic name exists only to keep the
                # entry out of the prelude's namespace. Qualifying anyway would be a
                # pure loss, because do notation still picks the monad family by the
                # UNQUALIFIED name. A `no_prelude` file that defines its own `Maybe`
                # depends on staying bare, and the floor is safe to prepend without renaming
                # precisely because it declares no types and no classes — there is
                # nothing on either axis for the entry to collide with.
                if entry_path == prelude_path(stdlib_root) then (Nothing, plain_mods)
                else
                  do
                    (err, prelude) <- prelude_module(stdlib_root, load_env)
                    match prelude with
                    | Nothing -> (err, Nil)
                    | Just mod ->
                        if skip then (Nothing, Cons(prelude_floor(mod), plain_mods))
                        else (Nothing, Cons(mod, name_entry_module(plain_mods, entry_path)))

# An IMPORTED file must declare a module header.
#
# Imports resolve by PATH (`module_loader.resolve_module_path`) with no check that
# the file declares a matching name, so an imported file could be headerless. Its
# declarations then emitted unqualified and collided with the prelude's, and the
# only sign was ``…is defined more than once in this module`` — a message about a
# symbol, naming neither the file nor the real cause. This says the cause.
#
# It is also what makes a single fixed `$entry` name sound: exactly one file in a
# bundle may be headerless, so one synthetic name can never collide with another.
#
# The prelude is exempt by construction — it is prepended after this check rather
# than imported, so it is not in the list.
fn headerless_import(mods: List ParsedModule, entry_path: String) -> Maybe LoadIssue =
  match mods with
  | Nil -> Nothing
  | Cons mod rest ->
      match mod with
      | ParsedModule mod_name path _ _ _ _ ->
          if mod_name == "" && path != entry_path then
            Just(LoadIssue(path, no_pos(),
              "imported file " ++ path ++ " has no `module` header; an imported file must "
                ++ "declare one so its declarations have a namespace of their own"))
          else headerless_import(rest, entry_path)

# The two cases that get no prelude prepended.
#
# The prelude AS the entry: prepending it would list the same path twice — the
# memo hands back the same ParsedModule — and every one of its declarations would
# then be "defined more than once". `--phase bundle stdlib/prelude.sprout` is a
# standing check (AGENTS.md Definition of Done #8), so this is a reachable path.
#
# The `no_prelude` directive: the explicit, file-local opt-out. It re-reads the
# entry source rather than recording the flag on ParsedModule, which would mean a
# seventh field threaded through 39 construction and destructuring sites. The cost
# is one extra read of ONE file, and none at all on the editor path — a buffer
# being checked is already in the overlay, so `module_source` returns it directly.
fn skip_prelude(entry_path: String, stdlib_root: String, load_env: LoadEnv) -> Bool !{IO} =
  if entry_path == prelude_path(stdlib_root) then true
  else
    # The walk has just read the entry; if it vanished since, the full prelude is the default.
    match module_source(entry_path, load_env) with
    | Err _ -> false
    | Ok src -> source.has_no_prelude(src)

# Give a headerless ENTRY file the synthetic module name, so its declarations
# qualify like every other module's.
#
# `qualified_name` (:202) reads the empty module name as "do not qualify", and ""
# is exactly the name the prelude carries. A headerless file therefore shared one
# flat namespace with the prelude, and every name it redefined — `Maybe`, `map` —
# collided. Naming it resolves that with the shadowing the language already has:
# the file's `Just` becomes `$entry.Just` while the prelude keeps `Just`.
#
# The name itself is `source.entry_module_name`, which is also where the render-
# time strip lives — one authority, so the two cannot drift. A single FIXED name
# is sound because only the entry may be headerless: an imported file without a
# `module` header is diagnosed.
#
# Applied HERE rather than where the module is parsed, because the parse is
# memoised across bundles: the same file may be the entry of one bundle and an
# import of the next, and stamping the name into the memo would carry it over.
#
# Called ONLY on the branch that prepends the prelude, which is what makes the
# prelude-as-entry case need no guard here: that entry takes the skip branch, so
# its own unqualified symbols — the ones every other module resolves against, and
# the ones baked into bootstrap/compile_driver.ll — are never renamed.
fn name_entry_module(mods: List ParsedModule, entry_path: String) -> List ParsedModule =
  match mods with
  | Nil -> Nil
  | Cons mod rest ->
      match mod with
      | ParsedModule mod_name path specs exported ctor_types decls ->
          if mod_name == "" && path == entry_path then
            Cons(ParsedModule(source.entry_module_name, path, specs, exported, ctor_types, decls), rest)
          else Cons(mod, name_entry_module(rest, entry_path))

# The prelude as a ParsedModule, memoised like any other module. Without the memo it is
# re-parsed on every bundle, and it is the largest file in the tree — which is
# the single biggest cost an editor pays per keystroke.
fn prelude_module(stdlib_root: String, load_env: LoadEnv) -> (Maybe LoadIssue, Maybe ParsedModule) !{IO} =
  do
    let path = prelude_path(stdlib_root)
    match module_source(path, load_env) with
    | Err msg -> (Just(LoadIssue(path, no_pos(), `cannot read the prelude ${path}: ${msg}`)), Nothing)
    | Ok src ->
        match memoised_module(path, src, load_env) with
        | Just mod -> (Nothing, Just(mod))
        | Nothing -> parse_prelude(path, src, load_env)

fn parse_prelude(path: String, src: String, load_env: LoadEnv) -> (Maybe LoadIssue, Maybe ParsedModule) !{IO} =
  do
    let Ok tokens = lexer.tokenize_source(src)
      else Err (token.TokenizeError msg pos) -> (Just(LoadIssue(path, pos, `Lex error in prelude: ${msg}`)), Nothing)
    let Ok(ast.Program decls _) = parser.parse_program(tokens)
      else Err (parser.ParseError msg pos) -> (Just(LoadIssue(path, pos, `Parse error in prelude: ${msg}`)), Nothing)
    let surface = parser.scan_module_surface(tokens)
    let mod = ParsedModule("", path, Nil, parser.surface_exported(surface), parser.surface_ctor_types(surface), decls)
    memoise_module(path, src, mod, load_env)
    (Nothing, Just(mod))

# ---------------------------------------------------------------------------
# Symbol table building
# ---------------------------------------------------------------------------

fn build_all_symbols(modules: List ParsedModule) -> Dict ModuleSymbols =
  build_symbols_acc(modules, dict_empty())

fn build_symbols_acc(modules: List ParsedModule, acc: Dict ModuleSymbols) -> Dict ModuleSymbols =
  match modules with
  | Nil -> acc
  | Cons mod rest ->
      match mod with
      | ParsedModule mod_name path _ exported ctor_types decls ->
          build_symbols_acc(rest, dict_set(path, build_module_symbols(mod_name, exported, ctor_types, decls), acc))

fn build_module_symbols(mod_name: String, exported: List String, ctor_types: List String, decls: List ast.Decl) -> ModuleSymbols =
  build_symbols_from_decls(mod_name, exported, ctor_types, decls,
    ModuleSymbols(dict_empty(), dict_empty(), dict_empty(),
                  dict_empty(), dict_empty(), dict_empty(),
                  dict_empty(), dict_empty(), Nil))

fn build_symbols_from_decls(mod_name: String, exported: List String, ctor_types: List String, decls: List ast.Decl, acc: ModuleSymbols) -> ModuleSymbols =
  match decls with
  | Nil -> acc
  | Cons d rest ->
      build_symbols_from_decls(mod_name, exported, ctor_types, rest,
        add_decl_to_symbols(mod_name, exported, ctor_types, d, acc))

fn add_decl_to_symbols(mod_name: String, exported: List String, ctor_types: List String, decl: ast.Decl, acc: ModuleSymbols) -> ModuleSymbols =
  match decl with
  | ast.FnDecl _ _ _ _ _ _ _ _ ->
      add_scoped_values(mod_name, exported, decl, acc)
  | ast.LetDecl _ _ _ _ ->
      add_scoped_values(mod_name, exported, decl, acc)
  | ast.TypeDecl name _ ctors _ _ _ _ ->
      add_type_to_symbols(mod_name, name, ctors, exported, ctor_types, acc)
  | ast.RecordDecl name _ _ _ _ _ _ ->
      add_record_to_symbols(mod_name, name, str_list_member(name, exported),
        str_list_member(name, ctor_types), acc)
  | ast.ClassDecl name _ methods _ _ ->
      add_class_to_symbols(mod_name, name, methods, str_list_member(name, exported), acc)
  | ast.InstanceDecl _ _ _ _ _ -> acc
  # An alias declares a name for a type and nothing else — no constructor, so
  # nothing for `(..)` to govern.
  | ast.AliasDecl name _ _ _ ->
      add_type_name_to_symbols(mod_name, name, str_list_member(name, exported), acc)
  # WrapDecl: register the type AND the synthetic constructor (same name) so
  # callers can reference both Foo (as a type) and Foo(...) (as a constructor).
  | ast.WrapDecl name _ inner _ _ _ _ ->
      add_type_to_symbols(mod_name, name,
        [ast.TypeConstructor(name, [inner], Nil, Nil, Nil)],
        exported, ctor_types, acc)
  # An extern contributes no module symbol, and that is DERIVED rather than
  # asserted here: ast.decl_value_scopes classifies it ScopeGlobal, so
  # scope_names_module returns nothing to record. The env path excludes it from
  # program_module_value_names by the same call, which is what keeps the two front
  # ends from spelling an extern two different ways.
  #
  # The NAME is still recorded, in extern_names — listing an extern in an import
  # is how its module gets bundled, so the import checks must not read it as a
  # name the module does not have.
  | ast.ExternFnDecl name _ _ _ _ _ _ ->
      add_extern_name(name, add_scoped_values(mod_name, exported, decl, acc))

fn add_extern_name(name: String, acc: ModuleSymbols) -> ModuleSymbols =
  match acc with
  | ModuleSymbols vl tl cl ev et ec mn ce xs ->
      ModuleSymbols(vl, tl, cl, ev, et, ec, mn, ce, Cons(name, xs))

# Register every module-scoped value name a declaration introduces.
fn add_scoped_values(mod_name: String, exported: List String, decl: ast.Decl, acc: ModuleSymbols) -> ModuleSymbols =
  add_value_names(mod_name, exported, ast.scope_names_module(ast.decl_value_scopes(decl)), acc)

fn add_value_names(mod_name: String, exported: List String, names: List String, acc: ModuleSymbols) -> ModuleSymbols =
  match names with
  | Nil -> acc
  | Cons name rest ->
      add_value_names(mod_name, exported, rest,
        add_value_to_symbols(mod_name, name, str_list_member(name, exported), acc))

fn canonical_of(mod_name: String, name: String) -> String =
  source.qualified_name_str(qualified_name(source.ModuleName(mod_name), source.RawName(name)))

fn add_value_to_symbols(mod_name: String, name: String, is_exported: Bool, acc: ModuleSymbols) -> ModuleSymbols =
  bind_value(name, canonical_of(mod_name, name), is_exported, acc)

fn bind_value(name: String, canonical: String, is_exported: Bool, acc: ModuleSymbols) -> ModuleSymbols =
  match acc with
  | ModuleSymbols vl tl cl ev et ec mn ce xs ->
      ModuleSymbols(dict_set(name, canonical, vl), tl, cl,
                    if is_exported then dict_set(name, canonical, ev) else ev,
                    et, ec, mn, ce, xs)

# A record declares BOTH a type and a constructor under one name, the same shape
# `wrap` has. Registering the constructor in the value maps is what subjects
# `P(x = 1)` to `(..)`: an unmarked record binds it module-locally, so a foreign
# module's spelling resolves to nothing and fails through the ordinary
# unknown-name path, note and all.
fn add_record_to_symbols(mod_name: String, name: String, is_exported: Bool,
                         export_ctor: Bool, acc: ModuleSymbols) -> ModuleSymbols =
  add_record_ctor(mod_name, name, export_ctor,
    add_type_name_to_symbols(mod_name, name, is_exported, acc))

fn add_record_ctor(mod_name: String, name: String, export_ctor: Bool, acc: ModuleSymbols) -> ModuleSymbols =
  match acc with
  | ModuleSymbols vl tl cl ev et ec mn ce xs ->
      ModuleSymbols(dict_set(name, canonical, vl), tl, cl,
                    if export_ctor then dict_set(name, canonical, ev) else ev,
                    et, ec, mn,
                    # Keyed by TYPE name, holding the one constructor, so a
                    # selective `import M (P)` carries it exactly as it carries a
                    # sum's constructors — one rule, one code path.
                    if export_ctor then dict_set(name, dict_set(name, canonical, dict_empty()), ce) else ce,
                    xs)
  where canonical = canonical_of(mod_name, name)

fn add_type_name_to_symbols(mod_name: String, name: String, is_exported: Bool, acc: ModuleSymbols) -> ModuleSymbols =
  match acc with
  | ModuleSymbols vl tl cl ev et ec mn ce xs ->
      ModuleSymbols(vl, dict_set(name, canonical, tl), cl, ev,
                    if is_exported then dict_set(name, canonical, et) else et,
                    ec, mn, ce, xs)
  where canonical = canonical_of(mod_name, name)

# A method is exported exactly when its class is.
fn add_class_to_symbols(mod_name: String, name: String, methods: List ast.ClassMethodSig, is_exported: Bool, acc: ModuleSymbols) -> ModuleSymbols =
  match fold(bind_method(is_exported, _, _), acc, vec_to_list(dict_entries(method_map))) with
  | ModuleSymbols vl tl cl ev et ec cm ce xs ->
      ModuleSymbols(vl, tl, dict_set(name, canonical, cl), ev, et,
                    if is_exported then dict_set(name, canonical, ec) else ec,
                    dict_set(name, method_map, cm), ce, xs)
  where canonical = canonical_of(mod_name, name)
        method_map = fold(add_method_canonical(mod_name, _, _), dict_empty(), methods)

fn add_method_canonical(mod_name: String, acc: Dict String, method: ast.ClassMethodSig) -> Dict String =
  dict_set(name, canonical_of(mod_name, name), acc)
  where name = method_sig_name(method)

fn bind_method(is_exported: Bool, acc: ModuleSymbols, entry: (String, String)) -> ModuleSymbols =
  match entry with | (name, canonical) -> bind_value(name, canonical, is_exported, acc)

fn method_sig_name(m: ast.ClassMethodSig) -> String =
  match m with | ast.ClassMethodSig name _ _ _ _ _ -> name

fn add_type_to_symbols(mod_name: String, type_name: String, ctors: List ast.TypeConstructor, exported: List String, ctor_types: List String, acc: ModuleSymbols) -> ModuleSymbols =
  match acc with
  | ModuleSymbols vl tl cl ev et ec mn ce xs ->
      match add_ctors(mod_name, ctors, export_ctors, vl, ev, dict_empty()) with
      | (new_vl, new_ev, ctor_map) ->
          ModuleSymbols(new_vl,
                        dict_set(type_name, canonical, tl),
                        cl,
                        new_ev,
                        if is_type_exported then dict_set(type_name, canonical, et) else et,
                        ec, mn,
                        if export_ctors then dict_set(type_name, ctor_map, ce) else ce,
                        xs)
  where canonical = canonical_of(mod_name, type_name)
        is_type_exported = str_list_member(type_name, exported)
        export_ctors = str_list_member(type_name, ctor_types)

fn add_ctors(mod_name: String, ctors: List ast.TypeConstructor, export_ctors: Bool, vl: Dict String, ev: Dict String, ctor_map: Dict String) -> (Dict String, Dict String, Dict String) =
  match ctors with
  | Nil -> (vl, ev, ctor_map)
  | Cons ctor rest ->
      match ctor with
      | ast.TypeConstructor ctor_name _ _ _ _ ->
          let canonical = canonical_of(mod_name, ctor_name)
          in add_ctors(mod_name, rest, export_ctors,
            dict_set(ctor_name, canonical, vl),
            if export_ctors then dict_set(ctor_name, canonical, ev) else ev,
            if export_ctors then dict_set(ctor_name, canonical, ctor_map) else ctor_map)

# ---------------------------------------------------------------------------
# Resolution context from imports
# ---------------------------------------------------------------------------

fn build_resolve_ctx(mod: ParsedModule, all_symbols: Dict ModuleSymbols, stdlib_root: String,
                     extra_roots: List String, canonical: Dict String,
                     prelude: PreludeNames, externs: List PrivateExtern) -> ResolveCtx =
  match mod with
  | ParsedModule mod_name path specs _ _ _ ->
      match dict_get(path, all_symbols) with
      | Nothing -> empty_resolve_ctx()
      | Just own_syms ->
          apply_imports_to_ctx(specs, all_symbols, stdlib_root, extra_roots,
            empty_resolve_ctx() with (
              value_locals = sym_value_locals(own_syms),
              type_locals = sym_type_locals(own_syms),
              class_locals = sym_class_locals(own_syms),
              canonical_names = canonical,
              prelude = prelude_seen_from(path, stdlib_root, prelude),
              foreign = foreign_externs(own_externs_of(mod_name, sym_extern_names(own_syms)), externs)))

# One extern declaration. `in_prelude` is the prelude or the `no_prelude` floor, found by
# path, since a headerless `no_prelude` entry also has module ""; their externs are
# exported whatever they write. `written_export` is `export extern fn`. `writes_local` is
# decided on the signature as QUALIFIED, so a type name is canonical and finds its
# definition in the table whichever module declared it.
type ExternFact = (declarer: String, path: String, name: String, in_prelude: Bool,
                   written_export: Bool, writes_local: Bool, pos: source.SourcePos)

# Every extern declaration in the bundle. The contexts are built without private
# externs: those only rename value names, never type names.
fn extern_facts_of(modules: List ParsedModule, all_symbols: Dict ModuleSymbols,
                   stdlib_root: String, extra_roots: List String, canonical: Dict String,
                   prelude: PreludeNames) -> List ExternFact =
  list_flat_map(extern_facts_in_module(prelude_path(stdlib_root), _, defs, ctx_of), modules)
  where ctx_of = build_resolve_ctx(_, all_symbols, stdlib_root, extra_roots, canonical, prelude, Nil)
        defs = type_bodies(modules, ctx_of)

# The externs a module outside their declarers may not reach. Exportedness is decided
# per NAME across the build: a name is exported if any module declaring it writes
# `export extern fn` or is the prelude/floor, so one module's private redeclaration
# cannot hide another's exported extern. A name whose signature writes `local` is
# private whatever is written, because its `local` is a promise the compiler cannot
# check (spec-v0 §Externs). Few `local` ones, built once per bundle.
fn private_externs_of(facts: List ExternFact) -> List PrivateExtern =
  list_filter_map(private_extern_of(set_from_list(list_filter_map(local_name_of, facts)),
                                    set_from_list(list_filter_map(exported_name_of, facts)), _), facts)

fn local_name_of(f: ExternFact) -> Maybe String =
  if f.writes_local then Just(f.name) else Nothing

fn exported_name_of(f: ExternFact) -> Maybe String =
  if f.in_prelude || f.written_export then Just(f.name) else Nothing

fn private_extern_of(locals: Set, exported: Set, f: ExternFact) -> Maybe PrivateExtern =
  if set_member(f.name, locals) then Just(PrivateExtern(declarer = f.declarer, name = f.name, writes_local = true))
  else if set_member(f.name, exported) then Nothing
  else Just(PrivateExtern(declarer = f.declarer, name = f.name, writes_local = false))

# Declaration rule for `unsafe_pure` (docs/unsafe-primitives-v0.md §4.2, rule 2). Without it a
# module could declare its own copy, since an extern is known by its name alone. Checked
# before the `local` rule so that `export` on it reports its own message.
fn unsafe_pure_decl_error(facts: List ExternFact) -> Maybe (String, source.SourcePos, String) =
  find_map(unsafe_pure_decl_error_of, facts)

fn unsafe_pure_decl_error_of(f: ExternFact) -> Maybe (String, source.SourcePos, String) =
  if f.name != source.unsafe_pure_name then Nothing
  else if f.declarer != source.unsafe_pure_declarer then Just((f.path, f.pos, source.unsafe_pure_declaration_message))
  else if f.written_export then Just((f.path, f.pos, source.unsafe_pure_export_message))
  else Nothing

# `export` on an extern that writes `local` promises what the `local` rule withholds.
fn export_local_extern_error(facts: List ExternFact) -> Maybe (String, source.SourcePos, String) =
  find_map(export_local_error_of, facts)

fn export_local_error_of(f: ExternFact) -> Maybe (String, source.SourcePos, String) =
  if f.written_export && f.writes_local
  then Just((f.path, f.pos, source.export_local_extern_message(f.declarer, f.name)))
  else Nothing

# Canonical type name -> the qualified type expressions of its definition: an
# alias's right-hand side, every constructor field, every record field, or the
# wrapped type.
fn type_bodies(modules: List ParsedModule, ctx_of: ParsedModule -> ResolveCtx) -> Dict (List ast.TypeExpr) =
  fold(add_module_defs(ctx_of, _, _), dict_empty(), modules)

fn add_module_defs(ctx_of: ParsedModule -> ResolveCtx, acc: Dict (List ast.TypeExpr),
                   mod: ParsedModule) -> Dict (List ast.TypeExpr) =
  match mod with
  | ParsedModule _ _ _ _ _ decls ->
      if any(defines_type, decls) then fold(add_type_bodies(ctx_of(mod), _, _), acc, decls) else acc

fn defines_type(d: ast.Decl) -> Bool =
  match d with
  | ast.AliasDecl _ _ _ _ -> true
  | ast.TypeDecl _ _ _ _ _ _ _ -> true
  | ast.RecordDecl _ _ _ _ _ _ _ -> true
  | ast.WrapDecl _ _ _ _ _ _ _ -> true
  | ast.FnDecl _ _ _ _ _ _ _ _ -> false
  | ast.ExternFnDecl _ _ _ _ _ _ _ -> false
  | ast.LetDecl _ _ _ _ -> false
  | ast.ClassDecl _ _ _ _ _ -> false
  | ast.InstanceDecl _ _ _ _ _ -> false

fn add_type_bodies(ctx: ResolveCtx, acc: Dict (List ast.TypeExpr), d: ast.Decl) -> Dict (List ast.TypeExpr) =
  match d with
  | ast.AliasDecl name _ rhs _ -> add_type_body(ctx, name, [rhs], acc)
  | ast.TypeDecl name _ ctors _ _ _ _ -> add_type_body(ctx, name, list_flat_map(ctor_field_types, ctors), acc)
  | ast.RecordDecl name _ fields _ _ _ _ -> add_type_body(ctx, name, list_map(record_field_type, fields), acc)
  | ast.WrapDecl name _ inner _ _ _ _ -> add_type_body(ctx, name, [inner], acc)
  | ast.FnDecl _ _ _ _ _ _ _ _ -> acc
  | ast.ExternFnDecl _ _ _ _ _ _ _ -> acc
  | ast.LetDecl _ _ _ _ -> acc
  | ast.ClassDecl _ _ _ _ _ -> acc
  | ast.InstanceDecl _ _ _ _ _ -> acc

fn add_type_body(ctx: ResolveCtx, name: String, bodies: List ast.TypeExpr,
                 acc: Dict (List ast.TypeExpr)) -> Dict (List ast.TypeExpr) =
  dict_set(dict_get_or(name, ctx.type_locals, name), list_map(qualify_type_expr(ctx, _), bodies), acc)

fn ctor_field_types(c: ast.TypeConstructor) -> List ast.TypeExpr =
  match c with
  | ast.TypeConstructor _ fields _ _ _ -> fields

fn record_field_type(f: ast.RecordFieldDecl) -> ast.TypeExpr =
  match f with
  | ast.RecordFieldDecl _ te -> te

fn extern_facts_in_module(prelude_file: String, mod: ParsedModule, defs: Dict (List ast.TypeExpr),
                         ctx_of: ParsedModule -> ResolveCtx) -> List ExternFact =
  match mod with
  | ParsedModule mod_name path _ _ _ decls ->
      if any(is_extern_decl, decls)
      then list_filter_map(extern_fact_in(mod_name, path, path == prelude_file, ctx_of(mod), defs, _), decls)
      else Nil

fn is_extern_decl(d: ast.Decl) -> Bool =
  match d with
  | ast.ExternFnDecl _ _ _ _ _ _ _ -> true
  | _ -> false

fn extern_fact_in(mod_name: String, path: String, in_prelude: Bool, ctx: ResolveCtx,
                  defs: Dict (List ast.TypeExpr), d: ast.Decl) -> Maybe ExternFact =
  match d with
  | ast.ExternFnDecl name params ret _ _ visibility pos ->
      Just(ExternFact(declarer = mod_name, path = path, name = name, in_prelude = in_prelude,
                      written_export = is_exported_extern(visibility),
                      writes_local = any(param_writes_local(ctx, defs, _), params) || type_writes_local(ctx, defs, ret),
                      pos = pos))
  | _ -> Nothing

fn is_exported_extern(v: ast.Visibility) -> Bool =
  match v with
  | ast.Exported -> true
  | ast.Private -> false

fn param_writes_local(ctx: ResolveCtx, defs: Dict (List ast.TypeExpr), p: ast.Param) -> Bool =
  match p with
  | ast.Param _ te mode -> ast.mode_is_local(mode) || type_writes_local(ctx, defs, te)

fn type_writes_local(ctx: ResolveCtx, defs: Dict (List ast.TypeExpr), te: Maybe ast.TypeExpr) -> Bool =
  match te with
  | Nothing -> false
  | Just written -> reaches_local(defs, [qualify_type_expr(ctx, written)], set_empty())

# A worklist over every type expression the signature reaches. Each definition is
# expanded once, so a shared type costs one visit and a recursive one ends.
fn reaches_local(defs: Dict (List ast.TypeExpr), pending: List ast.TypeExpr, seen: Set) -> Bool =
  match pending with
  | Nil -> false
  | Cons te rest ->
      match te with
      | ast.TypeName name ->
          if set_member(name, seen) then reaches_local(defs, rest, seen)
          else reaches_local(defs, list_append(def_bodies(name, defs), rest), set_insert(name, seen))
      | ast.TypeArrow p r _ mode ->
          ast.mode_is_local(mode) || reaches_local(defs, Cons(p, Cons(r, rest)), seen)
      | ast.TypeApply f x -> reaches_local(defs, Cons(f, Cons(x, rest)), seen)
      | ast.TupleType parts -> reaches_local(defs, list_append(parts, rest), seen)
      | ast.TypeEffect inner _ -> reaches_local(defs, Cons(inner, rest), seen)
      | ast.TypeThunk r _ -> reaches_local(defs, Cons(r, rest), seen)

# A type parameter or a builtin type has no definition to expand.
fn def_bodies(name: String, defs: Dict (List ast.TypeExpr)) -> List ast.TypeExpr =
  match dict_get(name, defs) with
  | Just bodies -> bodies
  | Nothing -> Nil

# The externs `mod_name` may reach as its own: those it declares, plus `unsafe_pure` when it
# is on `source.unsafe_pure_users` (docs/unsafe-primitives-v0.md §4.2, rule 1).
fn own_externs_of(mod_name: String, declared: List String) -> List String =
  if str_list_member(mod_name, source.unsafe_pure_users) then Cons(source.unsafe_pure_name, declared)
  else declared

# The private externs a module may NOT reach, by name. `own` is every extern the module
# declares itself. Two declarations of a name must agree (infer.extern_decl_ok), so
# declaring it is the module's own claim about it. When several modules declare a name, the
# first declarer is the one an error names.
fn foreign_externs(own: List String, externs: List PrivateExtern) -> Dict PrivateExtern =
  fold(add_foreign_extern(own, _, _), dict_empty(), externs)

fn add_foreign_extern(own: List String, acc: Dict PrivateExtern, entry: PrivateExtern) -> Dict PrivateExtern =
  if str_list_member(entry.name, own) || dict_member(entry.name, acc) then acc
  else dict_set(entry.name, entry, acc)

# Found by path, as `prelude_type_names` does. Empty when the bundle has no
# prelude; under `no_prelude` it is the floor.
fn prelude_names(modules: List ParsedModule, all_symbols: Dict ModuleSymbols, stdlib_root: String) -> PreludeNames =
  match dict_get(prelude_path(stdlib_root), all_symbols) with
  | Nothing -> no_prelude_names()
  | Just syms ->
      PreludeNames(values = sym_value_locals(syms),
                   bare = fold(\ (acc, m) -> dict_set(m, m, acc), dict_empty(), sym_extern_names(syms)),
                   types = sym_type_locals(syms), classes = sym_class_locals(syms),
                   unexported = unexported_fns_and_lets(prelude, sym_exported_vals(syms)))
  where prelude = find(\m -> parsed_path(m) == prelude_path(stdlib_root), modules)

fn no_prelude_names() -> PreludeNames =
  PreludeNames(values = dict_empty(), bare = dict_empty(), types = dict_empty(), classes = dict_empty(),
               unexported = set_empty())

# The module at `path` sees its own unexported names; every other module does not.
fn prelude_seen_from(path: String, stdlib_root: String, names: PreludeNames) -> PreludeNames =
  if path == prelude_path(stdlib_root) then names with (unexported = set_empty()) else names

# Types, constructors, classes and externs are not in the set: the prelude has no
# unexported type or class, a constructor is in scope without `(..)`, and an extern is
# outside the module system (spec-v0 §3.1).
fn unexported_fns_and_lets(prelude: Maybe ParsedModule, public: Dict String) -> Set =
  match prelude with
  | Nothing -> set_empty()
  | Just (ParsedModule _ _ _ _ _ decls) ->
      decls
      |> list_flat_map(fn_or_let_name)
      |> list_filter(\n -> !dict_member(n, public))
      |> set_from_list

# Every variant is listed, so a new declaration kind has to decide whether it can be private.
fn fn_or_let_name(d: ast.Decl) -> List String =
  match d with
  | ast.FnDecl name _ _ _ _ _ _ _ -> [name]
  | ast.LetDecl name _ _ _ -> [name]
  | ast.ExternFnDecl _ _ _ _ _ _ _ -> []
  | ast.TypeDecl _ _ _ _ _ _ _ -> []
  | ast.RecordDecl _ _ _ _ _ _ _ -> []
  | ast.ClassDecl _ _ _ _ _ -> []
  | ast.InstanceDecl _ _ _ _ _ -> []
  | ast.AliasDecl _ _ _ _ -> []
  | ast.WrapDecl _ _ _ _ _ _ _ -> []

fn prelude_value(names: PreludeNames, name: String) -> Maybe String =
  maybe_or_else(dict_get(name, names.values), dict_get(name, names.bare))

fn prelude_type(names: PreludeNames, name: String) -> Maybe String =
  maybe_or_else(dict_get(name, names.types), dict_get(name, names.classes))

# Every `<module>.<name>` the bundle declares, keyed for lookup. Built once per
# bundle and handed to every module's ResolveCtx: a name that is in here and that
# module-alias resolution declined is a canonical name someone typed, which is the
# only way it could have been produced (spec-v0 §3).
#
# Deliberately drawn from the `*_locals` tables, not the `exported_*` ones. A
# PRIVATE name is exactly the one this rule has to catch.
fn all_canonical_names(all_symbols: Dict ModuleSymbols) -> Dict String =
  vec_fold(add_module_canonical, dict_empty(), dict_values(all_symbols))

fn add_module_canonical(acc: Dict String, syms: ModuleSymbols) -> Dict String =
  add_canonical(sym_class_locals(syms),
    add_canonical(sym_type_locals(syms),
      add_canonical(sym_value_locals(syms), acc)))

# The VALUES of a locals table are the canonical names; the keys are the bare
# ones. Undotted values are skipped — a headerless module's names are canonical
# AND bare, and marking those would take every ordinary reference with them.
fn add_canonical(src: Dict String, acc: Dict String) -> Dict String =
  vec_fold(add_canonical_name, acc, dict_values(src))

fn add_canonical_name(acc: Dict String, canonical: String) -> Dict String =
  if str_find(canonical, ".") == -1 then acc else dict_set(canonical, "", acc)

fn apply_imports_to_ctx(specs: List module_loader.ImportSpec, all_symbols: Dict ModuleSymbols, stdlib_root: String, extra_roots: List String, ctx: ResolveCtx) -> ResolveCtx =
  match specs with
  | Nil -> ctx
  | Cons spec rest ->
      apply_imports_to_ctx(rest, all_symbols, stdlib_root, extra_roots,
        apply_one_import(spec, all_symbols, stdlib_root, extra_roots, ctx))

fn apply_one_import(spec: module_loader.ImportSpec, all_symbols: Dict ModuleSymbols, stdlib_root: String, extra_roots: List String, ctx: ResolveCtx) -> ResolveCtx =
  let Just symbols = spec_symbols(spec, all_symbols, stdlib_root, extra_roots) else ctx
  in match spec with
     | module_loader.ImportAlias _ alias _ ->
         ctx_with_alias_type(
           ctx_with_alias_val(ctx, alias, sym_exported_vals(symbols)),
           alias, merge_type_exports(symbols))
     | module_loader.ImportSelective _ names _ -> apply_selective_names(names, symbols, ctx)

fn merge_type_exports(symbols: ModuleSymbols) -> Dict String =
  sym_exported_types(symbols) ++ sym_exported_cls(symbols)

fn apply_selective_names(names: List String, symbols: ModuleSymbols, ctx: ResolveCtx) -> ResolveCtx =
  match names with
  | Nil -> ctx
  | Cons name rest ->
      apply_selective_names(rest, symbols, apply_selective_name(name, symbols, ctx))

fn apply_selective_name(name: String, symbols: ModuleSymbols, ctx: ResolveCtx) -> ResolveCtx =
  apply_import_bindings(selective_name_bindings(name, symbols), ctx)

# Every binding one selective import name contributes. Single source of truth:
# resolution applies exactly this list and the import diagnostics below check it,
# so the two cannot drift about what a name means.
fn selective_name_bindings(name: String, symbols: ModuleSymbols) -> List ImportBinding =
  list_append(value_binding(name, symbols),
    list_append(type_bindings(name, symbols), class_binding(name, symbols)))

fn value_binding(name: String, symbols: ModuleSymbols) -> List ImportBinding =
  match dict_get(name, sym_exported_vals(symbols)) with
  | Nothing -> Nil
  | Just canonical -> [ImportBinding (NsValue, name, canonical)]

# A type import carries its constructors when the type was exported `(..)`, which
# is why a name that appears in no import list can still collide.
fn type_bindings(name: String, symbols: ModuleSymbols) -> List ImportBinding =
  match dict_get(name, sym_exported_types(symbols)) with
  | Nothing -> Nil
  | Just canonical ->
      Cons(ImportBinding (NsType, name, canonical),
        match dict_get(name, sym_ctor_exports(symbols)) with
        | Nothing -> Nil
        | Just ctor_map -> vec_to_list(vec_map(value_entry_binding, dict_entries(ctor_map))))

fn value_entry_binding(entry: (String, String)) -> ImportBinding =
  match entry with
  | (name, canonical) -> ImportBinding(NsValue, name, canonical)

# A class import binds its methods, as a type import binds its constructors.
fn class_binding(name: String, symbols: ModuleSymbols) -> List ImportBinding =
  match dict_get(name, sym_exported_cls(symbols)) with
  | Nothing -> Nil
  | Just canonical ->
      Cons(ImportBinding (NsClass, name, canonical),
        match dict_get(name, sym_class_methods(symbols)) with
        | Nothing -> Nil
        | Just methods -> vec_to_list(vec_map(value_entry_binding, dict_entries(methods))))

fn apply_import_bindings(bindings: List ImportBinding, ctx: ResolveCtx) -> ResolveCtx =
  match bindings with
  | Nil -> ctx
  | Cons b rest -> apply_import_bindings(rest, apply_import_binding(b, ctx))

# NsPrefix never reaches here: a whole-module import binds an alias map rather
# than a name, and apply_one_import applies that itself.
fn apply_import_binding(b: ImportBinding, ctx: ResolveCtx) -> ResolveCtx =
  match b with
  | ImportBinding NsValue name target -> ctx_with_unqual_value(ctx, name, target)
  | ImportBinding NsType name target -> ctx_with_unqual_type(ctx, name, target)
  | ImportBinding NsClass name target -> ctx_with_unqual_class(ctx, name, target)
  | ImportBinding NsPrefix _ _ -> ctx

# ---------------------------------------------------------------------------
# Import diagnostics
# ---------------------------------------------------------------------------
#
# Applying an import is a fold that can only return a context, so neither of the
# two ways an import goes wrong could be reported from inside it, and both were
# silent:
#
#   1. A name the module does not export bound nothing. The import line survived
#      every rename of the thing it named, and the file kept compiling because
#      some other import happened to supply the name.
#   2. Two imports binding one unqualified name kept the last. Which symbol a
#      bare name meant depended on import ORDER, and the only symptom was a type
#      error elsewhere naming neither import.
#
# Both are checked here instead, over the bindings resolution actually makes, so
# a name that arrives through `(..)` on a type import is covered like any other.

fn spec_symbols(spec: module_loader.ImportSpec, all_symbols: Dict ModuleSymbols,
                stdlib_root: String, extra_roots: List String) -> Maybe ModuleSymbols =
  match spec_to_path(spec, stdlib_root, extra_roots) with
  | Nothing -> Nothing
  | Just mod_path -> dict_get(mod_path, all_symbols)

fn spec_bindings(spec: module_loader.ImportSpec, all_symbols: Dict ModuleSymbols,
                 stdlib_root: String, extra_roots: List String) -> List ImportBinding =
  # An unresolvable module contributes nothing: collect_modules has already
  # reported it, and a second message about the same line would only distract.
  match spec_symbols(spec, all_symbols, stdlib_root, extra_roots) with
  | Nothing -> Nil
  | Just symbols ->
      match spec with
      | module_loader.ImportAlias mod_name alias _ -> [ImportBinding (NsPrefix, alias, mod_name)]
      | module_loader.ImportSelective _ names _ -> selective_names_bindings(names, symbols)

fn selective_names_bindings(names: List String, symbols: ModuleSymbols) -> List ImportBinding =
  match names with
  | Nil -> Nil
  | Cons name rest ->
      list_append(selective_name_bindings(name, symbols), selective_names_bindings(rest, symbols))

# Each binding with the position of the import that makes it.
fn all_import_bindings(specs: List module_loader.ImportSpec, all_symbols: Dict ModuleSymbols,
                       stdlib_root: String, extra_roots: List String) -> List(source.SourcePos, ImportBinding) =
  list_flat_map(\spec -> placed_bindings(spec, all_symbols, stdlib_root, extra_roots), specs)

fn placed_bindings(spec: module_loader.ImportSpec, all_symbols: Dict ModuleSymbols,
                   stdlib_root: String, extra_roots: List String) -> List(source.SourcePos, ImportBinding) =
  [(module_loader.import_pos(spec), b) for b in spec_bindings(spec, all_symbols, stdlib_root, extra_roots)]

# The first (namespace, name) bound to two DIFFERENT symbols, with the symbol it
# was already bound to. The same symbol twice is legal — importing one name by
# two routes leaves nothing ambiguous.
fn first_import_conflict(bindings: List (source.SourcePos, ImportBinding), seen: Dict String) -> Maybe(source.SourcePos, ImportBinding, String) =
  match bindings with
  | Nil -> Nothing
  | Cons (pos, b) rest ->
      match dict_get(binding_key(b), seen) with
      | Just previous ->
          if previous == binding_target(b) then first_import_conflict(rest, seen)
          else Just((pos, b, previous))
      | Nothing ->
          first_import_conflict(rest, dict_set(binding_key(b), binding_target(b), seen))

fn binding_key(b: ImportBinding) -> String =
  match b with | ImportBinding ns name _ -> ns_tag(ns) ++ " " ++ name

fn binding_target(b: ImportBinding) -> String =
  match b with | ImportBinding _ _ target -> target

fn ns_tag(ns: ImportNs) -> String =
  match ns with
  | NsValue -> "value"
  | NsType -> "type"
  | NsClass -> "class"
  | NsPrefix -> "prefix"

# One kind of name binds nothing yet is legitimate to import, and would otherwise
# read as unknown: an EXTERN, which is global once its module is bundled — listing
# it is what bundles the module.
#
# The exemption is FORCED, not a leniency. An extern "never enters a
# module's exported set" (spec-v0 §"Externs are outside the module system"), and
# `export` on one is a parsed-and-discarded no-op (parser.sprout:2227), so
# "declared but not exported" is not a state an extern can be in. Rejecting one
# would reach a message telling the reader to add `export`, which the parser then
# discards — advice that cannot clear the diagnostic.
#
# extern_names holds this module's OWN extern declarations only, unlike
# module_loader.sprout:305-308, where globals are marker-selected and a module
# passes on the externs that reached it transitively. A name from an imported
# module's imports is still unknown here.
fn import_name_binds(name: String, symbols: ModuleSymbols) -> Bool =
  match selective_name_bindings(name, symbols) with
  | Nil -> str_list_member(name, sym_extern_names(symbols))
  | [_ | _] -> true

fn module_declares_name(name: String, symbols: ModuleSymbols) -> Bool =
  dict_member(name, sym_value_locals(symbols))
    || dict_member(name, sym_type_locals(symbols))
    || dict_member(name, sym_class_locals(symbols))

fn first_unbound_name(names: List String, symbols: ModuleSymbols) -> Maybe String =
  find(\name -> !import_name_binds(name, symbols), names)

# A name carrying a parenthesised group reaches here because the import scanner
# keeps the group rather than letting its `)` end the list
# (module_loader.sprout:52). It can never be exported — no declaration is spelled
# with one — so without this branch it would be reported as a missing export, and
# the reader would go looking in the wrong file for a name they did not write.
#
# Worded for any group, not just `(..)`: `T(C1)` is the PureScript spelling and
# the same reflex, and both fixes are the same word.
fn malformed_import_message(path: String, mod_name: String, name: String) -> String =
  `${path}: import ${mod_name} (${name}): a selective import lists bare names — \`(..)\` is not import syntax, it goes on the type's declaration in \`${mod_name}\`. Write \`${bare}\`; naming a type imports its constructors.`
  where bare = str_slice(name, 0, str_find(name, "("))

# Declared-but-unexported is worth its own wording: the fix is in the OTHER file,
# and "exports no such name" would send the reader looking for a typo instead.
fn unknown_import_message(path: String, mod_name: String, name: String, symbols: ModuleSymbols) -> String =
  if str_find(name, "(") != -1 then malformed_import_message(path, mod_name, name)
  else
    match method_class(name, symbols) with
    | Just class_name ->
        `${path}: import ${mod_name} (${name}): \`${name}\` is a method of class \`${class_name}\`, which is not exported — a method is exported with its class, so add \`export\` to \`class ${class_name}\` in \`${mod_name}\`.`
    | Nothing -> unexported_name_message(path, mod_name, name, symbols)

# The class in `symbols` that declares method `name`, if any.
fn method_class(name: String, symbols: ModuleSymbols) -> Maybe String =
  let Just(class_name, _) = find(declares_method(name, _), vec_to_list(dict_entries(sym_class_methods(symbols)))) else Nothing
  in Just(class_name)

fn declares_method(name: String, entry: (String, Dict String)) -> Bool =
  match entry with | (_, methods) -> dict_member(name, methods)

fn unexported_name_message(path: String, mod_name: String, name: String, symbols: ModuleSymbols) -> String =
  if module_declares_name(name, symbols) then
    `${path}: import ${mod_name} (${name}): \`${name}\` is declared in module \`${mod_name}\` but not exported — add \`export\` to its declaration, or \`(..)\` to its type's export if it is a constructor.`
  else
    `${path}: import ${mod_name} (${name}): module \`${mod_name}\` exports no \`${name}\`.`

fn conflict_message(path: String, b: ImportBinding, previous: String) -> String =
  match b with
  | ImportBinding NsPrefix alias mod_name ->
      `${path}: import ${mod_name}: the module prefix \`${alias}\` is already bound to \`${previous}\` in this file — import one of them under another name (\`import ${mod_name} as <alias>\`).`
  | ImportBinding _ name target ->
      `${path}: \`${name}\` is imported twice in this file, from two different symbols (\`${previous}\` and \`${target}\`) — a bare \`${name}\` would silently mean the last one. Import at most one, or import the modules whole and qualify.`

# Nothing for a whole-module import (it lists no names) and for a module that did
# not resolve, so the three guards read as one "or this spec has nothing to say".
fn unknown_name_in_spec(spec: module_loader.ImportSpec, all_symbols: Dict ModuleSymbols,
                        stdlib_root: String, extra_roots: List String, path: String) -> Maybe LoadIssue =
  let module_loader.ImportSelective mod_name names pos = spec else Nothing
      Just symbols = spec_symbols(spec, all_symbols, stdlib_root, extra_roots) else Nothing
      Just name = first_unbound_name(names, symbols) else Nothing
  in Just(LoadIssue(path, pos, unknown_import_message(path, mod_name, name, symbols)))

fn first_unknown_import(specs: List module_loader.ImportSpec, all_symbols: Dict ModuleSymbols,
                        stdlib_root: String, extra_roots: List String, path: String) -> Maybe LoadIssue =
  find_map(\spec -> unknown_name_in_spec(spec, all_symbols, stdlib_root, extra_roots, path), specs)

fn module_import_error(mod: ParsedModule, all_symbols: Dict ModuleSymbols,
                       stdlib_root: String, extra_roots: List String) -> Maybe LoadIssue =
  match mod with
  | ParsedModule _ path specs _ _ _ ->
      match first_unknown_import(specs, all_symbols, stdlib_root, extra_roots, path) with
      | Just issue -> Just(issue)
      | Nothing ->
          match first_import_conflict(
                  all_import_bindings(specs, all_symbols, stdlib_root, extra_roots),
                  dict_empty()) with
          | Nothing -> Nothing
          | Just (pos, b, previous) -> Just(LoadIssue(path, pos, conflict_message(path, b, previous)))

fn validate_imports(modules: List ParsedModule, all_symbols: Dict ModuleSymbols,
                    stdlib_root: String, extra_roots: List String) -> Maybe LoadIssue =
  find_map(\mod -> module_import_error(mod, all_symbols, stdlib_root, extra_roots), modules)

# ---------------------------------------------------------------------------
# AST qualification
# ---------------------------------------------------------------------------

fn qualify_params(ctx: ResolveCtx, params: List ast.Param) -> List ast.Param =
  match params with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      # Qualification rewrites the type, and the name only through `local_name`.
      # `mode` must be carried through, or `borrowing`/`consuming` would be silently
      # dropped for every bundled module (the compiler self-compiles through this path).
      | ast.Param name Nothing mode -> Cons(ast.Param(local_name(ctx, name), Nothing, mode), qualify_params(ctx, rest))
      | ast.Param name (Just t) mode ->
          Cons(ast.Param(local_name(ctx, name), Just(qualify_type_expr(ctx, t)), mode), qualify_params(ctx, rest))

# A declaration with no body (a class method signature, an extern) has no use a
# compiler-written name could capture, so its parameter names stay as written;
# they reach `--emit-iface` and signature listings.
fn qualify_param_types(ctx: ResolveCtx, params: List ast.Param) -> List ast.Param =
  match params with
  | [] -> []
  | [ast.Param name t mode | rest] ->
      Cons(ast.Param(name, map(\te -> qualify_type_expr(ctx, te), t), mode),
           qualify_param_types(ctx, rest))

fn qualify_constraints(ctx: ResolveCtx, cs: List ast.TypeConstraint) -> List ast.TypeConstraint =
  match cs with
  | Nil -> Nil
  | Cons c rest ->
      match c with
      | ast.TypeConstraint class_name args ->
          Cons(ast.TypeConstraint(qualify_type_name(ctx, class_name), qualify_type_list(ctx, args)),
               qualify_constraints(ctx, rest))

fn qualify_type_list(ctx: ResolveCtx, ts: List ast.TypeExpr) -> List ast.TypeExpr =
  match ts with
  | Nil -> Nil
  | Cons t rest -> Cons(qualify_type_expr(ctx, t), qualify_type_list(ctx, rest))

fn qualify_type_expr(ctx: ResolveCtx, t: ast.TypeExpr) -> ast.TypeExpr =
  match t with
  | ast.TypeName name -> ast.TypeName(qualify_type_name(ctx, name))
  | ast.TypeApply base arg -> ast.TypeApply(qualify_type_expr(ctx, base), qualify_type_expr(ctx, arg))
  | ast.TypeArrow left right effects mode -> ast.TypeArrow(qualify_type_expr(ctx, left), qualify_type_expr(ctx, right), effects, mode)
  | ast.TypeThunk right effects -> ast.TypeThunk(qualify_type_expr(ctx, right), effects)
  | ast.TypeEffect base effects -> ast.TypeEffect(qualify_type_expr(ctx, base), effects)
  | ast.TupleType items -> ast.TupleType(qualify_type_list(ctx, items))

fn qualify_type_name(ctx: ResolveCtx, name: String) -> String =
  match string.split_once(name, ".") with
  | Nothing -> bare_type_name(ctx, name)
  | Just (head, symbol) ->
      match alias_export(head, symbol, ctx.alias_type_exports) with
      | Just canonical -> canonical
      | Nothing ->
          match prelude_qualified(ctx, head, symbol, \s -> prelude_type(ctx.prelude, s)) with
          | Just canonical -> canonical
          | Nothing -> guard_canonical(ctx, name)

fn bare_type_name(ctx: ResolveCtx, name: String) -> String =
  match dict_get(name, ctx.type_locals) with
  | Just canonical -> canonical
  | Nothing ->
      match dict_get(name, ctx.class_locals) with
      | Just canonical -> canonical
      | Nothing ->
          match dict_get(name, ctx.unqual_types) with
          | Just canonical -> canonical
          | Nothing ->
              match dict_get(name, ctx.unqual_classes) with
              | Just canonical -> canonical
              | Nothing -> name

# `alias.symbol` through an import alias's export table. `Nothing` means module-alias
# resolution DECLINED, which a String return could not express: a single-segment
# module makes `demo.sealed` resolve to itself, and "unchanged" then reads as
# "declined". guard_canonical turns that confusion into a rejected program, so the
# two must stay distinguishable.
fn alias_export(alias: String, symbol: String, aliases: Dict (Dict String)) -> Maybe String =
  match dict_get(alias, aliases) with
  | Nothing -> Nothing
  | Just exports -> dict_get(symbol, exports)

# DOTTED-NAME CASCADE — do not reorder, and do not drop a step, without checking
# all six readings a dotted name has. Only the last is an error. A and C rename
# through `local_name` like any local. The name is split at its first dot once,
# and B to F read the `head` and `rest` halves:
#   A. A binder named by the WHOLE dotted name — the `scope` test below. Rare;
#      a name with a dot in it is not writable as a binder, but lambdas and
#      `do` binds thread names in verbatim.
#   B. A field chain whose HEAD is a module-level value (`origin.x`) — in an
#      expression only, by `qualify_var` once C to E decline. After E is safe:
#      such a value named `prelude` makes E decline.
#   C. A field chain whose HEAD is a LOCAL binder — the `head` test in
#      `claim_dotted_value`. Spec §field-access is normative: "a local binding
#      wins over a same-named module in head position." It must precede D, or an
#      import alias sharing a parameter's name answers `origin.x` with the
#      module's export and the program reads a different value, compiling clean.
#   D. An alias-qualified import (`sealed.unseal`) — `alias_export`.
#   E. `prelude.X` — `prelude_qualified`. After D, so an alias named `prelude`
#      wins; before F, which would mark it as a typed canonical name.
#   F. Anything left: a typo, or a hand-written canonical name.
#      `guard_canonical` separates the last from the rest and must run here,
#      after D has declined — running it earlier would reject `sealed.unseal`,
#      whose canonical form is in the same table.
fn qualify_value_name(ctx: ResolveCtx, scope: List String, name: String) -> String =
  match claim_value_name(ctx, scope, name) with
  | Claimed resolved -> resolved
  | Unclaimed _ -> guard_canonical(ctx, name)

# `qualify_value_name` for an expression, which also has reading B.
#
# B's rule (docs/records-v0.md §4.3) lives in `infer.infer_var_or_field`, but by then
# the head is in scope only under its canonical name, so infer's lookup misses and
# `origin.x` fails as an unknown variable. Locals stay with infer: C took them.
fn qualify_var(ctx: ResolveCtx, scope: List String, name: String, pos: source.SourcePos) -> ast.Expr =
  match claim_value_name(ctx, scope, name) with
  | Claimed resolved -> ast.VarExpr(resolved, pos)
  | Unclaimed (head, rest) ->
      match module_level_value(ctx, head) with
      | Just canonical -> ast.build_field_chain(ast.VarExpr(canonical, pos), rest, pos)
      | Nothing ->
          # A private prelude head is reported as private, not as a bad field on it.
          if set_member(head, ctx.prelude.unexported) then
            ast.build_field_chain(ast.VarExpr(source.mark_prelude_private(head), pos), rest, pos)
          else ast.VarExpr(guard_canonical(ctx, name), pos)

# What readings A and C to E make of a value name. `Unclaimed` is a dotted name
# none of them took, as its split at the first dot. One field per constructor, so
# a call matched in place takes the unboxed worker.
type ValueName =
  | Claimed String
  | Unclaimed (String, String)

fn claim_value_name(ctx: ResolveCtx, scope: List String, name: String) -> ValueName =
  if str_list_member(name, scope) then Claimed(local_name(ctx, name))
  else
    match string.split_once(name, ".") with
    | Nothing -> Claimed(bare_value_name(ctx, name))
    | Just split -> claim_dotted_value(ctx, scope, split)

# C to E of the cascade above.
fn claim_dotted_value(ctx: ResolveCtx, scope: List String, split: (String, String)) -> ValueName =
  match split with
  | (head, rest) ->
      if str_list_member(head, scope) then Claimed(local_name(ctx, head) ++ "." ++ rest)
      else
        match alias_export(head, rest, ctx.alias_val_exports) with
        | Just canonical -> Claimed(canonical)
        | Nothing ->
            match prelude_qualified(ctx, head, rest, \s -> prelude_value(ctx.prelude, s)) with
            | Just canonical -> Claimed(guard_prelude_value(ctx, canonical))
            | Nothing -> Unclaimed(split)

fn bare_value_name(ctx: ResolveCtx, name: String) -> String =
  match dict_get(name, ctx.value_locals) with
  | Just canonical -> canonical
  | Nothing ->
      match dict_get(name, ctx.unqual_values) with
      | Just canonical -> canonical
      | Nothing -> guard_prelude_value(ctx, name)

# A name that is neither the module's own nor imported is the prelude's, or an extern.
#
# An unexported prelude `fn` or `let` is private to the prelude. The rule binds
# source text only: every name the compiler writes after bundling (deriving's
# `eq`/`to_string`/`compare`, desugarings) is exported. Marked for the reason
# `guard_canonical` marks.
fn guard_prelude_value(ctx: ResolveCtx, name: String) -> String =
  if set_member(name, ctx.prelude.unexported) then source.mark_prelude_private(name)
  else guard_private_extern(ctx, name)

# `prelude.X` is the prelude's `X`, after a local, an import alias or a top-level
# value named `prelude` has declined it (docs/prelude-name-identity-v0.md §5). `Nothing` for an `X` the
# prelude lacks, so the name stays unresolved and inference reports it.
fn prelude_qualified(ctx: ResolveCtx, head: String, symbol: String, declared: String -> Maybe String) -> Maybe String =
  if head != ast.prelude_qualifier || claims_prelude_head(ctx, head) then Nothing
  else declared(symbol)

# An import alias or a top-level value named `prelude` takes the head in every
# position, so `prelude.X` means one thing in an expression, a pattern and a type.
# A local named `prelude` never gets here: the scope test before it takes the head.
fn claims_prelude_head(ctx: ResolveCtx, name: String) -> Bool =
  match (dict_get(name, ctx.alias_val_exports), dict_get(name, ctx.alias_type_exports),
         module_level_value(ctx, name)) with
  | (Nothing, Nothing, Nothing) -> false
  | _ -> true

# A local that shares a prelude value's name is renamed at its binder and at every
# use, so no name the compiler writes after bundling can reach it. A pure function
# of the name, so nested shadowing keeps its shape (§5.1 of the same doc).
fn local_name(ctx: ResolveCtx, name: String) -> String =
  match prelude_value(ctx.prelude, name) with
  | Nothing -> name
  | Just _ -> source.local_rename_prefix ++ name

# A dotted name no import claims is normally a field chain (`o.inner.n`) or a
# genuine typo, and is left alone for inference to read. One shape is neither: a
# `<module>.<name>` someone typed. The bundler flattens modules into one namespace
# under exactly those names, so before this guard such a name resolved straight to
# the binding — exported or not — and `export` and `(..)` were advisory.
#
# Marked rather than reported here: `qualify_value_name` returns a String and has
# no error channel, and the marked name cannot resolve (nothing declares one), so
# the existing unknown-name paths raise it with the position they already have.
# `infer.unresolved_name_message` and `unresolved_type_message` render it.
# The caller has already tested the head against the enclosing binders: for
# `demo.dup_one.x` the binder is `demo`, and without that test a parameter named
# after a module turns a correct chain into a rejected program. A type name's head
# is never a local.
fn guard_canonical(ctx: ResolveCtx, name: String) -> String =
  match dict_get(name, ctx.canonical_names) with
  | Nothing -> name
  | Just _ -> source.canonical_marker ++ name

# An extern no declaring module exports, or that writes `local`, is reachable only from
# a module that declares it (spec-v0 §Externs). `foreign_externs` holds the ones declared
# ELSEWHERE, so an own-module reference stays bare. Marked for the reason
# `guard_canonical` marks.
#
# The `unsafe_pure` exemption is decided per module, in `own_externs_of`.
fn guard_private_extern(ctx: ResolveCtx, name: String) -> String =
  match dict_get(name, ctx.foreign) with
  | Nothing -> name
  | Just entry -> source.mark_private_extern(entry.declarer, name, entry.writes_local)

# The head's canonical name: this module's own top-level values first, then names
# imported unqualified.  Same two dictionaries `bare_value_name` consults, in
# the same order, so a head resolves here exactly when the bare name would.
fn module_level_value(ctx: ResolveCtx, head: String) -> Maybe String =
  match dict_get(head, ctx.value_locals) with
  | Just canonical -> Just(canonical)
  | Nothing -> dict_get(head, ctx.unqual_values)

# `scope` is the enclosing binders, so a constructor name whose head is a local
# (`prelude.Nil` beside a parameter `prelude`) reads as that local, as in an
# expression, and is then rejected as no constructor.
fn qualify_pattern(ctx: ResolveCtx, scope: List String, p: ast.Pattern) -> ast.Pattern =
  match p with
  | ast.ConstructorPattern name args pos ->
      ast.ConstructorPattern(qualify_value_name(ctx, scope, name),
                             qualify_pattern_list(ctx, scope, args), pos)
  | ast.TuplePattern items pos ->
      ast.TuplePattern(qualify_pattern_list(ctx, scope, items), pos)
  # Every binder goes through `local_name`, so a new binding pattern must be listed.
  | ast.VarPattern name pos -> ast.VarPattern(local_name(ctx, name), pos)
  | ast.WildcardPattern _ -> p
  | ast.IntPattern _ _ -> p
  | ast.BoolPattern _ _ -> p
  | ast.StringPattern _ _ -> p
  | ast.CharPattern _ _ -> p
  | ast.UnitPattern _ -> p

fn qualify_pattern_list(ctx: ResolveCtx, scope: List String, ps: List ast.Pattern) -> List ast.Pattern =
  match ps with
  | Nil -> Nil
  | Cons p rest -> Cons(qualify_pattern(ctx, scope, p), qualify_pattern_list(ctx, scope, rest))

fn qualify_record_fields(ctx: ResolveCtx, scope: List String, fields: List ast.RecordField) -> List ast.RecordField =
  match fields with
  | Nil -> Nil
  | Cons f rest ->
      match f with
      | ast.RecordField fname expr ->
          Cons(ast.RecordField(fname, qualify_expr(ctx, scope, expr)),
               qualify_record_fields(ctx, scope, rest))

fn qualify_match_branches(ctx: ResolveCtx, scope: List String, branches: List ast.MatchBranch) -> List ast.MatchBranch =
  match branches with
  | Nil -> Nil
  | Cons b rest ->
      match b with
      | ast.MatchBranch pat body ->
          Cons(ast.MatchBranch(qualify_pattern(ctx, scope, pat),
                               qualify_expr(ctx, list_append(ast.pattern_names(pat), scope), body)),
               qualify_match_branches(ctx, scope, rest))

fn qualify_do_steps(ctx: ResolveCtx, scope: List String, steps: List ast.DoStep) -> List ast.DoStep =
  match steps with
  | Nil -> Nil
  | Cons step rest ->
      match step with
      | ast.DoBindStep pat expr ->
          Cons(ast.DoBindStep(qualify_pattern(ctx, scope, pat), qualify_expr(ctx, scope, expr)),
               qualify_do_steps(ctx, list_append(ast.pattern_names(pat), scope), rest))
      | ast.DoLetStep name expr ->
          Cons(ast.DoLetStep(local_name(ctx, name), qualify_expr(ctx, scope, expr)),
               qualify_do_steps(ctx, Cons(name, scope), rest))
      | ast.DoExprStep expr ->
          Cons(ast.DoExprStep(qualify_expr(ctx, scope, expr)),
               qualify_do_steps(ctx, scope, rest))
      | ast.DoPatStep kind pat value els pos ->
          Cons(ast.DoPatStep(kind, qualify_pattern(ctx, scope, pat), qualify_expr(ctx, scope, value),
                             qualify_let_else(ctx, scope, els), pos),
               qualify_do_steps(ctx, list_append(ast.pattern_names(pat), scope), rest))

# The handler runs where the pattern failed, so only the residual's names are in scope.
fn qualify_let_else(ctx: ResolveCtx, scope: List String, els: Maybe ast.LetElse) -> Maybe ast.LetElse =
  match els with
  | Nothing -> Nothing
  | Just (ast.LetElse Nothing handler) -> Just(ast.LetElse(Nothing, qualify_expr(ctx, scope, handler)))
  | Just (ast.LetElse(Just residual) handler) ->
      Just(ast.LetElse(Just(qualify_pattern(ctx, scope, residual)),
                       qualify_expr(ctx, list_append(ast.pattern_names(residual), scope), handler)))

fn qualify_expr_list(ctx: ResolveCtx, scope: List String, exprs: List ast.Expr) -> List ast.Expr =
  match exprs with
  | Nil -> Nil
  | Cons e rest -> Cons(qualify_expr(ctx, scope, e), qualify_expr_list(ctx, scope, rest))

fn qualify_expr(ctx: ResolveCtx, scope: List String, expr: ast.Expr) -> ast.Expr =
  match expr with
  | ast.VarExpr name pos -> qualify_var(ctx, scope, name, pos)
  | ast.IntExpr _ _ -> expr
  | ast.FloatExpr _ _ -> expr
  | ast.BoolExpr _ _ -> expr
  | ast.StringExpr _ _ -> expr
  | ast.CharExpr _ _ -> expr
  | ast.UnitExpr _ -> expr
  | ast.TupleExpr items pos ->
      ast.TupleExpr(qualify_expr_list(ctx, scope, items), pos)
  | ast.IfExpr cond th el pos ->
      ast.IfExpr(qualify_expr(ctx, scope, cond), qualify_expr(ctx, scope, th), qualify_expr(ctx, scope, el), pos)
  | ast.MatchExpr scrutinee branches pos ->
      ast.MatchExpr(qualify_expr(ctx, scope, scrutinee), qualify_match_branches(ctx, scope, branches), pos)
  | ast.CallExpr callee args pos ->
      ast.CallExpr(qualify_expr(ctx, scope, callee), qualify_expr_list(ctx, scope, args), pos)
  | ast.LambdaExpr params body pos ->
      ast.LambdaExpr(qualify_params(ctx, params), qualify_expr(ctx, list_append(ast.param_names(params), scope), body), pos)
  | ast.BinaryExpr op left right pos ->
      ast.BinaryExpr(op, qualify_expr(ctx, scope, left), qualify_expr(ctx, scope, right), pos)
  | ast.UnaryExpr op operand pos ->
      ast.UnaryExpr(op, qualify_expr(ctx, scope, operand), pos)
  | ast.IntRangeExpr lo hi pos ->
      ast.IntRangeExpr(qualify_expr(ctx, scope, lo), qualify_expr(ctx, scope, hi), pos)
  | ast.DoExpr steps pos ->
      ast.DoExpr(qualify_do_steps(ctx, scope, steps), pos)
  # Through the VALUE namespace, not the type one: `P(x = 1)` is a constructor
  # application, and the value maps are the only ones `(..)` governs. Resolving it
  # as a type name published every record's constructor on the strength of
  # `export` alone. Both maps spell the answer `<module>.P`, so what changes is
  # which marker decides, not what inference receives.
  | ast.RecordExpr type_name fields pos ->
      ast.RecordExpr(qualify_value_name(ctx, scope, type_name), qualify_record_fields(ctx, scope, fields), pos)
  | ast.GetFieldExpr record field_name pos ->
      ast.GetFieldExpr(qualify_expr(ctx, scope, record), field_name, pos)
  | ast.RecordUpdateExpr base fields pos ->
      ast.RecordUpdateExpr(qualify_expr(ctx, scope, base), qualify_record_fields(ctx, scope, fields), pos)
  | ast.StringTemplateExpr parts pos ->
      ast.StringTemplateExpr(qualify_template_parts(ctx, scope, parts), pos)
  | ast.ComprehensionExpr elem gens pos ->
      let (qgens, final_scope) = qualify_comprehension_gens(ctx, scope, gens)
      in ast.ComprehensionExpr(qualify_expr(ctx, final_scope, elem), qgens, pos)
  | ast.LetBindExpr pat value els body pos ->
      ast.LetBindExpr(qualify_pattern(ctx, scope, pat), qualify_expr(ctx, scope, value),
                      qualify_let_else(ctx, scope, els),
                      qualify_expr(ctx, list_append(ast.pattern_names(pat), scope), body), pos)
  | ast.TryExpr operand pos -> ast.TryExpr(qualify_expr(ctx, scope, operand), pos)

# Each generator's pattern scopes over its own guards, every later generator's
# source and guards, and (via the returned final scope) the element expr.
fn qualify_comprehension_gens(ctx: ResolveCtx, scope: List String, gens: List ast.ComprehensionGen) -> (List ast.ComprehensionGen, List String) =
  match gens with
  | Nil -> (Nil, scope)
  | Cons g rest ->
      match g with
      | ast.ComprehensionGen pat src guards ->
          let qsrc = qualify_expr(ctx, scope, src)
          in let qpat = qualify_pattern(ctx, scope, pat)
          in let inner_scope = list_append(ast.pattern_names(pat), scope)
          in let qguards = qualify_expr_list(ctx, inner_scope, guards)
          in let (qrest, final_scope) = qualify_comprehension_gens(ctx, inner_scope, rest)
          in (Cons(ast.ComprehensionGen(qpat, qsrc, qguards), qrest), final_scope)

fn qualify_template_parts(ctx: ResolveCtx, scope: List String, parts: List ast.TemplateExprPart) -> List ast.TemplateExprPart =
  match parts with
  | Nil -> Nil
  | Cons p rest ->
      match p with
      | ast.LitPart text -> Cons(ast.LitPart(text), qualify_template_parts(ctx, scope, rest))
      | ast.InterpPart expr ->
          Cons(ast.InterpPart(qualify_expr(ctx, scope, expr)), qualify_template_parts(ctx, scope, rest))

fn qualify_class_methods(ctx: ResolveCtx, methods: List ast.ClassMethodSig) -> List ast.ClassMethodSig =
  match methods with
  | Nil -> Nil
  | Cons m rest ->
      match m with
      | ast.ClassMethodSig name params ret_type effects constraints bounds ->
          Cons(ast.ClassMethodSig(dict_get_or(name, ctx.value_locals, name), qualify_param_types(ctx, params),
                                  qualify_type_expr(ctx, ret_type), effects,
                                  qualify_constraints(ctx, constraints), bounds),
               qualify_class_methods(ctx, rest))

# An instance names its methods through its class, not through scope, so it need
# not import them: `class_name` is canonical, and so is the method it yields.
fn qualify_instance_methods(ctx: ResolveCtx, class_name: String, methods: List ast.InstanceMethodImpl) -> List ast.InstanceMethodImpl =
  match methods with
  | Nil -> Nil
  | Cons m rest ->
      match m with
      | ast.InstanceMethodImpl name params ret_type effects constraints bounds body ->
          Cons(ast.InstanceMethodImpl(class_method_canonical(class_name, name),
                                      qualify_params(ctx, params),
                                      qualify_maybe_type(ctx, ret_type),
                                      effects,
                                      qualify_constraints(ctx, constraints),
                                      bounds,
                                      qualify_expr(ctx, ast.param_names(params), body)),
               qualify_instance_methods(ctx, class_name, rest))

# A method's canonical name is its class's module and its own name; a prelude
# class's method is bare.
fn class_method_canonical(class_name: String, method: String) -> String =
  match string.rsplit_once(class_name, ".") with
  | Just (module_name, _) -> canonical_of(module_name, method)
  | Nothing -> method

fn qualify_maybe_type(ctx: ResolveCtx, mt: Maybe ast.TypeExpr) -> Maybe ast.TypeExpr =
  match mt with
  | Nothing -> Nothing
  | Just t -> Just(qualify_type_expr(ctx, t))

fn qualify_ctor_args(ctx: ResolveCtx, ctors: List ast.TypeConstructor) -> List ast.TypeConstructor =
  match ctors with
  | Nil -> Nil
  | Cons ctor rest ->
      match ctor with
      # exist_vars are locally-bound type variables (not qualified). exist_constraints
      # DO get qualified (Stage 0b): a constrained existential `any C` must resolve its
      # class name to the same qualified form instance registration and the class marker
      # use, or its instance/witness lookups (@inst / @fwd) miss for a user-defined class
      # in a module. qualify_constraints qualifies the class name; the existential var arg
      # is a local tyvar and passes through unchanged (like any where-constraint var).
      | ast.TypeConstructor name args exist_vars exist_constraints bounds ->
          Cons(ast.TypeConstructor(qualify_value_name(ctx, Nil, name), qualify_type_list(ctx, args), exist_vars,
                                   qualify_constraints(ctx, exist_constraints), bounds),
               qualify_ctor_args(ctx, rest))

fn qualify_record_field_decls(ctx: ResolveCtx, fields: List ast.RecordFieldDecl) -> List ast.RecordFieldDecl =
  match fields with
  | Nil -> Nil
  | Cons f rest ->
      match f with
      | ast.RecordFieldDecl fname t ->
          Cons(ast.RecordFieldDecl(fname, qualify_type_expr(ctx, t)),
               qualify_record_field_decls(ctx, rest))

fn qualify_decl(ctx: ResolveCtx, decl: ast.Decl) -> ast.Decl =
  match decl with
  | ast.FnDecl name params ret_type effects constraints bounds body pos ->
      ast.FnDecl(
        dict_get_or(name, ctx.value_locals, name),
        qualify_params(ctx, params),
        qualify_maybe_type(ctx, ret_type),
        effects,
        qualify_constraints(ctx, constraints),
        bounds,
        qualify_expr(ctx, ast.param_names(params), body),
        pos)
  | ast.TypeDecl name type_params ctors deriving_classes mult repr pos ->
      ast.TypeDecl(
        dict_get_or(name, ctx.type_locals, name),
        type_params,
        qualify_ctor_args(ctx, ctors),
        deriving_classes,
        mult,
        repr,
        pos)
  | ast.RecordDecl name type_params fields deriving_classes mult repr pos ->
      ast.RecordDecl(
        dict_get_or(name, ctx.type_locals, name),
        type_params,
        qualify_record_field_decls(ctx, fields),
        deriving_classes,
        mult,
        repr,
        pos)
  | ast.LetDecl name body anno pos ->
      ast.LetDecl(
        dict_get_or(name, ctx.value_locals, name),
        qualify_expr(ctx, Nil, body),
        qualify_maybe_type(ctx, anno),
        pos)
  | ast.ClassDecl name type_params methods superclasses pos ->
      ast.ClassDecl(
        dict_get_or(name, ctx.class_locals, name),
        type_params,
        qualify_class_methods(ctx, methods),
        qualify_constraints(ctx, superclasses),
        pos)
  | ast.InstanceDecl constraint instance_constraints bounds methods pos ->
      match constraint with
      | ast.TypeConstraint class_name args ->
          let qclass = qualify_type_name(ctx, class_name)
          in ast.InstanceDecl(
               ast.TypeConstraint(qclass, qualify_type_list(ctx, args)),
               qualify_constraints(ctx, instance_constraints),
               bounds,
               qualify_instance_methods(ctx, qclass, methods),
               pos)
  | ast.AliasDecl name type_params rhs pos ->
      ast.AliasDecl(dict_get_or(name, ctx.type_locals, name), type_params, qualify_type_expr(ctx, rhs), pos)
  | ast.WrapDecl name type_params inner deriving_classes mult repr pos ->
      ast.WrapDecl(
        dict_get_or(name, ctx.type_locals, name),
        type_params,
        qualify_type_expr(ctx, inner),
        deriving_classes,
        mult,
        repr,
        pos)
  | ast.ExternFnDecl name params ret_type effects bounds visibility pos ->
      ast.ExternFnDecl(name, qualify_param_types(ctx, params), qualify_maybe_type(ctx, ret_type), effects, bounds, visibility, pos)

fn qualify_decls(ctx: ResolveCtx, decls: List ast.Decl) -> List ast.Decl =
  match decls with
  | Nil -> Nil
  | Cons d rest -> Cons(qualify_decl(ctx, d), qualify_decls(ctx, rest))

# ---------------------------------------------------------------------------
# Main pipeline
# ---------------------------------------------------------------------------

type QualifiedModule = (path: String, decls: List ast.Decl)

# What every check of one bundle reads. Bundle-wide, so built once rather than
# per module in build_resolve_ctx, which would make it quadratic in modules.
type BundleNames = (all_symbols: Dict ModuleSymbols, canonical: Dict String, prelude: PreludeNames,
                    externs: List PrivateExtern, extern_decl_error: Maybe (String, source.SourcePos, String),
                    qualified: List QualifiedModule)

fn bundle_names(modules: List ParsedModule, stdlib_root: String, extra_roots: List String) -> BundleNames =
  let all_symbols = build_all_symbols(modules)
      canonical = all_canonical_names(all_symbols)
      prelude = prelude_names(modules, all_symbols, stdlib_root)
      facts = extern_facts_of(modules, all_symbols, stdlib_root, extra_roots, canonical, prelude)
      externs = private_externs_of(facts)
  in BundleNames(all_symbols = all_symbols, canonical = canonical, prelude = prelude, externs = externs,
                 extern_decl_error = maybe_or_else(unsafe_pure_decl_error(facts), export_local_extern_error(facts)),
                 qualified = list_map(qualify_one(_, all_symbols, stdlib_root, extra_roots, canonical, prelude, externs), modules))

fn qualify_one(mod: ParsedModule, all_symbols: Dict ModuleSymbols, stdlib_root: String,
               extra_roots: List String, canonical: Dict String, prelude: PreludeNames,
               externs: List PrivateExtern) -> QualifiedModule =
  let ParsedModule _ path _ _ ctor_types decls = mod
      published = PublishedTypes(in_prelude = path == prelude_path(stdlib_root), ctor_types = ctor_types)
  in QualifiedModule(path = path,
                     decls = qualify_decls(build_resolve_ctx(mod, all_symbols, stdlib_root, extra_roots, canonical, prelude, externs),
                                           list_map(publish_if_marked(published, _), decls)))

# Which of a module's type declarations publish their representation.
#
# `ctor_types` is collected only from `export`-prefixed declarations
# (parser.scan_surface_from), so membership means `export` AND `(..)` — exactly
# what a sum's constructors already require. Reading the marker in the parser
# instead made an unexported `type R (..)` publish its fields to anyone who could
# obtain a value, which is not what the two markers mean together anywhere else.
#
# The prelude publishes every type it declares: it is prepended to every bundle
# rather than imported, so its constructors are in scope everywhere whatever
# their marker (spec-v0 §3.1).
type PublishedTypes = (in_prelude: Bool, ctor_types: List String)

# Settle each type declaration's Representation from the module's EXPORT SURFACE.
# Runs before qualification, while the names are still the ones the author wrote
# and the ones `ctor_types` holds. Every variant is spelled out: a declaration
# form added later that declares a type needs its representation settled here.
fn publish_if_marked(published: PublishedTypes, decl: ast.Decl) -> ast.Decl =
  match decl with
  | ast.TypeDecl name type_params ctors deriving_classes mult _ pos ->
      ast.TypeDecl(name, type_params, ctors, deriving_classes, mult, representation_of(published, name), pos)
  | ast.RecordDecl name type_params fields deriving_classes mult _ pos ->
      ast.RecordDecl(name, type_params, fields, deriving_classes, mult, representation_of(published, name), pos)
  | ast.WrapDecl name type_params inner deriving_classes mult _ pos ->
      ast.WrapDecl(name, type_params, inner, deriving_classes, mult, representation_of(published, name), pos)
  | ast.FnDecl _ _ _ _ _ _ _ _ -> decl
  | ast.ExternFnDecl _ _ _ _ _ _ _ -> decl
  | ast.LetDecl _ _ _ _ -> decl
  | ast.ClassDecl _ _ _ _ _ -> decl
  | ast.InstanceDecl _ _ _ _ _ -> decl
  | ast.AliasDecl _ _ _ _ -> decl

fn representation_of(published: PublishedTypes, name: String) -> ast.Representation =
  if published.in_prelude || str_list_member(name, published.ctor_types) then ast.Published
  else ast.Abstract

# ---------------------------------------------------------------------------
# Post-qualification check: every type name must be one that exists
# ---------------------------------------------------------------------------
#
# `qualify_type_name` returns its input unchanged when nothing in scope claims
# the name, and a dotted one whose alias lookup declines goes the same way. That
# fallback is load-bearing rather than a bug: `stdlib/prelude.sprout` carries no
# `module` header, so `Maybe`, `List` and `Result` are declared UNQUALIFIED and
# every use of them in every module resolves through exactly this path. At the
# moment of qualification an unresolved name and a prelude name are the same
# thing — a name that matched nothing and was passed through.
#
# They separate AFTERWARDS, by membership. Every name a module may legitimately
# reach — its own, an import's, the prelude's — is the name of some declaration
# in the bundle, in whatever spelling qualification has left it carrying. So one
# membership test covers BOTH phantom shapes, the bare `T` and the qualified
# `nosuch.Bar`, with no special case for either.
#
# Without this the name became a fresh opaque type: `fn ident(t: T) -> T = t`
# compiled and ran. The mistake surfaced only where the phantom met a real type,
# as a mismatch between two spellings that read identically (`T` vs `mod.T`),
# arbitrarily far from the annotation that caused it.

# ---------------------------------------------------------------------------
# The `no_prelude` floor  (docs/no-prelude-core-v0.md)
# ---------------------------------------------------------------------------
#
# `no_prelude` suppresses the standard LIBRARY, not the language's runtime
# interface. The floor is the part of the prelude a file cannot opt out of: the
# `extern fn` declarations whose signatures range only over scalar primitives.
# Nothing else — no types, no classes, no instances, no Sprout functions.
#
# The floor is DERIVED, not listed. There is no roster of floor names anywhere:
# an extern is in the floor iff every type it mentions is in floor_type_names
# or is a type variable. Add a primitive-only extern to the prelude and it joins
# the floor; give one a `Maybe` and it does not. That is deliberate — a hand-kept
# roster is the second source of truth this whole change exists to avoid.
#
# WHY SCALARS AND NOT `undeclared_type_names` (just below). That list — the builtin
# type constants — also carries `Vector`, `Map`, `Ref`, `Bytes`,
# `Builder`, which are runtime backing stores the prelude does NOT declare. Using
# it here is a one-word change and would widen the floor from 16 externs to ~28,
# admitting the `vector_*` / `map_*` / `ref_*` families. It is a
# coherent alternative and costs no extra code — see docs/no-prelude-core-v0.md
# §4.3. The narrower cut was chosen because those families are data structures,
# which is what a standard library is for, and because a smaller floor is a
# smaller collision surface for a file that opted out (§11.1).
let floor_type_names: List String =
  ["Int", "Double", "Bool", "String", "Char", "Unit"]

# Names that are legitimately used in a type position with no declaration to
# find. The first row is the language's primitives; the second is opaque
# C-runtime types that back stdlib declarations (`Vector` for Vec/MutVec, `Map`
# for Dict and Set, `Ref` for a mutable cell, `Builder` for the
# bytes builder in stdlib/bytes.sprout).
#
# The list is derived from the `extern fn` signatures in `stdlib/`, not guessed:
# every uppercase name appearing in one and declared by no `type`/`wrap`/`class`
# is here. `Builder` was the miss that made 234 of 656 corpus files fail — it
# reaches a type position only through an extern, which is exactly the position
# the pre-existing type-validation pass in infer does not cover.
let undeclared_type_names: List String =
  ["Int", "Double", "Bool", "String", "Char", "Unit", "Bytes",
   "Vector", "Map", "Ref", "Builder"]


# Deliberately NOT unresolved_in_type: that helper admits every name in
# undeclared_type_names before consulting its `declared` argument, so it cannot
# express a set narrower than the builtins. This walk answers a different
# question — "does this type range only over the floor?" — and says so.
fn type_over_floor(t: ast.TypeExpr) -> Bool =
  match t with
  | ast.TypeName name ->
      type_name_starts_lower(name) || str_list_member(name, floor_type_names)
  | ast.TypeApply base arg -> type_over_floor(base) && type_over_floor(arg)
  | ast.TypeArrow left right _ _ -> type_over_floor(left) && type_over_floor(right)
  | ast.TypeThunk right _ -> type_over_floor(right)
  | ast.TypeEffect base _ -> type_over_floor(base)
  | ast.TupleType items -> types_over_floor(items)

fn types_over_floor(ts: List ast.TypeExpr) -> Bool =
  match ts with
  | Nil -> true
  | Cons t rest -> type_over_floor(t) && types_over_floor(rest)

fn maybe_type_over_floor(mt: Maybe ast.TypeExpr) -> Bool =
  match mt with
  | Nothing -> true
  | Just t -> type_over_floor(t)

fn params_over_floor(params: List ast.Param) -> Bool =
  match params with
  | Nil -> true
  | Cons p rest ->
      match p with
      | ast.Param _ anno _ -> maybe_type_over_floor(anno) && params_over_floor(rest)

# An unannotated parameter cannot be shown to be primitive-only, so it is not in
# the floor. No prelude extern has one (they are all fully annotated), but the
# check is written to fail closed rather than assume that stays true.
fn is_floor_extern(d: ast.Decl) -> Bool =
  match d with
  | ast.ExternFnDecl _ params ret _ _ _ _ ->
      params_over_floor(params) && maybe_type_over_floor(ret)
  | _ -> false

fn floor_decls(decls: List ast.Decl) -> List ast.Decl =
  match decls with
  | Nil -> Nil
  | Cons d rest ->
      if is_floor_extern(d) then Cons(d, floor_decls(rest)) else floor_decls(rest)

fn floor_export_names(decls: List ast.Decl) -> List String =
  match decls with
  | Nil -> Nil
  | Cons d rest ->
      match d with
      | ast.ExternFnDecl name _ _ _ _ _ _ -> Cons(name, floor_export_names(rest))
      | _ -> floor_export_names(rest)

# The prelude reduced to its floor: the primitive-only externs and nothing else.
#
# `ctor_types` is emptied because the floor declares no types, so it registers no
# constructors — and that emptiness is what keeps a `no_prelude` file's namespace
# free of `Maybe`/`Eq`, which is what lets the entry module stay unqualified (see
# collect_modules). The module name stays "" for the same reason the full prelude
# uses it: the floor's names are meant to be spelled bare.
fn prelude_floor(mod: ParsedModule) -> ParsedModule =
  match mod with
  | ParsedModule _ path _ _ _ decls ->
      ParsedModule("", path, Nil, floor_export_names(floor_decls(decls)), Nil,
                   floor_decls(decls))

# A source type VARIABLE is lowercase (`a`, `elem`); a constructor is uppercase,
# qualified or not. Checked on the short name so `mod.Foo` reads as a constructor.
fn type_name_starts_lower(name: String) -> Bool =
  match str_char_at(string.after_last_dot(name), 0) with
  | Nothing -> false
  | Just c -> c >= 'a' && c <= 'z'

fn add_declared_type_name(decl: ast.Decl, acc: Dict String) -> Dict String =
  match decl with
  | ast.TypeDecl name _ _ _ _ _ _ -> dict_set(name, name, acc)
  | ast.RecordDecl name _ _ _ _ _ _ -> dict_set(name, name, acc)
  | ast.AliasDecl name _ _ _ -> dict_set(name, name, acc)
  | ast.WrapDecl name _ _ _ _ _ _ -> dict_set(name, name, acc)
  # Classes share the namespace: a constraint's head and an `any C` existential
  # both reach a class through a type position.
  | ast.ClassDecl name _ _ _ _ -> dict_set(name, name, acc)
  | _ -> acc

fn declared_type_names(decls: List ast.Decl, acc: Dict String) -> Dict String =
  match decls with
  | Nil -> acc
  | Cons d rest -> declared_type_names(rest, add_declared_type_name(d, acc))

fn type_name_in_scope(name: String, declared: Dict String) -> Bool =
  if type_name_starts_lower(name) then true
  else if str_list_member(name, undeclared_type_names) then true
  else
    dict_member(name, declared)

fn unresolved_in_type(t: ast.TypeExpr, declared: Dict String) -> Maybe String =
  match t with
  | ast.TypeName name -> if type_name_in_scope(name, declared) then Nothing else Just(name)
  | ast.TypeApply base arg -> or_unresolved(unresolved_in_type(base, declared), arg, declared)
  | ast.TypeArrow left right _ _ -> or_unresolved(unresolved_in_type(left, declared), right, declared)
  | ast.TypeThunk right _ -> unresolved_in_type(right, declared)
  | ast.TypeEffect base _ -> unresolved_in_type(base, declared)
  | ast.TupleType items -> unresolved_in_types(items, declared)

fn or_unresolved(found: Maybe String, t: ast.TypeExpr, declared: Dict String) -> Maybe String =
  match found with
  | Just n -> Just(n)
  | Nothing -> unresolved_in_type(t, declared)

fn unresolved_in_types(ts: List ast.TypeExpr, declared: Dict String) -> Maybe String =
  match ts with
  | Nil -> Nothing
  | Cons t rest -> or_unresolved(unresolved_in_types(rest, declared), t, declared)

fn unresolved_in_maybe_type(mt: Maybe ast.TypeExpr, declared: Dict String) -> Maybe String =
  match mt with
  | Nothing -> Nothing
  | Just t -> unresolved_in_type(t, declared)

fn unresolved_in_params(params: List ast.Param, declared: Dict String) -> Maybe String =
  find_map(unresolved_in_param(_, declared), params)

fn unresolved_in_param(p: ast.Param, declared: Dict String) -> Maybe String =
  match p with
  | ast.Param _ anno _ -> unresolved_in_maybe_type(anno, declared)

# A LAMBDA parameter may be annotated, and `LambdaExpr` is the only Expr node
# that reaches a TypeExpr (every other one lives in a declaration head). So the
# body has to be walked too, or `\ (x: Nope) -> x` stays a phantom while the
# identical annotation on a named function is rejected — a hole exactly where a
# reader would assume the rule is uniform.
fn unresolved_in_expr(e: ast.Expr, declared: Dict String) -> Maybe String =
  match e with
  | ast.LambdaExpr params body _ ->
      match unresolved_in_params(params, declared) with
      | Just n -> Just(n)
      | Nothing -> unresolved_in_expr(body, declared)
  | ast.TupleExpr items _ -> unresolved_in_exprs(items, declared)
  | ast.IfExpr cond th el _ -> unresolved_in_exprs([cond, th, el], declared)
  | ast.MatchExpr scrutinee branches _ ->
      match unresolved_in_expr(scrutinee, declared) with
      | Just n -> Just(n)
      | Nothing -> unresolved_in_branches(branches, declared)
  | ast.CallExpr callee args _ -> unresolved_in_exprs(Cons(callee, args), declared)
  | ast.BinaryExpr _ left right _ -> unresolved_in_exprs([left, right], declared)
  | ast.UnaryExpr _ operand _ -> unresolved_in_expr(operand, declared)
  | ast.IntRangeExpr lo hi _ -> unresolved_in_exprs([lo, hi], declared)
  | ast.DoExpr steps _ -> unresolved_in_do_steps(steps, declared)
  | ast.RecordExpr _ fields _ -> unresolved_in_record_exprs(fields, declared)
  | ast.GetFieldExpr record _ _ -> unresolved_in_expr(record, declared)
  | ast.RecordUpdateExpr base fields _ ->
      match unresolved_in_expr(base, declared) with
      | Just n -> Just(n)
      | Nothing -> unresolved_in_record_exprs(fields, declared)
  | ast.StringTemplateExpr parts _ -> unresolved_in_template_parts(parts, declared)
  | ast.ComprehensionExpr elem gens _ ->
      match unresolved_in_expr(elem, declared) with
      | Just n -> Just(n)
      | Nothing -> unresolved_in_comprehension_gens(gens, declared)
  | ast.LetBindExpr pat value els body pos ->
      unresolved_in_expr(ast.let_bind_match(pat, value, els, body, pos), declared)
  | ast.TryExpr operand _ -> unresolved_in_expr(operand, declared)
  | _ -> Nothing

fn unresolved_in_comprehension_gens(gens: List ast.ComprehensionGen, declared: Dict String) -> Maybe String =
  find_map(unresolved_in_comprehension_gen(_, declared), gens)

fn unresolved_in_comprehension_gen(g: ast.ComprehensionGen, declared: Dict String) -> Maybe String =
  match g with
  | ast.ComprehensionGen _ src guards ->
      match unresolved_in_expr(src, declared) with
      | Just n -> Just(n)
      | Nothing -> unresolved_in_exprs(guards, declared)

fn unresolved_in_exprs(es: List ast.Expr, declared: Dict String) -> Maybe String =
  find_map(unresolved_in_expr(_, declared), es)

fn unresolved_in_branches(bs: List ast.MatchBranch, declared: Dict String) -> Maybe String =
  find_map(unresolved_in_branch(_, declared), bs)

fn unresolved_in_branch(b: ast.MatchBranch, declared: Dict String) -> Maybe String =
  match b with
  | ast.MatchBranch _ body -> unresolved_in_expr(body, declared)

fn unresolved_in_do_steps(steps: List ast.DoStep, declared: Dict String) -> Maybe String =
  match steps with
  | Nil -> Nothing
  | [ast.DoPatStep kind pat value els pos | rest] ->
      unresolved_in_do_steps(ast.do_pat_steps(kind, pat, value, els, rest, pos), declared)
  | [ast.DoBindStep _ e | rest] -> unresolved_in_step(e, rest, declared)
  | [ast.DoLetStep _ e | rest] -> unresolved_in_step(e, rest, declared)
  | [ast.DoExprStep e | rest] -> unresolved_in_step(e, rest, declared)

fn unresolved_in_step(e: ast.Expr, rest: List ast.DoStep, declared: Dict String) -> Maybe String =
  match unresolved_in_expr(e, declared) with
  | Just n -> Just(n)
  | Nothing -> unresolved_in_do_steps(rest, declared)

fn unresolved_in_record_exprs(fields: List ast.RecordField, declared: Dict String) -> Maybe String =
  find_map(unresolved_in_record_expr(_, declared), fields)

fn unresolved_in_record_expr(f: ast.RecordField, declared: Dict String) -> Maybe String =
  match f with
  | ast.RecordField _ e -> unresolved_in_expr(e, declared)

fn unresolved_in_template_parts(parts: List ast.TemplateExprPart, declared: Dict String) -> Maybe String =
  find_map(unresolved_in_template_part(_, declared), parts)

fn unresolved_in_template_part(p: ast.TemplateExprPart, declared: Dict String) -> Maybe String =
  match p with
  | ast.LitPart _ -> Nothing
  | ast.InterpPart e -> unresolved_in_expr(e, declared)

fn unresolved_in_constraints(cs: List ast.TypeConstraint, declared: Dict String) -> Maybe String =
  find_map(unresolved_in_constraint(_, declared), cs)

fn unresolved_in_constraint(c: ast.TypeConstraint, declared: Dict String) -> Maybe String =
  match c with
  | ast.TypeConstraint class_name args ->
      unresolved_in_types(Cons(ast.TypeName(class_name), args), declared)

fn unresolved_in_signature(params: List ast.Param, ret: Maybe ast.TypeExpr, cs: List ast.TypeConstraint, declared: Dict String) -> Maybe String =
  match unresolved_in_params(params, declared) with
  | Just n -> Just(n)
  | Nothing ->
      match unresolved_in_maybe_type(ret, declared) with
      | Just n -> Just(n)
      | Nothing -> unresolved_in_constraints(cs, declared)

fn unresolved_in_class_methods(ms: List ast.ClassMethodSig, declared: Dict String) -> Maybe String =
  find_map(unresolved_in_class_method(_, declared), ms)

fn unresolved_in_class_method(m: ast.ClassMethodSig, declared: Dict String) -> Maybe String =
  match m with
  | ast.ClassMethodSig _ params ret _ cs _ ->
      unresolved_in_signature(params, Just(ret), cs, declared)

fn unresolved_in_instance_methods(ms: List ast.InstanceMethodImpl, declared: Dict String) -> Maybe String =
  find_map(unresolved_in_instance_method(_, declared), ms)

fn unresolved_in_instance_method(m: ast.InstanceMethodImpl, declared: Dict String) -> Maybe String =
  match m with
  | ast.InstanceMethodImpl _ params ret _ cs _ body ->
      match unresolved_in_signature(params, ret, cs, declared) with
      | Just n -> Just(n)
      | Nothing -> unresolved_in_expr(body, declared)

fn unresolved_in_ctors(ctors: List ast.TypeConstructor, declared: Dict String) -> Maybe String =
  find_map(unresolved_in_ctor(_, declared), ctors)

fn unresolved_in_ctor(c: ast.TypeConstructor, declared: Dict String) -> Maybe String =
  match c with
  | ast.TypeConstructor _ args _ exist_constraints _ ->
      match unresolved_in_types(args, declared) with
      | Just n -> Just(n)
      | Nothing -> unresolved_in_constraints(exist_constraints, declared)

fn unresolved_in_record_fields(fields: List ast.RecordFieldDecl, declared: Dict String) -> Maybe String =
  find_map(unresolved_in_type(_, declared), ast.record_field_type_exprs(fields))

# The name of the declaration an unresolved type was written in, for the message.
# Qualified, so it names the module too — the report's cost came from not knowing
# which of 4,400 lines the annotation was on.
fn decl_display_name(decl: ast.Decl) -> String =
  match decl with
  | ast.FnDecl name _ _ _ _ _ _ _ -> name
  | ast.ExternFnDecl name _ _ _ _ _ _ -> name
  | ast.TypeDecl name _ _ _ _ _ _ -> name
  | ast.RecordDecl name _ _ _ _ _ _ -> name
  | ast.AliasDecl name _ _ _ -> name
  | ast.WrapDecl name _ _ _ _ _ _ -> name
  | ast.ClassDecl name _ _ _ _ -> name
  | ast.LetDecl name _ _ _ -> name
  | ast.InstanceDecl constraint _ _ _ _ ->
      match constraint with
      | ast.TypeConstraint class_name _ -> "instance " ++ class_name

fn unresolved_in_decl(decl: ast.Decl, declared: Dict String) -> Maybe String =
  match decl with
  | ast.FnDecl _ params ret _ cs _ body _ ->
      match unresolved_in_signature(params, ret, cs, declared) with
      | Just n -> Just(n)
      | Nothing -> unresolved_in_expr(body, declared)
  | ast.ExternFnDecl _ params ret _ _ _ _ -> unresolved_in_signature(params, ret, Nil, declared)
  | ast.TypeDecl _ _ ctors _ _ _ _ -> unresolved_in_ctors(ctors, declared)
  | ast.RecordDecl _ _ fields _ _ _ _ -> unresolved_in_record_fields(fields, declared)
  | ast.AliasDecl _ _ rhs _ -> unresolved_in_type(rhs, declared)
  | ast.WrapDecl _ _ inner _ _ _ _ -> unresolved_in_type(inner, declared)
  | ast.ClassDecl _ _ methods supers _ ->
      match unresolved_in_class_methods(methods, declared) with
      | Just n -> Just(n)
      | Nothing -> unresolved_in_constraints(supers, declared)
  | ast.InstanceDecl constraint inst_cs _ methods _ ->
      match unresolved_in_constraints(Cons(constraint, inst_cs), declared) with
      | Just n -> Just(n)
      | Nothing -> unresolved_in_instance_methods(methods, declared)
  | ast.LetDecl _ body anno _ ->
      match unresolved_in_maybe_type(anno, declared) with
      | Just n -> Just(n)
      | Nothing -> unresolved_in_expr(body, declared)

# Which module exports a name spelled like this one. The unresolved name is bare
# (`TestState`), the declared one is qualified (`stdlib.test.TestState`), so the
# match is on the last segment and the answer is the prefix. Runs only on the
# error path, so the linear scan costs nothing in a successful compile.
fn exporting_module(name: String, declared_names: List String) -> Maybe String =
  match declared_names with
  | Nil -> Nothing
  | Cons d rest ->
      if string.after_last_dot(d) == string.after_last_dot(name) && str_find(d, ".") != -1
      then Just(str_slice(d, 0, str_len(d) - str_len(string.after_last_dot(d)) - 1))
      else exporting_module(name, rest)

# `place` is where the name was written: a declaration, in backticks, or the expression.
fn unresolved_type_message(name: String, place: String, declared: Dict String) -> String =
  if str_starts_with(name, source.canonical_marker)
  then source.canonical_name_message(name)
  else
    match exporting_module(name, vec_to_list(dict_keys(declared))) with
    | Nothing -> base
    | Just mod_name ->
        base ++ ". `" ++ mod_name ++ "` exports it — add it to that module's import list"
  where base = "unknown type `" ++ name ++ "` in " ++ place ++ ": nothing in scope declares that name"

fn find_unresolved_type(decls: List ast.Decl, declared: Dict String) -> Maybe(source.SourcePos, String) =
  ast.first_decl_error(unresolved_type_error(declared, _), decls)

fn unresolved_type_error(declared: Dict String, d: ast.Decl) -> Maybe String =
  map(unresolved_type_message(_, "`" ++ decl_display_name(d) ++ "`", declared), unresolved_in_decl(d, declared))

# The declared set is now the whole story. It used to be widened with an
# "ambient" list — the prelude's exported names, re-read from source, because a
# preludeless bundle did not declare them while the checker still knew them. With
# the prelude unconditional (collect_modules), its types are declared in the
# bundle like any other module's, so there is nothing left to compensate for.
fn validate_type_names(decls: List ast.Decl) -> Maybe(source.SourcePos, String) =
  find_unresolved_type(decls, declared_type_names(decls, dict_empty()))

# ---------------------------------------------------------------------------
# A one-constructor type whose constructor is named after a type in scope
# ---------------------------------------------------------------------------
#
# `type Pairs = List (String, Int)` reads as an alias and is not one: it declares a
# constructor named `List` (spec §5.6). Only the one-constructor shape is rejected,
# since that is the shape an alias has; `| JsonArray JsonArray` among other
# constructors stays legal (stdlib/json.sprout).
#
# "In scope" is what qualify_type_name resolves the name to, read off the same
# ResolveCtx: the module's own types, the ones it imports by name, the prelude's
# (by fall-through), and for `alias.T` the alias's exported types.

# The bundle-wide half of the answer. The prelude's types are found by PATH, not by
# the empty module name, which a `no_prelude` entry has too: its types are in scope
# only in itself. The canonical type names keep an alias lookup to types: its table
# holds the alias's classes too.
type TypeVocab = (prelude_types: Dict String, type_canonicals: Dict String)

fn prelude_type_names(all_symbols: Dict ModuleSymbols, stdlib_root: String) -> Dict String =
  match dict_get(prelude_path(stdlib_root), all_symbols) with
  | Nothing -> dict_empty()
  | Just syms -> sym_type_locals(syms)

fn add_type_canonicals(acc: Dict String, syms: ModuleSymbols) -> Dict String =
  vec_fold(\ (a, canonical) -> dict_set(canonical, canonical, a), acc, dict_values(sym_type_locals(syms)))

fn type_vocab(all_symbols: Dict ModuleSymbols, stdlib_root: String) -> TypeVocab =
  TypeVocab(prelude_types = prelude_type_names(all_symbols, stdlib_root),
            type_canonicals = vec_fold(add_type_canonicals, dict_empty(), dict_values(all_symbols)))

# (type, its parameters, constructor, position) of a one-constructor type not named
# like its constructor.
fn one_ctor_named_apart(decl: ast.Decl) -> Maybe (String, List String, String, source.SourcePos) =
  match decl with
  | ast.TypeDecl name params [ast.TypeConstructor ctor _ _ _ _] _ _ _ pos ->
      if ctor == name then Nothing else Just((name, params, ctor, pos))
  | _ -> Nothing

fn alias_names_type(ctx: ResolveCtx, vocab: TypeVocab, alias: String, symbol: String) -> Bool =
  match alias_export(alias, symbol, ctx.alias_type_exports) with
  | Nothing -> false
  | Just canonical -> dict_member(canonical, vocab.type_canonicals)

# A bare name is tried in qualify_type_name's order, so a class the module declares
# or imports hides a prelude or builtin type of its name.
fn names_type_in_scope(ctx: ResolveCtx, vocab: TypeVocab, name: String) -> Bool =
  match string.split_once(name, ".") with
  | Just (alias, symbol) -> alias_names_type(ctx, vocab, alias, symbol)
  | Nothing -> bare_names_type(ctx, vocab, name)

fn bare_names_type(ctx: ResolveCtx, vocab: TypeVocab, name: String) -> Bool =
  if dict_member(name, ctx.type_locals) then true
  else if dict_member(name, ctx.class_locals) then false
  else if dict_member(name, ctx.unqual_types) then true
  else if dict_member(name, ctx.unqual_classes) then false
  else str_list_member(name, undeclared_type_names) || dict_member(name, vocab.prelude_types)

# `shown` is the qualified name, so the message names the module; `head` is the
# type as written, with its parameters, which the suggested fix needs.
fn one_ctor_clash_message(shown: String, head: String, ctor: String) -> String =
  "type `" ++ shown ++ "` has one constructor, `" ++ ctor
    ++ "`, which is also the name of a type in scope: this declares a new sum type, not an alias. Write `type alias "
    ++ head ++ " = …` for an alias or `wrap " ++ head
    ++ " = …` for a distinct type; to keep the sum type, rename the constructor"

fn first_one_ctor_clash(ctx: ResolveCtx, vocab: TypeVocab,
                        candidates: List (String, List String, String, source.SourcePos)) -> Maybe(source.SourcePos, String) =
  match candidates with
  | [] -> Nothing
  | [(name, params, ctor, pos) | rest] ->
      if names_type_in_scope(ctx, vocab, ctor)
      then Just((pos, one_ctor_clash_message(dict_get_or(name, ctx.type_locals, name),
                                             string.join(" ", Cons(name, params)), ctor)))
      else first_one_ctor_clash(ctx, vocab, rest)

# Runs on the modules as written, before qualification renames their constructors.
# A module's ResolveCtx is built only when it has a candidate, which most do not.
# Returns the module's path with the clash, since its position is in THAT file.
fn find_one_ctor_clash(modules: List ParsedModule, all_symbols: Dict ModuleSymbols,
                       stdlib_root: String, extra_roots: List String, canonical: Dict String,
                       prelude: PreludeNames, externs: List PrivateExtern,
                       vocab: TypeVocab) -> Maybe (String, source.SourcePos, String) =
  match modules with
  | Nil -> Nothing
  | Cons mod rest ->
      match mod with
      | ParsedModule _ path _ _ _ decls ->
          match list_filter_map(one_ctor_named_apart, decls) with
          | [] -> find_one_ctor_clash(rest, all_symbols, stdlib_root, extra_roots, canonical, prelude, externs, vocab)
          | candidates ->
              match first_one_ctor_clash(build_resolve_ctx(mod, all_symbols, stdlib_root, extra_roots, canonical, prelude, externs),
                                         vocab, candidates) with
              | Just (pos, msg) -> Just((path, pos, msg))
              | Nothing -> find_one_ctor_clash(rest, all_symbols, stdlib_root, extra_roots, canonical, prelude, externs, vocab)

# ---------------------------------------------------------------------------
# Post-qualification assertion: no qualified name may start with '.'
# An empty module prefix + dot (e.g. ".fn_name") is always a bug in
# scan_source_info or build_resolve_ctx returning an empty module name.
# ---------------------------------------------------------------------------

fn validate_qualified_decl(decl: ast.Decl) -> Maybe String =
  match decl with
  | ast.FnDecl name _ _ _ _ _ _ _ ->
      if str_starts_with(name, ".") then Just("FnDecl name starts with '.': " ++ name)
      else Nothing
  | ast.TypeDecl name _ _ _ _ _ _ ->
      if str_starts_with(name, ".") then Just("TypeDecl name starts with '.': " ++ name)
      else Nothing
  | ast.LetDecl name _ _ _ ->
      if str_starts_with(name, ".") then Just("LetDecl name starts with '.': " ++ name)
      else Nothing
  | ast.ClassDecl name _ _ _ _ ->
      if str_starts_with(name, ".") then Just("ClassDecl name starts with '.': " ++ name)
      else Nothing
  | ast.WrapDecl name _ _ _ _ _ _ ->
      if str_starts_with(name, ".") then Just("WrapDecl name starts with '.': " ++ name)
      else Nothing
  | _ -> Nothing

fn validate_qualified_decls(decls: List ast.Decl) -> Maybe(source.SourcePos, String) =
  ast.first_decl_error(validate_qualified_decl, decls)

# Imports are validated FIRST. A bad import makes the names it should have bound
# resolve to something else or to nothing, so every later check reports a symptom
# of it — under its own name, somewhere the import is not mentioned.
fn make_bundle_or_err(modules: List ParsedModule, entry_path: String, stdlib_root: String,
                      extra_roots: List String, names: BundleNames) -> BundleResult =
  match validate_imports(modules, names.all_symbols, stdlib_root, extra_roots) with
  | Just issue -> BundleErr(issue_pos_for_entry(issue, entry_path), issue_message(issue))
  | Nothing ->
    match names.extern_decl_error with
    | Just (path, pos, err_msg) -> BundleErr(pos_for_entry(path, pos, entry_path), err_msg)
    | Nothing ->
      match validate_qualified_decls(qualified) with
      | Just (pos, err_msg) -> BundleErr(pos, "[assert] qualify_decl: " ++ err_msg)
      | Nothing ->
          match validate_type_names(qualified) with
          | Just (pos, err_msg) -> BundleErr(pos, err_msg)
          | Nothing ->
            match find_one_ctor_clash(modules, names.all_symbols, stdlib_root, extra_roots, names.canonical, names.prelude, names.externs,
                                      type_vocab(names.all_symbols, stdlib_root)) with
            | Just (path, pos, err_msg) -> BundleErr(pos_for_entry(path, pos, entry_path), err_msg)
            | Nothing ->
            match deriving.validate_deriving_decls(qualified) with
            | Just (pos, err_msg) -> BundleErr(pos, "deriving: " ++ err_msg)
            | Nothing -> BundleOk(list_map(\m -> deriving.expand_deriving_decls(m.decls), names.qualified))
  where qualified = list_flat_map(\m -> m.decls, names.qualified)

export fn bundle_file(path: source.FilePath, stdlib_root: source.StdlibRoot) -> BundleResult !{IO} =
  bundle_file_with_roots(path, stdlib_root, Nil)

# Like bundle_file, but resolves dotted non-stdlib imports against extra package
# roots (docs/packaging-v0.md §10 phase 2). bundle_file delegates here with no
# extra roots, so all existing callers are unaffected.
export fn bundle_file_with_roots(path: source.FilePath, stdlib_root: source.StdlibRoot, extra_roots: List String) -> BundleResult !{IO} =
  do
    load_env <- new_load_env()
    (bundle, _) <- bundle_entry(source.filepath_str(path), stdlib_root, extra_roots, load_env)
    bundle

# Bundle a module given its SOURCE rather than its path.
#
# This is the entry point an editor needs, and the reason the two front ends can now be
# one. The buffer being checked may differ from what is on disk, or have no file at all
# (a REPL line, an unsaved editor buffer), so it enters through the overlay
# under `entry_path` and is found there instead of being read.
#
# `entry_path` is not required to exist. It still matters: imports resolve against
# stdlib_root and extra_roots rather than relative to it, but it is the key the entry
# occupies in the overlay and the name that appears in load errors, so callers with a
# real path should pass it.
#
# The load_env's memo persists across calls, so a session re-checking one buffer re-parses
# only that buffer.
export fn bundle_source_with_roots(src: String, entry_path: String, stdlib_root: source.StdlibRoot,
                                   extra_roots: List String, load_env: LoadEnv) -> BundleResult !{IO} =
  do
    (bundle, _) <- bundle_entry(entry_path, stdlib_root, extra_roots, with_entry_source(entry_path, src, load_env))
    bundle

# A buffer with a declaration it does not contain: eval's `main`. The declaration is
# named, resolved and checked as if it were written at the end of the buffer.
export fn bundle_source_with_decl(src: String, entry_path: String, decl: ast.Decl,
                                  stdlib_root: source.StdlibRoot, extra_roots: List String,
                                  load_env: LoadEnv) -> BundleResult !{IO} =
  do
    let root = source.stdlib_root_str(stdlib_root)
    loaded <- load_bundle(entry_path, root, extra_roots, [decl], with_entry_source(entry_path, src, load_env))
    match loaded with
    | LoadFailed pos msg -> BundleErr(pos, msg)
    | LoadedBundle modules names -> make_bundle_or_err(modules, entry_path, root, extra_roots, names)

fn with_entry_source(entry_path: String, src: String, load_env: LoadEnv) -> LoadEnv =
  load_env_with_overlay(dict_set(entry_path, src, load_env_overlay(load_env)), load_env)

# Like bundle_file_with_roots, but also hands back the entry module's
# declarations as the bundle names them, so a report can tell the entry's
# declarations from its imports'.
export fn bundle_with_entry_decls(path: source.FilePath, stdlib_root: source.StdlibRoot,
                                  extra_roots: List String) -> (BundleResult, List ast.Decl) !{IO} =
  do
    load_env <- new_load_env()
    bundle_entry(source.filepath_str(path), stdlib_root, extra_roots, load_env)

# Every bundle is loaded here: its modules, and the names they are qualified against.
# `entry_extra` is appended to the entry module's declarations before either is computed.
type LoadedBundle =
  | LoadFailed source.SourcePos String
  | LoadedBundle (List ParsedModule) BundleNames

fn load_bundle(entry_path: String, root: String, extra_roots: List String, entry_extra: List ast.Decl,
               load_env: LoadEnv) -> LoadedBundle !{IO} =
  do
    (err, loaded) <- collect_modules(entry_path, root, extra_roots, load_env)
    match err with
    | Just issue -> LoadFailed(issue_pos_for_entry(issue, entry_path), issue_message(issue))
    | Nothing ->
        let modules = list_map(append_to_entry(entry_path, entry_extra, _), loaded)
        in LoadedBundle(modules, bundle_names(modules, root, extra_roots))

fn append_to_entry(entry_path: String, extra: List ast.Decl, mod: ParsedModule) -> ParsedModule =
  match mod with
  | ParsedModule name path specs exported ctor_types decls ->
      if path == entry_path then ParsedModule(name, path, specs, exported, ctor_types, decls ++ extra)
      else mod

# The bundle, and the entry module's declarations.
fn bundle_entry(entry_path: String, stdlib_root: source.StdlibRoot, extra_roots: List String,
                load_env: LoadEnv) -> (BundleResult, List ast.Decl) !{IO} =
  do
    let root = source.stdlib_root_str(stdlib_root)
    loaded <- load_bundle(entry_path, root, extra_roots, Nil, load_env)
    match loaded with
    | LoadFailed pos msg -> (BundleErr(pos, msg), Nil)
    | LoadedBundle modules names ->
        (make_bundle_or_err(modules, entry_path, root, extra_roots, names),
         list_flat_map(\m -> if m.path == entry_path then m.decls else Nil, names.qualified))

# A question asked in a buffer's scope: the buffer's bundle, and the expression with its
# names resolved as a declaration in the buffer would resolve them. The expression is not
# added to the buffer, so it binds nothing and no name is reserved for it.
export type QuestionBundle (..) =
  | QuestionBundleOk (List (List ast.Decl)) ast.Expr
  | QuestionBundleErr source.SourcePos String

export fn bundle_source_with_question(src: String, entry_path: String, question: ast.Expr,
                                      stdlib_root: source.StdlibRoot, extra_roots: List String,
                                      load_env: LoadEnv) -> QuestionBundle !{IO} =
  do
    let root = source.stdlib_root_str(stdlib_root)
    loaded <- load_bundle(entry_path, root, extra_roots, Nil, with_entry_source(entry_path, src, load_env))
    match loaded with
    | LoadFailed pos msg -> QuestionBundleErr(pos, msg)
    | LoadedBundle modules names ->
        match make_bundle_or_err(modules, entry_path, root, extra_roots, names) with
        | BundleErr pos msg -> QuestionBundleErr(pos, msg)
        | BundleOk bundled -> qualify_question(question, entry_path, root, extra_roots, modules, names, bundled)

# Type names are checked here, as validate_type_names checks a declaration's: an unknown
# one would otherwise reach the checker as a fresh opaque type.
fn qualify_question(question: ast.Expr, entry_path: String, root: String, extra_roots: List String,
                    modules: List ParsedModule, names: BundleNames,
                    bundled: List (List ast.Decl)) -> QuestionBundle =
  let pos = ast.expr_pos(question)
      Just entry = find(\m -> parsed_path(m) == entry_path, modules)
        else QuestionBundleErr(pos, "internal: the entry module was not loaded")
      ctx = build_resolve_ctx(entry, names.all_symbols, root, extra_roots, names.canonical,
                              names.prelude, names.externs)
      qualified = qualify_expr(ctx, Nil, question)
      declared = declared_type_names(list_flat_map(\m -> m.decls, names.qualified), dict_empty())
      Nothing = unresolved_in_expr(qualified, declared)
        else Just name -> QuestionBundleErr(pos, unresolved_type_message(name, "the expression", declared))
  in QuestionBundleOk(bundled, qualified)

# ---------------------------------------------------------------------------
# Phase: dump-qualify — show original→qualified name mapping per module
# Useful for diagnosing scan_source_info / build_resolve_ctx bugs.
# ---------------------------------------------------------------------------

fn decl_orig_name(decl: ast.Decl) -> String =
  match decl with
  | ast.FnDecl name _ _ _ _ _ _ _ -> name
  | ast.TypeDecl name _ _ _ _ _ _ -> name
  | ast.RecordDecl name _ _ _ _ _ _ -> name
  | ast.LetDecl name _ _ _ -> name
  | ast.ClassDecl name _ _ _ _ -> name
  | ast.InstanceDecl constraint _ _ _ _ ->
      match constraint with
      | ast.TypeConstraint class_name _ -> "instance:" ++ class_name
  | ast.AliasDecl name _ _ _ -> name
  | ast.WrapDecl name _ _ _ _ _ _ -> name
  | ast.ExternFnDecl name _ _ _ _ _ _ -> name

fn ctx_status_line(path: String, all_symbols: Dict ModuleSymbols) -> String =
  match dict_get(path, all_symbols) with
  | Nothing -> "ctx: EMPTY (path not in all_symbols)"
  | Just _ -> "ctx: populated"

fn module_header_line(mod_name: String) -> String =
  if mod_name == "" then "module: (prelude)" else "module: " ++ mod_name

fn qualify_debug_line(ctx: ResolveCtx, decl: ast.Decl) -> String =
  decl_orig_name(decl) ++ " -> " ++ decl_orig_name(qualify_decl(ctx, decl))

fn qualify_debug_lines_acc(ctx: ResolveCtx, decls: List ast.Decl, acc: List String) -> List String =
  match decls with
  | Nil -> list_reverse(acc)
  | Cons d rest ->
      qualify_debug_lines_acc(ctx, rest, Cons(qualify_debug_line(ctx, d), acc))

fn dump_qualify_module(mod: ParsedModule, all_symbols: Dict ModuleSymbols, stdlib_root: String,
                       canonical: Dict String, prelude: PreludeNames,
                       externs: List PrivateExtern) -> List String =
  match mod with
  | ParsedModule mod_name path _ _ _ decls ->
      Cons(module_header_line(mod_name),
      Cons(ctx_status_line(path, all_symbols),
      qualify_debug_lines_acc(
        build_resolve_ctx(mod, all_symbols, stdlib_root, Nil, canonical, prelude, externs),
        decls, Nil)))

# Same once-per-bundle rule as `make_bundle_or_err`: build the canonical table
# here, not inside the per-module function, or the debug dump is quadratic.
fn dump_qualify_modules_acc(modules: List ParsedModule, all_symbols: Dict ModuleSymbols, stdlib_root: String) -> List String =
  dump_qualify_modules_with(modules, all_symbols, stdlib_root, canonical, prelude,
                            private_externs_of(extern_facts_of(modules, all_symbols, stdlib_root, Nil, canonical, prelude)))
  where canonical = all_canonical_names(all_symbols)
        prelude = prelude_names(modules, all_symbols, stdlib_root)

fn dump_qualify_modules_with(modules: List ParsedModule, all_symbols: Dict ModuleSymbols,
                             stdlib_root: String, canonical: Dict String,
                             prelude: PreludeNames, externs: List PrivateExtern) -> List String =
  match modules with
  | Nil -> Nil
  | Cons mod rest ->
      list_append(dump_qualify_module(mod, all_symbols, stdlib_root, canonical, prelude, externs),
                  dump_qualify_modules_with(rest, all_symbols, stdlib_root, canonical, prelude, externs))

export fn dump_qualify_file(path: source.FilePath, stdlib_root: source.StdlibRoot) -> List String !{IO} =
  do
    load_env <- new_load_env()
    (err, modules) <- collect_modules(source.filepath_str(path), source.stdlib_root_str(stdlib_root), Nil, load_env)
    match err with
    | Just issue -> Cons("ERROR: " ++ issue_message(issue), Nil)
    | Nothing -> dump_qualify_modules_acc(modules, build_all_symbols(modules), source.stdlib_root_str(stdlib_root))

