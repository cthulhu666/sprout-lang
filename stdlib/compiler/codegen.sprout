module stdlib.compiler.codegen
import stdlib.compiler.ast as ast
import stdlib.compiler.types as types
import stdlib.compiler.typed_ast as typed_ast
import stdlib.compiler.source as source
import stdlib.compiler.field_kinds as fk
import stdlib.string as string

# ---------------------------------------------------------------------------
# M6 — LLVM IR emission pass
# ---------------------------------------------------------------------------
#
# compile_to_ir takes a TypedProgram (produced by re-typechecking the lowered
# AST) and the corresponding typing environment, and emits LLVM IR text.
#
# Pipeline position:
#   bundle → typecheck_typed → lower → typecheck_typed(lowered) → compile_to_ir
#
# Design notes:
#   • All LLVM types are strings ("i64", "i1", "ptr", "{ i64, ptr }").
#   • ADT handles, opaque pointers, Unit, and type-variable positions → "i64".
#   • Bool → "i1", String/Char → "i64" (GC Option C — see below), function values → "ptr" (closure ptr).
#   • GC Option C: String/Char are represented as i64 (raw ptr cast to int) so every string
#     slot is unconditionally compatible with the GC root table, which stores roots as i64.
#     Keeping strings as ptr would require ptrtoint/inttoptr coercions at every rooting call.
#     Consequence: string comparisons must coerce i64→ptr before calling str_eq/str_compare;
#     use compare_needs_ptr_dispatch(left_ty, right_ty) to detect the case.
#     DO NOT change const_to_ll("String"/"Char") to ll_ptr() — that is a regression.
#   • Tuples → "{ ll0, ll1, ... }" LLVM struct.
#   • The EmitterState holds all mutable codegen state in a Ref.
#   • Locals are threaded as a Dict Value (immutable, updated at each let/bind).
#   • TCO: self-recursive tail calls converted to explicit loops (Option C).

# ---------------------------------------------------------------------------
# Calling convention signatures
# ---------------------------------------------------------------------------

# CallSig describes how to call a function-typed value:
#   params   — LLVM types of the arguments (flattened, not curried)
#   ret      — LLVM return type
#   ret_sig  — if ret is "ptr" (another closure), its own CallSig
export type CallSig (..) =
  | CallSig (List String) String (Maybe CallSig)

# ---------------------------------------------------------------------------
# Runtime value representation
# ---------------------------------------------------------------------------

# Every computed expression is a Value:
#   lltype      — the LLVM type string (e.g. "i64", "ptr")
#   ir          — the LLVM IR name/literal (e.g. "%t3", "42", "null")
#   call_sig    — if this is a callable (ptr), how to call it
#   tuple_items — if this is a struct, the list of field lltypes (for GC scan)
#   tco_args    — non-Nothing signals a pending TCO back-edge; holds coerced
#                 new argument values to store back into the loop parameter slots
export type Value (..) =
  | Value String String (Maybe CallSig) (Maybe (List String)) (Maybe (List Value))

# ---------------------------------------------------------------------------
# Compile-time signatures collected from the TypedProgram
# ---------------------------------------------------------------------------

export type CtorSig (..) =
  | CtorSig String Int (List String) (List ast.TypeExpr) (List String)
  # CtorSig name tag arg_lltypes arg_type_exprs type_params

export type FnSig (..) =
  | FnSig String (List String) String (Maybe CallSig)
  # FnSig name param_lltypes ret_lltype ret_call_sig

export type GlobalInfo (..) =
  | GlobalInfo String Bool (Maybe String) (Maybe CallSig)
  # GlobalInfo lltype is_const const_ir call_sig

# ---------------------------------------------------------------------------
# TCO context (threaded through expression emission)
# ---------------------------------------------------------------------------

# TcoCtx is present only when we are inside a TCO or mutual-TCO function.
#
# fn_name     — name of the function being compiled
# loop_lbl    — label of the loop-header block (back-edge target)
# slots       — (alloca_ir, lltype) for each parameter
# ret_ll      — return lltype of the function
# n_roots     — GC roots pushed at function entry (parameter slots); constant
# outer_roots — cumulative extra GC roots in enclosing pattern branches
# sp_save     — IR register from llvm.stacksave(); restored at each back-edge
export type TcoCtx (..) =
  | TcoCtx String String (List (String, String)) String Int Int String

# ---------------------------------------------------------------------------
# Emitter state  (9 fields → fits sprout_make9; do NOT add more fields here)
# ---------------------------------------------------------------------------

# All mutable codegen state lives here, wrapped in a Ref.
#
# body      — lines being accumulated for the current function body (reversed)
# all_defs  — completed function/lambda definitions (reversed)
# str_glbs  — string literal global declarations (reversed)
# fn_wrap   — dict of top-level fn_name → wrapper_fn_name
# cur_blk   — name of the current basic block (NoBlk before first label)
# next_tmp  — counter for fresh SSA names (%t0, %t1, ...)
# next_blk  — counter for fresh block labels
# next_str  — counter for string literal globals (@.str.0, ...)
# next_lam  — counter for lambda/wrapper function names
type EmitterState =
  | EmitterState
      (Ref (List String))  # body
      (Ref (List String))  # all_defs
      (Ref (List String))  # str_glbs
      (Ref (Dict String))  # fn_wrap
      (Ref CurBlk)  # cur_blk  (NoBlk = no current block)
      (Ref Int)  # next_tmp
      (Ref Int)  # next_blk
      (Ref Int)  # next_str
      (Ref Int)  # next_lam

# ---------------------------------------------------------------------------
# Debug emitter state — kept separate so EmitterState stays at 9 fields.
#
# debug_mode      — false = all DWARF emission is skipped (release build)
# source_file     — entry source file path, used as the single !DIFile in M1
# meta_id_counter — next metadata node ID; starts at 6 (IDs 0–5 are the
#                   static module-level preamble; see assemble_debug_section)
# meta_lines      — accumulated debug metadata lines (reversed), flushed as
#                   the 4th IR section after all function defs
# current_sp_id   — !DISubprogram ID for the function currently being emitted;
#                   used when attaching !dbg to instructions (M1.5+)
type DbgEmitter =
  | DbgEmitter Bool String (Ref Int) (Ref (List String)) (Ref Int) (Ref Int) Int
  # debug_mode, source_file, meta_id_counter, meta_lines, current_sp_id, current_loc_id, header_line_offset

# Emitter wraps EmitterState (capped at 9 fields) together with DbgEmitter and a
# warns accumulator collecting missed-TCO advisory messages (cross-fn tail calls in a
# TCO context).  All emit_* and es_* call sites use `em: Emitter` unchanged.
type Emitter =
  | Emitter EmitterState DbgEmitter (Ref (List String))

# Encodes the current basic block name.  A dedicated ADT avoids the do-bind
# monadic-unwrap rule that applies to Maybe/Result.
type CurBlk =
  | NoBlk
  | SomeBlk String

# ---------------------------------------------------------------------------
# Codegen context (read-only, passed through all emit calls)
# ---------------------------------------------------------------------------

export type CgCtx (..) =
  | CgCtx
      (Dict FnSig)
      (Dict CtorSig)
      (Dict GlobalInfo)
      (Set)
      (Dict FnSig)
      (String)
      (Dict Int)
      (Dict FnSig)
      (Set)
  # fn_sigs, ctor_sigs, globals, adt_names, extern_sigs, scope, cpr_fns, cpr_extern_sigs, mutual_tco_fns

# ---------------------------------------------------------------------------
# Public result type
# ---------------------------------------------------------------------------

export type IrResult (..) =
  | IrOk String
  | IrErr String

export type IrLinesResult (..) =
  | IrLinesOk (List String) (List String) (List String) (List String) (List String)
  # header_lines, str_lines, def_lines, dbg_lines, warn_msgs
  | IrLinesErr String

# ===========================================================================
# Section 1 — LLVM type constants
# ===========================================================================

fn ll_i64() -> String = "i64"
fn ll_i32() -> String = "i32"
fn ll_i1() -> String = "i1"
fn ll_ptr() -> String = "ptr"

fn tuple_ll(items: List String) -> String =
  "{ " ++ string.join(", ", items) ++ " }"

fn join_args_str(a: String, b: String) -> String =
  if a == "" && b == "" then ""
  else if a == "" then b
  else if b == "" then a
  else a ++ ", " ++ b

fn format_ll_ir(ll: String, ir: String) -> String = ll ++ " " ++ ir

# ===========================================================================
# Section 2 — Type → LLType
# ===========================================================================

# Map a Sprout types.Type to its LLVM type string.
# Type variables → "i64" (monomorphise to opaque i64).
# Tuples → "{ ll0, ll1, ... }".
# Functions → "ptr" (all callables are closure pointers).
# Everything else (ADTs, containers, Unit, …) → "i64".
fn type_to_ll(t: types.Type) -> String =
  match t with
  | types.TConst name -> const_to_ll(name)
  | types.TVar _ -> ll_i64()
  | types.TApp _ _ -> ll_i64()
  | types.TFunc _ _ _ -> ll_ptr()
  | types.TTuple items -> tuple_ll(list_map(\i -> type_to_ll(i), items))

fn normalize_lambda_param_ll(ll: String) -> String =
  if str_starts_with(ll, "{ ") then ll_i64()
  else ll

fn const_to_ll(name: String) -> String =
  if type_name_leaf_is(name, "Int") then ll_i64()
  else if type_name_leaf_is(name, "Bool") then ll_i1()
  else if type_name_leaf_is(name, "String") then ll_i64()
  else if type_name_leaf_is(name, "Char") then ll_i64()
  else ll_i64()  # Unit, Set, Bytes, Builder, IntRange, ADT names, …

fn type_name_leaf_is(name: String, leaf: String) -> Bool =
  name == leaf || string_ends_with(name, "." ++ leaf)

fn string_ends_with(raw: String, suffix: String) -> Bool =
  str_len(raw) >= str_len(suffix) &&
  str_slice(raw, str_len(raw) - str_len(suffix), str_len(raw)) == suffix

# Peel all TFunc layers to get the flat (params, ret) pair.
fn call_sig_from_type(t: types.Type) -> Maybe CallSig =
  call_sig_acc(t, Nil)

fn call_sig_acc(t: types.Type, acc: List String) -> Maybe CallSig =
  match t with
  | types.TFunc param ret _ ->
      call_sig_acc(ret, acc ++ Cons(type_to_ll(param), Nil))
  | _ ->
      match acc with
      | Nil -> Nothing
      | _ -> Just(CallSig(acc, type_to_ll(t), Nothing))

# Check whether a type is a Maybe type (TApp (TConst "Maybe") _).
fn is_maybe_type(t: types.Type) -> Bool =
  match t with
  | types.TApp (types.TConst "Maybe") _ -> true
  | _ -> false

# Check whether a type is a Result type (TApp (TApp (TConst "Result") _) _).
fn is_result_type(t: types.Type) -> Bool =
  match t with
  | types.TApp (types.TApp(types.TConst "Result") _) _ -> true
  | _ -> false

fn is_string_type(t: types.Type) -> Bool =
  match t with
  | types.TConst "String" -> true
  | _ -> false

fn is_char_type(t: types.Type) -> Bool =
  match t with
  | types.TConst "Char" -> true
  | _ -> false

fn is_list_type(t: types.Type) -> Bool =
  match t with
  | types.TApp (types.TConst "List") _ -> true
  | _ -> false

# ===========================================================================
# Section 3 — Value constructors / accessors
# ===========================================================================

fn val_make(ll: String, ir: String) -> Value =
  Value(ll, ir, Nothing, Nothing, Nothing)

fn val_for_ll(ll: String, ir: String) -> Value =
  val_with_tuple_items(val_make(ll, ir), tuple_items_from_ll(ll))

fn val_ll(v: Value) -> String =
  match v with | Value ll _ _ _ _ -> ll

fn val_ir(v: Value) -> String =
  match v with | Value _ ir _ _ _ -> ir

fn val_call_sig(v: Value) -> Maybe CallSig =
  match v with | Value _ _ cs _ _ -> cs

fn val_tuple_items(v: Value) -> Maybe (List String) =
  match v with | Value _ _ _ ti _ -> ti

fn val_tco_args(v: Value) -> Maybe (List Value) =
  match v with | Value _ _ _ _ ta -> ta

fn val_with_call_sig(v: Value, cs: Maybe CallSig) -> Value =
  match v with | Value ll ir _ ti ta -> Value(ll, ir, cs, ti, ta)

fn val_with_tuple_items(v: Value, ti: Maybe (List String)) -> Value =
  match v with | Value ll ir cs _ ta -> Value(ll, ir, cs, ti, ta)

fn val_with_tco_args(v: Value, ta: Maybe (List Value)) -> Value =
  match v with | Value ll ir cs ti _ -> Value(ll, ir, cs, ti, ta)

fn val_is_i64(v: Value) -> Bool = val_ll(v) == ll_i64()
fn val_is_i1(v: Value) -> Bool = val_ll(v) == ll_i1()
fn val_is_ptr(v: Value) -> Bool = val_ll(v) == ll_ptr()

fn val_is_tuple(v: Value) -> Bool =
  str_starts_with(val_ll(v), "{ ")

# CallSig accessors
fn sig_params(s: CallSig) -> List String =
  match s with | CallSig ps _ _ -> ps

fn sig_ret(s: CallSig) -> String =
  match s with | CallSig _ r _ -> r

fn sig_ret_sig(s: CallSig) -> Maybe CallSig =
  match s with | CallSig _ _ rs -> rs

# CtorSig accessors
fn ctor_name(c: CtorSig) -> String =
  match c with | CtorSig n _ _ _ _ -> n

fn ctor_tag(c: CtorSig) -> Int =
  match c with | CtorSig _ t _ _ _ -> t

fn ctor_arg_lls(c: CtorSig) -> List String =
  match c with | CtorSig _ _ ls _ _ -> ls

fn ctor_type_exprs(c: CtorSig) -> List ast.TypeExpr =
  match c with | CtorSig _ _ _ es _ -> es

fn ctor_type_params(c: CtorSig) -> List String =
  match c with | CtorSig _ _ _ _ ps -> ps

fn ctor_arity(c: CtorSig) -> Int =
  list_length(ctor_arg_lls(c))

# Wrap ctors are stored with tag = wrap_tag() as a sentinel. They are never
# registered via @sprout_register_ctor (no runtime tag exists), and their
# construction/destruction are emitted as identity at the IR level.
fn wrap_tag() -> Int = -1

fn ctor_is_wrap(c: CtorSig) -> Bool =
  ctor_tag(c) == wrap_tag()

# FnSig accessors
fn fn_name(f: FnSig) -> String =
  match f with | FnSig n _ _ _ -> n

fn fn_params(f: FnSig) -> List String =
  match f with | FnSig _ ps _ _ -> ps

fn fn_ret(f: FnSig) -> String =
  match f with | FnSig _ _ r _ -> r

fn fn_ret_sig(f: FnSig) -> Maybe CallSig =
  match f with | FnSig _ _ _ rs -> rs

fn fn_sig_to_call_sig(f: FnSig) -> CallSig =
  CallSig(fn_params(f), fn_ret(f), fn_ret_sig(f))

fn fn_arity(f: FnSig) -> Int =
  list_length(fn_params(f))

# GlobalInfo accessors
fn gi_ll(g: GlobalInfo) -> String =
  match g with | GlobalInfo ll _ _ _ -> ll

fn gi_is_const(g: GlobalInfo) -> Bool =
  match g with | GlobalInfo _ c _ _ -> c

fn gi_const_ir(g: GlobalInfo) -> Maybe String =
  match g with | GlobalInfo _ _ ci _ -> ci

fn gi_call_sig(g: GlobalInfo) -> Maybe CallSig =
  match g with | GlobalInfo _ _ _ cs -> cs

# TcoCtx accessors
fn tco_fn_name(t: TcoCtx) -> String =
  match t with | TcoCtx n _ _ _ _ _ _ -> n

fn tco_loop_lbl(t: TcoCtx) -> String =
  match t with | TcoCtx _ l _ _ _ _ _ -> l

fn tco_slots(t: TcoCtx) -> List (String, String) =
  match t with | TcoCtx _ _ s _ _ _ _ -> s

fn tco_ret_ll(t: TcoCtx) -> String =
  match t with | TcoCtx _ _ _ r _ _ _ -> r

fn tco_n_roots(t: TcoCtx) -> Int =
  match t with | TcoCtx _ _ _ _ nr _ _ -> nr

fn tco_outer_roots(t: TcoCtx) -> Int =
  match t with | TcoCtx _ _ _ _ _ or _ -> or

fn tco_sp_save(t: TcoCtx) -> String =
  match t with | TcoCtx _ _ _ _ _ _ sp -> sp

fn tco_with_outer_roots(t: TcoCtx, n: Int) -> TcoCtx =
  match t with | TcoCtx fnm lp sl rt nr _ sp -> TcoCtx(fnm, lp, sl, rt, nr, n, sp)

# ===========================================================================
# Section 4 — EmitterState helpers
# ===========================================================================

# --- EmitterState unwrap ---

fn em_es(em: Emitter) -> EmitterState =
  match em with | Emitter es _ _ -> es

fn em_dbg(em: Emitter) -> DbgEmitter =
  match em with | Emitter _ dbg _ -> dbg

fn em_warns_ref(em: Emitter) -> Ref (List String) =
  match em with | Emitter _ _ wr -> wr

# --- DbgEmitter accessors ---

fn em_dbg_mode(em: Emitter) -> Bool =
  match em_dbg(em) with | DbgEmitter dm _ _ _ _ _ _ -> dm

fn em_dbg_src(em: Emitter) -> String =
  match em_dbg(em) with | DbgEmitter _ sf _ _ _ _ _ -> sf

fn em_meta_id_ref(em: Emitter) -> Ref Int =
  match em_dbg(em) with | DbgEmitter _ _ mc _ _ _ _ -> mc

fn em_meta_lines_ref(em: Emitter) -> Ref (List String) =
  match em_dbg(em) with | DbgEmitter _ _ _ ml _ _ _ -> ml

fn em_sp_id_ref(em: Emitter) -> Ref Int =
  match em_dbg(em) with | DbgEmitter _ _ _ _ sp _ _ -> sp

fn em_loc_id_ref(em: Emitter) -> Ref Int =
  match em_dbg(em) with | DbgEmitter _ _ _ _ _ lc _ -> lc

fn em_header_offset(em: Emitter) -> Int =
  match em_dbg(em) with | DbgEmitter _ _ _ _ _ _ ho -> ho

# --- field-Ref accessors (pure) — unwrap Emitter → EmitterState ---

fn es_body_ref(em: Emitter) -> Ref (List String) =
  match em_es(em) with | EmitterState b _ _ _ _ _ _ _ _ -> b

fn es_all_defs_ref(em: Emitter) -> Ref (List String) =
  match em_es(em) with | EmitterState _ a _ _ _ _ _ _ _ -> a

fn es_str_glbs_ref(em: Emitter) -> Ref (List String) =
  match em_es(em) with | EmitterState _ _ sg _ _ _ _ _ _ -> sg

fn es_fn_wrap_ref(em: Emitter) -> Ref (Dict String) =
  match em_es(em) with | EmitterState _ _ _ fw _ _ _ _ _ -> fw

fn es_cur_blk_ref(em: Emitter) -> Ref CurBlk =
  match em_es(em) with | EmitterState _ _ _ _ cb _ _ _ _ -> cb

fn es_next_tmp_ref(em: Emitter) -> Ref Int =
  match em_es(em) with | EmitterState _ _ _ _ _ nt _ _ _ -> nt

fn es_next_blk_ref(em: Emitter) -> Ref Int =
  match em_es(em) with | EmitterState _ _ _ _ _ _ nb _ _ -> nb

fn es_next_str_ref(em: Emitter) -> Ref Int =
  match em_es(em) with | EmitterState _ _ _ _ _ _ _ ns _ -> ns

fn es_next_lam_ref(em: Emitter) -> Ref Int =
  match em_es(em) with | EmitterState _ _ _ _ _ _ _ _ nl -> nl

# --- field value-getters (IO, reads through the Ref) ---

fn es_body(em: Emitter) -> List String !{IO} =
  ref_read(es_body_ref(em))

fn es_all_defs(em: Emitter) -> List String !{IO} =
  ref_read(es_all_defs_ref(em))

fn es_str_glbs(em: Emitter) -> List String !{IO} =
  ref_read(es_str_glbs_ref(em))

fn es_fn_wrap(em: Emitter) -> Dict String !{IO} =
  ref_read(es_fn_wrap_ref(em))

fn es_cur_blk(em: Emitter) -> CurBlk !{IO} =
  ref_read(es_cur_blk_ref(em))

# --- mutation helpers (operate directly on the field Refs) ---

fn es_add_line(em: Emitter, line: String) -> Unit !{IO} =
  do
    let r = es_body_ref(em)
    cur <- ref_read(r)
    ref_write(r, Cons(line, cur))

fn es_set_cur_blk(em: Emitter, blk: CurBlk) -> Unit !{IO} =
  ref_write(es_cur_blk_ref(em), blk)

fn es_add_def(em: Emitter, line: String) -> Unit !{IO} =
  do
    let r = es_all_defs_ref(em)
    cur <- ref_read(r)
    ref_write(r, Cons(line, cur))

fn es_add_str_glb(em: Emitter, line: String) -> Unit !{IO} =
  do
    let r = es_str_glbs_ref(em)
    cur <- ref_read(r)
    ref_write(r, Cons(line, cur))

fn es_set_fn_wrap(em: Emitter, fn_n: String, wrap_n: String) -> Unit !{IO} =
  do
    let r = es_fn_wrap_ref(em)
    fw <- ref_read(r)
    ref_write(r, dict_set(fn_n, wrap_n, fw))

fn es_reset_body(em: Emitter) -> Unit !{IO} =
  do
    ref_write(es_body_ref(em), Nil)
    ref_write(es_cur_blk_ref(em), NoBlk)

fn es_adopt_body(em: Emitter, lines: List String, blk: CurBlk) -> Unit !{IO} =
  do
    ref_write(es_body_ref(em), lines)
    ref_write(es_cur_blk_ref(em), blk)

# ===========================================================================
# Section 4b — Debug metadata helpers
# ===========================================================================
#
# Metadata IDs 0–5 are statically reserved for the module-level DWARF preamble
# (see assemble_debug_section).  Per-function and per-expression metadata nodes
# are allocated starting at ID 6 via alloc_meta_id.

# ---------------------------------------------------------------------------
# Milestone A: header-line offset helpers
#
# strip_headers removes module/import/blank lines before parsing; SourcePos
# line numbers are relative to the stripped source.  We count the stripped
# lines here so emit_fn_dbg can add the offset back, giving lldb accurate
# file line numbers.

# Byte-indexed header scanning. The module/import header region is ASCII by
# language spec, so codepoint indices and byte indices coincide; we use byte
# offsets here to skip str_slice's codepoint→byte conversion walks and to
# cache the source length once (`total`) instead of recomputing per iteration.
# Saves O(header_lines × source_bytes) work per IR emission.
fn dbg_next_line(s: String, byte_pos: Int, total: Int) -> Int =
  if nl == -1 then total
  else byte_pos + nl + 1
  where nl = str_find(str_slice_bytes(s, byte_pos, total - byte_pos), "\n")

fn dbg_is_header_line(s: String, byte_pos: Int, total: Int) -> Bool =
  str_starts_with(sl, "module ") ||
  str_starts_with(sl, "import ") ||
  str_starts_with(sl, "\n")
  where sl = str_slice_bytes(s, byte_pos, total - byte_pos)

# Internal recursive loop with cached `total = str_byte_len(src)`.
fn dbg_count_header_lines_loop(src: String, byte_pos: Int, count: Int, total: Int) -> Int =
  if byte_pos >= total then count
  else if dbg_is_header_line(src, byte_pos, total) then dbg_count_header_lines_loop(src, dbg_next_line(src, byte_pos, total), count + 1, total)
  else count

# Public entry — signature unchanged for the single call site below; computes
# the source byte length once and threads it through.
fn dbg_count_header_lines(src: String, pos: Int, count: Int) -> Int =
  dbg_count_header_lines_loop(src, pos, count, str_byte_len(src))

fn alloc_meta_id(em: Emitter) -> Int !{IO} =
  do
    let r = em_meta_id_ref(em)
    n <- ref_read(r)
    ref_write(r, n + 1)
    n

fn add_meta_line(em: Emitter, line: String) -> Unit !{IO} =
  do
    let r = em_meta_lines_ref(em)
    cur <- ref_read(r)
    ref_write(r, Cons(line, cur))

fn set_current_sp_id(em: Emitter, sp_id: Int) -> Unit !{IO} =
  ref_write(em_sp_id_ref(em), sp_id)

fn set_current_loc_id(em: Emitter, loc_id: Int) -> Unit !{IO} =
  ref_write(em_loc_id_ref(em), loc_id)

fn reset_debug_fn_state(em: Emitter) -> Unit !{IO} =
  do
    set_current_sp_id(em, 0)
    set_current_loc_id(em, 0)

# Produce the complete 4th IR section: named metadata references followed by
# all numbered metadata nodes (preamble IDs 0-5 first, then accumulated lines).
#
# Static preamble layout (IDs always assigned in this order):
#   !0  = DICompileUnit
#   !1  = module flag entry: Dwarf Version
#   !2  = module flag entry: Debug Info Version
#   !3  = DIFile
#   !4  = DISubroutineType (opaque, reused for all functions)
#   !5  = !{} (empty type-parameter list for DISubroutineType)
#
# meta_id_counter starts at 6 so per-function/per-expression nodes start at !6.
fn assemble_debug_section(em: Emitter) -> List String !{IO} =
  do
    meta_lines <- ref_read(em_meta_lines_ref(em))
    let src = em_dbg_src(em)
    let per_node_lines = list_reverse(meta_lines)
    list_append(debug_preamble_lines(src), per_node_lines)

fn debug_preamble_lines(src: String) -> List String =
  Cons("",
  Cons("; --- DWARF debug metadata ---",
  Cons("!llvm.dbg.cu = !{!0}",
  Cons("!llvm.module.flags = !{!1, !2}",
  Cons("!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !3, producer: \"sprout\", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug, splitDebugInlining: false)",
  Cons("!1 = !{i32 2, !\"Dwarf Version\", i32 5}",
  Cons("!2 = !{i32 2, !\"Debug Info Version\", i32 3}",
  Cons("!3 = !DIFile(filename: \"" ++ src ++ "\", directory: \".\")",
  Cons("!4 = !DISubroutineType(types: !5)",
  Cons("!5 = !{}", Nil))))))))))

# ===========================================================================
# Section 5 — High-level Emitter operations
# ===========================================================================

fn new_emitter(debug_mode_: Bool, source_file_: String) -> Emitter !{IO} =
  do
    body_ref <- ref_new(Nil)
    defs_ref <- ref_new(Nil)
    strs_ref <- ref_new(Nil)
    wrap_ref <- ref_new(dict_empty())
    blk_ref <- ref_new(NoBlk)
    nt_ref <- ref_new(0)
    nb_ref <- ref_new(0)
    ns_ref <- ref_new(0)
    nl_ref <- ref_new(0)
    meta_id_ref <- ref_new(6)
    meta_lines_ref <- ref_new(Nil)
    sp_id_ref <- ref_new(0)
    loc_id_ref <- ref_new(0)
    header_offset <-
      if debug_mode_ then
        match read_file(source_file_) with
        | Err _ -> 0
        | Ok src -> dbg_count_header_lines(src, 0, 0)
      else 0
    let es = EmitterState(body_ref, defs_ref, strs_ref, wrap_ref, blk_ref, nt_ref, nb_ref, ns_ref, nl_ref)
    let dbg = DbgEmitter(debug_mode_, source_file_, meta_id_ref, meta_lines_ref, sp_id_ref, loc_id_ref, header_offset)
    warns_ref <- ref_new(Nil)
    Emitter(es, dbg, warns_ref)

fn emit_line(em: Emitter, line: String) -> Unit !{IO} =
  do
    loc_id <- ref_read(em_loc_id_ref(em))
    let tagged = if loc_id == 0 then line
                 else if str_find(line, " call ") >= 0 then line ++ ", !dbg !" ++ int_to_string(loc_id)
                 else line
    es_add_line(em, tagged)

# Emit a StringTemplate as a single body line.
# Assembly joins body entries with "\n", so we must collapse all template
# parts into one string before pushing — using string_concat_many (one
# allocation per logical line, no ++ chains).
fn emit_template(em: Emitter, t: StringTemplate) -> Unit !{IO} =
  match t with
  | StringTemplate parts ->
      emit_line(em, string_concat_many(template_parts_to_strings(parts)))

fn emit_label(em: Emitter, name: String) -> Unit !{IO} =
  do
    es_add_line(em, name ++ ":")
    es_set_cur_blk(em, SomeBlk(name))

fn fresh_tmp(em: Emitter) -> String !{IO} =
  do
    let r = es_next_tmp_ref(em)
    n <- ref_read(r)
    ref_write(r, n + 1)
    "%t" ++ int_to_string(n)

fn fresh_block(em: Emitter, prefix: String) -> String !{IO} =
  do
    let r = es_next_blk_ref(em)
    n <- ref_read(r)
    ref_write(r, n + 1)
    prefix ++ int_to_string(n)

fn fresh_lambda_idx(em: Emitter) -> Int !{IO} =
  do
    let r = es_next_lam_ref(em)
    n <- ref_read(r)
    ref_write(r, n + 1)
    n

fn add_def_line(em: Emitter, line: String) -> Unit !{IO} =
  es_add_def(em, line)

fn add_str_global(em: Emitter, line: String) -> Unit !{IO} =
  es_add_str_glb(em, line)

fn set_fn_wrapper(em: Emitter, fn_n: String, wrap_n: String) -> Unit !{IO} =
  es_set_fn_wrap(em, fn_n, wrap_n)

fn read_cur_blk_or(em: Emitter, default_blk: String) -> String !{IO} =
  do
    cb <- es_cur_blk(em)
    match cb with
    | NoBlk -> default_blk
    | SomeBlk name -> name

fn is_terminated(em: Emitter) -> Bool !{IO} =
  do
    body <- es_body(em)
    is_terminated_lines(body)

# body is stored in reverse (head = most recent line).
fn is_terminated_lines(lines: List String) -> Bool =
  match lines with
  | Nil -> false
  | Cons line rest ->
      if line == "" then is_terminated_lines(rest)
      else if is_block_label(line) then false
      else is_terminator_line(str_trim_spaces(line))

fn is_block_label(line: String) -> Bool =
  str_len(line) > 0
  && str_starts_with(line, " ") == false
  && str_ends_with_colon(line)

fn str_ends_with_colon(s: String) -> Bool =
  if n == 0 then false
  else str_slice(s, n - 1, n) == ":"
  where n = str_len(s)

fn is_terminator_line(trimmed: String) -> Bool =
  str_starts_with(trimmed, "br ")
  || str_starts_with(trimmed, "ret ")
  || trimmed == "unreachable"

fn str_trim_spaces(s: String) -> String =
  if str_len(s) == 0 then s
  else
    match str_char_at(s, 0) with
    | Nothing -> s
    | Just ch ->
        if char_to_string(ch) == " " || char_to_string(ch) == "\t"
        then str_trim_spaces(str_slice(s, 1, str_len(s)))
        else s

# Save the current body lines, leaving em with an empty body.
# Used when starting to build a lambda/wrapper function definition.
fn save_body(em: Emitter) -> (List String, CurBlk) !{IO} =
  do
    saved_lines <- es_body(em)
    saved_blk <- es_cur_blk(em)
    es_reset_body(em)
    (saved_lines, saved_blk)

# Restore a previously-saved body into em.
fn restore_body(em: Emitter, saved: (List String, CurBlk)) -> Unit !{IO} =
  match saved with
  | (lines, blk) -> es_adopt_body(em, lines, blk)

# Flush and return the current body as a reversed line list (for building defs).
fn flush_body(em: Emitter) -> List String !{IO} =
  do
    body <- es_body(em)
    let lines = list_reverse(body)
    es_reset_body(em)
    lines

# ===========================================================================
# Section 6 — String constant encoding
# ===========================================================================
#
# LLVM IR string constants use c"..." syntax where bytes are written either
# as printable ASCII or as \XX hex escapes.  We handle the common special
# characters explicitly and pass through all other single-byte characters
# directly.  Multi-byte UTF-8 code points are passed through unchanged (they
# render as raw bytes in the IR — correct for ASCII-only source strings).

fn escape_char_for_ir(ch: Char) -> String =
  if s == "\\" then "\\5C"
  else if s == "\"" then "\\22"
  else if s == "\n" then "\\0A"
  else if s == "\r" then "\\0D"
  else if s == "\t" then "\\09"
  else s
  where s = char_to_string(ch)

fn encode_str_for_ir(s: String, i: Int, acc: String) -> String =
  if i >= str_len(s) then acc
  else
    match str_char_at(s, i) with
    | Nothing -> acc
    | Just ch -> encode_str_for_ir(s, i + 1, acc ++ escape_char_for_ir(ch))

# Emit a string literal as a private LLVM global constant and return
# (global_name, byte_length_including_null).
fn string_const(em: Emitter, s: String) -> (String, Int) !{IO} =
  do
    let r = es_next_str_ref(em)
    n <- ref_read(r)
    ref_write(r, n + 1)
    let gname = "@.str." ++ int_to_string(n)
    let body = encode_str_for_ir(s, 0, "") ++ "\\00"
    let len = str_byte_len(s) + 1
    let decl = gname ++ " = private unnamed_addr constant [" ++
                int_to_string(len) ++ " x i8] c\"" ++ body ++ "\""
    add_str_global(em, decl)
    (gname, len)

# Emit a string constant and return a ptr Value pointing to it.
fn emit_str_ptr(em: Emitter, s: String) -> Value !{IO} =
  do
    (gname, len) <- string_const(em, s)
    tmp <- fresh_tmp(em)
    emit_template(em, `  ${tmp} = getelementptr inbounds [${int_to_string (len)} x i8], ptr ${gname}, i64 0, i64 0`)
    Value(ll_ptr(), tmp, Nothing, Nothing, Nothing)

# ===========================================================================
# Section 7 — Sizeof struct (for GC scan-root registration)
# ===========================================================================

fn sizeof_struct(struct_type: String, em: Emitter) -> String !{IO} =
  do
    size_ptr <- fresh_tmp(em)
    emit_template(em, `  ${size_ptr} = getelementptr ${struct_type}, ptr null, i32 1`)
    size <- fresh_tmp(em)
    emit_template(em, `  ${size} = ptrtoint ptr ${size_ptr} to i64`)
    size

# ===========================================================================
# Section 8 — GC root management
# ===========================================================================

# Returns true for Sprout source-level types that are guaranteed to be pure
# scalars and can never be GC-managed heap pointers.  Only whitelisted
# TConst names — everything else (TVars, TApp, ADT names, Unit, …) may
# resolve to a heap object and must be rooted conservatively.
fn type_is_non_heap_scalar(t: types.Type) -> Bool =
  match t with
  | types.TConst name ->
      type_name_leaf_is(name, "Int") ||
      type_name_leaf_is(name, "Bool") ||
      type_name_leaf_is(name, "Char")
  | _ -> false

# Returns true when an ast.TypeExpr annotation declares a non-heap scalar.
# Used only when we have the annotation from ast.Param; returns false when
# uncertain (Nothing annotation or non-scalar type).
fn type_expr_is_non_heap_scalar(te: ast.TypeExpr) -> Bool =
  match te with
  | ast.TypeName name ->
      type_name_leaf_is(name, "Int") ||
      type_name_leaf_is(name, "Bool") ||
      type_name_leaf_is(name, "Char")
  | _ -> false

# Push a temporary GC root for `v`.  Returns the number of roots pushed (0 or 1).
# We skip pushing for Bool (i1) — it is never a heap pointer.
fn push_temp_root(v: Value, em: Emitter) -> Int !{IO} =
  if val_is_i64(v) then
    do
      slot <- fresh_tmp(em)
      emit_template(em, `  ${slot} = alloca i64`)
      emit_template(em, `  store i64 ${val_ir (v)}, ptr ${slot}`)
      reg <- fresh_tmp(em)
      emit_template(em, `  ${reg} = call i64 @sprout_gc_push_i64_root(ptr ${slot})`)
      1
  else if val_is_ptr(v) then
    do
      slot <- fresh_tmp(em)
      emit_template(em, `  ${slot} = alloca ptr`)
      emit_template(em, `  store ptr ${val_ir (v)}, ptr ${slot}`)
      reg <- fresh_tmp(em)
      emit_template(em, `  ${reg} = call i64 @sprout_gc_push_ptr_root(ptr ${slot})`)
      1
  else if val_is_tuple(v) then
    do
      let ll = val_ll(v)
      slot <- fresh_tmp(em)
      emit_template(em, `  ${slot} = alloca ${ll}`)
      emit_template(em, `  store ${ll} ${val_ir (v)}, ptr ${slot}`)
      sz <- sizeof_struct(ll, em)
      reg <- fresh_tmp(em)
      emit_template(em, `  ${reg} = call i64 @sprout_gc_push_scan_root(ptr ${slot}, i64 ${sz})`)
      1
  else
    0  # i1 (Bool) — never a GC-managed heap pointer

# Typed variant: skip rooting entirely when the source-level Sprout type is a
# known non-heap scalar (Int, Bool, Char).  Falls back to push_temp_root for
# all other types, including TVars and polymorphic types, which may resolve to
# heap objects at runtime.
fn push_temp_root_typed(v: Value, ty: types.Type, em: Emitter) -> Int !{IO} =
  if type_is_non_heap_scalar(ty) then 0
  else push_temp_root(v, em)

fn pop_temp_roots(count: Int, em: Emitter) -> Unit !{IO} =
  if count <= 0 then ()
  else
    do
      reg <- fresh_tmp(em)
      emit_template(em, `  ${reg} = call i64 @sprout_gc_pop_roots(i64 ${int_to_string (count)})`)

# Push temp roots for each value in the list; return total root count.
fn push_roots_list(vals: List Value, em: Emitter) -> Int !{IO} =
  match vals with
  | Nil -> 0
  | Cons v rest ->
      do
        n <- push_temp_root(v, em)
        ns <- push_roots_list(rest, em)
        n + ns

# ===========================================================================
# Section 9 — Pack / coerce
# ===========================================================================

# Pack a value to an i64 (for constructor arguments, which are always i64).
fn pack_to_i64(v: Value, em: Emitter) -> String !{IO} =
  if val_is_i64(v) then val_ir(v)
  else if val_is_i1(v) then
    do
      w <- fresh_tmp(em)
      emit_template(em, `  ${w} = zext i1 ${val_ir (v)} to i64`)
      w
  else if val_is_ptr(v) then
    do
      w <- fresh_tmp(em)
      emit_template(em, `  ${w} = ptrtoint ptr ${val_ir (v)} to i64`)
      w
  else if val_is_tuple(v) then
    match val_tuple_items(v) with
    | Nothing ->
        do
          let ll = val_ll(v)
          rooted <- push_temp_root(v, em)
          sz <- sizeof_struct(ll, em)
          raw_i64 <- fresh_tmp(em)
          emit_template(em, `  ${raw_i64} = call i64 @sprout_alloc_tuple_blob(i64 ${sz})`)
          raw_ptr <- fresh_tmp(em)
          emit_template(em, `  ${raw_ptr} = inttoptr i64 ${raw_i64} to ptr`)
          emit_template(em, `  store ${ll} ${val_ir (v)}, ptr ${raw_ptr}`)
          pop_temp_roots(rooted, em)
          raw_i64
    | Just items ->
        do
          let ll = val_ll(v)
          let blob_sz = int_to_string(list_length(items) * 8)
          rooted <- push_temp_root(v, em)
          raw_i64 <- fresh_tmp(em)
          emit_template(em, `  ${raw_i64} = call i64 @sprout_alloc_tuple_blob(i64 ${blob_sz})`)
          blob_slot <- fresh_tmp(em)
          emit_template(em, `  ${blob_slot} = alloca i64`)
          emit_template(em, `  store i64 ${raw_i64}, ptr ${blob_slot}`)
          blob_root <- fresh_tmp(em)
          emit_template(em, `  ${blob_root} = call i64 @sprout_gc_push_i64_root(ptr ${blob_slot})`)
          raw_ptr <- fresh_tmp(em)
          emit_template(em, `  ${raw_ptr} = inttoptr i64 ${raw_i64} to ptr`)
          pack_tuple_fields_to_blob(ll, val_ir(v), items, raw_ptr, 0, em)
          pop_temp_roots(rooted + 1, em)
          raw_i64
  else
    val_ir(v)  # fallback

# Store each tuple field into a heap blob at one-i64-per-field stride.
# Each field is individually normalized via pack_to_i64 before storing,
# which handles nested tuple fields (which would otherwise be stored as
# multi-word LLVM structs, breaking the GEP-i64 reader in the runtime).
fn pack_tuple_fields_to_blob(src_ll: String, src_ir: String, items: List String, blob_ptr: String, idx: Int, em: Emitter) -> Unit !{IO} =
  match items with
  | Nil -> ()
  | Cons item_ll rest ->
      do
        field_ir <- fresh_tmp(em)
        emit_template(em, `  ${field_ir} = extractvalue ${src_ll} ${src_ir}, ${int_to_string(idx)}`)
        let field_v = val_with_tuple_items(val_make(item_ll, field_ir), tuple_items_from_ll(item_ll))
        packed <- pack_to_i64(field_v, em)
        gep <- fresh_tmp(em)
        emit_template(em, `  ${gep} = getelementptr i64, ptr ${blob_ptr}, i64 ${int_to_string(idx)}`)
        emit_template(em, `  store i64 ${packed}, ptr ${gep}`)
        pack_tuple_fields_to_blob(src_ll, src_ir, rest, blob_ptr, idx + 1, em)

# Coerce a value to the target lltype.
fn coerce_value(v: Value, target: String, em: Emitter) -> Value !{IO} =
  if val_ll(v) == target then v
  else if target == ll_i64() then
    do
      packed <- pack_to_i64(v, em)
      val_make(ll_i64(), packed)
  else if val_ll(v) == ll_i64() && str_starts_with(target, "{ ") then
    do
      ptr <- fresh_tmp(em)
      emit_template(em, `  ${ptr} = inttoptr i64 ${val_ir (v)} to ptr`)
      out <- fresh_tmp(em)
      emit_template(em, `  ${out} = load ${target}, ptr ${ptr}`)
      val_with_tuple_items(val_make(target, out), tuple_items_from_ll(target))
  else if val_ll(v) == ll_i64() && target == ll_i1() then
    do
      out <- fresh_tmp(em)
      emit_template(em, `  ${out} = trunc i64 ${val_ir (v)} to i1`)
      val_make(ll_i1(), out)
  else if val_ll(v) == ll_i64() && target == ll_ptr() then
    do
      out <- fresh_tmp(em)
      emit_template(em, `  ${out} = inttoptr i64 ${val_ir (v)} to ptr`)
      val_make(ll_ptr(), out)
  else
    v  # best-effort fallback

# Parse tuple item types out of a type string like "{ i64, i1, ptr }".
# We do a simple linear scan splitting on ", " at depth 0.
fn tuple_items_from_ll(ll: String) -> Maybe (List String) =
  if str_starts_with(ll, "{ ") && str_ends_with_colon2(ll) then
    Just(split_ll_types(str_slice(ll, 2, str_len(ll) - 4), 0, 0, "", Nil))
  else Nothing

fn str_ends_with_colon2(s: String) -> Bool =
  if n < 2 then false
  else str_slice(s, n - 2, n) == " }"
  where n = str_len(s)

fn split_ll_types(s: String, i: Int, depth: Int, cur: String, acc: List String) -> List String =
  if i >= str_len(s) then
    if str_len(cur) > 0 then list_reverse(Cons(cur, acc))
    else list_reverse(acc)
  else
    match str_char_at(s, i) with
    | Nothing -> list_reverse(acc)
    | Just ch ->
        match char_to_string(ch) with
        | c ->
            if c == "{" then split_ll_types(s, i + 1, depth + 1, cur ++ c, acc)
            else if c == "}" then split_ll_types(s, i + 1, depth - 1, cur ++ c, acc)
            else if c == "," && depth == 0 then
              split_ll_types(s, i + 2, 0, "", Cons(cur, acc))
            else split_ll_types(s, i + 1, depth, cur ++ c, acc)

fn zero_init(ll: String) -> String =
  if ll == ll_ptr() then "null"
  else if str_starts_with(ll, "{ ") then "zeroinitializer"
  else "0"

fn zero_val(ll: String) -> Value =
  val_for_ll(ll, zero_init(ll))

# ===========================================================================
# Section 10 — Pattern operations
# ===========================================================================

# Collect all names bound by a pattern.
fn pbn_acc(acc: List String, p: ast.Pattern) -> List String =
  list_append(acc, pattern_bound_names(p))

fn pattern_bound_names(pat: ast.Pattern) -> List String =
  match pat with
  | ast.VarPattern name _ -> Cons(name, Nil)
  | ast.TuplePattern items _ -> list_fold(pbn_acc, Nil, items)
  | ast.ConstructorPattern _ args _ -> list_fold(pbn_acc, Nil, args)
  | _ -> Nil

# Emit a boolean test for whether `scrut` matches `pat`.
# Returns a Value of type i1.
fn emit_pattern_test(pat: ast.Pattern, scrut: Value, ctx: CgCtx, em: Emitter) -> Value !{IO} =
  match pat with
  | ast.WildcardPattern _ -> val_make(ll_i1(), "1")
  | ast.VarPattern _ _ -> val_make(ll_i1(), "1")
  | ast.IntPattern n _ ->
      do
        tmp <- fresh_tmp(em)
        emit_template(em, `  ${tmp} = icmp eq i64 ${val_ir (scrut)}, ${int_to_string (n)}`)
        val_make(ll_i1(), tmp)
  | ast.BoolPattern b _ ->
      do
        let lit = if b then "1" else "0"
        tmp <- fresh_tmp(em)
        emit_template(em, `  ${tmp} = icmp eq i1 ${val_ir (scrut)}, ${lit}`)
        val_make(ll_i1(), tmp)
  | ast.StringPattern s _ ->
      do
        lit_v <- emit_str_ptr(em, s)
        scrut_ptr <- coerce_value(scrut, ll_ptr(), em)
        tmp <- fresh_tmp(em)
        emit_template(em, `  ${tmp} = call i1 @str_eq(ptr ${val_ir (scrut_ptr)}, ptr ${val_ir (lit_v)})`)
        val_make(ll_i1(), tmp)
  | ast.CharPattern ch _ ->
      do
        lit_v <- emit_str_ptr(em, char_to_string(ch))
        scrut_ptr <- coerce_value(scrut, ll_ptr(), em)
        tmp <- fresh_tmp(em)
        emit_template(em, `  ${tmp} = call i1 @str_eq(ptr ${val_ir (scrut_ptr)}, ptr ${val_ir (lit_v)})`)
        val_make(ll_i1(), tmp)
  | ast.UnitPattern _ ->
      do
        tmp <- fresh_tmp(em)
        emit_template(em, `  ${tmp} = icmp eq i64 ${val_ir (scrut)}, 0`)
        val_make(ll_i1(), tmp)
  | ast.TuplePattern items _ ->
      emit_tuple_pattern_test(items, scrut, ctx, em, 0, val_make(ll_i1(), "1"))
  | ast.ConstructorPattern name args _ ->
      emit_ctor_pattern_test(name, args, scrut, ctx, em)

fn emit_tuple_pattern_test(items: List ast.Pattern, scrut: Value, ctx: CgCtx, em: Emitter, idx: Int, acc: Value) -> Value !{IO} =
  match items with
  | Nil -> acc
  | Cons item rest ->
      do
        field <- emit_tuple_field_by_idx(scrut, idx, em)
        test <- emit_pattern_test(item, field, ctx, em)
        and_t <- fresh_tmp(em)
        emit_template(em, `  ${and_t} = and i1 ${val_ir (acc)}, ${val_ir (test)}`)
        emit_tuple_pattern_test(rest, scrut, ctx, em, idx + 1, val_make(ll_i1(), and_t))

fn emit_ctor_pattern_test(name: String, args: List ast.Pattern, scrut: Value, ctx: CgCtx, em: Emitter) -> Value !{IO} =
  match ctx_ctor_sigs(ctx) with
  | ctors ->
      match dict_get(name, ctors) with
      | Nothing ->
          val_make(ll_i1(), "0")  # unknown ctor — never matches
      | Just ctor ->
          if ctor_is_wrap(ctor) then
            # Wrap has no tag; the only test is whether the inner pattern matches
            # the underlying value (scrut IS the inner value).
            match args with
            | Cons inner_pat Nil -> emit_pattern_test(inner_pat, scrut, ctx, em)
            | _ -> val_make(ll_i1(), "1")
          else do
            tag_t <- fresh_tmp(em)
            emit_template(em, `  ${tag_t} = call i64 @sprout_tag(i64 ${val_ir (scrut)})`)
            eq_t <- fresh_tmp(em)
            emit_template(em, `  ${eq_t} = icmp eq i64 ${tag_t}, ${int_to_string (ctor_tag(ctor))}`)
            match args with
            | Nil -> val_make(ll_i1(), eq_t)
            | _ -> emit_ctor_args_test(eq_t, scrut, ctor, args, ctx, em)

fn emit_ctor_args_test(eq_tag: String, handle: Value, ctor: CtorSig, args: List ast.Pattern, ctx: CgCtx, em: Emitter) -> Value !{IO} =
  do
    chk_lbl <- fresh_block(em, "ctor_chk")
    miss_lbl <- fresh_block(em, "ctor_miss")
    done_lbl <- fresh_block(em, "ctor_done")
    emit_template(em, `  br i1 ${eq_tag}, label %${chk_lbl}, label %${miss_lbl}`)
    emit_label(em, chk_lbl)
    last_ok <- emit_ctor_field_tests(args, ctor_arg_lls(ctor), handle, ctx, em, 0, miss_lbl)
    emit_template(em, `  br label %${done_lbl}`)
    emit_label(em, miss_lbl)
    emit_template(em, `  br label %${done_lbl}`)
    emit_label(em, done_lbl)
    phi <- fresh_tmp(em)
    emit_template(em, `  ${phi} = phi i1 [ 1, %${last_ok} ], [ 0, %${miss_lbl} ]`)
    val_make(ll_i1(), phi)

fn emit_ctor_field_tests(args: List ast.Pattern, arg_lls: List String, handle: Value, ctx: CgCtx, em: Emitter, idx: Int, miss_lbl: String) -> String !{IO} =
  match (args, arg_lls) with
  | (Nil, _) ->
      do
        cb <- es_cur_blk(em)
        match cb with | NoBlk -> miss_lbl | SomeBlk name -> name
  | (_, Nil) ->
      do
        cb <- es_cur_blk(em)
        match cb with | NoBlk -> miss_lbl | SomeBlk name -> name
  | (Cons arg rest_args, Cons arg_ll rest_lls) ->
      do
        field <- emit_ctor_field(val_ir(handle), idx, arg_ll, em)
        test <- emit_pattern_test(arg, field, ctx, em)
        next_lbl <- fresh_block(em, "ctor_next")
        emit_template(em, `  br i1 ${val_ir (test)}, label %${next_lbl}, label %${miss_lbl}`)
        emit_label(em, next_lbl)
        emit_ctor_field_tests(rest_args, rest_lls, handle, ctx, em, idx + 1, miss_lbl)

# Extract field idx from a ctor handle, coercing from i64 to the target type.
fn emit_ctor_field(handle_ir: String, idx: Int, ll: String, em: Emitter) -> Value !{IO} =
  do
    raw <- fresh_tmp(em)
    emit_template(em, `  ${raw} = call i64 @sprout_field(i64 ${handle_ir}, i64 ${int_to_string (idx)})`)
    if ll == ll_i64() then val_make(ll_i64(), raw)
    else if ll == ll_i1() then
      do
        out <- fresh_tmp(em)
        emit_template(em, `  ${out} = trunc i64 ${raw} to i1`)
        val_make(ll_i1(), out)
    else if ll == ll_ptr() then
      do
        out <- fresh_tmp(em)
        emit_template(em, `  ${out} = inttoptr i64 ${raw} to ptr`)
        val_make(ll_ptr(), out)
    else
      val_make(ll_i64(), raw)  # struct fields stay as i64 (packed blob)

# Extract tuple field by structural index.
fn emit_tuple_field_by_idx(scrut: Value, idx: Int, em: Emitter) -> Value !{IO} =
  do
    let ll = val_ll(scrut)
    match val_tuple_items(scrut) with
    | Nothing ->
        # Scrut is an i64 packed tuple blob — use getelementptr
        do
          ptr <- fresh_tmp(em)
          emit_template(em, `  ${ptr} = inttoptr i64 ${val_ir (scrut)} to ptr`)
          gep <- fresh_tmp(em)
          emit_template(em, `  ${gep} = getelementptr i64, ptr ${ptr}, i64 ${int_to_string (idx)}`)
          out <- fresh_tmp(em)
          emit_template(em, `  ${out} = load i64, ptr ${gep}`)
          val_make(ll_i64(), out)
    | Just items ->
        match list_nth(items, idx) with
        | Nothing -> val_make(ll_i64(), "0")
        | Just item_ll ->
            do
              out <- fresh_tmp(em)
              emit_template(em, `  ${out} = extractvalue ${ll} ${val_ir (scrut)}, ${int_to_string (idx)}`)
              val_with_tuple_items(val_make(item_ll, out), tuple_items_from_ll(item_ll))

# Emit pattern bindings.  Returns (new_bindings_as_list, gc_roots_pushed).
# scrut_type: the Sprout type of the scrutinee, used to instantiate generic ctor field types.
fn emit_pattern_bind(pat: ast.Pattern, scrut: Value, scrut_type: Maybe types.Type, ctx: CgCtx, em: Emitter) -> (List (String, Value), Int) !{IO} =
  match pat with
  | ast.WildcardPattern _ -> (Nil, 0)
  | ast.IntPattern _ _ -> (Nil, 0)
  | ast.BoolPattern _ _ -> (Nil, 0)
  | ast.StringPattern _ _ -> (Nil, 0)
  | ast.CharPattern _ _ -> (Nil, 0)
  | ast.UnitPattern _ -> (Nil, 0)
  | ast.VarPattern name _ ->
      do
        let skip = match scrut_type with
                   | Just t -> type_is_non_heap_scalar(t)
                   | Nothing -> false
        rooted <- if skip then 0 else push_temp_root(scrut, em)
        (Cons((name, scrut), Nil), rooted)
  | ast.TuplePattern items _ ->
      emit_tuple_pattern_bind(items, scrut, ctx, em, 0, Nil, 0)
  | ast.ConstructorPattern name args _ ->
      emit_ctor_pattern_bind(name, args, scrut, scrut_type, ctx, em)

fn emit_tuple_pattern_bind(items: List ast.Pattern, scrut: Value, ctx: CgCtx, em: Emitter, idx: Int, acc: List (String, Value), rooted: Int) -> (List (String, Value), Int) !{IO} =
  match items with
  | Nil -> (list_reverse(acc), rooted)
  | Cons item rest ->
      do
        field <- emit_tuple_field_by_idx(scrut, idx, em)
        (binds, r) <- emit_pattern_bind(item, field, Nothing, ctx, em)
        emit_tuple_pattern_bind(rest, scrut, ctx, em, idx + 1, list_reverse(binds) ++ acc, rooted + r)

fn emit_ctor_pattern_bind(name: String, args: List ast.Pattern, scrut: Value, scrut_type: Maybe types.Type, ctx: CgCtx, em: Emitter) -> (List (String, Value), Int) !{IO} =
  match dict_get(name, ctx_ctor_sigs(ctx)) with
  | Nothing -> (Nil, 0)
  | Just ctor ->
      # Wrap destructuring is identity: the scrut value IS the inner value,
      # so we recurse into the inner pattern bind with scrut unchanged — no
      # field read, no GC root.
      if ctor_is_wrap(ctor) then
        match args with
        | Cons inner_pat Nil -> emit_pattern_bind(inner_pat, scrut, scrut_type, ctx, em)
        | _ -> (Nil, 0)
      else do
        let lls = match scrut_type with
                  | Nothing -> ctor_arg_lls(ctor)
                  | Just st -> instantiated_ctor_arg_lls(ctor, st)
        emit_ctor_args_bind(args, lls, scrut, ctx, em, 0, Nil, 0)

fn emit_ctor_args_bind(args: List ast.Pattern, lls: List String, scrut: Value, ctx: CgCtx, em: Emitter, idx: Int, acc: List (String, Value), rooted: Int) -> (List (String, Value), Int) !{IO} =
  match (args, lls) with
  | (Nil, _) -> (list_reverse(acc), rooted)
  | (_, Nil) -> (list_reverse(acc), rooted)
  | (Cons arg rest_args, Cons ll rest_lls) ->
      do
        field <- emit_ctor_field(val_ir(scrut), idx, ll, em)
        (binds, r) <- emit_pattern_bind(arg, field, Nothing, ctx, em)
        emit_ctor_args_bind(rest_args, rest_lls, scrut, ctx, em, idx + 1, list_reverse(binds) ++ acc, rooted + r)

fn extend_locals(base: Dict Value, pairs: List (String, Value)) -> Dict Value =
  match pairs with
  | Nil -> base
  | Cons (k, v) rest -> extend_locals(dict_set(k, v, base), rest)

fn list_nth(xs: List String, n: Int) -> Maybe String =
  match xs with
  | Nil -> Nothing
  | Cons h t -> if n == 0 then Just(h) else list_nth(t, n - 1)

fn list_length(xs: List String) -> Int =
  list_fold(\ (acc, _) -> acc + 1, 0, xs)

fn list_length_vals(xs: List Value) -> Int =
  list_fold(\ (acc, _) -> acc + 1, 0, xs)

# ===========================================================================
# Section 11 — Free variable collection
# ===========================================================================

# Collect free variables in a TypedExpr (variables not in `bound` and not
# yet in `seen`).  Returns (new_free_list, updated_seen_set).
fn collect_free_vars(e: typed_ast.TypedExpr, bound: Set, acc: List String, seen: Set) -> (List String, Set) =
  match e with
  | typed_ast.TVar name _ _ ->
      if set_member(name, bound) || set_member(name, seen)
      then (acc, seen)
      else (Cons(name, acc), set_insert(name, seen))
  | typed_ast.TInt _ _ _ -> (acc, seen)
  | typed_ast.TBool _ _ _ -> (acc, seen)
  | typed_ast.TString _ _ _ -> (acc, seen)
  | typed_ast.TChar _ _ _ -> (acc, seen)
  | typed_ast.TUnit _ _ -> (acc, seen)
  | typed_ast.TTuple items _ _ ->
      collect_free_vars_list(items, bound, acc, seen)
  | typed_ast.TIf cond thn els _ _ ->
      match collect_free_vars(cond, bound, acc, seen) with
      | (a1, s1) ->
          match collect_free_vars(thn, bound, a1, s1) with
          | (a2, s2) -> collect_free_vars(els, bound, a2, s2)
  | typed_ast.TMatch scrut branches _ _ ->
      match collect_free_vars(scrut, bound, acc, seen) with
      | (a1, s1) -> collect_free_vars_branches(branches, bound, a1, s1)
  | typed_ast.TCall callee args _ _ ->
      match collect_free_vars(callee, bound, acc, seen) with
      | (a1, s1) -> collect_free_vars_list(args, bound, a1, s1)
  | typed_ast.TLambda params body _ _ ->
      collect_free_vars(body, list_fold(\ (s, p) -> match p with | ast.Param n _ -> set_insert(n, s), bound, params), acc, seen)
  | typed_ast.TBinary _ l r _ _ ->
      match collect_free_vars(l, bound, acc, seen) with
      | (a1, s1) -> collect_free_vars(r, bound, a1, s1)
  | typed_ast.TUnary _ operand _ _ ->
      collect_free_vars(operand, bound, acc, seen)
  | typed_ast.TRange start end_ _ _ ->
      match collect_free_vars(start, bound, acc, seen) with
      | (a1, s1) -> collect_free_vars(end_, bound, a1, s1)
  | typed_ast.TDo steps _ _ ->
      collect_free_vars_steps(steps, bound, acc, seen)
  | typed_ast.TDict _ _ _ -> (acc, seen)
  | typed_ast.TRecord _ _ _ _ -> (acc, seen)
  | typed_ast.TGetField obj _ _ _ ->
      collect_free_vars(obj, bound, acc, seen)

fn collect_free_vars_list(exprs: List typed_ast.TypedExpr, bound: Set, acc: List String, seen: Set) -> (List String, Set) =
  match exprs with
  | Nil -> (acc, seen)
  | Cons e rest ->
      match collect_free_vars(e, bound, acc, seen) with
      | (a1, s1) -> collect_free_vars_list(rest, bound, a1, s1)

fn collect_free_vars_branches(branches: List typed_ast.TypedMatchBranch, bound: Set, acc: List String, seen: Set) -> (List String, Set) =
  match branches with
  | Nil -> (acc, seen)
  | Cons (typed_ast.TypedMatchBranch pat body) rest ->
      match collect_free_vars(body, list_fold(\ (s, n) -> set_insert(n, s), bound, pattern_bound_names(pat)), acc, seen) with
      | (a1, s1) -> collect_free_vars_branches(rest, bound, a1, s1)

fn collect_free_vars_steps(steps: List typed_ast.TypedDoStep, bound: Set, acc: List String, seen: Set) -> (List String, Set) =
  match steps with
  | Nil -> (acc, seen)
  | Cons step rest ->
      match step with
      | typed_ast.TDoExprStep e ->
          match collect_free_vars(e, bound, acc, seen) with
          | (a1, s1) -> collect_free_vars_steps(rest, bound, a1, s1)
      | typed_ast.TDoLetStep name e ->
          match collect_free_vars(e, bound, acc, seen) with
          | (a1, s1) -> collect_free_vars_steps(rest, set_insert(name, bound), a1, s1)
      | typed_ast.TDoBindStep pat e ->
          match collect_free_vars(e, bound, acc, seen) with
          | (a1, s1) -> collect_free_vars_steps(rest, list_fold(\ (s, n) -> set_insert(n, s), bound, pattern_bound_names(pat)), a1, s1)

# ===========================================================================
# Section 12 — Closure operations
# ===========================================================================

fn emit_make_closure(code_ir: String, captures: List Value, em: Emitter) -> Value !{IO} =
  do
    rooted <- push_roots_list(captures, em)
    let n_slots = list_length_vals(captures) + 1
    sz <- fresh_tmp(em)
    emit_template(em, `  ${sz} = add i64 ${int_to_string (n_slots * 8)}, 0`)
    raw_i64 <- fresh_tmp(em)
    emit_template(em, `  ${raw_i64} = call i64 @sprout_alloc_closure_env(i64 ${sz})`)
    raw <- fresh_tmp(em)
    emit_template(em, `  ${raw} = inttoptr i64 ${raw_i64} to ptr`)
    emit_template(em, `  store ptr ${code_ir}, ptr ${raw}`)
    store_captures(captures, raw, em, 1)
    pop_temp_roots(rooted, em)
    val_make(ll_ptr(), raw)

fn store_captures(caps: List Value, raw: String, em: Emitter, idx: Int) -> Unit !{IO} =
  match caps with
  | Nil -> ()
  | Cons cap rest ->
      do
        packed <- pack_to_i64(cap, em)
        slot <- fresh_tmp(em)
        emit_template(em, `  ${slot} = getelementptr i64, ptr ${raw}, i64 ${int_to_string (idx)}`)
        emit_template(em, `  store i64 ${packed}, ptr ${slot}`)
        store_captures(rest, raw, em, idx + 1)

fn emit_closure_call(callee: Value, sig: CallSig, args: List Value, em: Emitter) -> Value !{IO} =
  do
    code <- fresh_tmp(em)
    emit_template(em, `  ${code} = load ptr, ptr ${val_ir (callee)}`)
    args_ir_str <- build_closure_args_ir(callee, sig_params(sig), args, em)
    out <- fresh_tmp(em)
    emit_template(em, `  ${out} = call ${sig_ret (sig)} ${code}(${args_ir_str})`)
    val_with_call_sig(val_for_ll(sig_ret(sig), out), sig_ret_sig(sig))

fn build_closure_args_ir(callee: Value, param_lls: List String, args: List Value, em: Emitter) -> String !{IO} =
  do
    coerced <- coerce_args(param_lls, args, em)
    let arg_parts = list_map(\p -> match p with | (ll, ir) -> format_ll_ir(ll, ir), coerced)
    "ptr " ++ val_ir(callee) ++ (if list_is_nil(arg_parts) then "" else ", " ++ string.join(", ", arg_parts))

fn coerce_args(param_lls: List String, args: List Value, em: Emitter) -> List (String, String) !{IO} =
  match (param_lls, args) with
  | (Nil, _) -> Nil
  | (_, Nil) -> Nil
  | (Cons ll rest_lls, Cons arg rest_args) ->
      do
        cv <- coerce_value(arg, ll, em)
        rest <- coerce_args(rest_lls, rest_args, em)
        Cons((ll, val_ir(cv)), rest)

fn list_is_nil(xs: List String) -> Bool =
  match xs with
  | Nil -> true
  | _ -> false

# ===========================================================================
# Section 13 — Wrapper generation (named fn closure, partial application)
# ===========================================================================

fn emit_named_fn_wrapper_lines(wrapper_name: String, fn_name_: String, sig: FnSig) -> List String =
  Cons("define " ++ fn_ret(sig) ++ " @" ++ wrapper_name ++ "(ptr %env" ++ params_str ++ ") {",
  Cons("entry:",
  Cons(call_str,
  Cons("  ret " ++ fn_ret(sig) ++ " %ret",
  Cons("}", Nil)))))
  where params_str = build_wrapper_params(fn_params(sig), 0)
        args_str = build_wrapper_args(fn_params(sig), 0)
        call_str = if args_str == ""
                     then "  %ret = call " ++ fn_ret(sig) ++ " @" ++ fn_name_ ++ "()"
                     else "  %ret = call " ++ fn_ret(sig) ++ " @" ++ fn_name_ ++ "(" ++ args_str ++ ")"

fn build_wrapper_params(lls: List String, idx: Int) -> String =
  match lls with
  | Nil -> ""
  | Cons ll rest -> ", " ++ ll ++ " %a" ++ int_to_string(idx) ++ build_wrapper_params(rest, idx + 1)

fn build_wrapper_args(lls: List String, idx: Int) -> String =
  match lls with
  | Nil -> ""
  | Cons ll rest ->
      match build_wrapper_args(rest, idx + 1) with
      | rest_str -> ll ++ " %a" ++ int_to_string(idx) ++ (if rest_str == "" then "" else ", " ++ rest_str)

fn emit_partial_direct_wrapper_lines(wrapper_name: String, fn_name_: String, sig: FnSig, applied: Int) -> List String =
  Cons("define " ++ fn_ret(sig) ++ " @" ++ wrapper_name ++ "(ptr %env" ++ remain_params ++ ") {",
  Cons("entry:",
  list_append(load_lines,
  Cons(call_str,
  Cons("  ret " ++ fn_ret(sig) ++ " %ret",
  Cons("}", Nil))))))
  where remaining = list_drop(fn_params(sig), applied)
        remain_params = build_wrapper_params(remaining, 0)
        load_lines = build_load_applied(fn_params(sig), 0, applied)
        applied_args = build_applied_arg_strs(fn_params(sig), 0, applied)
        remain_args = build_remain_arg_strs(remaining, 0)
        all_args = join_args_str(applied_args, remain_args)
        call_str = "  %ret = call " ++ fn_ret(sig) ++ " @" ++ fn_name_ ++ (if all_args == "" then "()" else "(" ++ all_args ++ ")")

fn build_load_applied(lls: List String, idx: Int, n: Int) -> List String =
  if idx >= n then Nil
  else
    match lls with
    | Nil -> Nil
    | Cons ll rest ->
        Cons("  %slot" ++ int_to_string(idx) ++ " = getelementptr i64, ptr %env, i64 " ++ int_to_string(idx + 1),
        Cons("  %raw" ++ int_to_string(idx) ++ " = load i64, ptr %slot" ++ int_to_string(idx),
        Cons(coerce_raw_line(ll, idx),
        build_load_applied(rest, idx + 1, n))))

fn coerce_raw_line(ll: String, idx: Int) -> String =
  if ll == ll_i64() then ""  # raw IS the value; don't emit spurious instruction
  else if ll == ll_i1() then
    "  %cap" ++ int_to_string(idx) ++ " = trunc i64 %raw" ++ int_to_string(idx) ++ " to i1"
  else if ll == ll_ptr() then
    "  %cap" ++ int_to_string(idx) ++ " = inttoptr i64 %raw" ++ int_to_string(idx) ++ " to ptr"
  else ""

fn get_applied_ir(ll: String, idx: Int) -> String =
  if ll == ll_i64() then "i64 %raw" ++ int_to_string(idx)
  else if ll == ll_i1() then "i1 %cap" ++ int_to_string(idx)
  else if ll == ll_ptr() then "ptr %cap" ++ int_to_string(idx)
  else "i64 %raw" ++ int_to_string(idx)

fn build_applied_arg_strs(lls: List String, idx: Int, n: Int) -> String =
  if idx >= n then ""
  else
    match lls with
    | Nil -> ""
    | Cons ll rest ->
        match build_applied_arg_strs(rest, idx + 1, n) with
        | rest_str ->
            match get_applied_ir(ll, idx) with
            | this -> if rest_str == "" then this else this ++ ", " ++ rest_str

fn build_remain_arg_strs(remaining: List String, idx: Int) -> String =
  match remaining with
  | Nil -> ""
  | Cons ll rest ->
      match build_remain_arg_strs(rest, idx + 1) with
      | rest_str ->
          match ll ++ " %a" ++ int_to_string(idx) with
          | this -> if rest_str == "" then this else this ++ ", " ++ rest_str

fn list_drop(xs: List String, n: Int) -> List String =
  if n <= 0 then xs
  else
    match xs with
    | Nil -> Nil
    | Cons _ rest -> list_drop(rest, n - 1)

fn list_append(xs: List String, ys: List String) -> List String =
  match xs with
  | Nil -> ys
  | Cons h t -> Cons(h, list_append(t, ys))

# ===========================================================================
# Section 14 — Lambda emission
# ===========================================================================

fn emit_lambda_helper(lam_name: String, params: List ast.Param, wire_lls: List String, logical_lls: List String, body: typed_ast.TypedExpr, ret_ll: String, captures: List String, capture_lls: List String, ctx: CgCtx, em: Emitter) -> Unit !{IO} =
  do
    saved <- save_body(em)
    let params_str = build_wrapper_params(wire_lls, 0)
    emit_line(em, "; " ++ lam_name ++ " (in " ++ ctx_scope(ctx) ++ ")")
    emit_template(em, `define ${ret_ll} @${lam_name}(ptr %env${params_str}) {`)
    emit_label(em, "entry")
    env_val <- push_temp_root(val_make(ll_ptr(), "%env"), em)
    (cap_locals, cap_rooted) <- load_captures(captures, capture_lls, em, 1)
    (param_locals, param_rooted) <- load_lambda_params(params, wire_lls, logical_lls, em, 0)
    let lam_locals = extend_locals(extend_locals(dict_empty(), cap_locals), param_locals)
    let total_rooted = env_val + cap_rooted + param_rooted
    body_val <- emit_expr(ctx, lam_locals, em, Nothing, body)
    coerced_body <- coerce_value(body_val, ret_ll, em)
    pop_temp_roots(total_rooted, em)
    emit_template(em, `  ret ${ret_ll} ${val_ir (coerced_body)}`)
    emit_line(em, "}")
    fn_lines <- flush_body(em)
    emit_defs_list(fn_lines, em)
    add_def_line(em, "")
    restore_body(em, saved)

fn load_captures(names: List String, lls: List String, em: Emitter, idx: Int) -> (List (String, Value), Int) !{IO} =
  match (names, lls) with
  | (Nil, _) -> (Nil, 0)
  | (_, Nil) -> (Nil, 0)
  | (Cons name rest_names, Cons ll rest_lls) ->
      do
        slot <- fresh_tmp(em)
        emit_template(em, `  ${slot} = getelementptr i64, ptr %env, i64 ${int_to_string (idx)}`)
        raw <- fresh_tmp(em)
        emit_template(em, `  ${raw} = load i64, ptr ${slot}`)
        v <- coerce_value(val_make(ll_i64(), raw), ll, em)
        rooted <- push_temp_root(v, em)
        (rest_binds, rest_rooted) <- load_captures(rest_names, rest_lls, em, idx + 1)
        (Cons((name, v), rest_binds), rooted + rest_rooted)

fn load_lambda_params(params: List ast.Param, wire_lls: List String, logical_lls: List String, em: Emitter, idx: Int) -> (List (String, Value), Int) !{IO} =
  match (params, wire_lls, logical_lls) with
  | (Nil, _, _) -> (Nil, 0)
  | (_, Nil, _) -> (Nil, 0)
  | (_, _, Nil) -> (Nil, 0)
  | (Cons(ast.Param name ann) rest_params, Cons wire rest_wires, Cons logical rest_logicals) ->
      do
        let ir = "%a" ++ int_to_string(idx)
        let raw_v = val_for_ll(wire, ir)
        v <- coerce_value(raw_v, logical, em)
        let skip = match ann with
                   | Just te -> type_expr_is_non_heap_scalar(te)
                   | Nothing -> false
        rooted <- if skip then 0 else push_temp_root(v, em)
        (rest_binds, rest_rooted) <- load_lambda_params(rest_params, rest_wires, rest_logicals, em, idx + 1)
        (Cons((name, v), rest_binds), rooted + rest_rooted)

fn emit_defs_list(lines: List String, em: Emitter) -> Unit !{IO} =
  match lines with
  | Nil -> ()
  | Cons line rest ->
      do
        add_def_line(em, line)
        emit_defs_list(rest, em)

# ===========================================================================
# Section 15 — CgCtx accessors
# ===========================================================================

fn ctx_fn_sigs(ctx: CgCtx) -> Dict FnSig =
  match ctx with | CgCtx fs _ _ _ _ _ _ _ _ -> fs

fn ctx_ctor_sigs(ctx: CgCtx) -> Dict CtorSig =
  match ctx with | CgCtx _ cs _ _ _ _ _ _ _ -> cs

fn ctx_globals(ctx: CgCtx) -> Dict GlobalInfo =
  match ctx with | CgCtx _ _ g _ _ _ _ _ _ -> g

fn ctx_extern_sigs(ctx: CgCtx) -> Dict FnSig =
  match ctx with | CgCtx _ _ _ _ es _ _ _ _ -> es

fn ctx_scope(ctx: CgCtx) -> String =
  match ctx with | CgCtx _ _ _ _ _ sc _ _ _ -> sc

fn ctx_cpr_fns(ctx: CgCtx) -> Dict Int =
  match ctx with | CgCtx _ _ _ _ _ _ cf _ _ -> cf

fn ctx_cpr_extern_sigs(ctx: CgCtx) -> Dict FnSig =
  match ctx with | CgCtx _ _ _ _ _ _ _ ces _ -> ces

fn ctx_mutual_tco_fns(ctx: CgCtx) -> Set =
  match ctx with | CgCtx _ _ _ _ _ _ _ _ mt -> mt

fn ctx_with_scope(ctx: CgCtx, name: String) -> CgCtx =
  match ctx with | CgCtx fs cs g an es _ cf ces mt -> CgCtx(fs, cs, g, an, es, name, cf, ces, mt)

# ===========================================================================
# Section 16 — TCO helpers
# ===========================================================================

fn has_self_tail_calls(e: typed_ast.TypedExpr, fn_name_: String) -> Bool =
  has_tail_call_to_set(e, set_insert(fn_name_, set_empty()))

# has_tail_call_to_set: generalises has_self_tail_calls to a Set of names.
fn has_tail_call_to_set(e: typed_ast.TypedExpr, names: Set) -> Bool =
  match e with
  | typed_ast.TCall (typed_ast.TVar name _ _) _ _ _ ->
      set_member(name, names)
  | typed_ast.TIf _ thn els _ _ ->
      has_tail_call_to_set(thn, names) || has_tail_call_to_set(els, names)
  | typed_ast.TMatch _ branches _ _ ->
      any_branch_has_tail_to_set(branches, names)
  | typed_ast.TDo steps _ _ ->
      do_last_has_tail_to_set(steps, names)
  | _ -> false

fn any_branch_has_tail_to_set(branches: List typed_ast.TypedMatchBranch, names: Set) -> Bool =
  match branches with
  | Nil -> false
  | Cons (typed_ast.TypedMatchBranch _ body) rest ->
      has_tail_call_to_set(body, names) || any_branch_has_tail_to_set(rest, names)

fn do_last_has_tail_to_set(steps: List typed_ast.TypedDoStep, names: Set) -> Bool =
  match steps with
  | Nil -> false
  | [step] ->
      match step with
      | typed_ast.TDoExprStep e -> has_tail_call_to_set(e, names)
      | _ -> false
  | Cons _ rest -> do_last_has_tail_to_set(rest, names)

# ---------------------------------------------------------------------------
# build_mutual_tco_fns: fixed-point expansion of the mutual-TCO set.
# Start from TCO functions (those with self-tail-calls), then transitively
# include any function that tail-calls into the current set.
# All functions in the returned Set must return i64 (excluded from CPR).

# Only collect functions whose return type maps to LLVM i64.
# Bool (→ i1) and tuples (→ struct) are excluded: musttail requires identical
# caller/callee return types, and the mutual-TCO path hardcodes i64.
fn body_ret_is_i64(body: typed_ast.TypedExpr) -> Bool =
  match typed_ast.typed_expr_type(body) with
  | types.TConst "Bool" -> false
  | types.TTuple _ -> false
  | _ -> true

fn collect_fn_bodies(decls: List typed_ast.TypedDecl, acc: List (String, typed_ast.TypedExpr)) -> List (String, typed_ast.TypedExpr) =
  match decls with
  | Nil -> acc
  | Cons decl rest ->
      match decl with
      | typed_ast.TFnDecl name _ _ _ _ body ->
          if body_ret_is_i64(body) then
            collect_fn_bodies(rest, Cons((name, body), acc))
          else
            collect_fn_bodies(rest, acc)
      | _ -> collect_fn_bodies(rest, acc)

fn seed_mutual_tco(bodies: List (String, typed_ast.TypedExpr), acc: Set) -> Set =
  match bodies with
  | Nil -> acc
  | Cons (name, body) rest ->
      if has_self_tail_calls(body, name) then
        seed_mutual_tco(rest, set_insert(name, acc))
      else
        seed_mutual_tco(rest, acc)

fn expand_mutual_tco_step(bodies: List (String, typed_ast.TypedExpr), current: Set, changed: Bool) -> (Set, Bool) =
  match bodies with
  | Nil -> (current, changed)
  | Cons (name, body) rest ->
      if set_member(name, current) then
        expand_mutual_tco_step(rest, current, changed)
      else if has_tail_call_to_set(body, current) then
        expand_mutual_tco_step(rest, set_insert(name, current), true)
      else
        expand_mutual_tco_step(rest, current, changed)

fn expand_mutual_tco_until_stable(bodies: List (String, typed_ast.TypedExpr), current: Set) -> Set =
  match expand_mutual_tco_step(bodies, current, false) with
  | (new_set, true) -> expand_mutual_tco_until_stable(bodies, new_set)
  | (final_set, false) -> final_set

fn build_mutual_tco_fns(decls: List typed_ast.TypedDecl) -> Set =
  expand_mutual_tco_until_stable(bodies, seed_mutual_tco(bodies, set_empty()))
  where bodies = collect_fn_bodies(decls, Nil)

# musttail requires that the callee prototype exactly matches the enclosing
# (caller) function prototype: same parameter count and types.
# Compare callee's declared ll param types against caller's TCO-slot ll types.
fn params_match_slots(params: List String, slots: List (String, String)) -> Bool =
  match (params, slots) with
  | (Nil, Nil) -> true
  | (Cons p rest_p, Cons(_, ll) rest_s) -> p == ll && params_match_slots(rest_p, rest_s)
  | _ -> false

fn emit_tco_back_edge(tco: TcoCtx, new_args: List Value, extra_roots: Int, em: Emitter) -> Unit !{IO} =
  do
    pop_temp_roots(extra_roots + tco_outer_roots(tco), em)
    store_tco_args(tco_slots(tco), new_args, em)
    let sp = tco_sp_save(tco)
    if str_len(sp) > 0 then
      emit_template(em, `  call void @llvm.stackrestore(ptr ${sp})`)
    else ()
    emit_template(em, `  br label %${tco_loop_lbl (tco)}`)

fn emit_pending_tco(tco_ctx: Maybe TcoCtx, v: Value, em: Emitter) -> Bool !{IO} =
  match tco_ctx with
  | Nothing -> false
  | Just tc ->
      match val_tco_args(v) with
      | Nothing -> false
      | Just new_args ->
          do
            emit_tco_back_edge(tc, new_args, 0, em)
            true

fn tco_with_extra_roots(tco_ctx: Maybe TcoCtx, extra_roots: Int) -> Maybe TcoCtx =
  match tco_ctx with
  | Nothing -> Nothing
  | Just tc -> Just(tco_with_outer_roots(tc, tco_outer_roots(tc) + extra_roots))

fn store_tco_args(slots: List (String, String), vals: List Value, em: Emitter) -> Unit !{IO} =
  match (slots, vals) with
  | (Nil, _) -> ()
  | (_, Nil) -> ()
  | (Cons(slot_ir, ll) rest_slots, Cons v rest_vals) ->
      do
        cv <- coerce_value(v, ll, em)
        emit_template(em, `  store ${ll} ${val_ir (cv)}, ptr ${slot_ir}`)
        store_tco_args(rest_slots, rest_vals, em)

# ===========================================================================
# Section 17 — Expression emission
# ===========================================================================

fn emit_expr(ctx: CgCtx, locals: Dict Value, em: Emitter, tco_ctx: Maybe TcoCtx, e: typed_ast.TypedExpr) -> Value !{IO} =
  match e with
  | typed_ast.TInt n _ _ ->
      val_make(ll_i64(), int_to_string(n))
  | typed_ast.TBool b _ _ ->
      val_make(ll_i1(), if b then "1" else "0")
  | typed_ast.TString s _ _ ->
      do
        p <- emit_str_ptr(em, s)
        coerce_value(p, ll_i64(), em)
  | typed_ast.TChar ch _ _ ->
      do
        p <- emit_str_ptr(em, char_to_string(ch))
        coerce_value(p, ll_i64(), em)
  | typed_ast.TUnit _ _ ->
      val_make(ll_i64(), "0")
  | typed_ast.TTuple items ty _ ->
      emit_tuple_expr(items, ty, ctx, locals, em, tco_ctx)
  | typed_ast.TVar name ty _ ->
      emit_var(name, ty, ctx, locals, em)
  | typed_ast.TLambda params body ty _ ->
      emit_lambda_expr(params, body, ty, ctx, locals, em)
  | typed_ast.TUnary op operand _ _ ->
      emit_unary(op, operand, ctx, locals, em)
  | typed_ast.TRange start end_ _ _ ->
      emit_range(start, end_, ctx, locals, em)
  | typed_ast.TBinary op left right ty _ ->
      emit_binary(op, left, right, ty, ctx, locals, em)
  | typed_ast.TIf cond thn els ty _ ->
      emit_if(cond, thn, els, ty, ctx, locals, em, tco_ctx)
  | typed_ast.TMatch scrut branches ty _ ->
      emit_match(scrut, branches, ty, ctx, locals, em, tco_ctx)
  | typed_ast.TCall callee args ty _ ->
      emit_call(callee, args, ty, ctx, locals, em, tco_ctx)
  | typed_ast.TDo steps ty _ ->
      emit_do(steps, ty, ctx, locals, em, tco_ctx)
  | typed_ast.TDict _ ty _ ->
      # TDict nodes should be eliminated by lowering; treat as unit if we see one
      zero_val(type_to_ll(ty))
  | typed_ast.TRecord _ _ ty _ ->
      zero_val(type_to_ll(ty))
  | typed_ast.TGetField obj _ ty _ ->
      # Record field access not supported in LLVM backend
      do
        _ <- emit_expr(ctx, locals, em, Nothing, obj)
        zero_val(type_to_ll(ty))

fn emit_tuple_expr(items: List typed_ast.TypedExpr, ty: types.Type, ctx: CgCtx, locals: Dict Value, em: Emitter, tco_ctx: Maybe TcoCtx) -> Value !{IO} =
  do
    (vals_and_lls, rooted) <- emit_tuple_items(items, ctx, locals, em)
    let lls = list_map(\p -> match p with | (_, ll) -> ll, vals_and_lls)
    let tuple_ll_ = tuple_ll(lls)
    result <- build_struct(tuple_ll_, vals_and_lls, em, "undef")
    pop_temp_roots(rooted, em)
    val_with_tuple_items(val_make(tuple_ll_, result), Just(lls))

# Each item's root is pushed immediately after evaluation so that a GC cycle
# triggered inside a later item's builtin call cannot free an earlier result.
fn emit_tuple_items(items: List typed_ast.TypedExpr, ctx: CgCtx, locals: Dict Value, em: Emitter) -> (List (Value, String), Int) !{IO} =
  match items with
  | Nil -> (Nil, 0)
  | Cons item rest ->
      do
        v <- emit_expr(ctx, locals, em, Nothing, item)
        n <- push_temp_root_typed(v, typed_ast.typed_expr_type(item), em)
        (rest_vals, ns) <- emit_tuple_items(rest, ctx, locals, em)
        (Cons((v, val_ll(v)), rest_vals), n + ns)

fn build_struct(tuple_ll_: String, vals_and_lls: List (Value, String), em: Emitter, current: String) -> String !{IO} =
  build_struct_acc(tuple_ll_, vals_and_lls, em, current, 0)

fn build_struct_acc(tuple_ll_: String, items: List (Value, String), em: Emitter, current: String, idx: Int) -> String !{IO} =
  match items with
  | Nil -> current
  | Cons (v, ll) rest ->
      do
        next <- fresh_tmp(em)
        emit_template(em, `  ${next} = insertvalue ${tuple_ll_} ${current}, ${ll} ${val_ir (v)}, ${int_to_string (idx)}`)
        build_struct_acc(tuple_ll_, rest, em, next, idx + 1)

fn emit_var(name: String, ty: types.Type, ctx: CgCtx, locals: Dict Value, em: Emitter) -> Value !{IO} =
  match dict_get(name, locals) with
  | Just v -> v
  | Nothing ->
      do
        match dict_get(name, ctx_fn_sigs(ctx)) with
        | Just sig ->
            do
              fw <- es_fn_wrap(em)
              let wrapper_opt = dict_get(name, fw)
              match wrapper_opt with
              | Nothing ->
                  val_make(ll_ptr(), "null")  # no wrapper? return null closure
              | Just wname ->
                  do
                    closure <- emit_make_closure("@" ++ wname, Nil, em)
                    val_with_call_sig(closure, Just(fn_sig_to_call_sig(sig)))
        | Nothing ->
            match dict_get(name, ctx_globals(ctx)) with
            | Just gi ->
                do
                  tmp <- fresh_tmp(em)
                  emit_template(em, `  ${tmp} = load ${gi_ll (gi)}, ptr @${name}`)
                  val_with_call_sig(val_make(gi_ll(gi), tmp), gi_call_sig(gi))
            | Nothing ->
                match dict_get(name, ctx_ctor_sigs(ctx)) with
                | Just ctor ->
                    if ctor_arity(ctor) == 0
                    then
                      do
                        tmp <- fresh_tmp(em)
                        let ctor_fn = if is_nothing_ctor(name) then "@sprout_nothing" else "@sprout_make0"
                        emit_template(em, `  ${tmp} = call i64 ${ctor_fn}(i64 ${int_to_string (ctor_tag(ctor))})`)
                        val_make(ll_i64(), tmp)
                    else
                      # Ctor applied to zero args but has arity > 0 → need partial closure
                      # Build a wrapper for this ctor and make a closure
                      do
                        lam_idx <- fresh_lambda_idx(em)
                        let wrap_name = "__sprout_ctor_" ++ name ++ "_" ++ int_to_string(lam_idx)
                        emit_ctor_closure_wrapper(wrap_name, ctor, em)
                        let sig = CallSig(ctor_arg_lls(ctor), ll_i64(), Nothing)
                        closure <- emit_make_closure("@" ++ wrap_name, Nil, em)
                        val_with_call_sig(closure, Just(sig))
                | Nothing ->
                    # Extern or completely unknown
                    match dict_get(name, ctx_extern_sigs(ctx)) with
                    | Just ext_sig ->
                        do
                          lam_idx <- fresh_lambda_idx(em)
                          let wname = "__sprout_fn_closure_" ++ int_to_string(lam_idx)
                          set_fn_wrapper(em, name, wname)
                          let wrapper_lines = emit_named_fn_wrapper_lines(wname, name, ext_sig)
                          emit_defs_list(wrapper_lines, em)
                          add_def_line(em, "")
                          closure <- emit_make_closure("@" ++ wname, Nil, em)
                          val_with_call_sig(closure, Just(fn_sig_to_call_sig(ext_sig)))
                    | Nothing ->
                        zero_val(type_to_ll(ty))  # unknown — return zero

fn is_nothing_ctor(name: String) -> Bool =
  name == "Nothing" || (n >= 7 && str_slice(name, n - 7, n) == "Nothing")
  where n = str_len(name)

fn is_entry_fn_name(name: String) -> Bool =
  name == "main" || (n >= 5 && str_slice(name, n - 5, 5) == ".main")
  where n = str_len(name)

fn emitted_fn_name(name: String) -> String =
  if is_entry_fn_name(name) then "main" else name

fn emit_ctor_closure_wrapper(wrap_name: String, ctor: CtorSig, em: Emitter) -> Unit !{IO} =
  do
    let lls = ctor_arg_lls(ctor)
    let fake_fn_sig = FnSig(wrap_name, lls, ll_i64(), Nothing)
    saved <- save_body(em)
    let params_str = build_wrapper_params(lls, 0)
    emit_template(em, `define i64 @${wrap_name}(ptr %env${params_str}) {`)
    emit_label(em, "entry")
    # Wrap ctor used in value position: closure wrapper is identity.
    # `wrap Age = Int` used as a function `Age :: Int -> Age` emits a wrapper
    # that returns its argument unchanged.
    if ctor_is_wrap(ctor) then
      emit_line(em, "  ret i64 %a0")
    else do
      let tag_str = int_to_string(ctor_tag(ctor))
      let n = list_length(lls)
      pack_and_call_ctor_wrapper(lls, n, tag_str, em)
    emit_line(em, "}")
    fn_lines <- flush_body(em)
    emit_defs_list(fn_lines, em)
    add_def_line(em, "")
    restore_body(em, saved)

fn pack_and_call_ctor_wrapper(lls: List String, n: Int, tag_str: String, em: Emitter) -> Unit !{IO} =
  do
    pack_strs <- pack_args_from_env(lls, 0, em)
    let args_ir = string.join(", ", list_map(\p -> "i64 " ++ p, pack_strs))
    ret <- fresh_tmp(em)
    let sep = if args_ir == "" then "" else ", "
    emit_template(em, `  ${ret} = call i64 @sprout_make${int_to_string (n)}(i64 ${tag_str}${sep}${args_ir})`)
    emit_template(em, `  ret i64 ${ret}`)

fn pack_args_from_env(lls: List String, idx: Int, em: Emitter) -> List String !{IO} =
  match lls with
  | Nil -> Nil
  | Cons ll rest ->
      do
        let raw_ir = "%a" ++ int_to_string(idx)
        packed <- pack_to_i64(val_make(ll, raw_ir), em)
        rest_packed <- pack_args_from_env(rest, idx + 1, em)
        Cons(packed, rest_packed)

fn lambda_free_names(body: typed_ast.TypedExpr, params: List ast.Param) -> List String =
  match collect_free_vars(body, list_fold(\ (s, p) -> match p with | ast.Param n _ -> set_insert(n, s), set_empty(), params), Nil, set_empty()) with
  | (names, _) -> names

fn emit_lambda_expr(params: List ast.Param, body: typed_ast.TypedExpr, ty: types.Type, ctx: CgCtx, locals: Dict Value, em: Emitter) -> Value !{IO} =
  do
    lam_idx <- fresh_lambda_idx(em)
    let scope_suffix = if ctx_scope(ctx) == "" then "" else "_" ++ ctx_scope(ctx)
    let lam_name = "__sprout_lambda_" ++ int_to_string(lam_idx) ++ scope_suffix
    let free_list = lambda_free_names(body, params)
    let captures = list_filter_in_locals(free_list, locals)
    let capture_vals = get_capture_vals(captures, locals)
    let n_lam_params = list_length_params(params)
    let raw_param_lls = extract_param_lls_from_type(ty, n_lam_params)
    let param_lls = if list_length(raw_param_lls) == n_lam_params then raw_param_lls
                    else list_map(\_ -> ll_i64(), params)
    let wire_param_lls = list_map(normalize_lambda_param_ll, param_lls)
    let ret_ll = normalize_lambda_param_ll(extract_ret_ll_from_type(ty, list_length_params(params)))
    let capture_lls = list_map(\v -> val_ll(v), capture_vals)
    emit_lambda_helper(lam_name, params, wire_param_lls, param_lls, body, ret_ll, captures, capture_lls, ctx, em)
    closure <- emit_make_closure("@" ++ lam_name, capture_vals, em)
    let sig = CallSig(wire_param_lls, ret_ll, call_sig_from_type(extract_ret_type(ty, list_length_params(params))))
    val_with_call_sig(closure, Just(sig))

fn list_filter_in_locals(names: List String, locals: Dict Value) -> List String =
  match names with
  | Nil -> Nil
  | Cons n rest ->
      match dict_get(n, locals) with
      | Just _ -> Cons(n, list_filter_in_locals(rest, locals))
      | Nothing -> list_filter_in_locals(rest, locals)

fn get_capture_vals(captures: List String, locals: Dict Value) -> List Value =
  match captures with
  | Nil -> Nil
  | Cons n rest ->
      match dict_get(n, locals) with
      | Nothing -> get_capture_vals(rest, locals)
      | Just v -> Cons(v, get_capture_vals(rest, locals))

fn extract_param_lls_from_type(ty: types.Type, n: Int) -> List String =
  if n <= 0 then Nil
  else
    match ty with
    | types.TFunc param ret _ -> Cons(type_to_ll(param), extract_param_lls_from_type(ret, n - 1))
    | _ -> Nil

fn extract_ret_ll_from_type(ty: types.Type, n: Int) -> String =
  type_to_ll(extract_ret_type(ty, n))

fn extract_ret_type(ty: types.Type, n: Int) -> types.Type =
  if n <= 0 then ty
  else
    match ty with
    | types.TFunc _ ret _ -> extract_ret_type(ret, n - 1)
    | _ -> ty

fn list_length_params(params: List ast.Param) -> Int =
  list_fold(\ (acc, _) -> acc + 1, 0, params)

fn emit_unary(op: String, operand: typed_ast.TypedExpr, ctx: CgCtx, locals: Dict Value, em: Emitter) -> Value !{IO} =
  do
    v <- emit_expr(ctx, locals, em, Nothing, operand)
    if op == "-" then
      do
        tmp <- fresh_tmp(em)
        emit_template(em, `  ${tmp} = sub i64 0, ${val_ir (v)}`)
        val_make(ll_i64(), tmp)
    else if op == "!" then
      do
        tmp <- fresh_tmp(em)
        emit_template(em, `  ${tmp} = xor i1 ${val_ir (v)}, true`)
        val_make(ll_i1(), tmp)
    else
      v

fn emit_range(start: typed_ast.TypedExpr, end_: typed_ast.TypedExpr, ctx: CgCtx, locals: Dict Value, em: Emitter) -> Value !{IO} =
  do
    sv <- emit_expr(ctx, locals, em, Nothing, start)
    ev <- emit_expr(ctx, locals, em, Nothing, end_)
    tmp <- fresh_tmp(em)
    emit_template(em, `  ${tmp} = call i64 @int_range(i64 ${val_ir (sv)}, i64 ${val_ir (ev)})`)
    val_make(ll_i64(), tmp)

fn compare_needs_ptr_dispatch(left_ty: types.Type, right_ty: types.Type) -> Bool =
  is_string_type(left_ty) || is_char_type(left_ty) || is_string_type(right_ty) || is_char_type(right_ty)

fn emit_binary(op: String, left: typed_ast.TypedExpr, right: typed_ast.TypedExpr, ty: types.Type, ctx: CgCtx, locals: Dict Value, em: Emitter) -> Value !{IO} =
  if op == "&&" || op == "||" then
    emit_short_circuit(op, left, right, ctx, locals, em)
  else if op == "++" then
    emit_str_binary_concat(left, right, ctx, locals, em)
  else
    do
      lv <- emit_expr(ctx, locals, em, Nothing, left)
      let left_ty = typed_ast.typed_expr_type(left)
      rooted <- push_temp_root_typed(lv, left_ty, em)
      rv <- emit_expr(ctx, locals, em, Nothing, right)
      let right_ty = typed_ast.typed_expr_type(right)
      if op == "+" || op == "-" || op == "*" || op == "/" then
        do
          pop_temp_roots(rooted, em)
          tmp <- fresh_tmp(em)
          let inst = if op == "+" then "add" else if op == "-" then "sub" else if op == "*" then "mul" else "sdiv"
          emit_template(em, `  ${tmp} = ${inst} i64 ${val_ir (lv)}, ${val_ir (rv)}`)
          val_make(ll_i64(), tmp)
      else if op == "%" then
        do
          pop_temp_roots(rooted, em)
          tmp <- fresh_tmp(em)
          emit_template(em, `  ${tmp} = srem i64 ${val_ir (lv)}, ${val_ir (rv)}`)
          val_make(ll_i64(), tmp)
      else
        do
          if compare_needs_ptr_dispatch(left_ty, right_ty) then
            do
              rooted_rv <- push_temp_root_typed(rv, right_ty, em)
              lp <- coerce_value(lv, ll_ptr(), em)
              rp <- coerce_value(rv, ll_ptr(), em)
              pop_temp_roots(rooted + rooted_rv, em)
              emit_ptr_comparison(op, lp, rp, em)
          else
            do
              pop_temp_roots(rooted, em)
              emit_comparison(op, lv, rv, em)

fn emit_str_binary_concat(left: typed_ast.TypedExpr, right: typed_ast.TypedExpr, ctx: CgCtx, locals: Dict Value, em: Emitter) -> Value !{IO} =
  do
    lv <- emit_expr(ctx, locals, em, Nothing, left)
    rooted <- push_temp_root(lv, em)
    rv <- emit_expr(ctx, locals, em, Nothing, right)
    pop_temp_roots(rooted, em)
    li <- coerce_value(lv, ll_i64(), em)
    ri <- coerce_value(rv, ll_i64(), em)
    tmp <- fresh_tmp(em)
    emit_template(em, `  ${tmp} = call i64 @str_concat(i64 ${val_ir (li)}, i64 ${val_ir (ri)})`)
    val_make(ll_i64(), tmp)

fn emit_ptr_comparison(op: String, lp: Value, rp: Value, em: Emitter) -> Value !{IO} =
  if op == "==" then
    do
      eq_tmp <- fresh_tmp(em)
      emit_template(em, `  ${eq_tmp} = call i1 @str_eq(ptr ${val_ir (lp)}, ptr ${val_ir (rp)})`)
      val_make(ll_i1(), eq_tmp)
  else if op == "!=" then
    do
      eq_tmp <- fresh_tmp(em)
      emit_template(em, `  ${eq_tmp} = call i1 @str_eq(ptr ${val_ir (lp)}, ptr ${val_ir (rp)})`)
      not_tmp <- fresh_tmp(em)
      emit_template(em, `  ${not_tmp} = xor i1 ${eq_tmp}, true`)
      val_make(ll_i1(), not_tmp)
  else
    do
      let pred = if op == "<" then "slt"
                 else if op == "<=" then "sle"
                 else if op == ">" then "sgt"
                 else "sge"
      cmp_tmp <- fresh_tmp(em)
      emit_template(em, `  ${cmp_tmp} = call i64 @str_compare(ptr ${val_ir (lp)}, ptr ${val_ir (rp)})`)
      result_tmp <- fresh_tmp(em)
      emit_template(em, `  ${result_tmp} = icmp ${pred} i64 ${cmp_tmp}, 0`)
      val_make(ll_i1(), result_tmp)

fn emit_comparison(op: String, lv: Value, rv: Value, em: Emitter) -> Value !{IO} =
  if val_is_ptr(lv) then
    do
      rv_ptr <- coerce_value(rv, ll_ptr(), em)
      emit_ptr_comparison(op, lv, rv_ptr, em)
  else if val_is_ptr(rv) then
    do
      lv_ptr <- coerce_value(lv, ll_ptr(), em)
      emit_ptr_comparison(op, lv_ptr, rv, em)
  else
    do
      let pred = if op == "<" then "slt"
                 else if op == "<=" then "sle"
                 else if op == ">" then "sgt"
                 else if op == ">=" then "sge"
                 else if op == "==" then "eq"
                 else "ne"
      let ll = val_ll(lv)
      tmp <- fresh_tmp(em)
      emit_template(em, `  ${tmp} = icmp ${pred} ${ll} ${val_ir (lv)}, ${val_ir (rv)}`)
      val_make(ll_i1(), tmp)

fn emit_short_circuit(op: String, left: typed_ast.TypedExpr, right: typed_ast.TypedExpr, ctx: CgCtx, locals: Dict Value, em: Emitter) -> Value !{IO} =
  do
    raw_lv <- emit_expr(ctx, locals, em, Nothing, left)
    lv <- coerce_value(raw_lv, ll_i1(), em)
    left_blk <- read_cur_blk_or(em, "entry")
    rhs_lbl <- fresh_block(em, "logic_rhs")
    done_lbl <- fresh_block(em, "logic_done")
    let const_on_short = if op == "&&" then "0" else "1"
    let br_instr = if op == "&&"
                   then "  br i1 " ++ val_ir(lv) ++ ", label %" ++ rhs_lbl ++ ", label %" ++ done_lbl
                   else "  br i1 " ++ val_ir(lv) ++ ", label %" ++ done_lbl ++ ", label %" ++ rhs_lbl
    emit_line(em, br_instr)
    emit_label(em, rhs_lbl)
    raw_rv <- emit_expr(ctx, locals, em, Nothing, right)
    rv <- coerce_value(raw_rv, ll_i1(), em)
    rhs_end <- read_cur_blk_or(em, rhs_lbl)
    emit_template(em, `  br label %${done_lbl}`)
    emit_label(em, done_lbl)
    phi <- fresh_tmp(em)
    emit_template(em, `  ${phi} = phi i1 [ ${const_on_short}, %${left_blk} ], [ ${val_ir (rv)}, %${rhs_end} ]`)
    val_make(ll_i1(), phi)

fn emit_if(cond: typed_ast.TypedExpr, thn: typed_ast.TypedExpr, els: typed_ast.TypedExpr, ty: types.Type, ctx: CgCtx, locals: Dict Value, em: Emitter, tco_ctx: Maybe TcoCtx) -> Value !{IO} =
  do
    let out_ll = match tco_ctx with | Nothing -> type_to_ll(ty) | Just tc -> tco_ret_ll(tc)
    raw_cv <- emit_expr(ctx, locals, em, Nothing, cond)
    cv <- coerce_value(raw_cv, ll_i1(), em)
    then_lbl <- fresh_block(em, "if_then")
    else_lbl <- fresh_block(em, "if_else")
    done_lbl <- fresh_block(em, "if_done")
    emit_template(em, `  br i1 ${val_ir (cv)}, label %${then_lbl}, label %${else_lbl}`)
    emit_label(em, then_lbl)
    then_val <- emit_expr(ctx, locals, em, tco_ctx, thn)
    _ <- emit_pending_tco(tco_ctx, then_val, em)
    then_term <- is_terminated(em)
    then_coerced <- if then_term then then_val else coerce_value(then_val, out_ll, em)
    then_blk <- read_cur_blk_or(em, then_lbl)
    if then_term == false then emit_template(em, `  br label %${done_lbl}`) else ()
    emit_label(em, else_lbl)
    else_val <- emit_expr(ctx, locals, em, tco_ctx, els)
    _ <- emit_pending_tco(tco_ctx, else_val, em)
    else_term <- is_terminated(em)
    else_coerced <- if else_term then else_val else coerce_value(else_val, out_ll, em)
    else_blk <- read_cur_blk_or(em, else_lbl)
    if else_term == false then emit_template(em, `  br label %${done_lbl}`) else ()
    emit_label(em, done_lbl)
    if then_term && else_term then
      val_for_ll(out_ll, "undef")
    else
      do
        phi <- fresh_tmp(em)
        let parts = if then_term
                    then "[ " ++ val_ir(else_coerced) ++ ", %" ++ else_blk ++ " ]"
                    else if else_term
                    then "[ " ++ val_ir(then_coerced) ++ ", %" ++ then_blk ++ " ]"
                    else "[ " ++ val_ir(then_coerced) ++ ", %" ++ then_blk ++ " ], [ " ++ val_ir(else_coerced) ++ ", %" ++ else_blk ++ " ]"
        emit_template(em, `  ${phi} = phi ${out_ll} ${parts}`)
        val_for_ll(out_ll, phi)

fn emit_match(scrut: typed_ast.TypedExpr, branches: List typed_ast.TypedMatchBranch, ty: types.Type, ctx: CgCtx, locals: Dict Value, em: Emitter, tco_ctx: Maybe TcoCtx) -> Value !{IO} =
  match scrut with
  | typed_ast.TCall (typed_ast.TVar name _ _) call_args _ _ ->
      match dict_get(name, ctx_cpr_fns(ctx)) with
      | Just width ->
          if all_branches_simple(branches)
          then emit_match_unboxed_adt(name, call_args, scrut, branches, ty, width, ctx, locals, em, tco_ctx)
          else emit_match_heap(scrut, branches, ty, ctx, locals, em, tco_ctx)
      | Nothing ->
          emit_match_heap(scrut, branches, ty, ctx, locals, em, tco_ctx)
  | _ ->
      emit_match_heap(scrut, branches, ty, ctx, locals, em, tco_ctx)

fn emit_match_heap(scrut: typed_ast.TypedExpr, branches: List typed_ast.TypedMatchBranch, ty: types.Type, ctx: CgCtx, locals: Dict Value, em: Emitter, tco_ctx: Maybe TcoCtx) -> Value !{IO} =
  do
    sv <- emit_expr(ctx, locals, em, Nothing, scrut)
    done_lbl <- fresh_block(em, "match_done")
    let out_ll = match tco_ctx with | Nothing -> type_to_ll(ty) | Just tc -> tco_ret_ll(tc)
    let scrut_type = typed_ast.typed_expr_type(scrut)
    match_result <- emit_branches(branches, sv, scrut_type, out_ll, ctx, locals, em, tco_ctx, done_lbl, Nil)
    let branch_vals = match_result
    if list_is_nil_branch_vals(branch_vals) then
      val_for_ll(out_ll, "undef")
    else
      do
        emit_label(em, done_lbl)
        phi <- fresh_tmp(em)
        let parts = string.join(", ", list_map(\p -> match p with | (v, blk) -> "[ " ++ val_ir(v) ++ ", %" ++ blk ++ " ]", branch_vals))
        emit_template(em, `  ${phi} = phi ${out_ll} ${parts}`)
        val_for_ll(out_ll, phi)

fn emit_match_abort(em: Emitter) -> Unit !{IO} =
  do
    emit_line(em, "  call void @sprout_abort_match()")
    emit_line(em, "  unreachable")

fn emit_branches(branches: List typed_ast.TypedMatchBranch, scrut: Value, scrut_type: types.Type, out_ll: String, ctx: CgCtx, locals: Dict Value, em: Emitter, tco_ctx: Maybe TcoCtx, done_lbl: String, acc: List (Value, String)) -> List (Value, String) !{IO} =
  match branches with
  | Nil ->
      do
        emit_match_abort(em)
        list_reverse(acc)
  | Cons (typed_ast.TypedMatchBranch pat body) rest ->
      do
        branch_lbl <- fresh_block(em, "match_br")
        next_lbl <- fresh_block(em, "match_next")
        let is_always_match = is_wildcard_or_var(pat)
        if is_always_match then
          emit_template(em, `  br label %${branch_lbl}`)
        else
          do
            test_v <- emit_pattern_test(pat, scrut, ctx, em)
            emit_template(em, `  br i1 ${val_ir (test_v)}, label %${branch_lbl}, label %${next_lbl}`)
        emit_label(em, branch_lbl)
        (new_binds, rooted) <- emit_pattern_bind(pat, scrut, Just(scrut_type), ctx, em)
        let branch_locals = extend_locals(locals, new_binds)
        let branch_tco = match tco_ctx with
                         | Nothing -> Nothing
                         | Just tc -> Just(tco_with_outer_roots(tc, tco_outer_roots(tc) + rooted))
        body_val <- emit_expr(ctx, branch_locals, em, branch_tco, body)
        _ <- emit_pending_tco(branch_tco, body_val, em)
        branch_term <- is_terminated(em)
        if branch_term then
          do
            if list_is_nil_branches(rest) then
              do
                emit_label(em, next_lbl)
                emit_match_abort(em)
                list_reverse(acc)
            else
              do
                emit_label(em, next_lbl)
                emit_branches(rest, scrut, scrut_type, out_ll, ctx, locals, em, tco_ctx, done_lbl, acc)
        else
          do
            coerced_body <- coerce_value(body_val, out_ll, em)
            end_blk <- read_cur_blk_or(em, branch_lbl)
            pop_temp_roots(rooted, em)
            emit_template(em, `  br label %${done_lbl}`)
            emit_label(em, next_lbl)
            emit_branches(rest, scrut, scrut_type, out_ll, ctx, locals, em, tco_ctx, done_lbl, Cons((coerced_body, end_blk), acc))

fn is_wildcard_or_var(pat: ast.Pattern) -> Bool =
  match pat with
  | ast.WildcardPattern _ -> true
  | ast.VarPattern _ _ -> true
  | _ -> false

fn all_var_pats(args: List ast.Pattern) -> Bool =
  match args with
  | Nil -> true
  | Cons (ast.VarPattern _ _) rest -> all_var_pats(rest)
  | Cons (ast.WildcardPattern _) rest -> all_var_pats(rest)
  | _ -> false

# Top-level VarPattern excluded: it binds the whole scrutinee as i64, but in
# the unboxed path the scrutinee is a { i64, ... } struct value — types don't align.
fn is_simple_pat(pat: ast.Pattern) -> Bool =
  match pat with
  | ast.WildcardPattern _ -> true
  | ast.ConstructorPattern _ args _ -> all_var_pats(args)
  | _ -> false

fn all_branches_simple(branches: List typed_ast.TypedMatchBranch) -> Bool =
  match branches with
  | Nil -> true
  | Cons (typed_ast.TypedMatchBranch pat _) rest ->
      if is_simple_pat(pat) then all_branches_simple(rest) else false

fn emit_unboxed_pattern_test(pat: ast.Pattern, tag_tmp: String, ctx: CgCtx, em: Emitter) -> Value !{IO} =
  match pat with
  | ast.ConstructorPattern name _ _ ->
      match dict_get(name, ctx_ctor_sigs(ctx)) with
      | Nothing -> val_make(ll_i1(), "0")
      | Just ctor ->
          do
            eq_t <- fresh_tmp(em)
            emit_template(em, `  ${eq_t} = icmp eq i64 ${tag_tmp}, ${int_to_string (ctor_tag(ctor))}`)
            val_make(ll_i1(), eq_t)
  | _ -> val_make(ll_i1(), "1")

fn emit_unboxed_pattern_bind(pat: ast.Pattern, r: String, ll_struct: String, em: Emitter) -> (List (String, Value), Int) !{IO} =
  match pat with
  | ast.WildcardPattern _ -> (Nil, 0)
  | ast.ConstructorPattern _ args _ ->
      emit_unboxed_ctor_args_bind(args, r, ll_struct, em, 1, Nil, 0)
  | _ -> (Nil, 0)

fn emit_unboxed_ctor_args_bind(args: List ast.Pattern, r: String, ll_struct: String, em: Emitter, field_idx: Int, acc: List (String, Value), rooted: Int) -> (List (String, Value), Int) !{IO} =
  match args with
  | Nil -> (list_reverse(acc), rooted)
  | Cons arg rest_args ->
      match arg with
      | ast.VarPattern vname _ ->
          do
            f <- fresh_tmp(em)
            emit_template(em, `  ${f} = extractvalue ${ll_struct} ${r}, ${int_to_string (field_idx)}`)
            let fv = val_make(ll_i64(), f)
            rooted_field <- push_temp_root(fv, em)
            emit_unboxed_ctor_args_bind(rest_args, r, ll_struct, em, field_idx + 1, Cons((vname, fv), acc), rooted + rooted_field)
      | _ ->
          emit_unboxed_ctor_args_bind(rest_args, r, ll_struct, em, field_idx + 1, acc, rooted)

fn emit_unboxed_branches(branches: List typed_ast.TypedMatchBranch, r: String, tag_tmp: String, ll_struct: String, out_ll: String, ctx: CgCtx, locals: Dict Value, em: Emitter, tco_ctx: Maybe TcoCtx, done_lbl: String, acc: List (Value, String)) -> List (Value, String) !{IO} =
  match branches with
  | Nil ->
      do
        emit_match_abort(em)
        list_reverse(acc)
  | Cons (typed_ast.TypedMatchBranch pat body) rest ->
      do
        branch_lbl <- fresh_block(em, "match_br")
        next_lbl <- fresh_block(em, "match_next")
        let is_always = is_wildcard_or_var(pat)
        if is_always then
          emit_template(em, `  br label %${branch_lbl}`)
        else
          do
            test_v <- emit_unboxed_pattern_test(pat, tag_tmp, ctx, em)
            emit_template(em, `  br i1 ${val_ir (test_v)}, label %${branch_lbl}, label %${next_lbl}`)
        emit_label(em, branch_lbl)
        (new_binds, rooted) <- emit_unboxed_pattern_bind(pat, r, ll_struct, em)
        let branch_locals = extend_locals(locals, new_binds)
        let branch_tco = match tco_ctx with
                         | Nothing -> Nothing
                         | Just tc -> Just(tco_with_outer_roots(tc, tco_outer_roots(tc) + rooted))
        body_val <- emit_expr(ctx, branch_locals, em, branch_tco, body)
        _ <- emit_pending_tco(branch_tco, body_val, em)
        branch_term <- is_terminated(em)
        if branch_term then
          do
            if list_is_nil_branches(rest) then
              do
                emit_label(em, next_lbl)
                emit_match_abort(em)
                list_reverse(acc)
            else
              do
                emit_label(em, next_lbl)
                emit_unboxed_branches(rest, r, tag_tmp, ll_struct, out_ll, ctx, locals, em, tco_ctx, done_lbl, acc)
        else
          do
            coerced_body <- coerce_value(body_val, out_ll, em)
            end_blk <- read_cur_blk_or(em, branch_lbl)
            pop_temp_roots(rooted, em)
            emit_template(em, `  br label %${done_lbl}`)
            emit_label(em, next_lbl)
            emit_unboxed_branches(rest, r, tag_tmp, ll_struct, out_ll, ctx, locals, em, tco_ctx, done_lbl, Cons((coerced_body, end_blk), acc))

fn emit_match_unboxed_adt(name: String, call_args: List typed_ast.TypedExpr, scrut: typed_ast.TypedExpr, branches: List typed_ast.TypedMatchBranch, ty: types.Type, width: Int, ctx: CgCtx, locals: Dict Value, em: Emitter, tco_ctx: Maybe TcoCtx) -> Value !{IO} =
  match dict_get(name ++ "_unboxed", ctx_cpr_extern_sigs(ctx)) with
  | Just sig ->
      emit_match_unboxed_call(name ++ "_unboxed", sig, call_args, branches, ty, width, ctx, locals, em, tco_ctx)
  | Nothing ->
      match dict_get(name, ctx_fn_sigs(ctx)) with
      | Just sig ->
          emit_match_unboxed_call(emitted_fn_name(name) ++ "_worker", sig, call_args, branches, ty, width, ctx, locals, em, tco_ctx)
      | Nothing ->
          emit_match_heap(scrut, branches, ty, ctx, locals, em, tco_ctx)

fn emit_match_unboxed_call(call_fn: String, sig: FnSig, call_args: List typed_ast.TypedExpr, branches: List typed_ast.TypedMatchBranch, ty: types.Type, width: Int, ctx: CgCtx, locals: Dict Value, em: Emitter, tco_ctx: Maybe TcoCtx) -> Value !{IO} =
  do
    (arg_vals, rooted_args) <- emit_args_with_roots(call_args, ctx, locals, em)
    coerced <- coerce_args(fn_params(sig), arg_vals, em)
    let args_ir = string.join(", ", list_map(\p -> match p with | (ll, ir) -> format_ll_ir(ll, ir), coerced))
    r <- fresh_tmp(em)
    let ll_struct = ll_for_unboxed_width(width)
    let call_str = if args_ir == ""
                   then "  " ++ r ++ " = call " ++ ll_struct ++ " @" ++ call_fn ++ "()"
                   else "  " ++ r ++ " = call " ++ ll_struct ++ " @" ++ call_fn ++ "(" ++ args_ir ++ ")"
    emit_line(em, call_str)
    pop_temp_roots(rooted_args, em)
    tag_tmp <- fresh_tmp(em)
    emit_template(em, `  ${tag_tmp} = extractvalue ${ll_struct} ${r}, 0`)
    done_lbl <- fresh_block(em, "match_done")
    let out_ll = match tco_ctx with | Nothing -> type_to_ll(ty) | Just tc -> tco_ret_ll(tc)
    branch_vals <- emit_unboxed_branches(branches, r, tag_tmp, ll_struct, out_ll, ctx, locals, em, tco_ctx, done_lbl, Nil)
    if list_is_nil_branch_vals(branch_vals) then
      val_for_ll(out_ll, "undef")
    else
      do
        emit_label(em, done_lbl)
        phi <- fresh_tmp(em)
        let parts = string.join(", ", list_map(\p -> match p with | (v, blk) -> "[ " ++ val_ir(v) ++ ", %" ++ blk ++ " ]", branch_vals))
        emit_template(em, `  ${phi} = phi ${out_ll} ${parts}`)
        val_for_ll(out_ll, phi)

fn list_is_nil_branch_vals(xs: List (Value, String)) -> Bool =
  match xs with | Nil -> true | _ -> false

fn list_is_nil_branches(xs: List typed_ast.TypedMatchBranch) -> Bool =
  match xs with | Nil -> true | _ -> false

fn emit_call(callee: typed_ast.TypedExpr, args: List typed_ast.TypedExpr, ty: types.Type, ctx: CgCtx, locals: Dict Value, em: Emitter, tco_ctx: Maybe TcoCtx) -> Value !{IO} =
  match callee with
  | typed_ast.TVar "print" _ _ ->
      emit_print_call(args, ctx, locals, em)
  | typed_ast.TVar "eprint" _ _ ->
      emit_eprint_call(args, ctx, locals, em)
  | typed_ast.TVar name callee_ty _ ->
      emit_named_call(name, callee_ty, args, ty, ctx, locals, em, tco_ctx)
  | _ ->
      do
        callee_val <- emit_expr(ctx, locals, em, Nothing, callee)
        rooted_callee <- push_temp_root(callee_val, em)
        let callee_ty = typed_ast.typed_expr_type(callee)
        let sig_opt = match val_call_sig(callee_val) with
                      | Just s -> Just(s)
                      | Nothing -> call_sig_from_type(callee_ty)
        match sig_opt with
        | Nothing ->
            do
              pop_temp_roots(rooted_callee, em)
              zero_val(type_to_ll(ty))
        | Just sig ->
            do
              (arg_vals, rooted_args) <- emit_args_with_roots(args, ctx, locals, em)
              let n_args = list_length_vals(arg_vals)
              let n_params = list_length(sig_params(sig))
              result <- if n_args < n_params then
                          do
                            lam_idx <- fresh_lambda_idx(em)
                            let wrap_name = "__sprout_partial_" ++ int_to_string(lam_idx)
                            let part_lines = emit_partial_closure_wrapper_lines(wrap_name, sig, n_args)
                            emit_defs_list(part_lines, em)
                            add_def_line(em, "")
                            closure <- emit_make_closure("@" ++ wrap_name, Cons(callee_val, arg_vals), em)
                            let rem_params = list_drop(sig_params(sig), n_args)
                            val_with_call_sig(closure, Just (CallSig(rem_params, sig_ret(sig), sig_ret_sig(sig))))
                        else
                          emit_closure_call(callee_val, sig, arg_vals, em)
              pop_temp_roots(rooted_args, em)
              pop_temp_roots(rooted_callee, em)
              result

fn emit_print_call(args: List typed_ast.TypedExpr, ctx: CgCtx, locals: Dict Value, em: Emitter) -> Value !{IO} =
  match args with
  | Nil -> val_make(ll_i64(), "0")
  | Cons arg _ ->
      do
        v <- emit_expr(ctx, locals, em, Nothing, arg)
        let arg_ty = typed_ast.typed_expr_type(arg)
        if val_is_ptr(v) then
          do
            tmp <- fresh_tmp(em)
            emit_template(em, `  ${tmp} = call i64 @print_str(ptr ${val_ir (v)})`)
            val_make(ll_i64(), tmp)
        else if val_is_i64(v) && (is_string_type(arg_ty) || is_char_type(arg_ty)) then
          do
            vp <- coerce_value(v, ll_ptr(), em)
            tmp <- fresh_tmp(em)
            emit_template(em, `  ${tmp} = call i64 @print_str(ptr ${val_ir (vp)})`)
            val_make(ll_i64(), tmp)
        else if val_is_i64(v) then
          do
            tmp <- fresh_tmp(em)
            emit_template(em, `  ${tmp} = call i64 @print_value(i64 ${val_ir (v)})`)
            val_make(ll_i64(), tmp)
        else if val_is_i1(v) then
          do
            w <- fresh_tmp(em)
            emit_template(em, `  ${w} = zext i1 ${val_ir (v)} to i64`)
            tmp <- fresh_tmp(em)
            emit_template(em, `  ${tmp} = call i64 @print_value(i64 ${w})`)
            val_make(ll_i64(), tmp)
        else
          val_make(ll_i64(), "0")

fn emit_eprint_call(args: List typed_ast.TypedExpr, ctx: CgCtx, locals: Dict Value, em: Emitter) -> Value !{IO} =
  match args with
  | Nil -> val_make(ll_i64(), "0")
  | Cons arg _ ->
      do
        v <- emit_expr(ctx, locals, em, Nothing, arg)
        vp <- coerce_value(v, ll_ptr(), em)
        tmp <- fresh_tmp(em)
        emit_template(em, `  ${tmp} = call i64 @eprint_str(ptr ${val_ir (vp)})`)
        val_make(ll_i64(), tmp)

fn strip_module_prefix(name: String) -> String =
  if dot_pos < 0
  then name
  else strip_module_prefix(str_slice(name, dot_pos + 1, str_len(name)))
  where dot_pos = str_find(name, ".")

fn emit_named_call(name: String, callee_ty: types.Type, args: List typed_ast.TypedExpr, ty: types.Type, ctx: CgCtx, locals: Dict Value, em: Emitter, tco_ctx: Maybe TcoCtx) -> Value !{IO} =
  if strip_module_prefix(name) == "append" then
    emit_append_call(args, ty, ctx, locals, em)
  else
    match dict_get(name, ctx_ctor_sigs(ctx)) with
    | Just ctor ->
        emit_ctor_call_expr(ctor, args, ctx, locals, em)
    | Nothing ->
        match dict_get(name, ctx_fn_sigs(ctx)) with
        | Just sig ->
            emit_direct_fn_call(name, sig, args, ty, ctx, locals, em, tco_ctx)
        | Nothing ->
            match dict_get(name, ctx_extern_sigs(ctx)) with
            | Just ext_sig ->
                emit_direct_fn_call(name, ext_sig, args, ty, ctx, locals, em, Nothing)
            | Nothing ->
                match dict_get(name, locals) with
                | Just local_v ->
                    do
                      rooted <- push_temp_root(local_v, em)
                      let sig_opt = match val_call_sig(local_v) with
                                    | Just s -> Just(s)
                                    | Nothing -> call_sig_from_type(callee_ty)
                      match sig_opt with
                      | Nothing ->
                          do
                            # sig_opt = Nothing means callee_ty is TVar (unannotated dispatch param).
                            # The value is an i64-boxed closure ptr. Re-root as ptr, reconstruct
                            # CallSig from call-site arg types, and invoke via emit_closure_call.
                            pop_temp_roots(rooted, em)
                            let arg_lls = list_map(\a -> type_to_ll(typed_ast.typed_expr_type(a)), args)
                            let reconstructed_sig = CallSig(arg_lls, type_to_ll(ty), Nothing)
                            ptr_v <- coerce_value(local_v, ll_ptr(), em)
                            rooted2 <- push_temp_root(ptr_v, em)
                            (arg_vals, rooted_args) <- emit_args_with_roots(args, ctx, locals, em)
                            result <- emit_closure_call(ptr_v, reconstructed_sig, arg_vals, em)
                            pop_temp_roots(rooted_args, em)
                            pop_temp_roots(rooted2, em)
                            result
                      | Just sig ->
                          do
                            # local_v may be i64 (GC Option C: typeclass dict method stored as
                            # i64-boxed closure). coerce_value is a no-op when already ptr.
                            callee_ptr <- coerce_value(local_v, ll_ptr(), em)
                            (arg_vals, rooted_args) <- emit_args_with_roots(args, ctx, locals, em)
                            result <- emit_closure_call(callee_ptr, sig, arg_vals, em)
                            pop_temp_roots(rooted_args, em)
                            pop_temp_roots(rooted, em)
                            result
                | Nothing ->
                    match dict_get(name, ctx_globals(ctx)) with
                    | Just gi ->
                        do
                          tmp <- fresh_tmp(em)
                          emit_template(em, `  ${tmp} = load ${gi_ll (gi)}, ptr @${name}`)
                          let gv = val_with_call_sig(val_make(gi_ll(gi), tmp), gi_call_sig(gi))
                          match gi_call_sig(gi) with
                          | Nothing -> gv
                          | Just sig ->
                              do
                                (arg_vals, rooted_args) <- emit_args_with_roots(args, ctx, locals, em)
                                result <- emit_closure_call(gv, sig, arg_vals, em)
                                pop_temp_roots(rooted_args, em)
                                result
                    | Nothing ->
                        zero_val(type_to_ll(ty))

fn emit_append_call(args: List typed_ast.TypedExpr, ty: types.Type, ctx: CgCtx, locals: Dict Value, em: Emitter) -> Value !{IO} =
  match args with
  | [typed_ast.TDict _ _ _, left, right | _] ->
      emit_append_operands(left, right, ty, ctx, locals, em)
  | [left, right | _] ->
      emit_append_operands(left, right, ty, ctx, locals, em)
  | _ -> zero_val(type_to_ll(ty))

fn emit_append_operands(left: typed_ast.TypedExpr, right: typed_ast.TypedExpr, ty: types.Type, ctx: CgCtx, locals: Dict Value, em: Emitter) -> Value !{IO} =
      if is_string_type(typed_ast.typed_expr_type(left)) || is_string_type(ty) then
        do
          lv <- emit_expr(ctx, locals, em, Nothing, left)
          rooted <- push_temp_root(lv, em)
          rv <- emit_expr(ctx, locals, em, Nothing, right)
          pop_temp_roots(rooted, em)
          li <- coerce_value(lv, ll_i64(), em)
          ri <- coerce_value(rv, ll_i64(), em)
          tmp <- fresh_tmp(em)
          emit_template(em, `  ${tmp} = call i64 @str_concat(i64 ${val_ir (li)}, i64 ${val_ir (ri)})`)
          val_make(ll_i64(), tmp)
      else if is_list_type(typed_ast.typed_expr_type(left)) || is_list_type(ty) then
        emit_regular_direct_call("list_append", FnSig("list_append", Cons(ll_i64(), Cons(ll_i64(), Nil)), ll_i64(), Nothing), Cons(left, Cons(right, Nil)), type_to_ll(ty), ctx, locals, em)
      else
        zero_val(type_to_ll(ty))

fn emit_ctor_call_expr(ctor: CtorSig, args: List typed_ast.TypedExpr, ctx: CgCtx, locals: Dict Value, em: Emitter) -> Value !{IO} =
  if ctor_is_wrap(ctor) then
    # Wrap construction is identity: emit the single arg expression and return
    # its value directly.  No alloc, no rebox, no field packing — the wrap and
    # the inner value share the same IR representation.
    match args with
    | Cons arg Nil -> emit_expr(ctx, locals, em, Nothing, arg)
    | _ -> zero_val(ll_i64())  # wrap arity is always 1; defensive fallback
  else if n_arity == 0 then
    do
      tmp <- fresh_tmp(em)
      let fn_name_ = if is_nothing_ctor(ctor_name(ctor)) then "@sprout_nothing" else "@sprout_make0"
      emit_template(em, `  ${tmp} = call i64 ${fn_name_}(i64 ${int_to_string (ctor_tag(ctor))})`)
      val_make(ll_i64(), tmp)
  else if n_args < n_arity then
    # Partial constructor application
    do
      (arg_vals, rooted_args) <- emit_args_with_roots(args, ctx, locals, em)
      lam_idx <- fresh_lambda_idx(em)
      let wrap_name = "__sprout_ctor_part_" ++ int_to_string(lam_idx)
      emit_ctor_partial_wrapper(wrap_name, ctor, n_args, em)
      closure <- emit_make_closure("@" ++ wrap_name, arg_vals, em)
      pop_temp_roots(rooted_args, em)
      let rem_lls = list_drop(ctor_arg_lls(ctor), n_args)
      val_with_call_sig(closure, Just (CallSig(rem_lls, ll_i64(), Nothing)))
  else
    do
      (arg_vals, rooted_args) <- emit_args_with_roots_lls(args, ctor_arg_lls(ctor), ctx, locals, em)
      coerced <- coerce_args(ctor_arg_lls(ctor), arg_vals, em)
      rooted_packed <- push_packed_roots(coerced, em)
      packed <- pack_coerced(coerced, em)
      let n = list_length(packed)
      let args_ir = string.join(", ", list_map(\p -> "i64 " ++ p, packed))
      tmp <- fresh_tmp(em)
      let sep = if args_ir == "" then "" else ", "
      emit_template(em, `  ${tmp} = call i64 @sprout_make${int_to_string (n)}(i64 ${int_to_string (ctor_tag(ctor))}${sep}${args_ir})`)
      pop_temp_roots(rooted_packed, em)
      pop_temp_roots(rooted_args, em)
      val_make(ll_i64(), tmp)
  where n_args = list_length_exprs(args)
        n_arity = ctor_arity(ctor)

fn push_packed_roots(coerced: List (String, String), em: Emitter) -> Int !{IO} =
  match coerced with
  | Nil -> 0
  | Cons (ll, ir) rest ->
      do
        n <- push_temp_root(val_make(ll, ir), em)
        ns <- push_packed_roots(rest, em)
        n + ns

fn pack_coerced(coerced: List (String, String), em: Emitter) -> List String !{IO} =
  match coerced with
  | Nil -> Nil
  | Cons (ll, ir) rest ->
      do
        packed <- pack_to_i64(val_make(ll, ir), em)
        rest_packed <- pack_coerced(rest, em)
        Cons(packed, rest_packed)

fn emit_ctor_partial_wrapper(wrap_name: String, ctor: CtorSig, applied: Int, em: Emitter) -> Unit !{IO} =
  do
    let all_lls = ctor_arg_lls(ctor)
    let rem_lls = list_drop(all_lls, applied)
    let params_str = build_wrapper_params(rem_lls, 0)
    saved <- save_body(em)
    emit_template(em, `define i64 @${wrap_name}(ptr %env${params_str}) {`)
    emit_label(em, "entry")
    applied_packed <- load_applied_from_env(all_lls, applied, em, 1)
    remain_packed <- pack_args_from_env(rem_lls, 0, em)
    let all_packed = applied_packed ++ remain_packed
    let n = list_length(all_packed)
    let args_ir = string.join(", ", list_map(\p -> "i64 " ++ p, all_packed))
    ret <- fresh_tmp(em)
    let sep = if args_ir == "" then "" else ", "
    emit_template(em, `  ${ret} = call i64 @sprout_make${int_to_string (n)}(i64 ${int_to_string (ctor_tag(ctor))}${sep}${args_ir})`)
    emit_template(em, `  ret i64 ${ret}`)
    emit_line(em, "}")
    fn_lines <- flush_body(em)
    emit_defs_list(fn_lines, em)
    add_def_line(em, "")
    restore_body(em, saved)

fn load_applied_from_env(lls: List String, n: Int, em: Emitter, slot_idx: Int) -> List String !{IO} =
  if n <= 0 then Nil
  else
    match lls with
    | Nil -> Nil
    | Cons ll rest ->
        do
          slot <- fresh_tmp(em)
          emit_template(em, `  ${slot} = getelementptr i64, ptr %env, i64 ${int_to_string (slot_idx)}`)
          raw <- fresh_tmp(em)
          emit_template(em, `  ${raw} = load i64, ptr ${slot}`)
          rest_packed <- load_applied_from_env(rest, n - 1, em, slot_idx + 1)
          Cons(raw, rest_packed)

fn emit_warn_and_regular_call(caller: String, callee: String, sig: FnSig, args: List typed_ast.TypedExpr, target_ll: String, ctx: CgCtx, locals: Dict Value, em: Emitter) -> Value !{IO} =
  do
    old <- ref_read(em_warns_ref(em))
    ref_write(em_warns_ref(em), Cons("tail call from `" ++ caller ++ "` to `" ++ callee ++ "` will allocate a stack frame (cross-function tail call in a TCO function)", old))
    emit_regular_direct_call(callee, sig, args, target_ll, ctx, locals, em)

fn emit_direct_fn_call(name: String, sig: FnSig, args: List typed_ast.TypedExpr, ty: types.Type, ctx: CgCtx, locals: Dict Value, em: Emitter, tco_ctx: Maybe TcoCtx) -> Value !{IO} =
  if n_args < n_params then
    do
      # Partial application of a direct function
      (arg_vals, rooted_args) <- emit_args_with_roots(args, ctx, locals, em)
      lam_idx <- fresh_lambda_idx(em)
      let wrap_name = "__sprout_partial_" ++ int_to_string(lam_idx)
      let part_lines = emit_partial_direct_wrapper_lines(wrap_name, name, sig, n_args)
      emit_defs_list(part_lines, em)
      add_def_line(em, "")
      closure <- emit_make_closure("@" ++ wrap_name, arg_vals, em)
      pop_temp_roots(rooted_args, em)
      let rem = list_drop(fn_params(sig), n_args)
      val_with_call_sig(closure, Just (CallSig(rem, fn_ret(sig), fn_ret_sig(sig))))
  else
    match tco_ctx with
    | Just tc ->
        if tco_fn_name(tc) == name && n_args == n_params then
          # Self-tail-call → TCO back edge
          do
            (raw_args, rooted_args) <- emit_tco_args(args, ctx, locals, em)
            coerced_args <- coerce_tco_args(raw_args, tco_slots(tc), em)
            pop_temp_roots(rooted_args, em)
            val_with_tco_args(val_make(tco_ret_ll(tc), "undef"), Just(coerced_args))
        else if set_member(name, ctx_mutual_tco_fns(ctx)) && n_args == n_params then
          # musttail requires identical return type (i64) and param types; skip if not met.
          if tco_ret_ll(tc) == ll_i64() && params_match_slots(fn_params(sig), tco_slots(tc)) then
            do
              (arg_vals, rooted_args) <- emit_tco_args(args, ctx, locals, em)
              coerced <- coerce_args(fn_params(sig), arg_vals, em)
              let args_ir = string.join(", ", list_map(\p -> match p with | (ll, ir) -> format_ll_ir(ll, ir), coerced))
              pop_temp_roots(rooted_args + tco_outer_roots(tc) + tco_n_roots(tc), em)
              let sp = tco_sp_save(tc)
              if str_len(sp) > 0 then
                emit_template(em, `  call void @llvm.stackrestore(ptr ${sp})`)
              else ()
              result_tmp <- fresh_tmp(em)
              let call_name = emitted_fn_name(name)
              let call_str = if args_ir == ""
                             then "  " ++ result_tmp ++ " = musttail call i64 @" ++ call_name ++ "()"
                             else "  " ++ result_tmp ++ " = musttail call i64 @" ++ call_name ++ "(" ++ args_ir ++ ")"
              emit_line(em, call_str)
              emit_line(em, "  ret i64 " ++ result_tmp)
              val_for_ll(tco_ret_ll(tc), "undef")
          else
            emit_regular_direct_call(name, sig, args, type_to_ll(ty), ctx, locals, em)
        else
          emit_warn_and_regular_call(tco_fn_name(tc), name, sig, args, type_to_ll(ty), ctx, locals, em)
    | Nothing ->
        emit_regular_direct_call(name, sig, args, type_to_ll(ty), ctx, locals, em)
  where n_args = list_length_exprs(args)
        n_params = fn_arity(sig)

fn emit_regular_direct_call(name: String, sig: FnSig, args: List typed_ast.TypedExpr, target_ll: String, ctx: CgCtx, locals: Dict Value, em: Emitter) -> Value !{IO} =
  do
    (arg_vals, rooted_args) <- emit_args_with_roots(args, ctx, locals, em)
    coerced <- coerce_args(fn_params(sig), arg_vals, em)
    let args_ir = string.join(", ", list_map(\p -> match p with | (ll, ir) -> format_ll_ir(ll, ir), coerced))
    tmp <- fresh_tmp(em)
    let call_name = emitted_fn_name(name)
    let call_str = if args_ir == ""
                   then "  " ++ tmp ++ " = call " ++ fn_ret(sig) ++ " @" ++ call_name ++ "()"
                   else "  " ++ tmp ++ " = call " ++ fn_ret(sig) ++ " @" ++ call_name ++ "(" ++ args_ir ++ ")"
    emit_line(em, call_str)
    pop_temp_roots(rooted_args, em)
    result <- coerce_value(val_with_call_sig(val_for_ll(fn_ret(sig), tmp), fn_ret_sig(sig)), target_ll, em)
    val_with_call_sig(result, fn_ret_sig(sig))

fn emit_args_with_roots(args: List typed_ast.TypedExpr, ctx: CgCtx, locals: Dict Value, em: Emitter) -> (List Value, Int) !{IO} =
  match args with
  | Nil -> (Nil, 0)
  | Cons arg rest ->
      do
        v <- emit_expr(ctx, locals, em, Nothing, arg)
        rooted <- push_temp_root_typed(v, typed_ast.typed_expr_type(arg), em)
        (rest_vals, rest_rooted) <- emit_args_with_roots(rest, ctx, locals, em)
        (Cons(v, rest_vals), rooted + rest_rooted)

fn emit_args_with_roots_lls(args: List typed_ast.TypedExpr, lls: List String, ctx: CgCtx, locals: Dict Value, em: Emitter) -> (List Value, Int) !{IO} =
  match args with
  | Nil -> (Nil, 0)
  | Cons arg rest ->
      do
        v <- emit_expr(ctx, locals, em, Nothing, arg)
        rooted <- push_temp_root_typed(v, typed_ast.typed_expr_type(arg), em)
        (rest_vals, rest_rooted) <- emit_args_with_roots_lls(rest, list_drop(lls, 1), ctx, locals, em)
        (Cons(v, rest_vals), rooted + rest_rooted)

fn emit_tco_args(args: List typed_ast.TypedExpr, ctx: CgCtx, locals: Dict Value, em: Emitter) -> (List Value, Int) !{IO} =
  match args with
  | Nil -> (Nil, 0)
  | Cons arg rest ->
      do
        v <- emit_expr(ctx, locals, em, Nothing, arg)
        let has_more = list_is_nil_exprs(rest) == false
        rooted <- if has_more then push_temp_root_typed(v, typed_ast.typed_expr_type(arg), em) else 0
        (rest_vals, rest_rooted) <- emit_tco_args(rest, ctx, locals, em)
        (Cons(v, rest_vals), rooted + rest_rooted)

fn coerce_tco_args(args: List Value, slots: List (String, String), em: Emitter) -> List Value !{IO} =
  match args with
  | Nil -> Nil
  | Cons v rest_args ->
      match slots with
      | Nil -> Nil
      | Cons (_, ll) rest_slots ->
          do
            cv <- coerce_value(v, ll, em)
            rest <- coerce_tco_args(rest_args, rest_slots, em)
            Cons(cv, rest)

fn emit_partial_closure_wrapper_lines(wrap_name: String, sig: CallSig, applied: Int) -> List String =
  Cons("define " ++ sig_ret(sig) ++ " @" ++ wrap_name ++ "(ptr %env" ++ rem_params_str ++ ") {",
  Cons("entry:",
  list_append(callee_load_lines,
  list_append(load_applied_lines,
  Cons(call_str,
  Cons("  ret " ++ sig_ret(sig) ++ " %ret",
  Cons("}", Nil)))))))
  where all_params = sig_params(sig)
        remaining = list_drop(all_params, applied)
        rem_params_str = build_wrapper_params(remaining, 0)
        load_applied_lines = build_load_applied_closure(all_params, applied)
        callee_load_lines = Cons("  %callee_slot = getelementptr i64, ptr %env, i64 1",
                            Cons("  %callee_raw = load i64, ptr %callee_slot",
                            Cons("  %callee = inttoptr i64 %callee_raw to ptr", Nil)))
        applied_args = build_applied_arg_strs(all_params, 0, applied)
        remain_args = build_remain_arg_strs(remaining, 0)
        all_args = join_args_str(applied_args, remain_args)
        call_str = "  %ret = call " ++ sig_ret(sig) ++ " %callee(ptr %callee" ++ (if all_args == "" then ")" else ", " ++ all_args ++ ")")

fn build_load_applied_closure(lls: List String, n: Int) -> List String =
  build_load_applied_closure_acc(lls, n, 0)

fn build_load_applied_closure_acc(lls: List String, n: Int, idx: Int) -> List String =
  if idx >= n then Nil
  else
    match lls with
    | Nil -> Nil
    | Cons ll rest ->
        Cons("  %cslot" ++ int_to_string(idx) ++ " = getelementptr i64, ptr %env, i64 " ++ int_to_string(idx + 2),
        Cons("  %craw" ++ int_to_string(idx) ++ " = load i64, ptr %cslot" ++ int_to_string(idx),
        Cons(if ll == ll_i1() then "  %cap" ++ int_to_string(idx) ++ " = trunc i64 %craw" ++ int_to_string(idx) ++ " to i1"
             else if ll == ll_ptr() then "  %cap" ++ int_to_string(idx) ++ " = inttoptr i64 %craw" ++ int_to_string(idx) ++ " to ptr"
             else "",
        build_load_applied_closure_acc(rest, n, idx + 1))))

fn list_is_nil_exprs(xs: List typed_ast.TypedExpr) -> Bool =
  match xs with | Nil -> true | _ -> false

fn list_length_exprs(xs: List typed_ast.TypedExpr) -> Int =
  list_fold(\ (acc, _) -> acc + 1, 0, xs)

fn emit_do(steps: List typed_ast.TypedDoStep, result_ty: types.Type, ctx: CgCtx, locals: Dict Value, em: Emitter, tco_ctx: Maybe TcoCtx) -> Value !{IO} =
  match steps with
  | Nil -> zero_val(type_to_ll(result_ty))
  | Cons step rest ->
      match step with
      | typed_ast.TDoLetStep name e ->
          do
            v <- emit_expr(ctx, locals, em, Nothing, e)
            rooted <- push_temp_root_typed(v, typed_ast.typed_expr_type(e), em)
            let step_tco = tco_with_extra_roots(tco_ctx, rooted)
            result <- emit_do(rest, result_ty, ctx, dict_set(name, v, locals), em, step_tco)
            _ <- emit_pending_tco(step_tco, result, em)
            result_term <- is_terminated(em)
            if result_term == false then pop_temp_roots(rooted, em) else ()
            result
      | typed_ast.TDoExprStep e ->
          match rest with
          | Nil -> emit_expr(ctx, locals, em, tco_ctx, e)
          | _ ->
              do
                _ <- emit_expr(ctx, locals, em, Nothing, e)
                emit_do(rest, result_ty, ctx, locals, em, tco_ctx)
      | typed_ast.TDoBindStep pat e ->
          do
            v <- emit_expr(ctx, locals, em, Nothing, e)
            let e_ty = typed_ast.typed_expr_type(e)
            if is_maybe_type(e_ty) then
              emit_do_maybe_bind(pat, v, e_ty, rest, result_ty, ctx, locals, em, tco_ctx)
            else if is_result_type(e_ty) then
              emit_do_result_bind(pat, v, e_ty, rest, result_ty, ctx, locals, em, tco_ctx)
            else
              do
                # IO bind: just evaluate and bind
                (new_binds, rooted) <- emit_pattern_bind(pat, v, Nothing, ctx, em)
                let bind_tco = tco_with_extra_roots(tco_ctx, rooted)
                result <- emit_do(rest, result_ty, ctx, extend_locals(locals, new_binds), em, bind_tco)
                _ <- emit_pending_tco(bind_tco, result, em)
                result_term <- is_terminated(em)
                if result_term == false then pop_temp_roots(rooted, em) else ()
                result

fn emit_do_maybe_bind(pat: ast.Pattern, v: Value, maybe_ty: types.Type, rest: List typed_ast.TypedDoStep, result_ty: types.Type, ctx: CgCtx, locals: Dict Value, em: Emitter, tco_ctx: Maybe TcoCtx) -> Value !{IO} =
  do
    # Check if the value is Nothing
    tag_t <- fresh_tmp(em)
    emit_template(em, `  ${tag_t} = call i64 @sprout_tag(i64 ${val_ir (v)})`)
    # Find the Nothing tag from ctor_sigs
    let nothing_tag = find_nothing_tag(ctx_ctor_sigs(ctx))
    eq_t <- fresh_tmp(em)
    emit_template(em, `  ${eq_t} = icmp eq i64 ${tag_t}, ${int_to_string (nothing_tag)}`)
    nothing_lbl <- fresh_block(em, "do_nothing")
    just_lbl <- fresh_block(em, "do_just")
    done_lbl <- fresh_block(em, "do_done")
    emit_template(em, `  br i1 ${eq_t}, label %${nothing_lbl}, label %${just_lbl}`)
    # Nothing branch: return Nothing of result type
    emit_label(em, nothing_lbl)
    nothing_v <- emit_nothing_value(nothing_tag, em)
    emit_template(em, `  br label %${done_lbl}`)
    # Just branch: extract payload and continue
    emit_label(em, just_lbl)
    let inner_ll = match maybe_ty with
                   | types.TApp _ inner -> type_to_ll(inner)
                   | _ -> ll_i64()
    payload <- emit_ctor_field(val_ir(v), 0, inner_ll, em)
    (new_binds, rooted) <- emit_pattern_bind(pat, payload, Nothing, ctx, em)
    let bind_tco = tco_with_extra_roots(tco_ctx, rooted)
    cont_v <- emit_do(rest, result_ty, ctx, extend_locals(locals, new_binds), em, bind_tco)
    _ <- emit_pending_tco(bind_tco, cont_v, em)
    cont_term <- is_terminated(em)
    just_end <- read_cur_blk_or(em, just_lbl)
    if cont_term == false then
      do
        pop_temp_roots(rooted, em)
        emit_template(em, `  br label %${done_lbl}`)
    else ()
    # Merge
    emit_label(em, done_lbl)
    if cont_term then
      nothing_v
    else
      do
        phi <- fresh_tmp(em)
        let out_ll = val_ll(cont_v)
        emit_template(em, `  ${phi} = phi ${out_ll} [ ${val_ir (nothing_v)}, %${nothing_lbl} ], [ ${val_ir (cont_v)}, %${just_end} ]`)
        val_make(out_ll, phi)

fn emit_do_result_bind(pat: ast.Pattern, v: Value, result_ty_: types.Type, rest: List typed_ast.TypedDoStep, result_ty: types.Type, ctx: CgCtx, locals: Dict Value, em: Emitter, tco_ctx: Maybe TcoCtx) -> Value !{IO} =
  do
    tag_t <- fresh_tmp(em)
    emit_template(em, `  ${tag_t} = call i64 @sprout_tag(i64 ${val_ir (v)})`)
    let err_tag = find_err_tag(ctx_ctor_sigs(ctx))
    eq_t <- fresh_tmp(em)
    emit_template(em, `  ${eq_t} = icmp eq i64 ${tag_t}, ${int_to_string (err_tag)}`)
    err_lbl <- fresh_block(em, "do_err")
    ok_lbl <- fresh_block(em, "do_ok")
    done_lbl <- fresh_block(em, "do_done")
    emit_template(em, `  br i1 ${eq_t}, label %${err_lbl}, label %${ok_lbl}`)
    # Err branch: propagate the Err
    emit_label(em, err_lbl)
    err_payload <- emit_ctor_field(val_ir(v), 0, ll_i64(), em)
    err_v <- fresh_tmp(em)
    emit_template(em, `  ${err_v} = call i64 @sprout_make1(i64 ${int_to_string (err_tag)}, i64 ${val_ir (err_payload)})`)
    emit_template(em, `  br label %${done_lbl}`)
    # Ok branch: extract payload and continue
    emit_label(em, ok_lbl)
    let inner_ll = match result_ty_ with
                   | types.TApp (types.TApp _ _) inner -> type_to_ll(inner)
                   | _ -> ll_i64()
    ok_payload <- emit_ctor_field(val_ir(v), 0, inner_ll, em)
    (new_binds, rooted) <- emit_pattern_bind(pat, ok_payload, Nothing, ctx, em)
    let bind_tco = tco_with_extra_roots(tco_ctx, rooted)
    cont_v <- emit_do(rest, result_ty, ctx, extend_locals(locals, new_binds), em, bind_tco)
    _ <- emit_pending_tco(bind_tco, cont_v, em)
    cont_term <- is_terminated(em)
    ok_end <- read_cur_blk_or(em, ok_lbl)
    if cont_term == false then
      do
        pop_temp_roots(rooted, em)
        emit_template(em, `  br label %${done_lbl}`)
    else ()
    # Merge
    emit_label(em, done_lbl)
    if cont_term then
      val_make(ll_i64(), err_v)
    else
      do
        phi <- fresh_tmp(em)
        let out_ll = val_ll(cont_v)
        emit_template(em, `  ${phi} = phi ${out_ll} [ ${err_v}, %${err_lbl} ], [ ${val_ir (cont_v)}, %${ok_end} ]`)
        val_make(out_ll, phi)

fn find_nothing_tag(ctor_sigs_: Dict CtorSig) -> Int =
  match dict_get("Nothing", ctor_sigs_) with
  | Just c -> ctor_tag(c)
  | Nothing ->
      match dict_get("stdlib.prelude.Nothing", ctor_sigs_) with
      | Just c -> ctor_tag(c)
      | Nothing -> 0

fn find_err_tag(ctor_sigs_: Dict CtorSig) -> Int =
  match dict_get("Err", ctor_sigs_) with
  | Just c -> ctor_tag(c)
  | Nothing ->
      match dict_get("stdlib.prelude.Err", ctor_sigs_) with
      | Just c -> ctor_tag(c)
      | Nothing -> 1

fn emit_nothing_value(nothing_tag: Int, em: Emitter) -> Value !{IO} =
  do
    tmp <- fresh_tmp(em)
    emit_template(em, `  ${tmp} = call i64 @sprout_nothing(i64 ${int_to_string (nothing_tag)})`)
    val_make(ll_i64(), tmp)

# ===========================================================================
# Section 18 — Function emission
# ===========================================================================

# emit_fn_dbg: when debug_mode is on and the function is not stdlib, allocate a
# !DISubprogram metadata node and return the " !dbg !N" suffix for the define line.
# User functions: qualified name contains "." AND does not start with "stdlib."
# or "__tc_".  This excludes unqualified prelude helpers (range, vec_empty, …)
# and typeclass dictionary functions (__tc_Eq_Int_eq, …) from M1 DWARF coverage.
fn is_user_fn_name(name: String) -> Bool =
  str_find(name, ".") >= 0 &&
  str_starts_with(name, "stdlib.") == false &&
  str_starts_with(name, "__tc_") == false

fn emit_fn_dbg(name: String, body: typed_ast.TypedExpr, em: Emitter) -> String !{IO} =
  if em_dbg_mode(em) == false then ""
  else if is_user_fn_name(name) == false then ""
  else
    do
      sp_id <- alloc_meta_id(em)
      set_current_sp_id(em, sp_id)
      let pos = typed_ast.typed_expr_pos(body)
      let stripped_line = source.position_line(pos)
      let line = stripped_line + em_header_offset(em)
      let sp_line = "!" ++ int_to_string(sp_id) ++ " = distinct !DISubprogram(name: \"" ++ name ++ "\", linkageName: \"" ++ name ++ "\", scope: !3, file: !3, line: " ++ int_to_string(line) ++ ", type: !4, scopeLine: " ++ int_to_string(line) ++ ", flags: DIFlagPrototyped, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !{})"
      add_meta_line(em, sp_line)
      loc_id <- alloc_meta_id(em)
      set_current_loc_id(em, loc_id)
      let loc_line = "!" ++ int_to_string(loc_id) ++ " = !DILocation(line: " ++ int_to_string(line) ++ ", column: 0, scope: !" ++ int_to_string(sp_id) ++ ")"
      add_meta_line(em, loc_line)
      " !dbg !" ++ int_to_string(sp_id)

fn emit_fn_decl(name: String, params: List ast.Param, body: typed_ast.TypedExpr, sig: FnSig, is_entry: Bool, ctor_reg_meta: Dict (List (String, Int, Int, Int, String)), runtime_lets: List (String, typed_ast.TypedExpr), ctx: CgCtx, em: Emitter) -> Unit !{IO} =
  do
    # FnSig invariant: param_lls must have the same length as AST params.
    # A mismatch silently truncates IR call args or emits wrong param types.
    if is_entry == false && fn_arity(sig) != list_length_params(params) then
      panic("codegen: FnSig arity mismatch for " ++ name ++ ": sig=" ++ int_to_string(fn_arity(sig)) ++ " ast=" ++ int_to_string(list_length_params(params)))
    else ()
    if is_entry == false && set_member(name, ctx_mutual_tco_fns(ctx)) then
      emit_fn_tco(name, params, body, sig, sctx, em)
    else
      match (if is_entry then Nothing else dict_get(name, ctx_cpr_fns(ctx))) with
    | Just width ->
        do
          emit_fn_worker(name, params, body, sig, width, sctx, em)
          emit_line(em, "")
          emit_fn_wrapper(name, params, sig, width, em)
    | Nothing ->
        do
          let params_str = if is_entry
                           then "i32 %argc, ptr %argv"
                           else build_fn_params(fn_params(sig), params, 0)
          let emit_name = emitted_fn_name(name)
          let define_ret = if is_entry then "i32" else fn_ret(sig)
          dbg_suffix <- emit_fn_dbg(name, body, em)
          emit_line(em, "define " ++ define_ret ++ " @" ++ emit_name ++ "(" ++ params_str ++ ")" ++ dbg_suffix ++ " {")
          emit_label(em, "entry")
          (param_locals, rooted) <- if is_entry then
            do
              init_argv <- fresh_tmp(em)
              emit_template(em, `  ${init_argv} = call i64 @sprout_set_argv(i32 %argc, ptr %argv)`)
              emit_ctor_registrations(ctor_reg_meta, em)
              match runtime_lets with
              | Nil -> ()
              | _ -> emit_line(em, "  call void @__sprout_init_globals()")
              (dict_empty(), 0)
          else
            build_param_locals_and_push_roots(params, fn_params(sig), em)
          result <- emit_expr(sctx, param_locals, em, Nothing, body)
          coerced_result <- if is_entry then result else coerce_value(result, fn_ret(sig), em)
          pop_temp_roots(rooted, em)
          if is_entry then
            match typed_ast.typed_expr_type(body) with
            | types.TConst "Int" ->
                do
                  exit_reg <- fresh_tmp(em)
                  emit_template(em, `  ${exit_reg} = trunc i64 ${val_ir (result)} to i32`)
                  emit_template(em, `  ret i32 ${exit_reg}`)
            | _ -> emit_line(em, "  ret i32 0")
          else
            emit_template(em, `  ret ${fn_ret (sig)} ${val_ir (coerced_result)}`)
          emit_line(em, "}")
          reset_debug_fn_state(em)
  where sctx = ctx_with_scope(ctx, name)

fn build_fn_params(lls: List String, params: List ast.Param, idx: Int) -> String =
  match lls with
  | Nil -> ""
  | Cons ll rest_lls ->
      match params with
      | Nil -> ""
      | Cons (ast.Param name _) rest_params ->
          match build_fn_params(rest_lls, rest_params, idx + 1) with
          | rest_str -> if rest_str == "" then ll ++ " %" ++ name else ll ++ " %" ++ name ++ ", " ++ rest_str

# Build param locals dict and push GC roots in one pass, using the type
# annotation from ast.Param (if present) to skip rooting for known scalar
# types (Int, Bool, Char).  Returns (locals_dict, n_roots_pushed).
# Falls back to push_temp_root (conservative) when annotation is absent or
# names a non-scalar type.
fn build_param_locals_and_push_roots(params: List ast.Param, lls: List String, em: Emitter) -> (Dict Value, Int) !{IO} =
  build_param_locals_and_push_roots_acc(params, lls, em, dict_empty(), 0)

fn build_param_locals_and_push_roots_acc(params: List ast.Param, lls: List String, em: Emitter, acc: Dict Value, rooted: Int) -> (Dict Value, Int) !{IO} =
  match params with
  | Nil -> (acc, rooted)
  | Cons (ast.Param name ann) rest_params ->
      match lls with
      | Nil -> (acc, rooted)
      | Cons ll rest_lls ->
          do
            let v = val_for_ll(ll, "%" ++ name)
            let skip = match ann with
                       | Just te -> type_expr_is_non_heap_scalar(te)
                       | Nothing -> false
            n <- if skip then 0 else push_temp_root(v, em)
            build_param_locals_and_push_roots_acc(rest_params, rest_lls, em, dict_set(name, v, acc), rooted + n)

# ---------------------------------------------------------------------------
# Milestone B: field_kinds descriptor helpers
#
# Derives a one-char-per-field descriptor string from a constructor's type
# expressions so sprout_register_ctor can store it in CtorMeta.field_kinds.
# The runtime and debugger tools use it to decode raw i64 field values.
#
# Encoding: 'i' Int  'b' Bool  's' String/Char  'p' ADT/closure/tuple  '_' type-var

fn char_is_uppercase(ch: Char) -> Bool =
  str_find("ABCDEFGHIJKLMNOPQRSTUVWXYZ", char_to_string(ch)) >= 0

# ctor_field_kind / ctor_field_kinds_string moved to stdlib.compiler.field_kinds
# (/code-review fix #10). Call sites use fk.* prefix.

fn emit_ctor_registrations(meta: Dict (List (String, Int, Int, Int, String)), em: Emitter) -> Unit !{IO} =
  emit_ctor_reg_keys(dict_keys(meta), meta, em, 0)

fn emit_ctor_reg_keys(keys: Vec String, meta: Dict (List (String, Int, Int, Int, String)), em: Emitter, idx: Int) -> Unit !{IO} =
  if idx >= vec_length(keys) then ()
  else
    match vec_get(idx, keys) with
    | Nothing -> emit_ctor_reg_keys(keys, meta, em, idx + 1)
    | Just k ->
        match dict_get(k, meta) with
        | Nothing -> emit_ctor_reg_keys(keys, meta, em, idx + 1)
        | Just aliases ->
            do
              emit_ctor_reg_aliases(aliases, em)
              emit_ctor_reg_keys(keys, meta, em, idx + 1)

fn emit_ctor_reg_aliases(aliases: List (String, Int, Int, Int, String), em: Emitter) -> Unit !{IO} =
  match aliases with
  | Nil -> ()
  | Cons (gname, len, tag, arity, fkinds) rest ->
      do
        (fk_gname, fk_len) <- string_const(em, fkinds)
        ptr <- fresh_tmp(em)
        emit_template(em, `  ${ptr} = getelementptr inbounds [${int_to_string (len)} x i8], ptr ${gname}, i64 0, i64 0`)
        fkptr <- fresh_tmp(em)
        emit_template(em, `  ${fkptr} = getelementptr inbounds [${int_to_string (fk_len)} x i8], ptr ${fk_gname}, i64 0, i64 0`)
        reg <- fresh_tmp(em)
        emit_template(em, `  ${reg} = call i64 @sprout_register_ctor(i64 ${int_to_string (tag)}, ptr ${ptr}, i64 ${int_to_string (arity)}, ptr ${fkptr})`)
        emit_ctor_reg_aliases(rest, em)

fn emit_fn_tco(name: String, params: List ast.Param, body: typed_ast.TypedExpr, sig: FnSig, ctx: CgCtx, em: Emitter) -> Unit !{IO} =
  do
    let params_str = build_fn_params(fn_params(sig), params, 0)
    emit_template(em, `define ${fn_ret (sig)} @${name}(${params_str}) {`)
    emit_label(em, "entry")
    loop_lbl <- fresh_block(em, "tco_loop")
    (slots, n_roots) <- allocate_tco_slots(params, fn_params(sig), loop_lbl, em)
    sp_save <- fresh_tmp(em)
    emit_template(em, `  ${sp_save} = call ptr @llvm.stacksave()`)
    emit_template(em, `  br label %${loop_lbl}`)
    emit_label(em, loop_lbl)
    tco_locals <- load_tco_params(params, slots, em)
    let tco = TcoCtx(name, loop_lbl, slots, fn_ret(sig), n_roots, 0, sp_save)
    result <- emit_expr(ctx, tco_locals, em, Just(tco), body)
    match val_tco_args(result) with
    | Just new_args ->
        do
          pop_temp_roots(n_roots, em)
          store_tco_args(slots, new_args, em)
          emit_template(em, `  call void @llvm.stackrestore(ptr ${sp_save})`)
          emit_template(em, `  br label %${loop_lbl}`)
    | Nothing ->
        do
          is_term <- is_terminated(em)
          if is_term == false then
            do
              coerced_result <- coerce_value(result, fn_ret(sig), em)
              pop_temp_roots(n_roots, em)
              emit_template(em, `  ret ${fn_ret (sig)} ${val_ir (coerced_result)}`)
          else ()
    emit_line(em, "}")

fn allocate_tco_slots(params: List ast.Param, lls: List String, loop_lbl: String, em: Emitter) -> (List (String, String), Int) !{IO} =
  allocate_tco_slots_acc(params, lls, em, Nil, 0)

fn allocate_tco_slots_acc(params: List ast.Param, lls: List String, em: Emitter, acc: List (String, String), rooted: Int) -> (List (String, String), Int) !{IO} =
  match params with
  | Nil -> (list_reverse(acc), rooted)
  | Cons (ast.Param name ann) rest_params ->
      match lls with
      | Nil -> (list_reverse(acc), rooted)
      | Cons ll rest_lls ->
          do
            slot <- fresh_tmp(em)
            emit_template(em, `  ${slot} = alloca ${ll}`)
            emit_template(em, `  store ${ll} %${name}, ptr ${slot}`)
            let scalar_ann = match ann with
                             | Just te -> type_expr_is_non_heap_scalar(te)
                             | Nothing -> false
            r <- if scalar_ann then 0
                 else if ll == ll_i64() then
                   do
                     reg <- fresh_tmp(em)
                     emit_template(em, `  ${reg} = call i64 @sprout_gc_push_i64_root(ptr ${slot})`)
                     1
                 else if ll == ll_ptr() then
                   do
                     reg <- fresh_tmp(em)
                     emit_template(em, `  ${reg} = call i64 @sprout_gc_push_ptr_root(ptr ${slot})`)
                     1
                 else 0
            allocate_tco_slots_acc(rest_params, rest_lls, em, Cons((slot, ll), acc), rooted + r)

fn load_tco_params(params: List ast.Param, slots: List (String, String), em: Emitter) -> Dict Value !{IO} =
  load_tco_params_acc(params, slots, em, dict_empty())

fn load_tco_params_acc(params: List ast.Param, slots: List (String, String), em: Emitter, acc: Dict Value) -> Dict Value !{IO} =
  match params with
  | Nil -> acc
  | Cons (ast.Param name _) rest_params ->
      match slots with
      | Nil -> acc
      | Cons (slot, ll) rest_slots ->
          do
            tmp <- fresh_tmp(em)
            emit_template(em, `  ${tmp} = load ${ll}, ptr ${slot}`)
            load_tco_params_acc(rest_params, rest_slots, em, dict_set(name, val_for_ll(ll, tmp), acc))

# ===========================================================================
# Section 19 — Global init emission
# ===========================================================================

fn emit_init_globals_fn(runtime_lets: List (String, typed_ast.TypedExpr), ctx: CgCtx, em: Emitter) -> Unit !{IO} =
  do
    emit_line(em, "define void @__sprout_init_globals() {")
    emit_label(em, "entry")
    emit_global_lets(runtime_lets, ctx, em)
    emit_line(em, "  ret void")
    emit_line(em, "}")

fn emit_global_lets(lets: List (String, typed_ast.TypedExpr), ctx: CgCtx, em: Emitter) -> Unit !{IO} =
  match lets with
  | Nil -> ()
  | Cons (name, body) rest ->
      do
        v <- emit_expr(ctx, dict_empty(), em, Nothing, body)
        match dict_get(name, ctx_globals(ctx)) with
        | Nothing -> ()
        | Just gi ->
            do
              cv <- coerce_value(v, gi_ll(gi), em)
              emit_template(em, `  store ${gi_ll (gi)} ${val_ir (cv)}, ptr @${name}`)
              emit_global_root_registration(name, gi_ll(gi), em)
        emit_global_lets(rest, ctx, em)

fn emit_global_root_registration(name: String, ll: String, em: Emitter) -> Unit !{IO} =
  if ll == ll_i64() then
    do
      reg <- fresh_tmp(em)
      emit_template(em, `  ${reg} = call i64 @sprout_gc_register_i64_root(ptr @${name})`)
  else if ll == ll_ptr() then
    do
      reg <- fresh_tmp(em)
      emit_template(em, `  ${reg} = call i64 @sprout_gc_register_ptr_root(ptr @${name})`)
  else if str_starts_with(ll, "{ ") then
    do
      sz <- sizeof_struct(ll, em)
      reg <- fresh_tmp(em)
      emit_template(em, `  ${reg} = call i64 @sprout_gc_register_scan_root(ptr @${name}, i64 ${sz})`)
  else ()

# ===========================================================================
# Section 20 — Extern signatures
# ===========================================================================

# Compiler-internal C functions that are emitted by codegen directly via
# hardcoded IR templates.  User-callable builtins are declared with
# `extern fn` in stdlib/prelude.sprout instead.
fn compiler_intrinsic_sigs_dict() -> Dict FnSig =
  dict_from_list(compiler_intrinsic_sigs())

fn compiler_intrinsic_sigs() -> List (String, FnSig) =
  # ADT boxing / unboxing (hardcoded in IR templates)
  [("sprout_make0", FnSig("sprout_make0", Cons(ll_i64(), Nil), ll_i64(), Nothing))
  , ("sprout_make1", FnSig("sprout_make1", Cons(ll_i64(), Cons(ll_i64(), Nil)), ll_i64(), Nothing))
  , ("sprout_make2", FnSig("sprout_make2", Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Nil))), ll_i64(), Nothing))
  , ("sprout_make3", FnSig("sprout_make3", Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Nil)))), ll_i64(), Nothing))
  , ("sprout_make4", FnSig("sprout_make4", Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Nil))))), ll_i64(), Nothing))
  , ("sprout_make5", FnSig("sprout_make5", Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Nil)))))), ll_i64(), Nothing))
  , ("sprout_make6", FnSig("sprout_make6", Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Nil))))))), ll_i64(), Nothing))
  , ("sprout_make7", FnSig("sprout_make7", Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Nil)))))))), ll_i64(), Nothing))
  , ("sprout_make8", FnSig("sprout_make8", Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Nil))))))))), ll_i64(), Nothing))
  , ("sprout_make9", FnSig("sprout_make9", Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Nil)))))))))), ll_i64(), Nothing))
  , ("sprout_nothing", FnSig("sprout_nothing", Cons(ll_i64(), Nil), ll_i64(), Nothing))
  , ("sprout_tag", FnSig("sprout_tag", Cons(ll_i64(), Nil), ll_i64(), Nothing))
  , ("sprout_field", FnSig("sprout_field", Cons(ll_i64(), Cons(ll_i64(), Nil)), ll_i64(), Nothing))
  , ("sprout_abort_match", FnSig("sprout_abort_match", Nil, "void", Nothing))
  , ("sprout_rebox2", FnSig("sprout_rebox2", Cons(ll_i64(), Cons(ll_i64(), Nil)), ll_i64(), Nothing))
  , ("sprout_rebox3", FnSig("sprout_rebox3", Cons(ll_i64(), Cons(ll_i64(), Cons(ll_i64(), Nil))), ll_i64(), Nothing))
  # Closure / tuple allocation
  , ("sprout_alloc_closure_env", FnSig("sprout_alloc_closure_env", Cons(ll_i64(), Nil), ll_i64(), Nothing))
  , ("sprout_alloc_tuple_blob", FnSig("sprout_alloc_tuple_blob", Cons(ll_i64(), Nil), ll_i64(), Nothing))
  # Runtime startup (uses raw ptr for argv/ctor-name)
  , ("sprout_register_ctor", FnSig("sprout_register_ctor", Cons(ll_i64(), Cons(ll_ptr(), Cons(ll_i64(), Cons(ll_ptr(), Nil)))), ll_i64(), Nothing))
  , ("sprout_set_argv", FnSig("sprout_set_argv", Cons(ll_i32(), Cons(ll_ptr(), Nil)), ll_i64(), Nothing))
  # String operations — called directly from codegen IR templates, must be declared even without prelude
  , ("str_eq", FnSig("str_eq", Cons(ll_ptr(), Cons(ll_ptr(), Nil)), ll_i1(), Nothing))
  , ("str_concat", FnSig("str_concat", Cons(ll_i64(), Cons(ll_i64(), Nil)), ll_i64(), Nothing))
  , ("str_compare", FnSig("str_compare", Cons(ll_ptr(), Cons(ll_ptr(), Nil)), ll_i64(), Nothing))
  # Print helpers — called with ptr/i64 operands from print codegen templates
  , ("print_str", FnSig("print_str", Cons(ll_ptr(), Nil), ll_i64(), Nothing))
  , ("eprint_str", FnSig("eprint_str", Cons(ll_ptr(), Nil), ll_i64(), Nothing))
  , ("print_value", FnSig("print_value", Cons(ll_i64(), Nil), ll_i64(), Nothing))
  # GC root management — use raw ptr (stack slot addresses, not Sprout values)
  , ("sprout_gc_push_i64_root", FnSig("sprout_gc_push_i64_root", Cons(ll_ptr(), Nil), ll_i64(), Nothing))
  , ("sprout_gc_push_ptr_root", FnSig("sprout_gc_push_ptr_root", Cons(ll_ptr(), Nil), ll_i64(), Nothing))
  , ("sprout_gc_push_scan_root", FnSig("sprout_gc_push_scan_root", Cons(ll_ptr(), Cons(ll_i64(), Nil)), ll_i64(), Nothing))
  , ("sprout_gc_pop_roots", FnSig("sprout_gc_pop_roots", Cons(ll_i64(), Nil), ll_i64(), Nothing))
  , ("sprout_gc_register_i64_root", FnSig("sprout_gc_register_i64_root", Cons(ll_ptr(), Nil), ll_i64(), Nothing))
  , ("sprout_gc_register_ptr_root", FnSig("sprout_gc_register_ptr_root", Cons(ll_ptr(), Nil), ll_i64(), Nothing))
  , ("sprout_gc_register_scan_root", FnSig("sprout_gc_register_scan_root", Cons(ll_ptr(), Cons(ll_i64(), Nil)), ll_i64(), Nothing))
  # Analysis bridge — C functions take const char* (ptr), not i64; extern fn String would give i64 ABI
  , ("analysis_check_source", FnSig("analysis_check_source", Cons(ll_ptr(), Nil), ll_i64(), Nothing))
  , ("analysis_declared_names_in_source", FnSig("analysis_declared_names_in_source", Cons(ll_ptr(), Nil), ll_i64(), Nothing))
  , ("analysis_exported_names_in_source", FnSig("analysis_exported_names_in_source", Cons(ll_ptr(), Nil), ll_i64(), Nothing))
  , ("analysis_symbol_inventory_in_source", FnSig("analysis_symbol_inventory_in_source", Cons(ll_ptr(), Nil), ll_i64(), Nothing))
  , ("analysis_diagnostics_in_source", FnSig("analysis_diagnostics_in_source", Cons(ll_ptr(), Nil), ll_i64(), Nothing))
  , ("analysis_symbol_locations_in_source", FnSig("analysis_symbol_locations_in_source", Cons(ll_ptr(), Nil), ll_i64(), Nothing))
  , ("analysis_type_of_in_source", FnSig("analysis_type_of_in_source", Cons(ll_ptr(), Cons(ll_ptr(), Nil)), ll_i64(), Nothing))
  , ("analysis_eval_expr_in_source", FnSig("analysis_eval_expr_in_source", Cons(ll_ptr(), Cons(ll_ptr(), Nil)), ll_i64(), Nothing))
  , ("analysis_instances_in_source", FnSig("analysis_instances_in_source", Cons(ll_ptr(), Cons(ll_ptr(), Nil)), ll_i64(), Nothing))
  # Vec String params are Sprout heap handles (i64 pointer values); C side receives them as const void*
  , ("analysis_complete_in_state", FnSig("analysis_complete_in_state", Cons(ll_ptr(), Cons(ll_ptr(), Cons(ll_ptr(), Nil))), ll_i64(), Nothing))
  # LLVM stack-save/restore intrinsics — must be explicitly declared so clang 16+ resolves them
  # by signature rather than by name lookup (which changed with opaque-pointer intrinsic overloading).
  , ("llvm.stacksave", FnSig("llvm.stacksave", Nil, ll_ptr(), Nothing))
  , ("llvm.stackrestore", FnSig("llvm.stackrestore", Cons(ll_ptr(), Nil), "void", Nothing))
  ]

# Convert an AST type expression to an LLVM type string.
# Used by build_extern_sigs_acc to derive LLVM types from extern fn declarations.
fn ast_type_to_ll(te: ast.TypeExpr) -> String =
  match te with
  | ast.TypeName name ->
      if type_name_leaf_is(name, "Bool") then ll_i1() else ll_i64()
  | ast.TypeArrow _ _ _ -> ll_ptr()
  | ast.TypeApply _ _ -> ll_i64()
  | ast.TypeEffect base _ -> ast_type_to_ll(base)
  | ast.TupleType _ -> ll_i64()

fn ast_param_to_ll(p: ast.Param) -> String =
  match p with
  | ast.Param _ Nothing -> ll_i64()
  | ast.Param _ (Just te) -> ast_type_to_ll(te)

fn extern_ret_ll(ret_ty: Maybe ast.TypeExpr) -> String =
  match ret_ty with
  | Nothing -> ll_i64()
  | Just te -> ast_type_to_ll(te)

# Build extern sigs from TExternFnDecl nodes, seeded with compiler intrinsics.
fn build_extern_sigs_from_decls(decls: List typed_ast.TypedDecl, env: Dict types.Scheme) -> Dict FnSig =
  build_extern_sigs_acc(decls, env, compiler_intrinsic_sigs_dict())

fn build_extern_sigs_acc(decls: List typed_ast.TypedDecl, env: Dict types.Scheme, acc: Dict FnSig) -> Dict FnSig =
  match decls with
  | Nil -> acc
  | Cons decl rest ->
      match decl with
      | typed_ast.TExternFnDecl name params ret_ty _ ->
          match extern_ret_ll(ret_ty) with
          | ret_ll_ ->
              build_extern_sigs_acc(rest, env,
                dict_set(name, FnSig(name, list_map(ast_param_to_ll, params), ret_ll_, Nothing), acc))
      | _ ->
          build_extern_sigs_acc(rest, env, acc)

# ===========================================================================
# Section 20.5 — CPR (Constructed Product Result) analysis helpers
# ===========================================================================

# Returns the outermost type constructor name of a TypeExpr, e.g.
# TypeApply (TypeName "Maybe") _ -> Just "Maybe"
fn type_expr_ctor_name(t: ast.TypeExpr) -> Maybe String =
  match t with
  | ast.TypeName name -> Just(name)
  | ast.TypeApply f _ -> type_expr_apply_ctor(f)
  | ast.TypeEffect inner _ -> type_expr_ctor_name(inner)
  | _ -> Nothing

fn type_expr_apply_ctor(f: ast.TypeExpr) -> Maybe String =
  match f with
  | ast.TypeName name -> Just(name)
  | _ -> type_expr_ctor_name(f)

# Build a map from ADT type name to its maximum constructor arity.
fn build_adt_arities(decls: List typed_ast.TypedDecl) -> Dict Int =
  build_adt_arities_acc(decls, dict_empty())

fn build_adt_arities_acc(decls: List typed_ast.TypedDecl, acc: Dict Int) -> Dict Int =
  match decls with
  | Nil -> acc
  | Cons decl rest ->
      match decl with
      | typed_ast.TPassThrough (ast.TypeDecl type_name _ ctors _ _) ->
          build_adt_arities_acc(rest, dict_set(type_name, compute_max_arity(ctors, 0), acc))
      | _ -> build_adt_arities_acc(rest, acc)

fn ctor_field_count(tc: ast.TypeConstructor) -> Int =
  match tc with
  | ast.TypeConstructor _ ctor_args -> list_length(type_expr_lls(ctor_args))

fn compute_max_arity(ctors: List ast.TypeConstructor, max_ar: Int) -> Int =
  match ctors with
  | Nil -> max_ar
  | Cons tc rest ->
      match ctor_field_count(tc) with
      | ar -> compute_max_arity(rest, if ar > max_ar then ar else max_ar)

# Given a max constructor arity, return the total i64 count for the unboxed struct
# (tag + max_arity payload fields), or Nothing if too large for CPR.
# max_arity=1 → width=2 (SproutUnboxed2), max_arity=2 → width=3 (SproutUnboxed3).
fn unboxed_width_for_arity(max_arity: Int) -> Maybe Int =
  if max_arity == 1 then Just(2)
  else if max_arity == 2 then Just(3)
  else Nothing

# Classify an extern return type: returns Just width if it's a small CPR-eligible ADT.
fn cpr_width_for_type_expr(ret_ty: Maybe ast.TypeExpr, arities: Dict Int) -> Maybe Int =
  match ret_ty with
  | Nothing -> Nothing
  | Just te ->
      match type_expr_ctor_name(te) with
      | Nothing -> Nothing
      | Just ctor_name ->
          match dict_get(ctor_name, arities) with
          | Nothing -> Nothing
          | Just max_ar -> unboxed_width_for_arity(max_ar)

# Build the cpr_fns dict: function name → unboxed struct width (2 or 3).
# Covers externs (always eligible) and user-defined functions whose return type
# is a small ADT, do not self-tail-call (TCO functions are excluded), and are
# not in the mutual-TCO set (which also requires i64 return for musttail).
fn build_cpr_fns(decls: List typed_ast.TypedDecl, arities: Dict Int, mutual_tco: Set) -> Dict Int =
  build_cpr_fns_acc(decls, arities, mutual_tco, dict_empty())

fn build_cpr_fns_acc(decls: List typed_ast.TypedDecl, arities: Dict Int, mutual_tco: Set, acc: Dict Int) -> Dict Int =
  match decls with
  | Nil -> acc
  | Cons decl rest ->
      match decl with
      | typed_ast.TExternFnDecl name _ ret_ty _ ->
          if is_cpr_extern_allowlisted(name) then
            match cpr_width_for_type_expr(ret_ty, arities) with
            | Nothing -> build_cpr_fns_acc(rest, arities, mutual_tco, acc)
            | Just width -> build_cpr_fns_acc(rest, arities, mutual_tco, dict_set(name, width, acc))
          else
            build_cpr_fns_acc(rest, arities, mutual_tco, acc)
      | typed_ast.TFnDecl name _ ret_ty _ _ _ ->
          if set_member(name, mutual_tco) then
            build_cpr_fns_acc(rest, arities, mutual_tco, acc)
          else
            match cpr_width_for_type_expr(ret_ty, arities) with
            | Nothing -> build_cpr_fns_acc(rest, arities, mutual_tco, acc)
            | Just width -> build_cpr_fns_acc(rest, arities, mutual_tco, dict_set(name, width, acc))
      | _ -> build_cpr_fns_acc(rest, arities, mutual_tco, acc)

# Build FnSig entries for the _unboxed extern variants so that emit_extern_decls
# emits the required `declare { i64, i64 } @name_unboxed(...)` lines.
# Only externs with a matching C implementation are included; this prevents
# declare-without-define linker errors for externs that haven't been ported yet.
fn build_cpr_extern_sigs(decls: List typed_ast.TypedDecl, arities: Dict Int, externs: Dict FnSig) -> Dict FnSig =
  build_cpr_extern_sigs_acc(decls, arities, externs, dict_empty())

fn is_cpr_extern_allowlisted(name: String) -> Bool =
  name == "env_get"
  || name == "argv_get"
  || name == "term_read_line"
  || name == "str_char_at"
  || name == "str_char_at_byte"
  || name == "regex_find_range"
  || name == "vector_get"
  || name == "map_get"
  || name == "map_nth_key"
  || name == "map_nth_value"
  || name == "bytes_get"
  || name == "native_set_to_list"

fn build_cpr_extern_sigs_acc(decls: List typed_ast.TypedDecl, arities: Dict Int, externs: Dict FnSig, acc: Dict FnSig) -> Dict FnSig =
  match decls with
  | Nil -> acc
  | Cons decl rest ->
      match decl with
      | typed_ast.TExternFnDecl name _ ret_ty _ ->
          if is_cpr_extern_allowlisted(name)
          then
            match cpr_width_for_type_expr(ret_ty, arities) with
            | Nothing -> build_cpr_extern_sigs_acc(rest, arities, externs, acc)
            | Just width ->
                match dict_get(name, externs) with
                | Nothing -> build_cpr_extern_sigs_acc(rest, arities, externs, acc)
                | Just orig_sig ->
                    build_cpr_extern_sigs_acc(rest, arities, externs,
                      dict_set(name ++ "_unboxed",
                               FnSig(name ++ "_unboxed", fn_params(orig_sig), ll_for_unboxed_width(width), Nothing),
                               acc))
          else build_cpr_extern_sigs_acc(rest, arities, externs, acc)
      | _ -> build_cpr_extern_sigs_acc(rest, arities, externs, acc)

# LLVM struct type string for an unboxed ADT of the given total width (tag + fields).
fn ll_for_unboxed_width(width: Int) -> String =
  if width == 2 then "{ i64, i64 }"
  else if width == 3 then "{ i64, i64, i64 }"
  else "{ i64, i64, i64, i64 }"

# ===========================================================================
# Section 20.5 — CPR worker/wrapper emission
# ===========================================================================

# Emit `define { i64, ... } @name_worker(params) { body }`.
# The body is compiled in "worker mode" via emit_worker_expr which routes
# CPR-eligible tail calls to their _unboxed/_worker variants, returning
# the result as a struct register rather than a heap pointer.
fn emit_fn_worker(name: String, params: List ast.Param, body: typed_ast.TypedExpr, sig: FnSig, width: Int, ctx: CgCtx, em: Emitter) -> Unit !{IO} =
  do
    let params_str = build_fn_params(fn_params(sig), params, 0)
    let ll_struct = ll_for_unboxed_width(width)
    let worker_name = emitted_fn_name(name) ++ "_worker"
    emit_line(em, "define " ++ ll_struct ++ " @" ++ worker_name ++ "(" ++ params_str ++ ") {")
    emit_label(em, "entry")
    (param_locals, rooted) <- build_param_locals_and_push_roots(params, fn_params(sig), em)
    result_reg <- emit_worker_expr(width, ctx, param_locals, em, body)
    pop_temp_roots(rooted, em)
    emit_line(em, "  ret " ++ ll_struct ++ " " ++ result_reg)
    emit_line(em, "}")

# Emit `define i64 @name(params) { call @name_worker; rebox; ret i64 }`.
# This is the public symbol: all existing call sites call @name and get a
# boxed i64.  The optimization fires only when emit_match routes to @name_worker
# directly (in match-on-call position).
fn emit_fn_wrapper(name: String, params: List ast.Param, sig: FnSig, width: Int, em: Emitter) -> Unit !{IO} =
  do
    let params_str = build_fn_params(fn_params(sig), params, 0)
    let emit_name = emitted_fn_name(name)
    let worker_name = emit_name ++ "_worker"
    let ll_struct = ll_for_unboxed_width(width)
    emit_line(em, "define i64 @" ++ emit_name ++ "(" ++ params_str ++ ") {")
    emit_label(em, "entry")
    r <- fresh_tmp(em)
    let call_str = if params_str == ""
                   then "  " ++ r ++ " = call " ++ ll_struct ++ " @" ++ worker_name ++ "()"
                   else "  " ++ r ++ " = call " ++ ll_struct ++ " @" ++ worker_name ++ "(" ++ params_str ++ ")"
    emit_line(em, call_str)
    tag_t <- fresh_tmp(em)
    emit_template(em, `  ${tag_t} = extractvalue ${ll_struct} ${r}, 0`)
    f0_t <- fresh_tmp(em)
    emit_template(em, `  ${f0_t} = extractvalue ${ll_struct} ${r}, 1`)
    rooted_f0 <- push_temp_root(val_make(ll_i64(), f0_t), em)
    if width == 2 then
      do
        boxed <- fresh_tmp(em)
        emit_template(em, `  ${boxed} = call i64 @sprout_rebox2(i64 ${tag_t}, i64 ${f0_t})`)
        pop_temp_roots(rooted_f0, em)
        emit_template(em, `  ret i64 ${boxed}`)
    else
      do
        f1_t <- fresh_tmp(em)
        emit_template(em, `  ${f1_t} = extractvalue ${ll_struct} ${r}, 2`)
        rooted_f1 <- push_temp_root(val_make(ll_i64(), f1_t), em)
        boxed <- fresh_tmp(em)
        emit_template(em, `  ${boxed} = call i64 @sprout_rebox3(i64 ${tag_t}, i64 ${f0_t}, i64 ${f1_t})`)
        pop_temp_roots(rooted_f0 + rooted_f1, em)
        emit_template(em, `  ret i64 ${boxed}`)
    emit_line(em, "}")

# Worker-mode expression emitter.  Only called at tail position within a worker
# function body (direct return site, match arm body, if branch).
# Sub-expressions (scrutinees, conditions, call arguments) always use emit_expr.
fn emit_worker_expr(width: Int, ctx: CgCtx, locals: Dict Value, em: Emitter, e: typed_ast.TypedExpr) -> String !{IO} =
  match e with
  | typed_ast.TCall (typed_ast.TVar name _ _) call_args _ _ ->
      match dict_get(name, ctx_cpr_fns(ctx)) with
      | Just _ -> emit_worker_cpr_call(name, call_args, width, ctx, locals, em)
      | Nothing -> emit_worker_box_unbox(width, ctx, locals, em, e)
  | typed_ast.TMatch scrut branches _ _ ->
      emit_worker_match(width, scrut, branches, ctx, locals, em)
  | typed_ast.TIf cond thn els _ _ ->
      emit_worker_if(width, cond, thn, els, ctx, locals, em)
  | _ ->
      emit_worker_box_unbox(width, ctx, locals, em, e)

# Dispatch to _unboxed (extern) or _worker (user-defined) variant.
# Width=3 externs use sret (see emit_extern_decl_keys for the ABI rationale).
fn emit_worker_cpr_call(name: String, call_args: List typed_ast.TypedExpr, width: Int, ctx: CgCtx, locals: Dict Value, em: Emitter) -> String !{IO} =
  match dict_get(name ++ "_unboxed", ctx_cpr_extern_sigs(ctx)) with
  | Just sig ->
      if width == 3
      then emit_worker_cpr_do_sret(name ++ "_unboxed", sig, call_args, width, em, ctx, locals)
      else emit_worker_cpr_do(name ++ "_unboxed", sig, call_args, width, em, ctx, locals)
  | Nothing ->
      match dict_get(name, ctx_fn_sigs(ctx)) with
      | Just sig -> emit_worker_cpr_do(emitted_fn_name(name) ++ "_worker", sig, call_args, width, em, ctx, locals)
      | Nothing -> "undef"

fn emit_worker_cpr_do(call_fn: String, sig: FnSig, call_args: List typed_ast.TypedExpr, width: Int, em: Emitter, ctx: CgCtx, locals: Dict Value) -> String !{IO} =
  do
    (arg_vals, rooted_args) <- emit_args_with_roots(call_args, ctx, locals, em)
    coerced <- coerce_args(fn_params(sig), arg_vals, em)
    let args_ir = string.join(", ", list_map(\p -> match p with | (ll, ir) -> format_ll_ir(ll, ir), coerced))
    r <- fresh_tmp(em)
    let ll_struct = ll_for_unboxed_width(width)
    let call_str = if args_ir == ""
                   then "  " ++ r ++ " = call " ++ ll_struct ++ " @" ++ call_fn ++ "()"
                   else "  " ++ r ++ " = call " ++ ll_struct ++ " @" ++ call_fn ++ "(" ++ args_ir ++ ")"
    emit_line(em, call_str)
    pop_temp_roots(rooted_args, em)
    r

# Sret-aware variant for width=3 externs: alloca a {i64,i64,i64} return slot,
# pass it as the sret first arg, then load the struct back.  Matches Clang's
# AAPCS / SysV lowering of `SproutUnboxed3 f(...)`.
fn emit_worker_cpr_do_sret(call_fn: String, sig: FnSig, call_args: List typed_ast.TypedExpr, width: Int, em: Emitter, ctx: CgCtx, locals: Dict Value) -> String !{IO} =
  do
    (arg_vals, rooted_args) <- emit_args_with_roots(call_args, ctx, locals, em)
    coerced <- coerce_args(fn_params(sig), arg_vals, em)
    let args_ir = string.join(", ", list_map(\p -> match p with | (ll, ir) -> format_ll_ir(ll, ir), coerced))
    let ll_struct = ll_for_unboxed_width(width)
    retslot <- fresh_tmp(em)
    emit_template(em, `  ${retslot} = alloca ${ll_struct}`)
    let sret_arg = "ptr sret(" ++ ll_struct ++ ") align 8 " ++ retslot
    let call_args_str = if args_ir == "" then sret_arg else sret_arg ++ ", " ++ args_ir
    emit_template(em, `  call void @${call_fn}(${call_args_str})`)
    pop_temp_roots(rooted_args, em)
    r <- fresh_tmp(em)
    emit_template(em, `  ${r} = load ${ll_struct}, ptr ${retslot}`)
    r

# Fallback: emit the expression via normal heap path, then unbox tag + fields
# into a struct using insertvalue.  Correct but doesn't eliminate allocation.
fn emit_worker_box_unbox(width: Int, ctx: CgCtx, locals: Dict Value, em: Emitter, e: typed_ast.TypedExpr) -> String !{IO} =
  do
    v <- emit_expr(ctx, locals, em, Nothing, e)
    let ll_struct = ll_for_unboxed_width(width)
    tag_t <- fresh_tmp(em)
    emit_template(em, `  ${tag_t} = call i64 @sprout_tag(i64 ${val_ir (v)})`)
    f0_t <- fresh_tmp(em)
    emit_template(em, `  ${f0_t} = call i64 @sprout_field(i64 ${val_ir (v)}, i64 0)`)
    r0 <- fresh_tmp(em)
    emit_line(em, "  " ++ r0 ++ " = insertvalue " ++ ll_struct ++ " undef, i64 " ++ tag_t ++ ", 0")
    r1 <- fresh_tmp(em)
    emit_line(em, "  " ++ r1 ++ " = insertvalue " ++ ll_struct ++ " " ++ r0 ++ ", i64 " ++ f0_t ++ ", 1")
    if width == 2 then
      r1
    else
      do
        f1_t <- fresh_tmp(em)
        emit_template(em, `  ${f1_t} = call i64 @sprout_field(i64 ${val_ir (v)}, i64 1)`)
        r2 <- fresh_tmp(em)
        emit_line(em, "  " ++ r2 ++ " = insertvalue " ++ ll_struct ++ " " ++ r1 ++ ", i64 " ++ f1_t ++ ", 2")
        r2

# Worker-mode match: scrutinee emitted via normal emit_expr → i64,
# arm bodies via emit_worker_expr → struct reg, phi with struct type.
fn emit_worker_match(width: Int, scrut: typed_ast.TypedExpr, branches: List typed_ast.TypedMatchBranch, ctx: CgCtx, locals: Dict Value, em: Emitter) -> String !{IO} =
  do
    sv <- emit_expr(ctx, locals, em, Nothing, scrut)
    done_lbl <- fresh_block(em, "match_done")
    let ll_struct = ll_for_unboxed_width(width)
    let scrut_type = typed_ast.typed_expr_type(scrut)
    branch_pairs <- emit_worker_branches(branches, sv, scrut_type, ll_struct, width, ctx, locals, em, done_lbl, Nil)
    match branch_pairs with
    | Nil -> "undef"
    | _ ->
        do
          emit_label(em, done_lbl)
          phi <- fresh_tmp(em)
          let parts = string.join(", ", list_map(\p -> match p with | (sr, blk) -> "[ " ++ sr ++ ", %" ++ blk ++ " ]", branch_pairs))
          emit_template(em, `  ${phi} = phi ${ll_struct} ${parts}`)
          phi

fn emit_worker_branches(branches: List typed_ast.TypedMatchBranch, scrut: Value, scrut_type: types.Type, ll_struct: String, width: Int, ctx: CgCtx, locals: Dict Value, em: Emitter, done_lbl: String, acc: List (String, String)) -> List (String, String) !{IO} =
  match branches with
  | Nil ->
      do
        emit_match_abort(em)
        list_reverse(acc)
  | Cons (typed_ast.TypedMatchBranch pat body) rest ->
      do
        branch_lbl <- fresh_block(em, "match_br")
        next_lbl <- fresh_block(em, "match_next")
        let is_always = is_wildcard_or_var(pat)
        if is_always then
          emit_template(em, `  br label %${branch_lbl}`)
        else
          do
            test_v <- emit_pattern_test(pat, scrut, ctx, em)
            emit_template(em, `  br i1 ${val_ir (test_v)}, label %${branch_lbl}, label %${next_lbl}`)
        emit_label(em, branch_lbl)
        (new_binds, rooted) <- emit_pattern_bind(pat, scrut, Just(scrut_type), ctx, em)
        let branch_locals = extend_locals(locals, new_binds)
        struct_reg <- emit_worker_expr(width, ctx, branch_locals, em, body)
        end_blk <- read_cur_blk_or(em, branch_lbl)
        pop_temp_roots(rooted, em)
        emit_template(em, `  br label %${done_lbl}`)
        emit_label(em, next_lbl)
        emit_worker_branches(rest, scrut, scrut_type, ll_struct, width, ctx, locals, em, done_lbl, Cons((struct_reg, end_blk), acc))

# Worker-mode if: condition emitted normally, branches via emit_worker_expr.
fn emit_worker_if(width: Int, cond: typed_ast.TypedExpr, thn: typed_ast.TypedExpr, els: typed_ast.TypedExpr, ctx: CgCtx, locals: Dict Value, em: Emitter) -> String !{IO} =
  do
    let ll_struct = ll_for_unboxed_width(width)
    raw_cv <- emit_expr(ctx, locals, em, Nothing, cond)
    cv <- coerce_value(raw_cv, ll_i1(), em)
    then_lbl <- fresh_block(em, "if_then")
    else_lbl <- fresh_block(em, "if_else")
    done_lbl <- fresh_block(em, "if_done")
    emit_template(em, `  br i1 ${val_ir (cv)}, label %${then_lbl}, label %${else_lbl}`)
    emit_label(em, then_lbl)
    then_reg <- emit_worker_expr(width, ctx, locals, em, thn)
    then_blk <- read_cur_blk_or(em, then_lbl)
    emit_template(em, `  br label %${done_lbl}`)
    emit_label(em, else_lbl)
    else_reg <- emit_worker_expr(width, ctx, locals, em, els)
    else_blk <- read_cur_blk_or(em, else_lbl)
    emit_template(em, `  br label %${done_lbl}`)
    emit_label(em, done_lbl)
    phi <- fresh_tmp(em)
    emit_line(em, "  " ++ phi ++ " = phi " ++ ll_struct ++ " [ " ++ then_reg ++ ", %" ++ then_blk ++ " ], [ " ++ else_reg ++ ", %" ++ else_blk ++ " ]")
    phi

# ===========================================================================
# Section 21 — Program analysis
# ===========================================================================

# Collect CtorSig for every TypeDecl in the program, assigning tags
# sequentially in declaration order.
fn build_ctor_sigs_from_decls(decls: List typed_ast.TypedDecl) -> (Dict CtorSig, Set) =
  build_ctor_sigs_acc(decls, 0, dict_empty(), set_empty())

fn build_ctor_sigs_acc(decls: List typed_ast.TypedDecl, next_tag: Int, sigs: Dict CtorSig, adts: Set) -> (Dict CtorSig, Set) =
  match decls with
  | Nil -> (sigs, adts)
  | Cons decl rest ->
      match decl with
      | typed_ast.TPassThrough (ast.TypeDecl type_name type_params ctors _ _) ->
          match register_ctors(ctors, next_tag, sigs, adts, type_name, type_params) with
          | (new_sigs, new_adts, new_tag) ->
              build_ctor_sigs_acc(rest, new_tag, new_sigs, new_adts)
      # WrapDecl: register a single synthetic ctor with tag = wrap_tag() sentinel.
      # No runtime tag is allocated (next_tag is not incremented).
      | typed_ast.TPassThrough (ast.WrapDecl type_name inner _) ->
          build_ctor_sigs_acc(rest, next_tag,
            dict_set(type_name,
              CtorSig(type_name, wrap_tag(), Cons(type_expr_to_ll(inner), Nil), Cons(inner, Nil), Nil),
              sigs),
            set_insert(type_name, adts))
      | _ ->
          build_ctor_sigs_acc(rest, next_tag, sigs, adts)

fn register_ctors(ctors: List ast.TypeConstructor, next_tag: Int, sigs: Dict CtorSig, adts: Set, type_name: String, type_params: List String) -> (Dict CtorSig, Set, Int) =
  match ctors with
  | Nil -> (sigs, set_insert(type_name, adts), next_tag)
  | Cons (ast.TypeConstructor ctor_name ctor_args) rest ->
      register_ctors(rest, next_tag + 1, dict_set(ctor_name, CtorSig(ctor_name, next_tag, type_expr_lls(ctor_args), ctor_args, type_params), sigs), adts, type_name, type_params)

fn type_expr_lls(args: List ast.TypeExpr) -> List String =
  match args with
  | Nil -> Nil
  | Cons arg rest -> Cons(type_expr_to_ll(arg), type_expr_lls(rest))

fn type_expr_to_ll(t: ast.TypeExpr) -> String =
  match t with
  | ast.TypeName name -> const_to_ll(name)
  | ast.TypeApply _ _ -> ll_i64()
  | ast.TypeArrow _ _ _ -> ll_ptr()
  | ast.TypeEffect inner _ -> type_expr_to_ll(inner)
  | ast.TupleType items -> tuple_ll(type_expr_lls(items))

# Collect TApp args left-to-right: TApp(TApp(TConst "F") A) B → [A, B]
fn extract_type_args(t: types.Type) -> List types.Type =
  list_reverse(extract_type_args_acc(t, Nil))

fn extract_type_args_acc(t: types.Type, acc: List types.Type) -> List types.Type =
  match t with
  | types.TApp base arg -> extract_type_args_acc(base, Cons(arg, acc))
  | _ -> acc

fn build_tvar_subst(params: List String, args: List types.Type, acc: Dict String) -> Dict String =
  match params with
  | Nil -> acc
  | Cons p rest_params ->
      match args with
      | Nil -> acc
      | Cons a rest_args -> build_tvar_subst(rest_params, rest_args, dict_set(p, type_to_ll(a), acc))

fn type_expr_to_ll_subst(t: ast.TypeExpr, subst: Dict String) -> String =
  match t with
  | ast.TypeName name ->
      match dict_get(name, subst) with
      | Just ll -> ll
      | Nothing -> const_to_ll(name)
  | ast.TypeApply _ _ -> ll_i64()
  | ast.TypeArrow _ _ _ -> ll_ptr()
  | ast.TypeEffect inner _ -> type_expr_to_ll_subst(inner, subst)
  | ast.TupleType items -> tuple_ll(list_map(\e -> type_expr_to_ll_subst(e, subst), items))

# Return concrete LLVM types for ctor fields given the scrutinee's monomorphic type.
fn instantiated_ctor_arg_lls(ctor: CtorSig, scrut_type: types.Type) -> List String =
  match ctor_type_params(ctor) with
  | Nil -> ctor_arg_lls(ctor)
  | _ ->
      apply_subst_to_type_exprs(ctor_type_exprs(ctor), build_tvar_subst(ctor_type_params(ctor), extract_type_args(scrut_type), dict_empty()))

fn apply_subst_to_type_exprs(exprs: List ast.TypeExpr, subst: Dict String) -> List String =
  list_map(\e -> type_expr_to_ll_subst(e, subst), exprs)

# Build FnSig for every TFnDecl using the env dict for type information.
fn build_fn_sigs_from_decls(decls: List typed_ast.TypedDecl, env: Dict types.Scheme) -> Dict FnSig =
  build_fn_sigs_acc(decls, env, dict_empty())

fn build_fn_sigs_acc(decls: List typed_ast.TypedDecl, env: Dict types.Scheme, acc: Dict FnSig) -> Dict FnSig =
  match decls with
  | Nil -> acc
  | Cons decl rest ->
      match decl with
      | typed_ast.TFnDecl name params _ _ _ body ->
          match dict_get(name, env) with
          | Nothing ->
              match typed_ast.typed_expr_type(body) with
              | body_ty ->
                  build_fn_sigs_acc(rest, env, dict_set(name, FnSig(name, list_map(\_ -> ll_i64(), params), type_to_ll(body_ty), Nothing), acc))
          | Just scheme ->
              match list_length_params(params) with
              | n_params_ ->
                  match types.scheme_type(scheme) with
                  | body_ty ->
                      match extract_param_lls_from_type(body_ty, n_params_) with
                      | raw_param_lls ->
                          # Fall back to i64 for all params when scheme has fewer arrows than actual
                          # params (constrained fns: dict args are not in the scheme type).
                          # Preserve extracted types when counts match (e.g. tuple-typed params).
                          match (if list_length(raw_param_lls) == n_params_ then raw_param_lls else list_map(\_ -> ll_i64(), params)) with
                          | param_lls ->
                              build_fn_sigs_acc(rest, env, dict_set(name, FnSig(name, param_lls, extract_ret_ll_from_type(body_ty, n_params_), Nothing), acc))
      | _ ->
          build_fn_sigs_acc(rest, env, acc)

# Separate let decls into const (evaluated at compile time) and runtime lets.
fn classify_let_decls(decls: List typed_ast.TypedDecl, env: Dict types.Scheme) -> (Dict GlobalInfo, List (String, typed_ast.TypedExpr)) =
  classify_let_decls_acc(decls, env, dict_empty(), Nil)

fn classify_let_decls_acc(decls: List typed_ast.TypedDecl, env: Dict types.Scheme, gi: Dict GlobalInfo, runtime: List (String, typed_ast.TypedExpr)) -> (Dict GlobalInfo, List (String, typed_ast.TypedExpr)) =
  match decls with
  | Nil -> (gi, list_reverse(runtime))
  | Cons decl rest ->
      match decl with
      | typed_ast.TLetDecl name body ->
          match type_to_ll(typed_ast.typed_expr_type(body)) with
          | ll ->
              match eval_const_expr(body) with
              | Just const_ir ->
                  classify_let_decls_acc(rest, env, dict_set(name, GlobalInfo(ll, true, Just(const_ir), Nothing), gi), runtime)
              | Nothing ->
                  classify_let_decls_acc(rest, env, dict_set(name, GlobalInfo(ll, false, Nothing, call_sig_from_type(typed_ast.typed_expr_type(body))), gi), Cons((name, body), runtime))
      | _ ->
          classify_let_decls_acc(rest, env, gi, runtime)

# Evaluate a compile-time constant expression.
fn eval_const_expr(e: typed_ast.TypedExpr) -> Maybe String =
  match e with
  | typed_ast.TInt n _ _ -> Just(int_to_string(n))
  | typed_ast.TBool b _ _ -> Just(if b then "1" else "0")
  | typed_ast.TUnit _ _ -> Just("0")
  | _ -> Nothing

# Emit extern declarations for all extern sigs.
fn emit_extern_decls(externs: Dict FnSig, em: Emitter) -> Unit !{IO} =
  emit_extern_decl_keys(dict_keys(externs), externs, em, 0)

fn emit_extern_decl_keys(keys: Vec String, externs: Dict FnSig, em: Emitter, idx: Int) -> Unit !{IO} =
  if idx >= vec_length(keys) then ()
  else
    match vec_get(idx, keys) with
    | Nothing -> emit_extern_decl_keys(keys, externs, em, idx + 1)
    | Just k ->
        match dict_get(k, externs) with
        | Nothing -> emit_extern_decl_keys(keys, externs, em, idx + 1)
        | Just sig ->
            do
              let params_str = string.join(", ", fn_params(sig))
              # ABI fix: width=3 unboxed externs (24-byte SproutUnboxed3) must
              # use sret on arm64 Darwin and the SysV AMD64 ABI.  Clang lowers
              # `SproutUnboxed3 f(...)` to a void function with an sret first
              # arg; a bare `{i64,i64,i64}` direct-return declare would silently
              # misread the call's return registers.  Width=2 (16-byte
              # SproutUnboxed2) fits in two return registers and stays direct.
              if fn_ret(sig) == "{ i64, i64, i64 }" then
                emit_template(em, `declare void @${fn_name (sig)}(ptr sret({ i64, i64, i64 }) align 8, ${params_str})`)
              else
                emit_template(em, `declare ${fn_ret (sig)} @${fn_name (sig)}(${params_str})`)
              emit_extern_decl_keys(keys, externs, em, idx + 1)

# Emit global variable declarations.
fn emit_global_decls(gi: Dict GlobalInfo, em: Emitter) -> Unit !{IO} =
  emit_global_decl_keys(dict_keys(gi), gi, em, 0)

fn emit_global_decl_keys(keys: Vec String, gi: Dict GlobalInfo, em: Emitter, idx: Int) -> Unit !{IO} =
  if idx >= vec_length(keys) then ()
  else
    match vec_get(idx, keys) with
    | Nothing -> emit_global_decl_keys(keys, gi, em, idx + 1)
    | Just k ->
        match dict_get(k, gi) with
        | Nothing -> emit_global_decl_keys(keys, gi, em, idx + 1)
        | Just info ->
            do
              let line = if gi_is_const(info)
                         then match gi_const_ir(info) with
                              | Nothing -> "@" ++ k ++ " = global " ++ gi_ll(info) ++ " " ++ zero_init(gi_ll(info))
                              | Just cir -> "@" ++ k ++ " = private constant " ++ gi_ll(info) ++ " " ++ cir
                         else "@" ++ k ++ " = global " ++ gi_ll(info) ++ " " ++ zero_init(gi_ll(info))
              emit_line(em, line)
              emit_global_decl_keys(keys, gi, em, idx + 1)

# Register fn wrappers for all top-level functions (except main).
fn register_fn_wrappers(decls: List typed_ast.TypedDecl, fn_sigs_: Dict FnSig, em: Emitter) -> Unit !{IO} =
  match decls with
  | Nil -> ()
  | Cons decl rest ->
      do
        match decl with
        | typed_ast.TFnDecl name _ _ _ _ _ ->
            if name == "main" then ()
            else
              match dict_get(name, fn_sigs_) with
              | Nothing -> ()
              | Just sig ->
                  do
                    lam_idx <- fresh_lambda_idx(em)
                    let wname = "__sprout_fn_closure_" ++ int_to_string(lam_idx)
                    set_fn_wrapper(em, name, wname)
                    let wrapper_lines = emit_named_fn_wrapper_lines(wname, emitted_fn_name(name), sig)
                    emit_defs_list(wrapper_lines, em)
                    add_def_line(em, "")
        | _ -> ()
        register_fn_wrappers(rest, fn_sigs_, em)

# Emit all function declarations.
fn emit_all_fns(decls: List typed_ast.TypedDecl, fn_sigs_: Dict FnSig, ctor_reg_meta: Dict (List (String, Int, Int, Int, String)), runtime_lets: List (String, typed_ast.TypedExpr), ctx: CgCtx, em: Emitter) -> Unit !{IO} =
  match decls with
  | Nil -> ()
  | Cons decl rest ->
      do
        match decl with
        | typed_ast.TFnDecl name params _ _ _ body ->
            match dict_get(name, fn_sigs_) with
            | Nothing -> ()
            | Just sig ->
                do
                  let is_entry = is_entry_fn_name(name)
                  emit_fn_decl(name, params, body, sig, is_entry, ctor_reg_meta, runtime_lets, ctx, em)
                  emit_line(em, "")
        | _ -> ()
        emit_all_fns(rest, fn_sigs_, ctor_reg_meta, runtime_lets, ctx, em)

# Emit only the function declarations whose name contains fn_name as a substring.
fn emit_matching_fns(decls: List typed_ast.TypedDecl, fn_name: String, fn_sigs_: Dict FnSig, ctor_reg_meta: Dict (List (String, Int, Int, Int, String)), runtime_lets: List (String, typed_ast.TypedExpr), ctx: CgCtx, em: Emitter) -> Unit !{IO} =
  match decls with
  | Nil -> ()
  | Cons decl rest ->
      do
        match decl with
        | typed_ast.TFnDecl name params _ _ _ body ->
            if str_find(name, fn_name) >= 0 then
              match dict_get(name, fn_sigs_) with
              | Nothing -> ()
              | Just sig ->
                  do
                    let is_entry = is_entry_fn_name(name)
                    emit_fn_decl(name, params, body, sig, is_entry, ctor_reg_meta, runtime_lets, ctx, em)
                    emit_line(em, "")
            else ()
        | _ -> ()
        emit_matching_fns(rest, fn_name, fn_sigs_, ctor_reg_meta, runtime_lets, ctx, em)

# Like compile_to_ir_lines but only emits the function(s) whose name contains
# fn_name as a substring.  Used by --emit-ir-one for fast per-function debugging.
export fn compile_to_ir_lines_one_fn(fn_name: String, prog: typed_ast.TypedProgram, env: Dict types.Scheme) -> IrLinesResult !{IO} =
  match prog with
  | typed_ast.TypedProgram decls ->
      do
        em <- new_emitter(false, "")
        let fn_sigs_ = build_fn_sigs_from_decls(decls, env)
        let externs = build_extern_sigs_from_decls(decls, env)
        let ctor_adt_pair = build_ctor_sigs_from_decls(decls)
        let ctor_sigs_ = match ctor_adt_pair with | (cs, _) -> cs
        let adt_names_ = match ctor_adt_pair with | (_, an) -> an
        let gi_rt_pair = classify_let_decls(decls, env)
        let gi = match gi_rt_pair with | (g, _) -> g
        let runtime_lets = match gi_rt_pair with | (_, r) -> r
        let adt_arities = build_adt_arities(decls)
        let mutual_tco_ = build_mutual_tco_fns(decls)
        let cpr_fns_ = build_cpr_fns(decls, adt_arities, mutual_tco_)
        let cpr_extern_decls = build_cpr_extern_sigs(decls, adt_arities, externs)
        let ctx = CgCtx(fn_sigs_, ctor_sigs_, gi, adt_names_, externs, "", cpr_fns_, cpr_extern_decls, mutual_tco_)
        emit_line(em, "; Generated by sprout codegen.sprout (M6) -- single-function mode")
        emit_line(em, "target triple = \"unknown-unknown-unknown\"")
        emit_line(em, "")
        emit_extern_decls(externs, em)
        emit_extern_decls(cpr_extern_decls, em)
        emit_line(em, "")
        ctor_reg_meta <- build_ctor_reg_meta(ctor_sigs_, em)
        emit_matching_fns(decls, fn_name, fn_sigs_, ctor_reg_meta, runtime_lets, ctx, em)
        sections <- assemble_ir_sections(em)
        warns <- ref_read(em_warns_ref(em))
        match sections with
        | (header_lines, str_lines, def_lines, dbg_lines) -> IrLinesOk(header_lines, str_lines, def_lines, dbg_lines, warns)

# Build ctor registration metadata (for the main function's startup code).
fn build_ctor_reg_meta(ctor_sigs_: Dict CtorSig, em: Emitter) -> Dict (List (String, Int, Int, Int, String)) !{IO} =
  build_ctor_reg_meta_keys(dict_keys(ctor_sigs_), ctor_sigs_, em, 0, dict_empty())

# Build the registration alias list: always the qualified name; add the leaf name when it differs.
# Uses strip_module_prefix to get the leaf (the part after the last dot).
fn ctor_reg_aliases(k: String, leaf: String, tag: Int, arity: Int, gname: String, gname_len: Int, fkinds: String, em: Emitter) -> List (String, Int, Int, Int, String) !{IO} =
  if leaf == k
  then Cons((gname, gname_len, tag, arity, fkinds), Nil)
  else
    do
      (gname2, len2) <- string_const(em, leaf)
      Cons((gname, gname_len, tag, arity, fkinds), Cons((gname2, len2, tag, arity, fkinds), Nil))

fn build_ctor_reg_meta_keys(keys: Vec String, ctor_sigs_: Dict CtorSig, em: Emitter, idx: Int, acc: Dict (List (String, Int, Int, Int, String))) -> Dict (List (String, Int, Int, Int, String)) !{IO} =
  if idx >= vec_length(keys) then acc
  else
    match vec_get(idx, keys) with
    | Nothing -> build_ctor_reg_meta_keys(keys, ctor_sigs_, em, idx + 1, acc)
    | Just k ->
        match dict_get(k, ctor_sigs_) with
        | Nothing -> build_ctor_reg_meta_keys(keys, ctor_sigs_, em, idx + 1, acc)
        | Just ctor ->
            # Wrap ctors are not registered at runtime: they have no tag,
            # no fields to introspect, and no constructor function exists.
            if ctor_is_wrap(ctor) then
              build_ctor_reg_meta_keys(keys, ctor_sigs_, em, idx + 1, acc)
            else do
              (gname, gname_len) <- string_const(em, k)
              let fkinds = fk.ctor_field_kinds_string(ctor_type_exprs(ctor))
              aliases <- ctor_reg_aliases(k, strip_module_prefix(k), ctor_tag(ctor), ctor_arity(ctor), gname, gname_len, fkinds, em)
              build_ctor_reg_meta_keys(keys, ctor_sigs_, em, idx + 1, dict_set(k, aliases, acc))

fn assemble_ir_sections(em: Emitter) -> (List String, List String, List String, List String) !{IO} =
  do
    body <- es_body(em)
    defs <- es_all_defs(em)
    strs <- es_str_glbs(em)
    let header_lines = list_reverse(body)
    let def_lines = list_reverse(defs)
    let str_lines = list_reverse(strs)
    dbg_lines <- if em_dbg_mode(em) then assemble_debug_section(em) else Nil
    (header_lines, str_lines, def_lines, dbg_lines)

fn join_line_sections(header_lines: List String, str_lines: List String, def_lines: List String, dbg_lines: List String) -> String =
  string_join_newlines(header_lines) ++ string_join_newlines(str_lines) ++ string_join_newlines(def_lines) ++ string_join_newlines(dbg_lines)

# ===========================================================================
# Section 22 — Main entry point
# ===========================================================================

export fn compile_to_ir(prog: typed_ast.TypedProgram, env: Dict types.Scheme) -> IrResult !{IO} =
  do
    lines_result <- compile_to_ir_lines(prog, env, false, "")
    match lines_result with
    | IrLinesErr msg -> IrErr(msg)
    | IrLinesOk header_lines str_lines def_lines dbg_lines _ -> IrOk(join_line_sections(header_lines, str_lines, def_lines, dbg_lines))

fn codegen_timing_enabled() -> Bool !{IO} =
  match env_get("SPROUT_TIME_PHASES") with
  | Nothing -> false
  | Just s -> if s == "" then false else if s == "0" then false else true

fn codegen_us_to_ms(us: Int) -> String = int_to_string(us / 1000)

export fn compile_to_ir_lines(prog: typed_ast.TypedProgram, env: Dict types.Scheme, debug_mode_: Bool, source_file_: String) -> IrLinesResult !{IO} =
  match prog with
  | typed_ast.TypedProgram decls ->
      do
        cg_t0 <- time_now_micros()
        em <- new_emitter(debug_mode_, source_file_)
        let fn_sigs_ = build_fn_sigs_from_decls(decls, env)
        let externs = build_extern_sigs_from_decls(decls, env)
        let ctor_adt_pair = build_ctor_sigs_from_decls(decls)
        let ctor_sigs_ = match ctor_adt_pair with | (cs, _) -> cs
        let adt_names_ = match ctor_adt_pair with | (_, an) -> an
        let gi_rt_pair = classify_let_decls(decls, env)
        let gi = match gi_rt_pair with | (g, _) -> g
        let runtime_lets = match gi_rt_pair with | (_, r) -> r
        let adt_arities = build_adt_arities(decls)
        let mutual_tco_ = build_mutual_tco_fns(decls)
        let cpr_fns_ = build_cpr_fns(decls, adt_arities, mutual_tco_)
        let cpr_extern_decls = build_cpr_extern_sigs(decls, adt_arities, externs)
        let ctx = CgCtx(fn_sigs_, ctor_sigs_, gi, adt_names_, externs, "", cpr_fns_, cpr_extern_decls, mutual_tco_)
        cg_t1 <- time_now_micros()
        # Header
        emit_line(em, "; Generated by sprout codegen.sprout (M6)")
        emit_line(em, "target triple = \"unknown-unknown-unknown\"")
        emit_line(em, "")
        # Extern declarations
        emit_extern_decls(externs, em)
        emit_extern_decls(cpr_extern_decls, em)
        emit_line(em, "")
        # Global variable declarations
        emit_global_decls(gi, em)
        str_len_gi <- global_count(gi)
        if str_len_gi > 0 then emit_line(em, "") else ()
        # Register wrappers for all top-level functions
        register_fn_wrappers(decls, fn_sigs_, em)
        # Build ctor registration metadata
        ctor_reg_meta <- build_ctor_reg_meta(ctor_sigs_, em)
        # Emit global init function if needed
        match runtime_lets with
        | Nil -> ()
        | _ ->
            do
              emit_init_globals_fn(runtime_lets, ctx, em)
              emit_line(em, "")
        cg_t2 <- time_now_micros()
        # Emit all functions
        emit_all_fns(decls, fn_sigs_, ctor_reg_meta, runtime_lets, ctx, em)
        cg_t3 <- time_now_micros()
        # Assemble final IR sections without concatenating the full output.
        sections <- assemble_ir_sections(em)
        cg_t4 <- time_now_micros()
        warns <- ref_read(em_warns_ref(em))
        timing_on <- codegen_timing_enabled()
        if timing_on
          then eprint("  [cg] sigs+ctx=" ++ codegen_us_to_ms(cg_t1 - cg_t0) ++ "ms decls_header=" ++ codegen_us_to_ms(cg_t2 - cg_t1) ++ "ms emit_all_fns=" ++ codegen_us_to_ms(cg_t3 - cg_t2) ++ "ms assemble=" ++ codegen_us_to_ms(cg_t4 - cg_t3) ++ "ms")
          else ()
        match sections with
        | (header_lines, str_lines, def_lines, dbg_lines) -> IrLinesOk(header_lines, str_lines, def_lines, dbg_lines, warns)

fn global_count(gi: Dict GlobalInfo) -> Int !{IO} =
  vec_length(dict_keys(gi))

