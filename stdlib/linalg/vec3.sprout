module stdlib.linalg.vec3

# A pure, immutable 3-vector. A record, not a buffer: every op returns a fresh
# value, so none needs IO.

import stdlib.math (sqrt)

export type Vec3 (..) = (x: Double, y: Double, z: Double) deriving (ToString)

export fn new(x: Double, y: Double, z: Double) -> Vec3 = Vec3(x = x, y = y, z = z)

export let zero = new(0.0, 0.0, 0.0)

export fn add(a: Vec3, b: Vec3) -> Vec3 = new(a.x + b.x, a.y + b.y, a.z + b.z)

export fn sub(a: Vec3, b: Vec3) -> Vec3 = new(a.x - b.x, a.y - b.y, a.z - b.z)

export fn neg(v: Vec3) -> Vec3 = new(-v.x, -v.y, -v.z)

export fn scale(s: Double, v: Vec3) -> Vec3 = new(s * v.x, s * v.y, s * v.z)

export fn dot(a: Vec3, b: Vec3) -> Double = a.x * b.x + a.y * b.y + a.z * b.z

# Right-handed: x cross y = z.
export fn cross(a: Vec3, b: Vec3) -> Vec3 =
  new(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x)

export fn length_squared(v: Vec3) -> Double = dot(v, v)

export fn length(v: Vec3) -> Double = sqrt(length_squared(v))

export fn distance(a: Vec3, b: Vec3) -> Double = length(sub(a, b))

# The zero vector normalizes to zero.
export fn normalize(v: Vec3) -> Vec3 =
  if len == 0.0 then zero
  else scale(1.0 / len, v)
  where len = length(v)
