module stdlib.http

# Sprout HTTP helpers (v0)
# Minimal helpers for request-line parsing and response formatting.

export type HttpResponse (..) =
  | HttpResponse Int String String

export type HttpError (..) =
  | HttpTimeout
  | HttpNetwork String
  | HttpBadStatus Int
  | HttpDecode String

export type HttpStatusError (..) =
  | HttpUnsupportedStatus Int

export type RequestPathVersion (..) =
  | RequestPathVersion String String

export type RequestLine (..) =
  | RequestLine String RequestPathVersion

type HttpStatusInfo =
  | HttpStatusInfo String String

fn str_drop(s: String, n: Int) -> String =
  if n >= str_len(s) then ""
  else str_slice(s, n, str_len(s) - n)

fn first_line(raw: String) -> String =
  if str_find(raw, "\r\n") < 0 then raw
  else str_slice(raw, 0, str_find(raw, "\r\n"))

fn parse_request_line_after_rest(method: String, rest: String) -> Maybe RequestLine =
  if str_find(rest, " ") < 0 then Nothing
  else
    Just(
      RequestLine(
        method,
        RequestPathVersion(str_slice(rest, 0, str_find(rest, " ")), str_drop(rest, str_find(rest, " ") + 1))
      )
    )

fn parse_request_line_from_line(line: String) -> Maybe RequestLine =
  if str_find(line, " ") < 0 then Nothing
  else parse_request_line_after_rest(str_slice(line, 0, str_find(line, " ")), str_drop(line, str_find(line, " ") + 1))

export fn parse_request_line(raw: String) -> Maybe RequestLine =
  parse_request_line_from_line(first_line(raw))

fn http_status_info(status: Int) -> Maybe HttpStatusInfo =
  match status with
  | 200 -> Just(HttpStatusInfo("200", "OK"))
  | 201 -> Just(HttpStatusInfo("201", "Created"))
  | 202 -> Just(HttpStatusInfo("202", "Accepted"))
  | 204 -> Just(HttpStatusInfo("204", "No Content"))
  | 400 -> Just(HttpStatusInfo("400", "Bad Request"))
  | 401 -> Just(HttpStatusInfo("401", "Unauthorized"))
  | 403 -> Just(HttpStatusInfo("403", "Forbidden"))
  | 404 -> Just(HttpStatusInfo("404", "Not Found"))
  | 405 -> Just(HttpStatusInfo("405", "Method Not Allowed"))
  | 409 -> Just(HttpStatusInfo("409", "Conflict"))
  | 410 -> Just(HttpStatusInfo("410", "Gone"))
  | 422 -> Just(HttpStatusInfo("422", "Unprocessable Content"))
  | 429 -> Just(HttpStatusInfo("429", "Too Many Requests"))
  | 500 -> Just(HttpStatusInfo("500", "Internal Server Error"))
  | 501 -> Just(HttpStatusInfo("501", "Not Implemented"))
  | 502 -> Just(HttpStatusInfo("502", "Bad Gateway"))
  | 503 -> Just(HttpStatusInfo("503", "Service Unavailable"))
  | 504 -> Just(HttpStatusInfo("504", "Gateway Timeout"))
  | _ -> Nothing

fn http_status_line(info: HttpStatusInfo) -> String =
  match info with
  | HttpStatusInfo code reason ->
      str_concat("HTTP/1.1 ", str_concat(code, str_concat(" ", reason)))

# The status line alone ("HTTP/1.1 200 OK"), for callers that assemble their own
# header block (e.g. stdlib.http_server.render, which builds headers from a dict so
# it can control Content-Type/Content-Length). Reuses the shared status table so the
# supported-status set stays defined in one place.
export fn status_line(status: Int) -> Result HttpStatusError String =
  match http_status_info(status) with
  | Just info -> Ok(http_status_line(info))
  | Nothing -> Err(HttpUnsupportedStatus(status))

export fn http_response(status: Int, body: String) -> Result HttpStatusError String =
  match http_status_info(status) with
  | Just info ->
      Ok(
        str_concat(
          http_status_line(info),
          str_concat("\r\nConnection: close\r\nContent-Type: text/plain\r\n\r\n", body)
        )
      )
  | Nothing -> Err(HttpUnsupportedStatus(status))

export fn http_ok(body: String) -> String =
  match http_response(200, body) with
  | Ok response -> response
  | Err _ -> ""

export fn http_bad_request() -> String =
  match http_response(400, "bad request") with
  | Ok response -> response
  | Err _ -> ""

export fn request_line_to_string(req: RequestLine) -> String =
  match req with
  | RequestLine method pv ->
      match pv with
      | RequestPathVersion path version ->
          str_concat(str_concat(method, " "), str_concat(path, str_concat(" ", version)))

export fn http_echo_response(raw_request: String) -> String =
  match parse_request_line(raw_request) with
  | Nothing -> http_bad_request()
  | Just req -> http_ok(request_line_to_string(req))

export fn http_response_body(resp: HttpResponse) -> String =
  match resp with
  | HttpResponse _ _ body -> body
