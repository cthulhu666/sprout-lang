module stdlib.http

import stdlib.bytes (Utf8Error)
import stdlib.bytes as bytes

# Sprout HTTP helpers (v0)
# Minimal helpers for request-line parsing and response formatting.

# status, raw header block, body.
#
# The body is Bytes, not String, for the same reason `stdlib.http_server`'s request body is: an HTTP
# body is a byte sequence — a PNG, a gzip stream, a protobuf message — and a Sprout String cannot
# carry one, being valid UTF-8 and NUL-free by construction (docs/spec-v0.md:64). While this was a
# String the runtime measured the received body with `strlen`, so a body containing 0x00 was
# SILENTLY truncated at it and returned as `Ok` — fetching a PNG yielded a handful of bytes and no
# error — and non-UTF-8 bytes were admitted into a String unvalidated, which the spec names as the
# obligation such a builtin has to meet.
#
# Text callers decode explicitly with `http_response_text`, which returns a `Result`: the failure is
# reported where it can be handled rather than being decided on the caller's behalf during the read.
# Follows Go (`http.Response.Body` is an `io.ReadCloser` of bytes) and hyper (a `Body` of `Bytes`).
export type HttpResponse (..) =
  | HttpResponse Int String Bytes

export type HttpError (..) =
  | HttpTimeout
  | HttpNetwork String
  | HttpBadStatus Int
  | HttpDecode String

# A status a server here can send. Closed, so every one has a status line and nothing can ask for
# one that does not. Each name carries its code, which also keeps `Ok200` apart from `Result`'s `Ok`.
export type HttpStatus (..) =
  | Ok200
  | Created201
  | Accepted202
  | NoContent204
  | MovedPermanently301
  | Found302
  | SeeOther303
  | NotModified304
  | TemporaryRedirect307
  | PermanentRedirect308
  | BadRequest400
  | Unauthorized401
  | Forbidden403
  | NotFound404
  | MethodNotAllowed405
  | RequestTimeout408
  | Conflict409
  | Gone410
  | ContentTooLarge413
  | UnprocessableContent422
  | TooManyRequests429
  | RequestHeaderFieldsTooLarge431
  | InternalServerError500
  | NotImplemented501
  | BadGateway502
  | ServiceUnavailable503
  | GatewayTimeout504

export type RequestPathVersion (..) =
  | RequestPathVersion String String

export type RequestLine (..) =
  | RequestLine String RequestPathVersion

fn str_drop(s: String, n: Int) -> String =
  if n >= str_len(s) then ""
  else str_slice(s, n, str_len(s) - n)

fn first_line(raw: String) -> String =
  if str_find(raw, "\r\n") < 0 then raw
  else str_slice(raw, 0, str_find(raw, "\r\n"))

fn parse_request_line_after_rest(method: String, rest: String) -> Maybe RequestLine =
  if str_find(rest, " ") < 0 then Nothing
  else
    Just(
      RequestLine(
        method,
        RequestPathVersion(str_slice(rest, 0, str_find(rest, " ")), str_drop(rest, str_find(rest, " ") + 1))
      )
    )

fn parse_request_line_from_line(line: String) -> Maybe RequestLine =
  if str_find(line, " ") < 0 then Nothing
  else parse_request_line_after_rest(str_slice(line, 0, str_find(line, " ")), str_drop(line, str_find(line, " ") + 1))

export fn parse_request_line(raw: String) -> Maybe RequestLine =
  parse_request_line_from_line(first_line(raw))

export fn status_code(status: HttpStatus) -> Int =
  match status with
  | Ok200 -> 200
  | Created201 -> 201
  | Accepted202 -> 202
  | NoContent204 -> 204
  | MovedPermanently301 -> 301
  | Found302 -> 302
  | SeeOther303 -> 303
  | NotModified304 -> 304
  | TemporaryRedirect307 -> 307
  | PermanentRedirect308 -> 308
  | BadRequest400 -> 400
  | Unauthorized401 -> 401
  | Forbidden403 -> 403
  | NotFound404 -> 404
  | MethodNotAllowed405 -> 405
  | RequestTimeout408 -> 408
  | Conflict409 -> 409
  | Gone410 -> 410
  | ContentTooLarge413 -> 413
  | UnprocessableContent422 -> 422
  | TooManyRequests429 -> 429
  | RequestHeaderFieldsTooLarge431 -> 431
  | InternalServerError500 -> 500
  | NotImplemented501 -> 501
  | BadGateway502 -> 502
  | ServiceUnavailable503 -> 503
  | GatewayTimeout504 -> 504

export fn status_reason(status: HttpStatus) -> String =
  match status with
  | Ok200 -> "OK"
  | Created201 -> "Created"
  | Accepted202 -> "Accepted"
  | NoContent204 -> "No Content"
  | MovedPermanently301 -> "Moved Permanently"
  | Found302 -> "Found"
  | SeeOther303 -> "See Other"
  | NotModified304 -> "Not Modified"
  | TemporaryRedirect307 -> "Temporary Redirect"
  | PermanentRedirect308 -> "Permanent Redirect"
  | BadRequest400 -> "Bad Request"
  | Unauthorized401 -> "Unauthorized"
  | Forbidden403 -> "Forbidden"
  | NotFound404 -> "Not Found"
  | MethodNotAllowed405 -> "Method Not Allowed"
  | RequestTimeout408 -> "Request Timeout"
  | Conflict409 -> "Conflict"
  | Gone410 -> "Gone"
  # RFC 9110 §15.5.14 renamed 413 from "Payload Too Large" (RFC 7231) to "Content Too Large"; the
  # newer phrase is used here. The reason phrase is advisory — clients switch on the code — so the
  # rename is safe, and nginx still reports the older name for the same status.
  | ContentTooLarge413 -> "Content Too Large"
  | UnprocessableContent422 -> "Unprocessable Content"
  | TooManyRequests429 -> "Too Many Requests"
  | RequestHeaderFieldsTooLarge431 -> "Request Header Fields Too Large"
  | InternalServerError500 -> "Internal Server Error"
  | NotImplemented501 -> "Not Implemented"
  | BadGateway502 -> "Bad Gateway"
  | ServiceUnavailable503 -> "Service Unavailable"
  | GatewayTimeout504 -> "Gateway Timeout"

# A 204 or 304 has no content (RFC 9110 §15.3.5, §15.4.5): no body, no Content-Length (§8.6) and no
# default content-type. A cache copies a 304's headers onto the stored response (RFC 9111 §4.3.4),
# so a defaulted type would replace the real one.
export fn status_has_content(status: HttpStatus) -> Bool =
  match status with
  | NoContent204 -> false
  | NotModified304 -> false
  | _ -> true

# "HTTP/1.1 200 OK", for callers that assemble their own header block, as
# stdlib.http_server.render does.
export fn status_line(status: HttpStatus) -> String =
  "HTTP/1.1 " ++ int_to_string(status_code(status)) ++ " " ++ status_reason(status)

export fn http_response(status: HttpStatus, body: String) -> String =
  if status_has_content(status) then
    status_line(status) ++ "\r\nConnection: close\r\nContent-Type: text/plain\r\n\r\n" ++ body
  else status_line(status) ++ "\r\nConnection: close\r\n\r\n"

export fn http_ok(body: String) -> String =
  http_response(Ok200, body)

export fn http_bad_request() -> String =
  http_response(BadRequest400, "bad request")

export fn request_line_to_string(req: RequestLine) -> String =
  match req with
  | RequestLine method pv ->
      match pv with
      | RequestPathVersion path version ->
          str_concat(str_concat(method, " "), str_concat(path, str_concat(" ", version)))

export fn http_echo_response(raw_request: String) -> String =
  match parse_request_line(raw_request) with
  | Nothing -> http_bad_request()
  | Just req -> http_ok(request_line_to_string(req))

export fn http_response_body(resp: HttpResponse) -> Bytes =
  match resp with
  | HttpResponse _ _ body -> body

# The body decoded as text. Separate from `http_response_body` and returning a `Result` because
# decoding is where a non-text response must be allowed to fail: the framing succeeded (these are
# exactly the bytes the server sent), the decoding did not. A caller wanting a PNG uses
# `http_response_body` and is no longer refused on a text assumption it never made.
export fn http_response_text(resp: HttpResponse) -> Result Utf8Error String =
  bytes.to_string(http_response_body(resp))
