module stdlib.log

import stdlib.bytes as bytes
import stdlib.hex as hex
import stdlib.string as string
import stdlib.time as time

# Leveled, structured logging. A logger is an immutable capability value that is
# threaded explicitly (never an ambient global) — matching docs/observability-
# guard-rails.md #3. Enriching a logger (with_field) returns a NEW logger; the
# sink and the record formatter are decoupled, so the pure pieces are testable
# without a socket, a file, or the wall clock. Design: docs/logging-v0.md.

export type Level (..) =
  | Debug
  | Info
  | Warn
  | Error

# min level | output sink | base context fields (prepended to every record)
export type Logger =
  | Logger Level (String -> Unit !{IO}) (Vec (String, String))

# --- Levels ----------------------------------------------------------------
fn rank(lvl: Level) -> Int =
  match lvl with
  | Debug -> 0
  | Info -> 1
  | Warn -> 2
  | Error -> 3

export fn level_name(lvl: Level) -> String =
  match lvl with
  | Debug -> "DEBUG"
  | Info -> "INFO"
  | Warn -> "WARN"
  | Error -> "ERROR"

# --- Constructors and accessors -------------------------------------------
export fn logger_with_sink(min: Level, sink: String -> Unit !{IO}) -> Logger =
  Logger(min, sink, vec_empty())

# The default sink is stderr (via eprint), which keeps stdout clean for a
# program's actual output — the Unix convention for diagnostics.
export fn stderr_logger(min: Level) -> Logger =
  logger_with_sink(min, eprint)

export fn min_level(lg: Logger) -> Level =
  match lg with
  | Logger min _ _ -> min

export fn base_fields(lg: Logger) -> Vec (String, String) =
  match lg with
  | Logger _ _ fields -> fields

# A new logger carrying one more base field; the source logger is unchanged.
export fn with_field(k: String, v: String, lg: Logger) -> Logger =
  match lg with
  | Logger min sink fields -> Logger(min, sink, vec_append((k, v), fields))

# --- Filtering -------------------------------------------------------------
# True iff a record at `lvl` meets the logger's minimum threshold.
export fn should_log(lg: Logger, lvl: Level) -> Bool =
  rank(lvl) >= rank(min_level(lg))

# --- Timestamp formatting (pure) ------------------------------------------
# Zero-pad a non-negative integer to a fixed width.
fn pad2(n: Int) -> String =
  if n < 10 then string.concat("0", int_to_string(n))
  else int_to_string(n)

fn pad4(n: Int) -> String =
  if n < 10 then string.concat("000", int_to_string(n))
  else if n < 100 then string.concat("00", int_to_string(n))
  else if n < 1000 then string.concat("0", int_to_string(n))
  else int_to_string(n)

# days since 1970-01-01 (>= 0) -> (year, month, day). Howard Hinnant's
# civil_from_days, specialized to the non-negative domain (era >= 0), so the
# whole conversion is total integer arithmetic — no builtin. O(1).
fn civil_from_days(z0: Int) -> (Int, Int, Int) =
  let z = z0 + 719468
      era = z / 146097
      doe = z - era * 146097
      yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
      yr = yoe + era * 400
      doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
      mp = (5 * doy + 2) / 153
      day = doy - (153 * mp + 2) / 5 + 1
      mon = if mp < 10 then mp + 3 else mp - 9
      year = if mon <= 2 then yr + 1 else yr
  in (year, mon, day)

fn date_time_string(y: Int, mo: Int, d: Int, hh: Int, mm: Int, ss: Int) -> String =
  pad4(y) ++ "-" ++ pad2(mo) ++ "-" ++ pad2(d) ++ "T" ++ pad2(hh) ++ ":" ++ pad2(mm) ++ ":" ++ pad2(ss) ++ "Z"

fn format_from_secs(secs: Int) -> String =
  match civil_from_days(secs / 86400) with
  | (y, mo, d) ->
      let sod = secs - (secs / 86400) * 86400
          hh = sod / 3600
          mm = (sod - hh * 3600) / 60
          ss = sod - (sod / 60) * 60
      in date_time_string(y, mo, d, hh, mm, ss)

# Render wall-clock microseconds-since-epoch as `YYYY-MM-DDThh:mm:ssZ` (UTC),
# truncated to whole seconds. Domain: micros >= 0 (dates from 1970 onward).
export fn format_iso8601(micros: Int) -> String =
  format_from_secs(micros / 1000000)

# --- Record formatting (pure) ---------------------------------------------
# Append the call fields onto the base fields (base first), preserving order.
fn all_fields(base: Vec (String, String), call: Vec (String, String)) -> Vec (String, String) =
  base ++ call

# --- Text escaping ---------------------------------------------------------
# One record is one line, and keys and values read back unambiguously (modelled on Go's
# log/slog TextHandler). A key or value is written bare unless it is empty or holds a space, `=`,
# `"`, a control byte, a C1 control (U+0080-U+009F) or U+2028/U+2029; then it is wrapped in `"` and
# escaped. The message is never quoted, but gets the same escapes. Everything is a byte scan. The
# ASCII bytes that change are single bytes; the rest are the UTF-8 sequences `C2 80`-`C2 9F` and
# `E2 80 A8`/`E2 80 A9`, found by their lead byte and then checked whole, so every cut lands on a
# codepoint boundary and all other non-ASCII UTF-8 passes through. Docs: logging-v0.md §4.2.

fn control_byte(b: Int) -> Bool =
  b < 32 || b == 127

# A byte that forces quotes: space, `=`, `"`, or a control byte.
fn quote_byte(b: Int) -> Bool =
  control_byte(b) || b == 32 || b == 34 || b == 61

# A byte that is rewritten. Inside quotes `"` is too; a message is not quoted, so it keeps `"`.
fn escaped_byte(quoted: Bool, b: Int) -> Bool =
  control_byte(b) || b == 92 || (quoted && b == 34)

# Lead bytes of the multi-byte sequences: `C2` (C1 controls) and `E2` (U+2028/U+2029).
fn multi_lead(b: Int) -> Bool =
  b == 194 || b == 226

# The length of the escaped multi-byte sequence at `i`: 2 for a C1 control, 3 for U+2028/U+2029,
# else 0. 256 is no byte, so a truncated sequence never matches.
fn multi_len(b: Bytes, i: Int) -> Int =
  if lead == 194 && next >= 128 && next <= 159 then 2
  else if lead == 226 && next == 128 && (last == 168 || last == 169) then 3
  else 0
where
  lead = bytes.get_or(b, i, 256)
  next = bytes.get_or(b, i + 1, 256)
  last = bytes.get_or(b, i + 2, 256)

# The length of the sequence at `i` that is rewritten: 0 none, 1 an ASCII byte, 2 or 3 multi-byte.
fn escape_len(quoted: Bool, b: Bytes, i: Int) -> Int =
  if escaped_byte(quoted, bytes.get_or(b, i, 256)) then 1 else multi_len(b, i)

fn escape_piece(b: Bytes, i: Int, len: Int) -> String =
  if len == 2 then "\\u00" ++ hex.encode(bytes.slice(b, i + 1, 1))
  else if len == 3 then (if bytes.get_or(b, i + 2, 256) == 168 then "\\u2028" else "\\u2029")
  else escape_ascii(bytes.get_or(b, i, 256))

fn escape_ascii(b: Int) -> String =
  if b == 10 then "\\n"
  else if b == 13 then "\\r"
  else if b == 9 then "\\t"
  else if b == 34 then "\\\""
  else if b == 92 then "\\\\"
  else "\\x" ++ hex.encode(bytes.singleton(b))

# `run` is the start of the current verbatim run and `acc` holds the pieces, reversed. `hit` accepts
# every byte that may start an escape; `escape_len` then decides, so a lead byte that starts a
# passing sequence (U+00A0) is skipped without ending the run. At each escape, flush the run, then
# the escape, and start a new run after it. `raw` itself comes back when no run was ever flushed.
fn escape_go(quoted: Bool, hit: Int -> Bool, raw: String, b: Bytes, run: Int, i: Int, acc: List String) -> List String =
  match bytes.find_byte_from(hit, b, i) with
  | Nothing -> if run == 0 then [raw] else Cons(str_slice_bytes(raw, run, bytes.length(b) - run), acc)
  | Just at ->
      let len = escape_len(quoted, b, at)
      in if len == 0 then escape_go(quoted, hit, raw, b, run, at + 1, acc)
         else escape_go(quoted, hit, raw, b, at + len, at + len,
           Cons(escape_piece(b, at, len), Cons(str_slice_bytes(raw, run, at - run), acc)))

# O(bytes). `raw` itself when nothing needs rewriting. `b` is `raw` encoded.
fn escape_text(quoted: Bool, raw: String, b: Bytes) -> String =
  match escape_go(quoted, \x -> escaped_byte(quoted, x) || multi_lead(x), raw, b, 0, 0, Nil) with
  | [only] -> only
  | parts -> string_concat_many(list_reverse(parts))

fn quote_lead(b: Int) -> Bool =
  quote_byte(b) || multi_lead(b)

# True when a byte at or after `i` forces quotes. A lead byte that starts a passing sequence is skipped.
fn quote_at(b: Bytes, i: Int) -> Bool =
  match bytes.find_byte_from(quote_lead, b, i) with
  | Nothing -> false
  | Just at ->
      if quote_byte(bytes.get_or(b, at, 256)) || multi_len(b, at) > 0 then true
      else quote_at(b, at + 1)

# A key or a value: bare, or quoted and escaped. Encoded once for both passes.
fn render_atom(raw: String) -> String =
  if string.is_empty(raw) || quote_at(encoded, 0) then "\"" ++ escape_text(true, raw, encoded) ++ "\""
  else raw
where
  encoded = bytes.from_string(raw)

# ` k=v` for each field, in order (leading space only when there are fields).
fn render_fields(fields: Vec (String, String)) -> String =
  string_concat_many(vec_to_list(vec_map(render_field, fields)))

fn render_field(pair: (String, String)) -> String =
  match pair with
  | (k, v) -> " " ++ render_atom(k) ++ "=" ++ render_atom(v)

# One log record as a line WITHOUT a trailing newline: `<ts> <LEVEL> <msg> k=v …`.
# The sink owns line termination (the default stderr sink's eprint appends "\n").
export fn format_line(ts: String, lvl: Level, msg: String, fields: Vec (String, String)) -> String =
  ts ++ " " ++ level_name(lvl) ++ " " ++ escape_text(false, msg, bytes.from_string(msg)) ++ render_fields(fields)

# --- Emission --------------------------------------------------------------
fn run_sink(lg: Logger, line: String) -> Unit !{IO} =
  match lg with
  | Logger _ sink _ -> sink(line)

# Read the wall clock, format, and hand the finished line to the sink.
fn emit(lg: Logger, lvl: Level, msg: String, fields: Vec (String, String)) -> Unit !{IO} =
  do
    now <- time.wall_micros()
    run_sink(lg, format_line(format_iso8601(now), lvl, msg, all_fields(base_fields(lg), fields)))

# Emit a record iff its level passes the logger's threshold. When gated out,
# nothing is formatted and the sink is never touched (a filtered Debug pays only
# the level comparison).
export fn log(lg: Logger, lvl: Level, msg: String, fields: Vec (String, String)) -> Unit !{IO} =
  if should_log(lg, lvl) then emit(lg, lvl, msg, fields)
  else ()

# --- Convenience -----------------------------------------------------------
export fn debug(lg: Logger, msg: String) -> Unit !{IO} = log(lg, Debug, msg, vec_empty())
export fn info(lg: Logger, msg: String) -> Unit !{IO} = log(lg, Info, msg, vec_empty())
export fn warn(lg: Logger, msg: String) -> Unit !{IO} = log(lg, Warn, msg, vec_empty())
export fn error(lg: Logger, msg: String) -> Unit !{IO} = log(lg, Error, msg, vec_empty())

export fn debug_f(lg: Logger, msg: String, fields: Vec (String, String)) -> Unit !{IO} = log(lg, Debug, msg, fields)
export fn info_f(lg: Logger, msg: String, fields: Vec (String, String)) -> Unit !{IO} = log(lg, Info, msg, fields)
export fn warn_f(lg: Logger, msg: String, fields: Vec (String, String)) -> Unit !{IO} = log(lg, Warn, msg, fields)
export fn error_f(lg: Logger, msg: String, fields: Vec (String, String)) -> Unit !{IO} = log(lg, Error, msg, fields)
