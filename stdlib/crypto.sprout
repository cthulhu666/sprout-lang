module stdlib.crypto

# `bit_or` is an extern, so it is callable by bare name only — `bits.bit_or` does not exist.
import stdlib.bits
import stdlib.bytes as bytes
import stdlib.string as string

export type CryptoError (..) =
  | CryptoInvalidArgument String
  | CryptoUnavailable String

export type Base64Error (..) =
  | Base64DecodeError String

export type BytesOpError (..) =
  | BytesXorLengthMismatch Int Int

extern fn crypto_sha256(b: Bytes) -> Bytes
extern fn crypto_hmac_sha256(key: Bytes, msg: Bytes) -> Bytes
extern fn crypto_base64_encode(b: Bytes) -> String
extern fn crypto_base64_decode(raw: String) -> Result Base64Error Bytes
extern fn crypto_bytes_xor(left: Bytes, right: Bytes) -> Result BytesOpError Bytes
extern fn crypto_random_bytes(count: Int) -> Result CryptoError Bytes !{IO}

export fn sha256(value: Bytes) -> Bytes =
  crypto_sha256(value)

export fn hmac_sha256(key: Bytes, message: Bytes) -> Bytes =
  crypto_hmac_sha256(key, message)

export fn base64_encode(value: Bytes) -> String =
  crypto_base64_encode(value)

export fn base64_decode(raw: String) -> Result Base64Error Bytes =
  crypto_base64_decode(raw)

# RFC 4648 section 5: the `-`/`_` alphabet, no padding. O(n).
export fn base64url_encode(value: Bytes) -> String =
  base64_encode(value)
    |> string.replace_all("=", "")
    |> string.replace_all("/", "_")
    |> string.replace_all("+", "-")

fn is_base64url_char(ch: Char) -> Bool =
  string.is_ascii_alnum(ch) || ch == '-' || ch == '_'

fn mod4(n: Int) -> Int =
  n - n / 4 * 4

fn base64url_pad_count(raw: String) -> Int =
  if string.ends_with(raw, "==") then 2
  else if string.ends_with(raw, "=") then 1
  else 0

fn require_canonical(body: String, decoded: Result Base64Error Bytes) -> Result Base64Error Bytes =
  match decoded with
  | Err e -> Err(e)
  | Ok out ->
    if base64url_encode(out) == body then Ok(out)
    else Err(Base64DecodeError("invalid base64url trailing bits"))

# Reads only the `-`/`_` alphabet: `+`, `/` and a stray `=` are errors. Padding is optional, but
# when present it must complete the last group of 4. Non-zero trailing bits are refused too, so
# each value has one spelling. O(n).
export fn base64url_decode(raw: String) -> Result Base64Error Bytes =
  if pad > 0 && mod4(string.byte_length(raw)) != 0 then
    Err(Base64DecodeError("invalid base64url padding"))
  else if mod4(string.byte_length(body)) == 1 then
    Err(Base64DecodeError("invalid base64url length"))
  else if ! vec_all (is_base64url_char, string.string_chars(body)) then
    Err(Base64DecodeError("invalid base64url character"))
  else
    require_canonical(body, base64_decode(string.replace_all("_", "/", string.replace_all("-", "+", body))
      ++ string.repeat("=", mod4(4 - mod4(string.byte_length(body))))))
where
  pad = base64url_pad_count(raw)
  body = string.drop_last(raw, pad)

export fn bytes_xor(left: Bytes, right: Bytes) -> Result BytesOpError Bytes =
  crypto_bytes_xor(left, right)

# Equality for key-derived values — an HMAC tag, a session token, a challenge. Reads every
# byte whichever way the answer goes, so the time taken depends on the length and not on
# where the values differ. `==` on Bytes (instance Eq Bytes) stops at the first difference
# and leaks it; use this one wherever a secret is on either side. O(|left|), one temporary.
#
# A length mismatch is false, decided before anything is compared, so the length is not
# hidden — as in Go's subtle.ConstantTimeCompare. Node and Ruby refuse the case outright.
export fn const_time_eq(left: Bytes, right: Bytes) -> Bool =
  match crypto_bytes_xor(left, right) with
  | Err _ -> false
  | Ok difference -> or_all(difference, 0, bytes.length(difference), 0) == 0

# OR of every byte, so the result is zero only if all of them are, with no branch on any
# byte's value. `bytes.get` is matched directly to keep the Maybe unboxed (see `get_or` in
# stdlib/bytes.sprout). The unreachable arm answers -1, which never compares equal to 0.
fn or_all(value: Bytes, index: Int, total: Int, acc: Int) -> Int =
  if index >= total then acc
  else
    match bytes.get(value, index) with
    | Just b -> or_all(value, index + 1, total, bit_or(acc, b))
    | Nothing -> -1

export fn random_bytes(count: Int) -> Result CryptoError Bytes !{IO} =
  crypto_random_bytes(count)
