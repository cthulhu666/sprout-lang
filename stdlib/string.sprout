module stdlib.string
import stdlib.collections (List, Vec, vec_empty, vec_append)

export fn words(raw: String) -> List String =
  split_words(raw)

# O(|left| + |right|): allocates and copies both inputs.
export fn concat(left: String, right: String) -> String =
  str_concat(left, right)

# O(codepoints): UTF-8 length counts codepoints by scanning the string.
export fn length(raw: String) -> Int =
  str_len(raw)

# O(codepoints in `raw` + `count`): the builtin finds UTF-8 boundaries, then copies the slice.
export fn slice(raw: String, start: Int, count: Int) -> String =
  str_slice(raw, start, count)

export fn take(raw: String, count: Int) -> String =
  if count <= 0 then ""
  else if count >= length(raw) then raw
  else slice(raw, 0, count)

export fn drop(raw: String, count: Int) -> String =
  if count <= 0 then raw
  else if count >= length(raw) then ""
  else slice(raw, count, length(raw) - count)

# O(|raw| * |needle|) in the worst case: delegates to the native substring search.
export fn find(raw: String, needle: String) -> Int =
  str_find(raw, needle)

# O(|prefix|): compares only the prefix region.
export fn starts_with(raw: String, prefix: String) -> Bool =
  str_starts_with(raw, prefix)

export fn contains(raw: String, needle: String) -> Bool =
  find(raw, needle) >= 0

# O(|raw| + |suffix|): pays for repeated length checks plus the copied suffix slice.
export fn ends_with(raw: String, suffix: String) -> Bool =
  if length(suffix) > length(raw) then false
  else slice(raw, length(raw) - length(suffix), length(suffix)) == suffix

# O(index): scans UTF-8 codepoints up to the requested position.
export fn char_at(raw: String, index: Int) -> Maybe Char =
  str_char_at(raw, index)

export fn char_at_or(raw: String, index: Int, fallback: Char) -> Char =
  match char_at(raw, index) with
  | Just (ch) -> ch
  | Nothing -> fallback

export fn string_from_char(ch: Char) -> String =
  char_to_string(ch)

fn is_newline(ch: Char) -> Bool =
  ch == '\n'

fn is_carriage_return(ch: Char) -> Bool =
  ch == '\r'

fn is_space(ch: Char) -> Bool =
  ch == ' '

fn is_tab(ch: Char) -> Bool =
  ch == '\t'

export fn is_ascii_whitespace(ch: Char) -> Bool =
  is_space(ch) || is_tab(ch) || is_newline(ch) || is_carriage_return(ch)

fn is_ascii_digit_char(ch: Char) -> Bool =
  digit_value(ch) >= 0

fn is_ascii_alpha_char(ch: Char) -> Bool =
  find("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", string_from_char(ch)) >= 0

export fn is_ascii_digit(ch: Char) -> Bool =
  is_ascii_digit_char(ch)

export fn is_ascii_alpha(ch: Char) -> Bool =
  is_ascii_alpha_char(ch)

export fn is_ascii_alnum(ch: Char) -> Bool =
  is_ascii_alpha_char(ch) || is_ascii_digit_char(ch)

export fn is_ident_start(ch: Char) -> Bool =
  is_ascii_alpha_char(ch) || ch == '_'

export fn is_ident_continue(ch: Char) -> Bool =
  is_ident_start(ch) || is_ascii_digit_char(ch)

export fn trim_left(raw: String) -> String =
  if length(raw) == 0 then raw
  else if is_ascii_whitespace(char_at_or(raw, 0, ' ')) then trim_left(slice(raw, 1, length(raw) - 1))
  else raw

export fn trim_right(raw: String) -> String =
  if length(raw) == 0 then raw
  else if is_ascii_whitespace(char_at_or(raw, length(raw) - 1, ' ')) then trim_right(slice(raw, 0, length(raw) - 1))
  else raw

export fn trim(raw: String) -> String =
  trim_left(trim_right(raw))

export fn is_empty(raw: String) -> Bool =
  length(raw) == 0

export fn strip_prefix(raw: String, prefix: String) -> Maybe String =
  if starts_with(raw, prefix) then Just(drop(raw, length(prefix)))
  else Nothing

export fn strip_suffix(raw: String, suffix: String) -> Maybe String =
  if ends_with(raw, suffix) then Just(take(raw, length(raw) - length(suffix)))
  else Nothing

export fn split_once(raw: String, sep: String) -> Maybe (String, String) =
  if is_empty(sep) then Nothing
  else if find(raw, sep) < 0 then Nothing
  else Just((take(raw, find(raw, sep)), drop(raw, find(raw, sep) + length(sep))))

fn join_step(sep: String, acc: List String, s: String) -> List String =
  match acc with
  | Nil -> Cons(s, Nil)
  | _ -> Cons(s, Cons(sep, acc))

# O(n + total_bytes): one O(n) fold building reversed interleaved list + O(B) concat.
export fn join(sep: String, xs: f String) -> String where Foldable f =
  string_concat_many(list_reverse(fold(\(acc, s) -> join_step(sep, acc, s), Nil, xs)))

export fn repeat(s: String, n: Int) -> String =
  if n <= 0 then "" else s ++ repeat(s, n - 1)

export fn replace_all(s: String, from: String, to: String) -> String =
  match split_once(s, from) with
  | Nothing -> s
  | Just (before, after) -> before ++ to ++ replace_all(after, from, to)

fn append_line(acc: Vec String, current: String) -> Vec String =
  vec_append(current, acc)

fn line_count_until(raw: String, line_start: Int, newline_index: Int) -> Int =
  if newline_index > line_start && is_carriage_return(char_at_or(raw, newline_index - 1, '?')) then
    newline_index - line_start - 1
  else
    newline_index - line_start

fn lines_loop(raw: String, index: Int, line_start: Int, total: Int, acc: Vec String) -> Vec String =
  if index >= total then
    if line_start >= total then acc
    else append_line(acc, slice(raw, line_start, total - line_start))
  else
    if is_newline(char_at_or(raw, index, '?')) then
      lines_loop(
        raw,
        index + 1,
        index + 1,
        total,
        append_line(acc, slice(raw, line_start, line_count_until(raw, line_start, index)))
      )
    else if is_carriage_return(char_at_or(raw, index, '?')) then
      lines_loop(raw, index + 1, line_start, total, acc)
    else
      lines_loop(raw, index + 1, line_start, total, acc)

# O(n^2) in the number of codepoints: repeated `char_at`/`slice` on persistent strings.
export fn string_lines(raw: String) -> Vec String =
  lines_loop(raw, 0, 0, length(raw), vec_empty())

fn digit_value(ch: Char) -> Int =
  find("0123456789", string_from_char(ch))

fn digits_loop(raw: String, index: Int, total: Int, acc: Vec Int) -> Vec Int =
  if index >= total then acc
  else
    if digit_value(char_at_or(raw, index, '?')) >= 0 then
      digits_loop(raw, index + 1, total, vec_append(digit_value(char_at_or(raw, index, '?')), acc))
    else
      digits_loop(raw, index + 1, total, acc)

# O(n^2) in the number of codepoints: each step re-reads one character and may copy the output vector.
export fn string_digits(raw: String) -> Vec Int =
  digits_loop(raw, 0, length(raw), vec_empty())

fn chars_loop(raw: String, index: Int, total: Int, acc: Vec Char) -> Vec Char =
  if index >= total then acc
  else chars_loop(raw, index + 1, total, vec_append(char_at_or(raw, index, '?'), acc))

# O(n^2) in the number of codepoints: repeated `char_at` plus persistent `vec_append`.
export fn string_chars(raw: String) -> Vec Char =
  chars_loop(raw, 0, length(raw), vec_empty())
