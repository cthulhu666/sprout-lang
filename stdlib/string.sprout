module stdlib.string
import stdlib.bytes as bytes
import stdlib.unicode.utf8 as utf8

# String primitives owned by this module rather than by the prelude.
#
# The prelude keeps the CHAR-INDEXED core that every program uses without thinking —
# `str_len`, `str_slice`, `str_char_at`, `str_find`, `str_starts_with`, `str_concat`,
# `str_compare`, `char_to_string`. Those are beginner-facing ergonomics and stay globally
# reachable. What lives here is the specialist surface: BYTE-indexed operations, whole-string
# splitters, and codepoint-level Char conversion. Byte offsets in particular are an encoding and
# performance concern, not a first-week one — a caller reaching for `str_byte_len` over `str_len`
# is making a deliberate choice, and an explicit import is the right place to record it.
#
# Unlike stdlib.fs / stdlib.time / stdlib.terminal, consumers of these call them BY BARE NAME and
# import this module only to bundle it. That is deliberate: `str_starts_with_at_byte` runs ~70
# times in stdlib/json.sprout's parse loop and `str_slice_bytes` sits in the lexer's per-token
# path, so routing them through wrappers would fold an unmeasured performance change into a
# relocation refactor. Externs resolve by bare name wherever their module is bundled
# (bundler.sprout:597 never registers them), so the import alone is sufficient — and a consumer
# that forgets it gets `Unknown variable`, not a missing-import diagnostic.
extern fn str_byte_len(s: String) -> Int
# O(byte_len), whatever the offset: the bounds check reads the CSTR header rather than
# scanning. Byte-indexed substring; cheaper than str_slice when the caller already tracks
# byte positions (most compiler stdlib scanning loops).
# CALLER CONTRACT: byte_start and byte_start+byte_len MUST land on UTF-8 codepoint
# boundaries. The runtime panics on a mid-codepoint split rather than silently emitting
# invalid UTF-8. For codepoint-indexed slicing of arbitrary user input, use `str_slice`
# (prelude) or `slice` below instead.
extern fn str_slice_bytes(s: String, byte_start: Int, byte_len: Int) -> String
extern fn str_starts_with_at_byte(s: String, byte: Int, prefix: String) -> Bool
extern fn str_split_lines(s: String) -> List String
extern fn split_words(s: String) -> List String

export fn words(raw: String) -> List String =
  split_words(raw)

# O(|left| + |right|): allocates and copies both inputs.
export fn concat(left: String, right: String) -> String =
  str_concat(left, right)

# O(codepoints): UTF-8 length counts codepoints by scanning the string.
export fn length(raw: String) -> Int =
  str_len(raw)

# O(1): reads the byte count from the string's CSTR header (every Sprout String
# is headered — arena, literal, and interned alike). Use this for protocol
# byte-length headers.
export fn byte_length(raw: String) -> Int =
  str_byte_len(raw)

# O(start + count): the builtin walks the UTF-8 sequence to `start`, then `count` further —
# independent of `|raw|`, so slicing a prefix of a huge string is cheap.
# A negative `start` or `count` clamps to empty rather than failing.
export fn slice(raw: String, start: Int, count: Int) -> String =
  str_slice(raw, start, count)

# O(codepoints × occurrences of sep): split `raw` around the LAST occurrence of
# `sep`, returning Just((before, after)), or Nothing when `sep` is absent (or
# empty).  Mirrors Rust's `str::rsplit_once`; the Maybe carries found-ness, so no
# redundant separator element is returned (cf. Python/Ruby `rpartition`).
export fn rsplit_once(raw: String, sep: String) -> Maybe (String, String) =
  if sep == "" then Nothing
  else if idx == -1 then Nothing
  else Just((slice(raw, 0, idx), drop(raw, idx + length(sep))))
  where idx = last_index_of(raw, sep)

# Last codepoint index at which `sep` starts in `raw`, or -1 if absent.
fn last_index_of(raw: String, sep: String) -> Int =
  last_index_of_loop(raw, sep, 0, -1)

fn last_index_of_loop(raw: String, sep: String, offset: Int, best: Int) -> Int =
  match find(drop(raw, offset), sep) with
  | Nothing -> best
  | Just rel -> last_index_of_loop(raw, sep, offset + rel + 1, offset + rel)

# O(codepoints × occurrences of sep): the segment after the last `sep`, or the
# whole string if `sep` is absent.  Convenience over rsplit_once for the common
# "bare-ify a dotted/qualified name" case ("a.b.c" / "." -> "c").
export fn substring_after_last(raw: String, sep: String) -> String =
  match rsplit_once(raw, sep) with
  | Just (_, tail) -> tail
  | Nothing -> raw

# O(codepoints): the segment after the last '.', or the whole string if there is
# none.  Dot-specific convenience over substring_after_last for bare-ifying a
# dotted/qualified name ("a.b.c" -> "c", "x" -> "x").
export fn after_last_dot(name: String) -> String =
  substring_after_last(name, ".")

# O(count): the leading `count` codepoints, or all of them when there are fewer.
# There is no "count covers everything" guard because `slice` already clamps, and
# asking would cost the O(|raw|) codepoint count this avoids — the guard only ever
# bought returning `raw` itself instead of an equal copy.
export fn take(raw: String, count: Int) -> String =
  if count <= 0 then ""
  else slice(raw, 0, count)

# O(|raw|): everything but the leading `count` codepoints. The codepoint count is
# irreducible here, so it is taken once and fed straight to `slice`, which clamps
# a non-positive remainder to the empty string.
export fn drop(raw: String, count: Int) -> String =
  if count <= 0 then raw
  else slice(raw, count, length(raw) - count)

# O(stop): the half-open window `[start, stop)` in codepoints. Prefer this to
# `slice(raw, start, stop - start)`, whose count goes negative when the two offsets
# arrive out of order; here an inverted or empty window is just the empty string.
export fn slice_between(raw: String, start: Int, stop: Int) -> String =
  let from = if start < 0 then 0 else start
  in slice(raw, from, stop - from)

# O(|raw|): the trailing `count` codepoints, or all of them when there are fewer.
# An offset counted from the end needs the codepoint length, so unlike `take` this
# cannot be O(count); a `count` past the end just makes the start negative, which
# `slice` clamps to zero.
export fn take_last(raw: String, count: Int) -> String =
  if count <= 0 then ""
  else slice(raw, length(raw) - count, count)

# O(|raw|): everything but the trailing `count` codepoints. Pair with `take_last`;
# the two partition `raw`.
export fn drop_last(raw: String, count: Int) -> String =
  if count <= 0 then raw
  else slice(raw, 0, length(raw) - count)

# O(|raw| * |needle|) in the worst case: delegates to the native substring search.
export fn find(raw: String, needle: String) -> Maybe Int =
  if r < 0 then Nothing else Just(r)
  where r = str_find(raw, needle)

# O(|prefix|): compares only the prefix region.
export fn starts_with(raw: String, prefix: String) -> Bool =
  str_starts_with(raw, prefix)

export fn contains(raw: String, needle: String) -> Bool =
  match find(raw, needle) with | Just _ -> true | Nothing -> false

# O(|suffix|): one byte-offset compare. UTF-8 is self-synchronising, so a match
# cannot start mid-codepoint. A suffix longer than `raw` gives a negative offset.
export fn ends_with(raw: String, suffix: String) -> Bool =
  let start = str_byte_len(raw) - str_byte_len(suffix)
  in start >= 0 && str_starts_with_at_byte(raw, start, suffix)

# O(index): scans UTF-8 codepoints up to the requested position.
export fn char_at(raw: String, index: Int) -> Maybe Char =
  str_char_at(raw, index)

export fn char_at_or(raw: String, index: Int, fallback: Char) -> Char =
  match char_at(raw, index) with
  | Just (ch) -> ch
  | Nothing -> fallback

export fn string_from_char(ch: Char) -> String =
  char_to_string(ch)

fn is_newline(ch: Char) -> Bool =
  ch == '\n'

fn is_carriage_return(ch: Char) -> Bool =
  ch == '\r'

fn is_space(ch: Char) -> Bool =
  ch == ' '

fn is_tab(ch: Char) -> Bool =
  ch == '\t'

export fn is_ascii_whitespace(ch: Char) -> Bool =
  is_space(ch) || is_tab(ch) || is_newline(ch) || is_carriage_return(ch)

# Range compares, since the lexer asks these of every identifier and number char.
fn is_ascii_digit_char(ch: Char) -> Bool =
  ch >= '0' && ch <= '9'

fn is_ascii_alpha_char(ch: Char) -> Bool =
  is_ascii_lower(ch) || is_ascii_upper(ch)

export fn is_ascii_digit(ch: Char) -> Bool =
  is_ascii_digit_char(ch)

export fn is_ascii_alpha(ch: Char) -> Bool =
  is_ascii_alpha_char(ch)

# Case-sensitive, which `is_ascii_alpha` cannot express. For callers that
# classify BY case — a name that must begin lowercase (or uppercase) to mean
# what it says.
export fn is_ascii_lower(ch: Char) -> Bool =
  ch >= 'a' && ch <= 'z'

export fn is_ascii_upper(ch: Char) -> Bool =
  ch >= 'A' && ch <= 'Z'

export fn is_ascii_alnum(ch: Char) -> Bool =
  is_ascii_alpha_char(ch) || is_ascii_digit_char(ch)

export fn is_ident_start(ch: Char) -> Bool =
  is_ascii_alpha_char(ch) || ch == '_'

export fn is_ident_continue(ch: Char) -> Bool =
  is_ident_start(ch) || is_ascii_digit_char(ch)

# Radix digits, for `0x` / `0b` integer literals. The index of the character in
# the digit string IS its value. Both cases are accepted, so `0xFF` and `0xff`
# agree.
#
# Binary digits deliberately have no separate value function: they are a subset of
# hex, so a caller decoding base 2 uses hex_digit_value and rejects any value >= 2.
# Shared by the lexer (which scans the run) and the parser (which decodes it).
export fn hex_digit_value(ch: Char) -> Maybe Int =
  match find("0123456789abcdef", string_from_char(ch)) with
  | Just v -> Just(v)
  | Nothing -> find("0123456789ABCDEF", string_from_char(ch))

export fn is_hex_digit(ch: Char) -> Bool =
  is_ascii_digit_char(ch) || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F')

export fn is_binary_digit(ch: Char) -> Bool =
  ch == '0' || ch == '1'

# ── ASCII whitespace trimming, O(n) ───────────────────────────────────────────────────────────────
# The previous versions recursed one codepoint at a time (`slice(raw, 1, len-1)` + a front-scanning
# `char_at_or`), which is Θ(n²) even when nothing is stripped — quadratic on a single long header
# value (code review finding 5). These convert to Bytes once (O(1) indexed access) and scan for the
# non-whitespace bounds, then slice once. ASCII whitespace is single-byte, so every cut lands on a
# codepoint boundary and the slice re-decodes cleanly.

# The four bytes `is_ascii_whitespace` recognises: space (0x20), tab (0x09), LF (0x0A), CR (0x0D).
# All are < 0x80, so they never appear as a UTF-8 lead or continuation byte — a byte-level test is
# exact, never mistaking part of a multibyte codepoint for whitespace.
fn is_ws_byte(b: Int) -> Bool =
  b == 32 || b == 9 || b == 10 || b == 13

# First index in [i, n) whose byte is not whitespace; n if the tail from i is all whitespace.
fn scan_ws_fwd(b: Bytes, i: Int, n: Int) -> Int =
  if i >= n then n
  else if is_ws_byte(bytes.get_or(b, i, 0)) then scan_ws_fwd(b, i + 1, n)
  else i

# Last index in [0, i] whose byte is not whitespace; -1 if [0, i] is all whitespace.
fn scan_ws_bwd(b: Bytes, i: Int) -> Int =
  if i < 0 then -1
  else if is_ws_byte(bytes.get_or(b, i, 0)) then scan_ws_bwd(b, i - 1)
  else i

# Decode the byte range [start, endx) back to a String. The range is always on codepoint boundaries
# here (cuts fall at ASCII whitespace, or at ASCII A..Z for the lowercaser), so to_string is Ok;
# the Err arm is an unreachable total fallback, never the observed path.
fn byte_range_string(b: Bytes, start: Int, endx: Int) -> String =
  match bytes.to_string(bytes.slice_between(b, start, endx)) with
  | Ok s -> s
  | Err _ -> ""

export fn trim_left(raw: String) -> String =
  let b = bytes.from_string(raw)
      n = bytes.length(b)
  in byte_range_string(b, scan_ws_fwd(b, 0, n), n)

export fn trim_right(raw: String) -> String =
  let b = bytes.from_string(raw)
  in byte_range_string(b, 0, scan_ws_bwd(b, bytes.length(b) - 1) + 1)

# One conversion and one scan from each end, so trimming is O(n) even on an all-whitespace input.
export fn trim(raw: String) -> String =
  let b = bytes.from_string(raw)
      n = bytes.length(b)
      lo = scan_ws_fwd(b, 0, n)
      hi = scan_ws_bwd(b, n - 1)
  in if lo > hi then "" else byte_range_string(b, lo, hi + 1)

# ── ASCII lowercasing, O(n) ─────────────────────────────────────────────────────────────────────
# Lowercase A..Z; every other byte is left exactly as-is. The old `http_server` copy rebuilt the
# String one codepoint at a time (Θ(n²)). This finds the first upper byte; an already-lowercase
# input, the header-name common case, comes back as is. Otherwise the walk goes on from that byte,
# coalescing maximal runs that need no change into a single verbatim slice and emitting each upper
# byte as a lowercased one, then joins the pieces in one O(total) `string_concat_many` pass. Only
# bytes 0x41..0x5A are ever split on, and those are single-codepoint, so every slice boundary is a
# codepoint boundary — multibyte UTF-8 (and any non-ASCII uppercase such as É) passes through
# untouched.
export fn to_lower_ascii(raw: String) -> String =
  if first == n then raw else string_concat_many(list_reverse(scan_lower(b, 0, first, n, Nil)))
where
  b = bytes.from_string(raw)
  n = bytes.length(b)
  first = first_upper(b, 0, n)

fn is_upper_byte(b: Int) -> Bool =
  b >= 65 && b <= 90

# The index of the first upper byte at or after `i`, or `n` when there is none.
fn first_upper(b: Bytes, i: Int, n: Int) -> Int =
  if i >= n || is_upper_byte(bytes.get_or(b, i, 0)) then i else first_upper(b, i + 1, n)

# Byte `b` (guaranteed 0x41..0x5A) as a one-character lowercase String, via a single-byte Bytes.
fn lower_byte_string(b: Int) -> String =
  byte_range_string(bytes.singleton(b + 32), 0, 1)

# `run` = start of the current verbatim (unchanged) run; `i` = cursor; `acc` = pieces, REVERSED.
# At each upper byte, flush the run [run, i) verbatim, then the lowercased single byte, and start a
# fresh run after it. At end, flush the final run [run, n).
fn scan_lower(b: Bytes, run: Int, i: Int, n: Int, acc: List String) -> List String =
  if i >= n then Cons(byte_range_string(b, run, n), acc)
  else if is_upper_byte(bytes.get_or(b, i, 0)) then
    scan_lower(b, i + 1, i + 1, n,
      Cons(lower_byte_string(bytes.get_or(b, i, 0)), Cons(byte_range_string(b, run, i), acc)))
  else scan_lower(b, run, i + 1, n, acc)

# O(1): `==` against "" stops at the first byte.
export fn is_empty(raw: String) -> Bool =
  raw == ""

export fn strip_prefix(raw: String, prefix: String) -> Maybe String =
  if starts_with(raw, prefix) then Just(drop(raw, length(prefix)))
  else Nothing

export fn strip_suffix(raw: String, suffix: String) -> Maybe String =
  if ends_with(raw, suffix) then Just(drop_last(raw, length(suffix)))
  else Nothing

export fn split_once(raw: String, sep: String) -> Maybe (String, String) =
  if is_empty(sep) then Nothing
  else
    match find(raw, sep) with
    | Nothing -> Nothing
    | Just pos -> Just((take(raw, pos), drop(raw, pos + length(sep))))

# Every occurrence of `sep`, in order, including the empty segments a leading,
# trailing or doubled separator produces — `split("/a//b/", "/")` is
# `["", "a", "", "b", ""]`. Callers wanting them dropped filter; a splitter that
# dropped them could not be used to parse a record with empty fields.
#
# Argument order follows `split_once(raw, sep)` beside it, NOT `join(sep, xs)`.
# The tree has both conventions, and matching the function this one shares a
# name-prefix with is what stops the pair from being a trap.
#
# An empty separator yields the whole string, matching `split_once`'s decision to
# report Nothing rather than fabricate a split at every position.
#
# O(bytes × |sep|): one left-to-right byte scan with O(1) byte-indexed slicing.
# Deliberately NOT the obvious `split_once`-on-the-remainder recursion, which is
# quadratic — `slice` is codepoint-indexed and walks the whole remainder per
# step. Scanning bytes is safe for any valid UTF-8 separator because UTF-8 is
# self-synchronising: no encoded character occurs as a subsequence of another, so
# a match can only ever begin on a character boundary.
export fn split(raw: String, sep: String) -> List String =
  if str_byte_len(sep) == 0 then Cons(raw, Nil) else split_from(raw, sep, 0)

# `split` of a non-empty `sep`, scanning from byte `pos`, before which no match starts. `pos` may
# fall inside a codepoint: a match cannot start there.
fn split_from(raw: String, sep: String, pos: Int) -> List String =
  list_reverse(split_go(raw, sep, str_byte_len(sep), str_byte_len(raw), pos, 0, Nil))

fn split_go(raw: String, sep: String, sep_bytes: Int, total: Int,
            pos: Int, start: Int, acc: List String) -> List String =
  if pos > total - sep_bytes then
    Cons(str_slice_bytes(raw, start, total - start), acc)
  else if str_starts_with_at_byte(raw, pos, sep) then
    split_go(raw, sep, sep_bytes, total, pos + sep_bytes, pos + sep_bytes,
      Cons(str_slice_bytes(raw, start, pos - start), acc))
  else
    split_go(raw, sep, sep_bytes, total, pos + 1, start, acc)

fn join_step(sep: String, acc: List String, s: String) -> List String =
  match acc with
  | Nil -> Cons(s, Nil)
  | _ -> Cons(s, Cons(sep, acc))

# O(n + total_bytes): one O(n) fold building reversed interleaved list + O(B) concat. An empty
# `sep` is not interleaved.
export fn join(sep: String, xs: f String) -> String where Foldable f =
  if sep == "" then string_concat_many(list_reverse(fold(\ (acc, s) -> Cons(s, acc), Nil, xs)))
  else string_concat_many(list_reverse(fold(\ (acc, s) -> join_step(sep, acc, s), Nil, xs)))

fn copies(s: String, n: Int, acc: List String) -> List String =
  if n <= 0 then acc else copies(s, n - 1, Cons(s, acc))

# O(n * |s|): a tail-recursive list of n copies, joined in one pass.
export fn repeat(s: String, n: Int) -> String =
  string_concat_many(copies(s, n, Nil))

# O(|s| * |from|): `split` compares `from` at each byte, then one join. An empty `from` returns `s`.
# Without a match `s` comes back as is, after one native search and no allocation: the common case
# for a sanitiser, such as `http_server`'s on every header line. With one, the split starts at the
# match's codepoint index, a lower bound on its byte offset.
export fn replace_all(from: String, to: String, s: String) -> String =
  if at < 0 || str_byte_len(from) == 0 then s else join(to, split_from(s, from, at))
where
  at = str_find(s, from)

# Strip a single trailing '\r' — for a CRLF line that str_split_lines split on the '\n'.
fn strip_trailing_cr(s: String) -> String =
  if ends_with(s, "\r") then drop_last(s, 1) else s

# Restore string_lines' exact contract on top of str_split_lines (a C extern that splits on '\n' in
# O(n) but keeps the '\r' and always emits a final segment, even an empty one): strip the CR from
# every line EXCEPT the final segment, and drop that final segment iff it is empty. So a trailing
# '\n' (or the empty string) yields no trailing blank line, an interior blank line is preserved, and
# a final non-newline-terminated line keeps any trailing '\r' — matching the old codepoint scanner.
fn finalize_lines(xs: List String) -> List String =
  match xs with
  | Nil -> Nil
  | [last] -> if is_empty(last) then Nil else Cons(last, Nil)
  | [head | rest] -> Cons(strip_trailing_cr(head), finalize_lines(rest))

# O(n): str_split_lines is one C-side pass; finalize_lines is one more pass with O(line) CR strips.
# (The previous pure-Sprout version was O(n^2) — char_at/slice per codepoint index — which made a
# ~650 KB input grind for many seconds.)
export fn string_lines(raw: String) -> Vec String =
  vec_from_list(finalize_lines(str_split_lines(raw)))

fn digits_loop(b: Bytes, i: Int, n: Int, acc: List Int) -> List Int =
  if i >= n then acc
  else
    let byte = bytes.get_or(b, i, 0)
    in if byte >= 48 && byte <= 57 then digits_loop(b, i + 1, n, Cons(byte - 48, acc))
       else digits_loop(b, i + 1, n, acc)

# O(bytes): one byte scan; ASCII digits never occur inside a multibyte codepoint.
export fn string_digits(raw: String) -> Vec Int =
  let b = bytes.from_string(raw)
  in vec_from_list(list_reverse(digits_loop(b, 0, bytes.length(b), Nil)))

fn chars_loop(b: Bytes, i: Int, n: Int, acc: List Char) -> List Char =
  if i >= n then acc
  else
    chars_loop(b, i + utf8.seq_length(bytes.get_or(b, i, 0)), n,
               Cons(char_from_codepoint(utf8.codepoint_at(b, i)), acc))

# O(bytes): steps by each codepoint's UTF-8 width and decodes it in place.
export fn string_chars(raw: String) -> Vec Char =
  let b = bytes.from_string(raw)
  in vec_from_list(list_reverse(chars_loop(b, 0, bytes.length(b), Nil)))
