module stdlib.terminal

# Terminal control primitives. Declared here rather than in the prelude: nothing in the prelude
# calls them, and under the rule "an extern lives in the module that owns its surface" this is
# that module. Reaching a terminal becomes an explicit dependency — the same reasoning the
# prelude already records for stdlib.net's socket primitives.
#
# Callers use the wrappers below (`write`, `clear`, ...), not these names directly. Note that
# `export` on an `extern fn` would be inert: the parser discards it (parser.sprout:1941) and the
# bundler never registers extern names (bundler.sprout:597), so an extern is reachable by bare
# name from anywhere this module is bundled. The wrapper API is what makes that reach
# intentional and greppable, not a visibility rule.
extern fn term_clear() -> Unit !{IO}
extern fn term_move(row: Int, col: Int) -> Unit !{IO}
extern fn term_hide_cursor() -> Unit !{IO}
extern fn term_show_cursor() -> Unit !{IO}
extern fn term_is_interactive() -> Bool !{IO}
extern fn term_read_key() -> String !{IO}
extern fn term_read_line() -> Maybe String !{IO}
extern fn term_write(text: String) -> Unit !{IO}

export fn clear() -> Unit !{IO} =
  term_clear()

export fn move(row: Int, col: Int) -> Unit !{IO} =
  term_move(row, col)

export fn hide_cursor() -> Unit !{IO} =
  term_hide_cursor()

export fn show_cursor() -> Unit !{IO} =
  term_show_cursor()

let esc = char_to_str(27)

export fn enter_alt_screen() -> Unit !{IO} =
  term_write(esc ++ "[?1049h")

export fn exit_alt_screen() -> Unit !{IO} =
  term_write(esc ++ "[?1049l")

export fn reset_style() -> Unit !{IO} =
  term_write(esc ++ "[0m")

export fn set_bold() -> Unit !{IO} =
  term_write(esc ++ "[1m")

export fn set_fg(r: Int, g: Int, b: Int) -> Unit !{IO} =
  term_write(`${esc}[38;2;${int_to_string(r)};${int_to_string(g)};${int_to_string(b)}m`)

export fn set_bg(r: Int, g: Int, b: Int) -> Unit !{IO} =
  term_write(`${esc}[48;2;${int_to_string(r)};${int_to_string(g)};${int_to_string(b)}m`)

export fn write(text: String) -> Unit !{IO} =
  term_write(text)

export fn term_home() -> Unit !{IO} =
  term_move(1, 1)

export fn term_reset_screen() -> Unit !{IO} =
  do
    term_clear()
    term_home()

export fn term_render_line(row: Int, text: String) -> Unit !{IO} =
  do
    move(row, 1)
    write(text)

export fn term_read_key_once() -> String !{IO} =
  term_read_key()

export fn term_read_line_once() -> Maybe String !{IO} =
  term_read_line()

export fn term_is_interactive_once() -> Bool !{IO} =
  term_is_interactive()

# ---------------------------------------------------------------------------
# Session raw mode, terminal size, and parked input
#
# `term_read_key` above is a per-keypress surface: it enters raw mode, reads, and
# restores the old termios before returning. That bound is why it decodes only
# `ESC [ A/B/C/D` — a longer sequence (a modifier chord, an SGR mouse report, a
# bracketed paste) outlives the window, and its tail bytes come back to the caller
# as separate fake keypresses. It also blocks the OS thread, so a key read starves
# every other green task.
#
# The surface below is the one a TUI uses instead. Raw mode is held across the
# session, `read_avail` hands back raw bytes and PARKS the calling task rather
# than the thread, and all decoding happens in Sprout — where it is an ordinary
# tested function rather than untestable C. `term_read_key` is unchanged and still
# used by stdlib/repl.sprout.
# ---------------------------------------------------------------------------

# Rows and columns. A positional ADT rather than a tuple because an extern
# returning a tuple has no precedent in the runtime, while a two-Int constructor
# does (stdlib.regex.Match).
export type TermSize (..) =
  | TermSize Int Int

# The result of one `read_avail`. Total by construction: every outcome the
# descriptor can produce has a constructor, so a caller cannot forget one.
#
# `Bytes`, not `String`: a read can land mid-UTF-8-sequence, and a Sprout String
# is always valid UTF-8 with no NUL. Reassembly belongs to the decoder.
export type TermInput (..) =
  | TermBytes Bytes
  # The deadline elapsed with nothing readable. Not an error — it is how a UI
  # gets its frame tick.
  | TermIdle
  # SIGWINCH arrived since the last call. Observed here rather than delivered as
  # a signal, so a resize is an ordinary event in the same stream as a keypress.
  | TermResized
  | TermEof
  | TermFailed String

extern fn term_raw_enter() -> Unit !{IO}
extern fn term_raw_exit() -> Unit !{IO}
extern fn term_size() -> TermSize !{IO}
extern fn term_read_avail(max: Int, ms: Int) -> TermInput !{IO}

# Hold raw mode for the session: no echo, no line buffering, and ctrl-C, ctrl-S
# and ctrl-Q delivered as ordinary bytes instead of signals. A no-op when stdin is
# not a terminal, so a piped run needs no branch at the call site.
#
# The runtime registers an atexit restore, so an abnormal exit cannot strand the
# user's shell with echo off — which would otherwise be unrecoverable, ctrl-C
# being exactly what this turns off.
export fn raw_enter() -> Unit !{IO} =
  term_raw_enter()

export fn raw_exit() -> Unit !{IO} =
  term_raw_exit()

# Current terminal size, falling back to $LINES/$COLUMNS and then 24x80, so a
# layout always has finite numbers even with no terminal attached.
export fn size() -> TermSize !{IO} =
  term_size()

export fn size_rows(s: TermSize) -> Int =
  match s with
  | TermSize rows _ -> rows

export fn size_cols(s: TermSize) -> Int =
  match s with
  | TermSize _ cols -> cols

# Wait up to `timeout_ms` for input, returning at most `max` bytes.
#
# Parks the calling task, so timers, animation and network I/O keep running while
# a UI waits on the keyboard. A non-positive `timeout_ms` polls once and returns
# `TermIdle` rather than waiting.
#
# EXACTLY ONE task may be waiting here at a time; a second one fails loudly. Two
# waiters would both wake when stdin becomes readable, the first would take the
# bytes, and the second's read would then block the whole scheduler — so the
# guard turns an unattributable wedge into a named error. Drive input from one
# task and hand events on through a channel.
export fn read_avail(max: Int, timeout_ms: Int) -> TermInput !{IO} =
  term_read_avail(max, timeout_ms)
