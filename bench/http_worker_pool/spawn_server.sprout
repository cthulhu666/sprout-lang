import stdlib.task (Scope, with_scope, task_spawn)
import stdlib.net (TcpListener, TcpConnection, listen_local, accept, close, close_listener, read_avail_timeout, write_all_utf8)

# Identical in both variants, so the ONLY difference measured is the concurrency
# model: task-per-connection vs a fixed worker pool fed by a channel.
let response = "HTTP/1.1 200 OK\r\nconnection: close\r\ncontent-length: 15\r\ncontent-type: application/json\r\n\r\n{\"status\":\"ok\"}"

# `read_avail_timeout`/`write_all_utf8` BORROW the connection; `close` consumes it, so the
# exactly-once obligation is discharged exactly here on every path.
fn handle(conn: consuming TcpConnection) -> Unit !{IO} =
  do
    # A bound rather than an unbounded read: `read_avail` is gone, because a benchmark server
    # that a silent client can park forever measures the wrong thing.
    _ <- read_avail_timeout(conn, 5000)
    _ <- write_all_utf8(conn, response)
    close(conn)

# One fire-and-forget task per accepted connection: 1 MiB stack + 512 KiB root
# pool malloc'd and freed per request, plus makecontext zeroing the stack.
fn serve_loop(scope: Scope, listener: consuming TcpListener) -> Unit !{IO} =
  do
    conn <- accept(listener)
    task_spawn(scope, \_ -> handle(conn))
    serve_loop(scope, listener)

fn main() -> Unit !{IO} =
  with_scope(\s -> serve_loop(s, listen_local(8099)))
