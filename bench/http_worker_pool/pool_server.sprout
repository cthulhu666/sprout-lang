import stdlib.task (Scope, with_scope, task_spawn, task_yield)
import stdlib.chan (Chan, Recv, Got, Closed, chan_new, chan_send, chan_recv, chan_close)
import stdlib.net (TcpListener, TcpConnection, listen_local, accept, close, close_listener, read_avail_timeout, write_all_utf8)

# Identical in both variants, so the ONLY difference measured is the concurrency
# model: task-per-connection vs a fixed worker pool fed by a channel.
let response = "HTTP/1.1 200 OK\r\nconnection: close\r\ncontent-length: 15\r\ncontent-type: application/json\r\n\r\n{\"status\":\"ok\"}"

# `read_avail_timeout`/`write_all_utf8` BORROW the connection; `close` consumes it, discharging the
# exactly-once obligation.
#
# The two calls are BARE STATEMENTS, not `_ <- ...`, and that is load-bearing rather than style.
# `_ <-` still sequences the `Result`: on `Err` it returns early from this function, so a read timeout
# — routine under benchmark load — SKIPPED `close(conn)` and leaked the descriptor. The linearity
# checker did not object, because it does not model the control-flow edges that the short-circuit
# introduces (BACKLOG P0, "a do block's Result short-circuit is never type-checked"). This comment
# previously claimed the obligation was discharged "on every path"; it was discharged on one of three.
# A bare statement runs the call, discards the Result, and CONTINUES, which is what a benchmark server
# that does not care about a client I/O error actually wants.
fn handle(conn: consuming TcpConnection) -> Unit !{IO} =
  do
    # A bound rather than an unbounded read: `read_avail` is gone, because a benchmark server
    # that a silent client can park forever measures the wrong thing.
    read_avail_timeout(conn, 5000)
    write_all_utf8(conn, response)
    close(conn)

# A worker never returns, so its context is built ONCE by makecontext and its stack
# and root pool are never freed. `Got conn` binds an OWNED connection; `handle`
# consumes it. This is the whole optimisation, expressed in Sprout.
fn worker(ch: Chan TcpConnection) -> Unit !{IO} =
  match chan_recv(ch) with
  | Got conn ->
      do
        handle(conn)
        worker(ch)
  | Closed -> task_yield()

fn spawn_workers(s: Scope, ch: Chan TcpConnection, n: Int) -> Unit !{IO} =
  if n <= 0 then task_yield()
  else
    do
      task_spawn(s, \_ -> worker(ch))
      spawn_workers(s, ch, n - 1)

# The accept loop owns the listener and MOVES each connection into the channel.
# An explicit match, not `conn <- accept(listener)`: a bare bind of an Err in a Unit function returns
# early and discards it, which here would stop the bench silently and look like a clean finish.
fn accept_loop(ch: Chan TcpConnection, listener: consuming TcpListener) -> Unit !{IO} =
  match accept(listener) with
  | Ok conn ->
      do
        chan_send(ch, conn)
        accept_loop(ch, listener)
  | Err _ ->
      do
        # The channel must close before the scope join, or every worker parked in chan_recv is a task
        # that never finishes and `with_scope` waits for it forever.
        chan_close(ch)
        close_listener(listener)

fn run(s: Scope, ch: Chan TcpConnection) -> Unit !{IO} =
  do
    spawn_workers(s, ch, 64)
    accept_loop(ch, listen_local(8099))

fn main() -> Unit !{IO} = with_scope(\s -> run(s, chan_new(s, 256)))
